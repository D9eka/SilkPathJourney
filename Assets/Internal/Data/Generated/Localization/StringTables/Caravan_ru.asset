      m_Items: []
  - m_Id: 318295176634377
    m_Localized: "\u0414\u043E\u0440\u043E\u0436\u043D\u044B\u0435 \u0444\u043E\u043D\u0430\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 322791487299584
    m_Localized: "-30% \u0448\u0430\u043D\u0441 \u0441\u043E\u0431\u044B\u0442\u0438\u044F
      \xAB\u0421\u043B\u043E\u043C\u0430\u043D\u043D\u043E\u0435 \u043A\u043E\u043B\u0435\u0441\u043E\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 322791525048320
    m_Localized: "+100% \u0441\u0440\u043E\u043A \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F
