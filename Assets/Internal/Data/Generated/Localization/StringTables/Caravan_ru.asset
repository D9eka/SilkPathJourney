      m_Items: []
  - m_Id: 322791525048322
    m_Localized: "-10% \u0448\u0430\u043D\u0441 \u0441\u043E\u0431\u044B\u0442\u0438\u044F
      \xAB\u0411\u0430\u043D\u0434\u0438\u0442\u044B\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 322791525048323
    m_Localized: "20 \u0435\u0434. \u0441\u043A\u0440\u044B\u0442\u043E\u0433\u043E
      \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0430 (\u0431\u0435\u0437
