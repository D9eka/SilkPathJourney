  m_Name: Player_ru
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ru
  m_SharedData: {fileID: 11400000, guid: eff343e1c16dba340a2b7cd41dcaea3f, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 527425536
    m_Localized: "\u0421\u044B\u043D \u043A\u0443\u043F\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 556785664
    m_Localized: "\u041E\u0442\u0435\u0446 \u0431\u044B\u043B \u0443\u0441\u043F\u0435\u0448\u043D\u044B\u043C
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u043C \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u043C
      \u043F\u043E\u0431\u0435\u0440\u0435\u0436\u044C\u0435, \u043D\u043E \u0440\u0430\u0437\u043E\u0440\u0438\u043B\u0441\u044F
      \u0438\u0437-\u0437\u0430 \u043D\u0435\u0443\u0434\u0430\u0447\u043D\u043E\u0439
      \u0441\u0434\u0435\u043B\u043A\u0438. \u0422\u044B \u0443\u043D\u0430\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B
      \u0437\u043D\u0430\u043D\u0438\u044F \u043E \u0446\u0435\u043D\u0430\u0445
      \u0438 \u0442\u043E\u0432\u0430\u0440\u0430\u0445 - \u043D\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0448\u044C
      \u043F\u0443\u0442\u044C \u0441 \u043D\u0443\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 556785665
    m_Localized: "\u0411\u044B\u0432\u0448\u0438\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 556785666
    m_Localized: "\u041C\u043D\u043E\u0433\u043E \u043B\u0435\u0442 \u0432\u043E\u0434\u0438\u043B
      \u0447\u0443\u0436\u0438\u0435 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u044B
      \u043F\u043E \u043E\u043F\u0430\u0441\u043D\u044B\u043C \u0434\u043E\u0440\u043E\u0433\u0430\u043C.
      \u0417\u043D\u0430\u0435\u0448\u044C \u043F\u0443\u0441\u0442\u044B\u043D\u044E,
      \u0441\u0442\u0435\u043F\u044C \u0438 \u0433\u043E\u0440\u044B - \u043D\u043E
      \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C \u0432\u0441\u0435\u0433\u0434\u0430
      \u0431\u044B\u043B\u043E \u043D\u0435 \u0442\u0432\u043E\u0438\u043C \u0434\u0435\u043B\u043E\u043C.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u0440\u0430 \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u0441\u0430\u043C\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 556785667
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 556785668
    m_Localized: "\u0411\u0440\u043E\u0434\u0438\u043B \u043F\u043E \u0433\u043E\u0440\u043E\u0434\u0430\u043C
      \u0421\u0440\u0435\u0434\u043D\u0435\u0439 \u0410\u0437\u0438\u0438, \u043F\u043E\u0434\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044F
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u043E\u043C \u0438
      \u043F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A\u043E\u043C. \u041D\u0435
      \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D \u043D\u0438 \u043A \u043E\u0434\u043D\u043E\u043C\u0443
      \u043C\u0435\u0441\u0442\u0443, \u0437\u0430\u0442\u043E \u0437\u043D\u0430\u0435\u0448\u044C
      \u043B\u044E\u0434\u0435\u0439 \u0438 \u0434\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 556785669
    m_Localized: "\u0414\u0438\u043F\u043B\u043E\u043C\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 556785670
    m_Localized: "\u0421\u043B\u0443\u0436\u0438\u043B \u043F\u0440\u0438 \u0434\u0432\u043E\u0440\u0435
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u043E\u043C, \u043D\u043E
      \u043F\u043E\u043F\u0430\u043B \u0432 \u043D\u0435\u043C\u0438\u043B\u043E\u0441\u0442\u044C.
      \u0423\u043C\u0435\u0435\u0448\u044C \u0443\u0431\u0435\u0436\u0434\u0430\u0442\u044C
      \u0438 \u0434\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0442\u044C\u0441\u044F,
      \u0437\u043D\u0430\u0435\u0448\u044C \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439
      - \u044F\u0437\u044B\u043A \u0434\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0438\u0438.
      \u041D\u043E \u043F\u0443\u0441\u0442\u044B\u043D\u044F \u0438 \u0433\u043E\u0440\u044B
      \u0434\u043B\u044F \u0442\u0435\u0431\u044F \u0432 \u043D\u043E\u0432\u0438\u043D\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 556785671
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 556785672
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u043B \u0437\u0430\u043F\u0440\u0435\u0449\u0451\u043D\u043D\u044B\u043C\u0438
      \u0442\u043E\u0432\u0430\u0440\u0430\u043C\u0438 \u0447\u0435\u0440\u0435\u0437
      \u043F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u044B\u0435 \u0433\u043E\u0440\u043E\u0434\u0430.
      \u0417\u043D\u0430\u0435\u0448\u044C \u0442\u0430\u0439\u043D\u044B\u0435 \u0442\u0440\u043E\u043F\u044B
      \u0438 \u0443\u043C\u0435\u0435\u0448\u044C \u043F\u0440\u044F\u0442\u0430\u0442\u044C
      \u0433\u0440\u0443\u0437. \u041D\u043E \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u043F\u043E\u0434\u043F\u043E\u0440\u0447\u0435\u043D\u0430 - \u0447\u0435\u0441\u0442\u043D\u044B\u0435
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B \u0442\u0435\u0431\u044F \u0441\u0442\u043E\u0440\u043E\u043D\u044F\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 556785673
    m_Localized: "\u0411\u044B\u0432\u0448\u0438\u0439 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 556785674
    m_Localized: "\u041C\u043D\u043E\u0433\u043E \u043B\u0435\u0442 \u0433\u0440\u0430\u0431\u0438\u043B
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u044B \u0432 \u0441\u0442\u0435\u043F\u044F\u0445.
      \u0423\u0441\u0442\u0430\u043B \u043E\u0442 \u044D\u0442\u043E\u0439 \u0436\u0438\u0437\u043D\u0438
      \u0438 \u0440\u0435\u0448\u0438\u043B \u0441\u0442\u0430\u0442\u044C \u0447\u0435\u0441\u0442\u043D\u044B\u043C
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u043C. \u041D\u043E \u043F\u0440\u043E\u0448\u043B\u043E\u0435
      \u043D\u0435 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0435\u0442 - \u0442\u0435\u0431\u044F
      \u0437\u043D\u0430\u044E\u0442 \u0438 \u043D\u0435 \u0434\u043E\u0432\u0435\u0440\u044F\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 556785675
    m_Localized: "\u0423\u0447\u0451\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 556785676
    m_Localized: "\u0418\u0437\u0443\u0447\u0430\u043B \u0434\u0440\u0435\u0432\u043D\u0438\u0435
      \u0442\u0435\u043A\u0441\u0442\u044B \u0438 \u043A\u0430\u0440\u0442\u044B
      \u0432 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0435 \u0427\u0430\u043D\u044A\u0430\u043D\u044F.
      \u0417\u043D\u0430\u0435\u0448\u044C \u044F\u0437\u044B\u043A\u0438 \u0438
      \u0438\u0441\u0442\u043E\u0440\u0438\u044E, \u043D\u043E \u0436\u0438\u0437\u043D\u044C
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 - \u0441\u043E\u0432\u0441\u0435\u043C
      \u043D\u0435 \u0442\u043E, \u0447\u0442\u043E \u043A\u043D\u0438\u0433\u0438.
      \u041E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F \u0432 \u043F\u0443\u0442\u044C
      \u0440\u0430\u0434\u0438 \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 556785677
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 556785678
    m_Localized: "\u0418\u0434\u0451\u0448\u044C \u043F\u043E \u0441\u0432\u044F\u0442\u044B\u043C
      \u043C\u0435\u0441\u0442\u0430\u043C \u043E\u0442 \u041B\u0445\u0430\u0441\u044B
      \u0434\u043E \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044F.
      \u0414\u043B\u044F \u0442\u0435\u0431\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044F
      - \u043B\u0438\u0448\u044C \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E
      \u0434\u043E\u0441\u0442\u0438\u0447\u044C \u0434\u0443\u0445\u043E\u0432\u043D\u043E\u0439
      \u0446\u0435\u043B\u0438. \u041B\u044E\u0434\u0438 \u0442\u044F\u043D\u0443\u0442\u0441\u044F
      \u043A \u0442\u0435\u0431\u0435, \u043D\u043E \u0434\u0435\u043D\u0435\u0433
      \u043F\u043E\u0447\u0442\u0438 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 556785679
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 556785680
    m_Localized: "\u041A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u043E\u0435 \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u0435:
      \u0432\u044B\u0441\u043E\u043A\u0430\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044F,
      2\xD7 \u0448\u0451\u043B\u043A \u043D\u0430 \u0441\u0442\u0430\u0440\u0442\u0435,
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 560979968
    m_Localized: "\u041D\u0430\u0451\u043C\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 560979969
    m_Localized: "\u041E\u043F\u044B\u0442\u0435\u043D \u0432 \u0434\u043E\u0440\u043E\u0433\u0435:
      \u0432\u044B\u0441\u043E\u043A\u043E\u0435 \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u0435,
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u0432\u044F\u043B\u0435\u043D\u043E\u0433\u043E
      \u043C\u044F\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 560979970
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 560979971
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u043D\u0438\u043A: \u0447\u0430\u0439
      \u043D\u0430 \u0441\u0442\u0430\u0440\u0442\u0435, \u0441\u043A\u0440\u043E\u043C\u043D\u043E\u0435
      \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 560979972
    m_Localized: "\u0414\u0438\u043F\u043B\u043E\u043C\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 560979973
    m_Localized: "\u0414\u0438\u043F\u043B\u043E\u043C\u0430\u0442: \u0432\u044B\u0441\u043E\u043A\u0430\u044F
      \u0445\u0430\u0440\u0438\u0437\u043C\u0430, \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u044B\u0439 \u043A\u0430\u043F\u0438\u0442\u0430\u043B,
      \u0431\u0443\u043C\u0430\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 560979974
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 560979975
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442:
      \u0446\u0435\u043D\u043D\u044B\u0435 \u0441\u043F\u0435\u0446\u0438\u0438 \u0438
      \u043C\u0443\u0441\u043A\u0443\u0441, \u043C\u0430\u043B\u043E \u0434\u0435\u043D\u0435\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 560979976
    m_Localized: "\u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 560979977
    m_Localized: "\u0417\u0430\u043A\u0430\u043B\u0451\u043D\u043D\u044B\u0439: \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C
      \u0432\u044B\u0436\u0438\u0432\u0430\u043D\u0438\u044F, \u043D\u0438\u0437\u043A\u0430\u044F
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F, \u0436\u0435\u043B\u0435\u0437\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 560979978
    m_Localized: "\u0423\u0447\u0451\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 560979979
    m_Localized: "\u042D\u0440\u0443\u0434\u0438\u0442: \u0437\u043D\u0430\u0435\u0442
      \u0442\u0440\u0438 \u044F\u0437\u044B\u043A\u0430, \u0431\u0443\u043C\u0430\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 560979980
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 560979981
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A: \u0431\u043E\u043D\u0443\u0441
      \u043C\u043E\u0440\u0430\u043B\u0438, \u0432\u044B\u0441\u043E\u043A\u0430\u044F
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F, \u0431\u043B\u0430\u0433\u043E\u0432\u043E\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 492307936698368
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0431\u0430\u0440\u044B\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 492307961864192
    m_Localized: "\u0417\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0439 100 \u043C\u043E\u043D\u0435\u0442
      \u0437\u0430 \u043E\u0434\u0438\u043D \u0437\u0430\u0431\u0435\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 492307961864193
    m_Localized: "\u0414\u043E\u043B\u0433\u0438\u0439 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 492307961864194
    m_Localized: "\u041F\u0440\u043E\u0439\u0434\u0438 50 \u0434\u043D\u0435\u0439
      \u0437\u0430 \u043E\u0434\u0438\u043D \u0437\u0430\u0431\u0435\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 492307961864195
    m_Localized: "\u041F\u043E\u043B\u0438\u0433\u043B\u043E\u0442"
