  - m_Id: 21023829332582508
    m_Localized: "\u0418\u0441\u0442\u043E\u0440\u0438\u044F \u043A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u043E\u0433\u043E
      \u0441\u044B\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582509
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0438\u044F
      \u0410\u043D\u044C \u041B\u0443\u0448\u0430\u043D\u044F \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u0437\u0430\u043D\u0451\u0441 \u0432\u0430\u0448\u0443 \u0441\u0435\u043C\u044C\u044E
      \u0432 \u0447\u0451\u0440\u043D\u044B\u0439 \u0441\u043F\u0438\u0441\u043E\u043A.
      \u0412\u0435\u0440\u043D\u0438\u0442\u0435 \u0434\u043E\u0431\u0440\u043E\u0435
      \u0438\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582510
    m_Localized: "\u041F\u0440\u043E\u043F\u0430\u0432\u0448\u0438\u0439 \u043F\u0430\u0440\u0442\u043D\u0451\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582511
    m_Localized: "\u0422\u0440\u0438 \u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434
      \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D \u0438\u0441\u0447\u0435\u0437
      \u0432 \u0425\u044D\u0441\u0438-\u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0435
      \u0441 \u0433\u0440\u0443\u0437\u043E\u043C \u0448\u0451\u043B\u043A\u0430.
      \u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0441\u043B\u0435\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582512
    m_Localized: "\u041F\u0435\u043F\u0435\u043B \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582513
    m_Localized: "\u041A\u0442\u043E \u043F\u043E\u0434\u0436\u0451\u0433 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0439
      \u0434\u0432\u043E\u0440 \u0420\u0443\u0441\u0442\u0430\u043C\u0430 \u0432
      \u0426\u0437\u044E\u0446\u044E\u0430\u043D\u0435 \u0438 \u043F\u043E\u0447\u0435\u043C\u0443
      \u043F\u043E\u0433\u0438\u0431\u043B\u0438 \u0434\u0432\u043E\u0435 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044C\u0446\u0435\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582514
    m_Localized: "\u0417\u0430\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582515
    m_Localized: "\u0417\u0430\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u043F\u0438\u0441\u044C\u043C\u043E \u0442\u0430\u043D\u044F \u0427\u0436\u044D\u043D
      \u0412\u044D\u044F \u0434\u043E\u043B\u0436\u043D\u043E \u043F\u043E\u043F\u0430\u0441\u0442\u044C
      \u0432 \u0421\u0438\u0430\u043D\u044C \u0432 \u043E\u0431\u0445\u043E\u0434
      \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0445 \u043F\u043E\u0441\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582516
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0434\u043E\u043B\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582517
    m_Localized: "\u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u043E\u0431\u044A\u044F\u0432\u0438\u043B\u0441\u044F
      \u0432 \u0426\u044E\u0430\u043D\u044C\u0447\u0436\u043E\u0443 \u0438 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u0434\u043E\u043B\u044E \u043E\u0442 \u0441\u0442\u0430\u0440\u043E\u0439
      \u043A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u044B \u043C\u0443\u0441\u043A\u0443\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582518
    m_Localized: "\u0412\u043E\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u0443\u0449\u0435\u0440\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582519
    m_Localized: "\u0421\u0435\u043C\u044C \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434
      \u0432\u0430\u0448\u0430 \u0431\u0430\u043D\u0434\u0430 \u043E\u0433\u0440\u0430\u0431\u0438\u043B\u0430
      \u0442\u0440\u0438 \u0441\u0435\u043C\u044C\u0438. \u041F\u043E\u0440\u0430
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0434\u043E\u043B\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582520
    m_Localized: "\u0420\u0430\u0437\u0440\u043E\u0437\u043D\u0435\u043D\u043D\u044B\u0439
      \u0442\u0440\u0430\u043A\u0442\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582521
    m_Localized: "\u0422\u0440\u0430\u043A\u0442\u0430\u0442 \u043E\u0442\u0446\u0430
      \u043E \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430\u0445 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438 \u0443\u043A\u0440\u0430\u0434\u0435\u043D \u0438
      \u0440\u0430\u0437\u043E\u0448\u0451\u043B\u0441\u044F \u043F\u043E \u0442\u0440\u0451\u043C
      \u0440\u0443\u043A\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582522
    m_Localized: "\u0422\u0440\u043E\u0439\u043D\u043E\u0439 \u043E\u0431\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582523
    m_Localized: "\u041E\u0431\u0435\u0442 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u043F\u043E\u0441\u0435\u0449\u0435\u043D\u0438\u044F \u0442\u0440\u0451\u0445
      \u0441\u0430\u043A\u0440\u0430\u043B\u044C\u043D\u044B\u0445 \u043C\u0435\u0441\u0442:
      \u0431\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u043E\u0433\u043E \u0445\u0440\u0430\u043C\u0430,
      \u0437\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u043E\u0433\u043E
      \u043E\u0433\u043D\u044F \u0438 \u043C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u043E\u0433\u043E
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 21302004633559040
