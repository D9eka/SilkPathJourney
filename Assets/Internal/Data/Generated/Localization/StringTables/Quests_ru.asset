    m_Localized: "\u0422\u0430\u0439\u043D\u044B \u043A\u0440\u0430\u0441\u0438\u043B\u044C\u043D\u043E\u0433\u043E
      \u0440\u0435\u043C\u0435\u0441\u043B\u0430 \u043C\u0430\u0441\u0442\u0435\u0440\u0430
      \u0427\u044D\u043D\u044C \u0412\u044D\u044F. \u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0438\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0441\u043A\u0438\u0439
      \u0448\u0451\u043B\u043A"
    m_Metadata:
