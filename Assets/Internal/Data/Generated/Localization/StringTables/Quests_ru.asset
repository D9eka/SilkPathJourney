    m_Metadata:
      m_Items: []
  - m_Id: 485482539
    m_Localized: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0432\u0435\u043B\u0438\u043A\u0443\u044E
      \u043E\u0445\u043E\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 485482540
    m_Localized: "\u0418\u043C\u043F\u0435\u0440\u0438\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 485482541
    m_Localized: "\u041A\u0430\u0440\u044C\u0435\u0440\u0430 \u0432 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0439
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438 \u2014 \u043E\u0442 \u043F\u0440\u043E\u0441\u0442\u043E\u0439
      \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438 \u0434\u043E \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430 \u0438\u043C\u043F\u0435\u0440\u0438\u0438.
      \u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F
      \u0432 \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 485482542
    m_Localized: "\u041F\u0443\u0442\u044C \u043C\u0438\u0441\u0442\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 485482543
    m_Localized: "\u0414\u0443\u0445\u043E\u0432\u043D\u043E\u0435 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435
      \u043F\u043E \u0441\u0432\u044F\u0442\u044B\u043D\u044F\u043C \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438. \u041E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0433\u043E\u0440\u043D\u044B\u0439 \u043F\u0435\u0440\u0435\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 485482544
    m_Localized: "\u041F\u0443\u0442\u044C \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 485482545
    m_Localized: "\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F \u0441\u0442\u0430\u0440\u043E\u0433\u043E
