    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582428
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u043F\u0438\u0441\u044C\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582429
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0438\u0442\u0435 \u0437\u0430\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u043F\u0438\u0441\u044C\u043C\u043E \u0443 \u0442\u0430\u043D\u0430 \u0427\u0436\u044D\u043D
      \u0412\u044D\u044F \u0432 \u0425\u0430\u043D\u0447\u0436\u043E\u0443 \u0438
      \u043D\u0430\u0439\u0434\u0438\u0442\u0435 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u0430
      \u0434\u043B\u044F \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E\u0439 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582430
    m_Localized: "\u042F\u0432\u0438\u0442\u044C\u0441\u044F \u043A \u0442\u0430\u043D\u0443
      \u0427\u0436\u044D\u043D \u0412\u044D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582431
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582432
    m_Localized: "\u0423\u0447\u0451\u043D\u044B\u0439-\u0441\u043E\u0433\u0434\u0438\u0435\u0446
      \u0443\u0437\u043D\u0430\u0451\u0442 \u0447\u0430\u0441\u0442\u044C \u0437\u043D\u0430\u043A\u043E\u0432:
      \u043F\u0438\u0441\u044C\u043C\u043E \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E
      \u0441\u043C\u0435\u0448\u0430\u043D\u043D\u044B\u043C \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E-\u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u043C
      \u0448\u0438\u0444\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582433
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582434
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439
      \u043F\u043E\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582435
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0434\u0438\u0442\u0435 \u043F\u0438\u0441\u044C\u043C\u043E
      \u0447\u0435\u0440\u0435\u0437 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u044B\u0439 \u043F\u043E\u0441\u0442,
      \u043D\u0435 \u0432\u044B\u0437\u0432\u0430\u0432 \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582436
    m_Localized: "\u0412\u044B\u0434\u0432\u0438\u043D\u0443\u0442\u044C\u0441\u044F
      \u043A \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u043C\u0443 \u043F\u043E\u0441\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582437
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582438
    m_Localized: "\u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043E\u0444\u0438\u0446\u0435\u0440
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0433\u0440\u0443\u0437 - \u0434\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0435
      \u0447\u0443\u0442\u044C\u0451 \u043F\u043E\u043C\u043E\u0436\u0435\u0442 \u043E\u0442\u0432\u0435\u0441\u0442\u0438
      \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582439
    m_Localized: "\u041F\u043E\u0441\u0442 \u043F\u0440\u043E\u0439\u0434\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582440
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u0432 \u0421\u0438\u0430\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582441
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043F\u0438\u0441\u044C\u043C\u043E
      \u0442\u0430\u043D\u0443 \u0425\u044D \u0411\u0438\u043D\u044E \u0432 \u0421\u0438\u0430\u043D\u044C
      \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435 \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u0443\u044E
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582442
    m_Localized: "\u0412\u044B\u0434\u0432\u0438\u043D\u0443\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0421\u0438\u0430\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582443
    m_Localized: "\u041C\u0438\u0441\u0441\u0438\u044F \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582444
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u0410\u0431\u0443
      \u0411\u0430\u043A\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582445
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0442\u044C\u0442\u0435\u0441\u044C
      \u0441 \u0410\u0431\u0443 \u0411\u0430\u043A\u0440\u043E\u043C \u0432 \u0426\u044E\u0430\u043D\u044C\u0447\u0436\u043E\u0443
      \u0438 \u0443\u0437\u043D\u0430\u0439\u0442\u0435 \u0435\u0433\u043E \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582446
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u0410\u0431\u0443 \u0411\u0430\u043A\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582447
    m_Localized: "\u0412\u044B\u0441\u043B\u0443\u0448\u0430\u0442\u044C \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582448
    m_Localized: "\u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0446\u0435\u043D\u0443: \u0434\u0432\u0435\u0441\u0442\u0438 \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C \u0438\u043B\u0438 \u043E\u043D
      \u0438\u0434\u0451\u0442 \u043A \u0442\u0430\u043C\u043E\u0436\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582449
    m_Localized: "\u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582450
    m_Localized: "\u0414\u0435\u043D\u044C\u0433\u0438 \u0438\u043B\u0438 \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582451
    m_Localized: "\u0421\u043E\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0432\u0435\u0441\u0442\u0438
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0438\u043B\u0438 \u043D\u0430\u0439\u0434\u0438\u0442\u0435
      \u0443\u043B\u0438\u043A\u0438 \u043F\u0440\u043E\u0442\u0438\u0432 \u0410\u0431\u0443
      \u0411\u0430\u043A\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582452
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u043F\u043E\u0438\u0441\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582453
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430
      \u0438\u043B\u0438 \u0443\u043B\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582454
    m_Localized: "\u041C\u0435\u0441\u0442\u043D\u044B\u0439 \u043C\u0435\u043D\u044F\u043B\u044B
      \u0437\u043D\u0430\u044E\u0442 \u043E \u043F\u0440\u043E\u0448\u043B\u044B\u0445
      \u0434\u0435\u043B\u0430\u0445 \u0410\u0431\u0443 \u0411\u0430\u043A\u0440\u0430
      - \u0437\u0430 \u043C\u0430\u043B\u0443\u044E \u043F\u043B\u0430\u0442\u0443
      \u043E\u043D\u0438 \u0434\u0435\u043B\u044F\u0442\u0441\u044F \u0438\u043C\u0435\u043D\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582455
    m_Localized: "\u0413\u043E\u0442\u043E\u0432\u044B \u043A \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439
      \u0441\u0434\u0435\u043B\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582456
    m_Localized: "\u0420\u0430\u0441\u0447\u0451\u0442 \u0441 \u0410\u0431\u0443
      \u0411\u0430\u043A\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582457
    m_Localized: "\u0420\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u0439\u0442\u0435\u0441\u044C
      \u0441 \u0410\u0431\u0443 \u0411\u0430\u043A\u0440\u043E\u043C \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438
      \u0438\u043B\u0438 \u0441\u0434\u0430\u0439\u0442\u0435 \u0435\u0433\u043E
      \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u044B\u043C \u0432\u043B\u0430\u0441\u0442\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582458
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0440\u0435\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582459
    m_Localized: "\u0414\u0435\u043B\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582460
    m_Localized: "\u0414\u043E\u043B\u0433 \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582461
    m_Localized: "\u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D\u0430 \u0432 \u042E\u0439\u043C\u044D\u043D\u0435
      \u0438 \u0432\u0435\u0440\u043D\u0438\u0442\u0435 \u0435\u043C\u0443 \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u043C\u043E\u043D\u0435\u0442, \u043E\u0442\u043D\u044F\u0442\u044B\u0445
      \u0441\u0435\u043C\u044C \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582462
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D\u0430
      \u0432 \u042E\u0439\u043C\u044D\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582463
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582464
    m_Localized: "\u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u043C\u043E\u043B\u0447\u0438\u0442
      \u0434\u043E\u043B\u0433\u0443\u044E \u043C\u0438\u043D\u0443\u0442\u0443,
      \u0441\u0436\u0438\u043C\u0430\u044F \u043C\u043E\u043D\u0435\u0442\u044B \u0432
      \u043A\u0443\u043B\u0430\u043A\u0435, \u043F\u043E\u0442\u043E\u043C \u043C\u043E\u043B\u0447\u0430
      \u043A\u0438\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582465
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0434\u043E\u043B\u0433 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0451\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582466
    m_Localized: "\u0421\u0435\u043C\u044C\u044F \u0432 \u0426\u0437\u044E\u0446\u044E\u0430\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582467
    m_Localized: "\u0412\u0442\u043E\u0440\u0430\u044F \u0441\u0435\u043C\u044C\u044F
      \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B\u0430 \u0438\u0437 \u042E\u0439\u043C\u044D\u043D\u044F
      \u0432 \u0426\u0437\u044E\u0446\u044E\u0430\u043D\u044C - \u043D\u0430\u0439\u0434\u0438\u0442\u0435
      \u0438\u0445 \u0438 \u0432\u0435\u0440\u043D\u0438\u0442\u0435 \u0434\u043E\u043B\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582468
    m_Localized: "\u0420\u0430\u0437\u044B\u0441\u043A\u0430\u0442\u044C \u0441\u0435\u043C\u044C\u044E
      \u0432 \u0426\u0437\u044E\u0446\u044E\u0430\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582469
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u043D\u043E\u0432\u044B\u0439 \u0430\u0434\u0440\u0435\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582470
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u0426\u0437\u044E\u0446\u044E\u0430\u043D\u044F
      \u0432\u0430\u043C \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0438\u043C\u044F
      \u043B\u0430\u0432\u043E\u0447\u043D\u0438\u043A\u0430 - \u0442\u043E\u0442
      \u0441\u0430\u043C\u044B\u0439, \u043A\u043E\u0433\u043E \u043E\u0433\u0440\u0430\u0431\u0438\u043B\u0438
      \u0432 \u0434\u043E\u0440\u043E\u0433\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582471
    m_Localized: "\u0412\u0442\u043E\u0440\u043E\u0439 \u0434\u043E\u043B\u0433 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0451\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582472
    m_Localized: "\u0421\u043B\u0443\u0436\u0431\u0430 \u0432 \u0425\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582473
    m_Localized: "\u0422\u0440\u0435\u0442\u044C\u044F \u0441\u0435\u043C\u044C\u044F
      \u0436\u0438\u0432\u0451\u0442 \u0432 \u0425\u0430\u043C\u0438. \u0413\u043B\u0430\u0432\u0430
      \u043D\u0435 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u0434\u0435\u043D\u044C\u0433\u0438
      - \u043F\u0440\u043E\u0441\u0438\u0442 \u0432\u043C\u0435\u0441\u0442\u043E
      \u044D\u0442\u043E\u0433\u043E \u0441\u043E\u0441\u043B\u0443\u0436\u0438\u0442\u044C
      \u0441\u043B\u0443\u0436\u0431\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582474
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u0432 \u0425\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582475
    m_Localized: "\u0412\u0441\u0435 \u0434\u043E\u043B\u0433\u0438 \u043F\u043E\u0433\u0430\u0448\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582476
    m_Localized: "\u041F\u0435\u0440\u0432\u0430\u044F \u0447\u0430\u0441\u0442\u044C
      \u0442\u0440\u0430\u043A\u0442\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582477
    m_Localized: "\u041F\u0435\u0440\u0432\u0430\u044F \u0447\u0430\u0441\u0442\u044C
      \u0442\u0440\u0430\u043A\u0442\u0430\u0442\u0430 \u043E\u0442\u0446\u0430 \u043F\u0440\u043E\u0434\u0430\u0451\u0442\u0441\u044F
      \u0443 \u0431\u0443\u043A\u0438\u043D\u0438\u0441\u0442\u0430 \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0430
      \u0432 \u041F\u0435\u043A\u0438\u043D\u0435 - \u043A\u0443\u043F\u0438\u0442\u0435
      \u0438\u043B\u0438 \u043E\u0431\u043C\u0435\u043D\u044F\u0439\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582478
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0430
      \u0432 \u041F\u0435\u043A\u0438\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582479
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582480
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0434\u0435\u0440\u0436\u0438\u0442
      \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C \u0437\u0430 \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u043E\u043C
      - \u0446\u0435\u043D\u0443 \u043D\u0430\u0437\u043D\u0430\u0447\u0430\u0435\u0442
      \u0432\u044B\u0441\u043E\u043A\u0443\u044E, \u043D\u043E \u0433\u043E\u0442\u043E\u0432
      \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0442\u044C \u043E\u0431\u043C\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582481
    m_Localized: "\u041F\u0435\u0440\u0432\u0430\u044F \u0447\u0430\u0441\u0442\u044C
      \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582482
    m_Localized: "\u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0441\u043A\u0430\u044F
      \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582483
    m_Localized: "\u0412\u0442\u043E\u0440\u0430\u044F \u0447\u0430\u0441\u0442\u044C
      \u0442\u0440\u0430\u043A\u0442\u0430\u0442\u0430 \u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F
      \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0435 \u0431\u043B\u0438\u0437
      \u041B\u0438\u0446\u0437\u044F\u043D\u0430 - \u043C\u043E\u043D\u0430\u0445\u0438
      \u043E\u0442\u0434\u0430\u0434\u0443\u0442 \u0435\u0451 \u0437\u0430 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u0443\u044E
      \u0443\u0441\u043B\u0443\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582484
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u043A \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582485
    m_Localized: "\u0412\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u043F\u0440\u043E\u0441\u044C\u0431\u0443
      \u043C\u043E\u043D\u0430\u0445\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582486
    m_Localized: "\u041D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C \u043F\u0440\u043E\u0441\u0438\u0442
      \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u0442\u0440\u0430\u0432\u044B \u0441 \u0433\u043E\u0440\u043D\u044B\u0445
      \u0442\u0440\u043E\u043F - \u043F\u0440\u043E\u0441\u0442\u043E\u0435 \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0435
      \u0434\u043B\u044F \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582487
    m_Localized: "\u0412\u0442\u043E\u0440\u0430\u044F \u0447\u0430\u0441\u0442\u044C
      \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582488
    m_Localized: "\u0421\u043E\u043F\u0435\u0440\u043D\u0438\u043A \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582489
    m_Localized: "\u0422\u0440\u0435\u0442\u044C\u044F \u0447\u0430\u0441\u0442\u044C
      \u0442\u0440\u0430\u043A\u0442\u0430\u0442\u0430 \u0443 \u0443\u0447\u0451\u043D\u043E\u0433\u043E-\u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0430
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435 - \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B \u043F\u043E\u043C\u043E\u0433\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582490
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u043D\u0430 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582491
    m_Localized: "\u0422\u0440\u0430\u043A\u0442\u0430\u0442 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582492
    m_Localized: "\u041B\u0430\u0434\u0430\u043D \u0434\u043B\u044F \u0424\u0430\u043C\u0435\u043D\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582493
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0438\u0442\u0435 \u043B\u0430\u0434\u0430\u043D
      \u0432 \u0431\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u0445\u0440\u0430\u043C
      \u0424\u0430\u043C\u0435\u043D\u0441\u044B \u0431\u043B\u0438\u0437 \u0427\u0430\u043D\u044A\u0430\u043D\u044F
      \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435 \u043F\u0435\u0440\u0432\u043E\u0435
      \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582494
    m_Localized: "\u0418\u0434\u0442\u0438 \u043A \u0424\u0430\u043C\u0435\u043D\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582495
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u043B\u0430\u0434\u0430\u043D
      \u043A \u0430\u043B\u0442\u0430\u0440\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582496
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u0432 \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u0432\u043E\u0439
      \u0440\u044F\u0441\u0435 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u043B\u0430\u0434\u0430\u043D \u043E\u0431\u0435\u0438\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438
      - \u0437\u0430\u043F\u0430\u0445 \u0441\u0430\u043D\u0434\u0430\u043B\u0430
      \u043D\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u0437\u0430\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582497
    m_Localized: "\u041F\u0435\u0440\u0432\u043E\u0435 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582498
    m_Localized: "\u0417\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u0438\u0439
      \u043E\u0433\u043E\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582499
    m_Localized: "\u0412 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u0433\u043E\u0440\u0438\u0442 \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u044B\u0439
      \u043E\u0433\u043E\u043D\u044C. \u041F\u0440\u043E\u0439\u0434\u0438\u0442\u0435
      \u0440\u0438\u0442\u0443\u0430\u043B \u043E\u0447\u0438\u0449\u0435\u043D\u0438\u044F
      \u0443 \u0436\u0440\u0435\u0446\u043E\u0432-\u0437\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0446\u0435\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582500
    m_Localized: "\u0414\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0434\u043E
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582501
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0440\u0438\u0442\u0443\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582502
    m_Localized: "\u0416\u0440\u0435\u0446 \u0437\u0430\u0434\u0430\u0451\u0442 \u0432\u043E\u043F\u0440\u043E\u0441\u044B
      \u043E \u043F\u0443\u0442\u0438 \u0438 \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u0438\u044F\u0445
      - \u043E\u0442\u0432\u0435\u0442 \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C
      \u0447\u0435\u0441\u0442\u043D\u044B\u043C, \u0438\u043D\u0430\u0447\u0435
      \u0440\u0438\u0442\u0443\u0430\u043B \u043D\u0435 \u043F\u0440\u0438\u043C\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582503
    m_Localized: "\u0412\u0442\u043E\u0440\u043E\u0435 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582504
    m_Localized: "\u041C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0439
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582505
    m_Localized: "\u0412 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0435 \u0441\u0442\u043E\u0438\u0442
      \u043C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0439 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C.
      \u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u0438 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u0442\u0435 \u043E\u0431\u0435\u0442."
    m_Metadata:
