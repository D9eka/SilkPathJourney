  m_TableData:
  - m_Id: 456122368
    m_Localized: "\u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 481288192
    m_Localized: "\u0413\u0438\u043B\u044C\u0434\u043C\u0430\u0441\u0442\u0435\u0440
      \u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u043F\u043E\u0440\u0443\u0447\u0438\u043B
      \u043F\u0440\u0438\u0432\u0435\u0437\u0442\u0438 \u0434\u0435\u0441\u044F\u0442\u044C
      \u0442\u044E\u043A\u043E\u0432 \u0448\u0451\u043B\u043A\u0430 \u0438\u0437
      \u0427\u0430\u043D\u044A\u0430\u043D\u044F \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434.
      \u041F\u0435\u0440\u0432\u0430\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430
      \u0434\u043B\u044F \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043E \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u0430
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 481288193
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B \u0432
      \u0411\u0443\u0445\u0430\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 481288194
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u044F \u0433\u0438\u043B\u044C\u0434\u0438\u044F
      \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u0442\u0435\u0431\u044F
      \u0432 \u0411\u0443\u0445\u0430\u0440\u0443 \u0434\u043B\u044F \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F
      \u043D\u043E\u0432\u043E\u0433\u043E \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430.
      \u0412\u0435\u0440\u043D\u0438\u0441\u044C \u0441 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u043C
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 481288195
    m_Localized: "\u041A\u043E\u043D\u0432\u043E\u0439 \u0434\u043E \u041C\u0435\u0448\u0445\u0435\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 481288196
    m_Localized: "\u0413\u0438\u043B\u044C\u0434\u0435\u0439\u0441\u043A\u0438\u0439
      \u043C\u0430\u0441\u0442\u0435\u0440 \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u043F\u043E\u0440\u0443\u0447\u0438\u043B \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0442\u043E\u0440\u0433\u043E\u0432\u0443\u044E \u0441\u0432\u044F\u0437\u044C
      \u0441 \u041C\u0435\u0448\u0445\u0435\u0434\u043E\u043C. \u0414\u043E\u0441\u0442\u0430\u0432\u044C
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u0438 \u043F\u043E\u043B\u0443\u0447\u0438
      \u043F\u0435\u0447\u0430\u0442\u044C \u0433\u0438\u043B\u044C\u0434\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 481288197
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043D\u0430 \u0411\u0430\u0433\u0434\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 481288198
    m_Localized: "\u0413\u0438\u043B\u044C\u0434\u0438\u044F \u0434\u043E\u0432\u0435\u0440\u044F\u0435\u0442
      \u0442\u0435\u0431\u0435 \u0446\u0435\u043D\u043D\u044B\u0439 \u0433\u0440\u0443\u0437
      \u0434\u043B\u044F \u0411\u0430\u0433\u0434\u0430\u0434\u0430. \u041F\u043E\u0442\u0435\u0440\u044F
      \u043D\u0435\u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u0430 - \u043D\u0430
      \u043A\u043E\u043D\u0443 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 481288199
    m_Localized: "\u041F\u0443\u0442\u044C \u043D\u0430 \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 481288200
    m_Localized: "\u0424\u0438\u043D\u0430\u043B\u044C\u043D\u044B\u0439 \u0440\u0435\u0439\u0441
      \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430
      - \u043E\u0442 \u0427\u0430\u043D\u044A\u0430\u043D\u044F \u0434\u043E \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044F.
      \u0417\u0430\u0432\u0435\u0440\u0448\u0438 \u0442\u043E, \u0447\u0442\u043E
      \u043D\u0430\u0447\u0430\u043B \u0412\u0430\u0445\u0443-\u041C\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 481288201
    m_Localized: "\u0421\u0432\u0438\u0442\u043E\u043A \u041B\u043E\u0431\u0441\u0430\u043D\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 481288202
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u041B\u043E\u0431\u0441\u0430\u043D\u0433
      \u0432\u0440\u0443\u0447\u0438\u043B \u0442\u0435\u0431\u0435 \u0441\u0432\u0438\u0442\u043E\u043A
      \u0432 \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u0432\u043E\u0439 \u0442\u043A\u0430\u043D\u0438.
      \u0414\u043E\u0441\u0442\u0430\u0432\u044C \u0435\u0433\u043E \u043C\u043E\u043D\u0430\u0445\u0443
      \u0422\u0438\u043D\u043B\u0435\u044E \u0432 \u043F\u0435\u0449\u0435\u0440\u044B
      \u041C\u043E\u0433\u0430\u043E \u0431\u043B\u0438\u0437 \u0410\u043D\u044C\u0441\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 481288203
    m_Localized: "\u0422\u0440\u0438 \u0441\u0432\u044F\u0442\u044B\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 481288204
    m_Localized: "\u041F\u043E\u0441\u0435\u0442\u0438 \u0442\u0440\u0438 \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u044B\u0445
      \u043C\u0435\u0441\u0442\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438: \u043F\u0435\u0449\u0435\u0440\u044B \u041C\u043E\u0433\u0430\u043E,
      \u043C\u0435\u0447\u0435\u0442\u044C \u0411\u0438\u0431\u0438-\u0425\u0430\u043D\u044B\u043C
      \u0438 \u0425\u0440\u0430\u043C \u041E\u0433\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 481288205
    m_Localized: "\u0413\u043E\u043B\u043E\u0441 \u0433\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 481288206
    m_Localized: "\u0412 \u0433\u043E\u0440\u0430\u0445 \u0441\u043A\u0440\u044B\u0442
      \u0445\u0440\u0430\u043C, \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u041B\u043E\u0431\u0441\u0430\u043D\u0433.
      \u041D\u0430\u0439\u0434\u0438 \u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 481288207
    m_Localized: "\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F \u0434\u0443\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 481288208
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u0445\u0440\u0430\u043C \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u043F\u0440\u043E\u0439\u0442\u0438 \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F,
      \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C
      \u0441\u0432\u043E\u044E \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 481288209
    m_Localized: "\u041F\u043E\u0441\u043B\u0430\u043D\u0438\u0435 \u0441\u0443\u0434\u044C\u0431\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 481288210
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0432\u044C \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435
      \u0438\u0437 \u0433\u043E\u0440\u043D\u043E\u0433\u043E \u0445\u0440\u0430\u043C\u0430
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434. \u0417\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435
      \u0434\u0443\u0445\u043E\u0432\u043D\u043E\u0433\u043E \u043F\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 481288211
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u043A\u043E\u043D\u0432\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 481288212
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0414\u0430\u0440\u0438\u0443\u0448
      \u043F\u043E\u0440\u0443\u0447\u0438\u043B \u0434\u043E\u0432\u0435\u0441\u0442\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432
      \u0434\u043E \u0410\u043D\u044C\u0441\u0438. \u0414\u043E\u043A\u0430\u0436\u0438,
      \u0447\u0442\u043E \u0434\u043E\u0441\u0442\u043E\u0438\u043D \u0435\u0433\u043E
      \u043D\u0430\u0441\u043B\u0435\u0434\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 481288213
    m_Localized: "\u041E\u0433\u043D\u0435\u043D\u043D\u044B\u0439 \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 481288214
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u0434\u043E\u0432\u0435\u0440\u044F\u0435\u0442
      \u0442\u0435\u0431\u0435 \u043E\u043F\u0430\u0441\u043D\u044B\u0439 \u0433\u0440\u0443\u0437
      \u0434\u043B\u044F \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0438 \u0432
      \u041C\u0435\u0448\u0445\u0435\u0434. \u041D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u0439
      \u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 481288215
    m_Localized: "\u0417\u0430\u0431\u043B\u0443\u0434\u0448\u0438\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 481288216
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u043F\u0430\u043B
      \u043D\u0430 \u043F\u0443\u0442\u0438 \u0447\u0435\u0440\u0435\u0437 \u043F\u0443\u0441\u0442\u044B\u043D\u044E.
      \u041D\u0430\u0439\u0434\u0438 \u0435\u0433\u043E \u0438 \u0432\u044B\u0432\u0435\u0434\u0438
      \u043A \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 481288217
    m_Localized: "\u0417\u0430\u0441\u0430\u0434\u0430 \u043D\u0430 \u0442\u0440\u0430\u043A\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 481288218
    m_Localized: "\u0411\u0430\u043D\u0434\u0438\u0442\u044B \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u044E\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u044B \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435.
      \u041E\u0442\u0440\u0430\u0437\u0438 \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u0435
      \u0438 \u0437\u0430\u0449\u0438\u0442\u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 481288219
    m_Localized: "\u041B\u0435\u0433\u0435\u043D\u0434\u0430 \u0434\u043E\u0440\u043E\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 481288220
    m_Localized: "\u041F\u0440\u043E\u0439\u0434\u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u0414\u0430\u0440\u0438\u0443\u0448\u0430 \u0434\u043E \u0411\u0430\u0433\u0434\u0430\u0434\u0430
      \u0438 \u0441\u0442\u0430\u043D\u044C \u043B\u0435\u0433\u0435\u043D\u0434\u043E\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043D\u044B\u0445 \u0434\u043E\u0440\u043E\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 481288221
    m_Localized: "\u041A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044C \u0438\u0437
      \u0410\u043D\u044C\u0441\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 481288222
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440 \u0427\u044D\u043D\u044C \u0412\u044D\u0439
      \u043F\u0440\u043E\u0441\u0438\u0442 \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0440\u0435\u0434\u043A\u043E\u0435 \u0441\u044B\u0440\u044C\u0451 \u0434\u043B\u044F
      \u043A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044F \u0438\u0437 \u0410\u043D\u044C\u0441\u0438
      \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 481288223
    m_Localized: "\u0423\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u044B\u0439 \u0440\u0435\u0446\u0435\u043F\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 481288224
    m_Localized: "\u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u043F\u043E\u043C\u043D\u0438\u0442
      \u0447\u0430\u0441\u0442\u044C \u0440\u0435\u0446\u0435\u043F\u0442\u0430,
      \u043D\u043E \u043A\u043B\u044E\u0447\u0435\u0432\u043E\u0439 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442
      \u0443\u0442\u0435\u0440\u044F\u043D. \u041D\u0430\u0439\u0434\u0438 \u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 481288225
    m_Localized: "\u0422\u0430\u0439\u043D\u0430 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 481288226
    m_Localized: "\u041A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u044B \u043A\u0440\u0430\u0434\u0443\u0442
      \u0441\u0435\u043A\u0440\u0435\u0442\u044B \u043A\u0440\u0430\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u043E\u0432.
      \u041F\u0440\u043E\u043D\u0438\u043A\u043D\u0438 \u0432 \u0438\u0445 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0443\u044E
      \u0438 \u0443\u0437\u043D\u0430\u0439 \u043F\u0440\u0430\u0432\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 481288227
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u043F\u0443\u0440\u043F\u0443\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 481288228
    m_Localized: "\u041F\u043E\u0441\u0442\u0440\u043E\u0439 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0443\u044E
