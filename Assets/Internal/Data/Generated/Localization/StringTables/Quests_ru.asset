  - m_Id: 18208261827330048
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0432\u0440\u0443\u0447\u0438\u043B
      \u0442\u0435\u0431\u0435 \u043A\u0430\u0440\u0442\u0443 \u0441 \u043F\u043E\u043C\u0435\u0442\u043A\u0430\u043C\u0438
      \u043D\u0430 \u0441\u0442\u0430\u0440\u043E-\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u043C.
      \u0420\u0430\u0441\u0448\u0438\u0444\u0440\u0443\u0439 \u0435\u0451 \u043D\u0430
      \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C \u043F\u0440\u0438\u0432\u0430\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 18208261869273088
    m_Localized: "\u041A\u0430\u0440\u0442\u0430 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u0430
      - \u043F\u0435\u0440\u0432\u0430\u044F \u043C\u0435\u0442\u043A\u0430 \u043C\u0435\u0436\u0434\u0443
      \u041A\u0430\u0448\u0433\u0430\u0440\u043E\u043C \u0438 \u0410\u043D\u044C\u0441\u0438,
      \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435 \u0443 \u0440\u0443\u0438\u043D
      \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u043E \u0445\u0440\u0430\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 18208261869273089
    m_Localized: "\u0413\u0438\u043B\u044C\u0434\u0438\u044F \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0430
      \u0442\u0435\u0431\u044F \u0432 \u0411\u0443\u0445\u0430\u0440\u0443 - \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C\u0441\u044F
      \u0441 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u043C \u0434\u043E\u043C\u043E\u043C
      \u0410\u043B\u044C-\u0411\u0443\u0445\u0430\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 18208261869273090
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043D.
      \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434
      \u0438 \u043E\u0442\u0447\u0438\u0442\u0430\u0439\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 18208261869273091
    m_Localized: "\u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u043E\u043F\u0438\u0441\u0430\u043B
      \u0443\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u044B\u0439 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442
      - \u043E\u0441\u043E\u0431\u043E\u0435 \u0438\u043D\u0434\u0438\u0433\u043E
      \u043E\u0442 \u0442\u0440\u0430\u0432\u043D\u0438\u043A\u0430 \u0431\u043B\u0438\u0437
      \u0410\u043D\u044C\u0441\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 18208261869273092
    m_Localized: "\u0418\u043D\u0434\u0438\u0433\u043E \u0432 \u0442\u0432\u043E\u0438\u0445
      \u0440\u0443\u043A\u0430\u0445. \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F
      \u043A \u043C\u0430\u0441\u0442\u0435\u0440\u0443 \u0427\u044D\u043D\u044E
      \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 18208261869273093
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u0434\u043E\u0432\u0435\u0440\u0438\u043B
      \u0442\u0435\u0431\u0435 \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u0439 \u0433\u0440\u0443\u0437.
      \u041D\u0435 \u0437\u0430\u0436\u0433\u0438 \u0435\u0433\u043E \u0438 \u043D\u0435
      \u0442\u0435\u0440\u044F\u0439 \u0434\u043E \u041C\u0435\u0448\u0445\u0435\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 18208261869273094
    m_Localized: "\u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u043E \u0433\u043E\u0440\u043D\u043E\u043C \u0445\u0440\u0430\u043C\u0435.
      \u0418\u0434\u0438 \u0432 \u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E\u0440\u044C\u0435
      \u0438 \u0440\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u0438 \u043C\u0435\u0441\u0442\u043D\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 18208261869273095
    m_Localized: "\u0425\u0440\u0430\u043C \u043D\u0430\u0439\u0434\u0435\u043D -
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0439\u0441\u044F \u043A \u043D\u0435\u043C\u0443
      \u043F\u043E \u0431\u0435\u043B\u043E\u0439 \u0442\u0440\u043E\u043F\u0435
      \u043C\u0438\u043C\u043E \u0441\u0442\u0435\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971050008576
    m_Localized: "\u0411\u0430\u0433\u0434\u0430\u0434\u0441\u043A\u0438\u0439 \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C
      \u043E\u0442\u0441\u0447\u0438\u0442\u0430\u043B \u0441\u0435\u0440\u0435\u0431\u0440\u043E
      \u0438 \u043F\u043E\u0436\u0430\u043B \u0440\u0443\u043A\u0443 - \u0433\u0440\u0443\u0437
      \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980096
    m_Localized: "\u0417\u043E\u043B\u043E\u0442\u044B\u0435 \u043A\u0443\u043F\u043E\u043B\u0430
      \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044F
      \u0443 \u0432\u0430\u0441 \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439.
      \u0412\u0435\u043B\u0438\u043A\u0438\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u043F\u0440\u043E\u0439\u0434\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980097
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0448\u043B\u0438 \u0447\u0435\u0440\u0435\u0437
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0433\u043E\u0440\u043D\u043E\u0433\u043E
      \u0445\u0440\u0430\u043C\u0430. \u0422\u0438\u043D\u043B\u0435\u0439 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0443 \u043F\u043E\u0440\u043E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980098
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u043A\u043E\u0441\u043D\u0443\u043B\u0441\u044F
      \u0432\u0430\u0448\u0435\u0433\u043E \u043B\u0431\u0430 - \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u0445\u0440\u0430\u043C\u0430 \u0441 \u0432\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980099
    m_Localized: "\u041F\u043E\u0441\u043B\u0430\u043D\u0438\u0435 \u043F\u0435\u0440\u0435\u0434\u0430\u043D\u043E
      \u041B\u043E\u0431\u0441\u0430\u043D\u0433\u0443 \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435.
      \u0414\u0443\u0445\u043E\u0432\u043D\u044B\u0439 \u043F\u0443\u0442\u044C \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980100
    m_Localized: "\u041E\u0433\u043D\u0435\u043D\u043D\u044B\u0439 \u0433\u0440\u0443\u0437
      \u0441\u0434\u0430\u043D \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044E
      \u0432 \u041C\u0435\u0448\u0445\u0435\u0434\u0435. \u0414\u0430\u0440\u0438\u0443\u0448
      \u0434\u043E\u0432\u043E\u043B\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980101
    m_Localized: "\u0421\u043F\u0430\u0441\u0451\u043D\u043D\u044B\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0434\u043E\u0442\u044F\u043D\u0443\u043B \u0434\u043E \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430. \u0412\u0441\u0435 \u0436\u0438\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980102
    m_Localized: "\u0422\u0440\u0430\u043A\u0442 \u0437\u0430\u0447\u0438\u0449\u0435\u043D
      \u043E\u0442 \u0437\u0430\u0441\u0430\u0434\u044B. \u041A\u0443\u043F\u0446\u044B
      \u0434\u044B\u0448\u0430\u0442 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980103
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u0432 \u0411\u0430\u0433\u0434\u0430\u0434\u0435
      \u043F\u043E\u0434\u043D\u044F\u043B \u0447\u0430\u0448\u0443 \u0437\u0430
      \u0432\u0430\u0441 - \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u044B \u043B\u0435\u0433\u0435\u043D\u0434\u0430
      \u0434\u043E\u0440\u043E\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980104
    m_Localized: "\u041F\u0443\u0440\u043F\u0443\u0440\u043D\u0430\u044F \u0442\u043A\u0430\u043D\u044C
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u0434\u0432\u043E\u0440\u0443.
      \u0418\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043B
      \u0443\u043A\u0430\u0437 \u043E \u043F\u043E\u043A\u0440\u043E\u0432\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980105
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u0442\u044E\u043A\u043E\u0432
      \u0448\u0451\u043B\u043A\u0430 \u0437\u0430\u043A\u0443\u043F\u043B\u0435\u043D\u044B
      \u0438 \u0443\u043F\u0430\u043A\u043E\u0432\u0430\u043D\u044B. \u0414\u043E\u0440\u043E\u0433\u0430
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434 \u043E\u0442\u043A\u0440\u044B\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980106
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u043E\u0448\u0451\u043B
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434. \u0428\u0451\u043B\u043A
      \u0441\u0434\u0430\u043D \u0432 \u0433\u0438\u043B\u044C\u0434\u0435\u0439\u0441\u043A\u0438\u0439
      \u0441\u043A\u043B\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980107
    m_Localized: "\u041F\u0440\u0438\u0431\u044B\u043B\u0438 \u0432 \u0411\u0443\u0445\u0430\u0440\u0443.
      \u0425\u0430\u0434\u0436\u0438 \u042E\u0441\u0443\u0444 \u0436\u0434\u0451\u0442
      \u0432\u043E \u0434\u0432\u043E\u0440\u0435 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u0434\u043E\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980108
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u043F\u0440\u0438\u0432\u0435\u0437\u0451\u043D
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434. \u0412\u0430\u0445\u0443-\u041C\u0430\u043D
      \u0436\u0434\u0451\u0442 \u043E\u0442\u0447\u0451\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980109
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D
      \u0432 \u041C\u0435\u0448\u0445\u0435\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980110
    m_Localized: "\u0413\u0440\u0443\u0437 \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D
      \u0432 \u0411\u0430\u0433\u0434\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980111
    m_Localized: "\u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044C
      - \u043A\u043E\u043D\u0435\u0446 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980112
    m_Localized: "\u041F\u0440\u0438\u0431\u044B\u043B\u0438 \u0432 \u0410\u043D\u044C\u0441\u0438.
      \u041F\u0435\u0449\u0435\u0440\u044B \u041C\u043E\u0433\u0430\u043E \u0440\u044F\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980113
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0433\u043E\u043B\u043E\u0441
      \u0443\u0441\u043B\u044B\u0448\u0430\u043D - \u0433\u043E\u043B\u043E\u0441
      \u041C\u043E\u0433\u0430\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980114
    m_Localized: "\u0412\u0442\u043E\u0440\u043E\u0439 \u0433\u043E\u043B\u043E\u0441
      \u0443\u0441\u043B\u044B\u0448\u0430\u043D - \u0433\u043E\u043B\u043E\u0441
      \u043A\u0430\u043C\u043D\u044F \u0411\u0438\u0431\u0438-\u0425\u0430\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980115
    m_Localized: "\u0422\u0440\u0435\u0442\u0438\u0439 \u0433\u043E\u043B\u043E\u0441
      \u0443\u0441\u043B\u044B\u0448\u0430\u043D. \u0412\u0441\u0435 \u0442\u0440\u0438
      \u0441\u0432\u044F\u0442\u044B\u043D\u0438 \u043F\u043E\u0441\u0435\u0449\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980116
    m_Localized: "\u041F\u0440\u0438\u0431\u044B\u043B\u0438 \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434.
      \u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u0436\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980117
    m_Localized: "\u041D\u043E\u0432\u0438\u0447\u043A\u0438 \u0432 \u0410\u043D\u044C\u0441\u0438.
      \u041A\u043E\u043D\u0432\u043E\u0439 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980118
    m_Localized: "\u041E\u0433\u043D\u0435\u043D\u043D\u044B\u0439 \u0433\u0440\u0443\u0437
      \u0432 \u041C\u0435\u0448\u0445\u0435\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980119
    m_Localized: "\u041F\u0440\u0438\u0431\u044B\u043B\u0438 \u0432 \u0411\u0430\u0433\u0434\u0430\u0434.
      \u0414\u0430\u0440\u0438\u0443\u0448 \u0436\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980120
    m_Localized: "\u0421\u044B\u0440\u044C\u0451 \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043E
      \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980121
    m_Localized: "\u041F\u0443\u0440\u043F\u0443\u0440\u043D\u0430\u044F \u0442\u043A\u0430\u043D\u044C
      \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980122
    m_Localized: "\u041F\u044F\u0442\u044B\u0439 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442
      \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u0435. \u041E\u0445\u043E\u0442\u0430
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 18412971070980123
    m_Localized: "\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435 \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043E.
      \u0425\u0440\u0430\u043C \u043E\u0442\u043A\u0440\u044B\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829307416576
    m_Localized: "\u0421\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388096
    m_Localized: "\u041E\u043F\u0440\u043E\u0441\u0438\u0442\u0435 \u0431\u044B\u0432\u0448\u0438\u0445
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445 \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u043E\u0432
      \u043E\u0442\u0446\u0430 \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u0438
      \u0438 \u0437\u0430\u043F\u0438\u0448\u0438\u0442\u0435 \u0438\u0445 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F
      \u043E \u0447\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438 \u0441\u0435\u043C\u044C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388097
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u043E\u0432
      \u043E\u0442\u0446\u0430 \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388098
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388099
    m_Localized: "\u0411\u044B\u0432\u0448\u0438\u0435 \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u044B
      \u043E\u0442\u0446\u0430 \u043F\u043E\u043C\u043D\u044F\u0442 \u043A\u0430\u0436\u0434\u0443\u044E
      \u0441\u0434\u0435\u043B\u043A\u0443, \u043D\u043E \u0431\u043E\u044F\u0442\u0441\u044F
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388100
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F \u0441\u043E\u0431\u0440\u0430\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388101
    m_Localized: "\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B \u0432 \u041B\u0443\u043E\u044F\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388102
    m_Localized: "\u0412 \u0430\u0440\u0445\u0438\u0432\u0430\u0445 \u041B\u0443\u043E\u044F\u043D\u0430
      \u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F \u043F\u043E\u0434\u043B\u0438\u043D\u043D\u044B\u0435
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435 \u0437\u0430\u043F\u0438\u0441\u0438,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u043F\u0440\u043E\u0432\u0435\u0440\u0433\u0430\u044E\u0442
      \u043E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u044F \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388103
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u0432 \u041B\u0443\u043E\u044F\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388104
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388105
    m_Localized: "\u0412 \u0430\u0440\u0445\u0438\u0432\u043D\u043E\u043C \u0437\u0430\u043B\u0435
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0441\u0442\u0430\u0440\u044B\u043C \u043B\u0430\u043A\u043E\u043C
      \u0438 \u0441\u044B\u0440\u043E\u0439 \u0431\u0443\u043C\u0430\u0433\u043E\u0439
      - \u043D\u0443\u0436\u043D\u044B\u0435 \u0441\u0432\u0438\u0442\u043A\u0438
      \u0441\u043F\u0440\u044F\u0442\u0430\u043D\u044B \u0432 \u0434\u0430\u043B\u044C\u043D\u0435\u043C
      \u0443\u0433\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388106
    m_Localized: "\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B \u043D\u0430\u0439\u0434\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388107
    m_Localized: "\u0421\u0443\u0434 \u043D\u0430\u0434 \u041B\u0443 \u0426\u0437\u044F\u043D\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388108
    m_Localized: "\u041F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0442\u0435 \u0443\u043B\u0438\u043A\u0438
      \u0446\u0437\u0435\u0434\u0443\u0448\u0438 \u0438 \u0434\u043E\u0431\u0435\u0439\u0442\u0435\u0441\u044C
      \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0439 \u0440\u0435\u0430\u0431\u0438\u043B\u0438\u0442\u0430\u0446\u0438\u0438
      \u0441\u0435\u043C\u044C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388109
    m_Localized: "\u042F\u0432\u0438\u0442\u044C\u0441\u044F \u043A \u0446\u0437\u0435\u0434\u0443\u0448\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388110
    m_Localized: "\u0421\u0435\u043C\u044C\u044F \u0440\u0435\u0430\u0431\u0438\u043B\u0438\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388111
    m_Localized: "\u0420\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u044B \u043D\u0430
      \u0437\u0430\u0441\u0442\u0430\u0432\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388112
    m_Localized: "\u0420\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u0438\u0442\u0435
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u043E\u0432 \u0438 \u043F\u043E\u0441\u0442\u043E\u0432\u044B\u0445
      \u0432 \u041B\u0430\u043D\u044C\u0447\u0436\u043E\u0443 - \u043A\u0442\u043E
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B \u0447\u0435\u0440\u0435\u0437
      \u0425\u044D\u0441\u0438-\u043A\u043E\u0440\u0438\u0434\u043E\u0440 \u0442\u0435\u043C
      \u043B\u0435\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388113
    m_Localized: "\u041F\u0440\u0438\u0439\u0442\u0438 \u043D\u0430 \u0437\u0430\u0441\u0442\u0430\u0432\u0443
      \u0432 \u041B\u0430\u043D\u044C\u0447\u0436\u043E\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829328388114
    m_Localized: "\u041E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u0441\u0442\u043E\u0432\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582400
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u043F\u043E\u043C\u043D\u0438\u0442 \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u0433\u043E
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430 \u0441 \u0442\u0440\u0435\u043C\u044F
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430\u043C\u0438 - \u043E\u043D\u0438
      \u0448\u043B\u0438 \u043D\u0430 \u0437\u0430\u043A\u0430\u0442 \u0438 \u043D\u0435
      \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582401
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0441\u043B\u0435\u0434 \u043D\u0430\u0439\u0434\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582402
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582403
    m_Localized: "\u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0432 \u042E\u0439\u043C\u044D\u043D\u0435
      \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0439 \u0434\u0432\u043E\u0440,
      \u0433\u0434\u0435 \u0432\u0438\u0434\u0435\u043B\u0438 \u041A\u044E\u043B\u044F
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0440\u0430\u0437 \u043F\u0435\u0440\u0435\u0434
      \u0438\u0441\u0447\u0435\u0437\u043D\u043E\u0432\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582404
    m_Localized: "\u0414\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0434\u043E
      \u042E\u0439\u043C\u044D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582405
    m_Localized: "\u0420\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C
      \u0445\u043E\u0437\u044F\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582406
    m_Localized: "\u0425\u043E\u0437\u044F\u0438\u043D \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u044F
      \u043F\u043E\u043C\u043D\u0438\u0442 \u0442\u0443 \u043D\u043E\u0447\u044C:
      \u0442\u044E\u0440\u043A \u0443\u0436\u0438\u043D\u0430\u043B \u043E\u0434\u0438\u043D
      \u0438 \u0432\u044B\u0448\u0435\u043B \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430
      - \u0431\u043E\u043B\u044C\u0448\u0435 \u0435\u0433\u043E \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582407
    m_Localized: "\u041C\u0430\u0440\u0448\u0440\u0443\u0442 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582408
    m_Localized: "\u041F\u0440\u0430\u0432\u0434\u0430 \u043E \u0425\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582409
    m_Localized: "\u0412 \u0425\u0430\u043C\u0438 \u0436\u0438\u0432\u0443\u0442
      \u043B\u044E\u0434\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0437\u043D\u0430\u044E\u0442
      \u0441\u0443\u0434\u044C\u0431\u0443 \u041A\u044E\u043B\u044F \u0438 \u043F\u0440\u043E\u0434\u0430\u043D\u043D\u043E\u0433\u043E
      \u0448\u0451\u043B\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582410
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u043D\u0430 \u0441\u043B\u0435\u0434
      \u0432 \u0425\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582411
    m_Localized: "\u041F\u0440\u0430\u0432\u0434\u0430 \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582412
    m_Localized: "\u0412\u044B\u0436\u0438\u0432\u0448\u0438\u0439 \u0441\u043B\u0443\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582413
    m_Localized: "\u041D\u0430\u0439\u0434\u0438\u0442\u0435 \u0432 \u0426\u0437\u044E\u0446\u044E\u0430\u043D\u0435
      \u0441\u043B\u0443\u0433\u0443 \u0420\u0443\u0441\u0442\u0430\u043C\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u0435\u0440\u0435\u0436\u0438\u043B
      \u043F\u043E\u0436\u0430\u0440 \u0438 \u0432\u0438\u0434\u0435\u043B \u043F\u043E\u0434\u0436\u0438\u0433\u0430\u0442\u0435\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 21023829332582414
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u0432\u044B\u0436\u0438\u0432\u0448\u0435\u0433\u043E
