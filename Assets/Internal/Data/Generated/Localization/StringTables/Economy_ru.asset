  - m_Id: 6593451503116295
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u0443\u0437\u0435\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 6593451503116296
    m_Localized: "\u0414\u043E\u0441\u0442\u0443\u043F \u043A \u043F\u043E\u0440\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6593451503116297
    m_Localized: "\u0421\u0435\u0440\u0434\u0446\u0435 \u041F\u043E\u0434\u043D\u0435\u0431\u0435\u0441\u043D\u043E\u0439
      \u2014 \u0432\u0435\u043B\u0438\u043A\u0430\u044F \u0441\u0442\u043E\u043B\u0438\u0446\u0430
      \u0434\u0438\u043D\u0430\u0441\u0442\u0438\u0438 \u041C\u0438\u043D. \u0417\u0434\u0435\u0441\u044C
      \u0441\u043E\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u0435\u043D\u044B
      \u043B\u0443\u0447\u0448\u0438\u0435 \u0442\u043E\u0432\u0430\u0440\u044B \u0438\u043C\u043F\u0435\u0440\u0438\u0438
      \u0438 \u043D\u0435\u0441\u043C\u0435\u0442\u043D\u044B\u0435 \u0431\u043E\u0433\u0430\u0442\u0441\u0442\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6593451503116298
    m_Localized: "\u0414\u0440\u0435\u0432\u043D\u0438\u0439 \u0433\u043E\u0440\u043E\u0434
      \u0443 \u043D\u0430\u0447\u0430\u043B\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438. \u0421\u0442\u043E\u043B\u0435\u0442\u0438\u044F\u043C\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u044B \u0443\u0445\u043E\u0434\u0438\u043B\u0438
      \u043E\u0442\u0441\u044E\u0434\u0430 \u043D\u0430 \u0437\u0430\u043F\u0430\u0434
      \u0447\u0435\u0440\u0435\u0437 \u0431\u0435\u0441\u043A\u0440\u0430\u0439\u043D\u0438\u0435
      \u0441\u0442\u0435\u043F\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6593451503116299
    m_Localized: "\u041F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u044B\u0439
      \u0433\u043E\u0440\u043E\u0434 \u043D\u0430 \u043A\u0440\u0430\u044E \u043F\u0443\u0441\u0442\u044B\u043D\u0438.
      \u0417\u0434\u0435\u0441\u044C \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B
      \u0433\u043E\u0442\u043E\u0432\u044F\u0442\u0441\u044F \u043A \u043E\u043F\u0430\u0441\u043D\u043E\u043C\u0443
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0443 \u0447\u0435\u0440\u0435\u0437
      \u0431\u0435\u0437\u0432\u043E\u0434\u043D\u044B\u0435 \u0437\u0435\u043C\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6593451503116300
    m_Localized: "\u0420\u0430\u0441\u0442\u0443\u0449\u0438\u0439 \u043F\u043E\u0440\u0442
      \u043D\u0430 \u043F\u043E\u0431\u0435\u0440\u0435\u0436\u044C\u0435. \u041C\u043E\u0440\u0441\u043A\u0438\u0435
      \u0434\u0436\u043E\u043D\u043A\u0438 \u0438 \u0440\u0435\u0447\u043D\u044B\u0435
      \u0441\u0443\u0434\u0430 \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
      \u0441\u044E\u0434\u0430 \u0442\u043E\u0432\u0430\u0440\u044B \u0441\u043E
      \u0432\u0441\u0435\u0433\u043E \u044E\u0433\u0430 \u041A\u0438\u0442\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6593451503116301
    m_Localized: "\u0416\u0435\u043C\u0447\u0443\u0436\u0438\u043D\u0430 \u044E\u0433\u0430
      \u2014 \u0433\u043E\u0440\u043E\u0434 \u043C\u0430\u0441\u0442\u0435\u0440\u043E\u0432
      \u0438 \u0442\u043A\u0430\u0447\u0435\u0439. \u0428\u0451\u043B\u043A \u0438
      \u0447\u0430\u0439 \u0438\u0437 \u0425\u0430\u043D\u0447\u0436\u043E\u0443
      \u0441\u043B\u0430\u0432\u044F\u0442\u0441\u044F \u043F\u043E \u0432\u0441\u0435\u0439
      \u0438\u043C\u043F\u0435\u0440\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6593451503116302
    m_Localized: "\u0412\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0438\u0439 \u043C\u043E\u0440\u0441\u043A\u043E\u0439
      \u043F\u043E\u0440\u0442 \u041C\u0438\u043D. \u041E\u0442\u0441\u044E\u0434\u0430
      \u043A\u043E\u0440\u0430\u0431\u043B\u0438 \u0443\u0445\u043E\u0434\u044F\u0442
      \u0432 \u042E\u0433\u043E-\u0412\u043E\u0441\u0442\u043E\u0447\u043D\u0443\u044E
      \u0410\u0437\u0438\u044E \u0438 \u0434\u0430\u043B\u0451\u043A\u0443\u044E
      \u0410\u0440\u0430\u0432\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 6593451503116303
    m_Localized: "\u042E\u0436\u043D\u044B\u0435 \u0432\u0440\u0430\u0442\u0430 \u041A\u0438\u0442\u0430\u044F.
      \u041F\u043E\u0440\u0442 \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442
      \u0438\u043C\u043F\u0435\u0440\u0438\u044E \u0441 \u0437\u0430\u043C\u043E\u0440\u0441\u043A\u0438\u043C\u0438
      \u0441\u0442\u0440\u0430\u043D\u0430\u043C\u0438 \u2014 \u043E\u0442 \u0418\u043D\u0434\u0438\u0438
      \u0434\u043E \u043E\u0441\u0442\u0440\u043E\u0432\u043E\u0432 \u041F\u0440\u044F\u043D\u043E\u0441\u0442\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 6593451503116304
    m_Localized: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
