      \u041F\u043E\u0442\u0430\u043B\u0430 \u0432\u043E\u0437\u0432\u044B\u0448\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430\u0434 \u0434\u043E\u043B\u0438\u043D\u043E\u0439. \u041C\u043E\u043D\u0430\u0445\u0438
      \u0445\u0440\u0430\u043D\u044F\u0442 \u0434\u0440\u0435\u0432\u043D\u044E\u044E
      \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 7217665176231948
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u0433\u043E\u0440\u043E\u0434
