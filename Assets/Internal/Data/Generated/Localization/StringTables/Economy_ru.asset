    m_Metadata:
      m_Items: []
  - m_Id: 7217665172037675
    m_Localized: "\u041E\u0430\u0437\u0438\u0441 \u043D\u0430 \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u043C
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0435 \u0447\u0435\u0440\u0435\u0437
      \u0422\u0430\u043A\u043B\u0430-\u041C\u0430\u043A\u0430\u043D. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u044B
      \u0437\u0430\u043F\u0430\u0441\u0430\u044E\u0442\u0441\u044F \u0432\u043E\u0434\u043E\u0439
      \u043F\u0435\u0440\u0435\u0434 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u043E\u043C
      \u0447\u0435\u0440\u0435\u0437 \u043F\u0443\u0441\u0442\u044B\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 7217665172037676
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u0434\u0440\u0435\u0432\u043D\u0435\u0439\u0448\u0438\u0445
      \u0431\u0430\u0437\u0430\u0440\u043E\u0432 \u043C\u0438\u0440\u0430. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u044B
      \u0441 \u0432\u043E\u0441\u0442\u043E\u043A\u0430 \u0438 \u0437\u0430\u043F\u0430\u0434\u0430
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0442\u0441\u044F \u043F\u043E\u0434
      \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u043C\u0438 \u0441\u0432\u043E\u0434\u0430\u043C\u0438
      \u043A\u0440\u044B\u0442\u043E\u0433\u043E \u0440\u044B\u043D\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7217665172037677
    m_Localized: "\u0421\u0432\u044F\u0449\u0435\u043D\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E
      \u0441\u043B\u0438\u044F\u043D\u0438\u044F \u0413\u0430\u043D\u0433\u0430 \u0438
      \u042F\u043C\u0443\u043D\u044B. \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438
      \u0441\u043E \u0432\u0441\u0435\u0439 \u0418\u043D\u0434\u0438\u0438 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
      \u043E\u043C\u044B\u0442\u044C\u0441\u044F \u0432 \u0441\u0432\u044F\u0442\u044B\u0445
      \u0432\u043E\u0434\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 7217665172037678
    m_Localized: "\u041A\u0440\u0435\u043F\u043E\u0441\u0442\u044C \u043D\u0430 \u0441\u0442\u044B\u043A\u0435
      \u043C\u0438\u0440\u043E\u0432. \u041A\u0440\u0435\u0441\u0442\u043E\u043D\u043E\u0441\u0446\u044B
      \u0438 \u043C\u0443\u0441\u0443\u043B\u044C\u043C\u0430\u043D\u0435 \u0432\u0435\u043A\u0430\u043C\u0438
      \u0441\u0440\u0430\u0436\u0430\u043B\u0438\u0441\u044C \u0437\u0430 \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C
      \u043D\u0430\u0434 \u044D\u0442\u0438\u043C \u043F\u043E\u0431\u0435\u0440\u0435\u0436\u044C\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 7217665172037679
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0430\u044F
      \u0437\u0430\u0441\u0442\u0430\u0432\u0430. \u0417\u0430 \u0441\u0442\u0435\u043D\u0430\u043C\u0438
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0431\u0435\u0441\u043A\u0440\u0430\u0439\u043D\u044F\u044F
      \u043F\u0443\u0441\u0442\u044B\u043D\u044F \u0438 \u0437\u0435\u043C\u043B\u0438
      \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 7217665172037680
    m_Localized: "\u041F\u044B\u043B\u044C\u043D\u044B\u0439 \u043F\u043E\u0440\u0442
      \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443 \u041A\u0440\u0430\u0441\u043D\u043E\u0433\u043E
      \u043C\u043E\u0440\u044F. \u041E\u0442\u0441\u044E\u0434\u0430 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438
      \u043E\u0442\u043F\u043B\u044B\u0432\u0430\u044E\u0442 \u043A \u0441\u0432\u044F\u0442\u044B\u043C
      \u0433\u043E\u0440\u043E\u0434\u0430\u043C \u0410\u0440\u0430\u0432\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 7217665172037681
    m_Localized: "\u041A\u0440\u0443\u0433\u043B\u044B\u0439 \u0433\u043E\u0440\u043E\u0434
      \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443 \u0422\u0438\u0433\u0440\u0430.
      \u0414\u043E\u043C \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u0438 \u0445\u0440\u0430\u043D\u0438\u0442
      \u0437\u043D\u0430\u043D\u0438\u044F \u0432\u0441\u0435\u0433\u043E \u043C\u0438\u0440\u0430.
      \u0425\u0430\u043B\u0438\u0444 \u043F\u0440\u0430\u0432\u0438\u0442 \u0438\u0437
      \u0437\u043E\u043B\u043E\u0442\u043E\u0433\u043E \u0434\u0432\u043E\u0440\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7217665172037682
    m_Localized: "\u041C\u0430\u0442\u044C \u0433\u043E\u0440\u043E\u0434\u043E\u0432
      \u2014 \u0434\u0440\u0435\u0432\u043D\u0435\u0439\u0448\u0438\u0439 \u0438\u0437
