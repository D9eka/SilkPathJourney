  - m_Id: 30370297315196928
    m_Localized: "\u0417\u0430\u0439\u0434\u0443 \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168448
    m_Localized: "\u0412\u044B \u0443\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u043A\u043E\u0448\u0435\u043B\u044C
      \u0437\u0430 \u043F\u043E\u044F\u0441. \u0412\u0430\u0445\u0443-\u041C\u0430\u043D
      \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442 \u043F\u043B\u0435\u0447\u0430\u043C\u0438:
      \xAB\u0413\u0438\u043B\u044C\u0434\u0438\u044F \u043D\u0435 \u0437\u0430\u043F\u0438\u0440\u0430\u0435\u0442
      \u0434\u0432\u0435\u0440\u0435\u0439. \u041A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0448\u044C
      \u0433\u043E\u0442\u043E\u0432 \u2014 \u0437\u0430\u0445\u043E\u0434\u0438.\xBB
      \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442
      \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442 \u0432 \u0435\u0433\u043E
      \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168449
    m_Localized: "\u0417\u0430\u0439\u0434\u0443 \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168450
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043B\u0430\u0434\u043E\u043D\u0438: \xAB\u041F\u0443\u0442\u044C \u043D\u0435
      \u0438\u0441\u0447\u0435\u0437\u043D\u0435\u0442. \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0448\u044C \u0433\u043E\u0442\u043E\u0432.\xBB
      \u0421\u0435\u0440\u0435\u0431\u0440\u043E \u043E\u043D \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0432\u0430\u043C \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0441\u043B\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168451
    m_Localized: "\u041E\u0431\u0434\u0443\u043C\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168452
    m_Localized: "\u0421\u0442\u0430\u0440\u0448\u0438\u043D\u0430 \u043A\u0438\u0432\u0430\u0435\u0442
      \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B: \xAB\u0414\u0430\u0440\u0438\u0443\u0448
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u2014 \u0442\u044B \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u0435\u043D.
      \u041F\u0440\u0438\u0445\u043E\u0434\u0438, \u043A\u043E\u0433\u0434\u0430
      \u0440\u0435\u0448\u0438\u0448\u044C.\xBB \u0413\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u0439
      \u043E\u0433\u043E\u043D\u044C \u0443\u0436\u0435 \u0432 \u0432\u0430\u0448\u0435\u043C
      \u043C\u0435\u0448\u043A\u0435, \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168453
    m_Localized: "\u0417\u0430\u0439\u0434\u0443 \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168454
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440 \u0427\u044D\u043D\u044C \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u0441\u0432\u0451\u0440\u0442\u043A\u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u043D\u0430 \u043F\u043E\u043B\u043A\u0443. \xAB\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F
      \u043D\u0435 \u043F\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u0435\u0442.
      \u041A\u043E\u0433\u0434\u0430 \u043D\u0430\u0434\u0443\u043C\u0430\u0435\u0448\u044C
      \u2014 \u0434\u0432\u0435\u0440\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u0430.\xBB
      \u0421\u0435\u0440\u0435\u0431\u0440\u043E \u043E\u043D \u043E\u0442\u0434\u0430\u0451\u0442
      \u0432\u0430\u043C \u0441\u0435\u0439\u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168455
    m_Localized: "\u0417\u0430\u0439\u043C\u0443\u0441\u044C \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168456
    m_Localized: "\u0412\u044B \u0441\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0435
      \u043A\u0430\u0440\u0442\u0443 \u0438 \u0443\u0431\u0438\u0440\u0430\u0435\u0442\u0435
      \u0432 \u0441\u0443\u043C\u043A\u0443. \u0417\u0430\u0433\u0430\u0434\u043A\u0430
      \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435 \u0434\u0435\u043D\u0435\u0442\u0441\u044F
      \u2014 \u0432\u0440\u0435\u043C\u044F \u0434\u043B\u044F \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0438
      \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u043F\u0440\u0438\u0432\u0430\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168457
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168458
    m_Localized: "\u0412\u044B \u043F\u0440\u044F\u0447\u0435\u0442\u0435 \u0444\u0438\u0433\u0443\u0440\u043A\u0443
      \u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u043E. \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434
      \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442 \u0432 \u0410\u0440\u0445\u0438\u0432\u0435
      \u2014 \u0424\u0430\u0440\u0443\u0445 \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442.
      \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u0442\u043E\u0447\u043A\u0430
      \u043A\u0430\u0440\u0442\u044B \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0441\u0430\u043C\u0438 \u0431\u0443\u0434\u0435\u0442\u0435
      \u0433\u043E\u0442\u043E\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168459
    m_Localized: "\u0415\u0449\u0451 \u043D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168460
    m_Localized: "\u0412\u044B \u0434\u0435\u043B\u0430\u0435\u0442\u0435 \u0448\u0430\u0433
      \u043D\u0430\u0437\u0430\u0434. \u0412\u0430\u0445\u0443-\u041C\u0430\u043D
      \u043A\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u043D\u0438\u043C\u0430\u044E\u0449\u0435
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E:
      \xAB\u042F \u0431\u0443\u0434\u0443 \u0436\u0434\u0430\u0442\u044C \u0432 \u0433\u0438\u043B\u044C\u0434\u0438\u0438
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430. \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0448\u044C \u0433\u043E\u0442\u043E\u0432.\xBB
      \u041A\u0443\u043F\u043E\u043B\u0430 \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044F
      \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168461
    m_Localized: "\u0412\u0435\u0440\u0448\u0438\u043D\u0430 \u043F\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168462
    m_Localized: "\u0412\u044B\u0441\u043E\u043A\u043E\u0433\u043E\u0440\u043D\u044B\u0439
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u0441\u0442\u043E\u0438\u0442
      \u0432 \u0442\u0438\u0448\u0438\u043D\u0435 \u2014 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u043C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u0444\u043B\u0430\u0433\u0438
      \u0442\u0440\u0435\u043F\u0435\u0449\u0443\u0442 \u043D\u0430\u0434 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C\u044E.
      \u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0443 \u0432\u0445\u043E\u0434\u0430. \u041E\u043D \u0434\u043E\u043B\u0433\u043E
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442, \u043F\u043E\u0442\u043E\u043C
      \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F. \xAB\u0422\u044B \u043F\u0440\u043E\u0448\u0451\u043B
      \u0432\u0441\u0451. \u041F\u043E\u0441\u043B\u0430\u043D\u0438\u044F \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B,
      \u0445\u0440\u0430\u043C\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044B.
      \u041F\u0443\u0442\u044C \u0434\u0443\u0445\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D.\xBB
      \u041E\u043D \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043B\u0430\u0434\u043E\u043D\u0438.
      \xAB\u0421\u043B\u043E\u0432\u043E \u0437\u0430 \u0442\u043E\u0431\u043E\u0439:
      \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0443
      \u0441\u0435\u0439\u0447\u0430\u0441 \u2014 \u0438\u043B\u0438 \u043F\u043E\u0431\u044B\u0442\u044C
      \u0435\u0449\u0451?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168463
    m_Localized: "\u041F\u0443\u0442\u044C \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168464
    m_Localized: "\u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F
      \u0433\u043B\u0443\u0431\u043E\u043A\u043E. \xAB\u0422\u044B \u043F\u0440\u0438\u043D\u0451\u0441
      \u0441\u0432\u0435\u0442 \u0442\u0443\u0434\u0430, \u0433\u0434\u0435 \u0435\u0433\u043E
      \u043D\u0435 \u0436\u0434\u0430\u043B\u0438. \u0418\u0434\u0438 \u0441 \u043C\u0438\u0440\u043E\u043C.\xBB
      \u0413\u043E\u0440\u043D\u0430\u044F \u0442\u0438\u0448\u0438\u043D\u0430 \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u0435\u0442
      \u0432\u0430\u0441 \u2014 \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C \u0434\u0443\u0445\u0430 \u043F\u0440\u043E\u0439\u0434\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168465
    m_Localized: "\u0415\u0449\u0451 \u043D\u0435 \u0432\u0440\u0435\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168466
    m_Localized: "\u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u043A\u0438\u0432\u0430\u0435\u0442
      \u0431\u0435\u0437 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u044F.
      \xAB\u0414\u043E\u0440\u043E\u0433\u0430 \u0441\u0430\u043C\u0430 \u0441\u043A\u0430\u0436\u0435\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u043F\u0440\u0438\u0448\u043B\u043E \u0432\u0440\u0435\u043C\u044F.
      \u042F \u0436\u0434\u0443 \u0443 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F
      \u0432 \u0410\u043D\u044C\u0441\u0438. \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168467
    m_Localized: "\u041B\u0435\u0433\u0435\u043D\u0434\u0430 \u0434\u043E\u0440\u043E\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168468
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0411\u0430\u0433\u0434\u0430\u0434\u0430
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B. \u0423\u043B\u0438\u0446\u044B
      \u043F\u0430\u0445\u043D\u0443\u0442 \u043F\u0440\u044F\u043D\u043E\u0441\u0442\u044F\u043C\u0438
      \u0438 \u0434\u044B\u043C\u043E\u043C \u043A\u0443\u0437\u043D\u0438\u0446.
      \u0414\u0430\u0440\u0438\u0443\u0448\u0435\u0432 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u043F\u0440\u043E\u0439\u0434\u0435\u043D \u043E\u0442 \u043F\u0435\u0440\u0432\u043E\u0433\u043E
      \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u043A\u0430\u043C\u043D\u044F.
      \u0421\u0442\u0430\u0440\u044B\u0439 \u0414\u0430\u0440\u0438\u0443\u0448,
      \u0434\u043E\u0436\u0434\u0430\u0432\u0448\u0438\u0439\u0441\u044F \u0432\u0430\u0441
      \u0432 \u0442\u0435\u043D\u0438 \u043F\u0430\u043B\u044C\u043C\u044B \u0443
      \u0432\u043E\u0440\u043E\u0442, \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0438 \u043C\u043E\u043B\u0447\u0438\u0442 \u0434\u043E\u043B\u0433\u043E.
      \u041F\u043E\u0442\u043E\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442:
      \xAB\u0421\u043E\u0440\u043E\u043A \u043B\u0435\u0442 \u044F \u0448\u0451\u043B
      \u044D\u0442\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u043E\u0439. \u0422\u0435\u043F\u0435\u0440\u044C
      \u043E\u043D\u0430 \u0442\u0432\u043E\u044F. \u0427\u0442\u043E \u0440\u0435\u0448\u0430\u0435\u0448\u044C
      \u2014 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0442\u043E\u0447\u043A\u0443
      \u0438\u043B\u0438 \u0434\u0430\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0435
      \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168469
    m_Localized: "\u0421\u0442\u0430\u0442\u044C \u043B\u0435\u0433\u0435\u043D\u0434\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168470
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u043A\u0440\u0435\u043F\u043A\u043E
      \u0436\u043C\u0451\u0442 \u0432\u0430\u0448\u0443 \u0440\u0443\u043A\u0443
      \u2014 \u0434\u0432\u0430 \u043F\u0430\u043B\u044C\u0446\u0430 \u043D\u0435
      \u0441\u0433\u0438\u0431\u0430\u044E\u0442\u0441\u044F, \u043D\u043E \u0445\u0432\u0430\u0442\u043A\u0430
      \u0436\u0435\u043B\u0435\u0437\u043D\u0430\u044F. \xAB\u041B\u0435\u0433\u0435\u043D\u0434\u0430
      \u0434\u043E\u0440\u043E\u0433. \u0417\u0430\u043F\u043E\u043C\u043D\u0438
      \u044D\u0442\u043E.\xBB \u0418\u043C\u044F \u0432\u0430\u0448\u0435\u0433\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0432\u043E\u0439\u0434\u0451\u0442
      \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168471
    m_Localized: "\u0415\u0449\u0451 \u043D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168472
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u0445\u043C\u044B\u043A\u0430\u0435\u0442.
      \xAB\u0425\u043E\u0440\u043E\u0448\u043E. \u0414\u043E\u0440\u043E\u0433\u0430
      \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435 \u0434\u0435\u043D\u0435\u0442\u0441\u044F.\xBB
      \u041E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043C\u0435\u0441\u0442\u043E,
      \u0433\u0434\u0435 \u0431\u0443\u0434\u0435\u0442 \u0436\u0434\u0430\u0442\u044C
      \u2014 \u0443 \u0432\u043E\u0440\u043E\u0442 \u0411\u0430\u0433\u0434\u0430\u0434\u0430,
      \u043A\u0430\u043A \u0432\u0441\u0435\u0433\u0434\u0430. \xAB\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0440\u0435\u0448\u0438\u0448\u044C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168473
    m_Localized: "\u0422\u0430\u0439\u043D\u0430 \u043F\u0443\u0440\u043F\u0443\u0440\u0430
      \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168474
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u0427\u044D\u043D\u044C
      \u0412\u044D\u044F \u043F\u043E\u0433\u0440\u0443\u0436\u0435\u043D\u0430 \u0432
      \u0437\u0430\u043F\u0430\u0445 \u0433\u043E\u0440\u044F\u0447\u0435\u0433\u043E
      \u0438\u043D\u0434\u0438\u0433\u043E \u0438 \u0432\u043E\u0441\u043A\u0430.
      \u041D\u0430 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u043C \u0441\u0442\u043E\u043B\u0435
      \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438 \u0440\u0430\u0437\u043B\u043E\u0436\u0435\u043D\u044B
      \u0442\u043A\u0430\u043D\u0438 \u2014 \u043F\u0443\u0440\u043F\u0443\u0440,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0435 \u0432\u044B\u0446\u0432\u0435\u0442\u0430\u0435\u0442.
      \u0414\u0435\u043B\u043E \u0432\u0441\u0435\u0439 \u0436\u0438\u0437\u043D\u0438
      \u043C\u0430\u0441\u0442\u0435\u0440\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E.
      \u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0442\u043A\u0430\u043D\u0438 \u0434\u043E\u043B\u0433\u043E,
      \u043F\u043E\u0442\u043E\u043C \u043D\u0430 \u0432\u0430\u0441. \xAB\u0421\u0435\u043A\u0440\u0435\u0442
      \u0442\u0435\u043F\u0435\u0440\u044C \u0436\u0438\u0432\u0451\u0442 \u043D\u0435
      \u0442\u043E\u043B\u044C\u043A\u043E \u0432 \u043C\u043E\u0438\u0445 \u0440\u0443\u043A\u0430\u0445.
      \u041F\u0443\u0442\u044C \u043E\u043A\u043E\u043D\u0447\u0435\u043D \u2014
      \u0438\u043B\u0438 \u0442\u044B \u0445\u043E\u0447\u0435\u0448\u044C \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
      \u0435\u0449\u0451?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168475
    m_Localized: "\u041F\u0443\u0442\u044C \u043F\u0440\u043E\u0439\u0434\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168476
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440 \u0427\u044D\u043D\u044C \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F
      \u043D\u0438\u0437\u043A\u043E. \xAB\u0422\u044B \u0434\u043E\u0441\u0442\u043E\u0438\u043D
      \u0437\u043D\u0430\u0442\u044C \u0442\u043E, \u0447\u0442\u043E \u0437\u043D\u0430\u044E
      \u044F.\xBB \u0421\u0435\u043A\u0440\u0435\u0442 \u043F\u0443\u0440\u043F\u0443\u0440\u0430
      \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D. \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C \u0448\u0451\u043B\u043A\u043E\u0442\u043A\u0430\u0447\u0435\u0439
      \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168477
    m_Localized: "\u0415\u0449\u0451 \u043D\u0435 \u0432\u0440\u0435\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168478
    m_Localized: "\u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u0442\u043A\u0430\u043D\u0438 \u0432 \u0441\u0443\u043D\u0434\u0443\u043A.
      \xAB\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u0436\u0434\u0451\u0442.
      \u042F \u0437\u0434\u0435\u0441\u044C \u2014 \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u0435,
      \u043A\u0430\u043A \u0432\u0441\u0435\u0433\u0434\u0430.\xBB \u0414\u0432\u0435\u0440\u044C
      \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168479
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168480
    m_Localized: "\u0410\u0440\u0445\u0438\u0432\u043D\u0430\u044F \u043A\u043E\u043C\u043D\u0430\u0442\u0430
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435. \u041D\u0430
      \u0441\u0442\u043E\u043B\u0435 \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438
      \u2014 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F,
      \u0440\u044F\u0434\u043E\u043C \u0441 \u043A\u0430\u0440\u0442\u043E\u0439
      \u0424\u0430\u0440\u0443\u0445\u0430, \u0433\u0434\u0435 \u043A\u0430\u0436\u0434\u0430\u044F
      \u0442\u043E\u0447\u043A\u0430 \u0437\u0430\u0447\u0451\u0440\u043A\u043D\u0443\u0442\u0430.
      \u0424\u0430\u0440\u0443\u0445 \u0441\u0442\u043E\u0438\u0442 \u0432 \u0434\u0432\u0435\u0440\u044F\u0445,
      \u0432 \u0440\u0443\u043A\u0430\u0445 \u0447\u0430\u0448\u043A\u0430 \u0447\u0451\u0440\u043D\u043E\u0433\u043E
      \u0447\u0430\u044F. \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0438 \u043C\u043E\u043B\u0447\u0430,
      \u043F\u043E\u0442\u043E\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442:
      \xAB\u041A\u0430\u0440\u0442\u0430 \u0441\u043A\u0430\u0437\u0430\u043B\u0430
      \u0432\u0441\u0451. \u041F\u0443\u0442\u044C \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D.
      \u0418\u043B\u0438 \u0442\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C,
      \u0447\u0442\u043E \u0435\u0449\u0451 \u043D\u0435 \u0433\u043E\u0442\u043E\u0432
      \u0443\u0445\u043E\u0434\u0438\u0442\u044C?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168481
    m_Localized: "\u041E\u0445\u043E\u0442\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168482
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0441\u0442\u0430\u0432\u0438\u0442
      \u0447\u0430\u0448\u043A\u0443 \u043D\u0430 \u0441\u0442\u043E\u043B \u0438
      \u043A\u0438\u0432\u0430\u0435\u0442. \xAB\u042F \u0437\u043D\u0430\u043B,
      \u0447\u0442\u043E \u0442\u044B \u0434\u043E\u0439\u0434\u0451\u0448\u044C.\xBB
      \u0420\u0435\u043B\u0438\u043A\u0432\u0438\u0438 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438 \u043D\u0430\u0439\u0434\u0435\u043D\u044B. \u0410\u0440\u0445\u0438\u0432
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168483
    m_Localized: "\u0415\u0449\u0451 \u043D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168484
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0434\u043E\u043F\u0438\u0432\u0430\u0435\u0442
      \u0447\u0430\u0439. \xAB\u041A\u0430\u043A \u0437\u043D\u0430\u0435\u0448\u044C.
      \u0410\u0440\u0445\u0438\u0432 \u0437\u0434\u0435\u0441\u044C \u2014 \u0432
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435, \u043A\u0430\u043A
      \u0438 \u043F\u0440\u0435\u0436\u0434\u0435.\xBB \u041E\u043D \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0438 \u043D\u0430 \u0441\u0442\u043E\u043B\u0435.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168485
    m_Localized: "\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434. \u0413\u0438\u043B\u044C\u0434\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168486
    m_Localized: "\u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0432 \u0442\u043E\u043C \u0436\u0435 \u043A\u0440\u0435\u0441\u043B\u0435,
      \u0447\u0442\u043E \u0438 \u0432 \u043F\u0435\u0440\u0432\u044B\u0439 \u0434\u0435\u043D\u044C.
      \u041F\u0435\u0447\u0430\u0442\u044C \u0433\u0438\u043B\u044C\u0434\u0438\u0438
      \u043B\u0435\u0436\u0438\u0442 \u043D\u0430 \u0441\u0442\u043E\u043B\u0435
      \u2014 \u0436\u0434\u0451\u0442. \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0441, \u043F\u043E\u0442\u043E\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442:
      \xAB\u041A\u0443\u043F\u043E\u043B\u0430 \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044F
      \u0432\u0441\u0451 \u0435\u0449\u0451 \u0442\u0430\u043C. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0433\u043E\u0442\u043E\u0432. \u0421\u043B\u043E\u0432\u043E \u0437\u0430
      \u0442\u043E\u0431\u043E\u0439.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168487
    m_Localized: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362752
    m_Localized: "\u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0432\u0441\u0442\u0430\u0451\u0442
      \u0438 \u0431\u0435\u0440\u0451\u0442 \u043A\u043E\u0448\u0435\u043B\u044C.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u0437\u0430\u043F\u0430\u0434\u0443. \u041D\u0430 \u044D\u0442\u043E\u0442
      \u0440\u0430\u0437 \u0432\u044B \u0432\u0445\u043E\u0434\u0438\u0442\u0435
      \u0432 \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362753
    m_Localized: "\u041F\u043E\u0434\u043E\u0436\u0434\u0443 \u0435\u0449\u0451"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362754
    m_Localized: "\u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0440\u0430\u0437\u0432\u043E\u0434\u0438\u0442
      \u0440\u0443\u043A\u0430\u043C\u0438: \xAB\u0413\u0438\u043B\u044C\u0434\u0438\u044F
      \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442.\xBB \u0414\u0432\u0435\u0440\u044C
      \u0435\u0433\u043E \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043F\u0440\u0438\u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362755
    m_Localized: "\u0410\u043D\u044C\u0441\u0438. \u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362756
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0443 \u043F\u043E\u0440\u043E\u0433\u0430 \u043F\u0435\u0449\u0435\u0440
      \u041C\u043E\u0433\u0430\u043E. \u041B\u0430\u043C\u043F\u0430\u0434\u044B
      \u0433\u043E\u0440\u044F\u0442, \u0437\u0430\u043F\u0430\u0445 \u0431\u043B\u0430\u0433\u043E\u0432\u043E\u043D\u0438\u0439
      \u043F\u0440\u0435\u0436\u043D\u0438\u0439. \u041C\u043E\u043D\u0430\u0445
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E.
      \xAB\u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u0436\u0434\u0451\u0442 \u0432
      \u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E\u0440\u044C\u0435. \u041F\u0443\u0442\u044C
      \u0434\u0443\u0445\u0430 \u043E\u0442\u043A\u0440\u044B\u0442. \u0422\u044B
      \u0433\u043E\u0442\u043E\u0432 \u0432\u044B\u0439\u0442\u0438?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362757
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u043D\u0430 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362758
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F
      \u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u0435\u0442 \u043B\u0430\u0434\u0430\u043D.
      \u0413\u043E\u0440\u043D\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0430.
      \u041F\u0443\u0442\u044C \u0434\u0443\u0445\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0441\u044F
      \u0442\u0430\u043C, \u0433\u0434\u0435 \u043D\u0430\u0447\u0430\u043B\u0441\u044F
      \u2014 \u0443 \u0432\u0435\u0440\u0448\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362759
    m_Localized: "\u0415\u0449\u0451 \u043D\u0435 \u0433\u043E\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362760
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043B\u0430\u0434\u043E\u043D\u0438: \xAB\u0413\u043E\u0440\u044B \u0436\u0434\u0443\u0442
      \u0442\u0435\u0440\u043F\u0435\u043B\u0438\u0432\u043E. \u042F \u0437\u0434\u0435\u0441\u044C
      \u2014 \u0432 \u041C\u043E\u0433\u0430\u043E \u2014 \u043A\u043E\u0433\u0434\u0430
      \u043D\u0430\u0434\u0443\u043C\u0430\u0435\u0448\u044C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362761
    m_Localized: "\u0411\u0430\u0433\u0434\u0430\u0434. \u0423 \u0432\u043E\u0440\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362762
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u0441\u0442\u043E\u0438\u0442
      \u0432 \u0442\u0435\u043D\u0438 \u043F\u0430\u043B\u044C\u043C\u044B \u0443
      \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0445 \u0432\u043E\u0440\u043E\u0442
      \u2014 \u0442\u0430\u043C, \u0433\u0434\u0435 \u043E\u0431\u0435\u0449\u0430\u043B.
      \u041B\u0438\u0446\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0435,
      \u0433\u043B\u0430\u0437\u0430 \u0436\u0438\u0432\u044B\u0435. \xAB\u041C\u0430\u0440\u0448\u0440\u0443\u0442
      \u043F\u0440\u043E\u0439\u0434\u0435\u043D, \u0433\u0440\u0443\u0437 \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D.
      \u041E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043E\u0434\u043D\u043E:
      \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0442\u043E\u0447\u043A\u0443.
      \u0413\u043E\u0442\u043E\u0432?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362763
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0442\u043E\u0447\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362764
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u0436\u043C\u0451\u0442 \u0432\u0430\u0448\u0443
      \u0440\u0443\u043A\u0443 \u2014 \u043A\u0440\u0435\u043F\u043A\u043E, \u043A\u0430\u043A
      \u0443\u043C\u0435\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u043F\u0440\u043E\u0436\u0438\u0432\u0448\u0438\u0439 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0430\u0445
      \u0441\u043E\u0440\u043E\u043A \u043B\u0435\u0442. \xAB\u041B\u0435\u0433\u0435\u043D\u0434\u0430
      \u0434\u043E\u0440\u043E\u0433. \u0417\u0430\u043F\u043E\u043C\u043D\u0438
      \u044D\u0442\u043E.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362765
    m_Localized: "\u0415\u0449\u0451 \u043D\u0435 \u0432\u0440\u0435\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362766
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u0445\u043C\u044B\u043A\u0430\u0435\u0442.
      \xAB\u0414\u043E\u0440\u043E\u0433\u0430 \u043D\u0438\u043A\u0443\u0434\u0430
      \u043D\u0435 \u0434\u0435\u043D\u0435\u0442\u0441\u044F. \u042F \u0443 \u0432\u043E\u0440\u043E\u0442
      \u2014 \u043A\u0430\u043A \u0432\u0441\u0435\u0433\u0434\u0430.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362767
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C. \u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362768
    m_Localized: "\u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0441\u0443\u043D\u0434\u0443\u043A \u0441 \u0442\u043A\u0430\u043D\u044F\u043C\u0438.
      \u041F\u0443\u0440\u043F\u0443\u0440 \u043B\u0435\u0436\u0438\u0442 \u0441\u0432\u0435\u0440\u0445\u0443
      \u2014 \u043D\u0435 \u0432\u044B\u0446\u0432\u0435\u043B. \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0441 \u043F\u043E\u0432\u0435\u0440\u0445 \u0441\u0443\u043D\u0434\u0443\u043A\u0430.
      \xAB\u0421\u0435\u043A\u0440\u0435\u0442 \u0436\u0438\u0432. \u0414\u0435\u043B\u043E
      \u0436\u0434\u0451\u0442 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044F.
      \u0413\u043E\u0442\u043E\u0432 \u043B\u0438 \u0442\u044B \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C
      \u0442\u043E, \u0447\u0442\u043E \u043D\u0430\u0447\u0430\u043B?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362769
    m_Localized: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0434\u0435\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362770
    m_Localized: "\u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u043A\u043B\u0430\u0434\u0451\u0442
      \u0442\u043A\u0430\u043D\u044C \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0438
      \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F. \xAB\u041F\u0443\u0442\u044C
      \u0448\u0451\u043B\u043A\u0430 \u043F\u0440\u043E\u0439\u0434\u0435\u043D.
      \u0417\u043D\u0430\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F.\xBB
      \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C \u043C\u0430\u0441\u0442\u0435\u0440\u0430
      \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362771
    m_Localized: "\u041D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362772
    m_Localized: "\u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0441\u0443\u043D\u0434\u0443\u043A. \xAB\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F
      \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435 \u0443\u0439\u0434\u0451\u0442.
      \u042F \u0437\u0434\u0435\u0441\u044C, \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u0435.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362773
    m_Localized: "\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434. \u0410\u0440\u0445\u0438\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362774
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0432 \u0430\u0440\u0445\u0438\u0432\u043D\u043E\u0439
      \u043A\u043E\u043C\u043D\u0430\u0442\u0435. \u0420\u0435\u043B\u0438\u043A\u0432\u0438\u0438
      \u0440\u0430\u0437\u043B\u043E\u0436\u0435\u043D\u044B \u043D\u0430 \u0441\u0442\u043E\u043B\u0435
      \u2014 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E, \u043A\u0430\u043A
      \u043E\u043D \u043B\u044E\u0431\u0438\u0442. \u041E\u043D \u0440\u0430\u0437\u043B\u0438\u0432\u0430\u0435\u0442
      \u0447\u0451\u0440\u043D\u044B\u0439 \u0447\u0430\u0439 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0441 \u0431\u0435\u0437 \u0441\u043B\u043E\u0432\u0430.
      \u041F\u043E\u0442\u043E\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E:
      \xAB\u041A\u0430\u0440\u0442\u0430 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0430.
      \u0412\u0441\u0451 \u043D\u0430\u0439\u0434\u0435\u043D\u043E. \u0422\u044B
      \u0433\u043E\u0442\u043E\u0432 \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u044D\u0442\u043E\u0442
      \u043F\u0443\u0442\u044C?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362775
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362776
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0447\u0430\u0448\u043A\u0443. \xAB\u0417\u0430 \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432.\xBB
      \u0420\u0435\u043B\u0438\u043A\u0432\u0438\u0438 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438 \u043D\u0430\u0448\u043B\u0438 \u0441\u0432\u043E\u0439
      \u0434\u043E\u043C \u0432 \u0410\u0440\u0445\u0438\u0432\u0435 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362777
    m_Localized: "\u0415\u0449\u0451 \u043F\u043E\u0434\u043E\u0436\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362778
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0434\u043E\u043F\u0438\u0432\u0430\u0435\u0442
      \u0447\u0430\u0439. \xAB\u041A\u0430\u043A \u0437\u043D\u0430\u0435\u0448\u044C.
      \u0410\u0440\u0445\u0438\u0432 \u0437\u0434\u0435\u0441\u044C.\xBB \u0427\u0430\u0448\u043A\u0438
      \u043E\u043F\u0443\u0441\u0442\u0435\u043B\u0438; \u0434\u0432\u0435\u0440\u044C
      \u043E\u0442\u043A\u0440\u044B\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362779
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362780
    m_Localized: "\u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u043D\u0435 \u043D\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u0435\u0442.
      \u041E\u043D \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0433\u0440\u0430\u043C\u043E\u0442\u0443
      \u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u0443 \u0438 \u043A\u0438\u0432\u0430\u0435\u0442:
      \xAB\u0414\u0443\u043C\u0430\u0439. \u0413\u0438\u043B\u044C\u0434\u0438\u044F
      \u043D\u0435 \u0443\u0439\u0434\u0451\u0442.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362781
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362782
    m_Localized: "\u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043B\u0430\u0434\u043E\u043D\u0438. \xAB\u041F\u0443\u0442\u044C \u0431\u0443\u0434\u0435\u0442
      \u0436\u0434\u0430\u0442\u044C. \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0448\u044C \u0433\u043E\u0442\u043E\u0432.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362783
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362784
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u043A\u0438\u0432\u0430\u0435\u0442
      \u043D\u0435 \u0441\u043F\u0435\u0448\u0430. \xAB\u0425\u043E\u0440\u043E\u0448\u043E.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u0443\u0447\u0438\u0442 \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u044E.
      \u041D\u0430\u0439\u0434\u0451\u0448\u044C \u043C\u0435\u043D\u044F \u0443
      \u043A\u043E\u0441\u0442\u0440\u0430, \u043A\u043E\u0433\u0434\u0430 \u0440\u0435\u0448\u0438\u0448\u044C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362785
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362786
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440 \u0427\u044D\u043D\u044C \u043F\u0440\u044F\u0447\u0435\u0442
      \u0440\u0443\u043A\u0438 \u0432 \u0440\u0443\u043A\u0430\u0432\u0430. \xAB\u041A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044C
      \u043D\u0435 \u0443\u0431\u0435\u0436\u0438\u0442. \u041A\u043E\u0433\u0434\u0430
      \u043D\u0430\u0434\u0443\u043C\u0430\u0435\u0448\u044C \u2014 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F
      \u0437\u0434\u0435\u0441\u044C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362787
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362788
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u043F\u0440\u044F\u0447\u0435\u0442
      \u043A\u0430\u0440\u0442\u0443 \u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u0443
      \u0438 \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442 \u043F\u043B\u0435\u0447\u0430\u043C\u0438.
      \xAB\u0420\u0435\u043B\u0438\u043A\u0432\u0438\u0438 \u0436\u0434\u0430\u043B\u0438
      \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u044F\u043C\u0438 \u2014 \u0435\u0449\u0451
      \u043F\u043E\u0434\u043E\u0436\u0434\u0443\u0442. \u041D\u0430\u0439\u0434\u0451\u0448\u044C
      \u043C\u0435\u043D\u044F \u0437\u0434\u0435\u0441\u044C, \u043D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326639517696
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u0438\u0437 \u0411\u0443\u0445\u0430\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489216
    m_Localized: "\u0412\u043E\u0437\u0434\u0443\u0445 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      \u043F\u0430\u0445\u043D\u0435\u0442 \u043F\u044B\u043B\u044C\u044E \u0438
      \u0440\u043E\u0437\u043E\u0432\u044B\u043C \u043C\u0430\u0441\u043B\u043E\u043C
      \u2014 \u0432\u044B \u0434\u043E\u043C\u0430. \u0412 \u0437\u0430\u043B\u0435
      \u0413\u0438\u043B\u044C\u0434\u0438\u0438 \u0412\u0430\u0445\u0443-\u041C\u0430\u043D
      \u0443\u0436\u0435 \u0438\u0437\u0443\u0447\u0430\u0435\u0442 \u0441\u0432\u0438\u0442\u043E\u043A
      \u0441 \u0431\u0443\u0445\u0430\u0440\u0441\u043A\u043E\u0439 \u043F\u0435\u0447\u0430\u0442\u044C\u044E,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0432\u044B \u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0438
      \u043F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C. \u041F\u0430\u043B\u044C\u0446\u044B
      \u0441\u043A\u043E\u043B\u044C\u0437\u044F\u0442 \u043F\u043E \u0441\u0442\u0440\u043E\u043A\u0430\u043C,
      \u0433\u0443\u0431\u044B \u0447\u0443\u0442\u044C \u0448\u0435\u0432\u0435\u043B\u044F\u0442\u0441\u044F.
      \u041F\u043E\u0442\u043E\u043C \u043E\u043D \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0441\u0432\u0438\u0442\u043E\u043A \u0438 \u043A\u0438\u0432\u0430\u0435\u0442
      \u0441 \u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0435\u043C.
      \xAB\u041E\u043D\u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0438\u0441\u044C
      \u043D\u0430 \u043D\u0430\u0448\u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F.
      \u041D\u0438 \u043E\u0434\u043D\u043E\u0439 \u0437\u0430\u043F\u044F\u0442\u043E\u0439
      \u043D\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0438. \u042D\u0442\u043E
      \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u044B\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442.\xBB
      \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0441
      \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E. \xAB\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435
      \u0434\u0435\u043B\u043E \u2014 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u0435\u0435.
      \u0413\u043E\u0442\u043E\u0432 \u0432\u0437\u044F\u0442\u044C\u0441\u044F \u0441\u0435\u0439\u0447\u0430\u0441
      \u0438\u043B\u0438 \u043D\u0443\u0436\u043D\u043E \u0432\u0440\u0435\u043C\u044F?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489217
    m_Localized: "\u0413\u043E\u0442\u043E\u0432 \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489218
    m_Localized: "\u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u043D\u043E\u0432\u0443\u044E \u0433\u0440\u0430\u043C\u043E\u0442\u0443 \u0438
      \u0445\u043B\u043E\u043F\u0430\u0435\u0442 \u043F\u043E \u0441\u0442\u043E\u043B\u0443
      \u043B\u0430\u0434\u043E\u043D\u044C\u044E. \xAB\u0425\u043E\u0440\u043E\u0448\u043E.
      \u041D\u0443\u0436\u0435\u043D \u043A\u043E\u043D\u0432\u043E\u0439 \u0432
      \u041C\u0435\u0448\u0445\u0435\u0434 \u2014 \u0433\u0438\u043B\u044C\u0434\u0438\u044F
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043D\u043E\u0432\u044B\u0439
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442. \u0414\u0435\u0442\u0430\u043B\u0438
      \u0437\u0434\u0435\u0441\u044C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489219
    m_Localized: "\u0417\u0430\u0439\u0434\u0443 \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489220
    m_Localized: "\u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443 \u0432 \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0443.
      \xAB\u0413\u0438\u043B\u044C\u0434\u0438\u044F \u043D\u0435 \u0437\u0430\u043F\u0438\u0440\u0430\u0435\u0442
      \u0434\u0432\u0435\u0440\u0435\u0439. \u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442
      \u0441 \u041C\u0435\u0448\u0445\u0435\u0434\u043E\u043C \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489221
    m_Localized: "\u041F\u0435\u0447\u0430\u0442\u044C \u041C\u0435\u0448\u0445\u0435\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489222
    m_Localized: "\u0412 \u041C\u0435\u0448\u0445\u0435\u0434\u0435 \u043F\u0430\u0445\u043D\u0435\u0442
      \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u043C \u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u044C\u044E
      \u2014 \u0433\u043E\u0440\u043E\u0434 \u0441\u0442\u0440\u043E\u0438\u0442\u0441\u044F,
      \u0442\u043E\u0440\u0433\u0443\u0435\u0442, \u0436\u0438\u0432\u0451\u0442.
      \u041A\u0443\u043F\u0435\u0446-\u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044C
      \u0413\u0438\u043B\u044C\u0434\u0438\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0443 \u0432\u043E\u0440\u043E\u0442 \u0441\u0432\u043E\u0435\u0439
      \u043B\u0430\u0432\u043A\u0438 \u0438 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C.
      \u041E\u043D \u0441\u0442\u0430\u0432\u0438\u0442 \u043F\u0435\u0447\u0430\u0442\u044C,
      \u043D\u0435 \u0447\u0438\u0442\u0430\u044F \u2014 \u0436\u0435\u0441\u0442
      \u0434\u043E\u0432\u0435\u0440\u0438\u044F. \xAB\u0412\u0430\u0445\u0443-\u041C\u0430\u043D
      \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442 \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u0445
      \u043B\u044E\u0434\u0435\u0439,\xBB \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043E\u043D \u043F\u043E-\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438.
      \xAB\u041F\u0435\u0440\u0435\u0434\u0430\u0439 \u0435\u043C\u0443: \u041C\u0435\u0448\u0445\u0435\u0434
      \u043E\u0442\u043A\u0440\u044B\u0442.\xBB \u0412\u0430\u0445\u0443-\u041C\u0430\u043D
      \u0443\u0436\u0435 \u0436\u0434\u0451\u0442 \u0441 \u043D\u043E\u0432\u044B\u043C
      \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0435\u043C \u2014 \u0432\u0437\u044F\u0442\u044C\u0441\u044F
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0438\u043B\u0438 \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489223
    m_Localized: "\u0413\u043E\u0442\u043E\u0432 \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489224
    m_Localized: "\u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u043F\u0435\u0447\u0430\u0442\u044C \u0438 \u0441\u0440\u0430\u0437\u0443
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043A\u0430\u0440\u0442\u0443:
      \xAB\u0411\u0430\u0433\u0434\u0430\u0434. \u0426\u0435\u043D\u043D\u044B\u0439
      \u0433\u0440\u0443\u0437. \u0414\u0435\u0442\u0430\u043B\u0438 \u0432 \u044D\u0442\u043E\u043C
      \u043F\u0438\u0441\u044C\u043C\u0435.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489225
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489226
    m_Localized: "\xAB\u0420\u0430\u0437\u0443\u043C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489227
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u0432 \u0411\u0430\u0433\u0434\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489228
    m_Localized: "\u0411\u0430\u0433\u0434\u0430\u0434 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u043A\u0430\u043D\u0430\u043B\u043E\u0432
      \u0438 \u0436\u0430\u0440\u0435\u043D\u044B\u0445 \u0444\u0438\u043D\u0438\u043A\u043E\u0432
      \u2014 \u0437\u0434\u0435\u0441\u044C \u043F\u0430\u0445\u043D\u0435\u0442
      \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438. \u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C
      \u0433\u0440\u0443\u0437\u0430 \u2014 \u043E\u0441\u0430\u043D\u0438\u0441\u0442\u044B\u0439
      \u043A\u0443\u043F\u0435\u0446 \u0432 \u043F\u043E\u043B\u043E\u0441\u0430\u0442\u043E\u043C
      \u043A\u0430\u0444\u0442\u0430\u043D\u0435 \u2014 \u0432\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0442\u044E\u043A\u0438 \u0441 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u043C
      \u043B\u0438\u0446\u043E\u043C \u0438 \u043E\u0434\u0438\u043D \u0437\u0430
      \u043E\u0434\u043D\u0438\u043C \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442
      \u043A\u0430\u0436\u0434\u0443\u044E \u0432\u0435\u0449\u044C. \u041D\u0430\u043A\u043E\u043D\u0435\u0446
      \u0432\u0437\u0434\u044B\u0445\u0430\u0435\u0442 \u043E\u0431\u043B\u0435\u0433\u0447\u0451\u043D\u043D\u043E.
      \xAB\u0412\u0441\u0451 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435. \u0412\u0430\u0445\u0443-\u041C\u0430\u043D
      \u0434\u0435\u0440\u0436\u0438\u0442 \u0441\u043B\u043E\u0432\u043E.\xBB \u041E\u043D
      \u043E\u0442\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442 \u0441\u0435\u0440\u0435\u0431\u0440\u043E
      \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E.
      \xAB\u041F\u043E\u0441\u043E\u043B \u0432 \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u0435
      \u0436\u0434\u0451\u0442. \u0425\u043E\u0447\u0435\u0448\u044C \u043F\u0440\u043E\u0439\u0442\u0438
      \u0432\u0435\u0441\u044C \u043F\u0443\u0442\u044C \u0434\u043E \u043A\u043E\u043D\u0446\u0430
      \u2014 \u0438\u043B\u0438 \u0432\u0435\u0440\u043D\u0451\u0448\u044C\u0441\u044F?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489229
    m_Localized: "\u041F\u0440\u043E\u0439\u0434\u0443 \u0434\u043E \u043A\u043E\u043D\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489230
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u043E\u0442\u0434\u0430\u0451\u0442
      \u043F\u0438\u0441\u044C\u043C\u043E \u0441 \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
      \u043A\u0438\u0432\u043A\u043E\u043C. \xAB\u0412\u0430\u0445\u0443-\u041C\u0430\u043D
      \u0431\u044B\u043B \u043F\u0440\u0430\u0432 \u043D\u0430 \u0442\u0432\u043E\u0439
      \u0441\u0447\u0451\u0442. \u041F\u0443\u0442\u044C \u043A \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044E
      \u043E\u0442\u043A\u0440\u044B\u0442.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489231
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489232
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u043F\u0438\u0441\u044C\u043C\u043E. \xAB\u041A\u0430\u043A \u0440\u0435\u0448\u0438\u0448\u044C.
      \u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0441\u043A\u0430\u0437\u0430\u043B
      \u2014 \u0442\u044B \u0441\u0430\u043C \u0432\u044B\u0431\u0435\u0440\u0435\u0448\u044C.
      \u0421\u0435\u0440\u0435\u0431\u0440\u043E \u0442\u0432\u043E\u0451.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489233
    m_Localized: "\u0422\u0440\u0438 \u0433\u043E\u043B\u043E\u0441\u0430 \u0442\u0438\u0448\u0438\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489234
    m_Localized: "\u041F\u0435\u0449\u0435\u0440\u044B \u041C\u043E\u0433\u0430\u043E
      \u043E\u043A\u0443\u0442\u044B\u0432\u0430\u044E\u0442 \u0432\u0430\u0441 \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043E\u0439.
      \u0422\u0438\u043D\u043B\u0435\u0439 \u0441\u0438\u0434\u0438\u0442 \u0443
      \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0439 \u043B\u0430\u043C\u043F\u044B,
      \u043D\u0435 \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044F\u0441\u044C,
      \u2014 \u0441\u043B\u043E\u0432\u043D\u043E \u0437\u043D\u0430\u043B, \u0447\u0442\u043E
      \u0432\u044B \u043F\u0440\u0438\u0434\u0451\u0442\u0435. \xAB\u042F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E
      \u0442\u0440\u0438 \u043C\u0435\u0441\u0442\u0430 \u0432 \u0442\u0435\u0431\u0435,\xBB
      \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D, \u043D\u0435
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044F \u0433\u043B\u0430\u0437.
      \xAB\u041E\u043D\u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438 \u0441
      \u0442\u043E\u0431\u043E\u0439?\xBB \u0412\u044B \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442\u0435
      \u0432\u0441\u0451 \u0443\u0432\u0438\u0434\u0435\u043D\u043D\u043E\u0435,
      \u0438 \u043C\u043E\u043D\u0430\u0445 \u043A\u0438\u0432\u0430\u0435\u0442
      \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u0441\u043B\u043E\u0432\u0443.
      \xAB\u0422\u0440\u0438 \u043E\u0433\u043D\u044F \u2014 \u043E\u0434\u0438\u043D
      \u043F\u0443\u0442\u044C. \u0422\u044B \u0443\u0441\u043B\u044B\u0448\u0430\u043B
      \u0440\u0430\u0437\u043D\u044B\u0435 \u0433\u043E\u043B\u043E\u0441\u0430 \u043E\u0434\u043D\u043E\u0433\u043E
      \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044F.\xBB \u041E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0432\u0437\u0433\u043B\u044F\u0434. \xAB\u041F\u0443\u0442\u044C \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F.
      \u0412\u043E\u0437\u044C\u043C\u0451\u0448\u044C\u0441\u044F \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u2014 \u0438\u043B\u0438 \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u0430
      \u0442\u0438\u0448\u0438\u043D\u0430?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877824
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0443 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877825
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043B\u0430\u0434\u043E\u043D\u0438. \xAB\u0413\u043E\u0440\u044B \u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0442
      \u0445\u0440\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877826
    m_Localized: "\u0417\u0430\u0439\u0434\u0443 \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877827
    m_Localized: "\xAB\u0422\u0438\u0448\u0438\u043D\u0430 \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0442\u043E\u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877828
    m_Localized: "\u041D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0439 \u0445\u0440\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877829
    m_Localized: "\u0422\u0443\u043C\u0430\u043D \u0440\u0430\u0441\u0441\u0435\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0441\u0430\u043C\u044B\u0439 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u044B\u0439
      \u043C\u043E\u043C\u0435\u043D\u0442 \u2014 \u0438 \u0432\u043E\u0442 \u043E\u043D,
      \u0432\u044B\u0440\u0443\u0431\u043B\u0435\u043D\u043D\u044B\u0439 \u043F\u0440\u044F\u043C\u043E
      \u0432 \u0441\u043A\u0430\u043B\u0435: \u0443\u0437\u043A\u0438\u0435 \u0441\u0442\u0443\u043F\u0435\u043D\u0438,
      \u0447\u0435\u0440\u0435\u043F\u0438\u0447\u043D\u0430\u044F \u043A\u0440\u044B\u0448\u0430,
      \u0442\u0438\u0445\u0438\u0439 \u0434\u0432\u043E\u0440 \u0441 \u043E\u0434\u043D\u0438\u043C
      \u043A\u0438\u043F\u0430\u0440\u0438\u0441\u043E\u043C. \u0422\u0438\u043D\u043B\u0435\u0439
      \u043F\u0440\u0438\u0448\u0451\u043B \u0437\u0430 \u0432\u0430\u043C\u0438
      \u0441\u0430\u043C \u2014 \u0438\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0437\u0434\u0435\u0441\u044C.
      \xAB\u0422\u044B \u043D\u0430\u0448\u0451\u043B \u0442\u043E, \u0447\u0442\u043E
      \u043D\u0435 \u0438\u0449\u0443\u0442 \u2014 \u0430 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0430\u0445\u043E\u0434\u044F\u0442,\xBB \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043E\u043D \u0431\u0435\u0437 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u044F.
      \xAB\u0425\u0440\u0430\u043C \u0432\u0438\u0434\u0438\u0442 \u0442\u0435\u0431\u044F.
      \u0413\u043E\u0442\u043E\u0432 \u043F\u0440\u043E\u0439\u0442\u0438 \u0435\u0433\u043E
      \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F \u0441\u0435\u0439\u0447\u0430\u0441
      \u2014 \u0438\u043B\u0438 \u043F\u0440\u0438\u0434\u0451\u0448\u044C, \u043A\u043E\u0433\u0434\u0430
      \u0441\u043E\u0431\u0435\u0440\u0451\u0448\u044C\u0441\u044F \u0441 \u0434\u0443\u0445\u043E\u043C?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877830
    m_Localized: "\u0413\u043E\u0442\u043E\u0432 \u043A \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877831
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0432\u0445\u043E\u0434: \xAB\u0412\u043E\u0439\u0434\u0438.
      \u0425\u0440\u0430\u043C \u0437\u0430\u0434\u0430\u0441\u0442 \u0432\u043E\u043F\u0440\u043E\u0441\u044B
      \u2014 \u043E\u0442\u0432\u0435\u0447\u0430\u0439 \u0441\u0435\u0440\u0434\u0446\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877832
    m_Localized: "\u0417\u0430\u0439\u0434\u0443 \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877833
    m_Localized: "\xAB\u041A\u0438\u043F\u0430\u0440\u0438\u0441 \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877834
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u0445\u0440\u0430\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877835
    m_Localized: "\u0422\u0440\u0438 \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F
      \u043F\u043E\u0437\u0430\u0434\u0438 \u2014 \u0442\u0438\u0448\u0438\u043D\u043E\u0439,
      \u0441\u0442\u0440\u0430\u0445\u043E\u043C \u0438 \u0432\u044B\u0431\u043E\u0440\u043E\u043C.
      \u0422\u0438\u043D\u043B\u0435\u0439 \u0441\u0442\u043E\u0438\u0442 \u0432
      \u0446\u0435\u043D\u0442\u0440\u0435 \u0434\u0432\u043E\u0440\u0430, \u0438
      \u0437\u0430 \u0435\u0433\u043E \u0441\u043F\u0438\u043D\u043E\u0439 \u043A\u0438\u043F\u0430\u0440\u0438\u0441
      \u043A\u0430\u0447\u0430\u0435\u0442\u0441\u044F \u0431\u0435\u0437 \u0432\u0435\u0442\u0440\u0430.
      \xAB\u0422\u044B \u043F\u0440\u043E\u0448\u0451\u043B \u0442\u043E, \u0447\u0442\u043E
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u043B\u043E
      \u043C\u043D\u043E\u0433\u0438\u0445,\xBB \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043C\u043E\u043D\u0430\u0445 \u0442\u0438\u0445\u043E. \xAB\u0425\u0440\u0430\u043C
      \u0434\u0430\u0451\u0442 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u2014 \u043D\u0435 \u043A\u0430\u043A \u0432\u043B\u0430\u0441\u0442\u044C,
      \u0430 \u043A\u0430\u043A \u044F\u0441\u043D\u043E\u0441\u0442\u044C.\xBB \u041E\u043D
      \u043D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435 \u043A\u043B\u0430\u0434\u0451\u0442
      \u0440\u0443\u043A\u0443 \u0432\u0430\u043C \u043D\u0430 \u043B\u043E\u0431.
      \xAB\u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u0436\u0434\u0451\u0442 \u0442\u0435\u0431\u044F
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435. \u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F
      \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u2014 \u0438\u043B\u0438
      \u043F\u043E\u0431\u0443\u0434\u0435\u0448\u044C \u0437\u0434\u0435\u0441\u044C?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877836
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u043B\u044E\u0441\u044C \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877837
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0434\u043E \u0441\u0442\u0443\u043F\u0435\u043D\u0435\u0439:
      \xAB\u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u0437\u043D\u0430\u0435\u0442
      \u0442\u0432\u043E\u0439 \u043F\u0443\u0442\u044C. \u041E\u043D \u043D\u0435
      \u0443\u0434\u0438\u0432\u0438\u0442\u0441\u044F.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877838
    m_Localized: "\u041F\u043E\u0431\u0443\u0434\u0443 \u0437\u0434\u0435\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877839
    m_Localized: "\xAB\u0425\u043E\u0440\u043E\u0448\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877840
    m_Localized: "\u041E\u0433\u043E\u043D\u044C \u0432 \u041C\u0435\u0448\u0445\u0435\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877841
    m_Localized: "\u041C\u0435\u0448\u0445\u0435\u0434\u0441\u043A\u0438\u0439 \u0441\u043A\u043B\u0430\u0434
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0437\u0430\u043F\u0430\u0445\u043E\u043C
      \u0441\u043A\u0438\u043F\u0438\u0434\u0430\u0440\u0430 \u0438 \u043B\u043E\u0448\u0430\u0434\u0438\u043D\u043E\u0433\u043E
      \u043F\u043E\u0442\u0430. \u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C
      \u2014 \u0440\u043E\u0441\u043B\u044B\u0439 \u043C\u0443\u0436\u0447\u0438\u043D\u0430
      \u0441 \u043E\u0442\u043C\u0435\u0442\u0438\u043D\u043E\u0439 \u043E\u0442
      \u043A\u043D\u0443\u0442\u0430 \u043D\u0430 \u0449\u0435\u043A\u0435 \u2014
      \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u0433\u0440\u0443\u0437 \u043C\u043E\u043B\u0447\u0430,
      \u0441\u0447\u0438\u0442\u0430\u044F \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u043E\u0441\u0443\u0434
      \u0434\u0432\u0430\u0436\u0434\u044B. \u0414\u0430\u0440\u0438\u0443\u0448
      \u0441\u0438\u0434\u0438\u0442 \u0432 \u0443\u0433\u043B\u0443 \u043D\u0430
      \u0442\u044E\u043A\u0435 \u0438 \u0436\u0443\u0451\u0442 \u0444\u0438\u043D\u0438\u043A\u0438.
      \xAB\u0426\u0435\u043B\u044B\u0439. \u042F \u043D\u0435 \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u043B\u0441\u044F.\xBB
      \u041E\u043D \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u0432\u0430\u043C
      \u043A\u043E\u0448\u0435\u043B\u044C. \xAB\u0422\u044F\u0436\u0451\u043B\u044B\u0439
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442, \u0441\u043E\u0433\u043B\u0430\u0441\u0435\u043D.
      \u041D\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u2014
      \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0440\u043E\u0434\u0430: \u043D\u0435
      \u043E\u0433\u043E\u043D\u044C, \u0430 \u043B\u044E\u0434\u0438. \u0411\u0435\u0440\u0451\u0448\u044C\u0441\u044F
      \u0441\u0440\u0430\u0437\u0443 \u0438\u043B\u0438 \u043D\u0443\u0436\u043D\u043E
      \u043F\u0440\u043E\u0434\u044B\u0448\u0430\u0442\u044C\u0441\u044F?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877842
    m_Localized: "\u0411\u0435\u0440\u0443\u0441\u044C \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877843
    m_Localized: "\xAB\u0425\u043E\u0440\u043E\u0448\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877844
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043E\u0442\u0434\u043E\u0445\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877845
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u043A\u0438\u0432\u0430\u0435\u0442.
      \xAB\u0423\u043C\u043D\u043E. \u0423\u0441\u0442\u0430\u043B\u044B\u0439 \u0438\u0449\u0435\u0442
      \u043F\u043B\u043E\u0445\u043E. \u0416\u0434\u0438 \u043C\u0435\u043D\u044F
      \u0443 \u0432\u043E\u0440\u043E\u0442 \u0437\u0430\u0432\u0442\u0440\u0430
      \u0443\u0442\u0440\u043E\u043C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877846
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u0438\u0437
      \u043F\u0435\u0441\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877847
    m_Localized: "\u041F\u044B\u043B\u044C \u043E\u0441\u0435\u0434\u0430\u0435\u0442,
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u0432\u0445\u043E\u0434\u0438\u0442 \u0432 \u0441\u0442\u0435\u043D\u044B
      \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E \u0434\u0432\u043E\u0440\u0430
      \u2014 \u0432\u0441\u0435 \u0436\u0438\u0432\u044B, \u0445\u043E\u0442\u044F
      \u0434\u0432\u043E\u0435 \u0435\u043B\u0435 \u0441\u0442\u043E\u044F\u0442.
      \u0422\u044B \u043D\u0430\u0448\u0451\u043B \u0438\u0445 \u0432 \u0442\u0440\u0451\u0445
      \u043B\u0438\u0433\u0430\u0445 \u043E\u0442 \u0442\u0440\u0430\u043A\u0442\u0430,
      \u0431\u0435\u0437 \u0432\u043E\u0434\u044B \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439
      \u0434\u0435\u043D\u044C. \u0414\u0430\u0440\u0438\u0443\u0448 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0441\u0440\u0430\u0437\u0443, \u0441\u043B\u043E\u0432\u043D\u043E \u0436\u0434\u0430\u043B
      \u0437\u0434\u0435\u0441\u044C. \xAB\u042F \u0441\u043B\u044B\u0448\u0430\u043B
      \u0442\u0432\u043E\u0439 \u0441\u0438\u0433\u043D\u0430\u043B,\xBB \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043E\u043D \u0445\u0440\u0438\u043F\u043B\u043E. \xAB\u0425\u043E\u0440\u043E\u0448\u0430\u044F
      \u0440\u0430\u0431\u043E\u0442\u0430. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0437\u043D\u0430\u0435\u0448\u044C: \u043B\u044E\u0434\u0435\u0439 \u0431\u0435\u0440\u0435\u0447\u044C
      \u0441\u043B\u043E\u0436\u043D\u0435\u0435, \u0447\u0435\u043C \u0433\u0440\u0443\u0437.\xBB
      \u041E\u043D \u0445\u043B\u043E\u043F\u0430\u0435\u0442 \u0442\u0435\u0431\u044F
      \u043F\u043E \u043F\u043B\u0435\u0447\u0443. \xAB\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435
      \u2014 \u0437\u0430\u0441\u0430\u0434\u0430 \u043D\u0430 \u0442\u0440\u0430\u043A\u0442\u0435.
      \u0411\u0435\u0440\u0451\u0448\u044C\u0441\u044F \u0438\u043B\u0438 \u043D\u0435\u0442?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877848
    m_Localized: "\u0412\u043E\u0437\u044C\u043C\u0443\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877849
    m_Localized: "\xAB\u0412\u043E\u0442 \u0438 \u0445\u043E\u0440\u043E\u0448\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877850
    m_Localized: "\u041F\u043E\u0434\u043E\u0436\u0434\u0438 \u043C\u0435\u043D\u044F
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877851
    m_Localized: "\xAB\u041E\u0442\u0434\u043E\u0445\u043D\u0438. \u0411\u0430\u043D\u0434\u0438\u0442\u044B
      \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435 \u0434\u0435\u043D\u0443\u0442\u0441\u044F
      \u0434\u043E \u0443\u0442\u0440\u0430. \u042F \u0437\u0434\u0435\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877852
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0430 \u0437\u0430\u0447\u0438\u0449\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877853
    m_Localized: "\u041F\u044B\u043B\u044C \u043E\u0442 \u0441\u0445\u0432\u0430\u0442\u043A\u0438
      \u0435\u0449\u0451 \u043D\u0435 \u043E\u0441\u0435\u043B\u0430, \u043D\u043E
      \u0442\u0440\u0430\u043A\u0442 \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D.
      \u0414\u0432\u043E\u0435 \u0440\u0430\u043D\u0435\u043D\u044B\u0445 \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432
      \u0431\u0435\u0433\u0443\u0442 \u043F\u0440\u043E\u0447\u044C, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0440\u0430\u0437\u0431\u0435\u0436\u0430\u043B\u0438\u0441\u044C \u0440\u0430\u043D\u044C\u0448\u0435.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0446\u044B, \u0447\u0442\u043E \u043F\u0440\u044F\u0442\u0430\u043B\u0438\u0441\u044C
      \u0437\u0430 \u0442\u0435\u043B\u0435\u0433\u0430\u043C\u0438, \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E
      \u0432\u0441\u0442\u0430\u044E\u0442, \u043D\u0435 \u0432\u0435\u0440\u044F,
      \u0447\u0442\u043E \u0432\u0441\u0451 \u043A\u043E\u043D\u0447\u0435\u043D\u043E.
      \u0414\u0430\u0440\u0438\u0443\u0448 \u043E\u0431\u044A\u0435\u0437\u0436\u0430\u0435\u0442
      \u043C\u0435\u0441\u0442\u043E \u0431\u043E\u044F \u0432\u0435\u0440\u0445\u043E\u043C,
      \u0434\u0435\u043B\u043E\u0432\u0438\u0442\u043E \u0441\u0447\u0438\u0442\u0430\u0435\u0442
      \u0442\u0440\u043E\u0444\u0435\u0438 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0441 \u0441 \u0447\u0435\u043C-\u0442\u043E \u043F\u043E\u0445\u043E\u0436\u0438\u043C
      \u043D\u0430 \u0433\u043E\u0440\u0434\u043E\u0441\u0442\u044C. \xAB\u041C\u0430\u0440\u0448\u0440\u0443\u0442
      \u0447\u0438\u0441\u0442. \u041C\u043E\u0436\u0435\u043C \u0445\u043E\u0434\u0438\u0442\u044C
      \u0437\u0434\u0435\u0441\u044C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E.\xBB
      \u041E\u043D \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u0448\u043B\u044F\u043F\u0443.
      \xAB\u041E\u0434\u0438\u043D \u043F\u0443\u0442\u044C \u043E\u0441\u0442\u0430\u043B\u0441\u044F.
      \u0413\u043E\u0442\u043E\u0432 \u0434\u043E\u0439\u0442\u0438 \u0434\u043E
      \u043A\u043E\u043D\u0446\u0430?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877854
    m_Localized: "\u0414\u043E \u043A\u043E\u043D\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877855
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u043D\u0430\u0434\u0435\u0432\u0430\u0435\u0442
      \u0448\u043B\u044F\u043F\u0443. \xAB\u0411\u0430\u0433\u0434\u0430\u0434. \u0414\u043E\u043B\u0433\u0438\u0439
      \u043F\u0443\u0442\u044C. \u0421\u0430\u043C\u044B\u0439 \u0432\u0430\u0436\u043D\u044B\u0439.
      \u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0443 \u0434\u0435\u0442\u0430\u043B\u0438
      \u0432 \u043B\u0430\u0433\u0435\u0440\u0435.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877856
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u0432\u0440\u0435\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877857
    m_Localized: "\xAB\u0425\u043E\u0440\u043E\u0448\u043E. \u041F\u043E\u0439\u0434\u0451\u043C
      \u0432 \u043B\u0430\u0433\u0435\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877858
    m_Localized: "\u0418\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442 \u043D\u0430\u0439\u0434\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877859
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u0427\u044D\u043D\u044F
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0437\u0430\u043F\u0430\u0445\u043E\u043C
      \u0438\u043D\u0434\u0438\u0433\u043E \u0438 \u043B\u0430\u043A\u0440\u0438\u0447\u043D\u043E\u0433\u043E
      \u043A\u043E\u0440\u043D\u044F. \u041C\u0430\u0441\u0442\u0435\u0440 \u0441\u0442\u043E\u0438\u0442
      \u043D\u0430\u0434 \u0441\u0442\u043E\u043B\u043E\u043C, \u043A\u043E\u0433\u0434\u0430
      \u0432\u044B \u043A\u043B\u0430\u0434\u0451\u0442\u0435 \u043F\u0435\u0440\u0435\u0434
      \u043D\u0438\u043C \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0439 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442.
      \u041E\u043D \u0431\u0435\u0440\u0451\u0442 \u0435\u0433\u043E \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E
      \u2014 \u043F\u043E\u0447\u0442\u0438 \u043D\u0435\u0436\u043D\u043E, \u0440\u0430\u0441\u0442\u0438\u0440\u0430\u0435\u0442
      \u043D\u0430 \u043D\u043E\u0433\u0442\u0435. \u041F\u043E\u0442\u043E\u043C
      \u0442\u0438\u0445\u043E \u0432\u044B\u0434\u044B\u0445\u0430\u0435\u0442.
      \xAB\u042F \u043F\u043E\u043C\u043D\u0438\u043B \u044D\u0442\u043E\u0442 \u0437\u0430\u043F\u0430\u0445
      \u0441 \u0442\u0435\u0445 \u043F\u043E\u0440, \u043A\u0430\u043A \u0431\u044B\u043B
      \u0443\u0447\u0435\u043D\u0438\u043A\u043E\u043C. \u0422\u044B \u0432\u0435\u0440\u043D\u0443\u043B
      \u0443\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u043E\u0435 \u0437\u0432\u0435\u043D\u043E.\xBB
      \u041E\u043D \u043E\u0442\u043E\u0434\u0432\u0438\u0433\u0430\u0435\u0442 \u0441\u0442\u0430\u0440\u0438\u043D\u043D\u0443\u044E
      \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C. \xAB\u0422\u0435\u043F\u0435\u0440\u044C
      \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C:
      \u043A\u0442\u043E \u0435\u0449\u0451 \u0437\u043D\u0430\u0435\u0442 \u0440\u0435\u0446\u0435\u043F\u0442.
      \u0412\u043E\u0437\u044C\u043C\u0451\u0448\u044C\u0441\u044F \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u2014 \u0438\u043B\u0438?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877860
    m_Localized: "\u0412\u043E\u0437\u044C\u043C\u0443\u0441\u044C \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877861
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440 \u0427\u044D\u043D\u044C \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u044F\u0449\u0438\u043A \u0441\u0442\u043E\u043B\u0430 \u0438 \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u0437\u0430\u043F\u0438\u0441\u043A\u0443. \xAB\u041A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u044B.
      \u041E\u0434\u043D\u0430 \u0438\u0437 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0438\u0445
      \u2014 \u0432 \u0434\u0432\u0443\u0445 \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0430\u0445
      \u043E\u0442\u0441\u044E\u0434\u0430. \u0423\u0437\u043D\u0430\u0439 \u043F\u0440\u0430\u0432\u0434\u0443.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877862
    m_Localized: "\u0417\u0430\u0439\u0434\u0443 \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877863
    m_Localized: "\xAB\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F
      \u0436\u0434\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877864
    m_Localized: "\u041F\u0440\u0430\u0432\u0434\u0430 \u043E \u043A\u0440\u0430\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877865
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u0427\u044D\u043D\u044F
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0441\u043E\u0441\u043D\u043E\u0432\u043E\u0439
      \u0441\u043C\u043E\u043B\u043E\u0439 \u0438 \u0433\u043E\u0440\u044F\u0447\u0438\u043C
      \u043C\u0435\u0442\u0430\u043B\u043B\u043E\u043C \u2014 \u043E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u043B,
      \u0436\u0434\u0430\u043B. \u0412\u044B \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u043D\u0430 \u0441\u0442\u043E\u043B \u0432\u0441\u0451: \u0438\u043C\u0435\u043D\u0430,
      \u0441\u0445\u0435\u043C\u044B, \u043E\u0431\u0440\u0430\u0437\u0446\u044B
      \u043A\u0440\u0430\u0434\u0435\u043D\u043E\u0433\u043E \u0440\u0435\u0446\u0435\u043F\u0442\u0430.
      \u041C\u0430\u0441\u0442\u0435\u0440 \u0427\u044D\u043D\u044C \u0438\u0437\u0443\u0447\u0430\u0435\u0442
      \u043A\u0430\u0436\u0434\u044B\u0439 \u043B\u0438\u0441\u0442\u043E\u043A \u043D\u0435
      \u0442\u043E\u0440\u043E\u043F\u044F\u0441\u044C, \u043F\u043E\u0442\u043E\u043C
      \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u0438\u0445 \u0441\u0442\u043E\u043F\u043A\u043E\u0439
      \u0438 \u043D\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043B\u0430\u0434\u043E\u043D\u044C\u044E.
      \xAB\u042F \u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0443\u0442\u0435\u0447\u043A\u0430
      \u0431\u044B\u043B\u0430. \u041D\u0435 \u0437\u043D\u0430\u043B \u2014 \u043A\u0442\u043E.\xBB
      \u0413\u043E\u043B\u043E\u0441 \u0440\u043E\u0432\u0435\u043D, \u043D\u043E
      \u043F\u0430\u043B\u044C\u0446\u044B \u0441\u0436\u0438\u043C\u0430\u044E\u0442\u0441\u044F.
      \xAB\u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C
      \u0441\u0432\u043E\u0451. \u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F
      \u043F\u0443\u0440\u043F\u0443\u0440\u0430. \u0413\u043E\u0442\u043E\u0432
      \u0432\u0437\u044F\u0442\u044C\u0441\u044F \u0437\u0430 \u0434\u0435\u043B\u043E?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877866
    m_Localized: "\u0413\u043E\u0442\u043E\u0432 \u0441\u0442\u0440\u043E\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877867
    m_Localized: "\u0427\u044D\u043D\u044C \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u0431\u0443\u043C\u0430\u0433\u0438 \u0432 \u0441\u0443\u043D\u0434\u0443\u043A
      \u0438 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043A\u0430\u0440\u0442\u0443
      \u0427\u0430\u043D\u044A\u0430\u043D\u044F: \xAB\u0423\u0447\u0430\u0441\u0442\u043E\u043A
      \u0435\u0441\u0442\u044C. \u041D\u0443\u0436\u043D\u044B \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B
      \u0438 \u043C\u0430\u0441\u0442\u0435\u0440\u0430. \u041D\u0430\u0447\u043D\u0451\u043C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877868
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877869
    m_Localized: "\xAB\u0414\u0443\u043C\u0430\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877870
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877871
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0433\u043E\u0440\u044F\u0447\u0435\u0433\u043E
      \u0432\u043E\u0441\u043A\u0430 \u0438 \u043F\u0443\u0440\u043F\u0443\u0440\u043D\u043E\u0433\u043E
      \u043A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044F \u0432\u043F\u0435\u0440\u0432\u044B\u0435
      \u0441\u043C\u0435\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0432 \u044D\u0442\u0438\u0445
      \u0441\u0442\u0435\u043D\u0430\u0445 \u2014 \u0432\u0430\u0448\u0438\u0445
      \u0441\u0442\u0435\u043D\u0430\u0445. \u041C\u0430\u0441\u0442\u0435\u0440
      \u0427\u044D\u043D\u044C \u0441\u0442\u043E\u0438\u0442 \u043F\u043E\u0441\u0440\u0435\u0434\u0438
      \u043D\u043E\u0432\u043E\u0433\u043E \u0437\u0430\u043B\u0430 \u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043E\u0431\u0432\u043E\u0434\u0438\u0442 \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C
      \u0447\u0430\u043D\u044B, \u043F\u043E\u043B\u043A\u0438 \u0441 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438,
      \u043E\u043A\u043D\u043E \u043D\u0430\u0434 \u0440\u0435\u043A\u043E\u0439.
      \xAB\u042F \u0441\u0442\u0440\u043E\u0438\u043B \u044D\u0442\u043E \u0432 \u0443\u043C\u0435
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442,\xBB \u2014
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D \u0442\u0438\u0445\u043E.
      \xAB\u0422\u044B \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B \u0437\u0430
      \u043C\u0435\u0441\u044F\u0446\u044B.\xBB \u041E\u043D \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u0432\u0430\u043C. \xAB\u041E\u0441\u0442\u0430\u043B\u0441\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0448\u0430\u0433: \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0427\u0430\u043D\u044A\u0430\u043D\u044E,
      \u0447\u0442\u043E \u043B\u0443\u0447\u0448\u0438\u0439 \u043F\u0443\u0440\u043F\u0443\u0440
      \u2014 \u0437\u0434\u0435\u0441\u044C. \u0412\u043E\u0437\u044C\u043C\u0451\u0448\u044C\u0441\u044F
      \u0437\u0430 \u044D\u0442\u043E \u0441\u0435\u0439\u0447\u0430\u0441?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877872
    m_Localized: "\u0414\u043E\u043A\u0430\u0436\u0435\u043C \u0432\u0441\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877873
    m_Localized: "\u0427\u044D\u043D\u044C \u043A\u0438\u0432\u0430\u0435\u0442 \u0438
      \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u043E\u0431\u0440\u0430\u0437\u0435\u0446
      \u0442\u043A\u0430\u043D\u0438: \xAB\u041D\u0443\u0436\u043D\u0430 \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u0430\u044F
      \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u044C.
      \u041F\u0443\u0440\u043F\u0443\u0440 \u0434\u043E\u043B\u0436\u0435\u043D \u0443\u0432\u0438\u0434\u0435\u0442\u044C
      \u0434\u0432\u043E\u0440.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877874
    m_Localized: "\u0417\u0430\u0439\u0434\u0443 \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877875
    m_Localized: "\xAB\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F
      \u0431\u0443\u0434\u0435\u0442 \u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877876
    m_Localized: "\u0422\u0440\u0438 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877877
    m_Localized: "\u0412 \u0410\u0440\u0445\u0438\u0432\u0435 \u043F\u0430\u0445\u043D\u0435\u0442
      \u0432\u043E\u0441\u043A\u043E\u043C \u0438 \u0441\u0442\u0430\u0440\u043E\u0439
      \u043A\u043E\u0436\u0435\u0439 \u2014 \u0424\u0430\u0440\u0443\u0445 \u0441\u0438\u0434\u0438\u0442
      \u043D\u0430\u0434 \u0440\u0430\u0437\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u043C\u0438
      \u043A\u0430\u0440\u0442\u0430\u043C\u0438, \u043A\u043E\u0433\u0434\u0430
      \u0432\u044B \u043A\u043B\u0430\u0434\u0451\u0442\u0435 \u043F\u0435\u0440\u0435\u0434
      \u043D\u0438\u043C \u0442\u0440\u0438 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u0430.
      \u041E\u043D \u0432\u0441\u0442\u0430\u0451\u0442, \u0431\u0435\u0440\u0451\u0442
      \u043A\u0430\u0436\u0434\u044B\u0439, \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043A \u0441\u0432\u0435\u0442\u0443, \u0447\u0438\u0442\u0430\u0435\u0442
      \u043D\u0430\u0434\u043F\u0438\u0441\u0438 \u0431\u0435\u0437\u0437\u0432\u0443\u0447\u043D\u043E.
      \xAB\u0422\u0440\u0438. \u0418\u043C\u0435\u043D\u043D\u043E \u0442\u0440\u0438.\xBB
      \u0415\u0433\u043E \u043B\u0438\u0446\u043E \u2014 \u0440\u0435\u0434\u043A\u043E\u0435
      \u0437\u0440\u0435\u043B\u0438\u0449\u0435 \u2014 \u0432\u044B\u0440\u0430\u0436\u0430\u0435\u0442
      \u043D\u0435\u0447\u0442\u043E \u043F\u043E\u0445\u043E\u0436\u0435\u0435 \u043D\u0430
      \u0441\u0447\u0430\u0441\u0442\u044C\u0435. \xAB\u0422\u044B \u043D\u0435 \u0437\u043D\u0430\u0435\u0448\u044C,
      \u0447\u0442\u043E \u0434\u0435\u0440\u0436\u0438\u0448\u044C \u0432 \u0440\u0443\u043A\u0430\u0445.
      \u042F \u043E\u0431\u044A\u044F\u0441\u043D\u044E \u2014 \u043D\u043E \u0441\u043D\u0430\u0447\u0430\u043B\u0430:
      \u0435\u0441\u0442\u044C \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439
      \u0441\u043B\u0435\u0434. \u0413\u043E\u0442\u043E\u0432 \u043A \u043D\u0435\u043C\u0443
      \u0441\u0435\u0439\u0447\u0430\u0441?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877878
    m_Localized: "\u0413\u043E\u0442\u043E\u0432 \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877879
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043D\u043E\u0432\u0443\u044E \u043A\u0430\u0440\u0442\u0443 \u0441 \u0434\u0440\u043E\u0436\u0430\u0449\u0438\u043C\u0438
      \u0440\u0443\u043A\u0430\u043C\u0438. \xAB\u041F\u043E\u0434\u0434\u0435\u043B\u043A\u0438.
      \u041A\u0442\u043E-\u0442\u043E \u0442\u043E\u0440\u0433\u0443\u0435\u0442
      \u0444\u0430\u043B\u044C\u0448\u0438\u0432\u043A\u0430\u043C\u0438 \u043D\u0430\u0448\u0438\u0445
      \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0439. \u042D\u0442\u043E \u043D\u0443\u0436\u043D\u043E
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877880
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u0432\u0440\u0435\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877881
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0431\u0435\u0440\u0435\u0436\u043D\u043E
      \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u044B
      \u0432 \u044F\u0449\u0438\u043A. \xAB\u041E\u043D\u0438 \u0437\u0434\u0435\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877882
    m_Localized: "\u0420\u0430\u0437\u043E\u0431\u043B\u0430\u0447\u0435\u043D\u0438\u0435
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877883
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0441\u0442\u043E\u0438\u0442 \u0443
      \u0432\u0445\u043E\u0434\u0430 \u0432 \u0410\u0440\u0445\u0438\u0432 \u0438
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442, \u043A\u0430\u043A \u0432\u044B
      \u0432\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0451\u043D\u043D\u044B\u043C\u0438
      \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F\u043C\u0438. \u041E\u043D
      \u043C\u043E\u043B\u0447\u0430 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A, \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u2014 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044F
      \u043A\u0430\u0436\u0434\u0443\u044E \u0432\u0435\u0449\u044C. \xAB\u041F\u043E\u0434\u043B\u0438\u043D\u043D\u044B\u0435,\xBB
      \u2014 \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442
      \u043E\u043D \u0441 \u043E\u0431\u043B\u0435\u0433\u0447\u0435\u043D\u0438\u0435\u043C.
      \xAB\u041C\u043E\u0448\u0435\u043D\u043D\u0438\u043A\u0438 \u0434\u0443\u043C\u0430\u043B\u0438,
      \u0447\u0442\u043E \u0440\u044B\u043D\u043E\u043A \u043D\u0435 \u0440\u0430\u0437\u0431\u0435\u0440\u0451\u0442.
      \u0422\u044B \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043B\u0441\u044F.\xBB
      \u041E\u043D \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0438
      \u043D\u0430 \u043F\u043E\u043B\u043A\u0443 \u0441 \u0438\u043C\u0435\u043D\u043D\u044B\u043C\u0438
      \u044F\u0440\u043B\u044B\u043A\u0430\u043C\u0438. \xAB\u0422\u0435\u043F\u0435\u0440\u044C
      \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C \u0440\u044B\u043D\u043E\u043A
      \u0438\u0437\u043D\u0443\u0442\u0440\u0438. \u0415\u0441\u0442\u044C \u043A\u043E\u0435-\u0447\u0442\u043E
      \u0432\u0430\u0436\u043D\u0435\u0435. \u041B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u043E\u0435
      \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435. \u0412\u043E\u0437\u044C\u043C\u0451\u0448\u044C\u0441\u044F
      \u0441\u0435\u0439\u0447\u0430\u0441?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877884
    m_Localized: "\u0413\u043E\u0432\u043E\u0440\u0438 \u043F\u0440\u043E \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877885
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u043A\u0430\u0440\u0442\u0443 \u0441 \u0433\u043E\u0440\u043D\u044B\u043C\u0438
      \u043E\u0442\u043C\u0435\u0442\u043A\u0430\u043C\u0438. \xAB\u0414\u0440\u0435\u0432\u043D\u044F\u044F
      \u043A\u0430\u0440\u0442\u0430. \u0412\u0435\u0440\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877886
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877887
    m_Localized: "\xAB\u0418\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877888
    m_Localized: "\u0425\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877889
    m_Localized: "\u0414\u0432\u0435\u0440\u044C \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0430
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0441 \u0442\u044F\u0436\u0451\u043B\u044B\u043C
      \u0432\u0437\u0434\u043E\u0445\u043E\u043C \u2014 \u0431\u0443\u0434\u0442\u043E
      \u0441\u043A\u0430\u043B\u0430 \u0434\u044B\u0448\u0438\u0442 \u0432\u043F\u0435\u0440\u0432\u044B\u0435
      \u0437\u0430 \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u044F. \u0412\u043D\u0443\u0442\u0440\u0438
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0441\u0443\u0445\u0438\u043C \u043A\u0430\u043C\u043D\u0435\u043C
      \u0438 \u043C\u0435\u0442\u0430\u043B\u043B\u043E\u043C: \u043F\u043E\u043B\u043A\u0438
      \u0441 \u043A\u0443\u0432\u0448\u0438\u043D\u0430\u043C\u0438, \u0441\u0432\u0438\u0442\u043A\u0438
      \u0432 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0445 \u043D\u0438\u0448\u0430\u0445,
      \u043C\u0435\u0434\u043D\u044B\u0435 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u044B
      \u0441 \u043D\u0430\u0434\u043F\u0438\u0441\u044F\u043C\u0438. \u0424\u0430\u0440\u0443\u0445
      \u0437\u0430 \u0432\u0430\u0448\u0438\u043C \u043F\u043B\u0435\u0447\u043E\u043C
      \u043C\u043E\u043B\u0447\u0438\u0442 \u0434\u043E\u043B\u044C\u0448\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E.
      \xAB\u042D\u0442\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435,\xBB
      \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D \u043D\u0430\u043A\u043E\u043D\u0435\u0446
      \u0448\u0451\u043F\u043E\u0442\u043E\u043C. \xAB\u041C\u044B \u043D\u0430\u0448\u043B\u0438
      \u0442\u043E, \u043E \u0447\u0451\u043C \u044F \u0447\u0438\u0442\u0430\u043B
      \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C.\xBB \u041E\u043D \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      \xAB\u041E\u0441\u0442\u0430\u043B\u0441\u044F \u0444\u0438\u043D\u0430\u043B:
      \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u0430\u043C\u043E\u0435
      \u0446\u0435\u043D\u043D\u043E\u0435 \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u044C.
      \u0413\u043E\u0442\u043E\u0432?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877890
    m_Localized: "\u0413\u043E\u0442\u043E\u0432 \u043A \u0444\u0438\u043D\u0430\u043B\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877891
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0431\u0435\u0440\u0435\u0436\u043D\u043E
      \u0431\u0435\u0440\u0451\u0442 \u0441\u0430\u043C\u044B\u0439 \u0441\u0442\u0430\u0440\u044B\u0439
      \u0441\u0432\u0438\u0442\u043E\u043A. \xAB\u0427\u0430\u043D\u044A\u0430\u043D\u044C.
      \u0414\u0432\u043E\u0440\u0446\u043E\u0432\u044B\u0439 \u0430\u0440\u0445\u0438\u0432.
      \u0422\u0443\u0434\u0430 \u2014 \u0438 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0442\u0443\u0434\u0430.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877892
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877893
    m_Localized: "\xAB\u0425\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435 \u043D\u0438\u043A\u0443\u0434\u0430
      \u043D\u0435 \u0434\u0435\u043D\u0435\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760157016064
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0414\u0430\u0440\u0438\u0443\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570496
    m_Localized: "\u0423 \u0434\u0432\u0435\u0440\u0435\u0439 \u043A\u0430\u0437\u0430\u0440\u043C
      \u0432\u0430\u0441 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0433\u0440\u0443\u0437\u043D\u044B\u0439 \u0441\u0435\u0434\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0432 \u043F\u043E\u0442\u0451\u0440\u0442\u043E\u043C \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u044C\u0435\u043C
      \u043A\u0430\u0444\u0442\u0430\u043D\u0435 \u2014 \u043B\u0438\u0446\u043E
      \u0432 \u0448\u0440\u0430\u043C\u0430\u0445 \u043E\u0442 \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u043E\u0433\u043E
      \u0432\u0435\u0442\u0440\u0430, \u043D\u0430 \u043B\u0435\u0432\u043E\u0439
      \u0440\u0443\u043A\u0435 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0430\u044F
      \u0442\u0430\u0442\u0443\u0438\u0440\u043E\u0432\u043A\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0430
      \u0441\u0442\u0430\u0440\u043E\u0439 \u0448\u043A\u043E\u043B\u044B. \u042D\u0442\u043E
      \u0414\u0430\u0440\u0438\u0443\u0448, \u0432\u0435\u0442\u0435\u0440\u0430\u043D
      \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u0433\u043E \u043F\u0443\u0442\u0438,
      \u0442\u0435\u043F\u0435\u0440\u044C \u0443\u0447\u0438\u0442 \u043C\u043E\u043B\u043E\u0434\u044B\u0445.
      \u041E\u043D \u0441\u0440\u0430\u0437\u0443 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u043A \u0434\u0435\u043B\u0443: \xAB\u0423 \u043C\u0435\u043D\u044F \u043F\u0430\u0440\u0442\u0438\u044F
      \u0436\u0435\u043B\u0442\u043E\u0443\u0445\u0438\u0445 \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432.
      \u0414\u0435\u0441\u044F\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u0448\u0435\u0441\u0442\u044C \u043F\u043E\u0432\u043E\u0437\u043E\u043A.
      \u041D\u0430\u0434\u043E \u0434\u043E\u0432\u0435\u0441\u0442\u0438 \u0434\u043E
      \u0410\u043D\u044C\u0441\u0438. \u041F\u043B\u0430\u0442\u044F\u0442 \u043A\u0430\u0437\u0430\u0440\u043C\u044B,
      \u043D\u043E \u043B\u044E\u0434\u0438 \u2014 \u043C\u043E\u0438.\xBB \u041E\u043D
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0448
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u044E\u0449\u0438\u043C
      \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C. \xAB\u0411\u0435\u0440\u0451\u0448\u044C\u0441\u044F?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570497
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570498
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u043A\u0438\u0432\u0430\u0435\u0442,
      \u043D\u0435 \u0432\u044B\u043A\u0430\u0437\u044B\u0432\u0430\u044F \u043E\u0431\u0438\u0434\u044B.
      \xAB\u041A\u0430\u0436\u0434\u044B\u0439 \u0441\u0430\u043C \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442
      \u0441\u0432\u043E\u044E \u0434\u043E\u0440\u043E\u0433\u0443. \u0410\u043D\u044C\u0441\u0438
      \u2014 \u043D\u0435 \u0434\u043B\u044F \u0432\u0441\u0435\u0445.\xBB \u041E\u043D
      \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u043A\u0430\u0437\u0430\u0440\u043C\u0435\u043D\u043D\u043E\u043C\u0443
      \u0434\u0432\u043E\u0440\u0443, \u0433\u0434\u0435 \u043D\u043E\u0432\u0438\u0447\u043A\u0438
      \u0432\u043E\u0437\u044F\u0442\u0441\u044F \u0441 \u0443\u043F\u0440\u044F\u0436\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570499
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0432\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570500
    m_Localized: "\u0412\u044B \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442\u0435
      \u0436\u0438\u043B\u0438\u0441\u0442\u0443\u044E \u0440\u0443\u043A\u0443 \u0414\u0430\u0440\u0438\u0443\u0448\u0430.
      \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442, \u043A\u0430\u043A
      \u0432\u044B \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432, \u043A\u0430\u043A \u0440\u0430\u0437\u0434\u0430\u0451\u0442\u0435
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435 \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0436\u0435\u043D\u0438\u044F
      \u2014 \u0438 \u0432 \u0435\u0433\u043E \u0433\u043B\u0430\u0437\u0430\u0445
      \u043C\u0435\u043B\u044C\u043A\u0430\u0435\u0442 \u043E\u0434\u043E\u0431\u0440\u0435\u043D\u0438\u0435.
      \xAB\u0412\u0438\u0434\u043D\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.
      \u0414\u043E \u0410\u043D\u044C\u0441\u0438 \u2014 \u0434\u0432\u0435 \u043D\u0435\u0434\u0435\u043B\u0438
      \u043F\u043E \u043F\u043B\u043E\u0445\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0435.
      \u0414\u043E\u0432\u0435\u0434\u0451\u0448\u044C \u2014 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C
      \u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u0435.\xBB
      \u041E\u043D \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u0432\u0430\u043C
      \u043F\u0430\u0439\u0446\u0437\u0443 \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E
      \u043A\u0430\u0437\u0430\u0440\u043C \u0438 \u0441\u043F\u0438\u0441\u043E\u043A
      \u043F\u043E\u0434\u043E\u043F\u0435\u0447\u043D\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570501
    m_Localized: "\u0412\u044B \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0435\u0441\u044C,
      \u043D\u043E \u0414\u0430\u0440\u0438\u0443\u0448 \u0432\u0438\u0434\u0438\u0442,
      \u0447\u0442\u043E \u043D\u043E\u0432\u0438\u0447\u043A\u0438 \u0432\u0430\u043C
      \u043D\u0435 \u0434\u043E\u0432\u0435\u0440\u044F\u044E\u0442 \u2014 \u0441\u043B\u043E\u0432\u0430
      \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442 \u043D\u0435\u0443\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0435,
      \u0433\u043E\u043B\u043E\u0441 \u0432\u044B\u0434\u0430\u0451\u0442. \u041E\u043D
      \u043C\u043E\u0440\u0449\u0438\u0442\u0441\u044F \u0438 \u043A\u0430\u0447\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439. \xAB\u041B\u0430\u0434\u043D\u043E,
      \u0431\u0435\u0440\u0438. \u041D\u043E \u043F\u0430\u0439\u0446\u0437\u0443
      \u043F\u043E\u043A\u0430 \u043F\u0440\u0438\u0434\u0435\u0440\u0436\u0443.\xBB
      \u041E\u0434\u0438\u043D \u0438\u0437 \u0441\u0442\u0430\u0440\u0448\u0438\u0445
      \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432, \u0425\u0430\u0441\u0430\u043D,
      \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u043F\u0440\u0430\u0432\u043E
      \u0433\u043E\u043B\u043E\u0441\u0430 \u2014 \u0438 \u0441\u043F\u043E\u0440\u0438\u0442
      \u0441 \u0432\u0430\u043C\u0438 \u0437\u0430 \u043A\u0430\u0436\u0434\u0443\u044E
      \u043C\u0435\u043B\u043E\u0447\u044C. \u0414\u043E\u0440\u043E\u0433\u0430
      \u0431\u0443\u0434\u0435\u0442 \u0434\u043B\u0438\u043D\u043D\u0435\u0435,
      \u0447\u0435\u043C \u0434\u043E\u043B\u0436\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570502
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u0437\u0430\u043C\u043E\u043B\u0432\u0438\u0442 \u0441\u043B\u043E\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570503
    m_Localized: "\u0412\u0430\u0448 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u0434\u0435\u043B\u0430\u0435\u0442 \u0448\u0430\u0433 \u0432\u043F\u0435\u0440\u0451\u0434
      \u0438 \u0445\u043B\u043E\u043F\u0430\u0435\u0442 \u0414\u0430\u0440\u0438\u0443\u0448\u0430
      \u043F\u043E \u043F\u043B\u0435\u0447\u0443 \u2014 \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
      \u043E\u043D\u0438 \u0441\u043B\u0443\u0436\u0438\u043B\u0438 \u0432\u043C\u0435\u0441\u0442\u0435
      \u043F\u0440\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435 \u0432
      \u0425\u043E\u0440\u0430\u0441\u0430\u043D. \u0414\u0430\u0440\u0438\u0443\u0448
      \u0440\u0430\u0441\u043F\u043B\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0432
      \u0440\u0435\u0434\u043A\u043E\u0439 \u0443\u043B\u044B\u0431\u043A\u0435.
      \xAB\u0415\u0441\u043B\u0438 \u0442\u044B \u0441 \u0420\u0443\u0441\u0442\u0430\u043C\u043E\u043C
      \u2014 \u0434\u0440\u0443\u0433\u043E\u0439 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440.\xBB
      \u041E\u043D \u043E\u0442\u0434\u0430\u0451\u0442 \u043F\u0430\u0439\u0446\u0437\u0443
      \u0438 \u0441\u043F\u0438\u0441\u043E\u043A \u0431\u0435\u0437 \u0440\u0430\u0437\u0434\u0443\u043C\u0438\u0439,
      \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044F: \xAB\u0418 \u0434\u0432\u0443\u0445
      \u0441\u0432\u043E\u0438\u0445 \u0440\u0435\u0431\u044F\u0442 \u0434\u0430\u043C
      \u0432 \u043F\u043E\u043C\u043E\u0449\u044C. \u0411\u0435\u0440\u0435\u0433\u0438
      \u0438\u0445, \u043A\u0430\u043A \u0441\u0432\u043E\u0438\u0445.\xBB \u0412\u044B
      \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u0437\u0430\u0434\u0430\u043D\u0438\u0435\u043C,
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u043E\u0439 \u043F\u0430\u0439\u0446\u0437\u043E\u0439
      \u0438 \u0434\u0432\u0443\u043C\u044F \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438
      \u0431\u043E\u0439\u0446\u0430\u043C\u0438 \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570504
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570505
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442
      \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438 \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u043F\u0430\u0439\u0446\u0437\u0443 \u0437\u0430 \u043F\u043E\u044F\u0441.
      \xAB\u0414\u0443\u043C\u0430\u0439. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u043E\u0439\u0434\u0451\u0442 \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u0438
      \u0434\u043D\u044F \u2014 \u0441 \u0442\u043E\u0431\u043E\u0439 \u0438\u043B\u0438
      \u0431\u0435\u0437.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570506
    m_Localized: "\u041F\u043E\u0434\u043E\u0439\u0442\u0438 \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570507
    m_Localized: "\u0412\u044B \u0441\u043F\u0435\u0448\u0438\u0432\u0430\u0435\u0442\u0435\u0441\u044C
      \u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442\u0435 \u043A \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0443.
      \u041E\u043D \u0440\u0430\u0441\u043A\u043B\u0430\u043D\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u0435\u0442 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0442\u043E\u0432\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570508
    m_Localized: "\u041A\u0438\u0432\u043D\u0443\u0442\u044C \u0438 \u043F\u0440\u043E\u0439\u0442\u0438
      \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570509
    m_Localized: "\u0412\u044B \u043A\u0438\u0432\u043A\u043E\u043C \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442\u0435
      \u043D\u0430 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435
      \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0435 \u043F\u0443\u0442\u044C.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442
      \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u043A \u0441\u0432\u043E\u0438\u043C \u0442\u044E\u043A\u0430\u043C \u2014
      \u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0441\u0432\u043E\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570510
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570511
    m_Localized: "\u0412\u044B \u0441\u0430\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430
      \u043A\u0440\u0430\u0439 \u043A\u043E\u0432\u0440\u0430 \u0438 \u0431\u0435\u0440\u0451\u0442\u0435
      \u0432 \u0440\u0443\u043A\u0438 \u0442\u043E \u043E\u0434\u043D\u043E, \u0442\u043E
      \u0434\u0440\u0443\u0433\u043E\u0435. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u043E\u0445\u043E\u0442\u043D\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043E \u043A\u0430\u0436\u0434\u043E\u0439 \u0432\u0435\u0449\u0438 \u2014
      \u0433\u0434\u0435 \u043A\u0443\u043F\u043B\u0435\u043D\u0430, \u0443 \u043A\u043E\u0433\u043E,
      \u043F\u043E \u043A\u0430\u043A\u043E\u0439 \u0446\u0435\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570512
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u0438 \u0438\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570513
    m_Localized: "\u0412\u044B \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u0435
      \u0437\u0430 \u0433\u043E\u0441\u0442\u0435\u043F\u0440\u0438\u0438\u043C\u0441\u0442\u0432\u043E
      \u0438 \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0435\u0441\u044C.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043B\u0430\u0434\u043E\u043D\u0438 \u0443 \u0433\u0440\u0443\u0434\u0438
      \u2014 \xAB\u043B\u0451\u0433\u043A\u043E\u0433\u043E \u043F\u0443\u0442\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570514
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043E\u0431\u043C\u0435\u043D
      \u0442\u043E\u0432\u0430\u0440\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570515
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D\u044B \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u0434\u0440\u0443\u0433 \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432 \u0434\u0440\u0443\u0433\u0430,
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E\u0442
      \u0442\u044E\u043A\u0438. \u041C\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043C\u044F
      \u043E\u0431\u043E\u0437\u0430\u043C\u0438 \u0437\u0430\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0442\u043E\u0440\u0433 \u2014 \u0434\u0435\u043B\u043E\u0432\u043E\u0439
      \u0438 \u043D\u0435\u0441\u043F\u0435\u0448\u043D\u044B\u0439, \u043A\u0430\u043A
      \u0438 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043E \u043D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570516
    m_Localized: "\u041E\u0431\u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F\u043C\u0438
      \u0438 \u0440\u0430\u0437\u043E\u0439\u0442\u0438\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570517
    m_Localized: "\u0412\u044B \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u0435\u0442\u0435\u0441\u044C
      \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F\u043C\u0438
      \u2014 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435 \u043D\u043E\u0432\u043E\u0441\u0442\u0438
      \u0441 \u0434\u043E\u0440\u043E\u0433\u0438, \u0438\u043C\u0435\u043D\u0430
      \u0433\u043E\u0440\u043E\u0434\u043E\u0432, \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u044B \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F,
      \u0443\u043D\u043E\u0441\u044F \u0447\u0443\u0436\u0438\u0435 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B
      \u0432 \u043F\u0430\u043C\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570518
    m_Localized: "\u0428\u043A\u0443\u0440\u044B \u0440\u0430\u0437\u044A\u0435\u0445\u0430\u043B\u0438\u0441\u044C
      \u043F\u043E\u0434 \u043A\u043E\u043B\u0451\u0441\u0430\u043C\u0438, \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0441\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0430 \u0431\u043E\u043A\u043E\u043C.
      \u0423\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0443\u0434\u0430\u043B\u043E\u0441\u044C,
      \u043D\u043E \u043E\u0441\u044C\u044E \u0443\u0434\u0430\u0440\u0438\u043B\u043E
      \u043E \u0441\u043A\u0430\u043B\u0443. \u0427\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430
      \u0432\u044B\u043B\u0435\u0442\u0435\u043B\u0430 \u0432 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C,
      \u043E\u0441\u044C \u0442\u0440\u0435\u0441\u043D\u0443\u043B\u0430. \u0414\u0435\u043D\u044C
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D, \u0438 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u0438
      \u0432 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430\u0445 \u043F\u043E\u0443\u0431\u0430\u0432\u0438\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570519
    m_Localized: "\u0416\u0435\u0441\u0442\u044B \u0432\u044B\u0448\u043B\u0438 \u043D\u0435\u043B\u043E\u0432\u043A\u0438\u0435,
      \u043B\u043E\u043C\u0430\u043D\u044B\u0435 \u0441\u043B\u043E\u0432\u0430 \u2014
      \u043E\u0431\u0438\u0434\u043D\u044B\u0435. \u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440
      \u043D\u0430\u0445\u043C\u0443\u0440\u0438\u043B\u0441\u044F \u0438 \u0443\u0434\u0432\u043E\u0438\u043B
      \u043F\u043E\u0448\u043B\u0438\u043D\u0443 \xAB\u0437\u0430 \u043D\u0435\u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\xBB.
      \u0421\u0435\u0440\u0435\u0431\u0440\u043E \u0443\u0448\u043B\u043E \u0432\u0434\u0432\u043E\u0435
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u0430\u0434\u0443\u043C\u0430\u043D\u043D\u043E\u0433\u043E,
      \u0430 \u0434\u0432\u043E\u0435 \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u043E\u0432
      \u0441\u043E\u043F\u0440\u043E\u0432\u043E\u0436\u0434\u0430\u043B\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0434\u043E \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430, \u0441\u043B\u043E\u0432\u043D\u043E
      \u043A\u043E\u043D\u0432\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570520
    m_Localized: "\u0421\u0442\u044B\u0447\u043A\u0430 \u043F\u043E\u0448\u043B\u0430
      \u043D\u0435 \u043F\u043E \u043F\u043B\u0430\u043D\u0443. \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432
      \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0432\u0438\u0434\u0435\u043B\u043E\u0441\u044C \u0438\u0437-\u0437\u0430
      \u0432\u0430\u043B\u0443\u043D\u043E\u0432, \u0438 \u0431\u0430\u0440\u0440\u0438\u043A\u0430\u0434\u0443
      \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0440\u0432\u0430\u043B\u0441\u044F
      \u0446\u0435\u043D\u043E\u0439 \u0440\u0430\u043D\u0435\u043D\u044B\u0445,
      \u0443\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u044B\u0445 \u0442\u044E\u043A\u043E\u0432
      \u0438 \u043F\u0430\u0432\u0448\u0435\u0433\u043E \u0432\u044C\u044E\u0447\u043D\u043E\u0433\u043E
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570521
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0431\u043E\u0433\u043D\u0443\u043B
      \u043C\u043E\u043D\u0430\u0445\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439,
      \u043D\u043E \u0432 \u043E\u0431\u0445\u043E\u0434 \u0442\u0440\u043E\u043F\u0430
      \u0441\u0443\u0436\u0430\u043B\u0430\u0441\u044C \u0438 \u0448\u043B\u0430
      \u043F\u043E\u0434 \u043D\u0430\u0432\u0438\u0441\u0430\u044E\u0449\u0438\u043C
      \u043A\u0430\u0440\u043D\u0438\u0437\u043E\u043C. \u041A\u0430\u043C\u043D\u0435\u043F\u0430\u0434
      \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0441\u044F \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F.
      \u0414\u0432\u0443\u0445 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0437\u0430\u0434\u0435\u043B\u043E, \u043F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0440\u0430\u0437\u0431\u0438\u043B\u043E, \u0433\u0440\u0443\u0437 \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u0441\u044F
      \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443. \u041C\u043E\u043B\u0438\u0442\u0432\u044B
      \u043C\u043E\u043D\u0430\u0445\u0430 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u043B\u0438
      \u043D\u0435 \u0437\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570522
    m_Localized: "\u0411\u0435\u0437 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u044B
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0443\u043F\u0443\u0441\u0442\u0438\u043B
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442 \u0432 \u0442\u0443\u043C\u0430\u043D\u0435
      \u0438 \u0437\u0430\u0431\u0440\u0451\u043B \u0432 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439
      \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442. \u0414\u0432\u043E\u0435
      \u0441\u0443\u0442\u043E\u043A \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B
      \u043D\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435,
      \u0441\u043A\u043E\u0442 \u0438\u0437\u043C\u043E\u0442\u0430\u043D, \u0432
      \u0442\u044E\u043A\u0430\u0445 \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C
      \u0441\u043B\u0435\u0434\u044B \u0434\u043E\u0436\u0434\u044F. \u0414\u0435\u043D\u044C\u0433\u0438,
      \u0447\u0442\u043E \u0432\u044B \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043B\u0438,
      \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u043F\u043E\u0442\u0435\u0440\u044F\u043C\u0438
      \u0432\u0442\u0440\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570523
    m_Localized: "\u0421\u043C\u0435\u043B\u044C\u0447\u0430\u043A\u0438 \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0438\u0441\u044C
      \u0441\u043E \u0441\u043A\u043B\u043E\u043D\u0430 \u043E\u0449\u0443\u043F\u044C\u044E,
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u043E\u0441\u0442\u0443\u043F\u0438\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0441\u044B\u043F\u0443\u0447\u0438\u0445 \u043A\u0430\u043C\u043D\u044F\u0445.
      \u041E\u0434\u0438\u043D \u0441\u043E\u0440\u0432\u0430\u043B\u0441\u044F,
      \u043F\u043E\u0432\u0440\u0435\u0434\u0438\u043B \u043D\u043E\u0433\u0443;
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0441 \u043F\u043E\u0440\u0432\u0430\u043D\u043D\u043E\u0439 \u043A\u0443\u0440\u0442\u043A\u043E\u0439
      \u0438 \u0431\u0435\u0437 \u0444\u0430\u043A\u0435\u043B\u0430. \u041E\u0433\u043D\u0438
      \u0432\u0441\u0451 \u0442\u0430\u043A \u0436\u0435 \u043C\u0435\u0440\u0446\u0430\u043B\u0438
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435, \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435.
      \u0423\u0442\u0440\u043E\u043C \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0432\u044B\u0437\u044B\u0432\u0430\u0442\u044C \u043F\u043E\u043C\u043E\u0449\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570524
    m_Localized: "\u041A\u0430\u043C\u043D\u0438 \u0438 \u0431\u0440\u0451\u0432\u043D\u0430
      \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u043B\u0438, \u0432\u0435\u0440\u0451\u0432\u043A\u0430
      \u043E\u0431\u043E\u0440\u0432\u0430\u043B\u0430\u0441\u044C. \u041F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0441\u043E\u0440\u0432\u0430\u043B\u0430\u0441\u044C, \u043F\u0440\u043E\u043A\u0430\u0442\u0438\u043B\u0430\u0441\u044C
      \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443 \u0438 \u0440\u0430\u0437\u0431\u0438\u043B\u0430\u0441\u044C
      \u043E \u0432\u044B\u0441\u0442\u0443\u043F \u0441\u043A\u0430\u043B\u044B
      \u043C\u0435\u0442\u0440\u0430\u0445 \u0432 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438
      \u043D\u0438\u0436\u0435. \u0413\u0440\u0443\u0437 \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u0441\u044F
      \u043F\u043E \u043A\u0430\u043C\u043D\u044F\u043C, \u0447\u0430\u0441\u0442\u044C
      \u2014 \u0432 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C. \u041B\u043E\u0448\u0430\u0434\u0435\u0439
      \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043E\u0431\u0440\u0435\u0437\u0430\u0442\u044C
      \u0432\u043E\u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570525
    m_Localized: "\u0421\u0440\u0443\u0431\u043B\u0435\u043D\u043D\u043E\u0435 \u0434\u0435\u0440\u0435\u0432\u0446\u0435
      \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0433\u043D\u0438\u043B\u044B\u043C
      \u0432\u043D\u0443\u0442\u0440\u0438, \u043A\u043E\u0436\u0430\u043D\u044B\u0435
      \u0440\u0435\u043C\u043D\u0438 \u043B\u043E\u043F\u043D\u0443\u043B\u0438 \u043D\u0430
      \u043F\u0435\u0440\u0432\u043E\u043C \u0436\u0435 \u0440\u044B\u0432\u043A\u0435.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0430 \u0441\u043D\u043E\u0432\u0430 \u043F\u0440\u043E\u0441\u0435\u043B\u0430,
      \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u0443\u0436\u0435 \u0433\u0440\u0443\u0437
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0441\u043D\u0438\u043C\u0430\u0442\u044C
      \u0438 \u043D\u0435\u0441\u0442\u0438 \u043D\u0430 \u0440\u0443\u043A\u0430\u0445
      \u0434\u043E \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0433\u043E \u043B\u0430\u0433\u0435\u0440\u044F.
      \u041F\u043E\u043B\u0434\u043D\u044F \u043F\u043E\u0442\u0435\u0440\u0438 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0438\u0441\u044C
      \u0432 \u0434\u0432\u043E\u0435 \u0441\u0443\u0442\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570526
    m_Localized: "\u041A\u0438\u0440\u043A\u0430 \u0443\u0434\u0430\u0440\u0438\u043B\u0430
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0431\u043B\u0438\u0437\u043A\u043E
      \u043A \u043E\u043F\u043E\u0440\u0435. \u0421\u0432\u043E\u0434 \u0442\u0440\u0435\u0441\u043D\u0443\u043B,
      \u0438 \u043F\u044B\u043B\u044C \u0445\u043B\u044B\u043D\u0443\u043B\u0430
      \u0432\u043D\u0438\u0437. \u041E\u0434\u0438\u043D \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0435\u0434\u0432\u0430 \u0443\u0441\u043F\u0435\u043B \u0432\u044B\u0441\u043A\u043E\u0447\u0438\u0442\u044C
      \u0441 \u0434\u0432\u0443\u043C\u044F \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u0430\u043C\u0438
      \u0432 \u0440\u0443\u043A\u0430\u0445, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u2014 \u043F\u043E\u0434 \u0437\u0430\u0432\u0430\u043B\u043E\u043C. \u0421\u043F\u0443\u0441\u043A\u0430\u0442\u044C\u0441\u044F
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0437\u0430 \u0434\u043E\u0431\u044B\u0447\u0435\u0439
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0440\u0438\u0441\u043A\u043D\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570527
    m_Localized: "\u0412\u044B \u043F\u044B\u0442\u0430\u0435\u0442\u0435\u0441\u044C
      \u0441\u0434\u0432\u0438\u043D\u0443\u0442\u044C \u0430\u043B\u0442\u0430\u0440\u044C,
      \u043D\u043E \u043F\u043B\u0438\u0442\u0430 \u043F\u0430\u0434\u0430\u0435\u0442
      \u0441 \u0433\u0440\u043E\u0445\u043E\u0442\u043E\u043C, \u043E\u0431\u043D\u0430\u0436\u0430\u044F
      \u043F\u0443\u0441\u0442\u0443\u044E \u043D\u0438\u0448\u0443 \u2014 \u043A\u0442\u043E-\u0442\u043E
      \u043F\u043E\u0431\u044B\u0432\u0430\u043B \u0437\u0434\u0435\u0441\u044C \u0434\u043E
      \u0432\u0430\u0441. \u041D\u0430 \u0441\u0442\u0435\u043D\u0430\u0445 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u0442\u0440\u0435\u0449\u0438\u043D\u044B, \u0438 \u043A\u0430\u043C\u0435\u043D\u043D\u0430\u044F
      \u043F\u044B\u043B\u044C \u0437\u0430\u0441\u044B\u043F\u0430\u0435\u0442 \u0444\u0440\u0435\u0441\u043A\u0438.
      \u0423\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u043F\u0443\u0441\u0442\u044B\u043C\u0438
      \u0440\u0443\u043A\u0430\u043C\u0438 \u0438 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u044B\u043C
      \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435\u043C, \u0447\u0442\u043E
      \u043F\u043E\u0442\u0440\u0435\u0432\u043E\u0436\u0438\u043B\u0438 \u043C\u0435\u0441\u0442\u043E,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043B\u0443\u0447\u0448\u0435 \u0431\u044B\u043B\u043E
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432 \u043F\u043E\u043A\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496568623104
    m_Localized: "\u0425\u0430\u0434\u0436\u0438 \u042E\u0441\u0443\u0444"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177536
    m_Localized: "\u0412 \u0411\u0443\u0445\u0430\u0440\u0435, \u0432 \u0442\u0435\u043D\u0438\u0441\u0442\u043E\u043C
      \u0434\u0432\u043E\u0440\u0435 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u0434\u043E\u043C\u0430 \u0410\u043B\u044C-\u0411\u0443\u0445\u0430\u0440\u0438,
      \u0432\u0430\u0441 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u0425\u0430\u0434\u0436\u0438
      \u042E\u0441\u0443\u0444 \u2014 \u0441\u0442\u0430\u0440\u0448\u0438\u0439
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044C
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0439 \u043A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u043E\u0439
      \u0441\u0435\u043C\u044C\u0438 \u0432 \u0442\u0440\u0435\u0442\u044C\u0435\u043C
      \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u0438. \u041D\u0430 \u0441\u0442\u043E\u043B\u0435
      \u043F\u0438\u0430\u043B\u0430 \u0441 \u0437\u0435\u043B\u0451\u043D\u044B\u043C
      \u0447\u0430\u0435\u043C \u0438 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442
      \u043D\u0430 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0435,
      \u0441\u043A\u0440\u0435\u043F\u043B\u0451\u043D\u043D\u044B\u0439 \u043F\u0435\u0447\u0430\u0442\u044C\u044E
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438. \u042E\u0441\u0443\u0444 \u0436\u0434\u0451\u0442.
      \u0426\u0438\u0444\u0440\u044B \u0432 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0435
      \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u044B \u043A\u0440\u0443\u043F\u043D\u043E,
      \u043D\u043E \u043E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0435
      \u043D\u0430 \u043D\u0438\u0445 \u2014 \u043E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177537
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0443\u0441\u043B\u043E\u0432\u0438\u044F
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177538
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442\u0435
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u0431\u0435\u0437 \u043F\u0440\u0430\u0432\u043E\u043A.
      \u042E\u0441\u0443\u0444 \u043A\u0438\u0432\u0430\u0435\u0442 \u0441 \u043B\u0451\u0433\u043A\u0438\u043C
      \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u0435\u043C
      \u2014 \u0432 \u0411\u0443\u0445\u0430\u0440\u0435 \u0443\u0432\u0430\u0436\u0430\u044E\u0442
      \u0442\u0435\u0445, \u043A\u0442\u043E \u0442\u043E\u0440\u0433\u0443\u0435\u0442\u0441\u044F.
      \u041F\u0435\u0447\u0430\u0442\u044C \u0433\u0438\u043B\u044C\u0434\u0438\u0438
      \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044F \u043D\u0430 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442,
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E \u043E\u0442\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043B\u0430\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043F\u043E\u0434\u043D\u043E\u0441. \u0421\u0434\u0435\u043B\u043A\u0430
      \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0430, \u043D\u043E \u042E\u0441\u0443\u0444
      \u0432\u0430\u0441 \u0443\u0436\u0435 \u043D\u0435 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177539
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0437\u0430 \u0434\u043E\u043B\u044E \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177540
    m_Localized: "\u0412\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u043E
      \u0440\u0430\u0441\u0445\u043E\u0434\u0430\u0445 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443,
      \u043E \u043D\u0430\u043B\u043E\u0433\u0430\u0445 \u044D\u043C\u0438\u0440\u0430,
      \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u0440\u0430\u0441\u0442\u0443\u0442
      \u0446\u0435\u043D\u044B \u043D\u0430 \u0445\u043B\u043E\u043F\u043E\u043A
      \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u0435. \u042E\u0441\u0443\u0444
      \u0441\u043B\u0443\u0448\u0430\u0435\u0442, \u043A\u0438\u0432\u0430\u0435\u0442,
      \u043F\u043E\u0434\u043B\u0438\u0432\u0430\u0435\u0442 \u0447\u0430\u0439 \u2014
      \u0438 \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u0446\u0438\u0444\u0440\u044B
      \u0432 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0432 \u0432\u0430\u0448\u0443
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443. \u0427\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441 \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438
      \u043B\u0435\u0436\u0438\u0442 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442
      \u0441 \u0434\u043E\u043B\u0435\u0439 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430,
      \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u043D\u043E\u0439 \u043D\u0430
      \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C, \u0438 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u044C \u0435\u0449\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177541
    m_Localized: "\u0412\u0430\u0448\u0438 \u0434\u043E\u0432\u043E\u0434\u044B \u042E\u0441\u0443\u0444
      \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u0442 \u043E\u0434\u0438\u043D
      \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u043C \u2014 \u043E\u043D \u0442\u043E\u0440\u0433\u0443\u0435\u0442
      \u0445\u043B\u043E\u043F\u043A\u043E\u043C \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C
      \u043B\u0435\u0442, \u0438 \u0441\u043B\u044B\u0448\u0430\u043B \u0432\u0441\u0451.
      \u041E\u043D \u043D\u0435 \u0437\u043B\u0438\u0442\u0441\u044F, \u043D\u043E
      \u0432 \u0433\u043B\u0430\u0437\u0430\u0445 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C. \u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442
      \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0433\u0438\u043B\u044C\u0434\u0438\u0438,
      \u0431\u0435\u0437 \u0432\u0430\u0448\u0435\u0439 \u043D\u0430\u0434\u0431\u0430\u0432\u043A\u0438.
      \u041D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435 \u042E\u0441\u0443\u0444
      \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442: \xAB\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434
      \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0433\u043E\u0440\u043E\u0434.
      \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0442\u0435\u0441\u044C,
      \u043A\u043E\u0433\u0434\u0430 \u0443\u0437\u043D\u0430\u0435\u0442\u0435 \u0446\u0435\u043D\u0443
      \u0445\u043B\u043E\u043F\u043A\u0430 \u043D\u0435 \u0438\u0437 \u0447\u0443\u0436\u0438\u0445
      \u0441\u043B\u043E\u0432.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177542
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u0431\u0435\u0441\u0435\u0434\u0443 \u043D\u0430 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177543
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442 \u043D\u0430 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u2014 \u0440\u0435\u0447\u044C \u0431\u0435\u0433\u043B\u0430\u044F, \u0432\u0435\u0436\u043B\u0438\u0432\u0430\u044F,
      \u0441 \u0443\u043C\u0435\u0441\u0442\u043D\u044B\u043C\u0438 \u0446\u0438\u0442\u0430\u0442\u0430\u043C\u0438
      \u0438\u0437 \u0431\u0443\u0445\u0430\u0440\u0441\u043A\u0438\u0445 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u043E\u043A.
      \u042E\u0441\u0443\u0444 \u0440\u0430\u0441\u0446\u0432\u0435\u0442\u0430\u0435\u0442:
      \u0434\u0430\u0432\u043D\u043E \u0435\u043C\u0443 \u043D\u0435 \u0434\u043E\u0432\u043E\u0434\u0438\u043B\u043E\u0441\u044C
      \u0432\u0435\u0441\u0442\u0438 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B
      \u043D\u0430 \u0440\u043E\u0434\u043D\u043E\u043C \u044F\u0437\u044B\u043A\u0435
      \u0441 \u043F\u0440\u0438\u0448\u043B\u044B\u043C. \u0427\u0430\u0439 \u0438\u0437
      \u0437\u0435\u043B\u0451\u043D\u043E\u0433\u043E \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0431\u0435\u043B\u044B\u043C, \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u0434\u0430\u044E\u0442\u0441\u044F
      \u0441\u043B\u0430\u0434\u043E\u0441\u0442\u0438. \u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442
      \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044F \u0443\u0436\u0435
      \u043D\u0435 \u043A\u0430\u043A \u0441\u0434\u0435\u043B\u043A\u0430, \u0430
      \u043A\u0430\u043A \u043D\u0430\u0447\u0430\u043B\u043E \u0434\u043E\u043B\u0433\u043E\u0439
      \u0434\u0440\u0443\u0436\u0431\u044B. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0432\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C,
      \u0443\u0434\u0432\u043E\u0435\u043D\u043D\u043E\u0439 \u0434\u043E\u043B\u0435\u0439
      \u0438 \u0433\u043E\u0440\u0441\u0442\u044C\u044E \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0445
      \u0444\u0440\u0430\u0437, \u043E\u0441\u0435\u0432\u0448\u0438\u0445 \u0432
      \u043F\u0430\u043C\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177544
    m_Localized: "\u041A\u0430\u043C\u0435\u043D\u043D\u0430\u044F \u0441\u0442\u0435\u043B\u0430
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177545
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u0447\u0435\u0440\u0435\u0437 \u0432\u044B\u0441\u043E\u043A\u0438\u0439
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B \u0440\u0430\u0437\u0434\u0432\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0443 \u0432\u044B\u0432\u0435\u0442\u0440\u0435\u043D\u043D\u043E\u0439 \u0441\u0442\u0435\u043B\u044B,
      \u0438\u0441\u043F\u0435\u0449\u0440\u0451\u043D\u043D\u043E\u0439 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u043C\u0438
      \u043D\u0430\u0434\u043F\u0438\u0441\u044F\u043C\u0438. \u041E\u0434\u0438\u043D
      \u043F\u0443\u0442\u044C \u0443\u0432\u043E\u0434\u0438\u0442 \u0432\u043D\u0438\u0437,
      \u0432 \u0437\u0435\u043B\u0451\u043D\u044B\u0435 \u0434\u043E\u043B\u0438\u043D\u044B,
      \u0434\u0440\u0443\u0433\u043E\u0439 \u2014 \u0432\u044B\u0448\u0435, \u0432
      \u043E\u0431\u043B\u0430\u043A\u0430. \u0423 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F
      \u0441\u0442\u0435\u043B\u044B \u0441\u0438\u0434\u0438\u0442 \u0445\u0443\u0434\u043E\u0439
      \u0441\u0442\u0430\u0440\u0438\u043A-\u044F\u043A\u043E\u0432\u043E\u0434\u044B
      \u0432 \u043F\u043E\u0442\u0451\u0440\u0442\u043E\u0439 \u043E\u0432\u0447\u0438\u043D\u0435,
      \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u044F \u0447\u0451\u0442\u043A\u0438
      \u0438\u0437 \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
      \u043A\u043E\u0441\u0442\u0438. \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0448 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0438 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F, \u0431\u0443\u0434\u0442\u043E
      \u0434\u0430\u0432\u043D\u043E \u0436\u0434\u0430\u043B. \u041B\u043E\u0431\u0441\u0430\u043D\u0433
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u043E \u0433\u043E\u0440\u043D\u043E\u043C
      \u0445\u0440\u0430\u043C\u0435, \u043D\u043E \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B,
      \u043A\u0430\u043A \u0435\u0433\u043E \u043D\u0430\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177546
    m_Localized: "\u0418\u0434\u0442\u0438 \u043F\u043E \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u044E
      \u0441\u0432\u0438\u0442\u043A\u0430 \u041B\u043E\u0431\u0441\u0430\u043D\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177547
    m_Localized: "\u0412\u044B \u0434\u043E\u0441\u0442\u0430\u0451\u0442\u0435 \u0441\u0432\u0438\u0442\u043E\u043A
      \u0438 \u0441\u0432\u0435\u0440\u044F\u0435\u0442\u0435 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435
      \u0441 \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C\u044E. \u041F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0439
      \u0432\u043E\u0437\u0434\u0443\u0445 \u043E\u0431\u043C\u0430\u043D\u044B\u0432\u0430\u0435\u0442:
      \u0442\u043E, \u0447\u0442\u043E \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
      \u0431\u043B\u0438\u0437\u043A\u043E, \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E\u043B\u0443\u0434\u043D\u0435\u043C \u043F\u0443\u0442\u0438.
      \u041D\u043E \u043A \u0432\u0435\u0447\u0435\u0440\u0443 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E
      \u0434\u043D\u044F \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u0442\u043E\u043D\u043A\u0438\u0439
      \u0434\u044B\u043C\u043E\u043A \u043D\u0430\u0434 \u0441\u043A\u0430\u043B\u043E\u0439
      \u2014 \u0445\u0440\u0430\u043C. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0434\u043E\u0445\u043E\u0434\u0438\u0442 \u0441\u0430\u043C, \u0431\u0435\u0437
      \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u0432, \u0438
      \u044D\u0442\u043E \u0443\u043A\u0440\u0435\u043F\u043B\u044F\u0435\u0442 \u0434\u043E\u0432\u0435\u0440\u0438\u0435
      \u043B\u044E\u0434\u0435\u0439 \u043A \u0432\u0430\u0448\u0435\u043C\u0443
      \u0447\u0443\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177548
    m_Localized: "\u0412\u044B \u0441\u0431\u0438\u0432\u0430\u0435\u0442\u0435\u0441\u044C
      \u0441 \u0442\u0440\u043E\u043F\u044B \u043D\u0430 \u0442\u0440\u0435\u0442\u0438\u0439
      \u0434\u0435\u043D\u044C. \u0421\u0432\u0438\u0442\u043E\u043A \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
      \xAB\u0434\u0432\u0430 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0445 \u043F\u0430\u043B\u044C\u0446\u0430
      \u0443 \u0431\u0435\u043B\u043E\u0433\u043E \u0440\u0443\u0447\u044C\u044F\xBB
      \u2014 \u0442\u0430\u043A\u0438\u0445 \u043F\u0430\u043B\u044C\u0446\u0435\u0432
      \u0432 \u0422\u0438\u0431\u0435\u0442\u0435 \u0434\u0435\u0441\u044F\u0442\u043A\u0438.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043B\u0443\u0442\u0430\u0435\u0442,
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u0442\u0430\u044E\u0442, \u043A\u0442\u043E-\u0442\u043E
      \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u0437\u0430\u0431\u043E\u043B\u0435\u0432\u0430\u0435\u0442.
      \u0425\u0440\u0430\u043C \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u0433\u0434\u0430 \u0441\u0430\u043C\u0438
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u0435 \u043D\u0430 \u043F\u0430\u0441\u0442\u0443\u0445\u0430-\u044F\u043A\u043E\u0432\u043E\u0434\u044B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0438 \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442
      \u0432\u0430\u0441. \u0414\u043E\u0439\u0434\u0451\u0442\u0435 \u2014 \u043D\u043E
      \u0438\u0437\u043C\u043E\u0442\u0430\u043D\u043D\u044B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177549
    m_Localized: "\u0420\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C
      \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u043F\u0430\u0441\u0442\u0443\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177550
    m_Localized: "\u0412\u044B \u0441\u0430\u0434\u0438\u0442\u0435\u0441\u044C \u0440\u044F\u0434\u043E\u043C
      \u0441\u043E \u0441\u0442\u0430\u0440\u0438\u043A\u043E\u043C \u0438 \u0434\u043E\u043B\u0433\u043E
      \u043C\u043E\u043B\u0447\u0438\u0442\u0435 \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u043D\u0438\u043C \u2014 \u0442\u0430\u043A \u043F\u0440\u0438\u043D\u044F\u0442\u043E
      \u0432 \u0433\u043E\u0440\u0430\u0445. \u041F\u043E\u0442\u043E\u043C \u043E\u043D
      \u0441\u0430\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442: \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0440\u0443\u043A\u043E\u0439 \u043D\u0430 \u0432\u0435\u0440\u0445\u043D\u044E\u044E
      \u0442\u0440\u043E\u043F\u0443, \u0440\u0438\u0441\u0443\u0435\u0442 \u043F\u043E\u0441\u043E\u0445\u043E\u043C
      \u043D\u0430 \u0437\u0435\u043C\u043B\u0435 \u043A\u0440\u0443\u0433 \u0438
      \u0442\u0440\u0438 \u043E\u0442\u043C\u0435\u0442\u043A\u0438. \u0412\u0430\u0448\u0435\u043C\u0443
      \u0442\u043E\u043B\u043C\u0430\u0447\u0443 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      \u0436\u0435\u0441\u0442\u043E\u0432 \u0438 \u043E\u0431\u0440\u044B\u0432\u043A\u043E\u0432
      \u2014 \u0445\u0440\u0430\u043C \u0437\u0430 \u0432\u0442\u043E\u0440\u044B\u043C
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u043E\u043C, \u0443 \u0431\u0435\u043B\u043E\u0433\u043E
      \u0440\u0443\u0447\u044C\u044F. \u0421\u0442\u0430\u0440\u0438\u043A \u043E\u0442\u043B\u0430\u043C\u044B\u0432\u0430\u0435\u0442
      \u043A\u0443\u0441\u043E\u043A \u044F\u0447\u044C\u0435\u0433\u043E \u0441\u044B\u0440\u0430
      \u0438 \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442:
      \xAB\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177551
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0431\u0435\u0441\u0435\u0434\u0443\u0435\u0442
      \u043D\u0430 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177552
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043B\u0430\u0434\u043E\u043D\u0438
      \u0443 \u0433\u0440\u0443\u0434\u0438 \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u043A \u0441\u0442\u0430\u0440\u0438\u043A\u0443 \u043D\u0430 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u043C
      \u2014 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043B\u043E\u0432\u0430\u043C\u0438,
      \u0430 \u0441 \u0443\u043C\u0435\u0441\u0442\u043D\u044B\u043C\u0438 \u0444\u043E\u0440\u043C\u0443\u043B\u0430\u043C\u0438
      \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0438. \u0421\u0442\u0430\u0440\u0438\u043A
      \u0441\u0432\u0435\u0442\u043B\u0435\u0435\u0442 \u043B\u0438\u0446\u043E\u043C
      \u0438 \u0437\u0430\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442
      \u043E\u0445\u043E\u0442\u043D\u043E, \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u044F
      \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043E \u0442\u0440\u043E\u043F\u0435,
      \u043D\u043E \u0438 \u043E \u0434\u0443\u0445\u0430\u0445 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430,
      \u043E \u0442\u043E\u043C, \u043A\u0430\u043A\u0438\u0435 \u043C\u0430\u043D\u0442\u0440\u044B
      \u0447\u0438\u0442\u0430\u0442\u044C \u0443 \u0441\u043A\u0430\u043B\u044B
      \u043F\u0435\u0440\u0435\u0434 \u0445\u0440\u0430\u043C\u043E\u043C, \u043A\u0430\u043A\u043E\u0439
      \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u043D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044E
      \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B.
      \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u043E\u0439
      \u043A\u0430\u0440\u0442\u043E\u0439 \u0432 \u0433\u043E\u043B\u043E\u0432\u0435,
      \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435\u043C
      \u0438 \u043F\u0430\u0440\u043E\u0439 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0445
      \u0441\u043B\u043E\u0432, \u043E\u0441\u0435\u0432\u0448\u0438\u0445 \u0432
      \u043F\u0430\u043C\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177553
    m_Localized: "\u0414\u044B\u043C \u043D\u0430\u0434 \u0431\u0430\u0440\u0445\u0430\u043D\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177554
    m_Localized: "\u041F\u0435\u0441\u0447\u0430\u043D\u0430\u044F \u0431\u0443\u0440\u044F
      \u043E\u0442\u0448\u0443\u043C\u0435\u043B\u0430 \u043A \u0443\u0442\u0440\u0443.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
      \u043D\u0430 \u0433\u0440\u0435\u0431\u043D\u0435 \u0434\u044E\u043D\u044B,
      \u0438 \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0440\u0443\u043A\u043E\u0439 \u043D\u0430 \u0437\u0430\u043F\u0430\u0434:
      \u043D\u0430\u0434 \u0431\u0430\u0440\u0445\u0430\u043D\u0430\u043C\u0438 \u0432
      \u0442\u0440\u0451\u0445 \u0432\u0435\u0440\u0441\u0442\u0430\u0445 \u0441\u0442\u043E\u0438\u0442
      \u0442\u043E\u043D\u043A\u0438\u0439 \u0441\u0442\u043E\u043B\u0431\u0438\u043A
      \u0441\u0435\u0440\u043E\u0433\u043E \u0434\u044B\u043C\u0430. \u0412 \u043D\u0435\u0431\u0435
      \u043A\u0440\u0443\u0436\u0430\u0442 \u0433\u0440\u0438\u0444\u044B. \u0413\u0434\u0435-\u0442\u043E
      \u0442\u0430\u043C \u2014 \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0438\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D, \u0438\u043B\u0438 \u0442\u043E,
      \u0447\u0442\u043E \u043E\u0442 \u043D\u0435\u0433\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C.
      \u041F\u0435\u0441\u043E\u043A \u0435\u0449\u0451 \u043D\u0435 \u0443\u0441\u043F\u0435\u043B
      \u0437\u0430\u043D\u0435\u0441\u0442\u0438 \u0441\u043B\u0435\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177555
    m_Localized: "\u0418\u0434\u0442\u0438 \u043D\u0430 \u0434\u044B\u043C \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177556
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u044B\u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F
      \u043A \u0434\u044B\u043C\u0443 \u0441\u043A\u043E\u0440\u044B\u043C \u0448\u0430\u0433\u043E\u043C.
      \u0427\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u0447\u0430\u0441\u0430
      \u0432\u044B \u0443\u0436\u0435 \u0432\u0438\u0434\u0438\u0442\u0435 \u043E\u0441\u0442\u0430\u0442\u043A\u0438
      \u043B\u0430\u0433\u0435\u0440\u044F: \u0447\u0435\u0442\u044B\u0440\u0435
      \u0442\u0435\u043B\u0435\u0433\u0438, \u0431\u0443\u0440\u0434\u044E\u043A\u0438
      \u0441 \u0432\u043E\u0434\u043E\u0439, \u0432\u044B\u0436\u0438\u0432\u0448\u0438\u0445
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0436\u0433\u0443\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0445\u0432\u043E\u0440\u043E\u0441\u0442, \u0447\u0442\u043E\u0431\u044B
      \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438. \u041E\u0431\u044A\u044F\u0442\u0438\u044F,
      \u0441\u043B\u0451\u0437\u044B, \u0444\u043B\u044F\u0433\u0438 \u0432\u043E\u0434\u044B.
      \u0412\u044B \u0432\u044B\u0432\u043E\u0434\u0438\u0442\u0435 \u0432\u0441\u0435\u0445
      \u043A \u043A\u043E\u043B\u043E\u0434\u0446\u0443, \u0440\u0430\u0437\u0433\u0440\u043E\u043C\u043B\u0435\u043D\u043D\u044B\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0441\u043F\u0430\u0441\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177557
    m_Localized: "\xAB\u0414\u044B\u043C\xBB \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043C\u0438\u0440\u0430\u0436\u043E\u043C \u2014 \u0433\u043E\u0440\u044F\u0447\u0438\u0439
      \u0432\u043E\u0437\u0434\u0443\u0445 \u043D\u0430\u0434 \u0432\u044B\u0445\u043E\u0434\u043E\u043C
      \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A\u0430, \u0438\u0441\u043A\u0430\u0436\u0451\u043D\u043D\u044B\u0439
      \u0443\u0442\u0440\u0435\u043D\u043D\u0438\u043C \u0441\u0432\u0435\u0442\u043E\u043C.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0442\u0435\u0440\u044F\u0435\u0442
      \u043F\u043E\u043B\u0434\u043D\u044F, \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u0438 \u0432\u0435\u0440\u0443 \u0432 \u0432\u0430\u0448\u0435 \u0447\u0443\u0442\u044C\u0451.
      \u041A\u043E\u0433\u0434\u0430 \u0432\u044B \u043D\u0430\u043A\u043E\u043D\u0435\u0446
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435 \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0438\u0445
      \u043F\u043E \u0434\u0440\u0443\u0433\u0438\u043C \u0441\u043B\u0435\u0434\u0430\u043C,
      \u0443 \u043D\u0438\u0445 \u0443\u0436\u0435 \u0447\u0435\u0442\u0432\u0435\u0440\u043E
      \u0432 \u0433\u043E\u0440\u044F\u0447\u043A\u0435 \u0438 \u0434\u0432\u043E\u0435
      \u0443\u043C\u0435\u0440\u0448\u0438\u0445 \u043E\u0442 \u0436\u0430\u0436\u0434\u044B.
      \u0421\u043F\u0430\u0441\u043B\u0438 \u2014 \u043D\u043E \u0434\u043E\u0440\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177558
    m_Localized: "\u0421\u0434\u0435\u043B\u0430\u0442\u044C \u043A\u0440\u0443\u0433
      \u0448\u0438\u0440\u0435, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0447\u0435\u0441\u0442\u044C
      \u0441\u043B\u0435\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177559
    m_Localized: "\u0412\u044B \u043E\u0431\u0445\u043E\u0434\u0438\u0442\u0435 \u0434\u044B\u043C
      \u043F\u043E \u0448\u0438\u0440\u043E\u043A\u043E\u0439 \u0434\u0443\u0433\u0435,
      \u0447\u0438\u0442\u0430\u044F \u0441\u043B\u0435\u0434\u044B \u0432 \u043F\u0435\u0441\u043A\u0435:
      \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0435 \u043A\u043E\u043B\u0435\u0438
      \u043D\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0445 \u0442\u0435\u043B\u0435\u0433,
      \u043B\u0451\u0433\u043A\u0438\u0435 \u043E\u0442\u043F\u0435\u0447\u0430\u0442\u043A\u0438
      \u043B\u044E\u0434\u0435\u0439, \u0438\u0434\u0443\u0449\u0438\u0445 \u0440\u044F\u0434\u043E\u043C.
      \u041F\u043E \u0441\u043B\u0435\u0434\u0430\u043C \u044F\u0441\u043D\u043E,
      \u0447\u0442\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0448\u0451\u043B
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u043D\u043E \u043D\u0435
      \u0440\u0430\u0437\u0433\u0440\u0430\u0431\u043B\u0435\u043D. \u041A \u043F\u043E\u043B\u0443\u0434\u043D\u044E
      \u0432\u044B \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u0435 \u043D\u0430
      \u043B\u0430\u0433\u0435\u0440\u044C \u043D\u0435 \u0441 \u0444\u0440\u043E\u043D\u0442\u0430,
      \u0430 \u0441\u0431\u043E\u043A\u0443 \u2014 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u044B \u0438 \u043E\u0431\u0440\u0430\u0434\u043E\u0432\u0430\u043D\u044B.
      \u0414\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0430 \u043E\u043A\u0443\u043F\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177560
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0447\u0438\u0442\u0430\u0435\u0442
      \u0441\u043B\u0435\u0434\u044B \u0432 \u043F\u0435\u0441\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177561
    m_Localized: "\u0412\u0430\u0448 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0441\u043F\u0435\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0438 \u0438\u0434\u0451\u0442
      \u043F\u0435\u0448\u043A\u043E\u043C, \u0441\u043A\u043B\u043E\u043D\u0438\u0432\u0448\u0438\u0441\u044C
      \u043A \u043F\u0435\u0441\u043A\u0443. \u0427\u0435\u0440\u0435\u0437 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C
      \u0447\u0430\u0441\u0430 \u043E\u043D \u0443\u0436\u0435 \u0437\u043D\u0430\u0435\u0442
      \u0432\u0441\u0451: \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0438\u0437
      \u0448\u0435\u0441\u0442\u0438 \u0442\u0435\u043B\u0435\u0433, \u0442\u0440\u043E\u0438\u0445
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432, \u0434\u0432\u0443\u0445
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432, \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0432\u043E\u0434\u0443 \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439
      \u0434\u0435\u043D\u044C, \u0438\u0434\u0443\u0442 \u043D\u0430 \u0437\u0430\u043F\u0430\u0434
      \u0442\u0440\u0435\u0442\u044C\u0438 \u0441\u0443\u0442\u043A\u0438. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0432\u0435\u0434\u0451\u0442 \u0432\u0430\u0441 \u043A \u043D\u0438\u043C
      \u043A\u0440\u0430\u0442\u0447\u0430\u0439\u0448\u0438\u043C \u043F\u0443\u0442\u0451\u043C
      \u2014 \u0440\u043E\u0432\u043D\u043E \u043A \u0437\u0430\u043A\u0430\u0442\u0443,
      \u043A\u043E\u0433\u0434\u0430 \u0441\u0438\u043B\u044B \u0443\u0436\u0435
      \u043D\u0430 \u0438\u0441\u0445\u043E\u0434\u0435. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0441\u043F\u0430\u0441\u0451\u043D \u0432 \u043F\u043E\u043B\u043D\u043E\u043C
      \u0441\u043E\u0441\u0442\u0430\u0432\u0435, \u0430 \u0441\u0440\u0435\u0434\u0438
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
      \u043F\u043E\u0434\u0430\u0440\u043A\u043E\u0432 \u2014 \u043F\u0430\u043A\u0435\u0442
      \u0444\u0438\u043D\u0438\u043A\u043E\u0432 \u0438\u0437 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
      \u0433\u0440\u0443\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177562
    m_Localized: "\u0417\u0430\u0441\u0430\u0434\u0430 \u0443 \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177563
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442\u0435
      \u043A \u043F\u0435\u0440\u0435\u043A\u0440\u0451\u0441\u0442\u043A\u0443 \u0443
      \u0441\u043E\u043B\u044F\u043D\u043E\u0433\u043E \u043E\u0437\u0435\u0440\u0430,
      \u0438 \u0438\u0437-\u0437\u0430 \u043D\u0438\u0437\u043A\u0438\u0445 \u0445\u043E\u043B\u043C\u043E\u0432
      \u0441\u043B\u044B\u0448\u043D\u044B \u043A\u0440\u0438\u043A\u0438. \u0414\u044E\u0436\u0438\u043D\u0430
      \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u043E\u0432 \u0432 \u0447\u0451\u0440\u043D\u043E\u043C
      \u0432\u043E\u0439\u043B\u043E\u043A\u0435 \u043E\u043A\u0440\u0443\u0436\u0438\u043B\u0430
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u0438\u0439
      \u043E\u0431\u043E\u0437 \u2014 \u0442\u0440\u0438 \u0442\u0435\u043B\u0435\u0433\u0438,
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u0440\u0438\u0436\u0430\u043B\u0438\u0441\u044C
      \u043A \u0437\u0435\u043C\u043B\u0435, \u0433\u043B\u0430\u0432\u0430\u0440\u044C
      \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432 \u0443\u0436\u0435 \u0441\u043F\u0435\u0448\u0438\u043B\u0441\u044F
      \u0438 \u0440\u0435\u0436\u0435\u0442 \u0432\u0435\u0440\u0451\u0432\u043A\u0438
      \u043D\u0430 \u0442\u044E\u043A\u0430\u0445. \u0411\u0430\u043D\u0434\u0438\u0442\u044B
      \u0432\u0430\u0441 \u0435\u0449\u0451 \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438,
      \u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B \u0442\u043E\u043B\u044C\u043A\u043E-\u0442\u043E\u043B\u044C\u043A\u043E
      \u0443\u0432\u0438\u0434\u0435\u043B\u0438 \u0438 \u043A\u0440\u0438\u0447\u0430\u0442,
      \u043F\u0440\u043E\u0441\u044F \u043E \u043F\u043E\u043C\u043E\u0449\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177564
    m_Localized: "\u0410\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C \u0432 \u043B\u043E\u0431
      \u0441 \u043A\u0440\u0438\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177565
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0435
      \u0440\u0443\u043A\u0443 \u0438 \u0431\u0440\u043E\u0441\u0430\u0435\u0442\u0435
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0432 \u0430\u0442\u0430\u043A\u0443
      \u0441 \u043A\u0440\u0438\u043A\u043E\u043C. \u0411\u0430\u043D\u0434\u0438\u0442\u044B,
      \u043D\u0435 \u043E\u0436\u0438\u0434\u0430\u0432\u0448\u0438\u0435 \u0443\u0434\u0430\u0440\u0430,
      \u043D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435 \u0446\u0435\u043F\u0435\u043D\u0435\u044E\u0442.
      \u042D\u0442\u043E\u0433\u043E \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u044F
      \u0445\u0432\u0430\u0442\u0430\u0435\u0442: \u0442\u0440\u043E\u0435 \u043F\u0430\u0434\u0430\u044E\u0442
      \u0441\u0440\u0430\u0437\u0443, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0431\u0440\u043E\u0441\u0430\u044E\u0442 \u0434\u043E\u0431\u044B\u0447\u0443
      \u0438 \u0443\u0445\u043E\u0434\u044F\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u0445\u043E\u043B\u043C\u043E\u0432. \u0413\u043B\u0430\u0432\u0430\u0440\u044C
      \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0442 \u0448\u0432\u044B\u0440\u043D\u0443\u0442\u044C
      \u0432 \u0432\u0430\u0441 \u0441\u0430\u0431\u043B\u044E, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u0443\u0435\u0445\u0430\u0442\u044C \u2014 \u043E\u043D\u0430
      \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0432 \u043F\u0435\u0441\u043A\u0435
      \u043A\u0430\u043A \u0442\u0440\u043E\u0444\u0435\u0439. \u041A\u0443\u043F\u0446\u044B
      \u0441\u043F\u0430\u0441\u0435\u043D\u044B, \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u0440\u0430\u0441\u0447\u0438\u0449\u0435\u043D, \u0441\u0440\u0435\u0434\u0438
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u0435\u0439
      \u2014 \u043A\u043B\u0438\u043D\u043E\u043A \u0438 \u043A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u043E\u0435
      \u0441\u043F\u0430\u0441\u0438\u0431\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177566
    m_Localized: "\u0412\u0430\u0448\u0430 \u0430\u0442\u0430\u043A\u0430 \u043F\u0443\u0442\u0430\u0435\u0442
      \u0441\u0442\u0440\u043E\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430:
      \u043E\u0434\u043D\u0438 \u0440\u0432\u0430\u043D\u0443\u043B\u0438 \u0432\u043F\u0435\u0440\u0451\u0434,
      \u0434\u0440\u0443\u0433\u0438\u0435 \u0437\u0430\u0441\u0442\u0440\u044F\u043B\u0438
      \u043D\u0430 \u043F\u0435\u0441\u043A\u0435. \u0411\u0430\u043D\u0434\u0438\u0442\u044B
      \u043B\u043E\u0432\u044F\u0442 \u043C\u043E\u043C\u0435\u043D\u0442 \u0438
      \u043A\u043E\u043D\u0442\u0440\u0430\u0442\u0430\u043A\u0443\u044E\u0442. \u0421\u0442\u044B\u0447\u043A\u0430
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442 \u0432 \u0441\u0432\u0430\u043B\u043A\u0443,
      \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0431\u0430\u043D\u0434\u0438\u0442\u044B
      \u0443\u0441\u043F\u0435\u0432\u0430\u044E\u0442 \u0443\u043D\u0435\u0441\u0442\u0438
      \u0447\u0430\u0441\u0442\u044C \u0442\u044E\u043A\u043E\u0432 \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432. \u041A\u0443\u043F\u0446\u044B
      \u0441\u043F\u0430\u0441\u0435\u043D\u044B, \u043D\u043E \u043D\u0435 \u0432\u0441\u0435,
      \u0438 \u0433\u0440\u0443\u0437 \u043F\u043E\u0442\u0435\u0440\u044F\u043D.
      \u0411\u0430\u043D\u0434\u0438\u0442\u044B \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u044E\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u0433\u0434\u0430 \u0432\u044B
      \u043F\u043B\u0430\u0442\u0438\u0442\u0435 \u0438\u043C \u043E\u0442\u043A\u0443\u043F
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177567
    m_Localized: "\u041E\u043A\u0440\u0443\u0436\u0438\u0442\u044C \u0441 \u0444\u043B\u0430\u043D\u0433\u0430,
      \u043F\u0440\u0438\u0436\u0430\u0442\u044C \u043A \u0441\u043A\u0430\u043B\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177568
    m_Localized: "\u0412\u044B \u0434\u0435\u043B\u0430\u0435\u0442\u0435 \u043A\u0440\u044E\u043A
      \u0437\u0430 \u043D\u0438\u0437\u043A\u0438\u0435 \u0445\u043E\u043B\u043C\u044B
      \u0438 \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u0435 \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u043C
      \u0441 \u0442\u044B\u043B\u0430. \u041A\u043E\u0433\u0434\u0430 \u043E\u043D\u0438
      \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u2014 \u0430 \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u043E\u043D\u0438 \u043F\u043E\u0437\u0434\u043D\u043E, \u0443\u0432\u043B\u0451\u043A\u0448\u0438\u0441\u044C
      \u0433\u0440\u0430\u0431\u0435\u0436\u043E\u043C \u2014 \u0437\u0430 \u0438\u0445
      \u0441\u043F\u0438\u043D\u0430\u043C\u0438 \u0443\u0436\u0435 \u0441\u0442\u043E\u0438\u0442
      \u0432\u0430\u0448 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043B\u043E\u0442\u043D\u044B\u043C
      \u0441\u0442\u0440\u043E\u0435\u043C. \u0413\u043B\u0430\u0432\u0430\u0440\u044C
      \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u0442 \u0440\u0430\u0441\u043A\u043B\u0430\u0434
      \u0432 \u043E\u0434\u043D\u043E \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435:
      \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u0434\u043E\u0431\u044B\u0447\u0443,
      \u043C\u0430\u0448\u0435\u0442 \u0441\u0432\u043E\u0438\u043C, \u0438 \u0431\u0430\u043D\u0434\u0430
      \u0443\u0445\u043E\u0434\u0438\u0442 \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A
      \u0432 \u0442\u0435\u043C\u043F\u0435 \u0433\u0430\u043B\u043E\u043F\u0430.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0443\u0431\u0438\u0442, \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u0440\u0430\u0441\u0447\u0438\u0449\u0435\u043D, \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B
      \u0446\u0435\u043B\u0443\u044E\u0442 \u0432\u0430\u043C \u0440\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177569
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0420\u0443\u0441\u0442\u0430\u043C
      \u0432\u043E\u0437\u0433\u043B\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u0442\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177570
    m_Localized: "\u0412\u0430\u0448 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u0420\u0443\u0441\u0442\u0430\u043C \u0432\u044B\u0445\u043E\u0434\u0438\u0442
      \u0432\u043F\u0435\u0440\u0451\u0434 \u0438 \u0431\u0435\u0440\u0451\u0442
      \u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0432\u0430\u043D\u0438\u0435 \u043D\u0430
      \u0441\u0435\u0431\u044F \u2014 \u043E\u043D \u0431\u044B\u0432\u0448\u0438\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u0439\u0441\u043A\u0438\u0439
      \u0441\u0442\u0440\u0430\u0436 \u0438 \u0437\u043D\u0430\u0435\u0442 \u0442\u0430\u043A\u0438\u0445
      \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432. \u041E\u043D \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0432\u0430\u0448\u0438\u0445 \u043B\u044E\u0434\u0435\u0439 \u0447\u0451\u0442\u043A\u043E:
      \u0442\u0440\u043E\u0435 \u0432 \u043E\u0431\u0445\u043E\u0434, \u0434\u0432\u043E\u0435
      \u0441 \u0442\u044B\u043B\u0430, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0441 \u0444\u0440\u043E\u043D\u0442\u0430. \u0410\u0442\u0430\u043A\u0430
      \u0438\u0434\u0451\u0442 \u0441\u043B\u0430\u0436\u0435\u043D\u043D\u043E,
      \u0431\u0435\u0437 \u043A\u0440\u0438\u043A\u043E\u0432, \u043A\u0430\u043A
      \u0443 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E \u043E\u0442\u0440\u044F\u0434\u0430.
      \u0411\u0430\u043D\u0434\u0438\u0442\u044B \u0434\u0440\u043E\u0433\u043D\u0443\u043B\u0438,
      \u0431\u0440\u043E\u0441\u0438\u043B\u0438 \u043E\u0440\u0443\u0436\u0438\u0435,
      \u0433\u043B\u0430\u0432\u0430\u0440\u044C \u043C\u043E\u043B\u0438\u0442 \u043E
      \u043F\u043E\u0449\u0430\u0434\u0435. \u0420\u0443\u0441\u0442\u0430\u043C
      \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u0438\u0445 \u0431\u0435\u0437
      \u043E\u0440\u0443\u0436\u0438\u044F \u2014 \u043F\u0443\u0441\u0442\u044C
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u043D\u0430
      \u0442\u0440\u0430\u043A\u0442\u0435, \u0447\u0442\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u044B
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0432\u043E\u0437\u044C\u043C\u0443\u0442
      \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177571
    m_Localized: "\u0422\u0440\u0430\u0432\u043D\u0438\u043A \u0441 \u0433\u043E\u0440
      \u041A\u0443\u043D\u044C\u043B\u0443\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177572
    m_Localized: "\u0412 \u0433\u043E\u0440\u043D\u043E\u043C \u0441\u0435\u043B\u0435\u043D\u0438\u0438
      \u043A \u0441\u0435\u0432\u0435\u0440\u0443 \u043E\u0442 \u0410\u043D\u044C\u0441\u0438,
      \u0432 \u0441\u0430\u043C\u0430\u043D\u043D\u043E\u043C \u0434\u0432\u043E\u0440\u0435
      \u0441 \u0447\u0430\u043D\u0430\u043C\u0438 \u043F\u043E\u0434 \u043D\u0430\u0432\u0435\u0441\u043E\u043C,
      \u0432\u0430\u0441 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u0441\u0442\u0430\u0440\u044B\u0439
      \u0442\u0440\u0430\u0432\u043D\u0438\u043A \u0423 \u0426\u0437\u0438\u043D
      \u2014 \u043C\u043E\u0440\u0449\u0438\u043D\u0438\u0441\u0442\u043E\u0435 \u043B\u0438\u0446\u043E,
      \u0441\u0438\u043D\u0438\u0435 \u043E\u0442 \u043A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044F
      \u043F\u0430\u043B\u044C\u0446\u044B, \u0443\u0437\u043B\u043E\u0432\u0430\u0442\u044B\u0439
      \u043F\u043E\u0441\u043E\u0445 \u0440\u044F\u0434\u043E\u043C. \u041E\u043D
      \u0442\u043E\u0440\u0433\u0443\u0435\u0442 \u0438\u043D\u0434\u0438\u0433\u043E
      \u043E\u0441\u043E\u0431\u043E\u0439 \u0432\u044B\u0434\u0435\u043B\u043A\u0438,
      \u0432\u044B\u0440\u0430\u0449\u0435\u043D\u043D\u044B\u043C \u043D\u0430 \u0433\u043E\u0440\u043D\u044B\u0445
      \u0442\u0435\u0440\u0440\u0430\u0441\u0430\u0445: \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439,
      \u043D\u0430\u0441\u044B\u0449\u0435\u043D\u043D\u044B\u0439, \u0431\u0435\u0437
      \u0437\u0435\u043B\u0435\u043D\u043E\u0432\u0430\u0442\u043E-\u0441\u0435\u0440\u043E\u0433\u043E
      \u043E\u0442\u0442\u0435\u043D\u043A\u0430 \u0440\u0430\u0432\u043D\u0438\u043D\u043D\u043E\u0433\u043E.
      \u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043B
      \u0438\u043C\u0435\u043D\u043D\u043E \u0435\u0433\u043E \u2014 \u044D\u0442\u043E
      \u0438 \u0435\u0441\u0442\u044C \u0443\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0439
      \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177573
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0438\u043D\u0434\u0438\u0433\u043E
      \u043F\u043E \u0437\u0430\u043F\u0440\u043E\u0448\u0435\u043D\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177574
    m_Localized: "\u0412\u044B \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E \u0431\u0435\u0437 \u0441\u043B\u043E\u0432.
      \u0423 \u0426\u0437\u0438\u043D \u043A\u0438\u0432\u0430\u0435\u0442, \u043E\u0442\u043C\u0435\u0440\u044F\u0435\u0442
      \u0433\u043E\u0440\u0441\u0442\u044C \u043F\u0430\u0441\u0442\u044B \u0432
      \u0433\u043B\u0438\u043D\u044F\u043D\u0443\u044E \u043F\u043B\u043E\u0448\u043A\u0443,
      \u0443\u043F\u0430\u043A\u043E\u0432\u044B\u0432\u0430\u0435\u0442 \u0432 \u043F\u0440\u043E\u043C\u0430\u0441\u043B\u0435\u043D\u043D\u0443\u044E
      \u0442\u043A\u0430\u043D\u044C. \u0421\u0434\u0435\u043B\u043A\u0430 \u0434\u0435\u043B\u043E\u0432\u0430\u044F,
      \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445 \u0441\u043B\u043E\u0432.
      \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u043F\u0438\u0433\u043C\u0435\u043D\u0442\u043E\u043C,
      \u043A\u043E\u0448\u0435\u043B\u044C\u043A\u043E\u043C \u043B\u0435\u0433\u0447\u0435
      \u0438 \u0442\u0435\u043D\u044C\u044E \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u044F
      \u0443 \u0441\u0442\u0430\u0440\u0438\u043A\u0430 \u2014 \u043E\u043D \u043D\u0430\u0434\u0435\u044F\u043B\u0441\u044F
      \u043D\u0430 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u043E \u0440\u0435\u043C\u0435\u0441\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177575
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F,
      \u0441\u0441\u044B\u043B\u0430\u044F\u0441\u044C \u043D\u0430 \u043C\u0430\u0441\u0442\u0435\u0440\u0430
      \u0427\u044D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177576
    m_Localized: "\u0412\u044B \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442\u0435
      \u0438\u043C\u044F \u043C\u0430\u0441\u0442\u0435\u0440\u0430 \u0427\u044D\u043D\u044C
      \u0412\u044D\u044F \u2014 \u0438 \u0441\u0442\u0430\u0440\u0438\u043A \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
      \u0432 \u043B\u0438\u0446\u0435. \xAB\u0427\u044D\u043D\u044C? \u0422\u043E\u0442
      \u0441\u0430\u043C\u044B\u0439, \u0438\u0437 \u0427\u0430\u043D\u044A\u0430\u043D\u044F?
      \u041E\u043D \u0443 \u043C\u0435\u043D\u044F \u0443\u0447\u0438\u043B\u0441\u044F
      \u0432 \u043C\u043E\u043B\u043E\u0434\u043E\u0441\u0442\u0438.\xBB \u0426\u0435\u043D\u0430
      \u043F\u0430\u0434\u0430\u0435\u0442 \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u0441\u0430\u043C\u0430 \u0441\u043E\u0431\u043E\u0439, \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442 \u043D\u0430 \u0441\u043E\u0440\u0442\u0430,
      \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u044B, \u0441\u0435\u043A\u0440\u0435\u0442\u044B
      \u0432\u044B\u0434\u0435\u0440\u0436\u043A\u0438. \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435
      \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0441 \u043F\u0438\u0433\u043C\u0435\u043D\u0442\u043E\u043C,
      \u043D\u043E \u0438 \u0441 \u0433\u043E\u0440\u0441\u0442\u044C\u044E \u0441\u043E\u0432\u0435\u0442\u043E\u0432,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u0435\u0440\u0435\u0434\u0430\u0434\u0438\u0442\u0435
      \u0427\u044D\u043D\u044E, \u0438 \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C
      \u043A \u0441\u0442\u0430\u0440\u043E\u043C\u0443 \u043C\u0430\u0441\u0442\u0435\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177577
    m_Localized: "\u0421\u0442\u0430\u0440\u0438\u043A \u0441\u043B\u0443\u0448\u0430\u0435\u0442
      \u0432\u0430\u0448\u0435 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435
      \u0427\u044D\u043D\u044F, \u043D\u043E \u043D\u0435 \u0432\u0435\u0440\u0438\u0442.
      \xAB\u0427\u044D\u043D\u044C \u043D\u0435 \u043F\u043E\u0441\u044B\u043B\u0430\u0435\u0442
      \u0442\u043E\u0440\u0433\u0430\u0448\u0435\u0439, \u043E\u043D \u0441\u0430\u043C
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442, \u043A\u043E\u0433\u0434\u0430
      \u0435\u043C\u0443 \u043D\u0430\u0434\u043E.\xBB \u0426\u0435\u043D\u0430 \u043D\u0435
      \u043F\u0430\u0434\u0430\u0435\u0442, \u0438 \u0437\u0430 \u0432\u0430\u0448\u0443
      \u043D\u0430\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C
      \u043E\u043D \u0431\u0435\u0440\u0451\u0442 \u043D\u0430\u0434\u0431\u0430\u0432\u043A\u0443
      \u2014 \xAB\u0437\u0430 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u043E\xBB.
      \u041F\u0438\u0433\u043C\u0435\u043D\u0442 \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435,
      \u043D\u043E \u0434\u043E\u0440\u043E\u0436\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E,
      \u0438 \u0441\u0442\u0430\u0440\u0438\u043A \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0431\u0435\u0437 \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177578
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0435\u0442
      \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0443\u044E \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u043F\u0438\u0433\u043C\u0435\u043D\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177579
    m_Localized: "\u0412\u0430\u0448 \u043B\u0435\u043A\u0430\u0440\u044C \u0441\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0441\u044F
      \u043D\u0430\u0434 \u0447\u0430\u043D\u0430\u043C\u0438 \u0438 \u0437\u0430\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442
      \u0441 \u0423 \u0426\u0437\u0438\u043D\u043E\u043C \u043E \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430\u0445
      \u0438\u043D\u0434\u0438\u0433\u043E \u0432 \u043B\u0435\u0447\u0435\u043D\u0438\u0438
      \u0440\u0430\u043D \u0438 \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0438.
      \u0421\u0442\u0430\u0440\u0438\u043A \u043E\u0436\u0438\u0432\u043B\u044F\u0435\u0442\u0441\u044F:
      \u043A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u0438 \u2014 \u043D\u0435
      \u0442\u043E\u043B\u044C\u043A\u043E \u0434\u043B\u044F \u0442\u043A\u0430\u043D\u0435\u0439,
      \u0438 \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043D\u0438\u043A, \u043F\u043E\u043D\u0438\u043C\u0430\u044E\u0449\u0438\u0439
      \u044D\u0442\u043E, \u0432 \u0433\u043E\u0440\u0430\u0445 \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044C.
      \u0411\u0435\u0441\u0435\u0434\u0430 \u0438\u0434\u0451\u0442 \u0434\u043E\u043B\u0433\u043E,
      \u0447\u0430\u0439 \u0441\u043C\u0435\u043D\u044F\u0435\u0442 \u0447\u0430\u0439.
      \u041A \u043A\u043E\u043D\u0446\u0443 \u0432\u0435\u0447\u0435\u0440\u0430
      \u0441\u0442\u0430\u0440\u0438\u043A \u043E\u0442\u0434\u0430\u0451\u0442 \u043F\u0438\u0433\u043C\u0435\u043D\u0442
      \u043F\u043E\u0447\u0442\u0438 \u0434\u0430\u0440\u043E\u043C \u2014 \xAB\u0437\u0430
      \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u0431\u0435\u0441\u0435\u0434\u0443\xBB
      \u2014 \u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u0440\u0435\u0446\u0435\u043F\u0442
      \u043C\u0430\u0437\u0438 \u0438\u0437 \u043E\u0441\u0442\u0430\u0442\u043A\u043E\u0432
      \u043A\u0440\u0430\u0441\u043A\u0438. \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435
      \u0431\u043E\u0433\u0430\u0447\u0435, \u0447\u0435\u043C \u043F\u0440\u0438\u0448\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177580
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u0443
      \u043A\u0430\u043D\u0430\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177581
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C, \u043D\u043E\u0447\u044C.
      \u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u0432
      \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443
      \u043A\u0430\u043D\u0430\u043B\u0430 \u0426\u0437\u044B\u0443, \u043F\u043E\u0434
      \u0433\u043B\u0438\u043D\u043E\u0431\u0438\u0442\u043D\u043E\u0439 \u0441\u0442\u0435\u043D\u043E\u0439
      \u0441 \u0447\u0435\u0440\u0435\u043F\u0438\u0446\u0435\u0439. \u041D\u0430\u0434
      \u0434\u0432\u0435\u0440\u044C\u044E \u043F\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0444\u043E\u043D\u0430\u0440\u044C, \u0432 \u0441\u0432\u0435\u0442\u0435
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0432\u0438\u0434\u0435\u043D
      \u0442\u0430\u043D\u0441\u043A\u0438\u0439 \u0441\u0442\u043E\u0440\u043E\u0436
      \u0441 \u0444\u043E\u043D\u0430\u0440\u0451\u043C \u2014 \u043F\u043E\u0436\u0438\u043B\u043E\u0439,
      \u043D\u043E \u0442\u0440\u0435\u0437\u0432\u044B\u0439. \u0412\u043D\u0443\u0442\u0440\u0438,
      \u043F\u043E \u0441\u043B\u043E\u0432\u0430\u043C \u0427\u044D\u043D\u044F,
      \u043B\u0435\u0436\u0430\u0442 \u0437\u0430\u043F\u0438\u0441\u0438 \u043E
      \u043A\u0440\u0430\u0434\u0435\u043D\u044B\u0445 \u0440\u0435\u0446\u0435\u043F\u0442\u0430\u0445.
      \u041B\u0443\u043D\u0430 \u0437\u0430 \u043E\u0431\u043B\u0430\u043A\u043E\u043C,
      \u0437\u0432\u0443\u043A\u0438 \u0432\u043E\u0434\u044B \u043F\u043E \u043A\u0430\u043D\u0430\u043B\u0443
      \u0437\u0430\u0433\u043B\u0443\u0448\u0430\u044E\u0442 \u0448\u0430\u0433\u0438.
      \u041E\u043A\u043D\u043E \u0443 \u043A\u0440\u044B\u0448\u0438 \u043F\u0440\u0438\u043E\u0442\u043A\u0440\u044B\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177582
    m_Localized: "\u041F\u043E\u0434\u043A\u0443\u043F\u0438\u0442\u044C \u0441\u0442\u043E\u0440\u043E\u0436\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177583
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442\u0435
      \u0441\u043E \u0441\u0432\u044F\u0437\u043A\u043E\u0439 \u043C\u043E\u043D\u0435\u0442
      \u0432 \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u043E\u0439 \u043B\u0430\u0434\u043E\u043D\u0438.
      \u0421\u0442\u043E\u0440\u043E\u0436 \u0441\u043C\u043E\u0442\u0440\u0438\u0442,
      \u043D\u0435 \u043C\u043E\u0440\u0433\u0430\u044F, \u043F\u043E\u0442\u043E\u043C
      \u043A\u043B\u0430\u0434\u0451\u0442 \u0444\u043E\u043D\u0430\u0440\u044C \u043D\u0430
      \u0437\u0435\u043C\u043B\u044E \u0438 \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u043A\u0430\u043D\u0430\u043B\u0443. \u0412\u044B \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u0435
      \u0432\u043D\u0443\u0442\u0440\u044C, \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442\u0435
      \u043D\u0443\u0436\u043D\u044B\u0435 \u0431\u0443\u043C\u0430\u0433\u0438,
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u0435. \u0421\u0442\u043E\u0440\u043E\u0436
      \u043D\u0435 \u0448\u0435\u0432\u0435\u043B\u0438\u0442\u0441\u044F. \u0427\u0435\u0440\u0435\u0437
      \u043C\u0438\u043D\u0443\u0442\u0443 \u0432\u044B \u0443\u0436\u0435 \u043D\u0430
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
      \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0430. \u0421\u0434\u0435\u043B\u043A\u0430
      \u043F\u0440\u043E\u0441\u0442\u0430\u044F, \u043D\u043E \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u0435
      \u0441\u043B\u0443\u0445\u0438 \u043E \u0442\u0430\u043A\u0438\u0445 \u0441\u0434\u0435\u043B\u043A\u0430\u0445
      \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0431\u044B\u0441\u0442\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177584
    m_Localized: "\u0422\u0438\u0445\u043E \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0443\u0442\u044C
      \u0447\u0435\u0440\u0435\u0437 \u043A\u0440\u044B\u0448\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177585
    m_Localized: "\u0412\u044B \u0432\u0441\u043A\u0430\u0440\u0430\u0431\u043A\u0438\u0432\u0430\u0435\u0442\u0435\u0441\u044C
      \u043F\u043E \u0432\u044B\u0441\u0442\u0443\u043F\u0443 \u0441\u0442\u0435\u043D\u044B
      \u043A \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u043C\u0443 \u043E\u043A\u043E\u0448\u043A\u0443,
      \u0441\u043A\u043E\u043B\u044C\u0437\u0438\u0442\u0435 \u0432\u043D\u0443\u0442\u0440\u044C
      \u0438 \u0432 \u043F\u043E\u043B\u0443\u043C\u0440\u0430\u043A\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435
      \u043B\u0430\u0440\u0435\u0446 \u0441 \u0437\u0430\u043F\u0438\u0441\u044F\u043C\u0438.
      \u041B\u0443\u043D\u0430 \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0438\u0437-\u0437\u0430
      \u043E\u0431\u043B\u0430\u043A\u0430 \u2014 \u043D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435
      \u0432\u0430\u0448\u0443 \u0442\u0435\u043D\u044C \u0432\u0438\u0434\u043D\u043E
      \u043D\u0430 \u0441\u0442\u0435\u043D\u0435 \u0438\u0437\u043D\u0443\u0442\u0440\u0438,
      \u043D\u043E \u0441\u0442\u043E\u0440\u043E\u0436 \u0441\u043D\u0430\u0440\u0443\u0436\u0438
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043A\u0430\u043D\u0430\u043B.
      \u0412\u044B \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u0435 \u0442\u0435\u043C
      \u0436\u0435 \u043F\u0443\u0442\u0451\u043C \u0441 \u0431\u0443\u043C\u0430\u0433\u0430\u043C\u0438
      \u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u043E\u0439. \u041D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0443\u0437\u043D\u0430\u0435\u0442, \u043A\u0440\u043E\u043C\u0435
      \u0432\u0430\u0441 \u0438 \u0427\u044D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177586
    m_Localized: "\u0427\u0435\u0440\u0435\u043F\u0438\u0446\u0430 \u0441\u043A\u0440\u0438\u043F\u0438\u0442
      \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0439 \u0433\u0440\u043E\u043C\u0447\u0435,
      \u0447\u0435\u043C \u0432\u044B \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u043B\u0438.
      \u0421\u0442\u043E\u0440\u043E\u0436 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0444\u043E\u043D\u0430\u0440\u044C \u0438 \u043A\u0440\u0438\u0447\u0438\u0442.
      \u0418\u0437-\u0437\u0430 \u0443\u0433\u043B\u0430 \u0432\u044B\u0431\u0435\u0433\u0430\u044E\u0442
      \u0434\u0432\u043E\u0435 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u043E\u0432
      \u0438\u0437 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0433\u043E \u043F\u043E\u0441\u0442\u0430.
      \u0412\u044B \u043F\u0440\u044B\u0433\u0430\u0435\u0442\u0435 \u0432 \u043A\u0430\u043D\u0430\u043B
      \u0438 \u043F\u043B\u044B\u0432\u0451\u0442\u0435 \u043D\u0430 \u0434\u0440\u0443\u0433\u0443\u044E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u2014 \u0445\u043E\u043B\u043E\u0434,
      \u0442\u0435\u043C\u043D\u043E\u0442\u0430, \u0443\u0448\u0438\u0431\u044B
      \u043E \u043A\u0430\u043C\u043D\u0438. \u0423\u0439\u0442\u0438 \u0443\u0434\u0430\u0451\u0442\u0441\u044F,
      \u043D\u043E \u0431\u0435\u0437 \u0431\u0443\u043C\u0430\u0433, \u0438 \u0432
      \u0434\u043E\u0437\u043E\u0440\u043D\u043E\u0439 \u043A\u043D\u0438\u0433\u0435
      \u0427\u0430\u043D\u044A\u0430\u043D\u044F \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0432\u0430\u0448\u0435 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435.
      \u041D\u0430 \u043E\u0442\u043A\u0443\u043F \u043F\u0430\u0442\u0440\u0443\u043B\u044C\u043D\u043E\u043C\u0443
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0431\u0440\u043E\u0441\u0438\u0442\u044C
      \u0433\u043E\u0440\u0441\u0442\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177587
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u0435\u0442
      \u0441\u0442\u043E\u0440\u043E\u0436\u0430 \u0431\u0430\u0439\u043A\u043E\u0439
      \u043D\u0430 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177588
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043A \u0441\u0442\u043E\u0440\u043E\u0436\u0443
      \u0441 \u0443\u043B\u044B\u0431\u043A\u043E\u0439 \u0438 \u0437\u0430\u0432\u043E\u0434\u0438\u0442
      \u0434\u043B\u0438\u043D\u043D\u0443\u044E \u0431\u0430\u0439\u043A\u0443 \u043E
      \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u0445 \u0437\u0430 \u0443\u0433\u043B\u043E\u043C,
      \u043E\u0431 \u043E\u0433\u043D\u044F\u0445 \u043D\u0430\u0434 \u043F\u0430\u0433\u043E\u0434\u043E\u0439,
      \u043E \u0431\u0435\u0441\u0430\u0445, \u0447\u0442\u043E \u0431\u0440\u043E\u0434\u044F\u0442
      \u0432 \u044D\u0442\u0443 \u043D\u043E\u0447\u044C \u2014 \u043D\u0430 \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u043E\u043C
      \u043B\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043D\u043E\u043C \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C
      \u0441 \u0446\u0438\u0442\u0430\u0442\u043E\u0439 \u0438\u0437 \u041A\u043E\u043D\u0444\u0443\u0446\u0438\u044F.
      \u0421\u0442\u043E\u0440\u043E\u0436, \u0441\u043A\u0443\u0447\u0430\u0432\u0448\u0438\u0439
      \u0432\u0441\u044E \u043D\u043E\u0447\u044C, \u0437\u0430\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      \u041F\u043E\u043A\u0430 \u043E\u043D \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u043D\u043E
      \u0441\u043B\u0443\u0448\u0430\u0435\u0442, \u0432\u044B \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u0435
      \u0432\u043D\u0443\u0442\u0440\u044C, \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442\u0435
      \u0431\u0443\u043C\u0430\u0433\u0438, \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u0435.
      \u0421\u0442\u043E\u0440\u043E\u0436 \u0434\u0430\u0436\u0435 \u043D\u0435
      \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      \u041D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435 \u043E\u043D
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u0430
      \u0437\u0430 \xAB\u043F\u0440\u0438\u044F\u0442\u043D\u0443\u044E \u0431\u0435\u0441\u0435\u0434\u0443\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177589
    m_Localized: "\u0421\u0445\u043E\u0434\u043A\u0430 \u043C\u0430\u0441\u0442\u0435\u0440\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177590
    m_Localized: "\u0427\u0430\u0439\u043D\u0430\u044F \u0443 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442 \u0427\u0430\u043D\u044A\u0430\u043D\u044F,
      \u0443\u0442\u0440\u043E. \u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0441\u044F
      \u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0435: \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C
      \u0432 \u0443\u0433\u043B\u0443 \u0441\u0438\u0434\u044F\u0442 \u0441\u0435\u043C\u044C
      \u0432\u043E\u043B\u044C\u043D\u044B\u0445 \u043A\u0440\u0430\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u043E\u0432
      \u2014 \u043A\u0442\u043E \u043F\u043E\u043C\u043E\u043B\u043E\u0436\u0435,
      \u043A\u0442\u043E \u043F\u043E\u0441\u0442\u0430\u0440\u0448\u0435, \u0443
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043F\u0430\u043B\u044C\u0446\u044B
      \u043F\u0435\u0440\u0435\u043F\u0430\u0447\u043A\u0430\u043D\u044B \u0441\u0432\u043E\u0438\u043C
      \u043E\u0442\u0442\u0435\u043D\u043A\u043E\u043C. \u041E\u043D\u0438 \u043F\u0440\u0438\u0448\u043B\u0438
      \u043F\u043E \u0441\u043B\u0443\u0445\u0430\u043C \u043E \u043F\u0443\u0440\u043F\u0443\u0440\u0435,
      \u043D\u043E \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u0441 \u043F\u0440\u0438\u0449\u0443\u0440\u043E\u043C:
      \u0446\u0435\u043D\u0430 \u0438\u0445 \u0440\u0435\u043C\u0435\u0441\u043B\u0430
      \u0432\u044B\u0441\u043E\u043A\u0430, \u0438 \u043E\u043D\u0438 \u043D\u0435
      \u0438\u0434\u0443\u0442 \u0437\u0430 \u043F\u0435\u0440\u0432\u044B\u043C
      \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0432\u0448\u0438\u043C. \u041D\u0430
      \u0441\u0442\u043E\u043B\u0435 \u2014 \u0442\u0440\u0438 \u043F\u043B\u043E\u0448\u043A\u0438
      \u0441 \u0440\u0430\u0437\u043D\u044B\u043C\u0438 \u0441\u0438\u043D\u0438\u043C\u0438,
      \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177591
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u0432\u0441\u0435\u0445,
      \u043A\u0442\u043E \u043E\u0442\u043A\u043B\u0438\u043A\u043D\u0443\u043B\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177592
    m_Localized: "\u0412\u044B \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u043A\u043E\u0448\u0435\u043B\u044C \u0438 \u043E\u0431\u0435\u0449\u0430\u0435\u0442\u0435
      \u0437\u0430\u0434\u0430\u0442\u043E\u043A \u043A\u0430\u0436\u0434\u043E\u043C\u0443.
      \u0420\u0430\u0434\u043E\u0441\u0442\u0438 \u043C\u043D\u043E\u0433\u043E,
      \u0441\u043A\u0435\u043F\u0441\u0438\u0441 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442.
      \u041A \u043F\u043E\u043B\u0443\u0434\u043D\u044E \u0443 \u0432\u0430\u0441
      \u043D\u0430\u043D\u044F\u0442\u0430 \u043A\u043E\u043C\u0430\u043D\u0434\u0430
      \u0438\u0437 \u0441\u0435\u043C\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u0441\u0440\u0435\u0434\u0438 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u2014
      \u0434\u0432\u043E\u0435 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0445
      \u043C\u0430\u0441\u0442\u0435\u0440\u043E\u0432 \u0438 \u043F\u044F\u0442\u0435\u0440\u043E
      \u043F\u043E\u0434\u043C\u0430\u0441\u0442\u0435\u0440\u044C\u0435\u0432. \u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F
      \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442 \u0431\u044B\u0441\u0442\u0440\u043E,
      \u043D\u043E \u043D\u0435 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E:
      \u043F\u0443\u0440\u043F\u0443\u0440 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F,
      \u043D\u043E \u043D\u0435 \u043B\u0443\u0447\u0448\u0435\u0433\u043E \u0441\u043E\u0440\u0442\u0430.
      \u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u043F\u043E\u0442\u043E\u043C
      \u0431\u0443\u0434\u0435\u0442 \u0432\u043E\u0440\u0447\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177593
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0441 \u0433\u0438\u043B\u044C\u0434\u0438\u0435\u0439 \u043A\u0440\u0430\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177594
    m_Localized: "\u0412\u044B \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442\u0435
      \u0441\u0442\u0430\u0440\u0448\u0438\u043D\u0443 \u0433\u0438\u043B\u044C\u0434\u0438\u0438
      \u0438 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u0435 \u043A
      \u0442\u043E\u0440\u0433\u0443 \u0432\u0441\u0435\u0440\u044C\u0451\u0437:
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u043E \u0434\u043E\u043B\u0435,
      \u043E\u0431 \u044D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432\u0435 \u043D\u0430
      \u043F\u0443\u0440\u043F\u0443\u0440, \u043E \u0442\u043E\u043C, \u0447\u0442\u043E
      \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u0431\u0443\u0434\u0435\u0442
      \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441 \u043B\u0443\u0447\u0448\u0438\u043C\u0438. \u0421\u0442\u0430\u0440\u0448\u0438\u043D\u0430
      \u0441\u043A\u0435\u043F\u0442\u0438\u0447\u0435\u043D, \u043D\u043E \u0438\u0434\u0451\u0442
      \u043D\u0430 \u0443\u0441\u043B\u043E\u0432\u0438\u044F. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0443 \u0432\u0430\u0441 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442
      \u0441 \u0442\u0440\u0435\u043C\u044F \u0438\u0437\u0431\u0440\u0430\u043D\u043D\u044B\u043C\u0438
      \u043C\u0430\u0441\u0442\u0435\u0440\u0430\u043C\u0438 \u043F\u043E \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435 \u0438 \u043E\u0431\u0440\u0430\u0437\u0435\u0446
      \u0448\u0451\u043B\u043A\u0430 \u043E\u0442 \u0433\u0438\u043B\u044C\u0434\u0438\u0438
      \u2014 \u043A\u0430\u043A \u0437\u043D\u0430\u043A \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F.
      \u0427\u044D\u043D\u044C \u0431\u0443\u0434\u0435\u0442 \u0434\u043E\u0432\u043E\u043B\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177595
    m_Localized: "\u0421\u0442\u0430\u0440\u0448\u0438\u043D\u0430 \u0433\u0438\u043B\u044C\u0434\u0438\u0438
      \u0441\u043B\u0443\u0448\u0430\u0435\u0442 \u0432\u0430\u0448\u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F
      \u0438 \u043A\u0430\u0447\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \xAB\u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u0433\u0438\u043B\u044C\u0434\u0438\u044F \u043D\u0435 \u0442\u043E\u0440\u0433\u0443\u0435\u0442
      \u043F\u0443\u0440\u043F\u0443\u0440\u043E\u043C \u043F\u043E \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435.\xBB \u041F\u043E\u0441\u043B\u0435 \u0434\u0432\u0443\u0445
      \u0447\u0430\u0441\u043E\u0432 \u0441\u043F\u043E\u0440\u0430 \u0432\u044B
      \u043F\u043B\u0430\u0442\u0438\u0442\u0435 \u0432\u0434\u0432\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0437\u0430\u0434\u0443\u043C\u0430\u043D\u043D\u043E\u0433\u043E \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435
      \u0434\u0432\u0443\u0445 \u043C\u0430\u0441\u0442\u0435\u0440\u043E\u0432 \u0432\u043C\u0435\u0441\u0442\u043E
      \u0442\u0440\u0451\u0445. \u0413\u0438\u043B\u044C\u0434\u0438\u044F \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
      \u0432\u0430\u0441 \u043A\u0430\u043A \xAB\u0442\u043E\u0433\u043E, \u043A\u0442\u043E
      \u043F\u0440\u0438\u0448\u0451\u043B \u0441 \u043F\u0443\u0441\u0442\u044B\u043C\u0438
      \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u044F\u043C\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177596
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446-\u043F\u0430\u0440\u0442\u043D\u0451\u0440
      \u0437\u043E\u0432\u0451\u0442 \u043B\u0443\u0447\u0448\u0438\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177597
    m_Localized: "\u0412\u0430\u0448 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u0432\u0441\u0442\u0430\u0451\u0442, \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442
      \u0437\u0430\u043B \u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0437\u0430
      \u0434\u0440\u0443\u0433\u0438\u043C \u0432\u044B\u043A\u043B\u0438\u043A\u0430\u0435\u0442
      \u043F\u043E \u0438\u043C\u0435\u043D\u0430\u043C \u2014 \u043E\u043D \u0432\u0441\u0435\u0445
      \u0437\u043D\u0430\u0435\u0442. \u0414\u0432\u043E\u0435 \u043B\u0443\u0447\u0448\u0438\u0445
      \u043A\u0440\u0430\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u043E\u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u044F
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0442 \u0433\u043E\u043B\u043E\u0432\u044B
      \u0438 \u043A\u0438\u0432\u0430\u044E\u0442: \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435
      \u043A \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0443 \u0432\u044B\u0448\u0435
      \u0434\u0435\u043D\u0435\u0433. \u0421\u0434\u0435\u043B\u043A\u0430 \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445,
      \u043C\u0430\u0441\u0442\u0435\u0440\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
      \u0441\u0430\u043C\u0438, \u0438 \u0432 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0443\u044E
      \u043F\u043E\u043F\u0430\u0434\u0430\u044E\u0442 \u0438\u043C\u0435\u043D\u043D\u043E
      \u0442\u0435, \u043A\u0442\u043E \u043D\u0443\u0436\u0435\u043D. \u0427\u044D\u043D\u044C
      \u0412\u044D\u0439 \u043F\u043E\u0442\u043E\u043C \u0441\u043A\u0430\u0436\u0435\u0442:
      \xAB\u0421 \u0442\u0430\u043A\u0438\u043C \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u043E\u043C
      \u043C\u043E\u0436\u043D\u043E\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177598
    m_Localized: "\u0411\u0430\u0437\u0430\u0440\u043D\u044B\u0439 \u0448\u0430\u0440\u043B\u0430\u0442\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177599
    m_Localized: "\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0441\u043A\u0438\u0439
      \u0431\u0430\u0437\u0430\u0440, \u0440\u044F\u0434 \u0430\u043D\u0442\u0438\u043A\u0432\u0430\u0440\u043E\u0432.
      \u041D\u0430 \u043F\u043E\u0442\u0451\u0440\u0442\u043E\u043C \u043A\u043E\u0432\u0440\u0435,
      \u043C\u0435\u0436\u0434\u0443 \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u043C\u0438
      \u043A\u0443\u0432\u0448\u0438\u043D\u0430\u043C\u0438 \u0438 \u0440\u0436\u0430\u0432\u044B\u043C\u0438
      \u043A\u043B\u0438\u043D\u043A\u0430\u043C\u0438, \u0440\u0430\u0437\u043B\u043E\u0436\u0435\u043D\u044B
      \xAB\u0434\u0440\u0435\u0432\u043D\u0438\u0435 \u0438\u0434\u043E\u043B\u044B\xBB
      \u2014 \u043D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u044B\u0435 \u0444\u0438\u0433\u0443\u0440\u043A\u0438
      \u0441 \u043D\u0430\u0434\u043F\u0438\u0441\u044F\u043C\u0438 \u043D\u0430
      \u044F\u043A\u043E\u0431\u044B \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C.
      \u041A\u0443\u043F\u0435\u0446, \u0442\u043E\u043B\u0441\u0442\u044B\u0439
      \u0438 \u0433\u0440\u043E\u043C\u043A\u0438\u0439, \u043A\u0440\u0438\u0447\u0438\u0442
      \u043D\u0430 \u0432\u0441\u0435\u0445 \u044F\u0437\u044B\u043A\u0430\u0445
      \u0441\u0440\u0430\u0437\u0443, \u043E\u0431\u0435\u0449\u0430\u044F \xAB\u0434\u0440\u0435\u0432\u043D\u0435\u0435
      \u0437\u043E\u043B\u043E\u0442\u043E \u043F\u0440\u0435\u0434\u043A\u043E\u0432\xBB.
      \u0422\u043E\u043B\u043F\u0430 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F.
      \u0421\u0440\u0435\u0434\u0438 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0445
      \u0444\u0438\u0433\u0443\u0440\u043E\u043A \u0424\u0430\u0440\u0443\u0445 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043B
      \u2014 \u0435\u0441\u0442\u044C \u0438 \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177600
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0443
      \u043A\u0430\u043A \u0443\u043B\u0438\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177601
    m_Localized: "\u0412\u044B \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0435
      \u0441\u0430\u043C\u0443\u044E \u043A\u0440\u0438\u0447\u0430\u0449\u0435-\xAB\u0434\u0440\u0435\u0432\u043D\u044E\u044E\xBB
      \u0444\u0438\u0433\u0443\u0440\u043A\u0443 \u0438 \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0442\u0435
      \u0431\u0435\u0437 \u0442\u043E\u0440\u0433\u0430. \u041A\u0443\u043F\u0435\u0446
      \u0440\u0430\u0441\u0446\u0432\u0435\u0442\u0430\u0435\u0442, \u0442\u043E\u043B\u043F\u0430
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C.
      \u0412\u044B \u043A\u043B\u0430\u0434\u0451\u0442\u0435 \u0441\u0432\u0451\u0440\u0442\u043E\u043A
      \u0432 \u0441\u0443\u043C\u043A\u0443 \u0438 \u0442\u0438\u0445\u043E \u0443\u0445\u043E\u0434\u0438\u0442\u0435
      \u2014 \u0443\u043B\u0438\u043A\u0430 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0443 \u0432\u0430\u0441, \u0438 \u0437\u0430\u0432\u0442\u0440\u0430 \u0431\u0430\u0437\u0430\u0440\u043D\u044B\u0439
      \u0441\u043E\u0432\u0435\u0442 \u043F\u043E\u043B\u0443\u0447\u0438\u0442 \u043D\u0430
      \u0441\u0442\u043E\u043B \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442
      \u0441 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435\u043C \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0438.
      \u0428\u0430\u0440\u043B\u0430\u0442\u0430\u043D \u043D\u0435 \u0443\u0437\u043D\u0430\u0435\u0442,
      \u0447\u0442\u043E \u044D\u0442\u043E \u0432\u044B, \u043F\u043E\u043A\u0430
      \u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0442 \u043F\u043E\u0437\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177602
    m_Localized: "\u0413\u0440\u043E\u043C\u043A\u043E \u0438\u0437\u043E\u0431\u043B\u0438\u0447\u0438\u0442\u044C
      \u043C\u043E\u0448\u0435\u043D\u043D\u0438\u043A\u0430 \u043F\u0440\u0438 \u0442\u043E\u043B\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177603
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0435
      \u043E\u0434\u043D\u0443 \u0438\u0437 \u0444\u0438\u0433\u0443\u0440\u043E\u043A
      \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0438 \u0433\u0440\u043E\u043C\u043A\u043E
      \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435 \u043D\u0430 \u043E\u0448\u0438\u0431\u043A\u0443
      \u0432 \u043D\u0430\u0434\u043F\u0438\u0441\u0438: \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u0433\u043B\u0430\u0433\u043E\u043B \u0441\u0442\u043E\u0438\u0442 \u0432
      \u043D\u0435\u0432\u0435\u0440\u043D\u043E\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
      \u0430 \xAB\u0434\u0440\u0435\u0432\u043D\u044F\u044F\xBB \u043F\u0430\u0442\u0438\u043D\u0430
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0443\u043A\u0441\u0443\u0441\u043E\u043C.
      \u0422\u043E\u043B\u043F\u0430, \u0441\u0435\u043A\u0443\u043D\u0434\u0443
      \u043D\u0430\u0437\u0430\u0434 \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F,
      \u0440\u0430\u0437\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F \u0441\u043C\u0435\u0445\u043E\u043C.
      \u041A\u0443\u043F\u0435\u0446 \u0431\u0430\u0433\u0440\u043E\u0432\u0435\u0435\u0442,
      \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u043E\u043F\u0440\u0430\u0432\u0434\u0430\u0442\u044C\u0441\u044F,
      \u043D\u043E \u0442\u043E\u043B\u043A\u0430\u0435\u0442\u0441\u044F \u0431\u0430\u0437\u0430\u0440\u043D\u043E\u0439
      \u0441\u0442\u0440\u0430\u0436\u0435\u0439 \u0437\u0430 \u043F\u0440\u0438\u043B\u0430\u0432\u043E\u043A.
      \u0421\u0440\u0435\u0434\u0438 \u0440\u0430\u0437\u0431\u0440\u043E\u0441\u0430\u043D\u043D\u044B\u0445
      \xAB\u0434\u0440\u0435\u0432\u043D\u043E\u0441\u0442\u0435\u0439\xBB \u0432\u044B
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0435 \u043E\u0434\u043D\u0443
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E \u2014 \u043E\u043D\u0430
      \u0434\u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0448\u0430\u0440\u043B\u0430\u0442\u0430\u043D\u0443
      \u043F\u043E \u0441\u043B\u0443\u0447\u0430\u044E \u0438 \u0448\u043B\u0430
      \u043A\u0430\u043A \u043F\u0440\u0438\u043C\u0430\u043D\u043A\u0430. \u042D\u0442\u0430
      \u2014 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177604
    m_Localized: "\u0412\u044B \u043A\u0440\u0438\u0447\u0438\u0442\u0435 \u043F\u0440\u043E
      \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0443, \u043D\u043E \u043D\u0435
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435 \u0441\u043B\u043E\u0432,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0443\u0441\u043B\u044B\u0448\u0438\u0442
      \u0442\u043E\u043B\u043F\u0430. \u041A\u0443\u043F\u0435\u0446 \u0441\u043C\u0435\u0451\u0442\u0441\u044F
      \u043F\u0435\u0440\u0432\u044B\u0439, \u0442\u043E\u043B\u043F\u0430 \u043F\u043E\u0434\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442:
      \xAB\u0417\u0430\u0432\u0438\u0441\u0442\u043D\u0438\u043A! \u041A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442!\xBB
      \u0411\u0430\u0437\u0430\u0440\u043D\u0430\u044F \u0441\u0442\u0440\u0430\u0436\u0430
      \u0443\u0432\u043E\u0434\u0438\u0442 \u043F\u043E\u0434 \u0440\u0443\u043A\u0438
      \u0443\u0436\u0435 \u0432\u0430\u0441, \u043D\u0435 \u0435\u0433\u043E. \u041A
      \u0432\u0435\u0447\u0435\u0440\u0443 \u0432\u0430\u0441 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u044E\u0442
      \u0441 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435\u043C,
      \u043D\u043E \u0432\u0430\u0448\u0435 \u043B\u0438\u0446\u043E \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B \u0441\u043E \u0432\u0441\u0435\u0433\u043E
      \u0440\u044F\u0434\u0430. \u0428\u0430\u0440\u043B\u0430\u0442\u0430\u043D
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u0441\u043B\u0435\u0434 \u0438
      \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177605
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0447\u0438\u0442\u0430\u0435\u0442
      \u043D\u0430\u0434\u043F\u0438\u0441\u0438 \u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u0442
      \u043E\u0448\u0438\u0431\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177606
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u0431\u0435\u0440\u0451\u0442 \u0444\u0438\u0433\u0443\u0440\u043A\u0443 \u0432
      \u0440\u0443\u043A\u0438, \u0441\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0441\u044F,
      \u0447\u0438\u0442\u0430\u0435\u0442 \u0448\u0435\u043F\u043E\u0442\u043E\u043C
      \u2014 \u0438 \u043A\u0430\u0447\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \u041F\u043E\u0442\u043E\u043C \u0433\u0440\u043E\u043C\u043A\u043E, \u0447\u0451\u0442\u043A\u043E,
      \u043D\u0430 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C \u0441
      \u0443\u043C\u0435\u0441\u0442\u043D\u044B\u043C \u0430\u043A\u0446\u0435\u043D\u0442\u043E\u043C,
      \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442 \u0442\u043E\u043B\u043F\u0435:
      \u043D\u0430\u0434\u043F\u0438\u0441\u044C \u2014 \u0448\u043A\u043E\u043B\u044C\u043D\u0430\u044F
      \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0430, \u0441\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u043D\u0430
      \u0441 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0439 \u0441\u0442\u0435\u043B\u044B,
      \u043D\u043E \u0441 \u0433\u0440\u0430\u043C\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u043E\u0448\u0438\u0431\u043A\u043E\u0439 \u043F\u044F\u0442\u043E\u0433\u043E
      \u043A\u043B\u0430\u0441\u0441\u0430. \u041A\u0443\u043F\u0435\u0446 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0440\u0430\u0437\u043E\u0431\u043B\u0430\u0447\u0451\u043D
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C, \u0433\u043E\u0432\u043E\u0440\u044F\u0449\u0438\u043C
      \u043B\u0443\u0447\u0448\u0435 \u043D\u0435\u0433\u043E \u0441\u0430\u043C\u043E\u0433\u043E,
      \u0438 \u043A\u0440\u0430\u0441\u043D\u0435\u0435\u0442 \u043E\u0442 \u0441\u0442\u044B\u0434\u0430.
      \u0422\u043E\u043B\u043F\u0430 \u0441\u043C\u0435\u0451\u0442\u0441\u044F,
      \u0441\u0442\u0440\u0430\u0436\u0430 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u043A \u0448\u0430\u0440\u043B\u0430\u0442\u0430\u043D\u0443, \u0430 \u0432\u0430\u0448
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E
      \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0432 \u0441\u0443\u043C\u043A\u0443
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E \u0444\u0438\u0433\u0443\u0440\u043A\u0443
      \u0441 \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0430 \u2014 \u0442\u0430,
      \u0447\u0442\u043E \u0431\u0435\u0437 \u043E\u0448\u0438\u0431\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177607
    m_Localized: "\u0420\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0430 \u0432 \u041F\u0430\u043C\u0438\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177608
    m_Localized: "\u0412\u0430\u0448 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
      \u0443 \u0443\u0437\u043A\u043E\u0433\u043E \u0443\u0449\u0435\u043B\u044C\u044F
      \u0432 \u041F\u0430\u043C\u0438\u0440\u0441\u043A\u0438\u0445 \u0433\u043E\u0440\u0430\u0445.
      \u041F\u043E \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u0430\u043C
      \u0441 \u043A\u0430\u0440\u0442\u044B \u0424\u0430\u0440\u0443\u0445\u0430,
      \u0433\u0434\u0435-\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u2014 \u0437\u0430\u0432\u0430\u043B\u0435\u043D\u043D\u044B\u0439
      \u043A\u0430\u043C\u043D\u044F\u043C\u0438 \u0432\u0445\u043E\u0434 \u0432
      \u043F\u0435\u0449\u0435\u0440\u0443-\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435.
      \u0421\u0442\u0435\u043D\u044B \u0443\u0449\u0435\u043B\u044C\u044F \u043A\u0440\u0430\u0441\u043D\u044B\u0435
      \u043E\u0442 \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0439 \u043F\u043E\u0440\u043E\u0434\u044B,
      \u0432\u0435\u0442\u0435\u0440 \u043F\u0430\u0445\u043D\u0435\u0442 \u0441\u043D\u0435\u0433\u043E\u043C.
      \u041D\u043E \u0437\u0430\u0432\u0430\u043B \u0441\u0432\u0435\u0436\u0438\u0439,
      \u0438 \u0432 \u043D\u0451\u043C \u043D\u0435 \u043E\u0434\u043D\u043E \u2014
      \u0442\u0440\u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0445 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F.
      \u041A\u0430\u0440\u0442\u0430 \u043C\u043E\u043B\u0447\u0438\u0442 \u043E
      \u0434\u0435\u0442\u0430\u043B\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177609
    m_Localized: "\u0420\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0437\u0430\u0432\u0430\u043B
      \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177610
    m_Localized: "\u0412\u044B \u0437\u0430\u0441\u0443\u0447\u0438\u0432\u0430\u0435\u0442\u0435
      \u0440\u0443\u043A\u0430\u0432\u0430 \u0438 \u0432\u0435\u0434\u0451\u0442\u0435
      \u043B\u044E\u0434\u0435\u0439 \u043D\u0430 \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u043A\u0443
      \u0441\u0430\u043C\u043E\u0433\u043E \u043A\u0440\u0443\u043F\u043D\u043E\u0433\u043E
      \u0438\u0437 \u0437\u0430\u0432\u0430\u043B\u043E\u0432. \u041F\u043E\u043B\u0442\u043E\u0440\u0430
      \u0434\u043D\u044F \u0442\u044F\u0436\u0451\u043B\u043E\u0439 \u0440\u0430\u0431\u043E\u0442\u044B,
      \u043E\u0431\u043E\u0434\u0440\u0430\u043D\u043D\u044B\u0435 \u0440\u0443\u043A\u0438,
      \u0442\u0440\u0435\u0441\u043D\u0443\u0432\u0448\u0438\u0439 \u0431\u043E\u0440\u0442
      \u0443 \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u043F\u043E\u0432\u043E\u0437\u043E\u043A.
      \u041D\u043E \u0437\u0430\u0432\u0430\u043B \u043F\u043E\u0434\u0434\u0430\u0451\u0442\u0441\u044F,
      \u0438 \u0437\u0430 \u043D\u0438\u043C \u2014 \u0443\u0437\u043A\u0438\u0439
      \u043B\u0430\u0437 \u0432 \u043A\u0430\u043C\u0435\u043D\u043D\u0443\u044E
      \u043D\u0438\u0448\u0443. \u0425\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435.
      \u0412\u043D\u0443\u0442\u0440\u0438 \u043F\u044B\u043B\u044C \u0432\u0435\u043A\u043E\u0432
      \u0438 \u0442\u0438\u0448\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177611
    m_Localized: "\u0418\u0434\u0442\u0438 \u0441\u0442\u0440\u043E\u0433\u043E \u043F\u043E
      \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u0430\u043C \u043A\u0430\u0440\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177612
    m_Localized: "\u0412\u044B \u0434\u043E\u0441\u0442\u0430\u0451\u0442\u0435 \u043A\u0430\u0440\u0442\u0443,
      \u0432\u044B\u0432\u0435\u0440\u044F\u0435\u0442\u0435 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B
      \u043F\u043E \u0441\u043E\u043B\u043D\u0446\u0443 \u0438 \u0442\u0435\u043D\u0438
      \u0441\u043A\u0430\u043B, \u0437\u0430\u043C\u0435\u0440\u044F\u0435\u0442\u0435
      \u0448\u0430\u0433\u0438. \u0420\u0430\u0441\u0447\u0451\u0442 \u0442\u043E\u0447\u0435\u043D:
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0432\u0445\u043E\u0434
      \u2014 \u043D\u0435 \u0442\u0430\u043C, \u0433\u0434\u0435 \u044F\u0432\u043D\u044B\u0439
      \u0437\u0430\u0432\u0430\u043B, \u0430 \u0432 \u0431\u043E\u043A\u043E\u0432\u043E\u0439
      \u043D\u0438\u0448\u0435, \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u043E\u0439
      \u043F\u043B\u043E\u0441\u043A\u0438\u043C \u043A\u0430\u043C\u043D\u0435\u043C.
      \u041A\u0430\u043C\u0435\u043D\u044C \u0441\u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F
      \u0434\u0432\u0443\u043C\u044F \u043B\u044E\u0434\u044C\u043C\u0438, \u0438
      \u0432\u044B \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435\u0441\u044C
      \u0432 \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435, \u043C\u0438\u043D\u0443\u044F
      \u0437\u0430\u0432\u0430\u043B\u044B. \u0421\u0440\u0435\u0434\u0438 \u043F\u044B\u043B\u0438
      \u2014 \u043D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u0430\u044F \u0444\u0438\u0433\u0443\u0440\u043A\u0430.
      \u041A\u0430\u0440\u0442\u0430 \u043D\u0435 \u0441\u043E\u043B\u0433\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177613
    m_Localized: "\u0412\u044B \u0441\u0432\u0435\u0440\u044F\u0435\u0442\u0435 \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B,
      \u043D\u043E \u0432 \u0433\u043E\u0440\u0430\u0445 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B
      \u043E\u0431\u043C\u0430\u043D\u0447\u0438\u0432\u044B. \u041A\u0430\u0440\u0442\u0430
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \xAB\u0443 \u043A\u0440\u0430\u0441\u043D\u043E\u0439
      \u0441\u043A\u0430\u043B\u044B \u043F\u0440\u0438 \u0442\u0435\u043D\u044F\u0445\xBB
      \u2014 \u0430 \u0441\u043A\u0430\u043B \u0442\u0443\u0442 \u0442\u0440\u0438,
      \u0438 \u0442\u0435\u043D\u0438 \u043A\u0430\u0436\u0434\u044B\u0439 \u0447\u0430\u0441
      \u0434\u0440\u0443\u0433\u0438\u0435. \u0412\u044B \u0442\u0440\u0430\u0442\u0438\u0442\u0435
      \u0434\u0432\u0430 \u0434\u043D\u044F \u043D\u0430 \u043F\u0440\u043E\u043C\u0435\u0440\u044B,
      \u043F\u043E\u0442\u043E\u043C \u0441\u0434\u0430\u0451\u0442\u0435\u0441\u044C
      \u0438 \u0438\u0434\u0451\u0442\u0435 \u0447\u0435\u0440\u0435\u0437 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
      \u0437\u0430\u0432\u0430\u043B. \u0425\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u2014 \u043D\u043E
      \u043F\u043E\u0437\u0434\u043D\u043E, \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u0442\u0430\u044E\u0442, \u0443 \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u043E\u0431\u043C\u043E\u0440\u043E\u0436\u0435\u043D\u044B
      \u043F\u0430\u043B\u044C\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177614
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
      \u0441\u0442\u0430\u0440\u0443\u044E \u0442\u0440\u043E\u043F\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177615
    m_Localized: "\u0412\u0430\u0448 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0434\u043E\u043B\u0433\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u043A\u0440\u0430\u0441\u043D\u044B\u0435 \u0441\u043A\u0430\u043B\u044B,
      \u043D\u0430 \u0437\u0430\u0432\u0430\u043B, \u043D\u0430 \u0432\u0435\u0442\u0435\u0440,
      \u043F\u043E\u0442\u043E\u043C \u043C\u0430\u0448\u0435\u0442 \u0440\u0443\u043A\u043E\u0439:
      \xAB\u041D\u0435 \u0437\u0434\u0435\u0441\u044C. \u0417\u0434\u0435\u0441\u044C
      \u0432\u0441\u0435 \u0445\u043E\u0434\u044F\u0442. \u0421\u0442\u0430\u0440\u0438\u043A\u0438
      \u0445\u043E\u0434\u0438\u043B\u0438 \u0432\u044B\u0448\u0435.\xBB \u041E\u043D
      \u0432\u0435\u0434\u0451\u0442 \u0432\u0430\u0441 \u043A \u0443\u0437\u043A\u043E\u0439
      \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0435 \u043C\u0435\u0442\u0440\u043E\u0432
      \u043D\u0430 \u0441\u043E\u0440\u043E\u043A \u0432\u044B\u0448\u0435, \u0437\u0430\u0440\u043E\u0441\u0448\u0435\u0439
      \u043A\u043E\u043B\u044E\u0447\u043A\u043E\u0439. \u0417\u0430 \u043A\u043E\u043B\u044E\u0447\u043A\u043E\u0439
      \u2014 \u0442\u043E\u0442 \u0436\u0435 \u043B\u0430\u0437 \u0432 \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435,
      \u043D\u043E \u0431\u0435\u0437 \u0432\u0441\u044F\u043A\u043E\u0433\u043E
      \u0437\u0430\u0432\u0430\u043B\u0430, \u0441\u043B\u043E\u0432\u043D\u043E
      \u0438 \u043D\u0435 \u0431\u044B\u043B\u043E \u0432\u0435\u043A\u043E\u0432.
      \u0422\u0440\u043E\u043F\u0430 \u0437\u043D\u0430\u043B\u0430 \u0434\u043E\u0440\u043E\u0433\u0443.
      \u0412 \u043D\u0438\u0448\u0435 \u0441\u0440\u0435\u0434\u0438 \u043F\u044B\u043B\u0438
      \u2014 \u043D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u0430\u044F \u0444\u0438\u0433\u0443\u0440\u043A\u0430
      \u0441 \u0438\u0441\u0442\u0451\u0440\u0442\u044B\u043C \u043B\u0438\u0446\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603757355008
    m_Localized: "\u0417\u043D\u0430\u043A\u0438 \u043F\u0443\u0442\u0430\u044E\u0442\u0441\u044F
      \u043F\u0435\u0440\u0435\u0434 \u0433\u043B\u0430\u0437\u0430\u043C\u0438 \u2014
      \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0438
      \u0442\u044F\u0436\u0435\u043B\u0435\u0435 \u043B\u044E\u0431\u043E\u0439 \u0437\u0430\u0433\u0430\u0434\u043A\u0438.
      \u0412\u044B \u0441\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0435
      \u043A\u0430\u0440\u0442\u0443, \u0434\u0430\u0432 \u0441\u0435\u0431\u0435
      \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u0435 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u043A \u043D\u0435\u0439 \u0441 \u044F\u0441\u043D\u043E\u0439 \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \u0420\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u0442\u044C \u0443\u0434\u0430\u0451\u0442\u0441\u044F
      \u043D\u0435 \u0441\u0440\u0430\u0437\u0443: \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0434\u0435\u043D\u044C \u0432 \u0434\u043E\u0440\u043E\u0433\u0435, \u043E\u0442\u0434\u044B\u0445\u0430\u044F,
      \u0432\u044B \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0432 \u0433\u043E\u043B\u043E\u0432\u0435
      \u2014 \u043D\u043E \u0434\u0435\u043D\u044C \u043F\u043E\u0442\u0435\u0440\u044F\u043D,
      \u0438 \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u0438 \u0432\u043E\u0440\u0447\u0430\u0442
      \u043D\u0430 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686656
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
      \u0441 \u043D\u0430\u0434\u043F\u0438\u0441\u044F\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686657
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u0441\u0430\u0434\u0438\u0442\u0441\u044F \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432,
      \u0440\u0430\u0437\u0433\u043B\u0430\u0436\u0438\u0432\u0430\u0435\u0442 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442
      \u0438 \u0447\u0438\u0442\u0430\u0435\u0442 \u0441\u0442\u0430\u0440\u043E-\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u0435
      \u043F\u0438\u0441\u044C\u043C\u043E \u0432\u0441\u043B\u0443\u0445 \u2014
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044F
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0437\u043D\u0430\u043A \u043D\u0430
      \u0441\u0432\u0435\u0442. \u041A \u043A\u043E\u043D\u0446\u0443 \u043F\u0435\u0440\u0432\u043E\u0433\u043E
      \u0447\u0430\u0441\u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u0430\u0435\u0442
      \u044F\u0441\u043D\u0435\u0435, \u0447\u0435\u043C \u043C\u043E\u0433 \u0431\u044B
      \u0443 \u0432\u0430\u0441 \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443.
      \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0434\u0430\u0436\u0435
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442 \u043C\u0435\u043B\u043A\u0443\u044E
      \u043F\u043E\u043C\u0435\u0442\u043A\u0443 \u043D\u0430 \u043F\u043E\u043B\u044F\u0445
      \u2014 \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043D\u0438\u0435
      \u043E \u043A\u0430\u043C\u043D\u0435\u043F\u0430\u0434\u0430\u0445 \u0432
      \u043E\u0434\u043D\u043E\u043C \u0438\u0437 \u0443\u0449\u0435\u043B\u0438\u0439,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u044B \u0431\u044B \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438.
      \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0445
      \u0441\u043B\u043E\u0432 \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u0443
      \u0432\u0430\u0441 \u0432 \u043F\u0430\u043C\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686658
    m_Localized: "\u041F\u0435\u0441\u0447\u0430\u043D\u044B\u0439 \u0445\u0440\u0430\u043C
      \u0443 \u0425\u043E\u0442\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686659
    m_Localized: "\u041D\u0430 \u044E\u0436\u043D\u043E\u0439 \u043E\u043A\u0440\u0430\u0438\u043D\u0435
      \u0425\u043E\u0442\u0430\u043D\u0441\u043A\u043E\u0433\u043E \u043E\u0430\u0437\u0438\u0441\u0430,
      \u0441\u0440\u0435\u0434\u0438 \u043F\u0435\u0441\u0447\u0430\u043D\u0438\u043A\u043E\u0432\u044B\u0445
      \u0445\u043E\u043B\u043C\u043E\u0432, \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u043E\u0441\u0442\u043E\u0432 \u0437\u0430\u0431\u044B\u0442\u043E\u0439 \u0431\u0443\u0434\u0434\u0438\u0441\u0442\u0441\u043A\u043E\u0439
      \u0441\u0442\u0443\u043F\u044B. \u041A\u0438\u0440\u043F\u0438\u0447\u043D\u0430\u044F
      \u043A\u043B\u0430\u0434\u043A\u0430 \u043A\u0440\u043E\u0448\u0438\u0442\u0441\u044F
      \u043E\u0442 \u0432\u0435\u0442\u0440\u0430, \u0432 \u043D\u0438\u0448\u0430\u0445
      \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C \u0441\u043B\u0435\u0434\u044B
      \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u0432\u043E\u0439 \u0448\u0442\u0443\u043A\u0430\u0442\u0443\u0440\u043A\u0438.
      \u041F\u043E \u043A\u0430\u0440\u0442\u0435 \u0424\u0430\u0440\u0443\u0445\u0430
      \u2014 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F \u0437\u0434\u0435\u0441\u044C,
      \u0432 \u0441\u043A\u0440\u044B\u0442\u043E\u0439 \u043D\u0438\u0448\u0435
      \u043F\u043E\u0434 \u0430\u043B\u0442\u0430\u0440\u043D\u044B\u043C \u043A\u0430\u043C\u043D\u0435\u043C.
      \u041C\u0435\u0441\u0442\u043D\u044B\u0439 \u043F\u0430\u0441\u0442\u0443\u0445
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0438\u0437\u0434\u0430\u043B\u0438,
      \u043D\u0435 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u044F\u0441\u044C:
      \u043C\u0435\u0441\u0442\u043E \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u044B\u043C, \u043D\u043E \u043D\u0438\u043A\u0435\u043C
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u043E\u0441\u0435\u0449\u0430\u0435\u0442\u0441\u044F.
      \u041F\u0435\u0441\u043E\u043A \u043C\u044F\u0433\u043A\u043E \u0448\u0443\u0440\u0448\u0438\u0442
      \u0443 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F \u0445\u0440\u0430\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686660
    m_Localized: "\u0420\u0430\u0441\u043A\u043E\u043F\u0430\u0442\u044C \u0430\u043B\u0442\u0430\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686661
    m_Localized: "\u0412\u044B \u0437\u0430\u0441\u0443\u0447\u0438\u0432\u0430\u0435\u0442\u0435
      \u0440\u0443\u043A\u0430\u0432\u0430 \u0438 \u0440\u0430\u0441\u0447\u0438\u0449\u0430\u0435\u0442\u0435
      \u043F\u0435\u0441\u043E\u043A \u0440\u0443\u043A\u0430\u043C\u0438. \u041F\u043E\u0434
      \u043F\u043B\u0438\u0442\u043E\u0439 \u0430\u043B\u0442\u0430\u0440\u044F \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0443\u0437\u043A\u0430\u044F \u043D\u0438\u0448\u0430, \u0432\u044B\u043B\u043E\u0436\u0435\u043D\u043D\u0430\u044F
      \u0433\u043B\u0430\u0437\u0443\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
      \u043F\u043B\u0438\u0442\u043A\u043E\u0439. \u0412\u043D\u0443\u0442\u0440\u0438
      \u2014 \u043D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u0430\u044F \u0444\u0438\u0433\u0443\u0440\u043A\u0430
      \u0411\u0443\u0434\u0434\u044B, \u043E\u0431\u0451\u0440\u043D\u0443\u0442\u0430\u044F
      \u0432 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u0439 \u0448\u0451\u043B\u043A.
      \u041F\u0430\u0441\u0442\u0443\u0445, \u0443\u0432\u0438\u0434\u0435\u0432
      \u043D\u0430\u0445\u043E\u0434\u043A\u0443, \u043A\u0438\u0432\u0430\u0435\u0442
      \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C: \xAB\u041A\u0430\u043C\u0435\u043D\u044C
      \u043F\u0440\u0438\u043D\u044F\u043B \u0442\u0435\u0431\u044F.\xBB \u0412\u044B
      \u043F\u043E\u043A\u0438\u0434\u0430\u0435\u0442\u0435 \u0445\u0440\u0430\u043C
      \u0441 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0435\u0439 \u0438 \u043A\u0440\u0435\u043F\u043D\u0443\u0449\u0438\u043C
      \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u043C, \u0447\u0442\u043E \u043A\u0430\u0440\u0442\u0430
      \u0424\u0430\u0440\u0443\u0445\u0430 \u0432\u0435\u0434\u0451\u0442 \u0432\u0435\u0440\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686662
    m_Localized: "\u0412\u044B \u043A\u043E\u043F\u0430\u0435\u0442\u0435 \u043D\u0435
      \u0442\u0430\u043C \u2014 \u0430\u043B\u0442\u0430\u0440\u043D\u0430\u044F
      \u043F\u043B\u0438\u0442\u0430 \u043F\u0440\u043E\u0441\u0435\u0434\u0430\u0435\u0442
      \u043D\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u0438 \u043E\u0434\u043D\u0430
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430, \u043F\u043E\u0434\u044A\u0435\u0445\u0430\u0432\u0448\u0430\u044F
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0431\u043B\u0438\u0437\u043A\u043E,
      \u043D\u044B\u0440\u044F\u0435\u0442 \u043A\u043E\u043B\u0435\u0441\u043E\u043C
      \u0432 \u043E\u0431\u0440\u0443\u0448\u0438\u0432\u0448\u0443\u044E\u0441\u044F
      \u044F\u043C\u0443. \u0412\u044B \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435 \u0444\u0438\u0433\u0443\u0440\u043A\u0443
      \u0447\u0443\u0442\u044C \u0433\u043B\u0443\u0431\u0436\u0435, \u0432 \u0431\u043E\u043A\u043E\u0432\u043E\u0439
      \u043D\u0438\u0448\u0435, \u043D\u043E \u0431\u043E\u0440\u0442 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0442\u0440\u0435\u0441\u043D\u0443\u043B \u043E\u0442 \u0443\u0434\u0430\u0440\u0430,
      \u0438 \u043F\u0430\u0441\u0442\u0443\u0445 \u043A\u0430\u0447\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439: \xAB\u041A\u0430\u043C\u0435\u043D\u044C
      \u043D\u0435 \u043B\u044E\u0431\u0438\u0442 \u0442\u043E\u0440\u043E\u043F\u043B\u0438\u0432\u044B\u0445.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686663
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0431\u0440\u0430\u0442\u044C
      \u0441 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686664
    m_Localized: "\u0412\u044B \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442\u0435\u0441\u044C
      \u0438 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442\u0435 \u043A\u0440\u0430\u0439
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u043E\u0439 \u043E\u0431\u0451\u0440\u0442\u043A\u0438
      \u0432 \u0442\u0440\u0435\u0449\u0438\u043D\u0435 \u043F\u043B\u0438\u0442\u044B
      \u2014 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F \u0447\u0443\u0442\u044C
      \u043B\u0438 \u043D\u0435 \u0441\u0430\u043C\u0430 \u0436\u0434\u0451\u0442.
      \u0412\u044B \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u0435\u0451
      \u0432\u044B\u043D\u0438\u043C\u0430\u0435\u0442\u0435, \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0435\u0441\u044C
      \u0430\u043B\u0442\u0430\u0440\u044E \u0438 \u0443\u0445\u043E\u0434\u0438\u0442\u0435.
      \u041F\u0440\u043E\u0441\u0442\u043E. \u0414\u0435\u043B\u043E\u0432\u043E\u0435
      \u0440\u0435\u0448\u0435\u043D\u0438\u0435, \u0431\u0435\u0437 \u0440\u0430\u0441\u043A\u043E\u043F\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686665
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0447\u0438\u0442\u0430\u0435\u0442
      \u043D\u0430\u0434\u043F\u0438\u0441\u0438 \u043D\u0430 \u0441\u0442\u0443\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686666
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u043E\u0431\u0445\u043E\u0434\u0438\u0442 \u0441\u0442\u0443\u043F\u0443,
      \u0432\u043E\u0434\u0438\u0442 \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u043F\u043E
      \u043F\u043E\u043B\u0443\u0441\u0442\u0451\u0440\u0448\u0438\u043C\u0441\u044F
      \u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442\u0441\u043A\u0438\u043C \u0437\u043D\u0430\u043A\u0430\u043C
      \u0438 \u0448\u0435\u043F\u0447\u0435\u0442 \u043F\u0435\u0440\u0435\u0432\u043E\u0434:
      \u043C\u043E\u043B\u0438\u0442\u0432\u0430 \u0437\u0430 \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432,
      \u0438\u043C\u0435\u043D\u0430 \u0434\u0430\u0440\u0438\u0442\u0435\u043B\u0435\u0439,
      \u0434\u0430\u0442\u0430 \u2014 \u043F\u044F\u0442\u043E\u0433\u043E \u0432\u0435\u043A\u0430.
      \u0418 \u0433\u043B\u0430\u0432\u043D\u043E\u0435: \u0442\u043E\u0447\u043D\u043E\u0435
      \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u0435, \u043F\u043E\u0434 \u043A\u0430\u043A\u0438\u043C
      \u0438\u043C\u0435\u043D\u043D\u043E \u043A\u0430\u043C\u043D\u0435\u043C \u0441\u043F\u0440\u044F\u0442\u0430\u043D\u0430
      \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F. \u0411\u0435\u0437 \u0440\u0430\u0441\u043A\u043E\u043F\u043E\u043A,
      \u0431\u0435\u0437 \u0434\u043E\u0433\u0430\u0434\u043E\u043A \u2014 \u0432\u044B
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0435 \u043D\u0443\u0436\u043D\u0443\u044E
      \u043F\u043B\u0438\u0442\u0443 \u0438 \u0434\u043E\u0441\u0442\u0430\u0451\u0442\u0435
      \u043D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u043E\u0433\u043E \u0411\u0443\u0434\u0434\u0443.
      \u041F\u0430\u0441\u0442\u0443\u0445, \u0443\u0441\u043B\u044B\u0448\u0430\u0432
      \u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442, \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043B\u0430\u0434\u043E\u043D\u0438. \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435
      \u0441\u043E \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u044B\u043C \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u043C
      \u0438 \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C \u043C\u043E\u043D\u0430\u0445\u043E\u0432
      \u0432\u0441\u0435\u0433\u043E \u0425\u043E\u0442\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686667
    m_Localized: "\u041E\u0433\u043D\u0435\u043D\u043D\u044B\u0439 \u0430\u043B\u0442\u0430\u0440\u044C
      \u0443 \u0411\u0430\u043B\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686668
    m_Localized: "\u0412 \u043F\u044F\u0442\u0438 \u0432\u0435\u0440\u0441\u0442\u0430\u0445
      \u043E\u0442 \u0411\u0430\u043B\u0445\u0430, \u0441\u0440\u0435\u0434\u0438
      \u043F\u044B\u043B\u044C\u043D\u044B\u0445 \u0431\u0430\u043A\u0442\u0440\u0438\u0439\u0441\u043A\u0438\u0445
      \u0445\u043E\u043B\u043C\u043E\u0432, \u0441\u0442\u043E\u0438\u0442 \u0440\u0443\u0438\u043D\u0430
      \u0437\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u043E\u0433\u043E
      \u0445\u0440\u0430\u043C\u0430 \u043E\u0433\u043D\u044F. \u0410\u043B\u0442\u0430\u0440\u043D\u044B\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C \u0432 \u0446\u0435\u043D\u0442\u0440\u0435
      \u0437\u0430\u043B\u0430 \u0447\u0451\u0440\u0435\u043D \u043E\u0442 \u043A\u043E\u043F\u043E\u0442\u0438
      \u0432\u0435\u043A\u043E\u0432. \u0423 \u0432\u0445\u043E\u0434\u0430 \u0434\u0435\u0436\u0443\u0440\u0438\u0442
      \u043F\u043E\u0436\u0438\u043B\u043E\u0439 \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C
      \u0432 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0435\u043C \u0441\u0435\u0440\u043E\u043C
      \u043A\u0430\u0444\u0442\u0430\u043D\u0435 \u2014 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0438\u0437 \u043E\u0431\u0449\u0438\u043D\u044B. \u041F\u043E \u043A\u0430\u0440\u0442\u0435
      \u0424\u0430\u0440\u0443\u0445\u0430 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F
      \u043B\u0435\u0436\u0438\u0442 \u0432 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0438
      \u0430\u043B\u0442\u0430\u0440\u044F, \u043F\u043E\u0434 \u0441\u043B\u043E\u0435\u043C
      \u043F\u0435\u043F\u043B\u0430. \u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0431\u0435\u0437 \u0432\u0440\u0430\u0436\u0434\u044B,
      \u043D\u043E \u0438 \u0431\u0435\u0437 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044F.
      \u0421\u043B\u043E\u0432\u043E \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442
      \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686669
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u0441 \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686670
    m_Localized: "\u0412\u044B \u0441\u0430\u0434\u0438\u0442\u0435\u0441\u044C \u0440\u044F\u0434\u043E\u043C
      \u0441\u043E \u0441\u0442\u0430\u0440\u0438\u043A\u043E\u043C, \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435
      \u0442\u0438\u0445\u043E \u2014 \u043E \u0442\u043E\u043C, \u0447\u0442\u043E
      \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F \u0434\u043E\u043B\u0436\u043D\u0430
      \u0431\u044B\u0442\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0430,
      \u0447\u0442\u043E \u0432\u044B \u0435\u0451 \u043D\u0435 \u043F\u0440\u043E\u0434\u0430\u0434\u0438\u0442\u0435,
      \u0447\u0442\u043E \u0424\u0430\u0440\u0443\u0445 \u0438\u0437 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B \u0432\u0430\u0441. \u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C
      \u0441\u043B\u0443\u0448\u0430\u0435\u0442 \u0434\u043E\u043B\u0433\u043E,
      \u043F\u043E\u0442\u043E\u043C \u043A\u0438\u0432\u0430\u0435\u0442: \xAB\u041F\u0443\u0441\u0442\u044C
      \u0434\u0430\u0440 \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F \u043A
      \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C\u0443 \u043F\u0443\u0442\u0438,
      \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0431\u044B\u043B
      \u0441\u0434\u0435\u043B\u0430\u043D.\xBB \u041E\u043D \u0441\u0430\u043C \u043E\u0442\u0433\u0440\u0435\u0431\u0430\u0435\u0442
      \u043F\u0435\u043F\u0435\u043B \u0438 \u043F\u043E\u0434\u0430\u0451\u0442
      \u0432\u0430\u043C \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u0443\u044E \u0444\u0438\u0433\u0443\u0440\u043A\u0443
      \u2014 \u043A\u0440\u044B\u043B\u0430\u0442\u043E\u0433\u043E \u0430\u0441\u0441\u0443\u0440\u0430.
      \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0435\u0439
      \u0438 \u0441 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435\u043C
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u0436\u0440\u0435\u0446\u0430
      \u0411\u0430\u043B\u0445\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686671
    m_Localized: "\u0412\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0433\u0440\u043E\u043C\u043A\u043E, \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0442\u043E\u0440\u043E\u043F\u043B\u0438\u0432\u043E. \u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C
      \u043C\u0440\u0430\u0447\u043D\u0435\u0435\u0442: \xAB\u0427\u0443\u0436\u0430\u043A
      \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442 \u043E\u0433\u043E\u043D\u044C.\xBB
      \u0412 \u0438\u0442\u043E\u0433\u0435 \u043E\u043D \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0441\u044F
      \u043E\u0442\u0434\u0430\u0442\u044C \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044E
      \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0430 \u0441\u0435\u0440\u0435\u0431\u0440\u043E
      \u2014 \u0438 \u0431\u0435\u0440\u0451\u0442 \u0432\u0434\u0432\u043E\u0435
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u0441\u0442\u043E\u0438\u043B\u043E
      \u0431\u044B. \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441
      \u0444\u0438\u0433\u0443\u0440\u043A\u043E\u0439, \u043D\u043E \u0441 \u0442\u044F\u0436\u0451\u043B\u044B\u043C
      \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u043C, \u0447\u0442\u043E \u0441\u0434\u0435\u043B\u043A\u0430
      \u0431\u044B\u043B\u0430 \u043D\u0435 \u0442\u0430\u043A\u043E\u0439, \u043A\u0430\u043A\u043E\u0439
      \u0445\u043E\u0442\u0435\u043B \u0424\u0430\u0440\u0443\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686672
    m_Localized: "\u041E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686673
    m_Localized: "\u0412\u044B \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u043A\u043E\u0448\u0435\u043B\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u0430
      \u0431\u0435\u0437 \u0441\u043B\u043E\u0432. \u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C
      \u043C\u043E\u043B\u0447\u0430 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0434\u0435\u043D\u044C\u0433\u0438, \u043E\u0442\u0433\u0440\u0435\u0431\u0430\u0435\u0442
      \u043F\u0435\u043F\u0435\u043B \u0438 \u043E\u0442\u0434\u0430\u0451\u0442
      \u0444\u0438\u0433\u0443\u0440\u043A\u0443. \u0421\u0434\u0435\u043B\u043A\u0430
      \u0434\u0435\u043B\u043E\u0432\u0430\u044F, \u0431\u0435\u0437\u043B\u0438\u0447\u043D\u0430\u044F.
      \u0420\u0435\u043B\u0438\u043A\u0432\u0438\u044F \u0442\u0435\u043F\u0435\u0440\u044C
      \u0443 \u0432\u0430\u0441 \u2014 \u043D\u043E \u0432 \u0433\u043B\u0430\u0437\u0430\u0445
      \u0441\u0442\u0430\u0440\u0438\u043A\u0430 \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u0445\u043E\u043B\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686674
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u0431\u0435\u0441\u0435\u0434\u0443 \u043D\u0430 \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686675
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043A \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044E
      \u0438 \u0437\u0430\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0447\u0438\u0441\u0442\u043E\u043C \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u043C,
      \u0446\u0438\u0442\u0438\u0440\u0443\u044F \u0441\u0442\u0440\u043E\u043A\u0443
      \u0438\u0437 \xAB\u0410\u0432\u0435\u0441\u0442\u044B\xBB \u2014 \u043F\u0440\u043E
      \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432, \u0447\u044C\u0451 \u0434\u0435\u043B\u043E
      \u2014 \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0442\u044C \u0437\u0435\u043C\u043B\u0438.
      \u0421\u0442\u0430\u0440\u0438\u043A \u0440\u0430\u0441\u0446\u0432\u0435\u0442\u0430\u0435\u0442:
      \u0434\u0430\u0432\u043D\u043E \u0435\u043C\u0443 \u043D\u0435 \u0434\u043E\u0432\u043E\u0434\u0438\u043B\u043E\u0441\u044C
      \u0441\u043B\u044B\u0448\u0430\u0442\u044C \u0441\u043B\u043E\u0432\u043E \u0432\u0435\u0440\u044B
      \u0438\u0437 \u0447\u0443\u0436\u0438\u0445 \u0443\u0441\u0442. \u0411\u0435\u0441\u0435\u0434\u0430
      \u0438\u0434\u0451\u0442 \u0434\u043E\u043B\u0433\u043E, \u0447\u0430\u0439
      \u0441\u043C\u0435\u043D\u044F\u0435\u0442 \u0447\u0430\u0439. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C \u0441\u0430\u043C \u0432\u0435\u0434\u0451\u0442
      \u0432\u0430\u0441 \u043A \u0430\u043B\u0442\u0430\u0440\u044E \u0438 \u043F\u043E\u0434\u0430\u0451\u0442
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u0443\u044E \u0444\u0438\u0433\u0443\u0440\u043A\u0443
      \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C. \xAB\u041F\u0443\u0441\u0442\u044C
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0442\u0432\u043E\u044F \u0431\u0443\u0434\u0435\u0442
      \u0441\u0432\u0435\u0442\u043B\u043E\u0439, \u043A\u0430\u043A \u043E\u0433\u043E\u043D\u044C.\xBB
      \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0435\u0439
      \u0438 \u0441 \u043F\u0430\u0440\u043E\u0439 \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0445
      \u0444\u0440\u0430\u0437, \u043E\u0441\u0435\u0432\u0448\u0438\u0445 \u0432
      \u043F\u0430\u043C\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686676
    m_Localized: "\u041F\u0435\u0449\u0435\u0440\u043D\u043E\u0435 \u0441\u0432\u044F\u0442\u0438\u043B\u0438\u0449\u0435
      \u0443 \u041A\u0443\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686677
    m_Localized: "\u0412 \u0441\u043A\u0430\u043B\u0430\u0445 \u043A \u0441\u0435\u0432\u0435\u0440\u0443
      \u043E\u0442 \u041A\u0443\u0447\u0438, \u0432 \u043E\u0431\u0440\u044B\u0432\u0435
      \u043D\u0430\u0434 \u0441\u0443\u0445\u0438\u043C \u0440\u0443\u0441\u043B\u043E\u043C,
      \u0447\u0435\u0440\u043D\u0435\u044E\u0442 \u0432\u0445\u043E\u0434\u044B \u043F\u0435\u0449\u0435\u0440\u043D\u044B\u0445
      \u0441\u0432\u044F\u0442\u0438\u043B\u0438\u0449. \u0422\u043E\u0445\u0430\u0440\u0441\u043A\u0438\u0435
      \u043C\u043E\u043D\u0430\u0445\u0438 \u0434\u0430\u0432\u043D\u043E \u0443\u0448\u043B\u0438,
      \u043D\u043E \u0444\u0440\u0435\u0441\u043A\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C
      \u2014 \u0411\u0443\u0434\u0434\u044B \u0432 \u0441\u0438\u043D\u0438\u0445
      \u0441\u043A\u043B\u0430\u0434\u043A\u0430\u0445, \u0442\u044B\u0441\u044F\u0447\u0430
      \u0433\u043D\u0435\u0432\u043D\u044B\u0445 \u043B\u0438\u0446 \u043D\u0430
      \u043F\u043E\u0442\u043E\u043B\u043A\u0430\u0445. \u041F\u043E \u043A\u0430\u0440\u0442\u0435
      \u0424\u0430\u0440\u0443\u0445\u0430 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F
      \u2014 \u0432 \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0432\u0435\u0440\u0445\u043D\u0438\u0445
      \u043F\u0435\u0449\u0435\u0440, \u0434\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043D\u0443\u0436\u043D\u043E \u043A\u0430\u0440\u0430\u0431\u043A\u0430\u0442\u044C\u0441\u044F
      \u043F\u043E \u0432\u044B\u0432\u0435\u0442\u0440\u0435\u043D\u043D\u043E\u0439
      \u0441\u043A\u0430\u043B\u0435. \u0421\u043D\u0438\u0437\u0443 \u043F\u0435\u0449\u0435\u0440\u0430
      \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043E\u0431\u043C\u0430\u043D\u0447\u0438\u0432\u043E
      \u0431\u043B\u0438\u0437\u043A\u043E\u0439. \u0412\u0435\u0442\u0435\u0440
      \u0441 \u043F\u0443\u0441\u0442\u044B\u043D\u0438 \u041B\u043E\u043F \u0442\u044F\u043D\u0435\u0442
      \u043F\u0435\u0441\u043E\u043A \u0432 \u0442\u0440\u0435\u0449\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686678
    m_Localized: "\u041F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F \u043A \u043F\u0435\u0449\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686679
    m_Localized: "\u0412\u044B \u043B\u0435\u0437\u0435\u0442\u0435 \u043F\u043E
      \u0441\u043A\u0430\u043B\u0435 \u043C\u0435\u0442\u0440 \u0437\u0430 \u043C\u0435\u0442\u0440\u043E\u043C,
      \u043F\u0440\u043E\u0431\u0443\u044F \u043A\u0430\u0436\u0434\u044B\u0439 \u0432\u044B\u0441\u0442\u0443\u043F.
      \u041D\u0430 \u043F\u043E\u043B\u043F\u0443\u0442\u0438 \u0432\u0435\u0442\u0435\u0440
      \u0448\u0432\u044B\u0440\u044F\u0435\u0442 \u0432 \u043B\u0438\u0446\u043E
      \u043F\u0435\u0441\u043E\u043A, \u0441\u043A\u0430\u043B\u0430 \u043A\u0430\u0447\u0430\u0435\u0442\u0441\u044F
      \u2014 \u043D\u043E \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F
      \u0443\u0434\u0430\u0451\u0442\u0441\u044F. \u0412 \u043F\u0435\u0449\u0435\u0440\u0435
      \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u043E \u0438 \u0442\u0438\u0445\u043E.
      \u041F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438 \u0441\u0442\u0443\u043F\u0430
      \u043F\u0435\u0441\u043A\u0430 \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u043F\u043B\u043E\u0441\u043A\u0438\u0439 \u043A\u0430\u043C\u0435\u043D\u044C;
      \u043F\u043E\u0434 \u043D\u0438\u043C \u2014 \u043D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u0430\u044F
      \u0444\u0438\u0433\u0443\u0440\u043A\u0430 \u0411\u0443\u0434\u0434\u044B \u0432
      \u043F\u043E\u0437\u0435 \u043C\u0435\u0434\u0438\u0442\u0430\u0446\u0438\u0438.
      \u0421\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0435\u0441\u044C \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u0438 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E, \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F
      \u2014 \u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u043E\u0439. \u0423\u0432\u0430\u0436\u0435\u043D\u0438\u0435
      \u0432\u0430\u0448\u0435\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u044B \u0440\u0430\u0441\u0442\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686680
    m_Localized: "\u041D\u0430 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u043F\u043E\u0434\u044A\u0451\u043C\u0430
      \u043A\u0430\u043C\u0435\u043D\u044C \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0439
      \u0432\u044B\u043A\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0438 \u0432\u044B \u0441\u044A\u0435\u0437\u0436\u0430\u0435\u0442\u0435
      \u043D\u0430 \u0434\u0435\u0441\u044F\u0442\u044C \u043C\u0435\u0442\u0440\u043E\u0432
      \u0432\u043D\u0438\u0437, \u0446\u0435\u043F\u043B\u044F\u044F\u0441\u044C
      \u0437\u0430 \u043A\u043E\u0440\u043D\u0438 \u0438 \u0442\u0440\u0435\u0449\u0438\u043D\u044B.
      \u041E\u0431\u043E\u0434\u0440\u0430\u043D\u043D\u044B\u0435 \u043B\u0430\u0434\u043E\u043D\u0438,
      \u0440\u0430\u0437\u0431\u0438\u0442\u043E\u0435 \u043A\u043E\u043B\u0435\u043D\u043E.
      \u0412\u044B \u0432\u0441\u0451 \u0436\u0435 \u0434\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0435\u0441\u044C
      \u0434\u043E \u043F\u0435\u0449\u0435\u0440\u044B \u0441\u043E \u0432\u0442\u043E\u0440\u043E\u0439
      \u043F\u043E\u043F\u044B\u0442\u043A\u0438, \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044E
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435 \u2014 \u043D\u043E \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435
      \u043E \u043C\u0435\u0441\u0442\u0435 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0441\u0432\u044F\u0437\u0430\u043D\u043E \u0441 \u0431\u043E\u043B\u044C\u044E
      \u0438 \u0441\u0442\u0440\u0430\u0445\u043E\u043C, \u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u0430
      \u0432\u0438\u0434\u0438\u0442, \u0447\u0442\u043E \u0432\u044B \u043F\u0440\u0438\u0445\u0440\u0430\u043C\u044B\u0432\u0430\u0435\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686681
    m_Localized: "\u0414\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F \u0441\u0443\u0445\u043E\u0439
      \u043F\u043E\u0433\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686682
    m_Localized: "\u0412\u044B \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0435
      \u043B\u0430\u0433\u0435\u0440\u044C \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F
      \u0441\u043A\u0430\u043B\u044B \u0438 \u0436\u0434\u0451\u0442\u0435 \u0434\u0432\u0430
      \u0434\u043D\u044F, \u043F\u043E\u043A\u0430 \u0432\u0435\u0442\u0435\u0440
      \u0443\u043B\u044F\u0436\u0435\u0442\u0441\u044F. \u041D\u0430 \u0442\u0440\u0435\u0442\u0438\u0439
      \u0434\u0435\u043D\u044C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0435\u0441\u044C
      \u0431\u0435\u0437 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439:
      \u043A\u0430\u043C\u0435\u043D\u044C \u0441\u0443\u0445\u043E\u0439, \u043F\u0435\u0441\u043A\u0430
      \u043D\u0435\u0442, \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F \u043B\u0435\u0436\u0438\u0442
      \u0440\u043E\u0432\u043D\u043E \u0442\u0430\u043C, \u0433\u0434\u0435 \u043E\u0431\u0435\u0449\u0430\u043B\u0430
      \u043A\u0430\u0440\u0442\u0430. \u0412\u0440\u0435\u043C\u044F \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u043E,
      \u043D\u043E \u043D\u043E\u0433\u0438 \u0446\u0435\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686683
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u0431\u043E\u043A\u043E\u0432\u043E\u0439 \u0442\u0440\u043E\u043F\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686684
    m_Localized: "\u0412\u0430\u0448 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0434\u043E\u043B\u0433\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u0441\u043A\u0430\u043B\u0443, \u043F\u043E\u0442\u043E\u043C \u043C\u0430\u0448\u0435\u0442
      \u0440\u0443\u043A\u043E\u0439 \u0432\u043B\u0435\u0432\u043E: \xAB\u041D\u0435
      \u0437\u0434\u0435\u0441\u044C. \u0421\u0442\u0430\u0440\u0438\u043A\u0438
      \u0445\u043E\u0434\u0438\u043B\u0438 \u0432\u044B\u0448\u0435 \u043F\u043E
      \u0440\u0443\u0441\u043B\u0443.\xBB \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441
      \u043E\u0431\u0445\u043E\u0434\u0430 \u0432\u044B \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435\u0441\u044C
      \u0443 \u0437\u0430\u0434\u043D\u0435\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B
      \u0443\u0442\u0451\u0441\u0430, \u0433\u0434\u0435 \u043F\u0435\u0449\u0435\u0440\u0430
      \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442\u0441\u044F \u0441 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
      \u0433\u0440\u043E\u0442\u043E\u043C, \u0432 \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043C\u043E\u0436\u043D\u043E \u0432\u043E\u0439\u0442\u0438 \u043F\u0435\u0448\u043A\u043E\u043C.
      \u041D\u0438\u043A\u0430\u043A\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0431\u043A\u0430\u043D\u044C\u044F.
      \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u0430\u0436\u0438\u0433\u0430\u0435\u0442
      \u0444\u0430\u043A\u0435\u043B, \u0432\u0435\u0434\u0451\u0442 \u0447\u0435\u0440\u0435\u0437
      \u0433\u0440\u043E\u0442, \u0438 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F
      \u2014 \u043D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u044B\u0439 \u0411\u0443\u0434\u0434\u0430
      \u2014 \u043B\u0435\u0436\u0438\u0442 \u043D\u0430 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0439
      \u043F\u043E\u043B\u043A\u0435, \u0441\u043B\u043E\u0432\u043D\u043E \u0432\u0430\u0441
      \u0436\u0434\u0430\u043B\u0438. \u041E\u043F\u044B\u0442 \u0433\u043E\u0440\u043D\u044B\u0445
      \u043F\u0443\u0442\u0435\u0439 \u0435\u0449\u0451 \u0440\u0430\u0437 \u043E\u043A\u0443\u043F\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431464939520
    m_Localized: "\u0428\u0451\u043B\u043A \u0437\u0430\u043A\u0443\u043F\u043B\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882560
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0438\u0437 \u0434\u0435\u0441\u044F\u0442\u0438 \u0442\u044E\u043A\u043E\u0432
      \u043B\u043E\u0436\u0438\u0442\u0441\u044F \u0432 \u043E\u0431\u043E\u0437.
      \u0422\u044E\u043A\u0438 \u043A\u0440\u0435\u043F\u043A\u043E \u0437\u0430\u0432\u044F\u0437\u0430\u043D\u044B,
      \u043F\u0435\u0447\u0430\u0442\u0438 \u0440\u044B\u043D\u043A\u0430 \u0441\u0442\u043E\u044F\u0442.
      \u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u0436\u0434\u0451\u0442 \u0432
      \u0427\u0430\u043D\u044A\u0430\u043D\u0435. \u041F\u043E\u0440\u0430 \u0432\u044B\u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882561
    m_Localized: "\u0412\u044B\u0434\u0432\u0438\u043D\u0443\u0442\u044C\u0441\u044F
      \u0432 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882562
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u044B\u0445\u043E\u0434\u0438\u0442
      \u0438\u0437 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0445 \u0432\u043E\u0440\u043E\u0442,
      \u043F\u043E\u0434\u043D\u044F\u0432 \u043F\u044B\u043B\u044C. \u0414\u0435\u0441\u044F\u0442\u044C
      \u0442\u044E\u043A\u043E\u0432 \u0448\u0451\u043B\u043A\u0430 \u043A\u0430\u0447\u0430\u044E\u0442\u0441\u044F
      \u0432 \u0440\u0438\u0442\u043C \u0448\u0430\u0433\u043E\u0432 \u0432\u044C\u044E\u0447\u043D\u044B\u0445
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882563
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882564
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0434\u043E\u043B\u0433\u0438\u0445
      \u043D\u0435\u0434\u0435\u043B\u044C \u043F\u0443\u0442\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0441\u0442\u0435\u043D\u044B \u0427\u0430\u043D\u044A\u0430\u043D\u044F.
      \u0413\u0438\u043B\u044C\u0434\u0435\u0439\u0441\u043A\u0438\u0439 \u0441\u043A\u043B\u0430\u0434
      \u043C\u0430\u0441\u0442\u0435\u0440\u0430 \u0427\u044D\u043D\u044F \u2014
      \u0443 \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0445 \u0432\u043E\u0440\u043E\u0442.
      \u0422\u044E\u043A\u0438 \u0448\u0451\u043B\u043A\u0430 \u0446\u0435\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882565
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882566
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0447\u0435\u0440\u0435\u0437 \u0432\u043E\u0440\u043E\u0442\u0430. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438
      \u0441\u0430\u043B\u044E\u0442\u0443\u044E\u0442 \u0433\u0440\u0430\u043C\u043E\u0442\u043E\u0439
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438. \u0414\u0430\u043B\u044C\u0448\u0435
      \u2014 \u043B\u0430\u0432\u043A\u0430 \u0412\u0430\u0445\u0443-\u041C\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882567
    m_Localized: "\u0411\u0443\u0445\u0430\u0440\u0441\u043A\u0438\u0435 \u043A\u0443\u043F\u043E\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882568
    m_Localized: "\u041C\u0438\u043D\u0430\u0440\u0435\u0442\u044B \u0411\u0443\u0445\u0430\u0440\u044B
      \u043E\u0442\u0440\u0430\u0436\u0430\u044E\u0442 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u0435
      \u0441\u043E\u043B\u043D\u0446\u0435. \u0410\u043B\u044C-\u0411\u0443\u0445\u0430\u0440\u0438
      \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0442 \u0446\u0435\u043B\u044B\u0439
      \u043A\u0432\u0430\u0440\u0442\u0430\u043B \u2014 \u0434\u0432\u043E\u0440
      \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E \u0434\u043E\u043C\u0430
      \u0443\u0437\u043D\u0430\u0432\u0430\u0435\u043C \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430
      \u043F\u043E \u043A\u0440\u0430\u0441\u043D\u043E-\u0431\u0435\u043B\u043E\u043C\u0443
      \u0448\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882569
    m_Localized: "\u041F\u043E\u0434\u043E\u0439\u0442\u0438 \u043A \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C\u0443
      \u0434\u043E\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882570
    m_Localized: "\u041F\u0440\u0438\u0432\u0440\u0430\u0442\u043D\u0438\u043A \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0432 \u0442\u0435\u043D\u0438\u0441\u0442\u044B\u0439
      \u0434\u0432\u043E\u0440. \u0425\u0430\u0434\u0436\u0438 \u042E\u0441\u0443\u0444
      \u0443\u0436\u0435 \u0436\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882571
    m_Localized: "\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882572
    m_Localized: "\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u043F\u044B\u043B\u0438 \u0438
      \u0440\u043E\u0437\u043E\u0432\u043E\u0433\u043E \u043C\u0430\u0441\u043B\u0430.
      \u0412 \u043A\u043E\u0448\u0435\u043B\u0435 \u2014 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0439
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E
      \u0410\u043B\u044C-\u0411\u0443\u0445\u0430\u0440\u0438. \u0412\u0430\u0445\u0443-\u041C\u0430\u043D
      \u0432 \u0433\u0438\u043B\u044C\u0434\u0435\u0439\u0441\u043A\u043E\u043C \u0437\u0430\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882573
    m_Localized: "\u0418\u0434\u0442\u0438 \u0432 \u0433\u0438\u043B\u044C\u0434\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882574
    m_Localized: "\u0414\u0432\u0435\u0440\u0438 \u0433\u0438\u043B\u044C\u0434\u0435\u0439\u0441\u043A\u043E\u0433\u043E
      \u0437\u0430\u043B\u0430 \u0440\u0430\u0441\u043F\u0430\u0445\u043D\u0443\u0442\u044B.
      \u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u0443 \u043E\u0442 \u0441\u0432\u0438\u0442\u043A\u043E\u0432
      \u0438 \u043A\u0438\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882575
    m_Localized: "\u041C\u0435\u0448\u0445\u0435\u0434\u0441\u043A\u0438\u0435 \u0441\u0442\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882576
    m_Localized: "\u041C\u0435\u0448\u0445\u0435\u0434\u0441\u043A\u0438\u0435 \u0441\u0442\u0435\u043D\u044B
      \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u043D\u0430 \u0437\u0430\u043A\u0430\u0442\u0435.
      \u041B\u0430\u0432\u043A\u0430 \u0433\u0438\u043B\u044C\u0434\u0435\u0439\u0441\u043A\u043E\u0433\u043E
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044F
      \u2014 \u043D\u0430 \u0433\u043B\u0430\u0432\u043D\u043E\u0439 \u0443\u043B\u0438\u0446\u0435.
      \u0412\u044B \u0434\u0435\u0440\u0436\u0438\u0442\u0435 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442
      \u0432 \u0440\u0443\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882577
    m_Localized: "\u041F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882578
    m_Localized: "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044C
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0443 \u0434\u0432\u0435\u0440\u0435\u0439
      \u043B\u0430\u0432\u043A\u0438 \u0438 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0440\u0443\u043A\u0443 \u0432 \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882579
    m_Localized: "\u0411\u0430\u0433\u0434\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882580
    m_Localized: "\u041D\u0430\u0434 \u0433\u043E\u0440\u043E\u0434\u043E\u043C \u2014
      \u0433\u043E\u043B\u0443\u0431\u043E\u0439 \u043A\u0443\u043F\u043E\u043B \u0414\u043E\u043C\u0430
      \u041C\u0443\u0434\u0440\u043E\u0441\u0442\u0438. \u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C
      \u0433\u0440\u0443\u0437\u0430 \u0434\u043E\u043B\u0436\u0435\u043D \u0436\u0434\u0430\u0442\u044C
      \u0443 \u0441\u043A\u043B\u0430\u0434\u043E\u0432 \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443
      \u0422\u0438\u0433\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882581
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882582
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u043A \u0441\u043A\u043B\u0430\u0434\u0430\u043C. \u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C
      \u2014 \u0440\u043E\u0441\u043B\u044B\u0439 \u043A\u0443\u043F\u0435\u0446
      \u0441 \u0448\u0440\u0430\u043C\u043E\u043C \u2014 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u0432\u0430\u043C \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882583
    m_Localized: "\u0421\u0442\u0435\u043D\u044B \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882584
    m_Localized: "\u0417\u043E\u043B\u043E\u0442\u044B\u0435 \u043A\u0443\u043F\u043E\u043B\u0430
      \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044F
      \u0441\u0438\u044F\u044E\u0442 \u0432\u043F\u0435\u0440\u0435\u0434\u0438.
      \u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0441\u0442\u043E\u0438\u0442
      \u0440\u044F\u0434\u043E\u043C, \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442. \xAB\u0412\u0441\u0451
      \u0433\u043E\u0442\u043E\u0432\u043E. \u041E\u0434\u0438\u043D \u0448\u0430\u0433
      \u2014 \u0438 \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C
      \u043F\u0440\u043E\u0439\u0434\u0435\u043D.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882585
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882586
    m_Localized: "\u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0434\u0435\u043B\u0430\u0435\u0442
      \u043F\u0435\u0440\u0432\u044B\u0439 \u0448\u0430\u0433 \u0447\u0435\u0440\u0435\u0437
      \u0432\u043E\u0440\u043E\u0442\u0430. \u0412\u044B \u2014 \u0441\u043B\u0435\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882587
    m_Localized: "\u0410\u043D\u044C\u0441\u0438 \u0438 \u041C\u043E\u0433\u0430\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882588
    m_Localized: "\u0410\u043D\u044C\u0441\u0438 \u043E\u0442\u043A\u0440\u044B\u043B\u0441\u044F
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435. \u041F\u0435\u0449\u0435\u0440\u044B
      \u041C\u043E\u0433\u0430\u043E \u2014 \u0432 \u0447\u0430\u0441\u0435 \u043F\u0443\u0442\u0438
      \u043E\u0442 \u0433\u043E\u0440\u043E\u0434\u0430, \u0441\u0440\u0435\u0434\u0438
      \u043F\u0435\u0441\u0447\u0430\u043D\u0438\u043A\u043E\u0432\u044B\u0445 \u0445\u043E\u043B\u043C\u043E\u0432.
      \u0421\u0432\u0438\u0442\u043E\u043A \u041B\u043E\u0431\u0441\u0430\u043D\u0433\u0430
      \u0432 \u043A\u043E\u0436\u0430\u043D\u043E\u0439 \u0441\u0443\u043C\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882589
    m_Localized: "\u0418\u0434\u0442\u0438 \u043A \u043F\u0435\u0449\u0435\u0440\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882590
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u0432\u044C\u0451\u0442\u0441\u044F
      \u0441\u0440\u0435\u0434\u0438 \u0434\u044E\u043D. \u041F\u0440\u043E\u0445\u043B\u0430\u0434\u0430
      \u043F\u0435\u0449\u0435\u0440 \u043E\u0431\u0435\u0449\u0430\u0435\u0442 \u0442\u0438\u0448\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882591
    m_Localized: "\u041F\u0435\u0449\u0435\u0440\u044B \u041C\u043E\u0433\u0430\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882592
    m_Localized: "\u0412 \u043F\u0435\u0449\u0435\u0440\u0430\u0445 \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u043E
      \u0438 \u0442\u0438\u0445\u043E. \u0422\u044B\u0441\u044F\u0447\u0438 \u0411\u0443\u0434\u0434
      \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u0441\u043E \u0441\u0442\u0435\u043D.
      \u0422\u0438\u043D\u043B\u0435\u0439 \u043F\u0440\u043E\u0441\u0438\u043B \u0432\u0430\u0441
      \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F \u0437\u0434\u0435\u0441\u044C
      \u2014 \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u0442\u044C, \u0447\u0442\u043E
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882593
    m_Localized: "\u0421\u0438\u0434\u0435\u0442\u044C \u0432 \u0442\u0438\u0448\u0438\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882594
    m_Localized: "\u0427\u0430\u0441 \u043F\u0440\u043E\u0448\u0451\u043B \u2014
      \u043C\u043E\u0436\u0435\u0442, \u0434\u0432\u0430. \u0421\u0442\u0435\u043D\u044B
      \u043F\u0435\u0449\u0435\u0440\u044B \u0434\u044B\u0448\u0430\u0442. \u0412\u044B
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0435\u0441\u044C, \u0443\u043D\u043E\u0441\u044F
      \u0441 \u0441\u043E\u0431\u043E\u0439 \u043F\u0435\u0440\u0432\u044B\u0439
      \u0438\u0437 \u0442\u0440\u0451\u0445 \u0433\u043E\u043B\u043E\u0441\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882595
    m_Localized: "\u0411\u0438\u0431\u0438-\u0425\u0430\u043D\u044B\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882596
    m_Localized: "\u041C\u0435\u0447\u0435\u0442\u044C \u0411\u0438\u0431\u0438-\u0425\u0430\u043D\u044B\u043C
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435 \u2014
      \u0447\u0443\u0434\u043E \u0441\u0438\u043D\u0438\u0445 \u0438\u0437\u0440\u0430\u0437\u0446\u043E\u0432.
      \u0412 \u0435\u0451 \u0442\u0435\u043D\u0438 \u0437\u0432\u0443\u043A\u0438
      \u0433\u043E\u0440\u043E\u0434\u0430 \u0441\u0442\u0438\u0445\u0430\u044E\u0442.
      \u0422\u0438\u043D\u043B\u0435\u0439 \u043F\u0440\u043E\u0441\u0438\u043B \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C
      \u0432\u0442\u043E\u0440\u043E\u0439 \u0433\u043E\u043B\u043E\u0441 \u2014
      \u0433\u043E\u043B\u043E\u0441 \u043A\u0430\u043C\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882597
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0432 \u043C\u0435\u0447\u0435\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882598
    m_Localized: "\u0412 \u043F\u0443\u0441\u0442\u043E\u0439 \u043C\u0435\u0447\u0435\u0442\u0438
      \u0432\u0430\u0448 \u0448\u0430\u0433 \u043E\u0442\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u044D\u0445\u043E\u043C. \u041A\u0430\u043C\u0435\u043D\u044C \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0431\u0435\u0437 \u0441\u043B\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882599
    m_Localized: "\u0425\u0440\u0430\u043C \u041E\u0433\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882600
    m_Localized: "\u0417\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u0438\u0439
      \u0425\u0440\u0430\u043C \u041E\u0433\u043D\u044F \u0432 \u041C\u0435\u0448\u0445\u0435\u0434\u0435
      \u2014 \u043D\u0438\u0437\u043A\u043E\u0435 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0435
      \u0437\u0434\u0430\u043D\u0438\u0435 \u0441 \u0432\u0435\u0447\u043D\u044B\u043C
      \u043F\u043B\u0430\u043C\u0435\u043D\u0435\u043C \u0432\u043E \u0434\u0432\u043E\u0440\u0435.
      \u0422\u0438\u043D\u043B\u0435\u0439 \u043F\u0440\u043E\u0441\u0438\u043B \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C
      \u0442\u0440\u0435\u0442\u0438\u0439 \u0433\u043E\u043B\u043E\u0441 \u2014
      \u0433\u043E\u043B\u043E\u0441 \u043E\u0433\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882601
    m_Localized: "\u041F\u043E\u0434\u043E\u0439\u0442\u0438 \u043A \u043E\u0433\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882602
    m_Localized: "\u0416\u0430\u0440 \u0442\u0440\u043E\u0433\u0430\u0435\u0442 \u043A\u043E\u0436\u0443.
      \u0412\u044B \u0441\u0442\u043E\u0438\u0442\u0435 \u0434\u043E\u043B\u0433\u043E.
      \u041E\u0433\u043E\u043D\u044C \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u2014
      \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u0443 \u0432\u0430\u0441 \u0442\u0440\u0438
      \u0433\u043E\u043B\u043E\u0441\u0430 \u043E\u0434\u043D\u043E\u0433\u043E \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882603
    m_Localized: "\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434 \u0441\u043D\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882604
    m_Localized: "\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0442\u0435\u043C \u0436\u0435 \u0437\u0430\u043F\u0430\u0445\u043E\u043C
      \u0440\u043E\u0437 \u0438 \u043F\u044B\u043B\u0438. \u041B\u043E\u0431\u0441\u0430\u043D\u0433
      \u0436\u0434\u0451\u0442 \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0435
      \u043D\u0430 \u043E\u043A\u0440\u0430\u0438\u043D\u0435 \u2014 \u0432\u044B
      \u0434\u043E\u043B\u0436\u043D\u044B \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C
      \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435 \u0445\u0440\u0430\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882605
    m_Localized: "\u0418\u0434\u0442\u0438 \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882606
    m_Localized: "\u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u0441\u0438\u0434\u0438\u0442
      \u0443 \u043E\u043A\u043D\u0430, \u043A\u0430\u043A \u0441\u0438\u0434\u0435\u043B
      \u0432 \u043F\u0435\u0440\u0432\u044B\u0439 \u0434\u0435\u043D\u044C. \xAB\u0422\u044B
      \u043F\u0440\u0438\u0448\u0451\u043B. \u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882607
    m_Localized: "\u0410\u043D\u044C\u0441\u0438 \u0437\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882608
    m_Localized: "\u0421\u0442\u0435\u043D\u044B \u0410\u043D\u044C\u0441\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0437\u0430\u043A\u0430\u0442\u0435. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432 \u0438\u0434\u0451\u0442 \u0441\u0442\u0440\u043E\u0435\u043C
      \u2014 \u0443\u0441\u0442\u0430\u0432\u0448\u0438\u0435, \u043D\u043E \u0436\u0438\u0432\u044B\u0435.
      \u0414\u0430\u0440\u0438\u0443\u0448 \u0436\u0434\u0451\u0442 \u043E\u0442\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882609
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882610
    m_Localized: "\u041C\u0435\u0441\u0442\u043D\u044B\u0439 \u0441\u0442\u0430\u0440\u0448\u0438\u043D\u0430
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0443 \u0432\u043E\u0440\u043E\u0442.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0448\u0451\u043B
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882611
    m_Localized: "\u041C\u0435\u0448\u0445\u0435\u0434\u0441\u043A\u0438\u0439 \u0441\u043A\u043B\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882612
    m_Localized: "\u041C\u0435\u0448\u0445\u0435\u0434 \u043F\u0430\u0445\u043D\u0435\u0442
      \u0441\u043A\u0438\u043F\u0438\u0434\u0430\u0440\u043E\u043C \u0438 \u043B\u043E\u0448\u0430\u0434\u0438\u043D\u044B\u043C
      \u043F\u043E\u0442\u043E\u043C. \u0421\u043A\u043B\u0430\u0434 \u0441 \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u043C
      \u0433\u0440\u0443\u0437\u043E\u043C \u2014 \u0443 \u044E\u0436\u043D\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442. \u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C
      \u2014 \u0440\u043E\u0441\u043B\u044B\u0439 \u043C\u0443\u0436\u0447\u0438\u043D\u0430
      \u0441\u043E \u0448\u0440\u0430\u043C\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882613
    m_Localized: "\u0421\u0434\u0430\u0442\u044C \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882614
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442
      \u0441\u043E\u0441\u0443\u0434\u044B \u0434\u0432\u0430\u0436\u0434\u044B.
      \u0414\u0430\u0440\u0438\u0443\u0448 \u0441\u0438\u0434\u0438\u0442 \u0432
      \u0443\u0433\u043B\u0443 \u043D\u0430 \u0442\u044E\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882615
    m_Localized: "\u0411\u0430\u0433\u0434\u0430\u0434 \u043D\u0430 \u0437\u0430\u043A\u0430\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882616
    m_Localized: "\u0411\u0430\u0433\u0434\u0430\u0434\u0441\u043A\u0438\u0435 \u043A\u0443\u043F\u043E\u043B\u0430
      \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0435\u043D\u044B \u0437\u0430\u043A\u0430\u0442\u043D\u044B\u043C
      \u0441\u043E\u043B\u043D\u0446\u0435\u043C. \u0414\u0430\u0440\u0438\u0443\u0448
      \u0436\u0434\u0451\u0442 \u0443 \u0414\u043E\u043C\u0430 \u041C\u0443\u0434\u0440\u043E\u0441\u0442\u0438
      \u2014 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043F\u0440\u0438\u0432\u0430\u043B
      \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882617
    m_Localized: "\u0418\u0434\u0442\u0438 \u043A \u0414\u0430\u0440\u0438\u0443\u0448\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882618
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0447\u0430\u0448\u0443, \u0443\u0432\u0438\u0434\u0435\u0432 \u0432\u0430\u0441.
      \xAB\u0414\u043E\u0448\u0451\u043B. \u0422\u0435\u043F\u0435\u0440\u044C \u0442\u044B
      \u043B\u0435\u0433\u0435\u043D\u0434\u0430.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882619
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C \u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882620
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435
      \u2014 \u0441\u0430\u043C\u044B\u0439 \u0448\u0443\u043C\u043D\u044B\u0439
      \u0433\u043E\u0440\u043E\u0434 \u043C\u0438\u0440\u0430. \u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F
      \u0427\u044D\u043D\u044F \u2014 \u0443\u0437\u043A\u0430\u044F, \u043F\u0440\u043E\u043F\u0430\u0445\u0448\u0430\u044F
      \u0438\u043D\u0434\u0438\u0433\u043E, \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u043C
      \u043A\u0440\u0430\u044E \u0440\u044B\u043D\u043A\u0430. \u0421\u044B\u0440\u044C\u0451
      \u0432 \u043E\u0431\u043E\u0437\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882621
    m_Localized: "\u0418\u0434\u0442\u0438 \u0432 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882622
    m_Localized: "\u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u0441\u0442\u043E\u0438\u0442
      \u043D\u0430\u0434 \u0447\u0430\u043D\u043E\u043C, \u043D\u0435 \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044F\u0441\u044C.
      \xAB\u0422\u044B \u043F\u0440\u0438\u0448\u0451\u043B. \u041F\u043E\u043B\u043E\u0436\u0438.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882623
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C \u2014 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882624
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C \u043F\u0440\u0438\u0432\u044B\u0447\u0435\u043D.
      \u041D\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F
      \u0427\u044D\u043D\u044C \u0412\u044D\u044F \u0436\u0434\u0451\u0442 \u043E\u0441\u043E\u0431\u044B\u0439
      \u0433\u0440\u0443\u0437 \u2014 \u043F\u0443\u0440\u043F\u0443\u0440\u043D\u0443\u044E
      \u0442\u043A\u0430\u043D\u044C \u0434\u043B\u044F \u0438\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0441\u043A\u043E\u0433\u043E
      \u0437\u0430\u043A\u0430\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882625
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u0442\u043A\u0430\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882626
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440 \u0431\u0435\u0440\u0435\u0436\u043D\u043E
      \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0440\u0443\u043B\u043E\u043D \u043F\u0443\u0440\u043F\u0443\u0440\u0430 \u0438
      \u0434\u043E\u043B\u0433\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u0446\u0432\u0435\u0442. \xAB\u041B\u0443\u0447\u0448\u0430\u044F \u043F\u0430\u0440\u0442\u0438\u044F,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u044F \u0432\u0438\u0434\u0435\u043B.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882627
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C \u2014 \u0444\u0438\u043D\u0430\u043B
      \u043E\u0445\u043E\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882628
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u0432\u0441\u0435\u0445 \u0441\u043F\u0435\u0446\u0438\u0439
      \u043C\u0438\u0440\u0430. \u0410\u0440\u0445\u0438\u0432 \u0443 \u0418\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0441\u043A\u043E\u0433\u043E
      \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0430 \u2014 \u0442\u0443\u0434\u0430
      \u043D\u0443\u0436\u043D\u043E \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043F\u044F\u0442\u044B\u0439 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442,
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882629
    m_Localized: "\u0418\u0434\u0442\u0438 \u0432 \u0410\u0440\u0445\u0438\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882630
    m_Localized: "\u0410\u0440\u0445\u0438\u0432\u0430\u0440\u0438\u0443\u0441-\u043A\u0438\u0442\u0430\u0435\u0446
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044E
      \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C. \xAB\u0428\u0435\u0441\u0442\u044C\u0441\u043E\u0442
      \u043B\u0435\u0442 \u043F\u0440\u043E\u0448\u043B\u043E \u0441 \u0442\u0435\u0445
      \u043F\u043E\u0440, \u043A\u0430\u043A \u044D\u0442\u043E\u0442 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
      \u043F\u043E\u043A\u0438\u043D\u0443\u043B \u044D\u0442\u0438 \u0441\u0442\u0435\u043D\u044B.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882631
    m_Localized: "\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F \u0434\u0443\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882632
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u0432\u044B\u0432\u043E\u0434\u0438\u0442
      \u0432\u0430\u0441 \u0432 \u0441\u0443\u0445\u043E\u0439 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439
      \u0434\u0432\u043E\u0440 \u0433\u043E\u0440\u043D\u043E\u0433\u043E \u0445\u0440\u0430\u043C\u0430.
      \u0412\u043E\u0437\u0434\u0443\u0445 \u0440\u0430\u0437\u0440\u0435\u0436\u0451\u043D,
      \u043A\u0438\u043F\u0430\u0440\u0438\u0441 \u043D\u0435 \u043A\u0430\u0447\u0430\u0435\u0442\u0441\u044F.
      \xAB\u041F\u0435\u0440\u0435\u0434 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435\u043C
      \u2014 \u0442\u0440\u0438 \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F.
      \u0412\u0441\u0435 \u043E\u043D\u0438 \u2014 \u0432\u043D\u0443\u0442\u0440\u0438
      \u0442\u0435\u0431\u044F. \u0412\u044B\u0431\u0435\u0440\u0438, \u0447\u0435\u0440\u0435\u0437
      \u0447\u0442\u043E \u0442\u044B \u0432\u043E\u0439\u0434\u0451\u0448\u044C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882633
    m_Localized: "\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435 \u0442\u0438\u0448\u0438\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882634
    m_Localized: "\u0412\u044B \u0441\u0430\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432
      \u0422\u0438\u043D\u043B\u0435\u044F \u0438 \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442\u0435
      \u043D\u0438 \u0441\u043B\u043E\u0432\u0430. \u0427\u0430\u0441, \u0434\u0432\u0430.
      \u0412\u0440\u0435\u043C\u044F \u0442\u0435\u0440\u044F\u0435\u0442 \u043E\u0447\u0435\u0440\u0442\u0430\u043D\u0438\u044F.
      \u041A\u043E\u0433\u0434\u0430 \u0432\u044B \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0435
      \u0433\u043B\u0430\u0437\u0430, \u043C\u043E\u043D\u0430\u0445 \u043A\u0438\u0432\u0430\u0435\u0442:
      \xAB\u0422\u0438\u0448\u0438\u043D\u0430 \u043F\u0440\u0438\u043D\u044F\u043B\u0430
      \u0442\u0435\u0431\u044F. \u0412\u043E\u0439\u0434\u0438 \u0432 \u0445\u0440\u0430\u043C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882635
    m_Localized: "\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435 \u0441\u0442\u0440\u0430\u0445\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882636
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u0432\u0435\u0434\u0451\u0442
      \u0432\u0430\u0441 \u043A \u0443\u0437\u043A\u043E\u0439 \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0435
      \u043D\u0430\u0434 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C\u044E.
      \u0412\u044B \u0441\u0442\u043E\u0438\u0442\u0435 \u043D\u0430 \u0435\u0451
      \u043A\u0440\u0430\u044E, \u043F\u043E\u043A\u0430 \u0432\u0435\u0442\u0435\u0440
      \u043D\u0435 \u0441\u0442\u0438\u0445\u043D\u0435\u0442. \u041A\u043E\u0433\u0434\u0430
      \u0432\u044B \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0435\u0441\u044C,
      \u043C\u043E\u043D\u0430\u0445 \u0443\u0436\u0435 \u0443 \u0432\u0445\u043E\u0434\u0430
      \u0432 \u0445\u0440\u0430\u043C. \xAB\u0421\u0442\u0440\u0430\u0445 \u043F\u0440\u043E\u0439\u0434\u0435\u043D.
      \u0412\u043E\u0439\u0434\u0438.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882637
    m_Localized: "\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435 \u0432\u044B\u0431\u043E\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882638
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u043A\u043B\u0430\u0434\u0451\u0442
      \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438 \u0434\u0432\u0435
      \u0447\u0430\u0448\u0438: \u043E\u0434\u043D\u0430 \u0441 \u0432\u043E\u0434\u043E\u0439,
      \u0434\u0440\u0443\u0433\u0430\u044F \u043F\u0443\u0441\u0442\u0430. \xAB\u0412\u044B\u0431\u0435\u0440\u0438
      \u043E\u0434\u043D\u0443, \u043E\u0442\u0434\u0430\u0439 \u0434\u0440\u0443\u0433\u043E\u043C\u0443.\xBB
      \u0412\u044B \u043E\u0442\u0434\u0430\u0451\u0442\u0435 \u043F\u043E\u043B\u043D\u0443\u044E
      \u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0435 \u043F\u0443\u0441\u0442\u0443\u044E
      \u0441\u0435\u0431\u0435. \u0422\u0438\u043D\u043B\u0435\u0439 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F.
      \xAB\u0421\u0434\u0435\u043B\u0430\u043D\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440
      \u0432\u0438\u0434\u0435\u043D \u0432 \u043A\u0430\u0436\u0434\u043E\u043C
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C. \u0412\u043E\u0439\u0434\u0438.\xBB"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
