  m_TableData:
  - m_Id: 443539456
    m_Localized: "\u041D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 514842624
    m_Localized: "\u041F\u0435\u0441\u0447\u0430\u043D\u0430\u044F \u0431\u0443\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 514842625
    m_Localized: "\u0417\u0430\u0441\u0430\u0434\u0430 \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 514842626
    m_Localized: "\u041D\u0430 \u0442\u0440\u043E\u043F\u0435 \u0432\u0430\u0441
      \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0442 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0435
      \u043B\u044E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 514842627
    m_Localized: "\u0421\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 514842628
    m_Localized: "\u0423\u0431\u0435\u0436\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 514842629
    m_Localized: "\u041E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 514842630
    m_Localized: "\u041F\u0435\u0441\u0447\u0430\u043D\u0430\u044F \u0431\u0443\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 514842631
    m_Localized: "\u0421\u0442\u0435\u043D\u0430 \u043F\u0435\u0441\u043A\u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435 \u0438
      \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0435\u0442\u0441\u044F.
      \u0412\u0435\u0442\u0435\u0440 \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0438 \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u044C \u043F\u0430\u0434\u0430\u0435\u0442
      \u0441 \u043A\u0430\u0436\u0434\u043E\u0439 \u0441\u0435\u043A\u0443\u043D\u0434\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 514842632
    m_Localized: "\u0423\u043A\u0440\u044B\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 514842633
    m_Localized: "\u0418\u0434\u0442\u0438 \u043D\u0430\u043F\u0440\u043E\u043B\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 3444889870336
    m_Localized: "\u0422\u0435\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 3444902453248
    m_Localized: "\u0422\u0435\u0441\u0442\u043E\u0432\u043E\u0435 \u0441\u043E\u0431\u044B\u0442\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 3444902453249
    m_Localized: "\u042D\u0442\u043E \u0442\u0435\u0441\u0442\u043E\u0432\u043E\u0435
      \u0441\u043E\u0431\u044B\u0442\u0438\u0435 \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438
      \u0441\u0438\u0441\u0442\u0435\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 3444902453250
    m_Localized: "\u041F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 3444902453251
    m_Localized: "\u0420\u0438\u0441\u043A\u043D\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148041117696
    m_Localized: "\u0417\u0430\u0441\u0430\u0434\u0430 \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148078866432
    m_Localized: "\u0418\u0437-\u0437\u0430 \u0431\u0430\u0440\u0445\u0430\u043D\u043E\u0432
      \u0432\u044B\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u044E\u0442 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0435
      \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u0438 \u0432 \u043C\u0430\u0441\u043A\u0430\u0445,
      \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0443
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443. \u0411\u043B\u0435\u0441\u043A
      \u043A\u043B\u0438\u043D\u043A\u043E\u0432 \u043D\u0430 \u0441\u043E\u043B\u043D\u0446\u0435
      \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u0439
      \u0432 \u0438\u0445 \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u0438\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 651148078866433
    m_Localized: "\u0421\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148078866434
    m_Localized: "\u0411\u0435\u0436\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148078866435
    m_Localized: "\u041E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148078866436
    m_Localized: "\u041D\u0435\u0432\u044B\u043D\u043E\u0441\u0438\u043C\u044B\u0439
      \u0437\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060736
    m_Localized: "\u0421\u043E\u043B\u043D\u0446\u0435 \u0432\u044B\u0436\u0438\u0433\u0430\u0435\u0442
      \u043F\u0443\u0441\u0442\u044B\u043D\u044E \u0431\u0435\u0441\u043F\u043E\u0449\u0430\u0434\u043D\u044B\u043C
      \u0436\u0430\u0440\u043E\u043C. \u0412\u043E\u0437\u0434\u0443\u0445 \u0434\u0440\u043E\u0436\u0438\u0442
      \u043D\u0430\u0434 \u0440\u0430\u0441\u043A\u0430\u043B\u0451\u043D\u043D\u044B\u043C\u0438
      \u0431\u0430\u0440\u0445\u0430\u043D\u0430\u043C\u0438, \u0430 \u043B\u044E\u0434\u0438
      \u0438 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u0435\u043B\u0435
      \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F \u043D\u0430 \u043D\u043E\u0433\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060737
    m_Localized: "\u041F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060738
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060739
    m_Localized: "\u0421\u043A\u043E\u0440\u043F\u0438\u043E\u043D\u044B \u0432 \u043B\u0430\u0433\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060740
    m_Localized: "\u0412 \u043D\u043E\u0447\u043D\u043E\u043C \u043B\u0430\u0433\u0435\u0440\u0435
      \u0441\u0440\u0435\u0434\u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u044B \u043A\u0440\u0443\u043F\u043D\u044B\u0435
      \u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D\u044B. \u0418\u0445 \u0445\u0432\u043E\u0441\u0442\u044B
      \u0443\u0433\u0440\u043E\u0436\u0430\u044E\u0449\u0435 \u0438\u0437\u043E\u0433\u043D\u0443\u0442\u044B,
      \u0438 \u043A\u0430\u0436\u0434\u043E\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
      \u0433\u0440\u043E\u0437\u0438\u0442 \u0443\u043A\u0443\u0441\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060741
    m_Localized: "\u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C \u043E\u0433\u043D\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060742
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060743
    m_Localized: "\u041F\u0443\u0441\u0442\u044B\u043D\u043D\u044B\u0439 \u043E\u0430\u0437\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060744
    m_Localized: "\u0421\u0440\u0435\u0434\u0438 \u0431\u0435\u0441\u043A\u0440\u0430\u0439\u043D\u0438\u0445
      \u043F\u0435\u0441\u043A\u043E\u0432 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u0437\u0435\u043B\u0435\u043D\u044C \u043F\u0430\u043B\u044C\u043C \u0438
      \u0431\u043B\u0435\u0441\u043A \u0432\u043E\u0434\u044B. \u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
      \u043E\u0430\u0437\u0438\u0441, \u043D\u043E \u0441\u043B\u0435\u0434\u044B
      \u0432\u043E\u043A\u0440\u0443\u0433 \u0433\u043E\u0432\u043E\u0440\u044F\u0442,
      \u0447\u0442\u043E \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E \u043D\u0435
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060745
    m_Localized: "\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060746
    m_Localized: "\u041D\u0430\u0431\u0440\u0430\u0442\u044C \u0432\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060747
    m_Localized: "\u041C\u0438\u0440\u0430\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060748
    m_Localized: "\u041D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435
      \u043C\u0435\u0440\u0446\u0430\u0435\u0442 \u0441\u0438\u043B\u0443\u044D\u0442
      \u0433\u043E\u0440\u043E\u0434\u0430 \u0441 \u043C\u0438\u043D\u0430\u0440\u0435\u0442\u0430\u043C\u0438.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u0441\u043F\u043E\u0440\u044F\u0442:
      \u043E\u0434\u043D\u0438 \u0443\u0432\u0435\u0440\u0435\u043D\u044B, \u0447\u0442\u043E
      \u044D\u0442\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0433\u043E\u0440\u043E\u0434,
      \u0434\u0440\u0443\u0433\u0438\u0435 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u044E\u0442
      \u043E \u043C\u0438\u0440\u0430\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060749
    m_Localized: "\u0418\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060750
    m_Localized: "\u0418\u0434\u0442\u0438 \u043A \u043D\u0435\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060751
    m_Localized: "\u0417\u0430\u0441\u0443\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060752
    m_Localized: "\u041A\u043E\u043B\u043E\u0434\u0446\u044B \u043D\u0430 \u043F\u0443\u0442\u0438
      \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u043B\u0438, \u0430 \u0437\u0430\u043F\u0430\u0441\u044B
      \u0432\u043E\u0434\u044B \u0442\u0430\u044E\u0442. \u041F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u0432\u0448\u0430\u044F\u0441\u044F
      \u0437\u0435\u043C\u043B\u044F \u0442\u044F\u043D\u0435\u0442\u0441\u044F \u0434\u043E
      \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430, \u0438 \u043D\u0443\u0436\u043D\u043E
      \u0440\u0435\u0448\u0430\u0442\u044C, \u043A\u0430\u043A \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u043A\u0430\u043F\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060753
    m_Localized: "\u0423\u0440\u0435\u0437\u0430\u0442\u044C \u0440\u0430\u0446\u0438\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060754
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u0432\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060755
    m_Localized: "\u0414\u043E\u0432\u0435\u0440\u0438\u0442\u044C\u0441\u044F \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060756
    m_Localized: "\u041F\u0435\u0441\u0447\u0430\u043D\u0430\u044F \u043B\u043E\u0432\u0443\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060757
    m_Localized: "\u041A\u043E\u043B\u0451\u0441\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u0432 \u0437\u044B\u0431\u0443\u0447\u0438\u0439 \u043F\u0435\u0441\u043E\u043A.
      \u0427\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0435 \u0442\u044F\u043D\u0443\u0442
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B, \u0442\u0435\u043C \u0433\u043B\u0443\u0431\u0436\u0435
      \u0432\u044F\u0437\u043D\u0435\u0442 \u0433\u0440\u0443\u0437. \u041F\u0435\u0441\u043E\u043A
      \u0437\u0430\u0441\u0430\u0441\u044B\u0432\u0430\u0435\u0442 \u043F\u043E\u0432\u043E\u0437\u043A\u0443
      \u043D\u0430 \u0433\u043B\u0430\u0437\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060758
    m_Localized: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E \u0432\u044B\u0442\u0430\u0449\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060759
    m_Localized: "\u0422\u044F\u043D\u0443\u0442\u044C \u0441\u0438\u043B\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060760
    m_Localized: "\u0420\u0430\u0437\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0438
      \u043E\u0431\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060761
    m_Localized: "\u0417\u0430\u0441\u0442\u0440\u044F\u0432\u0448\u0435\u0435 \u043A\u043E\u043B\u0435\u0441\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060762
    m_Localized: "\u041A\u043E\u043B\u0435\u0441\u043E \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043D\u0430\u043C\u0435\u0440\u0442\u0432\u043E \u0443\u0432\u044F\u0437\u043B\u043E
      \u0432 \u043F\u0435\u0441\u043A\u0435. \u041E\u0441\u044C \u0442\u0440\u0435\u0449\u0438\u0442,
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u0440\u0435\u0432\u0443\u0442,
      \u0430 \u0441\u043E\u043B\u043D\u0446\u0435 \u043F\u0430\u043B\u0438\u0442
      \u043D\u0435\u0449\u0430\u0434\u043D\u043E. \u041D\u0443\u0436\u043D\u043E
      \u0447\u0442\u043E-\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C \u0431\u044B\u0441\u0442\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060763
    m_Localized: "\u041F\u043E\u0447\u0438\u043D\u0438\u0442\u044C \u043A\u0430\u043A
      \u0441\u043B\u0435\u0434\u0443\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060764
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u0430\u044F \u043F\u043E\u0447\u0438\u043D\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060765
    m_Localized: "\u0420\u0430\u0437\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0447\u0430\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060766
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060767
    m_Localized: "\u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0448\u0430\u0442\u0440\u044B \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u043E\u0432
      \u0441 \u0434\u044B\u043C\u043E\u043C \u043A\u043E\u0441\u0442\u0440\u043E\u0432.
      \u0412\u043E\u0436\u0434\u044C \u0432 \u0440\u0430\u0437\u0432\u0435\u0432\u0430\u044E\u0449\u0438\u0445\u0441\u044F
      \u043E\u0434\u0435\u0436\u0434\u0430\u0445 \u0436\u0435\u0441\u0442\u043E\u043C
      \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u0435\u0442 \u043A\u0430\u0440\u0430\u0432\u0430\u043D.
      \u042D\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
      \u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044F, \u0438 \u043B\u043E\u0432\u0443\u0448\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060768
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060769
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060770
    m_Localized: "\u041F\u043E\u0434\u0430\u0440\u0438\u0442\u044C \u0448\u0451\u043B\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060771
    m_Localized: "\u0414\u0440\u0435\u0432\u043D\u0438\u0435 \u0440\u0443\u0438\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060772
    m_Localized: "\u041F\u043E\u043B\u0443\u0437\u0430\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0435
      \u043F\u0435\u0441\u043A\u043E\u043C \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0435
      \u043A\u043E\u043B\u043E\u043D\u043D\u044B \u0438 \u043E\u0431\u043B\u043E\u043C\u043A\u0438
      \u0430\u0440\u043E\u043A \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u044E\u0442
      \u0438\u0437 \u0434\u044E\u043D. \u0417\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u044B\u0435
      \u043D\u0430\u0434\u043F\u0438\u0441\u0438 \u043D\u0430 \u0441\u0442\u0435\u043D\u0430\u0445
      \u043C\u0430\u043D\u044F\u0442 \u0437\u0430\u0433\u043B\u044F\u043D\u0443\u0442\u044C
      \u0432\u043D\u0443\u0442\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060773
    m_Localized: "\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u0433\u043B\u0443\u0431\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060774
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u0441\u043D\u0430\u0440\u0443\u0436\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060775
    m_Localized: "\u0418\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060776
    m_Localized: "\u041F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0439 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060777
    m_Localized: "\u0412\u0435\u0442\u0435\u0440 \u0441\u0442\u0451\u0440 \u0432\u0441\u0435
      \u0441\u043B\u0435\u0434\u044B \u043D\u0430 \u043F\u0435\u0441\u043A\u0435,
      \u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u043E\u0434\u043D\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u043E\u0439
      \u043F\u0443\u0441\u0442\u044B\u043D\u0438. \u041A\u0430\u0440\u0442\u0430
      \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u0430, \u0430 \u0441\u043E\u043B\u043D\u0446\u0435
      \u043A\u043B\u043E\u043D\u0438\u0442\u0441\u044F \u043A \u0437\u0430\u043A\u0430\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060778
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060779
    m_Localized: "\u0418\u0434\u0442\u0438 \u043D\u0430\u0443\u0433\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060780
    m_Localized: "\u041F\u043E\u043B\u043E\u0436\u0438\u0442\u044C\u0441\u044F \u043D\u0430
      \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060781
    m_Localized: "\u0413\u043E\u0440\u043D\u0430\u044F \u0437\u0430\u0441\u0430\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060782
    m_Localized: "\u0411\u0430\u043D\u0434\u0438\u0442\u044B \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u043B\u0438
      \u0443\u0437\u043A\u0438\u0439 \u0433\u043E\u0440\u043D\u044B\u0439 \u043F\u0440\u043E\u0445\u043E\u0434,
      \u0437\u0430\u043D\u044F\u0432 \u043F\u043E\u0437\u0438\u0446\u0438\u0438 \u043D\u0430
      \u0441\u043A\u0430\u043B\u0430\u0445 \u043D\u0430\u0434 \u0442\u0440\u043E\u043F\u043E\u0439.
      \u0421\u0442\u0440\u0435\u043B\u044B \u043D\u0430\u0446\u0435\u043B\u0435\u043D\u044B
      \u0432\u043D\u0438\u0437, \u0430 \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0442\u044C
      \u043D\u0435\u043A\u0443\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060783
    m_Localized: "\u0421\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060784
    m_Localized: "\u0411\u0435\u0436\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060785
    m_Localized: "\u041E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060786
    m_Localized: "\u041A\u0430\u043C\u043D\u0435\u043F\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060787
    m_Localized: "\u0417\u0435\u043C\u043B\u044F \u0441\u043E\u0434\u0440\u043E\u0433\u0430\u0435\u0442\u0441\u044F,
      \u0438 \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0435 \u0432\u0430\u043B\u0443\u043D\u044B
      \u043D\u0435\u0441\u0443\u0442\u0441\u044F \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443
      \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D.
      \u041E\u0431\u043B\u0430\u043A\u043E \u043F\u044B\u043B\u0438 \u0437\u0430\u0441\u0442\u0438\u043B\u0430\u0435\u0442
      \u043D\u0435\u0431\u043E, \u0438 \u0441\u0447\u0451\u0442 \u0438\u0434\u0451\u0442
      \u043D\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060788
    m_Localized: "\u0423\u043A\u0440\u044B\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060789
    m_Localized: "\u041F\u0440\u043E\u0441\u043A\u043E\u0447\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060790
    m_Localized: "\u0421\u0442\u0430\u044F \u0432\u043E\u043B\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060791
    m_Localized: "\u0418\u0437 \u0433\u043E\u0440\u043D\u043E\u0433\u043E \u043B\u0435\u0441\u0430
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0441\u0442\u0430\u044F \u0441\u0435\u0440\u044B\u0445
      \u0432\u043E\u043B\u043A\u043E\u0432, \u0438\u0445 \u0433\u043B\u0430\u0437\u0430
      \u0441\u0432\u0435\u0442\u044F\u0442\u0441\u044F \u0432 \u0441\u0443\u043C\u0435\u0440\u043A\u0430\u0445.
      \u0417\u0432\u0435\u0440\u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0442 \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u044F \u0434\u043E\u0431\u044B\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060792
    m_Localized: "\u041E\u0442\u043F\u0443\u0433\u043D\u0443\u0442\u044C \u043E\u0433\u043D\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060793
    m_Localized: "\u041F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060794
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060795
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u0442\u0443\u043C\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060796
    m_Localized: "\u0413\u0443\u0441\u0442\u043E\u0439 \u0431\u0435\u043B\u044B\u0439
      \u0442\u0443\u043C\u0430\u043D \u043F\u043E\u0433\u043B\u043E\u0442\u0438\u043B
      \u0433\u043E\u0440\u043D\u0443\u044E \u0442\u0440\u043E\u043F\u0443. \u041A\u0440\u0430\u0439
      \u043E\u0431\u0440\u044B\u0432\u0430 \u0435\u0434\u0432\u0430 \u0440\u0430\u0437\u043B\u0438\u0447\u0438\u043C,
      \u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u0448\u0430\u0433 \u043C\u043E\u0436\u0435\u0442
      \u0441\u0442\u0430\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060797
    m_Localized: "\u041F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060798
    m_Localized: "\u0418\u0434\u0442\u0438 \u0432\u0441\u043B\u0435\u043F\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060799
    m_Localized: "\u0414\u043E\u0432\u0435\u0440\u0438\u0442\u044C\u0441\u044F \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060800
    m_Localized: "\u0417\u0430\u0432\u0430\u043B \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060801
    m_Localized: "\u041C\u0430\u0441\u0441\u0438\u0432\u043D\u0430\u044F \u0441\u0442\u0435\u043D\u0430
      \u0438\u0437 \u043A\u0430\u043C\u043D\u0435\u0439 \u0438 \u043E\u0431\u043B\u043E\u043C\u043A\u043E\u0432
      \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u043B\u0430 \u0433\u043E\u0440\u043D\u044B\u0439
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B. \u041A\u0440\u0443\u0442\u044B\u0435
      \u0441\u043A\u0430\u043B\u044B \u0441 \u043E\u0431\u0435\u0438\u0445 \u0441\u0442\u043E\u0440\u043E\u043D
      \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442 \u043F\u0440\u043E\u0441\u0442\u043E\u0433\u043E
      \u043E\u0431\u0445\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060802
    m_Localized: "\u0420\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060803
    m_Localized: "\u041F\u0440\u043E\u0431\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      \u0441\u0438\u043B\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060804
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u043F\u043E\u043C\u043E\u0449\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060805
    m_Localized: "\u0421\u043B\u043E\u043C\u0430\u043D\u043D\u0430\u044F \u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060806
    m_Localized: "\u041D\u0430 \u043A\u0440\u0443\u0442\u043E\u043C \u0441\u043F\u0443\u0441\u043A\u0435
      \u043E\u0441\u044C \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0441 \u0442\u0440\u0435\u0441\u043A\u043E\u043C
      \u043B\u043E\u043C\u0430\u0435\u0442\u0441\u044F. \u0413\u0440\u0443\u0437
      \u043E\u043F\u0430\u0441\u043D\u043E \u043D\u0430\u043A\u0440\u0435\u043D\u0438\u043B\u0441\u044F,
      \u0438 \u0442\u043E\u0432\u0430\u0440\u044B \u0432\u043E\u0442-\u0432\u043E\u0442
      \u043F\u043E\u0441\u044B\u043F\u043B\u044E\u0442\u0441\u044F \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060807
    m_Localized: "\u041F\u043E\u043B\u043D\u044B\u0439 \u0440\u0435\u043C\u043E\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060808
    m_Localized: "\u0412\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F \u043F\u043E\u0447\u0438\u043D\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060809
    m_Localized: "\u0421\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0447\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060810
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u043E\u0442\u0448\u0435\u043B\u044C\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060811
    m_Localized: "\u0423 \u0433\u043E\u0440\u043D\u043E\u0439 \u043F\u0435\u0449\u0435\u0440\u044B
      \u0441\u0438\u0434\u0438\u0442 \u0441\u0442\u0430\u0440\u044B\u0439 \u043E\u0442\u0448\u0435\u043B\u044C\u043D\u0438\u043A
      \u0432 \u043F\u0440\u043E\u0441\u0442\u044B\u0445 \u043E\u0434\u0435\u0436\u0434\u0430\u0445,
      \u0440\u044F\u0434\u043E\u043C \u043F\u0430\u0441\u0443\u0442\u0441\u044F \u043A\u043E\u0437\u044B.
      \u041E\u043D \u043F\u0440\u0438\u0432\u0435\u0442\u043B\u0438\u0432\u043E \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
      \u0447\u0430\u0439 \u0438 \u0434\u0435\u043B\u0438\u0442\u0441\u044F \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060812
    m_Localized: "\u041F\u043E\u0441\u043B\u0443\u0448\u0430\u0442\u044C \u0441\u043E\u0432\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
