    m_Localized: "\u041F\u0440\u0438\u0431\u0440\u0435\u0436\u043D\u044B\u0439 \u0448\u0442\u043E\u0440\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255113
    m_Localized: "\u041E\u0433\u0440\u043E\u043C\u043D\u044B\u0435 \u0432\u043E\u043B\u043D\u044B
      \u043E\u0431\u0440\u0443\u0448\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u043D\u0430
      \u043F\u0440\u0438\u0431\u0440\u0435\u0436\u043D\u0443\u044E \u0434\u043E\u0440\u043E\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255114
    m_Localized: "\u0423\u043A\u0440\u044B\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255115
    m_Localized: "\u041F\u0440\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255116
    m_Localized: "\u041F\u0440\u0438\u0431\u0440\u0435\u0436\u043D\u043E\u0435 \u043D\u0430\u0432\u043E\u0434\u043D\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255117
    m_Localized: "\u0420\u0430\u0437\u043B\u0438\u0432\u0448\u0430\u044F\u0441\u044F
      \u0440\u0435\u043A\u0430 \u0437\u0430\u0442\u043E\u043F\u0438\u043B\u0430 \u043F\u0440\u0438\u0431\u0440\u0435\u0436\u043D\u0443\u044E
      \u0434\u043E\u0440\u043E\u0433\u0443. \u041C\u0443\u0442\u043D\u0430\u044F
      \u0432\u043E\u0434\u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255118
    m_Localized: "\u041F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C \u0441\u043F\u0430\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255119
    m_Localized: "\u041F\u0435\u0440\u0435\u0441\u0435\u0447\u044C \u0432\u0431\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255120
    m_Localized: "\u041F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u043D\u0430\u0441\u0442\u0438\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255121
    m_Localized: "\u041A\u043E\u0440\u0430\u0431\u043B\u0435\u043A\u0440\u0443\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255122
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u0442\u044B\u0439 \u043A\u043E\u0440\u0430\u0431\u043B\u044C
      \u043B\u0435\u0436\u0438\u0442 \u043D\u0430 \u043A\u0430\u043C\u043D\u044F\u0445
      \u0443 \u0431\u0435\u0440\u0435\u0433\u0430. \u041C\u0435\u0436\u0434\u0443
      \u043E\u0431\u043B\u043E\u043C\u043A\u043E\u0432 \u0432\u0438\u0434\u043D\u044B
      \u0431\u043E\u0447\u043A\u0438 \u0438 \u044F\u0449\u0438\u043A\u0438 \u2014
      \u0447\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430 \u0435\u0449\u0451
      \u0446\u0435\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255123
    m_Localized: "\u041E\u0431\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u043E\u0431\u043B\u043E\u043C\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255124
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0441 \u0431\u0435\u0440\u0435\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255125
    m_Localized: "\u041D\u044B\u0440\u043D\u0443\u0442\u044C \u0437\u0430 \u0433\u0440\u0443\u0437\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255126
    m_Localized: "\u0420\u044B\u0431\u0430\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255127
    m_Localized: "\u0420\u044B\u0431\u0430\u043A\u0438 \u0447\u0438\u043D\u044F\u0442
      \u0441\u0435\u0442\u0438 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255128
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255129
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255130
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0440\u044B\u0431\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255131
    m_Localized: "\u0421\u043E\u043B\u0435\u0432\u0430\u044F \u043A\u043E\u0440\u0440\u043E\u0437\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255132
    m_Localized: "\u041C\u043E\u0440\u0441\u043A\u043E\u0439 \u0432\u043E\u0437\u0434\u0443\u0445
      \u0440\u0430\u0437\u044A\u0435\u0434\u0430\u0435\u0442 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u0447\u0430\u0441\u0442\u0438 \u043F\u043E\u0432\u043E\u0437\u043A\u0438.
      \u041A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F \u0440\u0436\u0430\u0432\u0435\u044E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255133
    m_Localized: "\u041A\u0430\u043F\u0438\u0442\u0430\u043B\u044C\u043D\u044B\u0439
      \u0440\u0435\u043C\u043E\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255134
    m_Localized: "\u0421\u043C\u0430\u0437\u0430\u0442\u044C \u0438 \u0435\u0445\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255135
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255136
    m_Localized: "\u0412 \u043F\u0440\u0438\u0431\u0440\u0435\u0436\u043D\u043E\u0439
      \u043F\u0435\u0449\u0435\u0440\u0435 \u043C\u0435\u043B\u044C\u043A\u0430\u0435\u0442
      \u0441\u0432\u0435\u0442 \u0444\u043E\u043D\u0430\u0440\u044F. \u0421\u043A\u0440\u044B\u0442\u043D\u044B\u0435
      \u0444\u0438\u0433\u0443\u0440\u044B \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044E\u0442
      \u0448\u0451\u043F\u043E\u0442\u043E\u043C \u044D\u043A\u0437\u043E\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0442\u043E\u0432\u0430\u0440 \u043F\u043E \u0437\u0430\u043C\u0430\u043D\u0447\u0438\u0432\u043E\u0439
      \u0446\u0435\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255137
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255138
    m_Localized: "\u0423\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255139
    m_Localized: "\u041A\u0440\u0443\u043F\u043D\u0430\u044F \u0441\u0434\u0435\u043B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255140
    m_Localized: "\u041D\u0430\u0448\u0435\u0441\u0442\u0432\u0438\u0435 \u043A\u0440\u0430\u0431\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255141
    m_Localized: "\u0421\u043E\u0442\u043D\u0438 \u043A\u0440\u0430\u0431\u043E\u0432
      \u043F\u043E\u043B\u0437\u0443\u0442 \u0447\u0435\u0440\u0435\u0437 \u043F\u0440\u0438\u0431\u0440\u0435\u0436\u043D\u0443\u044E
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0432\u043E \u0432\u0440\u0435\u043C\u044F
      \u043C\u0438\u0433\u0440\u0430\u0446\u0438\u0438. \u041F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043D\u0435 \u043F\u0440\u043E\u0435\u0434\u0435\u0442 \u2014 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u043B\u0438\u0431\u043E \u0440\u0430\u0441\u0447\u0438\u0449\u0430\u0442\u044C
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255142
    m_Localized: "\u0420\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255143
    m_Localized: "\u041F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255144
    m_Localized: "\u0413\u043E\u0440\u043D\u0430\u044F \u0431\u0443\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255145
    m_Localized: "\u041B\u0435\u0434\u044F\u043D\u043E\u0439 \u0432\u0435\u0442\u0435\u0440
      \u043E\u0431\u0440\u0443\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D, \u0441\u043A\u0440\u044B\u0432\u0430\u044F
      \u0442\u0440\u043E\u043F\u0443 \u0437\u0430 \u0441\u0442\u0435\u043D\u043E\u0439
      \u0441\u043D\u0435\u0433\u0430. \u041F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0434\u0440\u043E\u0436\u0430\u0442 \u043F\u043E\u0434 \u043D\u0430\u043F\u043E\u0440\u043E\u043C
      \u0431\u0443\u0440\u0438, \u0430 \u0432\u044C\u044E\u0447\u043D\u044B\u0435
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u0443\u043F\u0438\u0440\u0430\u044E\u0442\u0441\u044F
      \u0438 \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0438\u0434\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255146
    m_Localized: "\u0423\u043A\u0440\u044B\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255147
    m_Localized: "\u0418\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255148
    m_Localized: "\u0413\u043E\u0440\u043D\u0430\u044F \u0431\u043E\u043B\u0435\u0437\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255149
    m_Localized: "\u041D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435 \u0432\u043E\u0437\u0434\u0443\u0445
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0440\u0430\u0437\u0440\u0435\u0436\u0435\u043D\u043D\u044B\u043C.
      \u041B\u044E\u0434\u0438 \u0445\u0432\u0430\u0442\u0430\u044E\u0442\u0441\u044F
      \u0437\u0430 \u0433\u043E\u043B\u043E\u0432\u044B, \u0430 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435
      \u0441\u043F\u043E\u0442\u044B\u043A\u0430\u044E\u0442\u0441\u044F \u043D\u0430
      \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0439 \u0442\u0440\u043E\u043F\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255150
    m_Localized: "\u041C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0439 \u043F\u043E\u0434\u044A\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255151
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u044B\u0439 \u043F\u0440\u043E\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255152
    m_Localized: "\u041E\u0431\u0445\u043E\u0434\u043D\u043E\u0439 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255153
    m_Localized: "\u0417\u0430\u043C\u0451\u0440\u0437\u0448\u0438\u0435 \u043A\u043E\u043B\u0451\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255154
    m_Localized: "\u0423\u0442\u0440\u043E\u043C \u043A\u043E\u043B\u0451\u0441\u0430
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043D\u0430\u043C\u0435\u0440\u0442\u0432\u043E
      \u043F\u0440\u0438\u043C\u0451\u0440\u0437\u043B\u0438 \u043A \u0437\u0435\u043C\u043B\u0435.
      \u041B\u0451\u0434 \u0441\u043A\u043E\u0432\u0430\u043B \u043E\u0441\u0438,
      \u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
      \u0442\u0440\u043E\u043D\u0443\u0442\u044C\u0441\u044F \u0441 \u043C\u0435\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255155
    m_Localized: "\u041F\u043E\u043B\u043D\u044B\u0439 \u0440\u0435\u043C\u043E\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255156
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u0430\u044F \u043F\u043E\u0447\u0438\u043D\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255157
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u0432\u043E\u0437\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255158
    m_Localized: "\u041F\u0430\u0441\u0442\u0443\u0445\u0438 \u044F\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255159
    m_Localized: "\u041D\u0430 \u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E\u0440\u043D\u043E\u043C
      \u043F\u043B\u0430\u0442\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u043F\u0430\u0441\u0442\u0443\u0445\u043E\u0432 \u044F\u043A\u043E\u0432 \u0432
      \u0442\u0451\u043F\u043B\u044B\u0445 \u043C\u0435\u0445\u043E\u0432\u044B\u0445
      \u0448\u0443\u0431\u0430\u0445. \u041E\u043D\u0438 \u043C\u0430\u0448\u0443\u0442
      \u0440\u0443\u043A\u043E\u0439 \u0438 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u044E\u0442
      \u043A \u043A\u043E\u0441\u0442\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255160
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255161
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255162
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0447\u0430\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255163
    m_Localized: "\u041B\u0435\u0434\u044F\u043D\u0430\u044F \u0442\u0440\u043E\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255164
    m_Localized: "\u0423\u0437\u043A\u0430\u044F \u0433\u043E\u0440\u043D\u0430\u044F
      \u0442\u0440\u043E\u043F\u0430 \u043F\u043E\u043A\u0440\u044B\u0442\u0430 \u043A\u043E\u0440\u043A\u043E\u0439
      \u043B\u044C\u0434\u0430. \u041E\u0434\u043D\u043E \u043D\u0435\u0432\u0435\u0440\u043D\u043E\u0435
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435 \u2014 \u0438 \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0441\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0451\u0442 \u0432 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255165
    m_Localized: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u0439 \u043F\u0440\u043E\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449344
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u044B\u0439 \u043F\u0440\u043E\u0435\u0437\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449345
    m_Localized: "\u041B\u0430\u0432\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449346
    m_Localized: "\u0413\u0440\u043E\u0445\u043E\u0442 \u0440\u0430\u0437\u0434\u0430\u0451\u0442\u0441\u044F
      \u0441\u0432\u0435\u0440\u0445\u0443 \u2014 \u0441\u0442\u0435\u043D\u0430
      \u0441\u043D\u0435\u0433\u0430 \u043D\u0435\u0441\u0451\u0442\u0441\u044F \u043F\u043E
      \u0441\u043A\u043B\u043E\u043D\u0443 \u043F\u0440\u044F\u043C\u043E \u043D\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D. \u0415\u0441\u0442\u044C \u043B\u0438\u0448\u044C
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u044F, \u0447\u0442\u043E\u0431\u044B
      \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u0440\u0435\u0448\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449347
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u0443\u043A\u0440\u044B\u0442\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449348
    m_Localized: "\u0411\u0435\u0436\u0430\u0442\u044C \u0432\u043F\u0435\u0440\u0451\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449349
    m_Localized: "\u0420\u0430\u0437\u0440\u0435\u0436\u0435\u043D\u043D\u044B\u0439
      \u0432\u043E\u0437\u0434\u0443\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449350
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0437\u0430\u0431\u0440\u0430\u043B\u0441\u044F
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0432\u044B\u0441\u043E\u043A\u043E.
      \u041B\u044E\u0434\u0438 \u043F\u0430\u0434\u0430\u044E\u0442 \u043E\u0442
      \u0433\u043E\u043B\u043E\u0432\u043E\u043A\u0440\u0443\u0436\u0435\u043D\u0438\u044F,
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F. \u041D\u0443\u0436\u043D\u043E
      \u0440\u0435\u0448\u0438\u0442\u044C \u2014 \u0436\u0434\u0430\u0442\u044C
      \u0438\u043B\u0438 \u0438\u0434\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449351
    m_Localized: "\u041E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449352
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449353
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449354
    m_Localized: "\u0417\u043E\u043B\u043E\u0442\u0430\u044F \u043A\u0440\u044B\u0448\u0430
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F \u0431\u043B\u0435\u0441\u0442\u0438\u0442
      \u0441\u0440\u0435\u0434\u0438 \u0441\u043D\u0435\u0436\u043D\u044B\u0445 \u0432\u0435\u0440\u0448\u0438\u043D.
      \u041C\u043E\u043D\u0430\u0445\u0438 \u0432 \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u044B\u0445
      \u043E\u0434\u0435\u0436\u0434\u0430\u0445 \u0441\u0442\u043E\u044F\u0442 \u0443
      \u0432\u043E\u0440\u043E\u0442, \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044F
      \u043A\u0440\u043E\u0432 \u043F\u0443\u0442\u043D\u0438\u043A\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449355
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043A\u0440\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449356
    m_Localized: "\u0418\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449357
    m_Localized: "\u0421\u0434\u0435\u043B\u0430\u0442\u044C \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449358
    m_Localized: "\u041D\u0430\u0432\u043E\u0434\u043D\u0435\u043D\u0438\u0435 \u0432
      \u0434\u043E\u043B\u0438\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449359
    m_Localized: "\u0420\u0435\u043A\u0430 \u0432\u044B\u0448\u043B\u0430 \u0438\u0437
      \u0431\u0435\u0440\u0435\u0433\u043E\u0432 \u0438 \u0437\u0430\u0442\u043E\u043F\u0438\u043B\u0430
      \u0434\u043E\u0440\u043E\u0433\u0443. \u0411\u0443\u0440\u044B\u0439 \u043F\u043E\u0442\u043E\u043A
      \u043D\u0435\u0441\u0451\u0442 \u0432\u0435\u0442\u043A\u0438 \u0438 \u0433\u0440\u044F\u0437\u044C,
      \u043E\u0442\u0440\u0435\u0437\u0430\u044F \u043F\u0443\u0442\u044C \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449360
    m_Localized: "\u041F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449361
    m_Localized: "\u041F\u0435\u0440\u0435\u0439\u0442\u0438 \u0432\u0431\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449362
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u043B\u043E\u0434\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449363
    m_Localized: "\u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449364
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u043F\u0430\u0440\u043E\u043C
      \u043F\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0443
      \u043F\u0440\u0438\u0447\u0430\u043B\u0430. \u041F\u0430\u0440\u043E\u043C\u0449\u0438\u043A
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043F\u043B\u0430\u0442\u0443 \u0437\u0430
      \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0443 \u0447\u0435\u0440\u0435\u0437
      \u0433\u043B\u0443\u0431\u043E\u043A\u0443\u044E \u0431\u044B\u0441\u0442\u0440\u0443\u044E
      \u0440\u0435\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449365
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449366
    m_Localized: "\u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u0441\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449367
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449368
    m_Localized: "\u041E\u043F\u0430\u0441\u043D\u044B\u0439 \u0431\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449369
    m_Localized: "\u0420\u0435\u043A\u0430 \u0443 \u0431\u0440\u043E\u0434\u0430
      \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E \u0432\u0437\u0434\u0443\u043B\u0430\u0441\u044C.
      \u0411\u0443\u0440\u043D\u043E\u0435 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      \u043D\u0435\u0441\u0451\u0442 \u043A\u0430\u043C\u043D\u0438 \u0438 \u0432\u0435\u0442\u043A\u0438,
      \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430 \u043E\u043F\u0430\u0441\u043D\u0430
      \u0434\u043B\u044F \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0438 \u043B\u044E\u0434\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449370
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u0434\u0440\u0443\u0433\u043E\u0439
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449371
    m_Localized: "\u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449372
    m_Localized: "\u0420\u044B\u0431\u0430\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449373
    m_Localized: "\u0420\u044B\u0431\u0430\u043A\u0438 \u0447\u0438\u043D\u044F\u0442
      \u0441\u0435\u0442\u0438 \u0443 \u0431\u0435\u0440\u0435\u0433\u0430 \u0440\u0435\u043A\u0438.
      \u0420\u044F\u0434\u043E\u043C \u0441\u0442\u043E\u0438\u0442 \u0434\u0435\u0440\u0435\u0432\u043D\u044F
      \u0438\u0437 \u0442\u0440\u043E\u0441\u0442\u043D\u0438\u043A\u043E\u0432\u044B\u0445
      \u0445\u0438\u0436\u0438\u043D, \u043F\u0430\u0445\u043D\u0435\u0442 \u0441\u0432\u0435\u0436\u0435\u0439
      \u0440\u044B\u0431\u043E\u0439 \u0438 \u0434\u044B\u043C\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449374
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0440\u044B\u0431\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449375
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449376
    m_Localized: "\u041E\u0431\u043C\u0435\u043D\u044F\u0442\u044C \u0441\u043E\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449377
    m_Localized: "\u0417\u0430\u0441\u0442\u0440\u044F\u043B\u0438 \u0432 \u0433\u0440\u044F\u0437\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449378
    m_Localized: "\u041F\u043E\u0432\u043E\u0437\u043A\u0430 \u0443\u0432\u044F\u0437\u043B\u0430
      \u0432 \u0431\u043E\u043B\u043E\u0442\u0438\u0441\u0442\u043E\u0439 \u0437\u0435\u043C\u043B\u0435
      \u0443 \u0440\u0435\u043A\u0438. \u041A\u043E\u043B\u0451\u0441\u0430 \u043F\u043E
      \u0441\u0442\u0443\u043F\u0438\u0446\u0443 \u0443\u0448\u043B\u0438 \u0432
      \u0447\u0451\u0440\u043D\u0443\u044E \u0436\u0438\u0436\u0443, \u0438 \u043D\u0438
      \u043B\u044E\u0434\u0438, \u043D\u0438 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435
      \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u0435\u0451 \u0441\u0434\u0432\u0438\u043D\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449379
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u043F\u043E\u043C\u043E\u0449\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449380
    m_Localized: "\u041F\u043E\u0447\u0438\u043D\u0438\u0442\u044C \u0441\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449381
    m_Localized: "\u0420\u0430\u0437\u0433\u0440\u0443\u0437\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449382
    m_Localized: "\u041F\u043B\u043E\u0434\u043E\u0440\u043E\u0434\u043D\u044B\u0439
      \u0431\u0435\u0440\u0435\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449383
    m_Localized: "\u041F\u044B\u0448\u043D\u044B\u0439 \u0431\u0435\u0440\u0435\u0433
      \u0440\u0435\u043A\u0438 \u0443\u0441\u044B\u043F\u0430\u043D \u0434\u0438\u043A\u0438\u043C\u0438
      \u0444\u0440\u0443\u043A\u0442\u0430\u043C\u0438 \u0438 \u044F\u0433\u043E\u0434\u0430\u043C\u0438.
      \u041F\u0442\u0438\u0446\u044B \u043F\u043E\u044E\u0442 \u0432 \u0432\u0435\u0442\u0432\u044F\u0445,
      \u0430 \u0447\u0438\u0441\u0442\u0430\u044F \u0432\u043E\u0434\u0430 \u0436\u0443\u0440\u0447\u0438\u0442
      \u043F\u043E \u043A\u0430\u043C\u043D\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449384
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449385
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0447\u0442\u043E \u0432\u0438\u0434\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449386
    m_Localized: "\u0411\u0440\u043E\u0434\u044F\u0447\u0438\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449387
    m_Localized: "\u041E\u0434\u0438\u043D\u043E\u043A\u0438\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0441 \u043D\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u043C \u043E\u0441\u043B\u043E\u043C
      \u043C\u0430\u0448\u0435\u0442 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443
      \u0441 \u043E\u0431\u043E\u0447\u0438\u043D\u044B. \u041D\u0430 \u0435\u0433\u043E
      \u0442\u044E\u043A\u0430\u0445 \u0431\u043E\u043B\u0442\u0430\u044E\u0442\u0441\u044F
      \u044F\u0440\u043A\u0438\u0435 \u0442\u043A\u0430\u043D\u0438 \u0438 \u043C\u0435\u0448\u043E\u0447\u043A\u0438
      \u0441\u043E \u0441\u043F\u0435\u0446\u0438\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449388
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449389
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449390
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C \u0448\u0451\u043B\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449391
    m_Localized: "\u0417\u0430\u0431\u043B\u0443\u0434\u0448\u0438\u0439 \u043F\u0443\u0442\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449392
    m_Localized: "\u0418\u0437\u043C\u043E\u0436\u0434\u0451\u043D\u043D\u044B\u0439
      \u043F\u0443\u0442\u043D\u0438\u043A \u0441\u0438\u0434\u0438\u0442 \u0443
      \u0434\u043E\u0440\u043E\u0433\u0438 \u0441 \u043F\u0443\u0441\u0442\u043E\u0439
      \u0444\u043B\u044F\u0433\u043E\u0439. \u0415\u0433\u043E \u043E\u0434\u0435\u0436\u0434\u0430
      \u0438\u0437\u043E\u0434\u0440\u0430\u043D\u0430, \u0430 \u0432 \u0433\u043B\u0430\u0437\u0430\u0445
      \u2014 \u043C\u043E\u043B\u044C\u0431\u0430 \u043E \u043F\u043E\u043C\u043E\u0449\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449393
    m_Localized: "\u041F\u043E\u043C\u043E\u0447\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449394
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449395
    m_Localized: "\u0412\u044B\u043B\u0435\u0447\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449396
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0431\u0435\u0436\u0435\u043D\u0446\u0435\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449397
    m_Localized: "\u0413\u0440\u0443\u043F\u043F\u0430 \u0438\u0437\u043C\u0443\u0447\u0435\u043D\u043D\u044B\u0445
      \u0431\u0435\u0436\u0435\u043D\u0446\u0435\u0432 \u0441 \u0434\u0435\u0442\u044C\u043C\u0438
      \u0438 \u0443\u0437\u043B\u0430\u043C\u0438 \u0431\u0440\u0435\u0434\u0451\u0442
      \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443. \u0412 \u0438\u0445
      \u0433\u043B\u0430\u0437\u0430\u0445 \u0441\u0442\u0440\u0430\u0445, \u043E\u043D\u0438
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u044E\u0442
      \u043E\u0431 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u0432\u043F\u0435\u0440\u0435\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449398
    m_Localized: "\u041F\u043E\u043C\u043E\u0447\u044C \u0435\u0434\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449399
    m_Localized: "\u0418\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449400
    m_Localized: "\u041F\u0440\u0438\u044E\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449401
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
      \u0443\u0447\u0451\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449402
    m_Localized: "\u0423\u0447\u0451\u043D\u044B\u0439 \u0432 \u0442\u043E\u043D\u043A\u0438\u0445
      \u043E\u0434\u0435\u0436\u0434\u0430\u0445 \u0441 \u043C\u0443\u043B\u043E\u043C,
      \u0433\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u043C \u0441\u0432\u0438\u0442\u043A\u0430\u043C\u0438
      \u0438 \u043A\u043D\u0438\u0433\u0430\u043C\u0438, \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
      \u0437\u043D\u0430\u043D\u0438\u044F \u0432 \u043E\u0431\u043C\u0435\u043D
      \u043D\u0430 \u043A\u043E\u043C\u043F\u0430\u043D\u0438\u044E \u0432 \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449403
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449404
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449405
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449406
    m_Localized: "\u0420\u0430\u043D\u0435\u043D\u044B\u0439 \u0432\u043E\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449407
    m_Localized: "\u0420\u0430\u043D\u0435\u043D\u044B\u0439 \u0441\u043E\u043B\u0434\u0430\u0442
      \u0432 \u0440\u0432\u0430\u043D\u044B\u0445 \u0434\u043E\u0441\u043F\u0435\u0445\u0430\u0445
      \u043F\u0440\u0438\u0432\u0430\u043B\u0438\u043B\u0441\u044F \u043A \u0434\u0435\u0440\u0435\u0432\u0443
      \u0443 \u0434\u043E\u0440\u043E\u0433\u0438. \u0415\u0433\u043E \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u043A\u0438
      \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D\u044B \u043A\u0440\u043E\u0432\u044C\u044E,
      \u0430 \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u0439 \u043C\u0435\u0447
      \u043B\u0435\u0436\u0438\u0442 \u0440\u044F\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449408
    m_Localized: "\u041D\u0430\u043A\u043E\u0440\u043C\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449409
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449410
    m_Localized: "\u0412\u044B\u043B\u0435\u0447\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449411
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449412
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0441 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u043E\u0439
      \u043E\u0445\u0440\u0430\u043D\u043E\u0439 \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F
      \u0432 \u0442\u043E\u043C \u0436\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438.
      \u0415\u0433\u043E \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
      \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u044E\u0449\u0435 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0448\u0438 \u0442\u043E\u0432\u0430\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449413
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449414
    m_Localized: "\u041E\u0431\u043E\u0433\u043D\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449415
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449416
    m_Localized: "\u0413\u0440\u0443\u043F\u043F\u0430 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449417
    m_Localized: "\u0413\u0440\u0443\u043F\u043F\u0430 \u043C\u0438\u0440\u043D\u044B\u0445
      \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u043E\u0432 \u0432 \u043F\u0440\u043E\u0441\u0442\u044B\u0445
      \u043E\u0434\u0435\u0436\u0434\u0430\u0445 \u0438\u0434\u0451\u0442 \u0432\u043C\u0435\u0441\u0442\u0435.
      \u0417\u0430\u043F\u0430\u0445 \u0431\u043B\u0430\u0433\u043E\u0432\u043E\u043D\u0438\u0439
      \u0438 \u0442\u0438\u0445\u0430\u044F \u043C\u043E\u043B\u0438\u0442\u0432\u0430
      \u0441\u043E\u043F\u0440\u043E\u0432\u043E\u0436\u0434\u0430\u044E\u0442 \u0438\u0445
      \u0448\u0430\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449418
    m_Localized: "\u041F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449419
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449420
    m_Localized: "\u0422\u0430\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449421
    m_Localized: "\u041D\u0430 \u043F\u0435\u0440\u0435\u043A\u0440\u0451\u0441\u0442\u043A\u0435
      \u0432 \u0441\u0443\u043C\u0435\u0440\u043A\u0430\u0445 \u0441\u0442\u043E\u0438\u0442
      \u0444\u0438\u0433\u0443\u0440\u0430 \u0432 \u043F\u043B\u0430\u0449\u0435
      \u0441 \u043A\u0430\u043F\u044E\u0448\u043E\u043D\u043E\u043C. \u041B\u0438\u0446\u043E
      \u0441\u043A\u0440\u044B\u0442\u043E \u0442\u0435\u043D\u044C\u044E, \u043D\u043E
      \u0440\u0443\u043A\u0430 \u043C\u0430\u043D\u0438\u0442 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0431\u043B\u0438\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449422
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449423
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449424
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449425
    m_Localized: "\u0421\u0432\u0430\u0434\u0435\u0431\u043D\u0430\u044F \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449426
    m_Localized: "\u042F\u0440\u043A\u0430\u044F \u0441\u0432\u0430\u0434\u0435\u0431\u043D\u0430\u044F
      \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0438\u044F \u0441 \u043C\u0443\u0437\u044B\u043A\u043E\u0439
      \u0438 \u0446\u0432\u0435\u0442\u0430\u043C\u0438 \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u0435\u0442
      \u0434\u043E\u0440\u043E\u0433\u0443. \u0422\u0430\u043D\u0446\u043E\u0440\u044B
      \u0432 \u044F\u0440\u043A\u0438\u0445 \u043D\u0430\u0440\u044F\u0434\u0430\u0445
      \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u044E\u0442 \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432
      \u043D\u0430 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449427
    m_Localized: "\u041F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449428
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449429
    m_Localized: "\u041D\u0430\u0451\u043C\u043D\u044B\u0439 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449430
    m_Localized: "\u041A\u0440\u0435\u043F\u043A\u0438\u0439 \u0432\u043E\u0438\u043D
      \u0432 \u043A\u043E\u0436\u0430\u043D\u044B\u0445 \u0434\u043E\u0441\u043F\u0435\u0445\u0430\u0445
      \u0442\u043E\u0447\u0438\u0442 \u043C\u0435\u0447 \u0443 \u043E\u0431\u043E\u0447\u0438\u043D\u044B.
      \u041E\u043D \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0441\u0432\u043E\u0438
      \u0443\u0441\u043B\u0443\u0433\u0438 \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449431
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449432
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449433
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449434
    m_Localized: "\u041E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432 \u043E\u0434\u0435\u0436\u0434\u0435
      \u0440\u0430\u0437\u043D\u044B\u0445 \u043A\u0443\u043B\u044C\u0442\u0443\u0440
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      \u044F\u0437\u044B\u043A\u0430\u0445 \u0441 \u043A\u0443\u043F\u0446\u0430\u043C\u0438
      \u043D\u0430 \u043F\u0435\u0440\u0435\u043A\u0440\u0451\u0441\u0442\u043A\u0435.
      \u041E\u043D \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F
      \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449435
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449436
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449437
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449438
    m_Localized: "\u041C\u0435\u0441\u0442\u043D\u044B\u0439 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0441 \u0441\u0430\u043C\u043E\u0434\u0435\u043B\u044C\u043D\u044B\u043C\u0438
      \u043A\u0430\u0440\u0442\u0430\u043C\u0438 \u0441\u0442\u043E\u0438\u0442 \u043D\u0430
      \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0435 \u0434\u043E\u0440\u043E\u0433.
      \u041E\u043D \u0437\u043D\u0430\u0435\u0442 \u0442\u0430\u0439\u043D\u044B\u0435
      \u0442\u0440\u043E\u043F\u044B \u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0435
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449439
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449440
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449441
    m_Localized: "\u0426\u0435\u043B\u0438\u0442\u0435\u043B\u044C \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449442
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
      \u043B\u0435\u043A\u0430\u0440\u044C \u0441 \u043C\u0435\u0448\u043E\u0447\u043A\u0430\u043C\u0438
      \u0442\u0440\u0430\u0432 \u0438 \u0441\u043D\u0430\u0434\u043E\u0431\u0438\u0439
      \u043B\u0435\u0447\u0438\u0442 \u0440\u0430\u043D\u0435\u043D\u043E\u0435 \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435
      \u0443 \u0434\u043E\u0440\u043E\u0433\u0438. \u041E\u043D \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
      \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F
      \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443 \u0440\u0430\u0434\u0438
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449443
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449444
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449445
    m_Localized: "\u041F\u043E\u043F\u0443\u0442\u0447\u0438\u043A-\u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449446
    m_Localized: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0441 \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u043C
      \u043E\u0441\u043B\u043E\u043C \u043F\u0440\u043E\u0441\u0438\u0442 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F
      \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0432\u043C\u0435\u0441\u0442\u0435. \u0415\u0433\u043E \u0442\u043E\u0432\u0430\u0440\u044B
      \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442 \u043E\u0442\u043C\u0435\u043D\u043D\u043E,
      \u0430 \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u2014 \u043E\u043F\u0430\u0441\u043D\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449447
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449448
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449449
    m_Localized: "\u0413\u043E\u043B\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449450
    m_Localized: "\u0417\u0430\u043F\u0430\u0441\u044B \u0435\u0434\u044B \u043F\u043E\u0447\u0442\u0438
      \u043D\u0430 \u043D\u0443\u043B\u0435. \u0418\u0441\u0445\u0443\u0434\u0430\u0432\u0448\u0438\u0435
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B \u0441 \u0432\u043F\u0430\u043B\u044B\u043C\u0438
      \u0433\u043B\u0430\u0437\u0430\u043C\u0438 \u0441\u043F\u043E\u0440\u044F\u0442
      \u0438\u0437-\u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445
      \u043A\u0440\u043E\u0448\u0435\u043A \u0445\u043B\u0435\u0431\u0430. \u041D\u0443\u0436\u043D\u043E
      \u0441\u0440\u043E\u0447\u043D\u043E \u0447\u0442\u043E-\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449451
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0435\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449452
    m_Localized: "\u0417\u0430\u0431\u0438\u0442\u044C \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449453
    m_Localized: "\u0423\u0440\u0435\u0437\u0430\u0442\u044C \u0440\u0430\u0446\u0438\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449454
    m_Localized: "\u041F\u043E\u0432\u043E\u0437\u043A\u0430 \u0440\u0430\u0437\u0432\u0430\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449455
    m_Localized: "\u0420\u0430\u043C\u0430 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0442\u0440\u0435\u0449\u0438\u0442
      \u0438 \u0432\u043E\u0442-\u0432\u043E\u0442 \u0440\u0430\u0437\u0432\u0430\u043B\u0438\u0442\u0441\u044F.
      \u0413\u0440\u0443\u0437 \u043E\u043F\u0430\u0441\u043D\u043E \u043D\u0430\u043A\u0440\u0435\u043D\u0438\u043B\u0441\u044F,
      \u0434\u0435\u0440\u0435\u0432\u043E \u0442\u0440\u0435\u0449\u0438\u0442 \u043F\u043E\u0434
      \u0432\u0435\u0441\u043E\u043C \u0442\u043E\u0432\u0430\u0440\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449456
    m_Localized: "\u0421\u0440\u043E\u0447\u043D\u044B\u0439 \u0440\u0435\u043C\u043E\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449457
    m_Localized: "\u041F\u0435\u0440\u0435\u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
      \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449458
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u0447\u0430\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449459
    m_Localized: "\u041A\u0440\u0430\u0436\u0430 \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449460
    m_Localized: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u044B
      \u0432\u0441\u043F\u043E\u0440\u043E\u0442\u044B\u0435 \u043C\u0435\u0448\u043A\u0438
      \u0438 \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0430\u044F \u0435\u0434\u0430.
      \u0421\u043B\u0435\u0434\u044B \u0432\u043E\u0440\u043E\u0432 \u0432\u0435\u0434\u0443\u0442
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0443. \u0427\u0430\u0441\u0442\u044C
      \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u0443\u0436\u0435 \u043D\u0435
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449461
    m_Localized: "\u0412\u044B\u0441\u043B\u0435\u0434\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449462
    m_Localized: "\u0421\u043C\u0438\u0440\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449463
    m_Localized: "\u041F\u043E\u0436\u0430\u0440 \u0433\u0440\u0443\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449464
    m_Localized: "\u041F\u043B\u0430\u043C\u044F \u0432\u0441\u043F\u044B\u0445\u0438\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0433\u0440\u0443\u0437\u043E\u0432\u043E\u0439 \u043F\u043E\u0432\u043E\u0437\u043A\u0435
      \u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u043D\u043E\u0447\u043D\u043E\u0433\u043E
      \u043B\u0430\u0433\u0435\u0440\u044F. \u0428\u0451\u043B\u043A \u0438 \u0441\u043F\u0435\u0446\u0438\u0438
      \u0433\u043E\u0440\u044F\u0442, \u0435\u0434\u043A\u0438\u0439 \u0434\u044B\u043C
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u0432 \u043D\u0435\u0431\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449465
    m_Localized: "\u0422\u0443\u0448\u0438\u0442\u044C \u043E\u0433\u043E\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449466
    m_Localized: "\u0421\u043F\u0430\u0441\u0442\u0438 \u0446\u0435\u043D\u043D\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449467
    m_Localized: "\u041E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449468
    m_Localized: "\u0416\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u043F\u0430\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449469
    m_Localized: "\u0412\u044C\u044E\u0447\u043D\u043E\u0435 \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435
      \u0440\u0443\u0445\u043D\u0443\u043B\u043E \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443
      \u0438 \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432\u0441\u0442\u0430\u0432\u0430\u0442\u044C. \u0422\u044F\u0436\u0451\u043B\u044B\u0439
      \u0433\u0440\u0443\u0437 \u043D\u0443\u0436\u043D\u043E \u043A\u0443\u0434\u0430-\u0442\u043E
      \u0434\u0435\u0442\u044C, \u0430 \u043F\u0443\u0442\u044C \u0435\u0449\u0451
      \u0434\u0430\u043B\u0451\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449470
    m_Localized: "\u041B\u0435\u0447\u0438\u0442\u044C \u0438 \u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449471
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0437\u0430\u043C\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 651148091449472
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643648
    m_Localized: "\u0417\u0430\u0441\u0430\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643649
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u043A\u0440\u0443\u0436\u0451\u043D
      \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u043C\u0438 \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u043C\u0438
      \u0432 \u0443\u0437\u043A\u043E\u0439 \u0434\u043E\u043B\u0438\u043D\u0435.
      \u041F\u0443\u0442\u0438 \u043E\u0442\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F
      \u043D\u0435\u0442, \u043D\u0430\u043F\u0440\u044F\u0436\u0451\u043D\u043D\u043E\u0435
      \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0446\u044B \u0432\u044B\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044E\u0442
      \u043E\u0431\u043E\u0440\u043E\u043D\u0443 \u0438\u0437 \u043F\u043E\u0432\u043E\u0437\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643650
    m_Localized: "\u041F\u0440\u043E\u0440\u044B\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643651
    m_Localized: "\u0421\u0434\u0430\u0442\u044C \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643652
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643653
    m_Localized: "\u041D\u0435\u0445\u0432\u0430\u0442\u043A\u0430 \u0432\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643654
    m_Localized: "\u0411\u0443\u0440\u0434\u044E\u043A\u0438 \u043F\u0443\u0441\u0442\u044B,
      \u0433\u0443\u0431\u044B \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u043B\u0438\u0441\u044C.
      \u0411\u0435\u0437\u0436\u0430\u043B\u043E\u0441\u0442\u043D\u043E\u0435 \u0441\u043E\u043B\u043D\u0446\u0435
      \u043F\u0435\u0447\u0451\u0442, \u0430 \u0432\u043E\u043A\u0440\u0443\u0433
      \u2014 \u043D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430
      \u0432\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643655
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u0432\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643656
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0443 \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643657
    m_Localized: "\u042D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C \u0432\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643658
    m_Localized: "\u0412\u0441\u043F\u044B\u0448\u043A\u0430 \u0431\u043E\u043B\u0435\u0437\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643659
    m_Localized: "\u041B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0430 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F
      \u043F\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443. \u0411\u043E\u043B\u044C\u043D\u044B\u0435
      \u043B\u0435\u0436\u0430\u0442 \u0432 \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u0445,
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u044E\u0442
      \u043B\u0438\u0446\u0430 \u0442\u043A\u0430\u043D\u044C\u044E \u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643660
    m_Localized: "\u041A\u0430\u0440\u0430\u043D\u0442\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643661
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u043B\u0435\u043A\u0430\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643662
    m_Localized: "\u0418\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643663
    m_Localized: "\u041E\u0442\u0447\u0430\u044F\u043D\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643664
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043D\u0430 \u0433\u0440\u0430\u043D\u0438.
      \u041F\u0440\u0438\u043F\u0430\u0441\u044B \u0442\u0430\u044E\u0442, \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u043D\u0430\u0440\u0430\u0441\u0442\u0430\u0435\u0442, \u0438 \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0440\u0430\u0436\u0434\u0435\u0431\u043D\u0430\u044F
      \u0437\u0435\u043C\u043B\u044F. \u041F\u0440\u0438\u0448\u043B\u043E \u0432\u0440\u0435\u043C\u044F
      \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u0440\u0435\u0448\u0435\u043D\u0438\u0435,
      \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0437\u0430\u0432\u0438\u0441\u0438\u0442
      \u0432\u0441\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643665
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643666
    m_Localized: "\u0414\u0430\u0442\u044C \u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643667
    m_Localized: "\u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643668
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0440\u0443\u0431\u0435\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643669
    m_Localized: "\u0412\u0441\u0451 \u0440\u0443\u0448\u0438\u0442\u0441\u044F.
      \u0412\u0440\u0430\u0433\u0438 \u043D\u0430\u0441\u0442\u0443\u043F\u0430\u044E\u0442,
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C,
      \u0441\u0438\u043B\u044B \u043D\u0430 \u0438\u0441\u0445\u043E\u0434\u0435.
      \u042D\u0442\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0448\u0430\u043D\u0441
      \u2014 \u0432\u044B\u0441\u0442\u043E\u044F\u0442\u044C \u0438\u043B\u0438
      \u043F\u043E\u0433\u0438\u0431\u043D\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643670
    m_Localized: "\u0421\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643671
    m_Localized: "\u0421\u0434\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643672
    m_Localized: "\u0411\u0435\u0436\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643673
    m_Localized: "\u042F\u0440\u043E\u0441\u0442\u043D\u044B\u0439 \u0431\u043E\u0439
      \u0432 \u043F\u0435\u0441\u043A\u0430\u0445. \u0411\u0430\u043D\u0434\u0438\u0442\u044B
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643674
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u044B\u0440\u0432\u0430\u043B\u0441\u044F
      \u0438\u0437 \u0437\u0430\u0441\u0430\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643675
    m_Localized: "\u041E\u0442\u043A\u0443\u043F \u043F\u0440\u0438\u043D\u044F\u0442
      \u2014 \u0431\u0430\u043D\u0434\u0438\u0442\u044B \u0437\u0430\u0431\u0440\u0430\u043B\u0438
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E \u0438 \u0441\u043A\u0440\u044B\u043B\u0438\u0441\u044C
      \u0437\u0430 \u0434\u044E\u043D\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643676
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0443\u043A\u0440\u044B\u043B\u0441\u044F
      \u0437\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u043C\u0438 \u0438
      \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u043B \u0431\u0443\u0440\u044E.
      \u041F\u0435\u0441\u043E\u043A \u0437\u0430\u0431\u0438\u043B \u0432\u0441\u0451"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643677
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0431\u0438\u043B\u0441\u044F
      \u0441\u043A\u0432\u043E\u0437\u044C \u0441\u0442\u0435\u043D\u0443 \u043F\u0435\u0441\u043A\u0430.
      \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u044E\u043A\u043E\u0432
      \u0441\u043E\u0440\u0432\u0430\u043B\u043E \u0432\u0435\u0442\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643678
    m_Localized: "\u041E\u0430\u0437\u0438\u0441 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u043C \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0435\u043C
      \u2014 \u0447\u0438\u0441\u0442\u0430\u044F \u0432\u043E\u0434\u0430 \u0438
      \u0442\u0435\u043D\u044C \u043F\u0430\u043B\u044C\u043C. \u0421\u0440\u0435\u0434\u0438
      \u043A\u0430\u043C\u043D\u0435\u0439 \u043D\u0430\u0448\u043B\u0438\u0441\u044C
      \u0437\u0430\u0431\u044B\u0442\u044B\u0435 \u0432\u0435\u0449\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643679
    m_Localized: "\u0412\u0441\u0435 \u0431\u0443\u0440\u0434\u044E\u043A\u0438 \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u044B
      \u0434\u043E \u043A\u0440\u0430\u0451\u0432. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043D\u0430\u043F\u0438\u043B\u0438\u0441\u044C \u0432\u0434\u043E\u0432\u043E\u043B\u044C
      \u2014 \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C
      \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643680
    m_Localized: "\u0421\u0442\u0440\u043E\u0433\u0430\u044F \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u044F
      \u0432\u043E\u0434\u044B. \u041B\u044E\u0434\u0438 \u0441\u0442\u0440\u0430\u0434\u0430\u044E\u0442
      \u043E\u0442 \u0436\u0430\u0436\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643681
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u0438 \u043D\u0430\u0448\u043B\u0438
      \u0441\u043A\u0440\u044B\u0442\u044B\u0439 \u0440\u043E\u0434\u043D\u0438\u043A
      \u0441\u0440\u0435\u0434\u0438 \u0441\u043A\u0430\u043B. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0441\u043F\u0430\u0441\u0451\u043D \u043E\u0442 \u043E\u0431\u0435\u0437\u0432\u043E\u0436\u0438\u0432\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643682
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0432\u044B\u0432\u0435\u043B
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043A \u043E\u0430\u0437\u0438\u0441\u0443
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C \u043F\u0443\u0442\u0451\u043C.
      \u0415\u0433\u043E \u0437\u043D\u0430\u043D\u0438\u0435 \u043F\u0443\u0441\u0442\u044B\u043D\u0438
      \u0431\u0435\u0441\u0446\u0435\u043D\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643683
    m_Localized: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643684
    m_Localized: "\u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u0440\u0432\u0430\u043D\u0443\u043B\u0438
      \u0438\u0437\u043E \u0432\u0441\u0435\u0445 \u0441\u0438\u043B \u2014 \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0432\u044B\u0441\u043A\u043E\u0447\u0438\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643685
    m_Localized: "\u0413\u0440\u0443\u0437 \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u043B\u0438
      \u0432\u0440\u0443\u0447\u043D\u0443\u044E \u0432 \u043E\u0431\u0445\u043E\u0434.
      \u041F\u0443\u0441\u0442\u0443\u044E \u043F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0432\u044B\u0442\u0430\u0449\u0438\u0442\u044C \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
      \u043F\u0440\u043E\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643686
    m_Localized: "\u041A\u043E\u043B\u0435\u0441\u043E \u043E\u0442\u043A\u043E\u043F\u0430\u043D\u043E
      \u0438 \u0443\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u043E. \u041D\u0430\u0434\u0451\u0436\u043D\u0430\u044F
      \u043F\u043E\u0447\u0438\u043D\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643687
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u0430\u044F \u043F\u043E\u0447\u0438\u043D\u043A\u0430
      \u043D\u0430 \u0441\u043A\u043E\u0440\u0443\u044E \u0440\u0443\u043A\u0443.
      \u041A\u043E\u043B\u0435\u0441\u043E \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643688
    m_Localized: "\u0427\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430 \u0441\u043D\u044F\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643689
    m_Localized: "\u041A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0438 \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0447\u0435\u0441\u0442\u043D\u044B\u043C\u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430\u043C\u0438.
      \u0423\u0434\u0430\u043B\u043E\u0441\u044C \u043E\u0431\u043C\u0435\u043D\u044F\u0442\u044C
      \u0442\u043E\u0432\u0430\u0440\u044B \u043F\u043E \u0432\u044B\u0433\u043E\u0434\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643690
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u0435\u0436\u043B\u0438\u0432\u043E
      \u043F\u0440\u043E\u0448\u0451\u043B \u043C\u0438\u043C\u043E \u0441\u0442\u043E\u044F\u043D\u043A\u0438.
      \u041A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0438 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B\u0438
      \u0435\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643691
    m_Localized: "\u041F\u043E\u0434\u0430\u0440\u043E\u043A \u0448\u0451\u043B\u043A\u0430
      \u0440\u0430\u0441\u0442\u0440\u043E\u0433\u0430\u043B \u0432\u043E\u0436\u0434\u044F.
      \u0412 \u043E\u0442\u0432\u0435\u0442 \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0438
      \u043F\u043E\u0434\u0435\u043B\u0438\u043B\u0438\u0441\u044C \u0432\u043E\u0434\u043E\u0439
      \u0438 \u0441\u043E\u0432\u0435\u0442\u0430\u043C\u0438 \u043E \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643692
    m_Localized: "\u0412 \u0433\u043B\u0443\u0431\u0438\u043D\u0435 \u0440\u0443\u0438\u043D
      \u043D\u0430\u0439\u0434\u0435\u043D\u044B \u0434\u0440\u0435\u0432\u043D\u0438\u0435
      \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u044B. \u0426\u0435\u043D\u043D\u0430\u044F
      \u043D\u0430\u0445\u043E\u0434\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643693
    m_Localized: "\u0421\u043D\u0430\u0440\u0443\u0436\u0438 \u0441\u043E\u0431\u0440\u0430\u043D\u043E
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u044B\u0445
