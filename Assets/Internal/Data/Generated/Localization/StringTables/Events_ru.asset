  - m_Id: 651148095643725
    m_Localized: "\u041F\u043E\u0434\u043B\u043E\u0436\u0438\u043B\u0438 \u0432\u0435\u0442\u043A\u0438
      \u0438 \u0434\u043E\u0441\u043A\u0438 \u043F\u043E\u0434 \u043A\u043E\u043B\u0451\u0441\u0430.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0430 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u0432\u044B\u0431\u0440\u0430\u043B\u0430\u0441\u044C \u0438\u0437 \u0433\u0440\u044F\u0437\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643726
    m_Localized: "\u0413\u0440\u0443\u0437 \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u043B\u0438
      \u043D\u0430 \u0441\u0443\u0445\u043E\u0435 \u043C\u0435\u0441\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643727
    m_Localized: "\u041F\u043E\u043B\u043D\u044B\u0435 \u043C\u0435\u0448\u043A\u0438
      \u0446\u0435\u043B\u0435\u0431\u043D\u044B\u0445 \u0442\u0440\u0430\u0432 \u0441\u043E\u0431\u0440\u0430\u043D\u044B
      \u043D\u0430 \u043F\u043E\u043B\u044F\u043D\u0435. \u041E\u043D\u0438 \u043F\u0440\u0438\u0433\u043E\u0434\u044F\u0442\u0441\u044F
      \u0432 \u0434\u043E\u0440\u043E\u0433\u0435 \u0438 \u043D\u0430 \u0440\u044B\u043D\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643728
    m_Localized: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u0443\u0447\u043A\u043E\u0432
      \u0440\u0435\u0434\u043A\u0438\u0445 \u0442\u0440\u0430\u0432 \u0441\u043E\u0440\u0432\u0430\u043D\u043E
      \u043D\u0430 \u0445\u043E\u0434\u0443. \u041D\u0435\u043C\u043D\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643729
    m_Localized: "\u0412 \u0433\u043B\u0443\u0431\u0438\u043D\u0435 \u0445\u0440\u0430\u043C\u0430
      \u043D\u0430\u0439\u0434\u0435\u043D\u044B \u0441\u0442\u0430\u0440\u0438\u043D\u043D\u044B\u0435
      \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0438. \u041C\u0435\u0441\u0442\u043E
      \u0434\u044B\u0448\u0438\u0442 \u0434\u0440\u0435\u0432\u043D\u0435\u0439 \u0442\u0430\u0439\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643730
    m_Localized: "\u0423 \u0432\u0445\u043E\u0434\u0430 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u044B
      \u043C\u043E\u043D\u0435\u0442\u044B \u0438 \u043E\u0441\u043A\u043E\u043B\u043A\u0438
      \u043A\u0435\u0440\u0430\u043C\u0438\u043A\u0438. \u0421\u043A\u0440\u043E\u043C\u043D\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643731
    m_Localized: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u0439 \u043E\u0441\u043C\u043E\u0442\u0440
      \u0445\u0440\u0430\u043C\u0430 \u0432\u044B\u044F\u0432\u0438\u043B \u0442\u0430\u0439\u043D\u0438\u043A
      \u0441 \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044F\u043C\u0438. \u0423\u0434\u0430\u0447\u0430
      \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0430\u0441\u044C \u0442\u0435\u0440\u043F\u0435\u043B\u0438\u0432\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643732
    m_Localized: "\u041B\u0435\u0441\u043E\u0440\u0443\u0431 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B
      \u043E \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0439 \u0442\u0440\u043E\u043F\u0435
      \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0449\u0443 \u0438 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u043B
      \u043E \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u0445 \u0432\u043F\u0435\u0440\u0435\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643733
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043A\u0438\u0432\u043D\u0443\u043B
      \u043B\u0435\u0441\u043E\u0440\u0443\u0431\u0443 \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B
