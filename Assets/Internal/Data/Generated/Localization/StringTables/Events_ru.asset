  - m_Id: 651148099837981
    m_Localized: "\u0422\u043E\u0440\u0433 \u0441\u043E \u0441\u0442\u0430\u0440\u0438\u043A\u043E\u043C
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435\u043C.
      \u041E\u043D \u0441\u0431\u0440\u043E\u0441\u0438\u043B \u0446\u0435\u043D\u0443,
      \u043E\u0446\u0435\u043D\u0438\u0432 \u043E\u043F\u044B\u0442\u043D\u043E\u0433\u043E
      \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044F. \u0428\u0430\u0444\u0440\u0430\u043D
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u043C:
      \u043D\u0438\u0442\u0438 \u0434\u043B\u0438\u043D\u043D\u044B\u0435, \u0446\u0432\u0435\u0442
      \u0433\u0443\u0441\u0442\u043E-\u043A\u0440\u0430\u0441\u043D\u044B\u0439.
      \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u0433\u043E\u0440\u043E\u0434\u0435
      \u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0434\u0430\u0442\u044C
      \u0432\u0442\u0440\u043E\u0435 \u0434\u043E\u0440\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837982
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435. \u0421\u0442\u0430\u0440\u0438\u043A
      \u043F\u043E\u0436\u0430\u043B \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438
      \u043F\u043E\u0431\u0440\u0451\u043B \u0441\u0432\u043E\u0435\u0439 \u0434\u043E\u0440\u043E\u0433\u043E\u0439.
      \u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u0443\u043F\u0443\u0449\u0435\u043D\u043D\u0430\u044F
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C. \u0410
      \u043C\u043E\u0436\u0435\u0442, \u0438\u0437\u0431\u0435\u0436\u0430\u043B\u0438
      \u043E\u0431\u043C\u0430\u043D\u0430. \u041A\u0442\u043E \u0437\u043D\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837983
    m_Localized: "\u0428\u0451\u043B\u043A \u043F\u0440\u043E\u0434\u0430\u043D \u0441
      \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u043D\u0430\u0446\u0435\u043D\u043A\u043E\u0439.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0437\u043D\u0430\u0435\u0442
      \u0441\u0432\u043E\u0438\u0445 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837984
    m_Localized: "\u041F\u0443\u0442\u043D\u0438\u043A \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043B\u0441\u044F
      \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443. \u0412 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u043E\u043D \u043F\u043E\u0434\u0435\u043B\u0438\u043B\u0441\u044F \u0437\u043D\u0430\u043D\u0438\u044F\u043C\u0438
      \u043E \u0434\u043E\u0440\u043E\u0433\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837985
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0448\u0451\u043B
      \u043C\u0438\u043C\u043E. \u041F\u0443\u0442\u043D\u0438\u043A \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u043E\u0434\u0438\u043D \u0443 \u043E\u0431\u043E\u0447\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837986
    m_Localized: "\u041F\u0443\u0442\u043D\u0438\u043A\u0430 \u043F\u043E\u0434\u043B\u0435\u0447\u0438\u043B\u0438
      \u0438 \u043D\u0430\u043A\u043E\u0440\u043C\u0438\u043B\u0438. \u041E\u043D
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043A\u0443\u043F\u0446\u043E\u043C
      \u0438 \u0449\u0435\u0434\u0440\u043E \u043E\u0442\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837987
    m_Localized: "\u0411\u0435\u0436\u0435\u043D\u0446\u044B \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u044B
      \u0437\u0430 \u0435\u0434\u0443. \u041E\u043D\u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0438
      \u043E\u0431 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044F\u0445 \u043D\u0430
      \u0434\u043E\u0440\u043E\u0433\u0435 \u0432\u043F\u0435\u0440\u0435\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837988
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0448\u0451\u043B
      \u043C\u0438\u043C\u043E \u0431\u0435\u0436\u0435\u043D\u0446\u0435\u0432.
      \u0418\u0445 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F
      \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043D\u0435\u0443\u0441\u043B\u044B\u0448\u0430\u043D\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837989
    m_Localized: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0431\u0435\u0436\u0435\u043D\u0446\u0435\u0432
      \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043B\u0438\u0441\u044C
      \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443. \u041B\u0438\u0448\u043D\u0438\u0435
      \u0440\u0443\u043A\u0438 \u0432 \u043F\u0443\u0442\u0438 \u043D\u0435 \u043F\u043E\u043C\u0435\u0448\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837990
    m_Localized: "\u0423\u0447\u0451\u043D\u044B\u0439 \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043B\u0441\u044F
      \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443. \u0415\u0433\u043E
      \u0437\u043D\u0430\u043D\u0438\u044F \u044F\u0437\u044B\u043A\u043E\u0432 \u0438
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445 \u043F\u0443\u0442\u0435\u0439
      \u0431\u0435\u0441\u0446\u0435\u043D\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837991
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0442\u043A\u0430\u0437\u0430\u043B
      \u0443\u0447\u0451\u043D\u043E\u043C\u0443 \u0438 \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435. \u041B\u0438\u0448\u043D\u0438\u0439
      \u0440\u043E\u0442 \u2014 \u043B\u0438\u0448\u043D\u0438\u0435 \u0440\u0430\u0441\u0445\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837992
    m_Localized: "\u0411\u0435\u0441\u0435\u0434\u0430 \u0441 \u0443\u0447\u0451\u043D\u044B\u043C
      \u043E\u0442\u043A\u0440\u044B\u043B\u0430 \u043D\u043E\u0432\u044B\u0435 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B. \u0417\u043D\u0430\u043D\u0438\u044F
      \u0434\u043E\u0440\u043E\u0436\u0435 \u0437\u043E\u043B\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837993
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442 \u043F\u043E\u0435\u043B \u0438
      \u043E\u043A\u0440\u0435\u043F. \u0412 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u043E\u043D \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B \u043E
      \u0432\u043E\u0435\u043D\u043D\u044B\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F\u0445
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837994
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0448\u0451\u043B
      \u043C\u0438\u043C\u043E \u0440\u0430\u043D\u0435\u043D\u043E\u0433\u043E.
      \u0412\u043E\u0439\u043D\u0430 \u2014 \u043D\u0435 \u0438\u0445 \u0434\u0435\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837995
    m_Localized: "\u0420\u0430\u043D\u044B \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837996
    m_Localized: "\u0414\u0432\u043E\u0435 \u0441\u0443\u0442\u043E\u043A \u0431\u0435\u0437
      \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u043E\u0433\u043E \u043E\u0442\u0434\u044B\u0445\u0430,
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435 \u043F\u0440\u0438\u0432\u0430\u043B\u044B,
      \u043D\u043E\u0447\u043D\u044B\u0435 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044B.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0443 \u0442\u0440\u044F\u0441\u043B\u043E
      \u043D\u0430 \u0443\u0445\u0430\u0431\u0430\u0445, \u043B\u044E\u0434\u0438
      \u0435\u0434\u0432\u0430 \u0434\u0435\u0440\u0436\u0430\u043B\u0438\u0441\u044C
      \u043D\u0430 \u043D\u043E\u0433\u0430\u0445. \u041D\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043E\u0431\u043E\u0433\u043D\u0430\u043B \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u043E\u0432
      \u0438 \u043F\u0440\u0438\u0431\u044B\u043B \u0432 \u0433\u043E\u0440\u043E\u0434
      \u043F\u0435\u0440\u0432\u044B\u043C. \u0426\u0435\u043D\u044B \u043F\u043E\u043A\u0430
      \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837997
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B \u0437\u0430\u043D\u044F\u043B\u0438
      \u0434\u0432\u0430 \u0447\u0430\u0441\u0430. \u0418\u0442\u043E\u0433: \u0432\u044B
      \u0442\u043E\u0440\u0433\u0443\u0435\u0442\u0435 \u0432 \u044E\u0436\u043D\u043E\u043C
      \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0435, \u043E\u043D\u0438 \u0432
      \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u043C. \u041D\u0438 \u043E\u0434\u0438\u043D
      \u043D\u0435 \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u0446\u0435\u043D\u0443
      \u0434\u0440\u0443\u0433\u043E\u043C\u0443. \u041A\u0443\u043F\u0435\u0446
      \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u043E\u0432 \u043F\u043E\u0436\u0430\u043B
      \u0440\u0443\u043A\u0443: \u0441\u0434\u0435\u043B\u043A\u0430 \u0435\u0441\u0442\u044C
      \u0441\u0434\u0435\u043B\u043A\u0430. \u041E\u0431\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837998
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C
      \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0438\u0434\u0451\u0442 \u0441\u0432\u043E\u0438\u043C
      \u043F\u0443\u0442\u0451\u043C \u2014 \u0431\u0435\u0437 \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837999
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438 \u0448\u043B\u0438
      \u0441 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u043C \u0447\u0435\u0442\u044B\u0440\u0435
      \u0434\u043D\u044F. \u0412\u0435\u0447\u0435\u0440\u0430\u043C\u0438 \u043C\u043E\u043D\u0430\u0445
      \u0443\u0447\u0438\u043B \u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442\u0441\u043A\u0438\u043C
      \u043C\u0430\u043D\u0442\u0440\u0430\u043C, \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u043A
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B \u043E \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0437\u0435\u043C\u043B\u044F\u0445, \u0436\u0440\u0435\u0446 \u043F\u0435\u043B
      \u0433\u0438\u043C\u043D\u044B \u043E\u0433\u043D\u044E. \u041B\u044E\u0434\u0438
      \u0441\u043B\u0443\u0448\u0430\u043B\u0438, \u0437\u0430\u0442\u0430\u0438\u0432
      \u0434\u044B\u0445\u0430\u043D\u0438\u0435. \u041A\u043E\u0433\u0434\u0430
      \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438 \u0443\u0448\u043B\u0438,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0441\u0442\u0430\u043B \u0447\u0443\u0442\u044C
      \u043C\u0443\u0434\u0440\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838000
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u0438\u0437 \u0442\u0440\u043E\u0438\u0445
      \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0438\u043B \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u043E-\u0441\u0432\u043E\u0435\u043C\u0443: \u043C\u043E\u043D\u0430\u0445
      \u043C\u043E\u043B\u0438\u0442\u0432\u043E\u0439, \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u0438\u043A
      \u043A\u0440\u0435\u0441\u0442\u043D\u044B\u043C \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0435\u043C,
      \u0436\u0440\u0435\u0446 \u0449\u0435\u043F\u043E\u0442\u043A\u043E\u0439 \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u043E\u0433\u043E
      \u043F\u0435\u043F\u043B\u0430. \u0422\u0440\u0438 \u0432\u0435\u0440\u044B,
      \u043E\u0434\u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0430. \u041B\u044E\u0434\u0438
      \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438
      \u0441\u0435\u0431\u044F \u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838001
    m_Localized: "\u0422\u043E\u0432\u0430\u0440 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0446\u0430
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0440\u0435\u0434\u043A\u0438\u043C
      \u0438 \u0446\u0435\u043D\u043D\u044B\u043C. \u0421\u0442\u0440\u0430\u043D\u043D\u0430\u044F
      \u0441\u0434\u0435\u043B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838002
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0431\u043E\u0448\u0451\u043B
      \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0446\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439.
      \u041D\u0435 \u0432\u0441\u044F\u043A\u0430\u044F \u0432\u0441\u0442\u0440\u0435\u0447\u0430
      \u0441\u0443\u043B\u0438\u0442 \u0434\u043E\u0431\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838003
    m_Localized: "\u041D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0435\u0446 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0431\u044B\u0432\u0448\u0438\u043C \u043A\u0443\u043F\u0446\u043E\u043C.
      \u041E\u043D \u043F\u043E\u0434\u0435\u043B\u0438\u043B\u0441\u044F \u0442\u0430\u0439\u043D\u044B\u043C\u0438
      \u0437\u043D\u0430\u043D\u0438\u044F\u043C\u0438 \u043E \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445
      \u043F\u0443\u0442\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838004
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F,
      \u043B\u044E\u0434\u0438 \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043B\u0438\u0441\u044C
      \u043A \u043F\u0440\u0430\u0437\u0434\u043D\u043E\u0432\u0430\u043D\u0438\u044E.
      \u0416\u0435\u043D\u0438\u0445, \u0448\u0438\u0440\u043E\u043A\u043E \u0443\u043B\u044B\u0431\u0430\u044F\u0441\u044C,
      \u043D\u0430\u0441\u0442\u043E\u044F\u043B, \u0447\u0442\u043E\u0431\u044B
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u043E\u0442\u0432\u0435\u0434\u0430\u043B\u0438
      \u0441\u0432\u0430\u0434\u0435\u0431\u043D\u043E\u0433\u043E \u043F\u043B\u043E\u0432\u0430
      \u0438 \u043B\u0435\u043F\u0451\u0448\u0435\u043A. \u041C\u0443\u0437\u044B\u043A\u0430,
      \u0441\u043C\u0435\u0445, \u043D\u0430 \u0447\u0430\u0441 \u0437\u0430\u0431\u044B\u043B\u0430\u0441\u044C
      \u0434\u043E\u0440\u043E\u0436\u043D\u0430\u044F \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C.
      \u0423\u0435\u0437\u0436\u0430\u043B\u0438 \u0441 \u043F\u043E\u043B\u043D\u044B\u043C\u0438
      \u0436\u0438\u0432\u043E\u0442\u0430\u043C\u0438 \u0438 \u0445\u043E\u0440\u043E\u0448\u0438\u043C
      \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838005
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043E\u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u043E\u0432\u0430\u043B
      \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0438\u044E, \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044F\u0441\u044C.
      \u0416\u0435\u043D\u0438\u0445 \u0431\u0440\u043E\u0441\u0438\u043B \u0432
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443 \u0433\u043E\u0440\u0441\u0442\u044C
      \u0437\u0430\u0441\u0430\u0445\u0430\u0440\u0435\u043D\u043D\u044B\u0445 \u043E\u0440\u0435\u0445\u043E\u0432
      - \u043D\u0430 \u0441\u0447\u0430\u0441\u0442\u044C\u0435. \u041B\u044E\u0434\u0438
      \u0436\u0435\u0432\u0430\u043B\u0438 \u0441\u043B\u0430\u0434\u043E\u0441\u0442\u0438,
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u044F\u0441\u044C
      \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u0434\u0430\u0432\u043D\u043E
      \u043D\u0435 \u0431\u044B\u043B\u0438 \u0434\u043E\u043C\u0430. \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043F\u043E\u0434\u043D\u044F\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838006
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u043F\u0440\u0438\u043D\u044F\u0442
      \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D. \u0415\u0433\u043E \u043C\u0435\u0447
      \u0438 \u043E\u043F\u044B\u0442 \u0432\u0441\u0435\u043B\u044F\u044E\u0442
      \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838007
    m_Localized: "\u0412\u043E\u0438\u043D \u043F\u043E\u0436\u0430\u043B \u043F\u043B\u0435\u0447\u0430\u043C\u0438
      \u0438 \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0443 \u0434\u043E\u0440\u043E\u0433\u0438.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0438\u0434\u0451\u0442 \u0431\u0435\u0437
      \u043E\u0445\u0440\u0430\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838008
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043B\u0441\u044F
      \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443. \u0415\u0433\u043E
      \u0437\u043D\u0430\u043D\u0438\u0435 \u044F\u0437\u044B\u043A\u043E\u0432 \u043F\u043E\u043C\u043E\u0436\u0435\u0442
      \u0432 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838009
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0442\u043A\u0430\u0437\u0430\u043B
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u0443. \u042F\u0437\u044B\u043A\u043E\u0432\u043E\u0439
      \u0431\u0430\u0440\u044C\u0435\u0440 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u0432\u0430\u0442\u044C \u0436\u0435\u0441\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838010
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0432\u0441\u0442\u0443\u043F\u0438\u043B
      \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D. \u0415\u0433\u043E \u0437\u043D\u0430\u043D\u0438\u0435
      \u0442\u0440\u043E\u043F \u0438 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u043E\u0432
      \u2014 \u043D\u0430 \u0432\u0435\u0441 \u0437\u043E\u043B\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838011
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043E\u0442 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430 \u0438
      \u043F\u043E\u0448\u0451\u043B \u043F\u043E \u043A\u0430\u0440\u0442\u0435.
      \u041D\u0430\u0434\u0435\u044E\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838012
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043B\u0441\u044F
      \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443. \u0415\u0433\u043E
      \u0442\u0440\u0430\u0432\u044B \u0438 \u0437\u043D\u0430\u043D\u0438\u044F
      \u043C\u043E\u0433\u0443\u0442 \u0441\u043F\u0430\u0441\u0442\u0438 \u0436\u0438\u0437\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838013
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043E\u0435\u0445\u0430\u043B
      \u0434\u0430\u043B\u044C\u0448\u0435 \u0431\u0435\u0437 \u043B\u0435\u043A\u0430\u0440\u044F.
      \u0412 \u0441\u043B\u0443\u0447\u0430\u0435 \u0431\u043E\u043B\u0435\u0437\u043D\u0438
      \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C\u0441\u044F
      \u0441\u0430\u043C\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838014
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446-\u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A
      \u043F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043B\u0441\u044F.
      \u0415\u0433\u043E \u0442\u043E\u0432\u0430\u0440\u044B \u0434\u043E\u043F\u043E\u043B\u043D\u044F\u044E\u0442
      \u0430\u0441\u0441\u043E\u0440\u0442\u0438\u043C\u0435\u043D\u0442 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838015
    m_Localized: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435
      \u043E\u0434\u0438\u043D. \u0415\u0433\u043E \u043F\u0443\u0442\u044C \u043E\u043F\u0430\u0441\u0435\u043D
      \u0431\u0435\u0437 \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838016
    m_Localized: "\u0423\u0434\u0430\u043B\u043E\u0441\u044C \u043D\u0430\u0439\u0442\u0438
      \u043F\u0440\u043E\u0434\u0430\u0432\u0446\u0430 \u0438 \u043A\u0443\u043F\u0438\u0442\u044C
      \u0435\u0434\u044B \u043F\u043E \u0437\u0430\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435. \u0413\u043E\u043B\u043E\u0434 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838017
    m_Localized: "\u0412\u044C\u044E\u0447\u043D\u043E\u0435 \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435
      \u0437\u0430\u0431\u0438\u0442\u043E \u043D\u0430 \u043C\u044F\u0441\u043E.
      \u041F\u043E\u0442\u0435\u0440\u044F \u0431\u043E\u043B\u0435\u0437\u043D\u0435\u043D\u043D\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838018
    m_Localized: "\u0421\u0442\u0440\u043E\u0433\u0438\u0439 \u0440\u0430\u0446\u0438\u043E\u043D:
