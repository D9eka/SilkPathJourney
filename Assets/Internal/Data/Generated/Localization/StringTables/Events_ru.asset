      m_Items: []
  - m_Id: 651148087255060
    m_Localized: "\u041A\u043B\u0443\u0431\u043E\u043A \u044F\u0434\u043E\u0432\u0438\u0442\u044B\u0445
      \u0437\u043C\u0435\u0439 \u0433\u0440\u0435\u0435\u0442\u0441\u044F \u043D\u0430
      \u043A\u0430\u043C\u043D\u044F\u0445 \u043F\u0440\u044F\u043C\u043E \u043F\u043E\u0441\u0440\u0435\u0434\u0438
      \u043B\u0435\u0441\u043D\u043E\u0439 \u0442\u0440\u043E\u043F\u044B. \u0418\u0445
      \u043F\u0451\u0441\u0442\u0440\u044B\u0435 \u0442\u0435\u043B\u0430 \u0431\u043B\u0435\u0441\u0442\u044F\u0442
      \u043D\u0430 \u0441\u043E\u043B\u043D\u0446\u0435 \u2014 \u043E\u0431\u044A\u0435\u0437\u0434
      \u0437\u0430\u0439\u043C\u0451\u0442 \u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
