  - m_Id: 651148087255098
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255099
    m_Localized: "\u0420\u0430\u0441\u0441\u044B\u043F\u0430\u0432\u0448\u0438\u0439\u0441\u044F
      \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255100
    m_Localized: "\u0422\u0440\u044F\u0441\u043A\u0430 \u043D\u0430 \u0443\u0445\u0430\u0431\u0430\u0445
      \u0441\u0442\u0435\u043F\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0438
      \u043E\u0441\u043B\u0430\u0431\u0438\u043B\u0430 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F.
      \u0422\u044E\u043A\u0438 \u0441 \u0442\u043E\u0432\u0430\u0440\u0430\u043C\u0438
      \u0441\u043F\u043E\u043B\u0437\u0430\u044E\u0442 \u0438 \u0433\u0440\u043E\u0437\u044F\u0442
      \u0443\u043F\u0430\u0441\u0442\u044C \u2014 \u043D\u0443\u0436\u043D\u043E
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255101
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u0442\u044C \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255102
    m_Localized: "\u0415\u0445\u0430\u0442\u044C \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255103
    m_Localized: "\u041F\u0443\u0442\u0435\u0432\u043E\u0439 \u043A\u0430\u043C\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255104
    m_Localized: "\u0414\u0440\u0435\u0432\u043D\u0438\u0439 \u0440\u0435\u0437\u043D\u043E\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C \u0441 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u043C\u0438
      \u043D\u0430\u0434\u043F\u0438\u0441\u044F\u043C\u0438 \u0441\u0442\u043E\u0438\u0442
      \u0443 \u043E\u0434\u0438\u043D\u043E\u043A\u043E\u0439 \u0441\u0442\u0435\u043F\u043D\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0438. \u0423 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F
      \u2014 \u0447\u0430\u0448\u0430 \u0434\u043B\u044F \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0439
      \u0438 \u0443\u0432\u044F\u0434\u0448\u0438\u0435 \u0446\u0432\u0435\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255105
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255106
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255107
    m_Localized: "\u041F\u0440\u0438\u0431\u0440\u0435\u0436\u043D\u044B\u0435 \u043F\u0438\u0440\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255108
    m_Localized: "\u0418\u0437-\u0437\u0430 \u043F\u0440\u0438\u0431\u0440\u0435\u0436\u043D\u044B\u0445
      \u0441\u043A\u0430\u043B \u0432\u044B\u0445\u043E\u0434\u044F\u0442 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0435
      \u0433\u043E\u043B\u043E\u0432\u043E\u0440\u0435\u0437\u044B. \u0412 \u0431\u0443\u0445\u0442\u0435
      \u043F\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0438\u0445
      \u0441\u0443\u0434\u0430 \u2014 \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0442\u044C
      \u043D\u0435\u043A\u0443\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255109
    m_Localized: "\u0421\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
