      m_Items: []
  - m_Id: 651148087255046
    m_Localized: "\u0421\u043A\u0432\u043E\u0437\u044C \u0437\u0430\u0432\u0435\u0441\u0443
      \u043B\u0438\u0430\u043D \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u0430\u044E\u0442
      \u0437\u0430\u043C\u0448\u0435\u043B\u044B\u0435 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0435
      \u0441\u0442\u0435\u043D\u044B \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u043E
      \u0445\u0440\u0430\u043C\u0430. \u0412\u043D\u0443\u0442\u0440\u0438 \u0442\u0435\u043C\u043D\u043E"
