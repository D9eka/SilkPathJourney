  - m_Id: 10424707470843904
    m_Localized: "\u041F\u043E\u0441\u0442 \u0446\u0437\u0435\u0434\u0443\u0448\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981248
    m_Localized: "\u0423 \u043E\u0431\u043E\u0447\u0438\u043D\u044B \u0442\u0440\u0430\u043A\u0442\u0430
      \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B \u0431\u0430\u043C\u0431\u0443\u043A\u043E\u0432\u044B\u0435
      \u0437\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u0438\u044F \u0438 \u0448\u0430\u0442\u0451\u0440
      \u0441 \u0442\u0430\u043D\u0441\u043A\u0438\u043C \u0437\u043D\u0430\u043C\u0435\u043D\u0435\u043C.
      \u0422\u0440\u043E\u0435 \u0441\u043E\u043B\u0434\u0430\u0442 \u0432 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0447\u0430\u0442\u044B\u0445
      \u0434\u043E\u0441\u043F\u0435\u0445\u0430\u0445 \u043F\u0440\u0435\u0433\u0440\u0430\u0436\u0434\u0430\u044E\u0442
      \u043F\u0443\u0442\u044C. \u041E\u0444\u0438\u0446\u0435\u0440 \u0441 \u043B\u0430\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
      \u0434\u043E\u0449\u0435\u0447\u043A\u043E\u0439 \u0432 \u0440\u0443\u043A\u0430\u0445
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0432\u043F\u0435\u0440\u0451\u0434
      \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043A
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443:\r\n\r\n<npc_speech lang=\"Chinese\">\u0421\u0442\u043E\u0439!
      \u041F\u0440\u0435\u0434\u044A\u044F\u0432\u0438 \u043F\u0443\u0442\u0435\u0432\u0443\u044E
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443 \u0438 \u043E\u043F\u0438\u0441\u044C
      \u0442\u043E\u0432\u0430\u0440\u043E\u0432. \u041F\u0440\u0438\u043A\u0430\u0437
      \u0446\u0437\u0435\u0434\u0443\u0448\u0438.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981249
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043F\u043E\u0448\u043B\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981250
    m_Localized: "\u0421\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0435 \u043C\u043E\u043D\u0435\u0442\u044B
      \u043F\u0435\u0440\u0435\u0448\u043B\u0438 \u0432 \u0440\u0443\u043A\u0438
      \u043E\u0444\u0438\u0446\u0435\u0440\u0430. \u041E\u043D \u0437\u0430\u043F\u0438\u0441\u0430\u043B
      \u0447\u0442\u043E-\u0442\u043E \u043D\u0430 \u0434\u043E\u0449\u0435\u0447\u043A\u0435
      \u0438 \u043A\u0438\u0432\u043D\u0443\u043B \u0441\u043E\u043B\u0434\u0430\u0442\u0430\u043C.
      \u0417\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u0438\u044F \u0443\u0431\u0440\u0430\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981251
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981252
    m_Localized: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0443\u0447\u0442\u0438\u0432\u044B\u0445
      \u0444\u0440\u0430\u0437 \u043D\u0430 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C
      \u0438 \u043A\u043E\u043C\u043F\u043B\u0438\u043C\u0435\u043D\u0442 \u0434\u043E\u0431\u043B\u0435\u0441\u0442\u0438
      \u0446\u0437\u0435\u0434\u0443\u0448\u0438 - \u043E\u0444\u0438\u0446\u0435\u0440
      \u0441\u043C\u044F\u0433\u0447\u0438\u043B\u0441\u044F. \u041F\u043E\u0448\u043B\u0438\u043D\u0430
      \u0441\u043D\u0438\u0436\u0435\u043D\u0430, \u0430 \u043D\u0430 \u0434\u043E\u0449\u0435\u0447\u043A\u0435
      \u043F\u043E\u044F\u0432\u0438\u043B\u0430\u0441\u044C \u043F\u043E\u043C\u0435\u0442\u043A\u0430
      \"\u0431\u043B\u0430\u0433\u043E\u043D\u0430\u0434\u0451\u0436\u043D\u044B\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\"."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981253
    m_Localized: "\u041E\u0444\u0438\u0446\u0435\u0440 \u043D\u0430\u0445\u043C\u0443\u0440\u0438\u043B\u0441\u044F
      \u043E\u0442 \u043D\u0435\u0443\u043C\u0435\u043B\u043E\u0439 \u043B\u0435\u0441\u0442\u0438.
      \u041F\u043E\u0448\u043B\u0438\u043D\u0430 \u0443\u0434\u0432\u043E\u0435\u043D\u0430,
      \u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043D
      \u0434\u043E \u0432\u0435\u0447\u0435\u0440\u0430 \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981254
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u043B\u044F\u0435\u0442
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981255
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0441 \u043E\u0444\u0438\u0446\u0435\u0440\u043E\u043C \u043D\u0430 \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u043E\u043C
      \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C: <npc_speech lang=\"Chinese\">\u0413\u043E\u0441\u043F\u043E\u0434\u0438\u043D
      \u043E\u0444\u0438\u0446\u0435\u0440, \u0432\u043E\u0442 \u043D\u0430\u0448\u0438
      \u0433\u0440\u0430\u043C\u043E\u0442\u044B \u0438 \u043F\u0435\u0447\u0430\u0442\u0438.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0441\u043B\u0435\u0434\u0443\u0435\u0442
      \u0441 \u0434\u043E\u0437\u0432\u043E\u043B\u0435\u043D\u0438\u044F.</npc_speech>
      \u0421\u043E\u043B\u0434\u0430\u0442\u044B \u0440\u0430\u0441\u0441\u0442\u0443\u043F\u0438\u043B\u0438\u0441\u044C,
      \u0430 \u043E\u0444\u0438\u0446\u0435\u0440 \u0432\u0440\u0443\u0447\u0438\u043B
      \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u0443\u044E \u0433\u0440\u0430\u043C\u043E\u0442\u0443
      - \u043E\u043D\u0430 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F
      \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u043F\u043E\u0441\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981256
    m_Localized: "\u0417\u0430\u0441\u0430\u0434\u0430 \u043B\u0443\u0442\u0447\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981257
    m_Localized: "\u0418\u0437 \u0437\u0430\u0440\u043E\u0441\u043B\u0435\u0439 \u0442\u0430\u043C\u0430\u0440\u0438\u0441\u043A\u0430
      \u0443 \u0441\u0443\u0445\u043E\u0433\u043E \u0440\u0443\u0441\u043B\u0430
      \u0441 \u043A\u0440\u0438\u043A\u0430\u043C\u0438 \u0432\u044B\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u044E\u0442
      \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0435 \u043B\u044E\u0434\u0438
      - \u043B\u0443\u0442\u0447\u0438, \u0441\u0442\u0435\u043F\u043D\u044B\u0435
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438, \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u044F\u044E\u0449\u0438\u0435
      \u0433\u0440\u0430\u0431\u0435\u0436\u043E\u043C \u043D\u0430 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0445
      \u0434\u043E\u0440\u043E\u0433\u0430\u0445. \u041E\u043D\u0438 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043E\u043B\u0443\u043A\u043E\u043B\u044C\u0446\u043E\u043C.
      \u0418\u0445 \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
      \u0440\u0430\u0437\u043C\u0430\u0445\u0438\u0432\u0430\u0435\u0442 \u043A\u0440\u0438\u0432\u043E\u0439
      \u0441\u0430\u0431\u043B\u0435\u0439, \u0430 \u0437\u0430 \u0441\u043F\u0438\u043D\u0430\u043C\u0438
      \u043C\u0435\u043B\u044C\u043A\u0430\u044E\u0442 \u0444\u0430\u043A\u0435\u043B\u044B.
      \u041F\u0430\u0445\u043D\u0435\u0442 \u0434\u044B\u043C\u043E\u043C \u0438
      \u0433\u043E\u0440\u044C\u043A\u0438\u043C \u0442\u0430\u043C\u0430\u0440\u0438\u0441\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981258
    m_Localized: "\u0417\u0430\u0449\u0438\u0449\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981259
    m_Localized: "\u0411\u043E\u0439 \u0431\u044B\u043B \u0436\u0451\u0441\u0442\u043A\u0438\u043C
      \u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C. \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438, \u0443\u0442\u0430\u0449\u0438\u0432
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u044E\u043A\u043E\u0432.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0430 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0430,
      \u043B\u044E\u0434\u0438 \u043D\u0430\u043F\u0443\u0433\u0430\u043D\u044B,
      \u043D\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0446\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981260
    m_Localized: "\u041E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981261
    m_Localized: "\u0413\u043E\u0440\u0441\u0442\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u0430
      \u043E\u0441\u0442\u0443\u0434\u0438\u043B\u0430 \u043F\u044B\u043B \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F.
      \u041E\u043D \u0443\u0445\u043C\u044B\u043B\u044C\u043D\u0443\u043B\u0441\u044F,
      \u0441\u043F\u0440\u044F\u0442\u0430\u043B \u043C\u043E\u043D\u0435\u0442\u044B
      \u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u0443 \u0445\u0430\u043B\u0430\u0442\u0430
      \u0438 \u0441\u0432\u0438\u0441\u0442\u043D\u0443\u043B \u0441\u0432\u043E\u0438\u043C.
      \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C
      \u0432 \u0437\u0430\u0440\u043E\u0441\u043B\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981262
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0432\u0441\u0442\u0430\u0451\u0442
      \u0432 \u0441\u0442\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981263
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0432\u044B\u0448\u0435\u043B
      \u0432\u043F\u0435\u0440\u0451\u0434 \u0441 \u043E\u0431\u043D\u0430\u0436\u0451\u043D\u043D\u044B\u043C
      \u043A\u043B\u0438\u043D\u043A\u043E\u043C \u0438 \u0432\u0441\u0442\u0430\u043B
      \u043C\u0435\u0436\u0434\u0443 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u043C
      \u0438 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0430\u043C\u0438.
      \u041F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C \u043E\u0446\u0435\u043D\u0438\u043B
      \u0432\u044B\u043F\u0440\u0430\u0432\u043A\u0443 \u0432\u043E\u0438\u043D\u0430
      \u0438 \u0441\u0431\u0430\u0432\u0438\u043B \u0442\u043E\u043D. \u0421\u043E\u0448\u043B\u0438\u0441\u044C
      \u043D\u0430 \u043C\u0430\u043B\u043E\u0439 \u0434\u0430\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981264
    m_Localized: "\u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u043A\u0443\u043F\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981265
    m_Localized: "\u0423 \u043E\u0431\u043E\u0447\u0438\u043D\u044B \u0434\u043E\u0440\u043E\u0433\u0438
      \u0440\u0430\u0441\u043A\u0438\u043D\u0443\u0442\u0430 \u0446\u0432\u0435\u0442\u043D\u0430\u044F
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0430\u044F \u043F\u0430\u043B\u0430\u0442\u043A\u0430.
      \u041F\u0435\u0440\u0435\u0434 \u043D\u0435\u0439 \u0440\u0430\u0437\u043B\u043E\u0436\u0435\u043D\u044B
      \u0442\u044E\u043A\u0438 \u0441 \u0442\u043A\u0430\u043D\u044F\u043C\u0438
      \u0438 \u0433\u043E\u0440\u0438\u0442 \u0436\u0430\u0440\u043E\u0432\u043D\u044F.
      \u041A\u0443\u043F\u0435\u0446 \u0432 \u0445\u0430\u043B\u0430\u0442\u0435
      \u0441 \u0437\u043E\u043B\u043E\u0442\u044B\u043C \u0448\u0438\u0442\u044C\u0451\u043C
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443,
      \u043F\u0440\u0438\u0436\u0438\u043C\u0430\u044F \u0440\u0443\u043A\u0443 \u043A
      \u0441\u0435\u0440\u0434\u0446\u0443:\r\n\r\n<npc_speech lang=\"Sogdian\">\u041F\u0440\u0438\u0432\u0435\u0442!
      \u042F \u043A\u0443\u043F\u0435\u0446 \u0438\u0437 \u0411\u0443\u0445\u0430\u0440\u044B.
      \u0423 \u043D\u0430\u0441 \u043F\u0430\u0440\u0447\u0430 - \u043B\u0443\u0447\u0448\u0435,
      \u0447\u0435\u043C \u043D\u0430 \u043B\u044E\u0431\u043E\u043C \u0431\u0430\u0437\u0430\u0440\u0435.
      \u041F\u0440\u043E\u0448\u0443, \u0432\u0437\u0433\u043B\u044F\u043D\u0438\u0442\u0435!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981266
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u043F\u0430\u0440\u0447\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981267
    m_Localized: "\u041F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0433\u043E
      \u043F\u043E\u043C\u043E\u0433\u043B\u043E \u0441\u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C
      \u043E\u0442\u043B\u0438\u0447\u043D\u0443\u044E \u0446\u0435\u043D\u0443.
      \u041F\u0430\u0440\u0447\u0430 \u0438\u0437 \u0411\u0443\u0445\u0430\u0440\u044B
      - \u0442\u043E\u0432\u0430\u0440, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043E\u0446\u0435\u043D\u044F\u0442 \u0432 \u043B\u044E\u0431\u043E\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435 \u043E\u0442 \u0427\u0430\u043D\u044A\u0430\u043D\u044F
      \u0434\u043E \u0414\u0430\u043C\u0430\u0441\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981268
    m_Localized: "\u0411\u0435\u0437 \u0437\u043D\u0430\u043D\u0438\u044F \u044F\u0437\u044B\u043A\u0430
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0436\u0435\u0441\u0442\u0430\u043C\u0438. \u041A\u0443\u043F\u0435\u0446
      \u0443\u043B\u044B\u0431\u0430\u043B\u0441\u044F \u0438 \u043A\u0438\u0432\u0430\u043B,
      \u043D\u043E \u0446\u0435\u043D\u0430 \u0432\u044B\u0448\u043B\u0430 \u0432\u044B\u0441\u043E\u043A\u043E\u0439.
      \u041F\u0430\u0440\u0447\u0430, \u0432\u043F\u0440\u043E\u0447\u0435\u043C,
      \u0445\u043E\u0440\u043E\u0448\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981269
    m_Localized: "\u041E\u0431\u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F \u043D\u043E\u0432\u043E\u0441\u0442\u044F\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981270
    m_Localized: "\u0417\u0430 \u0447\u0430\u0448\u043A\u043E\u0439 \u0437\u0435\u043B\u0451\u043D\u043E\u0433\u043E
      \u0447\u0430\u044F \u0441\u043E\u0433\u0434\u0438\u0435\u0446 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B
      \u043E \u0446\u0435\u043D\u0430\u0445 \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u0438 \u0434\u043E\u0440\u043E\u0433\u0430\u0445 \u043D\u0430 \u0437\u0430\u043F\u0430\u0434.
      \u0426\u0435\u043D\u043D\u044B\u0435 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F
      - \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981271
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0432\u0435\u0434\u0451\u0442 \u0442\u043E\u0440\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981272
    m_Localized: "\u0412\u0430\u0448 \u043A\u0443\u043F\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u043E\u0431\u043C\u0435\u043D\u044F\u043B\u0441\u044F \u0441 \u0441\u043E\u0433\u0434\u0438\u0439\u0446\u0435\u043C
      \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F\u043C\u0438
      \u043D\u0430 \u0440\u043E\u0434\u043D\u043E\u043C \u044F\u0437\u044B\u043A\u0435:
      <npc_speech lang=\"Sogdian\">\u041F\u0440\u0438\u0432\u0435\u0442, \u0437\u0435\u043C\u043B\u044F\u043A!
      \u0414\u0430\u0432\u043D\u043E \u043B\u0438 \u0438\u0437 \u0411\u0443\u0445\u0430\u0440\u044B?
      \u041F\u043E\u043A\u0430\u0436\u0438 \u043F\u0430\u0440\u0447\u0443 - \u0434\u043B\u044F
      \u0441\u0432\u043E\u0438\u0445 \u0446\u0435\u043D\u0430 \u0434\u0440\u0443\u0433\u0430\u044F,
      \u0432\u0435\u0440\u043D\u043E?</npc_speech> \u0422\u043E\u0440\u0433 \u043F\u043E\u0448\u0451\u043B
      \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E.
      \u041F\u0430\u0440\u0447\u0430 \u043A\u0443\u043F\u043B\u0435\u043D\u0430 \u0441
      \u0438\u0437\u0440\u044F\u0434\u043D\u043E\u0439 \u0441\u043A\u0438\u0434\u043A\u043E\u0439,
      \u0430 \u0441\u043E\u0433\u0434\u0438\u0435\u0446 \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438\u043B
      \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C \u043F\u043B\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981273
    m_Localized: "\u0421\u043B\u043E\u043C\u0430\u043D\u043D\u043E\u0435 \u043A\u043E\u043B\u0435\u0441\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981274
    m_Localized: "\u041D\u0430 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0439
      \u0432\u044B\u0431\u043E\u0438\u043D\u0435 \u0440\u0430\u0437\u0434\u0430\u043B\u0441\u044F
      \u0445\u0440\u0443\u0441\u0442 - \u0441\u043F\u0438\u0446\u0430 \u0433\u043B\u0430\u0432\u043D\u043E\u0439
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0442\u0440\u0435\u0441\u043D\u0443\u043B\u0430,
      \u0438 \u043A\u043E\u043B\u0435\u0441\u043E \u043F\u0435\u0440\u0435\u043A\u043E\u0441\u0438\u043B\u043E\u0441\u044C.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0430 \u043D\u0430\u043A\u0440\u0435\u043D\u0438\u043B\u0430\u0441\u044C,
      \u043C\u0435\u0448\u043A\u0438 \u0441 \u0433\u0440\u0443\u0437\u043E\u043C
      \u043F\u043E\u043F\u043E\u043B\u0437\u043B\u0438 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
      \u0422\u044F\u0433\u043B\u043E\u0432\u043E\u0435 \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435
      \u0437\u0430\u043F\u0443\u0442\u0430\u043B\u043E\u0441\u044C \u0432 \u0443\u043F\u0440\u044F\u0436\u0438.
      \u0412\u043E\u043A\u0440\u0443\u0433 - \u043E\u0442\u043A\u0440\u044B\u0442\u0430\u044F
      \u0441\u0442\u0435\u043F\u044C \u0431\u0435\u0437 \u0435\u0434\u0438\u043D\u043E\u0433\u043E
      \u0434\u0435\u0440\u0435\u0432\u0430, \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u0431\u044B \u0432\u044B\u0440\u0435\u0437\u0430\u0442\u044C
      \u0437\u0430\u043C\u0435\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981275
    m_Localized: "\u0427\u0438\u043D\u0438\u0442\u044C \u043F\u043E\u0434\u0440\u0443\u0447\u043D\u044B\u043C\u0438
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981276
    m_Localized: "\u0418\u0437 \u0437\u0430\u043F\u0430\u0441\u043D\u044B\u0445 \u0434\u043E\u0441\u043E\u043A
      \u0438 \u043F\u043E\u043B\u043E\u0441 \u043A\u043E\u0436\u0438 \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u0441\u043A\u0440\u0435\u043F\u0438\u0442\u044C \u0441\u043F\u0438\u0446\u0443.
      \u041D\u0435\u043D\u0430\u0434\u0451\u0436\u043D\u043E, \u043D\u043E \u0434\u043E
      \u0433\u043E\u0440\u043E\u0434\u0430 \u0434\u043E\u0442\u044F\u043D\u0435\u0442.
      \u041F\u043E\u043B\u0434\u043D\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E
      \u043D\u0430 \u043F\u043E\u0447\u0438\u043D\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981277
    m_Localized: "\u041A\u043E\u0436\u0430\u043D\u044B\u0435 \u0441\u0442\u044F\u0436\u043A\u0438
      \u043B\u043E\u043F\u043D\u0443\u043B\u0438 \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441
      \u043F\u0443\u0442\u0438. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0447\u0438\u043D\u0438\u0442\u044C \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E,
      \u0438\u0437\u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432\u0430\u0432 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981278
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u0438\u0442\u044C
      \u043D\u0430 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
      \u0442\u0435\u043B\u0435\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981279
    m_Localized: "\u0413\u0440\u0443\u0437 \u043F\u0435\u0440\u0435\u043A\u0438\u043D\u0443\u0442
      \u043D\u0430 \u0437\u0430\u043F\u0430\u0441\u043D\u0443\u044E \u0442\u0435\u043B\u0435\u0433\u0443,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0442\u0435\u043F\u0435\u0440\u044C
      \u0441\u043A\u0440\u0438\u043F\u0438\u0442 \u043F\u043E\u0434 \u0434\u0432\u043E\u0439\u043D\u043E\u0439
      \u0442\u044F\u0436\u0435\u0441\u0442\u044C\u044E. \u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u043A\u043E\u0432\u044B\u043B\u044F\u0435\u0442
      \u043D\u0430\u043B\u0435\u0433\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981280
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u0447\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981281
    m_Localized: "\u0421\u0430\u043C\u044B\u0435 \u0442\u044F\u0436\u0451\u043B\u044B\u0435
      \u0442\u044E\u043A\u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B
      \u0443 \u0434\u043E\u0440\u043E\u0433\u0438, \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u043E\u0439
      \u0432\u043E\u0442\u043A\u043D\u0443\u0442\u043E\u0439 \u043F\u0430\u043B\u043A\u043E\u0439.
      \u041B\u0435\u0433\u0447\u0435 \u0435\u0445\u0430\u0442\u044C - \u0442\u044F\u0436\u0435\u043B\u0435\u0435
      \u043D\u0430 \u0434\u0443\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981282
    m_Localized: "\u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u041C\u0438\u0445\u0440\u0430\u0433\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981283
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0447\u0435\u0440\u0435\u0437 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0435
      \u0441\u0435\u043B\u0435\u043D\u0438\u0435, \u0433\u0434\u0435 \u043D\u0430
      \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043B\u043E\u0449\u0430\u0434\u0438
      \u0433\u043E\u0440\u0438\u0442 \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0440\u0438\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u0439
      \u043A\u043E\u0441\u0442\u0451\u0440. \u0414\u0435\u0440\u0435\u0432\u0435\u043D\u0441\u043A\u0438\u0435
      \u0432 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u0447\u043D\u044B\u0445 \u0445\u0430\u043B\u0430\u0442\u0430\u0445
      \u0441\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C \u0432\u043E\u043A\u0440\u0443\u0433
      \u043E\u0433\u043D\u044F: \u0436\u0440\u0435\u0446 \u0440\u0430\u0437\u0434\u0443\u0432\u0430\u0435\u0442
      \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u044B\u0439 \u0436\u0430\u0440,
      \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435 \u0432\u0438\u0442\u0430\u0435\u0442
      \u0430\u0440\u043E\u043C\u0430\u0442 \u043B\u0430\u0434\u0430\u043D\u0430 \u0438
      \u043F\u043E\u0434\u0436\u0430\u0440\u0435\u043D\u043D\u043E\u0433\u043E \u043A\u0443\u043D\u0436\u0443\u0442\u0430.
      \u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430 \u0441 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u043C
      \u043F\u043E\u044F\u0441\u043E\u043C \u0432\u044B\u0445\u043E\u0434\u0438\u0442
      \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F:\r\n\r\n<npc_speech
      lang=\"Sogdian\">\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C,
      \u043F\u0443\u0442\u043D\u0438\u043A\u0438! \u0421\u0435\u0433\u043E\u0434\u043D\u044F
      \u041C\u0438\u0445\u0440\u0430\u0433\u0430\u043D - \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A
      \u0410\u0445\u0443\u0440\u0430-\u041C\u0430\u0437\u0434\u044B \u0438 \u043E\u0441\u0435\u043D\u043D\u0435\u0433\u043E
      \u0441\u043E\u043B\u043D\u0446\u0430. \u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u0435
      \u0441 \u043D\u0430\u043C\u0438 \u043E\u0433\u043E\u043D\u044C \u0438 \u0445\u043B\u0435\u0431.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981284
    m_Localized: "\u041F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F
      \u043A \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981285
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0443 \u043F\u043E\u0434\u043D\u043E\u0441\u044F\u0442
      \u043B\u0435\u043F\u0451\u0448\u043A\u0438 \u0441 \u043C\u0451\u0434\u043E\u043C,
      \u0436\u0430\u0440\u0435\u043D\u044B\u0435 \u043E\u0440\u0435\u0445\u0438 \u0438
      \u0444\u0438\u043D\u0438\u043A\u0438. \u0412\u043E\u043A\u0440\u0443\u0433
      \u043A\u043E\u0441\u0442\u0440\u0430 \u043F\u043E\u044E\u0442 \u0441\u0442\u0430\u0440\u0438\u043D\u043D\u044B\u0435
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0435 \u0433\u0438\u043C\u043D\u044B
      \u0434\u043E \u0437\u0430\u043A\u0430\u0442\u0430. \u041B\u044E\u0434\u0438
      \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u043B\u0438 \u0438 \u043F\u043E\u0432\u0435\u0441\u0435\u043B\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981286
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u043F\u043E\u0434\u0430\u0440\u043E\u043A
      \u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981287
    m_Localized: "\u0429\u0435\u0434\u0440\u044B\u0439 \u0434\u0430\u0440 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0438\u043B
      \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0443. \u041E\u043D
      \u0432\u044B\u043D\u0435\u0441 \u043C\u0435\u0448\u043E\u0447\u0435\u043A \u0448\u0430\u0444\u0440\u0430\u043D\u0430
      \u0441\u043E \u0441\u043B\u043E\u0432\u0430\u043C\u0438 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u0438
      - \u0441\u043F\u0435\u0446\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0436\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981288
    m_Localized: "\u041F\u043E\u0434\u0430\u0440\u043E\u043A \u043F\u0440\u0438\u043D\u044F\u043B\u0438,
      \u043D\u043E \u0442\u043E\u0440\u0433 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043D\u0435\u0443\u043C\u0435\u0441\u0442\u043D\u044B\u043C \u0432 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u0447\u043D\u044B\u0439
      \u0434\u0435\u043D\u044C. \u0423\u0433\u043E\u0449\u0435\u043D\u0438\u0435
      \u0434\u0430\u043B\u0438, \u043D\u043E \u0431\u0435\u0437 \u043E\u0441\u043E\u0431\u043E\u0439
      \u0442\u0435\u043F\u043B\u043E\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981289
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u0438 \u0435\u0445\u0430\u0442\u044C \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981290
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u043B\u0441\u044F
      \u0434\u0435\u0440\u0435\u0432\u0435\u043D\u0441\u043A\u0438\u043C \u0438 \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435. \u041E\u0442\u0431\u043B\u0435\u0441\u043A\u0438
      \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u0447\u043D\u043E\u0433\u043E \u043E\u0433\u043D\u044F
      \u0435\u0449\u0451 \u0434\u043E\u043B\u0433\u043E \u0432\u0438\u0434\u043D\u0435\u043B\u0438\u0441\u044C
      \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981291
    m_Localized: "\u041F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439 \u0443\u0447\u0451\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981292
    m_Localized: "\u0423 \u043E\u0431\u043E\u0447\u0438\u043D\u044B \u0441\u0438\u0434\u0438\u0442
      \u043D\u0435\u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0432 \u0447\u0430\u043B\u043C\u0435 \u0438 \u043F\u043E\u0442\u0451\u0440\u0442\u043E\u043C
      \u0445\u0430\u043B\u0430\u0442\u0435, \u043E\u043A\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0439
      \u0441\u0432\u0438\u0442\u043A\u0430\u043C\u0438 \u0438 \u043A\u043D\u0438\u0433\u0430\u043C\u0438.
      \u0420\u044F\u0434\u043E\u043C \u0441\u0442\u043E\u0438\u0442 \u0442\u043E\u0449\u0438\u0439
      \u043E\u0441\u043B\u0438\u043A \u0441 \u043F\u0435\u0440\u0435\u043C\u0451\u0442\u043D\u044B\u043C\u0438
      \u0441\u0443\u043C\u0430\u043C\u0438. \u0423\u0432\u0438\u0434\u0435\u0432
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D, \u0443\u0447\u0451\u043D\u044B\u0439
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E-\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438:\r\n\r\n<npc_speech
      lang=\"Persian\">\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A! \u042F \u0443\u0447\u0451\u043D\u044B\u0439
      \u0438\u0437 \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0430. \u0412 \u043F\u0443\u0442\u0438
      \u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0441\u0432\u043E\u0438
      \u043A\u043D\u0438\u0433\u0438. \u0415\u0441\u043B\u0438 \u0443 \u0432\u0430\u0441
      \u0435\u0441\u0442\u044C \u0431\u0443\u043C\u0430\u0433\u0430, \u0432\u0437\u0430\u043C\u0435\u043D
      \u043F\u043E\u0434\u0435\u043B\u044E\u0441\u044C \u0437\u043D\u0430\u043D\u0438\u0435\u043C
      \u043E \u0437\u0432\u0451\u0437\u0434\u0430\u0445.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981293
    m_Localized: "\u041F\u043E\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u0431\u0443\u043C\u0430\u0433\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981294
    m_Localized: "\u0417\u0430 \u0431\u0443\u043C\u0430\u0433\u0443 \u0443\u0447\u0451\u043D\u044B\u0439
      \u043E\u0442\u043F\u043B\u0430\u0442\u0438\u043B \u0441\u0442\u043E\u0440\u0438\u0446\u0435\u0439:
      \u043F\u043E\u043A\u0430\u0437\u0430\u043B, \u043A\u0430\u043A \u0447\u0438\u0442\u0430\u0442\u044C
      \u0437\u0432\u0451\u0437\u0434\u044B \u0434\u043B\u044F \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438
      \u0438 \u043A\u0430\u043A \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0442\u044C
      \u043F\u043E\u0433\u043E\u0434\u0443 \u043F\u043E \u043E\u0431\u043B\u0430\u043A\u0430\u043C.
      \u0411\u0435\u0441\u0446\u0435\u043D\u043D\u044B\u0435 \u0437\u043D\u0430\u043D\u0438\u044F
      \u0434\u043B\u044F \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981295
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981296
    m_Localized: "\u0423\u0447\u0451\u043D\u044B\u0439 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B
      \u043E \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0435 \u0438 \u0414\u043E\u043C\u0435
      \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u0438 \u0432 \u0411\u0430\u0433\u0434\u0430\u0434\u0435.
      \u0415\u0433\u043E \u0441\u043B\u043E\u0432\u0430 \u043E \u0437\u0432\u0451\u0437\u0434\u0430\u0445
      \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438\u0441\u044C \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981297
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u0431\u0435\u0441\u0435\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981298
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0438
      \u0443\u0447\u0451\u043D\u044B\u0439 \u043F\u0440\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438
      \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430. \u0410\u0441\u0442\u0440\u043E\u043D\u043E\u043C\u0438\u044F,
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B,
      \u0441\u0435\u043A\u0440\u0435\u0442\u044B \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438
      - \u0432\u0435\u0441\u044C \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0441\u043B\u0443\u0448\u0430\u043B
      \u043A\u0430\u043A \u0437\u0430\u0432\u043E\u0440\u043E\u0436\u0451\u043D\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981299
    m_Localized: "\u0414\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u044B \u0410\u0431\u0431\u0430\u0441\u0438\u0434\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981300
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 - \u0448\u0435\u0441\u0442\u0435\u0440\u043E
      \u0432\u043E\u0438\u043D\u043E\u0432 \u0432 \u0440\u0432\u0430\u043D\u044B\u0445
      \u043A\u043E\u043B\u044C\u0447\u0443\u0433\u0430\u0445. \u0411\u044B\u0432\u0448\u0438\u0435
      \u0441\u043E\u043B\u0434\u0430\u0442\u044B \u0430\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u043E\u0439
      \u0430\u0440\u043C\u0438\u0438, \u0441\u0443\u0434\u044F \u043F\u043E \u0447\u0451\u0440\u043D\u044B\u043C
      \u043B\u043E\u0441\u043A\u0443\u0442\u0430\u043C \u043D\u0430 \u0440\u0443\u043A\u0430\u0432\u0430\u0445.
      \u0418\u0445 \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
      (\u0440\u043E\u0441\u043B\u044B\u0439 \u0431\u043E\u0440\u043E\u0434\u0430\u0447
      \u0441 \u0448\u0440\u0430\u043C\u043E\u043C \u0447\u0435\u0440\u0435\u0437
      \u0449\u0435\u043A\u0443) \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0432\u043F\u0435\u0440\u0451\u0434,
      \u043F\u043E\u043B\u043E\u0436\u0438\u0432 \u0440\u0443\u043A\u0443 \u043D\u0430
      \u044D\u0444\u0435\u0441 \u0441\u0430\u0431\u043B\u0438:\r\n\r\n<npc_speech
      lang=\"Arabic\">\u0421\u0442\u043E\u0439, \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446!
      \u041C\u044B \u0431\u044B\u0432\u0448\u0438\u0435 \u0432\u043E\u0438\u043D\u044B
      \u0445\u0430\u043B\u0438\u0444\u0430. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0431\u0435\u0440\u0451\u043C \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E.
      \u041F\u043B\u0430\u0442\u0438 \u0438\u043B\u0438 \u0437\u0430\u0449\u0438\u0449\u0430\u0439\u0441\u044F.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981301
    m_Localized: "\u0414\u0430\u0442\u044C \u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981302
    m_Localized: "\u0414\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u044B - \u043E\u043F\u044B\u0442\u043D\u044B\u0435
      \u0431\u043E\u0439\u0446\u044B. \u0411\u043E\u0439 \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443 \u0441 \u043F\u0440\u043E\u0431\u043E\u0438\u043D\u0430\u043C\u0438,
      \u0430 \u043B\u044E\u0434\u0435\u0439 - \u0432 \u0441\u0438\u043D\u044F\u043A\u0430\u0445.
      \u041D\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0443\u0441\u0442\u043E\u044F\u043B,
      \u0438 \u0441\u043E\u043B\u0434\u0430\u0442\u044B \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981303
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981304
    m_Localized: "\u041E\u0431\u0440\u0430\u0449\u0435\u043D\u0438\u0435 \u043F\u043E-\u0430\u0440\u0430\u0431\u0441\u043A\u0438,
      \u0441 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435\u043C \u0445\u0430\u043B\u0438\u0444\u0430
      \u0438 \u0447\u0435\u0441\u0442\u0438 \u0432\u043E\u0438\u043D\u0430, \u0442\u0440\u043E\u043D\u0443\u043B\u043E
      \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F. \u041E\u043D
      \u0432\u0437\u044F\u043B \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u043F\u043B\u0430\u0442\u0443 \u0438 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0441 \u043A\u0438\u0441\u043B\u043E\u0439
      \u0443\u0445\u043C\u044B\u043B\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981305
    m_Localized: "\u0421\u043B\u043E\u0432\u0430 \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u043B\u0438
      \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u044F. \u041F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
      \u0440\u0430\u0441\u0441\u043C\u0435\u044F\u043B\u0441\u044F \u0438 \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B
      \u0442\u0440\u043E\u0439\u043D\u0443\u044E \u0446\u0435\u043D\u0443. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C - \u0441\u043F\u043E\u0440\u0438\u0442\u044C
      \u0441 \u0448\u0435\u0441\u0442\u044C\u044E \u043A\u043B\u0438\u043D\u043A\u0430\u043C\u0438
      \u0431\u0435\u0441\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981306
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0443\u0437\u043D\u0430\u0451\u0442
      \u0431\u044B\u0432\u0448\u0438\u0445 \u0441\u043E\u0441\u043B\u0443\u0436\u0438\u0432\u0446\u0435\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981307
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0443\u0437\u043D\u0430\u043B
      \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F -
      \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0441\u043B\u0443\u0436\u0438\u043B\u0438
      \u0432\u043C\u0435\u0441\u0442\u0435. \u0421\u0442\u0430\u0440\u044B\u0435
      \u0441\u0432\u044F\u0437\u0438 \u0440\u0435\u0448\u0438\u043B\u0438 \u0434\u0435\u043B\u043E:
      \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0434\u0430\u043D\u044C \u0438 \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u0435
      \u043C\u043E\u043B\u0447\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981308
    m_Localized: "\u0411\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439 \u043B\u0430\u0433\u0435\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981309
    m_Localized: "\u041D\u0430 \u043F\u043E\u043B\u044F\u043D\u0435 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438:
      \u043A\u043E\u0441\u0442\u0440\u0438\u0449\u0435 \u0441 \u0437\u043E\u043B\u043E\u0439,
      \u043E\u0431\u0440\u044B\u0432\u043A\u0438 \u0442\u043A\u0430\u043D\u0438 \u043D\u0430
      \u043A\u043E\u043B\u044C\u044F\u0445, \u043F\u0435\u0440\u0435\u0432\u0451\u0440\u043D\u0443\u0442\u044B\u0435
      \u043A\u043E\u0442\u043B\u044B. \u0412\u043E\u043A\u0440\u0443\u0433 \u0432\u0430\u043B\u044F\u044E\u0442\u0441\u044F
      \u0432\u0435\u0440\u0451\u0432\u043A\u0438, \u043A\u043E\u0436\u0430\u043D\u044B\u0435
      \u043E\u0431\u0440\u0435\u0437\u043A\u0438 \u0438 \u0447\u0435\u0440\u0435\u043F\u043A\u0438
      \u043F\u043E\u0441\u0443\u0434\u044B. \u0421\u043B\u0435\u0434\u044B \u0432\u0435\u0434\u0443\u0442
      \u0432 \u0440\u0430\u0437\u043D\u044B\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B,
      \u043B\u0430\u0433\u0435\u0440\u044C \u044F\u0432\u043D\u043E \u043F\u043E\u043A\u0438\u043D\u0443\u043B\u0438
      \u0432 \u0441\u043F\u0435\u0448\u043A\u0435. \u041F\u0430\u0445\u043D\u0435\u0442
      \u043F\u0440\u0435\u043B\u043E\u0439 \u0442\u0440\u0430\u0432\u043E\u0439 \u0438
      \u043E\u0441\u0442\u044B\u0432\u0448\u0438\u043C \u043F\u0435\u043F\u043B\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981310
    m_Localized: "\u041E\u0431\u044B\u0441\u043A\u0430\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981311
    m_Localized: "\u041F\u043E\u0434 \u043F\u0435\u0440\u0435\u0432\u0451\u0440\u043D\u0443\u0442\u044B\u043C
      \u043A\u043E\u0442\u043B\u043E\u043C \u043D\u0430\u0448\u0451\u043B\u0441\u044F
      \u0441\u0432\u0451\u0440\u043D\u0443\u0442\u044B\u0439 \u043A\u043E\u0432\u0451\u0440,
      \u0430 \u0432 \u0437\u043E\u043B\u0435 - \u0441\u0443\u0445\u0430\u0440\u0438,
      \u0437\u0430\u043C\u043E\u0442\u0430\u043D\u043D\u044B\u0435 \u0432 \u0442\u0440\u044F\u043F\u043A\u0443.
      \u041E\u043F\u044B\u0442\u043D\u044B\u0439 \u0433\u043B\u0430\u0437 \u0437\u0430\u043C\u0435\u0442\u0438\u043B
      \u0438 \u043F\u0440\u0438\u0447\u0438\u043D\u0443 \u0431\u0435\u0433\u0441\u0442\u0432\u0430:
      \u0441\u043B\u0435\u0434\u044B \u043F\u043E\u0434\u043A\u043E\u0432 \u0441
      \u044E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981312
    m_Localized: "\u0423\u0434\u0430\u043B\u043E\u0441\u044C \u043D\u0430\u0439\u0442\u0438
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0435\u0434\u044B, \u043D\u043E
      \u043F\u0440\u0438 \u043E\u0441\u043C\u043E\u0442\u0440\u0435 \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0430\u0441\u044C
      \u0448\u0430\u0442\u043A\u0430\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F
      \u0438\u0437 \u043A\u043E\u043B\u044C\u0435\u0432. \u041C\u0435\u0441\u0442\u043E
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u043E\u043F\u0430\u0441\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981313
    m_Localized: "\u0421\u043D\u044F\u0442\u044C \u0437\u0430\u043F\u0447\u0430\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981314
    m_Localized: "\u0412\u0435\u0440\u0451\u0432\u043A\u0438, \u043A\u043E\u0436\u0430
      \u0438 \u043F\u0430\u0440\u0430 \u043A\u0440\u0435\u043F\u043A\u0438\u0445
      \u043A\u043E\u043B\u044C\u0435\u0432 \u043F\u0440\u0438\u0433\u043E\u0434\u044F\u0442\u0441\u044F
      \u0434\u043B\u044F \u043F\u043E\u0447\u0438\u043D\u043A\u0438 \u043F\u043E\u0432\u043E\u0437\u043A\u0438.
      \u0422\u0440\u0435\u0432\u043E\u0436\u043D\u043E\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043E
      \u043D\u0435 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981315
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981316
    m_Localized: "\u0427\u0443\u0436\u043E\u0439 \u043B\u0430\u0433\u0435\u0440\u044C
      - \u0447\u0443\u0436\u0430\u044F \u0431\u0435\u0434\u0430. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435,
      \u043D\u043E \u043C\u0440\u0430\u0447\u043D\u0430\u044F \u043A\u0430\u0440\u0442\u0438\u043D\u0430
      \u043D\u0435 \u0448\u043B\u0430 \u0438\u0437 \u0433\u043E\u043B\u043E\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981317
    m_Localized: "\u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0435 \u043A\u043E\u043D\u043D\u044B\u0435
      \u043B\u0443\u0447\u043D\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981318
    m_Localized: "\u0422\u043E\u043F\u043E\u0442 \u043A\u043E\u043F\u044B\u0442 \u043D\u0430\u0440\u0430\u0441\u0442\u0430\u0435\u0442
      \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0441\u0442\u0435\u043F\u0438.
      \u0414\u0435\u0441\u044F\u0442\u043E\u043A \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u043E\u0432
      \u0432 \u043A\u043E\u0436\u0430\u043D\u044B\u0445 \u043A\u0443\u0440\u0442\u043A\u0430\u0445
      \u0438 \u043C\u0435\u0445\u043E\u0432\u044B\u0445 \u0448\u0430\u043F\u043A\u0430\u0445
      \u043B\u0435\u0442\u0438\u0442 \u043D\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u0432\u044B\u0441\u0442\u0440\u043E\u0438\u0432\u0448\u0438\u0441\u044C \u0434\u0443\u0433\u043E\u0439.
      \u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0435 \u043B\u0443\u0447\u043D\u0438\u043A\u0438
      - \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0438, \u0434\u043B\u044F
      \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0433\u0440\u0430\u0431\u0451\u0436
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u043E\u0431\u044B\u0447\u043D\u043E\u0435
      \u0434\u0435\u043B\u043E. \u0418\u0445 \u0432\u043E\u0436\u0430\u043A \u043D\u0430
      \u0432\u043E\u0440\u043E\u043D\u043E\u043C \u0436\u0435\u0440\u0435\u0431\u0446\u0435
      \u043A\u0440\u0438\u0447\u0438\u0442, \u043D\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u044F
      \u043B\u0443\u043A:\r\n\r\n<npc_speech lang=\"Turkic\">\u041A\u0430\u0440\u0430\u0432\u0430\u043D
      - \u043D\u0430\u0448! \u0411\u0440\u043E\u0441\u0430\u0439\u0442\u0435 \u0434\u043E\u0431\u0440\u043E,
      \u0438\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u044B \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u044F\u0442!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981319
    m_Localized: "\u041E\u0442\u0431\u0438\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981320
    m_Localized: "\u0421\u0442\u0440\u0435\u043B\u044B \u043B\u0435\u0442\u0435\u043B\u0438
      \u0433\u0440\u0430\u0434\u043E\u043C. \u041F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0438\u0437\u0440\u0435\u0448\u0435\u0447\u0435\u043D\u044B, \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0442\u044E\u043A\u043E\u0432 \u0433\u043E\u0440\u044F\u0442. \u041B\u0443\u0447\u043D\u0438\u043A\u043E\u0432
      \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043E\u0442\u043E\u0433\u043D\u0430\u0442\u044C,
      \u043D\u043E \u043F\u043E\u0442\u0435\u0440\u0438 \u0432\u0435\u043B\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981321
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u0434\u043E\u0431\u044B\u0447\u0443
      \u0438 \u0431\u0435\u0436\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981322
    m_Localized: "\u041C\u0435\u0448\u043A\u0438 \u0441 \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C
      \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0442\u044E\u043A\u043E\u0432
      \u043F\u043E\u043B\u0435\u0442\u0435\u043B\u0438 \u043D\u0430 \u0437\u0435\u043C\u043B\u044E.
      \u0412\u0441\u0430\u0434\u043D\u0438\u043A\u0438 \u0441\u043F\u0435\u0448\u0438\u043B\u0438\u0441\u044C
      \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u0442\u044C \u0434\u043E\u0431\u044B\u0447\u0443,
      \u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043D\u0430\u0445\u043B\u0451\u0441\u0442\u044B\u0432\u0430\u043B
      \u0442\u044F\u0433\u043B\u043E\u0432\u044B\u0445 \u0438\u0437\u043E \u0432\u0441\u0435\u0445
      \u0441\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981323
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0443\u0435\u0442
      \u043E\u0431\u043E\u0440\u043E\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981324
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0432\u044B\u0441\u0442\u0440\u043E\u0438\u043B
      \u043B\u044E\u0434\u0435\u0439 \u0437\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u043C\u0438,
      \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0432 \u043F\u043E\u0434\u043E\u0431\u0438\u0435 \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u0438.
      \u0422\u044E\u0440\u043A\u0438 \u043F\u043E\u043A\u0440\u0443\u0442\u0438\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438,
      \u043F\u0443\u0441\u0442\u0438\u043B\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0441\u0442\u0440\u0435\u043B \u0438 \u0443\u0441\u043A\u0430\u043A\u0430\u043B\u0438,
      \u0437\u0430\u0431\u0440\u0430\u0432 \u043B\u0438\u0448\u044C \u0442\u043E,
      \u0447\u0442\u043E \u0431\u0440\u043E\u0441\u0438\u043B\u0438 \u0438\u043C
      \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981325
    m_Localized: "\u0420\u0430\u0441\u043A\u043E\u043B\u043E\u0442\u0430\u044F \u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981326
    m_Localized: "\u0421 \u0433\u043B\u0443\u0445\u0438\u043C \u0442\u0440\u0435\u0441\u043A\u043E\u043C
      \u043E\u0441\u044C \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0440\u0430\u0441\u043A\u0430\u043B\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432\u0434\u043E\u043B\u044C. \u041F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043E\u0441\u0435\u0434\u0430\u0435\u0442 \u043D\u0430\u0431\u043E\u043A,
      \u043A\u043E\u043B\u0451\u0441\u0430 \u0440\u0430\u0437\u044A\u0435\u0437\u0436\u0430\u044E\u0442\u0441\u044F.
      \u0413\u0440\u0443\u0437 \u0432\u0440\u0435\u0437\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0431\u043E\u0440\u0442, \u0438 \u0434\u043E\u0441\u043A\u0438 \u0442\u0440\u0435\u0449\u0430\u0442.
      \u0412 \u0441\u0442\u0435\u043F\u0438 \u043D\u0435\u0442 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0438\u0445
      - \u0447\u0438\u043D\u0438\u0442\u044C \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u0441\u0430\u043C\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981327
    m_Localized: "\u0420\u0435\u043C\u043E\u043D\u0442 \u0441 \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981328
    m_Localized: "\u041E\u0441\u044C \u043E\u0431\u043C\u043E\u0442\u0430\u043D\u0430
      \u043C\u043E\u043A\u0440\u044B\u043C\u0438 \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u043C\u0438,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u0442\u044F\u043D\u0443\u043B\u0438\u0441\u044C
      \u043F\u0440\u0438 \u0432\u044B\u0441\u044B\u0445\u0430\u043D\u0438\u0438.
      \u0421\u0432\u0435\u0440\u0445\u0443 \u043D\u0430\u043B\u043E\u0436\u0435\u043D\u044B
      \u0448\u0438\u043D\u044B \u0438\u0437 \u0437\u0430\u043F\u0430\u0441\u043D\u044B\u0445
      \u0434\u043E\u0441\u043E\u043A. \u041A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F
      \u0441\u043A\u0440\u0438\u043F\u0438\u0442, \u043D\u043E \u0434\u0435\u0440\u0436\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981329
    m_Localized: "\u041F\u043E\u0447\u0438\u043D\u043A\u0430 \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u043B\u0430
      \u043F\u0435\u0440\u0432\u043E\u0439 \u0436\u0435 \u044F\u043C\u044B. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044C \u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C
      \u0437\u0430\u043D\u043E\u0432\u043E, \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0432
      \u0432\u0440\u0435\u043C\u044F \u0438 \u043D\u0435\u0440\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981330
    m_Localized: "\u041C\u0435\u0434\u043B\u0435\u043D\u043D\u043E\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
      \u0431\u0435\u0437 \u043F\u043E\u0447\u0438\u043D\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981331
    m_Localized: "\u041F\u043E\u0432\u043E\u0437\u043A\u0430 \u043F\u043E\u043B\u0437\u0451\u0442
      \u043D\u0430 \u0440\u0430\u0441\u043A\u043E\u043B\u043E\u0442\u043E\u0439 \u043E\u0441\u0438,
      \u0441\u043A\u0440\u0435\u0436\u0435\u0449\u0430 \u043F\u043E \u043A\u0430\u043C\u043D\u044F\u043C.
      \u041A\u0430\u0436\u0434\u0430\u044F \u043A\u043E\u0447\u043A\u0430 - \u0443\u0434\u0430\u0440
      \u043F\u043E \u043D\u0435\u0440\u0432\u0430\u043C. \u041A \u0437\u0430\u043A\u0430\u0442\u0443
      \u0434\u043E\u0448\u043B\u0438 \u0434\u043E \u0440\u043E\u0432\u043D\u043E\u0433\u043E
      \u0443\u0447\u0430\u0441\u0442\u043A\u0430, \u043D\u043E \u043E\u0441\u044C
      \u0434\u043E\u0431\u0438\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981332
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u043A\u0430 \u043D\u0430
      \u0434\u043E\u043F. \u0442\u0435\u043B\u0435\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981333
    m_Localized: "\u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0440\u0430\u0437\u0433\u0440\u0443\u0436\u0435\u043D\u0430 \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443.
      \u0414\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0442\u0435\u043B\u0435\u0433\u0430 \u0441\u043A\u0440\u0438\u043F\u0438\u0442
      \u043F\u043E\u0434 \u0434\u0432\u043E\u0439\u043D\u044B\u043C \u0432\u0435\u0441\u043E\u043C,
      \u043D\u043E \u0438\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981334
    m_Localized: "\u0410\u0440\u0430\u0431\u0441\u043A\u0438\u0439 \u0441\u0431\u043E\u0440\u0449\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981335
    m_Localized: "\u041D\u0430 \u043F\u0435\u0440\u0435\u043A\u0440\u0451\u0441\u0442\u043A\u0435
      \u0434\u043E\u0440\u043E\u0433 \u0441\u0442\u043E\u0438\u0442 \u0448\u0430\u0442\u0451\u0440
      \u0441 \u0437\u0435\u043B\u0451\u043D\u044B\u043C \u0437\u043D\u0430\u043C\u0435\u043D\u0435\u043C.
      \u041F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C - \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u0432 \u0431\u0435\u043B\u043E\u043C \u0442\u044E\u0440\u0431\u0430\u043D\u0435
      \u0441 \u0447\u0435\u0440\u043D\u0438\u043B\u044C\u043D\u0438\u0446\u0435\u0439
      \u0438 \u0432\u0435\u0441\u0430\u043C\u0438. \u0414\u0432\u0430 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430
      \u0441 \u043A\u043E\u043F\u044C\u044F\u043C\u0438 \u0441\u0442\u043E\u044F\u0442
      \u043F\u043E \u0431\u043E\u043A\u0430\u043C. \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u0436\u0435\u0441\u0442\u043E\u043C \u043F\u0440\u0438\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0438 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442:\r\n\r\n<npc_speech
      lang=\"Arabic\">\u0417\u0434\u0435\u0441\u044C \u043F\u043E\u0441\u0442 \u0441\u0431\u043E\u0440\u0430
      \u043F\u043E\u0434\u0430\u0442\u0438. \u041F\u044F\u0442\u044C \u0434\u0438\u043D\u0430\u0440\u043E\u0432
      \u0441 \u043A\u0430\u0436\u0434\u043E\u0439 \u043F\u043E\u0432\u043E\u0437\u043A\u0438.
      \u0422\u0430\u043A\u043E\u0432 \u0437\u0430\u043A\u043E\u043D \u0445\u0430\u043B\u0438\u0444\u0430.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981336
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043D\u0430\u043B\u043E\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981337
    m_Localized: "\u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043B
      \u043C\u043E\u043D\u0435\u0442\u044B, \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u043F\u0435\u0447\u0430\u0442\u044C \u043D\u0430 \u0441\u0432\u0438\u0442\u043E\u043A
      \u0438 \u043A\u0438\u0432\u043D\u0443\u043B. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D. \u0427\u0435\u0440\u043D\u0438\u043B\u0430
      \u0435\u0449\u0451 \u043D\u0435 \u0432\u044B\u0441\u043E\u0445\u043B\u0438
      \u043D\u0430 \u043A\u0432\u0438\u0442\u0430\u043D\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981338
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981339
    m_Localized: "\u0417\u043D\u0430\u043D\u0438\u0435 \u0430\u0440\u0430\u0431\u0441\u043A\u043E\u0433\u043E
      \u0438 \u0442\u043E\u043D\u043A\u0438\u0439 \u043D\u0430\u043C\u0451\u043A
      \u043D\u0430 \u043F\u043E\u043A\u0440\u043E\u0432\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u0437\u043D\u0430\u0442\u043D\u043E\u0433\u043E \u043A\u0443\u043F\u0446\u0430
      \u0443\u0431\u0435\u0434\u0438\u043B\u0438 \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0430
      \u0441\u043D\u0438\u0437\u0438\u0442\u044C \u0441\u0442\u0430\u0432\u043A\u0443.
      \u041E\u043D \u0447\u0442\u043E-\u0442\u043E \u043F\u0440\u043E\u0431\u043E\u0440\u043C\u043E\u0442\u0430\u043B
      \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043F\u0435\u0447\u0430\u0442\u044C
      \u0441 \u043A\u0438\u0441\u043B\u043E\u0439 \u043C\u0438\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981340
    m_Localized: "\u0422\u043E\u0440\u0433 \u0440\u0430\u0437\u043E\u0437\u043B\u0438\u043B
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0430. \u041E\u043D \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B
      \u043D\u0430\u0434\u0431\u0430\u0432\u043A\u0443 \u0437\u0430 \"\u0434\u0435\u0440\u0437\u043E\u0441\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434 \u0437\u0430\u043A\u043E\u043D\u043E\u043C \u0445\u0430\u043B\u0438\u0444\u0430\"."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981341
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043E\u0441\u043F\u0430\u0440\u0438\u0432\u0430\u0435\u0442
      \u0441\u0442\u0430\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981342
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u0440\u043E\u0446\u0438\u0442\u0438\u0440\u043E\u0432\u0430\u043B
      \u0443\u043A\u0430\u0437 \u0445\u0430\u043B\u0438\u0444\u0430 \u043E \u043B\u044C\u0433\u043E\u0442\u0430\u0445
      \u0434\u043B\u044F \u0442\u0440\u0430\u043D\u0437\u0438\u0442\u043D\u044B\u0445
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u0432. \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u043F\u043E\u0431\u043B\u0435\u0434\u043D\u0435\u043B, \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043B
      \u0438 \u0432\u044B\u0441\u0442\u0430\u0432\u0438\u043B \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u0443\u044E
      \u043F\u043E\u0448\u043B\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981343
    m_Localized: "\u041B\u0430\u0433\u0435\u0440\u044C \u043F\u0430\u0441\u0442\u0443\u0445\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981344
    m_Localized: "\u0423 \u0440\u0443\u0447\u044C\u044F \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0441\u044F
      \u043B\u0430\u0433\u0435\u0440\u044C \u043F\u0430\u0441\u0442\u0443\u0445\u043E\u0432.
      \u0414\u044E\u0436\u0438\u043D\u0430 \u0448\u0430\u0442\u0440\u043E\u0432 \u0438\u0437
      \u043A\u043E\u0437\u044C\u0438\u0445 \u0448\u043A\u0443\u0440, \u0441\u0442\u0430\u0434\u043E
      \u043E\u0432\u0435\u0446 \u043D\u0430 \u0441\u043A\u043B\u043E\u043D\u0435,
      \u0434\u044B\u043C \u043E\u0442 \u043A\u043E\u0441\u0442\u0440\u043E\u0432
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u0432 \u0431\u0435\u0437\u0432\u0435\u0442\u0440\u0435\u043D\u043D\u043E\u0435
      \u043D\u0435\u0431\u043E. \u041F\u0430\u0445\u043D\u0435\u0442 \u043A\u0438\u0441\u043B\u044B\u043C
      \u043C\u043E\u043B\u043E\u043A\u043E\u043C \u0438 \u043D\u0430\u0432\u043E\u0437\u043E\u043C.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u043F\u0430\u0441\u0442\u0443\u0445
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443,
      \u043E\u043F\u0438\u0440\u0430\u044F\u0441\u044C \u043D\u0430 \u043F\u043E\u0441\u043E\u0445
      \u0441 \u0432\u044B\u0440\u0435\u0437\u0430\u043D\u043D\u044B\u043C \u043E\u0440\u043D\u0430\u043C\u0435\u043D\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981345
    m_Localized: "\u041E\u0431\u043C\u0435\u043D\u044F\u0442\u044C \u0442\u043E\u0432\u0430\u0440
      \u043D\u0430 \u0441\u044B\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981346
    m_Localized: "\u0417\u0430 \u0433\u043E\u0440\u0441\u0442\u044C \u043C\u0435\u0434\u043D\u044B\u0445
      \u043C\u043E\u043D\u0435\u0442 \u043F\u0430\u0441\u0442\u0443\u0445\u0438 \u0432\u044B\u043D\u0435\u0441\u043B\u0438
      \u043A\u0440\u0443\u0433 \u043E\u0432\u0435\u0447\u044C\u0435\u0433\u043E \u0441\u044B\u0440\u0430
      \u0438 \u043A\u0443\u0432\u0448\u0438\u043D \u043A\u0438\u0441\u043B\u043E\u0433\u043E
      \u043C\u043E\u043B\u043E\u043A\u0430. \u041F\u0440\u043E\u0441\u0442\u0430\u044F
      \u0435\u0434\u0430, \u043D\u043E \u043F\u043E\u0441\u043B\u0435 \u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0445
      \u0441\u0443\u0445\u0430\u0440\u0435\u0439 - \u043F\u0438\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981347
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043D\u043E\u0447\u043B\u0435\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981348
    m_Localized: "\u041F\u0430\u0441\u0442\u0443\u0445\u0438 \u043F\u0443\u0441\u0442\u0438\u043B\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0435\u0440\u0435\u043D\u043E\u0447\u0435\u0432\u0430\u0442\u044C
      \u0443 \u043A\u043E\u0441\u0442\u0440\u0430. \u0421\u043E\u0431\u0430\u043A\u0438
      \u043D\u0435\u0441\u043B\u0438 \u0441\u0442\u0440\u0430\u0436\u0443, \u0430
      \u043B\u044E\u0434\u0438 \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0437\u0430
      \u0434\u043D\u0438 \u0441\u043F\u0430\u043B\u0438 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981349
    m_Localized: "\u0421\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043E \u0434\u043E\u0440\u043E\u0433\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981350
    m_Localized: "\u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u043F\u0430\u0441\u0442\u0443\u0445
      \u0437\u043D\u0430\u0435\u0442 \u043A\u0430\u0436\u0434\u0443\u044E \u0442\u0440\u043E\u043F\u0443
      \u0432 \u043E\u043A\u0440\u0443\u0433\u0435. \u041E\u043D \u0443\u043A\u0430\u0437\u0430\u043B
      \u043D\u0430 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0439 \u043F\u0443\u0442\u044C
      \u0438 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u043B \u043E
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0430\u0445 \u0437\u0430
      \u0445\u043E\u043B\u043C\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981351
    m_Localized: "\u0411\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u043C\u043E\u043D\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981352
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u0441\u0442\u043E\u0438\u0442
      \u0431\u043E\u0441\u043E\u0439 \u043C\u043E\u043D\u0430\u0445 \u0432 \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u0432\u043E\u0439
      \u043A\u0430\u0448\u0430\u0435, \u0441 \u0447\u0430\u0448\u0435\u0439 \u0434\u043B\u044F
      \u043F\u043E\u0434\u0430\u044F\u043D\u0438\u044F \u0438 \u043F\u043E\u0441\u043E\u0445\u043E\u043C.
      \u0415\u0433\u043E \u0433\u043E\u043B\u043E\u0432\u0430 \u043E\u0431\u0440\u0438\u0442\u0430,
      \u0430 \u0433\u043B\u0430\u0437\u0430 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B.
      \u041E\u043D \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F \u0438
      \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443
      \u043D\u0430\u0440\u0430\u0441\u043F\u0435\u0432:\r\n\r\n<npc_speech lang=\"Sanskrit\">\u041F\u043E\u043A\u043B\u043E\u043D
      \u0411\u0443\u0434\u0434\u0435. \u041F\u0443\u0442\u043D\u0438\u043A, \u0434\u043E\u0440\u043E\u0433\u0430
      \u0442\u044F\u0436\u0435\u043B\u0430, \u043D\u043E \u0435\u0441\u043B\u0438
      \u0434\u0443\u0445 \u0441\u043F\u043E\u043A\u043E\u0435\u043D, \u0432\u0441\u0451
      \u0441\u0431\u0443\u0434\u0435\u0442\u0441\u044F. \u041D\u0435 \u043F\u043E\u0434\u0430\u0434\u0438\u0442\u0435
      \u043B\u0438 \u043C\u0438\u043B\u043E\u0441\u0442\u044B\u043D\u044E?</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981353
    m_Localized: "\u041F\u043E\u0434\u0430\u0442\u044C \u043C\u0438\u043B\u043E\u0441\u0442\u044B\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981354
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u043F\u0440\u0438\u043D\u044F\u043B
      \u043F\u043E\u0434\u0430\u044F\u043D\u0438\u0435, \u0441\u043B\u043E\u0436\u0438\u0432
      \u043B\u0430\u0434\u043E\u043D\u0438. \u0415\u0433\u043E \u0442\u0438\u0445\u0430\u044F
      \u043C\u043E\u043B\u0438\u0442\u0432\u0430 \u0440\u0430\u0437\u043D\u0435\u0441\u043B\u0430\u0441\u044C
      \u043D\u0430\u0434 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u043C.
      \u041B\u044E\u0434\u0438 \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438
      \u0441\u0442\u0440\u0430\u043D\u043D\u043E\u0435 \u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0438\u0435
      - \u0442\u0440\u0435\u0432\u043E\u0433\u0438 \u0434\u043E\u0440\u043E\u0433\u0438
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981355
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u043D\u0430 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981356
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u043A\u043E\u0441\u043D\u0443\u043B\u0441\u044F
      \u043B\u0431\u0430 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0430
      \u0438 \u043F\u0440\u043E\u0448\u0435\u043F\u0442\u0430\u043B \u043C\u0430\u043D\u0442\u0440\u0443.
      \u0421\u043B\u043E\u0432\u0430 \u043D\u0430 \u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442\u0435
      \u043E\u0442\u043F\u0435\u0447\u0430\u0442\u0430\u043B\u0438\u0441\u044C \u0432
      \u043F\u0430\u043C\u044F\u0442\u0438, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438
      \u0441\u043C\u044B\u0441\u043B \u0443\u0441\u043A\u043E\u043B\u044C\u0437\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981357
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981358
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u043A\u0438\u0432\u043D\u0443\u043B
      \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B \u0438 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B
      \u043D\u0430 \u043E\u0431\u043E\u0447\u0438\u043D\u0443. \u0415\u0433\u043E
      \u0441\u0438\u043B\u0443\u044D\u0442 \u0435\u0449\u0451 \u0434\u043E\u043B\u0433\u043E
      \u0432\u0438\u0434\u043D\u0435\u043B\u0441\u044F \u0432 \u0437\u0435\u0440\u043A\u0430\u043B\u0435
      \u0441\u0442\u0435\u043F\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981359
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u043E\u0439 \u0432\u043E\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707516981360
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u0442\u044F\u0433\u043B\u043E\u0432\u044B\u0445
      \u0432\u043E\u043B\u043E\u0432 \u0437\u0430\u043C\u0435\u0434\u043B\u0438\u043B
      \u0448\u0430\u0433 \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F,
      \u0442\u044F\u0436\u0435\u043B\u043E \u0434\u044B\u0448\u0430. \u0411\u043E\u043A\u0430
      \u0440\u0430\u0437\u0434\u0443\u0442\u044B, \u043C\u043E\u0440\u0434\u0430
      \u0432 \u043F\u0435\u043D\u0435, \u043D\u043E\u0433\u0438 \u043F\u043E\u0434\u043A\u0430\u0448\u0438\u0432\u0430\u044E\u0442\u0441\u044F.
      \u041F\u043E\u0445\u043E\u0436\u0435 \u043D\u0430 \u043E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      - \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E, \u0437\u0432\u0435\u0440\u044C
      \u043D\u0430\u0435\u043B\u0441\u044F \u044F\u0434\u043E\u0432\u0438\u0442\u043E\u0439
      \u0442\u0440\u0430\u0432\u044B \u043D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435.
      \u0411\u0435\u0437 \u0442\u044F\u0433\u043B\u0430 \u043E\u0434\u043D\u0430
      \u0438\u0437 \u0442\u0435\u043B\u0435\u0433 \u0432\u0441\u0442\u0430\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175552
    m_Localized: "\u0414\u0430\u0442\u044C \u0432\u043E\u043B\u0443 \u043E\u0442\u0434\u044B\u0445
      \u0438 \u0432\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175553
    m_Localized: "\u0412\u043E\u043B \u043E\u0442\u043B\u0451\u0436\u0438\u0432\u0430\u043B\u0441\u044F
      \u0434\u043E \u0432\u0435\u0447\u0435\u0440\u0430, \u043F\u043E\u043A\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0436\u0434\u0430\u043B. \u0427\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430 \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0435\u043D\u0430
      \u043D\u0430 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
      \u0442\u0435\u043B\u0435\u0433\u0443. \u041A \u0443\u0442\u0440\u0443 \u0437\u0432\u0435\u0440\u044C
      \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F, \u043D\u043E \u043E\u0441\u043B\u0430\u0431."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175554
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u0438\u0442\u044C
      \u0438 \u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0432\u043E\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175555
    m_Localized: "\u0412\u043E\u043B \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043D\u0430
      \u043E\u0431\u043E\u0447\u0438\u043D\u0435. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u043E\u0442\u0432\u043E\u0434\u044F\u0442 \u0433\u043B\u0430\u0437\u0430.
      \u0411\u0435\u0437 \u0442\u044F\u0433\u043B\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0432\u043F\u0440\u044F\u0433\u0430\u0442\u044C \u043B\u044E\u0434\u0435\u0439
      - \u0434\u0435\u043B\u043E \u0442\u044F\u0436\u0451\u043B\u043E\u0435 \u0438
      \u0443\u043D\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175556
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043B\u0435\u0447\u0438\u0442
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175557
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u0432\u043E\u043B\u0430, \u0432\u043B\u0438\u043B \u043E\u0442\u0432\u0430\u0440
      \u0438\u0437 \u0442\u0440\u0430\u0432 \u0432 \u0433\u043B\u043E\u0442\u043A\u0443
      \u0438 \u0440\u0430\u0441\u0442\u0451\u0440 \u0431\u043E\u043A\u0430. \u041A
      \u0443\u0442\u0440\u0443 \u0437\u0432\u0435\u0440\u044C \u0436\u0435\u0432\u0430\u043B
      \u0441\u0435\u043D\u043E \u0438 \u0442\u044F\u043D\u0443\u043B \u0443\u043F\u0440\u044F\u0436\u044C.
      \u041B\u0435\u043A\u0430\u0440\u044C \u0437\u043D\u0430\u0435\u0442 \u043D\u0435
      \u0442\u043E\u043B\u044C\u043A\u043E \u043B\u044E\u0434\u0441\u043A\u0438\u0435
      \u0445\u0432\u043E\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175558
    m_Localized: "\u0421\u043A\u0440\u044B\u0442\u044B\u0439 \u043A\u043E\u043B\u043E\u0434\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175559
    m_Localized: "\u0412 \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u043E\u0442
      \u0434\u043E\u0440\u043E\u0433\u0438, \u0437\u0430 \u0437\u0430\u0440\u043E\u0441\u043B\u044F\u043C\u0438
      \u0442\u0430\u043C\u0430\u0440\u0438\u0441\u043A\u0430, \u0431\u043B\u0435\u0441\u0442\u0438\u0442
      \u0432\u043B\u0430\u0436\u043D\u0430\u044F \u0433\u043B\u0438\u043D\u0430.
      \u0417\u0435\u043C\u043B\u044F \u0437\u0434\u0435\u0441\u044C \u043C\u044F\u0433\u0447\u0435,
      \u0442\u0440\u0430\u0432\u0430 \u0437\u0435\u043B\u0435\u043D\u0435\u0435.
      \u041E\u043F\u044B\u0442\u043D\u044B\u0439 \u0432\u0437\u0433\u043B\u044F\u0434
      \u0440\u0430\u0437\u043B\u0438\u0447\u0430\u0435\u0442 \u043A\u0430\u043C\u043D\u0438,
      \u0441\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0435 \u043A\u0440\u0443\u0433\u043E\u043C
      - \u0441\u0442\u0430\u0440\u044B\u0439 \u043A\u043E\u043B\u043E\u0434\u0435\u0446,
      \u0441\u043A\u0440\u044B\u0442\u044B\u0439 \u043A\u0443\u0441\u0442\u0430\u0440\u043D\u0438\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175560
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0432\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175561
    m_Localized: "\u0412\u043E\u0434\u0430 \u0447\u0438\u0441\u0442\u0430 \u0438
      \u0445\u043E\u043B\u043E\u0434\u043D\u0430. \u0411\u0443\u0440\u0434\u044E\u043A\u0438
      \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u044B \u0434\u043E \u043A\u0440\u0430\u0451\u0432,
      \u043B\u044E\u0434\u0438 \u0438 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435
      \u043D\u0430\u043F\u0438\u043B\u0438\u0441\u044C \u0432\u0434\u043E\u0432\u043E\u043B\u044C.
      \u0421\u043F\u0430\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F \u043D\u0430\u0445\u043E\u0434\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175562
    m_Localized: "\u0412\u043E\u0434\u0430 \u043C\u0443\u0442\u043D\u0430\u044F \u0438
      \u0441 \u043F\u0440\u0438\u0432\u043A\u0443\u0441\u043E\u043C \u0436\u0435\u043B\u0435\u0437\u0430,
      \u043D\u043E \u043F\u0438\u0442\u044C \u043C\u043E\u0436\u043D\u043E. \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043E\u0449\u0443\u0442\u0438\u043B\u0438
      \u043B\u0451\u0433\u043A\u0443\u044E \u0442\u043E\u0448\u043D\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175563
    m_Localized: "\u041D\u0430\u0431\u0440\u0430\u0442\u044C \u0431\u0435\u0437 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175564
    m_Localized: "\u0411\u0443\u0440\u0434\u044E\u043A\u0438 \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u044B,
      \u043D\u043E \u043A \u0432\u0435\u0447\u0435\u0440\u0443 \u0443 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u043E\u0432 \u0437\u0430\u0431\u043E\u043B\u0435\u043B\u0438
      \u0436\u0438\u0432\u043E\u0442\u044B. \u0412\u043E\u0434\u0430, \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E,
      \u043D\u0435 \u0441\u043E\u0432\u0441\u0435\u043C \u0447\u0438\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175565
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175566
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F:
      \"\u042F \u0437\u043D\u0430\u043B \u043E\u0431 \u044D\u0442\u043E\u043C \u043A\u043E\u043B\u043E\u0434\u0446\u0435.
      \u0417\u0434\u0435\u0441\u044C \u0432\u0441\u0435\u0433\u0434\u0430 \u0447\u0438\u0441\u0442\u0430\u044F
      \u0432\u043E\u0434\u0430 - \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0431\u0435\u0440\u0435\u0433\u0443\u0442 \u0435\u0433\u043E \u043A\u0430\u043A
      \u0442\u0430\u0439\u043D\u0443.\" \u0411\u0443\u0440\u0434\u044E\u043A\u0438
      \u043F\u043E\u043B\u043D\u044B, \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u043F\u0440\u0438\u043F\u043E\u0434\u043D\u044F\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175567
    m_Localized: "\u0421\u0432\u0430\u0434\u0435\u0431\u043D\u0430\u044F \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175568
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0443 \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u0435\u0442
      \u0448\u0443\u043C\u043D\u0430\u044F \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0438\u044F:
      \u043C\u0443\u0437\u044B\u043A\u0430\u043D\u0442\u044B \u0441 \u0431\u0430\u0440\u0430\u0431\u0430\u043D\u0430\u043C\u0438
      \u0438 \u0437\u0443\u0440\u043D\u0430\u043C\u0438, \u0436\u0435\u043D\u0449\u0438\u043D\u044B
      \u0432 \u044F\u0440\u043A\u0438\u0445 \u043F\u043B\u0430\u0442\u043A\u0430\u0445,
      \u043C\u0443\u0436\u0447\u0438\u043D\u044B \u0432\u0435\u0440\u0445\u043E\u043C
      \u043D\u0430 \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u043D\u044B\u0445 \u043B\u0435\u043D\u0442\u0430\u043C\u0438
      \u043B\u043E\u0448\u0430\u0434\u044F\u0445. \u041D\u0435\u0432\u0435\u0441\u0442\u0443
      \u0432\u0435\u0437\u0443\u0442 \u0432 \u043F\u0430\u043B\u0430\u043D\u043A\u0438\u043D\u0435,
      \u0440\u0430\u0441\u0448\u0438\u0442\u043E\u043C \u0437\u043E\u043B\u043E\u0442\u043E\u043C.
      \u0417\u0430\u043F\u0430\u0445 \u0440\u043E\u0437\u043E\u0432\u043E\u0439 \u0432\u043E\u0434\u044B
      \u0438 \u0436\u0430\u0440\u0435\u043D\u043E\u0433\u043E \u043C\u044F\u0441\u0430
      \u043F\u043B\u044B\u0432\u0451\u0442 \u043F\u043E \u0432\u0435\u0442\u0440\u0443.
      \u0421\u0442\u0430\u0440\u0448\u0438\u043D\u0430 \u0441\u0432\u0430\u0434\u044C\u0431\u044B
      \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u0435\u0442 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043A \u0441\u0442\u043E\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175569
    m_Localized: "\u041F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F
      \u043A \u043F\u0438\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175570
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0443\u0433\u043E\u0449\u0430\u044E\u0442
      \u043C\u0451\u0434\u043E\u043C, \u043C\u044F\u0441\u043E\u043C \u0438 \u043B\u0435\u043F\u0451\u0448\u043A\u0430\u043C\u0438.
      \u041C\u0443\u0437\u044B\u043A\u0430 \u0438 \u0441\u043C\u0435\u0445 \u0434\u043E
      \u0437\u0430\u043A\u0430\u0442\u0430. \u041B\u044E\u0434\u0438 \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u043B\u0438,
      \u043D\u0430\u0431\u0440\u0430\u043B\u0438\u0441\u044C \u0441\u0438\u043B \u0438
      \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175571
    m_Localized: "\u041F\u043E\u0434\u0430\u0440\u0438\u0442\u044C \u043F\u043E\u0434\u0430\u0440\u043E\u043A
      \u0438 \u043F\u0440\u043E\u0438\u0437\u043D\u0435\u0441\u0442\u0438 \u0442\u043E\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175572
    m_Localized: "\u041A\u0440\u0430\u0441\u0438\u0432\u044B\u0439 \u0442\u043E\u0441\u0442
      \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0438\u043B \u0433\u043E\u0441\u0442\u0435\u0439.
      \u041E\u0442\u0435\u0446 \u043D\u0435\u0432\u0435\u0441\u0442\u044B \u0432\u0440\u0443\u0447\u0438\u043B
      \u0433\u043E\u0440\u0448\u043E\u0447\u0435\u043A \u043C\u0451\u0434\u0430 \u0432
      \u043E\u0442\u0432\u0435\u0442\u043D\u044B\u0439 \u0434\u0430\u0440: \"\u041F\u0443\u0441\u0442\u044C
      \u0432\u0430\u0448 \u043F\u0443\u0442\u044C \u0431\u0443\u0434\u0435\u0442
      \u0441\u043B\u0430\u0434\u043E\u043A, \u043A\u0430\u043A \u044D\u0442\u043E\u0442
      \u043C\u0451\u0434.\""
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175573
    m_Localized: "\u0422\u043E\u0441\u0442 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0441\u044F
      \u0441\u0431\u0438\u0432\u0447\u0438\u0432\u044B\u043C. \u0413\u043E\u0441\u0442\u0438
      \u0432\u0435\u0436\u043B\u0438\u0432\u043E \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0438\u0441\u044C,
      \u043D\u043E \u043E\u0441\u043E\u0431\u043E\u0433\u043E \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u044F
      \u0440\u0435\u0447\u044C \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175574
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u0438 \u0435\u0445\u0430\u0442\u044C \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175575
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u043B\u0441\u044F
      \u043C\u043E\u043B\u043E\u0434\u044B\u043C \u0438 \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435. \u0417\u0432\u0443\u043A\u0438 \u0437\u0443\u0440\u043D\u044B
      \u0435\u0449\u0451 \u0434\u043E\u043B\u0433\u043E \u043F\u043B\u044B\u043B\u0438
      \u043D\u0430\u0434 \u0441\u0442\u0435\u043F\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175576
    m_Localized: "\u0420\u0443\u0438\u043D\u044B \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175577
    m_Localized: "\u0423 \u0434\u043E\u0440\u043E\u0433\u0438 \u0432\u043E\u0437\u0432\u044B\u0448\u0430\u044E\u0442\u0441\u044F
      \u043F\u043E\u043B\u0443\u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043D\u044B\u0435
      \u0433\u043B\u0438\u043D\u044F\u043D\u044B\u0435 \u0441\u0442\u0435\u043D\u044B
      \u0441 \u0430\u0440\u043E\u0447\u043D\u044B\u043C \u043F\u0440\u043E\u0451\u043C\u043E\u043C.
      \u0411\u044B\u0432\u0448\u0438\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0439
      - \u043A\u0440\u044B\u0448\u0430 \u043E\u0431\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044C,
      \u0434\u0432\u043E\u0440 \u0437\u0430\u0440\u043E\u0441 \u0431\u0443\u0440\u044C\u044F\u043D\u043E\u043C,
      \u043D\u043E \u0441\u0442\u0435\u043D\u044B \u0435\u0449\u0451 \u0441\u0442\u043E\u044F\u0442.
      \u0412\u043D\u0443\u0442\u0440\u0438 - \u043E\u0441\u0442\u0430\u0442\u043A\u0438
      \u043A\u043E\u043D\u044E\u0448\u043D\u0438 \u0438 \u043A\u043E\u043B\u043E\u0434\u0435\u0446
      \u0441 \u0446\u0435\u043F\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175578
    m_Localized: "\u0423\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u043F\u0440\u0438\u0432\u0430\u043B
      \u0432 \u0443\u043A\u0440\u044B\u0442\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175579
    m_Localized: "\u0421\u0442\u0435\u043D\u044B \u0437\u0430\u0449\u0438\u0442\u0438\u043B\u0438
      \u043E\u0442 \u0432\u0435\u0442\u0440\u0430 \u0438 \u043F\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0445
      \u0433\u043B\u0430\u0437. \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0432\u0451\u043B
      \u043D\u043E\u0447\u044C \u0432 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u043C
      \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u0435. \u041A\u043E\u043B\u043E\u0434\u0435\u0446
      \u0434\u0430\u043B \u043C\u0443\u0442\u043D\u0443\u044E, \u043D\u043E \u043F\u0440\u0438\u0433\u043E\u0434\u043D\u0443\u044E
      \u0432\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175580
    m_Localized: "\u041E\u0431\u044B\u0441\u043A\u0430\u0442\u044C \u0440\u0443\u0438\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175581
    m_Localized: "\u041F\u043E\u0434 \u0437\u0430\u0432\u0430\u043B\u043E\u043C \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438\u0441\u044C
      \u0434\u043E\u0441\u043A\u0438, \u043A\u043E\u0432\u0430\u043D\u044B\u0435
      \u0433\u0432\u043E\u0437\u0434\u0438 \u0438 \u0437\u0430\u0431\u044B\u0442\u0430\u044F
      \u043A\u0435\u043C-\u0442\u043E \u0441\u0432\u044F\u0437\u043A\u0430 \u043C\u043E\u043D\u0435\u0442.
      \u041C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0434\u043B\u044F \u043F\u043E\u0447\u0438\u043D\u043A\u0438
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 - \u0431\u0435\u0441\u0446\u0435\u043D\u043D\u044B
      \u0432 \u0441\u0442\u0435\u043F\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175582
    m_Localized: "\u041E\u0431\u044B\u0441\u043A \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0434\u0430\u043B, \u0437\u0430\u0442\u043E \u0441\u0442\u0435\u043D\u0430
      \u0435\u0434\u0432\u0430 \u043D\u0435 \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0430\u0441\u044C
      \u043D\u0430 \u0433\u043E\u043B\u043E\u0432\u0443. \u041C\u0435\u0441\u0442\u043E
      \u043D\u0435\u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175583
    m_Localized: "\u0415\u0445\u0430\u0442\u044C \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175584
    m_Localized: "\u0420\u0443\u0438\u043D\u044B \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u043F\u043E\u0437\u0430\u0434\u0438. \u041D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E, \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D\u043E. \u0421\u0442\u0435\u043F\u044C
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175585
    m_Localized: "\u041F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175586
    m_Localized: "\u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0439:
      \u043A\u0440\u0435\u043F\u043A\u0438\u0435 \u0441\u0442\u0435\u043D\u044B \u0438\u0437
      \u043E\u0431\u043E\u0436\u0436\u0451\u043D\u043D\u043E\u0433\u043E \u043A\u0438\u0440\u043F\u0438\u0447\u0430,
      \u0440\u0435\u0437\u043D\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430,
      \u0438 \u0437\u0430\u043F\u0430\u0445 \u0436\u0430\u0440\u0435\u043D\u043E\u0433\u043E
      \u043C\u044F\u0441\u0430 \u0441 \u043A\u0443\u0445\u043D\u0438. \u0425\u043E\u0437\u044F\u0438\u043D
      - \u0434\u043E\u0440\u043E\u0434\u043D\u044B\u0439 \u043F\u0435\u0440\u0441
      \u0441 \u0447\u0451\u0440\u043D\u043E\u0439 \u0431\u043E\u0440\u043E\u0434\u043E\u0439
      - \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443,
      \u0440\u0430\u0437\u0432\u0435\u0434\u044F \u0440\u0443\u043A\u0438:\r\n\r\n<npc_speech
      lang=\"Persian\">\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A! \u0417\u0434\u0435\u0441\u044C
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E. \u0415\u0434\u0430,
      \u0432\u043E\u0434\u0430 \u0438 \u0431\u0430\u0437\u0430\u0440 - \u0443 \u043D\u0430\u0441
      \u0432\u0441\u0451 \u0435\u0441\u0442\u044C. \u041F\u0440\u043E\u0448\u0443!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175587
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043D\u043E\u0447\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175588
    m_Localized: "\u0413\u043E\u0440\u044F\u0447\u0430\u044F \u0435\u0434\u0430,
      \u043A\u0440\u043E\u0432 \u0438 \u0431\u0430\u043D\u044F. \u041B\u044E\u0434\u0438
      \u0432\u044B\u043C\u044B\u043B\u0438\u0441\u044C, \u0437\u0430\u043B\u0430\u0442\u0430\u043B\u0438
      \u043E\u0434\u0435\u0436\u0434\u0443, \u0432\u044B\u0441\u043F\u0430\u043B\u0438\u0441\u044C
      \u043D\u0430 \u043A\u043E\u0432\u0440\u0430\u0445. \u0423\u0442\u0440\u043E\u043C
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u044B\u0435\u0445\u0430\u043B
      \u043E\u0431\u043D\u043E\u0432\u043B\u0451\u043D\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175589
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C \u043D\u0430
      \u0431\u0430\u0437\u0430\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175590
    m_Localized: "\u041F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435 \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u0433\u043E
      \u043E\u0442\u043A\u0440\u044B\u043B\u043E \u0434\u043E\u0441\u0442\u0443\u043F
      \u043A \u043B\u0443\u0447\u0448\u0438\u043C \u0446\u0435\u043D\u0430\u043C.
      \u0412\u044B \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u043B\u0438 \u0444\u043B\u0430\u043A\u043E\u043D
      \u043D\u0438\u0448\u0430\u043F\u0443\u0440\u0441\u043A\u0438\u0445 \u0434\u0443\u0445\u043E\u0432
      \u0437\u0430 \u043F\u043E\u043B\u0446\u0435\u043D\u044B \u0438 \u0432\u044B\u0433\u043E\u0434\u043D\u043E
      \u0441\u0431\u044B\u043B\u0438 \u0447\u0430\u0441\u0442\u044C \u0442\u043E\u0432\u0430\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175591
    m_Localized: "\u0411\u0435\u0437 \u044F\u0437\u044B\u043A\u0430 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C \u043D\u0430 \u043F\u0430\u043B\u044C\u0446\u0430\u0445.
      \u0414\u0443\u0445\u0438 \u043A\u0443\u043F\u043B\u0435\u043D\u044B, \u043D\u043E
      \u0441 \u043F\u0435\u0440\u0435\u043F\u043B\u0430\u0442\u043E\u0439. \u0425\u043E\u0437\u044F\u0438\u043D
      \u0443\u043B\u044B\u0431\u0430\u043B\u0441\u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0448\u0438\u0440\u043E\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175592
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u043D\u0430\u043B\u0430\u0436\u0438\u0432\u0430\u0435\u0442
      \u0441\u0432\u044F\u0437\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175593
    m_Localized: "\u0412\u0430\u0448 \u043A\u0443\u043F\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u043F\u0440\u043E\u0432\u0451\u043B \u0432\u0435\u0447\u0435\u0440 \u0432
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0430\u0445 \u0441 \u043C\u0435\u0441\u0442\u043D\u044B\u043C\u0438
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430\u043C\u0438. \u0423\u0442\u0440\u043E\u043C
      \u043E\u0431\u044A\u044F\u0432\u0438\u043B: \"\u042F \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0441\u044F
      - \u0434\u0443\u0445\u0438 \u0432 \u043F\u043E\u0434\u0430\u0440\u043E\u043A,
      \u0430 \u043D\u0430\u0448 \u0442\u043E\u0432\u0430\u0440 \u0443\u0445\u043E\u0434\u0438\u0442
      \u043F\u043E \u043E\u0442\u043B\u0438\u0447\u043D\u043E\u0439 \u0446\u0435\u043D\u0435.\""
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175594
    m_Localized: "\u041F\u043E\u043B\u0434\u043D\u044F \u0443\u0448\u043B\u043E \u043D\u0430
      \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u043A\u0443 \u0433\u0440\u0443\u0437\u0430.
      \u0412\u0435\u0440\u0451\u0432\u043A\u0438 \u0437\u0430\u0442\u044F\u043D\u0443\u0442\u044B
      \u043D\u0430\u043C\u0435\u0440\u0442\u0432\u043E. \u0412\u0440\u0435\u043C\u044F
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E, \u043D\u043E \u0442\u043E\u0432\u0430\u0440
      \u0446\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175595
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u043C\u0435\u0448\u043E\u043A
      \u0432\u0441\u0451-\u0442\u0430\u043A\u0438 \u0440\u0443\u0445\u043D\u0443\u043B.
      \u0417\u0430 \u043D\u0438\u043C \u043F\u043E\u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C
      \u0435\u0449\u0451 \u0434\u0432\u0430. \u0427\u0430\u0441\u0442\u044C \u0442\u043E\u0432\u0430\u0440\u0430
      \u0440\u0430\u0437\u0431\u0438\u043B\u0430\u0441\u044C, \u0447\u0430\u0441\u0442\u044C
      \u0443\u043A\u0430\u0442\u0438\u043B\u0430\u0441\u044C \u0432 \u043A\u0430\u043D\u0430\u0432\u0443.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u0431\u0440\u043E\u0441\u0438\u043B\u0438\u0441\u044C
      \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C - \u043D\u043E \u043D\u0435
      \u0432\u0441\u0451 \u0441\u043F\u0430\u0441\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175596
    m_Localized: "\u0410\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u043F\u0435\u0440\u0435\u043B\u043E\u0436\u0438\u0442\u044C
      \u043E\u043F\u0430\u0441\u043D\u044B\u0435 \u0442\u044E\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175597
    m_Localized: "\u0421\u0430\u043C\u044B\u0435 \u043D\u0435\u043D\u0430\u0434\u0451\u0436\u043D\u044B\u0435
      \u0442\u044E\u043A\u0438 \u043F\u0435\u0440\u0435\u043B\u043E\u0436\u0435\u043D\u044B
      \u0432\u043D\u0438\u0437 \u0438 \u0443\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u044B.
      \u0411\u044B\u0441\u0442\u0440\u043E \u0438 \u0442\u043E\u043B\u043A\u043E\u0432\u043E
      - \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175598
    m_Localized: "\u041F\u0440\u0438 \u043F\u0435\u0440\u0435\u043A\u043B\u0430\u0434\u043A\u0435
      \u043E\u0434\u0438\u043D \u0442\u044E\u043A \u0432\u044B\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B
      \u0438 \u0443\u0434\u0430\u0440\u0438\u043B \u043F\u043E \u0431\u043E\u0440\u0442\u0443
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438. \u0414\u043E\u0441\u043A\u0430
      \u0442\u0440\u0435\u0441\u043D\u0443\u043B\u0430, \u0430 \u043C\u0435\u0448\u043E\u043A
      \u043B\u043E\u043F\u043D\u0443\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175599
    m_Localized: "\u0411\u0430\u0437\u0430\u0440 \u043D\u0430 \u043F\u043E\u0434\u0441\u0442\u0443\u043F\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175600
    m_Localized: "\u041D\u0430 \u043F\u043E\u0434\u044A\u0435\u0437\u0434\u0435 \u043A
      \u0433\u043E\u0440\u043E\u0434\u0443 \u0440\u0430\u0441\u043A\u0438\u043D\u0443\u043B\u0441\u044F
      \u0441\u0442\u0438\u0445\u0438\u0439\u043D\u044B\u0439 \u0431\u0430\u0437\u0430\u0440:
      \u043D\u0430\u0432\u0435\u0441\u044B \u0438\u0437 \u043F\u043E\u043B\u043E\u0441\u0430\u0442\u043E\u0439
      \u0442\u043A\u0430\u043D\u0438, \u0433\u043E\u0440\u044B \u0444\u0440\u0443\u043A\u0442\u043E\u0432
      \u0438 \u0437\u0435\u043B\u0435\u043D\u0438, \u0434\u044B\u043C\u044F\u0449\u0438\u0435\u0441\u044F
      \u0436\u0430\u0440\u043E\u0432\u043D\u0438 \u0441 \u043A\u0435\u0431\u0430\u0431\u043E\u043C.
      \u0421\u0442\u0435\u043A\u043B\u043E\u0434\u0443\u0432\u044B \u0432\u044B\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u043F\u0435\u0440\u0435\u043B\u0438\u0432\u0430\u044E\u0449\u0443\u044E\u0441\u044F
      \u043D\u0430 \u0441\u043E\u043B\u043D\u0446\u0435 \u043F\u043E\u0441\u0443\u0434\u0443,
      \u043A\u0440\u0430\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0438 \u0440\u0430\u0437\u0432\u0435\u0441\u0438\u043B\u0438
      \u0442\u043A\u0430\u043D\u0438 \u0432\u0441\u0435\u0445 \u0446\u0432\u0435\u0442\u043E\u0432.
      \u0428\u0443\u043C, \u043A\u0440\u0438\u043A\u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432
      \u0438 \u0437\u0432\u043E\u043D \u043C\u043E\u043D\u0435\u0442 \u0441\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u0432 \u0433\u0443\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175601
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175602
    m_Localized: "\u041E\u0441\u0442\u0440\u044B\u0439 \u0433\u043B\u0430\u0437 \u043E\u0442\u043B\u0438\u0447\u0438\u043B
      \u0434\u0430\u043C\u0430\u0441\u0441\u043A\u043E\u0435 \u0441\u0442\u0435\u043A\u043B\u043E
      \u043E\u0442 \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0438. \u041A\u0443\u043F\u0438\u043B\u0438
      \u043F\u043E \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u0446\u0435\u043D\u0435
      - \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u0435 \u0437\u0430 \u044D\u0442\u043E
      \u0434\u0430\u0434\u0443\u0442 \u0432\u0442\u0440\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175603
    m_Localized: "\u0421\u0442\u0435\u043A\u043B\u043E \u043A\u0443\u043F\u043B\u0435\u043D\u043E,
      \u043D\u043E \u043F\u043E\u0437\u0436\u0435 \u0432\u044B\u044F\u0441\u043D\u0438\u043B\u043E\u0441\u044C,
      \u0447\u0442\u043E \u0447\u0430\u0441\u0442\u044C - \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0430
      \u0438\u0437 \u043E\u043A\u0440\u0430\u0448\u0435\u043D\u043D\u043E\u0439 \u0433\u043B\u0438\u043D\u044B.
      \u0421\u043B\u0438\u0448\u043A\u043E\u043C \u043F\u043E\u0437\u0434\u043D\u043E
      \u0441\u043F\u043E\u0440\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175604
    m_Localized: "\u041F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175605
    m_Localized: "\u0421\u0432\u0435\u0436\u0438\u0435 \u043B\u0435\u043F\u0451\u0448\u043A\u0438,
      \u0441\u0443\u0448\u0451\u043D\u043E\u0435 \u043C\u044F\u0441\u043E, \u043A\u0443\u0432\u0448\u0438\u043D\u044B
      \u0441 \u0432\u043E\u0434\u043E\u0439. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u043B\u0441\u044F \u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C\u0438
      \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439
      \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175606
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0437\u043D\u0430\u0435\u0442 \u043B\u0443\u0447\u0448\u0438\u0445
      \u043F\u0440\u043E\u0434\u0430\u0432\u0446\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175607
    m_Localized: "\u0412\u0430\u0448 \u0441\u043F\u0443\u0442\u043D\u0438\u043A-\u043A\u0443\u043F\u0435\u0446
      \u043F\u0440\u043E\u0432\u0451\u043B \u043A \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u043C\u0443
      \u0441\u0442\u0435\u043A\u043B\u043E\u0434\u0443\u0432\u0443 \u0432 \u0433\u043B\u0443\u0431\u0438\u043D\u0435
      \u0431\u0430\u0437\u0430\u0440\u0430. \u0426\u0435\u043D\u044B \u0432\u0434\u0432\u043E\u0435
      \u043D\u0438\u0436\u0435, \u0430 \u0441\u0442\u0435\u043A\u043B\u043E - \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435
      \u0434\u0430\u043C\u0430\u0441\u0441\u043A\u043E\u0435. \u0412 \u043F\u0440\u0438\u0434\u0430\u0447\u0443
      \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u043B\u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u0443 \u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0433\u043E
      \u043F\u043E\u0441\u0442\u0430\u0432\u0449\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175608
    m_Localized: "\u0422\u0430\u043D\u0441\u043A\u0438\u0439 \u043D\u0430\u0431\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175609
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0443 \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u0430\u0436\u0438\u0432\u0430\u0435\u0442
      \u043E\u0442\u0440\u044F\u0434 \u0442\u0430\u043D\u0441\u043A\u0438\u0445 \u0441\u043E\u043B\u0434\u0430\u0442.
      \u041E\u0444\u0438\u0446\u0435\u0440 \u0432 \u043B\u0430\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u043C
      \u0448\u043B\u0435\u043C\u0435 \u043E\u0431\u044A\u044F\u0432\u043B\u044F\u0435\u0442
      \u0441\u0431\u043E\u0440 \u043C\u0443\u0436\u0447\u0438\u043D \u043D\u0430
      \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u0443\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0439. \u041E\u043D
      \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443:\r\n\r\n<npc_speech
      lang=\"Chinese\">\u0423\u043A\u0430\u0437 \u0438\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0430!
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043E\u0431\u043E\u0437 \u043E\u0431\u044F\u0437\u0430\u043D \u0432\u044B\u0434\u0435\u043B\u0438\u0442\u044C
      \u0434\u0432\u0443\u0445 \u043A\u0440\u0435\u043F\u043A\u0438\u0445 \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u043E\u0432
      \u0438\u043B\u0438 \u0443\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0442\u0440\u0438
      \u0441\u0432\u044F\u0437\u043A\u0438 \u043C\u043E\u043D\u0435\u0442 \u043E\u0442\u043A\u0443\u043F\u0430.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175610
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043E\u0442\u043A\u0443\u043F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175611
    m_Localized: "\u0421\u0435\u0440\u0435\u0431\u0440\u043E \u043F\u0435\u0440\u0435\u0448\u043B\u043E
      \u0432 \u043A\u0430\u0437\u043D\u0443. \u041E\u0444\u0438\u0446\u0435\u0440
      \u0432\u044B\u043F\u0438\u0441\u0430\u043B \u043E\u0441\u0432\u043E\u0431\u043E\u0436\u0434\u0435\u043D\u0438\u0435
      \u0438 \u0436\u0435\u0441\u0442\u043E\u043C \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D. \u0417\u0430\u043A\u043E\u043D
      \u0441\u043E\u0431\u043B\u044E\u0434\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175612
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u043E\u0442\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175613
    m_Localized: "\u0413\u0440\u0430\u043C\u043E\u0442\u043D\u0430\u044F \u0440\u0435\u0447\u044C
      \u043D\u0430 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C \u0438
      \u0441\u0441\u044B\u043B\u043A\u0430 \u043D\u0430 \u0438\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0441\u043A\u0438\u0439
      \u0443\u043A\u0430\u0437 \u043E \u0442\u0440\u0430\u043D\u0437\u0438\u0442\u043D\u044B\u0445
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430\u0445 \u0443\u0431\u0435\u0434\u0438\u043B\u0438
      \u043E\u0444\u0438\u0446\u0435\u0440\u0430. \u041E\u043D \u043E\u0442\u0441\u0430\u043B\u044E\u0442\u043E\u0432\u0430\u043B
      \u0438 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0431\u0435\u0437 \u043F\u043B\u0430\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175614
    m_Localized: "\u041E\u0444\u0438\u0446\u0435\u0440 \u043D\u0435 \u043F\u043E\u0434\u0434\u0430\u043B\u0441\u044F
      \u043D\u0430 \u0443\u0433\u043E\u0432\u043E\u0440\u044B \u0438 \u043F\u0440\u0438\u0433\u0440\u043E\u0437\u0438\u043B
      \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435\u043C. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0441 \u043D\u0430\u0434\u0431\u0430\u0432\u043A\u043E\u0439
      \u0437\u0430 \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175615
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u0434\u0432\u0443\u0445 \u043B\u044E\u0434\u0435\u0439
      \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175616
    m_Localized: "\u0414\u0432\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0430
      \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043D\u0430 \u0441\u0442\u0440\u043E\u0439\u043A\u0435.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0434\u0432\u0438\u043D\u0443\u043B\u0438\u0441\u044C
      \u0434\u0430\u043B\u044C\u0448\u0435 \u0432 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0438.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0441\u043B\u0430\u0431,
      \u0438 \u0434\u0443\u0445 \u043F\u043E\u0434\u043E\u0440\u0432\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175617
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438-\u0445\u0430\u0434\u0436\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175618
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u0433\u0440\u0443\u043F\u043F\u0430 \u0443\u0441\u0442\u0430\u043B\u044B\u0445
      \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u043E\u0432 \u0432 \u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0445
      \u043F\u043B\u0430\u0449\u0430\u0445 - \u0447\u0451\u0442\u043A\u0438 \u043D\u0430
      \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u044F\u0445, \u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u043F\u043E\u0441\u043E\u0445 \u0438\u0437 \u0442\u0430\u043C\u0430\u0440\u0438\u0441\u043A\u043E\u0432\u043E\u0433\u043E
      \u0434\u0435\u0440\u0435\u0432\u0430. \u041E\u043D\u0438 \u0434\u0435\u0440\u0436\u0430\u0442
      \u043F\u0443\u0442\u044C \u043A \u041C\u0435\u043A\u043A\u0435 \u0447\u0435\u0440\u0435\u0437
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0435 \u0441\u0442\u0435\u043F\u0438.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u0438\u0437 \u043D\u0438\u0445
      \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F:\r\n\r\n<npc_speech
      lang=\"Arabic\">\u041C\u0438\u0440 \u0432\u0430\u043C, \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043B\u044E\u0434! \u041C\u044B - \u0445\u0430\u0434\u0436\u0438 \u0438\u0437
      \u041C\u0430\u0432\u0435\u0440\u0430\u043D\u043D\u0430\u0445\u0440\u0430. \u041E\u0434\u0438\u043D
      \u0438\u0437 \u0431\u0440\u0430\u0442\u044C\u0435\u0432 \u043D\u0430\u0448\u0438\u0445
      \u0437\u0430\u043D\u0435\u043C\u043E\u0433. \u041D\u0435\u0442 \u043B\u0438
      \u0443 \u0432\u0430\u0441 \u0441\u043D\u0430\u0434\u043E\u0431\u044C\u044F?</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175619
    m_Localized: "\u041F\u043E\u043C\u043E\u0447\u044C \u0431\u043E\u043B\u044C\u043D\u043E\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175620
    m_Localized: "\u0418\u0437 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043D\u044B\u0445
      \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u0432\u044B\u0434\u0435\u043B\u0438\u043B\u0438
      \u043B\u0435\u0447\u0435\u0431\u043D\u044B\u0435 \u0442\u0440\u0430\u0432\u044B
      \u0438 \u0447\u0438\u0441\u0442\u0443\u044E \u0432\u043E\u0434\u0443. \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438
      \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0438\u043B\u0438 \u043F\u0443\u0442\u044C
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0438 \u043F\u043E\u0434\u0430\u0440\u0438\u043B\u0438
      \u0441\u0432\u044F\u0437\u043A\u0443 \u0442\u0430\u043C\u0430\u0440\u0438\u0441\u043A\u0430
      - \u0434\u043E\u0431\u0440\u043E\u0435 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E
      \u043E\u0442 \u0440\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175621
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175622
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438 \u043A\u0438\u0432\u043D\u0443\u043B\u0438
      \u0441 \u043F\u0435\u0447\u0430\u043B\u044C\u044E \u0438 \u0434\u0432\u0438\u043D\u0443\u043B\u0438\u0441\u044C
      \u0434\u0430\u043B\u044C\u0448\u0435. \u0411\u043E\u043B\u044C\u043D\u043E\u0433\u043E
      \u043F\u043E\u0432\u0435\u043B\u0438 \u043F\u043E\u0434 \u0440\u0443\u043A\u0438.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u043B\u0438\u0441\u044C
      - \u043D\u0430 \u0434\u0443\u0448\u0435 \u043D\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175623
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442
      \u0431\u043E\u043B\u044C\u043D\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175624
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u0431\u043E\u043B\u044C\u043D\u043E\u0433\u043E \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u043D\u0430 \u043D\u043E\u0433\u0438 \u0437\u0430 \u0447\u0430\u0441. \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438
      \u0431\u044B\u043B\u0438 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u044B.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u0434\u043E\u0441\u0442\u0430\u043B
      \u0438\u0437 \u0441\u043A\u043B\u0430\u0434\u043E\u043A \u043F\u043B\u0430\u0449\u0430
      \u043A\u0443\u0441\u043E\u043A \u0431\u0435\u043B\u043E\u0433\u043E \u043B\u0430\u0434\u0430\u043D\u0430:
      \"\u041D\u0451\u0441 \u043A \u041A\u0430\u0430\u0431\u0435 - \u043D\u043E \u0410\u043B\u043B\u0430\u0445
      \u043F\u043E\u0441\u043B\u0430\u043B \u043D\u0430\u043C \u0442\u0435\u0431\u044F.
      \u0412\u043E\u0437\u044C\u043C\u0438, \u0446\u0435\u043B\u0438\u0442\u0435\u043B\u044C.\""
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175625
    m_Localized: "\u0424\u0430\u043B\u044C\u0448\u0438\u0432\u044B\u0435 \u043C\u043E\u043D\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175626
    m_Localized: "\u041D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435 \u043E\u0434\u0438\u043D
      \u0438\u0437 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u043E\u0432
      \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442, \u0447\u0442\u043E \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043C\u043E\u043D\u0435\u0442 \u0432 \u043A\u043E\u0448\u0435\u043B\u0435
      \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442 \u0438\u043D\u0430\u0447\u0435:
      \u043B\u0435\u0433\u0447\u0435, \u0442\u0443\u0441\u043A\u043B\u0435\u0435,
      \u043A\u0440\u0430\u0439 \u043D\u0435\u0440\u043E\u0432\u043D\u044B\u0439.
      \u041A\u0442\u043E-\u0442\u043E \u043F\u043E\u0434\u0441\u0443\u043D\u0443\u043B
      \u0444\u0430\u043B\u044C\u0448\u0438\u0432\u044B\u0435 \u0434\u0438\u0440\u0445\u0430\u043C\u044B,
      \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E, \u043D\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u043C
      \u0440\u044B\u043D\u043A\u0435. \u0415\u0441\u043B\u0438 \u0440\u0430\u0441\u043F\u043B\u0430\u0442\u0438\u0442\u044C\u0441\u044F
      \u0438\u043C\u0438, \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0440\u0432\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175627
    m_Localized: "\u0412\u044B\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175628
    m_Localized: "\u0424\u0430\u043B\u044C\u0448\u0438\u0432\u044B\u0435 \u043C\u043E\u043D\u0435\u0442\u044B
      \u043F\u043E\u043B\u0435\u0442\u0435\u043B\u0438 \u0432 \u043A\u0430\u043D\u0430\u0432\u0443.
      \u041F\u043E\u0442\u0435\u0440\u044F \u043E\u0449\u0443\u0442\u0438\u043C\u0430\u044F,
      \u043D\u043E \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0434\u043E\u0440\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175629
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u043E\u0442\u043B\u0438\u0447\u0438\u0442\u044C \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175630
    m_Localized: "\u041E\u043F\u044B\u0442\u043D\u044B\u0439 \u0433\u043B\u0430\u0437
      \u0440\u0430\u0437\u043B\u0438\u0447\u0438\u043B \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0438
      \u043F\u043E \u0432\u0435\u0441\u0443 \u0438 \u0437\u0432\u043E\u043D\u0443.
      \u0412\u044B\u0431\u0440\u043E\u0448\u0435\u043D\u043E \u043C\u0435\u043D\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175631
    m_Localized: "\u0427\u0430\u0441\u0442\u044C \u043F\u043E\u0434\u0434\u0435\u043B\u043E\u043A
      \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u043F\u043E \u043E\u0448\u0438\u0431\u043A\u0435.
      \u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u0440\u044B\u043D\u043A\u0435
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0437\u0430\u043C\u0435\u0442\u0438\u043B
      \u0444\u0430\u043B\u044C\u0448\u044C: \u0441\u043A\u0430\u043D\u0434\u0430\u043B
      \u0438 \u043F\u043E\u0442\u0435\u0440\u044F \u0434\u043E\u0432\u0435\u0440\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175632
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0437\u043D\u0430\u0435\u0442 \u0447\u0435\u043A\u0430\u043D\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175633
    m_Localized: "\u0412\u0430\u0448 \u043A\u0443\u043F\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u043F\u0435\u0440\u0435\u0431\u0440\u0430\u043B \u043A\u0430\u0436\u0434\u0443\u044E
      \u043C\u043E\u043D\u0435\u0442\u0443, \u0449\u0451\u043B\u043A\u0430\u044F
      \u043F\u043E \u043D\u0435\u0439 \u043D\u043E\u0433\u0442\u0435\u043C. \"\u0412\u043E\u0442
      \u044D\u0442\u0438 - \u043C\u0435\u0434\u044C \u0441 \u0441\u0435\u0440\u0435\u0431\u0440\u0435\u043D\u0438\u0435\u043C.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0447\u0438\u0441\u0442\u044B\u0435.\"
      \u041F\u043E\u0442\u0435\u0440\u0438 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175634
    m_Localized: "\u041D\u043E\u0447\u043D\u043E\u0439 \u043D\u0430\u0431\u0435\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175635
    m_Localized: "\u041F\u043E\u0441\u0440\u0435\u0434\u0438 \u043D\u043E\u0447\u0438
      \u0442\u0438\u0448\u0438\u043D\u0443 \u0440\u0430\u0437\u0440\u044B\u0432\u0430\u0435\u0442
      \u043A\u0440\u0438\u043A \u0434\u043E\u0437\u043E\u0440\u043D\u043E\u0433\u043E.
      \u0422\u0451\u043C\u043D\u044B\u0435 \u0444\u0438\u0433\u0443\u0440\u044B \u043C\u0435\u043B\u044C\u043A\u0430\u044E\u0442
      \u043C\u0435\u0436\u0434\u0443 \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u043C\u0438,
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438 \u043F\u043E\u0434\u043A\u0440\u0430\u043B\u0438\u0441\u044C
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435. \u0424\u0430\u043A\u0435\u043B\u043E\u0432
      \u043D\u0435 \u0437\u0430\u0436\u0438\u0433\u0430\u044E\u0442: \u0431\u044C\u044E\u0442
      \u043D\u0430\u043E\u0449\u0443\u043F\u044C, \u0445\u0432\u0430\u0442\u0430\u044E\u0442
      \u0447\u0442\u043E \u043F\u043E\u0434 \u0440\u0443\u043A\u0443 \u043F\u043E\u043F\u0430\u0434\u0451\u0442\u0441\u044F.
      \u041B\u044F\u0437\u0433 \u043C\u0435\u0442\u0430\u043B\u043B\u0430 \u0438
      \u043A\u0440\u0438\u043A\u0438 \u0441\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u0432 \u0445\u0430\u043E\u0441 \u043D\u043E\u0447\u043D\u043E\u0433\u043E
      \u0431\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175636
    m_Localized: "\u0414\u0430\u0442\u044C \u043E\u0442\u043F\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175637
    m_Localized: "\u0411\u043E\u0439 \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435
      - \u043A\u043E\u0448\u043C\u0430\u0440. \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438, \u0443\u043D\u0435\u0441\u044F
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0435\u0448\u043A\u043E\u0432.
      \u0423\u0442\u0440\u043E\u043C \u043F\u043E\u0434\u0441\u0447\u0438\u0442\u0430\u043B\u0438
      \u0443\u0431\u044B\u0442\u043A\u0438: \u0442\u043E\u0432\u0430\u0440 \u0443\u043A\u0440\u0430\u0434\u0435\u043D,
      \u0431\u043E\u0447\u043E\u043D\u043E\u043A \u0441 \u0432\u043E\u0434\u043E\u0439
      \u043F\u0440\u043E\u0431\u0438\u0442, \u043B\u044E\u0434\u0438 \u0438\u0437\u0431\u0438\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175638
    m_Localized: "\u041E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u0442\u044C
      \u043E\u0431\u043E\u0440\u043E\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175639
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u044B\u0435 \u043A\u043E\u043C\u0430\u043D\u0434\u044B
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435: \u043B\u044E\u0434\u0438
      \u0432\u0441\u0442\u0430\u043B\u0438 \u0441\u043F\u0438\u043D\u0430 \u043A
      \u0441\u043F\u0438\u043D\u0435, \u0437\u0430\u0436\u0433\u043B\u0438 \u0444\u0430\u043A\u0435\u043B\u044B,
      \u0441\u043E\u043C\u043A\u043D\u0443\u043B\u0438 \u043F\u043E\u0432\u043E\u0437\u043A\u0438.
      \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438, \u043E\u0441\u043B\u0435\u043F\u043B\u0451\u043D\u043D\u044B\u0435
      \u043E\u0433\u043D\u0451\u043C, \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438
      \u043F\u043E\u0447\u0442\u0438 \u0441 \u043F\u0443\u0441\u0442\u044B\u043C\u0438
      \u0440\u0443\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175640
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u043A\u0430 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u0442\u044C
      \u043E\u0431\u043E\u0440\u043E\u043D\u0443 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044C
      - \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u043B\u044E\u0434\u0438
      \u043C\u0435\u0448\u0430\u043B\u0438 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0443.
      \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438 \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438\u0441\u044C
      \u0437\u0430\u043C\u0435\u0448\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u043C
      \u0438 \u0443\u0442\u0430\u0449\u0438\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043F\u0440\u0438 \u043E\u0431\u044B\u0447\u043D\u043E\u043C
      \u0431\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175641
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043D\u0435\u0441\u0451\u0442
      \u0432\u0430\u0445\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175642
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0443\u0441\u043B\u044B\u0448\u0430\u043B
      \u0448\u043E\u0440\u043E\u0445 \u0440\u0430\u043D\u044C\u0448\u0435 \u0434\u043E\u0437\u043E\u0440\u043D\u043E\u0433\u043E
      \u0438 \u043F\u043E\u0434\u043D\u044F\u043B \u0442\u0440\u0435\u0432\u043E\u0433\u0443.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B
      \u043D\u0430\u043F\u0430\u0434\u0430\u0432\u0448\u0438\u0445 \u0432 \u0431\u043E\u0435\u0432\u043E\u043C
      \u043F\u043E\u0440\u044F\u0434\u043A\u0435. \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438,
      \u0443\u0432\u0438\u0434\u0435\u0432 \u0433\u043E\u0442\u043E\u0432\u043D\u043E\u0441\u0442\u044C,
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438, \u043D\u0435 \u0440\u0438\u0441\u043A\u043D\u0443\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175643
    m_Localized: "\u041F\u0440\u0438\u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0439
      \u0442\u043E\u0440\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175644
    m_Localized: "\u0423 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438 \u0434\u043E\u0440\u043E\u0433
      \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0441\u044F \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0442\u043E\u0440\u0433: \u0442\u0440\u0438-\u0447\u0435\u0442\u044B\u0440\u0435
      \u0442\u0435\u043B\u0435\u0433\u0438 \u0441 \u043D\u0430\u0432\u0435\u0441\u0430\u043C\u0438,
      \u0440\u0430\u0437\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0439 \u0442\u043E\u0432\u0430\u0440
      \u0438 \u0434\u044E\u0436\u0438\u043D\u0430 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0435\u0439.
      \u041A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u0435 \u043F\u0440\u043E\u0434\u0430\u044E\u0442
      \u0441\u0443\u0445\u043E\u0444\u0440\u0443\u043A\u0442\u044B, \u0437\u0435\u0440\u043D\u043E
      \u0438 \u0434\u043E\u043C\u043E\u0442\u043A\u0430\u043D\u043E\u0435 \u043F\u043E\u043B\u043E\u0442\u043D\u043E.
      \u0422\u043E\u0440\u0433\u043E\u0432\u043B\u044F \u0438\u0434\u0451\u0442 \u0431\u043E\u0439\u043A\u043E,
      \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u0431\u0435\u0437\u043B\u044E\u0434\u043D\u043E\u0441\u0442\u044C
      \u0440\u0430\u0432\u043D\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175645
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0441\u0443\u0445\u043E\u0444\u0440\u0443\u043A\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175646
    m_Localized: "\u041C\u0435\u0448\u043E\u0447\u0435\u043A \u0441\u0443\u0448\u0451\u043D\u044B\u0445
      \u0430\u0431\u0440\u0438\u043A\u043E\u0441\u043E\u0432 \u0438 \u0438\u0437\u044E\u043C\u0430
      - \u0437\u043E\u043B\u043E\u0442\u043E \u0432 \u0434\u043E\u0440\u043E\u0433\u0435.
      \u0421\u043B\u0430\u0434\u043A\u043E\u0435 \u043B\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E
      \u043F\u043E\u0434\u043D\u044F\u043B\u043E \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175647
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175648
    m_Localized: "\u041A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u0435 \u0441 \u0440\u0430\u0434\u043E\u0441\u0442\u044C\u044E
      \u043A\u0443\u043F\u0438\u043B\u0438 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0435
      \u0442\u043E\u0432\u0430\u0440\u044B. \u0422\u043E\u0440\u0433 \u043F\u0440\u043E\u0448\u0451\u043B
      \u0432\u044B\u0433\u043E\u0434\u043D\u043E - \u0434\u0435\u043D\u044C\u0433\u0438
      \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043D\u043E\u0439 \u043A\u0430\u0437\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175649
    m_Localized: "\u041A\u0440\u0435\u0441\u0442\u044C\u044F\u043D\u0435 \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u043B\u0438\u0441\u044C
      \u0443\u043F\u043E\u0440\u043D\u043E. \u041F\u0440\u043E\u0434\u0430\u043D\u043E
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E, \u0438 \u043F\u043E \u043D\u0435\u0432\u044B\u0441\u043E\u043A\u043E\u0439
      \u0446\u0435\u043D\u0435. \u0414\u0435\u0440\u0435\u0432\u0435\u043D\u0441\u043A\u0430\u044F
      \u0445\u0432\u0430\u0442\u043A\u0430 \u043D\u0435 \u0443\u0441\u0442\u0443\u043F\u0430\u0435\u0442
      \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175650
    m_Localized: "\u041F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175651
    m_Localized: "\u0417\u0435\u0440\u043D\u043E, \u043B\u0435\u043F\u0451\u0448\u043A\u0438
      \u0438 \u0432\u044F\u043B\u0435\u043D\u043E\u0435 \u043C\u044F\u0441\u043E
      \u043F\u043E \u0447\u0435\u0441\u0442\u043D\u044B\u043C \u0446\u0435\u043D\u0430\u043C.
      \u041F\u0440\u043E\u0441\u0442\u0430\u044F \u0435\u0434\u0430, \u043D\u043E
      \u0437\u0430\u043F\u0430\u0441\u044B \u043F\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175652
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0443\u043A\u0440\u044B\u043B\u0441\u044F
      \u043F\u043E\u0434 \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u043C\u0438,
      \u043D\u0430\u043A\u0440\u044B\u0432 \u0442\u044E\u043A\u0438 \u043F\u0440\u043E\u043C\u0430\u0441\u043B\u0435\u043D\u043D\u043E\u0439
      \u0442\u043A\u0430\u043D\u044C\u044E. \u0411\u0443\u0440\u044F \u0431\u0443\u0448\u0435\u0432\u0430\u043B\u0430
      \u0434\u043E \u0437\u0430\u043A\u0430\u0442\u0430. \u041A \u0443\u0442\u0440\u0443
      \u0432\u0441\u0451 \u043F\u043E\u043A\u0440\u044B\u0442\u043E \u0442\u043E\u043B\u0441\u0442\u044B\u043C
      \u0441\u043B\u043E\u0435\u043C \u043F\u044B\u043B\u0438, \u043D\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0446\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175653
    m_Localized: "\u0412 \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u043E\u0442
      \u0434\u043E\u0440\u043E\u0433\u0438 \u043D\u0430\u0448\u043B\u043E\u0441\u044C
      \u0440\u0443\u0441\u043B\u043E \u0432\u044B\u0441\u043E\u0445\u0448\u0435\u0439
      \u0440\u0435\u043A\u0438 - \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0435
      \u0438 \u0437\u0430\u0449\u0438\u0449\u0451\u043D\u043D\u043E\u0435 \u043E\u0442
      \u0432\u0435\u0442\u0440\u0430. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0441\u044F \u0432 \u043D\u0435\u0433\u043E
      \u0438 \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u043B \u0431\u0443\u0440\u044E
      \u0441 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u043C\u0438
      \u043F\u043E\u0442\u0435\u0440\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175654
    m_Localized: "\u041F\u043E\u0438\u0441\u043A\u0438 \u0443\u043A\u0440\u044B\u0442\u0438\u044F
      \u0443\u0432\u0435\u043B\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0432
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443. \u0412 \u043C\u0443\u0442\u043D\u043E\u0439
      \u043F\u044B\u043B\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0434\u043E\u0440\u043E\u0433\u0443,
      \u0430 \u0431\u0443\u0440\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u0441\u0438\u043B\u0438\u043B\u0430\u0441\u044C.
      \u0412\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u043D\u0430 \u0442\u0440\u0430\u043A\u0442
      \u043B\u0438\u0448\u044C \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443
      \u0443\u0442\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175655
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u0443\u043A\u0440\u044B\u0442\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175656
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E
      \u043F\u043E\u0432\u0451\u043B \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043A
      \u043D\u0438\u0437\u0438\u043D\u0435, \u0443\u043A\u0440\u044B\u0442\u043E\u0439
      \u043E\u0442 \u0432\u0435\u0442\u0440\u0430. \"\u042F \u0431\u044B\u043B \u0437\u0434\u0435\u0441\u044C
      \u0432 \u043F\u0440\u043E\u0448\u043B\u0443\u044E \u0431\u0443\u0440\u044E.
      \u0427\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u0447\u0430\u0441\u0430
      \u0441\u0442\u0438\u0445\u043D\u0435\u0442.\" \u0422\u0430\u043A \u0438 \u0432\u044B\u0448\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175657
    m_Localized: "\u0422\u0430\u043D\u0441\u043A\u0438\u0439 \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707521175658
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043F\u0430\u043B\u0430\u043D\u043A\u0438\u043D \u0432 \u0441\u043E\u043F\u0440\u043E\u0432\u043E\u0436\u0434\u0435\u043D\u0438\u0438
      \u0447\u0435\u0442\u044B\u0440\u0451\u0445 \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u043E\u0432.
      \u0418\u0437-\u0437\u0430 \u0448\u0451\u043B\u043A\u043E\u0432\u043E\u0439
      \u0437\u0430\u043D\u0430\u0432\u0435\u0441\u043A\u0438 \u0432\u044B\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u0432 \u0448\u0430\u043F\u043A\u0435
      \u0441 \u043A\u0440\u044B\u043B\u044C\u044F\u043C\u0438 - \u0430\u0442\u0440\u0438\u0431\u0443\u0442
      \u0440\u0430\u043D\u0433\u0430. \u041E\u043D \u0436\u0435\u0441\u0442\u043E\u043C
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0441\u043B\u0443\u0433\u0443:\r\n\r\n<npc_speech
      lang=\"Chinese\">\u042F - \u043F\u043E\u0441\u043B\u0430\u043D\u043D\u0438\u043A
      \u0446\u0437\u0435\u0434\u0443\u0448\u0438 \u0425\u044D\u0434\u0443\u043D\u0430.
      \u041E\u0442\u043A\u0443\u0434\u0430 \u0432\u0430\u0448 \u043E\u0431\u043E\u0437?
      \u041A\u0430\u043A\u0438\u0435 \u0442\u043E\u0432\u0430\u0440\u044B \u0432\u0435\u0437\u0451\u0442\u0435?
      \u0415\u0441\u043B\u0438 \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C
      \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0435 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F,
      \u043C\u043E\u0433\u0443 \u043F\u043E\u043C\u043E\u0447\u044C \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u0442\u044C
      \u0434\u043E\u0440\u043E\u0433\u0443.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369856
    m_Localized: "\u041E\u0442\u0432\u0435\u0442\u0438\u0442\u044C \u0443\u0447\u0442\u0438\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369857
    m_Localized: "\u0423\u0447\u0442\u0438\u0432\u044B\u0439 \u043E\u0442\u0432\u0435\u0442
      \u0438 \u0437\u043D\u0430\u043D\u0438\u0435 \u043F\u0440\u0438\u0434\u0432\u043E\u0440\u043D\u043E\u0433\u043E
      \u044D\u0442\u0438\u043A\u0435\u0442\u0430 \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u043B\u0438
      \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435. \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u0434\u0430\u043B \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435
      \u043F\u0438\u0441\u044C\u043C\u043E \u043A \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0443
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u0437\u0430\u0441\u0442\u0430\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369858
    m_Localized: "\u0413\u0440\u0443\u0431\u043E\u0432\u0430\u0442\u044B\u0439 \u043E\u0442\u0432\u0435\u0442
      \u0440\u0430\u0437\u0434\u043E\u0441\u0430\u0434\u043E\u0432\u0430\u043B \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0430.
      \u041E\u043D \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B \"\u043F\u043E\u0434\u0430\u0440\u043E\u043A\"
      \u0437\u0430 \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369859
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u043F\u043E\u0434\u0430\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369860
    m_Localized: "\u0421\u0435\u0440\u0435\u0431\u0440\u043E \u0432 \u0448\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u043C\u0435\u0448\u043E\u0447\u043A\u0435 \u043F\u0435\u0440\u0435\u043A\u043E\u0447\u0435\u0432\u0430\u043B\u043E
      \u043A \u0441\u043B\u0443\u0433\u0435. \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u043A\u0438\u0432\u043D\u0443\u043B - \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369861
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369862
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043E\u0431\u0440\u0430\u0442\u0438\u043B\u0441\u044F
      \u043A \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0443 \u043D\u0430
      \u043B\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043D\u043E\u043C \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C,
      \u043F\u0440\u043E\u0446\u0438\u0442\u0438\u0440\u043E\u0432\u0430\u0432 \u0441\u0442\u0438\u0445\u0438
      \u041B\u0438 \u0411\u043E: <npc_speech lang=\"Chinese\">\u0414\u0430\u043B\u0451\u043A\u0438\u0439
      \u043F\u0443\u0442\u043D\u0438\u043A \u0441\u0442\u0443\u0447\u0438\u0442 \u0432
      \u0432\u043E\u0440\u043E\u0442\u0430 - \u0442\u0430\u043A \u0438 \u043C\u044B
      \u043F\u0440\u043E\u0441\u0438\u043C \u0432\u0430\u0448\u0435\u0439 \u043C\u0438\u043B\u043E\u0441\u0442\u0438,
      \u043F\u043E\u0447\u0442\u0435\u043D\u043D\u044B\u0439.</npc_speech> \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u0440\u0430\u0441\u0446\u0432\u0451\u043B, \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438\u043B
      \u043D\u0430 \u0447\u0430\u0439 \u0438 \u0432\u044B\u043F\u0438\u0441\u0430\u043B
      \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u0443\u044E \u043D\u0430 \u0432\u0435\u0441\u044C
      \u0425\u044D\u0434\u0443\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369863
    m_Localized: "\u041B\u043E\u0448\u0430\u0434\u0438 \u0440\u0432\u0430\u043D\u0443\u043B\u0438
      \u043F\u0440\u043E\u0447\u044C, \u0443\u0432\u043B\u0435\u043A\u0430\u044F
      \u0437\u0430 \u0441\u043E\u0431\u043E\u0439 \u0432\u0435\u0440\u0451\u0432\u043A\u0443
      \u0438 \u0434\u0451\u0440\u043D\u0443\u0432 \u0437\u0430 \u043F\u0440\u0438\u0432\u044F\u0437\u044C
      \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437 \u043C\u0443\u043B\u043E\u0432.
      \u0421\u0443\u043C\u0430\u0442\u043E\u0445\u0430, \u0443\u0448\u0438\u0431\u044B,
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u043E\u0435 \u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369864
    m_Localized: "\u041A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u0438\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369865
    m_Localized: "\u041D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F
      \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D:
      \u0434\u0432\u0430 \u0434\u0435\u0441\u044F\u0442\u043A\u0430 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432,
      \u0433\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0445 \u0442\u044E\u043A\u0430\u043C\u0438,
      \u043E\u0445\u0440\u0430\u043D\u0430 \u0441 \u043A\u043E\u043F\u044C\u044F\u043C\u0438
      \u0438 \u0437\u043D\u0430\u043C\u0451\u043D\u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u0434\u043E\u043C\u0430. \u041A\u0430\u0440\u0430\u0432\u0430\u043D-\u0431\u0430\u0448\u0438
      (\u0441\u0435\u0434\u043E\u0443\u0441\u044B\u0439 \u043C\u0443\u0436\u0447\u0438\u043D\u0430
      \u0432 \u0434\u043E\u0440\u043E\u0433\u043E\u043C \u0445\u0430\u043B\u0430\u0442\u0435)
      \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0440\u0443\u043A\u0443.
      \u0415\u0433\u043E \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0441\u043A\u0440\u0438\u043F\u044F\u0442
      \u043F\u043E\u0434 \u0442\u044F\u0436\u0435\u0441\u0442\u044C\u044E \u0444\u0430\u0440\u0444\u043E\u0440\u0430
      \u0438 \u0448\u0451\u043B\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369866
    m_Localized: "\u041E\u0431\u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F \u0442\u043E\u0432\u0430\u0440\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369867
    m_Localized: "\u0422\u043E\u0440\u0433 \u0431\u044B\u043B \u0434\u043E\u043B\u0433\u0438\u043C,
      \u043D\u043E \u0432\u0437\u0430\u0438\u043C\u043E\u0443\u0432\u0430\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C.
      \u0412\u044B \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u043B\u0438 \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u043D\u044B\u0439
      \u0444\u0430\u0440\u0444\u043E\u0440 \u043F\u043E \u0447\u0435\u0441\u0442\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435. \u041A\u0430\u0440\u0430\u0432\u0430\u043D-\u0431\u0430\u0448\u0438
      \u043A\u0438\u0432\u043D\u0443\u043B: \"\u0421 \u0432\u0430\u043C\u0438 \u043F\u0440\u0438\u044F\u0442\u043D\u043E
      \u0438\u043C\u0435\u0442\u044C \u0434\u0435\u043B\u043E.\""
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369868
    m_Localized: "\u0426\u0435\u043D\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u0432\u044B\u0448\u0435 \u043E\u0436\u0438\u0434\u0430\u0435\u043C\u043E\u0439.
      \u0424\u0430\u0440\u0444\u043E\u0440 \u0445\u043E\u0440\u043E\u0448, \u043D\u043E
      \u043A\u043E\u0448\u0435\u043B\u044C \u0437\u0430\u043C\u0435\u0442\u043D\u043E
      \u043F\u043E\u043B\u0435\u0433\u0447\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369869
    m_Localized: "\u041E\u0431\u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369870
    m_Localized: "\u0417\u0430 \u0447\u0430\u0435\u043C \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0431\u0430\u0448\u0438
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B \u043E \u0446\u0435\u043D\u0430\u0445
      \u0432 \u0433\u043E\u0440\u043E\u0434\u0430\u0445 \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u0438 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u043B \u043E
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0430\u0445 \u0443 \u0440\u0435\u043A\u0438.
      \u0411\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
      - \u043B\u0443\u0447\u0448\u0430\u044F \u0441\u0434\u0435\u043B\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369871
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u0447\u0438\u043D\u043E\u0447\u043D\u044B\u0435
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369872
    m_Localized: "\u0417\u0430 \u0433\u043E\u0440\u0441\u0442\u044C \u043C\u043E\u043D\u0435\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0431\u0430\u0448\u0438 \u0432\u044B\u0434\u0435\u043B\u0438\u043B
      \u0437\u0430\u043F\u0430\u0441\u043D\u044B\u0435 \u0441\u043F\u0438\u0446\u044B,
      \u0434\u043E\u0441\u043A\u0438 \u0438 \u043A\u043B\u0438\u043D. \"\u0412 \u0441\u0442\u0435\u043F\u0438
      \u0441\u0432\u043E\u0438 \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u0441\u0432\u043E\u0438\u043C,\"
      - \u0441\u043A\u0430\u0437\u0430\u043B \u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369873
    m_Localized: "\u0417\u0430\u0441\u0442\u0430\u0432\u0430 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369874
    m_Localized: "\u041D\u0430 \u0443\u0437\u043A\u043E\u043C \u0443\u0447\u0430\u0441\u0442\u043A\u0435
      \u0434\u043E\u0440\u043E\u0433\u0438 \u043C\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043C\u044F
      \u0445\u043E\u043B\u043C\u0430\u043C\u0438 \u0441\u0442\u043E\u0438\u0442 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u0430\u044F
      \u0431\u0430\u0440\u0440\u0438\u043A\u0430\u0434\u0430. \u0417\u0430 \u043D\u0435\u0439
      - \u0434\u044E\u0436\u0438\u043D\u0430 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0445
      \u043B\u044E\u0434\u0435\u0439: \u043A\u0442\u043E \u0441 \u043B\u0443\u043A\u043E\u043C,
      \u043A\u0442\u043E \u0441 \u043A\u043E\u043F\u044C\u0451\u043C, \u043A\u0442\u043E
      \u0441 \u0434\u0443\u0431\u0438\u043D\u043E\u0439. \u041F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
      - \u0436\u0438\u043B\u0438\u0441\u0442\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0441\u043E \u0448\u0440\u0430\u043C\u043E\u043C \u043D\u0430 \u043B\u0431\u0443
      - \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0432\u043F\u0435\u0440\u0451\u0434,
      \u043F\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u044F \u043A\u0438\u043D\u0436\u0430\u043B\u043E\u043C:\r\n\r\n\u0414\u043E\u0440\u043E\u0433\u0430
      \u043F\u043B\u0430\u0442\u043D\u0430\u044F. \u0421\u0435\u0440\u0435\u0431\u0440\u043E
      - \u0438\u043B\u0438 \u043A\u0440\u043E\u0432\u044C. \u0412\u044B\u0431\u0438\u0440\u0430\u0439\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369875
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369876
    m_Localized: "\u0421\u0435\u0440\u0435\u0431\u0440\u043E \u0432\u044B\u0441\u044B\u043F\u0430\u043D\u043E
      \u043D\u0430 \u0431\u043E\u0447\u043A\u0443 \u0443 \u0431\u0430\u0440\u0440\u0438\u043A\u0430\u0434\u044B.
      \u041F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043B,
      \u043A\u0438\u0432\u043D\u0443\u043B, \u0438 \u0434\u043E\u0441\u043A\u0438
      \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C. \u0423\u043D\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
      \u043D\u043E \u0436\u0438\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369877
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0437\u0430 \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369878
    m_Localized: "\u0425\u043B\u0430\u0434\u043D\u043E\u043A\u0440\u043E\u0432\u0438\u0435
      \u0438 \u0442\u0432\u0451\u0440\u0434\u044B\u0439 \u0433\u043E\u043B\u043E\u0441
      \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u043B\u0438 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435.
      \u041F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C \u0445\u043C\u044B\u043A\u043D\u0443\u043B:
      \"\u041B\u0430\u0434\u043D\u043E, \u0437\u0430 \u0434\u0435\u0440\u0437\u043E\u0441\u0442\u044C
      - \u0441\u043A\u0438\u0434\u043A\u0430. \u041D\u043E \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0440\u0430\u0437 \u0434\u043E\u0440\u043E\u0436\u0435.\""
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369879
    m_Localized: "\u0422\u043E\u0440\u0433 \u0440\u0430\u0437\u043E\u0437\u043B\u0438\u043B
      \u0433\u043B\u0430\u0432\u0430\u0440\u044F. \u041E\u043D \u0441\u0432\u0438\u0441\u0442\u043D\u0443\u043B,
      \u0438 \u043B\u0443\u0447\u043D\u0438\u043A\u0438 \u043F\u043E\u0434\u043D\u044F\u043B\u0438
      \u043E\u0440\u0443\u0436\u0438\u0435. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0441 \u043D\u0430\u0434\u0431\u0430\u0432\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369880
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0434\u0435\u043C\u043E\u043D\u0441\u0442\u0440\u0438\u0440\u0443\u0435\u0442
      \u0441\u0438\u043B\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369881
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0432\u044B\u0448\u0435\u043B
      \u0432\u043F\u0435\u0440\u0451\u0434, \u043F\u043E\u043B\u043E\u0436\u0438\u0432
      \u0440\u0443\u043A\u0443 \u043D\u0430 \u043C\u0435\u0447. \u041F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
      \u043E\u0433\u043B\u044F\u0434\u0435\u043B \u0435\u0433\u043E \u0434\u043E\u0441\u043F\u0435\u0445\u0438
      \u0438 \u043E\u0440\u0443\u0436\u0438\u0435, \u043F\u0440\u0438\u043A\u0438\u043D\u0443\u043B
      \u0448\u0430\u043D\u0441\u044B - \u0438 \u0441\u043D\u0438\u0437\u0438\u043B
      \u0441\u0442\u0430\u0432\u043A\u0443 \u0434\u043E \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u0439.
      \u041F\u0440\u043E\u0449\u0435 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C,
      \u0447\u0435\u043C \u0434\u0440\u0430\u0442\u044C\u0441\u044F \u0441 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369882
    m_Localized: "\u0417\u043C\u0435\u0438\u043D\u043E\u0435 \u0433\u043D\u0435\u0437\u0434\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369883
    m_Localized: "\u041F\u0440\u0438 \u0440\u0430\u0437\u0431\u0438\u0432\u043A\u0435
      \u043D\u043E\u0447\u043D\u043E\u0433\u043E \u043B\u0430\u0433\u0435\u0440\u044F
      \u0432 \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0435 \u043C\u0435\u0436\u0434\u0443
      \u043A\u0430\u043C\u043D\u044F\u043C\u0438 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u043E
      \u0433\u043D\u0435\u0437\u0434\u043E \u043F\u0435\u0441\u0447\u0430\u043D\u044B\u0445
      \u044D\u0444. \u0417\u043C\u0435\u0438 \u0440\u0430\u0441\u043F\u043E\u043B\u0437\u0430\u044E\u0442\u0441\u044F
      \u043C\u0435\u0436\u0434\u0443 \u0442\u044E\u043A\u0430\u043C\u0438 \u0438
      \u043E\u0434\u0435\u044F\u043B\u0430\u043C\u0438. \u0424\u043E\u043D\u0430\u0440\u0438
      \u0432\u044B\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u044E\u0442 \u0438\u0437
      \u0442\u0435\u043C\u043D\u043E\u0442\u044B \u0434\u0435\u0441\u044F\u0442\u043A\u0438
      \u043F\u043E\u0431\u043B\u0451\u0441\u043A\u0438\u0432\u0430\u044E\u0449\u0438\u0445
      \u0447\u0435\u0448\u0443\u0451\u0439 \u0442\u0435\u043B. \u041E\u0434\u0438\u043D
      \u043D\u0435\u0432\u0435\u0440\u043D\u044B\u0439 \u0448\u0430\u0433 - \u0438
      \u0443\u043A\u0443\u0441 \u043D\u0435\u043C\u0438\u043D\u0443\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369884
    m_Localized: "\u041E\u0442\u043E\u0433\u043D\u0430\u0442\u044C \u043E\u0433\u043D\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369885
    m_Localized: "\u0424\u0430\u043A\u0435\u043B\u0430\u043C\u0438 \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u0440\u0430\u0437\u043E\u0433\u043D\u0430\u0442\u044C \u0437\u043C\u0435\u0439,
      \u043D\u043E \u0432 \u0441\u0443\u043C\u0430\u0442\u043E\u0445\u0435 \u043E\u043F\u0440\u043E\u043A\u0438\u043D\u0443\u0442
      \u043C\u0435\u0448\u043E\u043A \u0441 \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0435\u0439.
      \u041B\u044E\u0434\u0438 \u0434\u043E \u0443\u0442\u0440\u0430 \u043D\u0435
      \u0441\u043E\u043C\u043A\u043D\u0443\u043B\u0438 \u0433\u043B\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369886
    m_Localized: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0442\u0438
      \u043B\u0430\u0433\u0435\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369887
    m_Localized: "\u0422\u0438\u0445\u043E, \u043D\u0435 \u0442\u0440\u0435\u0432\u043E\u0436\u0430
      \u0433\u043D\u0435\u0437\u0434\u043E, \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B \u043D\u0430 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0435
      \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435. \u041A \u0443\u0442\u0440\u0443
      \u0437\u043C\u0435\u0438 \u0443\u043F\u043E\u043B\u0437\u043B\u0438 \u0432
      \u043F\u0435\u0441\u043A\u0438 \u0441\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369888
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u043A\u0430 \u0443\u0439\u0442\u0438
      \u0431\u0435\u0441\u0448\u0443\u043C\u043D\u043E \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044C
      - \u043A\u0442\u043E-\u0442\u043E \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u043B
      \u043D\u0430 \u0437\u043C\u0435\u044E. \u0423\u043A\u0443\u0448\u0435\u043D\u043D\u043E\u0433\u043E
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043E\u0442\u043F\u0430\u0438\u0432\u0430\u0442\u044C,
      \u0430 \u043B\u0430\u0433\u0435\u0440\u044C \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0442\u0438
      \u0432\u043F\u043E\u043F\u044B\u0445\u0430\u0445, \u043F\u043E\u0442\u0435\u0440\u044F\u0432
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369889
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0437\u043D\u0430\u0435\u0442
      \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u044F\u0434\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369890
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
      \u0441\u043E\u0431\u0440\u0430\u043B \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0437\u043C\u0435\u0439 \u0432 \u043C\u0435\u0448\u043E\u043A - \u0438\u0445
      \u044F\u0434 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F \u0434\u043B\u044F
      \u0441\u043D\u0430\u0434\u043E\u0431\u0438\u0439. \u041B\u0430\u0433\u0435\u0440\u044C
      \u043D\u0435 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369891
    m_Localized: "\u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0435 \u043A\u043E\u043D\u043D\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369892
    m_Localized: "\u0418\u0437 \u043C\u0430\u0440\u0435\u0432\u0430 \u043D\u0430
      \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435 \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u044E\u0442
      \u0441\u0438\u043B\u0443\u044D\u0442\u044B \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u043E\u0432.
      \u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0435 \u043A\u043E\u043D\u043D\u044B\u0435
      \u043B\u0443\u0447\u043D\u0438\u043A\u0438 \u0432 \u043A\u043E\u0436\u0430\u043D\u044B\u0445
      \u0434\u043E\u0441\u043F\u0435\u0445\u0430\u0445 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u044E\u0442
      \u0434\u043E\u0440\u043E\u0433\u0443, \u0432\u044B\u0441\u0442\u0440\u043E\u0438\u0432\u0448\u0438\u0441\u044C
      \u043F\u043E\u043B\u0443\u043C\u0435\u0441\u044F\u0446\u0435\u043C. \u0412\u043E\u0436\u0430\u043A
      \u043A\u0440\u0438\u0447\u0438\u0442 \u0447\u0442\u043E-\u0442\u043E \u043D\u0430
      \u0441\u0432\u043E\u0451\u043C \u044F\u0437\u044B\u043A\u0435, \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u044F
      \u043D\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0438.\r\n\r\n<npc_speech
      lang=\"Turkic\">\u0417\u0430 \u043F\u0440\u043E\u0445\u043E\u0434 \u043F\u043E
      \u043D\u0430\u0448\u0435\u0439 \u0437\u0435\u043C\u043B\u0435 - \u043F\u043B\u0430\u0442\u0430!
      \u0416\u0438\u0432\u0435\u0435!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369893
    m_Localized: "\u0421\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369894
    m_Localized: "\u0411\u043E\u0439 \u0441 \u043A\u043E\u043D\u043D\u044B\u043C\u0438
      \u043B\u0443\u0447\u043D\u0438\u043A\u0430\u043C\u0438 - \u0434\u0435\u043B\u043E
      \u043D\u0435\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0435.
      \u041E\u043D\u0438 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438,
      \u043E\u0441\u044B\u043F\u0430\u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0441\u0442\u0440\u0435\u043B\u0430\u043C\u0438. \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0442\u044E\u043A\u043E\u0432 \u043F\u043E\u0440\u0432\u0430\u043D\u043E,
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369895
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369896
    m_Localized: "\u0416\u0435\u0441\u0442\u0430\u043C\u0438 \u0438 \u043E\u0431\u0440\u044B\u0432\u043A\u0430\u043C\u0438
      \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0445 \u0441\u043B\u043E\u0432 \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u0441\u0431\u0438\u0442\u044C \u0446\u0435\u043D\u0443. \u0412\u043E\u0436\u0430\u043A
      \u0443\u0441\u043C\u0435\u0445\u043D\u0443\u043B\u0441\u044F \u0438 \u043F\u0440\u0438\u043D\u044F\u043B
      \u043C\u043E\u043D\u0435\u0442\u044B, \u043C\u0430\u0445\u043D\u0443\u0432
      \u0440\u0443\u043A\u043E\u0439 - \u043F\u0440\u043E\u0435\u0437\u0436\u0430\u0439\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369897
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B \u043B\u0438\u0448\u044C
      \u0440\u0430\u0437\u043E\u0437\u043B\u0438\u043B\u0438 \u0432\u043E\u0436\u0430\u043A\u0430.
      \u041E\u043D \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B \u0432\u0434\u0432\u043E\u0435
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0438 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C, \u0447\u0442\u043E\u0431\u044B
      \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C \u0441\u0442\u0440\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369898
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u0435\u0442
      \u0432\u043F\u0435\u0440\u0451\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369899
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0432\u044B\u0435\u0445\u0430\u043B
      \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B
      \u0441\u0432\u043E\u0451 \u043E\u0440\u0443\u0436\u0438\u0435, \u0433\u043E\u0432\u043E\u0440\u044F
      \u043D\u0430 \u044F\u0437\u044B\u043A\u0435 \u0432\u043E\u0438\u043D\u043E\u0432:
      <npc_speech lang=\"Turkic\">\u0421\u0442\u043E\u0439! \u042D\u0442\u043E\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043E\u0434 \u043C\u043E\u0435\u0439
      \u0437\u0430\u0449\u0438\u0442\u043E\u0439. \u0425\u043E\u0447\u0435\u0448\u044C
      \u043A\u0440\u043E\u0432\u0438 - \u043D\u0430\u0447\u043D\u0438 \u0441 \u043C\u043E\u0435\u0439.</npc_speech>
      \u0422\u044E\u0440\u043A\u0438 \u043E\u0446\u0435\u043D\u0438\u043B\u0438 \u0445\u0440\u0430\u0431\u0440\u043E\u0441\u0442\u044C
      \u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0438\u0441\u044C \u043D\u0430
      \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u0434\u0430\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369900
    m_Localized: "\u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369901
    m_Localized: "\u041D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435
      \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u0432\u0435\u0440\u0435\u043D\u0438\u0446\u0430
      \u0433\u0440\u0443\u0436\u0451\u043D\u044B\u0445 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432
      \u043F\u043E\u0434 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u043C\u0438
      \u0437\u043D\u0430\u043C\u0451\u043D\u0430\u043C\u0438. \u041A\u0430\u0440\u0430\u0432\u0430\u043D-\u0431\u0430\u0448\u0438
      \u0432 \u0440\u0430\u0441\u0448\u0438\u0442\u043E\u043C \u0445\u0430\u043B\u0430\u0442\u0435
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0440\u0443\u043A\u0443
      \u0432 \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0438
      \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043A \u0432\u0430\u043C
      \u043D\u0430 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C:\r\n\r\n<npc_speech
      lang=\"Sogdian\">\u041F\u0440\u0438\u0432\u0435\u0442, \u043A\u0443\u043F\u0435\u0446!
      \u041C\u044B \u0438\u0437 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430.
      \u0423 \u043D\u0430\u0441 \u043E\u0442\u0431\u043E\u0440\u043D\u044B\u0439
      \u0442\u043E\u0432\u0430\u0440 - \u0437\u043B\u0430\u0442\u043E\u0442\u043A\u0430\u043D\u0430\u044F
      \u043F\u0430\u0440\u0447\u0430. \u041D\u0435 \u0436\u0435\u043B\u0430\u0435\u0442\u0435
      \u0432\u0437\u0433\u043B\u044F\u043D\u0443\u0442\u044C?</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369902
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369903
    m_Localized: "\u041F\u043E\u043D\u0438\u043C\u0430\u044F \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439,
      \u0432\u044B \u0432\u044B\u0442\u043E\u0440\u0433\u043E\u0432\u0430\u043B\u0438
      \u043E\u0442\u043B\u0438\u0447\u043D\u0443\u044E \u043F\u0430\u0440\u0447\u0443
      \u043F\u043E \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0439
      \u0446\u0435\u043D\u0435. \u041A\u0430\u0440\u0430\u0432\u0430\u043D-\u0431\u0430\u0448\u0438
      \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043A\u0438\u0432\u043D\u0443\u043B
      - \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369904
    m_Localized: "\u0411\u0435\u0437 \u0437\u043D\u0430\u043D\u0438\u044F \u044F\u0437\u044B\u043A\u0430
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0446\u0435\u043D\u0443 \u043F\u0440\u043E\u0434\u0430\u0432\u0446\u0430.
      \u041F\u0430\u0440\u0447\u0430 \u0445\u043E\u0440\u043E\u0448\u0430, \u043D\u043E
      \u0437\u0430\u043F\u043B\u0430\u0447\u0435\u043D\u043E \u0441 \u043B\u0438\u0448\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369905
    m_Localized: "\u041E\u0431\u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F \u043D\u043E\u0432\u043E\u0441\u0442\u044F\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369906
    m_Localized: "\u0417\u0430 \u0447\u0430\u0435\u043C \u0441\u043E\u0433\u0434\u0438\u0439\u0446\u044B
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0438 \u043E \u0434\u043E\u0440\u043E\u0433\u0430\u0445
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438: \u0433\u0434\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438,
      \u0433\u0434\u0435 \u0432\u043E\u0434\u0430. \u0426\u0435\u043D\u043D\u044B\u0435
      \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F, \u043D\u0435 \u0441\u0442\u043E\u0438\u0432\u0448\u0438\u0435
      \u043D\u0438 \u043C\u043E\u043D\u0435\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369907
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0432\u0435\u0434\u0451\u0442 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369908
    m_Localized: "\u0412\u0430\u0448 \u043A\u0443\u043F\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B \u0441 \u0441\u043E\u0433\u0434\u0438\u0439\u0446\u0430\u043C\u0438
      \u043D\u0430 \u0438\u0445 \u044F\u0437\u044B\u043A\u0435: <npc_speech lang=\"Sogdian\">\u041C\u0438\u0440
      \u0434\u043E\u043C\u0443 \u0442\u0432\u043E\u0435\u043C\u0443, \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0431\u0430\u0448\u0438!
      \u041C\u044B \u0442\u043E\u0436\u0435 \u0437\u043D\u0430\u0435\u043C \u0446\u0435\u043D\u0443
      \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u043F\u0430\u0440\u0447\u0435.
      \u041F\u043E\u043A\u0430\u0436\u0438 \u043B\u0443\u0447\u0448\u0435\u0435 -
      \u0438 \u0441\u0442\u043E\u0440\u0433\u0443\u0435\u043C\u0441\u044F \u043A\u0430\u043A
      \u0441\u0432\u043E\u0438.</npc_speech> \u0421\u0434\u0435\u043B\u043A\u0430
      \u0432\u044B\u0448\u043B\u0430 \u0432\u044B\u0433\u043E\u0434\u043D\u0435\u0435,
      \u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0431\u0430\u0448\u0438
      \u043F\u0440\u0438\u0433\u043B\u0430\u0441\u0438\u043B \u0432\u0430\u0441 \u043D\u0430
      \u0443\u0436\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369909
    m_Localized: "\u0422\u0440\u0435\u0441\u043D\u0443\u0432\u0448\u0430\u044F \u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369910
    m_Localized: "\u0420\u0430\u0441\u043A\u0430\u043B\u0451\u043D\u043D\u043E\u0435
      \u0441\u043E\u043B\u043D\u0446\u0435 \u0432\u044B\u0441\u0443\u0448\u0438\u043B\u043E
      \u0434\u0435\u0440\u0435\u0432\u043E \u043E\u0441\u0438 \u0434\u043E \u043F\u0440\u0435\u0434\u0435\u043B\u0430.
      \u0421 \u0445\u0440\u0443\u0441\u0442\u043E\u043C, \u043F\u043E\u0445\u043E\u0436\u0438\u043C
      \u043D\u0430 \u0432\u044B\u0441\u0442\u0440\u0435\u043B, \u043E\u0441\u044C
      \u0433\u043B\u0430\u0432\u043D\u043E\u0439 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0440\u0430\u0441\u043A\u0430\u043B\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430\u0434\u0432\u043E\u0435. \u041F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043A\u0440\u0435\u043D\u0438\u0442\u0441\u044F, \u0442\u044E\u043A\u0438
      \u043F\u043E\u043B\u0437\u0443\u0442 \u0432 \u043F\u0435\u0441\u043E\u043A.
      \u0414\u043E \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u0430
      - \u0434\u043D\u0438 \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369911
    m_Localized: "\u0427\u0438\u043D\u0438\u0442\u044C \u043F\u043E\u0434\u0440\u0443\u0447\u043D\u044B\u043C\u0438
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369912
    m_Localized: "\u0418\u0437 \u0437\u0430\u043F\u0430\u0441\u043D\u044B\u0445 \u0434\u043E\u0441\u043E\u043A
      \u0438 \u0432\u0435\u0440\u0451\u0432\u043E\u043A \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u0441\u043A\u0440\u0435\u043F\u0438\u0442\u044C \u043E\u0441\u044C. \u041D\u0435\u043D\u0430\u0434\u0451\u0436\u043D\u043E,
      \u043D\u043E \u0434\u043E \u0433\u043E\u0440\u043E\u0434\u0430 \u0434\u043E\u0442\u044F\u043D\u0435\u0442.
      \u041F\u043E\u043B\u0434\u043D\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369913
    m_Localized: "\u041F\u043E\u0447\u0438\u043D\u043A\u0430 \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u043B\u0430
      - \u043E\u0441\u044C \u0441\u043B\u043E\u043C\u0430\u043B\u0430\u0441\u044C
      \u0441\u043D\u043E\u0432\u0430 \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441.
      \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0447\u0438\u043D\u0438\u0442\u044C
      \u0437\u0430\u043D\u043E\u0432\u043E, \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0432
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u0438 \u043D\u0435\u0440\u0432\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369914
    m_Localized: "\u0420\u0430\u0437\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043D\u0430
      \u0434\u043E\u043F. \u0442\u0435\u043B\u0435\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369915
    m_Localized: "\u0413\u0440\u0443\u0437 \u043F\u0435\u0440\u0435\u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D.
      \u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043F\u043E\u043B\u0437\u0451\u0442 \u043F\u043E\u043B\u0443\u043F\u0443\u0441\u0442\u043E\u0439,
      \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0435\u043D\u0430 \u0438 \u0441\u043A\u0440\u0438\u043F\u0438\u0442
      \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u0439 \u043A\u043E\u0447\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369916
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u0447\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369917
    m_Localized: "\u0421\u0430\u043C\u044B\u0435 \u0442\u044F\u0436\u0451\u043B\u044B\u0435
      \u0442\u044E\u043A\u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B
      \u0443 \u0434\u043E\u0440\u043E\u0433\u0438. \u041E\u0431\u043B\u0435\u0433\u0447\u0451\u043D\u043D\u0430\u044F
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u0434\u0432\u0438\u043D\u0443\u043B\u0430\u0441\u044C
      \u0434\u0430\u043B\u044C\u0448\u0435, \u043D\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0439
      \u0442\u043E\u0432\u0430\u0440 \u0443\u0436\u0435 \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369918
    m_Localized: "\u0422\u0430\u0439\u043D\u0438\u043A \u043A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369919
    m_Localized: "\u0412\u0435\u0442\u0435\u0440 \u043E\u0431\u043D\u0430\u0436\u0438\u043B
      \u043A\u0440\u0430\u0439 \u0433\u043B\u0438\u043D\u044F\u043D\u043E\u0439 \u043A\u043B\u0430\u0434\u043A\u0438
      \u043F\u043E\u0434 \u043F\u0435\u0441\u043A\u043E\u043C. \u0412\u043D\u0443\u0442\u0440\u0438
      - \u043F\u043E\u043B\u0443\u0438\u0441\u0442\u043B\u0435\u0432\u0448\u0438\u0435
      \u043C\u0435\u0448\u043A\u0438 \u0438 \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u043D\u044B\u0435
      \u043A\u0443\u0432\u0448\u0438\u043D\u044B. \u0421\u0443\u0434\u044F \u043F\u043E
      \u0441\u043B\u0435\u0434\u0430\u043C, \u0442\u0430\u0439\u043D\u0438\u043A\u0443
      \u043D\u0435 \u043E\u0434\u0438\u043D \u0433\u043E\u0434. \u041A\u0442\u043E-\u0442\u043E
      \u0441\u043F\u0440\u044F\u0442\u0430\u043B \u0437\u0434\u0435\u0441\u044C \u0442\u043E\u0432\u0430\u0440
      \u0438 \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369920
    m_Localized: "\u041E\u0431\u044B\u0441\u043A\u0430\u0442\u044C \u0442\u0430\u0439\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369921
    m_Localized: "\u0412 \u043A\u0443\u0432\u0448\u0438\u043D\u0430\u0445 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0441\u044F
      \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u043D\u044B\u0439 \u043B\u0430\u0434\u0430\u043D,
      \u0430 \u0432 \u043E\u0434\u043D\u043E\u043C \u043C\u0435\u0448\u043A\u0435
      - \u0433\u043E\u0440\u0441\u0442\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0445
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432. \u041D\u043E \u0442\u0430\u0439\u043D\u0438\u043A
      \u043C\u043E\u0433 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0442\u044C
      \u043A\u043E\u043C\u0443-\u0442\u043E \u043E\u043F\u0430\u0441\u043D\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369922
    m_Localized: "\u041E\u0446\u0435\u043D\u0438\u0442\u044C \u0438 \u0432\u0437\u044F\u0442\u044C
      \u043B\u0443\u0447\u0448\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369923
    m_Localized: "\u041E\u043F\u044B\u0442\u043D\u044B\u043C \u0433\u043B\u0430\u0437\u043E\u043C
      \u0432\u044B \u043E\u0442\u043E\u0431\u0440\u0430\u043B\u0438 \u0441\u0430\u043C\u044B\u0439
      \u0446\u0435\u043D\u043D\u044B\u0439 \u0442\u043E\u0432\u0430\u0440: \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u043D\u043D\u044B\u0439
      \u043B\u0430\u0434\u0430\u043D \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0441\u043E\u0440\u0442\u0430
      \u0438 \u043C\u0435\u0448\u043E\u0447\u0435\u043A \u0441 \u0434\u0438\u0440\u0445\u0430\u043C\u0430\u043C\u0438
      \u0430\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u043E\u0439 \u0447\u0435\u043A\u0430\u043D\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369924
    m_Localized: "\u0412\u044B \u0432\u0437\u044F\u043B\u0438 \u0447\u0442\u043E
      \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0446\u0435\u043D\u043D\u044B\u043C,
      \u043D\u043E \u043F\u043E\u0437\u0436\u0435 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438,
      \u0447\u0442\u043E \u0447\u0430\u0441\u0442\u044C \u043B\u0430\u0434\u0430\u043D\u0430
      \u043F\u043E\u0434\u043C\u043E\u043A\u043B\u0430 \u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430
      \u0430\u0440\u043E\u043C\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369925
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369926
    m_Localized: "\u0427\u0443\u0436\u043E\u0435 \u0434\u043E\u0431\u0440\u043E -
      \u0447\u0443\u0436\u0438\u0435 \u0431\u0435\u0434\u044B. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u0440\u043E\u0448\u0451\u043B \u043C\u0438\u043C\u043E, \u043D\u0435
      \u0442\u0440\u043E\u043D\u0443\u0432 \u0442\u0430\u0439\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369927
    m_Localized: "\u0411\u0435\u0434\u0443\u0438\u043D\u0441\u043A\u0438\u0439 \u0441\u043B\u0435\u0434\u043E\u043F\u044B\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369928
    m_Localized: "\u0423 \u043A\u0440\u0430\u044F \u0442\u0440\u043E\u043F\u044B
      \u0441\u0438\u0434\u0438\u0442 \u0431\u0435\u0434\u0443\u0438\u043D \u0432
      \u0447\u0451\u0440\u043D\u043E\u043C \u0431\u0443\u0440\u043D\u0443\u0441\u0435.
      \u041E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F,
      \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043D\u0430 \u0441\u043B\u0435\u0434\u044B
      \u0432 \u043F\u0435\u0441\u043A\u0435 \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0431\u044B\u0441\u0442\u0440\u043E \u0438 \u043E\u0442\u0440\u044B\u0432\u0438\u0441\u0442\u043E,
      \u0432\u043E\u0434\u044F \u0440\u0443\u043A\u043E\u0439 \u043F\u043E \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0443:\r\n\r\n<npc_speech
      lang=\"Arabic\">\u042D\u0442\u0430 \u0434\u043E\u0440\u043E\u0433\u0430 \u043E\u043F\u0430\u0441\u043D\u0430!
      \u0417\u0430 \u0431\u0430\u0440\u0445\u0430\u043D\u0430\u043C\u0438 \u0437\u0430\u0441\u0435\u043B\u0438
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438. \u0421\u043B\u0435\u0434\u0443\u0439
      \u0437\u0430 \u043C\u043D\u043E\u0439 - \u044F \u0437\u043D\u0430\u044E \u0434\u0440\u0443\u0433\u043E\u0439
      \u043F\u0443\u0442\u044C.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369929
    m_Localized: "\u0421\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C \u0437\u0430
      \u043D\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369930
    m_Localized: "\u0411\u0435\u0434\u0443\u0438\u043D \u0432\u044B\u0432\u0435\u043B
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0431\u0445\u043E\u0434\u043D\u044B\u043C
      \u043F\u0443\u0442\u0451\u043C \u043C\u0438\u043C\u043E \u0437\u0430\u0441\u0430\u0434\u044B.
      \u041F\u043E\u0442\u0440\u0430\u0442\u0438\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0432\u043E\u0434\u044B, \u043D\u043E \u0438\u0437\u0431\u0435\u0436\u0430\u043B\u0438
      \u0431\u0435\u0434\u044B. \u041E\u043D \u0438\u0441\u0447\u0435\u0437 \u0432
      \u0434\u044E\u043D\u0430\u0445, \u043D\u0435 \u043F\u0440\u0438\u043D\u044F\u0432
      \u043F\u043B\u0430\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369931
    m_Localized: "\u0418\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369932
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u043F\u0440\u0435\u0436\u043D\u0438\u043C \u043F\u0443\u0442\u0451\u043C.
      \u0411\u0435\u0434\u0443\u0438\u043D \u043F\u043E\u043A\u0430\u0447\u0430\u043B
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0438 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0441\u044F
      \u0432 \u043C\u0430\u0440\u0435\u0432\u0435. \u0412\u043F\u0435\u0440\u0435\u0434\u0438
      \u0436\u0434\u0451\u0442 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369933
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0440\u0430\u0437\u044A\u044F\u0441\u043D\u044F\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369934
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u0435\u0440\u0435\u0434\u0430\u043B
      \u0441\u043B\u043E\u0432\u0430 \u0431\u0435\u0434\u0443\u0438\u043D\u0430:
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u0437\u0430\u0441\u0430\u0434\u0430
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432, \u043D\u043E
      \u0435\u0441\u0442\u044C \u043E\u0431\u0445\u043E\u0434 \u0447\u0435\u0440\u0435\u0437
      \u0441\u0443\u0445\u043E\u0435 \u0440\u0443\u0441\u043B\u043E. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043C\u0438\u043D\u043E\u0432\u0430\u043B \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u0441 \u0437\u0430\u043F\u0430\u0441\u043E\u043C \u0438 \u0443\u0437\u043D\u0430\u043B
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0430\u0440\u0430\u0431\u0441\u043A\u0438\u0445
      \u0441\u043B\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369935
    m_Localized: "\u041E\u0433\u043D\u0438 \u0434\u0436\u0438\u043D\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369936
    m_Localized: "\u0413\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u043D\u043E\u0447\u044C\u044E
      \u043D\u0430\u0434 \u0431\u0430\u0440\u0445\u0430\u043D\u0430\u043C\u0438 \u0437\u0430\u0433\u043E\u0440\u0430\u044E\u0442\u0441\u044F
      \u0431\u043B\u0435\u0434\u043D\u043E-\u0437\u0435\u043B\u0451\u043D\u044B\u0435
      \u043E\u0433\u043E\u043D\u044C\u043A\u0438. \u041E\u043D\u0438 \u043F\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F,
      \u0431\u0443\u0434\u0442\u043E \u0434\u044B\u0448\u0430\u0442, \u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043F\u043B\u044B\u0432\u0443\u0442 \u0432\u0433\u043B\u0443\u0431\u044C \u043F\u0443\u0441\u0442\u044B\u043D\u0438.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u0437\u0430\u043C\u0435\u0440\u043B\u0438
      - \u0441\u0442\u0430\u0440\u0438\u043A\u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0442,
      \u044D\u0442\u043E \u0444\u043E\u043D\u0430\u0440\u0438 \u0434\u0436\u0438\u043D\u043D\u043E\u0432,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0437\u0430\u043C\u0430\u043D\u0438\u0432\u0430\u044E\u0442
      \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432 \u0432 \u0431\u0435\u0437\u0432\u043E\u0434\u043D\u044B\u0435
      \u043F\u0435\u0441\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369937
    m_Localized: "\u041D\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369938
    m_Localized: "\u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u043E\u043C\u043A\u043D\u0443\u043B
      \u0433\u043B\u0430\u0437. \u0421 \u043F\u0435\u0440\u0432\u044B\u043C \u0441\u0432\u0435\u0442\u043E\u043C
      \u043E\u0433\u043D\u0438 \u043F\u043E\u0433\u0430\u0441\u043B\u0438. \u041B\u044E\u0434\u0438
      \u0438\u0437\u043C\u043E\u0442\u0430\u043D\u044B \u0431\u0435\u0441\u0441\u043E\u043D\u043D\u043E\u0439
      \u043D\u043E\u0447\u044C\u044E, \u043D\u043E \u0446\u0435\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369939
    m_Localized: "\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369940
    m_Localized: "\u0421\u043B\u0435\u0434\u0443\u044F \u0437\u0430 \u043E\u0433\u043D\u044F\u043C\u0438
      \u043D\u0430 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u043C \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438,
      \u0432\u044B \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438 \u0432\u044B\u0445\u043E\u0434
      \u043F\u0440\u0438\u0440\u043E\u0434\u043D\u043E\u0433\u043E \u0433\u0430\u0437\u0430
      \u0438\u0437 \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u044B. \u041D\u0438\u043A\u0430\u043A\u0438\u0445
      \u0434\u0436\u0438\u043D\u043D\u043E\u0432 - \u0442\u043E\u043B\u044C\u043A\u043E
      \u0437\u0435\u043C\u043B\u044F \u0434\u044B\u0448\u0438\u0442. \u0417\u043D\u0430\u043D\u0438\u0435
      \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u043B\u043E \u043B\u044E\u0434\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369941
    m_Localized: "\u041E\u0433\u043D\u0438 \u0443\u0432\u0435\u043B\u0438 \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u043E\u0432
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u043E\u0442 \u043B\u0430\u0433\u0435\u0440\u044F.
      \u041E\u043D\u0438 \u0437\u0430\u0431\u043B\u0443\u0434\u0438\u043B\u0438\u0441\u044C
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u043B\u0438\u0448\u044C \u043A \u043F\u043E\u043B\u0443\u0434\u043D\u044E,
      \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0432 \u0432\u043E\u0434\u0443 \u0438
      \u043D\u0435\u0440\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369942
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u044D\u0442\u0438 \u043C\u0435\u0441\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369943
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0443\u0441\u043C\u0435\u0445\u043D\u0443\u043B\u0441\u044F:
      \"\u042D\u0442\u043E \u0433\u0430\u0437 \u0438\u0437-\u043F\u043E\u0434 \u0437\u0435\u043C\u043B\u0438,
      \u044F \u0432\u0438\u0434\u0435\u043B \u0442\u0430\u043A\u043E\u0435 \u0443
      \u0425\u043E\u0442\u0430\u043D\u0430\". \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u043F\u0435\u0440\u0435\u043D\u043E\u0447\u0435\u0432\u0430\u043B,
      \u0430 \u0443\u0442\u0440\u043E\u043C \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0432 \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369944
    m_Localized: "\u041F\u0435\u0440\u0435\u0441\u043E\u0445\u0448\u0438\u0439 \u043A\u043E\u043B\u043E\u0434\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369945
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u043E\u0441\u0442\u0438\u0433
      \u043A\u043E\u043B\u043E\u0434\u0446\u0430, \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u043E\u0433\u043E
      \u043D\u0430 \u043A\u0430\u0440\u0442\u0435, \u043D\u043E \u043D\u0430 \u0434\u043D\u0435
      - \u043B\u0438\u0448\u044C \u0440\u0430\u0441\u0442\u0440\u0435\u0441\u043A\u0430\u0432\u0448\u0430\u044F\u0441\u044F
      \u0433\u043B\u0438\u043D\u0430. \u0412\u0435\u0440\u0451\u0432\u043A\u0430
      \u0441 \u0432\u0435\u0434\u0440\u043E\u043C \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u043F\u0443\u0441\u0442\u043E\u0439. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0432\u043E\u0434\u044B -
      \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E \u0433\u0434\u0435.
      \u0416\u0430\u0436\u0434\u0430 \u0441\u043A\u0440\u0443\u0447\u0438\u0432\u0430\u0435\u0442
      \u0433\u043E\u0440\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369946
    m_Localized: "\u041A\u043E\u043F\u0430\u0442\u044C \u0433\u043B\u0443\u0431\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369947
    m_Localized: "\u041D\u0430 \u0433\u043B\u0443\u0431\u0438\u043D\u0435 \u0432
      \u0440\u043E\u0441\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043C\u0443\u0442\u043D\u0430\u044F, \u043D\u043E \u043F\u0440\u0438\u0433\u043E\u0434\u043D\u0430\u044F
      \u0432\u043E\u0434\u0430. \u0411\u0443\u0440\u0434\u044E\u043A\u0438 \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u044B
      - \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0441\u043F\u0430\u0441\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369948
    m_Localized: "\u0427\u0430\u0441\u044B \u043A\u043E\u043F\u0430\u043D\u0438\u044F
      \u043D\u0435 \u0434\u0430\u043B\u0438 \u043D\u0438\u0447\u0435\u0433\u043E,
      \u043A\u0440\u043E\u043C\u0435 \u043C\u043E\u0437\u043E\u043B\u0435\u0439 \u0438
      \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u044F. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435
      \u043D\u0430 \u043E\u0441\u0442\u0430\u0442\u043A\u0430\u0445 \u0437\u0430\u043F\u0430\u0441\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369949
    m_Localized: "\u0423\u0440\u0435\u0437\u0430\u0442\u044C \u0440\u0430\u0446\u0438\u043E\u043D
      \u0438 \u0438\u0434\u0442\u0438 \u0432\u043F\u0435\u0440\u0451\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369950
    m_Localized: "\u0421\u0442\u0440\u043E\u0433\u0430\u044F \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u044F.
      \u0413\u043B\u043E\u0442\u043E\u043A \u0432\u043E\u0434\u044B \u0432 \u0447\u0430\u0441.
      \u041B\u044E\u0434\u0438 \u043C\u043E\u043B\u0447\u0430\u0442, \u044D\u043A\u043E\u043D\u043E\u043C\u044F
      \u0441\u0438\u043B\u044B. \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0434\u043D\u044F \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369951
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369952
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u0438 \u0443\u0448\u043B\u0438
      \u043D\u0430 \u043F\u043E\u0438\u0441\u043A\u0438. \u041E\u0436\u0438\u0434\u0430\u043D\u0438\u0435
      \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435 \u0440\u0430\u0441\u0442\u044F\u043D\u0443\u043B\u043E\u0441\u044C
      \u043D\u0430 \u043C\u0443\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0447\u0430\u0441\u044B. \u041E\u043D\u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u0441 \u043D\u043E\u0432\u043E\u0441\u0442\u044F\u043C\u0438, \u043D\u043E
      \u0431\u0435\u0437 \u0432\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369953
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438 \u0445\u0430\u0434\u0436\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369954
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043F\u0435\u0448\u0430\u044F \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0438\u044F
      - \u0434\u0435\u0441\u044F\u0442\u043A\u0438 \u043B\u044E\u0434\u0435\u0439
      \u0432 \u0431\u0435\u043B\u044B\u0445 \u0438\u0445\u0440\u0430\u043C\u0430\u0445,
      \u0441 \u043F\u043E\u0441\u043E\u0445\u0430\u043C\u0438 \u0438 \u043C\u043E\u043B\u0438\u0442\u0432\u0430\u043C\u0438
      \u043D\u0430 \u0443\u0441\u0442\u0430\u0445. \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438
      \u0438\u0434\u0443\u0442 \u0432 \u041C\u0435\u043A\u043A\u0443. \u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u0439
      \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443:\r\n\r\n<npc_speech
      lang=\"Arabic\">\u041C\u0438\u0440 \u0432\u0430\u043C, \u043F\u0443\u0442\u043D\u0438\u043A\u0438!
      \u041C\u044B \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438. \u041D\u0435\u0442
      \u043B\u0438 \u0443 \u0432\u0430\u0441 \u0432\u043E\u0434\u044B \u0438\u043B\u0438
      \u0444\u0438\u043D\u0438\u043A\u043E\u0432 \u0434\u043B\u044F \u043D\u0443\u0436\u0434\u0430\u044E\u0449\u0438\u0445\u0441\u044F?</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369955
    m_Localized: "\u041F\u043E\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u0432\u043E\u0434\u043E\u0439
      \u0438 \u0444\u0438\u043D\u0438\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369956
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0438\u043B\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D. \u0418\u0445 \u043C\u043E\u043B\u0438\u0442\u0432\u044B
      \u0441\u043E\u0433\u0440\u0435\u043B\u0438 \u0441\u0435\u0440\u0434\u0446\u0430.
      \u0421\u043B\u0443\u0445\u0438 \u043E \u0432\u0430\u0448\u0435\u0439 \u0449\u0435\u0434\u0440\u043E\u0441\u0442\u0438
      \u0440\u0430\u0437\u043D\u0435\u0441\u0443\u0442\u0441\u044F \u043F\u043E \u0430\u0440\u0430\u0431\u0441\u043A\u0438\u043C
      \u0437\u0435\u043C\u043B\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369957
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369958
    m_Localized: "\u0412\u044B \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B\u0438,
      \u0447\u0442\u043E \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u043C\u0430\u043B\u043E,
      \u0438 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438 \u0441 \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435\u043C
      \u043A\u0438\u0432\u043D\u0443\u043B\u0438. \u0420\u0430\u0441\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u0431\u0435\u0437 \u043E\u0431\u0438\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369959
    m_Localized: "\u041E\u0442\u043A\u0430\u0437 \u043F\u0440\u043E\u0437\u0432\u0443\u0447\u0430\u043B
      \u0440\u0435\u0437\u043A\u043E. \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438
      \u0443\u0448\u043B\u0438 \u043C\u043E\u043B\u0447\u0430, \u0431\u0440\u043E\u0441\u0430\u044F
      \u0443\u043A\u043E\u0440\u0438\u0437\u043D\u0435\u043D\u043D\u044B\u0435 \u0432\u0437\u0433\u043B\u044F\u0434\u044B.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u0440\u043E\u043F\u0449\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369960
    m_Localized: "\u041F\u043E\u0434\u0430\u0440\u0438\u0442\u044C \u0444\u0438\u043D\u0438\u043A\u0438
      \u0438 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369961
    m_Localized: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u0439 \u043F\u0440\u0438\u043D\u044F\u043B
      \u0444\u0438\u043D\u0438\u043A\u0438 \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C
      \u0438 \u0434\u043E\u043B\u0433\u043E \u043C\u043E\u043B\u0438\u043B\u0441\u044F
      \u0437\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D. \u0417\u0430\u0442\u0435\u043C
      \u0434\u043E\u0441\u0442\u0430\u043B \u0438\u0437 \u0441\u0432\u043E\u0435\u0439
      \u043A\u043E\u0442\u043E\u043C\u043A\u0438 \u043C\u0435\u0448\u043E\u0447\u0435\u043A
      \u043E\u0442\u0431\u043E\u0440\u043D\u044B\u0445 \u0444\u0438\u043D\u0438\u043A\u043E\u0432:
      \"\u0410\u043B\u043B\u0430\u0445 \u0432\u043E\u0437\u043D\u0430\u0433\u0440\u0430\u0436\u0434\u0430\u0435\u0442
      \u0449\u0435\u0434\u0440\u044B\u0445\"."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369962
    m_Localized: "\u041E\u0431\u0435\u0437\u0432\u043E\u0436\u0435\u043D\u043D\u044B\u0439
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369963
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u0432\u044C\u044E\u0447\u043D\u044B\u0445
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432 \u043F\u043E\u0448\u0430\u0442\u043D\u0443\u043B\u0441\u044F
      \u0438 \u0440\u0443\u0445\u043D\u0443\u043B \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u0438,
      \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u044F\u0441\u044C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F.
      \u0413\u043B\u0430\u0437\u0430 \u043C\u0443\u0442\u043D\u044B\u0435, \u0433\u0443\u0431\u044B
      \u0432 \u043F\u0435\u043D\u0435. \u041E\u0431\u0435\u0437\u0432\u043E\u0436\u0438\u0432\u0430\u043D\u0438\u0435.
      \u0411\u0435\u0437 \u044D\u0442\u043E\u0433\u043E \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430
      \u0447\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u043D\u0435\u0441\u0442\u0438 \u043B\u044E\u0434\u044F\u043C \u0438\u043B\u0438
      \u0431\u0440\u043E\u0441\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369964
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u0447\u0430\u0441\u0442\u044C
      \u0432\u043E\u0434\u044B \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369965
    m_Localized: "\u0414\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u0430\u044F
      \u0432\u043E\u0434\u0430 \u0443\u0448\u043B\u0430 \u043D\u0430 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430.
      \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u043E\u043D \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F
      \u0438 \u043F\u043E\u0431\u0440\u0451\u043B \u0434\u0430\u043B\u044C\u0448\u0435,
      \u043D\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u043F\u043E\u0447\u0442\u0438 \u0431\u0435\u0437 \u0437\u0430\u043F\u0430\u0441\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369966
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u0438\u0442\u044C
      \u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369967
    m_Localized: "\u0413\u0440\u0443\u0437 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D
      \u043C\u0435\u0436\u0434\u0443 \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u043C\u0438\u0441\u044F
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u043C\u0438 \u0438 \u043B\u044E\u0434\u044C\u043C\u0438.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u043B\u0435\u0436\u0430\u0442\u044C \u0432 \u043F\u0435\u0441\u043A\u0435.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u043E\u0442\u0432\u043E\u0434\u044F\u0442
      \u0433\u043B\u0430\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369968
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0432\u044B\u0445\u0430\u0436\u0438\u0432\u0430\u0435\u0442
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369969
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0440\u0430\u0441\u0442\u0451\u0440
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0443 \u043D\u043E\u0433\u0438,
      \u0432\u043B\u0438\u043B \u0432\u043E\u0434\u044B \u0441 \u0441\u043E\u043B\u044C\u044E,
      \u043D\u0430\u043A\u0440\u044B\u043B \u0432\u043B\u0430\u0436\u043D\u043E\u0439
      \u0442\u043A\u0430\u043D\u044C\u044E. \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441
      \u0437\u0432\u0435\u0440\u044C \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F.
      \u041B\u0435\u043A\u0430\u0440\u044C \u0437\u043D\u0430\u0435\u0442 \u043D\u0435
      \u0442\u043E\u043B\u044C\u043A\u043E \u043B\u044E\u0434\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369970
    m_Localized: "\u0411\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369971
    m_Localized: "\u041D\u0430 \u043E\u0431\u043E\u0447\u0438\u043D\u0435 \u0442\u0440\u0430\u043A\u0442\u0430
      \u0441\u0442\u043E\u044F\u0442 \u043E\u0441\u0442\u043E\u0432\u044B \u043F\u043E\u0432\u043E\u0437\u043E\u043A,
      \u043F\u043E\u043B\u0443\u0437\u0430\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0435
      \u043F\u0435\u0441\u043A\u043E\u043C. \u0422\u043A\u0430\u043D\u044C \u043D\u0430\u0432\u0435\u0441\u043E\u0432
      \u0438\u0441\u0442\u043B\u0435\u043B\u0430, \u043D\u043E \u0440\u0430\u043C\u044B
      \u0446\u0435\u043B\u044B. \u041C\u0435\u0436\u0434\u0443 \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u043C\u0438
      \u0440\u0430\u0437\u0431\u0440\u043E\u0441\u0430\u043D\u044B \u0442\u044E\u043A\u0438.
      \u0421\u043B\u0435\u0434\u043E\u0432 \u043B\u044E\u0434\u0435\u0439 \u043D\u0435\u0442:
      \u043D\u0438 \u0442\u0435\u043B, \u043D\u0438 \u043A\u043E\u0441\u0442\u0435\u0439.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0438\u0441\u0447\u0435\u0437,
      \u043E\u0441\u0442\u0430\u0432\u0438\u0432 \u0433\u0440\u0443\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369972
    m_Localized: "\u041E\u0431\u044B\u0441\u043A\u0430\u0442\u044C \u043F\u043E\u0432\u043E\u0437\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369973
    m_Localized: "\u041F\u043E\u0434 \u0441\u043B\u043E\u0435\u043C \u043F\u0435\u0441\u043A\u0430
      \u043D\u0430\u0448\u043B\u0438\u0441\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0432\u0448\u0438\u0435\u0441\u044F
      \u043A\u043E\u0432\u0440\u044B \u0438 \u043C\u0435\u0448\u043E\u043A \u0441
      \u0441\u0443\u0445\u0430\u0440\u044F\u043C\u0438. \u0412\u044B \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438
      \u0441\u043B\u0435\u0434\u044B \u0443\u0445\u043E\u0434\u044F\u0449\u0438\u0435
      \u043D\u0430 \u044E\u0433. \u0421\u0443\u0434\u044C\u0431\u0430 \u043F\u0440\u0435\u0436\u043D\u0438\u0445
      \u0445\u043E\u0437\u044F\u0435\u0432 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0437\u0430\u0433\u0430\u0434\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369974
    m_Localized: "\u0423\u0434\u0430\u043B\u043E\u0441\u044C \u043D\u0430\u0439\u0442\u0438
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0435\u0434\u044B, \u043D\u043E
      \u043F\u0440\u0438 \u043E\u0431\u044B\u0441\u043A\u0435 \u0440\u0443\u0445\u043D\u0443\u043B
      \u043D\u0430\u0432\u0435\u0441, \u043F\u043E\u0434\u043D\u044F\u0432 \u043E\u0431\u043B\u0430\u043A\u043E
      \u043F\u044B\u043B\u0438. \u041C\u0435\u0441\u0442\u043E \u043D\u0435\u0443\u044E\u0442\u043D\u043E\u0435:
      \u0445\u043E\u0447\u0435\u0442\u0441\u044F \u0443\u0439\u0442\u0438 \u043F\u043E\u0431\u044B\u0441\u0442\u0440\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369975
    m_Localized: "\u0421\u043D\u044F\u0442\u044C \u0437\u0430\u043F\u0447\u0430\u0441\u0442\u0438
      \u0434\u043B\u044F \u043F\u043E\u0432\u043E\u0437\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369976
    m_Localized: "\u0421\u043E \u0441\u0442\u0430\u0440\u044B\u0445 \u043F\u043E\u0432\u043E\u0437\u043E\u043A
      \u0441\u043D\u044F\u0442\u044B \u0441\u043F\u0438\u0446\u044B, \u0434\u043E\u0441\u043A\u0438
      \u0438 \u0436\u0435\u043B\u0435\u0437\u043D\u0430\u044F \u043E\u0431\u0438\u0432\u043A\u0430.
      \u041F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F \u0434\u043B\u044F
      \u043F\u043E\u0447\u0438\u043D\u043A\u0438 \u0432 \u0434\u043E\u0440\u043E\u0433\u0435.
      \u0422\u0440\u0435\u0432\u043E\u0436\u043D\u043E\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043E
      \u043D\u0435 \u043F\u043E\u043A\u0438\u0434\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369977
    m_Localized: "\u0418\u0434\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707525369978
    m_Localized: "\u041B\u0443\u0447\u0448\u0435 \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u0442\u044C
      \u0447\u0443\u0436\u043E\u0435: \u043C\u0430\u043B\u043E \u043B\u0438 \u0447\u0442\u043E
      \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C \u0441 \u043F\u0440\u0435\u0436\u043D\u0438\u043C\u0438
      \u0445\u043E\u0437\u044F\u0435\u0432\u0430\u043C\u0438. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u0440\u043E\u0448\u0451\u043B \u043C\u0438\u043C\u043E, \u043D\u043E
      \u043C\u0440\u0430\u0447\u043D\u0430\u044F \u043D\u0430\u0445\u043E\u0434\u043A\u0430
      \u0432\u0440\u0435\u0437\u0430\u043B\u0430\u0441\u044C \u0432 \u043F\u0430\u043C\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564160
    m_Localized: "\u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0439 \u043F\u0430\u0441\u0442\u0443\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564161
    m_Localized: "\u0423 \u043A\u0440\u0430\u044F \u0442\u0440\u043E\u043F\u044B
      \u043F\u0430\u0441\u0442\u0443\u0445 \u0432 \u0432\u043E\u0439\u043B\u043E\u0447\u043D\u043E\u0439
      \u0448\u0430\u043F\u043A\u0435 \u0433\u043E\u043D\u0438\u0442 \u043E\u0442\u0430\u0440\u0443
      \u0442\u043E\u0449\u0438\u0445 \u043E\u0432\u0435\u0446. \u0417\u0430\u0432\u0438\u0434\u0435\u0432
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D, \u043E\u043D \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044F
      \u043D\u0430 \u0431\u0443\u0440\u0434\u044E\u043A:\r\n\r\n<npc_speech lang=\"Turkic\">\u0412\u043E\u0434\u0430
      \u0435\u0441\u0442\u044C? \u041E\u0432\u0446\u044B \u043C\u043E\u0438 \u043C\u0443\u0447\u0430\u044E\u0442\u0441\u044F
      \u043E\u0442 \u0436\u0430\u0436\u0434\u044B. \u0414\u0430\u0432\u0430\u0439
      \u043E\u0431\u043C\u0435\u043D\u044F\u0435\u043C\u0441\u044F - \u0443 \u043C\u0435\u043D\u044F
      \u043A\u0443\u043C\u044B\u0441, \u0445\u043E\u0440\u043E\u0448\u0438\u0439.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564162
    m_Localized: "\u041E\u0431\u043C\u0435\u043D\u044F\u0442\u044C \u0432\u043E\u0434\u0443
      \u043D\u0430 \u043A\u0443\u043C\u044B\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564163
    m_Localized: "\u041E\u0431\u043C\u0435\u043D \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u0441\u044F
      \u0432 \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u043E\u043C \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0438.
      \u041A\u0443\u043C\u044B\u0441 \u0431\u043E\u0434\u0440\u0438\u0442 \u0438
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0434\u0443\u0445.
      \u041F\u0430\u0441\u0442\u0443\u0445 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E
      \u043A\u0438\u0432\u043D\u0443\u043B, \u043D\u0430\u043F\u043E\u0438\u043B
      \u043E\u0432\u0435\u0446 \u0438 \u0443\u0448\u0451\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564164
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564165
    m_Localized: "\u0412\u043E\u0434\u044B \u0438 \u0442\u0430\u043A \u043C\u0430\u043B\u043E.
      \u041F\u0430\u0441\u0442\u0443\u0445 \u043F\u043E\u0436\u0430\u043B \u043F\u043B\u0435\u0447\u0430\u043C\u0438
      \u0438 \u043F\u043E\u0433\u043D\u0430\u043B \u043E\u0432\u0435\u0446 \u0434\u0430\u043B\u044C\u0448\u0435,
      \u0431\u043E\u0440\u043C\u043E\u0447\u0430 \u0447\u0442\u043E-\u0442\u043E
      \u043D\u0430 \u0441\u0432\u043E\u0451\u043C \u044F\u0437\u044B\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564166
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0440\u0430\u0441\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564167
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0441 \u043F\u0430\u0441\u0442\u0443\u0445\u043E\u043C: <npc_speech lang=\"Turkic\">\u0417\u0434\u043E\u0440\u043E\u0432
      \u0431\u0443\u0434\u044C, \u0431\u0440\u0430\u0442! \u041C\u044B \u0438\u0449\u0435\u043C
      \u0432\u043E\u0434\u0443. \u0413\u0434\u0435 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0439
      \u043A\u043E\u043B\u043E\u0434\u0435\u0446? \u041F\u043E\u0434\u0441\u043A\u0430\u0436\u0438
      \u0434\u043E\u0440\u043E\u0433\u0443.</npc_speech> \u041F\u0430\u0441\u0442\u0443\u0445
      \u043E\u0436\u0438\u0432\u0438\u043B\u0441\u044F \u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B
      \u043E \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u043C \u0441\u0442\u043E\u0439\u0431\u0438\u0449\u0435
      \u0441 \u0447\u0438\u0441\u0442\u044B\u043C \u043A\u043E\u043B\u043E\u0434\u0446\u0435\u043C
      \u0432 \u043F\u043E\u043B\u0443\u0434\u043D\u0435 \u043F\u0443\u0442\u0438
      \u0438 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u043B \u043E
      \u0437\u044B\u0431\u0443\u0447\u0438\u0445 \u043F\u0435\u0441\u043A\u0430\u0445
      \u044E\u0436\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564168
    m_Localized: "\u041F\u0440\u043E\u043A\u043B\u044F\u0442\u044B\u0435 \u0440\u0443\u0438\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564169
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043D\u0430\u0442\u043A\u043D\u0443\u043B\u0441\u044F
      \u043D\u0430 \u0440\u0430\u0437\u0432\u0430\u043B\u0438\u043D\u044B \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u043E
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0433\u043E \u0445\u0440\u0430\u043C\u0430.
      \u0421\u0442\u0435\u043D\u044B \u043F\u043E\u043A\u0440\u044B\u0442\u044B \u043F\u043E\u043B\u0443\u0441\u0442\u0451\u0440\u0442\u044B\u043C\u0438
      \u0444\u0440\u0435\u0441\u043A\u0430\u043C\u0438 \u0441 \u043A\u0440\u044B\u043B\u0430\u0442\u044B\u043C\u0438
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0430\u043C\u0438. \u0423 \u0432\u0445\u043E\u0434\u0430
      - \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439 \u0430\u043B\u0442\u0430\u0440\u044C
      \u0441 \u0442\u0451\u043C\u043D\u044B\u043C\u0438 \u043F\u044F\u0442\u043D\u0430\u043C\u0438.
      \u0412\u0435\u0442\u0435\u0440 \u0432\u043E\u0435\u0442 \u0432 \u043F\u0443\u0441\u0442\u044B\u0445
      \u043E\u043A\u043E\u043D\u043D\u044B\u0445 \u043F\u0440\u043E\u0451\u043C\u0430\u0445,
      \u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u0431\u043B\u0435\u0434\u043D\u0435\u044E\u0442:
      \u043C\u0435\u0441\u0442\u043E \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564170
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0438 \u043E\u0431\u044B\u0441\u043A\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564171
    m_Localized: "\u0421\u0440\u0435\u0434\u0438 \u043E\u0431\u043B\u043E\u043C\u043A\u043E\u0432
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D \u043B\u0430\u0440\u0435\u0446
      \u0441 \u043B\u0430\u0437\u0443\u0440\u0438\u0442\u043E\u043C. \u041D\u043E
      \u0432\u043D\u0443\u0442\u0440\u0438 \u0441\u0442\u0430\u043B\u043E \u0445\u043E\u043B\u043E\u0434\u043D\u043E,
      \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u043E\u0432
      \u043A\u043B\u044F\u043D\u0443\u0442\u0441\u044F, \u0447\u0442\u043E \u0432\u0438\u0434\u0435\u043B\u0438
      \u0442\u0435\u043D\u044C \u043D\u0430 \u0441\u0442\u0435\u043D\u0435. \u0414\u0443\u0445
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u043F\u043E\u0434\u043E\u0440\u0432\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564172
    m_Localized: "\u0421\u043E\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564173
    m_Localized: "\u041B\u0430\u0434\u0430\u043D \u0432\u043E\u0437\u043B\u043E\u0436\u0435\u043D
      \u043D\u0430 \u0430\u043B\u0442\u0430\u0440\u044C. \u0414\u044B\u043C \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F
      \u0441\u0442\u043E\u043B\u0431\u043E\u043C, \u0438 \u0432\u0435\u0442\u0435\u0440
      \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E \u0441\u0442\u0438\u0445.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u043B\u0438\u0441\u044C,
      \u0430 \u043F\u043E\u0434 \u0430\u043B\u0442\u0430\u0440\u0451\u043C \u0431\u043B\u0435\u0441\u043D\u0443\u043B
      \u043B\u0430\u0437\u0443\u0440\u0438\u0442 - \u0431\u0443\u0434\u0442\u043E
      \u0445\u0440\u0430\u043C \u043F\u0440\u0438\u043D\u044F\u043B \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564174
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564175
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0441\u0434\u0435\u043B\u0430\u043B
      \u043A\u0440\u044E\u043A, \u043E\u0431\u0445\u043E\u0434\u044F \u0440\u0443\u0438\u043D\u044B.
      \u0414\u043E\u043B\u044C\u0448\u0435, \u043D\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435.
      \u041A\u0442\u043E \u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E \u0442\u0430\u0438\u0442\u0441\u044F
      \u0432 \u044D\u0442\u0438\u0445 \u0441\u0442\u0435\u043D\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564176
    m_Localized: "\u0417\u0432\u0451\u0437\u0434\u043D\u0430\u044F \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564177
    m_Localized: "\u041D\u043E\u0447\u043D\u043E\u0435 \u043D\u0435\u0431\u043E \u043F\u0443\u0441\u0442\u044B\u043D\u0438
      - \u0440\u043E\u0441\u0441\u044B\u043F\u044C \u0431\u0440\u0438\u043B\u043B\u0438\u0430\u043D\u0442\u043E\u0432
      \u043D\u0430 \u0447\u0451\u0440\u043D\u043E\u043C \u0431\u0430\u0440\u0445\u0430\u0442\u0435.
      \u0412\u043E\u0437\u0434\u0443\u0445 \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u0435\u043D,
      \u043D\u0438 \u043E\u0431\u043B\u0430\u0447\u043A\u0430. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A-\u0441\u0442\u0430\u0440\u043E\u0436\u0438\u043B
      \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043D\u0430 \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u044F
      \u0438 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      \u043D\u043E\u0447\u044C\u044E, \u043F\u043E\u043A\u0430 \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u043E,
      \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u0443\u044F\u0441\u044C \u043F\u043E
      \u0437\u0432\u0451\u0437\u0434\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564178
    m_Localized: "\u0414\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u043D\u043E\u0447\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564179
    m_Localized: "\u041F\u043E\u0434 \u0437\u0432\u0451\u0437\u0434\u0430\u043C\u0438
      \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u043E \u0438 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E.
      \u0412\u044B \u0431\u0435\u0437\u043E\u0448\u0438\u0431\u043E\u0447\u043D\u043E
      \u043F\u0440\u043E\u0448\u043B\u0438 \u043F\u043E \u041F\u043E\u043B\u044F\u0440\u043D\u043E\u0439
      \u0437\u0432\u0435\u0437\u0434\u0435 \u0438 \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043B\u0438
      \u0432\u043E\u0434\u0443, \u0438\u0437\u0431\u0435\u0436\u0430\u0432 \u0434\u043D\u0435\u0432\u043D\u043E\u0433\u043E
      \u0437\u043D\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564180
    m_Localized: "\u0412 \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0443\u0433\u043E\u0434\u0438\u043B\u0430 \u0432 \u044F\u043C\u0443, \u0430
      \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438\u0441\u044C.
      \u041A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u0435\u0435,
      \u0447\u0435\u043C \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564181
    m_Localized: "\u041E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
      \u0434\u043E \u0443\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564182
    m_Localized: "\u0421\u043F\u043E\u043A\u043E\u0439\u043D\u0430\u044F \u043D\u043E\u0447\u044C
      \u043F\u043E\u0434 \u0437\u0432\u0451\u0437\u0434\u0430\u043C\u0438. \u0423\u0442\u0440\u043E\u043C
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u044B\u043C \u043F\u0443\u0442\u0451\u043C
      \u043F\u043E\u0434 \u043F\u0430\u043B\u044F\u0449\u0438\u043C \u0441\u043E\u043B\u043D\u0446\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564183
    m_Localized: "\u0417\u0430\u0441\u0430\u0434\u0430 \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564184
    m_Localized: "\u0418\u0437-\u0437\u0430 \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u0445
      \u0432\u044B\u0441\u0442\u0443\u043F\u043E\u0432 \u0432\u044B\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u044E\u0442
      \u043B\u044E\u0434\u0438 \u0432 \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u043E\u0439
      \u0442\u0430\u043D\u0441\u043A\u043E\u0439 \u0432\u043E\u0435\u043D\u043D\u043E\u0439
      \u0444\u043E\u0440\u043C\u0435. \u0414\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u044B
      \u0441 \u0438\u043C\u043F\u0435\u0440\u0441\u043A\u043E\u0439 \u0437\u0430\u0441\u0442\u0430\u0432\u044B
      - \u0433\u043E\u043B\u043E\u0434\u043D\u044B\u0435, \u043E\u0442\u0447\u0430\u044F\u043D\u043D\u044B\u0435,
      \u0441 \u043C\u0435\u0447\u0430\u043C\u0438 \u0438 \u043A\u043E\u043F\u044C\u044F\u043C\u0438.
      \u0418\u0445 \u043D\u0435\u043C\u043D\u043E\u0433\u043E, \u043D\u043E \u0442\u0435\u0440\u044F\u0442\u044C
      \u0438\u043C \u043D\u0435\u0447\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564185
    m_Localized: "\u0414\u0430\u0442\u044C \u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564186
    m_Localized: "\u0414\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u044B \u0434\u0440\u0430\u043B\u0438\u0441\u044C
      \u043E\u0442\u0447\u0430\u044F\u043D\u043D\u043E, \u043D\u043E \u0431\u0435\u0437
      \u0441\u0442\u0440\u043E\u044F \u0438 \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u044B.
      \u041E\u0442\u0431\u0438\u043B\u0438\u0441\u044C, \u043F\u043E\u0442\u0435\u0440\u044F\u0432
      \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u0432 \u0432\u043C\u044F\u0442\u0438\u043D\u044B
      \u043D\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564187
    m_Localized: "\u041D\u0430\u043A\u043E\u0440\u043C\u0438\u0442\u044C \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564188
    m_Localized: "\u0412\u044B \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B\u0438
      \u0435\u0434\u0443 \u0432\u043C\u0435\u0441\u0442\u043E \u0431\u043E\u044F.
      \u0414\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u044B \u0436\u0430\u0434\u043D\u043E
      \u043D\u0430\u0431\u0440\u043E\u0441\u0438\u043B\u0438\u0441\u044C \u043D\u0430
      \u0445\u043B\u0435\u0431 \u0438 \u043C\u044F\u0441\u043E. \u0421\u0442\u0430\u0440\u0448\u0438\u0439
      \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u043B\u0441\u044F: \"\u041C\u044B
      \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u0435\u043C\". \u041E\u043D\u0438
      \u0443\u0448\u043B\u0438 \u043D\u0430 \u044E\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564189
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043A\u043E\u043C\u0430\u043D\u0434\u0443\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564190
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0432\u044B\u0448\u0435\u043B
      \u0432\u043F\u0435\u0440\u0451\u0434 \u0438 \u0433\u0430\u0440\u043A\u043D\u0443\u043B
      \u043D\u0430 \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u043E\u0432 \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u043C
      \u0433\u043E\u043B\u043E\u0441\u043E\u043C. \u0422\u0435 \u043F\u043E \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u0435
      \u0432\u0441\u0442\u0430\u043B\u0438 \u043D\u0430\u0432\u044B\u0442\u044F\u0436\u043A\u0443.
      \u0420\u0430\u0437\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0448\u043B\u043E
      \u0431\u0435\u0437 \u043A\u0440\u043E\u0432\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564191
    m_Localized: "\u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u0431\u0430\u043D\u043A\u0438\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564192
    m_Localized: "\u0423 \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u044F
      \u0441\u0438\u0434\u0438\u0442 \u043F\u043E\u0436\u0438\u043B\u043E\u0439 \u0441\u043E\u0433\u0434\u0438\u0435\u0446
      \u0437\u0430 \u043D\u0438\u0437\u043A\u0438\u043C \u0441\u0442\u043E\u043B\u0438\u043A\u043E\u043C,
      \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u044F \u0441\u0447\u0451\u0442\u043D\u044B\u0435
      \u043A\u043E\u0441\u0442\u0438. \u042D\u0442\u043E \u043C\u0435\u043D\u044F\u043B\u0430
      \u0438 \u0431\u0430\u043D\u043A\u0438\u0440 - \u0435\u0433\u043E \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0438
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044E\u0442 \u043E\u0442 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      \u0434\u043E \u0427\u0430\u043D\u044A\u0430\u043D\u0438. \u041E\u043D \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u043A \u0432\u0430\u043C:\r\n\r\n<npc_speech lang=\"Sogdian\">\u0423\u0432\u0430\u0436\u0430\u0435\u043C\u044B\u0439
      \u043A\u0443\u043F\u0435\u0446! \u042F \u043C\u0435\u043D\u044F\u043B\u0430.
      \u0415\u0441\u043B\u0438 \u043D\u0443\u0436\u0434\u0430 \u0435\u0441\u0442\u044C,
      \u043C\u043E\u0433\u0443 \u043E\u0431\u043C\u0435\u043D\u044F\u0442\u044C \u0432\u0430\u0448\u0438
      \u0434\u0435\u043D\u044C\u0433\u0438 \u0441 \u043C\u0430\u043B\u043E\u0439
      \u0434\u043E\u043B\u0435\u0439.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564193
    m_Localized: "\u0412\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0443\u0441\u043B\u0443\u0433\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564194
    m_Localized: "\u041F\u043E\u043D\u0438\u043C\u0430\u044F \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u043E\u0431\u044B\u0447\u0430\u0439,
      \u0432\u044B \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C
      \u043E \u0432\u044B\u0433\u043E\u0434\u043D\u043E\u043C \u043E\u0431\u043C\u0435\u043D\u0435.
      \u0411\u0430\u043D\u043A\u0438\u0440 \u0432\u044B\u0434\u0430\u043B \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0443,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043F\u0440\u0438\u043C\u0443\u0442
      \u0432 \u043B\u044E\u0431\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u0435
      \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u0433\u043E \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564195
    m_Localized: "\u041E\u0431\u043C\u0435\u043D \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u0441\u044F,
      \u043D\u043E \u0431\u0435\u0437 \u0437\u043D\u0430\u043D\u0438\u044F \u044F\u0437\u044B\u043A\u0430
      \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u044F \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u0432\u044B\u0448\u0435, \u0447\u0435\u043C \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C
      \u0431\u044B. \u0412\u0441\u0451 \u0436\u0435 \u043B\u0443\u0447\u0448\u0435,
      \u0447\u0435\u043C \u043D\u0438\u0447\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564196
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564197
    m_Localized: "\u0412\u044B \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B\u0438
      \u0438 \u043F\u0440\u043E\u0448\u043B\u0438 \u043C\u0438\u043C\u043E. \u0421\u043E\u0433\u0434\u0438\u0435\u0446
      \u043F\u043E\u0436\u0430\u043B \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043A \u0441\u0432\u043E\u0438\u043C
      \u043A\u043E\u0441\u0442\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564198
    m_Localized: "\u041F\u0435\u0449\u0435\u0440\u043D\u044B\u0439 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564199
    m_Localized: "\u0412 \u043E\u0442\u0432\u0435\u0441\u043D\u043E\u0439 \u0441\u043A\u0430\u043B\u0435
      \u043D\u0430\u0434 \u0442\u0440\u043E\u043F\u043E\u0439 \u0442\u0435\u043C\u043D\u0435\u044E\u0442
      \u043E\u0442\u0432\u0435\u0440\u0441\u0442\u0438\u044F \u043F\u0435\u0449\u0435\u0440.
      \u042D\u0442\u043E \u0431\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C - \u0441\u0442\u0435\u043D\u044B
      \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u044B \u044F\u0440\u043A\u0438\u043C\u0438
      \u0444\u0440\u0435\u0441\u043A\u0430\u043C\u0438, \u0430 \u0432 \u043D\u0438\u0448\u0430\u0445
      \u0441\u0438\u0434\u044F\u0442 \u043C\u043E\u043D\u0430\u0445\u0438 \u0432
      \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u0432\u044B\u0445 \u043E\u0434\u0435\u0436\u0434\u0430\u0445.
      \u0417\u0430\u043F\u0430\u0445 \u0441\u0430\u043D\u0434\u0430\u043B\u0430 \u0438
      \u0442\u0438\u0448\u0438\u043D\u0430. \u041C\u043E\u043D\u0430\u0445\u0438
      \u0436\u0435\u0441\u0442\u0430\u043C\u0438 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u044E\u0442
      \u0432\u043D\u0443\u0442\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564200
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0438 \u043F\u043E\u043C\u043E\u043B\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564201
    m_Localized: "\u041F\u0440\u043E\u0445\u043B\u0430\u0434\u0430 \u043F\u0435\u0449\u0435\u0440,
      \u0447\u0438\u0441\u0442\u0430\u044F \u0432\u043E\u0434\u0430 \u0438\u0437
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430, \u043F\u043E\u043A\u043E\u0439.
      \u041C\u043E\u043D\u0430\u0445\u0438 \u0443\u0433\u043E\u0441\u0442\u0438\u043B\u0438
      \u0440\u0438\u0441\u043E\u043C \u0438 \u0447\u0430\u0435\u043C. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u043B\u0438 \u0442\u0435\u043B\u043E\u043C
      \u0438 \u0434\u0443\u0445\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564202
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0431\u0443\u043C\u0430\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564203
    m_Localized: "\u041C\u043E\u043D\u0430\u0445\u0438 \u043F\u043E\u0434\u0435\u043B\u0438\u043B\u0438\u0441\u044C
      \u0441\u0432\u0438\u0442\u043A\u043E\u043C \u0442\u043E\u043D\u043A\u043E\u0439
      \u0431\u0443\u043C\u0430\u0433\u0438 - \u0437\u0434\u0435\u0441\u044C \u0435\u0451
      \u0434\u0435\u043B\u0430\u044E\u0442 \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u043A\u0438
      \u0441\u0443\u0442\u0440. \u0426\u0435\u043D\u043D\u044B\u0439 \u0442\u043E\u0432\u0430\u0440
      \u043D\u0430 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445 \u0440\u044B\u043D\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564204
    m_Localized: "\u041D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564205
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435, \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F\u0441\u044C
      \u0443 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F. \u0412\u0440\u0435\u043C\u044F
      - \u0434\u0435\u043D\u044C\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564206
    m_Localized: "\u041F\u044B\u043B\u044C\u043D\u044B\u0439 \u0432\u0438\u0445\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564207
    m_Localized: "\u0418\u0437 \u043D\u0438\u043E\u0442\u043A\u0443\u0434\u0430 \u0432\u0437\u0432\u0438\u043B\u0441\u044F
      \u0441\u0442\u043E\u043B\u0431 \u043F\u0435\u0441\u043A\u0430 \u0432\u044B\u0441\u043E\u0442\u043E\u0439
      \u0432 \u0442\u0440\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0445
      \u0440\u043E\u0441\u0442\u0430. \u041F\u044B\u043B\u044C\u043D\u044B\u0439
      \u0432\u0438\u0445\u0440\u044C \u043D\u0435\u0441\u0451\u0442\u0441\u044F \u043F\u0440\u044F\u043C\u043E
      \u043D\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D, \u0441\u0440\u044B\u0432\u0430\u044F
      \u0442\u043A\u0430\u043D\u044C \u0441 \u043F\u043E\u0432\u043E\u0437\u043E\u043A
      \u0438 \u0448\u0432\u044B\u0440\u044F\u044F \u043F\u0435\u0441\u043E\u043A
      \u0432 \u0433\u043B\u0430\u0437\u0430. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u0440\u0435\u0432\u0443\u0442, \u043B\u044E\u0434\u0438 \u043F\u0440\u0438\u0436\u0438\u043C\u0430\u044E\u0442\u0441\u044F
      \u043A \u0437\u0435\u043C\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564208
    m_Localized: "\u0423\u043A\u0440\u044B\u0442\u044C\u0441\u044F \u0437\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564209
    m_Localized: "\u0412\u0438\u0445\u0440\u044C \u043F\u0440\u043E\u043C\u0447\u0430\u043B\u0441\u044F
      \u0437\u0430 \u043C\u0438\u043D\u0443\u0442\u0443, \u043D\u043E \u043D\u0430\u0432\u0435\u0441\u044B
      \u0441\u043E\u0440\u0432\u0430\u043D\u044B, \u043F\u0435\u0441\u043E\u043A
      \u0437\u0430\u0431\u0438\u043B \u0432\u0441\u0451. \u041F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u044B, \u0447\u0430\u0441\u0442\u044C
      \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u0437\u0430\u0441\u044B\u043F\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564210
    m_Localized: "\u0420\u0430\u0441\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564211
    m_Localized: "\u041B\u044E\u0434\u0438 \u0438 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435
      \u0440\u0430\u0437\u0431\u0435\u0436\u0430\u043B\u0438\u0441\u044C \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u044B.
      \u0412\u0438\u0445\u0440\u044C \u0437\u0430\u0446\u0435\u043F\u0438\u043B \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
      \u0442\u0435\u043B\u0435\u0433\u0443, \u043E\u043F\u0440\u043E\u043A\u0438\u043D\u0443\u0432
      \u0435\u0451. \u0421\u0431\u043E\u0440 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0437\u0430\u043D\u044F\u043B \u043F\u043E\u043B\u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564212
    m_Localized: "\u0410\u0440\u0430\u0431\u0441\u043A\u0438\u0439 \u043A\u0430\u043F\u0438\u0442\u0430\u043D
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564213
    m_Localized: "\u041D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F
      \u043A\u0440\u0443\u043F\u043D\u044B\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u043E\u0434 \u0437\u0435\u043B\u0451\u043D\u044B\u043C\u0438 \u0437\u043D\u0430\u043C\u0451\u043D\u0430\u043C\u0438.
      \u0415\u0433\u043E \u043A\u0430\u043F\u0438\u0442\u0430\u043D - \u0441\u0435\u0434\u043E\u0431\u043E\u0440\u043E\u0434\u044B\u0439
      \u0430\u0440\u0430\u0431 \u0432 \u0431\u0435\u043B\u043E\u043C \u0442\u044E\u0440\u0431\u0430\u043D\u0435
      - \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0441
      \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435\u043C:\r\n\r\n<npc_speech
      lang=\"Arabic\">\u042D\u0439, \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A!
      \u0421\u043E\u043B\u043D\u0446\u0435 \u043F\u0430\u043B\u0438\u0442, \u0430
      \u043F\u0443\u0442\u044C \u0434\u0430\u043B\u0451\u043A. \u041D\u0435 \u0445\u043E\u0442\u0438\u0442\u0435
      \u043B\u0438 \u043F\u0440\u0438\u043C\u043A\u043D\u0443\u0442\u044C \u043A
      \u043D\u0430\u0448\u0435\u043C\u0443 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443?
      \u0412\u043C\u0435\u0441\u0442\u0435 \u043B\u0435\u0433\u0447\u0435!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564214
    m_Localized: "\u041F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564215
    m_Localized: "\u0421\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u043F\u0443\u0442\u044C
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435. \u0417\u0430
      \u0443\u0436\u0438\u043D\u0430\u043C\u0438 \u0443 \u043E\u0431\u0449\u0435\u0433\u043E
      \u043A\u043E\u0441\u0442\u0440\u0430 \u0432\u044B \u043F\u043E\u0434\u0442\u044F\u043D\u0443\u043B\u0438
      \u0430\u0440\u0430\u0431\u0441\u043A\u0438\u0439 \u0438 \u0443\u0437\u043D\u0430\u043B\u0438
      \u043E \u0446\u0435\u043D\u0430\u0445 \u0432 \u041C\u0435\u043A\u043A\u0435.
      \u041A\u0430\u043F\u0438\u0442\u0430\u043D \u0441\u0442\u0430\u043B \u0443\u0432\u0430\u0436\u0430\u0442\u044C
      \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564216
    m_Localized: "\u0418\u0434\u0442\u0438 \u0432\u043C\u0435\u0441\u0442\u0435 -
      \u0437\u043D\u0430\u0447\u0438\u0442 \u043F\u043E\u0434\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      \u043F\u043E\u0434 \u0447\u0443\u0436\u043E\u0439 \u0440\u0438\u0442\u043C.
      \u041F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u0443\u0448\u043B\u043E \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043B\u043E\u0441\u044C,
      \u043D\u043E \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0447\u0443\u0442\u044C
      \u0441\u043D\u0438\u0437\u0438\u043B\u0430\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564217
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u043B\u043E\u043D\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564218
    m_Localized: "\u041A\u0430\u043F\u0438\u0442\u0430\u043D \u043A\u0438\u0432\u043D\u0443\u043B
      \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u044B
      \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C, \u0438 \u043F\u0443\u0441\u0442\u044B\u043D\u044F
      \u0441\u043D\u043E\u0432\u0430 \u0441\u0442\u0430\u043B\u0430 \u043F\u0443\u0441\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564219
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u0431\u0435\u0441\u0435\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564220
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043E\u0431\u0440\u0430\u0442\u0438\u043B\u0441\u044F
      \u043A \u043A\u0430\u043F\u0438\u0442\u0430\u043D\u0443: <npc_speech lang=\"Arabic\">\u041C\u0438\u0440
      \u0432\u0430\u043C, \u043F\u043E\u0447\u0442\u0435\u043D\u043D\u044B\u0439.
      \u041D\u0430\u0448 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0438\u0449\u0435\u0442
      \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A\u043E\u0432 - \u0432\u043C\u0435\u0441\u0442\u0435
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435.
      \u041D\u0435 \u043F\u043E\u0434\u0435\u043B\u0438\u0442\u0435\u0441\u044C \u043B\u0438
      \u0437\u043D\u0430\u043D\u0438\u0435\u043C \u043A\u043E\u043B\u043E\u0434\u0446\u0435\u0432?</npc_speech>
      \u041A\u0430\u043F\u0438\u0442\u0430\u043D \u0440\u0430\u0441\u043F\u043B\u044B\u043B\u0441\u044F
      \u0432 \u0443\u043B\u044B\u0431\u043A\u0435 \u0438 \u043F\u043E\u0434\u0435\u043B\u0438\u043B\u0441\u044F
      \u043A\u0430\u0440\u0442\u043E\u0439 \u043A\u043E\u043B\u043E\u0434\u0446\u0435\u0432,
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B \u043E \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0445
      \u0441\u0442\u043E\u044F\u043D\u043A\u0430\u0445. \u0421\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u044B\u0439
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434 \u043F\u0440\u043E\u0448\u0451\u043B
      \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564221
    m_Localized: "\u041E\u0442\u0448\u0435\u043B\u044C\u043D\u0438\u043A-\u043C\u0443\u0434\u0440\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564222
    m_Localized: "\u0412 \u0442\u0435\u043D\u0438 \u043E\u0434\u0438\u043D\u043E\u043A\u043E\u0433\u043E
      \u0441\u0430\u043A\u0441\u0430\u0443\u043B\u0430 \u0441\u0438\u0434\u0438\u0442
      \u0441\u0442\u0430\u0440\u0438\u043A \u0432 \u043B\u043E\u0445\u043C\u043E\u0442\u044C\u044F\u0445,
      \u0441\u043A\u0440\u0435\u0441\u0442\u0438\u0432 \u043D\u043E\u0433\u0438.
      \u0415\u0433\u043E \u0433\u043B\u0430\u0437\u0430 \u044F\u0441\u043D\u044B,
      \u043A\u0430\u043A \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u043E\u0435 \u043D\u0435\u0431\u043E.
      \u041E\u043D \u043D\u0435 \u043F\u0440\u043E\u0441\u0438\u0442 \u043D\u0438
      \u0432\u043E\u0434\u044B, \u043D\u0438 \u0435\u0434\u044B. \u0423\u0432\u0438\u0434\u0435\u0432
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D, \u043E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0440\u0443\u043A\u0443 \u0438 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043B\u043E\u0432
      \u043D\u0430 \u0447\u0438\u0441\u0442\u043E\u043C \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C,
      \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u043C \u0438 \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u043C
      \u043F\u043E\u043F\u0435\u0440\u0435\u043C\u0435\u043D\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564223
    m_Localized: "\u0412\u044B\u0441\u043B\u0443\u0448\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564224
    m_Localized: "\u0421\u0442\u0430\u0440\u0438\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u043E \u0434\u043E\u0440\u043E\u0433\u0430\u0445, \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0435
      \u0438 \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0438. \u041F\u0440\u043E\u0441\u0442\u044B\u0435
      \u0441\u043B\u043E\u0432\u0430, \u043D\u043E \u043E\u043D\u0438 \u043E\u0441\u0435\u043B\u0438
      \u0432 \u0434\u0443\u0448\u0435. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u043F\u0440\u0438\u0442\u0438\u0445\u043B\u0438 \u0438 \u0437\u0430\u0434\u0443\u043C\u0430\u043B\u0438\u0441\u044C.
      \u0411\u0443\u0434\u0442\u043E \u0432\u0435\u0441 \u043F\u0443\u0441\u0442\u044B\u043D\u0438
      \u0441\u0442\u0430\u043B \u043B\u0435\u0433\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564225
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0432\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707529564226
    m_Localized: "\u0421\u0442\u0430\u0440\u0438\u043A \u043F\u0440\u0438\u043D\u044F\u043B
      \u0432\u043E\u0434\u0443, \u043E\u0442\u043F\u0438\u043B \u0433\u043B\u043E\u0442\u043E\u043A
      \u0438 \u0432\u0435\u0440\u043D\u0443\u043B. \"\u0429\u0435\u0434\u0440\u043E\u0441\u0442\u044C
      - \u043B\u0443\u0447\u0448\u0438\u0439 \u0442\u043E\u0432\u0430\u0440\", -
      \u0441\u043A\u0430\u0437\u0430\u043B \u043E\u043D. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438 \u044D\u0442\u0438 \u0441\u043B\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758464
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758465
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0448\u0451\u043B
      \u043C\u0438\u043C\u043E. \u0421\u0442\u0430\u0440\u0438\u043A \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B
      \u0435\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C, \u043D\u0435
      \u0448\u0435\u0432\u0435\u043B\u044C\u043D\u0443\u0432\u0448\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758466
    m_Localized: "\u0414\u0436\u0438\u043D\u043D \u043C\u0438\u0440\u0430\u0436\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758467
    m_Localized: "\u041C\u0438\u0440\u0430\u0436 \u043E\u0431\u0440\u0435\u0442\u0430\u0435\u0442
      \u0444\u043E\u0440\u043C\u0443: \u0432 \u0434\u0440\u043E\u0436\u0430\u0449\u0435\u043C
      \u0432\u043E\u0437\u0434\u0443\u0445\u0435 \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u0430\u0435\u0442
      \u0444\u0438\u0433\u0443\u0440\u0430 \u0432 \u0437\u043E\u043B\u043E\u0442\u044B\u0445
      \u043E\u0434\u0435\u0436\u0434\u0430\u0445. \u041E\u043D\u0430 \u043F\u0430\u0440\u0438\u0442
      \u043D\u0430\u0434 \u043F\u0435\u0441\u043A\u043E\u043C \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u0432\u0430\u0441. \u0413\u043E\u043B\u043E\u0441,
      \u043F\u043E\u0445\u043E\u0436\u0438\u0439 \u043D\u0430 \u0448\u0451\u043F\u043E\u0442
      \u0432\u0435\u0442\u0440\u0430, \u0437\u0432\u0443\u0447\u0438\u0442 \u0432
      \u0433\u043E\u043B\u043E\u0432\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E:
      \"\u042F \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044E \u0441\u0434\u0435\u043B\u043A\u0443.
      \u041A\u0430\u043C\u0435\u043D\u044C \u0437\u0430 \u043E\u0442\u0432\u0435\u0442.\""
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758468
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0434\u0435\u043B\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758469
    m_Localized: "\u0412\u044B \u043E\u0442\u0432\u0435\u0442\u0438\u043B\u0438 \u043D\u0430
      \u0437\u0430\u0433\u0430\u0434\u043A\u0443 \u0434\u0436\u0438\u043D\u043D\u0430.
      \u0424\u0438\u0433\u0443\u0440\u0430 \u0440\u0430\u0441\u0441\u043C\u0435\u044F\u043B\u0430\u0441\u044C,
      \u0438 \u0438\u0437 \u0432\u043E\u0437\u0434\u0443\u0445\u0430 \u0432 \u0432\u0430\u0448\u0438
      \u0440\u0443\u043A\u0438 \u0443\u043F\u0430\u043B\u0430 \u0431\u0438\u0440\u044E\u0437\u0430
      \u043D\u0435\u0432\u0438\u0434\u0430\u043D\u043D\u043E\u0439 \u0447\u0438\u0441\u0442\u043E\u0442\u044B.
      \u041C\u0438\u0440\u0430\u0436 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758470
    m_Localized: "\u041E\u0442\u0432\u0435\u0442 \u043D\u0435 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u043B\u0441\u044F
      \u0434\u0436\u0438\u043D\u043D\u0443. \u041B\u0435\u0434\u044F\u043D\u043E\u0439
      \u0432\u0435\u0442\u0435\u0440 \u0443\u0434\u0430\u0440\u0438\u043B \u0432
      \u043B\u0438\u0446\u043E, \u0430 \u0432 \u0433\u043E\u043B\u043E\u0432\u0435
      \u0437\u0430\u0437\u0432\u0435\u043D\u0435\u043B\u043E. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0432 \u043F\u0430\u043D\u0438\u043A\u0435 - \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0431\u0440\u043E\u0441\u0438\u043B\u0438\u0441\u044C \u0431\u0435\u0436\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758471
    m_Localized: "\u041E\u0442\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758472
    m_Localized: "\u0412\u044B \u043E\u0442\u0432\u0435\u043B\u0438 \u0432\u0437\u0433\u043B\u044F\u0434.
      \u0424\u0438\u0433\u0443\u0440\u0430 \u0440\u0430\u0441\u0442\u0430\u044F\u043B\u0430,
      \u043E\u0441\u0442\u0430\u0432\u0438\u0432 \u043B\u0438\u0448\u044C \u0437\u0430\u043F\u0430\u0445
      \u0433\u043E\u0440\u044F\u0447\u0435\u0433\u043E \u043F\u0435\u0441\u043A\u0430.
      \u041B\u044E\u0434\u0438 \u043C\u043E\u043B\u0447\u0430\u0442 - \u043A\u0430\u0436\u0434\u044B\u0439
      \u0434\u0443\u043C\u0430\u0435\u0442 \u043E \u0442\u043E\u043C, \u0447\u0442\u043E
      \u0432\u0438\u0434\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758473
    m_Localized: "\u0413\u0430\u0434\u044E\u043A\u0430 \u0432 \u0433\u0440\u0443\u0437\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758474
    m_Localized: "\u041F\u0440\u0438 \u0440\u0430\u0437\u0433\u0440\u0443\u0437\u043A\u0435
      \u0438\u0437-\u043F\u043E\u0434 \u0442\u044E\u043A\u0430 \u0432\u044B\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0430
      \u043F\u0435\u0441\u0447\u0430\u043D\u0430\u044F \u0433\u0430\u0434\u044E\u043A\u0430
      \u0438 \u0443\u043A\u0443\u0441\u0438\u043B\u0430 \u0433\u0440\u0443\u0437\u0447\u0438\u043A\u0430
      \u0432 \u0440\u0443\u043A\u0443. \u0427\u0435\u043B\u043E\u0432\u0435\u043A
      \u043F\u043E\u0431\u043B\u0435\u0434\u043D\u0435\u043B, \u0440\u0443\u043A\u0430
      \u043E\u043F\u0443\u0445\u0430\u0435\u0442 \u043D\u0430 \u0433\u043B\u0430\u0437\u0430\u0445.
      \u042F\u0434 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u0431\u044B\u0441\u0442\u0440\u043E
      - \u043D\u0443\u0436\u043D\u043E \u0440\u0435\u0448\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758475
    m_Localized: "\u0412\u044B\u0441\u043E\u0441\u0430\u0442\u044C \u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758476
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0441\u043F\u043E\u0441\u043E\u0431.
      \u042F\u0434 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E \u0443\u0434\u0430\u043B\u0451\u043D,
      \u043D\u043E \u0440\u0443\u043A\u0430 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u0440\u0430\u0441\u043F\u0443\u0445\u043B\u0430. \u0413\u0440\u0443\u0437\u0447\u0438\u043A
      \u0441\u043B\u0451\u0433 \u043D\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0443.
      \u0420\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u043D\u0435\u043A\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758477
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u0442\u044C \u0438
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758478
    m_Localized: "\u041F\u0435\u0440\u0435\u0442\u044F\u043D\u0443\u0442\u0430\u044F
      \u0440\u0443\u043A\u0430 \u043F\u043E\u0441\u0438\u043D\u0435\u043B\u0430.
      \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u0433\u0440\u0443\u0437\u0447\u0438\u043A\u0443
      \u0441\u0442\u0430\u043B\u043E \u0445\u0443\u0436\u0435 - \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0430.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043D\u043E\u0447\u0435\u0432\u0430\u043B
      \u0432 \u0442\u0440\u0435\u0432\u043E\u0433\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758479
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043F\u0440\u0438\u043C\u0435\u043D\u044F\u0435\u0442
      \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u044F\u0434\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758480
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043D\u0430\u0434\u0440\u0435\u0437\u0430\u043B
      \u0440\u0430\u043D\u043A\u0443, \u043D\u0430\u043B\u043E\u0436\u0438\u043B
      \u0442\u0440\u0430\u0432\u044F\u043D\u043E\u0439 \u043A\u043E\u043C\u043F\u0440\u0435\u0441\u0441
      \u0438 \u0434\u0430\u043B \u043E\u0442\u0432\u0430\u0440. \u041A \u0443\u0442\u0440\u0443
      \u043E\u043F\u0443\u0445\u043E\u043B\u044C \u0441\u043F\u0430\u043B\u0430.
      \u0413\u0440\u0443\u0437\u0447\u0438\u043A \u0441\u043B\u0430\u0431, \u043D\u043E
      \u0436\u0438\u0442\u044C \u0431\u0443\u0434\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758481
    m_Localized: "\u041D\u0430\u0431\u0435\u0433 \u0431\u0435\u0434\u0443\u0438\u043D\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758482
    m_Localized: "\u0412\u0435\u0440\u0431\u043B\u044E\u0436\u044C\u0438 \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u0438
      \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C \u0438\u0437-\u0437\u0430
      \u0433\u0440\u044F\u0434\u044B \u0434\u044E\u043D \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435,
      \u043A\u043E\u0433\u0434\u0430 \u043B\u0430\u0433\u0435\u0440\u044C \u0435\u0449\u0451
      \u043D\u0435 \u0441\u0432\u0451\u0440\u043D\u0443\u0442. \u041E\u043D\u0438
      \u043C\u0447\u0430\u0442\u0441\u044F \u0441 \u0432\u043E\u0435\u043C, \u0440\u0430\u0437\u0432\u0435\u0432\u0430\u044F
      \u0447\u0451\u0440\u043D\u044B\u0435 \u043F\u043B\u0430\u0442\u043A\u0438.
      \u042D\u0442\u043E \u0440\u0435\u0439\u0434 - \u0431\u044B\u0441\u0442\u0440\u044B\u0439
      \u0443\u0434\u0430\u0440 \u0438 \u043E\u0442\u0445\u043E\u0434. \u041E\u043D\u0438
      \u0446\u0435\u043B\u044F\u0442\u0441\u044F \u043D\u0430 \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u0438 \u0441\u043A\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758483
    m_Localized: "\u041E\u0431\u043E\u0440\u043E\u043D\u044F\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758484
    m_Localized: "\u0411\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0442\u0435\u0447\u0435\u043D,
      \u043D\u043E \u044F\u0440\u043E\u0441\u0442\u0435\u043D. \u0411\u0435\u0434\u0443\u0438\u043D\u044B
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438, \u0443\u0433\u043D\u0430\u0432
      \u0434\u0432\u0443\u0445 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0430 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0430,
      \u0430 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u043C\u0440\u0430\u0447\u043D\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758485
    m_Localized: "\u041E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F \u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758486
    m_Localized: "\u0412\u044B \u0432\u044B\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u043C\u0435\u0448\u043A\u0438 \u0441 \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0435\u0439
      \u043D\u0430 \u0432\u0438\u0434\u0443. \u0411\u0435\u0434\u0443\u0438\u043D\u044B
      \u043F\u043E\u0434\u0445\u0432\u0430\u0442\u0438\u043B\u0438 \u0438\u0445 \u043D\u0435
      \u0441\u043F\u0435\u0448\u0438\u0432\u0430\u044F\u0441\u044C \u0438 \u0443\u043C\u0447\u0430\u043B\u0438\u0441\u044C.
      \u0414\u0451\u0448\u0435\u0432\u043E \u043E\u0442\u0434\u0435\u043B\u0430\u043B\u0438\u0441\u044C
      - \u043C\u043E\u0433\u043B\u043E \u0431\u044B\u0442\u044C \u0445\u0443\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758487
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0432\u044B\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442
      \u043E\u0431\u043E\u0440\u043E\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758488
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E
      \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u043B \u043B\u044E\u0434\u0435\u0439
      \u0437\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u043C\u0438 \u0438
      \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u043B \u0441\u0442\u0440\u0435\u043B\u044C\u0431\u0443.
      \u0411\u0435\u0434\u0443\u0438\u043D\u044B, \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0432
      \u043E\u0442\u043F\u043E\u0440, \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u0438 \u0443\u0448\u043B\u0438 \u0431\u0435\u0437 \u0434\u043E\u0431\u044B\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758489
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043B\u0430\u0434\u0430\u043D\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758490
    m_Localized: "\u041D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435 \u043A
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u0441\u043C\u0443\u0433\u043B\u044B\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0441 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u043C, \u043D\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u043C
      \u0431\u043B\u0430\u0433\u043E\u0432\u043E\u043D\u0438\u044F\u043C\u0438. \u0417\u0430\u043F\u0430\u0445
      \u043B\u0430\u0434\u0430\u043D\u0430 \u0438 \u043C\u0438\u0440\u0440\u044B
      \u043E\u043A\u0443\u0442\u044B\u0432\u0430\u0435\u0442 \u0441\u0442\u043E\u044F\u043D\u043A\u0443.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0440\u0430\u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043E\u0431\u0440\u0430\u0437\u0446\u044B \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F:\r\n\r\n<npc_speech
      lang=\"Arabic\">\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C!
      \u0423 \u043C\u0435\u043D\u044F \u043B\u0430\u0434\u0430\u043D \u0438\u0437
      \u0414\u043E\u0444\u0430\u0440\u0430 \u0438 \u043C\u0438\u0440\u0440\u0430
      \u0438\u0437 \u0419\u0435\u043C\u0435\u043D\u0430. \u041B\u0443\u0447\u0448\u0438\u0435
      \u0446\u0435\u043D\u044B \u0432\u043E \u0432\u0441\u0435\u0439 \u043F\u0443\u0441\u0442\u044B\u043D\u0435!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758491
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u043C\u0438\u0440\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758492
    m_Localized: "\u041F\u043E\u043D\u0438\u043C\u0430\u044F \u0430\u0440\u0430\u0431\u0441\u043A\u0438\u0439,
      \u0432\u044B \u0441\u0442\u043E\u0440\u0433\u043E\u0432\u0430\u043B\u0438\u0441\u044C
      \u0434\u043E \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0439
      \u0446\u0435\u043D\u044B. \u041C\u0438\u0440\u0440\u0430 \u0432\u044B\u0441\u0448\u0435\u0433\u043E
      \u0441\u043E\u0440\u0442\u0430 - \u043D\u0430 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0440\u044B\u043D\u043A\u0430\u0445 \u0437\u0430 \u043D\u0435\u0451 \u0434\u0430\u0434\u0443\u0442
      \u0432\u0442\u0440\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758493
    m_Localized: "\u0411\u0435\u0437 \u0437\u043D\u0430\u043D\u0438\u044F \u044F\u0437\u044B\u043A\u0430
      - \u0431\u0435\u0437 \u0442\u043E\u0440\u0433\u0430. \u041C\u0438\u0440\u0440\u0430
      \u0445\u043E\u0440\u043E\u0448\u0430, \u043D\u043E \u0437\u0430\u043F\u043B\u0430\u0447\u0435\u043D\u043E
      \u0441 \u0438\u0437\u0431\u044B\u0442\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758494
    m_Localized: "\u041E\u0431\u043C\u0435\u043D\u044F\u0442\u044C \u043B\u0430\u0434\u0430\u043D
      \u043D\u0430 \u043C\u0438\u0440\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758495
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043E\u0431\u0440\u0430\u0434\u043E\u0432\u0430\u043B\u0441\u044F
      \u043B\u0430\u0434\u0430\u043D\u0443: \"\u0417\u0443\u0444\u0430\u0440\u0441\u043A\u0438\u0439!
      \u0425\u043E\u0440\u043E\u0448\u0435\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E!\"
      \u041E\u043D \u043E\u0442\u0434\u0430\u043B \u0434\u0432\u0430 \u043C\u0435\u0448\u043E\u0447\u043A\u0430
      \u043C\u0438\u0440\u0440\u044B \u0432 \u043E\u0431\u043C\u0435\u043D. \u041E\u0431\u0435
      \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758496
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758497
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043F\u043E\u0436\u0430\u043B
      \u043F\u043B\u0435\u0447\u0430\u043C\u0438, \u0443\u0432\u044F\u0437\u0430\u043B
      \u0442\u043E\u0432\u0430\u0440 \u0438 \u043F\u043E\u0431\u0440\u0451\u043B
      \u0434\u0430\u043B\u044C\u0448\u0435. \u0417\u0430\u043F\u0430\u0445 \u043C\u0438\u0440\u0440\u044B
      \u0435\u0449\u0451 \u0434\u043E\u043B\u0433\u043E \u0432\u0438\u0441\u0435\u043B
      \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758498
    m_Localized: "\u0417\u043D\u0430\u043C\u0435\u043D\u0438\u0435 \u0432 \u043D\u0435\u0431\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758499
    m_Localized: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u0432
      \u0431\u043B\u0435\u0434\u043D\u043E\u043C \u043D\u0435\u0431\u0435 \u0432\u0441\u043F\u044B\u0445\u0438\u0432\u0430\u0435\u0442
      \u044F\u0440\u043A\u0430\u044F \u0442\u043E\u0447\u043A\u0430 - \u043F\u0430\u0434\u0430\u044E\u0449\u0430\u044F
      \u0437\u0432\u0435\u0437\u0434\u0430, \u043E\u0441\u0442\u0430\u0432\u0438\u0432\u0448\u0430\u044F
      \u0445\u0432\u043E\u0441\u0442 \u0437\u0435\u043B\u0451\u043D\u043E\u0433\u043E
      \u043F\u043B\u0430\u043C\u0435\u043D\u0438. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0437\u0430\u043C\u0435\u0440\u043B\u0438. \u041E\u0434\u043D\u0438 \u0441\u0447\u0438\u0442\u0430\u044E\u0442
      \u044D\u0442\u043E \u0434\u043E\u0431\u0440\u044B\u043C \u0437\u043D\u0430\u043A\u043E\u043C,
      \u0434\u0440\u0443\u0433\u0438\u0435 - \u043F\u0440\u0435\u0434\u0432\u0435\u0441\u0442\u0438\u0435\u043C
      \u0431\u0435\u0434\u044B. \u0421\u043F\u043E\u0440 \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u043B
      \u043B\u044E\u0434\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758500
    m_Localized: "\u041E\u0431\u044A\u044F\u0432\u0438\u0442\u044C \u0434\u043E\u0431\u0440\u044B\u043C
      \u0437\u043D\u0430\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758501
    m_Localized: "\u0412\u0430\u0448\u0430 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u0430\u0441\u044C \u043B\u044E\u0434\u044F\u043C.
      \"\u041D\u0435\u0431\u043E \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u043B\u044F\u0435\u0442
      \u043D\u0430\u0448 \u043F\u0443\u0442\u044C!\" - \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u044E\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438. \u0421\u043F\u043E\u0440
      \u0437\u0430\u0431\u044B\u0442, \u0438 \u0432\u0441\u0435 \u0441 \u043D\u043E\u0432\u043E\u0439
      \u0441\u0438\u043B\u043E\u0439 \u0442\u0440\u043E\u043D\u0443\u043B\u0438\u0441\u044C
      \u0432 \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758502
    m_Localized: "\u0412\u0430\u0441 \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B\u0438,
      \u043D\u043E \u0441\u043A\u0435\u043F\u0442\u0438\u043A\u0438 \u043D\u0435
      \u0443\u043D\u044F\u043B\u0438\u0441\u044C. \u0421\u0441\u043E\u0440\u0430
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0430\u0441\u044C, \u043F\u043E\u0434\u0440\u044B\u0432\u0430\u044F
      \u0441\u043F\u043B\u043E\u0447\u0451\u043D\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758503
    m_Localized: "\u0418\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0438 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758504
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0442\u0440\u043E\u043D\u0443\u043B\u0441\u044F,
      \u043D\u043E \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u044B \u043D\u0435
      \u0443\u0442\u0438\u0445\u043B\u0438 \u0434\u043E \u0441\u0430\u043C\u043E\u0433\u043E
      \u043F\u0440\u0438\u0432\u0430\u043B\u0430. \u041A\u0430\u0436\u0434\u044B\u0439
      \u0432\u0438\u0434\u0438\u0442 \u0432 \u043D\u0435\u0431\u0435 \u0441\u0432\u043E\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758505
    m_Localized: "\u041E\u0431\u043C\u0435\u043D \u0441 \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758506
    m_Localized: "\u0421\u0442\u043E\u0439\u0431\u0438\u0449\u0435 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0445
      \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u043E\u0432 \u0440\u0430\u0441\u043A\u0438\u043D\u0443\u043B\u043E\u0441\u044C
      \u0443 \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u0448\u0435\u0433\u043E \u0440\u0443\u0441\u043B\u0430.
      \u0416\u0435\u043D\u0449\u0438\u043D\u044B \u0442\u043A\u0443\u0442, \u0434\u0435\u0442\u0438
      \u0431\u0435\u0433\u0430\u044E\u0442 \u043C\u0435\u0436\u0434\u0443 \u044E\u0440\u0442\u0430\u043C\u0438.
      \u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430 \u0432\u044B\u0445\u043E\u0434\u0438\u0442
      \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 - \u0435\u0433\u043E
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u0435\u0442 \u0444\u0430\u0440\u0444\u043E\u0440
      \u0438\u0437 \u041F\u043E\u0434\u043D\u0435\u0431\u0435\u0441\u043D\u043E\u0439.
      \u0412 \u043E\u0431\u043C\u0435\u043D \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
      \u043A\u0430\u0448\u0435\u043C\u0438\u0440, \u0447\u0442\u043E \u0446\u0435\u043D\u0438\u0442\u0441\u044F
      \u043D\u0430 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445 \u0440\u044B\u043D\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758507
    m_Localized: "\u041E\u0431\u043C\u0435\u043D\u044F\u0442\u044C \u0444\u0430\u0440\u0444\u043E\u0440
      \u043D\u0430 \u043A\u0430\u0448\u0435\u043C\u0438\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758508
    m_Localized: "\u0412\u044B \u043E\u0446\u0435\u043D\u0438\u043B\u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E
      \u043A\u0430\u0448\u0435\u043C\u0438\u0440\u0430 \u0438 \u0432\u044B\u0442\u043E\u0440\u0433\u043E\u0432\u0430\u043B\u0438
      \u0434\u0432\u0430 \u043E\u0442\u0440\u0435\u0437\u0430 \u0437\u0430 \u043E\u0434\u043D\u0443
      \u0432\u0430\u0437\u0443. \u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430
      \u0443\u0432\u0430\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043A\u0438\u0432\u043D\u0443\u043B
      - \u0432\u044B \u0437\u043D\u0430\u0435\u0442\u0435 \u0446\u0435\u043D\u0443
      \u0432\u0435\u0449\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758509
    m_Localized: "\u041E\u0431\u043C\u0435\u043D \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u0441\u044F,
      \u043D\u043E \u043E\u0434\u0438\u043D \u043A \u043E\u0434\u043D\u043E\u043C\u0443.
      \u041A\u0430\u0448\u0435\u043C\u0438\u0440 \u0445\u043E\u0440\u043E\u0448,
      \u043D\u043E \u043C\u043E\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      \u0431\u043E\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758510
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0437\u0430 \u0434\u0435\u043D\u044C\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758511
    m_Localized: "\u041A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0438 \u043F\u0440\u0438\u043D\u044F\u043B\u0438
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E, \u0445\u043E\u0442\u044F \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u044E\u0442
      \u0431\u0430\u0440\u0442\u0435\u0440. \u041A\u0430\u0448\u0435\u043C\u0438\u0440
      \u0443\u043F\u0430\u043A\u043E\u0432\u0430\u043D \u0438 \u0443\u043B\u043E\u0436\u0435\u043D
      \u0432 \u043F\u043E\u0432\u043E\u0437\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758512
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0437\u043D\u0430\u0435\u0442 \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758513
    m_Localized: "\u0412\u0430\u0448 \u043A\u0443\u043F\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u0432\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u0442\u043E\u0440\u0433
      \u0438 \u043F\u043E\u0440\u0430\u0437\u0438\u043B \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0443
      \u0437\u043D\u0430\u043D\u0438\u0435\u043C \u0441\u043E\u0440\u0442\u043E\u0432
      \u043A\u0430\u0448\u0435\u043C\u0438\u0440\u0430. \u0412 \u0438\u0442\u043E\u0433\u0435
      - \u0434\u0432\u0430 \u043E\u0442\u0440\u0435\u0437\u0430 \u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u043E
      \u0441\u0432\u0435\u0440\u0445\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758514
    m_Localized: "\u041A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u043F\u0443\u0442\u044C
      \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758515
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0438 \u0443\u043A\u0430\u0437\u0430\u043B
      \u043D\u0430 \u0435\u0434\u0432\u0430 \u0437\u0430\u043C\u0435\u0442\u043D\u0443\u044E
      \u0442\u0440\u043E\u043F\u0443, \u0443\u0445\u043E\u0434\u044F\u0449\u0443\u044E
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u043E\u0442 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0433\u043E
      \u0442\u0440\u0430\u043A\u0442\u0430. \"\u042F \u0445\u043E\u0434\u0438\u043B
      \u0437\u0434\u0435\u0441\u044C \u0432 \u043C\u043E\u043B\u043E\u0434\u043E\u0441\u0442\u0438.
      \u0421\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043C \u0434\u0432\u0430 \u0434\u043D\u044F,
      \u0435\u0441\u043B\u0438 \u043F\u0435\u0441\u043A\u0438 \u043D\u0435 \u0437\u0430\u043D\u0435\u0441\u043B\u0438\".
      \u0420\u0435\u0448\u0435\u043D\u0438\u0435 \u0437\u0430 \u0432\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758516
    m_Localized: "\u0414\u043E\u0432\u0435\u0440\u0438\u0442\u044C\u0441\u044F \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758517
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043C\u043E\u0439. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0432\u044B\u0448\u0435\u043B \u043D\u0430 \u0442\u0440\u0430\u043A\u0442
      \u043D\u0430 \u0434\u0432\u0430 \u0434\u043D\u044F \u0440\u0430\u043D\u044C\u0448\u0435,
      \u0441 \u0437\u0430\u043F\u0430\u0441\u043E\u043C \u0432\u043E\u0434\u044B
      \u0438\u0437 \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u043E\u0433\u043E \u043F\u043E
      \u043F\u0443\u0442\u0438 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758518
    m_Localized: "\u041F\u0435\u0441\u043A\u0438 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
      \u0437\u0430\u043D\u0435\u0441\u043B\u0438 \u0442\u0440\u043E\u043F\u0443.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0430 \u0443\u0432\u044F\u0437\u043B\u0430,
      \u0430 \u043E\u0431\u0445\u043E\u0434 \u0437\u0430\u043D\u044F\u043B \u0432\u0440\u0435\u043C\u044F.
      \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0432\u0438\u043D\u043E\u0432\u0430\u0442\u043E
      \u043C\u043E\u043B\u0447\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758519
    m_Localized: "\u041E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u043C
      \u0442\u0440\u0430\u043A\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758520
    m_Localized: "\u041D\u0430\u0434\u0451\u0436\u043D\u0435\u0435 \u0435\u0445\u0430\u0442\u044C
      \u043F\u043E \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u043C\u0443 \u043F\u0443\u0442\u0438.
      \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043F\u043E\u0436\u0430\u043B
      \u043F\u043B\u0435\u0447\u0430\u043C\u0438: \"\u0412\u0430\u0448 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      - \u0432\u0430\u0448 \u0432\u044B\u0431\u043E\u0440\"."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758521
    m_Localized: "\u0421\u043E\u0432\u0435\u0442 \u043A\u0443\u043F\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758522
    m_Localized: "\u041D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435 \u0432\u0430\u0448
      \u043A\u0443\u043F\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442
      \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442 \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442:
      \"\u042F \u0437\u043D\u0430\u044E \u044D\u0442\u043E\u0442 \u0443\u0447\u0430\u0441\u0442\u043E\u043A.
      \u0417\u0430 \u0442\u0435\u043C\u0438 \u0431\u0430\u0440\u0445\u0430\u043D\u0430\u043C\u0438
      \u0441\u0442\u043E\u0438\u0442 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0431\u0430\u0437\u0430\u0440, \u0433\u0434\u0435 \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0438
      \u0442\u043E\u0440\u0433\u0443\u044E\u0442 \u0441 \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0449\u0438\u043C\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430\u043C\u0438. \u0426\u0435\u043D\u044B
      \u0442\u0430\u043C \u043D\u0438\u0436\u0435, \u0447\u0435\u043C \u0432 \u0433\u043E\u0440\u043E\u0434\u0435\"."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758523
    m_Localized: "\u0421\u0434\u0435\u043B\u0430\u0442\u044C \u043A\u0440\u044E\u043A
      \u043A \u0431\u0430\u0437\u0430\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758524
    m_Localized: "\u0411\u0430\u0437\u0430\u0440 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435. \u041A\u0443\u043F\u0435\u0446
      \u043F\u0440\u043E\u0432\u0451\u043B \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0441\u0434\u0435\u043B\u043E\u043A, \u043F\u043E\u043A\u0430 \u0432\u044B
      \u043E\u0442\u0434\u044B\u0445\u0430\u043B\u0438. \u0421\u0435\u0440\u0435\u0431\u0440\u043E
      \u0437\u0430\u0437\u0432\u0435\u043D\u0435\u043B\u043E \u0432 \u043A\u043E\u0448\u0435\u043B\u044C\u043A\u0435
      - \u0441\u043F\u0443\u0442\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u0441\u0432\u043E\u0451 \u0434\u0435\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758525
    m_Localized: "\u041D\u0435 \u043E\u0442\u043A\u043B\u043E\u043D\u044F\u0442\u044C\u0441\u044F
      \u043E\u0442 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758526
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u043A\u0438\u0432\u043D\u0443\u043B:
      \"\u041A\u0430\u043A \u0441\u043A\u0430\u0436\u0435\u0442\u0435. \u041D\u043E
      \u0438\u043C\u0435\u0439\u0442\u0435 \u0432 \u0432\u0438\u0434\u0443 \u043D\u0430
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u043C \u043F\u0443\u0442\u0438\".
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B
      \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758527
    m_Localized: "\u0421\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u0439 \u0443\u0434\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758528
    m_Localized: "\u041F\u043E\u043B\u0443\u0434\u0435\u043D\u043D\u044B\u0439 \u0437\u043D\u043E\u0439
      \u0441\u0432\u0430\u043B\u0438\u043B \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u043E\u0432. \u0427\u0435\u043B\u043E\u0432\u0435\u043A
      \u0431\u0440\u0435\u0434\u0438\u0442, \u043A\u043E\u0436\u0430 \u0441\u0443\u0445\u0430\u044F
      \u0438 \u0433\u043E\u0440\u044F\u0447\u0430\u044F, \u0433\u043B\u0430\u0437\u0430
      \u0437\u0430\u043A\u0430\u0442\u0438\u043B\u0438\u0441\u044C. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0432 \u043F\u0430\u043D\u0438\u043A\u0435 - \u0435\u0441\u043B\u0438 \u043D\u0435
      \u043F\u043E\u043C\u043E\u0447\u044C, \u043E\u043D \u0443\u043C\u0440\u0451\u0442.
      \u041D\u043E \u0432\u043E\u0434\u0430 \u043D\u0430 \u0438\u0441\u0445\u043E\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758529
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044E\u044E
      \u0432\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758530
    m_Localized: "\u0414\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u0430\u044F
      \u0432\u043E\u0434\u0430 \u0443\u0448\u043B\u0430 \u043D\u0430 \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u0435
      \u0436\u0438\u0437\u043D\u0438. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A \u043F\u0440\u0438\u0448\u0451\u043B
      \u0432 \u0441\u0435\u0431\u044F. \u0417\u0430\u043F\u0430\u0441\u044B \u043F\u043E\u0447\u0442\u0438
      \u043D\u0430 \u043D\u0443\u043B\u0435, \u043D\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0436\u0438\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758531
    m_Localized: "\u0421\u0434\u0435\u043B\u0430\u0442\u044C \u043D\u0430\u0432\u0435\u0441
      \u0438 \u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758532
    m_Localized: "\u041D\u0430\u0441\u043F\u0435\u0445 \u0441\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0439
      \u043D\u0430\u0432\u0435\u0441 \u0434\u0430\u043B \u0442\u0435\u043D\u044C,
      \u043D\u043E \u0431\u0435\u0437 \u0432\u043E\u0434\u044B \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0435. \u041F\u043E\u043B\u0434\u043D\u044F
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E, \u0430 \u0431\u043E\u043B\u044C\u043D\u043E\u043C\u0443
      \u0432\u0441\u0451 \u0435\u0449\u0451 \u043F\u043B\u043E\u0445\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758533
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0431\u043E\u0440\u0435\u0442\u0441\u044F
      \u0441 \u0443\u0434\u0430\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758534
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u0431\u0435\u0440\u043D\u0443\u043B
      \u0431\u043E\u043B\u044C\u043D\u043E\u0433\u043E \u043C\u043E\u043A\u0440\u043E\u0439
      \u0442\u043A\u0430\u043D\u044C\u044E, \u0434\u0430\u043B \u0441\u043E\u043B\u0451\u043D\u044B\u0439
      \u043E\u0442\u0432\u0430\u0440 \u0438 \u043E\u0442\u0432\u0451\u043B \u0432
      \u0442\u0435\u043D\u044C \u043F\u043E\u0432\u043E\u0437\u043A\u0438. \u0427\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043E\u0442\u043A\u0440\u044B\u043B
      \u0433\u043B\u0430\u0437\u0430. \u041B\u0435\u043A\u0430\u0440\u044C \u0437\u043D\u0430\u0435\u0442,
      \u043A\u0430\u043A \u043E\u0431\u043C\u0430\u043D\u0443\u0442\u044C \u043F\u0443\u0441\u0442\u044B\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758535
    m_Localized: "\u0417\u0430\u0441\u044B\u043F\u0430\u043D\u043D\u043E\u0435 \u0441\u0432\u044F\u0442\u0438\u043B\u0438\u0449\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758536
    m_Localized: "\u0412\u0435\u0442\u0435\u0440 \u043E\u0431\u043D\u0430\u0436\u0438\u043B
      \u0443\u0433\u043E\u043B \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0439 \u043A\u043B\u0430\u0434\u043A\u0438
      \u0441 \u043E\u0441\u0442\u0430\u0442\u043A\u0430\u043C\u0438 \u043F\u043E\u0437\u043E\u043B\u043E\u0442\u044B.
      \u041F\u043E\u0434 \u043F\u0435\u0441\u043A\u043E\u043C - \u043A\u0440\u043E\u0445\u043E\u0442\u043D\u043E\u0435
      \u0441\u0432\u044F\u0442\u0438\u043B\u0438\u0449\u0435, \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C \u0437\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u043E\u0435
      \u0438\u043B\u0438 \u0431\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u043E\u0435.
      \u0412\u043D\u0443\u0442\u0440\u0438 - \u043F\u043E\u043B\u0443\u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043D\u044B\u0439
      \u0430\u043B\u0442\u0430\u0440\u044C, \u043E\u0441\u0442\u0430\u0442\u043A\u0438
      \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0439 \u0438 \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439
      \u043F\u043E\u043A\u043E\u0439, \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
      \u043D\u0430 \u0437\u043D\u043E\u0439 \u0441\u043D\u0430\u0440\u0443\u0436\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758537
    m_Localized: "\u041E\u0431\u044B\u0441\u043A\u0430\u0442\u044C \u0441\u0432\u044F\u0442\u0438\u043B\u0438\u0449\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758538
    m_Localized: "\u0410\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u0432
      \u0437\u0430\u0432\u0430\u043B, \u0432\u044B \u043D\u0430\u0448\u043B\u0438
      \u043D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u0443\u044E \u0441\u0442\u0430\u0442\u0443\u044D\u0442\u043A\u0443
      - \u0442\u043E\u043D\u043A\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430,
      \u0434\u0440\u0435\u0432\u043D\u044F\u044F \u0438 \u0446\u0435\u043D\u043D\u0430\u044F.
      \u041C\u0435\u0441\u0442\u043E \u0434\u044B\u0448\u0438\u0442 \u0438\u0441\u0442\u043E\u0440\u0438\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758539
    m_Localized: "\u041F\u0440\u0438 \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u043A\u0435
      \u043E\u0431\u0432\u0430\u043B\u0438\u043B\u0441\u044F \u0444\u0440\u0430\u0433\u043C\u0435\u043D\u0442
      \u0441\u0442\u0435\u043D\u044B, \u043F\u043E\u0434\u043D\u044F\u0432 \u043F\u044B\u043B\u044C.
      \u041D\u0438\u0447\u0435\u0433\u043E \u0446\u0435\u043D\u043D\u043E\u0433\u043E
      \u043D\u0435 \u043D\u0430\u0448\u043B\u043E\u0441\u044C, \u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0432\u043E\u0440\u0447\u0430\u0442: \u043D\u0435 \u0441\u0442\u043E\u0438\u043B\u043E
      \u0442\u0440\u0435\u0432\u043E\u0436\u0438\u0442\u044C \u0441\u0442\u0430\u0440\u044B\u0435
      \u043A\u0430\u043C\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758540
    m_Localized: "\u041F\u043E\u043C\u0435\u0434\u0438\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758541
    m_Localized: "\u0412\u044B \u043F\u0440\u0438\u0441\u0435\u043B\u0438 \u0443
      \u0430\u043B\u0442\u0430\u0440\u044F \u0438 \u0437\u0430\u043A\u0440\u044B\u043B\u0438
      \u0433\u043B\u0430\u0437\u0430. \u0422\u0438\u0448\u0438\u043D\u0430 \u0441\u0432\u044F\u0442\u0438\u043B\u0438\u0449\u0430
      \u043F\u0440\u043E\u043D\u0438\u043A\u043B\u0430 \u0432\u043D\u0443\u0442\u0440\u044C.
      \u041A\u043E\u0433\u0434\u0430 \u0432\u044B \u0432\u044B\u0448\u043B\u0438,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438,
      \u0447\u0442\u043E \u0432\u044B \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442\u0435
      \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0432\u0448\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758542
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758543
    m_Localized: "\u041F\u0435\u0441\u043E\u043A \u0437\u0430\u0441\u044B\u043F\u043B\u0435\u0442
      \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E \u0441\u043D\u043E\u0432\u0430
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439. \u041F\u0443\u0441\u0442\u044C \u0445\u0440\u0430\u043D\u0438\u0442
      \u0441\u0432\u043E\u0438 \u0442\u0430\u0439\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758544
    m_Localized: "\u0428\u0430\u0433 \u0437\u0430 \u0448\u0430\u0433\u043E\u043C,
      \u0440\u0430\u0441\u0441\u0442\u0435\u043B\u0438\u0432 \u0448\u043A\u0443\u0440\u044B
      \u043F\u043E\u0434 \u043A\u043E\u043B\u0451\u0441\u0430, \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u043B \u043E\u0431\u043B\u0435\u0434\u0435\u043D\u0435\u0432\u0448\u0438\u0439
      \u0443\u0447\u0430\u0441\u0442\u043E\u043A. \u0417\u0430\u043D\u044F\u043B\u043E
      \u043F\u043E\u043B\u0434\u043D\u044F, \u043D\u043E \u043D\u0438 \u043E\u0434\u043D\u0430
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u043D\u0435 \u0441\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758545
    m_Localized: "\u0420\u0430\u0437\u043E\u0433\u043D\u0430\u0432\u0448\u0438\u0441\u044C,
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u043F\u0440\u043E\u0441\u043A\u043E\u0447\u0438\u043B\u0430
      \u043E\u0431\u043B\u0435\u0434\u0435\u043D\u0435\u0432\u0448\u0438\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A.
      \u041F\u0430\u0440\u0430 \u0443\u0448\u0438\u0431\u043E\u0432 - \u043C\u0435\u043B\u043E\u0447\u044C
      \u043F\u043E \u0441\u0440\u0430\u0432\u043D\u0435\u043D\u0438\u044E \u0441
      \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758546
    m_Localized: "\u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043F\u0430\u0442\u0440\u0443\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758547
    m_Localized: "\u0418\u0437-\u0437\u0430 \u0441\u043A\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u0433\u0440\u0435\u0431\u043D\u044F \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u0438 \u0432 \u043A\u043E\u043B\u044C\u0447\u0443\u0433\u0430\u0445
      \u0441 \u043A\u0440\u0430\u0441\u043D\u044B\u043C\u0438 \u043F\u043B\u0430\u0449\u0430\u043C\u0438
      - \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u044B\u0439
      \u043F\u0430\u0442\u0440\u0443\u043B\u044C. \u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0440\u0443\u043A\u0443,
      \u043F\u0440\u0438\u043A\u0430\u0437\u044B\u0432\u0430\u044F \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F. \u0415\u0433\u043E
      \u0432\u0437\u0433\u043B\u044F\u0434 \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u044E\u0449\u0438\u0439,
      \u0430 \u0432\u043E\u0438\u043D\u044B \u0434\u0435\u0440\u0436\u0430\u0442
      \u0440\u0443\u043A\u0438 \u043D\u0430 \u043C\u0435\u0447\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758548
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043F\u043E\u0448\u043B\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758549
    m_Localized: "\u0421\u0435\u0440\u0435\u0431\u0440\u043E \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u0438\u0437 \u0440\u0443\u043A \u0432 \u0440\u0443\u043A\u0438. \u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440
      \u043A\u0438\u0432\u0430\u0435\u0442 \u0438 \u0434\u0430\u0451\u0442 \u0437\u043D\u0430\u043A
      \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043A\u0430\u0440\u0430\u0432\u0430\u043D.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758550
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758551
    m_Localized: "\u0414\u043E\u043B\u0433\u0438\u0439 \u0442\u043E\u0440\u0433 \u043D\u0430
      \u0436\u0435\u0441\u0442\u0430\u0445 \u0438 \u043B\u043E\u043C\u0430\u043D\u044B\u0445
      \u0441\u043B\u043E\u0432\u0430\u0445. \u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440
      \u043D\u0435\u0445\u043E\u0442\u044F \u0441\u043D\u0438\u0437\u0438\u043B \u043F\u043E\u0448\u043B\u0438\u043D\u0443
      \u0432\u0434\u0432\u043E\u0435 - \u043D\u043E \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B
      \u043B\u0438\u0446\u043E \u043A\u0443\u043F\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758552
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043D\u0430
      \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758553
    m_Localized: "\u0421\u0432\u043E\u0431\u043E\u0434\u043D\u0430\u044F \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0430\u044F
      \u0440\u0435\u0447\u044C \u0443\u0434\u0438\u0432\u0438\u043B\u0430 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0430.
      \u041E\u043D \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u0435\u0442 \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C
      \u0447\u0430\u0439 \u0441 \u043C\u0430\u0441\u043B\u043E\u043C \u0438 \u0440\u0430\u0441\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u043E \u043D\u043E\u0432\u043E\u0441\u0442\u044F\u0445 \u0441 \u0440\u0430\u0432\u043D\u0438\u043D.
      \u041F\u043E\u0448\u043B\u0438\u043D\u0443 \u043E\u043D \u0437\u0430\u0431\u044B\u043B
      \u0443\u043F\u043E\u043C\u044F\u043D\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758554
    m_Localized: "\u041F\u0430\u043C\u0438\u0440\u0441\u043A\u0438\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758555
    m_Localized: "\u041D\u0430 \u0443\u0437\u043A\u043E\u043C \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435
      \u043F\u0443\u0442\u044C \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0436\u0435\u043D
      \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0439 \u0431\u0430\u0440\u0440\u0438\u043A\u0430\u0434\u043E\u0439.
      \u0418\u0437-\u0437\u0430 \u0432\u0430\u043B\u0443\u043D\u043E\u0432 \u0432\u044B\u0445\u043E\u0434\u044F\u0442
      \u0431\u043E\u0440\u043E\u0434\u0430\u0442\u044B\u0435 \u043B\u044E\u0434\u0438
      \u0432 \u043E\u0432\u0447\u0438\u043D\u043D\u044B\u0445 \u0448\u0443\u0431\u0430\u0445,
      \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0435 \u043A\u0440\u0438\u0432\u044B\u043C\u0438
      \u043A\u043B\u0438\u043D\u043A\u0430\u043C\u0438. \u0418\u0445 \u0433\u043B\u0430\u0432\u0430\u0440\u044C
      \u0443\u0445\u043C\u044B\u043B\u044F\u0435\u0442\u0441\u044F - \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0432 \u043B\u043E\u0432\u0443\u0448\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758556
    m_Localized: "\u041E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758557
    m_Localized: "\u0413\u043B\u0430\u0432\u0430\u0440\u044C \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043B
      \u043C\u043E\u043D\u0435\u0442\u044B, \u043A\u0438\u0432\u043D\u0443\u043B
      \u0438 \u043C\u0430\u0445\u043D\u0443\u043B \u0440\u0443\u043A\u043E\u0439
      - \u0431\u0430\u0440\u0440\u0438\u043A\u0430\u0434\u0443 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043B\u0438.
      \u0414\u0435\u0448\u0451\u0432\u0430\u044F \u0446\u0435\u043D\u0430 \u0437\u0430
      \u0436\u0438\u0437\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758558
    m_Localized: "\u0414\u0430\u0442\u044C \u043E\u0442\u043F\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758559
    m_Localized: "\u0421\u0442\u044B\u0447\u043A\u0430 \u0431\u044B\u043B\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0439,
      \u043D\u043E \u0436\u0451\u0441\u0442\u043A\u043E\u0439. \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438, \u043E\u0441\u0442\u0430\u0432\u0438\u0432
      \u0440\u0430\u043D\u0435\u043D\u044B\u0445. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u0440\u043E\u0448\u0451\u043B, \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0432
      \u043A\u0440\u043E\u0432\u044C\u044E, \u0430 \u043D\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758560
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u043F\u0440\u043E\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758561
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0437\u0430\u043C\u0435\u0442\u0438\u043B
      \u043A\u043E\u0437\u044C\u044E \u0442\u0440\u043E\u043F\u0443 \u0432 \u043E\u0431\u0445\u043E\u0434
      \u0431\u0430\u0440\u0440\u0438\u043A\u0430\u0434\u044B. \u0422\u0438\u0445\u0438\u0439
      \u043C\u0430\u043D\u0451\u0432\u0440 - \u0438 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
      \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043D\u0438 \u0441 \u0447\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758562
    m_Localized: "\u041E\u0442\u0448\u0435\u043B\u044C\u043D\u0438\u043A \u043D\u0430
      \u0441\u043A\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758563
    m_Localized: "\u041D\u0430 \u043A\u0430\u0440\u043D\u0438\u0437\u0435 \u0441\u043A\u0430\u043B\u044B,
      \u043F\u0440\u043E\u0434\u0443\u0432\u0430\u0435\u043C\u043E\u043C \u0432\u0441\u0435\u043C\u0438
      \u0432\u0435\u0442\u0440\u0430\u043C\u0438, \u0441\u0438\u0434\u0438\u0442
      \u0441\u0442\u0430\u0440\u0438\u043A \u0432 \u0440\u0432\u0430\u043D\u043E\u043C
      \u043E\u0434\u0435\u044F\u043D\u0438\u0438. \u0413\u043B\u0430\u0437\u0430
      \u0437\u0430\u043A\u0440\u044B\u0442\u044B, \u0433\u0443\u0431\u044B \u0431\u0435\u0437\u0437\u0432\u0443\u0447\u043D\u043E
      \u0448\u0435\u0432\u0435\u043B\u044F\u0442\u0441\u044F. \u0420\u044F\u0434\u043E\u043C:
      \u0433\u043B\u0438\u043D\u044F\u043D\u0430\u044F \u0447\u0430\u0448\u0430 \u0438
      \u043F\u043E\u0441\u043E\u0445. \u041E\u043D \u0437\u0434\u0435\u0441\u044C
      \u0434\u0430\u0432\u043D\u043E: \u0441\u043D\u0435\u0433 \u043E\u0431\u0442\u0430\u044F\u043B
      \u0432\u043E\u043A\u0440\u0443\u0433 \u043D\u0435\u0433\u043E, \u0441\u043B\u043E\u0432\u043D\u043E
      \u0442\u0435\u043B\u043E \u0438\u0437\u043B\u0443\u0447\u0430\u0435\u0442 \u0442\u0435\u043F\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758564
    m_Localized: "\u041F\u043E\u043B\u043E\u0436\u0438\u0442\u044C \u0435\u0434\u0443
      \u0432 \u0447\u0430\u0448\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758565
    m_Localized: "\u0421\u0442\u0430\u0440\u0438\u043A \u043E\u0442\u043A\u0440\u044B\u043B
      \u0433\u043B\u0430\u0437\u0430 \u0438 \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F.
      \u041E\u0434\u043D\u043E \u0441\u043B\u043E\u0432\u043E - \u0438 \u0442\u0440\u0435\u0432\u043E\u0433\u0430
      \u0443\u0448\u043B\u0430 \u0438\u0437 \u0441\u0435\u0440\u0434\u0435\u0446.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435 \u0441 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E\u0439
      \u043B\u0451\u0433\u043A\u043E\u0441\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758566
    m_Localized: "\u041D\u0435 \u0442\u0440\u0435\u0432\u043E\u0436\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758567
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0442\u0438\u0445\u043E
      \u043F\u0440\u043E\u0448\u0451\u043B \u043C\u0438\u043C\u043E. \u041E\u0442\u0448\u0435\u043B\u044C\u043D\u0438\u043A
      \u0434\u0430\u0436\u0435 \u043D\u0435 \u0448\u0435\u0432\u0435\u043B\u044C\u043D\u0443\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758568
    m_Localized: "\u0421\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043E \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758569
    m_Localized: "\u041E\u0442\u0448\u0435\u043B\u044C\u043D\u0438\u043A \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      - \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u043D\u043E \u0442\u043E\u0447\u043D\u043E.
      \u041E\u043D \u043E\u043F\u0438\u0441\u0430\u043B \u043A\u0430\u0436\u0434\u044B\u0439
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442 \u0432\u043F\u0435\u0440\u0435\u0434\u0438,
      \u043A\u0430\u0436\u0434\u0443\u044E \u0442\u0440\u0435\u0449\u0438\u043D\u0443
      \u0432\u043E \u043B\u044C\u0434\u0443. \u0422\u0430\u043A\u043E\u0435 \u0437\u043D\u0430\u043D\u0438\u0435
      \u0441\u0442\u043E\u0438\u0442 \u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u043E\u043B\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758570
    m_Localized: "\u0414\u0435\u043D\u044C \u043E\u0442\u0434\u044B\u0445\u0430 \u043F\u043E\u043C\u043E\u0433
      \u043B\u044E\u0434\u044F\u043C \u0438 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u043C
      \u043F\u0440\u0438\u0439\u0442\u0438 \u0432 \u0441\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758571
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u0435\u0432\u043E\u0437\u043C\u043E\u0433
      \u0441\u043B\u0430\u0431\u043E\u0441\u0442\u044C \u0438 \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0432\u043F\u0435\u0440\u0451\u0434. \u0414\u044B\u0448\u0430\u0442\u044C
      \u0432\u0441\u0451 \u0442\u044F\u0436\u0435\u043B\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758572
    m_Localized: "\u0412\u043E\u0438\u043D-\u043C\u043E\u043D\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758573
    m_Localized: "\u041D\u0430 \u0442\u0440\u043E\u043F\u0435 \u0441\u0442\u043E\u0438\u0442
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A - \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u043C\u043E\u043D\u0430\u0445 \u0438 \u0432\u043E\u0438\u043D. \u0411\u0440\u0438\u0442\u0430\u044F
      \u0433\u043E\u043B\u043E\u0432\u0430, \u043A\u043E\u043B\u044C\u0447\u0443\u0433\u0430
      \u043F\u043E\u0434 \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u043E\u0439 \u043D\u0430\u043A\u0438\u0434\u043A\u043E\u0439,
      \u043C\u0435\u0447 \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439. \u041E\u043D
      \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0434\u0438\u043B \u043F\u0443\u0442\u044C
      \u0438 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442 \u0447\u0442\u043E-\u0442\u043E
      \u043D\u0430 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u043C, \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044F
      \u043D\u0430 \u0443\u0449\u0435\u043B\u044C\u0435 \u0432\u043F\u0435\u0440\u0435\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758574
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0435\u0433\u043E \u043F\u043E\u043C\u043E\u0449\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758575
    m_Localized: "\u0412\u043E\u0438\u043D-\u043C\u043E\u043D\u0430\u0445 \u043F\u0440\u043E\u0432\u0451\u043B
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0447\u0435\u0440\u0435\u0437 \u0443\u0449\u0435\u043B\u044C\u0435,
      \u0440\u0430\u0441\u043F\u0435\u0432\u0430\u044F \u043C\u0430\u043D\u0442\u0440\u044B.
      \xAB\u0414\u0435\u043C\u043E\u043D\u044B\xBB \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u043E\u0431\u0432\u0430\u043B\u043E\u043E\u043F\u0430\u0441\u043D\u044B\u043C
      \u0443\u0447\u0430\u0441\u0442\u043A\u043E\u043C - \u0435\u0433\u043E \u043C\u043E\u043B\u0438\u0442\u0432\u044B
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u043B\u0438
      \u043E\u0431 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758576
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u0435\u0433\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758577
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0431\u043E\u0433\u043D\u0443\u043B
      \u043C\u043E\u043D\u0430\u0445\u0430 \u0438 \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0443\u0449\u0435\u043B\u044C\u0435. \u0412
      \u0443\u0437\u043A\u043E\u043C \u043C\u0435\u0441\u0442\u0435 \u043A\u0430\u043C\u043D\u0435\u043F\u0430\u0434
      \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0441\u044F \u043D\u0430 \u0442\u0440\u043E\u043F\u0443
      - \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0440\u0430\u0441\u0447\u0438\u0449\u0430\u0442\u044C
      \u043F\u0443\u0442\u044C \u0432\u0440\u0443\u0447\u043D\u0443\u044E, \u043F\u043E\u0442\u0435\u0440\u044F\u0432
      \u0432\u0440\u0435\u043C\u044F \u0438 \u0447\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758578
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758579
    m_Localized: "\u041C\u043E\u043B\u043E\u0434\u0430\u044F \u0436\u0435\u043D\u0449\u0438\u043D\u0430
      \u0432 \u043C\u0435\u0445\u043E\u0432\u043E\u0439 \u0448\u0430\u043F\u043A\u0435
      \u0438 \u0441 \u044F\u0447\u044C\u0435\u0439 \u0432\u0435\u0440\u0451\u0432\u043A\u043E\u0439
      \u0447\u0435\u0440\u0435\u0437 \u043F\u043B\u0435\u0447\u043E \u0432\u044B\u0445\u043E\u0434\u0438\u0442
      \u0438\u0437-\u0437\u0430 \u043A\u0430\u043C\u043D\u0435\u0439. \u041E\u043D\u0430
      \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043D\u0430 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0443
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u0438 \u0447\u0442\u043E-\u0442\u043E
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 - \u0431\u044B\u0441\u0442\u0440\u043E,
      \u0441 \u0433\u043E\u0440\u043D\u044B\u043C \u0430\u043A\u0446\u0435\u043D\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758580
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758581
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u0430 \u0437\u043D\u0430\u0435\u0442
      \u043A\u0430\u0436\u0434\u044B\u0439 \u043A\u0430\u043C\u0435\u043D\u044C.
      \u041F\u043E \u0434\u043E\u0440\u043E\u0433\u0435 \u043E\u043D\u0430 \u0443\u0447\u0438\u0442
      \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u043C \u0441\u043B\u043E\u0432\u0430\u043C
      \u0438 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442, \u0433\u0434\u0435
      \u0438\u0441\u043A\u0430\u0442\u044C \u0443\u043A\u0440\u044B\u0442\u0438\u0435
      \u043E\u0442 \u0432\u0435\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758582
    m_Localized: "\u0418\u0434\u0442\u0438 \u0441\u0430\u043C\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758583
    m_Localized: "\u0411\u0435\u0437 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u044B\u0431\u0440\u0430\u043B
      \u043D\u0435\u0432\u0435\u0440\u043D\u0443\u044E \u0442\u0440\u043E\u043F\u0443
      \u043D\u0430 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0435. \u041B\u0438\u0448\u043D\u0438\u0439
      \u0434\u0435\u043D\u044C \u043F\u0443\u0442\u0438 \u043F\u043E \u043A\u0430\u043C\u043D\u044F\u043C
      \u0438 \u0432\u0435\u0442\u0440\u0443. \u0416\u0438\u0432\u043E\u0442\u043D\u044B\u0435
      \u0438\u0437\u043C\u043E\u0442\u0430\u043D\u044B, \u043B\u044E\u0434\u0438
      \u0443\u0433\u0440\u044E\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758584
    m_Localized: "\u041D\u0435\u0441\u0442\u043E\u0440\u0438\u0430\u043D\u0441\u043A\u0438\u0439
      \u043C\u043E\u043D\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758585
    m_Localized: "\u0423 \u0440\u0430\u0437\u0432\u0430\u043B\u0438\u043D \u043F\u0440\u0438\u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439
      \u0447\u0430\u0441\u043E\u0432\u043D\u0438 \u0432 \u0433\u043E\u0440\u043D\u043E\u043C
      \u0443\u0449\u0435\u043B\u044C\u0435 \u0441\u0438\u0434\u0438\u0442 \u043C\u043E\u043D\u0430\u0445
      \u0432 \u0442\u0451\u043C\u043D\u043E\u0439 \u0440\u044F\u0441\u0435 \u0441
      \u043D\u0430\u0448\u0438\u0442\u044B\u043C \u043A\u0440\u0435\u0441\u0442\u043E\u043C
      - \u0437\u043D\u0430\u043A \u043D\u0435\u0441\u0442\u043E\u0440\u0438\u0430\u043D\u0441\u043A\u043E\u0439
      \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438, \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u043D\u043D\u043E\u0439
      \u0438\u0437 \u0421\u0438\u0440\u0438\u0438. \u041F\u0435\u0440\u0435\u0434
      \u043D\u0438\u043C \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u0430\u044F \u043A\u043D\u0438\u0433\u0430
      \u043D\u0430 \u0441\u0438\u0440\u0438\u0439\u0441\u043A\u043E\u043C \u043F\u0438\u0441\u044C\u043C\u0435.
      \u0423\u0432\u0438\u0434\u0435\u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u043E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043A
      \u043F\u0443\u0442\u043D\u0438\u043A\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758586
    m_Localized: "\u041F\u043E\u043C\u043E\u0447\u044C \u043C\u043E\u043D\u0430\u0445\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758587
    m_Localized: "\u041F\u043E\u043B\u0434\u043D\u044F \u0441\u0431\u043E\u0440\u0430
      \u0442\u0440\u0430\u0432 \u0432 \u0433\u043E\u0440\u0430\u0445. \u041C\u043E\u043D\u0430\u0445
      \u0443\u0447\u0438\u0442 \u0438\u0445 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F\u043C
      \u043D\u0430 \u0441\u0438\u0440\u0438\u0439\u0441\u043A\u043E\u043C, \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043E \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F\u0445 \u041C\u0435\u0440\u0432\u0430
      \u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445 \u043F\u0443\u0442\u044F\u0445
      \u0447\u0435\u0440\u0435\u0437 \u0425\u043E\u0440\u0430\u0441\u0430\u043D.
      \u0417\u043D\u0430\u043D\u0438\u0435 \u0431\u0435\u0441\u0446\u0435\u043D\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758588
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758589
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0438\u0437\u0432\u0438\u043D\u044F\u0435\u0442\u0441\u044F
      - \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u043D\u0435\u0442. \u041C\u043E\u043D\u0430\u0445
      \u043A\u0438\u0432\u0430\u0435\u0442 \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u043A \u043A\u043D\u0438\u0433\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758590
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0446\u0435\u043B\u0438\u0442\u0435\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758591
    m_Localized: "\u0426\u0435\u043B\u0438\u0442\u0435\u043B\u044C \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0438 \u043C\u043E\u043D\u0430\u0445 \u043E\u0431\u043C\u0435\u043D\u044F\u043B\u0438\u0441\u044C
      \u0437\u043D\u0430\u043D\u0438\u044F\u043C\u0438 \u0442\u0440\u0430\u0432.
      \u041C\u043E\u043D\u0430\u0445 \u043F\u043E\u0434\u0430\u0440\u0438\u043B \u043C\u0435\u0448\u043E\u0447\u0435\u043A
      \u0433\u043E\u0440\u043D\u044B\u0445 \u0442\u0440\u0430\u0432 \u0438 \u043A\u0443\u0441\u043E\u043A
      \u043B\u0430\u0434\u0430\u043D\u0430 \u0438\u0437 \u041C\u0435\u0440\u0432\u0430.
      \u041E\u0431\u0430 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758592
    m_Localized: "\u041E\u0433\u043D\u0438 \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758593
    m_Localized: "\u041D\u043E\u0447\u044C\u044E, \u043A\u043E\u0433\u0434\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435, \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435
      \u0433\u043E\u043B\u0443\u0431\u043E\u0432\u0430\u0442\u044B\u0435 \u043E\u0433\u043D\u0438
      \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F \u043D\u0430 \u0441\u043A\u043B\u043E\u043D\u0430\u0445.
      \u041E\u043D\u0438 \u0434\u0432\u0438\u0436\u0443\u0442\u0441\u044F \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E,
      \u0441\u043B\u043E\u0432\u043D\u043E \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u0438\u044F.
      \u041B\u044E\u0434\u0438 \u0448\u0435\u043F\u0447\u0443\u0442\u0441\u044F \u043E
      \u0433\u043E\u0440\u043D\u044B\u0445 \u0434\u0443\u0445\u0430\u0445. \u0416\u0438\u0432\u043E\u0442\u043D\u044B\u0435
      \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u044F\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758594
    m_Localized: "\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758595
    m_Localized: "\u0421\u043C\u0435\u043B\u044C\u0447\u0430\u043A\u0438 \u043D\u0430\u0448\u043B\u0438
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u043E\u0433\u043D\u0435\u0439
      - \u0441\u0432\u0435\u0442\u044F\u0449\u0438\u0439\u0441\u044F \u043C\u043E\u0445
      \u0432 \u0442\u0440\u0435\u0449\u0438\u043D\u0430\u0445 \u0441\u043A\u0430\u043B
      \u0438 \u0432\u044B\u0445\u043E\u0434 \u0433\u043E\u0440\u044F\u0447\u0435\u0433\u043E
      \u0433\u0430\u0437\u0430. \u041D\u0438\u043A\u0430\u043A\u0438\u0445 \u0434\u0443\u0445\u043E\u0432,
      \u043D\u043E \u0440\u044F\u0434\u043E\u043C \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0430\u0441\u044C
      \u043F\u0435\u0449\u0435\u0440\u0430 \u0441 \u0447\u0438\u0441\u0442\u043E\u0439
      \u0432\u043E\u0434\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758596
    m_Localized: "\u041D\u0435 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758597
    m_Localized: "\u041E\u0433\u043D\u0438 \u043F\u043E\u0433\u0430\u0441\u043B\u0438
      \u043A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443. \u041D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0441\u043F\u0430\u043B \u044D\u0442\u043E\u0439 \u043D\u043E\u0447\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758598
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u0434\u0443\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758599
    m_Localized: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u0441
      \u0433\u043E\u0440\u044B \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u043F\u0440\u043E\u0442\u044F\u0436\u043D\u044B\u0439 \u0437\u0432\u0443\u043A
      - \u043D\u0435 \u0432\u0435\u0442\u0435\u0440, \u043D\u0435 \u043E\u0431\u0432\u0430\u043B,
      \u0430 \u043D\u0435\u0447\u0442\u043E \u0438\u043D\u043E\u0435. \u041C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u0444\u043B\u0430\u0436\u043A\u0438 \u043D\u0430 \u043F\u0430\u043B\u043A\u0430\u0445
      \u0432\u0434\u043E\u043B\u044C \u0442\u0440\u043E\u043F\u044B \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
      \u0442\u0440\u0435\u043F\u0435\u0442\u0430\u0442\u044C, \u0445\u043E\u0442\u044F
      \u0432\u043E\u0437\u0434\u0443\u0445 \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u0435\u043D.
      \u0421\u0442\u0430\u0440\u044B\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A
      \u0431\u043B\u0435\u0434\u043D\u0435\u0435\u0442 \u0438 \u0448\u0435\u043F\u0447\u0435\u0442:
      \u044D\u0442\u043E \u0433\u043E\u043B\u043E\u0441 \u0433\u043E\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758600
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758601
    m_Localized: "\u041D\u0435\u043C\u043D\u043E\u0433\u043E \u0435\u0434\u044B \u0438
      \u0431\u043B\u0430\u0433\u043E\u0432\u043E\u043D\u0438\u0439 \u0443 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u0442\u0443\u0440\u0430. \u0417\u0432\u0443\u043A \u0441\u0442\u0438\u0445,
      \u0444\u043B\u0430\u0436\u043A\u0438 \u0437\u0430\u043C\u0435\u0440\u043B\u0438.
      \u041D\u0430 \u0441\u0435\u0440\u0434\u0446\u0435 \u0441\u0442\u0430\u043B\u043E
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435 - \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u0433\u043E\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758602
    m_Localized: "\u0418\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758603
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435, \u043D\u043E \u0432\u0435\u0441\u044C
      \u0434\u0435\u043D\u044C \u043B\u044E\u0434\u0438 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u043B\u0438\u0441\u044C.
      \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u0434\u0432\u0430 \u043E\u0441\u043B\u0430
      \u0437\u0430\u0445\u0440\u043E\u043C\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758604
    m_Localized: "\u041F\u0440\u043E\u0447\u0435\u0441\u0442\u044C \u043C\u0430\u043D\u0442\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758605
    m_Localized: "\u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0430\u044F \u043C\u0430\u043D\u0442\u0440\u0430
      \u0440\u0430\u0437\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043F\u043E \u0443\u0449\u0435\u043B\u044C\u044E.
      \u0417\u0432\u0443\u043A \u0441 \u0433\u043E\u0440\u044B \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442
      - \u0442\u0438\u0448\u0435, \u043C\u044F\u0433\u0447\u0435, \u0441\u043B\u043E\u0432\u043D\u043E
      \u043E\u0434\u043E\u0431\u0440\u044F\u044F. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u043E\u0448\u0435\u043B\u043E\u043C\u043B\u0435\u043D\u044B. \u041F\u0443\u0442\u044C
      \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u043B\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758606
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u0441\u0442\u0430\u0440\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758607
    m_Localized: "\u0423 \u0434\u043E\u0440\u043E\u0433\u0438 \u043D\u0430 \u043F\u043B\u043E\u0441\u043A\u043E\u043C
      \u043A\u0430\u043C\u043D\u0435 \u0441\u0438\u0434\u0438\u0442 \u0434\u0440\u0435\u0432\u043D\u0438\u0439
      \u0441\u0442\u0430\u0440\u0435\u0446. \u0415\u0433\u043E \u043B\u0438\u0446\u043E
      \u0438\u0441\u0441\u0435\u0447\u0435\u043D\u043E \u043C\u043E\u0440\u0449\u0438\u043D\u0430\u043C\u0438,
      \u043A\u0430\u043A \u0433\u043E\u0440\u043D\u044B\u0439 \u0441\u043A\u043B\u043E\u043D
      - \u0443\u0449\u0435\u043B\u044C\u044F\u043C\u0438. \u041E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0440\u0443\u043A\u0443, \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u044F
      \u043F\u043E\u0434\u043E\u0439\u0442\u0438, \u0438 \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u0438\u0437-\u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u0438 \u0441\u0432\u044F\u0437\u043A\u0443
      \u0448\u0435\u0440\u0441\u0442\u044F\u043D\u044B\u0445 \u0448\u043D\u0443\u0440\u043A\u043E\u0432
      \u0441 \u0443\u0437\u0435\u043B\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758608
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0448\u043D\u0443\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758609
    m_Localized: "\u0421\u0442\u0430\u0440\u0435\u0446 \u043F\u043E\u0432\u044F\u0437\u0430\u043B
      \u0448\u043D\u0443\u0440\u043E\u043A \u043D\u0430 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u0435
      \u043A\u0430\u0436\u0434\u043E\u043C\u0443. \u0422\u0435\u043F\u043B\u043E
      \u0440\u0430\u0437\u043B\u0438\u043B\u043E\u0441\u044C \u043F\u043E \u0442\u0435\u043B\u0443,
      \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u043C\u043E\u0440\u043E\u0437.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u044F\u0441\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758610
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758611
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0448\u0451\u043B
      \u043C\u0438\u043C\u043E. \u0421\u0442\u0430\u0440\u0435\u0446 \u043D\u0435
      \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B \u0435\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C
      - \u043E\u043D \u0443\u0436\u0435 \u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u043D\u0430 \u0433\u043E\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758612
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0441\u043E\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758613
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u043E\u043C\u043E\u0433
      \u0440\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0441\u0442\u0430\u0440\u0446\u0430.
      \u0422\u043E\u0442 \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043B \u043F\u0430\u043B\u043A\u043E\u0439
      \u043D\u0430 \u0441\u043D\u0435\u0433\u0443 \u043A\u0430\u0440\u0442\u0443
      \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0445 \u0434\u043D\u0435\u0439
      \u043F\u0443\u0442\u0438 - \u043A\u0430\u0436\u0434\u044B\u0439 \u043E\u043F\u0430\u0441\u043D\u044B\u0439
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442, \u043A\u0430\u0436\u0434\u044B\u0439
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0432\u043E\u0434\u044B.
      \u0411\u0435\u0441\u0446\u0435\u043D\u043D\u044B\u0439 \u0434\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758614
    m_Localized: "\u0422\u0435\u043B\u0435\u0433\u0430 \u043D\u0430 \u0441\u043A\u043B\u043E\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758615
    m_Localized: "\u041D\u0430 \u043A\u0440\u0443\u0442\u043E\u043C \u043E\u0431\u043B\u0435\u0434\u0435\u043D\u0435\u0432\u0448\u0435\u043C
      \u0441\u043F\u0443\u0441\u043A\u0435 \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0441\u043A\u043E\u043B\u044C\u0437\u0438\u0442\u044C.
      \u0412\u043E\u043B\u044B \u0443\u043F\u0438\u0440\u0430\u044E\u0442\u0441\u044F,
      \u043D\u043E \u0438\u0445 \u043A\u043E\u043F\u044B\u0442\u0430 \u043D\u0435
      \u043D\u0430\u0445\u043E\u0434\u044F\u0442 \u043E\u043F\u043E\u0440\u044B.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0430 \u043D\u0430\u0431\u0438\u0440\u0430\u0435\u0442
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C, \u0438 \u0435\u0441\u043B\u0438
      \u0435\u0451 \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      - \u043E\u043D\u0430 \u0440\u0443\u0445\u043D\u0435\u0442 \u0432 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0433\u0440\u0443\u0437\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758616
    m_Localized: "\u0417\u0430\u043A\u043B\u0438\u043D\u0438\u0442\u044C \u043A\u043E\u043B\u0451\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758617
    m_Localized: "\u041A\u0430\u043C\u043D\u0438 \u0438 \u0431\u0440\u0451\u0432\u043D\u0430
      \u043F\u043E\u0434 \u043A\u043E\u043B\u0451\u0441\u0430, \u0432\u0435\u0440\u0451\u0432\u043A\u0438
      \u0437\u0430 \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u0439 \u0432\u044B\u0441\u0442\u0443\u043F.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0430 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0430\u0441\u044C
      \u0432 \u043F\u0430\u0440\u0435 \u0448\u0430\u0433\u043E\u0432 \u043E\u0442
      \u043E\u0431\u0440\u044B\u0432\u0430. \u041E\u0441\u044C \u0442\u0440\u0435\u0441\u043D\u0443\u043B\u0430
      \u043E\u0442 \u0443\u0434\u0430\u0440\u0430, \u043D\u043E \u0433\u0440\u0443\u0437
      \u0446\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758618
    m_Localized: "\u0420\u0430\u0437\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u0438
      \u0441\u043F\u0443\u0441\u043A\u0430\u0442\u044C \u0432\u0440\u0443\u0447\u043D\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758619
    m_Localized: "\u041F\u043E\u043B\u0434\u043D\u044F \u043D\u0430 \u0440\u0430\u0437\u0433\u0440\u0443\u0437\u043A\u0443,
      \u0441\u043F\u0443\u0441\u043A \u0432\u0440\u0443\u0447\u043D\u0443\u044E \u0438
      \u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0443 \u043E\u0431\u0440\u0430\u0442\u043D\u043E.
      \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u043D\u043E \u043D\u0430\u0434\u0451\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758620
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u043F\u043E\u043B\u043E\u0433\u0438\u0439 \u0441\u043F\u0443\u0441\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758621
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B
      \u043E\u0431\u0445\u043E\u0434\u043D\u043E\u0439 \u043F\u0443\u0442\u044C -
      \u043F\u043E\u043B\u043E\u0433\u0438\u0439 \u0441\u043F\u0443\u0441\u043A \u0432
      \u043F\u043E\u043B\u0443\u043A\u0438\u043B\u043E\u043C\u0435\u0442\u0440\u0435.
      \u0414\u043E\u043B\u044C\u0448\u0435, \u043D\u043E \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758622
    m_Localized: "\u0421\u043B\u043E\u043C\u0430\u043D\u043D\u0430\u044F \u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758623
    m_Localized: "\u0420\u0435\u0437\u043A\u0438\u0439 \u0442\u0440\u0435\u0441\u043A
      - \u0438 \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u043F\u0440\u043E\u0441\u0435\u043B\u0430
      \u043D\u0430 \u043E\u0434\u043D\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
      \u041E\u0441\u044C \u043B\u043E\u043F\u043D\u0443\u043B\u0430 \u043D\u0430
      \u043A\u0430\u043C\u043D\u0435, \u0441\u043A\u0440\u044B\u0442\u043E\u043C
      \u043F\u043E\u0434 \u0441\u043D\u0435\u0433\u043E\u043C. \u041D\u0430 \u0442\u0430\u043A\u043E\u0439
      \u0432\u044B\u0441\u043E\u0442\u0435 \u043D\u0430\u0439\u0442\u0438 \u0434\u0435\u0440\u0435\u0432\u043E
      \u0434\u043B\u044F \u0437\u0430\u043C\u0435\u043D\u044B - \u0437\u0430\u0434\u0430\u0447\u0430
      \u043D\u0435\u0442\u0440\u0438\u0432\u0438\u0430\u043B\u044C\u043D\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758624
    m_Localized: "\u0427\u0438\u043D\u0438\u0442\u044C \u043D\u0430 \u043C\u0435\u0441\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758625
    m_Localized: "\u0421\u0440\u0443\u0431\u043B\u0435\u043D\u043D\u043E\u0435 \u0434\u0435\u0440\u0435\u0432\u0446\u0435
      \u0438 \u043F\u043E\u043B\u043E\u0441\u043A\u0438 \u043A\u043E\u0436\u0438
      \u0437\u0430\u043C\u0435\u043D\u0438\u043B\u0438 \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u0443\u044E
      \u043E\u0441\u044C. \u041F\u043E\u0447\u0438\u043D\u043A\u0430 \u0433\u0440\u0443\u0431\u0430\u044F,
      \u043D\u043E \u0434\u043E \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0433\u043E
      \u0441\u0435\u043B\u0435\u043D\u0438\u044F \u0434\u043E\u0442\u044F\u043D\u0435\u0442.
      \u041F\u043E\u043B\u0434\u043D\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758626
    m_Localized: "\u041F\u0435\u0440\u0435\u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
      \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758627
    m_Localized: "\u0427\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430 \u043F\u0435\u0440\u0435\u043A\u0438\u043D\u0443\u043B\u0438
      \u043D\u0430 \u0432\u044C\u044E\u0447\u043D\u044B\u0445 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445,
      \u0447\u0430\u0441\u0442\u044C - \u043D\u0430 \u0437\u0430\u043F\u0430\u0441\u043D\u044B\u0435
      \u0442\u0435\u043B\u0435\u0433\u0438. \u0418\u0434\u0451\u043C \u0434\u0430\u043B\u044C\u0448\u0435,
      \u043D\u043E \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758628
    m_Localized: "\u0413\u043E\u0440\u043D\u0430\u044F \u043F\u0435\u0449\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758629
    m_Localized: "\u0411\u0443\u0440\u044F \u0437\u0430\u0433\u043D\u0430\u043B\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0432 \u0443\u0437\u043A\u0443\u044E
      \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0443. \u0412\u043D\u0443\u0442\u0440\u0438
      - \u043F\u0435\u0449\u0435\u0440\u0430, \u0441\u0442\u0435\u043D\u044B \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u0438\u0441\u043A\u0440\u044F\u0442\u0441\u044F \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u0430\u043C\u0438
      \u0432 \u0441\u0432\u0435\u0442\u0435 \u0444\u0430\u043A\u0435\u043B\u0430.
      \u0412\u043E\u0437\u0434\u0443\u0445 \u0442\u0451\u043F\u043B\u044B\u0439 \u0438
      \u0441\u0443\u0445\u043E\u0439. \u0421\u0440\u0435\u0434\u0438 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u043E\u0432
      \u0431\u043B\u0435\u0441\u0442\u0438\u0442 \u0447\u0442\u043E-\u0442\u043E
      \u0446\u0435\u043D\u043D\u043E\u0435, \u043D\u043E \u0441\u0432\u043E\u0434
      \u043D\u0435\u043D\u0430\u0434\u0451\u0436\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758630
    m_Localized: "\u0414\u043E\u0431\u044B\u0442\u044C \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758631
    m_Localized: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0430\u044F \u0434\u043E\u0431\u044B\u0447\u0430
      \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430 \u0433\u043E\u0440\u0441\u0442\u044C
      \u0433\u043E\u0440\u043D\u044B\u0445 \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u043E\u0432
      - \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B \u0432 \u0433\u043E\u0440\u043E\u0434\u0430\u0445
      \u0437\u0430\u043F\u043B\u0430\u0442\u044F\u0442 \u0445\u043E\u0440\u043E\u0448\u043E.
      \u041D\u043E \u0441\u0432\u043E\u0434 \u0434\u0440\u043E\u0433\u043D\u0443\u043B,
      \u0438 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C\u0441\u044F
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u0447\u0435\u043C \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758632
    m_Localized: "\u041F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C \u0431\u0443\u0440\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758633
    m_Localized: "\u041D\u043E\u0447\u044C \u0432 \u0442\u0451\u043F\u043B\u043E\u0439
      \u043F\u0435\u0449\u0435\u0440\u0435 - \u0440\u0435\u0434\u043A\u0438\u0439
      \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u043D\u0430 \u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E\u0440\u044C\u0435.
      \u0423\u0442\u0440\u043E\u043C \u0431\u0443\u0440\u044F \u0441\u0442\u0438\u0445\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758634
    m_Localized: "\u0417\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439
      \u0445\u0440\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758635
    m_Localized: "\u0421\u0440\u0435\u0434\u0438 \u0441\u043A\u0430\u043B \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438\u0441\u044C
      \u0440\u0443\u0438\u043D\u044B \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u0445\u0440\u0430\u043C\u0430. \u041A\u0440\u044B\u0448\u0430 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044C,
      \u043D\u043E \u0441\u0442\u0435\u043D\u044B \u0441\u0442\u043E\u044F\u0442.
      \u0412\u043D\u0443\u0442\u0440\u0438 - \u043F\u043E\u043B\u0443\u0441\u0442\u0451\u0440\u0448\u0438\u0435\u0441\u044F
      \u0444\u0440\u0435\u0441\u043A\u0438, \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439
      \u0430\u043B\u0442\u0430\u0440\u044C \u0438 \u0437\u0430\u043F\u0430\u0445
      \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u0441\u0430\u043D\u0434\u0430\u043B\u0430.
      \u0412 \u043D\u0438\u0448\u0435 \u0447\u0442\u043E-\u0442\u043E \u043F\u043E\u0431\u043B\u0451\u0441\u043A\u0438\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758636
    m_Localized: "\u041E\u0431\u044B\u0441\u043A\u0430\u0442\u044C \u0445\u0440\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758637
    m_Localized: "\u0417\u0430 \u0430\u043B\u0442\u0430\u0440\u0451\u043C \u043D\u0430\u0448\u043B\u0430\u0441\u044C
      \u043D\u0438\u0448\u0430 \u0441 \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u044F\u043C\u0438:
      \u0441\u0442\u0430\u0440\u044B\u0435 \u043C\u043E\u043D\u0435\u0442\u044B \u0438
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u0430\u044F \u043A\u0443\u0440\u0438\u043B\u044C\u043D\u0438\u0446\u0430.
      \u0414\u0440\u0435\u0432\u043D\u0438\u0435 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438
      \u0431\u044B\u043B\u0438 \u0449\u0435\u0434\u0440\u044B \u043A \u044D\u0442\u043E\u043C\u0443
      \u043C\u0435\u0441\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758638
    m_Localized: "\u041F\u043E\u043C\u043E\u043B\u0438\u0442\u044C\u0441\u044F \u0438
      \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758639
    m_Localized: "\u041C\u043E\u043B\u0438\u0442\u0432\u0430 \u0432 \u0442\u0438\u0448\u0438\u043D\u0435
      \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u043E \u0445\u0440\u0430\u043C\u0430.
      \u041D\u0435\u0442 \u043D\u0438 \u0437\u043E\u043B\u043E\u0442\u0430, \u043D\u0438
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 - \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758640
    m_Localized: "\u041F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C \u0444\u0440\u0435\u0441\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758641
    m_Localized: "\u0424\u0440\u0435\u0441\u043A\u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442
      \u0438\u0441\u0442\u043E\u0440\u0438\u044E \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438, \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u0432\u0448\u0435\u0433\u043E
      \u0432\u0435\u043A\u0430 \u043D\u0430\u0437\u0430\u0434. \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0441\u0438\u043C\u0432\u043E\u043B\u044B \u0434\u043E \u0441\u0438\u0445
      \u043F\u043E\u0440 \u0432 \u0445\u043E\u0434\u0443 \u043D\u0430 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0445
      \u0440\u044B\u043D\u043A\u0430\u0445. \u0417\u043D\u0430\u043D\u0438\u0435,
      \u0432\u044B\u0447\u0438\u0442\u0430\u043D\u043D\u043E\u0435 \u0438\u0437 \u043A\u0430\u043C\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758642
    m_Localized: "\u041D\u043E\u0447\u043D\u0430\u044F \u0430\u0442\u0430\u043A\u0430
      \u0432\u043E\u043B\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758643
    m_Localized: "\u0413\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u043D\u043E\u0447\u044C\u044E
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u0437\u0430 \u043A\u0440\u0443\u0433\u043E\u043C
      \u043A\u043E\u0441\u0442\u0440\u0430 \u0437\u0430\u0433\u043E\u0440\u0430\u044E\u0442\u0441\u044F
      \u0436\u0451\u043B\u0442\u044B\u0435 \u0433\u043B\u0430\u0437\u0430. \u0421\u0442\u0430\u044F
      \u0432\u043E\u043B\u043A\u043E\u0432, \u0433\u043E\u043B\u043E\u0434\u043D\u0430\u044F
      \u0438 \u0434\u0435\u0440\u0437\u043A\u0430\u044F, \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
      \u043A \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u043C. \u0416\u0438\u0432\u043E\u0442\u043D\u044B\u0435
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0431\u044C\u044E\u0442\u0441\u044F
      \u0432 \u043F\u0440\u0438\u0432\u044F\u0437\u044F\u0445, \u043B\u044E\u0434\u0438
      \u0445\u0432\u0430\u0442\u0430\u044E\u0442\u0441\u044F \u0437\u0430 \u0444\u0430\u043A\u0435\u043B\u044B.
      \u0412\u043E\u0436\u0430\u043A \u0441\u0442\u0430\u0438 - \u043A\u0440\u0443\u043F\u043D\u044B\u0439
      \u0441\u0435\u0440\u044B\u0439 \u0437\u0432\u0435\u0440\u044C - \u043D\u0435
      \u043E\u0442\u0432\u043E\u0434\u0438\u0442 \u0432\u0437\u0433\u043B\u044F\u0434\u0430
      \u043E\u0442 \u043C\u0435\u0448\u043A\u043E\u0432 \u0441 \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758644
    m_Localized: "\u041E\u0442\u043E\u0433\u043D\u0430\u0442\u044C \u043E\u0433\u043D\u0451\u043C
      \u0438 \u0448\u0443\u043C\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758645
    m_Localized: "\u0424\u0430\u043A\u0435\u043B\u044B \u0438 \u043A\u0440\u0438\u043A\u0438
      \u0440\u0430\u0437\u043E\u0433\u043D\u0430\u043B\u0438 \u0441\u0442\u0430\u044E,
      \u043D\u043E \u0432\u043E\u043B\u043A\u0438 \u0443\u0441\u043F\u0435\u043B\u0438
      \u0432\u0446\u0435\u043F\u0438\u0442\u044C\u0441\u044F \u0432 \u043E\u0434\u0438\u043D
      \u0438\u0437 \u0442\u044E\u043A\u043E\u0432. \u041C\u0435\u0448\u043E\u043A
      \u0441 \u0432\u044F\u043B\u0435\u043D\u044B\u043C \u043C\u044F\u0441\u043E\u043C
      \u0440\u0430\u0437\u043E\u0434\u0440\u0430\u043D, \u0447\u0430\u0441\u0442\u044C
      \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u0440\u0430\u0437\u0431\u0440\u043E\u0441\u0430\u043D\u0430
      \u043F\u043E \u0437\u0435\u043C\u043B\u0435. \u041D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0441\u043F\u0430\u043B \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758646
    m_Localized: "\u041E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u0442\u044C
      \u043E\u0431\u043E\u0440\u043E\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758647
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u043E \u0441\u043E\u0441\u0442\u0430\u0432\u0438\u0432
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043A\u043E\u043B\u044C\u0446\u043E\u043C
      \u0438 \u0440\u0430\u0437\u0432\u0435\u0434\u044F \u043A\u043E\u0441\u0442\u0440\u044B
      \u043F\u043E \u043F\u0435\u0440\u0438\u043C\u0435\u0442\u0440\u0443, \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0432\u044B\u0441\u0442\u043E\u044F\u043B. \u0412\u043E\u043B\u043A\u0438
      \u043A\u0440\u0443\u0436\u0438\u043B\u0438 \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430,
      \u043D\u043E \u043D\u0435 \u0440\u0435\u0448\u0438\u043B\u0438\u0441\u044C
      \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C. \u041A \u0443\u0442\u0440\u0443
      \u0441\u0442\u0430\u044F \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0430\u0441\u044C
      \u0432 \u043F\u0440\u0435\u0434\u0440\u0430\u0441\u0441\u0432\u0435\u0442\u043D\u043E\u0439
      \u043C\u0433\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758648
    m_Localized: "\u0421\u0443\u043C\u0430\u0442\u043E\u0445\u0430 \u043F\u0440\u0438
      \u043F\u043E\u043F\u044B\u0442\u043A\u0435 \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0438\u0442\u044C
      \u043B\u0430\u0433\u0435\u0440\u044C \u043B\u0438\u0448\u044C \u0440\u0430\u0437\u0437\u0430\u0434\u043E\u0440\u0438\u043B\u0430
      \u0441\u0442\u0430\u044E. \u0412\u043E\u043B\u043A\u0438 \u0431\u0440\u043E\u0441\u0438\u043B\u0438\u0441\u044C
      \u0440\u0430\u0437\u043E\u043C - \u043D\u0430 \u043F\u0440\u0438\u043F\u0430\u0441\u044B,
      \u043D\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0443, \u043D\u0430 \u0432\u0435\u0440\u0451\u0432\u043A\u0438.
      \u041F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u0438\u0445 \u043E\u0442\u043E\u0433\u043D\u0430\u0442\u044C, \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F,
      \u0430 \u0447\u0430\u0441\u0442\u044C \u0435\u0434\u044B \u043F\u0440\u043E\u043F\u0430\u043B\u0430
      \u0431\u0435\u0437\u0432\u043E\u0437\u0432\u0440\u0430\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758649
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442
      \u043F\u043E\u0437\u0438\u0446\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758650
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A, \u043F\u0440\u0438\u0432\u044B\u043A\u0448\u0438\u0439
      \u043A \u043D\u043E\u0447\u043D\u044B\u043C \u043A\u0430\u0440\u0430\u0443\u043B\u0430\u043C,
      \u0437\u0430\u0440\u0430\u043D\u0435\u0435 \u0440\u0430\u0441\u0441\u043B\u044B\u0448\u0430\u043B
      \u0448\u043E\u0440\u043E\u0445 \u0432 \u0442\u0440\u0430\u0432\u0435. \u0412\u0441\u0442\u0430\u0432
      \u0441 \u043A\u043E\u043F\u044C\u0451\u043C \u0443 \u043A\u043E\u0441\u0442\u0440\u0430,
      \u043E\u043D \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B \u0432\u043E\u0436\u0430\u043A\u0430
      \u0441\u0442\u0430\u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u043C \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C.
      \u0412\u043E\u043B\u043A \u0437\u0430\u043C\u0435\u0440, \u043E\u0441\u043A\u0430\u043B\u0438\u043B\u0441\u044F
      - \u0438 \u0443\u0432\u0451\u043B \u0441\u0442\u0430\u044E \u043F\u0440\u043E\u0447\u044C.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043B
      \u043D\u0438 \u043A\u0440\u043E\u0448\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758651
    m_Localized: "\u041F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u043F\u0443\u0442\u043D\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758652
    m_Localized: "\u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435
      - \u0447\u0435\u0442\u0432\u0435\u0440\u043E \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432
      \u0432 \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u044B\u0445 \u0445\u0430\u043B\u0430\u0442\u0430\u0445.
      \u041E\u043D\u0438 \u0441\u0438\u0434\u044F\u0442 \u0443 \u043E\u0431\u043E\u0447\u0438\u043D\u044B,
      \u0441\u043B\u043E\u0432\u043D\u043E \u043E\u0442\u0434\u044B\u0445\u0430\u044E\u0442,
      \u043D\u043E \u043E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445 \u0442\u043E
      \u0438 \u0434\u0435\u043B\u043E \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0445\u043E\u043B\u043C\u044B. \u0423 \xAB\u0431\u0435\u0437\u043E\u0440\u0443\u0436\u043D\u044B\u0445\xBB
      \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432 \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043A\u0440\u0435\u043F\u043A\u0438\u0435 \u0440\u0443\u043A\u0438, \u0430
      \u043F\u043E\u0434 \u0445\u0430\u043B\u0430\u0442\u0430\u043C\u0438 \u0443\u0433\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u043E\u0447\u0435\u0440\u0442\u0430\u043D\u0438\u044F \u043D\u043E\u0436\u0435\u0439.
      \u0421\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758653
    m_Localized: "\u041E\u0431\u044A\u0435\u0445\u0430\u0442\u044C \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758654
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0441\u0432\u0435\u0440\u043D\u0443\u043B
      \u0441 \u0434\u043E\u0440\u043E\u0433\u0438, \u043F\u0440\u043E\u0434\u0438\u0440\u0430\u044F\u0441\u044C
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0440\u043E\u0432\u043D\u0443\u044E
      \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C. \u041F\u043E\u0432\u043E\u0437\u043A\u0443
      \u043F\u043E\u0442\u0440\u0435\u043F\u0430\u043B\u043E \u043D\u0430 \u043A\u043E\u0447\u043A\u0430\u0445,
      \u043D\u043E \u0437\u0430\u0441\u0430\u0434\u044B \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u0438\u0437\u0431\u0435\u0436\u0430\u0442\u044C. \u041F\u0443\u0442\u043D\u0438\u043A\u0438
      \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043D\u0435\u0434\u043E\u0431\u0440\u044B\u043C\u0438 \u0432\u0437\u0433\u043B\u044F\u0434\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758655
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438, \u043F\u043E\u043A\u0430\u0437\u0430\u0432
      \u0441\u0438\u043B\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758656
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0432\u043F\u0435\u0440\u0451\u0434 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u043C
      \u0441\u0442\u0440\u043E\u0435\u043C, \u043B\u044E\u0434\u0438 \u0434\u0435\u0440\u0436\u0430\u0442
      \u043E\u0440\u0443\u0436\u0438\u0435 \u043D\u0430 \u0432\u0438\u0434\u0443.
      \u041F\u0443\u0442\u043D\u0438\u043A\u0438 \u043E\u0446\u0435\u043D\u0438\u043B\u0438
      \u0441\u0438\u043B\u044B - \u0438 \u043C\u043E\u043B\u0447\u0430 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438.
      \u041E\u0434\u0438\u043D \u0434\u0430\u0436\u0435 \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E
      \u043A\u0438\u0432\u043D\u0443\u043B, \u0441\u043B\u043E\u0432\u043D\u043E
      \u043D\u0438\u0447\u0435\u0433\u043E \u0438 \u043D\u0435 \u0437\u0430\u043C\u044B\u0448\u043B\u044F\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758657
    m_Localized: "\u0411\u0440\u0430\u0432\u0430\u0434\u0430 \u043D\u0435 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430.
      \u0418\u0437-\u0437\u0430 \u0445\u043E\u043B\u043C\u043E\u0432 \u0432\u044B\u0441\u043A\u043E\u0447\u0438\u043B\u0438
      \u0435\u0449\u0451 \u043F\u044F\u0442\u0435\u0440\u043E - \u0437\u0430\u0441\u0430\u0434\u0430
      \u0437\u0430\u0445\u043B\u043E\u043F\u043D\u0443\u043B\u0430\u0441\u044C. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043E\u0442\u043A\u0443\u043F\u0430\u0442\u044C\u0441\u044F \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C,
      \u0447\u0442\u043E\u0431\u044B \u0443\u0439\u0442\u0438 \u0431\u0435\u0437
      \u043A\u0440\u043E\u0432\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758658
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0451\u0442
      \u0437\u0430\u0441\u0430\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758659
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A, \u043F\u0440\u0438\u0449\u0443\u0440\u0438\u0432\u0448\u0438\u0441\u044C,
      \u0443\u043A\u0430\u0437\u0430\u043B \u043D\u0430 \u0431\u043B\u0435\u0441\u043A
      \u043C\u0435\u0442\u0430\u043B\u043B\u0430 \u0432 \u043A\u0443\u0441\u0442\u0430\u0445
      \u0437\u0430 \u0445\u043E\u043B\u043C\u043E\u043C. \xAB\u0417\u0430\u0441\u0430\u0434\u0430.
      \u041F\u044F\u0442\u0435\u0440\u043E \u0437\u0430 \u0445\u043E\u043B\u043C\u043E\u043C,
      \u0447\u0435\u0442\u0432\u0435\u0440\u043E \u0437\u0434\u0435\u0441\u044C.\xBB
      \u041F\u043E \u0435\u0433\u043E \u043A\u043E\u043C\u0430\u043D\u0434\u0435
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0435\u0440\u0435\u0441\u0442\u0440\u043E\u0438\u043B\u0441\u044F
      \u0432 \u0431\u043E\u0435\u0432\u043E\u0439 \u043F\u043E\u0440\u044F\u0434\u043E\u043A.
      \u0411\u0430\u043D\u0434\u0438\u0442\u044B \u043F\u043E\u043D\u044F\u043B\u0438,
      \u0447\u0442\u043E \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u044B, \u0438
      \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C \u0432
      \u0437\u0430\u0440\u043E\u0441\u043B\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758660
    m_Localized: "\u0420\u0430\u0437\u0432\u0438\u043B\u043A\u0430 \u0431\u0435\u0437
      \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758661
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0430 \u0440\u0430\u0437\u0434\u0432\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      \u041B\u0435\u0432\u0430\u044F \u0442\u0440\u043E\u043F\u0430 \u0443\u0445\u043E\u0434\u0438\u0442
      \u0432 \u043D\u0438\u0437\u0438\u043D\u0443, \u0448\u0438\u0440\u0435, \u043D\u043E
      \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435 \u0442\u0435\u043C\u043D\u0435\u044E\u0442
      \u0442\u0443\u0447\u0438. \u041F\u0440\u0430\u0432\u0430\u044F \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u0432\u0432\u0435\u0440\u0445 \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443,
      \u0443\u0437\u043A\u0430\u044F \u0438 \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u0430\u044F.
      \u041D\u0438\u043A\u0430\u043A\u0438\u0445 \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0435\u0439,
      \u043D\u0438 \u0441\u043B\u0435\u0434\u043E\u0432 \u043E\u0442 \u043F\u043E\u0432\u043E\u0437\u043E\u043A.
      \u0421\u0442\u0430\u0440\u0430\u044F \u0441\u0442\u0435\u043B\u0430 \u0443
      \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438 \u0441\u0442\u0451\u0440\u0442\u0430
      \u0432\u0435\u0442\u0440\u043E\u043C \u0434\u043E \u043D\u0435\u0440\u0430\u0437\u0431\u043E\u0440\u0447\u0438\u0432\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758662
    m_Localized: "\u041F\u043E\u0439\u0442\u0438 \u043F\u043E \u043B\u0435\u0432\u043E\u0439
      (\u0448\u0438\u0440\u043E\u043A\u043E\u0439) \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758663
    m_Localized: "\u0428\u0438\u0440\u043E\u043A\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430
      \u0432\u0441\u043A\u043E\u0440\u0435 \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
      \u043B\u043E\u0432\u0443\u0448\u043A\u043E\u0439 - \u043D\u0438\u0437\u0438\u043D\u0430
      \u0437\u0430\u0431\u043E\u043B\u043E\u0447\u0435\u043D\u0430 \u043F\u043E\u0441\u043B\u0435
      \u0434\u043E\u0436\u0434\u0435\u0439, \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0432\u044F\u0437\u043D\u0443\u0442. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0440\u0430\u0437\u0433\u0440\u0443\u0436\u0430\u0442\u044C \u0438 \u0432\u044B\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u0442\u044C
      \u0432\u0440\u0443\u0447\u043D\u0443\u044E. \u041F\u043E\u043B\u0434\u043D\u044F
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E, \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u043F\u043E\u0434\u043C\u043E\u043A\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758664
    m_Localized: "\u041F\u043E\u0439\u0442\u0438 \u043F\u043E \u043F\u0440\u0430\u0432\u043E\u0439
      (\u0433\u043E\u0440\u043D\u043E\u0439) \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758665
    m_Localized: "\u041A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u044B\u0439 \u043F\u043E\u0434\u044A\u0451\u043C
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C.
      \u0417\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u043E\u043C \u043E\u0442\u043A\u0440\u044B\u043B\u0430\u0441\u044C
      \u0441\u0443\u0445\u0430\u044F \u0440\u043E\u0432\u043D\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430,
      \u0432\u0435\u0434\u0443\u0449\u0430\u044F \u0442\u043E\u0447\u043D\u043E \u0432
      \u043D\u0443\u0436\u043D\u043E\u043C \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438.
      \u041E\u043F\u044B\u0442\u043D\u044B\u0439 \u0433\u043B\u0430\u0437 \u043D\u0435
      \u043F\u043E\u0434\u0432\u0451\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758666
    m_Localized: "\u0423\u0437\u043A\u0430\u044F \u0442\u0440\u043E\u043F\u0430 \u043F\u0435\u0442\u043B\u044F\u043B\u0430
      \u0441\u0440\u0435\u0434\u0438 \u043A\u0430\u043C\u043D\u0435\u0439 \u043A\u0443\u0434\u0430
      \u0434\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C.
      \u041A\u043E\u043B\u0435\u0441\u043E \u043D\u0430\u043B\u0435\u0442\u0435\u043B\u043E
      \u043D\u0430 \u0432\u0430\u043B\u0443\u043D, \u043E\u0441\u044C \u0437\u0430\u0441\u0442\u043E\u043D\u0430\u043B\u0430.
      \u041A\u043E\u0433\u0434\u0430 \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0432\u044B\u0431\u0440\u0430\u043B\u0438\u0441\u044C,
      \u0441\u0442\u0430\u043B\u043E \u044F\u0441\u043D\u043E - \u043A\u0440\u044E\u043A
      \u0432\u044B\u0448\u0435\u043B \u043D\u0435\u043C\u0430\u043B\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758667
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u0434\u043E\u0440\u043E\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758668
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043F\u0440\u0438\u0441\u0435\u043B
      \u0443 \u0441\u0442\u0435\u043B\u044B, \u043F\u0440\u043E\u0432\u0451\u043B
      \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u043F\u043E \u0441\u0442\u0451\u0440\u0442\u044B\u043C
      \u0437\u043D\u0430\u043A\u0430\u043C. \xAB\u041D\u0430\u043F\u0440\u0430\u0432\u043E.
      \u041B\u0435\u0432\u0430\u044F \u0442\u0440\u043E\u043F\u0430 \u0432\u0435\u0434\u0451\u0442
      \u043A \u0441\u0442\u0430\u0440\u043E\u043C\u0443 \u0440\u0430\u0437\u043B\u0438\u0432\u0443
      - \u043F\u043E\u0441\u043B\u0435 \u0434\u043E\u0436\u0434\u0435\u0439 \u0442\u0430\u043C
      \u043D\u0435 \u043F\u0440\u043E\u0439\u0442\u0438.\xBB \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u043E\u0448\u0451\u043B \u043F\u0440\u0430\u0432\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u043E\u0439
      \u0438 \u043A \u0432\u0435\u0447\u0435\u0440\u0443 \u0432\u044B\u0448\u0435\u043B
      \u0442\u043E\u0447\u043D\u043E \u043A \u043D\u0430\u043C\u0435\u0447\u0435\u043D\u043D\u043E\u043C\u0443
      \u043F\u0440\u0438\u0432\u0430\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758669
    m_Localized: "\u041E\u043F\u0430\u0441\u043D\u044B\u0439 \u043E\u0431\u0440\u044B\u0432
      \u043D\u0430 \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758670
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u0441\u0443\u0436\u0430\u0435\u0442\u0441\u044F
      \u0434\u043E \u0448\u0438\u0440\u0438\u043D\u044B \u043E\u0434\u043D\u043E\u0439
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438. \u0421\u043F\u0440\u0430\u0432\u0430
      - \u043E\u0442\u0432\u0435\u0441\u043D\u0430\u044F \u0441\u0442\u0435\u043D\u0430,
      \u0441\u043B\u0435\u0432\u0430 - \u043E\u0431\u0440\u044B\u0432 \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u0435\u0441\u044F\u0442\u043A\u043E\u0432 \u0447\u0436\u0430\u043D\u043E\u0432.
      \u041A\u0430\u043C\u043D\u0438 \u043F\u043E\u0434 \u043A\u043E\u043B\u0451\u0441\u0430\u043C\u0438
      \u043E\u0441\u044B\u043F\u0430\u044E\u0442\u0441\u044F \u0432\u043D\u0438\u0437,
      \u0438 \u0437\u0432\u0443\u043A\u0430 \u0438\u0445 \u043F\u0430\u0434\u0435\u043D\u0438\u044F
      \u043D\u0435 \u0441\u043B\u044B\u0448\u043D\u043E. \u0412\u044C\u044E\u0447\u043D\u044B\u0435
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u043D\u0435\u0440\u0432\u043D\u0438\u0447\u0430\u044E\u0442,
      \u043F\u0440\u0438\u0436\u0438\u043C\u0430\u044F \u0443\u0448\u0438. \u0420\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E
      - \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043F\u0435\u0440\u0451\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758671
    m_Localized: "\u041C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u043F\u0440\u043E\u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758672
    m_Localized: "\u0428\u0430\u0433 \u0437\u0430 \u0448\u0430\u0433\u043E\u043C,
      \u043F\u0440\u0438\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u043C\u0438, \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u043E\u043B\u0437 \u043F\u043E \u043E\u0431\u0440\u044B\u0432\u0443.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u0442\u044E\u043A\u043E\u0432 \u0432\u0441\u0451
      \u0436\u0435 \u0441\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B
      \u0438 \u0443\u0445\u043D\u0443\u043B \u0432 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C.
      \u041B\u044E\u0434\u0438 \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C
      \u0434\u043E \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0433\u043E
      \u0443\u0447\u0430\u0441\u0442\u043A\u0430 \u0431\u043B\u0435\u0434\u043D\u044B\u0435
      \u0438 \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u044B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758673
    m_Localized: "\u0420\u0430\u0437\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0434\u043B\u044F \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758674
    m_Localized: "\u041B\u044E\u0434\u0438 \u0432\u0437\u044F\u043B\u0438 \u0433\u0440\u0443\u0437
      \u043D\u0430 \u043F\u043B\u0435\u0447\u0438 \u0438 \u043F\u0440\u043E\u0432\u0435\u043B\u0438
      \u043E\u0431\u043B\u0435\u0433\u0447\u0451\u043D\u043D\u044B\u0435 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043F\u043E \u043A\u0440\u0430\u044E \u043E\u0431\u0440\u044B\u0432\u0430.
      \u0422\u044F\u0436\u0435\u043B\u043E, \u043D\u043E \u043D\u0438 \u043E\u0434\u0438\u043D
      \u0442\u044E\u043A \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043D.
      \u041D\u0430 \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
      \u043F\u0435\u0440\u0435\u0432\u0435\u043B\u0438 \u0434\u0443\u0445 \u0438
      \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u043B\u0438\u0441\u044C \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758675
    m_Localized: "\u041D\u0430 \u043F\u043E\u043B\u043F\u0443\u0442\u0438 \u043E\u0431\u043B\u0435\u0433\u0447\u0451\u043D\u043D\u0430\u044F
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u0437\u0430\u0441\u043A\u043E\u043B\u044C\u0437\u0438\u043B\u0430 \u043A \u043A\u0440\u0430\u044E.
      \u041F\u044B\u0442\u0430\u044F\u0441\u044C \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C,
      \u0441\u043B\u043E\u043C\u0430\u043B\u0438 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435
      \u0431\u043E\u0440\u0442\u0430. \u0427\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0435\u0441\u043B\u0438 \u043D\u0430
      \u0440\u0443\u043A\u0430\u0445, \u0443\u0440\u043E\u043D\u0438\u043B\u0438
      \u0432 \u0441\u0443\u043C\u0430\u0442\u043E\u0445\u0435. \u041A\u043E\u0433\u0434\u0430
      \u043F\u0440\u043E\u0448\u043B\u0438 - \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u0430 \u0440\u0435\u043C\u043E\u043D\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758676
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u043C \u043F\u0443\u0442\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758677
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0443\u0448\u0451\u043B
      \u0432\u043F\u0435\u0440\u0451\u0434, \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044F
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0448\u0430\u0433. \xAB\u0417\u0434\u0435\u0441\u044C
      \u043A\u0430\u043C\u0435\u043D\u044C \u043A\u0440\u0435\u043F\u043A\u0438\u0439,
      \u0437\u0434\u0435\u0441\u044C \u0434\u0435\u0440\u0436\u0438\u0442\u0435\u0441\u044C
      \u0441\u0442\u0435\u043D\u044B. \u041D\u0435 \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
      \u0432\u043D\u0438\u0437.\xBB \u041F\u043E\u0434 \u0435\u0433\u043E \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u043C
      \u0440\u0443\u043A\u043E\u0432\u043E\u0434\u0441\u0442\u0432\u043E\u043C \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u043B \u043E\u043F\u0430\u0441\u043D\u044B\u0439
      \u0443\u0447\u0430\u0441\u0442\u043E\u043A \u0431\u0435\u0437 \u0435\u0434\u0438\u043D\u043E\u0439
      \u043F\u043E\u0442\u0435\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758678
    m_Localized: "\u041E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0438\u0437
      \u0440\u0443\u0447\u044C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758679
    m_Localized: "\u0423 \u0434\u043E\u0440\u043E\u0433\u0438 \u0440\u0443\u0447\u0435\u0439
      \u0441 \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u043E\u0439 \u0432\u043E\u0434\u043E\u0439.
      \u041B\u044E\u0434\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u043B\u0438
      \u0431\u0443\u0440\u0434\u044E\u043A\u0438, \u043D\u0430\u043F\u043E\u0438\u043B\u0438
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445. \u0427\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441 \u043D\u0430\u0447\u0430\u043B\u0438\u0441\u044C \u0440\u0435\u0437\u0438
      \u0432 \u0436\u0438\u0432\u043E\u0442\u0435, \u0434\u0432\u043E\u0438\u0445
      \u0432\u044B\u0440\u0432\u0430\u043B\u043E. \u0412\u043E\u0434\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u0430: \u0432\u044B\u0448\u0435
      \u043F\u043E \u0442\u0435\u0447\u0435\u043D\u0438\u044E \u0447\u0442\u043E-\u0442\u043E
      \u0433\u043D\u0438\u0451\u0442 \u0432 \u0437\u0430\u0432\u043E\u0434\u0438.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u043B\u0435\u0436\u0438\u0442
      \u043F\u043B\u0430\u0441\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758680
    m_Localized: "\u0416\u0434\u0430\u0442\u044C, \u043F\u043E\u043A\u0430 \u043F\u0440\u043E\u0439\u0434\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758681
    m_Localized: "\u0414\u0432\u0430 \u0434\u043D\u044F \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u0440\u043E\u0441\u0442\u043E\u044F\u043B \u043D\u0430 \u043C\u0435\u0441\u0442\u0435.
      \u041B\u044E\u0434\u0438 \u043F\u0438\u043B\u0438 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043A\u0438\u043F\u044F\u0447\u0451\u043D\u0443\u044E \u0432\u043E\u0434\u0443,
      \u043D\u043E \u0441\u043B\u0430\u0431\u043E\u0441\u0442\u044C \u043D\u0435
      \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u043B\u0430. \u0417\u0430\u043F\u0430\u0441\u044B
      \u0442\u0430\u044F\u043B\u0438, \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0443\u043F\u0430\u043B\u043E \u043D\u0438\u0436\u0435 \u043D\u0435\u043A\u0443\u0434\u0430.
      \u041A\u043E\u0433\u0434\u0430 \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0434\u0432\u0438\u043D\u0443\u043B\u0438\u0441\u044C,
      \u0448\u043B\u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u043A\u0430\u043A
      \u043F\u043E\u0441\u043B\u0435 \u0431\u043E\u043B\u0435\u0437\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758682
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0442\u0440\u0430\u0432\u044B \u0438\u0437 \u0437\u0430\u043F\u0430\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758683
    m_Localized: "\u0421\u0440\u0435\u0434\u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u043D\u0430\u0448\u043B\u0438\u0441\u044C \u0441\u0443\u0448\u0451\u043D\u044B\u0435
      \u043A\u043E\u0440\u043D\u0438 - \u0442\u043E \u0441\u0430\u043C\u043E\u0435
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E \u043E\u0442 \u0434\u0443\u0440\u043D\u043E\u0439
      \u0432\u043E\u0434\u044B, \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043E\u0442\u0435\u0446
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B \u0432 \u0434\u0435\u0442\u0441\u0442\u0432\u0435.
      \u041E\u0442\u0432\u0430\u0440 \u043F\u043E\u043C\u043E\u0433: \u043A \u0432\u0435\u0447\u0435\u0440\u0443
      \u043B\u044E\u0434\u0438 \u0443\u0436\u0435 \u043C\u043E\u0433\u043B\u0438
      \u0438\u0434\u0442\u0438. \u0427\u0430\u0441\u0442\u044C \u0435\u0434\u044B
      \u0443\u0448\u043B\u0430 \u043D\u0430 \u043B\u0435\u0447\u0435\u0431\u043D\u0443\u044E
      \u043A\u0430\u0448\u0443, \u043D\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043B\u0441\u044F \u043D\u0430\u0434\u043E\u043B\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758684
    m_Localized: "\u041E\u0442\u0432\u0430\u0440 \u043D\u0435 \u043F\u043E\u043C\u043E\u0433:
      \u0442\u0440\u0430\u0432\u044B \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u0442\u0430\u0440\u044B\u043C\u0438,
      \u0430 \u043C\u043E\u0436\u0435\u0442, \u043E\u0442\u0440\u0430\u0432\u0430
      \u0431\u044B\u043B\u0430 \u0438\u043D\u043E\u0433\u043E \u0440\u043E\u0434\u0430.
      \u041B\u044E\u0434\u0438 \u043F\u0440\u043E\u043C\u0443\u0447\u0438\u043B\u0438\u0441\u044C
      \u0435\u0449\u0451 \u0434\u043E\u043B\u044C\u0448\u0435, \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B \u0432\u043F\u0443\u0441\u0442\u0443\u044E.
      \u0414\u0443\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0443\u043F\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758685
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0433\u043E\u0442\u043E\u0432\u0438\u0442
      \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u044F\u0434\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758686
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C, \u043F\u0440\u0438\u043D\u044E\u0445\u0430\u0432\u0448\u0438\u0441\u044C
      \u043A \u0432\u043E\u0434\u0435, \u043F\u043E\u043A\u0430\u0447\u0430\u043B
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439: \u043E\u043D \u0437\u0430\u043C\u0435\u0442\u0438\u043B
      \u043C\u0443\u0442\u043D\u044B\u0439 \u043D\u0430\u043B\u0451\u0442 \u0435\u0449\u0451
      \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0432\u0441\u0435
      \u043D\u0430\u043F\u0438\u043B\u0438\u0441\u044C. \u0422\u0435\u043C, \u043A\u0442\u043E
      \u0443\u0441\u043F\u0435\u043B \u0433\u043B\u043E\u0442\u043D\u0443\u0442\u044C,
      \u043E\u043D \u0434\u0430\u043B \u0440\u0432\u043E\u0442\u043D\u044B\u0439
      \u043F\u043E\u0440\u043E\u0448\u043E\u043A \u0438 \u043E\u0442\u0432\u0430\u0440
      \u0438\u0437 \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
      \u0437\u0430\u043F\u0430\u0441\u043E\u0432. \u041A \u0443\u0442\u0440\u0443
      \u0432\u0441\u0435 \u0431\u044B\u043B\u0438 \u043D\u0430 \u043D\u043E\u0433\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758687
    m_Localized: "\u0423\u043A\u0443\u0441 \u0437\u043C\u0435\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707533758688
    m_Localized: "\u041D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435 \u043E\u0434\u0438\u043D
      \u0438\u0437 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u043E\u0432
      \u0432\u0441\u043A\u0440\u0438\u043A\u043D\u0443\u043B \u0438 \u043E\u0442\u043F\u0440\u044F\u043D\u0443\u043B
      \u043E\u0442 \u043F\u043E\u043B\u0435\u043D\u043D\u0438\u0446\u044B. \u041D\u0430
      \u0440\u0443\u043A\u0435 - \u0434\u0432\u0435 \u0430\u043B\u044B\u0445 \u0442\u043E\u0447\u043A\u0438
      \u0443\u043A\u0443\u0441\u0430. \u0418\u0437-\u043F\u043E\u0434 \u0445\u0432\u043E\u0440\u043E\u0441\u0442\u0430
      \u0432\u044B\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0430 \u0437\u043C\u0435\u044F
      \u0438 \u0438\u0441\u0447\u0435\u0437\u043B\u0430 \u0432 \u0442\u0440\u0430\u0432\u0435.
      \u0420\u0443\u043A\u0430 \u0431\u044B\u0441\u0442\u0440\u043E \u043E\u043F\u0443\u0445\u0430\u0435\u0442,
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0431\u043B\u0435\u0434\u043D\u0435\u0435\u0442.
      \u0411\u0435\u0437 \u043F\u043E\u043C\u043E\u0449\u0438 \u043E\u043D \u043C\u043E\u0436\u0435\u0442
      \u043B\u0438\u0448\u0438\u0442\u044C\u0441\u044F \u0440\u0443\u043A\u0438 \u0438\u043B\u0438
      \u0436\u0438\u0437\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147072
    m_Localized: "\u041F\u0435\u0440\u0435\u0442\u044F\u043D\u0443\u0442\u044C \u0438
      \u043D\u0430\u0434\u0435\u044F\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147073
    m_Localized: "\u0420\u0443\u043A\u0443 \u043F\u0435\u0440\u0435\u0442\u044F\u043D\u0443\u043B\u0438
      \u0440\u0435\u043C\u043D\u0451\u043C, \u0440\u0430\u043D\u0443 \u043F\u0440\u043E\u043C\u044B\u043B\u0438.
      \u0427\u0435\u043B\u043E\u0432\u0435\u043A \u0442\u0440\u044F\u0441\u0441\u044F
      \u0432\u0441\u044E \u043D\u043E\u0447\u044C \u0432 \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0435.
      \u041A \u0443\u0442\u0440\u0443 \u043E\u043F\u0443\u0445\u043E\u043B\u044C
      \u043D\u0435 \u0441\u043F\u0430\u043B\u0430, \u043D\u043E \u044F\u0434, \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u043D\u0435 \u043F\u043E\u0448\u0451\u043B \u0434\u0430\u043B\u044C\u0448\u0435.
      \u0418\u0434\u0442\u0438 \u043E\u043D \u043D\u0435 \u043C\u043E\u0436\u0435\u0442
      - \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0443\u043B\u043E\u0436\u0438\u0442\u044C
      \u043D\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0443 \u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u043D\u0430 \u0443\u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147074
    m_Localized: "\u0412\u044B\u0441\u043E\u0441\u0430\u0442\u044C \u044F\u0434 \u0438
      \u043F\u0440\u0438\u0436\u0435\u0447\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147075
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0441\u043F\u043E\u0441\u043E\u0431
      - \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0439, \u043D\u043E
      \u0438\u043D\u043E\u0433\u043E \u043D\u0435\u0442. \u042F\u0434 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
      \u0432\u044B\u0448\u0435\u043B, \u0440\u0430\u043D\u0443 \u043F\u0440\u0438\u0436\u0433\u043B\u0438
      \u0440\u0430\u0441\u043A\u0430\u043B\u0451\u043D\u043D\u044B\u043C \u043D\u043E\u0436\u043E\u043C.
      \u0427\u0435\u043B\u043E\u0432\u0435\u043A \u043F\u043E\u0442\u0435\u0440\u044F\u043B
      \u0441\u043E\u0437\u043D\u0430\u043D\u0438\u0435 \u043E\u0442 \u0431\u043E\u043B\u0438,
      \u043D\u043E \u043A \u0443\u0442\u0440\u0443 \u0436\u0430\u0440 \u043D\u0430\u0447\u0430\u043B
      \u0441\u043F\u0430\u0434\u0430\u0442\u044C. \u0428\u0440\u0430\u043C \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F
      \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147076
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0437\u043D\u0430\u0435\u0442
      \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u044F\u0434\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147077
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0431\u0440\u043E\u0441\u0438\u043B
      \u043E\u0434\u0438\u043D \u0432\u0437\u0433\u043B\u044F\u0434 \u043D\u0430
      \u0441\u043B\u0435\u0434\u044B \u0437\u0443\u0431\u043E\u0432. \xAB\u0429\u0438\u0442\u043E\u043C\u043E\u0440\u0434\u043D\u0438\u043A.
      \u041D\u0435 \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0435\u0441\u043B\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0431\u044B\u0441\u0442\u0440\u043E.\xBB \u041E\u043D \u0432\u0441\u043A\u0440\u044B\u043B
      \u0441\u0432\u043E\u0439 \u0441\u0443\u043D\u0434\u0443\u0447\u043E\u043A,
      \u043D\u0430\u043B\u043E\u0436\u0438\u043B \u043F\u0440\u0438\u043F\u0430\u0440\u043A\u0443
      \u0438\u0437 \u0442\u0451\u043C\u043D\u043E\u0439 \u043F\u0430\u0441\u0442\u044B
      \u0438 \u0434\u0430\u043B \u0432\u044B\u043F\u0438\u0442\u044C \u0433\u043E\u0440\u044C\u043A\u0438\u0439
      \u043E\u0442\u0432\u0430\u0440. \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441
      \u043E\u043F\u0443\u0445\u043E\u043B\u044C \u043D\u0430\u0447\u0430\u043B\u0430
      \u0441\u043F\u0430\u0434\u0430\u0442\u044C. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0443\u043A\u0443\u0448\u0435\u043D\u043D\u044B\u0439 \u0443\u0436\u0435 \u0441\u0438\u0434\u0435\u043B
      \u0443 \u043A\u043E\u0441\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147078
    m_Localized: "\u0418\u043D\u043E\u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0445\u043E\u0447\u0435\u0442 \u043E\u0431\u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147079
    m_Localized: "\u041D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F
      \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u043E\u0434 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u044B\u043C\u0438
      \u0432\u044B\u043C\u043F\u0435\u043B\u0430\u043C\u0438. \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0435
      \u043A\u0443\u043F\u0446\u044B \u0432 \u0440\u0430\u0441\u0448\u0438\u0442\u044B\u0445
      \u0445\u0430\u043B\u0430\u0442\u0430\u0445 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0442
      \u0440\u0443\u043A\u0443 \u0432 \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438
      \u0438 \u0447\u0442\u043E-\u0442\u043E \u043A\u0440\u0438\u0447\u0430\u0442,
      \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u044F \u043D\u0430 \u0441\u0432\u043E\u0438
      \u0442\u044E\u043A\u0438. \u0418\u0445 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043D\u0430\u0432\u044C\u044E\u0447\u0435\u043D\u044B \u0442\u043A\u0430\u043D\u044F\u043C\u0438,
      \u0432\u0438\u0434\u043D\u043E, \u0447\u0442\u043E \u0442\u043E\u0432\u0430\u0440
      \u0434\u043E\u0431\u0440\u043E\u0442\u043D\u044B\u0439. \u0421\u0442\u0430\u0440\u0448\u0438\u0439
      \u043A\u0443\u043F\u0435\u0446 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0441\u0432\u043E\u0451\u043C \u044F\u0437\u044B\u043A\u0435.\r\n\r\n<npc_speech
      lang=\"Sogdian\">\u0420\u0430\u0434\u044B \u0432\u0441\u0442\u0440\u0435\u0447\u0435!
      \u041C\u044B \u0445\u043E\u0442\u0438\u043C \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C.
      \u0422\u043A\u0430\u043D\u0438 \u0432 \u043E\u0431\u043C\u0435\u043D \u043D\u0430
      \u0448\u0451\u043B\u043A - \u0441\u043E\u0433\u043B\u0430\u0441\u043D\u044B?</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147080
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C \u0436\u0435\u0441\u0442\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147081
    m_Localized: "\u042F\u0437\u044B\u043A\u043E\u0432\u043E\u0439 \u0431\u0430\u0440\u044C\u0435\u0440
      \u043D\u0435 \u043F\u043E\u043C\u0435\u0445\u0430 \u043E\u043F\u044B\u0442\u043D\u043E\u043C\u0443
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0443. \u041F\u0430\u043B\u044C\u0446\u0430\u043C\u0438,
      \u043A\u0438\u0432\u043A\u0430\u043C\u0438 \u0438 \u0440\u043E\u0441\u0441\u044B\u043F\u044C\u044E
      \u043C\u043E\u043D\u0435\u0442 \u043D\u0430 \u043B\u0430\u0434\u043E\u043D\u0438
      \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u043E \u0432\u044B\u0433\u043E\u0434\u043D\u043E\u043C \u043E\u0431\u043C\u0435\u043D\u0435.
      \u0421\u043E\u0433\u0434\u0438\u0439\u0446\u044B \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B, \u0430 \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435
      \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C \u043E\u0442\u0440\u0435\u0437\u044B
      \u043E\u0442\u043B\u0438\u0447\u043D\u043E\u0439 \u043F\u0430\u0440\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147082
    m_Localized: "\u0411\u0435\u0437 \u0441\u043B\u043E\u0432 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044F
      \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C \u043F\u0443\u0442\u0430\u043D\u0438\u0446\u0435\u0439.
      \u0416\u0435\u0441\u0442\u044B \u0431\u044B\u043B\u0438 \u043F\u043E\u043D\u044F\u0442\u044B
      \u043D\u0435\u0432\u0435\u0440\u043D\u043E, \u043E\u0431\u043C\u0435\u043D
      \u0432\u044B\u0448\u0435\u043B \u0432 \u0443\u0431\u044B\u0442\u043E\u043A.
      \u0421\u043E\u0433\u0434\u0438\u0439\u0446\u044B \u0443\u0434\u0430\u043B\u0438\u043B\u0438\u0441\u044C
      \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u043C\u0438, \u0430 \u0443
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
      \u0433\u043E\u0440\u044C\u043A\u043E\u0435 \u043F\u043E\u0441\u043B\u0435\u0432\u043A\u0443\u0441\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147083
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043E\u0442
      \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147084
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u0435\u0436\u043B\u0438\u0432\u043E
      \u043F\u043E\u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u043E\u0432\u0430\u043B
      \u0441\u043E\u0433\u0434\u0438\u0439\u0446\u0435\u0432 \u0438 \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435. \u0418\u043D\u043E\u0433\u0434\u0430
      \u043B\u0443\u0447\u0448\u0435 \u043D\u0435 \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C,
      \u0442\u043E\u0440\u0433\u0443\u044F \u0441 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0446\u0430\u043C\u0438
      \u0431\u0435\u0437 \u043E\u0431\u0449\u0435\u0433\u043E \u044F\u0437\u044B\u043A\u0430.
      \u041A\u0443\u043F\u0446\u044B \u043F\u043E\u0436\u0430\u043B\u0438 \u043F\u043B\u0435\u0447\u0430\u043C\u0438
      \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0438 \u0441\u0432\u043E\u0439
      \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147085
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147086
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u044B\u0448\u0435\u043B
      \u0432\u043F\u0435\u0440\u0451\u0434 \u0438 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0441 \u043A\u0443\u043F\u0446\u0430\u043C\u0438 \u043D\u0430 \u0431\u0435\u0433\u043B\u043E\u043C
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C: <npc_speech lang=\"Sogdian\">\u041F\u0440\u0438\u0432\u0435\u0442,
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B! \u041C\u044B \u0440\u0430\u0434\u044B
      \u0432\u0441\u0442\u0440\u0435\u0447\u0435. \u041F\u043E\u043A\u0430\u0436\u0438\u0442\u0435
      \u0442\u043E\u0432\u0430\u0440 - \u043E\u0431\u0441\u0443\u0434\u0438\u043C
      \u043E\u0431\u043C\u0435\u043D.</npc_speech> \u041B\u0438\u0446\u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432
      \u0440\u0430\u0441\u0446\u0432\u0435\u043B\u0438: \u043D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E
      \u043C\u043E\u0436\u043D\u043E \u043E\u0431\u0441\u0443\u0434\u0438\u0442\u044C
      \u0434\u0435\u043B\u043E \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443.
      \u0421\u0434\u0435\u043B\u043A\u0430 \u0432\u044B\u0448\u043B\u0430 \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u043D\u0430\u044F:
      \u043F\u043E\u043C\u0438\u043C\u043E \u043C\u043E\u043D\u0435\u0442, \u0441\u043E\u0433\u0434\u0438\u0439\u0446\u044B
      \u043F\u043E\u0434\u0430\u0440\u0438\u043B\u0438 \u043E\u0442\u0440\u0435\u0437
      \u043F\u0430\u0440\u0447\u0438 \u043A\u0430\u043A \u0437\u043D\u0430\u043A
      \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F \u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443,
      \u0437\u043D\u0430\u044E\u0449\u0435\u043C\u0443 \u0438\u0445 \u044F\u0437\u044B\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147087
    m_Localized: "\u041D\u0430\u0434\u043F\u0438\u0441\u0438 \u043D\u0430 \u0440\u0443\u0438\u043D\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147088
    m_Localized: "\u0412 \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u043E\u0442
      \u0434\u043E\u0440\u043E\u0433\u0438  \u0440\u0443\u0438\u043D\u044B \u0437\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u043E\u0433\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u044F.
      \u0421\u0442\u0435\u043D\u044B \u043E\u043F\u043B\u044B\u043B\u0438 \u043E\u0442
      \u0434\u043E\u0436\u0434\u0435\u0439, \u043A\u0440\u044B\u0448\u0430 \u0434\u0430\u0432\u043D\u043E
      \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0430\u0441\u044C. \u041D\u0430
      \u0443\u0446\u0435\u043B\u0435\u0432\u0448\u0435\u043C \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u043C
      \u0441\u0442\u043E\u043B\u0431\u0435 \u0432\u044B\u0441\u0435\u0447\u0435\u043D\u044B
      \u0441\u0442\u0440\u043E\u043A\u0438: \u043F\u043E\u043B\u0443\u0441\u0442\u0451\u0440\u0442\u044B\u0435,
      \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u044F\u0437\u044B\u043A\u0430\u0445.
      \u0421\u0440\u0435\u0434\u0438 \u043D\u0438\u0445 \u0443\u0433\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0447\u0442\u043E-\u0442\u043E \u043F\u043E\u0445\u043E\u0436\u0435\u0435
      \u043D\u0430 \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u0435: \u0441\u0442\u0440\u0435\u043B\u043A\u0430,
      \u0446\u0438\u0444\u0440\u044B, \u0441\u043B\u043E\u0432\u043E, \u043F\u043E\u0445\u043E\u0436\u0435\u0435
      \u043D\u0430 \xAB\u0441\u0435\u0440\u0435\u0431\u0440\u043E\xBB \u0438\u043B\u0438
      \xAB\u0442\u0430\u0439\u043D\u0438\u043A\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147089
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0440\u0443\u0438\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147090
    m_Localized: "\u0414\u0432\u0430 \u0447\u0430\u0441\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u043B\u0438 \u043A\u0430\u043C\u043D\u0438
      \u0438 \u0440\u044B\u043B\u0438\u0441\u044C \u0432 \u043E\u0431\u043B\u043E\u043C\u043A\u0430\u0445.
      \u041D\u0430\u0448\u043B\u0438 \u043F\u0430\u0440\u0443 \u0447\u0435\u0440\u0435\u043F\u043A\u043E\u0432
      \u0438 \u0440\u0436\u0430\u0432\u044B\u0439 \u043D\u043E\u0436: \u043D\u0438\u0447\u0435\u0433\u043E
      \u0446\u0435\u043D\u043D\u043E\u0433\u043E. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0432\u0440\u0435\u043C\u044F \u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u043D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435. \u041D\u0430\u0434\u043F\u0438\u0441\u044C,
      \u0432\u0438\u0434\u0438\u043C\u043E, \u0434\u0430\u0432\u043D\u043E \u0443\u0442\u0440\u0430\u0442\u0438\u043B\u0430
      \u0430\u043A\u0442\u0443\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147091
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C
      \u043D\u0430\u0434\u043F\u0438\u0441\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147092
    m_Localized: "\u0411\u0443\u043A\u0432\u044B \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0435,
      \u044F\u0437\u044B\u043A \u0447\u0443\u0436\u043E\u0439. \u0421\u043A\u043E\u043B\u044C\u043A\u043E
      \u043D\u0438 \u0432\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0439\u0441\u044F,
      \u0431\u0435\u0437 \u0437\u043D\u0430\u043D\u0438\u044F \u044F\u0437\u044B\u043A\u0430
      \u043D\u0430\u0434\u043F\u0438\u0441\u044C \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043D\u0430\u0431\u043E\u0440\u043E\u043C \u0431\u0435\u0441\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u044B\u0445
      \u0437\u0430\u043A\u043E\u0440\u044E\u0447\u0435\u043A. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0432\u0440\u0435\u043C\u044F \u0438
      \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435
      \u0441 \u043B\u0451\u0433\u043A\u0438\u043C \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147093
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430\u0434\u043F\u0438\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147094
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u043E\u0434\u0438\u043B
      \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u043F\u043E \u043A\u0430\u043C\u043D\u044E,
      \u0448\u0435\u0432\u0435\u043B\u044F \u0433\u0443\u0431\u0430\u043C\u0438.
      \xAB\u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439, \u043E\u0447\u0435\u043D\u044C
      \u0441\u0442\u0430\u0440\u044B\u0439. \"\u0422\u0440\u0438 \u0448\u0430\u0433\u0430
      \u043E\u0442 \u0441\u0442\u043E\u043B\u0431\u0430 \u043D\u0430 \u0437\u0430\u043A\u0430\u0442,
      \u043F\u043E\u0434 \u043F\u043B\u043E\u0441\u043A\u0438\u043C \u043A\u0430\u043C\u043D\u0435\u043C
      - \u0434\u0430\u0440 \u043F\u0443\u0442\u043D\u0438\u043A\u0443.\"\xBB \u041F\u043E\u0434
      \u0443\u043A\u0430\u0437\u0430\u043D\u043D\u044B\u043C \u043A\u0430\u043C\u043D\u0435\u043C
      \u043D\u0430\u0448\u0451\u043B\u0441\u044F \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A: \u0433\u043E\u0440\u0441\u0442\u044C
      \u043C\u043E\u043D\u0435\u0442 \u0438 \u043A\u0443\u0441\u043E\u043A \u043B\u0430\u0437\u0443\u0440\u0438\u0442\u0430,
      \u0437\u0430\u0432\u0451\u0440\u043D\u0443\u0442\u044B\u0439 \u0432 \u043F\u0440\u043E\u043C\u0430\u0441\u043B\u0435\u043D\u043D\u0443\u044E
      \u0442\u043A\u0430\u043D\u044C. \u0421\u0442\u043E\u043B\u0435\u0442\u0438\u044F
      \u043F\u0440\u043E\u0448\u043B\u0438, \u0430 \u0442\u0430\u0439\u043D\u0438\u043A
      \u0446\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147095
    m_Localized: "\u041F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0434\u0435\u0448\u0451\u0432\u044B\u0439 \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147096
    m_Localized: "\u0423 \u0434\u043E\u0440\u043E\u0433\u0438 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0441\u044F
      \u043E\u0434\u0438\u043D\u043E\u043A\u0438\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0441 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0439 \u043F\u043E\u0432\u043E\u0437\u043A\u043E\u0439.
      \u041E\u043D \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0448\u0451\u043B\u043A
      \u043F\u043E \u0446\u0435\u043D\u0435 \u0432\u0442\u0440\u043E\u0435 \u043D\u0438\u0436\u0435
      \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439. \u0422\u043A\u0430\u043D\u044C
      \u043D\u0430 \u0432\u0438\u0434 \u0445\u043E\u0440\u043E\u0448\u0430: \u043F\u043B\u043E\u0442\u043D\u0430\u044F,
      \u0441 \u0431\u043B\u0435\u0441\u043A\u043E\u043C. \u041D\u043E \u043F\u043E\u0447\u0435\u043C\u0443
      \u0442\u0430\u043A \u0434\u0451\u0448\u0435\u0432\u043E? \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0448\u0438\u0440\u043E\u043A\u043E, \u043E\u0442\u0432\u043E\u0434\u0438\u0442
      \u0433\u043B\u0430\u0437\u0430 \u0438 \u0442\u043E\u0440\u043E\u043F\u0438\u0442
      \u0441\u0434\u0435\u043B\u043A\u0443. \u0427\u0442\u043E-\u0442\u043E \u0437\u0434\u0435\u0441\u044C
      \u043D\u0435 \u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147097
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147098
    m_Localized: "\u0428\u0451\u043B\u043A \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u043E\u0439: \u0442\u043E\u043D\u043A\u0438\u0439
      \u0441\u043B\u043E\u0439 \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u0442\u043A\u0430\u043D\u0438
      \u043F\u043E\u0432\u0435\u0440\u0445 \u0433\u0440\u0443\u0431\u043E\u0433\u043E
      \u0445\u043E\u043B\u0441\u0442\u0430. \u041E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u043E\u0441\u044C
      \u044D\u0442\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u043F\u0440\u0438\u0432\u0430\u043B\u0435, \u043A\u043E\u0433\u0434\u0430
      \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0438 \u0442\u044E\u043A
      \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0434\u0430\u0432\u043D\u043E \u0441\u043A\u0440\u044B\u043B\u0441\u044F.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B,
      \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u0438\u0441\u043F\u043E\u0440\u0447\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147099
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0442\u043E\u0432\u0430\u0440
      \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147100
    m_Localized: "\u041D\u0430\u043C\u0451\u0442\u0430\u043D\u043D\u044B\u0439 \u0433\u043B\u0430\u0437
      \u0441\u0440\u0430\u0437\u0443 \u0437\u0430\u043C\u0435\u0442\u0438\u043B:
      \u043D\u0438\u0442\u0438 \u043E\u0441\u043D\u043E\u0432\u044B \u0434\u0440\u0443\u0433\u043E\u0433\u043E
      \u0446\u0432\u0435\u0442\u0430, \u043A\u0440\u0430\u0439 \u0442\u044E\u043A\u0430
      \u043F\u043E\u0434\u0448\u0438\u0442 \u0437\u0430\u043D\u043E\u0432\u043E.
      \u041F\u043E\u0434\u0434\u0435\u043B\u043A\u0430. \u0422\u043E\u0440\u0433\u043E\u0432\u0446\u0443
      \u0442\u043A\u043D\u0443\u043B\u0438 \u043F\u0430\u043B\u044C\u0446\u0435\u043C
      \u0432 \u043E\u0431\u043C\u0430\u043D: \u043E\u043D \u043F\u043E\u0431\u043B\u0435\u0434\u043D\u0435\u043B
      \u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
      \u0442\u043E\u0432\u0430\u0440 \u043F\u043E \u0447\u0435\u0441\u0442\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435, \u043B\u0438\u0448\u044C \u0431\u044B \u043D\u0435
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u044C \u0448\u0443\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147101
    m_Localized: "\u0422\u043E\u0432\u0430\u0440 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438,
      \u043D\u043E \u043F\u043E\u0434\u0432\u043E\u0445\u0430 \u043D\u0435 \u043D\u0430\u0448\u043B\u0438:
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0438\u0441\u043A\u0443\u0441\u043D\u0430\u044F
      \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0430. \u041A\u0443\u043F\u0438\u043B\u0438
      \u0438 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438 \u043E\u0431\u043C\u0430\u043D
      \u043B\u0438\u0448\u044C \u0447\u0435\u0440\u0435\u0437 \u0434\u0435\u043D\u044C.
      \u041E\u0431\u0438\u0434\u043D\u043E \u0432\u0434\u0432\u043E\u0439\u043D\u0435:
      \u0432\u0435\u0434\u044C \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147102
    m_Localized: "\u041A\u0443\u043F\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u0440\u0430\u0441\u043F\u043E\u0437\u043D\u0430\u0451\u0442 \u043E\u0431\u043C\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147103
    m_Localized: "\u0421\u043F\u0443\u0442\u043D\u0438\u043A-\u043A\u0443\u043F\u0435\u0446
      \u0432\u0437\u044F\u043B \u0442\u043A\u0430\u043D\u044C, \u043F\u043E\u0442\u0451\u0440
      \u043C\u0435\u0436\u0434\u0443 \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438
      \u0438 \u043C\u043E\u043B\u0447\u0430 \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B
      \u0442\u044E\u043A \u0434\u043E \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u044B.
      \u0413\u0440\u0443\u0431\u044B\u0439 \u0445\u043E\u043B\u0441\u0442 \u0432\u044B\u0433\u043B\u044F\u043D\u0443\u043B
      \u043D\u0430\u0440\u0443\u0436\u0443. \xAB\u0421\u0442\u0430\u0440\u044B\u0439
      \u0442\u0440\u044E\u043A. \u042F \u0442\u0430\u043A\u0438\u0445 \u0434\u0435\u0441\u044F\u0442\u043A\u0438
      \u0432\u0438\u0434\u0435\u043B.\xBB \u041C\u043E\u0448\u0435\u043D\u043D\u0438\u043A
      \u0431\u0440\u043E\u0441\u0438\u043B \u043F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0438 \u0443\u0431\u0435\u0436\u0430\u043B. \u0412 \u043F\u043E\u0432\u043E\u0437\u043A\u0435
      \u043D\u0430\u0448\u0451\u043B\u0441\u044F \u0447\u0435\u0441\u0442\u043D\u044B\u0439
      \u0442\u043E\u0432\u0430\u0440, \u043F\u0440\u0438\u043F\u0440\u044F\u0442\u0430\u043D\u043D\u044B\u0439
      \u0434\u043B\u044F \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0445 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147104
    m_Localized: "\u041C\u043E\u043D\u043E\u043F\u043E\u043B\u0438\u0441\u0442 \u0437\u0430\u0434\u0438\u0440\u0430\u0435\u0442
      \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147105
    m_Localized: "\u041D\u0430 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439
      \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0435 \u0447\u0435\u0440\u0435\u0437
      \u0440\u0435\u043A\u0443 \u0445\u043E\u0437\u044F\u0439\u043D\u0438\u0447\u0430\u0435\u0442
      \u0442\u043E\u043B\u0441\u0442\u044B\u0439 \u043A\u0443\u043F\u0435\u0446 \u0441
      \u043E\u0445\u0440\u0430\u043D\u043E\u0439. \u041F\u0430\u0440\u043E\u043C
      - \u0435\u0433\u043E, \u0438 \u0446\u0435\u043D\u0443 \u043E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0442\u0430\u043A\u0443\u044E, \u0447\u0442\u043E \u0445\u0432\u0430\u0442\u0438\u043B\u043E
      \u0431\u044B \u043D\u0430 \u0442\u0440\u0438 \u043F\u0430\u0440\u043E\u043C\u0430.
      \u0414\u0440\u0443\u0433\u0438\u0445 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432
      \u043D\u0435\u0442 \u043D\u0430 \u0434\u0435\u043D\u044C \u043F\u0443\u0442\u0438.
      \u041A\u0443\u043F\u0435\u0446 \u0437\u043D\u0430\u0435\u0442 \u0441\u0432\u043E\u044E
      \u0441\u0438\u043B\u0443 \u0438 \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u0441\u044F
      - \u043C\u043E\u0436\u0435\u0442\u0435 \u0436\u0434\u0430\u0442\u044C, \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043E\u043D, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0445\u043E\u0442\u0438\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147106
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043F\u043E\u043B\u043D\u0443\u044E
      \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147107
    m_Localized: "\u0421\u043A\u0440\u0438\u043F\u044F \u0437\u0443\u0431\u0430\u043C\u0438,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B.
      \u041A\u0443\u043F\u0435\u0446 \u043F\u0440\u0438\u043D\u044F\u043B \u043C\u043E\u043D\u0435\u0442\u044B
      \u0441 \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0439 \u0443\u043B\u044B\u0431\u043A\u043E\u0439
      \u0438 \u0432\u0435\u043B\u0435\u043B \u0433\u0440\u0443\u0437\u0438\u0442\u044C
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043D\u0430 \u043F\u0430\u0440\u043E\u043C.
      \u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430 \u043F\u0440\u043E\u0448\u043B\u0430
      \u0431\u044B\u0441\u0442\u0440\u043E, \u043D\u043E \u0433\u043E\u0440\u0435\u0447\u044C
      \u043E\u0442 \u0433\u0440\u0430\u0431\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u043E\u0439
      \u0446\u0435\u043D\u044B \u043D\u0435 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u043B\u0430
      \u0434\u043E \u0441\u0430\u043C\u043E\u0433\u043E \u0432\u0435\u0447\u0435\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147108
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147109
    m_Localized: "\u0414\u043E\u043B\u0433\u0438\u0439, \u0438\u0437\u043C\u0430\u0442\u044B\u0432\u0430\u044E\u0449\u0438\u0439
      \u0442\u043E\u0440\u0433. \u041D\u043E \u043A\u043E\u0433\u0434\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A
      \u0443\u043F\u043E\u043C\u044F\u043D\u0443\u043B, \u0447\u0442\u043E \u0437\u043D\u0430\u0435\u0442
      \u0434\u0440\u0443\u0433\u0443\u044E \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0443
      \u0432 \u043F\u043E\u043B\u0443\u0434\u043D\u0435 \u043F\u0443\u0442\u0438
      - \u043A\u0443\u043F\u0435\u0446 \u0434\u0440\u043E\u0433\u043D\u0443\u043B.
      \u0411\u043B\u0435\u0444 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B:
      \u0446\u0435\u043D\u0430 \u0443\u043F\u0430\u043B\u0430 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0447\u0435\u043C \u0432\u0434\u0432\u043E\u0435. \u041F\u0430\u0440\u043E\u043C
      \u043E\u0442\u0447\u0430\u043B\u0438\u043B \u043F\u043E\u0434 \u0437\u043B\u043E\u0431\u043D\u043E\u0435
      \u0431\u0443\u0440\u0447\u0430\u043D\u0438\u0435 \u0445\u043E\u0437\u044F\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147110
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u043D\u0435 \u0443\u0441\u0442\u0443\u043F\u0438\u043B
      \u043D\u0438 \u043C\u043E\u043D\u0435\u0442\u044B. \u0425\u0443\u0436\u0435
      \u0442\u043E\u0433\u043E - \u0437\u0430 \xAB\u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F\xBB \u043D\u0430\u043A\u0438\u043D\u0443\u043B
      \u0441\u0432\u0435\u0440\u0445\u0443. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0435\u0449\u0451 \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043F\u0440\u043E\u0441\u0438\u043B\u0438 \u0438\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E.
      \u0423\u043D\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147111
    m_Localized: "\u041A\u0443\u043F\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u0437\u043D\u0430\u0435\u0442 \u043E\u0431\u0445\u043E\u0434\u043D\u043E\u0439
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147112
    m_Localized: "\u0421\u043F\u0443\u0442\u043D\u0438\u043A-\u043A\u0443\u043F\u0435\u0446
      \u043E\u0442\u0432\u0451\u043B \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0430
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443. \xAB\u042F \u0437\u043D\u0430\u044E
      \u044D\u0442\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.
      \u0416\u0430\u0434\u0435\u043D, \u043D\u043E \u0442\u0440\u0443\u0441\u043B\u0438\u0432.
      \u0421\u043A\u0430\u0436\u0438, \u0447\u0442\u043E \u043C\u044B \u0438\u0437
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0447\u0430\u043D\u044A\u0430\u043D\u044C\u0441\u043A\u043E\u0433\u043E
      \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u0430. \u041E\u043D
      \u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0442 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C.\xBB
      \u041C\u043E\u043D\u043E\u043F\u043E\u043B\u0438\u0441\u0442 \u043F\u043E\u0431\u043B\u0435\u0434\u043D\u0435\u043B
      \u0438 \u0441\u0431\u0440\u043E\u0441\u0438\u043B \u0446\u0435\u043D\u0443
      \u0434\u043E \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u043E\u0439.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F
      \u043F\u043E\u0447\u0442\u0438 \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147113
    m_Localized: "\u041F\u043E\u043F\u0443\u0442\u043D\u044B\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147114
    m_Localized: "\u041D\u0430 \u0448\u0438\u0440\u043E\u043A\u043E\u043C \u0443\u0447\u0430\u0441\u0442\u043A\u0435
      \u0434\u043E\u0440\u043E\u0433\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043D\u0430\u0433\u043D\u0430\u043B \u0434\u0440\u0443\u0433\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043E\u0431\u043E\u0437 - \u043F\u043E\u0432\u043E\u0437\u043A\u0438, \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B,
      \u0434\u0435\u0441\u044F\u0442\u043E\u043A \u043B\u044E\u0434\u0435\u0439.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u043A\u0443\u043F\u0435\u0446 \u043F\u0440\u0438\u0432\u0435\u0442\u043B\u0438\u0432\u043E
      \u043C\u0430\u0448\u0435\u0442 \u0440\u0443\u043A\u043E\u0439 \u0438 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
      \u0440\u0430\u0437\u0431\u0438\u0442\u044C \u043E\u0431\u0449\u0438\u0439 \u043B\u0430\u0433\u0435\u0440\u044C.
      \u0423 \u043D\u0438\u0445 \u0441\u0432\u0435\u0436\u0438\u0435 \u043D\u043E\u0432\u043E\u0441\u0442\u0438
      \u0441 \u0432\u043E\u0441\u0442\u043E\u043A\u0430: \u043A\u0430\u043A\u0438\u0435
      \u0434\u043E\u0440\u043E\u0433\u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B,
      \u0433\u0434\u0435 \u043F\u043E\u0434\u043D\u044F\u043B\u0438\u0441\u044C \u0446\u0435\u043D\u044B,
      \u0433\u0434\u0435 \u043E\u0431\u044A\u044F\u0432\u043B\u0435\u043D \u043A\u0430\u0440\u0430\u043D\u0442\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147115
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u0442\u044C \u043E\u0431\u0449\u0438\u0439
      \u043B\u0430\u0433\u0435\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147116
    m_Localized: "\u0412\u0435\u0447\u0435\u0440 \u0437\u0430 \u043E\u0431\u0449\u0438\u043C
      \u043A\u043E\u0441\u0442\u0440\u043E\u043C, \u043E\u0431\u043C\u0435\u043D
      \u043D\u043E\u0432\u043E\u0441\u0442\u044F\u043C\u0438 \u0438 \u0431\u0430\u0439\u043A\u0430\u043C\u0438.
      \u041B\u044E\u0434\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u043F\u043E\u0432\u0435\u0441\u0435\u043B\u0435\u043B\u0438
      - \u043F\u0440\u0438\u044F\u0442\u043D\u043E \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C
      \u0441\u0432\u043E\u0438\u0445 \u043D\u0430 \u0447\u0443\u0436\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0435. \u0423\u0434\u0432\u043E\u0435\u043D\u043D\u0430\u044F
      \u0441\u0442\u0440\u0430\u0436\u0430 \u043D\u043E\u0447\u044C\u044E \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B\u0430
      \u0432\u0441\u0435\u043C \u0432\u044B\u0441\u043F\u0430\u0442\u044C\u0441\u044F.
      \u041D\u0430\u0443\u0442\u0440\u043E \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C,
      \u043F\u043E\u0436\u0435\u043B\u0430\u0432 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0443
      \u0443\u0434\u0430\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147117
    m_Localized: "\u041E\u0431\u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F\u043C\u0438
      \u0438 \u0438\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147118
    m_Localized: "\u041A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u043D\u0430 \u0445\u043E\u0434\u0443 - \u043D\u043E \u0446\u0435\u043D\u043D\u044B\u0439.
      \u0423\u0437\u043D\u0430\u043B\u0438, \u0447\u0442\u043E \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u0440\u0430\u0437\u043C\u044B\u0442 \u043C\u043E\u0441\u0442, \u0438 \u043C\u043E\u0436\u043D\u043E
      \u0437\u0430\u0440\u0430\u043D\u0435\u0435 \u0441\u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u043D\u0430 \u043E\u0431\u044A\u0435\u0437\u0434. \u0414\u0435\u043B\u044C\u043D\u044B\u0439
      \u0441\u043E\u0432\u0435\u0442 \u0441\u0442\u043E\u0438\u0442 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u043E\u0447\u0451\u0432\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147119
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043D\u0435\u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0447\u0438\u0432
      - \u043E\u0442\u0432\u0435\u0442\u0438\u043B \u043F\u0430\u0440\u043E\u0439
      \u043E\u0431\u0449\u0438\u0445 \u0444\u0440\u0430\u0437 \u0438 \u0443\u0441\u043A\u043E\u0440\u0438\u043B
      \u0448\u0430\u0433. \u041D\u0438\u0447\u0435\u0433\u043E \u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0433\u043E
      \u0443\u0437\u043D\u0430\u0442\u044C \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C,
      \u043D\u043E \u0445\u043E\u0442\u044C \u043F\u043E\u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438
      \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147120
    m_Localized: "\u0412\u043E\u0435\u043D\u043D\u044B\u0439 \u043E\u0442\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147121
    m_Localized: "\u0418\u0437-\u0437\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430
      \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043A\u043E\u043D\u043D\u044B\u0439
      \u0440\u0430\u0437\u044A\u0435\u0437\u0434 - \u0434\u044E\u0436\u0438\u043D\u0430
      \u0432\u043E\u0438\u043D\u043E\u0432 \u0432 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0447\u0430\u0442\u044B\u0445
      \u0434\u043E\u0441\u043F\u0435\u0445\u0430\u0445 \u0441 \u043A\u043E\u043F\u044C\u044F\u043C\u0438
      \u043D\u0430\u043F\u0435\u0440\u0435\u0432\u0435\u0441. \u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440
      \u0432 \u0448\u043B\u0435\u043C\u0435 \u0441 \u043A\u0440\u0430\u0441\u043D\u044B\u043C
      \u043F\u043B\u044E\u043C\u0430\u0436\u0435\u043C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0440\u0443\u043A\u0443: \xAB\u0421\u0442\u043E\u0439. \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
      \u043D\u0430 \u0442\u043E\u0432\u0430\u0440.\xBB \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438
      \u043E\u0431\u0441\u0442\u0443\u043F\u0430\u044E\u0442 \u043F\u043E\u0432\u043E\u0437\u043A\u0438,
      \u0437\u0430\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F \u043F\u043E\u0434
      \u043F\u043E\u043B\u043E\u0433. \u041E\u0431\u044B\u0447\u043D\u0430\u044F
      \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 - \u0438\u043B\u0438 \u043F\u043E\u0432\u043E\u0434
      \u0434\u043B\u044F \u0432\u044B\u043C\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147122
    m_Localized: "\u041F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0442\u044C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147123
    m_Localized: "\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435,
      \u043D\u043E \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440 \u043D\u0430\u0448\u0451\u043B
      \xAB\u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0435\xBB: \u043F\u0435\u0447\u0430\u0442\u044C,
      \u044F\u043A\u043E\u0431\u044B, \u043D\u0435\u0447\u0451\u0442\u043A\u0430\u044F.
      \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \xAB\u043F\u043E\u0448\u043B\u0438\u043D\u0443\xBB, \u0447\u0442\u043E\u0431\u044B
      \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F.
      \u0421\u043E\u043B\u0434\u0430\u0442\u044B \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0441 \u0440\u0430\u0432\u043D\u043E\u0434\u0443\u0448\u043D\u044B\u043C\u0438
      \u043B\u0438\u0446\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147124
    m_Localized: "\u0423\u0431\u0435\u0434\u0438\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0430
      \u0432 \u0441\u0432\u043E\u0435\u0439 \u0431\u043B\u0430\u0433\u043E\u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147125
    m_Localized: "\u0423\u0432\u0435\u0440\u0435\u043D\u043D\u0430\u044F \u0440\u0435\u0447\u044C,
      \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445
      \u0438\u043C\u0451\u043D, \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434 - \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440
      \u043A\u0438\u0432\u043D\u0443\u043B. \xAB\u0412\u0438\u0436\u0443, \u0447\u0435\u0441\u0442\u043D\u044B\u0439
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446. \u041F\u0443\u0442\u044C
      \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D.\xBB \u0414\u0430\u0436\u0435
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u043B \u043E \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u0445
      \u0432 \u0434\u0432\u0443\u0445 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430\u0445
      \u043A \u0437\u0430\u043F\u0430\u0434\u0443. \u041F\u043E\u043B\u0435\u0437\u043D\u043E\u0435
      \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147126
    m_Localized: "\u0421\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u043A\u043B\u0430\u0434\u043D\u0430\u044F
      \u0440\u0435\u0447\u044C \u0432\u044B\u0437\u0432\u0430\u043B\u0430 \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0435.
      \xAB\u0427\u0442\u043E \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0448\u044C?\xBB
      \u041E\u0431\u044B\u0441\u043A \u0441\u0442\u0430\u043B \u0434\u043E\u0442\u043E\u0448\u043D\u044B\u043C,
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0432\u0434\u0432\u043E\u0435, \u0447\u0442\u043E\u0431\u044B \u043D\u0435
      \u043A\u043E\u043D\u0444\u0438\u0441\u043A\u043E\u0432\u0430\u043B\u0438 \u0442\u043E\u0432\u0430\u0440.
      \u0421\u043E\u043B\u0434\u0430\u0442\u044B \u0443\u0448\u043B\u0438 \u0441
      \u0443\u0445\u043C\u044B\u043B\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147127
    m_Localized: "\u0420\u0430\u043D\u0435\u043D\u044B\u0439 \u043F\u0443\u0442\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147128
    m_Localized: "\u0423 \u0434\u043E\u0440\u043E\u0433\u0438 \u043B\u0435\u0436\u0438\u0442
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A - \u0445\u0443\u0434\u043E\u0439,
      \u0432 \u0440\u0432\u0430\u043D\u043E\u0439 \u043E\u0434\u0435\u0436\u0434\u0435,
      \u0441 \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043D\u043D\u043E\u0439
      \u0433\u0440\u044F\u0437\u043D\u043E\u0439 \u0442\u0440\u044F\u043F\u043A\u043E\u0439
      \u043D\u043E\u0433\u043E\u0439. \u0420\u0430\u043D\u0430 \u0432\u043E\u0441\u043F\u0430\u043B\u0435\u043D\u0430,
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432 \u043F\u043E\u043B\u0443\u0431\u0440\u0435\u0434\u0443.
      \u0420\u044F\u0434\u043E\u043C - \u043F\u0443\u0441\u0442\u0430\u044F \u0444\u043B\u044F\u0433\u0430
      \u0438 \u043F\u0430\u043B\u043A\u0430, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u043E\u043D \u043E\u043F\u0438\u0440\u0430\u043B\u0441\u044F. \u041D\u0438
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438, \u043D\u0438 \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432.
      \u041E\u043D \u0441\u043B\u0430\u0431\u043E \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0440\u0443\u043A\u0443, \u043F\u0440\u043E\u0441\u044F \u043E \u043F\u043E\u043C\u043E\u0449\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147129
    m_Localized: "\u041F\u043E\u043C\u043E\u0447\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147130
    m_Localized: "\u0420\u0430\u043D\u0435\u043D\u043E\u0433\u043E \u043F\u043E\u0434\u043D\u044F\u043B\u0438,
      \u043D\u0430\u043F\u043E\u0438\u043B\u0438, \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043B\u0438
      \u0447\u0438\u0441\u0442\u043E\u0439 \u0442\u043A\u0430\u043D\u044C\u044E.
      \u041E\u043D \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043C\u0435\u043B\u043A\u0438\u043C
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u043C, \u043E\u0433\u0440\u0430\u0431\u043B\u0435\u043D\u043D\u044B\u043C
      \u0442\u0440\u0438 \u0434\u043D\u044F \u043D\u0430\u0437\u0430\u0434. \u0415\u0434\u044B
      \u0443\u0448\u043B\u043E \u043D\u0435\u043C\u0430\u043B\u043E, \u043D\u043E
      \u043B\u044E\u0434\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438
      \u0441\u0435\u0431\u044F \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E.
      \u041F\u0443\u0442\u043D\u0438\u043A, \u043F\u0440\u0438\u0434\u044F \u0432
      \u0441\u0435\u0431\u044F, \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0438\u043B
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0438 \u0443\u043A\u0430\u0437\u0430\u043B
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0443\u044E \u0442\u0440\u043E\u043F\u0443
      \u043A \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C\u0443 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147131
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147132
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0448\u0451\u043B
      \u043C\u0438\u043C\u043E. \u0427\u0435\u043B\u043E\u0432\u0435\u043A \u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u0432\u0441\u043B\u0435\u0434, \u043F\u043E\u043A\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043D\u0435 \u0441\u043A\u0440\u044B\u043B\u0438\u0441\u044C \u0437\u0430
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u043C. \u041D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B \u043D\u0438 \u0441\u043B\u043E\u0432\u0430,
      \u043D\u043E \u0442\u044F\u0436\u0435\u0441\u0442\u044C \u043B\u0435\u0433\u043B\u0430
      \u043D\u0430 \u0441\u0435\u0440\u0434\u0446\u0435. \u0412\u0435\u0447\u0435\u0440\u043E\u043C
      \u0443 \u043A\u043E\u0441\u0442\u0440\u0430 \u043B\u044E\u0434\u0438 \u043E\u0442\u0432\u043E\u0434\u0438\u043B\u0438
      \u0433\u043B\u0430\u0437\u0430. \u041A\u0430\u0436\u0434\u044B\u0439 \u0434\u0443\u043C\u0430\u043B:
      \u0430 \u0435\u0441\u043B\u0438 \u0437\u0430\u0432\u0442\u0440\u0430 \u0442\u0430\u043A
      \u043E\u043A\u0430\u0436\u0443\u0441\u044C \u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147133
    m_Localized: "\u0421\u0442\u0430\u0440\u0438\u043A \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043A\u0440\u0435\u043F\u043A\u0438\u043C \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0449\u0438\u043A\u043E\u043C
      \u0438 \u043D\u0435 \u0443\u0441\u0442\u0443\u043F\u0438\u043B \u043D\u0438
      \u043C\u043E\u043D\u0435\u0442\u044B. \u0428\u0430\u0444\u0440\u0430\u043D
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439, \u043D\u043E \u043A\u0443\u043F\u043B\u0435\u043D
      \u043F\u043E \u043F\u043E\u043B\u043D\u043E\u0439 \u0446\u0435\u043D\u0435.
      \u041F\u0440\u0438\u0431\u044B\u043B\u044C \u0431\u0443\u0434\u0435\u0442,
      \u043D\u043E \u0441\u043A\u0440\u043E\u043C\u043D\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147134
    m_Localized: "\u0411\u0435\u0436\u0435\u043D\u0446\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147135
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u0441\u0442\u043E\u0438\u0442
      \u0433\u0440\u0443\u043F\u043F\u0430 \u043B\u044E\u0434\u0435\u0439: \u0436\u0435\u043D\u0449\u0438\u043D\u044B,
      \u0434\u0435\u0442\u0438, \u0441\u0442\u0430\u0440\u0438\u043A\u0438 \u0441
      \u0443\u0437\u043B\u0430\u043C\u0438 \u043D\u0430 \u0441\u043F\u0438\u043D\u0430\u0445.
      \u0413\u043B\u0430\u0437\u0430 \u043F\u0443\u0441\u0442\u044B\u0435, \u043B\u0438\u0446\u0430
      \u0441\u0435\u0440\u044B\u0435 \u043E\u0442 \u043F\u044B\u043B\u0438. \u041E\u043D\u0438
      \u0438\u0434\u0443\u0442 \u0438\u0437 \u043F\u0440\u043E\u0432\u0438\u043D\u0446\u0438\u0438,
      \u0433\u0434\u0435 \u0432\u0441\u043F\u044B\u0445\u043D\u0443\u043B \u043C\u044F\u0442\u0435\u0436:
      \u0437\u0435\u043C\u043B\u0438 \u0441\u043E\u0436\u0436\u0435\u043D\u044B,
      \u0434\u043E\u043C\u0430 \u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u044B.
      \u041F\u0440\u043E\u0441\u044F\u0442 \u0445\u043B\u0435\u0431\u0430, \u0432\u043E\u0434\u044B,
      \u0447\u0435\u0433\u043E \u0443\u0433\u043E\u0434\u043D\u043E. \u0414\u0435\u0442\u0438
      \u043F\u043B\u0430\u0447\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147136
    m_Localized: "\u041F\u043E\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147137
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F,
      \u0440\u0430\u0437\u0434\u0430\u043B\u0438 \u0445\u043B\u0435\u0431, \u0441\u0443\u0448\u0451\u043D\u043E\u0435
      \u043C\u044F\u0441\u043E, \u0432\u043E\u0434\u0443. \u0421\u0442\u0430\u0440\u0443\u0445\u0430,
      \u043F\u0440\u0438\u043D\u044F\u0432 \u0435\u0434\u0443, \u0441\u0445\u0432\u0430\u0442\u0438\u043B\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0430 \u0437\u0430
      \u0440\u0443\u043A\u0443: \xAB\u041D\u0435\u0431\u043E \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442
      \u044D\u0442\u043E.\xBB \u041B\u044E\u0434\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0443\u0435\u0437\u0436\u0430\u043B\u0438 \u0441 \u0442\u044F\u0436\u0451\u043B\u044B\u043C
      \u0441\u0435\u0440\u0434\u0446\u0435\u043C, \u043D\u043E \u0441 \u0447\u0438\u0441\u0442\u043E\u0439
      \u0441\u043E\u0432\u0435\u0441\u0442\u044C\u044E. \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435 \u043E \u0449\u0435\u0434\u0440\u043E\u0441\u0442\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0443\u0436\u0435 \u0437\u043D\u0430\u043B\u0438:
      \u0431\u0435\u0436\u0435\u043D\u0446\u044B \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147138
    m_Localized: "\u0414\u0430\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0438 \u0438\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147139
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u043B\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043B\u0435\u043F\u0451\u0448\u0435\u043A \u0438 \u0431\u0443\u0440\u0434\u044E\u043A
      \u0432\u043E\u0434\u044B, \u043D\u0435\u043C\u043D\u043E\u0433\u043E, \u043D\u043E
      \u0445\u043E\u0442\u044C \u0447\u0442\u043E-\u0442\u043E. \u0411\u0435\u0436\u0435\u043D\u0446\u044B
      \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B\u0438
      \u0438 \u043F\u043E\u0442\u044F\u043D\u0443\u043B\u0438\u0441\u044C \u0434\u0430\u043B\u044C\u0448\u0435
      \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435. \u041B\u044E\u0434\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u043C\u043E\u043B\u0447\u0430
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u0438\u043C \u0432\u0441\u043B\u0435\u0434.
      \u0414\u0430\u043B\u0438 \u043C\u0430\u043B\u043E. \u041D\u043E \u0445\u043E\u0442\u044F
      \u0431\u044B \u0434\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147140
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147141
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0443\u0441\u043A\u043E\u0440\u0438\u043B
      \u0448\u0430\u0433, \u0441\u0442\u0430\u0440\u0430\u044F\u0441\u044C \u043D\u0435
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0442\u044C\u0441\u044F \u0433\u043B\u0430\u0437\u0430\u043C\u0438
      \u0441 \u0431\u0435\u0436\u0435\u043D\u0446\u0430\u043C\u0438. \u0420\u0435\u0431\u0451\u043D\u043E\u043A
      \u043F\u043E\u0431\u0435\u0436\u0430\u043B \u0437\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u043E\u0439,
      \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u044F \u0440\u0443\u043A\u0438,
      \u043F\u043E\u043A\u0430 \u043C\u0430\u0442\u044C \u043D\u0435 \u043E\u043A\u043B\u0438\u043A\u043D\u0443\u043B\u0430
      \u0435\u0433\u043E. \u0414\u043E \u043A\u043E\u043D\u0446\u0430 \u0434\u043D\u044F
      \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435 \u0441\u0442\u043E\u044F\u043B\u0430
      \u0442\u0438\u0448\u0438\u043D\u0430. \u041D\u0438\u043A\u0442\u043E \u043D\u0435
      \u0445\u043E\u0442\u0435\u043B \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147142
    m_Localized: "\u0421\u043E\u043F\u0435\u0440\u043D\u0438\u043A \u0442\u043E\u043B\u044C\u043A\u043E
      \u0440\u0430\u0441\u0441\u043C\u0435\u044F\u043B\u0441\u044F: \xAB\u0420\u044B\u043D\u043E\u043A
      \u043D\u0435 \u0434\u0435\u043B\u044F\u0442. \u0415\u0433\u043E \u0431\u0435\u0440\u0443\u0442.\xBB
      \u0418 \u0443\u0441\u043A\u043E\u0440\u0438\u043B \u0441\u0432\u043E\u0438\u0445
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432. \u0412\u043C\u0435\u0441\u0442\u0435
      \u0441 \u043D\u0438\u043C\u0438 \u0443\u0448\u043B\u0430 \u0438 \u043D\u0430\u0434\u0435\u0436\u0434\u0430
      \u043D\u0430 \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u0446\u0435\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147143
    m_Localized: "\u041F\u043E\u043F\u0443\u0442\u043D\u044B\u0439 \u0432\u0435\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147144
    m_Localized: "\u0421 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430 \u0432
      \u0441\u043F\u0438\u043D\u0443 \u0434\u0443\u0435\u0442 \u0440\u043E\u0432\u043D\u044B\u0439
      \u0442\u0451\u043F\u043B\u044B\u0439 \u0432\u0435\u0442\u0435\u0440. \u041F\u043E\u043B\u043E\u0442\u043D\u044F\u043D\u044B\u0435
      \u0442\u0435\u043D\u0442\u044B \u043D\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u0445
      \u0440\u0430\u0437\u0434\u0443\u0432\u0430\u044E\u0442\u0441\u044F, \u043A\u0430\u043A
      \u043F\u0430\u0440\u0443\u0441\u0430, \u0438 \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0435\u0434\u0435\u0442
      \u0441\u0430\u043C \u0441\u043E\u0431\u043E\u0439. \u0416\u0438\u0432\u043E\u0442\u043D\u044B\u0435
      \u0441\u0442\u0443\u043F\u0430\u044E\u0442 \u043B\u0435\u0433\u043A\u043E,
      \u043F\u044B\u043B\u044C \u0441\u043D\u043E\u0441\u0438\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443,
      \u0434\u044B\u0448\u0438\u0442\u0441\u044F \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u0442\u0435\u0445 \u0440\u0435\u0434\u043A\u0438\u0445
      \u0434\u043D\u0435\u0439, \u043A\u043E\u0433\u0434\u0430 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0432 \u0440\u0430\u0434\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147145
    m_Localized: "\u0412\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0438 \u0443\u0441\u043A\u043E\u0440\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147146
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0448\u0451\u043B
      \u0437\u0430 \u0434\u0435\u043D\u044C \u043F\u043E\u043B\u0443\u0442\u043E\u0440\u0430\u0434\u043D\u0435\u0432\u043D\u044B\u0439
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434. \u041F\u043E\u043F\u0443\u0442\u043D\u044B\u0439
      \u0432\u0435\u0442\u0435\u0440 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B
      \u0441\u0438\u043B\u044B \u043B\u044E\u0434\u0435\u0439 \u0438 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445
      - \u043D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432,
      \u0447\u0435\u043C \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u043B\u0438.
      \u041B\u044E\u0434\u0438 \u0448\u0443\u0442\u0438\u043B\u0438: \xAB\u0412\u043E\u0442
      \u0431\u044B \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C
      \u0442\u0430\u043A.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147147
    m_Localized: "\u0418\u0434\u0442\u0438 \u043E\u0431\u044B\u0447\u043D\u044B\u043C
      \u0442\u0435\u043C\u043F\u043E\u043C \u0438 \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147148
    m_Localized: "\u041B\u0451\u0433\u043A\u0438\u0439 \u043F\u0435\u0440\u0435\u0445\u043E\u0434,
      \u0440\u0430\u043D\u043D\u0438\u0439 \u043F\u0440\u0438\u0432\u0430\u043B.
      \u041B\u044E\u0434\u0438 \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0437\u0430
      \u0434\u043E\u043B\u0433\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u0438\u043B\u0438\u0441\u044C
      \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443 -
      \u043F\u043E\u0447\u0438\u043D\u0438\u043B\u0438 \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435,
      \u0437\u0430\u043B\u0430\u0442\u0430\u043B\u0438 \u043E\u0434\u0435\u0436\u0434\u0443,
      \u043F\u043E\u0441\u0438\u0434\u0435\u043B\u0438 \u0443 \u043A\u043E\u0441\u0442\u0440\u0430
      \u0431\u0435\u0437 \u0441\u043F\u0435\u0448\u043A\u0438. \u0412\u0435\u0442\u0435\u0440
      \u0432\u0441\u0451 \u0442\u0430\u043A \u0436\u0435 \u0440\u043E\u0432\u043D\u043E
      \u0434\u0443\u043B \u0432 \u0441\u043F\u0438\u043D\u0443. \u0425\u043E\u0440\u043E\u0448\u0438\u0439
      \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147149
    m_Localized: "\u0423\u0434\u0430\u0447\u043D\u0430\u044F \u043E\u0445\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147150
    m_Localized: "\u041D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435 \u043E\u0434\u0438\u043D
      \u0438\u0437 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u043E\u0432
      \u0437\u0430\u043C\u0435\u0442\u0438\u043B \u0441\u043B\u0435\u0434\u044B -
      \u0441\u0432\u0435\u0436\u0438\u0435, \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0435.
      \u0421\u0442\u0430\u0434\u043E \u0434\u0438\u043A\u0438\u0445 \u043A\u043E\u0437
      \u043F\u0440\u043E\u0448\u043B\u043E \u0437\u0434\u0435\u0441\u044C \u0441\u043E\u0432\u0441\u0435\u043C
      \u043D\u0435\u0434\u0430\u0432\u043D\u043E. \u0415\u0441\u043B\u0438 \u043F\u043E\u0442\u043E\u0440\u043E\u043F\u0438\u0442\u044C\u0441\u044F,
      \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u0431\u044B\u0442\u044C \u043C\u044F\u0441\u0430
      \u0438 \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u0442\u0430\u044E\u0449\u0438\u0435
      \u0437\u0430\u043F\u0430\u0441\u044B. \u0412\u0435\u0442\u0435\u0440 \u0434\u0443\u0435\u0442
      \u043E\u0442 \u0441\u0442\u0430\u0434\u0430 - \u0437\u0432\u0435\u0440\u0438
      \u043D\u0435 \u0443\u0447\u0443\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147151
    m_Localized: "\u041F\u043E\u0441\u043B\u0430\u0442\u044C \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147152
    m_Localized: "\u0422\u0440\u043E\u0435 \u0443\u0448\u043B\u0438 \u0441 \u043B\u0443\u043A\u0430\u043C\u0438
      \u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u0441 \u0434\u0432\u0443\u043C\u044F
      \u043A\u043E\u0437\u0430\u043C\u0438. \u0412\u0435\u0447\u0435\u0440\u043E\u043C
      \u0432 \u043B\u0430\u0433\u0435\u0440\u0435 \u043F\u0430\u0445\u043B\u043E
      \u0436\u0430\u0440\u0435\u043D\u044B\u043C \u043C\u044F\u0441\u043E\u043C,
      \u043B\u044E\u0434\u0438 \u0435\u043B\u0438 \u0434\u043E\u0441\u044B\u0442\u0430
      \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0437\u0430 \u043D\u0435\u0434\u0435\u043B\u044E.
      \u041E\u0441\u0442\u0430\u0442\u043A\u0438 \u0437\u0430\u0432\u044F\u043B\u0438\u043B\u0438
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443. \u0423\u0434\u0430\u0447\u0430
      - \u0440\u0435\u0434\u043A\u0430\u044F \u0433\u043E\u0441\u0442\u044C\u044F
      \u043D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147153
    m_Localized: "\u041E\u0445\u043E\u0442\u043D\u0438\u043A\u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u043D\u0438 \u0441 \u0447\u0435\u043C - \u0441\u0442\u0430\u0434\u043E \u0443\u0448\u043B\u043E
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u0447\u0435\u043C \u043E\u0436\u0438\u0434\u0430\u043B\u0438.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0432\u0440\u0435\u043C\u044F,
      \u0441\u044A\u0435\u043B\u0438 \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u043D\u0430 \u0445\u043E\u0434\u0443. \u041E\u0431\u0438\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147154
    m_Localized: "\u041D\u0435 \u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0432\u0440\u0435\u043C\u044F
      \u043D\u0430 \u043E\u0445\u043E\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147155
    m_Localized: "\u0421\u043B\u0435\u0434\u044B \u0443\u0448\u043B\u0438 \u0432
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u043E\u0442 \u0434\u043E\u0440\u043E\u0433\u0438,
      \u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435. \u041C\u043E\u0436\u0435\u0442, \u0432
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0440\u0430\u0437.
      \u041B\u044E\u0434\u0438 \u0432\u043E\u0440\u0447\u0430\u043B\u0438, \u043D\u043E
      \u0434\u043E\u0440\u043E\u0433\u0430 \u043D\u0435 \u0436\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147156
    m_Localized: "\u0420\u043E\u0434\u043D\u0438\u043A \u0441 \u0447\u0438\u0441\u0442\u043E\u0439
      \u0432\u043E\u0434\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147157
    m_Localized: "\u0421\u0440\u0435\u0434\u0438 \u043A\u0430\u043C\u043D\u0435\u0439
      \u0443 \u043E\u0431\u043E\u0447\u0438\u043D\u044B \u0431\u044C\u0451\u0442
      \u0440\u043E\u0434\u043D\u0438\u043A: \u0447\u0438\u0441\u0442\u044B\u0439,
      \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439, \u0441 \u0435\u0434\u0432\u0430
      \u0437\u0430\u043C\u0435\u0442\u043D\u044B\u043C \u043C\u0438\u043D\u0435\u0440\u0430\u043B\u044C\u043D\u044B\u043C
      \u043F\u0440\u0438\u0432\u043A\u0443\u0441\u043E\u043C. \u0412\u043E\u0434\u0430
      \u0442\u0435\u0447\u0451\u0442 \u043F\u043E \u0436\u0451\u043B\u043E\u0431\u0443,
      \u0432\u044B\u0431\u0438\u0442\u043E\u043C\u0443 \u0432 \u043A\u0430\u043C\u043D\u0435:
      \u043A\u0442\u043E-\u0442\u043E \u043E\u0431\u0443\u0441\u0442\u0440\u043E\u0438\u043B
      \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E \u0434\u0430\u0432\u043D\u044B\u043C-\u0434\u0430\u0432\u043D\u043E.
      \u0420\u044F\u0434\u043E\u043C \u043A\u0430\u043C\u0435\u043D\u043D\u0430\u044F
      \u0447\u0430\u0448\u0430 \u0434\u043B\u044F \u043F\u0438\u0442\u044C\u044F
      \u0438 \u0442\u0435\u043D\u044C \u043E\u0442 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
      \u0434\u0435\u0440\u0435\u0432\u0430. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0442\u043D\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147158
    m_Localized: "\u0421\u0434\u0435\u043B\u0430\u0442\u044C \u043F\u043E\u043B\u043D\u043E\u0446\u0435\u043D\u043D\u044B\u0439
      \u043F\u0440\u0438\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147159
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
      \u043D\u0430 \u043F\u043E\u043B\u0434\u043D\u044F. \u041B\u044E\u0434\u0438
      \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u043B\u0438 \u0432\u0441\u0435 \u0431\u0443\u0440\u0434\u044E\u043A\u0438,
      \u043D\u0430\u043F\u043E\u0438\u043B\u0438 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445,
      \u0432\u044B\u0441\u0442\u0438\u0440\u0430\u043B\u0438 \u043E\u0434\u0435\u0436\u0434\u0443.
      \u041A\u0442\u043E-\u0442\u043E \u043D\u0430\u0448\u0451\u043B \u0434\u0438\u043A\u0438\u0439
      \u043B\u0443\u043A \u0443 \u0432\u043E\u0434\u044B \u0438 \u0441\u0432\u0430\u0440\u0438\u043B
      \u043F\u043E\u0445\u043B\u0451\u0431\u043A\u0443. \u0412 \u0442\u0435\u043D\u0438
      \u0434\u0435\u0440\u0435\u0432\u0430, \u0441 \u043F\u043E\u043B\u043D\u044B\u043C
      \u0436\u0438\u0432\u043E\u0442\u043E\u043C \u0438 \u0447\u0438\u0441\u0442\u043E\u0439
      \u0432\u043E\u0434\u043E\u0439 \u0436\u0438\u0437\u043D\u044C \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0430
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u043D\u0435 \u0442\u0430\u043A\u043E\u0439
      \u0443\u0436 \u0442\u044F\u0436\u0451\u043B\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147160
    m_Localized: "\u041D\u0430\u0431\u0440\u0430\u0442\u044C \u0432\u043E\u0434\u044B
      \u0438 \u0438\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147161
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u0430\u044F \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430:
      \u0431\u0443\u0440\u0434\u044E\u043A\u0438 \u043F\u043E\u043B\u043D\u044B,
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u043D\u0430\u043F\u043E\u0435\u043D\u044B,
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0433\u043B\u043E\u0442\u043A\u043E\u0432
      \u043B\u0435\u0434\u044F\u043D\u043E\u0439 \u0432\u043E\u0434\u044B \u043A\u0430\u0436\u0434\u043E\u043C\u0443.
      \u042D\u0442\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u043D\u044F\u0442\u044C \u0434\u0443\u0445.
      \u0420\u043E\u0434\u043D\u0438\u043A \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u043F\u043E\u0437\u0430\u0434\u0438, \u043D\u043E \u0435\u0433\u043E \u0441\u0432\u0435\u0436\u0435\u0441\u0442\u044C
      \u0435\u0449\u0451 \u0434\u043E\u043B\u0433\u043E \u043E\u0449\u0443\u0449\u0430\u043B\u0430\u0441\u044C
      \u043D\u0430 \u0433\u0443\u0431\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147162
    m_Localized: "\u041D\u043E\u0447\u043D\u0430\u044F \u0430\u0442\u0430\u043A\u0430
      \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147163
    m_Localized: "\u0422\u0440\u0435\u0442\u044C\u044F \u0441\u0442\u0440\u0430\u0436\u0430.
      \u0423\u0433\u043B\u0438 \u043A\u043E\u0441\u0442\u0440\u0430 \u043F\u043E\u0434\u0451\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u043F\u0435\u043F\u043B\u043E\u043C, \u043A\u043E\u0433\u0434\u0430 \u0438\u0437
      \u0442\u0435\u043C\u043D\u043E\u0442\u044B \u0434\u043E\u043D\u0451\u0441\u0441\u044F
      \u0445\u0440\u0443\u0441\u0442 \u0433\u0430\u043B\u044C\u043A\u0438 \u043F\u043E\u0434
      \u0447\u0443\u0436\u0438\u043C\u0438 \u0441\u0430\u043F\u043E\u0433\u0430\u043C\u0438.
      \u0422\u0435\u043D\u0438 \u0441\u043A\u043E\u043B\u044C\u0437\u044F\u0442 \u043C\u0435\u0436\u0434\u0443
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u043C\u0438 - \u0431\u0430\u043D\u0434\u0438\u0442\u044B
      \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C \u043A \u0441\u043F\u044F\u0449\u0435\u043C\u0443
      \u043B\u0430\u0433\u0435\u0440\u044E. \u0412\u0440\u0435\u043C\u0435\u043D\u0438
      \u043D\u0430 \u0440\u0430\u0437\u0434\u0443\u043C\u044C\u044F \u043D\u0435\u0442:
      \u0437\u0432\u043E\u043D \u043C\u0435\u0442\u0430\u043B\u043B\u0430 \u0443\u0436\u0435
      \u043F\u0440\u043E\u0440\u0435\u0437\u0430\u043B \u0442\u0438\u0448\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147164
    m_Localized: "\u041E\u0431\u043E\u0440\u043E\u043D\u044F\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147165
    m_Localized: "\u0412\u044B\u0445\u0432\u0430\u0442\u0438\u0432 \u0444\u0430\u043A\u0435\u043B\u044B
      \u0438 \u043E\u0440\u0443\u0436\u0438\u0435, \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438 \u043D\u0430\u043F\u0430\u0434\u0430\u0432\u0448\u0438\u0445
      \u0434\u0440\u0443\u0436\u043D\u044B\u043C \u043E\u0442\u043F\u043E\u0440\u043E\u043C.
      \u0411\u0430\u043D\u0434\u0438\u0442\u044B \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0443, \u043E\u0441\u0442\u0430\u0432\u0438\u0432
      \u043F\u0430\u0440\u0443 \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0445
      \u043D\u043E\u0436\u0435\u0439. \u041F\u0440\u0438\u043F\u0430\u0441\u044B
      \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u044B, \u043D\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0446\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147166
    m_Localized: "\u0410\u0442\u0430\u043A\u0430 \u0437\u0430\u0441\u0442\u0430\u043B\u0430
      \u0432\u0440\u0430\u0441\u043F\u043B\u043E\u0445. \u041F\u043E\u043A\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u0445\u0432\u0430\u0442\u0430\u043B\u0438\u0441\u044C
      \u0437\u0430 \u0447\u0442\u043E \u043F\u043E\u043F\u0430\u043B\u043E, \u0431\u0430\u043D\u0434\u0438\u0442\u044B
      \u0432\u0441\u043F\u043E\u0440\u043E\u043B\u0438 \u0434\u0432\u0430 \u0442\u044E\u043A\u0430
      \u0438 \u0443\u0442\u0430\u0449\u0438\u043B\u0438 \u043C\u0435\u0448\u043E\u043A
      \u043C\u043E\u043D\u0435\u0442. \u041F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0430 \u043E\u0442 \u0443\u0434\u0430\u0440\u0430
      \u0442\u0430\u0440\u0430\u043D\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147167
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u043E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147168
    m_Localized: "\u041A\u043E\u0448\u0435\u043B\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u0430,
      \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439 \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0443,
      \u043A\u0443\u043F\u0438\u043B \u0442\u0438\u0448\u0438\u043D\u0443. \u0411\u0430\u043D\u0434\u0438\u0442\u044B
      \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043B\u0438 \u043C\u043E\u043D\u0435\u0442\u044B
      \u0438 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C
      \u0432 \u043D\u043E\u0447\u0438. \u0414\u0435\u0448\u0435\u0432\u043B\u0435,
      \u0447\u0435\u043C \u0431\u043E\u0439, \u043D\u043E \u0433\u043E\u0440\u0435\u0447\u044C
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147169
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0443\u0435\u0442
      \u0437\u0430\u0441\u0430\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147170
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0437\u0430\u043C\u0435\u0442\u0438\u043B
      \u0441\u043B\u0435\u0434\u044B \u0435\u0449\u0451 \u0437\u0430\u0441\u0432\u0435\u0442\u043B\u043E
      \u0438 \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u043B \u043B\u043E\u0432\u0443\u0448\u043A\u0438
      \u043D\u0430 \u043F\u043E\u0434\u0441\u0442\u0443\u043F\u0430\u0445. \u041A\u043E\u0433\u0434\u0430
      \u0431\u0430\u043D\u0434\u0438\u0442\u044B \u0441\u0443\u043D\u0443\u043B\u0438\u0441\u044C,
      \u0438\u0445 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438 \u0432\u0435\u0440\u0451\u0432\u043E\u0447\u043D\u044B\u0435
      \u043F\u0435\u0442\u043B\u0438 \u0438 \u0430\u0440\u0431\u0430\u043B\u0435\u0442\u043D\u044B\u0439
      \u0431\u043E\u043B\u0442-\u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435.
      \u041D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u043E\u0433\u043E
      \u0442\u044E\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147171
    m_Localized: "\u0414\u0438\u043A\u0438\u0435 \u0437\u0432\u0435\u0440\u0438 \u0443
      \u043B\u0430\u0433\u0435\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147172
    m_Localized: "\u0412\u044C\u044E\u0447\u043D\u044B\u0435 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435
      \u0437\u0430\u0432\u043E\u043B\u043D\u043E\u0432\u0430\u043B\u0438\u0441\u044C,
      \u043D\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u044F \u043F\u0440\u0438\u0432\u044F\u0437\u0438.
      \u0418\u0437-\u0437\u0430 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0439
      \u0433\u0440\u044F\u0434\u044B \u0441\u0432\u0435\u0440\u043A\u043D\u0443\u043B\u0438
      \u0436\u0451\u043B\u0442\u044B\u0435 \u0433\u043B\u0430\u0437\u0430 - \u0441\u0442\u0430\u044F
      \u0432\u043E\u043B\u043A\u043E\u0432 (\u0438\u043B\u0438 \u0433\u0438\u0435\u043D,
      \u0435\u0441\u043B\u0438 \u043F\u0443\u0441\u0442\u044B\u043D\u044F) \u0443\u0447\u0443\u044F\u043B\u0430
      \u0437\u0430\u043F\u0430\u0445 \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0438.
      \u0417\u0432\u0435\u0440\u0438 \u043A\u0440\u0443\u0436\u0430\u0442 \u043D\u0430
      \u0433\u0440\u0430\u043D\u0438\u0446\u0435 \u0441\u0432\u0435\u0442\u0430,
      \u0432\u044B\u0436\u0438\u0434\u0430\u044F \u043C\u043E\u043C\u0435\u043D\u0442.
      \u041E\u0434\u043D\u043E \u043D\u0435\u0432\u0435\u0440\u043D\u043E\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435
      - \u0438 \u043E\u043D\u0438 \u0431\u0440\u043E\u0441\u044F\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147173
    m_Localized: "\u041E\u0442\u043F\u0443\u0433\u043D\u0443\u0442\u044C \u043E\u0433\u043D\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147174
    m_Localized: "\u0420\u0430\u0441\u043A\u0430\u043B\u0451\u043D\u043D\u044B\u0435
      \u0433\u043E\u043B\u043E\u0432\u043D\u0438 \u0438 \u0433\u0440\u043E\u043C\u043A\u0438\u0435
      \u043A\u0440\u0438\u043A\u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u0441\u0442\u0430\u044E \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C.
      \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0441\u0436\u0435\u0447\u044C
      \u0437\u0430\u043F\u0430\u0441 \u0445\u0432\u043E\u0440\u043E\u0441\u0442\u0430
      \u0438 \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0432\u044F\u043B\u0435\u043D\u044B\u043C \u043C\u044F\u0441\u043E\u043C,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u0432\u043B\u0435\u0447\u044C \u0432\u043E\u0436\u0430\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147175
    m_Localized: "\u0424\u0430\u043A\u0435\u043B\u044B \u043D\u0435 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0438\u043B\u0438
      \u0437\u0432\u0435\u0440\u0435\u0439. \u0412\u043E\u043B\u043A\u0438 \u043F\u0440\u043E\u0440\u0432\u0430\u043B\u0438\u0441\u044C
      \u043A \u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C \u0438 \u0443\u0442\u0430\u0449\u0438\u043B\u0438
      \u043C\u0435\u0448\u043E\u043A \u0441 \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0435\u0439,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0438\u0445 \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u043F\u0440\u043E\u0433\u043D\u0430\u0442\u044C. \u041A\u0442\u043E-\u0442\u043E
      \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0443\u043A\u0443\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147176
    m_Localized: "\u041D\u0435 \u0442\u0440\u043E\u0433\u0430\u0442\u044C, \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147177
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0437\u0430\u043C\u0435\u0440.
      \u0417\u0432\u0435\u0440\u0438 \u043E\u0431\u043D\u044E\u0445\u0438\u0432\u0430\u043B\u0438
      \u0442\u044E\u043A\u0438 \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430,
      \u0443\u0442\u0430\u0449\u0438\u0432 \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u043F\u0430\u043B - \u0443\u0442\u0440\u043E\u043C
      \u043B\u0438\u0446\u0430 \u0441\u0435\u0440\u044B\u0435, \u0440\u0443\u043A\u0438
      \u0442\u0440\u044F\u0441\u0443\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147178
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u043D\u044B\u0435 \u0437\u0432\u0443\u043A\u0438
      \u0432 \u043D\u043E\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147179
    m_Localized: "\u0417\u0430 \u043F\u043E\u043B\u043D\u043E\u0447\u044C \u0438\u0437-\u0437\u0430
      \u0431\u0430\u0440\u0445\u0430\u043D\u043E\u0432 (\u0438\u043B\u0438 \u0438\u0437
      \u0443\u0449\u0435\u043B\u044C\u044F, \u0438\u043B\u0438 \u0438\u0437 \u043B\u0435\u0441\u0430)
      \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0439
      \u043F\u0440\u043E\u0442\u044F\u0436\u043D\u044B\u0439 \u0437\u0432\u0443\u043A
      - \u043D\u0435 \u0437\u0432\u0435\u0440\u044C, \u043D\u0435 \u0432\u0435\u0442\u0435\u0440.
      \u041C\u0435\u043B\u043E\u0434\u0438\u044F \u0431\u0435\u0437 \u0441\u043B\u043E\u0432,
      \u0442\u043E \u043B\u0438 \u043F\u043B\u0430\u0447, \u0442\u043E \u043B\u0438
      \u043F\u0435\u043D\u0438\u0435. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u043E\u0431\u043B\u0435\u0434\u043D\u0435\u043B\u0438, \u0448\u0435\u043F\u0447\u0443\u0442
      \u043C\u043E\u043B\u0438\u0442\u0432\u044B. \u041A\u0442\u043E-\u0442\u043E
      \u043A\u043B\u044F\u043D\u0451\u0442\u0441\u044F, \u0447\u0442\u043E \u0432\u0438\u0434\u0438\u0442
      \u0431\u043B\u0435\u0434\u043D\u044B\u0439 \u0441\u0432\u0435\u0442 \u0432\u0434\u0430\u043B\u0435\u043A\u0435.
      \u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C \u0438\u043B\u0438
      \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147180
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u0430\u0442\u044C \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
      \u0437\u0432\u0443\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147181
    m_Localized: "\u0417\u0430 \u0433\u0440\u044F\u0434\u043E\u0439 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D
      \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439 \u0432\u044B\u0441\u0442\u0443\u043F,
      \u0447\u0435\u0440\u0435\u0437 \u0449\u0435\u043B\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u0432\u0435\u0442\u0435\u0440 \u0441\u043E\u0437\u0434\u0430\u0451\u0442 \u0436\u0443\u0442\u043A\u0438\u0439
      \u0433\u0443\u043B. \u041F\u0440\u0438\u0440\u043E\u0434\u043D\u0430\u044F
      \xAB\u0444\u043B\u0435\u0439\u0442\u0430\xBB - \u043D\u0438\u043A\u0430\u043A\u043E\u0439
      \u043C\u0438\u0441\u0442\u0438\u043A\u0438. \u041B\u044E\u0434\u0438 \u043E\u0431\u043B\u0435\u0433\u0447\u0451\u043D\u043D\u043E
      \u0432\u0437\u0434\u043E\u0445\u043D\u0443\u043B\u0438, \u043A\u0442\u043E-\u0442\u043E
      \u0434\u0430\u0436\u0435 \u0440\u0430\u0441\u0441\u043C\u0435\u044F\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147182
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C,
      \u043D\u0435 \u043D\u0430\u0439\u0434\u044F \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430.
      \u0417\u0432\u0443\u043A \u0441\u0442\u0438\u0445 \u0441\u0430\u043C \u043F\u043E
      \u0441\u0435\u0431\u0435, \u043D\u043E \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u044F
      \u043D\u0435\u0442. \u0422\u0440\u0435\u0432\u043E\u0433\u0430 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C,
      \u043B\u044E\u0434\u0438 \u0448\u0435\u043F\u0447\u0443\u0442\u0441\u044F \u043E
      \u0434\u0443\u0445\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147183
    m_Localized: "\u0417\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C
      \u0438 \u043C\u043E\u043B\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147184
    m_Localized: "\u041A\u043E\u0441\u0442\u0440\u044B \u0443\u0441\u0438\u043B\u0435\u043D\u044B,
      \u043B\u0430\u0433\u0435\u0440\u044C \u0437\u0430\u0442\u044F\u043D\u0443\u0442
      \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u043C\u0438, \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u0442. \u0417\u0432\u0443\u043A
      \u0441\u0442\u0438\u0445 \u043A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443,
      \u043D\u043E \u043D\u043E\u0447\u044C \u043F\u0440\u043E\u0448\u043B\u0430
      \u0432 \u0442\u0440\u0435\u0432\u043E\u0433\u0435. \u0423\u0442\u0440\u043E\u043C
      \u0432\u0441\u0435 \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147185
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0443\u0437\u043D\u0430\u0451\u0442
      \u043C\u0435\u0441\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147186
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A, \u0437\u0430\u0441\u043B\u044B\u0448\u0430\u0432
      \u0437\u0432\u0443\u043A, \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E
      \u0443\u0441\u043C\u0435\u0445\u043D\u0443\u043B\u0441\u044F. \u041E\u043D
      \u0431\u044B\u0432\u0430\u043B \u0437\u0434\u0435\u0441\u044C: \u0432\u0435\u0442\u0435\u0440
      \u043F\u043E\u0451\u0442 \u0432 \u043A\u0430\u043C\u043D\u044F\u0445 \u043A\u0430\u0436\u0434\u0443\u044E
      \u043D\u043E\u0447\u044C. \u0420\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B
      \u043B\u0435\u0433\u0435\u043D\u0434\u0443 \u043E\u0431 \u044D\u0442\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435 - \u043B\u044E\u0434\u0438 \u0437\u0430\u0441\u043B\u0443\u0448\u0430\u043B\u0438\u0441\u044C
      \u0438 \u0437\u0430\u0431\u044B\u043B\u0438 \u0441\u0442\u0440\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147187
    m_Localized: "\u0412\u043E\u0440 \u0432 \u043B\u0430\u0433\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707542147188
    m_Localized: "\u041F\u0435\u0440\u0435\u0434 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u043E\u043C
      \u0447\u0430\u0441\u043E\u0432\u043E\u0439 \u0437\u0430\u043C\u0435\u0442\u0438\u043B
      \u0442\u0435\u043D\u044C, \u043C\u0435\u0442\u043D\u0443\u0432\u0448\u0443\u044E\u0441\u044F
      \u043E\u0442 \u043F\u043E\u0432\u043E\u0437\u043A\u0438. \u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430
      \u0432\u044B\u044F\u0432\u0438\u043B\u0430 \u0432\u0441\u043F\u043E\u0440\u043E\u0442\u044B\u0439
      \u043C\u0435\u0448\u043E\u043A \u0438 \u043F\u0440\u043E\u043F\u0430\u0436\u0443
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u043C\u043E\u043D\u0435\u0442.
      \u0412\u043E\u0440 \u0432\u0441\u0451 \u0435\u0449\u0451 \u0433\u0434\u0435-\u0442\u043E
      \u0440\u044F\u0434\u043E\u043C - \u0441\u043B\u0435\u0434\u044B \u0432\u0435\u0434\u0443\u0442
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0443. \u041B\u0430\u0433\u0435\u0440\u044C
      \u0443\u044F\u0437\u0432\u0438\u043C: \u0432\u0435\u0449\u0438 \u0440\u0430\u0437\u0431\u0440\u043E\u0441\u0430\u043D\u044B,
      \u043B\u044E\u0434\u0438 \u0441\u043F\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341376
    m_Localized: "\u041F\u0440\u0435\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u0432\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341377
    m_Localized: "\u041F\u043E \u0441\u043B\u0435\u0434\u0430\u043C \u043D\u0430
      \u043F\u0435\u0441\u043A\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043D\u0430\u0433\u043D\u0430\u0442\u044C
      \u0432\u043E\u0440\u0438\u0448\u043A\u0443 - \u0445\u0443\u0434\u043E\u0433\u043E
      \u043F\u0430\u0440\u043D\u044F \u0441 \u0438\u0441\u043F\u0443\u0433\u0430\u043D\u043D\u044B\u043C\u0438
      \u0433\u043B\u0430\u0437\u0430\u043C\u0438. \u041C\u043E\u043D\u0435\u0442\u044B
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u044B, \u0430 \u043F\u0430\u0440\u0435\u043D\u044C
      \u0441\u0431\u0435\u0436\u0430\u043B, \u0431\u0440\u043E\u0441\u0438\u0432
      \u0441\u0432\u043E\u044E \u0441\u0443\u043C\u043A\u0443 \u0441 \u043F\u0430\u0440\u043E\u0439
      \u043C\u0435\u0434\u044F\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341378
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u044F \u043F\u043E \u0442\u0435\u043C\u043D\u043E\u0442\u0435
      \u043D\u0438 \u043A \u0447\u0435\u043C\u0443 \u043D\u0435 \u043F\u0440\u0438\u0432\u0435\u043B\u0430.
      \u0421\u043B\u0435\u0434\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438\u0441\u044C,
      \u0430 \u043F\u043E\u043A\u0430 \u043B\u0430\u0433\u0435\u0440\u044C \u0431\u044B\u043B
      \u0431\u0435\u0437 \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u0430,
      \u043F\u0440\u043E\u043F\u0430\u043B\u043E \u0435\u0449\u0451 - \u043C\u043E\u043D\u0435\u0442\u044B
      \u0438\u0437 \u0432\u0442\u043E\u0440\u043E\u0433\u043E \u0442\u044E\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341379
    m_Localized: "\u041E\u043A\u0440\u0438\u043A\u043D\u0443\u0442\u044C \u0438 \u043D\u0430\u043F\u0443\u0433\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341380
    m_Localized: "\u0413\u0440\u043E\u0437\u043D\u044B\u0439 \u043E\u043A\u0440\u0438\u043A
      \u0438 \u0444\u0430\u043A\u0435\u043B, \u0432\u0441\u043A\u0438\u043D\u0443\u0442\u044B\u0439
      \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439, \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u0442\u0435\u043D\u044C \u043C\u0435\u0442\u043D\u0443\u0442\u044C\u0441\u044F
      \u043F\u0440\u043E\u0447\u044C. \u041F\u0440\u043E\u043F\u0430\u043B\u043E
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E, \u043D\u043E \u0432\u043E\u0440
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341381
    m_Localized: "\u041A\u0440\u0438\u043A \u0440\u0430\u0437\u0431\u0443\u0434\u0438\u043B
      \u0432\u0435\u0441\u044C \u043B\u0430\u0433\u0435\u0440\u044C, \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C
      \u0441\u0443\u0435\u0442\u0430. \u0412\u043E\u0440 \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0441\u044F
      \u043F\u0430\u043D\u0438\u043A\u043E\u0439 \u0438 \u0441\u043A\u0440\u044B\u043B\u0441\u044F,
      \u043F\u0440\u0438\u0445\u0432\u0430\u0442\u0438\u0432 \u0435\u0449\u0451 \u0433\u043E\u0440\u0441\u0442\u044C
      \u0441\u0435\u0440\u0435\u0431\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341382
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0432\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341383
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043D\u0435 \u0441\u043F\u0430\u043B
      - \u043E\u043D \u0434\u0430\u0432\u043D\u043E \u0437\u0430\u043C\u0435\u0442\u0438\u043B
      \u0447\u0443\u0436\u0438\u0435 \u0441\u043B\u0435\u0434\u044B. \u041F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0438\u043B
      \u0432\u043E\u0440\u0430 \u0443 \u0441\u0430\u043C\u043E\u0439 \u043F\u043E\u0432\u043E\u0437\u043A\u0438,
      \u0441\u043A\u0440\u0443\u0442\u0438\u043B \u0438 \u043E\u0442\u043E\u0431\u0440\u0430\u043B
      \u0443\u043A\u0440\u0430\u0434\u0435\u043D\u043D\u043E\u0435. \u0423\u0442\u0440\u043E\u043C
      \u0432\u0441\u0435 \u0441\u043F\u0430\u043B\u0438 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341384
    m_Localized: "\u041F\u0443\u0442\u043D\u0438\u043A \u0443 \u043A\u043E\u0441\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341385
    m_Localized: "\u0418\u0437 \u043D\u043E\u0447\u043D\u043E\u0439 \u0442\u044C\u043C\u044B
      \u043A \u043A\u0440\u0443\u0433\u0443 \u0441\u0432\u0435\u0442\u0430 \u043A\u043E\u0441\u0442\u0440\u0430
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043E\u0434\u0438\u043D\u043E\u043A\u0438\u0439
      \u043F\u0443\u0442\u043D\u0438\u043A. \u0418\u0437\u043D\u043E\u0448\u0435\u043D\u043D\u044B\u0439
      \u0445\u0430\u043B\u0430\u0442, \u043F\u0443\u0441\u0442\u043E\u0439 \u0431\u0443\u0440\u0434\u044E\u043A,
      \u0443\u0441\u0442\u0430\u043B\u044B\u0435 \u0433\u043B\u0430\u0437\u0430.
      \u041F\u0440\u043E\u0441\u0438\u0442 \u043E\u0433\u043D\u044F \u0438 \u0433\u043B\u043E\u0442\u043E\u043A
      \u0432\u043E\u0434\u044B, \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u044F
      \u0432\u0437\u0430\u043C\u0435\u043D \u0441\u0432\u043E\u044E \u0438\u0441\u0442\u043E\u0440\u0438\u044E.
      \u0413\u043E\u0432\u043E\u0440\u0438\u0442 \u043D\u0430 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C,
      \u0436\u0435\u0441\u0442\u0438\u043A\u0443\u043B\u0438\u0440\u0443\u044F:\r\n\r\n<npc_speech
      lang=\"Sogdian\">\u041F\u0440\u0438\u0432\u0435\u0442, \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A.
      \u042F \u043F\u0443\u0442\u043D\u0438\u043A, \u0438\u0434\u0443 \u0438\u0437
      \u0411\u0443\u0445\u0430\u0440\u044B. \u0412\u043E\u0434\u044B \u0438 \u043E\u0433\u043D\u044F
      - \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u043F\u0440\u043E\u0448\u0443.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341386
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u0443\u0442\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341387
    m_Localized: "\u041F\u0443\u0442\u043D\u0438\u043A \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0431\u044B\u0432\u0448\u0438\u043C \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u043C.
      \u0417\u0430 \u043F\u043E\u0445\u043B\u0451\u0431\u043A\u0443 \u043E\u043D
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B \u043E \u0442\u0440\u043E\u043F\u0430\u0445,
      \u043E\u0431\u0445\u043E\u0434\u044F\u0449\u0438\u0445 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u0447\u044C\u0438
      \u0437\u0430\u0441\u0442\u0430\u0432\u044B. \u0423\u0442\u0440\u043E\u043C
      \u0443\u0448\u0451\u043B \u0441 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C\u044E,
      \u043E\u0441\u0442\u0430\u0432\u0438\u0432 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0435
      \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341388
    m_Localized: "\u041F\u0443\u0442\u043D\u0438\u043A \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043C\u0435\u043B\u043A\u0438\u043C \u0436\u0443\u043B\u0438\u043A\u043E\u043C.
      \u0423\u0442\u0440\u043E\u043C \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0430\u0441\u044C
      \u043F\u0440\u043E\u043F\u0430\u0436\u0430 \u043C\u043E\u043D\u0435\u0442 \u0438\u0437
      \u0441\u0435\u0434\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0443\u043C\u043A\u0438.
      \u0414\u043E\u0432\u0435\u0440\u0447\u0438\u0432\u043E\u0441\u0442\u044C \u043E\u0431\u043E\u0448\u043B\u0430\u0441\u044C
      \u0434\u043E\u0440\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341389
    m_Localized: "\u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341390
    m_Localized: "\u041F\u0443\u0442\u043D\u0438\u043A \u043F\u043E\u043D\u0443\u0440\u043E
      \u043F\u043E\u0431\u0440\u0451\u043B \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0443.
      \u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0431\u0440\u043E\u0441\u0430\u043B\u0438 \u0443\u043A\u043E\u0440\u0438\u0437\u043D\u0435\u043D\u043D\u044B\u0435
      \u0432\u0437\u0433\u043B\u044F\u0434\u044B - \u043D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u043F\u0443\u0442\u0438 \u043D\u0435 \u043F\u0440\u0438\u043D\u044F\u0442\u043E
      \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C \u0432 \u0432\u043E\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341391
    m_Localized: "\u0411\u0440\u043E\u0434\u044F\u0447\u0438\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341392
    m_Localized: "\u0417\u0432\u043E\u043D \u0431\u0443\u0431\u0435\u043D\u0446\u043E\u0432
      - \u0438\u0437 \u0442\u0435\u043C\u043D\u043E\u0442\u044B \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u043E\u0441\u043B\u0438\u043A, \u043D\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0439
      \u043F\u0451\u0441\u0442\u0440\u044B\u043C\u0438 \u0442\u044E\u043A\u0430\u043C\u0438.
      \u0417\u0430 \u043D\u0438\u043C \u0448\u0430\u0433\u0430\u0435\u0442 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0432 \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u043E\u043C,
      \u043D\u043E \u043D\u0435\u043A\u043E\u0433\u0434\u0430 \u0431\u043E\u0433\u0430\u0442\u043E\u043C
      \u0445\u0430\u043B\u0430\u0442\u0435. \u0420\u0430\u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0442\u043E\u0432\u0430\u0440 \u043F\u0440\u044F\u043C\u043E \u043D\u0430
      \u0437\u0435\u043C\u043B\u0435, \u0437\u0430\u0436\u0438\u0433\u0430\u0435\u0442
      \u043C\u0430\u0441\u043B\u044F\u043D\u044B\u0439 \u0441\u0432\u0435\u0442\u0438\u043B\u044C\u043D\u0438\u043A.
      \u041D\u043E\u0447\u043D\u043E\u0439 \u0431\u0430\u0437\u0430\u0440 \u0434\u043B\u044F
      \u043E\u0434\u043D\u043E\u0433\u043E \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044F.
      \u041E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u0444\u0430\u0440\u0441\u0438:\r\n\r\n<npc_speech
      lang=\"Persian\">\u041C\u0438\u0440, \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A!
      \u0423 \u043C\u0435\u043D\u044F \u043E\u0442\u043C\u0435\u043D\u043D\u044B\u0439
      \u0442\u043E\u0432\u0430\u0440 - \u043F\u0440\u0438\u0432\u0451\u0437 \u0438\u0437
      \u0420\u0435\u044F. \u041F\u0440\u043E\u0448\u0443, \u0432\u0437\u0433\u043B\u044F\u043D\u0438\u0442\u0435!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341393
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0440\u0435\u0434\u043A\u0438\u0439
      \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341394
    m_Localized: "\u041E\u043F\u044B\u0442\u043D\u044B\u043C \u0433\u043B\u0430\u0437\u043E\u043C
      \u0432\u044B \u043E\u0446\u0435\u043D\u0438\u043B\u0438 \u0448\u0430\u0444\u0440\u0430\u043D
      - \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439, \u0438\u0437 \u0420\u0435\u044F.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0443\u0432\u0430\u0436\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043A\u0438\u0432\u043D\u0443\u043B, \u0443\u0441\u0442\u0443\u043F\u0438\u0432
      \u0432 \u0446\u0435\u043D\u0435: \u043E\u043D \u0446\u0435\u043D\u0438\u0442
      \u0437\u043D\u0430\u044E\u0449\u0435\u0433\u043E \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341395
    m_Localized: "\u0428\u0430\u0444\u0440\u0430\u043D \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u043D\u0435\u043F\u043B\u043E\u0445\u043E, \u043D\u043E \u0432\u044B \u043D\u0435
      \u0443\u0432\u0435\u0440\u0435\u043D\u044B \u0432 \u0446\u0435\u043D\u0435.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0443\u043B\u044B\u0431\u0430\u043B\u0441\u044F
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0448\u0438\u0440\u043E\u043A\u043E
      - \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043F\u0435\u0440\u0435\u043F\u043B\u0430\u0442\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341396
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341397
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043F\u043E\u0436\u0430\u043B
      \u043F\u043B\u0435\u0447\u0430\u043C\u0438, \u0441\u043E\u0431\u0440\u0430\u043B
      \u0442\u044E\u043A\u0438 \u0438 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0441\u044F
      \u0432 \u043D\u043E\u0447\u0438 \u0442\u0430\u043A \u0436\u0435 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E,
      \u043A\u0430\u043A \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F. \u041E\u0441\u043B\u0438\u043A
      \u0437\u0432\u044F\u043A\u043D\u0443\u043B \u0431\u0443\u0431\u0435\u043D\u0446\u043E\u043C
      \u043D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341398
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0442\u043E\u0440\u0433\u0443\u0435\u0442\u0441\u044F
      \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341399
    m_Localized: "\u0412\u0430\u0448 \u043A\u0443\u043F\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u0432\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B
      \u043D\u0430 \u0444\u0430\u0440\u0441\u0438: <npc_speech lang=\"Persian\">\u0414\u0440\u0443\u0433,
      \u044D\u0442\u043E\u0442 \u0448\u0430\u0444\u0440\u0430\u043D \u0445\u043E\u0440\u043E\u0448,
      \u043D\u043E \u043D\u0435 \u0437\u0430 \u0442\u0430\u043A\u0438\u0435 \u0434\u0435\u043D\u044C\u0433\u0438.
      \u041D\u0430\u0437\u043E\u0432\u0438 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E
      \u0446\u0435\u043D\u0443 - \u0438\u043B\u0438 \u043F\u043E\u0439\u0434\u0451\u043C
      \u0434\u0430\u043B\u044C\u0448\u0435.</npc_speech> \u0427\u0435\u0440\u0435\u0437
      \u043F\u043E\u043B\u0447\u0430\u0441\u0430 \u043E\u0436\u0435\u0441\u0442\u043E\u0447\u0451\u043D\u043D\u043E\u0433\u043E
      \u0442\u043E\u0440\u0433\u0430 \u0446\u0435\u043D\u0430 \u0443\u043F\u0430\u043B\u0430
      \u0432\u0434\u0432\u043E\u0435. \u0411\u0440\u043E\u0434\u044F\u0447\u0438\u0439
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0443\u0448\u0451\u043B,
      \u043A\u0430\u0447\u0430\u044F \u0433\u043E\u043B\u043E\u0432\u043E\u0439,
      \u043D\u043E \u0441 \u0443\u043B\u044B\u0431\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341400
    m_Localized: "\u0420\u0430\u0441\u0441\u043A\u0430\u0437 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341401
    m_Localized: "\u041A \u043A\u043E\u0441\u0442\u0440\u0443 \u043F\u043E\u0434\u0441\u0435\u043B
      \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A - \u043F\u043E\u0436\u0438\u043B\u043E\u0439
      \u0438\u043D\u0434\u0438\u0435\u0446 \u0432 \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u0432\u044B\u0445
      \u043E\u0434\u0435\u0436\u0434\u0430\u0445, \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0449\u0438\u0439\u0441\u044F
      \u0438\u0437 \u041D\u0430\u043B\u0430\u043D\u0434\u044B. \u0415\u0433\u043E
      \u0433\u043B\u0430\u0437\u0430 \u0441\u0432\u0435\u0442\u044F\u0442\u0441\u044F
      \u0432\u043D\u0443\u0442\u0440\u0435\u043D\u043D\u0438\u043C \u043F\u043E\u043A\u043E\u0435\u043C.
      \u041E\u043D \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442 \u0437\u0430
      \u043C\u0435\u0441\u0442\u043E \u0443 \u043E\u0433\u043D\u044F \u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437 \u043E \u0447\u0443\u0434\u0435\u0441\u0430\u0445,
      \u0432\u0438\u0434\u0435\u043D\u043D\u044B\u0445 \u0432 \u043F\u0443\u0442\u0438.
      \u0413\u043E\u043B\u043E\u0441 \u043C\u044F\u0433\u043A\u0438\u0439, \u0441\u043B\u043E\u0432\u0430
      \u043B\u044C\u044E\u0442\u0441\u044F \u043D\u0430 \u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442\u0435:\r\n\r\n<npc_speech
      lang=\"Sanskrit\">\u041F\u043E\u043A\u043B\u043E\u043D, \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A.
      \u042F \u0438\u0434\u0443 \u0438\u0437 \u041D\u0430\u043B\u0430\u043D\u0434\u044B.
      \u0427\u0443\u0434\u0435\u0441\u043D\u044B\u0435 \u0438\u0441\u0442\u043E\u0440\u0438\u0438
      \u0436\u0434\u0443\u0442 - \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u0439\u0442\u0435.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341402
    m_Localized: "\u0421\u043B\u0443\u0448\u0430\u0442\u044C \u0438\u0441\u0442\u043E\u0440\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341403
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B
      \u043E \u0437\u043E\u043B\u043E\u0442\u044B\u0445 \u0448\u043F\u0438\u043B\u044F\u0445
      \u041D\u0430\u043B\u0430\u043D\u0434\u044B, \u043E \u043C\u0443\u0434\u0440\u0435\u0446\u0430\u0445,
      \u0447\u0442\u043E \u0447\u0438\u0442\u0430\u044E\u0442 \u0437\u0432\u0451\u0437\u0434\u044B,
      \u043E \u0441\u043B\u043E\u043D\u0430\u0445 \u0441 \u0431\u0443\u0431\u0435\u043D\u0446\u0430\u043C\u0438.
      \u041B\u044E\u0434\u0438 \u0441\u043B\u0443\u0448\u0430\u043B\u0438, \u0437\u0430\u0431\u044B\u0432
      \u043E \u0442\u0440\u0435\u0432\u043E\u0433\u0430\u0445. \u0423\u0442\u0440\u043E\u043C
      \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435
      \u0437\u0430\u043C\u0435\u0442\u043D\u043E \u043F\u043E\u0434\u043D\u044F\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341404
    m_Localized: "\u0420\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C
      \u043E \u0434\u043E\u0440\u043E\u0433\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341405
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A \u0432\u0438\u0434\u0435\u043B
      \u043C\u043D\u043E\u0433\u043E\u0435: \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u0447\u044C\u0438
      \u0437\u0430\u0441\u0430\u0434\u044B, \u0440\u0430\u0437\u043C\u044B\u0442\u044B\u0435
      \u0431\u0440\u043E\u0434\u044B, \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0435
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u044B. \u0415\u0433\u043E \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F
      \u0431\u0435\u0441\u0446\u0435\u043D\u043D\u044B. \u0417\u0430\u043E\u0434\u043D\u043E
      \u0432\u044B \u0432\u044B\u0443\u0447\u0438\u043B\u0438 \u043F\u0430\u0440\u0443
      \u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442\u0441\u043A\u0438\u0445 \u0441\u043B\u043E\u0432
      - \xAB\u0434\u043E\u0440\u043E\u0433\u0430\xBB \u0438 \xAB\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341406
    m_Localized: "\u0412\u043E\u0435\u043D\u043D\u044B\u0439 \u043F\u0430\u0442\u0440\u0443\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341407
    m_Localized: "\u0421\u0442\u0443\u043A \u043A\u043E\u043F\u044B\u0442, \u043B\u044F\u0437\u0433
      \u0434\u043E\u0441\u043F\u0435\u0445\u043E\u0432 - \u043A \u043B\u0430\u0433\u0435\u0440\u044E
      \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0435\u0442\u0441\u044F \u043A\u043E\u043D\u043D\u044B\u0439
      \u043F\u0430\u0442\u0440\u0443\u043B\u044C \u0442\u0430\u043D\u0441\u043A\u043E\u0439
      \u0430\u0440\u043C\u0438\u0438. \u041E\u0444\u0438\u0446\u0435\u0440 \u0432
      \u043D\u0430\u0447\u0438\u0449\u0435\u043D\u043D\u043E\u043C \u0448\u043B\u0435\u043C\u0435
      \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u043E\u043A\u043B\u0438\u043A\u0430\u0435\u0442:\r\n\r\n<npc_speech lang=\"Chinese\">\u0421\u0442\u043E\u044F\u0442\u044C!
      \u041E\u0442\u043A\u0443\u0434\u0430 \u0432\u044B, \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B?
      \u0414\u043E\u0441\u0442\u0430\u0432\u0430\u0439\u0442\u0435 \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0435!</npc_speech>\r\n\r\n\u0421\u043E\u043B\u0434\u0430\u0442\u044B
      \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0442 \u043F\u043E\u0432\u043E\u0437\u043A\u0438,
      \u0440\u0443\u043A\u0438 \u043D\u0430 \u0440\u0443\u043A\u043E\u044F\u0442\u044F\u0445
      \u043C\u0435\u0447\u0435\u0439. \u041D\u0443\u0436\u043D\u044B \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
      \u0438\u043B\u0438 \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0441\u043B\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341408
    m_Localized: "\u041F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0442\u044C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
      \u0438 \u0431\u044B\u0442\u044C \u0432\u0435\u0436\u043B\u0438\u0432\u044B\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341409
    m_Localized: "\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435,
      \u0430 \u0443\u0447\u0442\u0438\u0432\u044B\u0439 \u043F\u043E\u043A\u043B\u043E\u043D
      \u0438 \u043F\u0430\u0440\u0430 \u0444\u0440\u0430\u0437 \u043D\u0430 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C
      \u043F\u0440\u043E\u0438\u0437\u0432\u0435\u043B\u0438 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435.
      \u041E\u0444\u0438\u0446\u0435\u0440 \u043A\u0438\u0432\u043D\u0443\u043B \u0438
      \u0434\u0430\u0436\u0435 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u043B
      \u043E \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0430\u0445 \u043D\u0430
      \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341410
    m_Localized: "\u041E\u0444\u0438\u0446\u0435\u0440 \u043D\u0430\u0448\u0451\u043B
      \u043F\u0440\u0438\u0434\u0438\u0440\u043A\u0443 \u043A \u043F\u0435\u0447\u0430\u0442\u0438
      \u0438 \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B \xAB\u043F\u043E\u0448\u043B\u0438\u043D\u0443
      \u0437\u0430 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443\xBB. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C, \u0430 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0443 \u043C\u0435\u0441\u0442\u043D\u044B\u0445 \u043F\u0430\u0442\u0440\u0443\u043B\u0435\u0439
      \u0438\u0441\u043F\u043E\u0440\u0447\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341411
    m_Localized: "\u041E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F \u0441\u0440\u0430\u0437\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341412
    m_Localized: "\u0421\u0435\u0440\u0435\u0431\u0440\u043E \u0440\u0435\u0448\u0430\u0435\u0442
      \u0432\u0441\u0435 \u0432\u043E\u043F\u0440\u043E\u0441\u044B. \u041E\u0444\u0438\u0446\u0435\u0440
      \u0441\u043F\u0440\u044F\u0442\u0430\u043B \u043C\u043E\u043D\u0435\u0442\u044B
      \u0438 \u0443\u0432\u0451\u043B \u043F\u0430\u0442\u0440\u0443\u043B\u044C,
      \u043D\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044F \u0433\u0440\u0443\u0437.
      \u0411\u044B\u0441\u0442\u0440\u043E, \u043D\u043E \u043D\u0430\u043A\u043B\u0430\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341413
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341414
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0441 \u043E\u0444\u0438\u0446\u0435\u0440\u043E\u043C \u043D\u0430 \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u043E\u043C
      \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C: <npc_speech lang=\"Chinese\">\u041F\u043E\u0447\u0442\u0435\u043D\u043D\u044B\u0439,
      \u043C\u044B \u0438\u0434\u0451\u043C \u043F\u043E \u0434\u0435\u043B\u0430\u043C
      \u043F\u0440\u0435\u0444\u0435\u043A\u0442\u0443\u0440\u044B. \u041F\u043E\u0437\u0432\u043E\u043B\u044C\u0442\u0435
      \u0437\u0430\u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u043F\u043E\u0447\u0442\u0435\u043D\u0438\u0435.</npc_speech> \u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430
      \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0430\u0441\u044C \u0432
      \u0434\u0440\u0443\u0436\u0435\u0441\u043A\u0443\u044E \u0431\u0435\u0441\u0435\u0434\u0443.
      \u041F\u0430\u0442\u0440\u0443\u043B\u044C \u0443\u0448\u0451\u043B, \u043F\u043E\u0436\u0435\u043B\u0430\u0432
      \u0434\u043E\u0431\u0440\u043E\u0433\u043E \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341415
    m_Localized: "\u0421\u0441\u043E\u0440\u0430 \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341416
    m_Localized: "\u0423 \u043A\u043E\u0441\u0442\u0440\u0430 \u0432\u0441\u043F\u044B\u0445\u043D\u0443\u043B\u0430
      \u0441\u0441\u043E\u0440\u0430. \u0414\u0432\u043E\u0435 \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432
      \u043D\u0435 \u043F\u043E\u0434\u0435\u043B\u0438\u043B\u0438 \u043C\u0435\u0441\u0442\u043E
      \u0443 \u043E\u0433\u043D\u044F, \u0438 \u0441\u043B\u043E\u0432\u043E \u0437\u0430
      \u0441\u043B\u043E\u0432\u043E - \u0434\u0435\u043B\u043E \u0434\u043E\u0448\u043B\u043E
      \u0434\u043E \u043A\u0440\u0438\u043A\u0430. \u041E\u0434\u0438\u043D \u043E\u0431\u0432\u0438\u043D\u044F\u0435\u0442
      \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0432 \u043B\u0435\u043D\u0438,
      \u0432\u0442\u043E\u0440\u043E\u0439 \u043E\u0433\u0440\u044B\u0437\u0430\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E \u043F\u0435\u0440\u0432\u044B\u0439 \u0435\u0441\u0442
      \u0437\u0430 \u0434\u0432\u043E\u0438\u0445. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u043F\u0440\u0438\u0442\u0438\u0445\u043B\u0438, \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C.
      \u0415\u0441\u043B\u0438 \u043D\u0435 \u0432\u043C\u0435\u0448\u0430\u0442\u044C\u0441\u044F,
      \u0434\u043E\u0439\u0434\u0451\u0442 \u0434\u043E \u043A\u0443\u043B\u0430\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341417
    m_Localized: "\u0412\u043C\u0435\u0448\u0430\u0442\u044C\u0441\u044F \u0438 \u0440\u0430\u0441\u0441\u0443\u0434\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341418
    m_Localized: "\u0422\u0432\u0451\u0440\u0434\u044B\u0439 \u0433\u043E\u043B\u043E\u0441
      \u0438 \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E \u043E\u0441\u0442\u0443\u0434\u0438\u043B\u0438
      \u0433\u043E\u0440\u044F\u0447\u0438\u0435 \u0433\u043E\u043B\u043E\u0432\u044B.
      \u041E\u0431\u0430 \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u0430 \u043D\u0435\u0445\u043E\u0442\u044F
      \u043F\u043E\u0436\u0430\u043B\u0438 \u0440\u0443\u043A\u0438. \u041A \u0443\u0442\u0440\u0443
      \u0438\u043D\u0446\u0438\u0434\u0435\u043D\u0442 \u0437\u0430\u0431\u044B\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341419
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u043A\u0430 \u043F\u0440\u0438\u043C\u0438\u0440\u0435\u043D\u0438\u044F
      \u043B\u0438\u0448\u044C \u043F\u043E\u0434\u043B\u0438\u043B\u0430 \u043C\u0430\u0441\u043B\u0430
      \u0432 \u043E\u0433\u043E\u043D\u044C. \u041E\u0434\u0438\u043D \u0438\u0437
      \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432 \u0443\u0448\u0451\u043B
      \u0441\u043F\u0430\u0442\u044C \u043F\u043E \u0434\u0440\u0443\u0433\u0443\u044E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u043B\u0430\u0433\u0435\u0440\u044F.
      \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u0438\u0441\u043F\u043E\u0440\u0447\u0435\u043D\u043E
      \u0443 \u0432\u0441\u0435\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341420
    m_Localized: "\u041D\u0435 \u0432\u043C\u0435\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341421
    m_Localized: "\u0421\u0441\u043E\u0440\u0430 \u0437\u0430\u0442\u0438\u0445\u043B\u0430
      \u0441\u0430\u043C\u0430, \u043D\u043E \u043E\u0441\u0430\u0434\u043E\u043A
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F. \u0423\u0442\u0440\u043E\u043C
      \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u0438 \u043D\u0435 \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u044E\u0442,
      \u0430 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0445\u043E\u0434\u044F\u0442
      \u043D\u0430 \u0446\u044B\u043F\u043E\u0447\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341422
    m_Localized: "\u0418\u0441\u0442\u043E\u0440\u0438\u044F \u0443 \u043A\u043E\u0441\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341423
    m_Localized: "\u0412\u0435\u0447\u0435\u0440 \u0442\u0438\u0445. \u041A\u043E\u0441\u0442\u0451\u0440
      \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0438\u0432\u0430\u0435\u0442, \u0438\u0441\u043A\u0440\u044B
      \u0432\u0437\u043B\u0435\u0442\u0430\u044E\u0442 \u043A \u0437\u0432\u0451\u0437\u0434\u0430\u043C.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432,
      \u0440\u0430\u0437\u043E\u043C\u043B\u0435\u0432 \u043E\u0442 \u0442\u0435\u043F\u043B\u0430,
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0440\u0430\u0441\u0441\u043A\u0430\u0437.
      \u041E \u0434\u0430\u043B\u0451\u043A\u0438\u0445 \u0437\u0435\u043C\u043B\u044F\u0445,
      \u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430\u0445 \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E,
      \u043E \u0447\u0443\u0434\u0435\u0441\u0430\u0445 \u043D\u0430 \u043A\u0440\u0430\u044E
      \u043C\u0438\u0440\u0430. \u0413\u043E\u043B\u043E\u0441 \u043D\u0435\u0433\u0440\u043E\u043C\u043A\u0438\u0439,
      \u043D\u043E \u043A\u0430\u0436\u0434\u043E\u0435 \u0441\u043B\u043E\u0432\u043E
      - \u043D\u0430 \u0432\u0435\u0441 \u0437\u043E\u043B\u043E\u0442\u0430. \u0414\u0430\u0436\u0435
      \u0432\u044C\u044E\u0447\u043D\u044B\u0435 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435,
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043F\u0440\u0438\u0442\u0438\u0445\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341424
    m_Localized: "\u0421\u043B\u0443\u0448\u0430\u0442\u044C \u0434\u043E \u043A\u043E\u043D\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341425
    m_Localized: "\u0420\u0430\u0441\u0441\u043A\u0430\u0437 \u0434\u043B\u0438\u043B\u0441\u044F
      \u0434\u043E \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u043D\u043E\u0447\u0438.
      \u041A\u043E\u0433\u0434\u0430 \u0441\u043F\u0443\u0442\u043D\u0438\u043A \u0437\u0430\u043C\u043E\u043B\u0447\u0430\u043B,
      \u043D\u0430\u0434 \u043B\u0430\u0433\u0435\u0440\u0435\u043C \u043F\u043E\u0432\u0438\u0441\u043B\u0430
      \u0442\u0451\u043F\u043B\u0430\u044F \u0442\u0438\u0448\u0438\u043D\u0430.
      \u041B\u044E\u0434\u0438 \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C
      \u0441\u043F\u0430\u0442\u044C \u0441 \u0443\u043B\u044B\u0431\u043A\u0430\u043C\u0438
      - \u0437\u0430\u0432\u0442\u0440\u0430 \u0434\u043E\u0440\u043E\u0433\u0430
      \u043F\u043E\u043A\u0430\u0436\u0435\u0442\u0441\u044F \u043B\u0435\u0433\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341426
    m_Localized: "\u041F\u043E\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u0441\u0432\u043E\u0435\u0439
      \u0438\u0441\u0442\u043E\u0440\u0438\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341427
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u0445\u0432\u0430\u0442\u0438\u043B\u0438
      \u043D\u0438\u0442\u044C \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430 \u0438
      \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0438 \u0441\u0432\u043E\u044E \u0438\u0441\u0442\u043E\u0440\u0438\u044E
      - \u043E \u043F\u0435\u0440\u0432\u043E\u043C \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435,
      \u043E \u0431\u0443\u0440\u0435 \u0432 \u0433\u043E\u0440\u0430\u0445, \u043E
      \u0441\u043C\u0435\u0445\u0435 \u043D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435. \u041B\u044E\u0434\u0438
      \u0441\u043B\u0443\u0448\u0430\u043B\u0438, \u0437\u0430\u0442\u0430\u0438\u0432
      \u0434\u044B\u0445\u0430\u043D\u0438\u0435. \u0423\u0442\u0440\u043E\u043C
      - \u043A\u0440\u0435\u043F\u0447\u0435 \u0434\u0443\u0445, \u0442\u0435\u0441\u043D\u0435\u0435
      \u043A\u0440\u0443\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341428
    m_Localized: "\u0412\u0430\u0448\u0430 \u0438\u0441\u0442\u043E\u0440\u0438\u044F
      \u043D\u0435 \u0442\u0430\u043A \u0445\u043E\u0440\u043E\u0448\u0430, \u043A\u0430\u043A
      \u0443 \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u0430, \u043D\u043E \u043F\u043E\u043F\u044B\u0442\u043A\u0430
      \u043E\u0446\u0435\u043D\u0435\u043D\u0430. \u041B\u044E\u0434\u0438 \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0438\u0441\u044C,
      \u0438 \u044D\u0442\u043E \u0442\u043E\u0436\u0435 \u0447\u0435\u0433\u043E-\u0442\u043E
      \u0441\u0442\u043E\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341429
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u043E\u0435 \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341430
    m_Localized: "\u0412\u0435\u0440\u0431\u043B\u044E\u0434 (\u0438\u043B\u0438
      \u044F\u043A, \u0438\u043B\u0438 \u043B\u043E\u0448\u0430\u0434\u044C) \u043D\u0435
      \u0432\u0441\u0442\u0430\u043B \u0441 \u0443\u0442\u0440\u0430. \u0411\u043E\u043A\u0430
      \u0432\u0437\u0434\u0443\u0442\u044B, \u0433\u043B\u0430\u0437\u0430 \u043C\u0443\u0442\u043D\u044B\u0435,
      \u0438\u0437 \u043F\u0430\u0441\u0442\u0438 - \u043F\u0435\u043D\u0430. \u0422\u043E
      \u043B\u0438 \u043E\u0442\u0440\u0430\u0432\u0438\u043B\u0441\u044F, \u0442\u043E
      \u043B\u0438 \u043F\u043E\u0434\u0445\u0432\u0430\u0442\u0438\u043B \u0441\u0442\u0435\u043F\u043D\u0443\u044E
      \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0443. \u0415\u0441\u043B\u0438
      \u043D\u0435 \u0432\u044B\u043B\u0435\u0447\u0438\u0442\u044C, \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435
      \u0443\u043C\u0440\u0451\u0442, \u0430 \u0431\u0435\u0437 \u0442\u044F\u0433\u043B\u043E\u0432\u043E\u0439
      \u0441\u0438\u043B\u044B \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0437\u0430\u043C\u0435\u0434\u043B\u0438\u0442\u0441\u044F
      \u0438\u043B\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u0442 \u0433\u0440\u0443\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341431
    m_Localized: "\u041B\u0435\u0447\u0438\u0442\u044C \u043F\u043E\u0434\u0440\u0443\u0447\u043D\u044B\u043C\u0438
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341432
    m_Localized: "\u0421\u0442\u0435\u043F\u043D\u044B\u0435 \u0442\u0440\u0430\u0432\u044B,
      \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0435 \u0443 \u0442\u0440\u043E\u043F\u044B,
      \u0438 \u043F\u0440\u043E\u043C\u044B\u0432\u0430\u043D\u0438\u0435 \u0432\u043E\u0434\u043E\u0439
      \u043F\u043E\u043C\u043E\u0433\u043B\u0438. \u041A \u043F\u043E\u043B\u0443\u0434\u043D\u044E
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u043F\u043E\u0434\u043D\u044F\u043B\u043E\u0441\u044C,
      \u0445\u043E\u0442\u044C \u0438 \u043F\u043E\u0448\u0430\u0442\u044B\u0432\u0430\u044F\u0441\u044C.
      \u041F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u043D\u0430 \u043A\u043E\u043C\u043F\u0440\u0435\u0441\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341433
    m_Localized: "\u041B\u0435\u0447\u0435\u043D\u0438\u0435 \u043D\u0435 \u043F\u043E\u043C\u043E\u0433\u043B\u043E
      - \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u0441\u043B\u0430\u0431\u0435\u0435\u0442.
      \u0427\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043F\u0435\u0440\u0435\u043B\u043E\u0436\u0438\u0442\u044C, \u0430 \u0434\u043E\u043F.
      \u0442\u0435\u043B\u0435\u0433\u0430 \u043F\u0440\u043E\u0441\u0435\u0434\u0430\u0435\u0442
      \u043F\u043E\u0434 \u0432\u0435\u0441\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341434
    m_Localized: "\u0417\u0430\u0431\u0438\u0442\u044C \u043D\u0430 \u043C\u044F\u0441\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341435
    m_Localized: "\u0420\u0435\u0448\u0435\u043D\u0438\u0435 \u043F\u0440\u0438\u043D\u044F\u0442\u043E
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E. \u041C\u044F\u0441\u043E \u0437\u0430\u0441\u043E\u043B\u0435\u043D\u043E
      \u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u0435\u043D\u043E \u043A \u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C.
      \u041D\u043E \u0442\u044F\u0433\u043B\u043E\u0432\u0430\u044F \u0441\u0438\u043B\u0430
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u0430 - \u0434\u043E\u043F. \u0442\u0435\u043B\u0435\u0433\u0443
      \u0442\u044F\u043D\u0443\u0442\u044C \u043D\u0435\u043A\u043E\u043C\u0443,
      \u0433\u0440\u0443\u0437 \u0434\u0430\u0432\u0438\u0442 \u043D\u0430 \u043E\u0441\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341436
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0437\u043D\u0430\u0435\u0442
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341437
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u0438 \u0437\u0430\u0432\u0430\u0440\u0438\u043B
      \u043E\u0442\u0432\u0430\u0440 \u0438\u0437 \u0441\u0432\u043E\u0438\u0445
      \u0437\u0430\u043F\u0430\u0441\u043E\u0432. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0437\u0432\u0435\u0440\u044C \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F
      \u0438 \u0434\u0430\u0436\u0435 \u043F\u043E\u0442\u044F\u043D\u0443\u043B\u0441\u044F
      \u043A \u043A\u043E\u0440\u043C\u0443. \u041B\u0435\u043A\u0430\u0440\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0436\u0430\u043B \u043F\u043B\u0435\u0447\u0430\u043C\u0438
      - \u043E\u0431\u044B\u0447\u043D\u043E\u0435 \u0441\u0442\u0435\u043F\u043D\u043E\u0435
      \u0441\u043D\u0430\u0434\u043E\u0431\u044C\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341438
    m_Localized: "\u041F\u043E\u043B\u043E\u043C\u043A\u0430 \u043F\u0440\u0438 \u043F\u043E\u0447\u0438\u043D\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341439
    m_Localized: "\u041F\u0440\u0438\u0432\u0430\u043B \u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u043C\u043E\u043C\u0435\u043D\u0442\u043E\u043C
      \u0434\u043B\u044F \u043F\u043E\u0447\u0438\u043D\u043A\u0438 \u0440\u0430\u0441\u0448\u0430\u0442\u0430\u043D\u043D\u043E\u0433\u043E
      \u043A\u043E\u043B\u0435\u0441\u0430. \u041D\u043E \u0441\u0442\u043E\u0438\u043B\u043E
      \u043F\u043E\u0434\u0434\u043E\u043C\u043A\u0440\u0430\u0442\u0438\u0442\u044C
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443, \u043A\u0430\u043A \u043E\u043F\u043E\u0440\u0430
      \u0441\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0430. \u041F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0440\u0443\u0445\u043D\u0443\u043B\u0430 \u043D\u0430 \u0431\u043E\u043A,
      \u043A\u043E\u043B\u0435\u0441\u043E \u0442\u0440\u0435\u0441\u043D\u0443\u043B\u043E
      \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0440\u0435\u043C\u043E\u043D\u0442\u0430 \u043D\u0443\u0436\u043D\u043E \u0432\u0434\u0432\u043E\u0435
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0430 \u0437\u0430\u043F\u0430\u0441\u043D\u044B\u0445
      \u0447\u0430\u0441\u0442\u0435\u0439 - \u0432\u0434\u0432\u043E\u0435 \u043C\u0435\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341440
    m_Localized: "\u0427\u0438\u043D\u0438\u0442\u044C \u043A\u0430\u043A \u0435\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341441
    m_Localized: "\u0421 \u0442\u0440\u0435\u0442\u044C\u0435\u0439 \u043F\u043E\u043F\u044B\u0442\u043A\u0438
      \u043A\u043E\u043B\u0435\u0441\u043E \u0441\u0435\u043B\u043E \u043D\u0430
      \u043E\u0441\u044C. \u041D\u0435 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E,
      \u043D\u043E \u0434\u0435\u0440\u0436\u0438\u0442. \u0420\u0443\u043A\u0438
      \u0432 \u0437\u0430\u043D\u043E\u0437\u0430\u0445, \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B \u043D\u0430 \u043A\u043B\u0438\u043D\u044C\u044F,
      \u0437\u0430\u0442\u043E \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u043D\u0430
      \u0445\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341442
    m_Localized: "\u041A\u043E\u043B\u0435\u0441\u043E \u0440\u0430\u0437\u0432\u0430\u043B\u0438\u043B\u043E\u0441\u044C
      \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044C \u0437\u0430\u043F\u0430\u0441\u043D\u044B\u0435
      \u0434\u043E\u0441\u043A\u0438 \u043E\u0442 \u0434\u043E\u043F. \u0442\u0435\u043B\u0435\u0433\u0438
      \u0438 \u0438\u043C\u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0430 \u043A\u043E\u0432\u044B\u043B\u044F\u0435\u0442,
      \u0430 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u043D\u0430
      \u043D\u0443\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341443
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u0438\u0442\u044C
      \u0438 \u0435\u0445\u0430\u0442\u044C \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341444
    m_Localized: "\u041F\u043E\u0432\u043E\u0437\u043A\u0443 \u043F\u043E\u0434\u043B\u0430\u0442\u0430\u043B\u0438
      \u043A\u043E\u0435-\u043A\u0430\u043A, \u0447\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430
      \u043F\u0435\u0440\u0435\u0431\u0440\u043E\u0448\u0435\u043D\u0430 \u043D\u0430
      \u0434\u043E\u043F. \u0442\u0435\u043B\u0435\u0433\u0443. \u041E\u0431\u0435
      \u0442\u0435\u043F\u0435\u0440\u044C \u0441\u043A\u0440\u0438\u043F\u044F\u0442,
      \u043D\u043E \u0434\u0432\u0438\u0436\u0443\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341445
    m_Localized: "\u0412\u043D\u0435\u0437\u0430\u043F\u043D\u0430\u044F \u0431\u0443\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341446
    m_Localized: "\u0412\u0435\u0442\u0435\u0440 \u0443\u0434\u0430\u0440\u0438\u043B
      \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F.
      \u0421\u0435\u043A\u0443\u043D\u0434\u0443 \u043D\u0430\u0437\u0430\u0434 -
      \u0437\u0432\u0451\u0437\u0434\u043D\u043E\u0435 \u043D\u0435\u0431\u043E,
      \u0438 \u0432\u043E\u0442 \u0443\u0436\u0435 \u0448\u0430\u0442\u0451\u0440
      \u0440\u0432\u0451\u0442\u0441\u044F \u0438\u0437 \u043A\u043E\u043B\u044C\u0435\u0432,
      \u043F\u0435\u0441\u043E\u043A \u0445\u043B\u0435\u0449\u0435\u0442 \u043F\u043E
      \u043B\u0438\u0446\u0430\u043C. \u0411\u0443\u0440\u044F \u043D\u0430\u043B\u0435\u0442\u0435\u043B\u0430
      \u0441\u0442\u0435\u043D\u043E\u0439: \u0434\u043E\u0436\u0434\u044C (\u0438\u043B\u0438
      \u043F\u0435\u0441\u043E\u043A \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435)
      \u0437\u0430\u043B\u0438\u0432\u0430\u0435\u0442 \u043A\u043E\u0441\u0442\u0451\u0440,
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0440\u0430\u0441\u043A\u0430\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F.
      \u0412\u0441\u0451 \u043D\u0443\u0436\u043D\u043E \u0437\u0430\u043A\u0440\u0435\u043F\u0438\u0442\u044C,
      \u0438\u043D\u0430\u0447\u0435 \u0443\u0442\u0440\u043E\u043C - \u043E\u0434\u043D\u0438
      \u0449\u0435\u043F\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341447
    m_Localized: "\u0417\u0430\u043A\u0440\u0435\u043F\u0438\u0442\u044C \u0432\u0441\u0451"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341448
    m_Localized: "\u0412\u0435\u0440\u0451\u0432\u043A\u0438 \u043D\u0430\u0442\u044F\u043D\u0443\u0442\u044B,
      \u0442\u044E\u043A\u0438 \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D\u044B,
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043F\u043E\u0434\u043F\u0451\u0440\u0442\u044B
      \u043A\u0430\u043C\u043D\u044F\u043C\u0438. \u0411\u0443\u0440\u044F \u0431\u0443\u0448\u0435\u0432\u0430\u043B\u0430
      \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430, \u043D\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u044B\u0441\u0442\u043E\u044F\u043B.
      \u041F\u0440\u043E\u043C\u043E\u043A\u043B\u0438 \u0438 \u0443\u0441\u0442\u0430\u043B\u0438,
      \u043D\u043E \u0446\u0435\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341449
    m_Localized: "\u0412\u0435\u0442\u0435\u0440 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435. \u0428\u0430\u0442\u0451\u0440
      \u0443\u043D\u0435\u0441\u043B\u043E, \u0434\u0432\u0430 \u0442\u044E\u043A\u0430
      \u043F\u0440\u043E\u043C\u043E\u043A\u043B\u0438 \u043D\u0430\u0441\u043A\u0432\u043E\u0437\u044C,
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430
      \u0431\u043E\u0440\u0442. \u0423\u0442\u0440\u043E\u043C - \u043A\u0430\u0440\u0442\u0438\u043D\u0430
      \u0440\u0430\u0437\u0433\u0440\u043E\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341450
    m_Localized: "\u0423\u043A\u0440\u044B\u0442\u044C\u0441\u044F \u0438 \u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341451
    m_Localized: "\u041B\u044E\u0434\u0438 \u0437\u0430\u0431\u0438\u043B\u0438\u0441\u044C
      \u043F\u043E\u0434 \u043F\u043E\u0432\u043E\u0437\u043A\u0438, \u043D\u0430\u043A\u0440\u044B\u0432\u0448\u0438\u0441\u044C
      \u0447\u0435\u043C \u043F\u043E\u043F\u0430\u043B\u043E. \u0411\u0443\u0440\u044F
      \u043F\u0440\u043E\u0448\u043B\u0430, \u043D\u043E \u0443\u0442\u0440\u043E\u043C
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D \u0443\u0449\u0435\u0440\u0431:
      \u043C\u043E\u043A\u0440\u044B\u0435 \u043F\u0440\u0438\u043F\u0430\u0441\u044B,
      \u043F\u043E\u043A\u043E\u0440\u0451\u0436\u0435\u043D\u043D\u044B\u0435 \u0431\u043E\u0440\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341452
    m_Localized: "\u0417\u043C\u0435\u044F \u0432 \u0432\u0435\u0449\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341453
    m_Localized: "\u0423\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u0441\u0431\u043E\u0440
      - \u0438 \u0432\u0434\u0440\u0443\u0433 \u043A\u0440\u0438\u043A. \u0418\u0437-\u043F\u043E\u0434
      \u0441\u0451\u0434\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043C\u0435\u0448\u043A\u0430
      \u0432\u044B\u043F\u043E\u043B\u0437\u0430\u0435\u0442 \u0433\u0430\u0434\u044E\u043A\u0430,
      \u0441\u0432\u0435\u0440\u043D\u0443\u0432\u0448\u0430\u044F\u0441\u044F \u0437\u0430
      \u043D\u043E\u0447\u044C \u0432 \u0442\u0435\u043F\u043B\u0435 \u043F\u043E\u043A\u043B\u0430\u0436\u0438.
      \u0422\u0432\u0430\u0440\u044C \u0448\u0438\u043F\u0438\u0442, \u0433\u043E\u0442\u043E\u0432\u0430\u044F
      \u043A \u0431\u0440\u043E\u0441\u043A\u0443. \u041E\u0434\u0438\u043D \u0438\u0437
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u0437\u0430\u043C\u0435\u0440
      \u0432 \u0448\u0430\u0433\u0435 \u043E\u0442 \u043D\u0435\u0451, \u0431\u043E\u044F\u0441\u044C
      \u043F\u043E\u0448\u0435\u0432\u0435\u043B\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341454
    m_Localized: "\u0423\u0431\u0438\u0442\u044C \u043F\u0430\u043B\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341455
    m_Localized: "\u0422\u043E\u0447\u043D\u044B\u0439 \u0443\u0434\u0430\u0440 -
      \u0437\u043C\u0435\u044F \u043E\u0431\u043C\u044F\u043A\u043B\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043E\u0442\u043E\u0448\u0451\u043B \u043D\u0430 \u0432\u0430\u0442\u043D\u044B\u0445
      \u043D\u043E\u0433\u0430\u0445, \u043D\u043E \u0446\u0435\u043B. \u0412\u0435\u0449\u0438
      \u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u044B, \u0431\u043E\u043B\u044C\u0448\u0435
      \u0433\u0430\u0434\u043E\u0432 \u043D\u0435 \u043D\u0430\u0448\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341456
    m_Localized: "\u041F\u0440\u043E\u043C\u0430\u0445\u043D\u0443\u043B\u0438\u0441\u044C.
      \u0417\u043C\u0435\u044F \u0443\u043A\u0443\u0441\u0438\u043B\u0430 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430
      \u0432 \u0440\u0443\u043A\u0443. \u0420\u0430\u043D\u0443 \u043F\u0440\u043E\u043C\u044B\u043B\u0438,
      \u043D\u043E \u0440\u0443\u043A\u0430 \u043E\u043F\u0443\u0445\u043B\u0430
      - \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432\u044B\u0431\u044B\u043B
      \u043D\u0430 \u0434\u0435\u043D\u044C. \u041F\u0440\u0438\u043F\u0430\u0441\u044B
      \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341457
    m_Localized: "\u041E\u0442\u043E\u0433\u043D\u0430\u0442\u044C \u0434\u044B\u043C\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341458
    m_Localized: "\u0414\u044B\u043C\u044F\u0449\u0430\u044F\u0441\u044F \u0432\u0435\u0442\u043A\u0430
      \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u0437\u043C\u0435\u044E
      \u0443\u043F\u043E\u043B\u0437\u0442\u0438, \u043D\u043E \u043F\u043E\u043A\u0430
      \u0432\u043E\u0437\u0438\u043B\u0438\u0441\u044C \u0441 \u0434\u044B\u043C\u043E\u043C,
      \u043A\u043E\u0441\u0442\u0451\u0440 \u043F\u043E\u0434\u043F\u0430\u043B\u0438\u043B
      \u043A\u0440\u0430\u0439 \u043C\u0435\u0448\u043A\u0430 \u0441 \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341459
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u0431\u0435\u0437\u0432\u0440\u0435\u0436\u0438\u0432\u0430\u0435\u0442
      \u0437\u043C\u0435\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341460
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0431\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0430
      \u043F\u043E\u0434\u043E\u0448\u0451\u043B \u043A \u0437\u043C\u0435\u0435
      \u0438 \u043B\u043E\u0432\u043A\u043E \u0443\u0445\u0432\u0430\u0442\u0438\u043B
      \u0437\u0430 \u0448\u0435\u044E. \u0421\u0446\u0435\u0434\u0438\u043B \u044F\u0434
      \u0432 \u0441\u043A\u043B\u044F\u043D\u043A\u0443 - \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F
      \u0434\u043B\u044F \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u0441 \u0431\u043B\u0430\u0433\u043E\u0433\u043E\u0432\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341461
    m_Localized: "\u041D\u0430\u0432\u043E\u0434\u043D\u0435\u043D\u0438\u0435 \u0432
      \u043B\u0430\u0433\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341462
    m_Localized: "\u0414\u043E\u0436\u0434\u044C \u0448\u0451\u043B \u0433\u0434\u0435-\u0442\u043E
      \u0432 \u0433\u043E\u0440\u0430\u0445, \u0430 \u0432 \u043B\u0430\u0433\u0435\u0440\u0435
      \u0431\u044B\u043B\u043E \u0441\u0443\u0445\u043E. \u041D\u043E \u0441\u0440\u0435\u0434\u0438
      \u043D\u043E\u0447\u0438 \u0432\u043E\u0434\u0430 \u043F\u0440\u0438\u0448\u043B\u0430:
      \u043C\u0443\u0442\u043D\u044B\u0439 \u043F\u043E\u0442\u043E\u043A \u0445\u043B\u044B\u043D\u0443\u043B
      \u043F\u043E \u0440\u0443\u0441\u043B\u0443, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u0448\u0438\u043C.
      \u0412\u043E\u0434\u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F,
      \u0437\u0430\u043B\u0438\u0432\u0430\u044F \u043D\u0438\u0436\u043D\u0438\u0435
      \u0442\u044E\u043A\u0438. \u041D\u0443\u0436\u043D\u043E \u0441\u043F\u0430\u0441\u0430\u0442\u044C
      \u0433\u0440\u0443\u0437 \u0438 \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0432\u043E\u0437\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341463
    m_Localized: "\u0421\u043F\u0430\u0441\u0430\u0442\u044C \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341464
    m_Localized: "\u0416\u0438\u0432\u0430\u044F \u0446\u0435\u043F\u043E\u0447\u043A\u0430
      \u0438\u0437 \u0440\u0443\u043A - \u0442\u044E\u043A\u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u044E\u0442\u0441\u044F
      \u043D\u0430\u0432\u0435\u0440\u0445, \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043E\u0442\u043A\u0430\u0442\u044B\u0432\u0430\u044E\u0442\u0441\u044F. \u041F\u0440\u043E\u043C\u043E\u043A\u043B\u0438
      \u0434\u043E \u043D\u0438\u0442\u043A\u0438, \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0438,
      \u043D\u043E \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u0433\u0440\u0443\u0437
      \u0441\u043F\u0430\u0441\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341465
    m_Localized: "\u0412\u043E\u0434\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435. \u0414\u0432\u0430 \u043C\u0435\u0448\u043A\u0430
      \u0441 \u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C\u0438 \u0443\u043D\u0435\u0441\u043B\u043E
      \u0442\u0435\u0447\u0435\u043D\u0438\u0435\u043C, \u043A\u043E\u043B\u0451\u0441\u0430
      \u0443\u0432\u044F\u0437\u043B\u0438 \u0432 \u0433\u0440\u044F\u0437\u0438,
      \u0430 \u0443\u0442\u0440\u043E\u043C - \u0432\u0441\u0451 \u0432 \u0438\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341466
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u043D\u0438\u0436\u043D\u0438\u0435
      \u0442\u044E\u043A\u0438, \u0441\u043F\u0430\u0441\u0442\u0438 \u043B\u044E\u0434\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341467
    m_Localized: "\u041B\u044E\u0434\u0438 \u0432\u0430\u0436\u043D\u0435\u0435 \u0433\u0440\u0443\u0437\u0430.
      \u0412\u0441\u0435 \u043D\u0430 \u0432\u043E\u0437\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0441\u0442\u0438,
      \u043D\u043E \u0442\u0440\u0438 \u043C\u0435\u0448\u043A\u0430 \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0438
      \u0443\u043F\u043B\u044B\u043B\u0438 \u0432\u043D\u0438\u0437 \u043F\u043E
      \u0440\u0443\u0441\u043B\u0443. \u0423\u0442\u0440\u043E\u043C - \u0433\u043E\u043B\u043E\u0434\u043D\u044B\u0435
      \u0433\u043B\u0430\u0437\u0430 \u0438 \u043C\u043E\u043A\u0440\u0430\u044F
      \u0437\u0435\u043C\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341468
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u043B
      \u043F\u0440\u043E \u0440\u0443\u0441\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341469
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0435\u0449\u0451
      \u043F\u0440\u0438 \u0440\u0430\u0437\u0431\u0438\u0432\u043A\u0435 \u043B\u0430\u0433\u0435\u0440\u044F
      \u043D\u0430\u0441\u0442\u043E\u044F\u043B \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u0442\u0438
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0432\u044B\u0448\u0435. \u041A\u043E\u0433\u0434\u0430
      \u0432\u043E\u0434\u0430 \u043F\u0440\u0438\u0448\u043B\u0430, \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0441\u0442\u043E\u044F\u043B \u043D\u0430 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u043C
      \u0445\u043E\u043B\u043C\u0435. \u041F\u0440\u043E\u043C\u043E\u043A\u043B\u0438
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341470
    m_Localized: "\u0417\u0432\u0451\u0437\u0434\u043D\u0430\u044F \u043D\u043E\u0447\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341471
    m_Localized: "\u0411\u0435\u0437\u043E\u0431\u043B\u0430\u0447\u043D\u043E\u0435
      \u043D\u0435\u0431\u043E \u0440\u0430\u0441\u043A\u0438\u043D\u0443\u043B\u043E\u0441\u044C
      \u043E\u0442 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430 \u0434\u043E
      \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430 - \u043C\u0438\u043B\u043B\u0438\u043E\u043D
      \u0437\u0432\u0451\u0437\u0434, \u041C\u043B\u0435\u0447\u043D\u044B\u0439
      \u041F\u0443\u0442\u044C \u0440\u0435\u043A\u043E\u0439. \u0412\u043E\u0437\u0434\u0443\u0445
      \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u0435\u043D \u0438 \u0447\u0438\u0441\u0442.
      \u0422\u0438\u0448\u0438\u043D\u0430 \u0442\u0430\u043A\u0430\u044F, \u0447\u0442\u043E
      \u0441\u043B\u044B\u0448\u043D\u043E \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0438\u0432\u0430\u043D\u0438\u0435
      \u0443\u0433\u043B\u0435\u0439 \u0438 \u0434\u044B\u0445\u0430\u043D\u0438\u0435
      \u0441\u043F\u044F\u0449\u0438\u0445 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432.
      \u0420\u0435\u0434\u043A\u0430\u044F \u043D\u043E\u0447\u044C \u043F\u043E\u043A\u043E\u044F
      \u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341472
    m_Localized: "\u041D\u0430\u0441\u043B\u0430\u0436\u0434\u0430\u0442\u044C\u0441\u044F
      \u043F\u043E\u043A\u043E\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341473
    m_Localized: "\u041B\u044E\u0434\u0438 \u043B\u0435\u0436\u0430\u0442 \u043D\u0430
      \u0441\u043F\u0438\u043D\u0430\u0445, \u0433\u043B\u044F\u0434\u044F \u0432
      \u043D\u0435\u0431\u043E. \u041A\u0442\u043E-\u0442\u043E \u0442\u0438\u0445\u043E
      \u043D\u0430\u043F\u0435\u0432\u0430\u0435\u0442. \u041D\u0438 \u0442\u0440\u0435\u0432\u043E\u0433,
      \u043D\u0438 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0435\u0439 -
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u043E\u0447\u044C, \u0437\u0432\u0451\u0437\u0434\u044B
      \u0438 \u0434\u043E\u0440\u043E\u0433\u0430 \u0432\u043F\u0435\u0440\u0435\u0434\u0438.
      \u0423\u0442\u0440\u043E\u043C \u0432\u0441\u0435 \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0432\u0448\u0438\u0435
      \u0438 \u043F\u043E\u043B\u043D\u044B\u0435 \u0441\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341474
    m_Localized: "\u0418\u0437\u0443\u0447\u0438\u0442\u044C \u0437\u0432\u0451\u0437\u0434\u044B
      \u0434\u043B\u044F \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341475
    m_Localized: "\u041F\u043E \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044E
      \u0441\u043E\u0437\u0432\u0435\u0437\u0434\u0438\u0439 \u0432\u044B \u0432\u044B\u0432\u0435\u0440\u0438\u043B\u0438
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0438 \u043D\u0430\u0448\u043B\u0438
      \u043E\u0448\u0438\u0431\u043A\u0443 - \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043E\u0442\u043A\u043B\u043E\u043D\u0438\u043B\u0441\u044F \u043E\u0442 \u043F\u0443\u0442\u0438
      \u043D\u0430 \u043F\u043E\u043B\u0434\u043D\u044F. \u0421\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u0432
      \u043A\u0443\u0440\u0441, \u0432\u044B \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u0435
      \u0432\u0440\u0435\u043C\u044F \u0438 \u043E\u0431\u043E\u0439\u0434\u0451\u0442\u0435
      \u043E\u043F\u0430\u0441\u043D\u044B\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341476
    m_Localized: "\u0417\u0432\u0451\u0437\u0434\u044B \u043A\u0440\u0430\u0441\u0438\u0432\u044B,
      \u043D\u043E \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445
      \u0432\u044B\u0432\u043E\u0434\u043E\u0432 \u0441\u0434\u0435\u043B\u0430\u0442\u044C
      \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C - \u043D\u0430\u0432\u044B\u043A\u0430
      \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442. \u0417\u0430\u0442\u043E
      \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u0432\u0441\u0451
      \u0440\u0430\u0432\u043D\u043E \u043F\u043E\u0434\u043D\u044F\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341477
    m_Localized: "\u0412\u0435\u0449\u0438\u0439 \u0441\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341478
    m_Localized: "\u041F\u043E\u0434 \u0443\u0442\u0440\u043E \u0432\u0430\u043C
      \u043F\u0440\u0438\u0441\u043D\u0438\u043B\u0441\u044F \u043D\u0435\u043E\u0431\u044B\u0447\u0430\u0439\u043D\u043E
      \u044F\u0440\u043A\u0438\u0439 \u0441\u043E\u043D. \u0413\u043E\u043B\u043E\u0441
      (\u043D\u0435 \u043C\u0443\u0436\u0441\u043A\u043E\u0439, \u043D\u0435 \u0436\u0435\u043D\u0441\u043A\u0438\u0439)
      \u043F\u0440\u043E\u0438\u0437\u043D\u0451\u0441 \u0441\u043B\u043E\u0432\u0430
      \u043D\u0430 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u043E\u043C \u044F\u0437\u044B\u043A\u0435.
      \u0417\u0430\u0442\u0435\u043C \u0432\u0438\u0434\u0435\u043D\u0438\u0435:
      \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0430 \u0434\u043E\u0440\u043E\u0433\u0438:
      \u0441 \u043E\u0434\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B
      \u0437\u043E\u043B\u043E\u0442\u043E\u0439 \u0441\u0432\u0435\u0442, \u0441
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0447\u0451\u0440\u043D\u044B\u0439 \u0434\u044B\u043C.
      \u0412\u044B \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0438\u0441\u044C \u0432
      \u043F\u043E\u0442\u0443, \u0441 \u0431\u044C\u044E\u0449\u0438\u043C\u0441\u044F
      \u0441\u0435\u0440\u0434\u0446\u0435\u043C. \u0427\u0442\u043E \u044D\u0442\u043E
      - \u043F\u0440\u0435\u0434\u0437\u043D\u0430\u043C\u0435\u043D\u043E\u0432\u0430\u043D\u0438\u0435
      \u0438\u043B\u0438 \u0443\u0441\u0442\u0430\u043B\u044B\u0439 \u0440\u0430\u0437\u0443\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341479
    m_Localized: "\u0421\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C \u0437\u043D\u0430\u043A\u0443
      - \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u043C\u0430\u0440\u0448\u0440\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341480
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0441\u0432\u0435\u0440\u043D\u0443\u043B
      \u043D\u0430 \u043E\u0431\u0445\u043E\u0434\u043D\u0443\u044E \u0442\u0440\u043E\u043F\u0443.
      \u041F\u0443\u0442\u044C \u0434\u043B\u0438\u043D\u043D\u0435\u0435, \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u0443\u0448\u043B\u043E \u0431\u043E\u043B\u044C\u0448\u0435, \u043D\u043E
      \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A \u043F\u043E\u0437\u0436\u0435
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B: \u043D\u0430 \u0433\u043B\u0430\u0432\u043D\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0435 \u0432\u0438\u0434\u0435\u043B\u0438 \u0441\u043B\u0435\u0434\u044B
      \u0437\u0430\u0441\u0430\u0434\u044B. \u0421\u043E\u043D \u043D\u0435 \u0441\u043E\u043B\u0433\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341481
    m_Localized: "\u0418\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      - \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341482
    m_Localized: "\u0412\u044B \u043E\u0442\u043C\u0430\u0445\u043D\u0443\u043B\u0438\u0441\u044C
      \u043E\u0442 \u0432\u0438\u0434\u0435\u043D\u0438\u044F. \u041D\u043E \u0432\u0435\u0441\u044C
      \u0434\u0435\u043D\u044C \u0441\u043E\u043D \u043D\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u043B
      \u0438\u0437 \u0433\u043E\u043B\u043E\u0432\u044B, \u0430 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0448\u0435\u043F\u0442\u0430\u043B\u0438\u0441\u044C. \u041A\u043E\u0433\u0434\u0430
      \u043A \u0432\u0435\u0447\u0435\u0440\u0443 \u0434\u043E\u0440\u043E\u0433\u0443
      \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0434\u0438\u043B \u0437\u0430\u0432\u0430\u043B,
      \u043C\u043D\u043E\u0433\u0438\u0435 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B\u0438
      \u0432\u0430\u0448 \u0440\u0430\u0441\u0441\u043A\u0430\u0437 \u0437\u0430
      \u0437\u0430\u0432\u0442\u0440\u0430\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341483
    m_Localized: "\u041E\u0433\u043E\u043D\u044C\u043A\u0438 \u0432 \u043D\u043E\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341484
    m_Localized: "\u0427\u0430\u0441\u043E\u0432\u043E\u0439 \u0440\u0430\u0441\u0442\u043E\u043B\u043A\u0430\u043B
      \u0432\u0430\u0441 \u0441\u0440\u0435\u0434\u0438 \u043D\u043E\u0447\u0438.
      \u041D\u0430 \u0440\u0430\u0432\u043D\u0438\u043D\u0435 (\u0438\u043B\u0438
      \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435, \u0438\u043B\u0438 \u0443
      \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F \u0433\u043E\u0440) \u043C\u0435\u0440\u0446\u0430\u044E\u0442
      \u0434\u0435\u0441\u044F\u0442\u043A\u0438 \u0431\u043B\u0435\u0434\u043D\u044B\u0445
      \u043E\u0433\u043E\u043D\u044C\u043A\u043E\u0432 - \u0437\u0435\u043B\u0435\u043D\u043E\u0432\u0430\u0442\u044B\u0445,
      \u043F\u043B\u0430\u0432\u043D\u043E \u043F\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0445\u0441\u044F.
      \u041D\u0435 \u0444\u0430\u043A\u0435\u043B\u044B, \u043D\u0435 \u0437\u0432\u0451\u0437\u0434\u044B.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0440\u0435\u0448\u0438\u043B\u0438,
      \u0447\u0442\u043E \u044D\u0442\u043E \u0434\u0436\u0438\u043D\u043D\u044B,
      \u0438 \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C \u0438\u0437 \u043A\u0440\u0443\u0433\u0430
      \u043A\u043E\u0441\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341485
    m_Localized: "\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u043E\u0433\u043E\u043D\u044C\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341486
    m_Localized: "\u0411\u043E\u043B\u043E\u0442\u043D\u044B\u0439 \u0433\u0430\u0437.
      \u041E\u0433\u043E\u043D\u044C\u043A\u0438 - \u043C\u0435\u0442\u0430\u043D,
      \u0432\u044B\u0445\u043E\u0434\u044F\u0449\u0438\u0439 \u0438\u0437 \u0442\u0440\u0435\u0449\u0438\u043D
      \u0432 \u0437\u0435\u043C\u043B\u0435. \u0412\u044B \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0438
      \u0433\u043E\u0440\u0441\u0442\u044C \u0441\u0432\u0435\u0442\u044F\u0449\u0435\u0439\u0441\u044F
      \u0433\u0440\u044F\u0437\u0438 \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438
      \u043B\u044E\u0434\u044F\u043C. \u0421\u043C\u0435\u0445 \u0440\u0430\u0437\u043E\u0433\u043D\u0430\u043B
      \u0441\u0442\u0440\u0430\u0445, \u0430 \u0437\u0430\u043E\u0434\u043D\u043E
      \u0432\u044B \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438 \u043F\u0440\u0438\u0437\u043D\u0430\u043A
      \u043F\u043E\u0434\u0437\u0435\u043C\u043D\u044B\u0445 \u0432\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341487
    m_Localized: "\u0412\u044B \u0434\u043E\u0448\u043B\u0438 \u0434\u043E \u043E\u0433\u043E\u043D\u044C\u043A\u043E\u0432,
      \u043D\u043E \u043E\u043D\u0438 \u043F\u043E\u0433\u0430\u0441\u043B\u0438
      \u043F\u0440\u0438 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u0438.
      \u0412\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u043D\u0438 \u0441
      \u0447\u0435\u043C, \u0430 \u043B\u044E\u0434\u0438 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0431\u043E\u044F\u0442\u0441\u044F \u0435\u0449\u0451 \u0431\u043E\u043B\u044C\u0448\u0435
      - \xAB\u0434\u0443\u0445\u0438 \u0432\u0430\u0441 \u0443\u0432\u0438\u0434\u0435\u043B\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341488
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F \u0443
      \u043A\u043E\u0441\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341489
    m_Localized: "\u0414\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430 \u0432\u0441\u0435
      \u0441\u0438\u0434\u0435\u043B\u0438, \u043D\u0435 \u0441\u043C\u044B\u043A\u0430\u044F
      \u0433\u043B\u0430\u0437. \u041E\u0433\u043E\u043D\u044C\u043A\u0438 \u043F\u043E\u0433\u0430\u0441\u043B\u0438
      \u0441 \u043F\u0435\u0440\u0432\u044B\u043C\u0438 \u043B\u0443\u0447\u0430\u043C\u0438.
      \u041E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u044F \u043D\u0435\u0442,
      \u043D\u043E \u0438 \u0432\u0440\u0435\u0434\u0430 \u043D\u0435 \u0431\u044B\u043B\u043E
      - \u043A\u0440\u043E\u043C\u0435 \u0431\u0435\u0441\u0441\u043E\u043D\u043D\u043E\u0439
      \u043D\u043E\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341490
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341491
    m_Localized: "\u0423\u0442\u0440\u043E\u043C \u043C\u0438\u043C\u043E \u043B\u0430\u0433\u0435\u0440\u044F
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D - \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432 \u043F\u043E\u0434 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u043C\u0438
      \u0444\u043B\u0430\u0436\u043A\u0430\u043C\u0438. \u041A\u0430\u0440\u0430\u0432\u0430\u043D-\u0431\u0430\u0448\u0438,
      \u0437\u0430\u043C\u0435\u0442\u0438\u0432 \u0432\u0430\u0448 \u043B\u0430\u0433\u0435\u0440\u044C,
      \u043F\u0440\u0438\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u043A\u043E\u043B\u043E\u043D\u043D\u0443.
      \u0415\u0433\u043E \u043B\u044E\u0434\u0438 \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442
      \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0434\u0440\u0443\u0436\u0435\u043B\u044E\u0431\u043D\u043E
      \u0438 \u043D\u0430\u0441\u0442\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u043E.
      \u041E\u043D \u043E\u043A\u043B\u0438\u043A\u0430\u0435\u0442:\r\n\r\n<npc_speech
      lang=\"Turkic\">\u042D\u0439, \u043A\u0430\u0440\u0430\u0432\u0430\u043D! \u0412\u044B
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B? \u041E\u0431\u043C\u0435\u043D\u044F\u0435\u043C\u0441\u044F?</npc_speech>\r\n\r\n\u042D\u0442\u043E
      \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0448\u0430\u043D\u0441
      \u043D\u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044E - \u0438\u043B\u0438
      \u043D\u0430 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341492
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341493
    m_Localized: "\u041E\u0431\u043C\u0435\u043D \u0432\u044B\u0448\u0435\u043B \u0432\u044B\u0433\u043E\u0434\u043D\u044B\u043C:
      \u0438\u0445 \u0448\u0435\u0440\u0441\u0442\u044C \u0437\u0430 \u0432\u0430\u0448
      \u0444\u0430\u0440\u0444\u043E\u0440. \u041A\u0430\u0440\u0430\u0432\u0430\u043D-\u0431\u0430\u0448\u0438
      \u0443\u0433\u043E\u0441\u0442\u0438\u043B \u043A\u0443\u043C\u044B\u0441\u043E\u043C
      \u0438 \u043F\u043E\u0436\u0435\u043B\u0430\u043B \u0434\u043E\u0431\u0440\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438. \u0412\u0430\u0448\u0438 \u043B\u044E\u0434\u0438
      \u043F\u043E\u0432\u0435\u0441\u0435\u043B\u0435\u043B\u0438 - \u043F\u0440\u0438\u0431\u044B\u0442\u043E\u043A
      \u0438 \u043D\u043E\u0432\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341494
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u043B\u044F \u043D\u0435 \u0437\u0430\u0434\u0430\u043B\u0430\u0441\u044C
      - \u0442\u044E\u0440\u043A\u0438 \u0437\u0430\u043F\u0440\u043E\u0441\u0438\u043B\u0438
      \u0432\u0442\u0440\u0438\u0434\u043E\u0440\u043E\u0433\u0430, \u0430 \u0432\u0430\u0448
      \u0442\u043E\u0432\u0430\u0440 \u043E\u0446\u0435\u043D\u0438\u043B\u0438 \u043D\u0438\u0437\u043A\u043E.
      \u0423\u0448\u043B\u0438 \u0441 \u043F\u043E\u0442\u0435\u0440\u0435\u0439,
      \u043D\u043E \u0445\u043E\u0442\u044F \u0431\u044B \u0431\u0435\u0437 \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341495
    m_Localized: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u043C\u043E\u043B\u0447\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341496
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0448\u0451\u043B
      \u043C\u0438\u043C\u043E, \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F\u0441\u044C.
      \u0418\u0445 \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u0438 \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
      \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438 \u0432\u0430\u0448\u0435
      \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435. \u0423\u043F\u0443\u0449\u0435\u043D\u0430
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C, \u043D\u043E
      \u0438 \u0440\u0438\u0441\u043A\u0430 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341497
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0432\u0435\u0434\u0451\u0442 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341498
    m_Localized: "\u0412\u0430\u0448 \u043A\u0443\u043F\u0435\u0446 \u0432\u044B\u0441\u0442\u0443\u043F\u0438\u043B
      \u0432\u043F\u0435\u0440\u0451\u0434, \u0438 \u0447\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0431\u0430\u0448\u0438
      \u0445\u043B\u043E\u043F\u043D\u0443\u043B \u0435\u0433\u043E \u043F\u043E
      \u043F\u043B\u0435\u0447\u0443. \u0421\u0434\u0435\u043B\u043A\u0430 - \u043E\u0431\u043E\u044E\u0434\u043D\u043E
      \u0432\u044B\u0433\u043E\u0434\u043D\u0430\u044F. \u0412\u0430\u0448\u0438
      \u043B\u044E\u0434\u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u0441\u0432\u0435\u0436\u0438\u0435
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u0438 \u043D\u043E\u0432\u043E\u0441\u0442\u0438
      \u0441 \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0445 \u0434\u043E\u0440\u043E\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341499
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
      \u043C\u0443\u0434\u0440\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341500
    m_Localized: "\u041A \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u043C\u0443 \u043A\u043E\u0441\u0442\u0440\u0443
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0441\u0442\u0440\u0430\u043D\u043D\u0438\u043A
      \u0432 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u0445 \u043E\u0434\u0435\u0436\u0434\u0430\u0445
      - \u0431\u043E\u0441\u043E\u0439, \u0441 \u043A\u043E\u0442\u043E\u043C\u043A\u043E\u0439,
      \u043F\u043E\u043B\u043D\u043E\u0439 \u0441\u0432\u0438\u0442\u043A\u043E\u0432.
      \u041E\u043D \u043D\u0435 \u043F\u0440\u043E\u0441\u0438\u0442 \u0435\u0434\u044B
      \u0438 \u043D\u0435 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
      \u0442\u043E\u0432\u0430\u0440. \u0415\u0433\u043E \u0434\u0430\u0440 - \u0441\u043B\u043E\u0432\u0430.
      \u041F\u043E\u043B\u0438\u0433\u043B\u043E\u0442, \u0437\u043D\u0430\u044E\u0449\u0438\u0439
      \u044F\u0437\u044B\u043A\u0438 \u043E\u0442 \u0411\u0430\u0433\u0434\u0430\u0434\u0430
      \u0434\u043E \u0427\u0430\u043D\u044A\u0430\u043D\u044F, \u043E\u043D \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
      \u0443\u0440\u043E\u043A \u043B\u044E\u0431\u043E\u043C\u0443, \u043A\u0442\u043E
      \u0433\u043E\u0442\u043E\u0432 \u0441\u043B\u0443\u0448\u0430\u0442\u044C.
      \u041E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u0430\u0440\u0430\u0431\u0441\u043A\u043E\u043C:\r\n\r\n<npc_speech
      lang=\"Arabic\">\u041C\u0438\u0440 \u0442\u0435\u0431\u0435, \u0445\u043E\u0437\u044F\u0438\u043D
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430. \u042F \u0443\u0447\u0438\u0442\u0435\u043B\u044C
      \u044F\u0437\u044B\u043A\u043E\u0432. \u041D\u0435 \u0436\u0435\u043B\u0430\u0435\u0448\u044C
      \u043B\u0438 \u0443\u0447\u0438\u0442\u044C\u0441\u044F?</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341501
    m_Localized: "\u0418\u0437\u0443\u0447\u0430\u0442\u044C \u0430\u0440\u0430\u0431\u0441\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341502
    m_Localized: "\u0414\u043E \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u043D\u043E\u0447\u0438
      \u043C\u0443\u0434\u0440\u0435\u0446 \u0443\u0447\u0438\u043B \u0432\u0430\u0441
      \u0430\u0440\u0430\u0431\u0441\u043A\u043E\u0439 \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u043C \u0444\u0440\u0430\u0437\u0430\u043C.
      \u0423\u0433\u043B\u0438 \u043F\u043E\u0433\u0430\u0441\u043B\u0438, \u0430
      \u0432\u044B \u0432\u0441\u0451 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u043B\u0438
      \u0441\u043B\u043E\u0432\u0430. \u0423\u0442\u0440\u043E\u043C \u0432 \u0433\u043E\u043B\u043E\u0432\u0435
      - \u043D\u043E\u0432\u044B\u0435 \u0437\u0432\u0443\u043A\u0438, \u043D\u0430
      \u044F\u0437\u044B\u043A\u0435 - \u043D\u043E\u0432\u044B\u0435 \u0441\u043B\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341503
    m_Localized: "\u0418\u0437\u0443\u0447\u0430\u0442\u044C \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341504
    m_Localized: "\u041C\u0443\u0434\u0440\u0435\u0446 \u043F\u0435\u0440\u0435\u0448\u0451\u043B
      \u043D\u0430 \u0444\u0430\u0440\u0441\u0438, \u0438 \u043C\u0438\u0440 \u0437\u0430\u0437\u0432\u0443\u0447\u0430\u043B
      \u0438\u043D\u0430\u0447\u0435. \u0421\u0442\u0438\u0445\u0438 \u0420\u0443\u0434\u0430\u043A\u0438,
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435 \u0442\u0435\u0440\u043C\u0438\u043D\u044B,
      \u0444\u043E\u0440\u043C\u0443\u043B\u044B \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0438
      - \u0441\u043B\u043E\u0432\u0430 \u0443\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u043B\u0438\u0441\u044C
      \u0442\u043E\u0447\u043D\u043E \u043F\u043E \u043C\u0435\u0441\u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341505
    m_Localized: "\u0418\u0437\u0443\u0447\u0430\u0442\u044C \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341506
    m_Localized: "\u041C\u0443\u0434\u0440\u0435\u0446 \u0432\u044B\u0432\u0435\u043B
      \u043A\u0438\u0441\u0442\u044C\u044E \u043D\u0430 \u043F\u0435\u0441\u043A\u0435
      \u043F\u0435\u0440\u0432\u044B\u0435 \u0438\u0435\u0440\u043E\u0433\u043B\u0438\u0444\u044B.
      \u041D\u0435\u0431\u043E, \u0437\u0435\u043C\u043B\u044F, \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u043F\u0443\u0442\u044C. \u0412\u044B \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u043B\u0438
      \u0437\u0430 \u043D\u0438\u043C, \u0438 \u043A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443
      \u0443\u043C\u0435\u043B\u0438 \u043D\u0430\u043F\u0438\u0441\u0430\u0442\u044C
      \u0441\u0432\u043E\u0451 \u0438\u043C\u044F \u0438 \u0441\u043B\u043E\u0432\u043E
      \xAB\u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341507
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
      \u0443\u0433\u043B\u0443\u0431\u0438\u0442\u044C \u043E\u0431\u0443\u0447\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341508
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0438\u043B\u0441\u044F
      \u043A \u0443\u0440\u043E\u043A\u0443, \u0438 \u043C\u0443\u0434\u0440\u0435\u0446
      \u0440\u0430\u0441\u0446\u0432\u0451\u043B - \u043D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E
      \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043D\u0438\u043A \u0435\u0433\u043E
      \u0443\u0440\u043E\u0432\u043D\u044F. \u0412\u0442\u0440\u043E\u0451\u043C
      \u0432\u044B \u0441\u0440\u0430\u0432\u043D\u0438\u0432\u0430\u043B\u0438 \u044F\u0437\u044B\u043A\u0438,
      \u043D\u0430\u0445\u043E\u0434\u0438\u043B\u0438 \u043E\u0431\u0449\u0438\u0435
      \u043A\u043E\u0440\u043D\u0438 \u0441\u043B\u043E\u0432. \u0423\u0440\u043E\u043A
      \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0441\u044F \u0432 \u043F\u0438\u0440
      \u0440\u0430\u0437\u0443\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341509
    m_Localized: "\u0413\u043E\u043B\u043E\u0434\u043D\u044B\u0439 \u0431\u0443\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341510
    m_Localized: "\u0422\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C \u0431\u0435\u0437
      \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0439 \u0435\u0434\u044B.
      \u041D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0438 \u0431\u0440\u043E\u0441\u0430\u044E\u0442
      \u0442\u044E\u043A\u0438 \u0438 \u043E\u0431\u0441\u0442\u0443\u043F\u0430\u044E\u0442
      \u0433\u043E\u043B\u043E\u0432\u043D\u0443\u044E \u043F\u043E\u0432\u043E\u0437\u043A\u0443.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u0438\u0437 \u043D\u0438\u0445,
      \u0436\u0438\u043B\u0438\u0441\u0442\u044B\u0439 \u043C\u0443\u0436\u0447\u0438\u043D\u0430
      \u0441 \u043E\u0431\u0432\u0435\u0442\u0440\u0435\u043D\u043D\u044B\u043C \u043B\u0438\u0446\u043E\u043C,
      \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0432\u043F\u0435\u0440\u0451\u0434.
      \u0412 \u0435\u0433\u043E \u0433\u043B\u0430\u0437\u0430\u0445 \u043D\u0435
      \u0437\u043B\u043E\u0431\u0430, \u0430 \u0442\u0443\u043F\u043E\u0435 \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u0435
      \u0437\u0430\u0433\u043D\u0430\u043D\u043D\u043E\u0433\u043E \u0437\u0432\u0435\u0440\u044F.
      \u0415\u0441\u043B\u0438 \u043D\u0435 \u043D\u0430\u043A\u043E\u0440\u043C\u0438\u0442\u044C
      \u043B\u044E\u0434\u0435\u0439 \u0441\u0435\u0439\u0447\u0430\u0441, \u043A
      \u0443\u0442\u0440\u0443 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0440\u0430\u0437\u0431\u0435\u0436\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341511
    m_Localized: "\u0420\u0430\u0437\u0434\u0430\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u043A\u0440\u043E\u0445\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341512
    m_Localized: "\u0412\u044B \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u043B\u0438
      \u0432\u0441\u043A\u0440\u044B\u0442\u044C \u043D\u0435\u043F\u0440\u0438\u043A\u043E\u0441\u043D\u043E\u0432\u0435\u043D\u043D\u044B\u0439
      \u0437\u0430\u043F\u0430\u0441. \u041F\u043E\u0445\u043B\u0451\u0431\u043A\u0430
      \u0436\u0438\u0434\u043A\u0430\u044F, \u043D\u043E \u0433\u043E\u0440\u044F\u0447\u0430\u044F.
      \u041B\u044E\u0434\u0438 \u0435\u0434\u044F\u0442 \u043C\u043E\u043B\u0447\u0430,
      \u043D\u0435 \u0433\u043B\u044F\u0434\u044F \u0434\u0440\u0443\u0433 \u043D\u0430
      \u0434\u0440\u0443\u0433\u0430. \u0411\u0443\u043D\u0442 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B,
      \u043D\u043E \u0435\u0434\u044B \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
      \u043D\u0430 \u0441\u0447\u0438\u0442\u0430\u043D\u043D\u044B\u0435 \u0447\u0430\u0441\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341513
    m_Localized: "\u041F\u043E\u043E\u0431\u0435\u0449\u0430\u0442\u044C \u043D\u0430\u0433\u0440\u0430\u0434\u0443
      \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C \u0433\u043E\u0440\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341514
    m_Localized: "\u0412\u044B \u0432\u0441\u0442\u0430\u043B\u0438 \u043F\u0435\u0440\u0435\u0434
      \u0442\u043E\u043B\u043F\u043E\u0439 \u0438 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438,
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0438 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E.
      \u041E \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0445 \u0445\u0430\u0440\u0447\u0435\u0432\u043D\u044F\u0445,
      \u043E \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u0435 \u0432\u0434\u0432\u043E\u0435.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u043D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A
      \u0441\u043F\u043B\u044E\u043D\u0443\u043B, \u043D\u043E \u043A\u0438\u0432\u043D\u0443\u043B.
      \u041B\u044E\u0434\u0438 \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C
      \u043F\u043E \u043C\u0435\u0441\u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341515
    m_Localized: "\u041F\u0443\u0441\u0442\u044B\u0435 \u0441\u043B\u043E\u0432\u0430
      \u043D\u0430 \u0433\u043E\u043B\u043E\u0434\u043D\u044B\u0439 \u0436\u0435\u043B\u0443\u0434\u043E\u043A
      \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u0430\u0441\u043B\u043E \u0432
      \u043E\u0433\u043E\u043D\u044C. \u041A\u0442\u043E-\u0442\u043E \u0448\u0432\u044B\u0440\u043D\u0443\u043B
      \u043A\u0430\u043C\u0435\u043D\u044C \u0432 \u043F\u043E\u0432\u043E\u0437\u043A\u0443.
      \u0414\u0432\u043E\u0435 \u0441\u0445\u0432\u0430\u0442\u0438\u043B\u0438\u0441\u044C
      \u0437\u0430 \u043D\u043E\u0436\u0438. \u0415\u043B\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u0440\u0430\u0437\u0432\u0435\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341516
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043D\u0430\u0432\u043E\u0434\u0438\u0442
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341517
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043C\u043E\u043B\u0447\u0430
      \u0432\u044B\u0448\u0435\u043B \u0432\u043F\u0435\u0440\u0451\u0434, \u043F\u043E\u043B\u043E\u0436\u0438\u0432
      \u043B\u0430\u0434\u043E\u043D\u044C \u043D\u0430 \u0440\u0443\u043A\u043E\u044F\u0442\u044C
      \u043C\u0435\u0447\u0430. \u041D\u0435 \u0443\u0433\u0440\u043E\u0436\u0430\u044F,
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044F.
      \u0422\u043E\u043B\u043F\u0430 \u043E\u0442\u0445\u043B\u044B\u043D\u0443\u043B\u0430.
      \u0411\u0443\u043D\u0442 \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u043B\u0441\u044F,
      \u043D\u043E \u0432 \u0433\u043B\u0430\u0437\u0430\u0445 \u043B\u044E\u0434\u0435\u0439
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u043D\u0435\u043D\u0430\u0432\u0438\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341518
    m_Localized: "\u0412\u044B\u043D\u0443\u0436\u0434\u0435\u043D\u043D\u0430\u044F
      \u0440\u0430\u0441\u043F\u0440\u043E\u0434\u0430\u0436\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341519
    m_Localized: "\u041F\u0440\u0438\u043F\u0430\u0441\u044B \u043D\u0430 \u0438\u0441\u0445\u043E\u0434\u0435.
      \u0423 \u043E\u0431\u043E\u0447\u0438\u043D\u044B \u0441\u0442\u043E\u0438\u0442
      \u043E\u0434\u0438\u043D\u043E\u043A\u0438\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0441 \u0442\u043E\u0449\u0438\u043C \u043E\u0441\u043B\u043E\u043C, \u043D\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u043C
      \u043C\u0435\u0448\u043A\u0430\u043C\u0438 \u0437\u0435\u0440\u043D\u0430 \u0438
      \u0432\u044F\u043B\u0435\u043D\u043E\u0433\u043E \u043C\u044F\u0441\u0430.
      \u041E\u043D \u0432\u0438\u0434\u0438\u0442 \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u0435
      \u043D\u0430 \u0432\u0430\u0448\u0438\u0445 \u043B\u0438\u0446\u0430\u0445
      \u0438 \u0449\u0443\u0440\u0438\u0442\u0441\u044F \u0441 \u0440\u0430\u0441\u0447\u0451\u0442\u043B\u0438\u0432\u043E\u0439
      \u0443\u0445\u043C\u044B\u043B\u043A\u043E\u0439. \u041E\u043D \u043A\u0443\u043F\u0438\u0442
      \u0432\u0430\u0448 \u0442\u043E\u0432\u0430\u0440, \u043D\u043E \u0437\u0430
      \u0431\u0435\u0441\u0446\u0435\u043D\u043E\u043A. \u0413\u043E\u043B\u043E\u0434
      - \u043B\u0443\u0447\u0448\u0438\u0439 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0449\u0438\u043A
      \u043D\u0430 \u0435\u0433\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341520
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C \u0442\u043E\u0432\u0430\u0440
      \u0437\u0430 \u0435\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341521
    m_Localized: "\u0412\u044B \u043E\u0442\u0434\u0430\u043B\u0438 \u0442\u044E\u043A
      \u0448\u0451\u043B\u043A\u0430 \u0437\u0430 \u0433\u043E\u0440\u0441\u0442\u044C
      \u044F\u0447\u043C\u0435\u043D\u044F \u0438 \u0441\u0432\u044F\u0437\u043A\u0443
      \u0432\u044F\u043B\u0435\u043D\u043E\u0433\u043E \u043C\u044F\u0441\u0430.
      \u0426\u0435\u043D\u0430 \u0433\u0440\u0430\u0431\u0438\u0442\u0435\u043B\u044C\u0441\u043A\u0430\u044F,
      \u043D\u043E \u043B\u044E\u0434\u0438 \u0436\u0443\u044E\u0442, \u0438 \u044D\u0442\u043E
      \u0433\u043B\u0430\u0432\u043D\u043E\u0435. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0443\u0435\u0445\u0430\u043B, \u043D\u0430\u0441\u0432\u0438\u0441\u0442\u044B\u0432\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341522
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u043A\u0440\u043E\u0432\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341523
    m_Localized: "\u0412\u044B \u043D\u0430\u0437\u0432\u0430\u043B\u0438 \u0438\u0441\u0442\u0438\u043D\u043D\u0443\u044E
      \u0446\u0435\u043D\u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0442\u043E\u0432\u0430\u0440\u0430:
      \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435,
      \u0432\u0435\u0441, \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \u043D\u0438\u0442\u0438.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043F\u043E\u043D\u044F\u043B,
      \u0447\u0442\u043E \u0438\u043C\u0435\u0435\u0442 \u0434\u0435\u043B\u043E
      \u0441 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u043E\u043C,
      \u0438 \u0443\u0441\u0442\u0443\u043F\u0438\u043B. \u0415\u0434\u044B \u0445\u0432\u0430\u0442\u0438\u0442
      \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341524
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0440\u0430\u0441\u0445\u043E\u0445\u043E\u0442\u0430\u043B\u0441\u044F:
      \xAB\u0414\u0430 \u0442\u044B \u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C
      \u043D\u0435 \u0443\u043C\u0435\u0435\u0448\u044C, \u0430 \u0442\u0443\u0434\u0430
      \u0436\u0435 - \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438!\xBB
      \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043E\u0442\u0434\u0430\u0442\u044C
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C,
      \u0438 \u043F\u0440\u043E\u0433\u043B\u043E\u0442\u0438\u0442\u044C \u0443\u043D\u0438\u0436\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341525
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0438\u0437 \u0441\u0432\u0438\u0442\u044B
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442 \u0432\u044B\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341526
    m_Localized: "\u0412\u0430\u0448 \u0441\u043F\u0443\u0442\u043D\u0438\u043A-\u043A\u0443\u043F\u0435\u0446
      \u043E\u0442\u0432\u0451\u043B \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0438 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u043D\u0430 \u044F\u0437\u044B\u043A\u0435 \u043F\u0440\u0438\u0431\u044B\u043B\u0438:
      \u0442\u0438\u0445\u043E, \u0432\u043A\u0440\u0430\u0434\u0447\u0438\u0432\u043E.
      \u0427\u0435\u0440\u0435\u0437 \u043C\u0438\u043D\u0443\u0442\u0443 \u043E\u0431\u0430
      \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u0441 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u043C\u0438
      \u043B\u0438\u0446\u0430\u043C\u0438. \u0421\u0434\u0435\u043B\u043A\u0430
      \u0432\u044B\u0448\u043B\u0430 \u043F\u043E\u0447\u0442\u0438 \u0447\u0435\u0441\u0442\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341527
    m_Localized: "\u0420\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A \u043D\u0430
      \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341528
    m_Localized: "\u041D\u0430 \u043F\u0435\u0440\u0435\u043A\u0440\u0451\u0441\u0442\u043A\u0435
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043D\u044B\u0445 \u0442\u0440\u043E\u043F
      \u043F\u043E\u0434 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u043C \u043D\u0430\u0432\u0435\u0441\u043E\u043C
      \u0441\u0438\u0434\u0438\u0442 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u0440\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A. \u041F\u0435\u0440\u0435\u0434
      \u043D\u0438\u043C: \u0432\u0435\u0441\u044B, \u0447\u0435\u0440\u043D\u0438\u043B\u044C\u043D\u0438\u0446\u0430
      \u0438 \u0441\u0442\u043E\u043F\u043A\u0430 \u0434\u043E\u043B\u0433\u043E\u0432\u044B\u0445
      \u0440\u0430\u0441\u043F\u0438\u0441\u043E\u043A. \u041E\u043D \u0437\u043D\u0430\u0435\u0442
      \u0432\u0430\u0448\u0443 \u0431\u0435\u0434\u0443 \u0440\u0430\u043D\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0432\u044B \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0435
      \u0440\u043E\u0442: \u043F\u0443\u0441\u0442\u0430\u044F \u043C\u043E\u0448\u043D\u0430
      \u0432\u0438\u0434\u043D\u0430 \u0437\u0430 \u043B\u0438. \u0415\u0433\u043E
      \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u0436\u0435\u0441\u0442\u043E\u043A\u0438,
      \u043D\u043E \u0431\u0435\u0437 \u0434\u0435\u043D\u0435\u0433 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043D\u0435 \u0434\u043E\u0439\u0434\u0451\u0442 \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0433\u043E\u0440\u043E\u0434\u0430.\r\n\r\n<npc_speech lang=\"Sogdian\">\u041D\u0430
      \u044D\u0442\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0435 \u0434\u043E\u043B\u0433\u0438
      \u043D\u0430\u0441\u0442\u0438\u0433\u0430\u044E\u0442 \u0432\u0441\u0435\u0445.
      \u041C\u043E\u044F \u0446\u0435\u043D\u0430 \u043F\u0440\u043E\u0441\u0442\u0430
      - \u0432\u0430\u0448\u0430 \u0436\u0438\u0437\u043D\u044C \u0432 \u0437\u0430\u043B\u043E\u0433.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341529
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0437\u0430\u0439\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341530
    m_Localized: "\u0412\u044B \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u043F\u043E\u0434\u043F\u0438\u0441\u044C \u043D\u0430 \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0435.
      \u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u043C\u043E\u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341531
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0437\u0430 \u0443\u0441\u043B\u043E\u0432\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341532
    m_Localized: "\u0412\u044B \u0437\u043D\u0430\u0435\u0442\u0435 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0435
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435 \u043E\u0431\u044B\u0447\u0430\u0438.
      \u0421\u0441\u044B\u043B\u043A\u0430 \u043D\u0430 \xAB\u0437\u0430\u043A\u043E\u043D
      \u0447\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u0432\u0435\u0441\u0430\xBB
      \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u0440\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A\u0430
      \u043F\u043E\u043C\u043E\u0440\u0449\u0438\u0442\u044C\u0441\u044F, \u043D\u043E
      \u0441\u043D\u0438\u0437\u0438\u0442\u044C \u043F\u0440\u043E\u0446\u0435\u043D\u0442.
      \u0414\u043E\u043B\u0433 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F,
      \u043D\u043E \u043D\u0435 \u0440\u0430\u0437\u0434\u0430\u0432\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341533
    m_Localized: "\u0420\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B
      \u0438 \u043F\u043E\u043A\u0430\u0447\u0430\u043B \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \xAB\u041D\u0435 \u0443\u0447\u0438 \u0443\u0447\u0451\u043D\u043E\u0433\u043E.\xBB
      \u0417\u0430\u0439\u043C \u0443\u0440\u0435\u0437\u0430\u043D, \u0430 \u0443\u0441\u043B\u043E\u0432\u0438\u044F
      \u0435\u0449\u0451 \u0445\u0443\u0436\u0435. \u0420\u0430\u0441\u043F\u0438\u0441\u043A\u0430
      \u043B\u0435\u0433\u043B\u0430 \u0432 \u0441\u0442\u043E\u043F\u043A\u0443
      - \u0432\u044B \u043D\u0435 \u043F\u0435\u0440\u0432\u044B\u0439 \u0438 \u043D\u0435
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341534
    m_Localized: "\u0423\u0439\u0442\u0438 \u0441 \u043F\u0443\u0441\u0442\u044B\u043C\u0438
      \u0440\u0443\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341535
    m_Localized: "\u0412\u044B \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u0438 \u0443\u0448\u043B\u0438. \u0413\u043E\u0440\u0434\u043E\u0441\u0442\u044C
      \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341536
    m_Localized: "\u0412\u043E\u0440\u043E\u0432\u0441\u0442\u0432\u043E \u0438\u0437
      \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341537
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u0432\u044B \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0438\u0441\u044C
      \u043E\u0442 \u0448\u043E\u0440\u043E\u0445\u0430. \u041E\u0434\u0438\u043D
      \u0438\u0437 \u0432\u0430\u0448\u0438\u0445 \u043B\u044E\u0434\u0435\u0439
      \u043A\u043E\u043F\u0430\u0435\u0442\u0441\u044F \u0432 \u0447\u0443\u0436\u043E\u043C
      \u0442\u044E\u043A\u0435. \u0420\u044F\u0434\u043E\u043C \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
      \u043F\u043E\u043F\u0443\u0442\u043D\u044B\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D.
      \u0412\u043E\u0440 \u0437\u0430\u043C\u0435\u0440, \u0433\u043B\u044F\u0434\u044F
      \u043D\u0430 \u0432\u0430\u0441 \u0433\u043B\u0430\u0437\u0430\u043C\u0438
      \u0437\u0430\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0433\u043E
      \u043F\u0441\u0430. \u0415\u0441\u043B\u0438 \u0435\u0433\u043E \u043F\u043E\u0439\u043C\u0430\u044E\u0442
      \u0447\u0443\u0436\u0438\u0435, \u043E\u0442\u0440\u0443\u0431\u044F\u0442
      \u0440\u0443\u043A\u0443. \u0415\u0441\u043B\u0438 \u043D\u0435 \u043F\u043E\u0439\u043C\u0430\u044E\u0442,
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0431\u0443\u0434\u0435\u0442 \u0447\u0435\u043C
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0437\u0430 \u0432\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341538
    m_Localized: "\u041F\u0440\u0438\u043A\u0440\u044B\u0442\u044C \u0432\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341539
    m_Localized: "\u0412\u044B \u043E\u0442\u0432\u043B\u0435\u043A\u043B\u0438 \u0447\u0430\u0441\u043E\u0432\u043E\u0433\u043E
      \u043F\u043E\u043F\u0443\u0442\u043D\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0448\u0443\u0442\u043A\u043E\u0439 \u043E \u0437\u0432\u0451\u0437\u0434\u0430\u0445,
      \u043F\u043E\u043A\u0430 \u0432\u043E\u0440 \u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E. \u0423\u0442\u0440\u043E\u043C:
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u043E\u043D\u0435\u0442
      \u0432 \u043E\u0431\u0449\u0435\u0439 \u043A\u0430\u0437\u043D\u0435 \u0438
      \u0442\u044F\u0436\u0435\u0441\u0442\u044C \u043D\u0430 \u0441\u043E\u0432\u0435\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341540
    m_Localized: "\u0427\u0430\u0441\u043E\u0432\u043E\u0439 \u0437\u0430\u043C\u0435\u0442\u0438\u043B
      \u0442\u0435\u043D\u044C. \u041A\u0440\u0438\u043A, \u0444\u0430\u043A\u0435\u043B\u044B,
      \u0434\u043E\u043F\u0440\u043E\u0441. \u0412\u0430\u0448 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u043F\u043E\u0439\u043C\u0430\u043D \u0441 \u0447\u0443\u0436\u0438\u043C
      \u0434\u043E\u0431\u0440\u043E\u043C. \u041F\u043E\u043F\u0443\u0442\u043D\u044B\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u0432\u043E\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u0438 \u043A\u043B\u0435\u0439\u043C\u0438\u0442
      \u0432\u0430\u0441 \u0432\u043E\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341541
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0438
      \u043D\u0430\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341542
    m_Localized: "\u0412\u044B \u0441\u0445\u0432\u0430\u0442\u0438\u043B\u0438 \u0435\u0433\u043E
      \u0437\u0430 \u0440\u0443\u043A\u0443 \u0438 \u043E\u0442\u0442\u0430\u0449\u0438\u043B\u0438.
      \u0423\u0442\u0440\u043E\u043C \u043E\u0431\u044A\u044F\u0432\u0438\u043B\u0438
      \u043F\u0435\u0440\u0435\u0434 \u0432\u0441\u0435\u043C\u0438: \u0432\u0438\u043D\u043E\u0432\u043D\u044B\u0439
      \u043B\u0438\u0448\u0451\u043D \u0434\u043E\u043B\u0438. \u041B\u044E\u0434\u0438
      \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u0438\u0441\u043F\u043E\u0434\u043B\u043E\u0431\u044C\u044F,
      \u043A\u0442\u043E \u0441 \u043E\u0434\u043E\u0431\u0440\u0435\u043D\u0438\u0435\u043C,
      \u043A\u0442\u043E \u0441\u043E \u0441\u0442\u0440\u0430\u0445\u043E\u043C.
      \u041D\u043E \u0447\u0443\u0436\u043E\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043A\u0438\u0432\u043D\u0443\u043B \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341543
    m_Localized: "\u0420\u0430\u0437\u0431\u0443\u0434\u0438\u0442\u044C \u0432\u0441\u0435\u0445
      \u0438 \u0440\u0435\u0448\u0438\u0442\u044C \u0441\u043E\u043E\u0431\u0449\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341544
    m_Localized: "\u0412\u044B \u0441\u043E\u0437\u0432\u0430\u043B\u0438 \u0441\u043E\u0432\u0435\u0442
      \u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u043D\u043E\u0447\u0438. \u041B\u044E\u0434\u0438
      \u0432\u044B\u0441\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u0438 \u0440\u0435\u0448\u0438\u043B\u0438
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0443\u043A\u0440\u0430\u0434\u0435\u043D\u043D\u043E\u0435,
      \u0430 \u0432\u0438\u043D\u043E\u0432\u043D\u043E\u0433\u043E \u043D\u0435
      \u0432\u044B\u0434\u0430\u0432\u0430\u0442\u044C. \u0427\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C
      \u043F\u0435\u0440\u0435\u0434 \u0447\u0443\u0436\u0438\u043C\u0438, \u043C\u0438\u043B\u043E\u0441\u0435\u0440\u0434\u0438\u0435
      \u043A \u0441\u0432\u043E\u0438\u043C. \u041D\u0430\u0443\u0442\u0440\u043E
      \u043E\u0431\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0434\u0432\u0438\u043D\u0443\u043B\u0438\u0441\u044C
      \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341545
    m_Localized: "\xAB\u0421\u043E\u0432\u0435\u0442\xBB \u043F\u0435\u0440\u0435\u0440\u043E\u0441
      \u0432 \u0441\u0432\u0430\u0440\u0443. \u041E\u0434\u043D\u0438 \u043A\u0440\u0438\u0447\u0430\u043B\u0438
      \xAB\u043E\u0442\u0434\u0430\u0442\u044C \u0432\u043E\u0440\u0430\xBB, \u0434\u0440\u0443\u0433\u0438\u0435
      - \xAB\u0441\u0432\u043E\u0438\u0445 \u043D\u0435 \u0441\u0434\u0430\u0451\u043C\xBB.
      \u0427\u0443\u0436\u043E\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F
      \u043E\u0442 \u0448\u0443\u043C\u0430. \u0423\u0442\u0440\u043E \u043D\u0430\u0447\u0430\u043B\u0438
      \u0441 \u0440\u0430\u0437\u0434\u043E\u0440\u0430 \u0438 \u043F\u043E\u0437\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341546
    m_Localized: "\u041E\u0441\u0430\u0434\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341547
    m_Localized: "\u041E\u043D\u0438 \u043F\u0440\u0438\u0448\u043B\u0438 \u043D\u0430
      \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 - \u0434\u0432\u0430 \u0434\u0435\u0441\u044F\u0442\u043A\u0430
      \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u043E\u0432 \u0441 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u043C\u0438
      \u043B\u0438\u0446\u0430\u043C\u0438. \u041D\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
      \u0441 \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0438,
      \u0430 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u043D\u043D\u0430\u044F
      \u0431\u0430\u043D\u0434\u0430, \u043F\u0440\u0438\u0432\u044B\u043A\u0448\u0430\u044F
      \u0431\u0440\u0430\u0442\u044C \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u044B.
      \u041E\u043D\u0438 \u043E\u043A\u0440\u0443\u0436\u0438\u043B\u0438 \u043B\u0430\u0433\u0435\u0440\u044C
      \u0438 \u0432\u0441\u0442\u0430\u043B\u0438 \u043A\u043E\u043B\u044C\u0446\u043E\u043C,
      \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u044F\u0441\u044C \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C.
      \u0412\u043E\u0436\u0430\u043A \u043F\u043E\u0434\u043D\u044F\u043B \u0440\u0443\u043A\u0443:
      \u0436\u0434\u0443\u0442 \u0432\u0430\u0448\u0435\u0433\u043E \u0440\u0435\u0448\u0435\u043D\u0438\u044F.\r\n\r\n<npc_speech
      lang=\"Turkic\">\u0411\u0440\u043E\u0441\u0430\u0439\u0442\u0435 \u0434\u043E\u0431\u0440\u043E.
      \u041F\u0443\u0441\u0442\u044C \u043A\u0440\u043E\u0432\u044C \u043D\u0435
      \u043B\u044C\u0451\u0442\u0441\u044F.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341548
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u0447\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341549
    m_Localized: "\u0412\u044B \u0432\u044B\u043A\u0430\u0442\u0438\u043B\u0438 \u0442\u0440\u0438
      \u0442\u044E\u043A\u0430 \u043A \u043D\u043E\u0433\u0430\u043C \u0432\u043E\u0436\u0430\u043A\u0430.
      \u041E\u043D \u043A\u0438\u0432\u043D\u0443\u043B, \u0438 \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u0438
      \u0441\u043E\u0431\u0440\u0430\u043B\u0438 \u0434\u043E\u0431\u044B\u0447\u0443
      \u0431\u0435\u0437 \u0435\u0434\u0438\u043D\u043E\u0433\u043E \u0441\u043B\u043E\u0432\u0430.
      \u0427\u0435\u0440\u0435\u0437 \u043C\u0438\u043D\u0443\u0442\u0443 - \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u044B\u043B\u044C. \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0446\u0435\u043B,
      \u043D\u043E \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435 - \u0441\u043B\u043E\u0432\u043D\u043E
      \u0441\u043E\u0434\u0440\u0430\u043B\u0438 \u043A\u043E\u0436\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341550
    m_Localized: "\u0414\u0435\u0440\u0436\u0430\u0442\u044C \u043E\u0431\u043E\u0440\u043E\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341551
    m_Localized: "\u041F\u043E\u0432\u043E\u0437\u043A\u0438 \u0432 \u043A\u0440\u0443\u0433,
      \u043A\u043E\u043F\u044C\u044F \u043D\u0430\u0440\u0443\u0436\u0443. \u041F\u0435\u0440\u0432\u0430\u044F
      \u0430\u0442\u0430\u043A\u0430 \u0437\u0430\u0445\u043B\u0435\u0431\u043D\u0443\u043B\u0430\u0441\u044C
      \u043E \u0431\u0430\u0440\u0440\u0438\u043A\u0430\u0434\u0443 \u0438\u0437
      \u0442\u044E\u043A\u043E\u0432. \u041F\u043E\u0441\u043B\u0435 \u0432\u0442\u043E\u0440\u043E\u0439
      \u0432\u043E\u043B\u043D\u044B \u0431\u0430\u043D\u0434\u0438\u0442\u044B \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438
      - \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u043E\u0440\u043E\u0433\u0430\u044F
      \u0434\u043E\u0431\u044B\u0447\u0430. \u0422\u0435\u043B\u0435\u0433\u0430
      \u043F\u043E\u0431\u0438\u0442\u0430 \u0441\u0442\u0440\u0435\u043B\u0430\u043C\u0438,
      \u043D\u043E \u043B\u044E\u0434\u0438 \u043B\u0438\u043A\u0443\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341552
    m_Localized: "\u041E\u0431\u043E\u0440\u043E\u043D\u0430 \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u043B\u0430.
      \u0411\u0430\u043D\u0434\u0438\u0442\u044B \u043F\u0440\u043E\u0440\u0432\u0430\u043B\u0438\u0441\u044C
      \u0441 \u0444\u043B\u0430\u043D\u0433\u0430, \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u0432
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443. \u0417\u0430\u0431\u0440\u0430\u043B\u0438
      \u0432\u0441\u0451, \u0434\u043E \u0447\u0435\u0433\u043E \u0434\u043E\u0442\u044F\u043D\u0443\u043B\u0438\u0441\u044C.
      \u041A\u043E\u0433\u0434\u0430 \u043F\u044B\u043B\u044C \u0443\u043B\u0435\u0433\u043B\u0430\u0441\u044C,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0441\u0447\u0438\u0442\u0430\u043B
      \u043F\u043E\u0442\u0435\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341553
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341554
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0441\u0442\u0440\u043E\u0438\u0442
      \u043B\u044E\u0434\u0435\u0439 \u0432 \u043B\u0438\u043D\u0438\u044E, \u0440\u0430\u0437\u0434\u0430\u0451\u0442
      \u043F\u0440\u0438\u043A\u0430\u0437\u044B. \u0415\u0433\u043E \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u0437\u0430\u0440\u0430\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u0430. \u0411\u0430\u043D\u0434\u0438\u0442\u044B
      \u0432\u0438\u0434\u044F\u0442 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043E\u0442\u043F\u043E\u0440 \u0438 \u0440\u0435\u0448\u0430\u044E\u0442
      \u043D\u0435 \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C. \u041E\u0442\u0441\u0442\u0443\u043F\u0430\u044E\u0442,
      \u043E\u0433\u0440\u044B\u0437\u0430\u044F\u0441\u044C \u0441\u0442\u0440\u0435\u043B\u0430\u043C\u0438,
      \u043D\u043E \u0431\u0435\u0437 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E
      \u043D\u0430\u0442\u0438\u0441\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341555
    m_Localized: "\u0414\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u0441\u0442\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341556
    m_Localized: "\u0423\u0442\u0440\u043E\u043C \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u043E\u0441\u044C:
      \u0434\u0432\u043E\u0435 \u043B\u044E\u0434\u0435\u0439 \u0443\u0448\u043B\u0438
      \u043D\u043E\u0447\u044C\u044E, \u0437\u0430\u0431\u0440\u0430\u0432 \u0441
      \u0441\u043E\u0431\u043E\u0439 \u043C\u0435\u0448\u043E\u043A \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u0438 \u0444\u043B\u044F\u0433\u0438 \u0441 \u0432\u043E\u0434\u043E\u0439.
      \u0421\u043B\u0435\u0434\u044B \u0432\u0435\u0434\u0443\u0442 \u043D\u0430
      \u0432\u043E\u0441\u0442\u043E\u043A - \u043A \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C\u0443
      \u0441\u0435\u043B\u0435\u043D\u0438\u044E. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u043C\u0440\u0430\u0447\u043D\u043E \u043C\u043E\u043B\u0447\u0430\u0442,
      \u043D\u043E \u0432\u044B \u0432\u0438\u0434\u0438\u0442\u0435: \u0435\u0449\u0451
      \u0434\u0432\u043E\u0435-\u0442\u0440\u043E\u0435 \u043F\u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044E\u0442
      \u0432 \u0442\u0443 \u0436\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0442\u0440\u0435\u0449\u0438\u0442
      \u043F\u043E \u0448\u0432\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341557
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0438 \u043D\u0435
      \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341558
    m_Localized: "\u0412\u044B \u043D\u0435 \u0441\u0442\u0430\u043B\u0438 \u0433\u043D\u0430\u0442\u044C\u0441\u044F.
      \u041F\u043E\u0442\u0435\u0440\u044F \u043B\u044E\u0434\u0435\u0439 \u0443\u0434\u0430\u0440\u0438\u043B\u0430
      \u043F\u043E \u0434\u0443\u0445\u0443 \u0441\u0438\u043B\u044C\u043D\u0435\u0435,
      \u0447\u0435\u043C \u043F\u043E \u043A\u043E\u0448\u0435\u043B\u044C\u043A\u0443.
      \u041E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F \u0442\u0430\u0449\u0430\u0442
      \u0442\u044E\u043A\u0438 \u043C\u043E\u043B\u0447\u0430, \u0441 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u043C\u0438
      \u043B\u0438\u0446\u0430\u043C\u0438. \u041A\u0430\u0436\u0434\u044B\u0439
      \u0434\u0443\u043C\u0430\u0435\u0442: \u043D\u0435 \u043E\u043D \u043B\u0438
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341559
    m_Localized: "\u0423\u0431\u0435\u0434\u0438\u0442\u044C \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445
      \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341560
    m_Localized: "\u0412\u044B \u0441\u043E\u0431\u0440\u0430\u043B\u0438 \u043B\u044E\u0434\u0435\u0439
      \u0438 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438 \u043E
      \u0442\u043E\u043C, \u0447\u0442\u043E \u0436\u0434\u0451\u0442 \u0432\u043F\u0435\u0440\u0435\u0434\u0438:
      \u0433\u043E\u0440\u043E\u0434, \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u0435,
      \u043E\u0442\u0434\u044B\u0445. \u041E \u0442\u043E\u043C, \u0447\u0442\u043E
      \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443 \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u044B
      \u043D\u0435 \u0434\u043E\u0439\u0434\u0443\u0442. \u0413\u043E\u043B\u043E\u0441
      \u0432\u0430\u0448 \u043D\u0435 \u0434\u0440\u043E\u0436\u0430\u043B. \u041B\u044E\u0434\u0438
      \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341561
    m_Localized: "\u0421\u043B\u043E\u0432\u0430 \u043F\u0440\u043E\u0437\u0432\u0443\u0447\u0430\u043B\u0438
      \u043F\u0443\u0441\u0442\u043E. \u041A\u0442\u043E-\u0442\u043E \u0431\u0443\u0440\u043A\u043D\u0443\u043B:
      \xAB\u0421\u043B\u043E\u0432\u0430 \u043D\u0435 \u043A\u043E\u0440\u043C\u044F\u0442.\xBB
      \u0415\u0449\u0451 \u043E\u0434\u0438\u043D \u0443\u0448\u0451\u043B \u0434\u043E
      \u043F\u043E\u043B\u0443\u0434\u043D\u044F, \u043F\u0440\u0438\u0445\u0432\u0430\u0442\u0438\u0432
      \u043B\u0435\u043F\u0451\u0448\u043A\u0438 \u0438\u0437 \u043E\u0431\u0449\u0435\u0433\u043E
      \u043C\u0435\u0448\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341562
    m_Localized: "\u0412\u044B\u0441\u043B\u0430\u0442\u044C \u043F\u043E\u0433\u043E\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341563
    m_Localized: "\u0414\u0432\u043E\u0435 \u0432\u0435\u0440\u043D\u044B\u0445 \u043B\u044E\u0434\u0435\u0439
      \u043D\u0430\u0433\u043D\u0430\u043B\u0438 \u0431\u0435\u0433\u043B\u0435\u0446\u043E\u0432
      \u043A \u043F\u043E\u043B\u0443\u0434\u043D\u044E. \u0412\u0435\u0440\u043D\u0443\u043B\u0438
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u0438 \u043F\u0440\u0438\u0432\u0435\u043B\u0438
      \u043E\u0431\u043E\u0438\u0445 \u043D\u0430\u0437\u0430\u0434. \u0414\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u044B
      \u043F\u043E\u043D\u0443\u0440\u044B, \u043D\u043E \u0436\u0438\u0432\u044B.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043C\u043E\u043B\u0447\u0430\u0442
      - \u0443\u0440\u043E\u043A \u043F\u043E\u043D\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341564
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u044F \u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
      \u043D\u0438 \u0441 \u0447\u0435\u043C - \u0441\u043B\u0435\u0434\u044B \u0437\u0430\u0442\u0435\u0440\u044F\u043B\u0438\u0441\u044C
      \u0432 \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0439 \u043F\u0443\u0441\u0442\u043E\u0448\u0438.
      \u041F\u043E\u0442\u0440\u0430\u0447\u0435\u043D \u0434\u0435\u043D\u044C,
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B \u043B\u044E\u0434\u0438,
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E \u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341565
    m_Localized: "\u0420\u043E\u043F\u043E\u0442 \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341566
    m_Localized: "\u041B\u044E\u0434\u0438 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0438
      \u043F\u0435\u0442\u044C \u043D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0430\u0445.
      \u041F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0438 \u0448\u0443\u0442\u0438\u0442\u044C.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043E\u043D\u0438 \u043F\u0435\u0440\u0435\u0448\u0451\u043F\u0442\u044B\u0432\u0430\u044E\u0442\u0441\u044F,
      \u0437\u0430\u043C\u043E\u043B\u043A\u0430\u044F \u043F\u0440\u0438 \u0432\u0430\u0448\u0435\u043C
      \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u0438. \u0412\u0435\u0447\u0435\u0440\u043E\u043C
      \u0443 \u043A\u043E\u0441\u0442\u0440\u0430 \u0432\u044B \u0441\u043B\u044B\u0448\u0438\u0442\u0435
      \u043E\u0431\u0440\u044B\u0432\u043A\u0438: \xAB...\u043E\u0431\u0435\u0449\u0430\u043B
      \u043B\u0451\u0433\u043A\u0438\u0439 \u043F\u0443\u0442\u044C...\xBB, \xAB...\u0433\u043D\u0438\u043B\u044B\u0435
      \u043B\u0435\u043F\u0451\u0448\u043A\u0438 \u0442\u0440\u0435\u0442\u0438\u0439
      \u0434\u0435\u043D\u044C...\xBB, \xAB...\u0430 \u043E\u043D \u0436\u0438\u0440\u0443\u0435\u0442...\xBB.
      \u0418\u0441\u043A\u0440\u0430 \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0430
      \u0442\u043B\u0435\u0435\u0442: \u0435\u0449\u0451 \u043D\u0435\u043C\u043D\u043E\u0433\u043E,
      \u0438 \u0432\u0441\u043F\u044B\u0445\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341567
    m_Localized: "\u0423\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u0447\u043D\u044B\u0439
      \u0443\u0436\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707546341568
    m_Localized: "\u0412\u044B \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u043B\u0438
      \u0437\u0430\u0440\u0435\u0437\u0430\u0442\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
      \u0431\u0430\u0440\u0430\u043D\u0430 \u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u0431\u0443\u0440\u0434\u044E\u043A \u0441 \u0432\u0438\u043D\u043E\u043C.
      \u0420\u0430\u0441\u0442\u043E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535680
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u0437\u0430\u0447\u0438\u043D\u0449\u0438\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535681
    m_Localized: "\u0412\u044B \u043D\u0430\u0448\u043B\u0438 \u0442\u043E\u0433\u043E,
      \u043A\u0442\u043E \u0433\u0440\u043E\u043C\u0447\u0435 \u0432\u0441\u0435\u0445
      \u0432\u043E\u0440\u0447\u0438\u0442, \u0438 \u0441\u0435\u043B\u0438 \u0440\u044F\u0434\u043E\u043C.
      \u0412\u044B\u0441\u043B\u0443\u0448\u0430\u043B\u0438. \u041D\u0435 \u0441\u043F\u043E\u0440\u0438\u043B\u0438.
      \u041F\u043E\u0442\u043E\u043C \u0442\u0438\u0445\u043E \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B\u0438,
      \u0447\u0442\u043E \u0438 \u0432\u0430\u043C \u043D\u0435 \u043B\u0435\u0433\u0447\u0435.
      \u0423\u0442\u0440\u043E\u043C \u043E\u043D \u043F\u0435\u0440\u0432\u044B\u043C
      \u0432\u0441\u0442\u0430\u043B \u0437\u0430 \u0442\u044E\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535682
    m_Localized: "\u0417\u0430\u0447\u0438\u043D\u0449\u0438\u043A \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B
      \u0438 \u0443\u0441\u043C\u0435\u0445\u043D\u0443\u043B\u0441\u044F: \xAB\u0421\u043B\u043E\u0432\u0430
      \u0445\u043E\u0437\u044F\u0438\u043D\u0430 - \u0432\u0435\u0442\u0435\u0440.\xBB
      \u0420\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0438 \u0443\u0448\u0451\u043B
      \u043A \u0441\u0432\u043E\u0438\u043C. \u0428\u0451\u043F\u043E\u0442 \u0441\u0442\u0430\u043B
      \u0433\u0440\u043E\u043C\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535683
    m_Localized: "\u0420\u0430\u0437\u0434\u0430\u0442\u044C \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435
      \u043F\u0440\u0435\u043C\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535684
    m_Localized: "\u041F\u043E \u0442\u0440\u0438 \u043C\u043E\u043D\u0435\u0442\u044B
      \u043A\u0430\u0436\u0434\u043E\u043C\u0443, \u043C\u0430\u043B\u043E, \u043D\u043E
      \u0437\u0432\u043E\u043D \u0441\u0435\u0440\u0435\u0431\u0440\u0430 \u0443\u0441\u043F\u043E\u043A\u0430\u0438\u0432\u0430\u0435\u0442
      \u043B\u0443\u0447\u0448\u0435 \u043B\u044E\u0431\u044B\u0445 \u0441\u043B\u043E\u0432.
      \u041B\u044E\u0434\u0438 \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0438 \u0434\u0435\u043D\u044C\u0433\u0438
      \u0438 \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C. \u041D\u0435
      \u0440\u0430\u0434\u043E\u0441\u0442\u043D\u044B\u0435, \u043D\u043E \u0438
      \u043D\u0435 \u0437\u043B\u044B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535685
    m_Localized: "\u041C\u044F\u0442\u0435\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535686
    m_Localized: "\u041F\u0440\u043E\u0441\u043D\u0443\u043B\u0438\u0441\u044C \u043E\u0442
      \u043A\u0440\u0438\u043A\u0430. \u0427\u0435\u0442\u0432\u0435\u0440\u043E
      \u0441\u0442\u043E\u044F\u0442 \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u0432\u043E\u0437\u043A\u043E\u0439,
      \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0435 \u0434\u0440\u0435\u043A\u043E\u043B\u044C\u0435\u043C.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 (\u0442\u043E\u0442 \u0441\u0430\u043C\u044B\u0439,
      \u0447\u0442\u043E \u043C\u043E\u043B\u0447\u0430\u043B \u043D\u0430 \u0432\u0441\u0435\u0445
      \u043F\u0440\u0438\u0432\u0430\u043B\u0430\u0445) \u0442\u0435\u043F\u0435\u0440\u044C
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0437\u0430 \u0432\u0441\u0435\u0445:
      \xAB\u041C\u044B \u0443\u0445\u043E\u0434\u0438\u043C. \u0418 \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u043C
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u0433\u0440\u0443\u0437\u0430:
      \u044D\u0442\u043E \u043D\u0430\u0448\u0435 \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u0435.\xBB
      \u0417\u0430 \u0438\u0445 \u0441\u043F\u0438\u043D\u0430\u043C\u0438 \u0435\u0449\u0451
      \u0448\u0435\u0441\u0442\u0435\u0440\u043E, \u043F\u043E\u043A\u0430 \u043D\u0435
      \u0440\u0435\u0448\u0438\u0432\u0448\u0438\u0445, \u043A \u043A\u043E\u043C\u0443
      \u043F\u0440\u0438\u043C\u043A\u043D\u0443\u0442\u044C. \u042D\u0442\u043E
      \u043D\u0435 \u0440\u043E\u043F\u043E\u0442. \u042D\u0442\u043E \u043C\u044F\u0442\u0435\u0436."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535687
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u0442\u0440\u0435\u0431\u0443\u0435\u043C\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535688
    m_Localized: "\u0412\u044B \u043C\u043E\u043B\u0447\u0430 \u0440\u0430\u0437\u0432\u044F\u0437\u0430\u043B\u0438
      \u0442\u044E\u043A\u0438 \u0438 \u043E\u0442\u043C\u0435\u0440\u0438\u043B\u0438
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443. \u041C\u044F\u0442\u0435\u0436\u043D\u0438\u043A\u0438
      \u0437\u0430\u0431\u0440\u0430\u043B\u0438 \u0441\u0432\u043E\u0451 \u0438
      \u0443\u0448\u043B\u0438, \u043D\u0435 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0431\u0435\u0441\u043A\u0440\u043E\u0432\u043B\u0435\u043D,
      \u043D\u043E \u0446\u0435\u043B. \u0422\u0435, \u043A\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u0441\u044F,
      \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u043D\u0430 \u0432\u0430\u0441
      \u0441 \u043D\u0435\u044F\u0441\u043D\u044B\u043C \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u043C:
      \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435 \u0438\u043B\u0438 \u0436\u0430\u043B\u043E\u0441\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535689
    m_Localized: "\u0412\u0441\u0442\u0430\u0442\u044C \u043D\u0430 \u043F\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535690
    m_Localized: "\u0412\u044B \u0432\u0441\u0442\u0430\u043B\u0438 \u043F\u0435\u0440\u0435\u0434
      \u043F\u043E\u0432\u043E\u0437\u043A\u043E\u0439. \u0423\u0434\u0430\u0440
      \u043F\u0430\u043B\u043A\u043E\u0439 \u043F\u043E \u043F\u043B\u0435\u0447\u0443,
      \u0432\u044B \u0443\u0441\u0442\u043E\u044F\u043B\u0438. \u0414\u0440\u0430\u043A\u0430.
      \u041A\u0442\u043E-\u0442\u043E \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u043B
      \u043C\u0435\u0448\u043A\u0438, \u043A\u0442\u043E-\u0442\u043E \u043F\u043E\u0434\u0436\u0451\u0433
      \u0442\u0435\u043D\u0442. \u041A\u043E\u0433\u0434\u0430 \u0432\u0441\u0451
      \u043A\u043E\u043D\u0447\u0438\u043B\u043E\u0441\u044C, \u043C\u044F\u0442\u0435\u0436\u043D\u0438\u043A\u0438
      \u0443\u0448\u043B\u0438 \u0441 \u043C\u0430\u043B\u044B\u043C, \u043D\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u0441 \u0441\u0438\u043D\u044F\u043A\u0430\u043C\u0438 \u0438 \u0431\u0435\u0437
      \u043F\u043E\u0440\u044F\u0434\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535691
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0443\u0441\u043C\u0438\u0440\u044F\u0435\u0442
      \u0431\u0443\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535692
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0432\u0441\u0442\u0430\u043B
      \u0440\u044F\u0434\u043E\u043C, \u043E\u0431\u043D\u0430\u0436\u0438\u0432
      \u043A\u043B\u0438\u043D\u043E\u043A. \u041D\u0435 \u0437\u0430\u043C\u0430\u0445\u043D\u0443\u043B\u0441\u044F
      - \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0442\u043E\u044F\u043B, \u0438
      \u043B\u0443\u043D\u043D\u044B\u0439 \u0441\u0432\u0435\u0442 \u043F\u043B\u044B\u043B
      \u043F\u043E \u043B\u0435\u0437\u0432\u0438\u044E. \u041C\u044F\u0442\u0435\u0436\u043D\u0438\u043A\u0438
      \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u043B\u0438\u0441\u044C.
      \u0412\u043E\u0436\u0430\u043A \u0441\u043F\u043B\u044E\u043D\u0443\u043B \u0438
      \u0431\u0440\u043E\u0441\u0438\u043B \u043F\u0430\u043B\u043A\u0443. \xAB\u041B\u0430\u0434\u043D\u043E.
      \u041F\u043E\u043A\u0430.\xBB \u0423\u0448\u043B\u0438 \u0442\u0440\u043E\u0435,
      \u0431\u0435\u0437 \u0433\u0440\u0443\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535693
    m_Localized: "\u0422\u0435\u043B\u0435\u0433\u0430 \u0440\u0430\u0437\u0432\u0430\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535694
    m_Localized: "\u0422\u0440\u0435\u0441\u043A \u0440\u0430\u0437\u0434\u0430\u043B\u0441\u044F
      \u043A\u0430\u043A \u0432\u044B\u0441\u0442\u0440\u0435\u043B. \u041E\u0441\u043D\u043E\u0432\u043D\u0430\u044F
      \u0442\u0435\u043B\u0435\u0433\u0430 \u043E\u0441\u0435\u043B\u0430 \u043D\u0430\u0431\u043E\u043A
      - \u043E\u0441\u044C \u043F\u0435\u0440\u0435\u043B\u043E\u043C\u0438\u043B\u0430\u0441\u044C
      \u043D\u0430\u0434\u0432\u043E\u0435, \u043A\u043E\u043B\u0435\u0441\u043E
      \u043E\u0442\u043A\u0430\u0442\u0438\u043B\u043E\u0441\u044C \u0432 \u043A\u0430\u043D\u0430\u0432\u0443.
      \u0422\u044E\u043A\u0438 \u043F\u043E\u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443. \u0420\u0430\u043C\u0430
      \u043F\u0435\u0440\u0435\u043A\u043E\u0448\u0435\u043D\u0430, \u0431\u043E\u0440\u0442
      \u0440\u0430\u0441\u0449\u0435\u043F\u043B\u0451\u043D. \u0411\u0435\u0437
      \u0440\u0435\u043C\u043E\u043D\u0442\u0430 \u0434\u0430\u043B\u044C\u0448\u0435
      - \u043D\u0438\u043A\u0443\u0434\u0430, \u043D\u043E \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430
      \u043F\u043E\u0447\u0442\u0438 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535695
    m_Localized: "\u0420\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C \u0434\u043E\u043F.
      \u0442\u0435\u043B\u0435\u0433\u0443 \u043D\u0430 \u0437\u0430\u043F\u0447\u0430\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535696
    m_Localized: "\u0412\u044B \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u043B\u0438
      \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C \u0437\u0430\u043F\u0430\u0441\u043D\u0443\u044E
      \u0442\u0435\u043B\u0435\u0433\u0443. \u041E\u0441\u044C, \u0441\u043F\u0438\u0446\u044B,
      \u0434\u043E\u0441\u043A\u0438 - \u0432\u0441\u0451 \u043F\u043E\u0448\u043B\u043E
      \u043D\u0430 \u043F\u043E\u0447\u0438\u043D\u043A\u0443. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u043E\u0441\u043D\u043E\u0432\u043D\u0430\u044F \u0442\u0435\u043B\u0435\u0433\u0430
      \u0441\u0442\u043E\u0438\u0442 \u0440\u043E\u0432\u043D\u043E, \u043D\u043E
      \u043B\u0438\u0448\u043D\u0438\u0439 \u0433\u0440\u0443\u0437 \u0442\u0435\u043F\u0435\u0440\u044C
      \u043D\u0435\u043A\u0443\u0434\u0430 \u043A\u043B\u0430\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535697
    m_Localized: "\u0418\u043C\u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0440\u0435\u043C\u043E\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535698
    m_Localized: "\u0418\u0437 \u0432\u0435\u0442\u0432\u0435\u0439, \u043A\u0430\u043C\u043D\u0435\u0439
      \u0438 \u0432\u0435\u0440\u0451\u0432\u043E\u043A \u0432\u044B \u0441\u043E\u043E\u0440\u0443\u0434\u0438\u043B\u0438
      \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0443\u044E \u043E\u043F\u043E\u0440\u0443.
      \u041D\u0435 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E, \u043D\u043E
      \u0442\u0435\u043B\u0435\u0433\u0430 \u043F\u043E\u0435\u0445\u0430\u043B\u0430.
      \u041C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E \u0440\u0443\u043A
      \u0441\u043F\u0430\u0441\u043B\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043E\u0442 \u043C\u043D\u043E\u0433\u043E\u0434\u043D\u0435\u0432\u043D\u043E\u0439
      \u0441\u0442\u043E\u044F\u043D\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535699
    m_Localized: "\u0420\u0435\u043C\u043E\u043D\u0442 \u0437\u0430\u043D\u044F\u043B
      \u0446\u0435\u043B\u044B\u0439 \u0434\u0435\u043D\u044C. \u041A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F
      \u0441\u043A\u0440\u0438\u043F\u0438\u0442 \u0438 \u0448\u0430\u0442\u0430\u0435\u0442\u0441\u044F.
      \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0432\u044B\u0431\u0440\u043E\u0441\u0438\u0442\u044C
      \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432,
      \u0447\u0442\u043E\u0431\u044B \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u0442\u044C
      \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0443. \u041B\u044E\u0434\u0438
      \u0432\u043E\u0440\u0447\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535700
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u0447\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535701
    m_Localized: "\u0421\u0430\u043C\u044B\u0435 \u0442\u044F\u0436\u0451\u043B\u044B\u0435
      \u0442\u044E\u043A\u0438 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043D\u0430
      \u043E\u0431\u043E\u0447\u0438\u043D\u0435. \u0422\u0435\u043B\u0435\u0433\u0430
      \u043E\u0431\u043B\u0435\u0433\u0447\u0435\u043D\u0430 \u0438 \u043A\u043E\u0435-\u043A\u0430\u043A
      \u043F\u043E\u043B\u0437\u0451\u0442. \u041B\u044E\u0434\u0438 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u043D\u0430 \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u043E\u0435 \u0434\u043E\u0431\u0440\u043E,
      \u0431\u0443\u0434\u0442\u043E \u043D\u0430 \u043C\u043E\u0433\u0438\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535702
    m_Localized: "\u042D\u043A\u0441\u0442\u0440\u0435\u043D\u043D\u044B\u0439 \u0440\u0435\u043C\u043E\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535703
    m_Localized: "\u0422\u0435\u043B\u0435\u0433\u0430 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u0441\u043A\u0440\u0438\u043F\u0438\u0442: \u043E\u043D\u0430
      \u0441\u0442\u043E\u043D\u0435\u0442. \u041A\u0430\u0436\u0434\u0430\u044F
      \u043A\u043E\u0447\u043A\u0430 \u043E\u0442\u0434\u0430\u0451\u0442\u0441\u044F
      \u0445\u0440\u0443\u0441\u0442\u043E\u043C. \u041E\u0431\u043E\u0434 \u043A\u043E\u043B\u0435\u0441\u0430
      \u043B\u043E\u043F\u043D\u0443\u043B, \u0441\u043F\u0438\u0446\u044B \u0442\u043E\u0440\u0447\u0430\u0442
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u044B, \u0431\u043E\u0440\u0442
      \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F \u043D\u0430 \u043E\u0434\u043D\u043E\u043C
      \u0433\u0432\u043E\u0437\u0434\u0435. \u0415\u0449\u0451 \u043E\u0434\u0438\u043D
      \u043F\u0435\u0440\u0435\u0435\u0437\u0434 \u0447\u0435\u0440\u0435\u0437 \u0440\u0443\u0447\u0435\u0439,
      \u0438 \u043E\u043D\u0430 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F
      \u043B\u0435\u0436\u0430\u0442\u044C. \u041D\u0443\u0436\u043D\u043E \u0440\u0435\u0448\u0430\u0442\u044C
      \u0441\u0435\u0439\u0447\u0430\u0441, \u043F\u043E\u043A\u0430 \u043E\u043D\u0430
      \u0435\u0449\u0451 \u0441\u0442\u043E\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535704
    m_Localized: "\u041D\u043E\u0447\u043D\u043E\u0439 \u0440\u0435\u043C\u043E\u043D\u0442
      \u043F\u0440\u0438 \u0444\u0430\u043A\u0435\u043B\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535705
    m_Localized: "\u0412\u0441\u044E \u043D\u043E\u0447\u044C \u0441\u0442\u0443\u043A
      \u043C\u043E\u043B\u043E\u0442\u043A\u043E\u0432 \u043D\u0435 \u0441\u0442\u0438\u0445\u0430\u043B.
      \u041A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443 \u0442\u0435\u043B\u0435\u0433\u0430
      \u043E\u0431\u043C\u043E\u0442\u0430\u043D\u0430 \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u043C\u0438
      \u0438 \u043F\u043E\u0434\u043F\u0451\u0440\u0442\u0430 \u043D\u043E\u0432\u044B\u043C\u0438
      \u043A\u043B\u0438\u043D\u044C\u044F\u043C\u0438. \u0423\u0440\u043E\u0434\u043B\u0438\u0432\u043E,
      \u043D\u043E \u043A\u0440\u0435\u043F\u043A\u043E. \u041B\u044E\u0434\u0438
      \u0437\u0435\u0432\u0430\u044E\u0442, \u043D\u043E \u0434\u0432\u0438\u0433\u0430\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535706
    m_Localized: "\u0412 \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u043A\u0442\u043E-\u0442\u043E
      \u0443\u0434\u0430\u0440\u0438\u043B \u043C\u043E\u043B\u043E\u0442\u043A\u043E\u043C
      \u043F\u043E \u043F\u0430\u043B\u044C\u0446\u0430\u043C, \u043A\u0442\u043E-\u0442\u043E
      \u0432\u0431\u0438\u043B \u043A\u043B\u0438\u043D \u043D\u0435 \u0442\u0443\u0434\u0430.
      \u0423\u0442\u0440\u043E\u043C \u0442\u0435\u043B\u0435\u0433\u0430 \u0447\u0443\u0442\u044C
      \u043A\u0440\u0435\u043F\u0447\u0435, \u043D\u043E \u043B\u044E\u0434\u0438
      \u0438\u0437\u043C\u043E\u0442\u0430\u043D\u044B \u0438 \u0437\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535707
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u043C\u0430\u0441\u0442\u0435\u0440\u0430
      \u0432 \u043E\u043A\u0440\u0443\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535708
    m_Localized: "\u0412 \u0434\u0432\u0443\u0445 \u043B\u0438 \u043E\u0442 \u0434\u043E\u0440\u043E\u0433\u0438
      \u0434\u0435\u0440\u0435\u0432\u043D\u044F \u0441 \u043F\u043B\u043E\u0442\u043D\u0438\u043A\u043E\u043C.
      \u0421\u0442\u0430\u0440\u0438\u043A \u0434\u043E\u043B\u0433\u043E \u043A\u0430\u0447\u0430\u043B
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439, \u043D\u043E \u0437\u0430 \u0441\u0435\u0440\u0435\u0431\u0440\u043E
      \u0432\u0437\u044F\u043B\u0441\u044F. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0442\u0435\u043B\u0435\u0433\u0430 \u0441\u043A\u0440\u0438\u043F\u0438\u0442
      \u043F\u043E-\u043D\u043E\u0432\u043E\u043C\u0443: \u0441\u043A\u0440\u0438\u043F
      \u0437\u0434\u043E\u0440\u043E\u0432\u043E\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535709
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u043F\u0443\u0442\u044C \u043A
      \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535710
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043B:
      \u0437\u0430 \u0445\u043E\u043B\u043C\u043E\u043C - \u043A\u0443\u0437\u043D\u044F,
      \u0433\u0434\u0435 \u043F\u043E\u0434\u043A\u043E\u0432\u044B\u0432\u0430\u044E\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043D\u044B\u0445 \u043B\u043E\u0448\u0430\u0434\u0435\u0439.
      \u041C\u0430\u0441\u0442\u0435\u0440 \u0438 \u0442\u0435\u043B\u0435\u0433\u0438
      \u0447\u0438\u043D\u0438\u0442, \u043F\u0440\u0438\u0447\u0451\u043C \u0434\u0435\u0448\u0435\u0432\u043B\u0435,
      \u0447\u0435\u043C \u0432 \u0433\u043E\u0440\u043E\u0434\u0435. \u041F\u043E\u0432\u0435\u0437\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535711
    m_Localized: "\u041E\u0442\u043A\u0430\u0437 \u0432 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535712
    m_Localized: "\u041D\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0435
      \u0434\u0432\u0435\u0440\u0438 \u0437\u0430\u043A\u0440\u044B\u043B\u0438\u0441\u044C
      \u043F\u0440\u0438 \u0432\u0430\u0448\u0435\u043C \u043F\u043E\u044F\u0432\u043B\u0435\u043D\u0438\u0438.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0446\u044B \u043E\u0442\u0432\u043E\u0434\u044F\u0442
      \u0433\u043B\u0430\u0437\u0430, \u043C\u0435\u043D\u044F\u043B\u044B \u043F\u0440\u044F\u0447\u0443\u0442
      \u0432\u0435\u0441\u044B. \u0421\u043B\u0443\u0445\u0438 \u043B\u0435\u0442\u044F\u0442
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430:
      \u0432\u0430\u0441 \u0437\u043D\u0430\u044E\u0442 \u043A\u0430\u043A \u043D\u0435\u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0433\u043E,
      \u0430 \u0442\u043E \u0438 \u0432\u043E\u0440\u0430. \u0411\u0435\u0437 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D - \u043C\u0451\u0440\u0442\u0432\u044B\u0439
      \u0433\u0440\u0443\u0437 \u043D\u0430 \u043A\u043E\u043B\u0451\u0441\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535713
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0442\u043E\u0432\u0430\u0440
      \u043F\u043E \u0434\u0435\u0448\u0451\u0432\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535714
    m_Localized: "\u0412\u044B \u0440\u0430\u0437\u043B\u043E\u0436\u0438\u043B\u0438
      \u0442\u043E\u0432\u0430\u0440 \u043F\u0440\u044F\u043C\u043E \u043D\u0430
      \u0437\u0435\u043C\u043B\u0435 - \u043F\u043E \u0446\u0435\u043D\u0430\u043C
      \u0432\u0434\u0432\u043E\u0435 \u043D\u0438\u0436\u0435 \u0440\u044B\u043D\u043E\u0447\u043D\u044B\u0445.
      \u0416\u0430\u0434\u043D\u043E\u0441\u0442\u044C \u043F\u043E\u0431\u0435\u0434\u0438\u043B\u0430
      \u0431\u0440\u0435\u0437\u0433\u043B\u0438\u0432\u043E\u0441\u0442\u044C. \u041A
      \u0432\u0435\u0447\u0435\u0440\u0443 \u043D\u0430\u0448\u043B\u0438\u0441\u044C
      \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0438. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u043D\u0435 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430,
      \u043D\u043E \u043B\u0451\u0434 \u0442\u0440\u043E\u043D\u0443\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535715
    m_Localized: "\u041E\u0431\u0440\u0430\u0442\u0438\u0442\u044C\u0441\u044F \u043A
      \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535716
    m_Localized: "\u0412\u044B \u043D\u0430\u0448\u043B\u0438 \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0443
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u044F \u0438
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438 \u0441 \u043D\u0438\u043C
      \u043D\u0430 \u044F\u0437\u044B\u043A\u0435 \u0447\u0435\u0441\u0442\u0438:
      \u043E \u043F\u0440\u0435\u0434\u043A\u0430\u0445, \u043E \u043A\u043B\u044F\u0442\u0432\u0430\u0445,
      \u043E \u0432\u0442\u043E\u0440\u043E\u043C \u0448\u0430\u043D\u0441\u0435.
      \u0421\u0442\u0430\u0440\u0438\u043A \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B
      \u0438 \u043A\u0438\u0432\u043D\u0443\u043B. \u041A \u0443\u0442\u0440\u0443
      \u0434\u0432\u0435\u0440\u0438 \u043E\u0442\u043A\u0440\u044B\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535717
    m_Localized: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430 \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B
      \u0438 \u043F\u043E\u043A\u0430\u0447\u0430\u043B \u0433\u043E\u043B\u043E\u0432\u043E\u0439:
      \xAB\u0414\u043E\u0432\u0435\u0440\u0438\u0435 \u043D\u0435 \u0448\u0442\u043E\u043F\u0430\u044E\u0442
      \u0441\u043B\u043E\u0432\u0430\u043C\u0438.\xBB \u0412\u044B \u0443\u0448\u043B\u0438
      \u043F\u043E\u0434 \u043A\u043E\u0441\u044B\u043C\u0438 \u0432\u0437\u0433\u043B\u044F\u0434\u0430\u043C\u0438.
      \u041B\u044E\u0434\u0438 \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435
      \u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u0432\u0441\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535718
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043D\u0430\u0445\u043E\u0434\u0438\u0442
      \u043F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535719
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u043E\u0442\u044B\u0441\u043A\u0430\u043B \u0441\u0440\u0435\u0434\u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432
      \u0437\u0435\u043C\u043B\u044F\u043A\u0430 \u0438 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0441\u044F
      \u0442\u0438\u0445\u043E: \u0442\u043E\u0442 \u0432\u044B\u0441\u0442\u0443\u043F\u0438\u0442
      \u043F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A\u043E\u043C \u0437\u0430
      \u0441\u043A\u0440\u043E\u043C\u043D\u044B\u0439 \u043F\u0440\u043E\u0446\u0435\u043D\u0442.
      \u0422\u043E\u0432\u0430\u0440 \u043F\u0440\u043E\u0434\u0430\u043D \u0447\u0435\u0440\u0435\u0437
      \u0442\u0440\u0435\u0442\u044C\u0438 \u0440\u0443\u043A\u0438. \u041D\u0435
      \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0435, \u043D\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535720
    m_Localized: "\u0412\u0440\u0430\u0436\u0434\u0435\u0431\u043D\u043E\u0441\u0442\u044C
      \u043C\u0435\u0441\u0442\u043D\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535721
    m_Localized: "\u0414\u0435\u0440\u0435\u0432\u043D\u044F \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043A\u0430\u043C\u043D\u044F\u043C\u0438.
      \u0414\u0435\u0442\u0438 \u043A\u0440\u0438\u0447\u0430\u0442 \u0440\u0443\u0433\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430,
      \u0436\u0435\u043D\u0449\u0438\u043D\u044B \u0437\u0430\u0445\u043B\u043E\u043F\u044B\u0432\u0430\u044E\u0442
      \u0441\u0442\u0430\u0432\u043D\u0438, \u043C\u0443\u0436\u0447\u0438\u043D\u044B
      \u0441\u0442\u043E\u044F\u0442 \u0443 \u043E\u043A\u043E\u043B\u0438\u0446\u044B
      \u0441 \u0432\u0438\u043B\u0430\u043C\u0438 \u0438 \u0441\u0435\u0440\u043F\u0430\u043C\u0438.
      \u041A\u0442\u043E-\u0442\u043E \u0440\u0430\u0437\u043D\u0451\u0441 \u0441\u043B\u0443\u0445,
      \u0447\u0442\u043E \u0432\u0430\u0448 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043D\u0435\u0441\u0451\u0442 \u0431\u043E\u043B\u0435\u0437\u043D\u044C -
      \u0438\u043B\u0438 \u0447\u0442\u043E \u0432\u044B \u043E\u0431\u043C\u0430\u043D\u0443\u043B\u0438
      \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0435 \u0441\u0435\u043B\u0435\u043D\u0438\u0435.
      \u041F\u0440\u0430\u0432\u0434\u0430 \u0443\u0436\u0435 \u043D\u0435 \u0432\u0430\u0436\u043D\u0430.
      \u0412\u0430\u0441 \u0437\u0434\u0435\u0441\u044C \u043D\u0435 \u0436\u0434\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535722
    m_Localized: "\u0423\u0439\u0442\u0438 \u043D\u0435 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535723
    m_Localized: "\u0412\u044B \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0438 \u043E\u0431\u043E\u0448\u043B\u0438
      \u0434\u0435\u0440\u0435\u0432\u043D\u044E \u043F\u043E \u0431\u0435\u0437\u0434\u043E\u0440\u043E\u0436\u044C\u044E.
      \u041A\u0440\u044E\u043A \u0432 \u043F\u043E\u043B\u0434\u043D\u044F, \u043F\u043E\u0442\u0435\u0440\u044F
      \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u043D\u0430 \u043E\u0431\u044A\u0435\u0437\u0434.
      \u041A\u0430\u043C\u0435\u043D\u044C \u0440\u0430\u0441\u0441\u0451\u043A \u0442\u0435\u043D\u0442
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535724
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535725
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u043D\u044F\u043B\u0438 \u043F\u0443\u0441\u0442\u044B\u0435
      \u0440\u0443\u043A\u0438 \u0438 \u0432\u044B\u0448\u043B\u0438 \u0432\u043F\u0435\u0440\u0451\u0434
      \u043E\u0434\u0438\u043D. \u0413\u043E\u0432\u043E\u0440\u0438\u043B\u0438
      \u0434\u043E\u043B\u0433\u043E - \u043E \u0442\u043E\u0432\u0430\u0440\u0430\u0445,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043D\u0443\u0436\u043D\u044B \u0434\u0435\u0440\u0435\u0432\u043D\u0435,
      \u043E \u0447\u0435\u0441\u0442\u043D\u043E\u0439 \u0446\u0435\u043D\u0435.
      \u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430 \u0434\u0435\u0440\u0435\u0432\u043D\u0438
      \u043E\u043F\u0443\u0441\u0442\u0438\u043B \u0432\u0438\u043B\u044B \u043F\u0435\u0440\u0432\u044B\u043C.
      \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u0432\u044B \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u043B\u0438
      \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535726
    m_Localized: "\u041A\u0430\u043C\u0435\u043D\u044C \u043F\u043E\u043F\u0430\u043B
      \u0432 \u043F\u043B\u0435\u0447\u043E. \u0422\u043E\u043B\u043F\u0430 \u043D\u0430\u0434\u0432\u0438\u043D\u0443\u043B\u0430\u0441\u044C.
      \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0431\u0435\u0436\u0430\u0442\u044C
      \u043A \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u043C \u043F\u043E\u0434
      \u0433\u0440\u0430\u0434\u043E\u043C \u043F\u0440\u043E\u043A\u043B\u044F\u0442\u0438\u0439.
      \u0422\u0435\u043B\u0435\u0433\u0443 \u043F\u043E\u0434\u043E\u0436\u0433\u043B\u0438,
      \u0435\u043B\u0435 \u043F\u043E\u0442\u0443\u0448\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535727
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u043E\u0442\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535728
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0432\u0441\u0442\u0430\u043B
      \u043C\u0435\u0436\u0434\u0443 \u0442\u043E\u043B\u043F\u043E\u0439 \u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u043C, \u0449\u0438\u0442\u043E\u043C
      \u0432\u043F\u0435\u0440\u0451\u0434. \u041D\u0435 \u043D\u0430\u043F\u0430\u0434\u0430\u043B
      - \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0442\u043E\u044F\u043B \u0441\u0442\u0435\u043D\u043E\u0439,
      \u043F\u043E\u043A\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u043B\u0438\u0441\u044C.
      \u041A\u0430\u043C\u043D\u0438 \u0431\u0438\u043B\u0438\u0441\u044C \u043E
      \u0449\u0438\u0442, \u043D\u043E \u043D\u0438\u043A\u0442\u043E \u043D\u0435
      \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535729
    m_Localized: "\u0428\u0451\u043B\u043A \u0437\u0430 \u043F\u0440\u043E\u043F\u0443\u0441\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535730
    m_Localized: "\u041D\u0430 \u043C\u043E\u0441\u0442\u0443 \u0447\u0435\u0440\u0435\u0437
      \u0440\u0430\u0437\u043B\u0438\u0432\u0448\u0443\u044E\u0441\u044F \u0440\u0435\u043A\u0443
      \u0441\u0442\u043E\u0438\u0442 \u0437\u0430\u0441\u0442\u0430\u0432\u0430.
      \u0422\u0430\u043D\u0441\u043A\u0438\u0439 \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u0432 \u043F\u043E\u0442\u0451\u0440\u0442\u043E\u043C \u0448\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u0445\u0430\u043B\u0430\u0442\u0435 \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442
      \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0435 \u0433\u0440\u0430\u043C\u043E\u0442\u044B.
      \u0412\u0430\u0448\u0438 - \u043F\u0440\u043E\u0441\u0440\u043E\u0447\u0435\u043D\u044B
      \u0438\u043B\u0438 \u0432\u043E\u0432\u0441\u0435 \u043F\u043E\u0434\u0434\u0435\u043B\u044C\u043D\u044B.
      \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u0437\u0430\u0434\u0443\u043C\u0447\u0438\u0432\u043E
      \u043F\u043E\u0433\u043B\u0430\u0436\u0438\u0432\u0430\u0435\u0442 \u0431\u043E\u0440\u043E\u0434\u043A\u0443,
      \u043F\u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F \u043D\u0430 \u0442\u044E\u043A\u0438
      \u0441 \u043F\u0430\u0440\u0447\u043E\u0439. \u041D\u0430\u043C\u0451\u043A
      \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u0435\u0435 \u0441\u0442\u0435\u043A\u043B\u0430.\r\n\r\n<npc_speech
      lang=\"Chinese\">\u041F\u0443\u0442\u043D\u0438\u043A\u0443 \u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442
      \u0438\u043C\u0435\u0442\u044C \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u0443\u044E
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443. \u041D\u043E... \u0431\u044B\u0442\u044C
      \u043C\u043E\u0436\u0435\u0442, \u043C\u044B \u043D\u0430\u0439\u0434\u0451\u043C
      \u0432\u044B\u0445\u043E\u0434.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535731
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u043E\u0442\u0440\u0435\u0437
      \u043F\u0430\u0440\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535732
    m_Localized: "\u041E\u0442\u0440\u0435\u0437 \u043F\u0430\u0440\u0447\u0438 \u0438\u0441\u0447\u0435\u0437
      \u043F\u043E\u0434 \u043F\u043E\u043B\u043E\u0439 \u0445\u0430\u043B\u0430\u0442\u0430
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0430. \u041F\u0435\u0447\u0430\u0442\u044C
      \u043B\u0435\u0433\u043B\u0430 \u043D\u0430 \u0441\u0432\u0435\u0436\u0443\u044E
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443. \xAB\u041F\u0440\u043E\u0435\u0437\u0436\u0430\u0439\u0442\u0435,
      \u043F\u043E\u0447\u0442\u0435\u043D\u043D\u044B\u0435.\xBB \u041C\u043E\u0441\u0442
      \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535733
    m_Localized: "\u041D\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u0442\u044C \u043D\u0430
      \u043F\u0440\u0430\u0432\u0435 \u043F\u0440\u043E\u0435\u0437\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535734
    m_Localized: "\u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u043F\u043E\u0436\u0430\u043B
      \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438 \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u043B
      \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u043C\u043E\u0441\u0442. \u0422\u0440\u0438
      \u0434\u043D\u044F \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F, \u043F\u043E\u043A\u0430
      \xAB\u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044E\u0442 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B\xBB.
      \u041F\u0440\u0438\u043F\u0430\u0441\u044B \u0442\u0430\u044E\u0442, \u043B\u044E\u0434\u0438
      \u0440\u043E\u043F\u0449\u0443\u0442, \u0430 \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u043F\u044C\u0451\u0442 \u0447\u0430\u0439 \u043D\u0430 \u0442\u043E\u043C
      \u0431\u0435\u0440\u0435\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535735
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u0431\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535736
    m_Localized: "\u041D\u0438\u0436\u0435 \u043F\u043E \u0442\u0435\u0447\u0435\u043D\u0438\u044E
      \u043D\u0430\u0448\u0451\u043B\u0441\u044F \u043C\u0435\u043B\u043A\u0438\u0439
      \u0431\u0440\u043E\u0434. \u0422\u0435\u043B\u0435\u0433\u0438 \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u043B\u0438
      \u043D\u0430 \u0440\u0443\u043A\u0430\u0445 - \u0442\u044F\u0436\u0435\u043B\u043E,
      \u043D\u043E \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C. \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u043D\u0430 \u043C\u043E\u0441\u0442\u0443 \u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u0432\u0441\u043B\u0435\u0434 \u0441 \u043A\u0438\u0441\u043B\u044B\u043C
      \u043B\u0438\u0446\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535737
    m_Localized: "\u0411\u0440\u043E\u0434 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0433\u043B\u0443\u0431\u0436\u0435, \u0447\u0435\u043C \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C.
      \u0422\u0435\u043B\u0435\u0433\u0430 \u0437\u0430\u0441\u0442\u0440\u044F\u043B\u0430
      \u043F\u043E\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435, \u0438 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0440\u0430\u0437\u0433\u0440\u0443\u0436\u0430\u0442\u044C \u043F\u0440\u044F\u043C\u043E
      \u0432 \u0432\u043E\u0434\u0435. \u041D\u0430\u043C\u043E\u043A\u043B\u0438
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u0438 \u0447\u0430\u0441\u0442\u044C
      \u0442\u043E\u0432\u0430\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535738
    m_Localized: "\u0427\u0430\u0439 \u043E\u0442\u0448\u0435\u043B\u044C\u043D\u0438\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535739
    m_Localized: "\u0423 \u0433\u043E\u0440\u043D\u043E\u0439 \u0442\u0440\u043E\u043F\u044B,
      \u0432 \u0442\u0435\u043D\u0438 \u043D\u0430\u0432\u0438\u0441\u0430\u044E\u0449\u0435\u0439
      \u0441\u043A\u0430\u043B\u044B, \u0441\u0438\u0434\u0438\u0442 \u0441\u0442\u0430\u0440\u0438\u043A
      \u0432 \u0440\u0432\u0430\u043D\u043E\u043C \u0445\u0430\u043B\u0430\u0442\u0435.
      \u041F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C \u043A\u0430\u043C\u0435\u043D\u043D\u0430\u044F
      \u0447\u0430\u0448\u0430 \u0438 \u043F\u043E\u0442\u0443\u0445\u0448\u0438\u0439
      \u043E\u0447\u0430\u0433. \u041E\u043D \u043D\u0435 \u043F\u0440\u043E\u0441\u0438\u0442
      \u043F\u043E\u0434\u0430\u044F\u043D\u0438\u044F, \u043F\u0440\u043E\u0441\u0442\u043E
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442. \u041D\u043E \u0435\u0433\u043E
      \u0433\u043B\u0430\u0437\u0430 \u044F\u0441\u043D\u044B, \u043A\u0430\u043A
      \u0433\u043E\u0440\u043D\u044B\u0439 \u0440\u0443\u0447\u0435\u0439. \u041B\u044E\u0434\u0438
      \u0448\u0435\u043F\u0447\u0443\u0442: \u044D\u0442\u043E \u0434\u0430\u043E\u0441\u0441\u043A\u0438\u0439
      \u043E\u0442\u0448\u0435\u043B\u044C\u043D\u0438\u043A, \u0430 \u043C\u043E\u0436\u0435\u0442,
      \u0431\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u043C\u043E\u043D\u0430\u0445,
      \u043F\u043E\u043A\u0438\u043D\u0443\u0432\u0448\u0438\u0439 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C
      \u0440\u0430\u0434\u0438 \u043F\u0440\u043E\u0441\u0432\u0435\u0442\u043B\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535740
    m_Localized: "\u0423\u0433\u043E\u0441\u0442\u0438\u0442\u044C \u0444\u0438\u043D\u0438\u043A\u0430\u043C\u0438
      \u0438 \u0447\u0430\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535741
    m_Localized: "\u0421\u0442\u0430\u0440\u0438\u043A \u043F\u0440\u0438\u043D\u044F\u043B
      \u0444\u0438\u043D\u0438\u043A\u0438 \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C.
      \u0417\u0430\u0432\u0430\u0440\u0438\u043B \u0447\u0430\u0439 \u0438\u0437
      \u0442\u0440\u0430\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0440\u043E\u0441\u043B\u0438
      \u0442\u0443\u0442 \u0436\u0435, \u0443 \u0441\u043A\u0430\u043B\u044B. \u0412\u044B
      \u043F\u0438\u043B\u0438 \u0432\u043C\u0435\u0441\u0442\u0435, \u043C\u043E\u043B\u0447\u0430.
      \u041F\u043E\u0442\u043E\u043C \u043E\u043D \u0443\u043A\u0430\u0437\u0430\u043B
      \u043D\u0430 \u0442\u0440\u043E\u043F\u0443: \xAB\u0422\u0430\u043C, \u0437\u0430
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u043E\u043C, \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A.
      \u0412\u043E\u0434\u0430 \u0447\u0438\u0441\u0442\u0430\u044F.\xBB \u0411\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u0431\u0435\u0437 \u0441\u043B\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535742
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535743
    m_Localized: "\u0412\u044B \u043A\u0438\u0432\u043D\u0443\u043B\u0438 \u0441\u0442\u0430\u0440\u0438\u043A\u0443
      \u0438 \u043F\u0440\u043E\u0448\u043B\u0438 \u043C\u0438\u043C\u043E. \u041E\u043D
      \u043D\u0435 \u043E\u043A\u043B\u0438\u043A\u043D\u0443\u043B, \u043D\u0435
      \u043E\u0431\u0438\u0434\u0435\u043B\u0441\u044F, \u043F\u0440\u043E\u0441\u0442\u043E
      \u0437\u0430\u043A\u0440\u044B\u043B \u0433\u043B\u0430\u0437\u0430. \u041D\u043E
      \u043A\u0442\u043E-\u0442\u043E \u0438\u0437 \u043B\u044E\u0434\u0435\u0439
      \u043E\u0433\u043B\u044F\u043D\u0443\u043B\u0441\u044F \u0438 \u043F\u0435\u0440\u0435\u043A\u0440\u0435\u0441\u0442\u0438\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535744
    m_Localized: "\u041E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u0438 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707550535745
    m_Localized: "\u0412\u044B \u0441\u0435\u043B\u0438 \u0440\u044F\u0434\u043E\u043C.
      \u0421\u0442\u0430\u0440\u0438\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u043C\u0430\u043B\u043E: \u043E \u0432\u0435\u0442\u0440\u0435, \u043E \u043A\u0430\u043C\u043D\u044F\u0445,
      \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0434\u043E\u0440\u043E\u0433\u0430
      \u0443\u0447\u0438\u0442 \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u044E.
      \u041F\u0440\u043E\u0441\u0442\u044B\u0435 \u0441\u043B\u043E\u0432\u0430,
      \u043D\u043E \u043B\u044E\u0434\u0438 \u0441\u043B\u0443\u0448\u0430\u043B\u0438
      \u043C\u043E\u043B\u0447\u0430. \u0412\u0435\u0447\u0435\u0440\u043E\u043C
      \u043B\u0430\u0433\u0435\u0440\u044C \u0431\u044B\u043B \u0442\u0438\u0448\u0435
      \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E, \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439,
      \u043D\u0435 \u0442\u0440\u0435\u0432\u043E\u0436\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554729984
    m_Localized: "\u041F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0435 \u0445\u0440\u0430\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554729985
    m_Localized: "\u041D\u0430 \u043F\u0435\u0440\u0435\u043A\u0440\u0451\u0441\u0442\u043A\u0435
      \u0434\u043E\u0440\u043E\u0433 - \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439 \u0445\u0440\u0430\u043C.
      \u041D\u0438 \u043C\u043E\u043D\u0430\u0445\u0430, \u043D\u0438 \u0441\u0442\u0440\u0430\u0436\u0438,
      \u0442\u043E\u043B\u044C\u043A\u043E \u043C\u0430\u0441\u043B\u044F\u043D\u0430\u044F
      \u043B\u0430\u043C\u043F\u0430 \u0433\u043E\u0440\u0438\u0442 \u043F\u0435\u0440\u0435\u0434
      \u0441\u0442\u0430\u0442\u0443\u0435\u0439 \u0411\u0443\u0434\u0434\u044B,
      \u0441\u0442\u0451\u0440\u0448\u0435\u0439\u0441\u044F \u043E\u0442 \u0434\u043E\u0436\u0434\u0435\u0439.
      \u041F\u0430\u0445\u043D\u0435\u0442 \u0441\u0430\u043D\u0434\u0430\u043B\u043E\u043C
      \u0438 \u0441\u0442\u0430\u0440\u044B\u043C \u043A\u0430\u043C\u043D\u0435\u043C.
      \u0412\u0430\u0448 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F,
      \u0438 \u043B\u044E\u0434\u0438 \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u043D\u0430 \u0445\u0440\u0430\u043C \u0441 \u0431\u043B\u0430\u0433\u043E\u0433\u043E\u0432\u0435\u043D\u0438\u0435\u043C.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445 \u0442\u0438\u0445\u043E
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442: \xAB\u0425\u043E\u0440\u043E\u0448\u0435\u0435
      \u043C\u0435\u0441\u0442\u043E. \u041D\u0430\u0434\u043E \u0431\u044B \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0435.\xBB\r\n\r\n<npc_speech
      lang=\"Sanskrit\">\u041A\u0442\u043E \u0434\u0430\u0451\u0442 - \u043E\u0431\u0440\u0435\u0442\u0430\u0435\u0442
      \u0437\u0430\u0441\u043B\u0443\u0433\u0443.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554729986
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043B\u0430\u0434\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554729987
    m_Localized: "\u0414\u044B\u043C \u043B\u0430\u0434\u0430\u043D\u0430 \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F
      \u043A \u043F\u043E\u0442\u043E\u043B\u043A\u0443 \u0445\u0440\u0430\u043C\u0430.
      \u041B\u044E\u0434\u0438 \u0441\u0442\u043E\u044F\u043B\u0438 \u043C\u043E\u043B\u0447\u0430,
      \u0441\u043A\u043B\u043E\u043D\u0438\u0432 \u0433\u043E\u043B\u043E\u0432\u044B.
      \u041A\u043E\u0433\u0434\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0442\u0440\u043E\u043D\u0443\u043B\u0441\u044F,
      \u0438\u0434\u0442\u0438 \u0441\u0442\u0430\u043B\u043E \u043B\u0435\u0433\u0447\u0435
      - \u043D\u0435 \u043D\u043E\u0433\u0430\u043C, \u0430 \u0434\u0443\u0448\u0435.
      \u041C\u0435\u0441\u0442\u043D\u044B\u0435 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
      \u0432\u0438\u0434\u0435\u043B\u0438 \u0434\u044B\u043C \u0438 \u043A\u0438\u0432\u0430\u043B\u0438
      \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554729988
    m_Localized: "\u041F\u043E\u043C\u043E\u043B\u0438\u0442\u044C\u0441\u044F \u0431\u0435\u0437
      \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554729989
    m_Localized: "\u0412\u044B \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u0438 \u043F\u0435\u0440\u0435\u0434
      \u0441\u0442\u0430\u0442\u0443\u0435\u0439. \u041D\u0435 \u0431\u044B\u043B\u043E
      \u0441\u043B\u043E\u0432 - \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0438\u0448\u0438\u043D\u0430
      \u0438 \u0437\u0430\u043F\u0430\u0445 \u043C\u0430\u0441\u043B\u0430. \u042D\u0442\u043E\u0433\u043E
      \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E.
      \u041B\u044E\u0434\u0438 \u0434\u0432\u0438\u043D\u0443\u043B\u0438\u0441\u044C
      \u0434\u0430\u043B\u044C\u0448\u0435 \u0447\u0443\u0442\u044C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554729990
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554729991
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0435\u0445\u0430\u043B
      \u043C\u0438\u043C\u043E \u0445\u0440\u0430\u043C\u0430, \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044F\u0441\u044C.
      \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u0441 \u0443\u043A\u043E\u0440\u0438\u0437\u043D\u043E\u0439.
      \u0421\u0443\u0435\u0432\u0435\u0440\u0438\u0435 \u0438\u043B\u0438 \u043D\u0435\u0442,
      \u043D\u043E \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u043A\u0442\u043E-\u0442\u043E
      \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u043B\u0441\u044F \u043D\u0430
      \u0434\u0443\u0440\u043D\u043E\u0439 \u0441\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554729992
    m_Localized: "\u0422\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u044B\u0439 \u0434\u043E\u0441\u043C\u043E\u0442\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554729993
    m_Localized: "\u041F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u044B\u0439
      \u043F\u043E\u0441\u0442 \u043D\u0430 \u0433\u0440\u0430\u043D\u0438\u0446\u0435
      \u043F\u0440\u043E\u0432\u0438\u043D\u0446\u0438\u0438. \u041F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439
      \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0438\u043A \u0432 \u0442\u044E\u0440\u0431\u0430\u043D\u0435
      \u0441 \u0437\u043E\u043B\u043E\u0442\u043E\u0439 \u043A\u0430\u0439\u043C\u043E\u0439
      \u043C\u0435\u0442\u043E\u0434\u0438\u0447\u043D\u043E \u0432\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0442\u044E\u043A, \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u044F
      \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435 \u043D\u0430 \u0433\u043B\u0438\u043D\u044F\u043D\u043E\u0439
      \u0442\u0430\u0431\u043B\u0438\u0447\u043A\u0435. \u0420\u044F\u0434\u043E\u043C
      \u0441\u0442\u043E\u044F\u0442 \u0434\u0432\u043E\u0435 \u0441\u043E\u043B\u0434\u0430\u0442
      \u0441 \u043A\u043E\u043F\u044C\u044F\u043C\u0438. \u0422\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0438\u043A
      \u044F\u0432\u043D\u043E \u0438\u0449\u0435\u0442 \u043F\u043E\u0432\u043E\u0434
      \u0434\u043B\u044F \u043A\u043E\u043D\u0444\u0438\u0441\u043A\u0430\u0446\u0438\u0438
      - \u0438\u043B\u0438 \u0432\u0437\u044F\u0442\u043A\u0438.\r\n\r\n<npc_speech
      lang=\"Persian\">\u0420\u0430\u0441\u043A\u0440\u043E\u0439\u0442\u0435 \u0442\u044E\u043A\u0438.
      \u0412\u0441\u0451 \u043F\u043E\u0434\u043B\u0435\u0436\u0438\u0442 \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0443.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554729994
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043F\u043E\u0448\u043B\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554729995
    m_Localized: "\u0421\u0435\u0440\u0435\u0431\u0440\u043E \u043F\u0435\u0440\u0435\u0448\u043B\u043E
      \u0438\u0437 \u0440\u0443\u043A \u0432 \u0440\u0443\u043A\u0438. \u0422\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0438\u043A
      \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u0437\u0430\u043F\u0438\u0441\u0430\u043B
      \u0441\u0443\u043C\u043C\u0443, \u043E\u0442\u0441\u0447\u0438\u0442\u0430\u043B
      \u043C\u043E\u043D\u0435\u0442\u044B \u0438 \u0432\u044B\u0434\u0430\u043B
      \u043F\u0440\u043E\u043F\u0443\u0441\u043A. \u0417\u0430\u043A\u043E\u043D\u043D\u043E,
      \u043D\u043E \u0434\u043E\u0440\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554729996
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u043E\u0432\u0435\u0437\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554729997
    m_Localized: "\u0412\u044B \u043F\u0435\u0440\u0435\u043B\u043E\u0436\u0438\u043B\u0438
      \u0446\u0435\u043D\u043D\u044B\u0435 \u0442\u043E\u0432\u0430\u0440\u044B \u0432
      \u0434\u0432\u043E\u0439\u043D\u043E\u0435 \u0434\u043D\u043E \u043A\u043E\u0440\u0437\u0438\u043D\u044B,
      \u0430 \u0441\u0432\u0435\u0440\u0445\u0443 - \u0434\u0435\u0448\u0451\u0432\u044B\u0439
      \u0445\u043B\u043E\u043F\u043E\u043A. \u0422\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0438\u043A
      \u043A\u043E\u0432\u044B\u0440\u044F\u043B \u0432\u0435\u0440\u0445\u043D\u0438\u0435
      \u0441\u043B\u043E\u0438, \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u043D\u0430\u0448\u0451\u043B \u0438 \u043C\u0430\u0445\u043D\u0443\u043B
      \u0440\u0443\u043A\u043E\u0439: \u043F\u0440\u043E\u0435\u0437\u0436\u0430\u0439\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554729998
    m_Localized: "\u0422\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0438\u043A \u043D\u0430\u0448\u0451\u043B
      \u0442\u0430\u0439\u043D\u0438\u043A \u0441 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E
      \u0442\u044E\u043A\u0430. \u0423\u0441\u043C\u0435\u0445\u043D\u0443\u043B\u0441\u044F,
      \u043A\u0430\u043A \u043A\u043E\u0442 \u043F\u0435\u0440\u0435\u0434 \u043C\u044B\u0448\u044C\u044E.
      \u041A\u043E\u043D\u0444\u0438\u0441\u043A\u0430\u0446\u0438\u044F, \u0448\u0442\u0440\u0430\u0444
      \u0438 \u043F\u043E\u043C\u0435\u0442\u043A\u0430 \u0432 \u0442\u0430\u0431\u043B\u0438\u0447\u043A\u0435.
      \u0412\u0430\u0448\u0435 \u0438\u043C\u044F \u0442\u0435\u043F\u0435\u0440\u044C
      \u0432 \u0438\u0445 \u0441\u043F\u0438\u0441\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554729999
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0437\u043D\u0430\u0435\u0442 \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730000
    m_Localized: "\u0412\u0430\u0448 \u0441\u043F\u0443\u0442\u043D\u0438\u043A-\u043A\u0443\u043F\u0435\u0446
      \u0443\u0437\u043D\u0430\u043B \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0438\u043A\u0430:
      \u0441\u0442\u0430\u0440\u044B\u0439 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439
      \u043F\u043E \u0434\u0435\u043B\u0430\u043C \u0432 \u0420\u0435\u0435. \u041F\u0430\u0440\u0430
      \u0441\u043B\u043E\u0432, \u0434\u0440\u0443\u0436\u0435\u0441\u043A\u0438\u0439
      \u0436\u0435\u0441\u0442, \u0438 \u043F\u043E\u0448\u043B\u0438\u043D\u0430
      \u0447\u0443\u0434\u0435\u0441\u043D\u044B\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C
      \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u043B\u0430\u0441\u044C \u0432\u0442\u0440\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730001
    m_Localized: "\u041F\u043E\u0434\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u0448\u0451\u043B\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730002
    m_Localized: "\u041D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435 \u043A
      \u0432\u0430\u043C \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0441 \u0443\u0437\u043A\u0438\u043C
      \u043B\u0438\u0446\u043E\u043C \u0438 \u0431\u0435\u0433\u0430\u044E\u0449\u0438\u043C\u0438
      \u0433\u043B\u0430\u0437\u0430\u043C\u0438. \u041F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
      \xAB\u043F\u0435\u0440\u0432\u043E\u0441\u043E\u0440\u0442\u043D\u044B\u0439
      \u0448\u0451\u043B\u043A \u0438\u0437 \u0425\u0430\u043D\u0447\u0436\u043E\u0443\xBB
      \u043F\u043E \u0446\u0435\u043D\u0435 \u0432\u0442\u0440\u043E\u0435 \u043D\u0438\u0436\u0435
      \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439. \u0422\u044E\u043A\u0438
      \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442 \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u043E,
      \u043D\u043E \u0447\u0442\u043E-\u0442\u043E \u043D\u0435 \u0442\u0430\u043A
      - \u0448\u0451\u043B\u043A \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0442\u044F\u0436\u0451\u043B\u044B\u0439,
      \u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u0441\u044F.\r\n\r\n<npc_speech
      lang=\"Sogdian\">\u041B\u0443\u0447\u0448\u0438\u0439 \u0448\u0451\u043B\u043A!
      \u0418\u0437 \u0425\u0430\u043D\u0447\u0436\u043E\u0443! \u0426\u0435\u043D\u0430
      \u0445\u043E\u0440\u043E\u0448\u0430\u044F, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0434\u043B\u044F \u0432\u0430\u0441.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730003
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730004
    m_Localized: "\u0412\u044B \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B\u0438,
      \u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0438\u0441\u0447\u0435\u0437
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u043F\u0435\u0441\u0447\u0430\u043D\u043E\u0439
      \u043B\u0438\u0441\u044B. \u0412 \u0433\u043E\u0440\u043E\u0434\u0435 \u0432\u044B\u044F\u0441\u043D\u0438\u043B\u043E\u0441\u044C:
      \xAB\u0448\u0451\u043B\u043A\xBB - \u043A\u0440\u0430\u0448\u0435\u043D\u044B\u0439
      \u043B\u0451\u043D, \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D\u043D\u044B\u0439
      \u043C\u0430\u0441\u043B\u043E\u043C \u0434\u043B\u044F \u0431\u043B\u0435\u0441\u043A\u0430.
      \u041F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0438 \u0441\u043C\u0435\u044F\u043B\u0438\u0441\u044C
      \u0432\u0430\u043C \u0432 \u043B\u0438\u0446\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730005
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730006
    m_Localized: "\u0412\u044B \u043F\u043E\u0442\u0451\u0440\u043B\u0438 \u0442\u043A\u0430\u043D\u044C
      \u043C\u0435\u0436\u0434\u0443 \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438,
      \u043F\u043E\u0434\u043D\u0435\u0441\u043B\u0438 \u043A \u0441\u0432\u0435\u0442\u0443,
      \u043F\u043E\u043D\u044E\u0445\u0430\u043B\u0438. \u0424\u0430\u043B\u044C\u0448\u0438\u0432\u043A\u0430.
      \u0412\u044B \u043D\u0430\u0437\u0432\u0430\u043B\u0438 \u043C\u043E\u0448\u0435\u043D\u043D\u0438\u043A\u0430
      \u0432\u0441\u043B\u0443\u0445 - \u043E\u043D \u043F\u043E\u0431\u043B\u0435\u0434\u043D\u0435\u043B
      \u0438 \u0443\u0431\u0435\u0436\u0430\u043B. \u0412\u0430\u0448\u0438 \u043B\u044E\u0434\u0438
      \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0437\u0430\u0433\u0443\u0434\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730007
    m_Localized: "\u0412\u044B \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
      \u0442\u043A\u0430\u043D\u044C \u0438 \u043D\u0435 \u043D\u0430\u0448\u043B\u0438
      \u043F\u043E\u0434\u0432\u043E\u0445\u0430. \u041A\u0443\u043F\u0438\u043B\u0438.
      \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0440\u044B\u043D\u043A\u0435
      \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u0441\u0442\u0430\u0440\u044B\u0439
      \u0442\u043A\u0430\u0447 \u043F\u043E\u043A\u0430\u0447\u0430\u043B \u0433\u043E\u043B\u043E\u0432\u043E\u0439:
      \xAB\u042D\u0442\u043E \u043D\u0435 \u0448\u0451\u043B\u043A, \u0441\u044B\u043D\u043E\u043A.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730008
    m_Localized: "\u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730009
    m_Localized: "\u0412\u044B \u0443\u043A\u0430\u0437\u0430\u043B\u0438 \u043D\u0430
      \u0434\u043E\u0440\u043E\u0433\u0443. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u043F\u043E\u0436\u0430\u043B \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438
      \u043F\u043E\u0431\u0440\u0451\u043B \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443. \u0412\u0430\u0448\u0438
      \u043B\u044E\u0434\u0438 \u0437\u0430\u0448\u0435\u043F\u0442\u0430\u043B\u0438\u0441\u044C:
      \xAB\u041C\u043E\u0436\u0435\u0442, \u0437\u0440\u044F \u043D\u0435 \u043A\u0443\u043F\u0438\u043B\u0438?\xBB
      \u041C\u043E\u0436\u0435\u0442, \u0438 \u0437\u0440\u044F. \u041D\u043E \u0441\u043A\u043E\u0440\u0435\u0435
      \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730010
    m_Localized: "\u0422\u044E\u043A \u0443 \u0434\u043E\u0440\u043E\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730011
    m_Localized: "\u041D\u0430 \u043E\u0431\u043E\u0447\u0438\u043D\u0435, \u043F\u043E\u043B\u0443\u0437\u0430\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0439
      \u043F\u044B\u043B\u044C\u044E, \u043B\u0435\u0436\u0438\u0442 \u0442\u044E\u043A.
      \u0412\u0435\u0440\u0451\u0432\u043A\u0438 \u043F\u043E\u0440\u0432\u0430\u043D\u044B,
      \u0442\u043A\u0430\u043D\u044C \u043E\u0431\u0451\u0440\u0442\u043A\u0438 \u0432\u044B\u0446\u0432\u0435\u043B\u0430
      \u043D\u0430 \u0441\u043E\u043B\u043D\u0446\u0435. \u0420\u044F\u0434\u043E\u043C
      \u0441\u043B\u0435\u0434\u044B \u043A\u043E\u043F\u044B\u0442 \u0438 \u043E\u0431\u0440\u044B\u0432\u043E\u043A
      \u0432\u0435\u0440\u0451\u0432\u043A\u0438. \u041A\u0442\u043E-\u0442\u043E
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0433\u0440\u0443\u0437 \u0438\u043B\u0438
      \u0431\u0440\u043E\u0441\u0438\u043B \u0432 \u0441\u043F\u0435\u0448\u043A\u0435.
      \u041C\u043E\u0436\u0435\u0442, \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C,
      \u043C\u043E\u0436\u0435\u0442, \u043C\u0443\u0441\u043E\u0440. \u0410 \u043C\u043E\u0436\u0435\u0442,
      \u043B\u043E\u0432\u0443\u0448\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730012
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730013
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\u0438
      \u0442\u044E\u043A \u043D\u0430 \u043B\u043E\u0432\u0443\u0448\u043A\u0438:
      \u0447\u0438\u0441\u0442\u043E. \u0412\u043D\u0443\u0442\u0440\u0438 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A \u043C\u0435\u0434\u043D\u043E\u0439
      \u043F\u043E\u0441\u0443\u0434\u044B \u0438 \u043C\u0435\u0448\u043E\u0447\u0435\u043A
      \u0441 \u043F\u0435\u0440\u0446\u0435\u043C. \u041D\u0435\u043F\u043B\u043E\u0445\u0430\u044F
      \u0434\u043E\u0431\u044B\u0447\u0430 \u0434\u043B\u044F \u0442\u0435\u0445,
      \u043A\u0442\u043E \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730014
    m_Localized: "\u041F\u043E\u0434 \u0442\u044E\u043A\u043E\u043C \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043D\u043E\u0440\u0430 \u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D\u043E\u0432.
      \u041A\u0442\u043E-\u0442\u043E \u0432\u0441\u043A\u0440\u0438\u043A\u043D\u0443\u043B,
      \u0431\u0440\u043E\u0441\u0438\u043B \u0442\u044E\u043A, \u0438 \u043E\u043D
      \u043F\u043E\u043A\u0430\u0442\u0438\u043B\u0441\u044F \u0432 \u043E\u0432\u0440\u0430\u0433.
      \u041D\u0438 \u0434\u043E\u0431\u044B\u0447\u0438, \u043D\u0438 \u043F\u043E\u043A\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730015
    m_Localized: "\u0417\u0430\u0431\u0440\u0430\u0442\u044C \u043D\u0435 \u0433\u043B\u044F\u0434\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730016
    m_Localized: "\u0422\u044E\u043A \u0437\u0430\u043A\u0438\u043D\u0443\u043B\u0438
      \u043D\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0443. \u041F\u043E\u0442\u043E\u043C
      \u0440\u0430\u0437\u0431\u0435\u0440\u0451\u0442\u0435\u0441\u044C. \u0412\u0435\u0447\u0435\u0440\u043E\u043C
      \u043D\u0430\u0448\u043B\u0438 \u0432\u043D\u0443\u0442\u0440\u0438 \u043F\u0430\u0440\u0443
      \u043C\u043E\u0442\u043A\u043E\u0432 \u0445\u043B\u043E\u043F\u043A\u0430.
      \u041D\u0435 \u0437\u043E\u043B\u043E\u0442\u043E, \u043D\u043E \u0438 \u043D\u0435
      \u043F\u0443\u0441\u0442\u043E. \u0410 \u0447\u0443\u0432\u0441\u0442\u0432\u043E
      \u0442\u0440\u0435\u0432\u043E\u0433\u0438: \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E
      \u0434\u043E\u0440\u043E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730017
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730018
    m_Localized: "\u0427\u0443\u0436\u043E\u0435 \u0434\u043E\u0431\u0440\u043E,
      \u0447\u0443\u0436\u0438\u0435 \u0431\u0435\u0434\u044B. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u0440\u043E\u0448\u0451\u043B \u043C\u0438\u043C\u043E, \u043D\u0435
      \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u044F\u0441\u044C. \u041C\u0443\u0434\u0440\u043E\u0441\u0442\u044C
      \u0438\u043B\u0438 \u0442\u0440\u0443\u0441\u043E\u0441\u0442\u044C: \u0437\u0430\u0432\u0438\u0441\u0438\u0442
      \u043E\u0442 \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0431\u044B\u043B\u043E
      \u0432\u043D\u0443\u0442\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730019
    m_Localized: "\u041E\u0431\u043C\u0435\u043D \u0441 \u0447\u0443\u0436\u0435\u0441\u0442\u0440\u0430\u043D\u0446\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730020
    m_Localized: "\u041D\u0430 \u0448\u0438\u0440\u043E\u043A\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0435
      \u0432\u0441\u0442\u0440\u0435\u0447\u043D\u044B\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      - \u0430\u0440\u0430\u0431\u0441\u043A\u0438\u0435 \u043A\u0443\u043F\u0446\u044B
      \u043D\u0430 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430\u0445, \u0433\u0440\u0443\u0436\u0451\u043D\u044B\u0445
      \u0442\u044E\u043A\u0430\u043C\u0438 \u0441 \u0431\u043B\u0430\u0433\u043E\u0432\u043E\u043D\u0438\u044F\u043C\u0438
      \u0438 \u0441\u043F\u0435\u0446\u0438\u044F\u043C\u0438. \u0421\u0442\u0430\u0440\u0448\u0438\u0439
      \u043A\u0443\u043F\u0435\u0446 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0440\u0443\u043A\u0443 \u0432 \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043D\u0430 \u043B\u043E\u043C\u0430\u043D\u043E\u043C
      \u0444\u0430\u0440\u0441\u0438, \u0447\u0442\u043E \u0433\u043E\u0442\u043E\u0432
      \u043A \u043E\u0431\u043C\u0435\u043D\u0443. \u0422\u043E\u0432\u0430\u0440\u044B
      \u0440\u0430\u0437\u043D\u044B\u0435, \u0438 \u0432\u044B\u0433\u043E\u0434\u0430
      \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u0430, \u043D\u043E \u044F\u0437\u044B\u043A\u043E\u0432\u043E\u0439
      \u0431\u0430\u0440\u044C\u0435\u0440 \u043C\u0435\u0448\u0430\u0435\u0442 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u043E \u0434\u0435\u0442\u0430\u043B\u044F\u0445.\r\n\r\n<npc_speech lang=\"Arabic\">\u041C\u0438\u0440
      \u0432\u0430\u043C! \u0422\u043E\u0440\u0433\u043E\u0432\u043B\u044F? \u041E\u0431\u043C\u0435\u043D?
      \u0423 \u043C\u0435\u043D\u044F \u0431\u043B\u0430\u0433\u043E\u0432\u043E\u043D\u0438\u044F
      \u0438 \u043F\u0440\u044F\u043D\u043E\u0441\u0442\u0438!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730021
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C \u0436\u0435\u0441\u0442\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730022
    m_Localized: "\u0420\u0443\u043A\u0438, \u043F\u0430\u043B\u044C\u0446\u044B,
      \u0440\u0438\u0441\u0443\u043D\u043A\u0438 \u043D\u0430 \u043F\u0435\u0441\u043A\u0435.
      \u042F\u0437\u044B\u043A \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438 -
      \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u0435\u043D. \u0412\u044B
      \u0432\u044B\u043C\u0435\u043D\u044F\u043B\u0438 \u0445\u043E\u0440\u043E\u0448\u0438\u0439
      \u0442\u043E\u0432\u0430\u0440 \u0438 \u0434\u0430\u0436\u0435 \u0432\u044B\u0443\u0447\u0438\u043B\u0438
      \u043F\u0430\u0440\u0443 \u0430\u0440\u0430\u0431\u0441\u043A\u0438\u0445 \u0441\u043B\u043E\u0432.
      \u041E\u0431\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730023
    m_Localized: "\u041E\u0431\u043C\u0435\u043D \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u0441\u044F,
      \u043D\u043E \u043D\u0435\u043B\u043E\u0432\u043A\u043E. \u0412\u044B \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438
      \u043F\u044F\u0442\u044C \u043F\u0430\u043B\u044C\u0446\u0435\u0432, \u0430
      \u043E\u043D\u0438 \u043F\u043E\u043D\u044F\u043B\u0438 \xAB\u0434\u0435\u0441\u044F\u0442\u044C\xBB.
      \u0418\u0442\u043E\u0433: \u043C\u0435\u043B\u043A\u0438\u0439 \u0443\u0431\u044B\u0442\u043E\u043A
      \u0438 \u0432\u0437\u0430\u0438\u043C\u043D\u043E\u0435 \u043D\u0435\u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435.
      \u041D\u043E \u0445\u043E\u0442\u044F \u0431\u044B \u0431\u0435\u0437 \u0441\u0441\u043E\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730024
    m_Localized: "\u041F\u0440\u0438\u0433\u043B\u0430\u0441\u0438\u0442\u044C \u043D\u0430
      \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u043F\u0440\u0438\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730025
    m_Localized: "\u0412\u044B \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u043B\u0438
      \u0435\u0434\u0443 \u0438 \u043E\u0433\u043E\u043D\u044C. \u0412\u0435\u0447\u0435\u0440
      \u043F\u0440\u043E\u0448\u0451\u043B \u0432 \u043F\u043E\u043F\u044B\u0442\u043A\u0430\u0445
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043D\u0430 \u0441\u043C\u0435\u0441\u0438
      \u044F\u0437\u044B\u043A\u043E\u0432, \u0436\u0435\u0441\u0442\u043E\u0432
      \u0438 \u0441\u043C\u0435\u0445\u0430. \u0423\u0442\u0440\u043E\u043C \u043E\u0431\u043C\u0435\u043D\u044F\u043B\u0438\u0441\u044C
      \u043F\u043E\u0434\u0430\u0440\u043A\u0430\u043C\u0438. \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F
      \u0440\u0430\u0434\u043E\u0441\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730026
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730027
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0441 \u0430\u0440\u0430\u0431\u0430\u043C\u0438 \u043D\u0430 \u0438\u0445
      \u044F\u0437\u044B\u043A\u0435: <npc_speech lang=\"Arabic\">\u041C\u0438\u0440
      \u0432\u0430\u043C! \u041C\u044B \u0445\u043E\u0442\u0438\u043C \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C
      \u0447\u0435\u0441\u0442\u043D\u043E. \u0427\u0442\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u0435
      \u0437\u0430 \u043D\u0430\u0448 \u0448\u0451\u043B\u043A?</npc_speech> \u0421\u0434\u0435\u043B\u043A\u0430
      \u043F\u043E\u0448\u043B\u0430 \u0433\u043B\u0430\u0434\u043A\u043E. \u0426\u0435\u043D\u044B
      \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u044B\u0435, \u0442\u043E\u0432\u0430\u0440
      \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0439. \u0410\u0440\u0430\u0431\u0441\u043A\u0438\u0439
      \u043A\u0443\u043F\u0435\u0446 \u043F\u043E\u0445\u043B\u043E\u043F\u0430\u043B
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u0430 \u043F\u043E
      \u043F\u043B\u0435\u0447\u0443: <npc_speech lang=\"Arabic\">\u0425\u043E\u0440\u043E\u0448\u0438\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0443 \u0442\u0435\u0431\u044F,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730028
    m_Localized: "\u041D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u0430\u044F \u043F\u0435\u0449\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730029
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u043B\u044E\u0434\u0435\u0439
      \u0437\u0430\u043C\u0435\u0442\u0438\u043B \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0443
      \u0432 \u0441\u043A\u0430\u043B\u0435, \u0441\u043A\u0440\u044B\u0442\u0443\u044E
      \u043A\u0443\u0441\u0442\u0430\u0440\u043D\u0438\u043A\u043E\u043C. \u0412\u043D\u0443\u0442\u0440\u0438:
      \u043D\u0435\u0433\u043B\u0443\u0431\u043E\u043A\u0430\u044F \u043F\u0435\u0449\u0435\u0440\u0430
      \u0441 \u043F\u0440\u043E\u0436\u0438\u043B\u043A\u0430\u043C\u0438 \u0437\u0435\u043B\u0435\u043D\u043E\u0432\u0430\u0442\u043E\u0433\u043E
      \u043A\u0430\u043C\u043D\u044F \u0432 \u0441\u0442\u0435\u043D\u0430\u0445.
      \u041D\u0430 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u043C \u0432\u044B\u0441\u0442\u0443\u043F\u0435,
      \u043A\u0430\u043A \u043D\u0430 \u0430\u043B\u0442\u0430\u0440\u0435, \u0441\u0442\u043E\u0438\u0442
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F \u043D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u0430\u044F
      \u0444\u0438\u0433\u0443\u0440\u043A\u0430: \u0434\u0440\u0430\u043A\u043E\u043D,
      \u0441\u0432\u0435\u0440\u043D\u0443\u0432\u0448\u0438\u0439\u0441\u044F \u043A\u043E\u043B\u044C\u0446\u043E\u043C.
      \u041A\u0442\u043E \u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0435\u0451
      \u0437\u0434\u0435\u0441\u044C \u0438 \u0437\u0430\u0447\u0435\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730030
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0444\u0438\u0433\u0443\u0440\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730031
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B\u0438
      \u0440\u0443\u043A\u0443 \u0438 \u0432\u0437\u044F\u043B\u0438 \u0434\u0440\u0430\u043A\u043E\u043D\u0430.
      \u041A\u0430\u043C\u0435\u043D\u044C \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439,
      \u0433\u043B\u0430\u0434\u043A\u0438\u0439, \u0442\u044F\u0436\u0451\u043B\u044B\u0439.
      \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u043E\u0442\u0432\u0435\u043B\u0438 \u0433\u043B\u0430\u0437\u0430, \u043F\u043B\u043E\u0445\u0430\u044F
      \u043F\u0440\u0438\u043C\u0435\u0442\u0430, \u0431\u0440\u0430\u0442\u044C
      \u0441 \u0447\u0443\u0436\u043E\u0433\u043E \u0430\u043B\u0442\u0430\u0440\u044F.
      \u041D\u043E \u043D\u0435\u0444\u0440\u0438\u0442 \u0435\u0441\u0442\u044C
      \u043D\u0435\u0444\u0440\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730032
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u043F\u0435\u0449\u0435\u0440\u0443
      \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730033
    m_Localized: "\u0417\u0430 \u043A\u0430\u043C\u043D\u044F\u043C\u0438 \u0432
      \u0433\u043B\u0443\u0431\u0438\u043D\u0435 \u043F\u0435\u0449\u0435\u0440\u044B
      \u043D\u0430\u0448\u0451\u043B\u0441\u044F \u0442\u0430\u0439\u043D\u0438\u043A:
      \u0444\u0438\u0433\u0443\u0440\u043A\u0430, \u043F\u0430\u0440\u0430 \u043C\u043E\u043D\u0435\u0442
      \u0438 \u0441\u0432\u0451\u0440\u0442\u043E\u043A \u0448\u0451\u043B\u043A\u0430.
      \u0427\u0435\u0439-\u0442\u043E \u0441\u0445\u0440\u043E\u043D, \u0434\u0430\u0432\u043D\u043E
      \u0437\u0430\u0431\u044B\u0442\u044B\u0439. \u0412\u044B \u0437\u0430\u0431\u0440\u0430\u043B\u0438
      \u0432\u0441\u0451, \u043E\u0441\u0442\u0430\u0432\u0438\u0432 \u0432\u0437\u0430\u043C\u0435\u043D
      \u0433\u043E\u0440\u0441\u0442\u044C \u0444\u0438\u043D\u0438\u043A\u043E\u0432.
      \u041E\u0431\u044B\u0447\u0430\u0439 \u0434\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730034
    m_Localized: "\u0412 \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u043F\u0435\u0449\u0435\u0440\u044B
      \u0432\u044B \u0441\u043F\u043E\u0442\u043A\u043D\u0443\u043B\u0438\u0441\u044C
      \u043E \u043A\u0430\u043C\u043D\u0438. \u0428\u0443\u043C \u043F\u0440\u0438\u0432\u043B\u0451\u043A
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435, \u0438 \u043D\u0430\u0443\u0442\u0440\u043E
      \u0443 \u0432\u0445\u043E\u0434\u0430 \u0431\u044B\u043B\u0438 \u0441\u0432\u0435\u0436\u0438\u0435
      \u0441\u043B\u0435\u0434\u044B. \u041A\u0442\u043E-\u0442\u043E \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730035
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043D\u0435\u0442\u0440\u043E\u043D\u0443\u0442\u044B\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730036
    m_Localized: "\u0412\u044B \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u043B\u0438\u0441\u044C
      \u0444\u0438\u0433\u0443\u0440\u043A\u0435 \u0438 \u0432\u044B\u0448\u043B\u0438.
      \u041B\u044E\u0434\u0438 \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0437\u0430\u043A\u0438\u0432\u0430\u043B\u0438. \u0412 \u044D\u0442\u0438\u0445
      \u043A\u0440\u0430\u044F\u0445 \u0447\u0442\u044F\u0442 \u0447\u0443\u0436\u0438\u0435
      \u0441\u0432\u044F\u0442\u044B\u043D\u0438, \u0438 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u044C
      - \u0447\u0430\u0441\u0442\u044C \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730037
    m_Localized: "\u041F\u0440\u0430\u0437\u0434\u043D\u0438\u043A \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730038
    m_Localized: "\u0414\u0435\u0440\u0435\u0432\u043D\u044F \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0430
      \u043B\u0435\u043D\u0442\u0430\u043C\u0438 \u0438 \u0431\u0443\u043C\u0430\u0436\u043D\u044B\u043C\u0438
      \u0444\u043E\u043D\u0430\u0440\u044F\u043C\u0438. \u041F\u0430\u0445\u043D\u0435\u0442
      \u0436\u0430\u0440\u0435\u043D\u044B\u043C \u043C\u044F\u0441\u043E\u043C \u0438
      \u0440\u0438\u0441\u043E\u0432\u044B\u043C \u0432\u0438\u043D\u043E\u043C.
      \u0421\u0435\u0433\u043E\u0434\u043D\u044F \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A
      \u0443\u0440\u043E\u0436\u0430\u044F, \u0438\u043B\u0438 \u0434\u0435\u043D\u044C
      \u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F \u043C\u0435\u0441\u0442\u043D\u043E\u0433\u043E
      \u0434\u0443\u0445\u0430, \u0438\u043B\u0438 \u0441\u0432\u0430\u0434\u044C\u0431\u0430
      \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u044B. \u041B\u044E\u0434\u0438
      \u0437\u043E\u0432\u0443\u0442 \u0432\u0430\u0441 \u043A \u0441\u0442\u043E\u043B\u0443.
      \u041C\u0443\u0437\u044B\u043A\u0430, \u0441\u043C\u0435\u0445, \u0442\u0430\u043D\u0446\u044B.
      \u0412\u0430\u0448\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0443\u0436\u0435 \u043A\u043E\u0441\u044F\u0442\u0441\u044F \u043D\u0430
      \u0432\u0435\u0441\u0435\u043B\u044C\u0435 \u0441 \u0442\u043E\u0441\u043A\u043E\u0439
      \u0433\u043E\u043B\u043E\u0434\u043D\u044B\u0445 \u043F\u0441\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730039
    m_Localized: "\u041F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F
      \u043A \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730040
    m_Localized: "\u0412\u044B \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B\u0438
      \u043B\u044E\u0434\u0435\u0439 \u0433\u0443\u043B\u044F\u0442\u044C \u0438
      \u0441\u0430\u043C\u0438 \u0441\u0435\u043B\u0438 \u0437\u0430 \u0441\u0442\u043E\u043B.
      \u0412\u0438\u043D\u043E, \u043F\u0435\u0441\u043D\u0438, \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0435
      \u043B\u0438\u0446\u0430 - \u0432\u0441\u0451 \u0441\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0442\u0451\u043F\u043B\u044B\u0439 \u0442\u0443\u043C\u0430\u043D.
      \u0423\u0442\u0440\u043E\u043C \u0433\u043E\u043B\u043E\u0432\u044B \u0442\u044F\u0436\u0451\u043B\u044B\u0435,
      \u043D\u043E \u043B\u044E\u0434\u0438 \u0443\u043B\u044B\u0431\u0430\u044E\u0442\u0441\u044F
      \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0437\u0430 \u043D\u0435\u0434\u0435\u043B\u044E.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B
      \u043D\u0430 \u0443\u0433\u043E\u0449\u0435\u043D\u0438\u0435 \u043C\u0435\u0441\u0442\u043D\u044B\u0445
      - \u0442\u0430\u043A \u043F\u0440\u0438\u043D\u044F\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730041
    m_Localized: "\u0423\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044E
      \u043D\u0430 \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730042
    m_Localized: "\u0412\u044B \u0440\u0430\u0437\u043B\u043E\u0436\u0438\u043B\u0438
      \u0442\u043E\u0432\u0430\u0440 \u0443 \u043A\u0440\u0430\u044F \u043F\u043B\u043E\u0449\u0430\u0434\u0438.
      \u041F\u0440\u0430\u0437\u0434\u043D\u0438\u0447\u043D\u043E\u0435 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0440\u0430\u0437\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442 \u043A\u043E\u0448\u0435\u043B\u044C\u043A\u0438.
      \u041A \u043F\u043E\u043B\u0443\u0434\u043D\u044E \u0432\u044B \u043F\u0440\u043E\u0434\u0430\u043B\u0438
      \u0431\u0435\u0437\u0434\u0435\u043B\u0443\u0448\u043A\u0438 \u043F\u043E \u0445\u043E\u0440\u043E\u0448\u0435\u0439
      \u0446\u0435\u043D\u0435, \u0430 \u0432\u0430\u0448\u0438 \u043B\u044E\u0434\u0438
      \u043D\u0430\u043F\u043B\u044F\u0441\u0430\u043B\u0438\u0441\u044C \u0432\u0434\u043E\u0432\u043E\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730043
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u043B\u044F \u043D\u0430 \u0447\u0443\u0436\u043E\u043C
      \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u0435 \u0441\u043E\u0447\u043B\u0438
      \u0434\u0443\u0440\u043D\u044B\u043C \u0442\u043E\u043D\u043E\u043C. \u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430
      \u043D\u0430\u0445\u043C\u0443\u0440\u0438\u043B\u0441\u044F, \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0438
      \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0443\u0431\u0440\u0430\u0442\u044C \u0442\u043E\u0432\u0430\u0440 \u0438
      \u043F\u0440\u043E\u0441\u0442\u043E \u0443\u0433\u043E\u0449\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730044
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730045
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0448\u0451\u043B
      \u0441\u043A\u0432\u043E\u0437\u044C \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u0447\u043D\u0443\u044E
      \u0434\u0435\u0440\u0435\u0432\u043D\u044E, \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044F\u0441\u044C.
      \u041B\u044E\u0434\u0438 \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u043B\u0438
      \u0432\u0435\u0441\u0435\u043B\u044C\u0435 \u0442\u043E\u0441\u043A\u043B\u0438\u0432\u044B\u043C\u0438
      \u0432\u0437\u0433\u043B\u044F\u0434\u0430\u043C\u0438. \u041A\u0442\u043E-\u0442\u043E
      \u0431\u0443\u0440\u043A\u043D\u0443\u043B: \xAB\u0425\u043E\u0437\u044F\u0438\u043D
      - \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0435 \u0441\u0435\u0440\u0434\u0446\u0435.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730046
    m_Localized: "\u041F\u0442\u0438\u0447\u0438\u0439 \u0437\u043D\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730047
    m_Localized: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u043D\u0430\u0434
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u043C \u0437\u0430\u043A\u0440\u0443\u0436\u0438\u043B\u0430\u0441\u044C
      \u0441\u0442\u0430\u044F \u0431\u0435\u043B\u044B\u0445 \u0436\u0443\u0440\u0430\u0432\u043B\u0435\u0439
      - \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044C \u0432 \u044D\u0442\u0438\u0445
      \u043A\u0440\u0430\u044F\u0445. \u041F\u0442\u0438\u0446\u044B \u043A\u0440\u0443\u0436\u0438\u043B\u0438
      \u0442\u0440\u0438\u0436\u0434\u044B, \u0438 \u0441\u0442\u0430\u0440\u0448\u0438\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A \u043F\u0440\u043E\u0448\u0435\u043F\u0442\u0430\u043B:
      \xAB\u0414\u043E\u0431\u0440\u044B\u0439 \u0437\u043D\u0430\u043A. \u0416\u0443\u0440\u0430\u0432\u043B\u0438
      - \u0432\u0435\u0441\u0442\u043D\u0438\u043A\u0438 \u041D\u0435\u0431\u0430.\xBB
      \u041B\u044E\u0434\u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C
      \u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u0432\u0432\u0435\u0440\u0445,
      \u043F\u043E\u0437\u0430\u0431\u044B\u0432 \u043D\u0430 \u043C\u0438\u043D\u0443\u0442\u0443
      \u043E \u0442\u044F\u0433\u043E\u0442\u0430\u0445 \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730048
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0437\u043D\u0430\u043A
      \u0441 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730049
    m_Localized: "\u0412\u044B \u0441\u043A\u043B\u043E\u043D\u0438\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u0443
      \u0438 \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B\u0438
      \u043D\u0435\u0431\u043E. \u041B\u044E\u0434\u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u043B\u0438.
      \u041F\u0440\u043E\u0441\u0442\u043E\u0439 \u0436\u0435\u0441\u0442, \u043D\u043E
      \u043E\u043D \u043D\u0430\u043F\u043E\u043C\u043D\u0438\u043B \u0432\u0441\u0435\u043C:
      \u0434\u043E\u0440\u043E\u0433\u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435, \u043D\u043E \u0438
      \u0447\u0443\u0434\u043E. \u0414\u0435\u043D\u044C \u043F\u0440\u043E\u0448\u0451\u043B
      \u043B\u0435\u0433\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730050
    m_Localized: "\u0420\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u0442\u044C \u0438\u0441\u0442\u043E\u0440\u0438\u044E
      \u043E \u0436\u0443\u0440\u0430\u0432\u043B\u044F\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730051
    m_Localized: "\u0412\u044B \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0438
      \u0441\u0442\u0430\u0440\u0443\u044E \u043B\u0435\u0433\u0435\u043D\u0434\u0443:
      \u0436\u0443\u0440\u0430\u0432\u043B\u0438 \u043D\u0435\u0441\u0443\u0442 \u0434\u0443\u0448\u0438
      \u043F\u0440\u0430\u0432\u0435\u0434\u043D\u0438\u043A\u043E\u0432 \u0432 \u043D\u0435\u0431\u0435\u0441\u043D\u044B\u0435
      \u0441\u0430\u0434\u044B. \u041A\u0442\u043E \u0443\u0432\u0438\u0434\u0438\u0442
      \u0441\u0442\u0430\u044E - \u0442\u043E\u043C\u0443 \u0433\u043E\u0434 \u0443\u0434\u0430\u0447\u0438.
      \u041F\u0440\u0430\u0432\u0434\u0430 \u044D\u0442\u043E \u0438\u043B\u0438
      \u043D\u0435\u0442, \u043D\u043E \u043B\u044E\u0434\u0438 \u0448\u043B\u0438
      \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C \u0441 \u0443\u043B\u044B\u0431\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730052
    m_Localized: "\u0421\u0442\u0430\u0440\u0430\u044F \u043C\u043E\u043D\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730053
    m_Localized: "\u041F\u0440\u0438 \u0440\u0430\u0437\u0431\u0438\u0432\u043A\u0435
      \u043B\u0430\u0433\u0435\u0440\u044F \u043E\u0434\u0438\u043D \u0438\u0437
      \u043B\u044E\u0434\u0435\u0439 \u043D\u0430\u0448\u0451\u043B \u0432 \u0437\u0435\u043C\u043B\u0435
      \u0442\u044F\u0436\u0451\u043B\u0443\u044E \u043C\u043E\u043D\u0435\u0442\u0443
      - \u043F\u043E\u0437\u0435\u043B\u0435\u043D\u0435\u0432\u0448\u0443\u044E
      \u043E\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u0441 \u043F\u0440\u043E\u0444\u0438\u043B\u0435\u043C
      \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F.
      \u0425\u0430\u043D\u044C\u0441\u043A\u0430\u044F? \u041A\u0443\u0448\u0430\u043D\u0441\u043A\u0430\u044F?
      \u0413\u0440\u0435\u043A\u043E-\u0431\u0430\u043A\u0442\u0440\u0438\u0439\u0441\u043A\u0430\u044F?
      \u041A\u0442\u043E \u0431\u044B \u043D\u0438 \u0447\u0435\u043A\u0430\u043D\u0438\u043B
      \u0435\u0451 - \u043E\u043D\u0430 \u0441\u0442\u0430\u0440\u0448\u0435 \u0432\u0441\u0435\u0445
      \u0436\u0438\u0432\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730054
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u0435\u0431\u0435
      \u043A\u0430\u043A \u0442\u0430\u043B\u0438\u0441\u043C\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730055
    m_Localized: "\u0412\u044B \u0441\u043F\u0440\u044F\u0442\u0430\u043B\u0438 \u043C\u043E\u043D\u0435\u0442\u0443
      \u0432 \u043D\u0430\u0433\u0440\u0443\u0434\u043D\u044B\u0439 \u043A\u0430\u0440\u043C\u0430\u043D.
      \u0422\u044F\u0436\u0435\u0441\u0442\u044C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F,
      \u043D\u043E \u043E\u0449\u0443\u0442\u0438\u043C\u0430\u044F. \u0413\u043E\u0432\u043E\u0440\u044F\u0442,
      \u0441\u0442\u0430\u0440\u044B\u0435 \u043C\u043E\u043D\u0435\u0442\u044B \u043F\u0440\u0438\u043D\u043E\u0441\u044F\u0442
      \u0443\u0434\u0430\u0447\u0443 \u0442\u0435\u043C, \u043A\u0442\u043E \u0438\u0445
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442. \u041B\u044E\u0434\u0438 \u043A\u0438\u0432\u043D\u0443\u043B\u0438
      \u0441 \u043E\u0434\u043E\u0431\u0440\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730056
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730057
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u043C\u043E\u043D\u0435\u0442\u0447\u0438\u043A
      \u0432 \u0433\u043E\u0440\u043E\u0434\u0435 \u0434\u043E\u043B\u0433\u043E
      \u0432\u0435\u0440\u0442\u0435\u043B \u043D\u0430\u0445\u043E\u0434\u043A\u0443,
      \u0446\u043E\u043A\u0430\u044F \u044F\u0437\u044B\u043A\u043E\u043C. \u0417\u0430\u043F\u043B\u0430\u0442\u0438\u043B
      \u0432\u043E\u0441\u0435\u043C\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0445
      - \xAB\u0437\u0430 \u0434\u0440\u0435\u0432\u043D\u043E\u0441\u0442\u044C\xBB.
      \u041C\u0435\u043B\u043E\u0447\u044C, \u043D\u043E \u043F\u0440\u0438\u044F\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730058
    m_Localized: "\u0417\u0430\u043A\u0430\u0442 \u043D\u0430\u0434 \u0440\u0430\u0432\u043D\u0438\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730059
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
      \u043D\u0430 \u0433\u0440\u0435\u0431\u043D\u0435 \u0445\u043E\u043B\u043C\u0430.
      \u0412\u043D\u0438\u0437\u0443 - \u0431\u0435\u0441\u043A\u0440\u0430\u0439\u043D\u044F\u044F
      \u0440\u0430\u0432\u043D\u0438\u043D\u0430, \u0437\u0430\u043B\u0438\u0442\u0430\u044F
      \u0437\u0430\u043A\u0430\u0442\u043D\u044B\u043C \u0437\u043E\u043B\u043E\u0442\u043E\u043C.
      \u041D\u0435\u0431\u043E \u043F\u043E\u043B\u044B\u0445\u0430\u0435\u0442 \u043E\u0442
      \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430 \u0434\u043E \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430:
      \u043F\u0443\u0440\u043F\u0443\u0440, \u0448\u0430\u0444\u0440\u0430\u043D,
      \u043C\u0435\u0434\u044C. \u0422\u0438\u0448\u0438\u043D\u0430 \u0442\u0430\u043A\u0430\u044F,
      \u0447\u0442\u043E \u0441\u043B\u044B\u0448\u043D\u043E, \u043A\u0430\u043A
      \u0442\u0440\u0430\u0432\u0430 \u0448\u0435\u043F\u0447\u0435\u0442 \u043D\u0430
      \u0432\u0435\u0442\u0440\u0443. \u041B\u044E\u0434\u0438 \u0437\u0430\u043C\u0435\u0440\u043B\u0438,
      \u0437\u0430\u0431\u044B\u0432 \u043E \u0433\u0440\u0443\u0437\u0435 \u0438
      \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730060
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0438 \u043F\u0435\u0440\u0435\u0434\u043E\u0445\u043D\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730061
    m_Localized: "\u0412\u044B \u043F\u0440\u0438\u043A\u0430\u0437\u0430\u043B\u0438
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0443. \u041B\u044E\u0434\u0438
      \u0441\u0435\u043B\u0438 \u043D\u0430 \u0442\u0440\u0430\u0432\u0443 \u0438
      \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B.
      \u041A\u043E\u0433\u0434\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u043B\u0443\u0447 \u043F\u043E\u0433\u0430\u0441, \u043A\u0442\u043E-\u0442\u043E
      \u0442\u0438\u0445\u043E \u0441\u043A\u0430\u0437\u0430\u043B: \xAB\u0420\u0430\u0434\u0438
      \u044D\u0442\u043E\u0433\u043E \u0438 \u0441\u0442\u043E\u0438\u0442 \u0438\u0434\u0442\u0438.\xBB
      \u041D\u043E\u0447\u044C \u0431\u044B\u043B\u0430 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730062
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730063
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435, \u043D\u043E \u043B\u044E\u0434\u0438
      \u0448\u043B\u0438 \u043C\u043E\u043B\u0447\u0430, \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C
      \u043D\u0430 \u0437\u0430\u043A\u0430\u0442. \u0414\u0430\u0436\u0435 \u043D\u0430
      \u0445\u043E\u0434\u0443 \u043A\u0440\u0430\u0441\u043E\u0442\u0430 \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u043A\u0432\u043E\u0437\u044C \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730064
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
      \u0443\u0447\u0451\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730065
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 - \u043E\u0434\u0438\u043D\u043E\u043A\u0438\u0439
      \u043F\u0443\u0442\u043D\u0438\u043A \u0432 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0435\u043C
      \u0443\u0447\u0451\u043D\u043E\u043C \u0445\u0430\u043B\u0430\u0442\u0435 \u0441
      \u0437\u0430\u043F\u043B\u0435\u0447\u043D\u044B\u043C \u043C\u0435\u0448\u043A\u043E\u043C,
      \u043D\u0430\u0431\u0438\u0442\u044B\u043C \u0441\u0432\u0438\u0442\u043A\u0430\u043C\u0438.
      \u041E\u043D \u0438\u0434\u0451\u0442 \u043E\u0442 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F
      \u043A \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044E, \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u044F
      \u0441\u0443\u0442\u0440\u044B \u0438 \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u044F
      \u043C\u0435\u0441\u0442\u043D\u044B\u0435 \u043D\u0430\u0440\u0435\u0447\u0438\u044F.
      \u0423\u0432\u0438\u0434\u0435\u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u043E\u043D \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F \u0438
      \u043F\u0440\u043E\u0441\u0438\u0442 \u043F\u043E\u0437\u0432\u043E\u043B\u0435\u043D\u0438\u044F
      \u043F\u0440\u043E\u0439\u0442\u0438 \u0447\u0430\u0441\u0442\u044C \u043F\u0443\u0442\u0438
      \u0432\u043C\u0435\u0441\u0442\u0435 - \u0432\u0437\u0430\u043C\u0435\u043D
      \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0443\u0440\u043E\u043A\u0438
      \u044F\u0437\u044B\u043A\u0430.\r\n\r\n<npc_speech lang=\"Chinese\">\u042F
      \u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
      \u0443\u0447\u0451\u043D\u044B\u0439. \u0415\u0441\u043B\u0438 \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u0435
      \u0438\u0434\u0442\u0438 \u0441 \u0432\u0430\u043C\u0438, \u044F \u043D\u0430\u0443\u0447\u0443
      \u0432\u0430\u0441 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C
      \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u043C \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u044F\u043C.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730066
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0438 \u0443\u0447\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730067
    m_Localized: "\u0423\u0447\u0451\u043D\u044B\u0439 \u0448\u0451\u043B \u0441
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u043C \u0442\u0440\u0438 \u0434\u043D\u044F.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0432\u0435\u0447\u0435\u0440 \u0443
      \u043A\u043E\u0441\u0442\u0440\u0430 - \u0443\u0440\u043E\u043A: \u0438\u0435\u0440\u043E\u0433\u043B\u0438\u0444\u044B
      \u043D\u0430 \u043F\u0435\u0441\u043A\u0435, \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0448\u0435\u043D\u0438\u0435
      \u0442\u043E\u043D\u043E\u0432, \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435
      \u0444\u0440\u0430\u0437\u044B. \u041A \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u0430\u043D\u0438\u044E
      \u0432\u044B \u043C\u043E\u0433\u043B\u0438 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0447\u0438\u0441\u0442\u043E\u043C \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730068
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u0435\u0440\u0435\u0432\u0435\u0441\u0442\u0438
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730069
    m_Localized: "\u0423 \u0432\u0430\u0441 \u0431\u044B\u043B \u0441\u0432\u0438\u0442\u043E\u043A
      \u043D\u0430 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C - \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442, \u043A\u0443\u043F\u043B\u0435\u043D\u043D\u044B\u0439
      \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u0435. \u0423\u0447\u0451\u043D\u044B\u0439
      \u043F\u0435\u0440\u0435\u0432\u0451\u043B \u0435\u0433\u043E \u0437\u0430
      \u0443\u0436\u0438\u043D: \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
      \u0442\u0430\u043C \u0443\u043A\u0430\u0437\u0430\u043D\u044B \u043B\u044C\u0433\u043E\u0442\u043D\u044B\u0435
      \u043F\u043E\u0448\u043B\u0438\u043D\u044B \u0434\u043B\u044F \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u0432
      \u0441 \u0448\u0451\u043B\u043A\u043E\u043C. \u0426\u0435\u043D\u043D\u0430\u044F
      \u043D\u0430\u0445\u043E\u0434\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730070
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730071
    m_Localized: "\u0412\u044B \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u043B\u0438\u0441\u044C
      \u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B\u0438, \u0447\u0442\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0438\u0434\u0451\u0442 \u0431\u044B\u0441\u0442\u0440\u043E.
      \u0423\u0447\u0451\u043D\u044B\u0439 \u043A\u0438\u0432\u043D\u0443\u043B \u0431\u0435\u0437
      \u043E\u0431\u0438\u0434\u044B: \xAB\u0414\u043E\u0440\u043E\u0433\u0430 \u0443
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0441\u0432\u043E\u044F.\xBB \u0418
      \u043F\u043E\u0431\u0440\u0451\u043B \u0434\u0430\u043B\u044C\u0448\u0435,
      \u043E\u043F\u0438\u0440\u0430\u044F\u0441\u044C \u043D\u0430 \u043F\u043E\u0441\u043E\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730072
    m_Localized: "\u0417\u0430\u0431\u043B\u0443\u0434\u0438\u0432\u0448\u0438\u0439\u0441\u044F
      \u0440\u0435\u0431\u0451\u043D\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730073
    m_Localized: "\u0423 \u043E\u0431\u043E\u0447\u0438\u043D\u044B \u0441\u0438\u0434\u0438\u0442
      \u043C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u0430 \u043B\u0435\u0442 \u0441\u0435\u043C\u0438:
      \u0431\u043E\u0441\u043E\u0439, \u0432 \u0440\u0432\u0430\u043D\u043E\u0439
      \u0440\u0443\u0431\u0430\u0445\u0435, \u0441 \u0437\u0430\u043F\u043B\u0430\u043A\u0430\u043D\u043D\u044B\u043C
      \u043B\u0438\u0446\u043E\u043C. \u041E\u043D \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0441\u044F,
      \u043E\u0442\u0441\u0442\u0430\u0432 \u043E\u0442 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0435\u0439. \u041D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0448\u0435\u043C \u044F\u0437\u044B\u043A\u0435,
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0440\u0443\u043A\u043E\u0439 \u043A\u0443\u0434\u0430-\u0442\u043E \u043D\u0430
      \u0432\u043E\u0441\u0442\u043E\u043A \u0438 \u0432\u0441\u0445\u043B\u0438\u043F\u044B\u0432\u0430\u0435\u0442.
      \u0414\u043E \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0439 \u0434\u0435\u0440\u0435\u0432\u043D\u0438
      \u043F\u043E\u043B\u0434\u043D\u044F \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730074
    m_Localized: "\u041E\u0442\u0432\u0435\u0437\u0442\u0438 \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730075
    m_Localized: "\u0412\u044B \u043F\u043E\u0441\u0430\u0434\u0438\u043B\u0438 \u043C\u0430\u043B\u044C\u0447\u0438\u043A\u0430
      \u043D\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0443 \u0438 \u0441\u0432\u0435\u0440\u043D\u0443\u043B\u0438
      \u043A \u0434\u0435\u0440\u0435\u0432\u043D\u0435. \u041C\u0430\u0442\u044C
      \u0432\u044B\u0431\u0435\u0436\u0430\u043B\u0430 \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443
      \u0441 \u043A\u0440\u0438\u043A\u043E\u043C. \u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430
      \u0434\u0435\u0440\u0435\u0432\u043D\u0438 \u0442\u0440\u044F\u0441 \u0432\u0430\u0448\u0443
      \u0440\u0443\u043A\u0443 \u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B
      \u043D\u043E\u0447\u043B\u0435\u0433. \u0421\u043B\u0443\u0445\u0438 \u043E
      \u0434\u043E\u0431\u0440\u043E\u043C \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0435
      \u0434\u043E\u0439\u0434\u0443\u0442 \u0434\u043E \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0445
      \u0441\u0435\u043B\u0435\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730076
    m_Localized: "\u041D\u0430\u043A\u043E\u0440\u043C\u0438\u0442\u044C \u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0443 \u0434\u043E\u0440\u043E\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730077
    m_Localized: "\u0412\u044B \u0434\u0430\u043B\u0438 \u0435\u043C\u0443 \u043B\u0435\u043F\u0451\u0448\u043A\u0443
      \u0438 \u0432\u043E\u0434\u044B. \u041C\u0430\u043B\u044C\u0447\u0438\u043A
      \u0435\u043B \u0436\u0430\u0434\u043D\u043E. \u041A\u043E\u0433\u0434\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F,
      \u043E\u043D \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u0432\u0441\u043B\u0435\u0434
      \u043C\u043E\u043B\u0447\u0430, \u0443\u0436\u0435 \u043F\u0440\u0438\u0432\u044B\u043A\u0448\u0438\u0439.
      \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u0430\u0448\u0438\u0445
      \u043B\u044E\u0434\u0435\u0439 \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u0438 \u043E\u0442\u0432\u0435\u043B\u0438 \u0433\u043B\u0430\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730078
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442
      \u0440\u0435\u0431\u0451\u043D\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730079
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u043C\u0430\u043B\u044C\u0447\u0438\u043A\u0430: \u043E\u0431\u0435\u0437\u0432\u043E\u0436\u0435\u043D,
      \u043D\u0430 \u043D\u043E\u0433\u0435 \u043D\u0430\u0433\u043D\u043E\u0438\u0432\u0448\u0430\u044F\u0441\u044F
      \u0440\u0430\u043D\u0430. \u041F\u0440\u043E\u043C\u044B\u043B, \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043B,
      \u043D\u0430\u043F\u043E\u0438\u043B \u043E\u0442\u0432\u0430\u0440\u043E\u043C.
      \u0412 \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u043C\u0430\u0442\u044C
      \u0440\u044B\u0434\u0430\u043B\u0430 \u043E\u0442 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u0438.
      \u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430 \u0441\u043A\u0430\u0437\u0430\u043B:
      \xAB\u0412\u0430\u0448 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043E\u0434
      \u043D\u0430\u0448\u0435\u0439 \u0437\u0430\u0449\u0438\u0442\u043E\u0439.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730080
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438 \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u043B\u0438\u0441\u044C,
      \u043D\u043E \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0438\u043B\u0438\u0441\u044C
      \u0434\u043E\u0431\u0440\u044B\u043C\u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438.
      \u0411\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0438,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0443 \u0432\u0430\u0441 \u043D\u0435\u0442.
      \u041D\u043E \u0434\u0430\u0436\u0435 \u0434\u043E\u0431\u0440\u044B\u0435
      \u0441\u043B\u043E\u0432\u0430 \u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C
      \u0442\u0438\u0448\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730081
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0440\u0430\u0441\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u043E \u0434\u043E\u0440\u043E\u0433\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730082
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0434\u043E\u043B\u0433\u043E
      \u0431\u0435\u0441\u0435\u0434\u043E\u0432\u0430\u043B \u0441 \u043C\u043E\u043D\u0430\u0445\u043E\u043C
      \u043D\u0430 \u0441\u043C\u0435\u0441\u0438 \u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442\u0430
      \u0438 \u0444\u0430\u0440\u0441\u0438. \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0438, \u043A\u0430\u043A\u0438\u0435
      \u0434\u043E\u0440\u043E\u0433\u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B,
      \u0433\u0434\u0435 \u0441\u0442\u043E\u044F\u0442 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438,
      \u0433\u0434\u0435 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438
      \u0432\u043E\u0434\u0443. \u0411\u0435\u0441\u0446\u0435\u043D\u043D\u044B\u0435
      \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0434\u043B\u044F \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730083
    m_Localized: "\u041B\u0430\u0433\u0435\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730084
    m_Localized: "\u0411\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730085
    m_Localized: "\u042F\u0437\u044B\u043A\u043E\u0432\u0430\u044F \u0432\u0441\u0442\u0440\u0435\u0447\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730086
    m_Localized: "\u0417\u0430\u0433\u0430\u0434\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730087
    m_Localized: "\u041C\u0438\u0441\u0442\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730088
    m_Localized: "\u041F\u0440\u0438\u0440\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730089
    m_Localized: "\u041D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10424707554730090
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774425563136
    m_Localized: "\u041A\u0430\u0442\u0435\u0433\u043E\u0440\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774475894784
    m_Localized: 
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672000
    m_Localized: "\u041C\u043E\u043D\u0435\u0442\u044B \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672001
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442 \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u043A\u043E\u0448\u0435\u043B\u0451\u043A \u0443 \u043E\u0431\u043E\u0447\u0438\u043D\u044B.
      \u0412\u043D\u0443\u0442\u0440\u0438 - \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043C\u0435\u0434\u043D\u044B\u0445 \u043C\u043E\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672002
    m_Localized: "\u041F\u043E\u0440\u0432\u0430\u043D\u043D\u044B\u0439 \u0440\u0435\u043C\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672003
    m_Localized: "\u0423\u043F\u0440\u044F\u0436\u043D\u043E\u0439 \u0440\u0435\u043C\u0435\u043D\u044C
      \u043B\u043E\u043F\u043D\u0443\u043B \u043D\u0430 \u0445\u043E\u0434\u0443.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u043F\u043E\u043A\u0430 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0432\u044F\u0436\u0443\u0442 \u0437\u0430\u043C\u0435\u043D\u0443 \u0438\u0437
      \u0432\u0435\u0440\u0451\u0432\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672004
    m_Localized: "\u041F\u043E\u043F\u0443\u0442\u043D\u044B\u0439 \u0432\u0435\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672005
    m_Localized: "\u0421\u0438\u043B\u044C\u043D\u044B\u0439 \u043F\u043E\u043F\u0443\u0442\u043D\u044B\u0439
      \u0432\u0435\u0442\u0435\u0440 \u043F\u043E\u0434\u0433\u043E\u043D\u044F\u0435\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u0438\u0434\u0443\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672006
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u043D\u044B\u0439 \u0432\u0435\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672007
    m_Localized: "\u041F\u043E\u0440\u044B\u0432\u0438\u0441\u0442\u044B\u0439 \u0432\u0441\u0442\u0440\u0435\u0447\u043D\u044B\u0439
      \u0432\u0435\u0442\u0435\u0440 \u0431\u044C\u0451\u0442 \u0432 \u043B\u0438\u0446\u043E,
      \u0437\u0430\u0431\u0438\u0432\u0430\u0435\u0442 \u0433\u043B\u0430\u0437\u0430
      \u043F\u044B\u043B\u044C\u044E. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0449\u0443\u0440\u044F\u0442\u0441\u044F \u0438 \u0440\u0443\u0433\u0430\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672008
    m_Localized: "\u041A\u0440\u0435\u043F\u043A\u0438\u0439 \u0441\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672009
    m_Localized: "\u0422\u0438\u0445\u0430\u044F \u043D\u043E\u0447\u044C, \u0442\u0451\u043F\u043B\u044B\u0439
      \u0432\u043E\u0437\u0434\u0443\u0445 \u0438 \u043C\u044F\u0433\u043A\u0430\u044F
      \u0437\u0435\u043C\u043B\u044F - \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u043E\u0442\u043B\u0438\u0447\u043D\u043E \u0432\u044B\u0441\u043F\u0430\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672010
    m_Localized: "\u041A\u043E\u043C\u0430\u0440\u044B \u0432 \u043B\u0430\u0433\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672011
    m_Localized: "\u0422\u0443\u0447\u0438 \u043A\u043E\u043C\u0430\u0440\u043E\u0432
      \u043D\u0435 \u0434\u0430\u043B\u0438 \u0443\u0441\u043D\u0443\u0442\u044C
      \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430. \u041B\u044E\u0434\u0438
      \u0437\u043B\u044B\u0435 \u0438 \u043D\u0435 \u0432\u044B\u0441\u043F\u0430\u0432\u0448\u0438\u0435\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672012
    m_Localized: "\u0412\u043E\u0439 \u0432\u043E\u043B\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672013
    m_Localized: "\u041F\u0440\u043E\u0442\u044F\u0436\u043D\u044B\u0439 \u0432\u043E\u043B\u0447\u0438\u0439
      \u0432\u043E\u0439 \u0440\u0430\u0437\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u0432 \u043D\u043E\u0447\u0438. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u0442\u0440\u0435\u0432\u043E\u0436\u043D\u043E \u043F\u0440\u044F\u0434\u0443\u0442
      \u0443\u0448\u0430\u043C\u0438, \u043D\u043E \u0441\u0442\u0430\u044F \u0434\u0430\u043B\u0435\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672014
    m_Localized: "\u041F\u0430\u0434\u0430\u044E\u0449\u0430\u044F \u0437\u0432\u0435\u0437\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672015
    m_Localized: "\u042F\u0440\u043A\u0430\u044F \u0437\u0432\u0435\u0437\u0434\u0430
      \u043F\u0440\u043E\u0447\u0435\u0440\u0447\u0438\u0432\u0430\u0435\u0442 \u043D\u0435\u0431\u043E
      \u0438 \u0433\u0430\u0441\u043D\u0435\u0442 \u0437\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u043E\u043C.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0448\u0435\u043F\u0447\u0443\u0442
      \u043C\u043E\u043B\u0438\u0442\u0432\u044B - \u0434\u043E\u0431\u0440\u044B\u0439
      \u0437\u043D\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672016
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672017
    m_Localized: "\u0423 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438 \u0441\u0442\u043E\u0438\u0442
      \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u0439 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439
      \u0441\u0442\u043E\u043B\u0431 \u0441 \u0430\u0440\u0430\u0431\u0441\u043A\u043E\u0439
      \u0432\u044F\u0437\u044C\u044E. \u041D\u0430\u0434\u043F\u0438\u0441\u044C
      \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442 -
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043D\u0430 \u0432\u0435\u0440\u043D\u043E\u043C
      \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672018
    m_Localized: "\u0420\u0430\u0441\u0441\u044B\u043F\u0430\u043D\u043D\u043E\u0435
      \u0437\u0435\u0440\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672019
    m_Localized: "\u041C\u0435\u0448\u043E\u043A \u0441 \u0437\u0435\u0440\u043D\u043E\u043C
      \u0440\u0430\u0437\u0432\u044F\u0437\u0430\u043B\u0441\u044F \u043D\u0430 \u0445\u043E\u0434\u0443.
      \u0427\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u0432\u044B\u0441\u044B\u043F\u0430\u043B\u0430\u0441\u044C \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672020
    m_Localized: "\u0414\u0438\u043A\u0438\u0435 \u0442\u0440\u0430\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672021
    m_Localized: "\u0423 \u0434\u043E\u0440\u043E\u0433\u0438 \u0440\u0430\u0441\u0442\u0443\u0442
      \u043F\u0443\u0447\u043A\u0438 \u0434\u0438\u043A\u043E\u0433\u043E \u0442\u0438\u043C\u044C\u044F\u043D\u0430.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0442
      \u0438\u0445 - \u043F\u0440\u0438\u0433\u043E\u0434\u044F\u0442\u0441\u044F
      \u0434\u043B\u044F \u043F\u043E\u0445\u043B\u0451\u0431\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672022
    m_Localized: "\u0420\u0430\u0437\u0431\u043E\u043B\u0442\u0430\u043D\u043D\u043E\u0435
      \u043A\u043E\u043B\u0435\u0441\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672023
    m_Localized: "\u041A\u043E\u043B\u0435\u0441\u043E \u0442\u0435\u043B\u0435\u0433\u0438
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0432\u0438\u0445\u043B\u044F\u0442\u044C.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442
      \u044D\u0442\u043E \u0432\u043E\u0432\u0440\u0435\u043C\u044F \u0438 \u043F\u043E\u0434\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672024
    m_Localized: "\u0423\u043F\u0440\u044F\u043C\u044B\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672025
    m_Localized: "\u0413\u043E\u043B\u043E\u0432\u043D\u043E\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u043B\u043E\u0436\u0438\u0442\u0441\u044F \u043F\u043E\u0441\u0440\u0435\u0434\u0438
      \u0434\u043E\u0440\u043E\u0433\u0438 \u0438 \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432\u0441\u0442\u0430\u0432\u0430\u0442\u044C. \u041F\u043E\u043B\u0447\u0430\u0441\u0430
      \u0443\u0433\u043E\u0432\u043E\u0440\u043E\u0432, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u043E\u043D \u0441\u043E\u0438\u0437\u0432\u043E\u043B\u0438\u043B
      \u043F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672026
    m_Localized: "\u0423\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u0442\u0443\u043C\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672027
    m_Localized: "\u0413\u0443\u0441\u0442\u043E\u0439 \u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439
      \u0442\u0443\u043C\u0430\u043D \u043E\u043A\u0443\u0442\u044B\u0432\u0430\u0435\u0442
      \u0442\u0440\u043E\u043F\u0443. \u0421\u0438\u043B\u0443\u044D\u0442\u044B
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044F\u044E\u0442\u0441\u044F
      \u0432 \u043C\u043E\u043B\u043E\u0447\u043D\u043E\u0439 \u0434\u044B\u043C\u043A\u0435
      - \u043A\u0440\u0430\u0441\u0438\u0432\u043E \u0438 \u0442\u0440\u0435\u0432\u043E\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672028
    m_Localized: "\u0414\u0440\u0435\u0432\u043D\u0438\u0435 \u043A\u043E\u043B\u0435\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672029
    m_Localized: "\u0413\u043B\u0443\u0431\u043E\u043A\u0438\u0435 \u043A\u043E\u043B\u0435\u0438,
      \u043F\u0440\u043E\u0431\u0438\u0442\u044B\u0435 \u0442\u044B\u0441\u044F\u0447\u0430\u043C\u0438
      \u043F\u043E\u0432\u043E\u0437\u043E\u043A \u0437\u0430 \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u044F.
      \u042D\u0442\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u043E\u0439 \u0445\u043E\u0434\u0438\u043B\u0438
      \u0435\u0449\u0451 \u043F\u0440\u0438 \u0422\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672030
    m_Localized: "\u0413\u043E\u0440\u044F\u0447\u0438\u0439 \u0432\u0435\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672031
    m_Localized: "\u0420\u0430\u0441\u043A\u0430\u043B\u0451\u043D\u043D\u044B\u0439
      \u0432\u0435\u0442\u0435\u0440 \u0434\u0443\u0435\u0442 \u0438\u0437 \u043F\u0443\u0441\u0442\u044B\u043D\u0438,
      \u043E\u0431\u0436\u0438\u0433\u0430\u044F \u043A\u043E\u0436\u0443. \u0412\u043E\u0434\u0430
      \u0432 \u0431\u0443\u0440\u0434\u044E\u043A\u0430\u0445 \u0442\u0435\u043F\u043B\u0435\u0435\u0442
      \u043D\u0430 \u0433\u043B\u0430\u0437\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672032
    m_Localized: "\u041C\u0430\u0440\u0435\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672033
    m_Localized: "\u041D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435
      \u0434\u0440\u043E\u0436\u0438\u0442 \u043C\u0430\u0440\u0435\u0432\u043E -
      \u043C\u0438\u0440\u0430\u0436\u0438 \u0440\u0438\u0441\u0443\u044E\u0442 \u043E\u0437\u0435\u0440\u043E
      \u0441 \u043F\u0430\u043B\u044C\u043C\u0430\u043C\u0438. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0437\u043D\u0430\u044E\u0442: \u044D\u0442\u043E \u043B\u043E\u0436\u044C
      \u043F\u0435\u0441\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672034
    m_Localized: "\u041F\u0435\u0441\u043E\u043A \u0432 \u0433\u0440\u0443\u0437\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672035
    m_Localized: "\u041C\u0435\u043B\u043A\u0438\u0439 \u043F\u0435\u0441\u043E\u043A
      \u043F\u0440\u043E\u043D\u0438\u043A \u0432 \u0442\u044E\u043A\u0438 \u0447\u0435\u0440\u0435\u0437
      \u0449\u0435\u043B\u0438. \u0422\u043A\u0430\u043D\u0438 \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u043F\u0435\u0440\u0435\u0442\u0440\u044F\u0445\u0438\u0432\u0430\u0442\u044C
      \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u0441\u0442\u043E\u044F\u043D\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672036
    m_Localized: "\u041F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u044B\u0439 \u0440\u0430\u0441\u0441\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672037
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u044B\u0448\u0435\u043B
      \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430 \u0438 \u043F\u0440\u043E\u0448\u0451\u043B
      \u0434\u043E\u043B\u0433\u0438\u0439 \u043F\u0435\u0440\u0435\u0433\u043E\u043D
      \u0432 \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u0435. \u041B\u044E\u0434\u0438
      \u0431\u043E\u0434\u0440\u044B \u0438 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672038
    m_Localized: "\u042F\u0449\u0435\u0440\u0438\u0446\u044B \u043D\u0430 \u043A\u0430\u043C\u043D\u044F\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672039
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u043A\u0438 \u044F\u0449\u0435\u0440\u0438\u0446
      \u0433\u0440\u0435\u044E\u0442\u0441\u044F \u043D\u0430 \u043F\u0440\u0438\u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0445
      \u043A\u0430\u043C\u043D\u044F\u0445 \u0438 \u0441\u0442\u0440\u0435\u043C\u0433\u043B\u0430\u0432
      \u0440\u0430\u0437\u0431\u0435\u0433\u0430\u044E\u0442\u0441\u044F \u043F\u0440\u0438
      \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672040
    m_Localized: "\u041F\u0435\u0440\u0435\u0441\u043E\u0445\u0448\u0438\u0439 \u043A\u043E\u043B\u043E\u0434\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672041
    m_Localized: "\u041A\u043E\u043B\u043E\u0434\u0435\u0446 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0441\u0443\u0445\u0438\u043C
      - \u043D\u0430 \u0434\u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u0432\u0448\u0430\u044F\u0441\u044F
      \u0433\u043B\u0438\u043D\u0430. \u041F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C \u0432\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672042
    m_Localized: "\u0421\u043B\u0435\u0434\u044B \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672043
    m_Localized: "\u0421\u0432\u0435\u0436\u0438\u0435 \u0441\u043B\u0435\u0434\u044B
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432 \u043D\u0430 \u043F\u0435\u0441\u043A\u0435
      - \u0434\u0440\u0443\u0433\u043E\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u0440\u043E\u0448\u0451\u043B \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u0434\u0430\u0432\u043D\u043E.
      \u0417\u043D\u0430\u0447\u0438\u0442, \u043F\u0443\u0442\u044C \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672044
    m_Localized: "\u041D\u043E\u0447\u043D\u043E\u0439 \u0445\u043E\u043B\u043E\u0434
      \u043F\u0443\u0441\u0442\u044B\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672045
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0434\u043D\u0435\u0432\u043D\u043E\u0439
      \u0436\u0430\u0440\u044B \u043D\u043E\u0447\u044C \u043E\u0431\u0440\u0443\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043B\u0435\u0434\u044F\u043D\u044B\u043C \u0445\u043E\u043B\u043E\u0434\u043E\u043C.
      \u041B\u044E\u0434\u0438 \u0436\u043C\u0443\u0442\u0441\u044F \u043A \u043A\u043E\u0441\u0442\u0440\u0443
      \u0438 \u043D\u0435 \u043C\u043E\u0433\u0443\u0442 \u0441\u043E\u0433\u0440\u0435\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672046
    m_Localized: "\u041F\u0435\u0441\u043D\u044F \u0436\u0430\u0432\u043E\u0440\u043E\u043D\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672047
    m_Localized: "\u0412\u044B\u0441\u043E\u043A\u043E \u0432 \u043D\u0435\u0431\u0435
      \u0437\u0430\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0436\u0430\u0432\u043E\u0440\u043E\u043D\u043E\u043A.
      \u0415\u0433\u043E \u0442\u0440\u0435\u043B\u044C \u0440\u0430\u0437\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u043D\u0430\u0434 \u0441\u0442\u0435\u043F\u044C\u044E - \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0443\u043B\u044B\u0431\u0430\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672048
    m_Localized: "\u0412\u044B\u0441\u043E\u043A\u0430\u044F \u0442\u0440\u0430\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672049
    m_Localized: "\u0422\u0440\u0430\u0432\u0430 \u0432\u044B\u043C\u0430\u0445\u0430\u043B\u0430
      \u0432\u044B\u0448\u0435 \u043F\u043E\u044F\u0441\u0430 \u0438 \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0442\u0440\u043E\u043F\u0443. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043F\u0440\u043E\u0434\u0438\u0440\u0430\u044E\u0442\u0441\u044F \u0441\u043A\u0432\u043E\u0437\u044C
      \u0437\u0430\u0440\u043E\u0441\u043B\u0438, \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u044F
      \u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672050
    m_Localized: "\u041F\u0440\u0438\u0432\u0430\u043B \u0434\u043B\u044F \u0432\u044B\u043F\u0430\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672051
    m_Localized: "\u0421\u043E\u0447\u043D\u044B\u0435 \u043B\u0443\u0433\u0430 -
      \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044C \u0432 \u043F\u0443\u0442\u0438.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0435\u043B\u0430\u0435\u0442
      \u043F\u0440\u0438\u0432\u0430\u043B, \u0447\u0442\u043E\u0431\u044B \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043D\u0430\u0435\u043B\u0438\u0441\u044C \u0432\u0434\u043E\u0432\u043E\u043B\u044C
      \u0441\u0432\u0435\u0436\u0435\u0439 \u0442\u0440\u0430\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672052
    m_Localized: "\u0412\u0441\u0430\u0434\u043D\u0438\u043A\u0438 \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672053
    m_Localized: "\u041D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435
      \u043C\u0435\u043B\u044C\u043A\u0430\u044E\u0442 \u0441\u0438\u043B\u0443\u044D\u0442\u044B
      \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u043E\u0432. \u041E\u043D\u0438
      \u0441\u043A\u0430\u0447\u0443\u0442 \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u044B\u043C
      \u043A\u0443\u0440\u0441\u043E\u043C, \u043D\u043E \u043D\u0435 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672054
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u0442\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672055
    m_Localized: "\u0420\u0430\u0437\u043C\u044B\u0442\u0430\u044F \u0434\u043E\u0436\u0434\u044F\u043C\u0438
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0432 \u0440\u044B\u0442\u0432\u0438\u043D\u0430\u0445
      \u0438 \u043B\u0443\u0436\u0430\u0445. \u0422\u0435\u043B\u0435\u0433\u0430
      \u043F\u043E\u0434\u043F\u0440\u044B\u0433\u0438\u0432\u0430\u0435\u0442 \u043D\u0430
      \u043A\u0430\u0436\u0434\u043E\u0439 \u043A\u043E\u0447\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672056
    m_Localized: "\u041F\u0430\u0441\u0442\u0443\u0445 \u0443 \u0441\u0442\u0430\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672057
    m_Localized: "\u041F\u0430\u0441\u0442\u0443\u0445 \u0441 \u043E\u0442\u0430\u0440\u043E\u0439
      \u043E\u0432\u0435\u0446 \u043C\u0430\u0448\u0435\u0442 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443
      \u0438 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043D\u0430
      \u0440\u043E\u0434\u043D\u0438\u043A \u0437\u0430 \u0445\u043E\u043B\u043C\u043E\u043C.
      \u0414\u043E\u0431\u0440\u044B\u0439 \u0441\u043E\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672058
    m_Localized: "\u042F\u0441\u0442\u0440\u0435\u0431 \u0432 \u043D\u0435\u0431\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672059
    m_Localized: "\u042F\u0441\u0442\u0440\u0435\u0431 \u043A\u0440\u0443\u0436\u0438\u0442
      \u043D\u0430\u0434 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u043C,
      \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u044F \u0448\u0438\u0440\u043E\u043A\u0438\u0435
      \u0434\u0443\u0433\u0438. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0441\u043F\u043E\u0440\u044F\u0442 - \u043A \u0443\u0434\u0430\u0447\u0435
      \u044D\u0442\u043E \u0438\u043B\u0438 \u043A \u0431\u0435\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672060
    m_Localized: "\u041A\u0430\u043C\u043D\u0435\u043F\u0430\u0434 \u0432\u0434\u0430\u043B\u0435\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672061
    m_Localized: "\u0421 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0433\u043E \u0441\u043A\u043B\u043E\u043D\u0430
      \u0441 \u0433\u0440\u043E\u0445\u043E\u0442\u043E\u043C \u0441\u0445\u043E\u0434\u044F\u0442
      \u043A\u0430\u043C\u043D\u0438. \u041E\u0431\u043B\u0430\u043A\u043E \u043F\u044B\u043B\u0438
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u043D\u0430\u0434
      \u0443\u0449\u0435\u043B\u044C\u0435\u043C - \u043F\u043E\u0432\u0435\u0437\u043B\u043E,
      \u0447\u0442\u043E \u043D\u0435 \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672062
    m_Localized: "\u0423\u0437\u043A\u0438\u0439 \u043A\u0430\u0440\u043D\u0438\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672063
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u0441\u0443\u0436\u0430\u0435\u0442\u0441\u044F
      \u0434\u043E \u0443\u0437\u043A\u043E\u0433\u043E \u043A\u0430\u0440\u043D\u0438\u0437\u0430
      \u043D\u0430\u0434 \u043E\u0431\u0440\u044B\u0432\u043E\u043C. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043F\u0440\u0438\u0436\u0438\u043C\u0430\u044E\u0442\u0441\u044F \u043A \u0441\u043A\u0430\u043B\u0435
      \u0438 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E \u0441\u0442\u0443\u043F\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672064
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u0440\u043E\u0434\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672065
    m_Localized: "\u0418\u0437 \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u044B
      \u0431\u044C\u0451\u0442 \u043B\u0435\u0434\u044F\u043D\u043E\u0439 \u0440\u043E\u0434\u043D\u0438\u043A.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043E\u043F\u043E\u043B\u043D\u044F\u0435\u0442
      \u0437\u0430\u043F\u0430\u0441\u044B \u0447\u0438\u0441\u0442\u0435\u0439\u0448\u0435\u0439
      \u0433\u043E\u0440\u043D\u043E\u0439 \u0432\u043E\u0434\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672066
    m_Localized: "\u042D\u0445\u043E \u0432 \u043A\u0430\u043D\u044C\u043E\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672067
    m_Localized: "\u0417\u0432\u043E\u043D \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u0447\u0438\u043A\u043E\u0432
      \u043D\u0430 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430\u0445 \u043C\u043D\u043E\u0433\u043E\u043A\u0440\u0430\u0442\u043D\u043E
      \u043E\u0442\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F \u043E\u0442 \u0441\u0442\u0435\u043D
      \u043A\u0430\u043D\u044C\u043E\u043D\u0430. \u041A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u0431\u0443\u0434\u0442\u043E \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443
      \u0438\u0434\u0451\u0442 \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u044B\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672068
    m_Localized: "\u041A\u043E\u0437\u044C\u044F \u0442\u0440\u043E\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672069
    m_Localized: "\u0421\u0442\u0430\u0434\u043E \u0433\u043E\u0440\u043D\u044B\u0445
      \u043A\u043E\u0437\u043B\u043E\u0432 \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u0435\u0442
      \u0442\u0440\u043E\u043F\u0443 \u0438 \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u0440\u0435\u0434\u0438 \u043A\u0430\u043C\u043D\u0435\u0439. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u044E\u0442 \u0438\u0445 \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C
      - \u043B\u043E\u0432\u043A\u0438\u0435 \u0442\u0432\u0430\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774492672070
    m_Localized: "\u041E\u0431\u0440\u0443\u0448\u0435\u043D\u043D\u044B\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866304
    m_Localized: "\u0427\u0430\u0441\u0442\u044C \u0442\u0440\u043E\u043F\u044B \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0430\u0441\u044C
      \u043F\u043E\u0441\u043B\u0435 \u043E\u043F\u043E\u043B\u0437\u043D\u044F.
      \u041F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0440\u0430\u0437\u0433\u0440\u0443\u0436\u0430\u0442\u044C
      \u0442\u0435\u043B\u0435\u0433\u0443 \u0438 \u043F\u0435\u0440\u0435\u043D\u043E\u0441\u0438\u0442\u044C
      \u0442\u044E\u043A\u0438 \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866305
    m_Localized: "\u0420\u0430\u0437\u0440\u0435\u0436\u0451\u043D\u043D\u044B\u0439
      \u0432\u043E\u0437\u0434\u0443\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866306
    m_Localized: "\u041D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435 \u0434\u044B\u0448\u0430\u0442\u044C
      \u0442\u044F\u0436\u0435\u043B\u043E. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0437\u0430\u0434\u044B\u0445\u0430\u044E\u0442\u0441\u044F \u043E\u0442 \u043B\u044E\u0431\u043E\u0433\u043E
      \u0443\u0441\u0438\u043B\u0438\u044F, \u0433\u043E\u043B\u043E\u0432\u044B
      \u0440\u0430\u0441\u043A\u0430\u043B\u044B\u0432\u0430\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866307
    m_Localized: "\u041C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u0444\u043B\u0430\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866308
    m_Localized: "\u041D\u0430 \u0433\u043E\u0440\u043D\u043E\u043C \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435
      \u0442\u0440\u0435\u043F\u0435\u0449\u0443\u0442 \u0446\u0432\u0435\u0442\u043D\u044B\u0435
      \u043C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u0444\u043B\u0430\u0433\u0438.
      \u0412\u0435\u0442\u0435\u0440 \u0443\u043D\u043E\u0441\u0438\u0442 \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0435
      \u043D\u0430 \u043D\u0438\u0445 \u043C\u0430\u043D\u0442\u0440\u044B \u043A
      \u043D\u0435\u0431\u0435\u0441\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866309
    m_Localized: "\u042F\u0447\u0438\u0439 \u0447\u0430\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866310
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u043D\u044B\u0439 \u043F\u0430\u0441\u0442\u0443\u0445-\u0442\u0438\u0431\u0435\u0442\u0435\u0446
      \u0443\u0433\u043E\u0449\u0430\u0435\u0442 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u043E\u0432
      \u0433\u043E\u0440\u044F\u0447\u0438\u043C \u0447\u0430\u0435\u043C \u0441
      \u044F\u0447\u044C\u0438\u043C \u043C\u0430\u0441\u043B\u043E\u043C. \u0421\u043E\u043B\u0451\u043D\u044B\u0439,
      \u0436\u0438\u0440\u043D\u044B\u0439, \u0441\u043E\u0433\u0440\u0435\u0432\u0430\u044E\u0449\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866311
    m_Localized: "\u041C\u043E\u0440\u043E\u0437\u043D\u043E\u0435 \u0443\u0442\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866312
    m_Localized: "\u0423\u0442\u0440\u043E\u043C \u0442\u044E\u043A\u0438 \u043F\u043E\u043A\u0440\u044B\u0442\u044B
      \u0438\u043D\u0435\u0435\u043C, \u0430 \u0432\u043E\u0434\u0430 \u0432 \u0431\u0443\u0440\u0434\u044E\u043A\u0430\u0445
      \u0441\u0445\u0432\u0430\u0442\u0438\u043B\u0430\u0441\u044C \u0442\u043E\u043D\u043A\u043E\u0439
      \u043A\u043E\u0440\u043A\u043E\u0439 \u043B\u044C\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866313
    m_Localized: "\u041A\u0430\u043C\u0435\u043D\u043D\u0430\u044F \u043F\u0438\u0440\u0430\u043C\u0438\u0434\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866314
    m_Localized: "\u0423 \u0442\u0440\u043E\u043F\u044B \u0441\u043B\u043E\u0436\u0435\u043D\u0430
      \u043F\u0438\u0440\u0430\u043C\u0438\u0434\u043A\u0430 \u0438\u0437 \u043A\u0430\u043C\u043D\u0435\u0439
      - \u043E\u0431\u043E. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044E\u0442 \u043F\u043E \u043A\u0430\u043C\u043D\u044E
      \u0438 \u043E\u0431\u0445\u043E\u0434\u044F\u0442 \u0435\u0451 \u043F\u043E
      \u0441\u043E\u043B\u043D\u0446\u0443 \u043D\u0430 \u0443\u0434\u0430\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866315
    m_Localized: "\u0422\u0435\u043D\u044C \u043F\u043E\u0434 \u043A\u0440\u043E\u043D\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866316
    m_Localized: "\u0413\u0443\u0441\u0442\u044B\u0435 \u043A\u0440\u043E\u043D\u044B
      \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432 \u0434\u0430\u044E\u0442 \u0431\u043B\u0430\u0436\u0435\u043D\u043D\u0443\u044E
      \u0442\u0435\u043D\u044C \u043F\u043E\u0441\u043B\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0438. \u041F\u0440\u043E\u0445\u043B\u0430\u0434\u0430
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0434\u0443\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866317
    m_Localized: "\u0423\u043F\u0430\u0432\u0448\u0435\u0435 \u0434\u0435\u0440\u0435\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866318
    m_Localized: "\u041F\u043E\u0432\u0430\u043B\u0435\u043D\u043D\u043E\u0435 \u0434\u0435\u0440\u0435\u0432\u043E
      \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u0430\u0436\u0438\u0432\u0430\u0435\u0442
      \u0442\u0440\u043E\u043F\u0443. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0440\u0443\u0431\u044F\u0442 \u0441\u0442\u0432\u043E\u043B \u0438 \u0440\u0430\u0441\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u044E\u0442
      \u0435\u0433\u043E \u043F\u043E \u0447\u0430\u0441\u0442\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866319
    m_Localized: "\u041B\u0435\u0441\u043D\u044B\u0435 \u044F\u0433\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866320
    m_Localized: "\u041A\u0443\u0441\u0442\u044B \u0432\u0434\u043E\u043B\u044C \u0442\u0440\u043E\u043F\u044B
      \u0443\u0441\u044B\u043F\u0430\u043D\u044B \u0441\u043F\u0435\u043B\u044B\u043C\u0438
      \u044F\u0433\u043E\u0434\u0430\u043C\u0438. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043D\u0430\u0431\u0438\u0440\u0430\u044E\u0442 \u043F\u043E\u043B\u043D\u044B\u0435
      \u0433\u043E\u0440\u0441\u0442\u0438 - \u0441\u043B\u0430\u0434\u043A\u0438\u0435,
      \u0441\u043E\u0447\u043D\u044B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866321
    m_Localized: "\u0411\u043E\u043B\u043E\u0442\u0438\u0441\u0442\u044B\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866322
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0447\u0435\u0440\u0435\u0437 \u0431\u043E\u043B\u043E\u0442\u0438\u0441\u0442\u0443\u044E
      \u043D\u0438\u0437\u0438\u043D\u0443. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u0432\u044F\u0437\u043D\u0443\u0442 \u043F\u043E \u0449\u0438\u043A\u043E\u043B\u043E\u0442\u043A\u0443,
      \u0430 \u043D\u0430 \u043D\u043E\u0433\u0430\u0445 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      - \u043F\u0438\u044F\u0432\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866323
    m_Localized: "\u041E\u0436\u0438\u0434\u0430\u043D\u0438\u0435 \u043F\u0430\u0440\u043E\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866324
    m_Localized: "\u041F\u0430\u0440\u043E\u043C\u0449\u0438\u043A \u043D\u0430 \u0442\u043E\u043C
      \u0431\u0435\u0440\u0435\u0433\u0443. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0436\u0434\u0451\u0442 \u0443 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u044B,
      \u043F\u043E\u043A\u0430 \u043B\u043E\u0434\u043A\u0430 \u043D\u0435\u0441\u043F\u0435\u0448\u043D\u043E
      \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u0435\u0442 \u043C\u0443\u0442\u043D\u0443\u044E
      \u0440\u0435\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866325
    m_Localized: "\u0420\u044B\u0431\u0430 \u0432 \u0440\u0435\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866326
    m_Localized: "\u041B\u0430\u0433\u0435\u0440\u044C \u0441\u0442\u043E\u0438\u0442
      \u0443 \u0440\u0435\u043A\u0438. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043B\u043E\u0432\u044F\u0442 \u0440\u044B\u0431\u0443 \u0433\u043E\u043B\u044B\u043C\u0438
      \u0440\u0443\u043A\u0430\u043C\u0438 \u043D\u0430 \u043C\u0435\u043B\u043A\u043E\u0432\u043E\u0434\u044C\u0435
      - \u0443\u0436\u0438\u043D \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866327
    m_Localized: "\u0422\u043E\u043F\u043A\u0438\u0439 \u0431\u0435\u0440\u0435\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866328
    m_Localized: "\u041A\u043E\u043B\u0451\u0441\u0430 \u0442\u0435\u043B\u0435\u0433\u0438
      \u0443\u0432\u044F\u0437\u0430\u044E\u0442 \u0432 \u0440\u0430\u0441\u043A\u0438\u0441\u0448\u0435\u0439
      \u0433\u043B\u0438\u043D\u0435 \u0443 \u0440\u0435\u043A\u0438. \u041F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u043F\u043E\u0434\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C \u0432\u0435\u0442\u043A\u0438
      \u0438 \u0432\u044B\u0442\u0430\u043B\u043A\u0438\u0432\u0430\u0442\u044C \u0432\u0440\u0443\u0447\u043D\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866329
    m_Localized: "\u0421\u043E\u043B\u0451\u043D\u044B\u0439 \u0431\u0440\u0438\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866330
    m_Localized: "\u0421 \u043C\u043E\u0440\u044F \u0442\u044F\u043D\u0435\u0442
      \u0441\u0432\u0435\u0436\u0438\u043C \u0441\u043E\u043B\u0451\u043D\u044B\u043C
      \u0431\u0440\u0438\u0437\u043E\u043C. \u041F\u043E\u0441\u043B\u0435 \u043F\u044B\u043B\u044C\u043D\u044B\u0445
      \u0434\u043E\u0440\u043E\u0433 \u0441\u043E\u043B\u043E\u043D\u043E\u0432\u0430\u0442\u044B\u0439
      \u0432\u043E\u0437\u0434\u0443\u0445 \u043A\u0430\u0436\u0435\u0442\u0441\u044F
      \u0446\u0435\u043B\u0435\u0431\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866331
    m_Localized: "\u0420\u0430\u043A\u0443\u0448\u043A\u0438 \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866332
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u044E\u0442
      \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u0435 \u0440\u0430\u043A\u043E\u0432\u0438\u043D\u044B
      \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443. \u041E\u0434\u0438\u043D
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442 \u043A\u0440\u0443\u043F\u043D\u0443\u044E
      \u043F\u0435\u0440\u043B\u0430\u043C\u0443\u0442\u0440\u043E\u0432\u0443\u044E
      - \u043C\u043E\u0436\u0435\u0442, \u0443\u0434\u0430\u0441\u0442\u0441\u044F
      \u043F\u0440\u043E\u0434\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866333
    m_Localized: "\u0420\u0436\u0430\u0432\u0447\u0438\u043D\u0430 \u043E\u0442 \u0441\u043E\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866334
    m_Localized: "\u041C\u043E\u0440\u0441\u043A\u043E\u0439 \u0432\u043E\u0437\u0434\u0443\u0445
      \u0440\u0430\u0437\u044A\u0435\u0434\u0430\u0435\u0442 \u043C\u0435\u0442\u0430\u043B\u043B\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F \u0442\u0435\u043B\u0435\u0433\u0438.
      \u041D\u0430 \u043F\u0435\u0442\u043B\u044F\u0445 \u0438 \u0441\u043A\u043E\u0431\u0430\u0445
      \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0440\u044B\u0436\u0430\u044F
      \u0440\u0436\u0430\u0432\u0447\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866335
    m_Localized: "\u041E\u0445\u043E\u0442\u0430 \u0432 \u0441\u0442\u0435\u043F\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866336
    m_Localized: "\u0417\u0430 \u043B\u0430\u0433\u0435\u0440\u0435\u043C, \u0432
      \u0432\u044B\u0441\u043E\u043A\u043E\u0439 \u0442\u0440\u0430\u0432\u0435,
      \u043C\u0435\u043B\u044C\u043A\u0430\u044E\u0442 \u0442\u0435\u043D\u0438 -
      \u043A\u0443\u0440\u043E\u043F\u0430\u0442\u043A\u0438, \u0430 \u043C\u043E\u0436\u0435\u0442,
      \u0437\u0430\u0439\u0446\u044B. \u0412\u0435\u0442\u0435\u0440 \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442
      \u0437\u0430\u043F\u0430\u0445 \u043F\u043E\u043B\u044B\u043D\u0438 \u0438
      \u0441\u0443\u0445\u043E\u0439 \u0437\u0435\u043C\u043B\u0438. \u041E\u0434\u0438\u043D
      \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u0438\u0437-\u043F\u043E\u0434 \u0442\u044E\u043A\u043E\u0432 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
      \u043B\u0443\u043A \u0438 \u043A\u0438\u0432\u0430\u0435\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u0441\u0442\u0435\u043F\u0438: \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u043D\u0430 \u0438\u0441\u0445\u043E\u0434\u0435, \u0434\u0438\u0447\u044C
      \u0441\u0430\u043C\u0430 \u043F\u0440\u043E\u0441\u0438\u0442\u0441\u044F \u0432
      \u0440\u0443\u043A\u0438. \u0412\u043E\u043F\u0440\u043E\u0441 \u043B\u0438\u0448\u044C
      \u0432 \u0442\u043E\u043C, \u043A\u0442\u043E \u043F\u043E\u0439\u0434\u0451\u0442
      \u0438 \u043A\u0430\u043A \u0434\u0430\u043B\u0435\u043A\u043E \u0441\u0442\u043E\u0438\u0442
      \u0443\u0433\u043B\u0443\u0431\u043B\u044F\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866337
    m_Localized: "\u041E\u0445\u043E\u0442\u0438\u0442\u044C\u0441\u044F \u0443 \u043B\u0430\u0433\u0435\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866338
    m_Localized: "\u041F\u0430\u0440\u0430 \u0447\u0430\u0441\u043E\u0432 \u0432
      \u0431\u043B\u0438\u0436\u043D\u0435\u0439 \u0442\u0440\u0430\u0432\u0435 \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430
      \u0434\u0432\u0443\u0445 \u0442\u043E\u0449\u0438\u0445 \u0437\u0430\u0439\u0446\u0435\u0432
      \u0438 \u0433\u043E\u0440\u0441\u0442\u044C \u043F\u0435\u0440\u0435\u043F\u0435\u043B\u0438\u043D\u044B\u0445
      \u044F\u0438\u0446. \u041D\u0435\u0433\u0443\u0441\u0442\u043E, \u043D\u043E
      \u043A\u043E\u0442\u0451\u043B \u0443\u0436\u0435 \u0431\u0443\u043B\u044C\u043A\u0430\u0435\u0442,
      \u0438 \u0437\u0430\u043F\u0430\u0445 \u0436\u0430\u0440\u043A\u043E\u0433\u043E
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866339
    m_Localized: "\u0423\u0433\u043B\u0443\u0431\u0438\u0442\u044C\u0441\u044F \u0432
      \u0441\u0442\u0435\u043F\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866340
    m_Localized: "\u0421\u043B\u0435\u0434\u044B \u043A\u043E\u043F\u044B\u0442 \u043F\u0440\u0438\u0432\u0435\u043B\u0438
      \u043A \u0432\u043E\u0434\u043E\u043F\u043E\u044E - \u0437\u0430\u0440\u043E\u0441\u0448\u0435\u0439
      \u0441\u0442\u0430\u0440\u0438\u0446\u0435, \u0433\u0434\u0435 \u043A\u043E\u0440\u043C\u0438\u043B\u0438\u0441\u044C
      \u0434\u0440\u043E\u0444\u044B. \u0414\u0432\u0430 \u0442\u043E\u0447\u043D\u044B\u0445
      \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430, \u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D \u043C\u044F\u0441\u043E\u043C
      \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0440\u0430\u0437\u0434\u0435\u043B\u0430\u043B\u0438
      \u0434\u043E\u0431\u044B\u0447\u0443 \u0438 \u0440\u0430\u0437\u0432\u0435\u0441\u0438\u043B\u0438
      \u043F\u043E\u043B\u043E\u0441\u043A\u0438 \u0432\u044F\u043B\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430\u0434 \u0443\u0433\u043B\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866341
    m_Localized: "\u0421\u0442\u0435\u043F\u044C \u043E\u0431\u043C\u0430\u043D\u0447\u0438\u0432\u0430
      - \u0440\u043E\u0432\u043D\u0430\u044F \u043D\u0430 \u0432\u0438\u0434, \u043E\u043D\u0430
      \u043F\u0440\u044F\u0447\u0435\u0442 \u043E\u0432\u0440\u0430\u0433\u0438 \u0438
      \u043F\u0440\u043E\u043C\u043E\u0438\u043D\u044B. \u041E\u0445\u043E\u0442\u043D\u0438\u043A
      \u0437\u0430\u0431\u043B\u0443\u0434\u0438\u043B\u0441\u044F, \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0432 \u043B\u0430\u0433\u0435\u0440\u044C \u0437\u0430\u0442\u0435\u043C\u043D\u043E
      \u0441 \u043F\u0443\u0441\u0442\u044B\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438
      \u0438 \u0432\u044B\u0432\u0438\u0445\u043D\u0443\u0442\u043E\u0439 \u043B\u043E\u0434\u044B\u0436\u043A\u043E\u0439.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u043D\u0435\u0440\u0432\u043D\u0438\u0447\u0430\u044E\u0442:
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u0437\u0430 \u043D\u0438\u043C
      \u043A\u0442\u043E-\u0442\u043E \u0448\u0451\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866342
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u0434\u0438\u0447\u043D\u044B\u0435 \u0442\u0440\u043E\u043F\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866343
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043F\u0440\u0438\u0441\u0435\u043B,
      \u043F\u043E\u0442\u0440\u043E\u0433\u0430\u043B \u043F\u0440\u0438\u043C\u044F\u0442\u0443\u044E
      \u0442\u0440\u0430\u0432\u0443 \u0438 \u0443\u0441\u043C\u0435\u0445\u043D\u0443\u043B\u0441\u044F.
      \xAB\u0422\u0443\u0442 \u0434\u0436\u0435\u0439\u0440\u0430\u043D\u044B \u0445\u043E\u0434\u044F\u0442
      \u043D\u0430 \u0432\u043E\u0434\u043E\u043F\u043E\u0439 - \u043A\u0430\u0436\u0434\u044B\u0439
      \u0432\u0435\u0447\u0435\u0440, \u043A\u0430\u043A \u043F\u043E \u0447\u0430\u0441\u0430\u043C.\xBB
      \u041A \u0437\u0430\u043A\u0430\u0442\u0443 \u043E\u043D \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0441 \u0434\u0432\u0443\u043C\u044F \u0442\u0443\u0448\u0430\u043C\u0438
      \u043D\u0430 \u0432\u043E\u043B\u043E\u043A\u0443\u0448\u0435 \u0438\u0437
      \u0436\u0435\u0440\u0434\u0435\u0439. \u041C\u044F\u0441\u0430 \u0445\u0432\u0430\u0442\u0438\u0442
      \u043D\u0430\u0434\u043E\u043B\u0433\u043E, \u0430 \u0448\u043A\u0443\u0440\u044B
      \u043F\u043E\u0439\u0434\u0443\u0442 \u043D\u0430 \u0437\u0430\u043F\u043B\u0430\u0442\u043A\u0438
      \u0434\u043B\u044F \u0443\u043F\u0440\u044F\u0436\u0438. \u041B\u0430\u0433\u0435\u0440\u044C
      \u0441\u044B\u0442 \u0438 \u0441\u043F\u043E\u043A\u043E\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866344
    m_Localized: "\u0412\u0435\u0447\u0435\u0440 \u0443 \u043A\u043E\u0441\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866345
    m_Localized: "\u042F\u0437\u044B\u043A\u0438 \u043F\u043B\u0430\u043C\u0435\u043D\u0438
      \u043B\u0438\u0436\u0443\u0442 \u0441\u0443\u0445\u043E\u0439 \u043A\u0438\u0437\u044F\u043A,
      \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u044F \u0438\u0441\u043A\u0440\u044B
      \u0432 \u0442\u0451\u043C\u043D\u043E\u0435 \u043D\u0435\u0431\u043E. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0441\u0438\u0434\u044F\u0442 \u043A\u0440\u0443\u0433\u043E\u043C: \u043A\u0442\u043E
      \u0447\u0438\u043D\u0438\u0442 \u0441\u0431\u0440\u0443\u044E, \u043A\u0442\u043E
      \u0442\u043E\u0447\u0438\u0442 \u043D\u043E\u0436, \u043A\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432 \u043E\u0433\u043E\u043D\u044C.
      \u041D\u043E\u0447\u044C \u0442\u0451\u043F\u043B\u0430\u044F, \u0441\u0442\u0435\u043F\u043D\u044B\u0435
      \u0441\u0432\u0435\u0440\u0447\u043A\u0438 \u0441\u0442\u0440\u0435\u043A\u043E\u0447\u0443\u0442
      \u043D\u0430\u043F\u0435\u0440\u0435\u0431\u043E\u0439, \u0438 \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435
      \u0432\u0438\u0441\u0438\u0442 \u0437\u0430\u043F\u0430\u0445 \u0437\u0430\u0432\u0430\u0440\u0435\u043D\u043D\u043E\u0433\u043E
      \u0447\u0430\u044F \u0441 \u043C\u044F\u0442\u043E\u0439. \u0420\u0435\u0434\u043A\u0438\u0439
      \u0432\u0435\u0447\u0435\u0440 \u0431\u0435\u0437 \u0442\u0440\u0435\u0432\u043E\u0433:
      \u0441\u0430\u043C\u043E\u0435 \u0432\u0440\u0435\u043C\u044F \u0434\u043B\u044F
      \u0441\u043B\u043E\u0432\u0430, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0433\u043E
      \u0441\u043F\u043B\u043E\u0442\u0438\u0442\u044C \u043B\u044E\u0434\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866346
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866347
    m_Localized: "\u041C\u043E\u043B\u0447\u0430\u043D\u0438\u0435 \u0443 \u043E\u0433\u043D\u044F
      \u0442\u043E\u0436\u0435 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440.
      \u041B\u044E\u0434\u0438 \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u043D\u0430
      \u0443\u0433\u043B\u0438, \u043F\u044C\u044E\u0442 \u0447\u0430\u0439, \u0438
      \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0445
      \u0434\u043D\u0435\u0439 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u043F\u043B\u0435\u0447\u0438. \u0423\u0442\u0440\u043E\u043C \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0442\u0440\u043E\u043D\u0435\u0442\u0441\u044F \u043B\u0435\u0433\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866348
    m_Localized: "\u041F\u043E\u0434\u043D\u044F\u0442\u044C \u0434\u0443\u0445 \u0440\u0435\u0447\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866349
    m_Localized: "\u0412\u044B \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438
      \u043E \u0434\u043E\u0440\u043E\u0433\u0435, \u043E \u0442\u043E\u043C, \u0447\u0442\u043E
      \u0436\u0434\u0451\u0442 \u0432\u043F\u0435\u0440\u0435\u0434\u0438, \u043E
      \u0441\u0435\u0440\u0435\u0431\u0440\u0435 \u0438 \u0448\u0451\u043B\u043A\u0435
      \u043D\u0430 \u0440\u044B\u043D\u043A\u0430\u0445 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430.
      \u0421\u043B\u043E\u0432\u0430 \u043D\u0430\u0448\u043B\u0438\u0441\u044C \u0432\u0435\u0440\u043D\u044B\u0435:
      \u043F\u0440\u043E\u0441\u0442\u044B\u0435, \u0431\u0435\u0437 \u043F\u0430\u0444\u043E\u0441\u0430.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A-\u043F\u0435\u0440\u0441 \u043A\u0438\u0432\u043D\u0443\u043B
      \u0438 \u0441\u043A\u0430\u0437\u0430\u043B: \xAB\u0417\u0430 \u0442\u0430\u043A\u043E\u0433\u043E
      \u0445\u043E\u0437\u044F\u0438\u043D\u0430 \u043D\u0435 \u0441\u0442\u0440\u0430\u0448\u043D\u043E\xBB.
      \u041B\u044E\u0434\u0438 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u043B\u0438\u0441\u044C
      \u0438 \u0432\u044B\u043F\u0440\u044F\u043C\u0438\u043B\u0438 \u0441\u043F\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866350
    m_Localized: "\u0421\u043B\u043E\u0432\u0430 \u043F\u0440\u043E\u0437\u0432\u0443\u0447\u0430\u043B\u0438
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0435, \u043D\u043E
      \u043F\u0443\u0441\u0442\u044B\u0435: \u0432\u0438\u0434\u043D\u043E, \u0447\u0442\u043E
      \u0437\u0430\u0443\u0447\u0435\u043D\u044B, \u0430 \u043D\u0435 \u043F\u0440\u043E\u0436\u0438\u0442\u044B.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u0432\u0435\u0436\u043B\u0438\u0432\u043E
      \u043A\u0438\u0432\u043D\u0443\u043B\u0438 \u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u043A \u0441\u0432\u043E\u0438\u043C \u0434\u0435\u043B\u0430\u043C. \u041D\u0435
      \u0445\u0443\u0436\u0435, \u0447\u0435\u043C \u0431\u044B\u043B\u043E, \u043D\u043E
      \u0438 \u043D\u0435 \u043B\u0443\u0447\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866351
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0438\u0441\u0442\u043E\u0440\u0438\u044E \u043D\u0430 \u043C\u0435\u0441\u0442\u043D\u043E\u043C
      \u044F\u0437\u044B\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866352
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043E\u0442\u0445\u043B\u0435\u0431\u043D\u0443\u043B
      \u0447\u0430\u044E, \u043F\u0440\u043E\u043A\u0430\u0448\u043B\u044F\u043B\u0441\u044F
      \u0438 \u043D\u0430\u0447\u0430\u043B \u0440\u0430\u0441\u0441\u043A\u0430\u0437
      \u043D\u0430 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C:
      <npc_speech lang=\"Sogdian\">\u0421\u043B\u0443\u0448\u0430\u0439\u0442\u0435!
      \u0416\u0438\u043B \u043E\u0434\u0438\u043D \u043A\u0443\u043F\u0435\u0446
      - \u0443\u043F\u0440\u044F\u043C\u044B\u0439, \u043A\u0430\u043A \u0441\u0442\u0430\u0440\u044B\u0439
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434. \u0421\u0435\u043C\u044C \u0431\u0443\u0440\u044C
      \u043F\u0440\u043E\u0448\u0451\u043B \u0438 \u044F\u0432\u0438\u043B\u0441\u044F
      \u0432 \u0411\u0443\u0445\u0430\u0440\u0443 \u0441 \u043F\u043E\u043B\u043D\u044B\u043C\u0438
      \u0442\u044E\u043A\u0430\u043C\u0438 \u0438 \u0441\u0435\u0434\u043E\u0439
      \u0431\u043E\u0440\u043E\u0434\u043E\u0439.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866353
    m_Localized: "\u041F\u043E\u0447\u0438\u043D\u043A\u0430 \u0442\u0435\u043B\u0435\u0433\u0438
      \u043D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866354
    m_Localized: "\u0421\u043A\u0440\u0438\u043F \u043D\u0435 \u0443\u043C\u043E\u043B\u043A\u0430\u043B
      \u0441 \u0441\u0430\u043C\u043E\u0433\u043E \u0443\u0442\u0440\u0430: \u043B\u0435\u0432\u043E\u0435
      \u0437\u0430\u0434\u043D\u0435\u0435 \u043A\u043E\u043B\u0435\u0441\u043E \u0445\u043E\u0434\u0438\u0442
      \u0432\u043E\u0441\u044C\u043C\u0451\u0440\u043A\u043E\u0439, \u0441\u043F\u0438\u0446\u044B
      \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u043B\u0438\u0441\u044C, \u0430
      \u0436\u0435\u043B\u0435\u0437\u043D\u044B\u0439 \u043E\u0431\u043E\u0434 \u043F\u0440\u043E\u0441\u0435\u0434\u0430\u0435\u0442
      \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u0439 \u043A\u043E\u043B\u0434\u043E\u0431\u0438\u043D\u0435.
      \u041D\u0430 \u0445\u043E\u0434\u0443 \u043D\u0435 \u043F\u043E\u0447\u0438\u043D\u0438\u0442\u044C:
      \u043D\u0443\u0436\u0435\u043D \u043F\u0440\u0438\u0432\u0430\u043B, \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
      \u0438 \u043A\u0440\u0435\u043F\u043A\u0438\u0435 \u0440\u0443\u043A\u0438.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E\u0442
      \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F \u0438 \u043A\u0430\u0447\u0430\u044E\u0442
      \u0433\u043E\u043B\u043E\u0432\u0430\u043C\u0438: \u0440\u0430\u0431\u043E\u0442\u044B
      \u043D\u0430 \u043F\u043E\u043B\u0434\u043D\u044F, \u0435\u0441\u043B\u0438
      \u043F\u043E\u0432\u0435\u0437\u0451\u0442, \u0438 \u043D\u0430 \u0432\u0435\u0441\u044C
      \u0434\u0435\u043D\u044C, \u0435\u0441\u043B\u0438 \u043D\u0435\u0442. \u0420\u044F\u0434\u043E\u043C
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043D\u0430\u044F
      \u0442\u0440\u043E\u043F\u0430, \u0438 \u043F\u043E\u0440\u043E\u0439 \u043C\u0438\u043C\u043E
      \u0442\u044F\u043D\u0443\u0442\u0441\u044F \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0434\u0440\u0443\u0433\u0438\u0445 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432.\r\n\r\n<npc_speech
      lang=\"Persian\">\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A. \u041A\u043E\u043B\u0435\u0441\u043E
      \u0441\u043B\u043E\u043C\u0430\u043B\u043E\u0441\u044C? \u0423 \u043D\u0430\u0441
      \u0435\u0441\u0442\u044C \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B
      - \u0435\u0441\u043B\u0438 \u0446\u0435\u043D\u0430 \u043F\u043E\u0434\u043E\u0439\u0434\u0451\u0442.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866355
    m_Localized: "\u0427\u0438\u043D\u0438\u0442\u044C \u0441\u0432\u043E\u0438\u043C\u0438
      \u0441\u0438\u043B\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866356
    m_Localized: "\u0420\u0430\u0431\u043E\u0442\u0430 \u0437\u0430\u043D\u044F\u043B\u0430
      \u043F\u043E\u043B\u0434\u043D\u044F, \u043D\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442
      \u0434\u043E\u0431\u0440\u043E\u0441\u043E\u0432\u0435\u0441\u0442\u043D\u044B\u0439.
      \u041D\u043E\u0432\u044B\u0435 \u0441\u043F\u0438\u0446\u044B \u0432\u044B\u0442\u0435\u0441\u0430\u043D\u044B
      \u0438\u0437 \u0441\u0440\u0443\u0431\u043B\u0435\u043D\u043D\u043E\u0433\u043E
      \u0443 \u0440\u0443\u0447\u044C\u044F \u044F\u0441\u0435\u043D\u044F, \u043E\u0431\u043E\u0434
      \u0432\u044B\u043F\u0440\u0430\u0432\u043B\u0435\u043D \u0438 \u043F\u043E\u0441\u0430\u0436\u0435\u043D
      \u043D\u0430 \u043C\u0435\u0441\u0442\u043E \u0433\u043E\u0440\u044F\u0447\u0435\u0439
      \u0443\u0441\u0430\u0434\u043A\u043E\u0439. \u041A\u043E\u043B\u0435\u0441\u043E
      \u043A\u0440\u0443\u0442\u0438\u0442\u0441\u044F \u0440\u043E\u0432\u043D\u043E,
      \u0431\u0435\u0437 \u043B\u044E\u0444\u0442\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0443\u0442\u0438\u0440\u0430\u044E\u0442 \u043F\u043E\u0442 \u0438 \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0449\u0451\u043B\u043A\u0430\u044E\u0442 \u044F\u0437\u044B\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866357
    m_Localized: "\u0421\u043F\u0438\u0446\u0430 \u0440\u0430\u0441\u043A\u043E\u043B\u043E\u043B\u0430\u0441\u044C
      \u043F\u0440\u0438 \u043F\u043E\u0434\u0433\u043E\u043D\u043A\u0435, \u043E\u0431\u043E\u0434
      \u0441\u0435\u043B \u043A\u0440\u0438\u0432\u043E, \u0438 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044C \u0432\u0441\u0451 \u0437\u0430\u043D\u043E\u0432\u043E.
      \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u043A\u043E\u0435-\u043A\u0430\u043A
      \u0441\u043E\u0431\u0440\u0430\u043B\u0438: \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F,
      \u043D\u043E \u043D\u0435\u043D\u0430\u0434\u0451\u0436\u043D\u043E. \u041F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u043D\u0430 \u043F\u043E\u0434\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435
      \u0441\u0438\u043B, \u0430 \u043B\u044E\u0434\u0438 \u0432\u044B\u043C\u043E\u0442\u0430\u043D\u044B
      \u0438 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866358
    m_Localized: "\u0420\u0438\u0441\u043A\u043D\u0443\u0442\u044C \u0438 \u0435\u0445\u0430\u0442\u044C
      \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866359
    m_Localized: "\u041A\u043E\u043B\u0435\u0441\u043E \u0441\u043A\u0440\u0438\u043F\u0438\u0442,
      \u043D\u043E \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F: \u043F\u043E\u043A\u0430.
      \u041A\u0430\u0436\u0434\u0430\u044F \u044F\u043C\u0430 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435
      \u043E\u0442\u0434\u0430\u0451\u0442\u0441\u044F \u0441\u043A\u0440\u0435\u0436\u0435\u0442\u043E\u043C
      \u043F\u043E \u043D\u0435\u0440\u0432\u0430\u043C. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043A\u043E\u0441\u044F\u0442\u0441\u044F \u043D\u0430 \u043A\u0430\u0447\u0430\u044E\u0449\u0443\u044E\u0441\u044F
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443 \u0438 \u043C\u043E\u043B\u0447\u0430\u0442,
      \u043D\u043E \u0432 \u0438\u0445 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0438
      \u0441\u043B\u044B\u0448\u043D\u043E: \xAB\u041D\u0435 \u0434\u043E\u0432\u0435\u0437\u0451\u043C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866360
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0434\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441 \u043F\u0440\u043E\u0435\u0437\u0436\u0438\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866361
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0438\u043B
      \u043F\u0440\u043E\u0435\u0437\u0436\u0438\u0439 \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439
      \u0444\u0443\u0440\u0433\u043E\u043D, \u043F\u043E\u0431\u043E\u043B\u0442\u0430\u043B
      \u0441 \u0432\u043E\u0437\u043D\u0438\u0446\u0435\u0439, \u043F\u0440\u043E\u0449\u0443\u043F\u0430\u043B
      \u0442\u043E\u0432\u0430\u0440 \u0438 \u0447\u0435\u0440\u0435\u0437 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C
      \u0447\u0430\u0441\u0430 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0441
      \u0433\u043E\u0442\u043E\u0432\u044B\u043C \u043A\u043E\u043B\u0435\u0441\u043E\u043C
      (\u043F\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u043D\u044B\u043C, \u043D\u043E
      \u043A\u0440\u0435\u043F\u043A\u0438\u043C). \xAB\u041F\u044F\u0442\u044C \u043C\u043E\u043D\u0435\u0442
      \u0438 \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u0435 \u0434\u043E\u0431\u0440\u043E\u0433\u043E
      \u0441\u043B\u043E\u0432\u0430 \u0432 \u0420\u0435\u0435. \u0423 \u043D\u0438\u0445
      \u0442\u0430\u043A\u0438\u0445 \u0434\u0432\u0430 \u0437\u0430\u043F\u0430\u0441\u043D\u044B\u0445.\xBB
      \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0441\u0442\u043E\u0438\u0442 \u0440\u043E\u0432\u043D\u043E, \u0430 \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439
      \u0432\u043E\u0437\u043D\u0438\u0446\u0430 \u0443\u0435\u0445\u0430\u043B \u0441
      \u0440\u0443\u043A\u043E\u043F\u043E\u0436\u0430\u0442\u0438\u0435\u043C \u0438
      \u0432\u0430\u0448\u0438\u043C \u0438\u043C\u0435\u043D\u0435\u043C \u043D\u0430
      \u044F\u0437\u044B\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866362
    m_Localized: "\u041F\u043E\u0438\u0441\u043A \u0432\u043E\u0434\u044B \u0432
      \u043D\u043E\u0447\u043D\u043E\u0439 \u043F\u0443\u0441\u0442\u044B\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866363
    m_Localized: "\u0421\u043E\u043B\u043D\u0446\u0435 \u0443\u0448\u043B\u043E \u0437\u0430
      \u0431\u0430\u0440\u0445\u0430\u043D\u044B, \u043D\u043E \u0436\u0430\u0440
      \u043D\u0435 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0435\u0442, \u043F\u0435\u0441\u043E\u043A
      \u0434\u044B\u0448\u0438\u0442 \u0437\u043D\u043E\u0435\u043C, \u043D\u0430\u043A\u043E\u043F\u043B\u0435\u043D\u043D\u044B\u043C
      \u0437\u0430 \u0434\u0435\u043D\u044C. \u0411\u0443\u0440\u0434\u044E\u043A\u0438
      \u0441\u0443\u0445\u043E \u0448\u0443\u0440\u0448\u0430\u0442 \u043F\u0440\u0438
      \u043A\u0430\u0436\u0434\u043E\u043C \u043D\u0430\u043A\u043B\u043E\u043D\u0435:
      \u0432\u043E\u0434\u044B \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043D\u0430
      \u0433\u043B\u043E\u0442\u043E\u043A, \u043C\u043E\u0436\u0435\u0442, \u0434\u0432\u0430.
      \u0421\u0442\u0430\u0440\u044B\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A-\u0431\u0435\u0434\u0443\u0438\u043D
      \u0432\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0432
      \u0442\u0435\u043C\u043D\u043E\u0442\u0443 \u0438 \u043D\u044E\u0445\u0430\u0435\u0442
      \u0432\u043E\u0437\u0434\u0443\u0445. \xAB\u041D\u0430 \u0441\u0435\u0432\u0435\u0440\u043E-\u0432\u043E\u0441\u0442\u043E\u043A\u0435,
      - \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D, - \u043F\u0430\u0445\u043D\u0435\u0442
      \u0441\u044B\u0440\u043E\u0441\u0442\u044C\u044E. \u041C\u043E\u0436\u0435\u0442,
      \u0440\u0443\u0441\u043B\u043E\xBB. \u041D\u043E \u043D\u043E\u0447\u043D\u0430\u044F
      \u043F\u0443\u0441\u0442\u044B\u043D\u044F \u043F\u043E\u043B\u043D\u0430 \u043B\u043E\u0432\u0443\u0448\u0435\u043A:
      \u0437\u044B\u0431\u0443\u0447\u0438\u0439 \u043F\u0435\u0441\u043E\u043A,
      \u0437\u043C\u0435\u0438\u043D\u044B\u0435 \u043D\u043E\u0440\u044B, \u043E\u0432\u0440\u0430\u0433\u0438,
      \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u044B\u0435 \u0431\u0435\u0437 \u043B\u0443\u043D\u044B.
      \u0418\u0434\u0442\u0438 \u0438\u043B\u0438 \u0436\u0434\u0430\u0442\u044C
      \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430 \u0438 \u0442\u0435\u0440\u044F\u0442\u044C
      \u043E\u0441\u0442\u0430\u0442\u043A\u0438 \u0432\u043E\u0434\u044B \u043D\u0430
      \u0436\u0430\u0440\u0443?\r\n\r\n<npc_speech lang=\"Arabic\">\u042D\u0439,
      \u043F\u0443\u0442\u043D\u0438\u043A, \u0441\u043E\u043B\u043D\u0446\u0435
      \u043D\u0430\u0441 \u0443\u0431\u0438\u0432\u0430\u0435\u0442. \u0412\u043E\u0434\u0430
      - \u0442\u0430\u043C, \u044F \u0447\u0443\u044E \u0435\u0451. \u041D\u043E
      \u043D\u043E\u0447\u044C \u043E\u043F\u0430\u0441\u043D\u0430.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866364
    m_Localized: "\u0421\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u0440\u043E\u0441\u0443
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866365
    m_Localized: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0440\u0430\u0441\u0441\u0442\u0435\u043B\u0438\u043B\u0438 \u0442\u043A\u0430\u043D\u044C
      \u043D\u0430 \u043A\u0430\u043C\u043D\u044F\u0445 \u0438 \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u0445.
      \u041A \u0432\u043E\u0441\u0445\u043E\u0434\u0443 \u0441\u043E\u0431\u0440\u0430\u043B\u0438
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0438\u0433\u043E\u0440\u0448\u043D\u0435\u0439
      \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0439 \u0432\u043B\u0430\u0433\u0438,
      \u0435\u0434\u0432\u0430 \u0445\u0432\u0430\u0442\u0438\u043B\u043E \u0441\u043C\u043E\u0447\u0438\u0442\u044C
      \u0433\u043E\u0440\u043B\u043E \u043A\u0430\u0436\u0434\u043E\u043C\u0443.
      \u041D\u0435\u043C\u043D\u043E\u0433\u043E, \u043D\u043E \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u0448\u0438\u0435
      \u0433\u0443\u0431\u044B \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u044B
      \u0438 \u0437\u0430 \u044D\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866366
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u0440\u0443\u0441\u043B\u043E
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866367
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u043F\u0440\u0438\u0432\u0451\u043B
      \u0432\u0435\u0440\u043D\u043E: \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u043B\u0447\u0430\u0441\u0430
      \u043D\u043E\u0433\u0438 \u0441\u0442\u0443\u043F\u0438\u043B\u0438 \u043D\u0430
      \u0436\u0451\u0441\u0442\u043A\u0438\u0439 \u0433\u043B\u0438\u043D\u0438\u0441\u0442\u044B\u0439
      \u0433\u0440\u0443\u043D\u0442 \u0432\u044B\u0441\u043E\u0445\u0448\u0435\u0433\u043E
      \u0440\u0443\u0441\u043B\u0430. \u041B\u043E\u043F\u0430\u0442\u0430 \u0432\u043E\u0448\u043B\u0430
      \u0432 \u043F\u0435\u0441\u043E\u043A \u0443 \u043A\u043E\u0440\u043D\u0435\u0439
      \u043C\u0451\u0440\u0442\u0432\u043E\u0433\u043E \u0442\u0430\u043C\u0430\u0440\u0438\u0441\u043A\u0430,
      \u0438 \u043D\u0430 \u0433\u043B\u0443\u0431\u0438\u043D\u0435 \u043B\u043E\u043A\u0442\u044F
      \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u0438\u043B\u0430 \u043C\u0443\u0442\u043D\u0430\u044F,
      \u043D\u043E \u0436\u0438\u0432\u0430\u044F \u0432\u043E\u0434\u0430. \u041A
      \u043F\u043E\u043B\u0443\u043D\u043E\u0447\u0438 \u0431\u0443\u0440\u0434\u044E\u043A\u0438
      \u043F\u043E\u043B\u043D\u044B. \u041B\u044E\u0434\u0438 \u043F\u0438\u043B\u0438
      \u0436\u0430\u0434\u043D\u043E, \u043C\u043E\u043B\u0447\u0430, \u0438 \u0431\u044B\u043B\u043E
      \u0441\u043B\u044B\u0448\u043D\u043E \u0442\u043E\u043B\u044C\u043A\u043E \u0431\u0443\u043B\u044C\u043A\u0430\u043D\u044C\u0435
      \u0434\u0430 \u0441\u0442\u0440\u0451\u043A\u043E\u0442 \u0446\u0438\u043A\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866368
    m_Localized: "\u0422\u0435\u043C\u043D\u043E\u0442\u0430 \u043E\u0431\u043C\u0430\u043D\u0443\u043B\u0430
      - \u0442\u043E, \u0447\u0442\u043E \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
      \u0440\u0443\u0441\u043B\u043E\u043C, \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
      \u0434\u043B\u0438\u043D\u043D\u043E\u0439 \u043B\u043E\u0436\u0431\u0438\u043D\u043E\u0439
      \u043C\u0435\u0436\u0434\u0443 \u0431\u0430\u0440\u0445\u0430\u043D\u0430\u043C\u0438.
      \u0414\u0432\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0438\u0441\u044C
      \u0432 \u043F\u0435\u0441\u0447\u0430\u043D\u044B\u0439 \u043A\u0430\u0440\u043C\u0430\u043D
      \u043F\u043E \u043F\u043E\u044F\u0441, \u0442\u0440\u0435\u0442\u0438\u0439
      \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u043B \u043D\u0430 \u0437\u043C\u0435\u0438\u043D\u0443\u044E
      \u043D\u043E\u0440\u0443 \u0438 \u0435\u0434\u0432\u0430 \u0443\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u043E\u0442 \u0443\u043A\u0443\u0441\u0430. \u0412\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u0432 \u043B\u0430\u0433\u0435\u0440\u044C \u0437\u0430\u0442\u0435\u043C\u043D\u043E,
      \u0438\u0437\u043C\u043E\u0442\u0430\u043D\u043D\u044B\u0435, \u0431\u0435\u0437
      \u043A\u0430\u043F\u043B\u0438 \u0432\u043E\u0434\u044B. \u0423\u0442\u0440\u043E
      \u0431\u0443\u0434\u0435\u0442 \u0442\u044F\u0436\u0451\u043B\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866369
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u0441\u043A\u0440\u044B\u0442\u044B\u0439 \u043A\u043E\u043B\u043E\u0434\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866370
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F,
      \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u044F \u043D\u0438 \u0441\u043B\u043E\u0432\u0430,
      \u0437\u0430\u043A\u0438\u043D\u0443\u043B \u043D\u0430 \u043F\u043B\u0435\u0447\u043E
      \u043F\u0443\u0441\u0442\u043E\u0439 \u0431\u0443\u0440\u0434\u044E\u043A \u0438
      \u0443\u0448\u0451\u043B \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0443.
      \u0412\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0447\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441 - \u0431\u0443\u0440\u0434\u044E\u043A \u043D\u0430\u0431\u0443\u0445
      \u0438 \u0442\u044F\u0436\u0435\u043B\u043E \u043F\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u043B\u0441\u044F.
      \xAB\u0421\u0442\u0430\u0440\u044B\u0439 \u043A\u043E\u043B\u043E\u0434\u0435\u0446
      \u0437\u0430 \u0442\u0440\u0435\u0442\u044C\u0438\u043C \u0431\u0430\u0440\u0445\u0430\u043D\u043E\u043C.
      \u041A\u0430\u043C\u043D\u0438 \u043F\u043E\u0447\u0442\u0438 \u0437\u0430\u0441\u044B\u043F\u0430\u043D\u044B,
      \u043D\u043E \u044F \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u043B
      \u0433\u043E\u0440\u043B\u043E\u0432\u0438\u043D\u0443. \u0412\u043E\u0434\u0430
      \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F, \u0447\u0438\u0441\u0442\u0430\u044F.
      \u0418\u0434\u0451\u043C\u0442\u0435.\xBB \u041A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443
      \u0432\u0435\u0441\u044C \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043D\u0430\u043F\u043E\u0451\u043D,
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u0444\u044B\u0440\u043A\u0430\u044E\u0442
      \u0443 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0433\u043E \u0441\u0440\u0443\u0431\u0430,
      \u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0441\u0438\u0434\u0438\u0442
      \u0443 \u043E\u0433\u043D\u044F \u0438 \u0442\u043E\u0447\u0438\u0442 \u0441\u0432\u043E\u0439
      \u043D\u043E\u0436, \u0431\u0443\u0434\u0442\u043E \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866371
    m_Localized: "\u0421\u043A\u043E\u0440\u043F\u0438\u043E\u043D\u044B \u0432 \u043B\u0430\u0433\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866372
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u043A\u0440\u0438\u043A \u0440\u0430\u0437\u0434\u0430\u043B\u0441\u044F
      \u0443 \u0442\u0440\u0435\u0442\u044C\u0435\u0439 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      - \u0441\u0438\u043F\u043B\u044B\u0439, \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439,
      \u0431\u0443\u0434\u0442\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443
      \u0437\u0430\u0436\u0430\u043B\u0438 \u0440\u043E\u0442. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043E\u0442\u0434\u0451\u0440\u043D\u0443\u043B \u0440\u0443\u043A\u0443 \u043E\u0442
      \u0442\u044E\u043A\u0430 \u0438 \u0437\u0430\u0442\u0440\u044F\u0441 \u0435\u044E:
      \u043D\u0430 \u0442\u044B\u043B\u044C\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
      \u043B\u0430\u0434\u043E\u043D\u0438 \u043D\u0430\u0431\u0443\u0445\u0430\u0435\u0442
      \u043A\u0440\u0430\u0441\u043D\u0430\u044F \u0442\u043E\u0447\u043A\u0430.
      \u041F\u043E\u0434 \u0440\u043E\u0433\u043E\u0436\u0435\u0439 \u0448\u0435\u0432\u0435\u043B\u0438\u0442\u0441\u044F
      \u0447\u0442\u043E-\u0442\u043E \u043C\u0435\u043B\u043A\u043E\u0435 \u0438
      \u0447\u0451\u0440\u043D\u043E\u0435. \u041A\u0442\u043E-\u0442\u043E \u043F\u043E\u0434\u043D\u044F\u043B
      \u0444\u043E\u043D\u0430\u0440\u044C, \u0438 \u0441\u0442\u0430\u043B\u043E
      \u0432\u0438\u0434\u043D\u043E: \u043F\u0435\u0441\u0447\u0430\u043D\u044B\u0435
      \u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D\u044B, \u0434\u0435\u0441\u044F\u0442\u043A\u0438,
      \u043B\u0435\u0437\u0443\u0442 \u0438\u0437-\u043F\u043E\u0434 \u043F\u043E\u0432\u043E\u0437\u043E\u043A,
      \u0438\u0437 \u0441\u043A\u043B\u0430\u0434\u043E\u043A \u0442\u043A\u0430\u043D\u0438,
      \u0438\u0437-\u043F\u043E\u0434 \u043A\u0430\u043C\u043D\u0435\u0439, \u043D\u0430
      \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0441\u0443\u0448\u0438\u043B\u0430\u0441\u044C
      \u0441\u0431\u0440\u0443\u044F. \u041D\u043E\u0447\u043D\u043E\u0439 \u0445\u043E\u043B\u043E\u0434
      \u0441\u043E\u0433\u043D\u0430\u043B \u0438\u0445 \u043A \u0442\u0435\u043F\u043B\u0443
      \u043A\u043E\u0441\u0442\u0440\u0430 \u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0445
      \u0442\u0435\u043B. \u041D\u0443\u0436\u043D\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0431\u044B\u0441\u0442\u0440\u043E: \u0443\u043A\u0443\u0441 \u043E\u0434\u043D\u043E\u0433\u043E
      \u043D\u0435 \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u0435\u043D, \u043D\u043E
      \u0435\u0441\u043B\u0438 \u0443\u0436\u0430\u043B\u044F\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445,
      \u043A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443 \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0441\u0434\u0432\u0438\u043D\u0435\u0442\u0441\u044F \u0441
      \u043C\u0435\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866373
    m_Localized: "\u041E\u0442\u043E\u0433\u043D\u0430\u0442\u044C \u043E\u0433\u043D\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866374
    m_Localized: "\u0424\u0430\u043A\u0435\u043B\u044B \u0438\u0437 \u043F\u0440\u043E\u043C\u0430\u0441\u043B\u0435\u043D\u043D\u043E\u0439
      \u0432\u0435\u0442\u043E\u0448\u0438 \u0440\u0430\u0437\u043E\u0433\u043D\u0430\u043B\u0438
      \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u0442\u0432\u0430\u0440\u0435\u0439,
      \u043D\u043E \u043D\u0435 \u0432\u0441\u0435\u0445. \u0414\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u0436\u0433\u043B\u0438
      \u0445\u0432\u043E\u0440\u043E\u0441\u0442 \u0438 \u0432\u044B\u0442\u0440\u044F\u0445\u0438\u0432\u0430\u043B\u0438
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0442\u044E\u043A: \u043D\u0443\u0434\u043D\u0430\u044F,
      \u0438\u0437\u043C\u0430\u0442\u044B\u0432\u0430\u044E\u0449\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430.
      \u041E\u0434\u0438\u043D \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0443\u0436\u0430\u043B\u0435\u043D
      \u0432 \u0449\u0438\u043A\u043E\u043B\u043E\u0442\u043A\u0443, \u0434\u0440\u0443\u0433\u043E\u0439
      \u043E\u0431\u0436\u0451\u0433 \u0440\u0443\u043A\u0443 \u0444\u0430\u043A\u0435\u043B\u043E\u043C.
      \u041F\u0440\u0438\u043F\u0430\u0441\u044B \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B\u0438:
      \u043C\u0435\u0448\u043E\u043A \u0441 \u043C\u0443\u043A\u043E\u0439 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0432\u044B\u0442\u0440\u044F\u0445\u043D\u0443\u0442\u044C \u0438 \u0431\u0440\u043E\u0441\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866375
    m_Localized: "\u0423\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0434\u044B\u043C\u043E\u0432\u0443\u044E
      \u0437\u0430\u0432\u0435\u0441\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866376
    m_Localized: "\u0421\u0443\u0445\u043E\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u0438\u0439
      \u043D\u0430\u0432\u043E\u0437, \u0433\u043E\u0440\u0441\u0442\u044C \u0441\u0435\u0440\u044B
      \u0438\u0437 \u0430\u043F\u0442\u0435\u0447\u043D\u043E\u0433\u043E \u043C\u0435\u0448\u043A\u0430
      \u0438 \u043F\u0443\u0447\u043E\u043A \u043F\u043E\u043B\u044B\u043D\u0438:
      \u0433\u0443\u0441\u0442\u043E\u0439 \u0435\u0434\u043A\u0438\u0439 \u0434\u044B\u043C
      \u043F\u043E\u043F\u043E\u043B\u0437 \u043F\u043E \u0437\u0435\u043C\u043B\u0435,
      \u0437\u0430\u0431\u0438\u0432\u0430\u044F\u0441\u044C \u043F\u043E\u0434 \u043F\u043E\u0432\u043E\u0437\u043A\u0438.
      \u0421\u043A\u043E\u0440\u043F\u0438\u043E\u043D\u044B \u0445\u043B\u044B\u043D\u0443\u043B\u0438
      \u043F\u0440\u043E\u0447\u044C \u0447\u0451\u0440\u043D\u044B\u043C \u0440\u0443\u0447\u044C\u0451\u043C,
      \u0443\u043F\u043E\u043B\u0437\u0430\u044F \u0432 \u043F\u0435\u0441\u043E\u043A.
      \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u0432\u043E\u0437\u0434\u0443\u0445
      \u043E\u0447\u0438\u0441\u0442\u0438\u043B\u0441\u044F \u0438 \u043B\u0430\u0433\u0435\u0440\u044C
      \u043E\u043F\u0443\u0441\u0442\u0435\u043B \u043E\u0442 \u0442\u0432\u0430\u0440\u0435\u0439.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0437\u0430\u043A\u0430\u0448\u043B\u044F\u043B\u0438\u0441\u044C,
      \u043D\u043E \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B\u0438 \u0441
      \u043E\u0431\u043B\u0435\u0433\u0447\u0435\u043D\u0438\u0435\u043C - \u043D\u0438
      \u043E\u0434\u043D\u043E\u0433\u043E \u043D\u043E\u0432\u043E\u0433\u043E \u0443\u043A\u0443\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866377
    m_Localized: "\u0414\u044B\u043C \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0441\u044F
      \u0436\u0438\u0434\u043A\u0438\u043C, \u0440\u0432\u0430\u043D\u044B\u043C,
      \u0432\u0435\u0442\u0435\u0440 \u0440\u0430\u0437\u043D\u043E\u0441\u0438\u043B
      \u0435\u0433\u043E \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u044B. \u0421\u043A\u043E\u0440\u043F\u0438\u043E\u043D\u044B
      \u043D\u0435 \u0443\u0448\u043B\u0438, \u0430 \u0440\u0430\u0437\u0431\u0435\u0436\u0430\u043B\u0438\u0441\u044C
      \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u043B\u0430\u0433\u0435\u0440\u044E.
      \u0422\u0440\u043E\u0435 \u0443\u0436\u0430\u043B\u0435\u043D\u044B, \u043E\u0434\u0438\u043D
      \u0434\u0432\u0430\u0436\u0434\u044B: \u0440\u0443\u043A\u0430 \u0440\u0430\u0441\u043F\u0443\u0445\u043B\u0430,
      \u043D\u0430\u0447\u0430\u043B\u0441\u044F \u0436\u0430\u0440. \u041F\u0440\u0438\u043F\u0430\u0441\u044B,
      \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D\u043D\u044B\u0435 \u0434\u044B\u043C\u043E\u043C,
      \u0433\u043E\u0440\u0447\u0430\u0442 \u0438 \u0432\u043E\u043D\u044F\u044E\u0442.
      \u041D\u043E\u0447\u044C \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0430\u0441\u044C
      \u0432 \u043A\u043E\u0448\u043C\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866378
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0433\u043E\u0442\u043E\u0432\u0438\u0442
      \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u044F\u0434\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866379
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043D\u0435 \u0441\u0442\u0430\u043B
      \u043F\u0430\u043D\u0438\u043A\u043E\u0432\u0430\u0442\u044C. \u041E\u043D
      \u0434\u043E\u0441\u0442\u0430\u043B \u0438\u0437 \u0441\u0432\u043E\u0435\u0433\u043E
      \u043C\u0435\u0448\u043A\u0430 \u0433\u043B\u0438\u043D\u044F\u043D\u044B\u0439
      \u0433\u043E\u0440\u0448\u043E\u0447\u0435\u043A \u0441 \u0442\u0451\u043C\u043D\u043E\u0439
      \u043C\u0430\u0437\u044C\u044E (\u0440\u0430\u0441\u0442\u0451\u0440\u0442\u044B\u0439
      \u0431\u0435\u0437\u043E\u0430\u0440, \u0441\u043C\u0435\u0448\u0430\u043D\u043D\u044B\u0439
      \u0441 \u043A\u0430\u043C\u0444\u043E\u0440\u043E\u0439 \u0438 \u043C\u0430\u0441\u043B\u043E\u043C)
      \u0438 \u0432\u0435\u043B\u0435\u043B \u043C\u0430\u0437\u0430\u0442\u044C
      \u043C\u0435\u0441\u0442\u0430 \u0443\u043A\u0443\u0441\u043E\u0432. \u0416\u0436\u0435\u043D\u0438\u0435
      \u0443\u0448\u043B\u043E \u0437\u0430 \u043C\u0438\u043D\u0443\u0442\u0443,
      \u043E\u043F\u0443\u0445\u043E\u043B\u044C \u0441\u043F\u0430\u043B\u0430 \u0437\u0430
      \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C \u0447\u0430\u0441\u0430.
      \u041F\u043E\u0442\u043E\u043C \u043B\u0435\u043A\u0430\u0440\u044C \u0440\u0430\u0437\u0432\u0451\u043B
      \u043F\u0430\u0441\u0442\u0443 \u0438\u0437 \u043F\u043E\u043B\u044B\u043D\u0438
      \u0438 \u0441\u0435\u0440\u044B, \u043E\u0431\u043C\u0430\u0437\u0430\u043B
      \u043A\u043E\u043B\u0451\u0441\u0430 \u043F\u043E\u0432\u043E\u0437\u043E\u043A:
      \u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D\u044B \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u043B\u0438. \xAB\u0425\u0440\u0430\u043D\u0438
      \u044D\u0442\u043E\xBB, \u0441\u043A\u0430\u0437\u0430\u043B \u043E\u043D,
      \u0432\u043B\u043E\u0436\u0438\u0432 \u0432 \u0432\u0430\u0448\u0443 \u0440\u0443\u043A\u0443
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0433\u043B\u0430\u0434\u043A\u0438\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C. \xAB\u0411\u0435\u0437\u043E\u0430\u0440.
      \u0420\u0430\u0437\u043C\u0435\u043B\u0435\u0448\u044C \u0432 \u043F\u043E\u0440\u043E\u0448\u043E\u043A
      - \u0432\u044B\u0442\u044F\u043D\u0435\u0442 \u043B\u044E\u0431\u043E\u0439
      \u044F\u0434\xBB. \u041B\u0430\u0433\u0435\u0440\u044C \u0441\u043F\u0430\u043B
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866380
    m_Localized: "\u0427\u0442\u0435\u043D\u0438\u0435 \u0437\u0432\u0451\u0437\u0434\u043D\u043E\u0439
      \u043A\u0430\u0440\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866381
    m_Localized: "\u041D\u043E\u0447\u044C \u0443\u043F\u0430\u043B\u0430 \u043D\u0430
      \u043F\u0443\u0441\u0442\u044B\u043D\u044E, \u043A\u0430\u043A \u0447\u0451\u0440\u043D\u044B\u0439
      \u0437\u0430\u043D\u0430\u0432\u0435\u0441, \u0438 \u043D\u0435\u0431\u043E
      \u0432\u0437\u043E\u0440\u0432\u0430\u043B\u043E\u0441\u044C \u0437\u0432\u0451\u0437\u0434\u0430\u043C\u0438.
      \u041C\u043B\u0435\u0447\u043D\u044B\u0439 \u041F\u0443\u0442\u044C \u043B\u0435\u0436\u0438\u0442
      \u0431\u0435\u043B\u043E\u0439 \u0440\u0435\u043A\u043E\u0439 \u043E\u0442
      \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430 \u0434\u043E \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430,
      \u0438 \u043A\u0430\u0436\u0434\u0430\u044F \u0437\u0432\u0435\u0437\u0434\u0430
      \u0433\u043E\u0440\u0438\u0442 \u0442\u0430\u043A \u044F\u0440\u043A\u043E,
      \u0447\u0442\u043E, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043C\u043E\u0436\u043D\u043E
      \u043F\u043E\u0442\u0440\u043E\u0433\u0430\u0442\u044C \u0440\u0443\u043A\u043E\u0439.
      \u0421\u0442\u0430\u0440\u044B\u0439 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A \u0438\u0437 \u043F\u043E\u043F\u0443\u0442\u043D\u043E\u0433\u043E
      \u043E\u0431\u043E\u0437\u0430 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u044F\u0445 \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u0439
      \u0441\u0432\u0438\u0442\u043E\u043A: \u043A\u0430\u0440\u0442\u0430 \u0437\u0432\u0451\u0437\u0434\u043D\u043E\u0433\u043E
      \u043D\u0435\u0431\u0430, \u043F\u0440\u043E\u0447\u0435\u0440\u0447\u0435\u043D\u043D\u0430\u044F
      \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u043C\u0438 \u0447\u0435\u0440\u043D\u0438\u043B\u0430\u043C\u0438
      \u043D\u0430 \u0436\u0451\u043B\u0442\u043E\u0439 \u0431\u0443\u043C\u0430\u0433\u0435.
      \u041E\u043D \u0432\u043E\u0434\u0438\u0442 \u043F\u0430\u043B\u044C\u0446\u0435\u043C
      \u043F\u043E \u043B\u0438\u043D\u0438\u044F\u043C \u0438 \u0431\u043E\u0440\u043C\u043E\u0447\u0435\u0442,
      \u0441\u0432\u0435\u0440\u044F\u044F\u0441\u044C \u0441 \u043D\u0435\u0431\u043E\u0441\u0432\u043E\u0434\u043E\u043C.
      \u0417\u043D\u0430\u043D\u0438\u0435 \u044D\u0442\u0438\u0445 \u043B\u0438\u043D\u0438\u0439
      - \u0440\u0430\u0437\u043D\u0438\u0446\u0430 \u043C\u0435\u0436\u0434\u0443
      \u043A\u0440\u0430\u0442\u0447\u0430\u0439\u0448\u0438\u043C \u043F\u0443\u0442\u0451\u043C
      \u0438 \u043B\u0438\u0448\u043D\u0435\u0439 \u043D\u0435\u0434\u0435\u043B\u0435\u0439
      \u0441\u0440\u0435\u0434\u0438 \u0431\u0430\u0440\u0445\u0430\u043D\u043E\u0432.\r\n\r\n<npc_speech
      lang=\"Turkic\">\u0417\u0434\u043E\u0440\u043E\u0432 \u0431\u0443\u0434\u044C,
      \u043F\u0443\u0442\u043D\u0438\u043A! \u042D\u0442\u0438 \u0437\u0432\u0451\u0437\u0434\u044B
      \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u043F\u0443\u0442\u044C
      - \u041F\u043E\u043B\u044F\u0440\u043D\u0430\u044F \u0437\u0432\u0435\u0437\u0434\u0430
      \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u0441\u0435\u0432\u0435\u0440\u0435.
      \u0415\u0441\u043B\u0438 \u0437\u043D\u0430\u0435\u0448\u044C \u0438\u0445,
      \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u0437\u0430\u0431\u043B\u0443\u0434\u0438\u0448\u044C\u0441\u044F.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866382
    m_Localized: "\u0417\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0435
      \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866383
    m_Localized: "\u041F\u043E\u043B\u044F\u0440\u043D\u0430\u044F \u0437\u0432\u0435\u0437\u0434\u0430,
      \u043F\u043E\u044F\u0441 \u041E\u0440\u0438\u043E\u043D\u0430, \u044F\u0440\u043A\u0430\u044F
      \u0412\u0435\u0433\u0430: \u0442\u0440\u0451\u0445 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432
      \u0445\u0432\u0430\u0442\u0438\u0442, \u0447\u0442\u043E\u0431\u044B \u043D\u0435
      \u0441\u0431\u0438\u0442\u044C\u0441\u044F \u0441 \u0433\u0435\u043D\u0435\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F. \u0412\u044B
      \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438, \u043A\u0430\u043A
      \u0441\u0442\u0430\u0440\u0438\u043A \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B:
      \u043F\u0430\u043B\u0435\u0446 \u043D\u0430 \u041F\u043E\u043B\u044F\u0440\u043D\u0443\u044E,
      \u043B\u0430\u0434\u043E\u043D\u044C \u043D\u0430 \u044E\u0433\u043E-\u0437\u0430\u043F\u0430\u0434.
      \u041F\u0440\u043E\u0441\u0442\u043E, \u043D\u043E \u043D\u0430\u0434\u0451\u0436\u043D\u043E.
      \u0423\u0442\u0440\u043E\u043C \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0442\u0440\u043E\u043D\u0443\u043B\u0441\u044F
      \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u0435\u0435, \u0447\u0435\u043C
      \u0432\u0447\u0435\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866384
    m_Localized: "\u0421\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043A\u0430\u0440\u0442\u0443 \u0438 \u043F\u0440\u043E\u043B\u043E\u0436\u0438\u0442\u044C
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866385
    m_Localized: "\u0412\u044B \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B\u0438
      \u043A\u043B\u043E\u0447\u043E\u043A \u0431\u0443\u043C\u0430\u0433\u0438,
      \u0442\u0443\u0448\u044C \u0438 \u043F\u0435\u0440\u043E \u0438 \u043F\u0440\u0438\u043D\u044F\u043B\u0438\u0441\u044C
      \u0441\u0440\u0438\u0441\u043E\u0432\u044B\u0432\u0430\u0442\u044C \u043B\u0438\u043D\u0438\u0438,
      \u0441\u0432\u0435\u0440\u044F\u044F\u0441\u044C \u0441 \u043D\u0435\u0431\u043E\u043C.
      \u0421\u0442\u0430\u0440\u0438\u043A \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0445\u043C\u044B\u043A\u043D\u0443\u043B \u0438 \u0442\u043A\u043D\u0443\u043B
      \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u0432 \u0442\u043E\u0447\u043A\u0443,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0432\u044B \u0435\u0434\u0432\u0430
      \u043D\u0435 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438:
      \xAB\u0412\u043E\u0442 \u044D\u0442\u0430 \u0437\u0432\u0435\u0437\u0434\u0430
      \u0443\u0432\u043E\u0434\u0438\u0442 \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432
      \u043D\u0430 \u044E\u0433, \u043A \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A\u0443.
      \u041D\u0435 \u0445\u043E\u0434\u0438 \u0442\u0443\u0434\u0430\xBB. \u041A
      \u0443\u0442\u0440\u0443 \u0443 \u0432\u0430\u0441 \u0431\u044B\u043B\u0430
      \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F \u043A\u0430\u0440\u0442\u0430
      \u043D\u043E\u0447\u043D\u043E\u0433\u043E \u043D\u0435\u0431\u0430 - \u0433\u0440\u0443\u0431\u0430\u044F,
      \u043D\u043E \u0432\u0435\u0440\u043D\u0430\u044F. \u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A \u0445\u043B\u043E\u043F\u043D\u0443\u043B
      \u0432\u0430\u0441 \u043F\u043E \u043F\u043B\u0435\u0447\u0443: \xAB\u0423
      \u0442\u0435\u0431\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432
      \u0433\u043B\u0430\u0437 - \u0432\u0441\u0451 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0448\u044C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866386
    m_Localized: "\u041B\u0438\u043D\u0438\u0438 \u043F\u0443\u0442\u0430\u043B\u0438\u0441\u044C,
      \u0437\u0432\u0451\u0437\u0434\u044B \u0434\u0432\u043E\u0438\u043B\u0438\u0441\u044C
      \u043E\u0442 \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u0438, \u0438
      \u0432 \u0438\u0442\u043E\u0433\u0435 \u0432\u0430\u0448\u0430 \u043A\u043E\u043F\u0438\u044F
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u043E\u0445\u043E\u0436\u0430 \u043D\u0430
      \u043A\u043B\u044F\u043A\u0441\u0443, \u0447\u0435\u043C \u043D\u0430 \u043A\u0430\u0440\u0442\u0443.
      \u0421\u0442\u0430\u0440\u0438\u043A \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B,
      \u043F\u043E\u043A\u0430\u0447\u0430\u043B \u0433\u043E\u043B\u043E\u0432\u043E\u0439
      \u0438 \u0437\u0430\u0431\u0440\u0430\u043B \u0441\u0432\u043E\u044E \u0431\u0443\u043C\u0430\u0433\u0443
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E. \u041D\u0435 \u0432\u0441\u0451
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E: \u0432\u044B \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438
      \u0445\u043E\u0442\u044F \u0431\u044B \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u043D\u0430 \u041F\u043E\u043B\u044F\u0440\u043D\u0443\u044E \u0437\u0432\u0435\u0437\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866387
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0440\u0430\u0441\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u043E \u0442\u0430\u0439\u043D\u044B\u0445 \u0442\u0440\u043E\u043F\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866388
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u043E\u0434\u0441\u0435\u043B
      \u043A \u0441\u0442\u0430\u0440\u0438\u043A\u0443 \u0438 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u043D\u0430 \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u043C: <npc_speech
      lang=\"Turkic\">\u0410\u0442\u0430, \u0442\u044B \u0445\u043E\u0440\u043E\u0448\u043E
      \u0437\u043D\u0430\u0435\u0448\u044C \u0437\u0432\u0451\u0437\u0434\u044B.
      \u0410 \u0447\u0442\u043E \u0441\u043A\u0430\u0436\u0435\u0448\u044C \u043E
      \u0442\u0440\u043E\u043F\u0430\u0445? \u0415\u0441\u0442\u044C \u043B\u0438
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u043F\u0443\u0442\u044C \u043C\u0438\u043C\u043E
      \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A\u0430?</npc_speech> \u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u043F\u043E\u0442\u0451\u043A: \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u043E \u0437\u0432\u0451\u0437\u0434\u0430\u0445, \u043F\u043E\u0442\u043E\u043C
      \u043E \u0434\u043E\u0440\u043E\u0433\u0430\u0445, \u043F\u043E\u0442\u043E\u043C
      \u043E \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u044F\u0445, \u0447\u0442\u043E
      \u0445\u043E\u0434\u0438\u043B\u0438 \u044D\u0442\u0438\u043C \u043F\u0443\u0442\u0451\u043C.
      \u0421\u0442\u0430\u0440\u0438\u043A \u043E\u0436\u0438\u0432\u0438\u043B\u0441\u044F,
      \u0434\u043E\u0441\u0442\u0430\u043B \u0432\u0442\u043E\u0440\u043E\u0439 \u0441\u0432\u0438\u0442\u043E\u043A
      (\u0437\u0430\u0442\u0451\u0440\u0442\u044B\u0439 \u0434\u043E \u0434\u044B\u0440,
      \u0441 \u043F\u043E\u043C\u0435\u0442\u043A\u0430\u043C\u0438 \u043D\u0430
      \u043F\u043E\u043B\u044F\u0445) \u0438 \u043F\u0440\u0438\u043D\u044F\u043B\u0441\u044F
      \u0447\u0435\u0440\u0442\u0438\u0442\u044C \u043F\u0430\u043B\u044C\u0446\u0435\u043C
      \u043F\u043E \u043F\u0435\u0441\u043A\u0443: \xAB\u0412\u043E\u0442 \u0442\u0443\u0442
      \u043A\u043E\u043B\u043E\u0434\u0435\u0446, \u0437\u0430\u0441\u044B\u043F\u0430\u043D
      \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443, \u043D\u043E
      \u0432\u043E\u0434\u0430 \u0435\u0441\u0442\u044C. \u0410 \u0442\u0443\u0442
      \u043E\u0431\u044A\u0435\u0437\u0434 \u043C\u0438\u043C\u043E \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A\u0430,
      \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442 \u0434\u0432\u0430 \u0434\u043D\u044F.
      \u0422\u0435\u0431\u0435 \u0441\u043A\u0430\u0436\u0443, \u043F\u043E\u0442\u043E\u043C\u0443
      \u0447\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C \u043A\u0430\u043A
      \u0441\u0432\u043E\u0439\xBB. \u041A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0437\u043D\u0430\u043B
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0434\u043E \u043C\u0435\u043B\u044C\u0447\u0430\u0439\u0448\u0438\u0445
      \u0434\u0435\u0442\u0430\u043B\u0435\u0439, \u0430 \u0441\u0442\u0430\u0440\u0438\u043A
      \u0443\u0435\u0445\u0430\u043B \u0441 \u0438\u043C\u0435\u043D\u0435\u043C
      \u0432\u0430\u0448\u0435\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u043D\u0430 \u0443\u0441\u0442\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866389
    m_Localized: "\u0421\u0431\u043E\u0440 \u0433\u043E\u0440\u043D\u044B\u0445 \u0442\u0440\u0430\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866390
    m_Localized: "\u041B\u0430\u0433\u0435\u0440\u044C \u0440\u0430\u0437\u0431\u0438\u0442
      \u043D\u0430 \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0439 \u0442\u0435\u0440\u0440\u0430\u0441\u0435,
      \u0433\u0434\u0435 \u0432\u0435\u0442\u0435\u0440 \u0447\u0443\u0442\u044C
      \u0442\u0438\u0448\u0435. \u041C\u0435\u0436\u0434\u0443 \u0432\u0430\u043B\u0443\u043D\u0430\u043C\u0438,
      \u0432 \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0430\u0445, \u043A\u0443\u0434\u0430
      \u0434\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u0441\u043E\u043B\u043D\u0446\u0435,
      \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0436\u0451\u0441\u0442\u043A\u0430\u044F
      \u0437\u0435\u043B\u0435\u043D\u044C: \u0433\u043E\u0440\u043D\u0430\u044F
      \u043F\u043E\u043B\u044B\u043D\u044C, \u0436\u0451\u043B\u0442\u044B\u0435
      \u0441\u043E\u0446\u0432\u0435\u0442\u0438\u044F \u0440\u043E\u0434\u0438\u043E\u043B\u044B,
      \u0442\u0451\u043C\u043D\u044B\u0435 \u043A\u0443\u0441\u0442\u0438\u043A\u0438
      \u043C\u043E\u0436\u0436\u0435\u0432\u0435\u043B\u044C\u043D\u0438\u043A\u0430.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432-\u0442\u0438\u0431\u0435\u0442\u0446\u0435\u0432
      \u043F\u0440\u0438\u0441\u0435\u043B \u0443 \u043A\u0430\u043C\u043D\u044F,
      \u0440\u0430\u0441\u0442\u0451\u0440 \u043B\u0438\u0441\u0442 \u043C\u0435\u0436\u0434\u0443
      \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438 \u0438 \u043F\u043E\u043D\u044E\u0445\u0430\u043B.
      \u041A\u0438\u0432\u043D\u0443\u043B: \u043B\u0435\u0447\u0435\u0431\u043D\u044B\u0435.
      \u041D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435 \u044D\u0442\u0438 \u0442\u0440\u0430\u0432\u044B
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0440\u0430\u0432\u043D\u0438\u043D\u043D\u044B\u0445:
      \u0432 \u043D\u0438\u0445 \u0431\u043E\u043B\u044C\u0448\u0435 \u0433\u043E\u0440\u0435\u0447\u0438
      \u0438 \u0436\u0438\u0437\u043D\u0438. \u041D\u043E \u0443\u0441\u0442\u0443\u043F
      \u043D\u0430\u0434 \u043B\u0430\u0433\u0435\u0440\u0435\u043C, \u0433\u0434\u0435
      \u0437\u0435\u043B\u0435\u043D\u0438 \u0433\u0443\u0449\u0435 \u0432\u0441\u0435\u0433\u043E,
      \u043A\u0440\u0443\u0442 \u0438 \u043D\u0435\u043D\u0430\u0434\u0451\u0436\u0435\u043D:
      \u043A\u0430\u043C\u043D\u0438 \u0443\u0445\u043E\u0434\u044F\u0442 \u0438\u0437-\u043F\u043E\u0434
      \u043D\u043E\u0433, \u0430 \u0432\u043D\u0438\u0437\u0443: \u043E\u0431\u0440\u044B\u0432
      \u0432 \u0434\u0432\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u0438\u0445
      \u0440\u043E\u0441\u0442\u0430.\r\n\r\n<npc_speech lang=\"Tibetan\">\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E,
      \u0433\u043E\u0441\u0442\u044C. \u042D\u0442\u043E \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u0442\u0440\u0430\u0432\u044B - \u043F\u0440\u0438 \u0445\u0432\u043E\u0440\u044F\u0445
      \u043E\u0447\u0435\u043D\u044C \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442.
      \u041D\u0430 \u043E\u0431\u0440\u044B\u0432 \u043D\u0435 \u0445\u043E\u0434\u0438,
      \u0442\u0430\u043C \u0437\u0435\u043C\u043B\u044F \u043D\u0435\u043D\u0430\u0434\u0451\u0436\u043D\u0430\u044F.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866391
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u0442\u0440\u0430\u0432\u044B
      \u0443 \u043B\u0430\u0433\u0435\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866392
    m_Localized: "\u041F\u043E\u043B\u0447\u0430\u0441\u0430 \u043D\u0435\u0441\u043F\u0435\u0448\u043D\u043E\u0439
      \u0440\u0430\u0431\u043E\u0442\u044B \u043C\u0435\u0436\u0434\u0443 \u043A\u0430\u043C\u043D\u044F\u043C\u0438,
      \u0438 \u0432 \u0440\u0443\u043A\u0430\u0445 \u043F\u0443\u0447\u043E\u043A
      \u043F\u043E\u043B\u044B\u043D\u0438 \u0438 \u0433\u043E\u0440\u0441\u0442\u044C
      \u043C\u043E\u0436\u0436\u0435\u0432\u0435\u043B\u043E\u0432\u044B\u0445 \u044F\u0433\u043E\u0434.
      \u041D\u0435\u043C\u043D\u043E\u0433\u043E, \u043D\u043E \u0445\u0432\u0430\u0442\u0438\u0442
      \u0437\u0430\u0432\u0430\u0440\u0438\u0442\u044C \u0433\u043E\u0440\u044C\u043A\u0438\u0439
      \u043E\u0442\u0432\u0430\u0440, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u043D\u0443\u044E
      \u0431\u043E\u043B\u044C \u043E\u0442 \u0432\u044B\u0441\u043E\u0442\u044B.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u044C\u044E\u0442,
      \u043C\u043E\u0440\u0449\u0430\u0442\u0441\u044F \u0438 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E
      \u043A\u0438\u0432\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866393
    m_Localized: "\u041F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F \u043D\u0430
      \u0443\u0441\u0442\u0443\u043F \u0437\u0430 \u0440\u043E\u0434\u0438\u043E\u043B\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866394
    m_Localized: "\u041F\u043E\u0434\u044A\u0451\u043C \u043F\u043E \u043E\u0441\u044B\u043F\u0438:
      \u0448\u0430\u0433, \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u043E\u043F\u043E\u0440\u044B,
      \u0435\u0449\u0451 \u0448\u0430\u0433. \u041A\u0430\u043C\u043D\u0438 \u0441\u043A\u0440\u0438\u043F\u044F\u0442,
      \u043D\u043E \u0434\u0435\u0440\u0436\u0430\u0442. \u041D\u0430\u0432\u0435\u0440\u0445\u0443:
      \u0446\u0435\u043B\u0430\u044F \u043F\u043E\u043B\u044F\u043D\u0430 \u0440\u043E\u0434\u0438\u043E\u043B\u044B,
      \u0437\u043E\u043B\u043E\u0442\u0438\u0441\u0442\u043E\u0439 \u0438 \u043F\u0430\u0445\u0443\u0447\u0435\u0439.
      \u0412\u044B \u043D\u0430\u0440\u0432\u0430\u043B\u0438 \u0441\u0442\u043E\u043B\u044C\u043A\u043E,
      \u0447\u0442\u043E \u0445\u0432\u0430\u0442\u0438\u0442 \u043D\u0430 \u043D\u0435\u0434\u0435\u043B\u044E
      \u043E\u0442\u0432\u0430\u0440\u043E\u0432 \u0438 \u043F\u0440\u0438\u043F\u0430\u0440\u043E\u043A.
      \u0421\u043F\u0443\u0441\u043A \u043F\u0440\u043E\u0448\u0451\u043B \u043F\u043E
      \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C \u0441\u043B\u0435\u0434\u0430\u043C,
      \u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u043C \u043D\u0430
      \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u044C. \u041B\u0430\u0433\u0435\u0440\u044C
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B \u0432\u0430\u0441 \u0437\u0430\u043F\u0430\u0445\u043E\u043C
      \u043A\u0438\u043F\u044F\u0449\u0435\u0433\u043E \u0447\u0430\u044F \u0441
      \u0433\u043E\u0440\u043D\u044B\u043C\u0438 \u0442\u0440\u0430\u0432\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866395
    m_Localized: "\u041D\u0430 \u043F\u043E\u043B\u043F\u0443\u0442\u0438 \u043A\u0430\u043C\u0435\u043D\u044C
      \u0443\u0448\u0451\u043B \u0438\u0437-\u043F\u043E\u0434 \u043D\u043E\u0433\u0438,
      \u0438 \u043E\u0441\u044B\u043F\u044C \u043F\u043E\u0435\u0445\u0430\u043B\u0430
      \u0432\u043D\u0438\u0437, \u0443\u0432\u043B\u0435\u043A\u0430\u044F \u0437\u0430
      \u0441\u043E\u0431\u043E\u0439 \u0432\u0441\u0451, \u0447\u0442\u043E \u043D\u0435
      \u0432\u0440\u043E\u0441\u043B\u043E \u0432 \u0441\u043A\u043B\u043E\u043D.
      \u0412\u044B \u0441\u043A\u0430\u0442\u0438\u043B\u0438\u0441\u044C, \u043E\u0431\u043E\u0434\u0440\u0430\u0432
      \u0440\u0443\u043A\u0438 \u0438 \u043A\u043E\u043B\u0435\u043D\u0438, \u0430
      \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439 \u043F\u043E\u0442\u043E\u043A
      \u0437\u0430\u0434\u0435\u043B \u043A\u0440\u0430\u0439 \u043F\u043E\u0432\u043E\u0437\u043A\u0438,
      \u0440\u0430\u0441\u0449\u0435\u043F\u0438\u0432 \u0431\u043E\u043A\u043E\u0432\u0443\u044E
      \u0434\u043E\u0441\u043A\u0443. \u0413\u043E\u0440\u0441\u0442\u044C \u043F\u043E\u043C\u044F\u0442\u043E\u0439
      \u0437\u0435\u043B\u0435\u043D\u0438 \u0432 \u0440\u0443\u043A\u0435 - \u0441\u043B\u0430\u0431\u043E\u0435
      \u0443\u0442\u0435\u0448\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866396
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0437\u043D\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866397
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u0431\u0432\u0451\u043B
      \u043B\u0430\u0433\u0435\u0440\u044C \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u043C
      \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C \u0438 \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F
      \u043D\u0435 \u0432\u0432\u0435\u0440\u0445, \u0430 \u0432\u043D\u0438\u0437,
      \u043A \u0440\u0443\u0447\u044C\u044E \u0437\u0430 \u0433\u0440\u044F\u0434\u043E\u0439
      \u043A\u0430\u043C\u043D\u0435\u0439. \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0441 \u043F\u043E\u043B\u043D\u043E\u0439
      \u0441\u0443\u043C\u043A\u043E\u0439: \u0440\u043E\u0434\u0438\u043E\u043B\u0430,
      \u0433\u043E\u0440\u0435\u0447\u0430\u0432\u043A\u0430, \u043F\u0443\u0447\u043A\u0438
      \u0441\u0443\u0448\u0451\u043D\u043E\u0439 \u043F\u043E\u043B\u044B\u043D\u0438,
      \u0438 \u0433\u043B\u0430\u0432\u043D\u043E\u0435: \u0431\u043B\u0435\u0434\u043D\u044B\u0439
      \u043C\u044F\u0441\u0438\u0441\u0442\u044B\u0439 \u043A\u043E\u0440\u0435\u043D\u044C,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043D \u0431\u0435\u0440\u0435\u0436\u043D\u043E
      \u0437\u0430\u0432\u0435\u0440\u043D\u0443\u043B \u0432 \u0442\u0440\u044F\u043F\u0438\u0446\u0443.
      \xAB\u0416\u0435\u043D\u044C\u0448\u044D\u043D\u044C, - \u0441\u043A\u0430\u0437\u0430\u043B
      \u043E\u043D. - \u0413\u043E\u0440\u043D\u044B\u0439. \u0420\u0435\u0434\u043A\u0438\u0439.
      \u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u0437\u0430 \u043D\u0435\u0433\u043E
      \u0434\u0430\u0434\u0443\u0442 \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C
      \u0437\u0430 \u0441\u0435\u0440\u0435\u0431\u0440\u043E, \u043D\u043E \u0435\u0441\u043B\u0438
      \u043A\u0442\u043E-\u0442\u043E \u0437\u0430\u0431\u043E\u043B\u0435\u0435\u0442,
      \u0446\u0435\u043D\u044B \u0435\u043C\u0443 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442
      \u0432\u043E\u0432\u0441\u0435.\xBB \u041B\u0430\u0433\u0435\u0440\u044C \u043F\u0430\u0445\u043D\u0435\u0442
      \u0442\u0440\u0430\u0432\u0430\u043C\u0438, \u0447\u0430\u0439 \u0433\u043E\u0440\u0447\u0438\u0442
      \u0438 \u0431\u043E\u0434\u0440\u0438\u0442, \u0430 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u043D\u0430 \u043B\u0435\u043A\u0430\u0440\u044F
      \u0441 \u0442\u0438\u0445\u0438\u043C \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866398
    m_Localized: "\u0413\u043E\u0440\u044F\u0447\u0438\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866399
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0441\u0435\u0440\u044B \u043F\u043E\u0447\u0443\u044F\u043B\u0438
      \u0435\u0449\u0451 \u0434\u043E \u043F\u0440\u0438\u0432\u0430\u043B\u0430:
      \u0442\u043E\u043D\u043A\u0438\u0439, \u0435\u0434\u043A\u0438\u0439, \u0442\u044F\u043D\u0443\u0449\u0438\u0439
      \u0438\u0437-\u0437\u0430 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0439
      \u0433\u0440\u044F\u0434\u044B. \u0417\u0430 \u0432\u0430\u043B\u0443\u043D\u0430\u043C\u0438
      \u043E\u0442\u043A\u0440\u044B\u043B\u0430\u0441\u044C \u043D\u0435\u0433\u043B\u0443\u0431\u043E\u043A\u0430\u044F
      \u043A\u0430\u043C\u0435\u043D\u043D\u0430\u044F \u0447\u0430\u0448\u0430,
      \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0434\u044B\u043C\u0438\u0442\u0441\u044F
      \u0437\u0435\u043B\u0435\u043D\u043E\u0432\u0430\u0442\u0430\u044F \u0432\u043E\u0434\u0430.
      \u0413\u043E\u0440\u044F\u0447\u0438\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A:
      \u0440\u0435\u0434\u043A\u0430\u044F \u0443\u0434\u0430\u0447\u0430 \u043D\u0430
      \u0432\u044B\u0441\u043E\u0442\u0435, \u0433\u0434\u0435 \u043D\u043E\u0447\u043D\u043E\u0439
      \u043C\u043E\u0440\u043E\u0437 \u043F\u0440\u043E\u0431\u0438\u0440\u0430\u0435\u0442
      \u0434\u043E \u043A\u043E\u0441\u0442\u0435\u0439. \u0412\u043E\u0434\u0430
      \u043E\u0431\u0436\u0438\u0433\u0430\u0435\u0442 \u043F\u0430\u043B\u044C\u0446\u044B,
      \u043D\u043E \u0447\u0435\u0440\u0435\u0437 \u043C\u0438\u043D\u0443\u0442\u0443
      \u0442\u0435\u043B\u043E \u043F\u0440\u0438\u0432\u044B\u043A\u0430\u0435\u0442,
      \u0438 \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C \u0443\u0445\u043E\u0434\u0438\u0442
      \u0438\u0437 \u043C\u044B\u0448\u0446, \u043A\u0430\u043A \u043F\u0435\u0441\u043E\u043A
      \u0441\u043A\u0432\u043E\u0437\u044C \u043F\u0430\u043B\u044C\u0446\u044B.
      \u0412\u043E\u043A\u0440\u0443\u0433 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430
      \u0432\u0438\u0434\u043D\u044B \u0441\u043B\u0435\u0434\u044B: \u043A\u0430\u043C\u043D\u0438
      \u0441\u043B\u043E\u0436\u0435\u043D\u044B \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E\u0439
      \u0441\u0442\u0435\u043D\u043A\u043E\u0439, \u0440\u044F\u0434\u043E\u043C
      \u043E\u0431\u0440\u044B\u0432\u043A\u0438 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u0445
      \u043C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u0445 \u0444\u043B\u0430\u0433\u043E\u0432.
      \u042D\u0442\u043E \u043C\u0435\u0441\u0442\u043E \u043A\u0442\u043E-\u0442\u043E
      \u043F\u043E\u0447\u0438\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774496866400
    m_Localized: "\u041E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C \u0443 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060608
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438
      \u043D\u0430\u0442\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0435 \u043D\u043E\u0433\u0438
      \u0432 \u0433\u043E\u0440\u044F\u0447\u0443\u044E \u0432\u043E\u0434\u0443.
      \u041A\u0442\u043E-\u0442\u043E \u0437\u0430\u0441\u0442\u043E\u043D\u0430\u043B
      \u043E\u0442 \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u044F,
      \u043A\u0442\u043E-\u0442\u043E \u0442\u0438\u0445\u043E \u0440\u0430\u0441\u0441\u043C\u0435\u044F\u043B\u0441\u044F,
      \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0437\u0430 \u043C\u043D\u043E\u0433\u043E
      \u0434\u043D\u0435\u0439. \u0422\u0435\u043F\u043B\u043E \u0440\u0430\u0437\u043E\u0448\u043B\u043E\u0441\u044C
      \u043F\u043E \u0442\u0435\u043B\u0443, \u0438 \u0434\u0430\u0436\u0435 \u043D\u043E\u0447\u043D\u043E\u0439
      \u0432\u0435\u0442\u0435\u0440 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043C\u044F\u0433\u0447\u0435. \u0423\u0442\u0440\u043E\u043C \u043B\u044E\u0434\u0438
      \u0434\u0432\u0438\u043D\u0443\u043B\u0438\u0441\u044C \u0432 \u043F\u0443\u0442\u044C
      \u0431\u043E\u0434\u0440\u0435\u0435, \u0447\u0435\u043C \u043D\u0430\u043A\u0430\u043D\u0443\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060609
    m_Localized: "\u041F\u043E\u0434\u043D\u044F\u0442\u044C \u0431\u043E\u0435\u0432\u043E\u0439
      \u0434\u0443\u0445 \u0440\u0435\u0447\u044C\u044E \u0443 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060610
    m_Localized: "\u0412\u044B \u0441\u043E\u0431\u0440\u0430\u043B\u0438 \u043B\u044E\u0434\u0435\u0439
      \u0443 \u0432\u043E\u0434\u044B, \u043A\u043E\u0433\u0434\u0430 \u043F\u0430\u0440
      \u043E\u043A\u0443\u0442\u0430\u043B \u043B\u0430\u0433\u0435\u0440\u044C \u0432
      \u0441\u0443\u043C\u0435\u0440\u043A\u0430\u0445. \u0417\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438
      \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0433\u043E\u0440\u044B \u0441\u0443\u0440\u043E\u0432\u044B,
      \u043D\u043E \u0449\u0435\u0434\u0440\u044B \u043A \u0442\u0435\u043C, \u043A\u0442\u043E
      \u043D\u0435 \u0441\u0434\u0430\u0451\u0442\u0441\u044F. \u041E \u0442\u0451\u043F\u043B\u044B\u0445
      \u0440\u044B\u043D\u043A\u0430\u0445 \u041A\u0430\u0448\u0433\u0430\u0440\u0430
      \u0438 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430, \u0447\u0442\u043E
      \u0436\u0434\u0443\u0442 \u043D\u0430 \u0442\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u043E\u0432. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A-\u0442\u0438\u0431\u0435\u0442\u0435\u0446
      \u043A\u0438\u0432\u043D\u0443\u043B \u0438 \u0434\u043E\u0431\u0430\u0432\u0438\u043B:
      \xAB\u041A\u0442\u043E \u043D\u0430\u0448\u0451\u043B \u0433\u043E\u0440\u044F\u0447\u0443\u044E
      \u0432\u043E\u0434\u0443 \u0432 \u0433\u043E\u0440\u0430\u0445 - \u0442\u043E\u0433\u043E
      \u0433\u043E\u0440\u044B \u0432\u0435\u0434\u0443\u0442\xBB. \u041B\u044E\u0434\u0438
      \u0432\u044B\u043F\u0440\u044F\u043C\u0438\u043B\u0438 \u0441\u043F\u0438\u043D\u044B.
      \u0414\u0430\u0436\u0435 \u044F\u043A\u0438, \u043A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u0432\u0441\u0442\u0430\u043B\u0438 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060611
    m_Localized: "\u0421\u043B\u043E\u0432\u0430 \u0432\u044B\u0448\u043B\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0435,
      \u043D\u043E \u0433\u043E\u043B\u043E\u0441 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0441\u044F
      \u0432 \u0441\u0432\u0438\u0441\u0442\u0435 \u0432\u0435\u0442\u0440\u0430.
      \u041B\u044E\u0434\u0438 \u0441\u043B\u0443\u0448\u0430\u043B\u0438 \u0432\u0435\u0436\u043B\u0438\u0432\u043E,
      \u0433\u0440\u0435\u043B\u0438 \u0440\u0443\u043A\u0438 \u043D\u0430\u0434
      \u043F\u0430\u0440\u043E\u043C \u0438 \u043A\u0438\u0432\u0430\u043B\u0438,
      \u043D\u043E \u0433\u043B\u0430\u0437\u0430 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u0443\u0441\u0442\u0430\u043B\u044B\u043C\u0438. \u0413\u043E\u0440\u044F\u0447\u0430\u044F
      \u0432\u043E\u0434\u0430 \u043F\u043E\u043C\u043E\u0433\u043B\u0430 \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0440\u0435\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060612
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u0446\u0435\u043B\u0435\u0431\u043D\u044B\u0435 \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060613
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043E\u043F\u0443\u0441\u0442\u0438\u043B
      \u0440\u0443\u043A\u0443 \u0432 \u0432\u043E\u0434\u0443, \u043F\u043E\u043D\u044E\u0445\u0430\u043B
      \u043F\u0430\u043B\u044C\u0446\u044B \u0438 \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0445\u043C\u044B\u043A\u043D\u0443\u043B. \xAB\u0421\u0435\u0440\u043D\u044B\u0439
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A. \u0422\u0438\u0431\u0435\u0442\u0446\u044B
      \u0437\u043E\u0432\u0443\u0442 \u0435\u0433\u043E \u0446\u0445\u0430-\u0447\u0445\u0443
      (\u0433\u043E\u0440\u044F\u0447\u0430\u044F \u0432\u043E\u0434\u0430). \u0415\u0441\u043B\u0438
      \u0437\u0430\u043C\u043E\u0447\u0438\u0442\u044C \u0432 \u043D\u0451\u043C
      \u0442\u0440\u044F\u043F\u043A\u0438 \u0438 \u043E\u0431\u0435\u0440\u043D\u0443\u0442\u044C
      \u0441\u0443\u0441\u0442\u0430\u0432\u044B - \u0431\u043E\u043B\u044C \u0443\u0439\u0434\u0451\u0442
      \u043D\u0430 \u0442\u0440\u0438 \u0434\u043D\u044F. \u0410 \u0435\u0441\u043B\u0438
      \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0432\u043E\u0442 \u044D\u0442\u0438\u0445
      \u043A\u0430\u043C\u043D\u0435\u0439 (\u043E\u043D \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043B
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0431\u0435\u043B\u0451\u0441\u044B\u0445
      \u043E\u0431\u043B\u043E\u043C\u043A\u043E\u0432 \u0441 \u043A\u0440\u0430\u044F
      \u0447\u0430\u0448\u0438), \u0432\u043E\u0434\u0430 \u0441\u0442\u0430\u043D\u0435\u0442
      \u043F\u0440\u0438\u0433\u043E\u0434\u043D\u043E\u0439 \u0434\u043B\u044F \u043F\u0438\u0442\u044C\u044F.
      \u041C\u0438\u043D\u0435\u0440\u0430\u043B, \u043D\u0435 \u044F\u0434.\xBB
      \u041A \u043D\u043E\u0447\u0438 \u0432\u0435\u0441\u044C \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043E\u0442\u043C\u043E\u043A, \u0441\u0443\u0441\u0442\u0430\u0432\u044B
      \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043D\u044B \u0442\u0451\u043F\u043B\u044B\u043C\u0438
      \u043A\u043E\u043C\u043F\u0440\u0435\u0441\u0441\u0430\u043C\u0438, \u0430
      \u0431\u0443\u0440\u0434\u044E\u043A\u0438 \u043F\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u044B
      \u0442\u0451\u043F\u043B\u043E\u0439 \u043C\u0438\u043D\u0435\u0440\u0430\u043B\u044C\u043D\u043E\u0439
      \u0432\u043E\u0434\u043E\u0439. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u043D\u0430\u0443\u0447\u0438\u043B \u0434\u0432\u0443\u0445 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u043C\u0443 \u0441\u043B\u043E\u0432\u0443
      \xAB\u0446\u0445\u0430-\u0447\u0445\u0443\xBB, \u0438 \u0442\u0435 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u043B\u0438
      \u0435\u0433\u043E, \u0441\u043C\u0435\u044F\u0441\u044C, \u0434\u043E \u0441\u0430\u043C\u043E\u0433\u043E
      \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060614
    m_Localized: "\u041F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      \u043E \u043B\u0430\u0432\u0438\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060615
    m_Localized: "\u041D\u043E\u0447\u044C. \u041B\u0430\u0433\u0435\u0440\u044C
      \u043F\u0440\u0438\u0436\u0430\u043B\u0441\u044F \u043A \u0441\u043A\u0430\u043B\u044C\u043D\u043E\u043C\u0443
      \u0432\u044B\u0441\u0442\u0443\u043F\u0443 \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430. \u0421\u043D\u0435\u0433
      \u0438\u0434\u0451\u0442 \u0442\u0440\u0435\u0442\u0438\u0439 \u0447\u0430\u0441.
      \u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0443 \u043A\u043E\u0441\u0442\u0440\u0430 \u0432\u0434\u0440\u0443\u0433
      \u0437\u0430\u043C\u0435\u0440, \u043F\u0440\u0438\u0436\u0430\u043B \u0443\u0445\u043E
      \u043A \u043A\u0430\u043C\u043D\u044E: \u043B\u0438\u0446\u043E \u043F\u043E\u0431\u0435\u043B\u0435\u043B\u043E.
      \u041D\u0430\u0434 \u043B\u0430\u0433\u0435\u0440\u0435\u043C \u0447\u0442\u043E-\u0442\u043E
      \u0441\u0434\u0432\u0438\u043D\u0443\u043B\u043E\u0441\u044C: \u0433\u043B\u0443\u0445\u043E\u0439
      \u0433\u0443\u043B, \u0438 \u043C\u0435\u043B\u043A\u0430\u044F \u0441\u043D\u0435\u0436\u043D\u0430\u044F
      \u043F\u044B\u043B\u044C \u043F\u043E\u0441\u044B\u043F\u0430\u043B\u0430\u0441\u044C
      \u0441 \u043A\u043E\u0437\u044B\u0440\u044C\u043A\u0430 \u0441\u043A\u0430\u043B\u044B.
      \u041E\u043D \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0438
      \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B \u0431\u044B\u0441\u0442\u0440\u043E,
      \u043E\u0442\u0440\u044B\u0432\u0438\u0441\u0442\u043E:\r\n\r\n<npc_speech
      lang=\"Tibetan\">\u0421\u043B\u0443\u0448\u0430\u0439\u0442\u0435! \u0421 \u0432\u0435\u0440\u0448\u0438\u043D\u044B
      \u0441\u0445\u043E\u0434\u0438\u0442 \u0441\u043D\u0435\u0433! \u0414\u0432\u0438\u0433\u0430\u0439\u0442\u0435
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 - \u0441\u0435\u0439\u0447\u0430\u0441!
      \u041D\u0435 \u043C\u0435\u0434\u043B\u0438\u0442\u0435!</npc_speech>\r\n\r\n\u0414\u0430\u0436\u0435
      \u0431\u0435\u0437 \u0437\u043D\u0430\u043D\u0438\u044F \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u0433\u043E
      \u043F\u043E\u043D\u044F\u0442\u043D\u043E: \u043E\u043D \u0432 \u0443\u0436\u0430\u0441\u0435.
      \u041B\u0430\u0432\u0438\u043D\u0430 \u043C\u043E\u0436\u0435\u0442 \u0441\u043E\u0439\u0442\u0438
      \u0447\u0435\u0440\u0435\u0437 \u043C\u0438\u043D\u0443\u0442\u0443, \u0430
      \u043C\u043E\u0436\u0435\u0442 \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441.
      \u041D\u043E \u0435\u0441\u043B\u0438 \u0441\u043E\u0439\u0434\u0451\u0442
      \u043D\u0430 \u043B\u0430\u0433\u0435\u0440\u044C - \u043E\u0442 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u043D\u0438\u0447\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060616
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u043E \u0441\u0442\u044F\u043D\u0443\u0442\u044C
      \u043B\u0430\u0433\u0435\u0440\u044C \u043A \u0441\u043A\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060617
    m_Localized: "\u041A\u0440\u0438\u043A\u0438, \u043C\u0430\u0442\u0435\u0440\u043D\u0430\u044F
      \u0440\u0443\u0433\u0430\u043D\u044C \u043D\u0430 \u0442\u0440\u0451\u0445
      \u044F\u0437\u044B\u043A\u0430\u0445, \u0441\u043A\u0440\u0438\u043F \u043F\u043E\u043B\u043E\u0437\u044C\u0435\u0432
      \u043F\u043E \u043C\u043E\u043A\u0440\u043E\u043C\u0443 \u043A\u0430\u043C\u043D\u044E.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0438 \u043E\u0442\u0442\u0430\u0449\u0438\u043B\u0438
      \u0432\u043F\u043B\u043E\u0442\u043D\u0443\u044E \u043A \u0441\u043A\u0430\u043B\u044C\u043D\u043E\u043C\u0443
      \u0432\u044B\u0441\u0442\u0443\u043F\u0443: \u0435\u0441\u043B\u0438 \u043B\u0430\u0432\u0438\u043D\u0430
      \u043F\u043E\u0439\u0434\u0451\u0442, \u043E\u0441\u043D\u043E\u0432\u043D\u0430\u044F
      \u043C\u0430\u0441\u0441\u0430 \u0441\u043D\u0435\u0433\u0430 \u043F\u0440\u043E\u043B\u0435\u0442\u0438\u0442
      \u043C\u0438\u043C\u043E. \u0415\u0441\u043B\u0438. \u041D\u043E\u0447\u044C
      \u043F\u0440\u043E\u0448\u043B\u0430 \u0431\u0435\u0437 \u0441\u043D\u0430,
      \u0432 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0438 \u0443\u0434\u0430\u0440\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043C\u043E\u0436\u0435\u0442 \u043F\u0440\u0438\u0439\u0442\u0438
      \u043A\u0430\u0436\u0434\u0443\u044E \u0441\u0435\u043A\u0443\u043D\u0434\u0443.
      \u041A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443 \u0441\u043D\u0435\u0433
      \u0441\u0442\u0438\u0445, \u043D\u043E \u043D\u0435\u0440\u0432\u044B \u0438\u0441\u0442\u0440\u0451\u043F\u0430\u043D\u044B,
      \u0430 \u043E\u0434\u043D\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043F\u043E\u043C\u044F\u0442\u0430 - \u0432\u043F\u043E\u043F\u044B\u0445\u0430\u0445
      \u0435\u0451 \u043F\u0440\u0438\u043B\u043E\u0436\u0438\u043B\u0438 \u043E
      \u043A\u0430\u043C\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060618
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u0430\u0442\u044C \u0441\u043A\u043B\u043E\u043D
      \u0438 \u043E\u0446\u0435\u043D\u0438\u0442\u044C \u0443\u0433\u0440\u043E\u0437\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060619
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u043D\u044F\u043B\u0438\u0441\u044C
      \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443 \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435,
      \u0443\u0442\u043E\u043F\u0430\u044F \u0432 \u0441\u043D\u0435\u0433\u0443
      \u043F\u043E \u043A\u043E\u043B\u0435\u043D\u043E. \u0424\u043E\u043D\u0430\u0440\u044C
      \u0432\u044B\u0445\u0432\u0430\u0442\u0438\u043B \u0438\u0437 \u043C\u0440\u0430\u043A\u0430
      \u043A\u043E\u0437\u044B\u0440\u0451\u043A \u043A\u0430\u0440\u043D\u0438\u0437\u0430
      - \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u0439, \u043D\u043E \u0435\u0449\u0451
      \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F. \u0422\u0440\u0435\u0449\u0438\u043D\u0430
      \u0448\u043B\u0430 \u043F\u0440\u0430\u0432\u0435\u0435, \u043D\u0435 \u043D\u0430\u0434
      \u043B\u0430\u0433\u0435\u0440\u0435\u043C. \u0412\u044B \u0432\u0431\u0438\u043B\u0438
      \u0434\u0432\u0430 \u043A\u043E\u043B\u044B\u0448\u043A\u0430, \u043D\u0430\u0442\u044F\u043D\u0443\u043B\u0438
      \u0432\u0435\u0440\u0451\u0432\u043A\u0443-\u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440
      \u0438 \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0438\u0441\u044C. \xAB\u0421\u043D\u043E\u0441\u0438\u0442
      \u043F\u0440\u0430\u0432\u0435\u0435. \u0415\u0441\u043B\u0438 \u043B\u044F\u0436\u0435\u043C
      \u043B\u0435\u0432\u0435\u0435 \u0441\u043A\u0430\u043B\u044B, \u043F\u0440\u043E\u043D\u0435\u0441\u0451\u0442.\xBB
      \u041B\u0430\u0433\u0435\u0440\u044C \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u043B\u0438
      \u0437\u0430 \u043F\u043E\u043B\u0447\u0430\u0441\u0430. \u041F\u043E\u0434
      \u0443\u0442\u0440\u043E \u043B\u0430\u0432\u0438\u043D\u0430 \u0441\u043E\u0448\u043B\u0430
      \u0442\u0443\u0434\u0430, \u0433\u0434\u0435 \u0435\u0449\u0451 \u0447\u0430\u0441
      \u043D\u0430\u0437\u0430\u0434 \u0441\u0442\u043E\u044F\u043B\u0438 \u043F\u043E\u0432\u043E\u0437\u043A\u0438.
      \u041B\u044E\u0434\u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u043D\u0430
      \u0431\u0435\u043B\u044B\u0439 \u0432\u0430\u043B, \u0437\u0430\u0441\u044B\u043F\u0430\u0432\u0448\u0438\u0439
      \u0438\u0445 \u0441\u0442\u0430\u0440\u0443\u044E \u0441\u0442\u043E\u044F\u043D\u043A\u0443,
      \u0438 \u043C\u043E\u043B\u0447\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060620
    m_Localized: "\u0421\u043A\u043B\u043E\u043D \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043A\u0440\u0443\u0447\u0435, \u0447\u0435\u043C \u0434\u0443\u043C\u0430\u043B\u043E\u0441\u044C.
      \u041D\u0430 \u043F\u043E\u043B\u043F\u0443\u0442\u0438 \u0441\u043D\u0435\u0436\u043D\u044B\u0439
      \u043F\u043B\u0430\u0441\u0442 \u043F\u043E\u0435\u0445\u0430\u043B \u043F\u043E\u0434
      \u043D\u043E\u0433\u0430\u043C\u0438: \u043D\u0435 \u043B\u0430\u0432\u0438\u043D\u0430,
      \u043D\u043E \u043E\u043F\u043E\u043B\u0437\u0435\u043D\u044C, \u0442\u044F\u0436\u0451\u043B\u044B\u0439
      \u0438 \u0431\u044B\u0441\u0442\u0440\u044B\u0439. \u0412\u044B \u0441\u043A\u0430\u0442\u0438\u043B\u0438\u0441\u044C
      \u0432\u043D\u0438\u0437, \u0443\u0432\u043B\u0435\u043A\u0430\u044F \u0437\u0430
      \u0441\u043E\u0431\u043E\u0439 \u043A\u0430\u043C\u043D\u0438 \u0438 \u043C\u043E\u043A\u0440\u044B\u0439
      \u0441\u043D\u0435\u0433. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A,
      \u0441\u0442\u0440\u0430\u0445\u043E\u0432\u0430\u0432\u0448\u0438\u0439 \u0441\u043D\u0438\u0437\u0443,
      \u043F\u043E\u043F\u0430\u043B \u043F\u043E\u0434 \u0443\u0434\u0430\u0440
      - \u0435\u0433\u043E \u043F\u0440\u0438\u0434\u0430\u0432\u0438\u043B\u043E
      \u0441\u043D\u0435\u0436\u043D\u044B\u043C \u044F\u0437\u044B\u043A\u043E\u043C,
      \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438 \u0441 \u0442\u0440\u0443\u0434\u043E\u043C,
      \u0440\u0443\u043A\u0430 \u0432\u044B\u0432\u0435\u0440\u043D\u0443\u0442\u0430.
      \u0423\u0433\u0440\u043E\u0437\u0443 \u0442\u0430\u043A \u0438 \u043D\u0435
      \u043E\u0446\u0435\u043D\u0438\u043B\u0438, \u043D\u043E\u0447\u044C \u043F\u0440\u043E\u0448\u043B\u0430
      \u0432 \u0441\u0442\u0440\u0430\u0445\u0435, \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u043F\u043E\u0434\u043C\u043E\u043A\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060621
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0443\u0435\u0442
      \u044D\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060622
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043D\u0435 \u0441\u0442\u0430\u043B
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044C\u0441\u044F, \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F
      \u0442\u0440\u0435\u0432\u043E\u0433\u0430 \u0438\u043B\u0438 \u043B\u043E\u0436\u043D\u0430\u044F.
      \u041E\u043D \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u043B.
      \u0422\u0440\u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0445 \u0441\u0432\u0438\u0441\u0442\u043A\u0430
      - \u0441\u0438\u0433\u043D\u0430\u043B, \u043E\u0442\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u044B\u0439
      \u0441 \u043F\u0435\u0440\u0432\u043E\u0439 \u043D\u0435\u0434\u0435\u043B\u0438
      \u043F\u0443\u0442\u0438. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0432\u0441\u043A\u043E\u0447\u0438\u043B\u0438, \u044F\u043A\u043E\u0432
      \u043F\u043E\u0434\u043D\u044F\u043B\u0438 \u043F\u0438\u043D\u043A\u0430\u043C\u0438,
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043F\u043E\u043A\u0430\u0442\u0438\u043B\u0438
      \u0432\u043D\u0438\u0437 \u043F\u043E \u0442\u0440\u043E\u043F\u0435: \u043F\u0440\u043E\u0447\u044C
      \u043E\u0442 \u0441\u043A\u0430\u043B\u044B, \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0435
      \u043F\u043B\u0430\u0442\u043E, \u0433\u0434\u0435 \u043B\u0430\u0432\u0438\u043D\u0435
      \u043D\u0435 \u0437\u0430 \u0447\u0442\u043E \u0437\u0430\u0446\u0435\u043F\u0438\u0442\u044C\u0441\u044F.
      \u0420\u0430\u0431\u043E\u0442\u0430\u043B\u0438 \u043C\u043E\u043B\u0447\u0430,
      \u0431\u044B\u0441\u0442\u0440\u043E, \u0432 \u043E\u0434\u043D\u0438\u0445
      \u043F\u043E\u0434\u0448\u0442\u0430\u043D\u043D\u0438\u043A\u0430\u0445 \u0438
      \u043E\u0432\u0447\u0438\u043D\u0430\u0445. \u0427\u0430\u0441\u0442\u044C
      \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u0431\u0440\u043E\u0441\u0438\u043B\u0438:
      \u043D\u0435 \u0434\u043E \u043D\u0438\u0445. \u0427\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441 \u043B\u0430\u0433\u0435\u0440\u044C \u0441\u0442\u043E\u044F\u043B
      \u043D\u0430 \u0440\u043E\u0432\u043D\u043E\u043C \u043C\u0435\u0441\u0442\u0435
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u043E\u0442 \u0441\u043A\u043B\u043E\u043D\u0430.
      \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u043B
      \u0434\u043E\u0437\u043E\u0440\u044B \u0438 \u043B\u0451\u0433 \u0441\u043F\u0430\u0442\u044C
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C. \u041F\u043E\u0434
      \u0443\u0442\u0440\u043E \u0441\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u044B
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430 \u0434\u043E\u043D\u0451\u0441\u0441\u044F
      \u0433\u043B\u0443\u0445\u043E\u0439 \u0443\u0434\u0430\u0440: \u0441\u043D\u0435\u0436\u043D\u044B\u0439
      \u043A\u0430\u0440\u043D\u0438\u0437 \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0441\u044F
      \u0442\u0443\u0434\u0430, \u0433\u0434\u0435 \u0435\u0449\u0451 \u043D\u0435\u0434\u0430\u0432\u043D\u043E
      \u0433\u043E\u0440\u0435\u043B \u043A\u043E\u0441\u0442\u0451\u0440. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043C\u043E\u043B\u0447\u0430 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
      \u043D\u0430 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430. \u0422\u043E\u0442
      \u043F\u043E\u0436\u0430\u043B \u043F\u043B\u0435\u0447\u0430\u043C\u0438:
      \xAB\u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E \u044F \u0437\u0434\u0435\u0441\u044C\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060623
    m_Localized: "\u041E\u0433\u043D\u0438 \u0434\u0436\u0438\u043D\u043D\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060624
    m_Localized: "\u0413\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u043D\u043E\u0447\u044C\u044E
      \u043D\u0430\u0434 \u0431\u0430\u0440\u0445\u0430\u043D\u0430\u043C\u0438 \u0437\u0430\u0433\u043E\u0440\u0430\u044E\u0442\u0441\u044F
      \u0431\u043B\u0435\u0434\u043D\u043E-\u0437\u0435\u043B\u0451\u043D\u044B\u0435
      \u043E\u0433\u043E\u043D\u044C\u043A\u0438: \u0442\u0440\u0438, \u043F\u044F\u0442\u044C,
      \u0434\u0435\u0441\u044F\u0442\u043E\u043A. \u041E\u043D\u0438 \u043F\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F,
      \u0431\u0443\u0434\u0442\u043E \u0434\u044B\u0448\u0430\u0442, \u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043F\u043B\u044B\u0432\u0443\u0442 \u0432\u0433\u043B\u0443\u0431\u044C \u043F\u0443\u0441\u0442\u044B\u043D\u0438,
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u0437\u0430 \u0441\u043E\u0431\u043E\u0439
      \u0441\u043B\u0430\u0431\u044B\u0439 \u0441\u0435\u0440\u043D\u044B\u0439 \u0437\u0430\u043F\u0430\u0445.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u0437\u0430\u043C\u0435\u0440\u043B\u0438
      \u0443 \u043F\u043E\u0442\u0443\u0445\u0448\u0435\u0433\u043E \u043A\u043E\u0441\u0442\u0440\u0430.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0447\u0438\u043A
      \u0441\u0436\u0438\u043C\u0430\u0435\u0442 \u0430\u043C\u0443\u043B\u0435\u0442
      \u043D\u0430 \u0448\u0435\u0435 \u0438 \u0448\u0435\u043F\u0447\u0435\u0442,
      \u0447\u0442\u043E \u044D\u0442\u043E \u0444\u043E\u043D\u0430\u0440\u0438
      \u0434\u0436\u0438\u043D\u043D\u043E\u0432 - \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u0445
      \u0434\u0443\u0445\u043E\u0432, \u0437\u0430\u043C\u0430\u043D\u0438\u0432\u0430\u044E\u0449\u0438\u0445
      \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432 \u0432 \u0431\u0435\u0437\u0432\u043E\u0434\u043D\u044B\u0435
      \u043F\u0435\u0441\u043A\u0438. \u041D\u043E \u043E\u0434\u0438\u043D \u0438\u0437
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432-\u0431\u0435\u0434\u0443\u0438\u043D\u043E\u0432
      \u043A\u0430\u0447\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u043E\u0439:\r\n\r\n<npc_speech
      lang=\"Arabic\">\u041D\u0435 \u0431\u043E\u0439\u0441\u044F, \u043F\u0443\u0442\u043D\u0438\u043A.
      \u042D\u0442\u043E \u043E\u0433\u043E\u043D\u044C \u0437\u0435\u043C\u043B\u0438
      - \u0433\u0430\u0437 \u0438\u0437-\u043F\u043E\u0434 \u043F\u0435\u0441\u043A\u043E\u0432.
      \u041D\u043E \u0438 \u0434\u0436\u0438\u043D\u043D\u044B \u0442\u043E\u0436\u0435
      \u043E\u0431\u0438\u0442\u0430\u044E\u0442 \u0432 \u044D\u0442\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435. \u041A\u0442\u043E \u0437\u043D\u0430\u0435\u0442?</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060625
    m_Localized: "\u041D\u0435 \u0442\u0440\u043E\u0433\u0430\u0442\u044C \u043E\u0433\u043D\u0438,
      \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060626
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0437\u0430\u0442\u0430\u0438\u043B\u0441\u044F.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u043F\u0430\u043B: \u043B\u044E\u0434\u0438
      \u0441\u0438\u0434\u0435\u043B\u0438 \u0441\u043F\u0438\u043D\u043E\u0439 \u043A
      \u043E\u0433\u043D\u044F\u043C, \u0437\u0430\u043A\u0440\u044B\u0432 \u043B\u0438\u0446\u0430
      \u0442\u043A\u0430\u043D\u044C\u044E, \u0431\u043E\u0440\u043C\u043E\u0447\u0430
      \u043C\u043E\u043B\u0438\u0442\u0432\u044B. \u041A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443
      \u0437\u0435\u043B\u0451\u043D\u044B\u0435 \u0442\u043E\u0447\u043A\u0438 \u043F\u043E\u0433\u0430\u0441\u043B\u0438
      \u043E\u0434\u043D\u0430 \u0437\u0430 \u0434\u0440\u0443\u0433\u043E\u0439,
      \u043A\u0430\u043A \u0441\u0432\u0435\u0447\u0438 \u043D\u0430 \u0432\u0435\u0442\u0440\u0443.
      \u041F\u0435\u0441\u043E\u043A \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
      \u043E\u0433\u043D\u0435\u0439 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0442\u0451\u043F\u043B\u044B\u043C \u043D\u0430 \u043E\u0449\u0443\u043F\u044C
      \u0438 \u043F\u0430\u0445 \u0441\u0435\u0440\u043E\u0439. \u0423\u0442\u0440\u043E\u043C
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0432 \u043E\u0431\u0445\u043E\u0434, \u043F\u043E\u0442\u0435\u0440\u044F\u0432
      \u043F\u043E\u043B\u0434\u043D\u044F, \u043D\u043E \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u0432
      \u043D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.
      \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0435:
      \u0441\u0442\u0430\u0440\u044B\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0447\u0438\u043A
      \u0442\u0432\u0435\u0440\u0434\u0438\u0442, \u0447\u0442\u043E \u0434\u0436\u0438\u043D\u043D\u044B
      \u0432\u0435\u0440\u043D\u0443\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060627
    m_Localized: "\u041F\u043E\u0434\u043E\u0439\u0442\u0438 \u043A \u043E\u0433\u043D\u044F\u043C
      \u0438 \u043E\u0431\u0440\u0430\u0442\u0438\u0442\u044C\u0441\u044F \u043A
      \u0434\u0443\u0445\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060628
    m_Localized: "\u0412\u044B \u0432\u0441\u0442\u0430\u043B\u0438, \u043E\u0442\u0440\u044F\u0445\u043D\u0443\u043B\u0438
      \u043F\u0435\u0441\u043E\u043A \u0441 \u043A\u043E\u043B\u0435\u043D \u0438
      \u043F\u043E\u0448\u043B\u0438 \u043A \u043E\u0433\u043D\u044F\u043C. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u0432\u0430\u043C \u0432\u0441\u043B\u0435\u0434,
      \u043A\u0430\u043A \u043D\u0430 \u043C\u0435\u0440\u0442\u0432\u0435\u0446\u0430.
      \u0423 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F \u0431\u0430\u0440\u0445\u0430\u043D\u0430
      \u043E\u0433\u043D\u0438 \u0437\u0430\u043A\u0440\u0443\u0436\u0438\u043B\u0438\u0441\u044C,
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0438 \u044F\u0440\u0447\u0435,
      \u0438 \u043F\u043E\u0433\u0430\u0441\u043B\u0438. \u041D\u0430 \u0433\u0440\u0435\u0431\u043D\u0435
      \u0434\u044E\u043D\u044B, \u0432 \u043B\u0443\u043D\u043A\u0435 \u043F\u0435\u0441\u043A\u0430,
      \u043B\u0435\u0436\u0430\u043B \u0441\u0432\u0451\u0440\u0442\u043E\u043A \u043F\u0430\u043B\u044C\u043C\u043E\u0432\u044B\u0445
      \u043B\u0438\u0441\u0442\u044C\u0435\u0432. \u0412\u043D\u0443\u0442\u0440\u0438
      - \u043A\u043E\u043C\u043E\u043A \u0431\u0435\u043B\u043E\u0433\u043E \u043B\u0430\u0434\u0430\u043D\u0430,
      \u043F\u043B\u043E\u0442\u043D\u043E\u0433\u043E \u0438 \u0430\u0440\u043E\u043C\u0430\u0442\u043D\u043E\u0433\u043E.
      \u0421\u0442\u0430\u0440\u0438\u043A\u0438 \u043F\u043E\u0442\u043E\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438,
      \u0447\u0442\u043E \u0434\u0436\u0438\u043D\u043D \u043F\u0440\u0438\u043D\u044F\u043B
      \u0434\u0430\u0440 \u0437\u0430 \u0445\u0440\u0430\u0431\u0440\u043E\u0441\u0442\u044C.
      \u0411\u0435\u0434\u0443\u0438\u043D \u0443\u0441\u043C\u0435\u0445\u043D\u0443\u043B\u0441\u044F:
      \xAB\u0422\u0443\u0442 \u0432\u0447\u0435\u0440\u0430 \u043F\u0440\u043E\u0448\u0451\u043B
      \u043B\u0430\u0434\u0430\u043D\u043D\u044B\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D.
      \u0423\u0440\u043E\u043D\u0438\u043B\u0438. \u0410 \u0433\u0430\u0437 - \u043E\u043D
      \u0433\u0430\u0437 \u0438 \u0435\u0441\u0442\u044C\xBB. \u0418\u0441\u0442\u0438\u043D\u0430
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0432 \u043F\u0435\u0441\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060629
    m_Localized: "\u0412\u044B \u0448\u0430\u0433\u043D\u0443\u043B\u0438 \u043A
      \u043E\u0433\u043D\u044F\u043C - \u0438 \u0437\u0435\u043C\u043B\u044F \u043F\u043E\u0434
      \u043D\u043E\u0433\u0430\u043C\u0438 \u043F\u0440\u043E\u0441\u0435\u043B\u0430.
      \u0420\u044B\u0445\u043B\u044B\u0439 \u043F\u0435\u0441\u043E\u043A \u043F\u043E\u0442\u044F\u043D\u0443\u043B
      \u0432\u043D\u0438\u0437, \u043A\u0430\u043A \u0442\u0440\u044F\u0441\u0438\u043D\u0430.
      \u041F\u043E\u043A\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0442\u0430\u0449\u0438\u043B\u0438 \u0432\u0430\u0441 \u0437\u0430 \u0432\u0435\u0440\u0451\u0432\u043A\u0443,
      \u0431\u0443\u0440\u0434\u044E\u043A \u0441 \u0432\u043E\u0434\u043E\u0439
      \u043B\u043E\u043F\u043D\u0443\u043B, \u0430 \u043E\u0433\u043D\u0438 \u043A\u0440\u0443\u0436\u0438\u043B\u0438\u0441\u044C
      \u0432\u043E\u043A\u0440\u0443\u0433, \u0431\u0443\u0434\u0442\u043E \u0441\u043C\u0435\u044F\u043B\u0438\u0441\u044C.
      \u0423\u0442\u0440\u043E\u043C \u043B\u044E\u0434\u0438 \u043C\u043E\u043B\u0447\u0430\u043B\u0438,
      \u043D\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438
      \u044F\u0441\u043D\u043E: \u0437\u0430 \u043D\u0430\u0433\u043B\u043E\u0441\u0442\u044C
      \u043F\u043B\u0430\u0442\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060630
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442
      \u043F\u0440\u0438\u0440\u043E\u0434\u0443 \u043E\u0433\u043D\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060631
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u0440\u0438\u0441\u0435\u043B
      \u0440\u044F\u0434\u043E\u043C \u0441\u043E \u0441\u0442\u0430\u0440\u044B\u043C
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0447\u0438\u043A\u043E\u043C \u0438
      \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B \u043D\u0430 \u0430\u0440\u0430\u0431\u0441\u043A\u043E\u043C
      - \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E, \u043D\u0435\u0433\u0440\u043E\u043C\u043A\u043E:
      <npc_speech lang=\"Arabic\">\u041D\u0435 \u0431\u043E\u0439\u0441\u044F, \u043E\u0442\u0435\u0446.
      \u0423\u0447\u0451\u043D\u044B\u0435 \u0432 \u0411\u0430\u0433\u0434\u0430\u0434\u0435
      \u0437\u043D\u0430\u044E\u0442: \u044D\u0442\u043E \u043E\u0433\u043E\u043D\u044C
      \u0437\u0435\u043C\u043B\u0438, \u0433\u0430\u0437 \u0438\u0437 \u0433\u043B\u0443\u0431\u0438\u043D\u044B.
      \u041D\u0435 \u0434\u0436\u0438\u043D\u043D\u044B.</npc_speech> \u041E\u043D
      \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B, \u0447\u0442\u043E \u043F\u043E\u0434\u0437\u0435\u043C\u043D\u044B\u0439
      \u0433\u0430\u0437 \u043F\u0440\u043E\u0441\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u043A\u0432\u043E\u0437\u044C \u043F\u0435\u0441\u043E\u043A \u0438
      \u0437\u0430\u0433\u043E\u0440\u0430\u0435\u0442\u0441\u044F \u043E\u0442 \u0436\u0430\u0440\u0430.
      \u0411\u0435\u0434\u0443\u0438\u043D\u0441\u043A\u0438\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043A\u0438\u0432\u0430\u043B, \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u044F,
      \u0447\u0442\u043E \u0435\u0433\u043E \u0434\u0435\u0434 \u0432\u0438\u0434\u0435\u043B
      \u0442\u0430\u043A\u043E\u0435 \u0443 \u0425\u0430\u0434\u0440\u0430\u043C\u0430\u0443\u0442\u0430
      \u0438 \u043D\u0435 \u0431\u043E\u044F\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060632
    m_Localized: "\u0414\u0443\u0445 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060633
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u0432\u044B\u0445\u043E\u0434\u0438\u0442
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B, \u0443\u0437\u043A\u0443\u044E
      \u0441\u0435\u0434\u043B\u043E\u0432\u0438\u043D\u0443 \u043C\u0435\u0436\u0434\u0443
      \u0434\u0432\u0443\u043C\u044F \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u043C\u0438
      \u0437\u0443\u0431\u0446\u0430\u043C\u0438. \u0423 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u043E\u0431\u043E, \u043E\u0431\u0432\u044F\u0437\u0430\u043D\u043D\u043E\u0433\u043E
      \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u043C\u0438 \u043C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438
      \u0444\u043B\u0430\u0433\u0430\u043C\u0438, \u0434\u044B\u043C\u0438\u0442\u0441\u044F
      \u043C\u043E\u0436\u0436\u0435\u0432\u0435\u043B\u044C\u043D\u0438\u043A. \u041D\u043E
      \u0434\u044B\u043C \u0432\u0435\u0434\u0451\u0442 \u0441\u0435\u0431\u044F
      \u0441\u0442\u0440\u0430\u043D\u043D\u043E: \u043E\u043D \u043D\u0435 \u0440\u0430\u0441\u0441\u0435\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0432\u0435\u0442\u0440\u0443, \u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u0440\u043E\u0432\u043D\u044B\u043C \u0441\u0442\u043E\u043B\u0431\u043E\u043C,
      \u0431\u0443\u0434\u0442\u043E \u0432 \u0431\u0435\u0437\u0432\u0435\u0442\u0440\u0438\u0435,
      \u0445\u043E\u0442\u044F \u043F\u043E\u0440\u044B\u0432\u044B \u0442\u0440\u0435\u043F\u043B\u044E\u0442
      \u043B\u0435\u043D\u0442\u044B \u043D\u0430 \u0444\u043B\u0430\u0433\u0430\u0445.
      \u0412\u044C\u044E\u0447\u043D\u044B\u0435 \u044F\u043A\u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C
      \u0438 \u0440\u0435\u0432\u0443\u0442, \u043D\u0438\u0437\u043A\u043E \u0438
      \u043F\u0440\u043E\u0442\u044F\u0436\u043D\u043E, \u0432\u0431\u0438\u0432
      \u043A\u043E\u043F\u044B\u0442\u0430 \u0432 \u043F\u0440\u043E\u043C\u0451\u0440\u0437\u0448\u0438\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C. \u0421\u0442\u0430\u0440\u044B\u0439
      \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A,
      \u043D\u0430\u043D\u044F\u0442\u044B\u0439 \u0432 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u043C
      \u0441\u0435\u043B\u0435\u043D\u0438\u0438, \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0441\u044F \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u0438
      \u043F\u0435\u0440\u0435\u0434 \u043E\u0431\u043E \u0438 \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F
      \u043B\u0431\u043E\u043C \u0437\u0435\u043C\u043B\u0438.\r\n\r\n<npc_speech
      lang=\"Tibetan\">\u041F\u043E\u0447\u0442\u0435\u043D\u0438\u0435 \u0431\u043E\u0433\u0430\u043C!
      \u0412\u0435\u043B\u0438\u043A\u0438\u0439 \u0445\u043E\u0437\u044F\u0438\u043D
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430, \u0441\u043C\u0438\u043B\u0443\u0439\u0441\u044F
      \u043D\u0430\u0434 \u043D\u0430\u043C\u0438, \u0438\u0434\u0443\u0449\u0438\u043C\u0438!
      \u041F\u043E\u043A\u043B\u043E\u043D \u0442\u0435\u0431\u0435!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060634
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0435
      \u0438\u0437 \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060635
    m_Localized: "\u0412\u044B \u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0438 \u0443
      \u043E\u0431\u043E \u0433\u043E\u0440\u0441\u0442\u044C \u0446\u0430\u043C\u043F\u044B,
      \u043A\u0443\u0441\u043E\u043A \u0441\u0443\u0448\u0451\u043D\u043E\u0433\u043E
      \u043C\u044F\u0441\u0430 \u0438 \u043F\u043B\u0435\u0441\u043D\u0443\u043B\u0438
      \u0447\u0430\u044F \u0438\u0437 \u043A\u043E\u0442\u0435\u043B\u043A\u0430
      \u043D\u0430 \u043A\u0430\u043C\u043D\u0438. \u0421\u0442\u0430\u0440\u044B\u0439
      \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043A\u0438\u0432\u043D\u0443\u043B, \u043D\u0435 \u0432\u0441\u0442\u0430\u0432\u0430\u044F
      \u0441 \u043A\u043E\u043B\u0435\u043D. \u0412\u0435\u0442\u0435\u0440 \u043D\u0430
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435 \u0441\u0442\u0438\u0445,
      \u0438 \u0441\u0442\u043E\u043B\u0431 \u0434\u044B\u043C\u0430 \u0434\u0440\u043E\u0433\u043D\u0443\u043B
      - \u0438\u0437\u043E\u0433\u043D\u0443\u043B\u0441\u044F \u0432 \u0432\u0430\u0448\u0443
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u0431\u0443\u0434\u0442\u043E
      \u043A\u0438\u0432\u043D\u0443\u043B, \u0438 \u0440\u0430\u0441\u0441\u0435\u044F\u043B\u0441\u044F.
      \u042F\u043A\u0438 \u0442\u0440\u043E\u043D\u0443\u043B\u0438\u0441\u044C \u0441\u0430\u043C\u0438,
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E, \u0431\u0435\u0437 \u043F\u043E\u043D\u0443\u043A\u0430\u043D\u0438\u0439.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B\u0438.
      \u0421\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0435 \u0438\u043B\u0438
      \u043D\u0435\u0442, \u043D\u043E \u043F\u0435\u0440\u0435\u0432\u0430\u043B
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043F\u043E\u0437\u0430\u0434\u0438
      \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060636
    m_Localized: "\u0421\u0442\u0435\u0433\u043D\u0443\u0442\u044C \u044F\u043A\u043E\u0432
      \u0438 \u043F\u0440\u043E\u0439\u0442\u0438 \u0441\u0438\u043B\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060637
    m_Localized: "\u0425\u043B\u044B\u0441\u0442\u044B \u0449\u0451\u043B\u043A\u043D\u0443\u043B\u0438.
      \u042F\u043A\u0438 \u0440\u0432\u0430\u043D\u0443\u043B\u0438 \u0432\u043F\u0435\u0440\u0451\u0434,
      \u043E\u0431\u0435\u0437\u0443\u043C\u0435\u0432 \u043E\u0442 \u0443\u0434\u0430\u0440\u043E\u0432:
      \u043A\u043E\u043F\u044B\u0442\u0430 \u0441\u043A\u043E\u043B\u044C\u0437\u0438\u043B\u0438
      \u043F\u043E \u043B\u044C\u0434\u0443, \u043D\u043E \u0434\u0435\u0440\u0436\u0430\u043B\u0438.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0433\u0440\u043E\u0445\u043E\u0442\u0430\u043B
      \u043C\u0438\u043C\u043E \u043E\u0431\u043E \u043D\u0430 \u043F\u043E\u043B\u043D\u043E\u043C
      \u0445\u043E\u0434\u0443. \u0421\u0442\u0430\u0440\u044B\u0439 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u043E\u0442\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0438 \u043C\u043E\u043B\u0447\u0430\u043B
      \u0434\u043E \u0432\u0435\u0447\u0435\u0440\u0430. \u041B\u044E\u0434\u0438
      \u043A\u043E\u0441\u0438\u043B\u0438\u0441\u044C \u043D\u0430 \u043D\u0435\u0433\u043E
      \u0438 \u043D\u0430 \u0433\u043E\u0440\u044B \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439.
      \u041F\u0435\u0440\u0435\u0432\u0430\u043B \u043F\u0440\u043E\u0439\u0434\u0435\u043D,
      \u043D\u043E \u0442\u0438\u0448\u0438\u043D\u0430 \u0432 \u043E\u0442\u0440\u044F\u0434\u0435
      \u0441\u0442\u043E\u0438\u0442 \u0442\u044F\u0436\u0451\u043B\u0430\u044F,
      \u043A\u0430\u043A \u043F\u0435\u0440\u0435\u0434 \u0433\u0440\u043E\u0437\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060638
    m_Localized: "\u0412\u0435\u0434\u0443\u0449\u0438\u0439 \u044F\u043A \u0441\u043E\u0440\u0432\u0430\u043B\u0441\u044F
      \u043D\u0430 \u043E\u0431\u043B\u0435\u0434\u0435\u043D\u0435\u0432\u0448\u0435\u043C
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0435: \u0437\u0430\u0434\u043D\u044F\u044F
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u0437\u0430\u043D\u0435\u0441\u043B\u043E,
      \u043A\u043E\u043B\u0435\u0441\u043E \u0443\u0434\u0430\u0440\u0438\u043B\u043E\u0441\u044C
      \u043E \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u0439 \u0432\u044B\u0441\u0442\u0443\u043F
      \u0438 \u0442\u0440\u0435\u0441\u043D\u0443\u043B\u043E. \u041F\u043E\u043A\u0430
      \u0432\u044B\u043F\u0440\u0430\u0432\u043B\u044F\u043B\u0438 \u0433\u0440\u0443\u0437,
      \u043A\u0430\u043C\u0435\u043D\u043D\u0430\u044F \u043E\u0441\u044B\u043F\u044C
      \u0441\u043E\u0448\u043B\u0430 \u0441\u0432\u0435\u0440\u0445\u0443, \u043C\u0435\u043B\u043A\u0430\u044F,
      \u043D\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u0430\u044F,
      \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0432\u0430\u043B\u0438\u0442\u044C
      \u0442\u0440\u043E\u043F\u0443 \u043D\u0430 \u0434\u0432\u0430 \u0447\u0430\u0441\u0430.
      \u0421\u0442\u0430\u0440\u044B\u0439 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F \u0441 \u043A\u043E\u043B\u0435\u043D,
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043D\u0430 \u0432\u0430\u0441
      \u0434\u043E\u043B\u0433\u043E \u0438 \u0441\u043A\u0430\u0437\u0430\u043B
      \u043E\u0434\u043D\u043E \u0441\u043B\u043E\u0432\u043E: \xAB\u0413\u043E\u0432\u043E\u0440\u0438\u043B\xBB.
      \u042F\u043A\u0438 \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0438\u0441\u044C
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0435\u0449\u0451 \u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060639
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u0440\u0438\u0442\u0443\u0430\u043B \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060640
    m_Localized: "\u0412\u0430\u0448 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0432\u044B\u0441\u0442\u0443\u043F\u0438\u043B \u0432\u043F\u0435\u0440\u0451\u0434
      \u0438 \u0436\u0435\u0441\u0442\u043E\u043C \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D. \u041E\u043D \u0434\u043E\u0441\u0442\u0430\u043B
      \u0438\u0437 \u043F\u043E\u044F\u0441\u043D\u043E\u0439 \u0441\u0443\u043C\u043A\u0438
      \u043A\u0443\u0441\u043E\u043A \u0442\u043E\u043F\u043B\u0451\u043D\u043E\u0433\u043E
      \u043C\u0430\u0441\u043B\u0430, \u0437\u0430\u0432\u0451\u0440\u043D\u0443\u0442\u044B\u0439
      \u0432 \u0442\u0440\u044F\u043F\u0438\u0446\u0443, \u0438 \u0432\u0435\u0442\u043A\u0443
      \u043C\u043E\u0436\u0436\u0435\u0432\u0435\u043B\u044C\u043D\u0438\u043A\u0430
      - \u0437\u0430\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u043D\u0443\u044E
      \u0437\u0430\u0440\u0430\u043D\u0435\u0435, \u0431\u0443\u0434\u0442\u043E
      \u0437\u043D\u0430\u043B. \u041F\u0440\u0438\u0441\u0435\u043B \u0440\u044F\u0434\u043E\u043C
      \u0441\u043E \u0441\u0442\u0430\u0440\u0438\u043A\u043E\u043C, \u043F\u0440\u043E\u0438\u0437\u043D\u0451\u0441
      \u043D\u0430\u0440\u0430\u0441\u043F\u0435\u0432 \u0434\u043B\u0438\u043D\u043D\u0443\u044E
      \u043C\u043E\u043B\u0438\u0442\u0432\u0443 \u0438 \u043F\u043E\u0434\u043D\u0451\u0441
      \u043C\u0430\u0441\u043B\u043E \u043A \u0434\u044B\u043C\u0443. \u0421\u0442\u043E\u043B\u0431
      \u0438\u0437\u043E\u0433\u043D\u0443\u043B\u0441\u044F, \u043E\u0431\u0432\u0438\u043B
      \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0435, \u043A\u0430\u043A
      \u0436\u0438\u0432\u043E\u0439, \u0438 \u0440\u0430\u0441\u0441\u0435\u044F\u043B\u0441\u044F.
      \u0412\u0435\u0442\u0435\u0440 \u0441\u0442\u0438\u0445. \u042F\u043A\u0438
      \u043F\u043E\u0434\u043D\u044F\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u044B
      \u0438 \u043F\u043E\u0448\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060641
    m_Localized: "\u041F\u0440\u043E\u0440\u043E\u0447\u0435\u0441\u043A\u0438\u0439
      \u0441\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060642
    m_Localized: "\u041F\u0440\u0438\u0432\u0430\u043B \u043D\u0430 \u0440\u043E\u0432\u043D\u043E\u0439
      \u0441\u0442\u0435\u043F\u0438, \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C
      \u0432 \u043A\u043E\u0441\u0442\u044F\u0445, \u0447\u0430\u0439 \u0441 \u043C\u044F\u0442\u043E\u0439
      \u0432 \u0440\u0443\u043A\u0430\u0445. \u0421\u043E\u043D \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442
      \u0431\u044B\u0441\u0442\u0440\u043E: \u0442\u044F\u0436\u0451\u043B\u044B\u0439,
      \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439, \u0431\u0435\u0437 \u0441\u043D\u043E\u0432\u0438\u0434\u0435\u043D\u0438\u0439.
      \u0410 \u043F\u043E\u0442\u043E\u043C \u0432\u0441\u043F\u044B\u0448\u043A\u0430.
      \u0412\u044B \u0441\u0442\u043E\u0438\u0442\u0435 \u043D\u0430 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0435.
      \u041B\u0435\u0432\u0430\u044F \u0442\u0440\u043E\u043F\u0430 \u0432\u0435\u0434\u0451\u0442
      \u043A \u0433\u043E\u0440\u043E\u0434\u0443 \u0441 \u0437\u043E\u043B\u043E\u0442\u044B\u043C\u0438
      \u043A\u0443\u043F\u043E\u043B\u0430\u043C\u0438, \u043D\u043E \u043E\u0442
      \u0432\u043E\u0440\u043E\u0442 \u0442\u044F\u043D\u0435\u0442 \u0433\u0430\u0440\u044C\u044E.
      \u041F\u0440\u0430\u0432\u0430\u044F \u0443\u0445\u043E\u0434\u0438\u0442 \u0432
      \u0441\u0442\u0435\u043F\u044C, \u0433\u0434\u0435 \u0442\u0440\u0430\u0432\u0430
      \u043F\u043E \u043F\u043E\u044F\u0441 \u0438 \u0441\u043B\u044B\u0448\u043D\u043E
      \u043F\u0435\u043D\u0438\u0435 - \u043D\u0435\u0437\u0434\u0435\u0448\u043D\u0435\u0435,
      \u043A\u0430\u043A \u0445\u043E\u0440 \u0432 \u043F\u0443\u0441\u0442\u043E\u043C
      \u0445\u0440\u0430\u043C\u0435. \u041C\u0435\u0436\u0434\u0443 \u0442\u0440\u043E\u043F\u0430\u043C\u0438
      \u0441\u0442\u043E\u0438\u0442 \u0444\u0438\u0433\u0443\u0440\u0430 \u0432
      \u0431\u0435\u043B\u043E\u043C, \u043B\u0438\u0446\u0430 \u043D\u0435 \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u0435\u0442\u044C.
      \u041E\u043D\u0430 \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u0440\u0443\u043A\u0443: \u043D\u0430 \u043B\u0430\u0434\u043E\u043D\u0438
      \u043C\u0435\u0434\u043D\u0430\u044F \u043C\u043E\u043D\u0435\u0442\u0430,
      \u0440\u0430\u0441\u043A\u043E\u043B\u043E\u0442\u0430\u044F \u043F\u043E\u043F\u043E\u043B\u0430\u043C.
      \u0412\u044B \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0435\u0441\u044C
      \u0432 \u043F\u043E\u0442\u0443. \u041A\u043E\u0441\u0442\u0451\u0440 \u043F\u0440\u043E\u0433\u043E\u0440\u0435\u043B,
      \u0437\u0432\u0451\u0437\u0434\u044B \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C.
      \u0420\u044F\u0434\u043E\u043C \u0432\u043E\u0440\u043E\u0447\u0430\u0435\u0442\u0441\u044F
      \u043B\u0435\u043A\u0430\u0440\u044C, \u0431\u043E\u0440\u043C\u043E\u0447\u0430
      \u0432\u043E \u0441\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060643
    m_Localized: "\u0417\u0430\u0431\u044B\u0442\u044C \u0441\u043E\u043D, \u0441\u043F\u0438\u0441\u0430\u0442\u044C
      \u043D\u0430 \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060644
    m_Localized: "\u0412\u044B \u043F\u043B\u0435\u0441\u043D\u0443\u043B\u0438 \u0432\u043E\u0434\u044B
      \u0432 \u043B\u0438\u0446\u043E, \u043F\u043E\u0434\u0431\u0440\u043E\u0441\u0438\u043B\u0438
      \u043A\u0438\u0437\u044F\u043A\u0430 \u0432 \u043A\u043E\u0441\u0442\u0451\u0440
      \u0438 \u043B\u0435\u0433\u043B\u0438 \u0441\u043D\u043E\u0432\u0430. \u0421\u043E\u043D
      \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F, \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u0443\u0441\u0442\u0430\u044F \u0447\u0435\u0440\u043D\u043E\u0442\u0430
      \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430. \u0423\u0442\u0440\u043E\u043C
      \u043E\u0442 \u043D\u043E\u0447\u043D\u043E\u0433\u043E \u0432\u0438\u0434\u0435\u043D\u0438\u044F
      \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043B\u0438\u0448\u044C \u0441\u043C\u0443\u0442\u043D\u043E\u0435
      \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u043E \u0432
      \u0433\u0440\u0443\u0434\u0438, \u043D\u043E \u043A\u0440\u0435\u043F\u043A\u0438\u0439
      \u0447\u0430\u0439 \u0438 \u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0435
      \u0445\u043B\u043E\u043F\u043E\u0442\u044B \u0431\u044B\u0441\u0442\u0440\u043E
      \u0435\u0433\u043E \u0432\u044B\u0442\u0435\u0441\u043D\u0438\u043B\u0438.
      \u041D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u043F\u0440\u043E\u0441\u0442\u043E
      \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060645
    m_Localized: "\u0418\u0441\u0442\u043E\u043B\u043A\u043E\u0432\u0430\u0442\u044C
      \u0432\u0438\u0434\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060646
    m_Localized: "\u0412\u044B \u0441\u0435\u043B\u0438 \u0443 \u043A\u043E\u0441\u0442\u0440\u0430
      \u0438 \u043D\u0430\u0447\u0430\u043B\u0438 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044C
      \u043E\u0431\u0440\u0430\u0437\u044B. \u0413\u043E\u0440\u043E\u0434 \u0441
      \u0437\u043E\u043B\u043E\u0442\u044B\u043C\u0438 \u043A\u0443\u043F\u043E\u043B\u0430\u043C\u0438:
      \u0411\u0443\u0445\u0430\u0440\u0430 \u0438\u043B\u0438 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434?
      \u0414\u044B\u043C \u043E\u0431\u043E\u0437\u043D\u0430\u0447\u0430\u043B \u043F\u043E\u0436\u0430\u0440
      \u0438\u043B\u0438 \u0432\u043E\u0439\u043D\u0443. \u0420\u0430\u0441\u043A\u043E\u043B\u043E\u0442\u0430\u044F
      \u043C\u043E\u043D\u0435\u0442\u0430: \u0441\u0434\u0435\u043B\u043A\u0430,
      \u043E\u0431\u0440\u0435\u0447\u0451\u043D\u043D\u0430\u044F \u0440\u0430\u0441\u043F\u0430\u0441\u0442\u044C\u0441\u044F.
      \u0421\u0442\u0435\u043F\u043D\u0430\u044F \u0442\u0440\u043E\u043F\u0430 \u0441
      \u043F\u0435\u043D\u0438\u0435\u043C: \u0434\u043E\u043B\u0433\u0438\u0439,
      \u043D\u043E \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0439 \u043F\u0443\u0442\u044C.
      \u041A \u0443\u0442\u0440\u0443 \u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u0431\u044B\u043B\u043E \u043F\u0440\u0438\u043D\u044F\u0442\u043E: \u043E\u0431\u043E\u0439\u0442\u0438
      \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0439 \u0433\u043E\u0440\u043E\u0434
      \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439. \u0412\u044B\u0439\u0442\u0438
      \u043D\u0430 \u0441\u0442\u0435\u043F\u043D\u043E\u0439 \u0442\u0440\u0430\u043A\u0442.
      \u0427\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u0434\u043D\u044F \u043E\u0442
      \u0432\u0441\u0442\u0440\u0435\u0447\u043D\u044B\u0445 \u043F\u0440\u0438\u0448\u043B\u0430
      \u0432\u0435\u0441\u0442\u044C: \u0432 \u0411\u0443\u0445\u0430\u0440\u0435
      \u0432\u0441\u043F\u044B\u0445\u043D\u0443\u043B \u043C\u044F\u0442\u0435\u0436,
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u044B,
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432 \u0433\u0440\u0430\u0431\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060647
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0441\u0438\u0434\u0435\u043B\u0438
      \u0443 \u0443\u0433\u043B\u0435\u0439 \u043F\u043E\u043B\u043D\u043E\u0447\u0438,
      \u0432\u043E\u0440\u043E\u0447\u0430\u044F \u043E\u0431\u0440\u0430\u0437\u044B,
      \u043A\u0430\u043A \u043A\u0430\u043C\u043D\u0438 \u043D\u0430 \u043C\u0435\u043B\u043A\u043E\u0432\u043E\u0434\u044C\u0435.
      \u041A\u0443\u0434\u0430 \u0432\u0451\u043B \u0433\u043E\u0440\u043E\u0434,
      \u0447\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u043B\u0430 \u043C\u043E\u043D\u0435\u0442\u0430,
      \u043A\u0442\u043E \u0431\u044B\u043B\u0430 \u0444\u0438\u0433\u0443\u0440\u0430
      \u0432 \u0431\u0435\u043B\u043E\u043C? \u041E\u0442\u0432\u0435\u0442\u043E\u0432
      \u043D\u0435 \u043D\u0430\u0448\u043B\u043E\u0441\u044C, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0433\u043E\u043B\u043E\u0432\u043D\u0430\u044F \u0431\u043E\u043B\u044C \u0438
      \u0431\u0435\u0441\u0441\u043E\u043D\u043D\u0430\u044F \u043D\u043E\u0447\u044C.
      \u0423\u0442\u0440\u043E\u043C \u0432\u044B \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u0438
      \u0445\u0443\u0436\u0435 \u0432\u0441\u0435\u0445 \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0448\u0435\u043F\u0442\u0430\u043B\u0438\u0441\u044C:
      \u0445\u043E\u0437\u044F\u0438\u043D \u0432\u0438\u0434\u0435\u043B \u0434\u0443\u0440\u043D\u043E\u0439
      \u0441\u043E\u043D \u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u043F\u043E\u043A\u043E\u0439.
      \u0422\u0440\u0435\u0432\u043E\u0433\u0430 \u043B\u0438\u043F\u043B\u0430 \u043A
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443, \u043A\u0430\u043A \u043F\u044B\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060648
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0437\u043D\u0430\u0435\u0442
      \u0442\u043E\u043B\u043A\u043E\u0432\u0430\u043D\u0438\u0435 \u0441\u043D\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060649
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F
      \u043E\u0442 \u0432\u0430\u0448\u0435\u0433\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F,
      \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B \u0440\u0430\u0441\u0441\u043A\u0430\u0437
      \u0438 \u043A\u0438\u0432\u043D\u0443\u043B, \u0431\u0443\u0434\u0442\u043E
      \u0441\u043B\u044B\u0448\u0430\u043B \u044D\u0442\u043E \u043D\u0435 \u0432\u043F\u0435\u0440\u0432\u044B\u0435.
      \xAB\u041F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0435 \u043C\u0430\u0433\u0438
      \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0442\u0430\u043A\u0438\u0435
      \u0441\u043D\u044B \"\u0445\u0432\u0430\u0430\u0431-\u0438 \u0440\u0430\u0430\u0445\u043D\u0430\u043C\u0430\u0430\",
      \u043F\u0443\u0442\u0435\u0432\u043E\u0434\u043D\u044B\u0439 \u0441\u043E\u043D.
      \u0420\u0430\u0441\u043A\u043E\u043B\u043E\u0442\u0430\u044F \u043C\u043E\u043D\u0435\u0442\u0430
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u0435\u0442
      \u043E \u043D\u0435\u0447\u0435\u0441\u0442\u043D\u043E\u0439 \u0441\u0434\u0435\u043B\u043A\u0435.
      \u0413\u043E\u0440\u043E\u0434 \u0432 \u0434\u044B\u043C\u0443: \u043C\u0435\u0441\u0442\u043E,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0441\u043B\u0435\u0434\u0443\u0435\u0442
      \u0438\u0437\u0431\u0435\u0433\u0430\u0442\u044C. \u041F\u0435\u043D\u0438\u0435
      \u0432 \u0442\u0440\u0430\u0432\u0435: \u0433\u043E\u043B\u043E\u0441 \u0444\u0440\u0430\u0432\u0430\u0448\u0438,
      \u0434\u0443\u0445\u0430-\u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044F.
      \u0418\u0434\u0438 \u0434\u043B\u0438\u043D\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u043E\u0439.\xBB
      \u041B\u0435\u043A\u0430\u0440\u044C \u0437\u0430\u0432\u0430\u0440\u0438\u043B
      \u0433\u043E\u0440\u044C\u043A\u0438\u0439 \u043E\u0442\u0432\u0430\u0440 \u0438\u0437
      \u0442\u0440\u0430\u0432, \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u0442\u044F\u0436\u0435\u0441\u0442\u044C \u0432 \u0433\u043E\u043B\u043E\u0432\u0435
      \u0440\u0430\u0441\u0441\u0435\u044F\u043B\u0430\u0441\u044C, \u043A\u0430\u043A
      \u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u0442\u0443\u043C\u0430\u043D.
      \u0423\u0442\u0440\u043E\u043C \u0432\u044B \u0441\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043B\u0438
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442. \u041B\u0438\u0446\u0430 \u0445\u043E\u0437\u044F\u0438\u043D\u0430
      \u0438 \u043B\u0435\u043A\u0430\u0440\u044F \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438
      \u0441\u0430\u043C\u0438 \u0437\u0430 \u0441\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060650
    m_Localized: "\u041F\u0442\u0438\u0447\u044C\u0435 \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060651
    m_Localized: "\u0423 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0440\u0430\u0441\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u043D\u0430 \u0434\u0432\u0435 \u0442\u0440\u043E\u043F\u044B: \u043E\u0431\u0435
      \u043F\u044B\u043B\u044C\u043D\u044B\u0435, \u043E\u0431\u0435 \u0431\u0435\u0437
      \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0435\u0439. \u0412\u043E\u0437\u043D\u0438\u0447\u0438\u0435
      \u0441\u043F\u043E\u0440\u044F\u0442, \u043A\u0430\u043A\u0430\u044F \u043A\u043E\u0440\u043E\u0447\u0435.
      \u041D\u0430\u0434 \u0445\u043E\u043B\u043C\u043E\u043C \u0432\u0437\u043B\u0435\u0442\u0430\u0435\u0442
      \u0441\u0442\u0430\u044F. \u0414\u0435\u0441\u044F\u0442\u043A\u0438 \u043F\u0442\u0438\u0446:
      \u0436\u0443\u0440\u0430\u0432\u043B\u0438 \u043B\u0435\u0442\u044F\u0442 \u043A\u043B\u0438\u043D\u043E\u043C
      \u043D\u0430 \u044E\u0433\u043E-\u0437\u0430\u043F\u0430\u0434, \u043A \u043B\u0435\u0432\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435. \u0421\u0442\u0430\u0440\u044B\u0439 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0439
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u043F\u0440\u0435\u043A\u0440\u0430\u0449\u0430\u0435\u0442
      \u0441\u043F\u043E\u0440 \u0438 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u043B\u0430\u0434\u043E\u043D\u044C:\r\n\r\n<npc_speech lang=\"Turkic\">\u0416\u0443\u0440\u0430\u0432\u043B\u044C
      \u0437\u043D\u0430\u0435\u0442 \u043F\u0443\u0442\u044C - \u0442\u0430\u043A
      \u0432\u0435\u043B\u0438\u0442 \u041D\u0435\u0431\u043E. \u041A\u0443\u0434\u0430
      \u043B\u0435\u0442\u0438\u0442 \u0436\u0443\u0440\u0430\u0432\u043B\u044C,
      \u0442\u0430\u043C \u0432\u043E\u0434\u0430, \u0442\u0430\u043C \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C.</npc_speech>\r\n\r\n\u041E\u043D
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u0436\u0443\u0440\u0430\u0432\u043B\u0438
      \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043B\u0435\u0442\u044F\u0442
      \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u0431\u0435\u0434\u0435.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0443\u043C\u043E\u043B\u043A\u0430\u044E\u0442.
      \u041B\u0435\u0432\u0430\u044F \u0442\u0440\u043E\u043F\u0430 \u0443\u0445\u043E\u0434\u0438\u0442
      \u043A \u0434\u0430\u043B\u0451\u043A\u0438\u043C \u0445\u043E\u043B\u043C\u0430\u043C,
      \u043F\u0440\u0430\u0432\u0430\u044F \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u0435\u0442
      \u0440\u043E\u0432\u043D\u0443\u044E \u0441\u0442\u0435\u043F\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060652
    m_Localized: "\u041F\u043E\u0439\u0442\u0438 \u043F\u043E \u043B\u0435\u0432\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435 \u0437\u0430 \u0436\u0443\u0440\u0430\u0432\u043B\u044F\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060653
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0441\u0432\u0435\u0440\u043D\u0443\u043B
      \u043D\u0430\u043B\u0435\u0432\u043E - \u0432\u0441\u043B\u0435\u0434 \u0437\u0430
      \u043A\u043B\u0438\u043D\u043E\u043C. \u0422\u0440\u043E\u043F\u0430 \u043F\u0435\u0442\u043B\u044F\u043B\u0430
      \u0441\u0440\u0435\u0434\u0438 \u043D\u0435\u0432\u044B\u0441\u043E\u043A\u0438\u0445
      \u0445\u043E\u043B\u043C\u043E\u0432, \u043D\u043E \u043A \u043F\u043E\u043B\u0443\u0434\u043D\u044E
      \u0432\u044B\u0432\u0435\u043B\u0430 \u043A \u0440\u0443\u0447\u044C\u044E
      \u0441 \u0447\u0438\u0441\u0442\u043E\u0439 \u0432\u043E\u0434\u043E\u0439
      \u0438 \u0437\u0430\u0440\u043E\u0441\u043B\u044F\u043C\u0438 \u0434\u0438\u043A\u043E\u0433\u043E
      \u0443\u0440\u044E\u043A\u0430. \u0411\u0443\u0440\u0434\u044E\u043A\u0438
      \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u044B, \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043D\u0430\u043F\u043E\u0435\u043D\u044B, \u043B\u044E\u0434\u0438 \u0436\u0443\u044E\u0442
      \u0441\u043B\u0430\u0434\u043A\u0438\u0435 \u0430\u0431\u0440\u0438\u043A\u043E\u0441\u044B
      \u0438 \u0443\u043B\u044B\u0431\u0430\u044E\u0442\u0441\u044F. \u0421\u0442\u0430\u0440\u044B\u0439
      \u0442\u044E\u0440\u043A \u0441\u0438\u0434\u0438\u0442 \u043D\u0430 \u043A\u0430\u043C\u043D\u0435
      \u0438 \u043A\u0438\u0432\u0430\u0435\u0442 \u0441 \u0432\u0438\u0434\u043E\u043C
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0432\u0441\u0435\u0433\u0434\u0430 \u0437\u043D\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060654
    m_Localized: "\u041F\u0440\u043E\u0438\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u0438\u043C\u0435\u0442\u0443, \u043F\u043E\u0439\u0442\u0438
      \u043F\u043E \u043F\u0440\u0430\u0432\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060655
    m_Localized: "\u0412\u044B \u043E\u0446\u0435\u043D\u0438\u043B\u0438 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435,
      \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u0434\u043E\u0440\u043E\u0433\u0443
      \u0438 \u0440\u0435\u0448\u0438\u043B\u0438: \u043F\u0440\u0430\u0432\u0430\u044F
      \u0442\u0440\u043E\u043F\u0430 \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442
      \u043F\u043E\u043B\u0434\u043D\u044F. \u0418 \u0431\u044B\u043B\u0438 \u043F\u0440\u0430\u0432\u044B.
      \u0420\u043E\u0432\u043D\u0430\u044F \u0441\u0442\u0435\u043F\u044C, \u0442\u0432\u0451\u0440\u0434\u0430\u044F
      \u043F\u043E\u0447\u0432\u0430, \u043D\u0438\u043A\u0430\u043A\u0438\u0445
      \u0441\u044E\u0440\u043F\u0440\u0438\u0437\u043E\u0432. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0434\u043E\u0431\u0440\u0430\u043B\u0441\u044F
      \u0434\u043E \u043F\u0435\u0440\u0435\u043A\u0440\u0451\u0441\u0442\u043A\u0430
      \u0441 \u043E\u0436\u0438\u0432\u043B\u0451\u043D\u043D\u044B\u043C \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u043C
      \u0434\u0432\u043E\u0440\u043E\u043C, \u0433\u0434\u0435 \u0432\u044B \u043F\u0440\u043E\u0434\u0430\u043B\u0438
      \u0447\u0430\u0441\u0442\u044C \u0442\u043E\u0432\u0430\u0440\u043E\u0432 \u0441
      \u043F\u0440\u0438\u0431\u044B\u043B\u044C\u044E \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0449\u0435\u043C\u0443
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C\u0443 \u043E\u0431\u043E\u0437\u0443.
      \u0421\u0442\u0430\u0440\u044B\u0439 \u0442\u044E\u0440\u043A \u043D\u0430\u0441\u0443\u043F\u0438\u043B\u0441\u044F,
      \u043D\u043E \u043F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u043B - \u0441\u0435\u0440\u0435\u0431\u0440\u043E
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0433\u0440\u043E\u043C\u0447\u0435
      \u0436\u0443\u0440\u0430\u0432\u043B\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060656
    m_Localized: "\u041F\u0440\u0430\u0432\u0430\u044F \u0442\u0440\u043E\u043F\u0430
      \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u043E\u0431\u043C\u0430\u043D\u0447\u0438\u0432\u043E\u0439:
      \u0440\u043E\u0432\u043D\u0430\u044F \u043D\u0430 \u0432\u0438\u0434, \u043E\u043D\u0430
      \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u0443\u0445\u043E\u0434\u0438\u043B\u0430
      \u0432 \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A. \u041A\u043E\u043B\u0451\u0441\u0430
      \u0432\u044F\u0437\u043B\u0438, \u0431\u044B\u043A\u0438 \u0432\u044B\u0431\u0438\u0432\u0430\u043B\u0438\u0441\u044C
      \u0438\u0437 \u0441\u0438\u043B, \u0430 \u0432\u043E\u0434\u044B \u043F\u043E\u0431\u043B\u0438\u0437\u043E\u0441\u0442\u0438
      \u043D\u0435 \u043D\u0430\u0448\u043B\u043E\u0441\u044C. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u044B\u0431\u0440\u0430\u043B\u0441\u044F
      \u043D\u0430 \u0442\u0432\u0451\u0440\u0434\u0443\u044E \u0437\u0435\u043C\u043B\u044E,
      \u043D\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u043F\u043E\u043B\u0434\u043D\u044F
      \u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u044B. \u0421\u0442\u0430\u0440\u044B\u0439
      \u0442\u044E\u0440\u043A \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043D\u0430
      \u0432\u0430\u0441 \u043C\u043E\u043B\u0447\u0430, \u0438 \u0432 \u0435\u0433\u043E
      \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0438 \u0441\u043B\u044B\u0448\u0430\u043B\u043E\u0441\u044C:
      \xAB\u0416\u0443\u0440\u0430\u0432\u043B\u0438 \u0437\u043D\u0430\u043B\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060657
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0447\u0438\u0442\u0430\u0435\u0442
      \u043F\u0440\u0438\u043C\u0435\u0442\u044B \u0440\u044B\u043D\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060658
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u043F\u0440\u0438\u0449\u0443\u0440\u0438\u043B\u0441\u044F
      \u043D\u0430 \u0436\u0443\u0440\u0430\u0432\u043B\u0435\u0439, \u043F\u043E\u0442\u043E\u043C
      \u043D\u0430 \u0445\u043E\u043B\u043C\u044B. \xAB\u0416\u0443\u0440\u0430\u0432\u043B\u0438
      \u043B\u0435\u0442\u044F\u0442 \u043A \u0432\u043E\u0434\u0435, \u0437\u043D\u0430\u0447\u0438\u0442,
      \u043A \u0437\u0435\u043B\u0435\u043D\u0438. \u0410 \u0433\u0434\u0435 \u0443
      \u0434\u043E\u0440\u043E\u0433\u0438 \u0437\u0435\u043B\u0435\u043D\u044C,
      \u0442\u0430\u043C \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u0435.
      \u0410 \u0433\u0434\u0435 \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u0435,
      \u0442\u0430\u043C \u0440\u044B\u043D\u043E\u043A\xBB. \u041E\u043D \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043F\u0440\u0430\u0432: \u0437\u0430 \u0445\u043E\u043B\u043C\u0430\u043C\u0438
      \u0441\u0442\u043E\u044F\u043B \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u043A\u043E\u0447\u0435\u0432\u043E\u0439 \u043B\u0430\u0433\u0435\u0440\u044C
      \u0441 \u044E\u0440\u0442\u0430\u043C\u0438, \u0442\u0430\u0431\u0443\u043D\u0430\u043C\u0438
      \u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u043C \u0440\u044F\u0434\u043E\u043C.
      \u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0435 \u0441\u043A\u043E\u0442\u043E\u0432\u043E\u0434\u044B
      \u043E\u0431\u0440\u0430\u0434\u043E\u0432\u0430\u043B\u0438\u0441\u044C \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443
      \u0438 \u043E\u0445\u043E\u0442\u043D\u043E \u043C\u0435\u043D\u044F\u043B\u0438
      \u0432\u044F\u043B\u0435\u043D\u043E\u0435 \u043C\u044F\u0441\u043E \u0438
      \u043A\u0443\u043C\u044B\u0441 \u043D\u0430 \u0438\u0433\u043B\u044B \u0438
      \u0442\u043A\u0430\u043D\u044C. \u0421\u0442\u0430\u0440\u044B\u0439 \u0442\u044E\u0440\u043A,
      \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u0439 \u0442\u0435\u043C,
      \u0447\u0442\u043E \u043E\u0431\u043E\u0437 \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u043F\u043E\u0448\u0451\u043B \u0437\u0430 \u043F\u0442\u0438\u0446\u0430\u043C\u0438,
      \u0445\u043B\u043E\u043F\u043D\u0443\u043B \u043A\u0443\u043F\u0446\u0430 \u043F\u043E
      \u0441\u043F\u0438\u043D\u0435: \xAB\u0413\u043E\u043B\u043E\u0432\u0430 \u0443
      \u0442\u0435\u0431\u044F \u043A\u0430\u043A \u0443 \u0436\u0443\u0440\u0430\u0432\u043B\u044F
      - \u0432\u0441\u0435\u0433\u0434\u0430 \u0437\u043D\u0430\u0435\u0442, \u0433\u0434\u0435
      \u043A\u043E\u0440\u043C\u0451\u0436\u043A\u0430\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060659
    m_Localized: "\u0412\u0435\u0441\u0435\u043D\u043D\u0438\u0439 \u043F\u0430\u0432\u043E\u0434\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060660
    m_Localized: "\u0414\u043E\u0436\u0434\u044C \u043D\u0435 \u043F\u0440\u0435\u043A\u0440\u0430\u0449\u0430\u043B\u0441\u044F
      \u0434\u0432\u043E\u0435 \u0441\u0443\u0442\u043E\u043A: \u043C\u0435\u043B\u043A\u0438\u0439,
      \u0443\u043F\u0440\u044F\u043C\u044B\u0439, \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u0432\u0448\u0438\u0439
      \u0437\u0435\u043C\u043B\u044E \u0434\u043E \u0433\u043B\u0438\u043D\u044B.
      \u0410 \u043D\u0430 \u0442\u0440\u0435\u0442\u044C\u0435 \u0443\u0442\u0440\u043E
      \u0441 \u0432\u0435\u0440\u0445\u043E\u0432\u044C\u0435\u0432 \u043F\u0440\u0438\u0448\u043B\u0430
      \u0432\u043E\u0434\u0430. \u041C\u0443\u0442\u043D\u044B\u0439 \u043F\u043E\u0442\u043E\u043A
      \u0448\u0438\u0440\u0438\u043D\u043E\u0439 \u0432 \u0442\u0440\u0438 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0440\u0430\u0437\u043B\u0438\u043B\u0441\u044F \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435,
      \u043F\u043E\u0434\u043C\u044B\u0432\u0430\u044F \u043A\u043E\u043B\u0435\u0438
      \u0438 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u044F \u043E\u0431\u043E\u0447\u0438\u043D\u044B
      \u0432 \u0436\u0438\u0434\u043A\u0443\u044E \u0433\u0440\u044F\u0437\u044C.
      \u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u043D\u0438\u0437\u0438\u043D\u0430,
      \u0433\u0434\u0435 \u0442\u0440\u043E\u043F\u0430 \u0443\u0445\u043E\u0434\u0438\u0442
      \u043F\u043E\u0434 \u0432\u043E\u0434\u0443. \u0422\u0435\u0447\u0435\u043D\u0438\u0435
      \u043D\u0435\u0441\u0451\u0442 \u0432\u0435\u0442\u043A\u0438, \u0433\u043B\u0438\u043D\u044F\u043D\u044B\u0435
      \u043A\u043E\u043C\u044C\u044F, \u0447\u044C\u044E-\u0442\u043E \u043F\u043B\u0435\u0442\u0451\u043D\u0443\u044E
      \u043A\u043E\u0440\u0437\u0438\u043D\u0443. \u0412\u043E\u043B\u044B \u043D\u0435\u0440\u0432\u043D\u043E
      \u0444\u044B\u0440\u043A\u0430\u044E\u0442, \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u044F\u0441\u044C
      \u0441\u0442\u0443\u043F\u0430\u0442\u044C \u0432 \u0431\u0443\u0440\u044B\u0439
      \u043F\u043E\u0442\u043E\u043A. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0432\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u0432\u043F\u0435\u0440\u0451\u0434: \u0431\u0440\u043E\u0434\u0430 \u043D\u0435
      \u0432\u0438\u0434\u043D\u043E, \u0432\u043E\u0434\u0430 \u043F\u0440\u0438\u0431\u044B\u0432\u0430\u0435\u0442
      \u0441 \u043A\u0430\u0436\u0434\u044B\u043C \u0447\u0430\u0441\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060661
    m_Localized: "\u041F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C \u043D\u0430
      \u0432\u043E\u0437\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060662
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B
      \u043A \u0445\u043E\u043B\u043C\u0443 \u0438 \u0440\u0430\u0437\u0431\u0438\u043B
      \u043B\u0430\u0433\u0435\u0440\u044C \u043D\u0430 \u0441\u044B\u0440\u043E\u0439
      \u0442\u0440\u0430\u0432\u0435. \u0414\u0432\u0430 \u0434\u043D\u044F \u043F\u043E\u0434
      \u0434\u043E\u0436\u0434\u0451\u043C, \u043F\u0440\u043E\u043C\u043E\u043A\u0448\u0438\u0435
      \u043E\u0434\u0435\u044F\u043B\u0430, \u0441\u043A\u0443\u0434\u043D\u044B\u0439
      \u043F\u0430\u0451\u043A. \u0412\u043E\u0434\u0430 \u0432 \u0431\u0443\u0440\u0434\u044E\u043A\u0430\u0445
      \u0445\u043E\u0442\u044F \u0431\u044B \u0447\u0438\u0441\u0442\u0430\u044F,
      \u0434\u043E\u0436\u0434\u0435\u0432\u0430\u044F. \u041D\u0430 \u0442\u0440\u0435\u0442\u044C\u0435
      \u0443\u0442\u0440\u043E \u043F\u043E\u0442\u043E\u043A \u043E\u0431\u043C\u0435\u043B\u0435\u043B,
      \u0434\u043E\u0440\u043E\u0433\u0430 \u043E\u0431\u043D\u0430\u0436\u0438\u043B\u0430\u0441\u044C:
      \u0440\u0430\u0437\u043C\u044B\u0442\u0430\u044F, \u0432 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0445
      \u043A\u043E\u043B\u0435\u044F\u0445, \u043D\u043E \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043C\u0430\u044F.
      \u041B\u044E\u0434\u0438 \u043C\u043E\u043B\u0447\u0430\u0442, \u043A\u0443\u0442\u0430\u044F\u0441\u044C
      \u0432 \u043C\u043E\u043A\u0440\u0443\u044E \u0448\u0435\u0440\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060663
    m_Localized: "\u0424\u043E\u0440\u0441\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u043F\u043E\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060664
    m_Localized: "\u0429\u0443\u043F\u043E\u043C \u043D\u0430\u0448\u043B\u0438 \u0434\u043D\u043E:
      \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0435, \u043F\u043B\u043E\u0442\u043D\u043E\u0435,
      \u0433\u043B\u0443\u0431\u0438\u043D\u0430 \u043F\u043E \u0441\u0442\u0443\u043F\u0438\u0446\u0443.
      \u0412\u043E\u043B\u043E\u0432 \u0432\u0435\u043B\u0438 \u043F\u043E\u0434
      \u0443\u0437\u0434\u0446\u044B, \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0441\u0432\u044F\u0437\u0430\u043B\u0438 \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u043C\u0438
      \u0432 \u0446\u0435\u043F\u043E\u0447\u043A\u0443. \u0412\u043E\u0434\u0430
      \u0431\u0438\u043B\u0430\u0441\u044C \u0432 \u0431\u043E\u0440\u0442\u0430,
      \u0442\u0435\u0447\u0435\u043D\u0438\u0435 \u0442\u044F\u043D\u0443\u043B\u043E,
      \u043D\u043E \u043A\u043E\u043B\u0451\u0441\u0430 \u043D\u0435 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0438\u0441\u044C.
      \u041D\u0430 \u0442\u043E\u043C \u0431\u0435\u0440\u0435\u0433\u0443 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B\u0438 \u0440\u0430\u0437\u043E\u043C:
      \u043E\u0434\u0435\u0436\u0434\u0430 \u0445\u043E\u0442\u044C \u0432\u044B\u0436\u0438\u043C\u0430\u0439,
      \u0437\u0430\u0442\u043E \u0432\u0441\u0451 \u043D\u0430 \u043C\u0435\u0441\u0442\u0435.
      \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043A\u0438\u0432\u043D\u0443\u043B:
      \xAB\u0411\u044B\u0432\u0430\u043B\u043E \u0445\u0443\u0436\u0435\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060665
    m_Localized: "\u041D\u0430 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u043F\u043E\u0442\u043E\u043A\u0430
      \u043A\u043E\u043B\u0435\u0441\u043E \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u043E\u0441\u044C
      \u0432 \u043F\u0440\u043E\u043C\u043E\u0438\u043D\u0443: \u043F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u043E \u0431\u043E\u043A\u043E\u043C,
      \u0438 \u0432\u043E\u0434\u0430 \u0445\u043B\u044B\u043D\u0443\u043B\u0430
      \u0447\u0435\u0440\u0435\u0437 \u0431\u043E\u0440\u0442. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0431\u0440\u043E\u0441\u0438\u043B\u0438\u0441\u044C \u0441\u043F\u0430\u0441\u0430\u0442\u044C
      \u0442\u044E\u043A\u0438, \u043D\u043E \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      \u0443\u0436\u0435 \u0443\u043D\u043E\u0441\u0438\u043B\u043E \u043C\u0435\u0448\u043A\u0438
      \u0438 \u0441\u0432\u0451\u0440\u0442\u043A\u0438. \u041E\u0434\u0438\u043D
      \u0431\u043E\u043A \u0442\u0435\u043B\u0435\u0433\u0438 \u0442\u0440\u0435\u0441\u043D\u0443\u043B
      \u043E\u0442 \u0443\u0434\u0430\u0440\u0430 \u043E \u043F\u043E\u0434\u0432\u043E\u0434\u043D\u044B\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C. \u041A\u043E\u0435-\u0447\u0442\u043E
      \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438 \u043D\u0438\u0436\u0435 \u043F\u043E
      \u0442\u0435\u0447\u0435\u043D\u0438\u044E, \u043D\u043E \u0447\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430 \u043F\u0440\u043E\u043F\u0430\u043B\u0430 \u0431\u0435\u0441\u0441\u043B\u0435\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060666
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u043E\u0431\u0445\u043E\u0434\u043D\u0443\u044E \u0442\u0440\u043E\u043F\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060667
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043F\u0440\u0438\u0441\u0435\u043B,
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043D\u0430 \u0446\u0432\u0435\u0442
      \u0432\u043E\u0434\u044B, \u043F\u043E\u043D\u044E\u0445\u0430\u043B \u0432\u0435\u0442\u0435\u0440
      \u0438 \u043C\u043E\u043B\u0447\u0430 \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B
      \u043F\u0435\u0440\u0435\u0434\u043E\u0432\u0443\u044E \u0443\u043F\u0440\u044F\u0436\u043A\u0443
      \u0432\u043B\u0435\u0432\u043E, \u043A \u0433\u0440\u044F\u0434\u0435 \u043F\u043E\u043B\u043E\u0433\u0438\u0445
      \u0445\u043E\u043B\u043C\u043E\u0432. \xAB\u0422\u0430\u043C \u0435\u0441\u0442\u044C
      \u0441\u0442\u0430\u0440\u0430\u044F \u0442\u0440\u043E\u043F\u0430: \u043F\u0430\u0441\u0442\u0443\u0445\u0438
      \u0433\u043E\u043D\u044F\u044E\u0442 \u043E\u0442\u0430\u0440\u044B \u0432
      \u043E\u0431\u0445\u043E\u0434 \u043F\u0430\u0432\u043E\u0434\u043A\u0430.
      \u041A\u0440\u044E\u043A \u0432 \u043F\u043E\u043B\u0434\u043D\u044F, \u0437\u0430\u0442\u043E
      \u0441\u0443\u0445\u043E.\xBB \u0422\u0440\u043E\u043F\u0430 \u0438 \u0432\u043F\u0440\u0430\u0432\u0434\u0443
      \u043D\u0430\u0448\u043B\u0430\u0441\u044C: \u0443\u0437\u043A\u0430\u044F,
      \u0437\u0430\u0440\u043E\u0441\u0448\u0430\u044F, \u043D\u043E \u0432\u044B\u0448\u0435
      \u0443\u0440\u043E\u0432\u043D\u044F \u0432\u043E\u0434\u044B. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u044B\u0448\u0435\u043B \u043D\u0430
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0437\u0430 \u0440\u0430\u0437\u043B\u0438\u0432\u043E\u043C,
      \u043F\u043E\u0442\u0435\u0440\u044F\u0432 \u043B\u0438\u0448\u044C \u0432\u0440\u0435\u043C\u044F
      \u0438 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u043D\u0430 \u043B\u0438\u0448\u043D\u0438\u0439 \u043F\u0435\u0440\u0435\u0433\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060668
    m_Localized: "\u0412\u0435\u043B\u0438\u043A\u0430\u044F \u043F\u0435\u0441\u0447\u0430\u043D\u0430\u044F
      \u0431\u0443\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060669
    m_Localized: "\u0413\u043E\u0440\u0438\u0437\u043E\u043D\u0442 \u043F\u043E\u0442\u0435\u043C\u043D\u0435\u043B
      \u0437\u0430 \u0447\u0430\u0441, \u043E\u0442 \u043A\u0440\u0430\u044F \u0434\u043E
      \u043A\u0440\u0430\u044F, \u0431\u0443\u0434\u0442\u043E \u043A\u0442\u043E-\u0442\u043E
      \u043E\u043F\u0440\u043E\u043A\u0438\u043D\u0443\u043B \u043D\u0430 \u043D\u0435\u0431\u043E
      \u043A\u043E\u0442\u0451\u043B \u0441 \u0441\u0430\u0436\u0435\u0439. \u041F\u043E\u0442\u043E\u043C
      \u043F\u0440\u0438\u0448\u0451\u043B \u0432\u0435\u0442\u0435\u0440: \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u043F\u043E\u0440\u044B\u0432\u0430\u043C\u0438, \u0437\u0430\u0442\u0435\u043C
      \u0441\u043F\u043B\u043E\u0448\u043D\u043E\u0439 \u0441\u0442\u0435\u043D\u043E\u0439,
      \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0438\u0441\u0447\u0435\u0437\u043B\u0438
      \u0431\u0430\u0440\u0445\u0430\u043D\u044B, \u0434\u043E\u0440\u043E\u0433\u0430,
      \u0441\u043E\u043B\u043D\u0446\u0435. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043B\u0435\u0433\u043B\u0438, \u0441\u043F\u0440\u044F\u0442\u0430\u0432
      \u043C\u043E\u0440\u0434\u044B \u043C\u0435\u0436\u0434\u0443 \u043D\u043E\u0433.
      \u041A\u0442\u043E-\u0442\u043E \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u043E\u0442\u043E\u0448\u0451\u043B \u043D\u0430 \u0434\u0435\u0441\u044F\u0442\u044C
      \u0448\u0430\u0433\u043E\u0432 \u0438 \u043F\u0440\u043E\u043F\u0430\u043B
      \u0432 \u0436\u0451\u043B\u0442\u043E\u0439 \u043C\u0433\u043B\u0435. \u0421\u0442\u0430\u0440\u044B\u0439
      \u0431\u0435\u0434\u0443\u0438\u043D, \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439,
      \u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043B
      \u0441\u0430\u043C\u043E\u043E\u0431\u043B\u0430\u0434\u0430\u043D\u0438\u044F,
      \u0445\u0440\u0438\u043F\u0438\u0442 \u0441\u043A\u0432\u043E\u0437\u044C \u0442\u043A\u0430\u043D\u044C:\r\n\r\n<npc_speech
      lang=\"Arabic\">\u041D\u0435 \u0434\u0432\u0438\u0433\u0430\u0439\u0442\u0435\u0441\u044C!
      \u0417\u0430\u043A\u043E\u043F\u0430\u0439\u0442\u0435 \u043A\u043E\u043B\u0451\u0441\u0430
      \u0432 \u043F\u0435\u0441\u043E\u043A \u0438 \u0434\u0435\u0440\u0436\u0438\u0442\u0435\u0441\u044C!
      \u042D\u0442\u043E \u0445\u0430\u0431\u0443\u0431 - \u0431\u044B\u0441\u0442\u0440\u043E
      \u043E\u043D \u043D\u0435 \u043F\u0440\u043E\u0439\u0434\u0451\u0442!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060670
    m_Localized: "\u041F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C, \u0443\u043A\u0440\u044B\u0432\u0448\u0438\u0441\u044C
      \u0437\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060671
    m_Localized: "\u0414\u0432\u043E\u0435 \u0441\u0443\u0442\u043E\u043A \u0431\u0443\u0440\u044F
      \u0432\u044B\u043B\u0430 \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u0430\u043C\u0438.
      \u041F\u0435\u0441\u043E\u043A \u0437\u0430\u0441\u044B\u043F\u0430\u043B \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043F\u043E \u043E\u0441\u0438, \u0437\u0430\u0431\u0438\u043B\u0441\u044F
      \u0432 \u043A\u0430\u0436\u0434\u044B\u0439 \u043C\u0435\u0448\u043E\u043A
      \u0438 \u0431\u0443\u0440\u0434\u044E\u043A. \u0427\u0430\u0441\u0442\u044C
      \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432 \u0438\u0441\u043F\u043E\u0440\u0447\u0435\u043D\u0430:
      \u043C\u0443\u043A\u0430 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0430\u0441\u044C
      \u0432 \u0433\u0440\u044F\u0437\u043D\u0443\u044E \u043A\u0430\u0448\u0443,
      \u0432\u043E\u0434\u0430 \u0432 \u0431\u0443\u0440\u0434\u044E\u043A\u0430\u0445
      \u0445\u0440\u0443\u0441\u0442\u0438\u0442 \u043D\u0430 \u0437\u0443\u0431\u0430\u0445.
      \u041A\u043E\u0433\u0434\u0430 \u0432\u0435\u0442\u0435\u0440 \u0441\u0442\u0438\u0445,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0442\u043A\u043E\u043F\u0430\u043B\u0441\u044F
      \u0438 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B, \u0447\u0442\u043E
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0438\u0441\u0447\u0435\u0437\u043B\u0430
      - \u0431\u0430\u0440\u0445\u0430\u043D\u044B \u043F\u0435\u0440\u0435\u043A\u0440\u043E\u0438\u043B\u0438
      \u043F\u0443\u0441\u0442\u044B\u043D\u044E, \u0438 \u0441\u0442\u0430\u0440\u044B\u0435
      \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B \u0437\u0430\u0441\u044B\u043F\u0430\u043D\u044B.
      \u041B\u044E\u0434\u0438 \u0436\u0438\u0432\u044B, \u043D\u043E \u0438\u0437\u043C\u043E\u0442\u0430\u043D\u044B
      \u0438 \u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060672
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u0432\u044B\u0432\u0435\u0441\u0442\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0438\u0437 \u044D\u043F\u0438\u0446\u0435\u043D\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060673
    m_Localized: "\u0412\u0435\u0442\u0435\u0440 \u0434\u0443\u043B \u0441 \u0441\u0435\u0432\u0435\u0440\u043E-\u0437\u0430\u043F\u0430\u0434\u0430:
      \u0437\u043D\u0430\u0447\u0438\u0442, \u043A\u0440\u0430\u0439 \u0431\u0443\u0440\u0438
      \u043D\u0430 \u044E\u0433\u0435. \u0412\u044B \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043E\u043F\u0435\u0440\u0451\u043A
      \u0432\u0435\u0442\u0440\u0430, \u043F\u0440\u0438\u043A\u0440\u044B\u0432
      \u043C\u043E\u0440\u0434\u044B \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430\u043C
      \u043C\u043E\u043A\u0440\u044B\u043C\u0438 \u0442\u0440\u044F\u043F\u043A\u0430\u043C\u0438.
      \u0427\u0430\u0441 \u0441\u043B\u0435\u043F\u043E\u0433\u043E \u043C\u0430\u0440\u0448\u0430
      \u0441\u043A\u0432\u043E\u0437\u044C \u043F\u0435\u0441\u0447\u0430\u043D\u0443\u044E
      \u0441\u0442\u0435\u043D\u0443 - \u0438 \u0432\u0434\u0440\u0443\u0433 \u0442\u0438\u0448\u0438\u043D\u0430.
      \u0411\u0443\u0440\u044F \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0437\u0430
      \u0441\u043F\u0438\u043D\u043E\u0439, \u0440\u044B\u0436\u0438\u043C \u0441\u0442\u043E\u043B\u0431\u043E\u043C
      \u0443\u043F\u0438\u0440\u0430\u044E\u0449\u0438\u043C\u0441\u044F \u0432 \u043D\u0435\u0431\u043E.
      \u041F\u043E\u0442\u0435\u0440\u0438 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B:
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u0435\u0441\u043A\u0430 \u0432
      \u0433\u0440\u0443\u0437\u0435, \u043F\u0430\u0440\u0430 \u043B\u043E\u043F\u043D\u0443\u0432\u0448\u0438\u0445
      \u0432\u0435\u0440\u0451\u0432\u043E\u043A. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u043D\u0430 \u0432\u0430\u0441
      \u0441 \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u044B\u043C \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060674
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F,
      \u043D\u043E \u0431\u0443\u0440\u044F \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u0448\u0438\u0440\u0435, \u0447\u0435\u043C \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C.
      \u0412\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u044C \u0443\u043F\u0430\u043B\u0430
      \u0434\u043E \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u043E\u0439 \u0440\u0443\u043A\u0438.
      \u0412\u0435\u0440\u0451\u0432\u043A\u0438 \u043C\u0435\u0436\u0434\u0443 \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u043C\u0438
      \u043B\u043E\u043F\u043D\u0443\u043B\u0438, \u0437\u0430\u0434\u043D\u044F\u044F
      \u0442\u0435\u043B\u0435\u0433\u0430 \u043E\u0442\u0441\u0442\u0430\u043B\u0430
      \u0438 \u043F\u0435\u0440\u0435\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
      \u0432 \u043D\u0430\u043D\u043E\u0441\u0435. \u0412\u0435\u0440\u0431\u043B\u044E\u0434
      \u0441\u043E\u0440\u0432\u0430\u043B\u0441\u044F \u0441 \u043F\u0440\u0438\u0432\u044F\u0437\u0438
      \u0438 \u0438\u0441\u0447\u0435\u0437. \u041A\u043E\u0433\u0434\u0430 \u0431\u0443\u0440\u044F
      \u0443\u0442\u0438\u0445\u043B\u0430 \u0447\u0435\u0440\u0435\u0437 \u0441\u0443\u0442\u043A\u0438,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0431\u044B\u043B \u0440\u0430\u0437\u0431\u0440\u043E\u0441\u0430\u043D
      \u043F\u043E \u043F\u0443\u0441\u0442\u044B\u043D\u0435: \u043B\u044E\u0434\u0438,
      \u0442\u044E\u043A\u0438, \u043E\u0431\u043B\u043E\u043C\u043A\u0438, \u0432\u0441\u0451
      \u0432\u043F\u0435\u0440\u0435\u043C\u0435\u0448\u043A\u0443 \u0441 \u043F\u0435\u0441\u043A\u043E\u043C.
      \u0421\u0431\u043E\u0440 \u0437\u0430\u043D\u044F\u043B \u043F\u043E\u043B\u0434\u043D\u044F.
      \u0427\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430 \u043D\u0435
      \u043D\u0430\u0448\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060675
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0443\u0435\u0442
      \u043E\u0431\u043E\u0440\u043E\u043D\u0443 \u043B\u0430\u0433\u0435\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060676
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u043B
      \u0431\u044B\u0441\u0442\u0440\u043E, \u0435\u0449\u0451 \u0434\u043E \u0442\u043E\u0433\u043E,
      \u043A\u0430\u043A \u0441\u0442\u0435\u043D\u0430 \u043F\u0435\u0441\u043A\u0430
      \u043D\u0430\u043A\u0440\u044B\u043B\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0438 \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0438
      \u0432 \u043A\u0440\u0443\u0433, \u043A\u043E\u043B\u0451\u0441\u0430 \u0437\u0430\u043A\u043B\u0438\u043D\u0438\u043B\u0438
      \u043A\u0430\u043C\u043D\u044F\u043C\u0438, \u043C\u0435\u0436\u0434\u0443
      \u0431\u043E\u0440\u0442\u0430\u043C\u0438 \u043D\u0430\u0442\u044F\u043D\u0443\u043B\u0438
      \u0431\u0440\u0435\u0437\u0435\u043D\u0442. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432
      \u0443\u043B\u043E\u0436\u0438\u043B\u0438 \u0432\u043D\u0443\u0442\u0440\u044C
      \u043A\u0440\u0443\u0433\u0430 \u0438 \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043B\u0438
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C\u0438 \u043F\u043E\u0432\u043E\u0434\u044C\u044F\u043C\u0438.
      \u0422\u044E\u043A\u0438 \u043E\u0431\u0432\u044F\u0437\u0430\u043B\u0438 \u0434\u0432\u043E\u0439\u043D\u044B\u043C\u0438
      \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u043C\u0438 \u0438 \u043F\u0440\u0438\u043A\u0440\u044B\u043B\u0438
      \u0448\u043A\u0443\u0440\u0430\u043C\u0438. \u041A\u043E\u0433\u0434\u0430
      \u0431\u0443\u0440\u044F \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0430\u0441\u044C,
      \u0443\u043A\u0440\u0435\u043F\u043B\u0451\u043D\u043D\u044B\u0439 \u043B\u0430\u0433\u0435\u0440\u044C
      \u0432\u044B\u0441\u0442\u043E\u044F\u043B. \u041F\u0435\u0441\u043E\u043A
      \u0437\u0430\u043D\u043E\u0441\u0438\u043B \u0441\u0442\u0435\u043D\u044B,
      \u043D\u043E \u0433\u0440\u0443\u0437 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u0441\u0443\u0445\u0438\u043C, \u0441\u043A\u043E\u0442 - \u0446\u0435\u043B\u044B\u043C.
      \u0427\u0435\u0440\u0435\u0437 \u0434\u0432\u043E\u0435 \u0441\u0443\u0442\u043E\u043A
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435, \u043F\u043E\u0442\u0435\u0440\u044F\u0432
      \u043B\u0438\u0448\u044C \u0432\u0440\u0435\u043C\u044F \u0438 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060677
    m_Localized: "\u0417\u0435\u043C\u043B\u0435\u0442\u0440\u044F\u0441\u0435\u043D\u0438\u0435
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060678
    m_Localized: "\u0417\u0435\u043C\u043B\u044F \u0434\u0440\u043E\u0433\u043D\u0443\u043B\u0430
      \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F
      - \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u0442\u043E\u043B\u0447\u043E\u043A,
      \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0437\u0430\u0437\u0432\u0435\u043D\u0435\u043B\u0430
      \u0443\u043F\u0440\u044F\u0436\u044C \u0438 \u0437\u0430\u0445\u0440\u0438\u043F\u0435\u043B\u0438
      \u044F\u043A\u0438. \u041F\u043E\u0442\u043E\u043C \u0432\u0442\u043E\u0440\u043E\u0439,
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435. \u041F\u043E\u0442\u043E\u043C
      \u0442\u0440\u0435\u0442\u0438\u0439: \u043F\u0440\u043E\u0442\u044F\u0436\u043D\u044B\u0439,
      \u0433\u043B\u0443\u0431\u0438\u043D\u043D\u044B\u0439, \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u0442\u0440\u043E\u043F\u0430 \u043F\u043E\u0448\u043B\u0430 \u0442\u0440\u0435\u0449\u0438\u043D\u0430\u043C\u0438.
      \u0421 \u043E\u0431\u0440\u044B\u0432\u0430 \u043F\u043E\u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C
      \u043A\u0430\u043C\u043D\u0438: \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u043C\u0435\u043B\u043A\u0430\u044F \u0449\u0435\u0431\u0451\u043D\u043A\u0430,
      \u043F\u043E\u0442\u043E\u043C \u0432\u0430\u043B\u0443\u043D\u044B, \u0433\u0443\u043B\u043A\u043E
      \u043F\u0440\u044B\u0433\u0430\u044E\u0449\u0438\u0435 \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443.
      \u041F\u044B\u043B\u044C \u043F\u043E\u0434\u043D\u044F\u043B\u0430\u0441\u044C
      \u0441\u0442\u0435\u043D\u043E\u0439, \u0437\u0430\u043A\u0440\u044B\u0432
      \u043D\u0435\u0431\u043E. \u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u0443\u0447\u0430\u0441\u0442\u043E\u043A
      \u0442\u0440\u043E\u043F\u044B \u043F\u0440\u043E\u0441\u0435\u043B, \u043E\u0431\u043D\u0430\u0436\u0438\u0432
      \u0447\u0451\u0440\u043D\u044B\u0439 \u043F\u0440\u043E\u0432\u0430\u043B.
      \u041F\u043E\u0437\u0430\u0434\u0438 \u043E\u0441\u044B\u043F\u044C \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u043B\u0430
      \u043F\u0443\u0442\u044C \u0432\u0430\u043B\u0443\u043D\u0430\u043C\u0438 \u0432
      \u0440\u043E\u0441\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432-\u0442\u0438\u0431\u0435\u0442\u0446\u0435\u0432
      \u0437\u0430\u0436\u0438\u043C\u0430\u0435\u0442 \u0440\u0430\u0437\u0431\u0438\u0442\u043E\u0435
      \u043F\u043B\u0435\u0447\u043E, \u0435\u0433\u043E \u044F\u043A \u043B\u0435\u0436\u0438\u0442
      \u043D\u0430 \u0431\u043E\u043A\u0443, \u043F\u0440\u0438\u0434\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
      \u043E\u0431\u043B\u043E\u043C\u043A\u043E\u043C \u0441\u043A\u0430\u043B\u044B.
      \u0421\u0442\u0430\u0440\u044B\u0439 \u043F\u0430\u0441\u0442\u0443\u0445 \u043F\u043E\u0431\u0435\u043B\u0435\u0432\u0448\u0438\u043C\u0438
      \u0433\u0443\u0431\u0430\u043C\u0438 \u0448\u0435\u043F\u0447\u0435\u0442:\r\n\r\n<npc_speech
      lang=\"Tibetan\">\u0417\u0435\u043C\u043B\u0435\u0442\u0440\u044F\u0441\u0435\u043D\u0438\u0435!
      \u0413\u043E\u0440\u043D\u044B\u0439 \u0434\u0443\u0445 \u0440\u0430\u0437\u0433\u043D\u0435\u0432\u0430\u043B\u0441\u044F!
      \u041D\u0443\u0436\u043D\u043E \u043C\u043E\u043B\u0438\u0442\u044C\u0441\u044F!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060679
    m_Localized: "\u0420\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0437\u0430\u0432\u0430\u043B
      \u0438 \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u0442\u044C \u0440\u0430\u043D\u0435\u043D\u044B\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060680
    m_Localized: "\u0414\u0432\u043E\u0435 \u0441\u0443\u0442\u043E\u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u043B\u0438 \u0437\u0430\u0432\u0430\u043B
      \u0433\u043E\u043B\u044B\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438:
      \u043A\u0430\u043C\u0435\u043D\u044C \u0437\u0430 \u043A\u0430\u043C\u043D\u0435\u043C,
      \u0432 \u043F\u044B\u043B\u0438 \u0438 \u0445\u043E\u043B\u043E\u0434\u0435.
      \u0420\u0430\u043D\u0435\u043D\u043E\u0433\u043E \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430
      \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043B\u0438 \u043F\u043E\u043B\u043E\u0441\u0430\u043C\u0438
      \u043E\u0442 \u0440\u0443\u0431\u0430\u0445, \u043D\u043E \u043F\u043B\u0435\u0447\u043E
      \u043E\u043F\u0443\u0445\u043B\u043E \u0438 \u043F\u043E\u0441\u0438\u043D\u0435\u043B\u043E.
      \u041F\u0440\u0438\u0434\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0433\u043E
      \u044F\u043A\u0430 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0437\u0430\u0431\u0438\u0442\u044C
      - \u043C\u044F\u0441\u0430 \u0445\u0432\u0430\u0442\u0438\u0442, \u043D\u043E
      \u0432\u044C\u044E\u0447\u043D\u043E\u0433\u043E \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0433\u043E
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0442. \u041A \u0438\u0441\u0445\u043E\u0434\u0443
      \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E \u0434\u043D\u044F \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u043B\u0438
      \u0443\u0437\u043A\u0438\u0439 \u043F\u0440\u043E\u0445\u043E\u0434: \u043F\u0440\u043E\u0442\u0438\u0441\u043D\u0443\u0442\u044C\u0441\u044F
      \u043C\u043E\u0436\u043D\u043E, \u043D\u043E \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043E\u0431\u043E\u0434\u0440\u0430\u043B\u0438 \u0431\u043E\u0440\u0442\u0430
      \u043E \u043A\u0430\u043C\u043D\u0438. \u041B\u044E\u0434\u0438 \u0432\u044B\u043C\u043E\u0442\u0430\u043D\u044B
      \u0434\u043E \u043F\u0440\u0435\u0434\u0435\u043B\u0430, \u043F\u0430\u043B\u044C\u0446\u044B
      \u0432 \u043A\u0440\u043E\u0432\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060681
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u043E\u0431\u0445\u043E\u0434\u043D\u043E\u0439
      \u043F\u0443\u0442\u044C \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060682
    m_Localized: "\u0412\u044B\u0448\u0435 \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443,
      \u0437\u0430 \u043D\u0430\u0433\u0440\u043E\u043C\u043E\u0436\u0434\u0435\u043D\u0438\u0435\u043C
      \u0432\u0430\u043B\u0443\u043D\u043E\u0432, \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0441\u044F
      \u043A\u043E\u0437\u0438\u0439 \u043B\u0430\u0437 - \u0443\u0437\u043A\u0430\u044F
      \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0430 \u043C\u0435\u0436\u0434\u0443
      \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u043C\u0438 \u043F\u043B\u0438\u0442\u0430\u043C\u0438,
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0448\u0438\u0440\u043E\u043A\u0430\u044F
      \u0434\u043B\u044F \u044F\u043A\u0430 \u0431\u0435\u0437 \u0432\u044C\u044E\u043A\u0430.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0438 \u0440\u0430\u0437\u0433\u0440\u0443\u0437\u0438\u043B\u0438,
      \u043F\u0440\u043E\u0442\u0430\u0449\u0438\u043B\u0438 \u043F\u043E \u0447\u0430\u0441\u0442\u044F\u043C,
      \u0433\u0440\u0443\u0437 \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u043B\u0438
      \u043D\u0430 \u0440\u0443\u043A\u0430\u0445. \u0420\u0430\u0431\u043E\u0442\u0430
      \u0437\u0430\u043D\u044F\u043B\u0430 \u0434\u0435\u043D\u044C, \u043D\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0431\u043E\u0448\u0451\u043B
      \u0437\u0430\u0432\u0430\u043B \u0431\u0435\u0437 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u044B\u0445
      \u043F\u043E\u0442\u0435\u0440\u044C. \u0412 \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0435,
      \u043E\u0431\u043D\u0430\u0436\u0451\u043D\u043D\u043E\u0439 \u0437\u0435\u043C\u043B\u0435\u0442\u0440\u044F\u0441\u0435\u043D\u0438\u0435\u043C,
      \u0431\u043B\u0435\u0441\u043D\u0443\u043B \u0431\u0438\u0440\u044E\u0437\u043E\u0432\u044B\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C, \u0447\u0438\u0441\u0442\u044B\u0439,
      \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C \u0441 \u043A\u0443\u043B\u0430\u043A.
      \u0413\u043E\u0440\u044B \u0432\u0437\u044F\u043B\u0438, \u043D\u043E \u0438
      \u0434\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060683
    m_Localized: "\u0421\u043A\u043B\u043E\u043D \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043D\u0435\u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u043C: \u0432\u0442\u043E\u0440\u0438\u0447\u043D\u044B\u0439
      \u043E\u0431\u0432\u0430\u043B \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0431\u044B\u043B
      \u043D\u0430 \u043F\u043E\u043B\u043F\u0443\u0442\u0438. \u041A\u0430\u043C\u043D\u0438
      \u043F\u043E\u043A\u0430\u0442\u0438\u043B\u0438\u0441\u044C \u0432\u043D\u0438\u0437,
      \u043B\u043E\u043C\u0430\u044F \u0431\u043E\u0440\u0442\u0430 \u043F\u043E\u0432\u043E\u0437\u043E\u043A
      \u0438 \u043A\u0430\u043B\u0435\u0447\u0430 \u043B\u044E\u0434\u0435\u0439.
      \u041B\u0435\u043A\u0430\u0440\u044C, \u0448\u0435\u0434\u0448\u0438\u0439
      \u0437\u0430\u043C\u044B\u043A\u0430\u044E\u0449\u0438\u043C, \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0443\u0434\u0430\u0440 \u043E\u0431\u043B\u043E\u043C\u043A\u043E\u043C \u0432
      \u0431\u043E\u043A \u0438 \u0435\u0434\u0432\u0430 \u0443\u0441\u0442\u043E\u044F\u043B
      \u043D\u0430 \u043D\u043E\u0433\u0430\u0445. \u0422\u0435\u043B\u0435\u0433\u0438
      \u043F\u043E\u043C\u044F\u0442\u044B, \u043E\u0434\u043D\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430 \u043A\u043E\u043B\u0435\u0441\u043E.
      \u0421\u043F\u0443\u0441\u0442\u0438\u043B\u0438\u0441\u044C \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u043D\u0430 \u043A\u0430\u0440\u043D\u0438\u0437 - \u0441 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C\u0438
      \u0440\u0430\u043D\u0435\u043D\u044B\u043C\u0438 \u0438 \u0431\u0435\u0437
      \u043E\u0431\u0445\u043E\u0434\u043D\u043E\u0433\u043E \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060684
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0441\u043F\u0430\u0441\u0430\u0435\u0442
      \u0440\u0430\u043D\u0435\u043D\u044B\u0445 \u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u0442
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0439 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060685
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u043B
      \u0441\u0440\u0430\u0437\u0443 \u043D\u0430 \u0434\u0432\u0443\u0445 \u0444\u0440\u043E\u043D\u0442\u0430\u0445.
      \u041F\u043E\u043A\u0430 \u043E\u043D \u0432\u043F\u0440\u0430\u0432\u043B\u044F\u043B
      \u043F\u043B\u0435\u0447\u043E \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0443
      (\u0431\u044B\u0441\u0442\u0440\u043E, \u0443\u043C\u0435\u043B\u043E, \u043F\u0440\u0438\u043C\u043E\u0442\u0430\u0432
      \u0440\u0443\u043A\u0443 \u043A \u0442\u0435\u043B\u0443 \u043F\u043E\u043B\u043E\u0441\u0430\u043C\u0438
      \u0448\u0435\u0440\u0441\u0442\u0438 \u0438 \u043D\u0430\u043B\u043E\u0436\u0438\u0432
      \u0448\u0438\u043D\u0443 \u0438\u0437 \u0440\u0430\u0441\u0449\u0435\u043F\u043B\u0451\u043D\u043D\u043E\u0439
      \u0436\u0435\u0440\u0434\u0438), \u0435\u0433\u043E \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A
      \u043E\u0431\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B \u0437\u0430\u0432\u0430\u043B.
      \u041B\u0435\u043A\u0430\u0440\u044C \u0437\u043D\u0430\u043B: \u0442\u0440\u0435\u0449\u0438\u043D\u044B
      \u043F\u043E\u0441\u043B\u0435 \u0437\u0435\u043C\u043B\u0435\u0442\u0440\u044F\u0441\u0435\u043D\u0438\u044F
      \u0447\u0430\u0441\u0442\u043E \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442
      \u043F\u0440\u043E\u0445\u043E\u0434\u044B, \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
      \u043F\u0440\u0435\u0436\u0434\u0435. \u0422\u0430\u043A \u0438 \u0432\u044B\u0448\u043B\u043E.
      \u0417\u0430 \u043A\u0440\u0443\u043F\u043D\u044B\u043C \u0432\u0430\u043B\u0443\u043D\u043E\u043C
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0441\u044F \u0440\u0430\u0437\u043B\u043E\u043C,
      \u0432\u0435\u0434\u0443\u0449\u0438\u0439 \u043D\u0430 \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u0443\u044E
      \u0442\u0440\u043E\u043F\u0443 \u0432\u044B\u0448\u0435 \u043E\u0431\u0432\u0430\u043B\u0430.
      \u041F\u0440\u043E\u0445\u043E\u0434 \u0442\u0435\u0441\u043D\u044B\u0439,
      \u043D\u043E \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043F\u0440\u043E\u0448\u043B\u0438,
      \u0430 \u0440\u0430\u043D\u0435\u043D\u044B\u0439 \u043A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0448\u0435\u0432\u0435\u043B\u0438\u043B \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438.
      \xAB\u041A\u043E\u0441\u0442\u0438 \u0446\u0435\u043B\u044B. \u0427\u0435\u0440\u0435\u0437
      \u043D\u0435\u0434\u0435\u043B\u044E \u0431\u0443\u0434\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060686
    m_Localized: "\u0423\u0434\u0430\u0440 \u043C\u043E\u043B\u043D\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060687
    m_Localized: "\u0413\u0440\u043E\u0437\u0430 \u043D\u0430\u043B\u0435\u0442\u0435\u043B\u0430
      \u0438\u0437 \u043D\u0438\u043E\u0442\u043A\u0443\u0434\u0430: \u043D\u0435\u0431\u043E
      \u0440\u0430\u0441\u043A\u043E\u043B\u043E\u043B\u043E\u0441\u044C \u0431\u0435\u043B\u043E\u0439
      \u0432\u0441\u043F\u044B\u0448\u043A\u043E\u0439, \u0438 \u0443\u0434\u0430\u0440
      \u0433\u0440\u043E\u043C\u0430 \u0432\u0431\u0438\u043B \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0432 \u0437\u0435\u043C\u043B\u044E. \u041C\u043E\u043B\u043D\u0438\u044F
      \u0443\u0434\u0430\u0440\u0438\u043B\u0430 \u0432 \u043F\u0435\u0440\u0435\u0434\u043D\u044E\u044E
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443. \u0422\u0440\u0435\u0441\u043A,
      \u0432\u0441\u043F\u044B\u0448\u043A\u0430, \u0437\u0430\u043F\u0430\u0445
      \u043F\u0430\u043B\u0451\u043D\u043E\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u0430
      \u0438 \u0433\u043E\u0440\u0435\u043B\u043E\u0439 \u0448\u0435\u0440\u0441\u0442\u0438.
      \u0411\u0440\u0435\u0437\u0435\u043D\u0442 \u0437\u0430\u043D\u044F\u043B\u0441\u044F
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E: \u0441\u0443\u0445\u0430\u044F
      \u0442\u043A\u0430\u043D\u044C, \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D\u043D\u0430\u044F
      \u043C\u0430\u0441\u043B\u043E\u043C, \u043F\u043E\u043B\u044B\u0445\u043D\u0443\u043B\u0430
      \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u044B\u043C \u0441\u0442\u043E\u043B\u0431\u043E\u043C.
      \u0412\u043E\u043B\u044B \u0440\u0432\u0430\u043D\u0443\u043B\u0438\u0441\u044C,
      \u043F\u043E\u0440\u0432\u0430\u0432 \u043F\u043E\u0441\u0442\u0440\u043E\u043C\u043A\u0438,
      \u0438 \u043F\u043E\u043D\u0435\u0441\u043B\u0438\u0441\u044C \u0432 \u043F\u043E\u043B\u0435.
      \u0422\u044E\u043A\u0438 \u0433\u043E\u0440\u044F\u0442, \u043F\u043B\u0430\u043C\u044F
      \u0436\u0430\u0434\u043D\u043E \u043B\u0438\u0436\u0435\u0442 \u043C\u0435\u0448\u043A\u043E\u0432\u0438\u043D\u0443,
      \u0434\u043E\u0431\u0438\u0440\u0430\u044F\u0441\u044C \u0434\u043E \u0442\u043E\u0432\u0430\u0440\u0430.
      \u0414\u043E\u0436\u0434\u044C \u0445\u043B\u0435\u0449\u0435\u0442, \u043D\u043E
      \u043E\u0433\u043E\u043D\u044C \u043F\u043E\u043A\u0430 \u0441\u0438\u043B\u044C\u043D\u0435\u0435.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u043C\u0435\u0447\u0443\u0442\u0441\u044F
      \u043C\u0435\u0436\u0434\u0443 \u0441\u043F\u0430\u0441\u0435\u043D\u0438\u0435\u043C
      \u0433\u0440\u0443\u0437\u0430 \u0438 \u0442\u0443\u0448\u0435\u043D\u0438\u0435\u043C
      \u043F\u043E\u0436\u0430\u0440\u0430: \u0440\u0443\u043A \u043D\u0430 \u0432\u0441\u0451
      \u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060688
    m_Localized: "\u0421\u043F\u0430\u0441\u0430\u0442\u044C \u0442\u043E, \u0447\u0442\u043E
      \u043C\u043E\u0436\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060689
    m_Localized: "\u041F\u043E\u0434 \u0434\u043E\u0436\u0434\u0451\u043C, \u0432
      \u0434\u044B\u043C\u0443 \u0438 \u043A\u043E\u043F\u043E\u0442\u0438, \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0432\u044B\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u043B\u0438 \u0442\u044E\u043A\u0438
      \u0438\u0437 \u043F\u043B\u0430\u043C\u0435\u043D\u0438: \u043E\u0431\u0436\u0438\u0433\u0430\u043B\u0438
      \u0440\u0443\u043A\u0438, \u043A\u0430\u0448\u043B\u044F\u043B\u0438, \u0441\u043F\u043E\u0442\u044B\u043A\u0430\u043B\u0438\u0441\u044C
      \u043E \u0440\u0430\u0441\u043A\u0438\u0434\u0430\u043D\u043D\u044B\u0439 \u0433\u0440\u0443\u0437.
      \u0427\u0430\u0441\u0442\u044C \u0442\u043E\u0432\u0430\u0440\u0430 \u0441\u043F\u0430\u0441\u043B\u0438,
      \u043D\u043E \u043E\u0434\u0438\u043D \u0442\u044E\u043A \u0441\u0433\u043E\u0440\u0435\u043B
      \u0434\u043E\u0442\u043B\u0430, \u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043E\u0431\u0443\u0433\u043B\u0438\u043B\u0430\u0441\u044C \u0434\u043E \u043A\u0430\u0440\u043A\u0430\u0441\u0430
      \u0441 \u043E\u0434\u043D\u043E\u0433\u043E \u0431\u043E\u043A\u0430. \u0412\u043E\u043B\u043E\u0432
      \u043F\u043E\u0439\u043C\u0430\u043B\u0438 \u043A \u0443\u0442\u0440\u0443:
      \u0434\u0440\u043E\u0436\u0430\u0449\u0438\u0445, \u0441 \u043E\u0431\u043E\u0436\u0436\u0451\u043D\u043D\u044B\u043C\u0438
      \u0431\u043E\u043A\u0430\u043C\u0438. \u041B\u044E\u0434\u0438 \u0441\u0438\u0434\u044F\u0442
      \u0443 \u0434\u044B\u043C\u044F\u0449\u0438\u0445\u0441\u044F \u043E\u0441\u0442\u0430\u043D\u043A\u043E\u0432
      \u0438 \u043C\u043E\u043B\u0447\u0430 \u0441\u0447\u0438\u0442\u0430\u044E\u0442
      \u0443\u0431\u044B\u0442\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060690
    m_Localized: "\u0420\u0438\u0441\u043A\u043D\u0443\u0442\u044C \u0438 \u0442\u0443\u0448\u0438\u0442\u044C
      \u043F\u043E\u0436\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060691
    m_Localized: "\u041E\u043F\u044B\u0442\u043D\u044B\u0439 \u0433\u043B\u0430\u0437
      \u043E\u0446\u0435\u043D\u0438\u043B \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E:
      \u0447\u0442\u043E \u0433\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u0435\u0449\u0451
      \u043C\u043E\u0436\u043D\u043E \u0441\u043F\u0430\u0441\u0442\u0438, \u0447\u0442\u043E
      \u0443\u0436\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E. \u0412\u044B
      \u0441\u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0432\u0430\u043B\u0438: \u0434\u0432\u043E\u0435
      \u043D\u0430 \u0442\u0443\u0448\u0435\u043D\u0438\u0435, \u0442\u0440\u043E\u0435
      \u0432\u044B\u043D\u043E\u0441\u044F\u0442 \u0441\u0430\u043C\u044B\u0439 \u0446\u0435\u043D\u043D\u044B\u0439
      \u0442\u043E\u0432\u0430\u0440, \u043E\u0434\u0438\u043D \u043B\u043E\u0432\u0438\u0442
      \u0432\u043E\u043B\u043E\u0432. \u041C\u043E\u043A\u0440\u044B\u0435 \u043E\u0434\u0435\u044F\u043B\u0430
      \u0437\u0430\u0434\u0443\u0448\u0438\u043B\u0438 \u043F\u043B\u0430\u043C\u044F
      \u043F\u0440\u0435\u0436\u0434\u0435, \u0447\u0435\u043C \u043E\u0433\u043E\u043D\u044C
      \u0434\u043E\u0431\u0440\u0430\u043B\u0441\u044F \u0434\u043E \u0448\u0451\u043B\u043A\u0430
      \u0438 \u0444\u0430\u0440\u0444\u043E\u0440\u0430. \u041F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0437\u0430\u043A\u043E\u043F\u0447\u0435\u043D\u0430, \u043F\u0430\u0440\u0430
      \u043C\u0435\u0448\u043A\u043E\u0432 \u0441 \u043C\u0443\u043A\u043E\u0439
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u0430, \u043D\u043E \u0434\u043E\u0440\u043E\u0433\u043E\u0439
      \u0433\u0440\u0443\u0437 \u0446\u0435\u043B. \u041D\u0430 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C
      \u0440\u044B\u043D\u043A\u0435 \u043F\u043E\u0434\u0433\u043E\u0440\u0435\u0432\u0448\u0438\u0435
      \u043E\u0441\u0442\u0430\u0442\u043A\u0438 \u0443\u0439\u0434\u0443\u0442 \u043A\u0430\u043A
      \u0443\u0446\u0435\u043D\u0451\u043D\u043D\u044B\u0439 \u0442\u043E\u0432\u0430\u0440:
      \u043C\u0435\u043B\u043E\u0447\u044C, \u043D\u043E \u043D\u0435 \u0432 \u0443\u0431\u044B\u0442\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060692
    m_Localized: "\u041F\u043E\u043A\u0430 \u0432\u044B \u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0432\u0430\u043B\u0438
      \u0442\u0443\u0448\u0435\u043D\u0438\u0435\u043C, \u0432\u0435\u0442\u0435\u0440
      \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u0438\u043B\u0441\u044F \u0438 \u0448\u0432\u044B\u0440\u043D\u0443\u043B
      \u043F\u043B\u0430\u043C\u044F \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439
      \u0431\u043E\u0440\u0442. \u041E\u0433\u043E\u043D\u044C \u043E\u0445\u0432\u0430\u0442\u0438\u043B
      \u0432\u0441\u044E \u043F\u043E\u0432\u043E\u0437\u043A\u0443 \u0437\u0430
      \u043C\u0438\u043D\u0443\u0442\u044B. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0435\u0434\u0432\u0430 \u0443\u0441\u043F\u0435\u043B\u0438 \u043E\u0442\u0441\u043A\u043E\u0447\u0438\u0442\u044C:
      \u0431\u0440\u043E\u0432\u0438 \u043E\u043F\u0430\u043B\u0435\u043D\u044B,
      \u0440\u0443\u043A\u0438 \u0432 \u0432\u043E\u043B\u0434\u044B\u0440\u044F\u0445.
      \u041A\u043E\u0433\u0434\u0430 \u0434\u043E\u0436\u0434\u044C \u043D\u0430\u043A\u043E\u043D\u0435\u0446
      \u043F\u0440\u0438\u0434\u0430\u0432\u0438\u043B \u043F\u043B\u0430\u043C\u044F,
      \u043E\u0442 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B \u0433\u0440\u0443\u0437\u0430
      \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0433\u043E\u043B\u043E\u0432\u0435\u0448\u043A\u0438
      \u0438 \u043C\u043E\u043A\u0440\u044B\u0439 \u043F\u0435\u043F\u0435\u043B.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0430 \u043E\u0431\u0443\u0433\u043B\u0435\u043D\u043D\u044B\u0439
      \u043E\u0441\u0442\u043E\u0432: \u043D\u0430 \u043D\u0435\u0439 \u0435\u0449\u0451
      \u043C\u043E\u0436\u043D\u043E \u0435\u0445\u0430\u0442\u044C, \u043D\u043E
      \u0432\u043F\u0440\u0438\u0442\u044B\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060693
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0441\u043F\u0430\u0441\u0430\u0442\u044C \u043F\u0435\u0440\u0432\u044B\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060694
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043D\u0435 \u0431\u0440\u043E\u0441\u0438\u043B\u0441\u044F
      \u0442\u0443\u0448\u0438\u0442\u044C, \u043E\u043D \u0431\u0440\u043E\u0441\u0438\u043B\u0441\u044F
      \u0441\u0447\u0438\u0442\u0430\u0442\u044C. \u0417\u0430 \u0442\u0440\u0438
      \u0443\u0434\u0430\u0440\u0430 \u0441\u0435\u0440\u0434\u0446\u0430 \u043E\u043D
      \u043E\u0446\u0435\u043D\u0438\u043B \u043A\u0430\u0436\u0434\u044B\u0439 \u0442\u044E\u043A:
      \xAB\u0428\u0451\u043B\u043A \u043D\u0430\u043B\u0435\u0432\u043E, \u0444\u0430\u0440\u0444\u043E\u0440
      \u043D\u0430\u043F\u0440\u0430\u0432\u043E, \u043C\u0443\u043A\u0443 \u0431\u0440\u043E\u0441\u0430\u0439,
      \u043E\u043D\u0430 \u0443\u0436\u0435 \u043C\u043E\u043A\u0440\u0430\u044F!\xBB
      \u0415\u0433\u043E \u043A\u043E\u043C\u0430\u043D\u0434\u044B \u0440\u0435\u0437\u0430\u043B\u0438
      \u0432\u043E\u0437\u0434\u0443\u0445, \u043A\u0430\u043A \u043D\u043E\u0436\u0438.
      \u0426\u0435\u043D\u043D\u044B\u0439 \u0442\u043E\u0432\u0430\u0440 \u0432\u044B\u043D\u0435\u0441\u043B\u0438
      \u043F\u0435\u0440\u0432\u044B\u043C, \u0434\u0435\u0448\u0451\u0432\u044B\u0439
      \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u043E\u0433\u043D\u044E.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0430 \u043E\u0431\u0433\u043E\u0440\u0435\u043B\u0430,
      \u043D\u043E \u0443\u0446\u0435\u043B\u0435\u0432\u0448\u0438\u0435 \u0442\u044E\u043A\u0438
      \u0434\u0435\u0440\u0436\u0430\u043B\u0438 \u0441\u0430\u043C\u043E\u0435 \u0434\u043E\u0440\u043E\u0433\u043E\u0435.
      \xAB\u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0433\u0440\u043E\u0448\u0438,
      \u0441\u043F\u0430\u0441\u043B\u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u043E\xBB,
      \u0441\u043A\u0430\u0437\u0430\u043B \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446,
      \u0432\u044B\u0442\u0438\u0440\u0430\u044F \u043A\u043E\u043F\u043E\u0442\u044C
      \u0441\u043E \u043B\u0431\u0430. \xAB\u041D\u0430 \u0440\u044B\u043D\u043A\u0435
      \u0440\u0430\u0437\u043D\u0438\u0446\u0430 \u0431\u0443\u0434\u0435\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0439.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060695
    m_Localized: "\u0417\u0430\u0441\u0430\u0434\u0430 \u0432 \u043A\u0430\u043D\u044C\u043E\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060696
    m_Localized: "\u041A\u0430\u043D\u044C\u043E\u043D \u0441\u0443\u0436\u0430\u0435\u0442\u0441\u044F:
      \u043E\u0442\u0432\u0435\u0441\u043D\u044B\u0435 \u0441\u0442\u0435\u043D\u044B
      \u0438\u0437 \u0440\u044B\u0436\u0435\u0433\u043E \u043F\u0435\u0441\u0447\u0430\u043D\u0438\u043A\u0430
      \u0441\u043C\u044B\u043A\u0430\u044E\u0442\u0441\u044F \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439,
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u043F\u043E\u043B\u043E\u0441\u043A\u0443
      \u0431\u0435\u043B\u0451\u0441\u043E\u0433\u043E \u043D\u0435\u0431\u0430.
      \u0422\u0438\u0448\u0438\u043D\u0430 \u0434\u0430\u0432\u0438\u0442 \u043D\u0430
      \u0443\u0448\u0438: \u043D\u0438 \u0432\u0435\u0442\u0440\u0430, \u043D\u0438
      \u043F\u0442\u0438\u0446, \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043A\u0440\u0438\u043F
      \u043A\u043E\u043B\u0451\u0441\u043D\u044B\u0445 \u043E\u0441\u0435\u0439.
      \u041F\u0435\u0440\u0435\u0434\u043D\u0438\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u0432\u0441\u0442\u0430\u043B, \u0440\u0430\u0437\u0434\u0443\u0432\u0430\u044F
      \u043D\u043E\u0437\u0434\u0440\u0438. \u041F\u043E\u0442\u043E\u043C - \u0441\u0432\u0438\u0441\u0442.
      \u0421\u0442\u0440\u0435\u043B\u0430 \u0432\u043E\u043D\u0437\u0438\u043B\u0430\u0441\u044C
      \u0432 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439 \u0431\u043E\u0440\u0442
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043D\u0430 \u043B\u0430\u0434\u043E\u043D\u044C
      \u043E\u0442 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430. \u041D\u0430
      \u0433\u0440\u0435\u0431\u043D\u044F\u0445 \u043A\u0430\u043D\u044C\u043E\u043D\u0430
      \u0448\u0435\u0432\u0435\u043B\u044F\u0442\u0441\u044F \u0444\u0438\u0433\u0443\u0440\u044B
      \u0432 \u043A\u043E\u0436\u0430\u043D\u044B\u0445 \u0431\u0435\u0437\u0440\u0443\u043A\u0430\u0432\u043A\u0430\u0445
      \u0438 \u043C\u0435\u0445\u043E\u0432\u044B\u0445 \u0448\u0430\u043F\u043A\u0430\u0445,
      \u0441 \u0441\u043E\u0441\u0442\u0430\u0432\u043D\u044B\u043C\u0438 \u043B\u0443\u043A\u0430\u043C\u0438
      \u043D\u0430\u0438\u0437\u0433\u043E\u0442\u043E\u0432\u043A\u0443. \u0418\u0445
      \u043D\u0435 \u043C\u0435\u043D\u044C\u0448\u0435 \u0434\u044E\u0436\u0438\u043D\u044B.
      \u0425\u0440\u0438\u043F\u043B\u044B\u0439 \u0433\u043E\u043B\u043E\u0441 \u0441\u0432\u0435\u0440\u0445\u0443:\r\n\r\n<npc_speech
      lang=\"Turkic\">\u0421\u0442\u043E\u0439, \u043F\u0443\u0442\u043D\u0438\u043A!
      \u041E\u0442\u0434\u0430\u0432\u0430\u0439 \u0437\u043E\u043B\u043E\u0442\u043E
      - \u0438\u043B\u0438 \u043F\u043E\u0441\u044B\u043F\u043B\u044E\u0442\u0441\u044F
      \u0441\u0442\u0440\u0435\u043B\u044B!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060697
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u043A\u043E\u0448\u0435\u043B\u044C
      \u0438 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060698
    m_Localized: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u043A\u043E\u0448\u0435\u043B\u044C
      \u043E\u043F\u0438\u0441\u0430\u043B \u0434\u0443\u0433\u0443 \u0438 \u0437\u0432\u044F\u043A\u043D\u0443\u043B
      \u043E \u043A\u0430\u043C\u043D\u0438 \u0443 \u0441\u0442\u0435\u043D\u044B
      \u043A\u0430\u043D\u044C\u043E\u043D\u0430. \u0421\u0435\u043A\u0443\u043D\u0434\u0430
      \u0442\u0438\u0448\u0438\u043D\u044B. \u041F\u043E\u0442\u043E\u043C \u043E\u0434\u0438\u043D
      \u0438\u0437 \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432 \u0441\u043F\u0440\u044B\u0433\u043D\u0443\u043B
      \u0441 \u0443\u0441\u0442\u0443\u043F\u0430, \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043B
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E \u0438 \u0441\u0432\u0438\u0441\u0442\u043D\u0443\u043B.
      \u0421\u0442\u0440\u0435\u043B\u044B \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438\u0441\u044C.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043E\u043F\u044F\u0442\u0438\u043B\u0441\u044F
      \u043D\u0430\u0437\u0430\u0434, \u0438 \u043D\u0438\u043A\u0442\u043E \u043D\u0435
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0443
      \u0432 \u0433\u043B\u0430\u0437\u0430. \u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u043C\u043E\u043D\u0435\u0442 \u0437\u0430 \u0436\u0438\u0437\u043D\u044C,
      \u0434\u0451\u0448\u0435\u0432\u043E. \u041D\u043E \u0433\u043E\u0440\u0435\u0447\u044C
      \u0436\u0436\u0451\u0442 \u0433\u043E\u0440\u043B\u043E \u0445\u0443\u0436\u0435
      \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u043E\u0439 \u043F\u044B\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060699
    m_Localized: "\u0414\u0430\u0442\u044C \u0431\u043E\u0439 \u0432 \u043A\u0430\u043D\u044C\u043E\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060700
    m_Localized: "\u041F\u043E\u0432\u043E\u0437\u043A\u0438 \u0441\u0434\u0432\u0438\u043D\u0443\u043B\u0438\u0441\u044C
      \u0431\u043E\u0440\u0442\u0430\u043C\u0438: \u0438\u043C\u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
      \u0431\u0430\u0440\u0440\u0438\u043A\u0430\u0434\u0430. \u041F\u0435\u0440\u0432\u044B\u0439
      \u0437\u0430\u043B\u043F \u043F\u0440\u043E\u0448\u0451\u043B \u043F\u043E\u0432\u0435\u0440\u0445\u0443:
      \u0431\u0430\u043D\u0434\u0438\u0442\u044B \u043D\u0435 \u043E\u0436\u0438\u0434\u0430\u043B\u0438,
      \u0447\u0442\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u0441\u0442\u0430\u043D\u0435\u0442
      \u0432 \u043E\u0431\u043E\u0440\u043E\u043D\u0443. \u041F\u043E\u043A\u0430
      \u0441\u0442\u0440\u0435\u043B\u044B \u0446\u043E\u043A\u0430\u043B\u0438 \u043E
      \u0434\u043E\u0441\u043A\u0438, \u0442\u0440\u043E\u0435 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u043E\u0432
      \u043F\u043E\u0434\u043D\u044F\u043B\u0438\u0441\u044C \u043D\u0430 \u0443\u0441\u0442\u0443\u043F
      \u043F\u043E \u0431\u043E\u043A\u043E\u0432\u043E\u0439 \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0435
      \u0438 \u0443\u0434\u0430\u0440\u0438\u043B\u0438 \u0432 \u0441\u043F\u0438\u043D\u0443.
      \u041F\u0430\u043D\u0438\u043A\u0430 \u0440\u0435\u0448\u0438\u043B\u0430 \u0434\u0435\u043B\u043E
      - \u0442\u044E\u0440\u043A\u0438 \u043F\u043E\u0431\u0435\u0436\u0430\u043B\u0438,
      \u043F\u043E\u0431\u0440\u043E\u0441\u0430\u0432 \u043B\u0443\u043A\u0438 \u0438
      \u0441\u0430\u0431\u043B\u0438. \u041E\u0434\u043D\u0430 \u0438\u0437 \u0441\u0430\u0431\u0435\u043B\u044C
      (\u0445\u043E\u0440\u043E\u0448\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430,
      \u0434\u0430\u043C\u0430\u0441\u0441\u043A\u0430\u044F \u0441\u0442\u0430\u043B\u044C)
      \u043F\u043E\u0439\u0434\u0451\u0442 \u0432 \u0442\u044E\u043A. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u044B\u0432\u0430\u044E\u0442 \u0446\u0430\u0440\u0430\u043F\u0438\u043D\u044B
      \u0438 \u0441\u043C\u0435\u044E\u0442\u0441\u044F \u043E\u0442 \u043D\u0435\u0440\u0432\u043D\u043E\u0433\u043E
      \u043E\u0431\u043B\u0435\u0433\u0447\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060701
    m_Localized: "\u0421\u0442\u0440\u0435\u043B\u044B \u043F\u043E\u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C
      \u0433\u0440\u0430\u0434\u043E\u043C: \u0434\u0432\u043E\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0443\u043F\u0430\u043B\u0438 \u0441\u0440\u0430\u0437\u0443, \u0442\u0440\u0435\u0442\u0438\u0439
      \u0437\u0430\u043E\u0440\u0430\u043B, \u0437\u0430\u0436\u0438\u043C\u0430\u044F
      \u0431\u0435\u0434\u0440\u043E. \u0411\u0430\u043D\u0434\u0438\u0442\u044B
      \u0440\u0438\u043D\u0443\u043B\u0438\u0441\u044C \u0432\u043D\u0438\u0437 \u043F\u043E
      \u0441\u043A\u043B\u043E\u043D\u0443, \u043A\u0440\u0443\u0448\u0430 \u0431\u043E\u0440\u0442\u0430
      \u043F\u043E\u0432\u043E\u0437\u043E\u043A \u0441\u0430\u0431\u043B\u044F\u043C\u0438.
      \u041A\u043E\u0433\u0434\u0430 \u043E\u043D\u0438 \u0443\u0448\u043B\u0438,
      \u043A\u0430\u043D\u044C\u043E\u043D \u043F\u0440\u043E\u043F\u0430\u0445 \u043A\u0440\u043E\u0432\u044C\u044E
      \u0438 \u043F\u044B\u043B\u044C\u044E. \u041C\u043E\u043D\u0435\u0442\u044B,
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B, \u0447\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430 - \u0432\u0441\u0451 \u0432 \u0447\u0443\u0436\u0438\u0445
      \u0440\u0443\u043A\u0430\u0445. \u041F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0441 \u043F\u0440\u043E\u043B\u043E\u043C\u043B\u0435\u043D\u043D\u044B\u043C
      \u0431\u043E\u0440\u0442\u043E\u043C \u0435\u043B\u0435 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043D\u0430 \u043E\u0441\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060702
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442
      \u043A\u043E\u043D\u0442\u0440\u0437\u0430\u0441\u0430\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060703
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043F\u043E\u0434\u043D\u044F\u043B
      \u043A\u0443\u043B\u0430\u043A \u0435\u0449\u0451 \u043D\u0430 \u043F\u043E\u0434\u0445\u043E\u0434\u0435
      \u043A \u043A\u0430\u043D\u044C\u043E\u043D\u0443 - \u043E\u043D \u0437\u0430\u043C\u0435\u0442\u0438\u043B
      \u0441\u0432\u0435\u0436\u0438\u0435 \u0441\u043B\u0435\u0434\u044B \u043D\u0430
      \u043F\u0435\u0441\u043A\u0435 \u0438 \u0446\u0430\u0440\u0430\u043F\u0438\u043D\u044B
      \u043E\u0442 \u043F\u043E\u0434\u043A\u043E\u0432\u0430\u043D\u043D\u044B\u0445
      \u0441\u0430\u043F\u043E\u0433 \u043D\u0430 \u043A\u0430\u043C\u043D\u044F\u0445.
      \xAB\u0417\u0430\u0441\u0430\u0434\u0430. \u0414\u0430\u0439\u0442\u0435 \u043C\u043D\u0435
      \u0447\u0435\u0442\u0432\u0435\u0440\u044B\u0445 \u0438 \u043F\u043E\u043B\u0447\u0430\u0441\u0430.\xBB
      \u041E\u043D \u0443\u0432\u0451\u043B \u043B\u044E\u0434\u0435\u0439 \u0432
      \u043E\u0431\u0445\u043E\u0434 \u043F\u043E \u043A\u043E\u0437\u044C\u0435\u0439
      \u0442\u0440\u043E\u043F\u0435. \u041A\u043E\u0433\u0434\u0430 \u0431\u0430\u043D\u0434\u0438\u0442\u044B
      \u043F\u0440\u0438\u0432\u0441\u0442\u0430\u043B\u0438 \u0434\u043B\u044F \u0437\u0430\u043B\u043F\u0430,
      \u0430\u0440\u0431\u0430\u043B\u0435\u0442\u043D\u044B\u0439 \u0431\u043E\u043B\u0442
      \u0432\u043E\u0448\u0451\u043B \u0432 \u043A\u0430\u043C\u0435\u043D\u044C
      \u0443 \u043D\u043E\u0433 \u0432\u043E\u0436\u0430\u043A\u0430, \u0430 \u0447\u0435\u0442\u044B\u0440\u0435
      \u043A\u043B\u0438\u043D\u043A\u0430 \u0431\u043B\u0435\u0441\u043D\u0443\u043B\u0438
      \u0437\u0430 \u0441\u043F\u0438\u043D\u0430\u043C\u0438 \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432.
      \u0422\u044E\u0440\u043A\u0438 \u043F\u043E\u0431\u0440\u043E\u0441\u0430\u043B\u0438
      \u043E\u0440\u0443\u0436\u0438\u0435 \u0438 \u0440\u0430\u0437\u0431\u0435\u0436\u0430\u043B\u0438\u0441\u044C
      \u043F\u043E \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0430\u043C.
      \u041D\u0438 \u043E\u0434\u043D\u043E\u0439 \u043F\u043E\u0442\u0435\u0440\u0438,
      \u0430 \u0442\u0440\u043E\u0444\u0435\u0439\u043D\u044B\u0435 \u0441\u0430\u0431\u043B\u0438
      \u0438 \u0441\u043E\u0441\u0442\u0430\u0432\u043D\u043E\u0439 \u043B\u0443\u043A
      \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u043B\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043D\u043E\u0435
      \u0434\u043E\u0431\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060704
    m_Localized: "\u0412\u043E\u043B\u043A\u0438 \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060705
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u0430\u043B \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B
      \u043C\u0435\u0442\u0435\u043B\u044C\u044E: \u0441\u043D\u0435\u0433 \u0431\u044C\u0451\u0442
      \u0432 \u043B\u0438\u0446\u043E, \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u044C
      \u0432 \u0434\u0435\u0441\u044F\u0442\u044C \u0448\u0430\u0433\u043E\u0432.
      \u042F\u043A\u0438 \u0441\u0431\u0438\u043B\u0438\u0441\u044C \u0432 \u043A\u0443\u0447\u0443
      \u0438 \u043C\u044B\u0447\u0430\u0442, \u043F\u0440\u0438\u0436\u0438\u043C\u0430\u044F
      \u0443\u0448\u0438. \u041F\u043E\u0442\u043E\u043C \u0441\u043A\u0432\u043E\u0437\u044C
      \u0432\u043E\u0439 \u0432\u0435\u0442\u0440\u0430 \u043F\u0440\u043E\u0440\u0435\u0437\u0430\u043B\u0441\u044F
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0432\u043E\u0439: \u043F\u0440\u043E\u0442\u044F\u0436\u043D\u044B\u0439,
      \u0433\u043E\u043B\u043E\u0434\u043D\u044B\u0439, \u0441\u043E\u0432\u0441\u0435\u043C
      \u0431\u043B\u0438\u0437\u043A\u043E. \u0416\u0451\u043B\u0442\u044B\u0435
      \u0433\u043B\u0430\u0437\u0430 \u0432\u0441\u043F\u044B\u0445\u043D\u0443\u043B\u0438
      \u0432 \u0441\u043D\u0435\u0436\u043D\u043E\u0439 \u043F\u0435\u043B\u0435\u043D\u0435,
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0434\u0432\u0430, \u043F\u043E\u0442\u043E\u043C
      \u0448\u0435\u0441\u0442\u044C, \u043F\u043E\u0442\u043E\u043C \u0431\u043E\u043B\u044C\u0448\u0435.
      \u0412\u043E\u043B\u043A\u0438, \u043A\u0440\u0443\u043F\u043D\u044B\u0435
      \u0438 \u0437\u0438\u043C\u043D\u0438\u0435, \u0441 \u0440\u0451\u0431\u0440\u0430\u043C\u0438
      \u043F\u043E\u0434 \u0441\u0432\u0430\u043B\u044F\u0432\u0448\u0435\u0439\u0441\u044F
      \u0448\u0435\u0440\u0441\u0442\u044C\u044E, \u043E\u0431\u0441\u0442\u0443\u043F\u0430\u044E\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043E\u043B\u0443\u043A\u0440\u0443\u0433\u043E\u043C.
      \u0421\u0442\u0430\u0440\u044B\u0439 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0441\u043E\u0440\u0432\u0430\u043B
      \u0444\u0430\u043A\u0435\u043B \u0438\u0437 \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F
      \u0438 \u043F\u0440\u043E\u0445\u0440\u0438\u043F\u0435\u043B:\r\n\r\n<npc_speech
      lang=\"Tibetan\">\u0412\u043E\u043B\u043A\u043E\u0432 \u043C\u043D\u043E\u0433\u043E!
      \u0417\u0430\u0436\u0438\u0433\u0430\u0439\u0442\u0435 \u043E\u0433\u043E\u043D\u044C!
      \u0417\u0430\u0436\u0438\u0433\u0430\u0439\u0442\u0435 \u043E\u0433\u043E\u043D\u044C!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060706
    m_Localized: "\u041E\u0442\u043E\u0433\u043D\u0430\u0442\u044C \u043E\u0433\u043D\u0451\u043C
      \u0438 \u0448\u0443\u043C\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060707
    m_Localized: "\u0424\u0430\u043A\u0435\u043B\u044B, \u043A\u0440\u0438\u043A\u0438,
      \u0433\u0440\u043E\u0445\u043E\u0442 \u0436\u0435\u043B\u0435\u0437\u043D\u044B\u0445
      \u043A\u043E\u0442\u043B\u043E\u0432: \u0432\u043E\u043B\u043A\u0438 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438,
      \u043D\u043E \u043D\u0435 \u0443\u0448\u043B\u0438. \u0421\u0442\u0430\u044F
      \u043A\u0440\u0443\u0436\u0438\u043B\u0430 \u043D\u0430 \u0433\u0440\u0430\u043D\u0438\u0446\u0435
      \u0441\u0432\u0435\u0442\u0430 \u0432\u0441\u044E \u043D\u043E\u0447\u044C,
      \u0438 \u043A \u0443\u0442\u0440\u0443 \u0434\u0432\u0430 \u0432\u044C\u044E\u0447\u043D\u044B\u0445
      \u044F\u043A\u0430 \u043B\u0435\u0436\u0430\u043B\u0438 \u0441 \u0440\u0430\u0437\u043E\u0440\u0432\u0430\u043D\u043D\u044B\u043C\u0438
      \u0437\u0430\u0433\u0440\u0438\u0432\u043A\u0430\u043C\u0438: \u043E\u0442\u0431\u0438\u043B\u0438\u0441\u044C
      \u043E\u0442 \u0441\u0442\u0430\u0434\u0430 \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435.
      \u041C\u044F\u0441\u043E \u043F\u0440\u043E\u043F\u0430\u043B\u043E, \u0443\u043F\u0440\u044F\u0436\u044C
      \u043F\u043E\u0440\u0432\u0430\u043D\u0430, \u0430 \u043B\u044E\u0434\u0438
      \u043D\u0435 \u0441\u043E\u043C\u043A\u043D\u0443\u043B\u0438 \u0433\u043B\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060708
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443
      \u0441\u0442\u0430\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060709
    m_Localized: "\u041F\u044F\u0442\u0435\u0440\u043E \u0441 \u043A\u043E\u043F\u044C\u044F\u043C\u0438
      \u0432\u044B\u0448\u043B\u0438 \u0441\u0442\u0435\u043D\u043E\u0439, \u0444\u0430\u043A\u0435\u043B\u044B
      \u0432 \u043B\u0435\u0432\u044B\u0445 \u0440\u0443\u043A\u0430\u0445. \u0412\u043E\u0436\u0430\u043A
      \u0431\u0440\u043E\u0441\u0438\u043B\u0441\u044F \u043F\u0435\u0440\u0432\u044B\u043C
      \u0438 \u043F\u0435\u0440\u0432\u044B\u043C \u0443\u043F\u0430\u043B, \u043F\u0440\u043E\u043D\u0437\u0451\u043D\u043D\u044B\u0439
      \u0434\u0432\u0443\u043C\u044F \u043E\u0441\u0442\u0440\u0438\u044F\u043C\u0438.
      \u0421\u0442\u0430\u044F \u0437\u0430\u043C\u0435\u0440\u043B\u0430, \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
      \u0438 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0430\u0441\u044C
      \u0432 \u043C\u0435\u0442\u0435\u043B\u0438. \u0423 \u0432\u043E\u0436\u0430\u043A\u0430
      \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u0448\u043A\u0443\u0440\u0430
      \u0440\u0435\u0434\u043A\u043E\u0433\u043E \u0433\u043E\u0440\u043D\u043E\u0433\u043E
      \u0432\u043E\u043B\u043A\u0430, \u043A\u0440\u0443\u043F\u043D\u043E\u0433\u043E,
      \u0441 \u0441\u0435\u0440\u0435\u0431\u0440\u0438\u0441\u0442\u044B\u043C \u0437\u0430\u0433\u0440\u0438\u0432\u043A\u043E\u043C.
      \u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0432 \u0434\u043E\u043B\u0438\u043D\u0435
      \u0437\u0430 \u0442\u0430\u043A\u0443\u044E \u0448\u043A\u0443\u0440\u0443
      \u0434\u0430\u0434\u0443\u0442 \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u0446\u0435\u043D\u0443.
      \u041B\u044E\u0434\u0438 \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0438
      \u043F\u043B\u0435\u0447\u0438: \u0441\u0442\u0440\u0430\u0445 \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0435\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u0437\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E
      \u043C\u043E\u0436\u0435\u0448\u044C \u0434\u0430\u0442\u044C \u043E\u0442\u043F\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060710
    m_Localized: "\u0412\u043E\u0436\u0430\u043A \u0443\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u043E\u0442 \u043A\u043E\u043F\u044C\u044F \u0438 \u0432\u0446\u0435\u043F\u0438\u043B\u0441\u044F
      \u0432 \u0440\u0443\u043A\u0443 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C\u0443
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0443. \u0421\u0442\u0430\u044F
      \u0445\u043B\u044B\u043D\u0443\u043B\u0430 \u0441\u043B\u0435\u0434\u043E\u043C:
      \u0440\u044B\u0447\u0430\u043D\u0438\u0435, \u0432\u0438\u0437\u0433, \u043C\u0435\u043B\u044C\u043A\u0430\u043D\u0438\u0435
      \u0441\u0435\u0440\u044B\u0445 \u0442\u0435\u043B \u0432 \u0441\u043D\u0435\u0436\u043D\u043E\u0439
      \u043A\u0440\u0443\u0433\u043E\u0432\u0435\u0440\u0442\u0438. \u041E\u0442\u0431\u0438\u043B\u0438\u0441\u044C,
      \u043D\u043E \u0434\u0432\u043E\u0435 \u0440\u0430\u043D\u0435\u043D\u044B,
      \u044F\u043A \u0441 \u043F\u043E\u043A\u043B\u0430\u0436\u0435\u0439 \u0441\u043E\u0440\u0432\u0430\u043B\u0441\u044F
      \u0441 \u0442\u0440\u043E\u043F\u044B \u0432 \u043E\u0431\u0440\u044B\u0432,
      \u0430 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0442\u0435\u043B\u0435\u0433\u0430 \u043E\u043F\u0440\u043E\u043A\u0438\u043D\u0443\u043B\u0430\u0441\u044C
      \u043D\u0430 \u043E\u0431\u043B\u0435\u0434\u0435\u043D\u0435\u0432\u0448\u0435\u043C
      \u0441\u043A\u043B\u043E\u043D\u0435. \u0412\u043E\u043B\u043A\u0438 \u0443\u0448\u043B\u0438
      \u0441\u044B\u0442\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060711
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0432\u044B\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442
      \u043E\u0431\u043E\u0440\u043E\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060712
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u043B
      \u0431\u0435\u0437 \u043F\u0440\u043E\u043C\u0435\u0434\u043B\u0435\u043D\u0438\u044F:
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0432 \u043A\u0440\u0443\u0433,
      \u044F\u043A\u0438 \u0432\u043D\u0443\u0442\u0440\u044C, \u043B\u044E\u0434\u0438
      \u043F\u043E \u043F\u0435\u0440\u0438\u043C\u0435\u0442\u0440\u0443 \u0441
      \u0444\u0430\u043A\u0435\u043B\u0430\u043C\u0438 \u0438 \u043A\u043E\u043F\u044C\u044F\u043C\u0438.
      \xAB\u041D\u0435 \u0431\u0435\u0433\u0430\u0442\u044C. \u041D\u0435 \u043A\u0440\u0438\u0447\u0430\u0442\u044C.
      \u0421\u0442\u043E\u044F\u0442\u044C \u043F\u043B\u0435\u0447\u043E\u043C \u043A
      \u043F\u043B\u0435\u0447\u0443.\xBB \u0412\u043E\u043B\u043A\u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u043B\u0438
      \u043F\u0440\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F \u0434\u0432\u0430\u0436\u0434\u044B,
      \u043E\u0431\u0430 \u0440\u0430\u0437\u0430 \u043D\u0430\u0442\u044B\u043A\u0430\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0441\u0442\u0435\u043D\u0443 \u043E\u0433\u043D\u044F \u0438
      \u0436\u0435\u043B\u0435\u0437\u0430. \u041A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443
      \u0441\u0442\u0430\u044F \u0443\u0448\u043B\u0430, \u043E\u0441\u0442\u0430\u0432\u0438\u0432
      \u043D\u0430 \u0441\u043D\u0435\u0433\u0443 \u043A\u0440\u043E\u0432\u0430\u0432\u044B\u0435
      \u0441\u043B\u0435\u0434\u044B. \u041F\u043E\u0442\u0435\u0440\u0438 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B:
      \u043E\u0434\u0438\u043D \u0440\u0430\u0437\u043E\u0440\u0432\u0430\u043D\u043D\u044B\u0439
      \u043C\u0435\u0448\u043E\u043A \u0441 \u043C\u0443\u043A\u043E\u0439 \u0434\u0430
      \u043F\u0440\u043E\u043A\u0443\u0448\u0435\u043D\u043D\u043E\u0435 \u044F\u0440\u043C\u043E.
      \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0432\u044B\u0442\u0435\u0440
      \u043A\u043E\u043F\u044C\u0451 \u0441\u043D\u0435\u0433\u043E\u043C \u0438
      \u0441\u043A\u0430\u0437\u0430\u043B: \xAB\u0412\u043E\u043B\u043A\u0438 \u0443\u0432\u0430\u0436\u0430\u044E\u0442
      \u0441\u0442\u0440\u043E\u0439. \u041A\u0430\u043A \u0438 \u043B\u044E\u0434\u0438.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060713
    m_Localized: "\u0420\u0430\u0437\u0432\u0438\u043B\u043A\u0430 \u0431\u0435\u0437
      \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060714
    m_Localized: "\u0422\u0440\u0438 \u0442\u0440\u043E\u043F\u044B \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F
      \u043E\u0442 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0433\u043E \u0441\u0442\u043E\u043B\u0431\u0430,
      \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u043F\u043E\u043A\u0440\u044B\u0442\u043E\u0433\u043E
      \u0440\u0435\u0437\u043D\u044B\u043C\u0438 \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044F\u043C\u0438.
      \u0421\u0435\u0439\u0447\u0430\u0441 \u043B\u0438\u0448\u044C \u0441\u043A\u043E\u043B\u044B
      \u0438 \u0431\u043E\u0440\u043E\u0437\u0434\u043A\u0438, \u0437\u0430\u043C\u0435\u0442\u0451\u043D\u043D\u044B\u0435
      \u043F\u0435\u0441\u043A\u043E\u043C. \u041E\u0434\u043D\u0430 \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u0430\u0435\u0442
      \u043E\u0442\u043A\u0440\u044B\u0442\u0443\u044E \u0440\u0430\u0432\u043D\u0438\u043D\u0443,
      \u0432\u0442\u043E\u0440\u0430\u044F \u043D\u044B\u0440\u044F\u0435\u0442 \u043C\u0435\u0436\u0434\u0443
      \u0434\u044E\u043D\u0430\u043C\u0438, \u0442\u0440\u0435\u0442\u044C\u044F
      \u043F\u043E\u043C\u0435\u0447\u0435\u043D\u0430 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u043C\u0438
      \u0442\u0440\u044F\u043F\u0438\u0447\u043D\u044B\u043C\u0438 \u0432\u044B\u043C\u043F\u0435\u043B\u0430\u043C\u0438
      \u0438 \u043F\u043E\u043B\u0443\u0441\u0442\u0451\u0440\u0442\u044B\u043C\u0438
      \u0437\u043D\u0430\u043A\u0430\u043C\u0438 \u043D\u0430 \u043A\u0430\u043C\u043D\u044F\u0445:
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435 \u043F\u043E\u043C\u0435\u0442\u043A\u0438,
      \u043D\u043E \u043D\u0430 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u043E\u043C
      \u043F\u0438\u0441\u044C\u043C\u0435. \u0423 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F
      \u0441\u0442\u043E\u043B\u0431\u0430 \u0441\u0438\u0434\u0438\u0442 \u0441\u0442\u0430\u0440\u0438\u043A
      \u0432 \u043F\u044B\u043B\u044C\u043D\u043E\u043C \u0431\u0443\u0440\u043D\u0443\u0441\u0435,
      \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u0435\u0442 \u0447\u0451\u0442\u043A\u0438.
      \u0421\u043C\u043E\u0442\u0440\u0438\u0442 \u0441\u043D\u0438\u0437\u0443 \u0432\u0432\u0435\u0440\u0445
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442:\r\n\r\n<npc_speech lang=\"Arabic\">\u041E,
      \u043F\u0443\u0442\u043D\u0438\u043A, \u0442\u0440\u0438 \u0442\u0440\u043E\u043F\u044B:
      \u043E\u0434\u043D\u0430 \u043A \u0432\u043E\u0434\u0435, \u043E\u0434\u043D\u0430
      \u043A \u043F\u0435\u0441\u043A\u0443, \u043E\u0434\u043D\u0430 \u043A \u0440\u044B\u043D\u043A\u0443.
      \u041D\u043E \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043A\u043E\u0442\u043E\u0440\u0430\u044F?
      \u0412\u043E\u0442 \u0432 \u0447\u0451\u043C \u0432\u043E\u043F\u0440\u043E\u0441.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060715
    m_Localized: "\u041F\u043E\u0439\u0442\u0438 \u043F\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439
      \u0440\u0430\u0432\u043D\u0438\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060716
    m_Localized: "\u0414\u043B\u0438\u043D\u043D\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430
      - \u0447\u0435\u0441\u0442\u043D\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430.
      \u0414\u0432\u0430 \u043B\u0438\u0448\u043D\u0438\u0445 \u0434\u043D\u044F
      \u043F\u043E \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0439 \u0440\u0430\u0432\u043D\u0438\u043D\u0435,
      \u0433\u0434\u0435 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442 \u043F\u043B\u044B\u0432\u0451\u0442
      \u0432 \u043C\u0430\u0440\u0435\u0432\u0435, \u0430 \u0442\u0435\u043D\u0438
      \u043D\u0435\u0442 \u043D\u0438 \u043A\u043B\u043E\u0447\u043A\u0430. \u041F\u0440\u0438\u043F\u0430\u0441\u044B
      \u0442\u0430\u044E\u0442, \u043B\u044E\u0434\u0438 \u0432\u043E\u0440\u0447\u0430\u0442,
      \u043D\u043E \u043D\u0438 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432,
      \u043D\u0438 \u043B\u043E\u0432\u0443\u0448\u0435\u043A - \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u0435\u0442\u0435\u0440 \u0438 \u043F\u044B\u043B\u044C. \u041A \u0438\u0441\u0445\u043E\u0434\u0443
      \u0432\u0442\u043E\u0440\u043E\u0433\u043E \u0434\u043D\u044F \u043D\u0430
      \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435 \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u0438\u043B\u0438
      \u043A\u043E\u043D\u0442\u0443\u0440\u044B \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u044F.
      \u0414\u043E\u043B\u0433\u043E, \u043D\u043E \u0436\u0438\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060717
    m_Localized: "\u0421\u0440\u0435\u0437\u0430\u0442\u044C \u0447\u0435\u0440\u0435\u0437
      \u0440\u0430\u0441\u043F\u0430\u0434\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060718
    m_Localized: "\u0412\u044B \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438\u0441\u044C
      \u043A \u0437\u043D\u0430\u043A\u0430\u043C \u043D\u0430 \u043F\u0440\u0430\u0432\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435 \u0438 \u043F\u0440\u043E\u0432\u0435\u043B\u0438
      \u043F\u043E \u043D\u0438\u043C \u043F\u0430\u043B\u044C\u0446\u0435\u043C.
      \u0423\u0433\u043B\u043E\u0432\u044B\u0435 \u0437\u0430\u0440\u0443\u0431\u043A\u0438:
      \u043F\u043E\u043D\u044F\u0442\u043D\u044B \u043B\u044E\u0431\u043E\u043C\u0443,
      \u043A\u0442\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u043B \u0432
      \u0411\u0443\u0445\u0430\u0440\u0435. \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0435
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435 \u0437\u043D\u0430\u043A\u0438:
      \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0434\u043E \u043A\u043E\u043B\u043E\u0434\u0446\u0430,
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043A \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u043C\u0443
      \u0434\u0432\u043E\u0440\u0443, \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      \u043E \u0437\u044B\u0431\u0443\u0447\u0438\u0445 \u043F\u0435\u0441\u043A\u0430\u0445
      \u0441\u043B\u0435\u0432\u0430. \u041F\u0440\u043E\u0445\u043E\u0434 \u043C\u0435\u0436
      \u0434\u044E\u043D \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C
      \u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u043C, \u0430
      \u0437\u0430 \u043D\u0438\u043C \u043B\u0435\u0436\u0430\u043B\u0430 \u0445\u043E\u0440\u043E\u0448\u043E
      \u043D\u0430\u043A\u0430\u0442\u0430\u043D\u043D\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430.
      \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u043E\u043F\u044B\u0442 \u0441\u0431\u0435\u0440\u0451\u0433
      \u0434\u0432\u0430 \u0434\u043D\u044F \u0438 \u0441\u043E\u0442\u043D\u044E
      \u0442\u0440\u0435\u0432\u043E\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060719
    m_Localized: "\u041F\u0440\u043E\u0445\u043E\u0434 \u043F\u043E\u0433\u043B\u043E\u0442\u0438\u043B
      \u043E\u0431\u043E\u0437 \u043A\u0430\u043A \u0432\u043E\u0440\u043E\u043D\u043A\u0430:
      \u043F\u0435\u0441\u043E\u043A \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043C\u044F\u0433\u0447\u0435, \u0447\u0435\u043C \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B.
      \u041A\u043E\u043B\u0451\u0441\u0430 \u043F\u043E\u0433\u0440\u0443\u0437\u0438\u043B\u0438\u0441\u044C
      \u043F\u043E \u0441\u0442\u0443\u043F\u0438\u0446\u0443. \u041F\u043E\u043A\u0430
      \u043A\u043E\u043F\u0430\u043B\u0438, \u0432\u0435\u0442\u0435\u0440 \u043D\u0430\u0433\u043D\u0430\u043B
      \u0441\u0442\u0435\u043D\u0443 \u043F\u0435\u0441\u043A\u0430 \u0438 \u0442\u0440\u043E\u043F\u0430
      \u0438\u0441\u0447\u0435\u0437\u043B\u0430. \u041F\u043E\u043B\u0434\u043D\u044F
      \u0431\u043B\u0443\u0436\u0434\u0430\u043D\u0438\u0439, \u0442\u0440\u0435\u0441\u043D\u0443\u043B\u0430
      \u043E\u0441\u044C, \u0432\u043E\u0434\u0430 \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u0430
      \u0437\u0440\u044F. \u041A\u043E\u0433\u0434\u0430 \u043D\u0430\u043A\u043E\u043D\u0435\u0446
      \u0432\u044B\u0431\u0440\u0430\u043B\u0438\u0441\u044C \u043D\u0430 \u0442\u0432\u0451\u0440\u0434\u0443\u044E
      \u043F\u043E\u0447\u0432\u0443, \u0441\u0442\u0430\u0440\u0438\u043A \u0443
      \u0441\u0442\u043E\u043B\u0431\u0430, \u0432\u0435\u0440\u043D\u043E, \u043F\u043E\u043A\u0430\u0447\u0430\u043B
      \u0431\u044B \u0433\u043E\u043B\u043E\u0432\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060720
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0447\u0438\u0442\u0430\u0435\u0442
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435 \u0437\u043D\u0430\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060721
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u0440\u0438\u0441\u0435\u043B
      \u0443 \u043A\u0430\u043C\u043D\u0435\u0439 \u043D\u0430 \u043F\u0440\u0430\u0432\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435 \u0438 \u0441\u0442\u0430\u043B \u0432\u043E\u0434\u0438\u0442\u044C
      \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u043F\u043E \u0437\u0430\u0440\u0443\u0431\u043A\u0430\u043C.
      \xAB\u042D\u0442\u043E \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043C\u0435\u0442\u043A\u0438
      - \u0437\u0434\u0435\u0441\u044C \u0446\u0435\u043B\u044B\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u043D\u044B\u0439
      \u043B\u0438\u0441\u0442. \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0430\u044F
      \u043E\u0441\u043D\u043E\u0432\u0430, \u043D\u043E \u0430\u0440\u0430\u0431\u0441\u043A\u0438\u0435
      \u043F\u0440\u0438\u043F\u0438\u0441\u043A\u0438: \"\u043A\u043E\u043B\u043E\u0434\u0435\u0446
      \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u043B\u0434\u043D\u044F\", \"\u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0439
      \u0434\u0432\u043E\u0440 \u0418\u0431\u043D \u0425\u0438\u0448\u0430\u043C\u0430
      - \u0447\u0435\u0441\u0442\u043D\u044B\u0435 \u0446\u0435\u043D\u044B\", \"\u043B\u0435\u0432\u044B\u0439
      \u043F\u0440\u043E\u0445\u043E\u0434: \u0437\u044B\u0431\u0443\u0447\u0438\u0439
      \u043F\u0435\u0441\u043E\u043A, \u043D\u0435 \u0432\u0445\u043E\u0434\u0438\u0442\u044C\".\xBB
      \u041E\u043D \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B \u0441\u043E
      \u0441\u0442\u0430\u0440\u0438\u043A\u043E\u043C \u043F\u043E-\u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438:
      <npc_speech lang=\"Sogdian\">\u041E\u0442\u0435\u0446, \u044D\u0442\u0438 \u043C\u0435\u0442\u043A\u0438
      \u0438\u0437 \u0411\u0443\u0445\u0430\u0440\u044B? \u041A\u043E\u043B\u043E\u0434\u0435\u0446
      \u0435\u0449\u0451 \u0442\u0430\u043C? \u041C\u044B \u0438\u0434\u0451\u043C
      \u043F\u043E \u043F\u0440\u0430\u0432\u043E\u0439 \u0442\u0440\u043E\u043F\u0435.</npc_speech>
      \u0421\u0442\u0430\u0440\u0438\u043A \u043E\u0436\u0438\u0432\u0438\u043B\u0441\u044F,
      \u0443\u0441\u043B\u044B\u0448\u0430\u0432 \u0440\u043E\u0434\u043D\u043E\u0439
      \u044F\u0437\u044B\u043A, \u0438 \u0434\u043E\u0431\u0430\u0432\u0438\u043B:
      \u043A\u043E\u043B\u043E\u0434\u0435\u0446 \u0442\u0430\u043C, \u043E\u043D
      \u0441\u0430\u043C \u043F\u0438\u043B \u0438\u0437 \u043D\u0435\u0433\u043E
      \u0443\u0442\u0440\u043E\u043C. \u041E\u0431\u043E\u0437 \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u043F\u043E \u043F\u0440\u0430\u0432\u043E\u0439 \u0442\u0440\u043E\u043F\u0435
      \u0441 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C\u044E
      \u043A\u0430\u0440\u0442\u044B \u0432 \u0440\u0443\u043A\u0430\u0445. \u041A
      \u0432\u0435\u0447\u0435\u0440\u0443 \u0432\u044B\u0448\u043B\u0438 \u043A
      \u0432\u043E\u0434\u0435, \u0442\u0435\u043D\u0438 \u0438 \u043A\u0440\u0435\u043F\u043A\u0438\u043C
      \u0441\u0442\u0435\u043D\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060722
    m_Localized: "\u0412\u044B\u0431\u043E\u0440 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060723
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u0443\u043F\u0438\u0440\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0443 \u0443 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u043E\u0431\u043E, \u0443\u0432\u0435\u0448\u0430\u043D\u043D\u043E\u0433\u043E
      \u043E\u0431\u0440\u044B\u0432\u043A\u0430\u043C\u0438 \u043C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u0445
      \u0444\u043B\u0430\u0433\u043E\u0432. \u041D\u0430\u043B\u0435\u0432\u043E:
      \u0443\u0437\u043A\u0430\u044F \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0430
      \u043C\u0435\u0436\u0434\u0443 \u0441\u043A\u0430\u043B, \u043A\u0440\u0443\u0442\u043E
      \u0443\u0445\u043E\u0434\u044F\u0449\u0430\u044F \u0432\u0432\u0435\u0440\u0445.
      \u0421\u043D\u0435\u0433 \u043D\u0430 \u043A\u0430\u043C\u043D\u044F\u0445
      \u0443\u0442\u043E\u043F\u0442\u0430\u043D: \u043A\u0442\u043E-\u0442\u043E
      \u0445\u043E\u0434\u0438\u043B \u043D\u0435\u0434\u0430\u0432\u043D\u043E,
      \u043D\u043E \u0441\u043B\u0435\u0434\u044B \u043E\u0431\u043E\u0440\u0432\u0430\u043D\u044B
      \u043B\u0430\u0432\u0438\u043D\u043D\u044B\u043C \u044F\u0437\u044B\u043A\u043E\u043C.
      \u041D\u0430\u043F\u0440\u0430\u0432\u043E: \u0448\u0438\u0440\u043E\u043A\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430, \u043F\u0435\u0442\u043B\u044F\u044E\u0449\u0430\u044F
      \u0441\u0435\u0440\u043F\u0430\u043D\u0442\u0438\u043D\u043E\u043C \u043F\u043E
      \u0441\u043A\u043B\u043E\u043D\u0443. \u041E\u043D\u0430 \u0434\u043B\u0438\u043D\u043D\u0435\u0435
      \u043D\u0430 \u0446\u0435\u043B\u044B\u0439 \u0434\u0435\u043D\u044C, \u043D\u043E
      \u0441\u043D\u0435\u0433 \u0437\u0434\u0435\u0441\u044C \u0441\u043B\u0435\u0436\u0430\u0432\u0448\u0438\u0439\u0441\u044F,
      \u0442\u0432\u0451\u0440\u0434\u044B\u0439, \u0438 \u043A\u043E\u043B\u0435\u044F
      \u043D\u0430\u0431\u0438\u0442\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A-\u043F\u0430\u043C\u0438\u0440\u0435\u0446
      \u0441\u0442\u043E\u0438\u0442 \u0443 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438,
      \u0449\u0443\u0440\u0438\u0442\u0441\u044F \u043D\u0430 \u043D\u0435\u0431\u043E
      \u0438 \u043C\u043E\u043B\u0447\u0438\u0442. \u041E\u043D \u0437\u043D\u0430\u0435\u0442
      \u043E\u0431\u0430 \u043F\u0443\u0442\u0438, \u043D\u043E \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u0441\u044F
      \u0441 \u0441\u043E\u0432\u0435\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060724
    m_Localized: "\u0418\u0434\u0442\u0438 \u0434\u043B\u0438\u043D\u043D\u044B\u043C
      \u0441\u0435\u0440\u043F\u0430\u043D\u0442\u0438\u043D\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060725
    m_Localized: "\u0414\u0435\u043D\u044C \u043F\u043E\u0442\u0435\u0440\u044F\u043D,
      \u043D\u043E \u043D\u043E\u0433\u0438 \u0446\u0435\u043B\u044B. \u0421\u0435\u0440\u043F\u0430\u043D\u0442\u0438\u043D
      \u0442\u044F\u043D\u0443\u043B\u0441\u044F \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E
      - \u043F\u043E\u0432\u043E\u0440\u043E\u0442 \u0437\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u043C,
      \u043E\u0434\u0438\u043D \u0441\u043A\u043B\u043E\u043D \u0441\u043C\u0435\u043D\u044F\u0435\u0442
      \u0434\u0440\u0443\u0433\u043E\u0439, \u0430 \u0432\u0435\u0440\u0448\u0438\u043D\u0430
      \u0432\u0441\u0451 \u043D\u0435 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0435\u0442\u0441\u044F.
      \u042F\u043A\u0438 \u0448\u043B\u0438 \u0440\u043E\u0432\u043D\u043E, \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043D\u0435 \u0431\u0443\u043A\u0441\u043E\u0432\u0430\u043B\u0438, \u0438
      \u043A \u0437\u0430\u043A\u0430\u0442\u0443 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0438\u043B \u0447\u0435\u0440\u0435\u0437
      \u0433\u0440\u0435\u0431\u0435\u043D\u044C. \u0412\u043D\u0438\u0437\u0443,
      \u0432 \u0434\u043E\u043B\u0438\u043D\u0435, \u043C\u0435\u0440\u0446\u0430\u043B\u0438
      \u043E\u0433\u043D\u0438 \u0441\u0435\u043B\u0435\u043D\u0438\u044F. \u041F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u0443\u0448\u043B\u043E \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C
      \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0431\u044B, \u043D\u043E
      \u0432\u0441\u0435 \u0436\u0438\u0432\u044B \u0438 \u0432\u0441\u0451 \u043D\u0430
      \u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060726
    m_Localized: "\u0420\u0438\u0441\u043A\u043D\u0443\u0442\u044C \u0447\u0435\u0440\u0435\u0437
      \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060727
    m_Localized: "\u0420\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043C\u043E\u0439: \u043B\u0430\u0432\u0438\u043D\u043D\u044B\u0439
      \u044F\u0437\u044B\u043A \u043F\u043E\u0434\u0442\u0430\u044F\u043B \u0438
      \u043E\u0441\u0435\u043B, \u043E\u0441\u0442\u0430\u0432\u0438\u0432 \u0443\u0437\u043A\u0438\u0439
      \u043F\u0440\u043E\u0445\u043E\u0434 \u0443 \u0441\u0442\u0435\u043D\u044B.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0438 \u043F\u0440\u043E\u0442\u0438\u0441\u043D\u0443\u043B\u0438\u0441\u044C
      \u0431\u043E\u043A\u043E\u043C, \u044F\u043A\u0438 \u0448\u043B\u0438 \u0433\u0443\u0441\u044C\u043A\u043E\u043C,
      \u0438 \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u0438 \u0447\u0430\u0441\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u044B\u0448\u0435\u043B \u043D\u0430
      \u043F\u043E\u043B\u043E\u0433\u0438\u0439 \u0441\u043A\u043B\u043E\u043D \u0441
      \u044E\u0436\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B.
      \u0421\u043E\u043B\u043D\u0446\u0435, \u0437\u0435\u043B\u0435\u043D\u044C,
      \u0442\u0430\u043B\u0430\u044F \u0432\u043E\u0434\u0430 \u0432 \u0440\u0443\u0447\u044C\u044F\u0445.
      \u0423 \u0442\u0440\u043E\u043F\u044B - \u0437\u0430\u0440\u043E\u0441\u043B\u0438
      \u0434\u0438\u043A\u043E\u0433\u043E \u0436\u0435\u043D\u044C\u0448\u0435\u043D\u044F,
      \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044C \u0432 \u044D\u0442\u0438\u0445
      \u043A\u0440\u0430\u044F\u0445. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A-\u043F\u0430\u043C\u0438\u0440\u0435\u0446
      \u043A\u0438\u0432\u043D\u0443\u043B \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C:
      \xAB\u0413\u043E\u0440\u0430 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0430.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060728
    m_Localized: "\u041D\u0430 \u043F\u043E\u043B\u043F\u0443\u0442\u0438 \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0430
      \u0441\u043E\u043C\u043A\u043D\u0443\u043B\u0430\u0441\u044C: \u0441\u0432\u0435\u0436\u0438\u0439
      \u043E\u043F\u043E\u043B\u0437\u0435\u043D\u044C \u0437\u0430\u0432\u0430\u043B\u0438\u043B
      \u0442\u0440\u043E\u043F\u0443 \u043C\u043E\u043A\u0440\u044B\u043C \u0441\u043D\u0435\u0433\u043E\u043C
      \u0438 \u0449\u0435\u0431\u043D\u0435\u043C. \u0420\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u043D\u0435\u0433\u0434\u0435: \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0440\u0430\u0437\u0433\u0440\u0443\u0436\u0430\u0442\u044C \u043F\u043E\u0432\u043E\u0437\u043A\u0438,
      \u043F\u0435\u0440\u0435\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u0442\u044C
      \u0442\u044E\u043A\u0438 \u0447\u0435\u0440\u0435\u0437 \u0437\u0430\u0432\u0430\u043B
      \u0440\u0443\u043A\u0430\u043C\u0438 \u0438 \u043F\u0440\u043E\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u0442\u044C
      \u043F\u0443\u0441\u0442\u044B\u0435 \u0442\u0435\u043B\u0435\u0433\u0438 \u043F\u043E
      \u043A\u0430\u043C\u043D\u044F\u043C. \u041E\u0434\u043D\u0430 \u043E\u0441\u044C
      \u0442\u0440\u0435\u0441\u043D\u0443\u043B\u0430, \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0442\u0435\u043B\u0435\u0433\u0430 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430
      \u0431\u043E\u0440\u0442. \u041A \u0432\u0435\u0447\u0435\u0440\u0443, \u0438\u0437\u043C\u043E\u0442\u0430\u043D\u043D\u044B\u0435
      \u0438 \u0437\u043B\u044B\u0435, \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u043A \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0435 \u0438 \u043F\u043E\u0448\u043B\u0438
      \u0441\u0435\u0440\u043F\u0430\u043D\u0442\u0438\u043D\u043E\u043C. \u0414\u0432\u0430
      \u0434\u043D\u044F \u0432\u043C\u0435\u0441\u0442\u043E \u043E\u0434\u043D\u043E\u0433\u043E,
      \u0438 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u0432 \u0441\u043D\u0435\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060729
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u0442\u0440\u0435\u0442\u0438\u0439 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060730
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043F\u043E\u0441\u0442\u043E\u044F\u043B
      \u0443 \u043E\u0431\u043E, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u043D\u0430 \u043E\u0431\u043B\u0430\u043A\u0430, \u043F\u043E\u0442\u0440\u043E\u0433\u0430\u043B
      \u0441\u043D\u0435\u0433 \u043D\u0430 \u043A\u0430\u043C\u043D\u044F\u0445
      \u0438 \u0441\u043A\u0430\u0437\u0430\u043B: \xAB\u0415\u0441\u0442\u044C \u0442\u0440\u0435\u0442\u0438\u0439
      \u043F\u0443\u0442\u044C - \u043F\u0430\u0441\u0442\u0443\u0448\u044C\u044F
      \u0442\u0440\u043E\u043F\u0430, \u0435\u0451 \u043D\u0435 \u0432\u0438\u0434\u043D\u043E
      \u0437\u0430 \u0442\u0435\u043C \u0432\u044B\u0441\u0442\u0443\u043F\u043E\u043C.
      \u041D\u0435 \u0442\u0430\u043A\u0430\u044F \u043A\u0440\u0443\u0442\u0430\u044F,
      \u043A\u0430\u043A \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0430,
      \u0438 \u0432\u0434\u0432\u043E\u0435 \u043A\u043E\u0440\u043E\u0447\u0435
      \u0441\u0435\u0440\u043F\u0430\u043D\u0442\u0438\u043D\u0430. \u041C\u0435\u0441\u0442\u043D\u044B\u0435
      \u0435\u0439 \u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0433\u043E\u043D\u044F\u0442 \u044F\u043A\u043E\u0432
      \u0441 \u043F\u0430\u0441\u0442\u0431\u0438\u0449.\xBB \u0422\u0440\u043E\u043F\u0430
      \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u0438\u043C\u0435\u043D\u043D\u043E
      \u0442\u0430\u043A\u043E\u0439: \u0443\u0437\u043A\u043E\u0439, \u043D\u043E
      \u0442\u0432\u0451\u0440\u0434\u043E\u0439, \u0441 \u043F\u043E\u043B\u043E\u0433\u0438\u043C
      \u043F\u043E\u0434\u044A\u0451\u043C\u043E\u043C \u0438 \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u043C
      \u0433\u0440\u0443\u043D\u0442\u043E\u043C. \u041D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435
      - \u0433\u043E\u0440\u044F\u0447\u0438\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A,
      \u0433\u0434\u0435 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043D\u0430\u043F\u043E\u0438\u043B
      \u044F\u043A\u043E\u0432 \u0438 \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u043B
      \u0431\u0443\u0440\u0434\u044E\u043A\u0438. \u041F\u043E \u0434\u043E\u0440\u043E\u0433\u0435
      \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0441\u043E\u0440\u0432\u0430\u043B
      \u043F\u0443\u0447\u043E\u043A \u0433\u043E\u0440\u043D\u043E\u0433\u043E \u0436\u0435\u043D\u044C\u0448\u0435\u043D\u044F
      \u0438 \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B \u0432\u0430\u043C:
      \xAB\u0417\u0430 \u0434\u043E\u0432\u0435\u0440\u0438\u0435.\xBB \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0432\u044B\u0448\u043B\u0438 \u0432 \u0434\u043E\u043B\u0438\u043D\u0443
      \u0441 \u043F\u043E\u043B\u043D\u044B\u043C\u0438 \u0437\u0430\u043F\u0430\u0441\u0430\u043C\u0438
      \u0438 \u043B\u0451\u0433\u043A\u0438\u043C \u0441\u0435\u0440\u0434\u0446\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060731
    m_Localized: "\u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u043A\u0443\u043F\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060732
    m_Localized: "\u041D\u0430 \u043F\u0435\u0440\u0435\u043A\u0440\u0451\u0441\u0442\u043A\u0435
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043D\u044B\u0445 \u0442\u0440\u043E\u043F
      \u0441\u0442\u043E\u0438\u0442 \u0437\u0430\u043F\u044B\u043B\u0451\u043D\u043D\u044B\u0439
      \u0444\u0443\u0440\u0433\u043E\u043D \u0441 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u043C
      \u0431\u0438\u0440\u044E\u0437\u043E\u0432\u044B\u043C \u043F\u043E\u043B\u043E\u0433\u043E\u043C.
      \u0420\u044F\u0434\u043E\u043C: \u043A\u043E\u0440\u0435\u043D\u0430\u0441\u0442\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432 \u043A\u0430\u0444\u0442\u0430\u043D\u0435
      \u0441 \u0437\u043E\u043B\u043E\u0442\u044B\u043C \u0448\u0438\u0442\u044C\u0451\u043C
      \u0438 \u043A\u0440\u0443\u0433\u043B\u043E\u0439 \u0432\u043E\u0439\u043B\u043E\u0447\u043D\u043E\u0439
      \u0448\u0430\u043F\u043A\u0435, \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u0435\u0442
      \u0442\u044E\u043A\u0438, \u043F\u0440\u0438\u0434\u0438\u0440\u0447\u0438\u0432\u043E
      \u0449\u0443\u043F\u0430\u044F \u043A\u0430\u0436\u0434\u044B\u0439 \u0448\u043E\u0432.
      \u0417\u0430\u0432\u0438\u0434\u0435\u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u043E\u043D \u0432\u044B\u043F\u0440\u044F\u043C\u043B\u044F\u0435\u0442\u0441\u044F,
      \u0443\u0442\u0438\u0440\u0430\u0435\u0442 \u043B\u043E\u0431 \u0440\u0443\u043A\u0430\u0432\u043E\u043C
      \u0438 \u043E\u043A\u043B\u0438\u043A\u0430\u0435\u0442, \u0431\u044B\u0441\u0442\u0440\u043E
      \u0438 \u0434\u0435\u043B\u043E\u0432\u0438\u0442\u043E, \u043D\u0430 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C.
      \u0415\u0433\u043E \u0432\u043E\u0437\u043D\u0438\u0446\u0430, \u0441\u0443\u0445\u043E\u043D\u044C\u043A\u0438\u0439
      \u0441\u0442\u0430\u0440\u0438\u043A \u0441 \u0434\u0443\u0431\u043B\u0451\u043D\u044B\u043C
      \u043B\u0438\u0446\u043E\u043C, \u0440\u0430\u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u043F\u044B\u043B\u044C\u043D\u043E\u0439 \u043A\u043E\u0448\u043C\u0435
      \u043E\u0431\u0440\u0430\u0437\u0446\u044B \u0442\u043A\u0430\u043D\u0435\u0439:
      \u043F\u0430\u0440\u0447\u0430, \u0448\u0451\u043B\u043A, \u0447\u0442\u043E-\u0442\u043E
      \u0442\u0451\u043C\u043D\u043E-\u043A\u0440\u0430\u0441\u043D\u043E\u0435 \u0441
      \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u043E\u0439 \u043D\u0438\u0442\u044C\u044E.\r\n\r\n<npc_speech
      lang=\"Sogdian\">\u041F\u0440\u0438\u0432\u0435\u0442, \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A!
      \u0423 \u043C\u0435\u043D\u044F \u043F\u0430\u0440\u0447\u0430 \u0438\u0437
      \u041A\u0438\u0442\u0430\u044F - \u0448\u0451\u043B\u043A, \u0447\u0442\u043E
      \u0432 \u0411\u0443\u0445\u0430\u0440\u0435 \u0441\u0442\u043E\u0438\u0442
      \u0432\u0442\u0440\u043E\u0435 \u0434\u043E\u0440\u043E\u0436\u0435. \u0412\u0437\u0433\u043B\u044F\u043D\u0438
      - \u0435\u0441\u043B\u0438 \u043F\u043E\u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F,
      \u0441\u0442\u043E\u0440\u0433\u0443\u0435\u043C\u0441\u044F!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060733
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C \u0436\u0435\u0441\u0442\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060734
    m_Localized: "\u042F\u0437\u044B\u043A \u0436\u0435\u0441\u0442\u043E\u0432 \u0443\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u0435\u043D:
      \u044F\u0437\u044B\u043A \u043B\u044E\u0431\u043E\u0433\u043E \u0431\u0430\u0437\u0430\u0440\u0430.
      \u0412\u044B \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438 \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438
      \u0446\u0435\u043D\u0443, \u043A\u0443\u043F\u0435\u0446 \u043F\u043E\u043A\u0430\u0447\u0430\u043B
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439, \u043F\u043E\u043A\u0430\u0437\u0430\u043B
      \u0441\u0432\u043E\u044E. \u0422\u0440\u0438 \u043A\u0440\u0443\u0433\u0430
      \u043F\u0435\u0440\u0435\u0442\u044B\u043A\u0438\u0432\u0430\u043D\u0438\u0439,
      \u0442\u044B\u0447\u043A\u043E\u0432 \u0432 \u0442\u044E\u043A\u0438 \u0438
      \u043F\u043E\u0436\u0438\u043C\u0430\u043D\u0438\u0439 \u043F\u043B\u0435\u0447\u0430\u043C\u0438.
      \u0421\u0434\u0435\u043B\u043A\u0430 \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u0430\u0441\u044C.
      \u041F\u0435\u0440\u0435\u043F\u043B\u0430\u0442\u0438\u043B\u0438: \u0431\u0435\u0437
      \u0441\u043B\u043E\u0432 \u043D\u0435 \u0432\u044B\u0442\u043E\u0440\u0433\u0443\u0435\u0448\u044C,
      \u0438 \u0441\u043E\u0433\u0434\u0438\u0435\u0446 \u044D\u0442\u043E \u0437\u043D\u0430\u043B.
      \u0417\u0430\u0442\u043E \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435
      \u043F\u0440\u0438\u0431\u0430\u0432\u0438\u043B\u0441\u044F \u043E\u0442\u0440\u0435\u0437
      \u0445\u043B\u043E\u043F\u043A\u0430, \u0430 \u043A\u0443\u043F\u0435\u0446
      \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B \u0432\u0430\u0441 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E\u0439
      \u0443\u0445\u043C\u044B\u043B\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060735
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u043F\u043E\u043D\u044F\u0442\u044C \u0438 \u043F\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060736
    m_Localized: "\u0412\u044B \u0443\u043B\u043E\u0432\u0438\u043B\u0438 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0435
      \u0441\u043B\u043E\u0432\u0430 (\xAB\u043F\u0430\u0440\u0447\u0430\xBB, \xAB\u0411\u0443\u0445\u0430\u0440\u0430\xBB,
      \xAB\u0446\u0435\u043D\u0430\xBB) \u0438 \u0440\u0438\u0441\u043A\u043D\u0443\u043B\u0438
      \u043E\u0442\u0432\u0435\u0442\u0438\u0442\u044C, \u043C\u0435\u0448\u0430\u044F
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0435 \u043E\u0431\u0440\u044B\u0432\u043A\u0438
      \u0441 \u0436\u0435\u0441\u0442\u0430\u043C\u0438 \u0438 \u0438\u043D\u0442\u043E\u043D\u0430\u0446\u0438\u0435\u0439.
      \u041A\u0443\u043F\u0435\u0446 \u043F\u0440\u0438\u0449\u0443\u0440\u0438\u043B\u0441\u044F,
      \u043F\u043E\u0442\u043E\u043C \u0440\u0430\u0441\u0445\u043E\u0445\u043E\u0442\u0430\u043B\u0441\u044F
      \u0438 \u0445\u043B\u043E\u043F\u043D\u0443\u043B \u0432\u0430\u0441 \u043F\u043E
      \u043F\u043B\u0435\u0447\u0443. \u0414\u0430\u043B\u044C\u0448\u0435 \u0442\u043E\u0440\u0433
      \u043F\u043E\u0448\u0451\u043B \u0436\u0438\u0432\u0435\u0435: \u043E\u043D
      \u0441\u0431\u0430\u0432\u0438\u043B \u0446\u0435\u043D\u0443, \u0432\u044B
      \u043F\u0440\u0438\u0431\u0430\u0432\u0438\u043B\u0438 \u0443\u043B\u044B\u0431\u043A\u0443,
      \u0438 \u0447\u0435\u0440\u0435\u0437 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C
      \u0447\u0430\u0441\u0430 \u043F\u0430\u0440\u0447\u0430 \u0438\u0437 \u0427\u0430\u043D\u044A\u0430\u043D\u044F
      \u043F\u0435\u0440\u0435\u043A\u043E\u0447\u0435\u0432\u0430\u043B\u0430 \u0432
      \u0432\u0430\u0448 \u0442\u044E\u043A \u0437\u0430 \u0441\u043C\u0435\u0445\u043E\u0442\u0432\u043E\u0440\u043D\u044B\u0435
      \u0434\u0435\u043D\u044C\u0433\u0438. \u0421\u043E\u0433\u0434\u0438\u0435\u0446
      \u043F\u043E\u0434\u043C\u0438\u0433\u043D\u0443\u043B: <npc_speech lang=\"Sogdian\">\u041A\u0442\u043E
      \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      - \u0442\u043E\u0442 \u0443\u0436\u0435 \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u0441\u0432\u043E\u0439.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060737
    m_Localized: "\u0421\u043B\u043E\u0432\u0430 \u043F\u0440\u043E\u0437\u0432\u0443\u0447\u0430\u043B\u0438
      \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E - \u043D\u043E \u043D\u0435
      \u0442\u0435. \u0412\u044B \u043F\u0435\u0440\u0435\u043F\u0443\u0442\u0430\u043B\u0438
      \xAB\u0442\u0440\u0438\xBB \u0438 \xAB\u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C\xBB,
      \u0430 \u0436\u0435\u0441\u0442, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0432\u0430\u043C \u0437\u043D\u0430\u043A\u043E\u043C,
      \u0443 \u0441\u043E\u0433\u0434\u0438\u0439\u0446\u0435\u0432 \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442
      \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0435 \u043D\u0430 \u043F\u0435\u0440\u0432\u0443\u044E
      \u0446\u0435\u043D\u0443. \u041A\u0443\u043F\u0435\u0446 \u043A\u0438\u0432\u043D\u0443\u043B,
      \u043F\u043E\u0436\u0430\u043B \u0440\u0443\u043A\u0443 \u0438 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E
      \u0437\u0430\u0432\u0435\u0440\u043D\u0443\u043B \u0442\u044E\u043A. \u041A\u043E\u0433\u0434\u0430
      \u043E\u0448\u0438\u0431\u043A\u0430 \u0434\u043E\u0448\u043B\u0430 \u0434\u043E
      \u0432\u0430\u0441, \u0444\u0443\u0440\u0433\u043E\u043D \u0443\u0436\u0435
      \u0441\u043A\u0440\u0438\u043F\u0435\u043B \u043F\u0440\u043E\u0447\u044C \u043F\u043E
      \u0434\u043E\u0440\u043E\u0433\u0435. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u043E\u043A\u043E\u0441\u0438\u043B\u0438\u0441\u044C \u0438 \u043F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u043B\u0438.
      \u0423\u0441\u043C\u0435\u0448\u043A\u0438 \u0441\u043A\u0430\u0437\u0430\u043B\u0438
      \u0432\u0441\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060738
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u0442\u043E\u0440\u0433 \u043D\u0430 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060739
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0448\u0430\u0433\u043D\u0443\u043B
      \u0432\u043F\u0435\u0440\u0451\u0434 \u0438 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u043D\u0430 \u0447\u0438\u0441\u0442\u043E\u043C \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C,
      \u0431\u0435\u0433\u043B\u043E, \u0441 \u0431\u0443\u0445\u0430\u0440\u0441\u043A\u0438\u043C
      \u0430\u043A\u0446\u0435\u043D\u0442\u043E\u043C: <npc_speech lang=\"Sogdian\">\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439,
      \u043A\u0443\u043F\u0435\u0446! \u042F \u0438\u0437 \u0411\u0443\u0445\u0430\u0440\u044B,
      \u043A\u0430\u043A \u0438 \u0442\u044B. \u041F\u043E\u043A\u0430\u0436\u0438
      \u043F\u0430\u0440\u0447\u0443 - \u043F\u043E\u0442\u043E\u0440\u0433\u0443\u0435\u043C\u0441\u044F
      \u043F\u043E-\u043D\u0430\u0448\u0435\u043C\u0443, \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0441\u043B\u043E\u0432.</npc_speech> \u041A\u0443\u043F\u0435\u0446 \u0432\u0441\u043A\u0438\u043D\u0443\u043B
      \u0431\u0440\u043E\u0432\u0438 \u0438 \u0440\u0430\u0441\u043F\u043B\u044B\u043B\u0441\u044F
      \u0432 \u0443\u043B\u044B\u0431\u043A\u0435: \u0437\u0435\u043C\u043B\u044F\u043A!"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774501060740
    m_Localized: "\u0410\u0440\u0430\u0431\u0441\u043A\u043E\u0435 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254912
    m_Localized: "\u0418\u0437-\u0437\u0430 \u0433\u0440\u0435\u0431\u043D\u044F
      \u0431\u0430\u0440\u0445\u0430\u043D\u0430 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0432\u0441\u0430\u0434\u043D\u0438\u043A \u043D\u0430 \u0445\u0443\u0434\u043E\u043C
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0435 (\u0431\u0435\u043B\u044B\u0435
      \u043E\u0434\u0435\u0436\u0434\u044B \u0432 \u043F\u044B\u043B\u0438, \u0442\u044E\u0440\u0431\u0430\u043D
      \u0440\u0430\u0437\u043C\u043E\u0442\u0430\u043D \u0438 \u0431\u043E\u043B\u0442\u0430\u0435\u0442\u0441\u044F
      \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439, \u043D\u0430 \u043F\u043E\u044F\u0441\u0435
      \u043A\u0440\u0438\u0432\u043E\u0439 \u043A\u0438\u043D\u0436\u0430\u043B).
      \u041E\u043D \u0433\u043E\u043D\u0438\u0442 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430
      \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u0440\u0430\u0437\u043C\u0430\u0445\u0438\u0432\u0430\u044F \u0440\u0443\u043A\u0430\u043C\u0438
      \u0438 \u043A\u0440\u0438\u0447\u0430. \u0413\u043E\u043B\u043E\u0441 \u0445\u0440\u0438\u043F\u043B
      \u043E\u0442 \u0436\u0430\u0436\u0434\u044B, \u0441\u043B\u043E\u0432\u0430
      \u0431\u044C\u044E\u0442\u0441\u044F \u043E \u0432\u0435\u0442\u0435\u0440
      \u0438 \u0440\u0432\u0443\u0442\u0441\u044F \u043D\u0430 \u043A\u0443\u0441\u043A\u0438.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0441\u0445\u0432\u0430\u0442\u0438\u043B\u0438\u0441\u044C
      \u0437\u0430 \u043E\u0440\u0443\u0436\u0438\u0435: \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E,
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u0435\u0442
      \u043E\u043D \u0438\u043B\u0438 \u0443\u0433\u0440\u043E\u0436\u0430\u0435\u0442.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434 \u0432\u0441\u0442\u0430\u043B \u0432
      \u0434\u0435\u0441\u044F\u0442\u0438 \u0448\u0430\u0433\u0430\u0445, \u0442\u044F\u0436\u0435\u043B\u043E
      \u043F\u043E\u0432\u043E\u0434\u044F \u0431\u043E\u043A\u0430\u043C\u0438,
      \u0430 \u0432\u0441\u0430\u0434\u043D\u0438\u043A \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442
      \u043A\u0440\u0438\u0447\u0430\u0442\u044C, \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044F
      \u043A\u0443\u0434\u0430-\u0442\u043E \u0437\u0430 \u0441\u043F\u0438\u043D\u0443:\r\n\r\n<npc_speech
      lang=\"Arabic\">\u041D\u0435 \u0445\u043E\u0434\u0438\u0442\u0435 \u0442\u0443\u0434\u0430!
      \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438 - \u0434\u0435\u0441\u044F\u0442\u044C
      \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u043E\u0432 - \u0436\u0434\u0443\u0442
      \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430! \u0412\u0447\u0435\u0440\u0430
      \u0432\u044B\u0440\u0435\u0437\u0430\u043B\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D!
      \u0421\u0432\u0435\u0440\u043D\u0438\u0442\u0435 \u0432 \u0441\u0435\u0432\u0435\u0440\u043D\u0443\u044E
      \u0434\u043E\u043B\u0438\u043D\u0443 - \u0442\u0430\u043C \u0434\u0440\u0443\u0433\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254913
    m_Localized: "\u041F\u0440\u043E\u0438\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0438 \u0438\u0434\u0442\u0438 \u043F\u0440\u0435\u0436\u043D\u0438\u043C
      \u043F\u0443\u0442\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254914
    m_Localized: "\u0427\u0443\u0436\u043E\u0439 \u0432\u0441\u0430\u0434\u043D\u0438\u043A
      - \u0443\u0433\u0440\u043E\u0437\u0430. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043E\u0431\u043E\u0448\u0451\u043B \u0435\u0433\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439,
      \u0441\u0442\u0438\u0441\u043D\u0443\u0432 \u043E\u0440\u0443\u0436\u0438\u0435.
      \u0410\u0440\u0430\u0431 \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u0432\u0441\u043B\u0435\u0434,
      \u0431\u0435\u0441\u0441\u0438\u043B\u044C\u043D\u043E \u0443\u0440\u043E\u043D\u0438\u0432
      \u0440\u0443\u043A\u0438, \u043F\u043E\u0442\u043E\u043C \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430 \u0438 \u0443\u0448\u0451\u043B
      \u043D\u0430 \u0441\u0435\u0432\u0435\u0440. \u0427\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430 \u0447\u0430\u0441\u0430 \u043F\u0435\u0440\u0435\u0434\u043E\u0432\u043E\u0439
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0437\u0430\u043C\u0435\u0442\u0438\u043B
      \u043D\u0430 \u043F\u0435\u0441\u043A\u0435 \u0442\u0451\u043C\u043D\u044B\u0435
      \u043F\u044F\u0442\u043D\u0430: \u043A\u0440\u043E\u0432\u044C. \u0415\u0449\u0451
      \u0447\u0435\u0440\u0435\u0437 \u043B\u0438\u0433\u0443: \u043F\u0435\u0440\u0435\u0432\u0451\u0440\u043D\u0443\u0442\u044B\u0439
      \u0444\u0443\u0440\u0433\u043E\u043D \u0441 \u0432\u044B\u043F\u043E\u0442\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u043C\u0438
      \u0442\u044E\u043A\u0430\u043C\u0438 \u0438 \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u043C\u0438
      \u0441\u0442\u0440\u0435\u043B\u0430\u043C\u0438 \u0432 \u0431\u043E\u0440\u0442\u0430\u0445.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0448\u0451\u043B
      \u043C\u0438\u043C\u043E \u043C\u043E\u043B\u0447\u0430. \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u0441\u0442\u0430\u043B\u0430 \u043E\u0441\u044F\u0437\u0430\u0435\u043C\u043E\u0439:
      \u0431\u0430\u043D\u0434\u0438\u0442\u044B \u0433\u0434\u0435-\u0442\u043E
      \u0440\u044F\u0434\u043E\u043C, \u0430 \u0432\u044B \u0438\u0434\u0451\u0442\u0435
      \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u043D\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254915
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C
      \u0441\u043B\u043E\u0432\u0430 \u043F\u043E \u043A\u043E\u043D\u0442\u0435\u043A\u0441\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254916
    m_Localized: "\xAB\u041A\u043E\u043B\u043E\u0434\u0435\u0446\xBB, \xAB\u0434\u0435\u0441\u044F\u0442\u044C
      \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u043E\u0432\xBB, \xAB\u0432\u0447\u0435\u0440\u0430\xBB:
      \u043E\u0431\u0440\u044B\u0432\u043A\u0438 \u0430\u0440\u0430\u0431\u0441\u043A\u0438\u0445
      \u0441\u043B\u043E\u0432, \u0436\u0435\u0441\u0442\u044B, \u0432\u044B\u0442\u0430\u0440\u0430\u0449\u0435\u043D\u043D\u044B\u0435
      \u0433\u043B\u0430\u0437\u0430. \u0412\u044B \u0441\u043B\u043E\u0436\u0438\u043B\u0438
      \u043E\u0441\u043A\u043E\u043B\u043A\u0438 \u0432 \u043A\u0430\u0440\u0442\u0438\u043D\u0443:
      \u0437\u0430\u0441\u0430\u0434\u0430 \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430,
      \u0434\u0435\u0441\u044F\u0442\u044C \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0445,
      \u0432\u0447\u0435\u0440\u0430 \u0443\u0436\u0435 \u043A\u043E\u0433\u043E-\u0442\u043E
      \u043E\u0433\u0440\u0430\u0431\u0438\u043B\u0438. \u0420\u0438\u0441\u043A\u043D\u0443\u0442\u044C
      \u0438\u043B\u0438 \u043E\u0431\u043E\u0439\u0442\u0438? \u0420\u0435\u0448\u0438\u043B\u0438
      \u043E\u0431\u043E\u0439\u0442\u0438. \u041A\u0440\u044E\u043A \u0432 \u043F\u043E\u043B\u0434\u043D\u044F,
      \u0437\u0430\u0442\u043E \u0431\u0435\u0437 \u043A\u0440\u043E\u0432\u0438.
      \u0412\u043E\u0434\u044B \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B\u0438
      \u0431\u043E\u043B\u044C\u0448\u0435, \u043D\u043E \u043A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0432\u044B\u0448\u043B\u0438 \u043D\u0430 \u0442\u0440\u043E\u043F\u0443
      \u0437\u0430 \u043A\u043E\u043B\u043E\u0434\u0446\u0435\u043C, \u043E\u0441\u0442\u0430\u0432\u0438\u0432
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432 \u043F\u043E\u0437\u0430\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254917
    m_Localized: "\u0421\u043B\u043E\u0432\u0430 \u0447\u0443\u0436\u0438\u0435,
      \u0436\u0435\u0441\u0442\u044B \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u044B.
      \u0412\u044B \u0440\u0435\u0448\u0438\u043B\u0438, \u0447\u0442\u043E \u0430\u0440\u0430\u0431
      \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043A\u043E\u0440\u043E\u0442\u043A\u0443\u044E
      \u0434\u043E\u0440\u043E\u0433\u0443, \u0438 \u0441\u0432\u0435\u0440\u043D\u0443\u043B\u0438
      \u0432 \u0432\u0430\u0434\u0438. \u0423\u0437\u043A\u0438\u0439 \u043F\u0440\u043E\u0445\u043E\u0434
      \u0437\u0430\u0432\u0451\u043B \u0432 \u0442\u0443\u043F\u0438\u043A: \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0435
      \u0441\u0442\u0435\u043D\u044B, \u0441\u044B\u043F\u0443\u0447\u0438\u0439
      \u043F\u0435\u0441\u043E\u043A, \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0437\u0430\u0441\u0442\u0440\u044F\u043B\u0438 \u043F\u043E \u0441\u0442\u0443\u043F\u0438\u0446\u044B.
      \u041F\u043E\u043B\u0434\u043D\u044F \u043D\u0430 \u0432\u044B\u0442\u0430\u0441\u043A\u0438\u0432\u0430\u043D\u0438\u0435,
      \u0431\u0443\u0440\u0434\u044E\u043A \u0441 \u0432\u043E\u0434\u043E\u0439
      \u043B\u043E\u043F\u043D\u0443\u043B \u043F\u043E\u0434 \u043A\u043E\u043B\u0435\u0441\u043E\u043C,
      \u0430 \u043A\u043E\u0433\u0434\u0430 \u0432\u044B\u0431\u0440\u0430\u043B\u0438\u0441\u044C,
      \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u0447\u0442\u043E
      \u0441\u0434\u0435\u043B\u0430\u043B\u0438 \u043A\u0440\u0443\u0433 \u0438
      \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u043A \u043D\u0430\u0447\u0430\u043B\u0443.
      \u0412\u0441\u0430\u0434\u043D\u0438\u043A \u0434\u0430\u0432\u043D\u043E \u0438\u0441\u0447\u0435\u0437.
      \u0422\u043E, \u0447\u0442\u043E \u043E\u043D \u043A\u0440\u0438\u0447\u0430\u043B,
      \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0437\u0430\u0433\u0430\u0434\u043A\u043E\u0439
      - \u043D\u043E \u044F\u0432\u043D\u043E \u043D\u0435 \xAB\u0441\u0432\u0435\u0440\u043D\u0438\u0442\u0435
      \u0441\u044E\u0434\u0430\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254918
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u044B\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0435\u0442
      \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254919
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u043E\u0434\u043D\u044F\u043B
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0435 \u043B\u0430\u0434\u043E\u043D\u0438
      (\u0436\u0435\u0441\u0442 \u043C\u0438\u0440\u0430) \u0438 \u043E\u0431\u0440\u0430\u0442\u0438\u043B\u0441\u044F
      \u043A \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u0443 \u043D\u0430 \u0430\u0440\u0430\u0431\u0441\u043A\u043E\u043C.
      \u0422\u043E\u0442 \u0432\u0437\u0434\u0440\u043E\u0433\u043D\u0443\u043B \u043E\u0442
      \u043E\u0431\u043B\u0435\u0433\u0447\u0435\u043D\u0438\u044F, \u0441\u043F\u0435\u0448\u0438\u043B\u0441\u044F
      \u0438 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B, \u0437\u0430\u0445\u043B\u0451\u0431\u044B\u0432\u0430\u044F\u0441\u044C
      \u0441\u043B\u043E\u0432\u0430\u043C\u0438: <npc_speech lang=\"Arabic\">\u041E\u043D\u0438
      \u0437\u0430\u0441\u0435\u043B\u0438 \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430
      - \u0434\u0435\u0441\u044F\u0442\u044C, \u043C\u043E\u0436\u0435\u0442 \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C!
      \u0412\u0447\u0435\u0440\u0430 \u0440\u0430\u0437\u0433\u0440\u0430\u0431\u0438\u043B\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0438\u0437 \u041C\u0435\u0440\u0432\u0430,
      \u043D\u0438\u043A\u043E\u0433\u043E \u043D\u0435 \u043F\u043E\u0449\u0430\u0434\u0438\u043B\u0438!
      \u0421\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0442\u0435 \u0432
      \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0435 \u0432\u0430\u0434\u0438,
      \u0442\u0430\u043C \u0442\u0440\u043E\u043F\u0430 \u0434\u043E \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254920
    m_Localized: "\u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043C\u043E\u043D\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254921
    m_Localized: "\u041D\u0430 \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435, \u0433\u0434\u0435 \u0432\u0435\u0442\u0435\u0440
      \u0441\u0432\u0438\u0441\u0442\u0438\u0442 \u043C\u0435\u0436\u0434\u0443 \u0432\u0430\u043B\u0443\u043D\u0430\u043C\u0438,
      \u0438\u0437 \u0431\u043E\u043A\u043E\u0432\u043E\u0433\u043E \u0443\u0449\u0435\u043B\u044C\u044F
      \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0444\u0438\u0433\u0443\u0440\u0430
      \u0432 \u0442\u0451\u043C\u043D\u043E-\u0431\u0430\u0433\u0440\u044F\u043D\u043E\u043C
      \u043F\u043B\u0430\u0449\u0435 \u043F\u043E\u0432\u0435\u0440\u0445 \u043A\u043B\u0451\u043F\u0430\u043D\u043E\u0439
      \u043A\u043E\u043B\u044C\u0447\u0443\u0433\u0438: \u043D\u043E \u044D\u0442\u043E
      \u043D\u0435 \u0432\u043E\u0438\u043D. \u0411\u0440\u0438\u0442\u0430\u044F
      \u0433\u043E\u043B\u043E\u0432\u0430, \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0435
      \u0447\u0451\u0442\u043A\u0438 \u043D\u0430 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u0435,
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0435 \u0433\u043B\u0430\u0437\u0430.
      \u041C\u043E\u043D\u0430\u0445-\u0432\u043E\u0438\u043D \u0438\u0437 \u0433\u043E\u0440\u043D\u043E\u0433\u043E
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F. \u0417\u0430 \u0435\u0433\u043E
      \u0441\u043F\u0438\u043D\u043E\u0439, \u0432\u044B\u0440\u0443\u0431\u043B\u0435\u043D\u043D\u0430\u044F
      \u0432 \u0441\u043A\u0430\u043B\u0435 \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0430
      \u0432\u0435\u0434\u0451\u0442 \u0432\u0432\u0435\u0440\u0445, \u043A \u0431\u0435\u043B\u0451\u043D\u044B\u043C
      \u0441\u0442\u0435\u043D\u0430\u043C, \u043E\u0442\u043A\u0443\u0434\u0430
      \u0432\u044C\u0451\u0442\u0441\u044F \u0434\u044B\u043C\u043E\u043A \u043C\u043E\u0436\u0436\u0435\u0432\u0435\u043B\u044C\u043D\u0438\u043A\u0430.
      \u041C\u043E\u043D\u0430\u0445 \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F,
      \u043F\u0440\u0438\u0436\u0430\u0432 \u043B\u0430\u0434\u043E\u043D\u0438,
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0440\u0430\u0437\u043C\u0435\u0440\u0435\u043D\u043D\u043E,
      \u043A\u0430\u043A \u0447\u0438\u0442\u0430\u0435\u0442 \u043C\u043E\u043B\u0438\u0442\u0432\u0443:\r\n\r\n<npc_speech
      lang=\"Tibetan\">\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E,
      \u0433\u043E\u0441\u0442\u044C. \u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C.
      \u042F \u043C\u043E\u0433\u0443 \u0434\u0430\u0442\u044C \u0432\u0430\u043C
      \u043A\u0440\u043E\u0432 \u0438 \u043F\u0438\u0449\u0443 - \u0437\u0438\u043C\u043D\u044F\u044F
      \u0431\u0443\u0440\u044F \u0438\u0434\u0451\u0442, \u043E\u0442\u0441\u044E\u0434\u0430
      \u043D\u0435 \u0443\u0439\u0442\u0438. \u0412\u0445\u043E\u0434\u0438\u0442\u0435,
      \u0435\u0441\u0442\u044C \u0447\u0430\u0439 \u0438 \u0446\u0430\u043C\u043F\u0430.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254922
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u043B\u043E\u043D\u0438\u0442\u044C
      \u0438 \u0438\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254923
    m_Localized: "\u041F\u043E\u043A\u043B\u043E\u043D, \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u043D\u0430\u044F
      \u043A \u0433\u0440\u0443\u0434\u0438 \u043B\u0430\u0434\u043E\u043D\u044C:
      \u044F\u0437\u044B\u043A \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F \u043D\u0435
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0441\u043B\u043E\u0432. \u041C\u043E\u043D\u0430\u0445
      \u043A\u0438\u0432\u043D\u0443\u043B \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B
      \u0438 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u0443\u0449\u0435\u043B\u044C\u0435.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435 \u043F\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0432\u0435\u0442\u0435\u0440 \u0443\u0441\u0438\u043B\u0438\u043B\u0441\u044F,
      \u0441\u043D\u0435\u0433 \u0431\u0438\u043B \u0432 \u043B\u0438\u0446\u043E,
      \u043B\u044E\u0434\u0438 \u0436\u0430\u043B\u0438\u0441\u044C \u043A \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u043C.
      \u0422\u0451\u043F\u043B\u044B\u0435 \u0441\u0442\u0435\u043D\u044B \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F
      \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u043F\u043E\u0437\u0430\u0434\u0438.
      \u041C\u043E\u0436\u0435\u0442, \u043D\u0430\u043F\u0440\u0430\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254924
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C\u0441\u044F
      \u0436\u0435\u0441\u0442\u0430\u043C\u0438 \u0438 \u0432\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254925
    m_Localized: "\u041B\u0430\u0434\u043E\u043D\u0438 \u0432\u043C\u0435\u0441\u0442\u0435,
      \u043F\u043E\u043A\u043B\u043E\u043D, \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u0435
      \u043D\u0430 \u043D\u0435\u0431\u043E \u0438 \u043D\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D:
      \u043C\u043E\u043D\u0430\u0445 \u043F\u043E\u043D\u044F\u043B. \u041E\u043D
      \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F \u0438 \u043F\u043E\u0432\u0451\u043B
      \u043D\u0430\u0432\u0435\u0440\u0445 \u043F\u043E \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0439
      \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0435. \u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u043C
      (\u043F\u044F\u0442\u044C \u043A\u0435\u043B\u0438\u0439, \u043A\u0443\u0445\u043D\u044F,
      \u0437\u0430\u043B \u0434\u043B\u044F \u043C\u043E\u043B\u0438\u0442\u0432),
      \u043D\u043E \u0441\u0442\u0435\u043D\u044B \u0434\u0435\u0440\u0436\u0430\u043B\u0438
      \u0432\u0435\u0442\u0435\u0440, \u0430 \u0432 \u043E\u0447\u0430\u0433\u0435
      \u0433\u043E\u0440\u0435\u043B \u044F\u0447\u0438\u0439 \u043A\u0438\u0437\u044F\u043A.
      \u041C\u043E\u043D\u0430\u0445\u0438 \u043D\u0430\u043A\u043E\u0440\u043C\u0438\u043B\u0438
      \u0446\u0430\u043C\u043F\u043E\u0439 \u0441 \u043C\u0430\u0441\u043B\u043E\u043C,
      \u043D\u0430\u043F\u043E\u0438\u043B\u0438 \u0441\u043E\u043B\u0451\u043D\u044B\u043C
      \u0447\u0430\u0435\u043C, \u0438 \u043E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445,
      \u0441\u0442\u0430\u0440\u0438\u043A \u0441 \u0440\u0443\u043A\u0430\u043C\u0438
      \u0442\u0440\u0430\u0432\u043D\u0438\u043A\u0430, \u043C\u043E\u043B\u0447\u0430
      \u0432\u043B\u043E\u0436\u0438\u043B \u0432 \u0432\u0430\u0448\u0443 \u043B\u0430\u0434\u043E\u043D\u044C
      \u043F\u0443\u0447\u043E\u043A \u0433\u043E\u0440\u043D\u044B\u0445 \u043A\u043E\u0440\u043D\u0435\u0439,
      \u043F\u043E\u0445\u043E\u0436\u0438\u0445 \u043D\u0430 \u0436\u0435\u043D\u044C\u0448\u0435\u043D\u044C.
      \u041D\u043E\u0447\u044C \u043F\u0440\u043E\u0448\u043B\u0430 \u0432 \u0442\u0435\u043F\u043B\u0435.
      \u0423\u0442\u0440\u043E\u043C \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0432\u0448\u0438\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0441\u043F\u0443\u0441\u043A\u0430\u043B\u0441\u044F
      \u043F\u043E \u0442\u0440\u043E\u043F\u0435, \u0430 \u0432 \u0443\u0448\u0430\u0445
      \u0435\u0449\u0451 \u0437\u0432\u0435\u043D\u0435\u043B\u043E \u043C\u043E\u043D\u043E\u0442\u043E\u043D\u043D\u043E\u0435
      \u043F\u0435\u043D\u0438\u0435 \u0438\u0437 \u0437\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254926
    m_Localized: "\u0416\u0435\u0441\u0442\u044B \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0434\u0432\u0443\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u044B. \u041C\u043E\u043D\u0430\u0445
      \u043D\u0430\u0445\u043C\u0443\u0440\u0438\u043B\u0441\u044F, \u043F\u043E\u043A\u0430\u0447\u0430\u043B
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0437\u043D\u0430\u043A: \u0432\u0438\u0434\u0438\u043C\u043E,
      \u0432\u044B \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u043E \u0438\u0437\u043E\u0431\u0440\u0430\u0437\u0438\u043B\u0438
      \u0447\u0442\u043E-\u0442\u043E \u043D\u0435\u043F\u043E\u0447\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435.
      \u041E\u043D \u043D\u0435 \u0440\u0430\u0441\u0441\u0435\u0440\u0434\u0438\u043B\u0441\u044F,
      \u043D\u043E \u0434\u0432\u0435\u0440\u044C \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u0439.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0435\u0440\u0435\u043D\u043E\u0447\u0435\u0432\u0430\u043B
      \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u044B
      \u0432 \u0437\u0430\u0442\u0438\u0448\u043A\u0435 \u0441\u043A\u0430\u043B
      - \u043D\u0435 \u0432 \u0442\u0435\u043F\u043B\u0435, \u043D\u043E \u0445\u043E\u0442\u044F
      \u0431\u044B \u043D\u0435 \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u043C
      \u0432\u0435\u0442\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254927
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043E\u0431\u044B\u0447\u0430\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254928
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0442\u0440\u043E\u043D\u0443\u043B
      \u0432\u0430\u0441 \u0437\u0430 \u0440\u0443\u043A\u0430\u0432: \xAB\u041D\u0435
      \u043A\u043B\u0430\u043D\u044F\u0439\u0442\u0435\u0441\u044C - \u0441\u043B\u043E\u0436\u0438\u0442\u0435
      \u0440\u0443\u043A\u0438 \u043B\u0430\u0434\u043E\u043D\u044F\u043C\u0438 \u0432\u0432\u0435\u0440\u0445.
      \u0417\u043D\u0430\u0447\u0438\u0442: \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044E
      \u0441 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C\u044E.\xBB
      \u041E\u043D \u043E\u0431\u0440\u0430\u0442\u0438\u043B\u0441\u044F \u043A
      \u043C\u043E\u043D\u0430\u0445\u0443 \u043D\u0430 \u043B\u043E\u043C\u0430\u043D\u043E\u043C
      \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u043C, \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u044F \u0441\u043B\u043E\u0432\u0430:
      <npc_speech lang=\"Tibetan\">\u041F\u043E\u0447\u0442\u0435\u043D\u043D\u044B\u0439...
      \u043C\u044B - \u043A\u0430\u0440\u0430\u0432\u0430\u043D. \u0411\u0443\u0440\u044F
      \u0438\u0434\u0451\u0442. \u041F\u0440\u043E\u0441\u0438\u043C \u0443\u043A\u0440\u044B\u0442\u0438\u0435...
      \u0435\u0434\u0443. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043C.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254929
    m_Localized: "\u041F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439 \u0443\u0447\u0451\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254930
    m_Localized: "\u0412 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u043C \u0434\u0432\u043E\u0440\u0435
      \u0437\u0430 \u043D\u0438\u0437\u043A\u0438\u043C \u0433\u043B\u0438\u043D\u044F\u043D\u044B\u043C
      \u0441\u0442\u043E\u043B\u043E\u043C \u0441\u0438\u0434\u0438\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0432 \u0447\u0438\u0441\u0442\u043E\u0439 \u0431\u0435\u043B\u043E\u0439
      \u0447\u0430\u043B\u043C\u0435 \u0438 \u0442\u0451\u043C\u043D\u043E-\u0441\u0438\u043D\u0435\u043C
      \u0443\u0447\u0451\u043D\u043E\u043C \u0445\u0430\u043B\u0430\u0442\u0435.
      \u041F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C: \u0440\u0430\u0437\u0432\u0451\u0440\u043D\u0443\u0442\u044B\u0439
      \u0441\u0432\u0438\u0442\u043E\u043A, \u0447\u0435\u0440\u043D\u0438\u043B\u044C\u043D\u0438\u0446\u0430
      \u0438\u0437 \u043E\u043D\u0438\u043A\u0441\u0430, \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0439
      \u0446\u0438\u0440\u043A\u0443\u043B\u044C \u0438 \u0441\u0442\u043E\u043F\u043A\u0430
      \u0431\u0443\u043C\u0430\u0436\u043D\u044B\u0445 \u043B\u0438\u0441\u0442\u043E\u0432.
      \u041E\u043D \u0447\u0442\u043E-\u0442\u043E \u0437\u0430\u0440\u0438\u0441\u043E\u0432\u044B\u0432\u0430\u0435\u0442,
      \u0431\u043E\u0440\u043C\u043E\u0447\u0435\u0442 \u043F\u043E\u0434 \u043D\u043E\u0441,
      \u0432\u043E\u0434\u0438\u0442 \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u043F\u043E
      \u043B\u0438\u043D\u0438\u044F\u043C. \u0417\u0430\u043C\u0435\u0442\u0438\u0432
      \u043E\u0431\u043E\u0437 \u0432\u043E \u0434\u0432\u043E\u0440\u0435, \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u0443, \u043F\u043E\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442
      \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u0443\u044E \u0431\u043E\u0440\u043E\u0434\u0443
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0443\u0447\u0442\u0438\u0432\u043E,
      \u0441 \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u043E\u043C
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043F\u0440\u0438\u0432\u044B\u043A\u0448\u0435\u0433\u043E
      \u0431\u044B\u0442\u044C \u0443\u0441\u043B\u044B\u0448\u0430\u043D\u043D\u044B\u043C:\r\n\r\n<npc_speech
      lang=\"Persian\">\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E,
      \u043A\u0443\u043F\u0435\u0446-\u0433\u043B\u0430\u0432\u0430\u0440\u044C.
      \u042F \u0424\u0430\u0440\u0445\u0430\u0434, \u0438\u043D\u0436\u0435\u043D\u0435\u0440
      \u0438 \u0433\u0435\u043E\u0433\u0440\u0430\u0444 \u0438\u0437 \u0420\u0435\u044F.
      \u042D\u0442\u0430 \u043C\u043E\u044F \u043A\u0430\u0440\u0442\u0430 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0441\u043A\u0440\u044B\u0442\u044B\u0435 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B
      \u043E\u0442 \u041C\u0435\u0448\u0445\u0435\u0434\u0430 \u0434\u043E \u0411\u0430\u043B\u0445\u0430,
      \u0447\u0435\u0440\u0435\u0437 \u0433\u043E\u0440\u044B. \u041A\u0443\u043F\u0438
      \u0435\u0451 \u0438 \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0448\u044C
      \u043D\u0435\u0434\u0435\u043B\u044E \u043F\u0443\u0442\u0438. \u0426\u0435\u043D\u0430?
      \u041C\u0443\u0434\u0440\u044B\u0439 \u043F\u0443\u0442\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0437\u043D\u0430\u043D\u0438\u0435 \u0441\u0442\u043E\u0438\u0442
      \u043C\u0435\u043D\u044C\u0448\u0435 \u0437\u043E\u043B\u043E\u0442\u0430.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254931
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u043A\u0430\u0440\u0442\u0443
      \u0432\u0441\u043B\u0435\u043F\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254932
    m_Localized: "\u041F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u043C\u043E\u043D\u0435\u0442:
      \u0446\u0435\u043D\u0430 \u043D\u0430\u0437\u0432\u0430\u043D\u0430 \u043D\u0430
      \u043F\u0430\u043B\u044C\u0446\u0430\u0445. \u0423\u0447\u0451\u043D\u044B\u0439
      \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u0441\u0432\u0435\u0440\u043D\u0443\u043B
      \u0441\u0432\u0438\u0442\u043E\u043A, \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043B
      \u0448\u043D\u0443\u0440\u043E\u043C \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u043B
      \u0441 \u043B\u0451\u0433\u043A\u0438\u043C \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C.
      \u041A\u0430\u0440\u0442\u0430 \u043A\u0440\u0430\u0441\u0438\u0432\u0430:
      \u0433\u043E\u0440\u044B, \u0440\u0435\u043A\u0438, \u043E\u0442\u043C\u0435\u0442\u043A\u0438
      \u043A\u043E\u043B\u043E\u0434\u0446\u0435\u0432. \u041D\u043E \u0431\u0435\u0437
      \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u0433\u043E \u043D\u0430\u0434\u043F\u0438\u0441\u0438
      - \u0443\u043A\u0440\u0430\u0448\u0435\u043D\u0438\u0435, \u043D\u0435 \u0431\u043E\u043B\u044C\u0448\u0435.
      \u041F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0438\u0441\u043A\u0430\u0442\u044C
      \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u0441\u043C\u043E\u0436\u0435\u0442
      \u043F\u0440\u043E\u0447\u0435\u0441\u0442\u044C, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u043A\u0430\u0440\u0442\u0430 \u0441\u0442\u0430\u043D\u0435\u0442
      \u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0439. \u0414\u0435\u043D\u044C\u0433\u0438
      \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B, \u043F\u043E\u043B\u044C\u0437\u0430
      \u043F\u043E\u0434 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254933
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0438 \u0440\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0447\u0435\u0440\u0435\u0437
      \u0436\u0435\u0441\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254934
    m_Localized: "\u0412\u044B \u0442\u043A\u043D\u0443\u043B\u0438 \u043F\u0430\u043B\u044C\u0446\u0435\u043C
      \u0432 \u043A\u0430\u0440\u0442\u0443, \u043F\u043E\u0442\u043E\u043C \u0432
      \u043A\u043E\u0448\u0435\u043B\u044C, \u0432\u044B\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u0432\u043E\u0441\u0435\u043C\u044C \u043F\u0430\u043B\u044C\u0446\u0435\u0432
      \u0438 \u0441\u043A\u0435\u043F\u0442\u0438\u0447\u0435\u0441\u043A\u0438 \u043F\u043E\u0434\u0436\u0430\u043B\u0438
      \u0433\u0443\u0431\u044B. \u0423\u0447\u0451\u043D\u044B\u0439 \u0437\u0430\u0441\u043C\u0435\u044F\u043B\u0441\u044F:
      \u044F\u0437\u044B\u043A \u0442\u043E\u0440\u0433\u0430 \u0431\u044B\u043B
      \u0435\u043C\u0443 \u0437\u043D\u0430\u043A\u043E\u043C. \u041E\u043D \u043F\u043E\u043A\u0430\u0437\u0430\u043B
      \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C, \u0432\u044B
      \u0432\u043E\u0441\u0435\u043C\u044C, \u043E\u043D \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C,
      \u0432\u044B \u0434\u0435\u0441\u044F\u0442\u044C, \u043E\u043D \u0432\u0437\u0434\u043E\u0445\u043D\u0443\u043B,
      \u043F\u043E\u0436\u0430\u043B \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438
      \u043A\u0438\u0432\u043D\u0443\u043B \u043D\u0430 \u0432\u043E\u0441\u0435\u043C\u044C.
      \u041F\u043E\u043A\u0430 \u0441\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u043B
      \u0441\u0432\u0438\u0442\u043E\u043A, \u0432\u044B \u0443\u043A\u0430\u0437\u0430\u043B\u0438
      \u043D\u0430 \u043D\u0430\u0434\u043F\u0438\u0441\u0438 \u0438 \u043F\u043E\u0434\u043D\u044F\u043B\u0438
      \u0431\u0440\u043E\u0432\u0438. \u0424\u0430\u0440\u0445\u0430\u0434 \u0432\u0437\u044F\u043B
      \u0447\u0438\u0441\u0442\u044B\u0439 \u043B\u0438\u0441\u0442 \u0438 \u043D\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043B
      \u043F\u043E\u044F\u0441\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
      \u0441\u0445\u0435\u043C\u0443: \u0441\u0442\u0440\u0435\u043B\u043A\u0438,
      \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u0442\u043E\u0447\u043A\u0430\u043C\u0438,
      \u043F\u0440\u043E\u0441\u0442\u044B\u0435 \u0437\u043D\u0430\u043A\u0438 \u0432\u043E\u0434\u044B
      \u0438 \u0433\u043E\u0440\u044B. \u041D\u0435 \u043F\u0435\u0440\u0435\u0432\u043E\u0434,
      \u043D\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0434\u043B\u044F
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430. \u041A \u0441\u0432\u0438\u0442\u043A\u0443
      \u0434\u043E\u0431\u0430\u0432\u0438\u043B \u043F\u0430\u0447\u043A\u0443 \u0447\u0438\u0441\u0442\u043E\u0439
      \u0431\u0443\u043C\u0430\u0433\u0438 - \u0432\u0438\u0434\u043D\u043E, \u043F\u043E\u0441\u0447\u0438\u0442\u0430\u043B
      \u0432\u0430\u0441 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C,
      \u0446\u0435\u043D\u044F\u0449\u0438\u043C \u0437\u043D\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254935
    m_Localized: "\u0423\u0447\u0451\u043D\u044B\u0439 \u0442\u0435\u0440\u043F\u0435\u043B\u0438\u0432\u043E
      \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B \u0432\u0430\u0448\u0438 \u0436\u0435\u0441\u0442\u044B,
      \u043A\u0438\u0432\u043D\u0443\u043B \u0438 \u0441\u043D\u043E\u0432\u0430
      \u043D\u0430\u0437\u0432\u0430\u043B \u0442\u0443 \u0436\u0435 \u0446\u0435\u043D\u0443.
      \u0412\u044B \u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F,
      \u043D\u043E \u0431\u0435\u0437 \u0441\u043B\u043E\u0432 \u0434\u043E\u0432\u043E\u0434\u044B
      \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C: \u043A\u0430\u0436\u0434\u044B\u0439
      \u0436\u0435\u0441\u0442 \u043E\u043D \u043F\u043E\u043D\u0438\u043C\u0430\u043B
      \u043F\u043E-\u0441\u0432\u043E\u0435\u043C\u0443. \u0412 \u0438\u0442\u043E\u0433\u0435
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B\u0438 \u043F\u043E\u043B\u043D\u0443\u044E
      \u0446\u0435\u043D\u0443, \u0430 \u043A\u043E\u0433\u0434\u0430 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B\u0438
      \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C \u043D\u0430\u0434\u043F\u0438\u0441\u0438,
      \u0424\u0430\u0440\u0445\u0430\u0434 \u0440\u0430\u0437\u0432\u0451\u043B \u0440\u0443\u043A\u0430\u043C\u0438
      \u0438 \u0441\u043A\u0430\u0437\u0430\u043B \u0447\u0442\u043E-\u0442\u043E
      \u044F\u0432\u043D\u043E \u0441\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435.
      \u0421\u0432\u0438\u0442\u043E\u043A \u043A\u0440\u0430\u0441\u0438\u0432,
      \u043D\u043E \u043D\u0435\u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254936
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0432\u0435\u0434\u0451\u0442
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B \u043D\u0430 \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254937
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0441\u0435\u043B \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432
      \u0443\u0447\u0451\u043D\u043E\u0433\u043E \u0438 \u043E\u0431\u0440\u0430\u0442\u0438\u043B\u0441\u044F
      \u043A \u043D\u0435\u043C\u0443 \u043F\u043E-\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438,
      \u043D\u0435\u0441\u043F\u0435\u0448\u043D\u043E, \u0441 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0439
      \u043E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E:
      <npc_speech lang=\"Persian\">\u0423\u0432\u0430\u0436\u0430\u0435\u043C\u044B\u0439
      \u0424\u0430\u0440\u0445\u0430\u0434, \u0432\u0430\u0448\u0430 \u043A\u0430\u0440\u0442\u0430
      \u0432\u0435\u043B\u0438\u043A\u043E\u043B\u0435\u043F\u043D\u0430. \u041D\u043E
      \u0432\u043E\u0441\u0435\u043C\u044C \u043C\u043E\u043D\u0435\u0442 - \u0446\u0435\u043D\u0430
      \u0434\u043B\u044F \u0447\u0443\u0436\u0430\u043A\u0430. \u041C\u044B \u043E\u0431\u0430
      \u0437\u043D\u0430\u0435\u043C \u0434\u043E\u0440\u043E\u0433\u0438 \u0438\u0437
      \u0420\u0435\u044F, \u0442\u0430\u043A \u043D\u0430\u0437\u043E\u0432\u0438\u0442\u0435
      \u0446\u0435\u043D\u0443 \u0434\u043B\u044F \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u043F\u043E\u043D\u0438\u043C\u0430\u044E\u0449\u0435\u0433\u043E.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254938
    m_Localized: "\u0417\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u0430\u044F
      \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0430 \u0432 \u043F\u0435\u0441\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254939
    m_Localized: "\u0412\u0435\u0442\u0435\u0440 \u043E\u0431\u043D\u0430\u0436\u0438\u043B
      \u0441\u043A\u043B\u043E\u043D \u0434\u044E\u043D\u044B \u0438 \u043E\u0442\u043A\u0440\u044B\u043B
      \u043A\u0430\u043C\u0435\u043D\u043D\u0443\u044E \u043A\u043B\u0430\u0434\u043A\u0443:
      \u043D\u0438\u0437\u043A\u0438\u0439 \u0432\u0445\u043E\u0434, \u0434\u0432\u0443\u043C\u044F
      \u0442\u0440\u0435\u0442\u044F\u043C\u0438 \u0443\u0448\u0435\u0434\u0448\u0438\u0439
      \u0432 \u0437\u0435\u043C\u043B\u044E, \u0443\u0445\u043E\u0434\u0438\u0442
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0443. \u0418\u0437 \u0449\u0435\u043B\u0438
      \u0441\u043E\u0447\u0438\u0442\u0441\u044F \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439
      \u0432\u043E\u0437\u0434\u0443\u0445, \u043D\u0435\u0441\u0451\u0442 \u0447\u0442\u043E-\u0442\u043E
      \u0441\u043B\u0430\u0434\u043A\u043E\u0435, \u043A\u0430\u043A \u0441\u0442\u0430\u0440\u044B\u0439
      \u043B\u0430\u0434\u0430\u043D. \u041D\u0430 \u043F\u0435\u0440\u0435\u043C\u044B\u0447\u043A\u0435
      \u0441\u0442\u0451\u0440\u0442\u044B\u0435 \u0441\u0438\u043C\u0432\u043E\u043B\u044B:
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0435 \u043F\u0438\u0441\u044C\u043C\u043E,
      \u043F\u043B\u0430\u0432\u043D\u043E\u0435, \u043D\u043E \u043E\u0441\u0442\u0440\u043E\u0435.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u0431\u0435\u0434\u0443\u0438\u043D\u0441\u043A\u0438\u0445
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u043F\u043E\u0431\u043B\u0435\u0434\u043D\u0435\u043B
      \u0438 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B \u043D\u0430\u0437\u0430\u0434,
      \u0431\u043E\u0440\u043C\u043E\u0447\u0430:\r\n\r\n<npc_speech lang=\"Arabic\">\u042D\u0442\u043E
      \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0430 \u0434\u0440\u0435\u0432\u043D\u0438\u0445.
      \u041D\u0435 \u0432\u0445\u043E\u0434\u0438 - \u0434\u0436\u0438\u043D\u043D\u044B
      \u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442 \u0441\u0432\u043E\u0438\u0445
      \u043C\u0435\u0440\u0442\u0432\u0435\u0446\u043E\u0432. \u0425\u043E\u0442\u044F...
      \u044F \u0432\u0438\u0434\u0435\u043B \u0437\u043E\u043B\u043E\u0442\u043E
      \u0432 \u0442\u0430\u043A\u0438\u0445 \u043C\u0435\u0441\u0442\u0430\u0445
      \u043F\u0440\u0435\u0436\u0434\u0435.</npc_speech>\r\n\r\n\u0418\u0437 \u0433\u043B\u0443\u0431\u0438\u043D\u044B
      \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u043D\u0438\u0437\u043A\u0438\u0439
      \u0433\u0443\u043B - \u0432\u0435\u0442\u0435\u0440 \u0432 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0445
      \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430\u0445, \u0430 \u043C\u043E\u0436\u0435\u0442,
      \u0447\u0442\u043E-\u0442\u043E \u0435\u0449\u0451. \u0423 \u0432\u0445\u043E\u0434\u0430
      \u0441\u044B\u043F\u043B\u0435\u0442\u0441\u044F \u043F\u0435\u0441\u043E\u043A,
      \u0441\u043B\u043E\u0432\u043D\u043E \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254940
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254941
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0433\u0438\u0431\u0430\u0435\u0442
      \u0431\u0430\u0440\u0445\u0430\u043D, \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F
      \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0443 \u043F\u0435\u0441\u043A\u0443
      \u0438 \u0432\u0435\u0442\u0440\u0443. \u0411\u0435\u0434\u0443\u0438\u043D
      \u043E\u0431\u043B\u0435\u0433\u0447\u0451\u043D\u043D\u043E \u0432\u044B\u0434\u044B\u0445\u0430\u0435\u0442
      \u0438 \u0448\u0435\u043F\u0447\u0435\u0442 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
      \u043C\u043E\u043B\u0438\u0442\u0432\u0443. \u0427\u0442\u043E \u0431\u044B
      \u043D\u0438 \u0441\u043A\u0440\u044B\u0432\u0430\u043B\u043E\u0441\u044C \u043F\u043E\u0434
      \u043A\u0430\u043C\u043D\u044F\u043C\u0438 - \u043E\u043D\u043E \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F
      \u0442\u0430\u0439\u043D\u043E\u0439. \u0421\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0438\u0435
      \u0434\u043E\u0440\u043E\u0436\u0435 \u0437\u043E\u043B\u043E\u0442\u0430,
      \u043F\u043E \u043A\u0440\u0430\u0439\u043D\u0435\u0439 \u043C\u0435\u0440\u0435
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254942
    m_Localized: "\u0421\u043F\u0443\u0441\u0442\u0438\u0442\u044C\u0441\u044F \u0432\u043D\u0443\u0442\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254943
    m_Localized: "\u0424\u0430\u043A\u0435\u043B \u0438\u0437 \u043F\u0440\u043E\u043C\u0430\u0441\u043B\u0435\u043D\u043D\u044B\u0445
      \u0442\u0440\u044F\u043F\u043E\u043A \u043E\u0441\u0432\u0435\u0449\u0430\u0435\u0442
      \u043D\u0438\u0437\u043A\u0438\u0439 \u043A\u043E\u0440\u0438\u0434\u043E\u0440:
      \u0441\u0442\u0435\u043D\u044B \u0432 \u043E\u0445\u0440\u044F\u043D\u044B\u0445
      \u0440\u043E\u0441\u043F\u0438\u0441\u044F\u0445 \u0441 \u0444\u0438\u0433\u0443\u0440\u0430\u043C\u0438
      \u0432\u043E\u0437\u0434\u0435\u0442\u044B\u0445 \u0440\u0443\u043A, \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430\u043C\u0438,
      \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u044B\u043C\u0438 \u0434\u0438\u0441\u043A\u0430\u043C\u0438.
      \u0417\u0430\u043C\u0435\u0447\u0430\u0435\u0442\u0435 \u043F\u0440\u043E\u0441\u0435\u0432\u0448\u0443\u044E
      \u043F\u043B\u0438\u0442\u0443 \u043F\u043E\u043B\u0430 \u0438 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E
      \u043E\u0431\u0445\u043E\u0434\u0438\u0442\u0435. \u0412 \u043F\u043E\u0433\u0440\u0435\u0431\u0430\u043B\u044C\u043D\u043E\u0439
      \u043A\u0430\u043C\u0435\u0440\u0435 \u0441\u0442\u043E\u0438\u0442 \u043E\u043F\u0440\u043E\u043A\u0438\u043D\u0443\u0442\u044B\u0439
      \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439 \u0441\u0430\u0440\u043A\u043E\u0444\u0430\u0433,
      \u0434\u0430\u0432\u043D\u043E \u0432\u0441\u043A\u0440\u044B\u0442\u044B\u0439
      \u043C\u0430\u0440\u043E\u0434\u0451\u0440\u0430\u043C\u0438. \u041D\u043E
      \u0432 \u0437\u0430\u0432\u0430\u043B\u0435\u043D\u043D\u043E\u0439 \u043E\u0431\u043B\u043E\u043C\u043A\u0430\u043C\u0438
      \u043D\u0438\u0448\u0435 \u0437\u0430 \u043D\u0438\u043C \u0432 \u0441\u0432\u0435\u0442\u0435
      \u0444\u0430\u043A\u0435\u043B\u0430 \u043C\u0435\u0440\u0446\u0430\u0435\u0442
      \u0437\u043E\u043B\u043E\u0442\u043E\u0435 \u043E\u0436\u0435\u0440\u0435\u043B\u044C\u0435
      \u0441 \u0431\u0438\u0440\u044E\u0437\u043E\u0439. \u0411\u0435\u0440\u0451\u0442\u0435
      \u043D\u0430\u0445\u043E\u0434\u043A\u0443 \u0438 \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0435\u0441\u044C
      \u043D\u0430\u0440\u0443\u0436\u0443, \u043F\u043E\u043A\u0430 \u043F\u043E\u0442\u043E\u043B\u043E\u043A
      \u043D\u0435 \u0440\u0435\u0448\u0438\u043B \u043E\u0441\u0435\u0441\u0442\u044C.
      \u0413\u0440\u043E\u0431\u043D\u0438\u0446\u0430 \u043E\u0442\u0434\u0430\u043B\u0430
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043C\u0451\u0440\u0442\u0432\u044B\u0445
      - \u043D\u043E \u043D\u0435 \u0432\u0441\u0435 \u0435\u0451 \u0442\u0430\u0439\u043D\u044B
      \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254944
    m_Localized: "\u0422\u0435\u043C\u043D\u043E\u0442\u0430 \u043E\u0431\u043C\u0430\u043D\u044B\u0432\u0430\u0435\u0442.
      \u041D\u043E\u0433\u0430 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043F\u0440\u043E\u0433\u043D\u0438\u0432\u0448\u0443\u044E \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u0443\u044E
      \u043A\u0440\u044B\u0448\u043A\u0443: \u043B\u043E\u0432\u0443\u0448\u043A\u0430-\u044F\u043C\u0430,
      \u0437\u0430\u0441\u044B\u043F\u0430\u043D\u043D\u0430\u044F \u043F\u0435\u0441\u043A\u043E\u043C
      \u043F\u043E \u043B\u043E\u043A\u043E\u0442\u044C, \u043D\u043E \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439
      \u043A\u0440\u0430\u0439 \u043E\u0441\u0442\u0440\u044B\u0439. \u041B\u043E\u0434\u044B\u0436\u043A\u0430
      \u043F\u0440\u043E\u043D\u0437\u0430\u0435\u0442 \u0431\u043E\u043B\u044C.
      \u041F\u043E\u043A\u0430 \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0435\u0441\u044C,
      \u0441 \u043F\u043E\u0442\u043E\u043B\u043A\u0430 \u0441\u044B\u043F\u043B\u044E\u0442\u0441\u044F
      \u043A\u0430\u043C\u043D\u0438: \u043A\u043E\u0440\u0438\u0434\u043E\u0440
      \u0440\u0443\u0448\u0438\u0442\u0441\u044F. \u0412\u044B\u043F\u043E\u043B\u0437\u0430\u0435\u0442\u0435
      \u043D\u0430\u0440\u0443\u0436\u0443, \u0442\u0435\u0440\u044F\u0435\u0442\u0435
      \u0444\u0430\u043A\u0435\u043B, \u0431\u0443\u0440\u0434\u044E\u043A \u0441
      \u0432\u043E\u0434\u043E\u0439 \u0438 \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432.
      \u0413\u0440\u043E\u0431\u043D\u0438\u0446\u0430 \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0437\u0430 \u0432\u0430\u043C\u0438 \u0441\u0442\u043E\u043B\u0431\u043E\u043C
      \u043F\u044B\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254945
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u044D\u0442\u0438 \u0440\u0443\u0438\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254946
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043F\u0440\u0438\u0441\u0435\u043B
      \u0443 \u0432\u0445\u043E\u0434\u0430, \u043F\u0440\u043E\u0432\u0451\u043B
      \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u043F\u043E \u0437\u043D\u0430\u043A\u0430\u043C
      \u043D\u0430 \u043F\u0440\u0438\u0442\u043E\u043B\u043E\u043A\u0435 \u0438
      \u043A\u0438\u0432\u043D\u0443\u043B. \xAB\u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0430\u044F
      \u0440\u0430\u0431\u043E\u0442\u0430. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0438\u043B\u0438 \u0436\u0440\u0435\u0446 - \u043D\u0435 \u0432\u043E\u0438\u043D,
      \u043B\u043E\u0432\u0443\u0448\u043A\u0438 \u043F\u0440\u043E\u0441\u0442\u044B\u0435.\xBB
      \u041E\u043D \u0432\u043E\u0448\u0451\u043B \u043F\u0435\u0440\u0432\u044B\u043C,
      \u043F\u0440\u043E\u0441\u0442\u0443\u043A\u0438\u0432\u0430\u044F \u0441\u0442\u0435\u043D\u044B
      \u0438 \u043F\u043E\u043B \u043F\u0430\u043B\u043A\u043E\u0439. \u0427\u0435\u0440\u0435\u0437
      \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C \u0447\u0430\u0441\u0430 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0441 \u0437\u043E\u043B\u043E\u0442\u044B\u043C \u043E\u0436\u0435\u0440\u0435\u043B\u044C\u0435\u043C,
      \u0433\u043E\u0440\u0441\u0442\u044C\u044E \u043C\u043E\u043D\u0435\u0442 \u0438
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u043C \u0437\u0435\u0440\u043A\u0430\u043B\u043E\u043C.
      \xAB\u0413\u0440\u0430\u0431\u0438\u0442\u0435\u043B\u0438 \u0432\u0437\u044F\u043B\u0438
      \u043A\u0440\u0443\u043F\u043D\u043E\u0435, \u043D\u043E \u043D\u0435 \u0437\u0430\u0433\u043B\u044F\u043D\u0443\u043B\u0438
      \u0432 \u0432\u043E\u0434\u043E\u0441\u0442\u043E\u043A. \u0422\u0430\u043C
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u0440\u044F\u0447\u0443\u0442 \u0441\u0430\u043C\u043E\u0435
      \u0446\u0435\u043D\u043D\u043E\u0435.\xBB \u0411\u0435\u0434\u0443\u0438\u043D-\u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430
      \u0441 \u043D\u0435\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u043C\u044B\u043C
      \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C. \u0413\u0440\u043E\u0431\u043D\u0438\u0446\u0430
      \u043E\u0442\u0434\u0430\u043B\u0430 \u0441\u0432\u043E\u0451 - \u0431\u0435\u0437
      \u043A\u0440\u043E\u0432\u0438 \u0438 \u0431\u0435\u0437 \u043E\u0431\u0440\u0443\u0448\u0435\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254947
    m_Localized: "\u0417\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u0430\u044F \u043D\u0430\u0434\u043F\u0438\u0441\u044C
      \u043D\u0430 \u0441\u043A\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254948
    m_Localized: "\u041D\u0430 \u043E\u0442\u0432\u0435\u0441\u043D\u043E\u0439 \u0441\u043A\u0430\u043B\u0435
      \u0443 \u0442\u0440\u043E\u043F\u044B \u0432\u044B\u0441\u0435\u0447\u0435\u043D\u044B
      \u0441\u0438\u043C\u0432\u043E\u043B\u044B \u0432 \u0442\u0440\u0438 \u0441\u0442\u0440\u043E\u043A\u0438.
      \u041F\u0438\u0441\u044C\u043C\u0435\u043D\u0430 \u043F\u043E\u043A\u0440\u044B\u0442\u044B
      \u043B\u0438\u0448\u0430\u0439\u043D\u0438\u043A\u043E\u043C, \u043D\u043E
      \u043B\u0438\u043D\u0438\u0438 \u0433\u043B\u0443\u0431\u043E\u043A\u0438 \u0438
      \u0447\u0451\u0442\u043A\u0438, \u0441\u043B\u043E\u0432\u043D\u043E \u0440\u0435\u0437\u0430\u043B\u0438
      \u0432\u0447\u0435\u0440\u0430. \u041D\u0438\u0436\u043D\u044F\u044F \u0441\u0442\u0440\u043E\u043A\u0430:
      \u0441\u0442\u0440\u0435\u043B\u043A\u0438 \u0438 \u0437\u0430\u0440\u0443\u0431\u043A\u0438,
      \u043F\u043E\u0445\u043E\u0436\u0438\u0435 \u043D\u0430 \u0441\u0445\u0435\u043C\u0443
      \u0442\u0440\u043E\u043F\u044B. \u0412\u044C\u044E\u0447\u043D\u044B\u0435
      \u044F\u043A\u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C
      \u0441\u0430\u043C\u0438, \u0431\u0443\u0434\u0442\u043E \u0437\u043D\u0430\u044E\u0442
      \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E. \u0421\u0442\u0430\u0440\u044B\u0439
      \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0441\u043D\u044F\u043B \u0448\u0430\u043F\u043A\u0443, \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u043B\u0441\u044F
      \u043A\u0430\u043C\u043D\u044E \u0438 \u043F\u0440\u043E\u0438\u0437\u043D\u0451\u0441:\r\n\r\n<npc_speech
      lang=\"Tibetan\">\u042D\u0442\u043E \u0434\u0440\u0435\u0432\u043D\u044F\u044F
      \u043D\u0430\u0434\u043F\u0438\u0441\u044C. \u0423\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C
      \u043F\u0443\u0442\u0438 \u0438\u043B\u0438 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      - \u044F \u043D\u0435 \u0437\u043D\u0430\u044E. \u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435
      \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E.</npc_speech>\r\n\r\n\u0412\u0435\u0442\u0435\u0440
      \u043D\u0435\u0441\u0451\u0442 \u0441 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430
      \u0437\u0430\u043F\u0430\u0445 \u043C\u043E\u0436\u0436\u0435\u0432\u0435\u043B\u044C\u043D\u0438\u043A\u0430.
      \u041C\u0435\u0436\u0434\u0443 \u043A\u0430\u043C\u043D\u044F\u043C\u0438 \u0443
      \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F \u0441\u043A\u0430\u043B\u044B
      \u043A\u0442\u043E-\u0442\u043E \u0441\u043B\u043E\u0436\u0438\u043B \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u043E\u0431\u043E \u0438\u0437 \u043F\u043B\u043E\u0441\u043A\u0438\u0445
      \u043A\u0430\u043C\u043D\u0435\u0439 - \u0441\u0432\u0435\u0436\u0438\u0439,
      \u043D\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      \u0434\u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254949
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254950
    m_Localized: "\u0412\u044B \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442\u0435
      \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0441\u043A\u0430\u043B\u044B
      \u043D\u0430 \u0441\u043B\u0443\u0447\u0430\u0439 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F.
      \u0421\u0442\u0430\u0440\u044B\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043A\u0438\u0432\u0430\u0435\u0442:
      \u043D\u0435 \u0432\u0441\u044F\u043A\u0443\u044E \u0434\u0432\u0435\u0440\u044C
      \u0441\u0442\u043E\u0438\u0442 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C.
      \u042F\u043A\u0438 \u0442\u0440\u043E\u0433\u0430\u044E\u0442\u0441\u044F \u0441\u0430\u043C\u0438,
      \u0435\u0434\u0432\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0442\u0445\u043E\u0434\u0438\u0442
      \u043D\u0430 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0448\u0430\u0433\u043E\u0432.
      \u041D\u0430\u0434\u043F\u0438\u0441\u044C \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439, \u043D\u0435\u0447\u0438\u0442\u0430\u043D\u043D\u0430\u044F
      \u0438 \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254951
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254952
    m_Localized: "\u0421\u0442\u0440\u0435\u043B\u043A\u0438 \u0438 \u0437\u0430\u0440\u0443\u0431\u043A\u0438:
      \u043D\u0435 \u043F\u0438\u0441\u044C\u043C\u043E, \u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435
      \u043C\u0435\u0442\u043A\u0438. \u0412\u044B \u0432\u0438\u0434\u0435\u043B\u0438
      \u043F\u043E\u0445\u043E\u0436\u0438\u0435 \u043D\u0430 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0445
      \u0441\u043A\u043B\u0430\u0434\u0441\u043A\u0438\u0445 \u0431\u0438\u0440\u043A\u0430\u0445:
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435, \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435,
      \u0437\u043D\u0430\u043A \xAB\u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\xBB.
      \u041D\u0438\u0436\u043D\u044F\u044F \u0441\u0442\u0440\u043E\u043A\u0430 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0443 \u0432
      \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u0438 \u0448\u0430\u0433\u0430\u0445
      \u043B\u0435\u0432\u0435\u0435 \u0442\u0440\u043E\u043F\u044B. \u041C\u0435\u0436\u0434\u0443
      \u043A\u0430\u043C\u043D\u044F\u043C\u0438 \u0441\u043A\u0440\u044B\u0442 \u043D\u0435\u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439
      \u0442\u0430\u0439\u043D\u0438\u043A, \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u044B\u0439
      \u043F\u043B\u043E\u0441\u043A\u0438\u043C \u0441\u043B\u0430\u043D\u0446\u0435\u043C:
      \u043C\u0435\u0448\u043E\u0447\u0435\u043A \u0441 \u0431\u0438\u0440\u044E\u0437\u043E\u0432\u044B\u043C\u0438
      \u0431\u0443\u0441\u0438\u043D\u0430\u043C\u0438 \u0438 \u0441\u0432\u0451\u0440\u043D\u0443\u0442\u0430\u044F
      \u043A\u043E\u0436\u0430\u043D\u0430\u044F \u043A\u0430\u0440\u0442\u0430 \u043E\u043A\u0440\u0435\u0441\u0442\u043D\u044B\u0445
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u043E\u0432. \u0427\u044C\u044F-\u0442\u043E
      \u0437\u0430\u043D\u0430\u0447\u043A\u0430, \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F
      \u0434\u043B\u044F \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A\u0430 \u0438\u043B\u0438
      \u0434\u043B\u044F \u0441\u0435\u0431\u044F \u043D\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u044B\u0439
      \u043F\u0443\u0442\u044C. \u041A\u0442\u043E \u0431\u044B \u043D\u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u043C\u0435\u0442\u043A\u0438, \u043E\u043D \u0437\u043D\u0430\u043B \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043D\u043E\u0435
      \u0440\u0435\u043C\u0435\u0441\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254953
    m_Localized: "\u0417\u043D\u0430\u043A\u0438 \u043D\u0435 \u043F\u043E\u0434\u0434\u0430\u044E\u0442\u0441\u044F:
      \u0432\u044B \u043F\u0443\u0442\u0430\u0435\u0442\u0435 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F,
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u0443\u044E
      \u043C\u0435\u0442\u043A\u0443 \u0437\u0430 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0443\u044E
      \u043C\u0430\u043D\u0442\u0440\u0443. \u041F\u043E\u043F\u044B\u0442\u043A\u0430
      \u043F\u0440\u043E\u0439\u0442\u0438 \u043F\u043E \xAB\u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044E\xBB
      \u0437\u0430\u0432\u043E\u0434\u0438\u0442 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0432 \u043E\u0441\u044B\u043F\u044C, \u0433\u0434\u0435 \u043A\u043E\u043B\u0451\u0441\u0430
      \u0432\u044F\u0437\u043D\u0443\u0442 \u0432 \u043C\u0435\u043B\u043A\u043E\u043C
      \u0449\u0435\u0431\u043D\u0435. \u041F\u043E\u043B\u0434\u043D\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E
      \u043D\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
      \u043A \u0442\u0440\u043E\u043F\u0435. \u041D\u0430\u0434\u043F\u0438\u0441\u044C
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u0441\u043B\u0435\u0434 \u0440\u0430\u0432\u043D\u043E\u0434\u0443\u0448\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254954
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0447\u0438\u0442\u0430\u0435\u0442
      \u043D\u0430\u0434\u043F\u0438\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254955
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0434\u043E\u043B\u0433\u043E
      \u0432\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043A\u0430\u043C\u0435\u043D\u044C, \u0432\u043E\u0434\u044F \u043F\u0430\u043B\u044C\u0446\u0435\u043C
      \u043F\u043E \u0441\u0442\u0440\u043E\u043A\u0430\u043C. \xAB\u0412\u0435\u0440\u0445\u043D\u0438\u0435
      \u0434\u0432\u0435 - \u0441\u0442\u0430\u0440\u043E\u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0430\u044F
      \u043C\u043E\u043B\u0438\u0442\u0432\u0430 \u0437\u0430 \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432.
      \u0410 \u043D\u0438\u0436\u043D\u044F\u044F - \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0430\u044F
      \u0441\u043A\u043E\u0440\u043E\u043F\u0438\u0441\u044C: \"\u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C
      \u0448\u0430\u0433\u043E\u0432 \u0432\u043B\u0435\u0432\u043E, \u043F\u043E\u0434
      \u0441\u043B\u0430\u043D\u0446\u0435\u043C, \u0434\u043B\u044F \u0434\u0440\u0443\u0433\u0430\".
      \u041A\u0442\u043E-\u0442\u043E \u0438\u0437 \u043D\u0430\u0448\u0438\u0445,
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445.\xBB \u0422\u0430\u0439\u043D\u0438\u043A
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435: \u0431\u0438\u0440\u044E\u0437\u043E\u0432\u044B\u0435
      \u0431\u0443\u0441\u0438\u043D\u044B, \u043A\u043E\u0436\u0430\u043D\u0430\u044F
      \u043A\u0430\u0440\u0442\u0430 \u0438 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u0430\u044F \u0444\u0438\u0433\u0443\u0440\u043A\u0430
      \u0411\u0443\u0434\u0434\u044B, \u0437\u0430\u0432\u0451\u0440\u043D\u0443\u0442\u0430\u044F
      \u0432 \u0448\u0451\u043B\u043A. \u0421\u0442\u0430\u0440\u044B\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A,
      \u0443\u0441\u043B\u044B\u0448\u0430\u0432 \u043F\u0435\u0440\u0435\u0432\u043E\u0434
      \u043C\u043E\u043B\u0438\u0442\u0432\u044B, \u043A\u043B\u0430\u0434\u0451\u0442
      \u0444\u0438\u0433\u0443\u0440\u043A\u0443 \u043E\u0431\u0440\u0430\u0442\u043D\u043E,
      \u043D\u043E \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u043A\u0430\u0440\u0442\u0443:
      \xAB\u0411\u0443\u0434\u0434\u0430 \u043F\u0443\u0441\u0442\u044C \u0436\u0434\u0451\u0442
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u043F\u0443\u0442\u043D\u0438\u043A\u0430\xBB.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0443\u0445\u043E\u0434\u0438\u0442
      \u0441 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430 \u0441 \u043D\u043E\u0432\u044B\u043C
      \u0437\u043D\u0430\u043D\u0438\u0435\u043C \u0438 \u043B\u0451\u0433\u043A\u0438\u043C
      \u0441\u0435\u0440\u0434\u0446\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254956
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043A\u0438 \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254957
    m_Localized: "\u0421\u043F\u0440\u0430\u0432\u0430 \u043E\u0442 \u0442\u0440\u043E\u043F\u044B,
      \u0432 \u043D\u0435\u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u043B\u043E\u0436\u0431\u0438\u043D\u0435,
      \u0431\u0435\u043B\u0435\u044E\u0442 \u043A\u043E\u0441\u0442\u0438. \u0421\u043D\u0430\u0447\u0430\u043B\u0430
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F - \u043E\u0432\u0446\u044B. \u041D\u043E
      \u043D\u0435\u0442: \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u044C\u0438
      \u0440\u0451\u0431\u0440\u0430 \u0442\u043E\u0440\u0447\u0430\u0442 \u0438\u0437
      \u0437\u0435\u043C\u043B\u0438, \u043A\u0430\u043A \u0440\u0451\u0431\u0440\u0430
      \u0437\u0430\u0442\u043E\u043D\u0443\u0432\u0448\u0435\u0433\u043E \u043A\u043E\u0440\u0430\u0431\u043B\u044F.
      \u0414\u0430\u043B\u044C\u0448\u0435 \u0436\u0435\u043B\u0435\u0437\u043D\u044B\u0435
      \u043E\u0431\u043E\u0434\u044C\u044F \u043A\u043E\u043B\u0451\u0441, \u043F\u043E\u0437\u0435\u043B\u0435\u043D\u0435\u0432\u0448\u0438\u0435
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0435 \u043F\u0440\u044F\u0436\u043A\u0438,
      \u043F\u043E\u043B\u0443\u0438\u0441\u0442\u043B\u0435\u0432\u0448\u0438\u0435
      \u043E\u0431\u0440\u044B\u0432\u043A\u0438 \u0442\u043A\u0430\u043D\u0438.
      \u0421\u0442\u0430\u0440\u044B\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u043F\u043E\u0433\u0438\u0431\u0448\u0438\u0439 \u043D\u0435 \u043E\u0434\u0438\u043D
      \u0434\u0435\u0441\u044F\u0442\u043E\u043A \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434.
      \u0412\u0435\u0442\u0435\u0440 \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u0435\u0442
      \u043B\u043E\u0445\u043C\u043E\u0442\u044C\u044F, \u0431\u0443\u0434\u0442\u043E
      \u043B\u0438\u0441\u0442\u0430\u0435\u0442 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u044B
      \u0437\u0430\u0431\u044B\u0442\u043E\u0439 \u043A\u043D\u0438\u0433\u0438.
      \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0441\u043F\u0440\u044B\u0433\u043D\u0443\u043B \u0441 \u0442\u0435\u043B\u0435\u0433\u0438
      \u0438 \u043F\u0440\u0438\u0441\u0435\u043B \u0443 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0433\u043E
      \u0441\u043A\u0435\u043B\u0435\u0442\u0430 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430,
      \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F \u043E\u0441\u0442\u0430\u0442\u043A\u0438
      \u0441\u0431\u0440\u0443\u0438:\r\n\r\n<npc_speech lang=\"Sogdian\">\u042D\u0442\u043E\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A \u0431\u044B\u043B
      \u0438\u0437 \u0411\u0443\u0445\u0430\u0440\u044B - \u044F \u0443\u0437\u043D\u0430\u044E
      \u043A\u043B\u0435\u0439\u043C\u043E \u043D\u0430 \u0441\u0431\u0440\u0443\u0435.
      \u0413\u0440\u0443\u0436\u0451\u043D \u0431\u044B\u043B \u0434\u043E\u0432\u0435\u0440\u0445\u0443
      - \u0442\u043E\u043B\u044C\u043A\u043E \u0443\u0434\u0430\u0447\u0438 \u0435\u043C\u0443
      \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u043B\u043E.</npc_speech>\r\n\r\n\u041C\u0435\u0436\u0434\u0443
      \u043A\u043E\u0441\u0442\u044F\u043C\u0438 \u0447\u0442\u043E-\u0442\u043E
      \u043F\u043E\u0431\u043B\u0451\u0441\u043A\u0438\u0432\u0430\u0435\u0442 \u043D\u0430
      \u0441\u043E\u043B\u043D\u0446\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254958
    m_Localized: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254959
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u0435
      \u0432\u0434\u043E\u043B\u044C \u043E\u0441\u0442\u0430\u043D\u043A\u043E\u0432,
      \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u044F \u043B\u0438\u0448\u043D\u0435\u0433\u043E.
      \u0423 \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437 \u0441\u043A\u0435\u043B\u0435\u0442\u043E\u0432
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432 \u043D\u0430\u0448\u043B\u0430\u0441\u044C
      \u043A\u043E\u0436\u0430\u043D\u0430\u044F \u0441\u0443\u043C\u043A\u0430,
      \u0447\u0443\u0434\u043E\u043C \u0443\u0446\u0435\u043B\u0435\u0432\u0448\u0430\u044F
      \u0432 \u0441\u043A\u043B\u0430\u0434\u043A\u0435 \u0437\u0435\u043C\u043B\u0438.
      \u0412\u043D\u0443\u0442\u0440\u0438 - \u0433\u043E\u0440\u0441\u0442\u044C
      \u043F\u043E\u0442\u0435\u043C\u043D\u0435\u0432\u0448\u0438\u0445 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0445
      \u043C\u043E\u043D\u0435\u0442 \u0438 \u043A\u043E\u0441\u0442\u044F\u043D\u043E\u0439
      \u0433\u0440\u0435\u0431\u0435\u043D\u044C. \u041D\u0435\u0433\u0443\u0441\u0442\u043E,
      \u043D\u043E \u0438 \u043A\u043E\u0441\u0442\u044F\u043C \u043D\u0435 \u043F\u043E\u0432\u0440\u0435\u0434\u0438\u043B\u0438.
      \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0431\u043E\u0440\u043C\u043E\u0447\u0435\u0442 \u043A\u043E\u0440\u043E\u0442\u043A\u0443\u044E
      \u043C\u043E\u043B\u0438\u0442\u0432\u0443 \u0437\u0430 \u0443\u043F\u043E\u043A\u043E\u0439
      \u0438 \u043A\u043B\u0430\u0434\u0451\u0442 \u043A\u0430\u043C\u0435\u0448\u0435\u043A
      \u043D\u0430 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0439 \u0447\u0435\u0440\u0435\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254960
    m_Localized: "\u0422\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043E\u0431\u044B\u0441\u043A\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254961
    m_Localized: "\u0412\u044B \u043C\u0435\u0442\u043E\u0434\u0438\u0447\u043D\u043E
      \u0440\u0430\u0441\u043A\u0430\u043F\u044B\u0432\u0430\u0435\u0442\u0435 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0442\u044E\u043A, \u043A\u0430\u0436\u0434\u0443\u044E \u043F\u043E\u0432\u043E\u0437\u043A\u0443.
      \u041F\u043E\u0434 \u043E\u043F\u0440\u043E\u043A\u0438\u043D\u0443\u0442\u043E\u0439
      \u0440\u0430\u043C\u043E\u0439 \u0437\u0430\u0434\u043D\u0435\u0439 \u0442\u0435\u043B\u0435\u0433\u0438
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u043E\u0441\u044C \u0434\u0432\u043E\u0439\u043D\u043E\u0435
      \u0434\u043D\u043E, \u0430 \u0432 \u043D\u0451\u043C \u0441\u0432\u0451\u0440\u0442\u043E\u043A
      \u043F\u0440\u043E\u0441\u043C\u043E\u043B\u0451\u043D\u043D\u043E\u0439 \u0442\u043A\u0430\u043D\u0438.
      \u0412\u043D\u0443\u0442\u0440\u0438: \u043E\u0442\u0440\u0435\u0437 \u043F\u0430\u0440\u0447\u0438,
      \u043F\u043E\u0442\u0443\u0441\u043A\u043D\u0435\u0432\u0448\u0438\u0439, \u043D\u043E
      \u0446\u0435\u043B\u044B\u0439, \u0438 \u043C\u0435\u0448\u043E\u0447\u0435\u043A
      \u043B\u0430\u0437\u0443\u0440\u0438\u0442\u043E\u0432\u044B\u0445 \u0431\u0443\u0441\u0438\u043D,
      \u0441\u0438\u043D\u0438\u0445 \u043A\u0430\u043A \u0437\u0438\u043C\u043D\u0435\u0435
      \u043D\u0435\u0431\u043E. \u041A\u0443\u043F\u0435\u0446 \u0432\u0451\u0437
      \u0446\u0435\u043D\u043D\u043E\u0435 \u0441\u043A\u0440\u044B\u0442\u043D\u043E
      - \u0438 \u0432\u0451\u0437 \u0431\u044B \u0434\u043E \u0420\u0435\u044F, \u0435\u0441\u043B\u0438
      \u0431\u044B \u0441\u0443\u0434\u044C\u0431\u0430 \u043D\u0435 \u0440\u0430\u0441\u043F\u043E\u0440\u044F\u0434\u0438\u043B\u0430\u0441\u044C
      \u0438\u043D\u0430\u0447\u0435. \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u043F\u0440\u0438\u0441\u0432\u0438\u0441\u0442\u043D\u0443\u043B:
      \xAB\u0411\u0443\u0445\u0430\u0440\u0441\u043A\u0430\u044F \u0433\u0438\u043B\u044C\u0434\u0438\u044F.
      \u041E\u043D\u0438 \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u0440\u044F\u0442\u0430\u043B\u0438
      \u043B\u0443\u0447\u0448\u0435\u0435 \u0432 \u043E\u0441\u044F\u0445.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254962
    m_Localized: "\u0420\u0430\u0441\u043A\u043E\u043F\u043A\u0438 \u0437\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u044E\u0442\u0441\u044F:
      \u0437\u0435\u043C\u043B\u044F \u0441\u043B\u0435\u0436\u0430\u043B\u0430\u0441\u044C,
      \u0442\u044E\u043A\u0438 \u0441\u043F\u0435\u043A\u043B\u0438\u0441\u044C \u0432
      \u0431\u0435\u0441\u0444\u043E\u0440\u043C\u0435\u043D\u043D\u0443\u044E \u043C\u0430\u0441\u0441\u0443.
      \u041F\u043E\u043A\u0430 \u0432\u044B \u043A\u043E\u0432\u044B\u0440\u044F\u0435\u0442\u0435
      \u0441\u043B\u0438\u043F\u0448\u0443\u044E\u0441\u044F \u0442\u043A\u0430\u043D\u044C,
      \u0438\u0437-\u043F\u043E\u0434 \u043A\u043E\u0441\u0442\u0435\u0439 \u0432\u044B\u043F\u043E\u043B\u0437\u0430\u0435\u0442
      \u0433\u0430\u0434\u044E\u043A\u0430: \u0435\u043B\u0435 \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0442\u0435
      \u043E\u0442\u0434\u0451\u0440\u043D\u0443\u0442\u044C \u0440\u0443\u043A\u0443.
      \u0421\u0443\u043C\u0430\u0442\u043E\u0445\u0430, \u043A\u0440\u0438\u043A\u0438,
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0439 \u0431\u0443\u0440\u0434\u044E\u043A.
      \u0412 \u0438\u0442\u043E\u0433\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043C\u0435\u0434\u043D\u044B\u0445 \u043C\u043E\u043D\u0435\u0442 \u0438
      \u0438\u0441\u043F\u043E\u0440\u0447\u0435\u043D\u043D\u044B\u0435 \u043D\u0435\u0440\u0432\u044B.
      \u041C\u0451\u0440\u0442\u0432\u044B\u0445 \u0442\u0440\u043E\u0433\u0430\u0442\u044C
      - \u0434\u0443\u0440\u043D\u0430\u044F \u043F\u0440\u0438\u043C\u0435\u0442\u0430.
      \u0422\u0435\u043F\u0435\u0440\u044C \u044D\u0442\u043E \u0437\u043D\u0430\u0435\u0442
      \u0432\u0435\u0441\u044C \u043E\u0442\u0440\u044F\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254963
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u0442
      \u043D\u0430\u0445\u043E\u0434\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254964
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043E\u0431\u043E\u0448\u0451\u043B
      \u043E\u0441\u0442\u0430\u043D\u043A\u0438 \u043D\u0435 \u0441\u043F\u0435\u0448\u0430,
      \u043A\u0430\u043A \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044C
      \u043D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435. \u041F\u043E\u0442\u0440\u043E\u0433\u0430\u043B
      \u043E\u0431\u043E\u0434\u044C\u044F: \xAB\u041A\u043E\u0432\u0430\u043D\u044B\u0435,
      \u043D\u0435 \u043B\u0438\u0442\u044B\u0435, \u0431\u0443\u0445\u0430\u0440\u0441\u043A\u0430\u044F
      \u0440\u0430\u0431\u043E\u0442\u0430\xBB. \u041F\u0440\u043E\u0441\u0442\u0443\u0447\u0430\u043B
      \u043E\u0441\u0438: \xAB\u042D\u0442\u0430 \u043F\u0443\u0441\u0442\u0430\u044F,
      \u0430 \u0442\u0430 \u043D\u0435\u0442\xBB. \u0427\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441 \u0438\u0437 \u043F\u043E\u0442\u0430\u0439\u043D\u044B\u0445
      \u043F\u043E\u043B\u043E\u0441\u0442\u0435\u0439 \u0434\u0432\u0443\u0445 \u0442\u0435\u043B\u0435\u0433
      \u0438\u0437\u0432\u043B\u0435\u0447\u0435\u043D\u044B \u043E\u0442\u0440\u0435\u0437
      \u043F\u0430\u0440\u0447\u0438 \u0432 \u043F\u0440\u043E\u043C\u0430\u0441\u043B\u0435\u043D\u043D\u043E\u0439
      \u043E\u0431\u0451\u0440\u0442\u043A\u0435, \u043C\u0435\u0448\u043E\u0447\u0435\u043A
      \u043B\u0430\u0437\u0443\u0440\u0438\u0442\u0430 \u0438 \u0441\u0432\u044F\u0437\u043A\u0430
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0445 \u0433\u0438\u0440\u0435\u043A
      (\u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442). \xAB\u042D\u0442\u043E\u0442
      \u0448\u0451\u043B \u0438\u0437 \u0411\u0443\u0445\u0430\u0440\u044B \u0432
      \u0420\u0435\u0439. \u041B\u0435\u0442 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C
      \u043D\u0430\u0437\u0430\u0434, \u0441\u0443\u0434\u044F \u043F\u043E \u0441\u0431\u0440\u0443\u0435.
      \u0411\u0430\u043D\u0434\u0438\u0442\u044B \u0432\u0437\u044F\u043B\u0438 \u0432\u0435\u0440\u0445\u043D\u0438\u0439
      \u0433\u0440\u0443\u0437: \u0434\u0432\u043E\u0439\u043D\u043E\u0433\u043E
      \u0434\u043D\u0430 \u043D\u0435 \u043D\u0430\u0448\u043B\u0438, \u043D\u0435
      \u0443\u043C\u0435\u043B\u0438.\xBB \u041E\u043D \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430\u0445\u043E\u0434\u043A\u0438 \u0438 \u043A\u043B\u0430\u0434\u0451\u0442
      \u043D\u0430 \u043C\u043E\u0433\u0438\u043B\u044C\u043D\u044B\u0439 \u043A\u0430\u043C\u0435\u043D\u044C
      \u043C\u0435\u0434\u043D\u0443\u044E \u043C\u043E\u043D\u0435\u0442\u0443.
      \xAB\u0417\u0430 \u0443\u043F\u043E\u043A\u043E\u0439 \u043C\u0430\u0441\u0442\u0435\u0440\u0430.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254965
    m_Localized: "\u0422\u0430\u0439\u043D\u0438\u043A \u043A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254966
    m_Localized: "\u0414\u043E\u0440\u043E\u0436\u043D\u044B\u0439 \u043E\u0432\u0440\u0430\u0433
      \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0441\u044F \u043F\u043E\u0441\u043B\u0435
      \u0434\u043E\u0436\u0434\u044F, \u043E\u0442\u043A\u0440\u044B\u0432 \u0442\u0451\u043C\u043D\u0443\u044E
      \u0449\u0435\u043B\u044C \u0432 \u0441\u043A\u043B\u043E\u043D\u0435: \u0432\u0445\u043E\u0434
      \u0432 \u043D\u0435\u0433\u043B\u0443\u0431\u043E\u043A\u0443\u044E \u043F\u0435\u0449\u0435\u0440\u0443,
      \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u0443\u044E \u0432\u044F\u0437\u0430\u043D\u043A\u043E\u0439
      \u0441\u0443\u0445\u0438\u0445 \u0432\u0435\u0442\u043E\u043A. \u0412\u043D\u0443\u0442\u0440\u0438
      \u0441\u043B\u0435\u0434\u044B \u043D\u0435\u0434\u0430\u0432\u043D\u0435\u0433\u043E
      \u043F\u0440\u0435\u0431\u044B\u0432\u0430\u043D\u0438\u044F: \u0437\u043E\u043B\u0430
      \u043A\u043E\u0441\u0442\u0440\u0430, \u043E\u0431\u0440\u044B\u0432\u043A\u0438
      \u0432\u0435\u0440\u0451\u0432\u043E\u043A, \u043C\u0430\u0441\u043B\u044F\u043D\u044B\u0435
      \u043F\u044F\u0442\u043D\u0430 \u043D\u0430 \u043A\u0430\u043C\u043D\u0435.
      \u0423 \u0434\u0430\u043B\u044C\u043D\u0435\u0439 \u0441\u0442\u0435\u043D\u044B,
      \u0437\u0430 \u0433\u0440\u0443\u0434\u043E\u0439 \u0432\u0430\u043B\u0443\u043D\u043E\u0432,
      \u0443\u0433\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u043E\u0447\u0435\u0440\u0442\u0430\u043D\u0438\u044F
      \u043C\u0435\u0448\u043A\u043E\u0432 \u0438 \u044F\u0449\u0438\u043A\u043E\u0432.
      \u041A\u0442\u043E-\u0442\u043E \u0441\u043F\u0440\u044F\u0442\u0430\u043B
      \u0437\u0434\u0435\u0441\u044C \u0442\u043E\u0432\u0430\u0440\u044B - \u0438
      \u0435\u0449\u0451 \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F.
      \u041C\u0438\u043C\u043E \u043F\u0440\u043E\u0435\u0437\u0436\u0430\u043B \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A, \u0437\u0430\u043C\u0435\u0434\u043B\u0438\u043B
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443 \u0438 \u043A\u0440\u0438\u043A\u043D\u0443\u043B
      \u0447\u0435\u0440\u0435\u0437 \u043F\u043B\u0435\u0447\u043E:\r\n\r\n<npc_speech
      lang=\"Persian\">\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E.
      \u042D\u0442\u043E \u0441\u043A\u043B\u0430\u0434 \u043A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442\u043E\u0432
      - \u044F \u0432\u0438\u0434\u0430\u043B \u0442\u0430\u043A\u0438\u0435. \u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E:
      \u0438\u043D\u043E\u0433\u0434\u0430 \u043E\u043D\u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F.</npc_speech>\r\n\r\n\u0421\u0432\u0435\u0436\u0438\u0435
      \u0441\u043B\u0435\u0434\u044B \u0441\u0430\u043F\u043E\u0433 \u0432\u0435\u0434\u0443\u0442
      \u0438\u0437 \u043F\u0435\u0449\u0435\u0440\u044B \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443
      \u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E. \u0417\u0434\u0435\u0441\u044C
      \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435\u0434\u0430\u0432\u043D\u043E
      \u043A\u0442\u043E-\u0442\u043E \u0431\u044B\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254967
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0438 \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254968
    m_Localized: "\u0412\u044B \u0437\u0430\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u0432 \u043F\u0435\u0449\u0435\u0440\u0443, \u043D\u0435 \u0443\u0433\u043B\u0443\u0431\u043B\u044F\u044F\u0441\u044C.
      \u0411\u043B\u0438\u0436\u043D\u0438\u0439 \u043C\u0435\u0448\u043E\u043A \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442
      \u043C\u0443\u043A\u0443: \u0441\u044B\u0440\u0443\u044E, \u043D\u043E \u0433\u043E\u0434\u043D\u0443\u044E.
      \u0420\u044F\u0434\u043E\u043C \u043B\u0435\u0436\u0438\u0442 \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u043A\u043E\u0448\u0435\u043B\u044C \u0441 \u043C\u0435\u043B\u043A\u0438\u043C
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C, \u0437\u0430\u0431\u044B\u0442\u044B\u0439
      \u0438\u043B\u0438 \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439 \u0432\u043F\u043E\u043F\u044B\u0445\u0430\u0445.
      \u0411\u0435\u0440\u0451\u0442\u0435 \u043A\u043E\u0448\u0435\u043B\u044C \u0438
      \u043C\u0435\u0448\u043E\u043A \u043C\u0443\u043A\u0438, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u0435\u0442\u0435. \u0411\u044B\u0441\u0442\u0440\u043E,
      \u0442\u0438\u0445\u043E, \u0431\u0435\u0437 \u0436\u0430\u0434\u043D\u043E\u0441\u0442\u0438.
      \u041D\u043E \u043D\u0430 \u0432\u044B\u0445\u043E\u0434\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442\u0435
      \u0441\u0432\u0435\u0436\u0443\u044E \u0437\u0430\u0440\u0443\u0431\u043A\u0443
      \u043D\u0430 \u0434\u0435\u0440\u0435\u0432\u0435 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
      - \u043A\u0442\u043E-\u0442\u043E \u043C\u0435\u0442\u0438\u0442 \u043F\u0443\u0442\u044C
      \u043A \u0441\u0445\u0440\u043E\u043D\u0443. \u041B\u0443\u0447\u0448\u0435
      \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254969
    m_Localized: "\u041E\u0431\u044B\u0441\u043A\u0430\u0442\u044C \u0442\u0430\u0439\u043D\u0438\u043A
      \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254970
    m_Localized: "\u0412\u044B \u043C\u0435\u0442\u043E\u0434\u0438\u0447\u043D\u043E
      \u043E\u0431\u044B\u0441\u043A\u0438\u0432\u0430\u0435\u0442\u0435 \u0441\u0445\u0440\u043E\u043D,
      \u043C\u0435\u0448\u043E\u043A \u0437\u0430 \u043C\u0435\u0448\u043A\u043E\u043C,
      \u044F\u0449\u0438\u043A \u0437\u0430 \u044F\u0449\u0438\u043A\u043E\u043C.
      \u041C\u0443\u043A\u0430, \u0432\u044F\u043B\u0435\u043D\u0430\u044F \u0440\u044B\u0431\u0430,
      \u043D\u0438\u0447\u0435\u0433\u043E \u043F\u0440\u0438\u043C\u0435\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E.
      \u041D\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u0433\u043B\u0430\u0437
      \u043D\u0435 \u043E\u0431\u043C\u0430\u043D\u0443\u0442\u044C: \u043E\u0434\u0438\u043D
      \u044F\u0449\u0438\u043A \u0442\u044F\u0436\u0435\u043B\u0435\u0435, \u0447\u0435\u043C
      \u0434\u043E\u043B\u0436\u0435\u043D. \u041B\u043E\u0436\u043D\u043E\u0435
      \u0434\u043D\u043E. \u041F\u043E\u0434 \u0444\u0430\u043B\u044C\u0448\u0438\u0432\u043E\u0439
      \u043A\u0440\u044B\u0448\u043A\u043E\u0439 \u043F\u043B\u043E\u0442\u043D\u043E
      \u0441\u043A\u0430\u0442\u0430\u043D\u043D\u044B\u0435 \u043A\u0443\u043B\u044C\u043A\u0438
      \u0448\u0430\u0444\u0440\u0430\u043D\u0430 \u0432 \u0432\u043E\u0449\u0451\u043D\u043E\u0439
      \u0431\u0443\u043C\u0430\u0433\u0435 \u0438 \u0442\u0440\u0438 \u043A\u043B\u0438\u043D\u043A\u0430
      \u0438\u0437 \u0445\u043E\u0440\u0430\u0441\u0430\u043D\u0441\u043A\u043E\u0433\u043E
      \u043F\u0443\u043B\u0430\u0434\u0430 \u0432 \u043F\u0440\u043E\u043C\u0430\u0441\u043B\u0435\u043D\u043D\u044B\u0445
      \u043D\u043E\u0436\u043D\u0430\u0445. \u041A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0430,
      \u044F\u0432\u043D\u043E \u043E\u0431\u0445\u043E\u0434\u044F\u0449\u0430\u044F
      \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0435 \u043F\u043E\u0448\u043B\u0438\u043D\u044B.
      \u0411\u0435\u0440\u0451\u0442\u0435 \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0437\u0430\u043C\u0435\u0442\u0430\u0435\u0442\u0435 \u0441\u043B\u0435\u0434\u044B.
      \u0422\u043E\u0440\u043E\u043F\u0438\u0442\u0435\u0441\u044C: \u0445\u043E\u0437\u044F\u0435\u0432\u0430
      \u0437\u043D\u0430\u044E\u0442 \u0441\u0432\u043E\u0451 \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254971
    m_Localized: "\u0422\u0430\u043A \u0443\u0432\u043B\u0435\u043A\u043B\u0438\u0441\u044C
      \u043E\u0431\u044B\u0441\u043A\u043E\u043C, \u0447\u0442\u043E \u043D\u0435
      \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438 \u0442\u0440\u0451\u0445 \u043B\u044E\u0434\u0435\u0439,
      \u0432\u044B\u0441\u0442\u0443\u043F\u0438\u0432\u0448\u0438\u0445 \u0438\u0437
      \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432. \u041A\u043E\u0436\u0430\u043D\u044B\u0435
      \u043A\u0443\u0440\u0442\u043A\u0438, \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435
      \u0441\u0430\u0431\u043B\u0438, \u0436\u0451\u0441\u0442\u043A\u0438\u0435
      \u0432\u0437\u0433\u043B\u044F\u0434\u044B. \u041A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442\u044B
      \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u0437\u0430 \u0442\u043E\u0432\u0430\u0440\u043E\u043C.
      \u0421\u0442\u044B\u0447\u043A\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u0430\u044F,
      \u043D\u043E \u0436\u0451\u0441\u0442\u043A\u0430\u044F: \u0432\u044B\u0433\u043D\u0430\u043B\u0438
      \u0438\u0437 \u043F\u0435\u0449\u0435\u0440\u044B, \u0437\u0430\u0431\u0440\u0430\u043B\u0438
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E, \u043D\u0430\u043C\u044F\u043B\u0438
      \u0431\u043E\u043A\u0430 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0443.
      \u0413\u043B\u0430\u0432\u0430\u0440\u044C \u043F\u043B\u044E\u043D\u0443\u043B
      \u0432\u0441\u043B\u0435\u0434 \u0438 \u0441\u043A\u0430\u0437\u0430\u043B
      \u0447\u0442\u043E-\u0442\u043E \u043F\u043E-\u0442\u044E\u0440\u043A\u0441\u043A\u0438,
      \u043B\u0443\u0447\u0448\u0435 \u043D\u0435 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0438\u0442\u044C.
      \u041E\u0431\u043E\u0437 \u0443\u0445\u043E\u0434\u0438\u0442 \u0441 \u0441\u0438\u043D\u044F\u043A\u0430\u043C\u0438
      \u0438 \u0443\u0440\u043E\u043A\u043E\u043C: \u0447\u0443\u0436\u043E\u0435
      \u0434\u043E\u0431\u0440\u043E \u043A\u0443\u0441\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254972
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442
      \u043D\u0430 \u0437\u0430\u0441\u0430\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254973
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u043F\u043E\u0434\u043D\u044F\u043B
      \u0440\u0443\u043A\u0443, \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044F
      \u043E\u0431\u043E\u0437, \u0438 \u0431\u0435\u0437\u0437\u0432\u0443\u0447\u043D\u043E
      \u043E\u0431\u043E\u0448\u0451\u043B \u043E\u0432\u0440\u0430\u0433 \u043F\u043E
      \u0433\u0440\u0435\u0431\u043D\u044E. \u0412\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C
      \u0447\u0430\u0441\u0430. \xAB\u0422\u0440\u043E\u0435. \u0421\u043F\u044F\u0442
      \u0432 \u0440\u043E\u0449\u0435 \u0437\u0430 \u0445\u043E\u043B\u043C\u043E\u043C,
      \u043A\u043E\u043D\u0438 \u0441\u0442\u0440\u0435\u043D\u043E\u0436\u0435\u043D\u044B.
      \u0423 \u043D\u0430\u0441 \u0434\u0432\u0430 \u0447\u0430\u0441\u0430, \u043D\u0435
      \u0431\u043E\u043B\u044C\u0448\u0435\xBB. \u041F\u043E\u043A\u0430 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u0441\u0442\u043E\u044F\u043B \u043D\u0430 \u0441\u0442\u0440\u0430\u0436\u0435
      \u043D\u0430 \u0433\u0440\u0435\u0431\u043D\u0435, \u0432\u044B \u0431\u044B\u0441\u0442\u0440\u043E
      \u0438 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E
      \u043E\u0431\u044B\u0441\u043A\u0430\u043B\u0438 \u0441\u0445\u0440\u043E\u043D.
      \u0428\u0430\u0444\u0440\u0430\u043D, \u043A\u043B\u0438\u043D\u043A\u0438,
      \u043C\u0435\u0448\u043E\u043A \u043C\u0443\u043A\u0438 - \u0432\u0441\u0451
      \u043F\u0435\u0440\u0435\u043A\u043E\u0447\u0435\u0432\u0430\u043B\u043E \u0432
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443. \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u0437\u0430\u043C\u0451\u043B \u0441\u043B\u0435\u0434\u044B, \u043F\u043E\u043F\u0440\u0430\u0432\u0438\u043B
      \u0432\u0435\u0442\u043A\u0438 \u0443 \u0432\u0445\u043E\u0434\u0430 \u043A\u0430\u043A
      \u0431\u044B\u043B\u0438. \xAB\u041F\u0443\u0441\u0442\u044C \u0434\u0443\u043C\u0430\u044E\u0442,
      \u0447\u0442\u043E \u0434\u043E\u0436\u0434\u044C \u0432\u0441\u0451 \u0441\u043C\u044B\u043B.
      \u0423\u0445\u043E\u0434\u0438\u043C\xBB. \u041E\u0431\u043E\u0437 \u0443\u0448\u0451\u043B
      \u0442\u0438\u0445\u043E, \u043A\u0430\u043A \u043B\u0438\u0441\u0438\u0446\u0430
      \u0432 \u043D\u043E\u0447\u0438. \u041A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442\u044B
      \u043F\u0440\u043E\u0441\u043D\u0443\u0442\u0441\u044F \u0438 \u0434\u043E\u043B\u0433\u043E
      \u0431\u0443\u0434\u0443\u0442 \u0447\u0435\u0441\u0430\u0442\u044C \u0432
      \u0437\u0430\u0442\u044B\u043B\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254974
    m_Localized: "\u0422\u0430\u043D\u0441\u043A\u0438\u0439 \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254975
    m_Localized: "\u041D\u0430 \u043B\u0451\u0441\u0441\u043E\u0432\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0435,
      \u043C\u0435\u0436\u0434\u0443 \u043F\u0448\u0435\u043D\u0438\u0447\u043D\u044B\u043C\u0438
      \u043F\u043E\u043B\u044F\u043C\u0438, \u043F\u043E\u043F\u0435\u0440\u0451\u043A
      \u043F\u0443\u0442\u0438 \u0432\u044B\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B
      \u0431\u0430\u043C\u0431\u0443\u043A\u043E\u0432\u044B\u0435 \u0437\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u0438\u044F.
      \u0417\u0430 \u043D\u0438\u043C\u0438: \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u0439
      \u0448\u0430\u0442\u0451\u0440 \u0438\u0437 \u043F\u0440\u043E\u043C\u0430\u0441\u043B\u0435\u043D\u043D\u043E\u0439
      \u0445\u043E\u043B\u0441\u0442\u0438\u043D\u044B \u0441 \u0431\u0430\u0433\u0440\u043E\u0432\u044B\u043C
      \u0448\u0451\u043B\u043A\u043E\u0432\u044B\u043C \u0432\u044B\u043C\u043F\u0435\u043B\u043E\u043C
      \u043D\u0430 \u043A\u043E\u043D\u044C\u043A\u0435. \u0422\u0440\u043E\u0435
      \u0441\u043E\u043B\u0434\u0430\u0442 \u0432 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0447\u0430\u0442\u044B\u0445
      \u0434\u043E\u0441\u043F\u0435\u0445\u0430\u0445 \u0441 \u043B\u0430\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C\u0438
      \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0430\u043C\u0438 \u0441\u0442\u043E\u044F\u0442
      \u043F\u043B\u0435\u0447\u043E\u043C \u043A \u043F\u043B\u0435\u0447\u0443,
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0435 \u0430\u043B\u0435\u0431\u0430\u0440\u0434\u044B
      \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u043E. \u0412
      \u0446\u0435\u043D\u0442\u0440\u0435 \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u0432 \u0448\u0451\u043B\u043A\u043E\u0432\u043E\u043C \u0445\u0430\u043B\u0430\u0442\u0435
      \u0441 \u0432\u044B\u0448\u0438\u0442\u044B\u043C \u0434\u0440\u0430\u043A\u043E\u043D\u043E\u043C,
      \u0432 \u0440\u0443\u043A\u0430\u0445 \u043B\u0430\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
      \u0434\u043E\u0449\u0435\u0447\u043A\u0430 \u0434\u043B\u044F \u0437\u0430\u043F\u0438\u0441\u0435\u0439.
      \u041E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u043B\u0430\u0434\u043E\u043D\u044C,
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044F \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0440\u0435\u0437\u043A\u0438\u043C
      \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u043C \u0442\u043E\u043D\u043E\u043C:\r\n\r\n<npc_speech
      lang=\"Chinese\">\u0421\u0442\u043E\u044F\u0442\u044C! \u042F - \u0434\u0443\u0445\u0443
      \u0410\u043D\u044C\u0441\u0438 \u041B\u0438 \u0427\u044D\u043D. \u041F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0442\u0435
      \u0434\u043E\u0440\u043E\u0436\u043D\u0443\u044E \u0433\u0440\u0430\u043C\u043E\u0442\u0443
      \u0438 \u043E\u043F\u0438\u0441\u044C \u0442\u043E\u0432\u0430\u0440\u043E\u0432.
      \u0411\u0435\u0437 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F
      \u043F\u0440\u043E\u0445\u043E\u0434 \u0437\u0430\u043A\u0440\u044B\u0442.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254976
    m_Localized: "\u041F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0442\u044C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
      \u0438 \u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254977
    m_Localized: "\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435,
      \u043D\u043E \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u043D\u0435
      \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u0441\u044F. \u041E\u043D \u043F\u0435\u0440\u0435\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442
      \u043A\u0430\u0436\u0434\u0443\u044E \u0441\u0442\u0440\u043E\u043A\u0443,
      \u0441\u0432\u0435\u0440\u044F\u0435\u0442 \u043F\u0435\u0447\u0430\u0442\u0438,
      \u0441\u0447\u0438\u0442\u0430\u0435\u0442 \u0442\u044E\u043A\u0438. \u0421\u043E\u043B\u0434\u0430\u0442
      \u043E\u0449\u0443\u043F\u044B\u0432\u0430\u0435\u0442 \u043C\u0435\u0448\u043A\u0438,
      \u0437\u0430\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442 \u043F\u043E\u0434
      \u0445\u043E\u043B\u0441\u0442\u0438\u043D\u0443. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438:
      \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u043E\u0432\u0430\u044F \u043F\u043E\u0448\u043B\u0438\u043D\u0430
      \u043F\u044F\u0442\u044C \u043C\u043E\u043D\u0435\u0442 \u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u043C
      \u0434\u043D\u0451\u043C \u043F\u0443\u0442\u0438. \u041D\u0430 \u043B\u0430\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
      \u0434\u043E\u0449\u0435\u0447\u043A\u0435 \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0430
      \u043F\u0440\u0438\u0431\u0430\u0432\u0438\u043B\u0430\u0441\u044C \u0441\u0442\u0440\u043E\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254978
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u0443\u0431\u0435\u0434\u0438\u0442\u044C \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774505254979
    m_Localized: "\u0412\u044B \u043D\u0438\u0437\u043A\u043E \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u043B\u0438\u0441\u044C
      \u0438 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438, \u043F\u043E\u0447\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
      \u043D\u043E \u0431\u0435\u0437 \u0440\u0430\u0431\u043E\u043B\u0435\u043F\u0438\u044F.
      \u0423\u043F\u043E\u043C\u044F\u043D\u0443\u043B\u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u0434\u043E\u043C \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u0435, \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0433\u043E
      \u043F\u0440\u0435\u0444\u0435\u043A\u0442\u0430, \u0432\u0430\u0436\u043D\u043E\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430 \u0434\u043B\u044F \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0433\u0430\u0440\u043D\u0438\u0437\u043E\u043D\u043E\u0432. \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u0441\u043B\u0443\u0448\u0430\u043B, \u043F\u043E\u0441\u0442\u0443\u043A\u0438\u0432\u0430\u044F
      \u043A\u0438\u0441\u0442\u044C\u044E \u043F\u043E \u0434\u043E\u0449\u0435\u0447\u043A\u0435.
      \u041F\u043E\u0442\u043E\u043C \u043A\u0438\u0432\u043D\u0443\u043B, \u0432\u0435\u043B\u0435\u043B
      \u0441\u043E\u043B\u0434\u0430\u0442\u0430\u043C \u043F\u043E\u0434\u043D\u044F\u0442\u044C
      \u0437\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u0438\u0435 \u0438 \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B
      \u043F\u0443\u0442\u0435\u0432\u0443\u044E \u0433\u0440\u0430\u043C\u043E\u0442\u0443,
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
      \u0434\u043E \u041B\u0430\u043D\u044C\u0447\u0436\u043E\u0443. \xAB\u041D\u0435
      \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435\u0441\u044C
      \u0432 \u043F\u0443\u0442\u0438\xBB, - \u0441\u043A\u0430\u0437\u0430\u043B
      \u043E\u043D, \u0443\u0436\u0435 \u043D\u0435 \u0433\u043B\u044F\u0434\u044F
      \u043D\u0430 \u0432\u0430\u0441. \u0422\u0440\u0438 \u043C\u043E\u043D\u0435\u0442\u044B
      \u043F\u043E\u0448\u043B\u0438\u043D\u044B: \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u044C
      \u0434\u0435\u0448\u0435\u0432\u043B\u0435 \u0432\u0437\u044F\u0442\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449216
    m_Localized: "\u0421\u043B\u043E\u0432\u0430 \u043F\u0440\u043E\u0437\u0432\u0443\u0447\u0430\u043B\u0438
      \u043D\u0435 \u0442\u0430\u043A, \u043A\u0430\u043A \u0437\u0430\u0434\u0443\u043C\u044B\u0432\u0430\u043B\u043E\u0441\u044C:
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0432\u043E\u043B\u044C\u043D\u043E,
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043F\u043E-\u043A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u0438.
      \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u043D\u0430\u0445\u043C\u0443\u0440\u0438\u043B\u0441\u044F
      \u0438 \u043F\u0440\u043E\u0446\u0435\u0434\u0438\u043B \u0441\u043A\u0432\u043E\u0437\u044C
      \u0437\u0443\u0431\u044B \u043F\u0440\u0438\u043A\u0430\u0437: \u043F\u043E\u043B\u043D\u044B\u0439
      \u0434\u043E\u0441\u043C\u043E\u0442\u0440. \u0421\u043E\u043B\u0434\u0430\u0442\u044B
      \u0440\u0430\u0437\u0432\u044F\u0437\u0430\u043B\u0438 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0442\u044E\u043A, \u0432\u044B\u0432\u0430\u043B\u0438\u043B\u0438 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435
      \u043D\u0430 \u043F\u044B\u043B\u044C, \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043B\u0438
      \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u043C\u043E\u043D\u0435\u0442\u044B.
      \u0428\u0442\u0440\u0430\u0444 \u0437\u0430 \xAB\u043D\u0435\u0431\u0440\u0435\u0436\u043D\u043E\u0441\u0442\u044C
      \u0432 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u0445\xBB: \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0445. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u043F\u0435\u0440\u0435\u0443\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442
      \u0442\u043E\u0432\u0430\u0440, \u0431\u0440\u043E\u0441\u0430\u044F \u043D\u0430
      \u0432\u0430\u0441 \u0442\u044F\u0436\u0451\u043B\u044B\u0435 \u0432\u0437\u0433\u043B\u044F\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449217
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449218
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0448\u0430\u0433\u043D\u0443\u043B
      \u0432\u043F\u0435\u0440\u0451\u0434, \u0441\u043B\u043E\u0436\u0438\u043B
      \u0440\u0443\u043A\u0438 \u0432 \u0446\u0435\u0440\u0435\u043C\u043E\u043D\u0438\u0430\u043B\u044C\u043D\u043E\u043C
      \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438 \u0438 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u043D\u0430 \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u043E\u043C
      \u043F\u0440\u0438\u0434\u0432\u043E\u0440\u043D\u043E\u043C \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C,
      \u0441 \u043E\u0431\u043E\u0440\u043E\u0442\u0430\u043C\u0438, \u043A\u0430\u043A\u0438\u0435
      \u0443\u0441\u043B\u044B\u0448\u0438\u0448\u044C \u0440\u0430\u0437\u0432\u0435
      \u0447\u0442\u043E \u0432 \u043A\u0430\u043D\u0446\u0435\u043B\u044F\u0440\u0438\u0438
      \u0427\u0430\u043D\u044A\u0430\u043D\u044F: <npc_speech lang=\"Chinese\">\u0421\u0438\u044F\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0434\u0443\u0445\u0443 \u0410\u043D\u044C\u0441\u0438, \u043C\u044B - \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0441 \u0434\u043E\u0437\u0432\u043E\u043B\u0435\u043D\u0438\u044F
      \u043F\u0440\u043E\u0442\u0435\u043A\u0442\u043E\u0440\u0430\u0442\u0430. \u041F\u0440\u043E\u0448\u0443
      \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u0433\u0440\u0430\u043C\u043E\u0442\u0443
      \u0438 \u043E\u043F\u0438\u0441\u044C. \u0414\u0430 \u043F\u0440\u0435\u0431\u0443\u0434\u0435\u0442
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u041F\u043E\u0434\u043D\u0435\u0431\u0435\u0441\u043D\u043E\u0439
      \u043D\u0435\u0440\u0443\u0448\u0438\u043C.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449219
    m_Localized: "\u042F\u0440\u043C\u0430\u0440\u043A\u0430 \u043B\u043E\u0448\u0430\u0434\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449220
    m_Localized: "\u0417\u0430 \u043F\u043E\u043B\u043E\u0433\u0438\u043C \u0445\u043E\u043B\u043C\u043E\u043C
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0448\u0443\u043C\u043D\u043E\u0435
      \u0437\u0440\u0435\u043B\u0438\u0449\u0435: \u0434\u0435\u0441\u044F\u0442\u043A\u0438
      \u0432\u043E\u0439\u043B\u043E\u0447\u043D\u044B\u0445 \u044E\u0440\u0442,
      \u0434\u044B\u043C\u044F\u0449\u0438\u0435\u0441\u044F \u043A\u043E\u0441\u0442\u0440\u044B,
      \u0440\u0436\u0430\u043D\u0438\u0435 \u043B\u043E\u0448\u0430\u0434\u0435\u0439.
      \u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0435 \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0438
      \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0438 \u044F\u0440\u043C\u0430\u0440\u043A\u0443:
      \u0442\u0430\u0431\u0443\u043D\u044B \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D\u044B
      \u043A \u0434\u043B\u0438\u043D\u043D\u044B\u043C \u043A\u043E\u043D\u043E\u0432\u044F\u0437\u044F\u043C,
      \u043A\u0440\u0435\u043F\u043A\u0438\u0435 \u043D\u0438\u0437\u043A\u043E\u0440\u043E\u0441\u043B\u044B\u0435
      \u0441\u0442\u0435\u043F\u043D\u044B\u0435 \u043A\u043E\u043D\u0438, \u0430
      \u0441\u0440\u0435\u0434\u0438 \u043D\u0438\u0445 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0441\u0442\u0430\u0442\u043D\u044B\u0445 \u0436\u0435\u0440\u0435\u0431\u0446\u043E\u0432,
      \u043B\u043E\u0441\u043D\u044F\u0449\u0438\u0445\u0441\u044F \u043D\u0430 \u0441\u043E\u043B\u043D\u0446\u0435.
      \u041C\u0443\u0436\u0447\u0438\u043D\u044B \u0432 \u043A\u043E\u0436\u0430\u043D\u044B\u0445
      \u0431\u0435\u0437\u0440\u0443\u043A\u0430\u0432\u043A\u0430\u0445 \u0438 \u043C\u0435\u0445\u043E\u0432\u044B\u0445
      \u0448\u0430\u043F\u043A\u0430\u0445 \u0432\u0435\u0434\u0443\u0442 \u043A\u043E\u043D\u0435\u0439
      \u043F\u043E \u043A\u0440\u0443\u0433\u0443, \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044F
      \u0430\u043B\u043B\u044E\u0440. \u0417\u0430\u043F\u0430\u0445 \u043A\u043E\u043D\u0441\u043A\u043E\u0433\u043E
      \u043F\u043E\u0442\u0430, \u043A\u0443\u043C\u044B\u0441\u0430 \u0438 \u0436\u0430\u0440\u0435\u043D\u043E\u0433\u043E
      \u0431\u0430\u0440\u0430\u043D\u044C\u0435\u0433\u043E \u0436\u0438\u0440\u0430
      \u0432\u0438\u0441\u0438\u0442 \u0432 \u0442\u0451\u043F\u043B\u043E\u043C
      \u0432\u043E\u0437\u0434\u0443\u0445\u0435. \u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430
      \u0441 \u0437\u0430\u043F\u043B\u0435\u0442\u0451\u043D\u043D\u043E\u0439 \u0432
      \u043A\u043E\u0441\u0443 \u0431\u043E\u0440\u043E\u0434\u043E\u0439 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0438 \u043C\u0430\u0448\u0435\u0442
      \u0440\u0443\u043A\u043E\u0439, \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u044F
      \u043F\u043E\u0434\u043E\u0439\u0442\u0438:\r\n\r\n<npc_speech lang=\"Turkic\">\u0417\u0434\u043E\u0440\u043E\u0432
      \u0431\u0443\u0434\u044C, \u043F\u0443\u0442\u043D\u0438\u043A! \u0423 \u043D\u0430\u0441
      \u043A\u043E\u043D\u0438 \u0435\u0441\u0442\u044C - \u0434\u043E\u0431\u0440\u044B\u0435,
      \u043A\u0440\u0435\u043F\u043A\u0438\u0435, \u0431\u044B\u0441\u0442\u0440\u044B\u0435.
      \u041F\u043E\u0434\u0445\u043E\u0434\u0438, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438
      - \u043C\u043E\u0436\u0435\u0442, \u0441\u0442\u043E\u0440\u0433\u0443\u0435\u043C\u0441\u044F!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449221
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E
      \u043A\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449222
    m_Localized: "\u0412\u044B \u0443\u043A\u0430\u0437\u0430\u043B\u0438 \u043D\u0430
      \u043A\u0440\u0435\u043F\u043A\u043E\u0433\u043E \u0433\u043D\u0435\u0434\u043E\u0433\u043E
      \u043A\u043E\u043D\u044C\u043A\u0430: \u043D\u0435 \u043A\u0440\u0430\u0441\u0430\u0432\u0435\u0446,
      \u043D\u043E \u0448\u0438\u0440\u043E\u043A\u043E\u0433\u0440\u0443\u0434\u044B\u0439,
      \u0441 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C\u0438 \u043A\u0440\u0435\u043F\u043A\u0438\u043C\u0438
      \u043D\u043E\u0433\u0430\u043C\u0438. \u041A\u043E\u0447\u0435\u0432\u043D\u0438\u043A
      \u043A\u0438\u0432\u043D\u0443\u043B, \u043F\u0440\u0438\u043D\u044F\u043B
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E, \u043F\u0435\u0440\u0435\u043A\u0438\u043D\u0443\u043B
      \u043F\u043E\u0432\u043E\u0434. \u041A\u043E\u043D\u044C \u0442\u043A\u043D\u0443\u043B\u0441\u044F
      \u043C\u043E\u0440\u0434\u043E\u0439 \u0432\u0430\u043C \u0432 \u043F\u043B\u0435\u0447\u043E:
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439,
      \u043A \u0443\u043F\u0440\u044F\u0436\u0438 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u044B\u0439.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0446\u043E\u043A\u0430\u044E\u0442: \u0437\u0430\u043F\u0430\u0441\u043D\u0430\u044F
      \u0442\u044F\u0433\u043B\u043E\u0432\u0430\u044F \u0441\u0438\u043B\u0430 \u043D\u0430
      \u0434\u043E\u0440\u043E\u0433\u0435 \u043D\u0435 \u0440\u043E\u0441\u043A\u043E\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449223
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0437\u0430 \u043F\u043E\u0440\u043E\u0434\u0438\u0441\u0442\u043E\u0433\u043E
      \u0436\u0435\u0440\u0435\u0431\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449224
    m_Localized: "\u0412\u044B \u043F\u0440\u0438\u043C\u0435\u0442\u0438\u043B\u0438
      \u0440\u043E\u0441\u043B\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u043A\u043E\u0432\u043E\u0433\u043E
      \u0436\u0435\u0440\u0435\u0431\u0446\u0430 \u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u0435\u043C
      \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u043E\u0432\u044F\u0437\u0438:
      \u0442\u0430\u043A\u043E\u0433\u043E \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0434\u0430\u0448\u044C \u0432\u0442\u0440\u043E\u0435.
      \u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430 \u0437\u0430\u043B\u043E\u043C\u0438\u043B
      \u0446\u0435\u043D\u0443, \u043D\u043E \u0432\u044B \u0437\u043D\u0430\u043B\u0438
      \u043F\u0440\u0438\u0451\u043C\u044B: \u043F\u043E\u0445\u0432\u0430\u043B\u0438\u043B\u0438
      \u0435\u0433\u043E \u0442\u0430\u0431\u0443\u043D, \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0434\u043B\u0438\u043D\u043D\u044B\u0439 \u043F\u0443\u0442\u044C,
      \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B\u0438 \u043C\u0435\u0448\u043E\u043A
      \u0441\u0443\u0448\u0451\u043D\u044B\u0445 \u0444\u0438\u043D\u0438\u043A\u043E\u0432
      \u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u043E. \u0422\u0440\u0438 \u043A\u0440\u0443\u0433\u0430
      \u0442\u043E\u0440\u0433\u0430, \u0438 \u0436\u0435\u0440\u0435\u0431\u0435\u0446
      \u0432\u0430\u0448, \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u043C
      \u0441\u0435\u0434\u043B\u043E\u043C \u0438\u0437 \u0432\u043E\u0439\u043B\u043E\u043A\u0430
      \u0438 \u043A\u043E\u0436\u0438. \u041A\u043E\u0447\u0435\u0432\u043D\u0438\u043A
      \u0445\u043B\u043E\u043F\u043D\u0443\u043B \u043F\u043E \u0440\u0443\u043A\u0430\u043C
      \u0438 \u043D\u0430\u043B\u0438\u043B \u043F\u0438\u0430\u043B\u0443 \u043A\u0443\u043C\u044B\u0441\u0430:
      \u0437\u043D\u0430\u043A \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F \u043A
      \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u043E\u043C\u0443 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449225
    m_Localized: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043A\u0440\u0435\u043F\u043A\u0438\u043C \u043E\u0440\u0435\u0448\u043A\u043E\u043C.
      \u0412\u0430\u0448\u0438 \u0434\u043E\u0432\u043E\u0434\u044B \u0441\u043A\u043E\u043B\u044C\u0437\u0438\u043B\u0438
      \u043C\u0438\u043C\u043E: \u043E\u043D \u0442\u043E\u043B\u044C\u043A\u043E
      \u043A\u0430\u0447\u0430\u043B \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0438
      \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u043B \u0446\u0435\u043D\u0443.
      \u0412 \u0438\u0442\u043E\u0433\u0435 \u0432\u044B \u0443\u0441\u0442\u0443\u043F\u0438\u043B\u0438
      \u043F\u0435\u0440\u0432\u044B\u043C\u0438, \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0432
      \u043F\u043E\u043B\u043D\u0443\u044E \u0446\u0435\u043D\u0443 \u0437\u0430
      \u043A\u043E\u043D\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0445\u043E\u0440\u043E\u0448, \u043D\u043E \u043D\u0435 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E.
      \u041A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0438 \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u043B\u0438\u0441\u044C
      \u0438 \u043F\u043E\u0441\u043C\u0435\u0438\u0432\u0430\u043B\u0438\u0441\u044C.
      \u0423\u0440\u043E\u043A: \u0441\u0442\u0435\u043F\u043D\u043E\u0439 \u0442\u043E\u0440\u0433
      \u044D\u0442\u043E \u043D\u0435 \u0431\u0430\u0437\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449226
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u0442
      \u043B\u043E\u0448\u0430\u0434\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449227
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043E\u043A\u0438\u043D\u0443\u043B
      \u0442\u0430\u0431\u0443\u043D \u0446\u0435\u043F\u043A\u0438\u043C \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C
      \u0438 \u0442\u0440\u043E\u043D\u0443\u043B \u0432\u0430\u0441 \u0437\u0430
      \u043B\u043E\u043A\u043E\u0442\u044C: \xAB\u0412\u043E\u043D \u0442\u043E\u0442,
      \u043F\u0435\u0433\u0438\u0439, \u0442\u0440\u0435\u0442\u0438\u0439 \u0441\u043F\u0440\u0430\u0432\u0430,
      \u0432\u0438\u0434\u0438\u0448\u044C, \u043A\u0430\u043A \u0441\u0442\u0430\u0432\u0438\u0442
      \u0437\u0430\u0434\u043D\u0438\u0435? \u0424\u0435\u0440\u0433\u0430\u043D\u0441\u043A\u0430\u044F
      \u043A\u0440\u043E\u0432\u044C, \u043D\u0435 \u0447\u0438\u0441\u0442\u0430\u044F
      \u0441\u0442\u0435\u043F\u043D\u0430\u044F. \u0421\u0442\u043E\u0438\u0442
      \u0432\u0447\u0435\u0442\u0432\u0435\u0440\u043E \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043F\u0440\u043E\u0441\u044F\u0442, \u043D\u043E \u0445\u043E\u0437\u044F\u0438\u043D
      \u043D\u0435 \u0437\u043D\u0430\u0435\u0442\xBB. \u0412\u044B \u043F\u043E\u0434\u043E\u0448\u043B\u0438
      \u043A \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0443, \u043A\u0430\u043A
      \u0431\u0443\u0434\u0442\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u044F\u0441\u044C
      \u0433\u043D\u0435\u0434\u044B\u043C \u0440\u044F\u0434\u043E\u043C, \u0430
      \u043F\u043E\u0442\u043E\u043C \u043A\u0430\u043A \u0431\u044B \u043D\u0435\u0432\u0437\u043D\u0430\u0447\u0430\u0439
      \u0443\u043A\u0430\u0437\u0430\u043B\u0438 \u043D\u0430 \u043F\u0435\u0433\u043E\u0433\u043E.
      \u0422\u043E\u0440\u0433 \u0434\u043B\u0438\u043B\u0441\u044F \u043D\u0435\u0434\u043E\u043B\u0433\u043E:
      \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A \u043E\u0442\u0434\u0430\u043B
      \u043A\u043E\u043D\u044F \u0437\u0430 \u0432\u043E\u0441\u0435\u043C\u044C
      \u043C\u043E\u043D\u0435\u0442, \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u0439,
      \u0447\u0442\u043E \u0441\u0431\u044B\u043B \xAB\u043D\u0435\u0441\u043A\u043B\u0430\u0434\u043D\u043E\u0433\u043E\xBB,
      \u0438 \u0432 \u043F\u0440\u0438\u0434\u0430\u0447\u0443 \u0432\u0440\u0443\u0447\u0438\u043B
      \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0435 \u0441\u0435\u0434\u043B\u043E.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B
      \u0441\u0435\u0431\u0435 \u0435\u0434\u0432\u0430 \u0437\u0430\u043C\u0435\u0442\u043D\u0443\u044E
      \u0443\u043B\u044B\u0431\u043A\u0443, \u043A\u043E\u0433\u0434\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449228
    m_Localized: "\u0420\u0430\u043D\u0435\u043D\u044B\u0439 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449229
    m_Localized: "\u0423 \u043E\u0431\u043E\u0447\u0438\u043D\u044B, \u0432 \u0442\u0435\u043D\u0438
      \u0437\u0430\u0441\u043E\u0445\u0448\u0435\u0433\u043E \u043A\u0430\u0440\u0430\u0433\u0430\u0447\u0430,
      \u0441\u0438\u0434\u0438\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A:
      \u043F\u0440\u0438\u0441\u043B\u043E\u043D\u0438\u043B\u0441\u044F \u0441\u043F\u0438\u043D\u043E\u0439
      \u043A \u0441\u0442\u0432\u043E\u043B\u0443, \u043D\u043E\u0433\u0438 \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u044B,
      \u043B\u0435\u0432\u0430\u044F \u0440\u0443\u043A\u0430 \u043F\u0440\u0438\u0436\u0430\u0442\u0430
      \u043A \u0431\u043E\u043A\u0443 \u0433\u0440\u044F\u0437\u043D\u043E\u0439
      \u0442\u0440\u044F\u043F\u043A\u043E\u0439, \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D\u043D\u043E\u0439
      \u0431\u0443\u0440\u044B\u043C. \u0420\u044F\u0434\u043E\u043C \u0432\u043E\u0442\u043A\u043D\u0443\u0442
      \u0432 \u0437\u0435\u043C\u043B\u044E \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
      \u043C\u0435\u0447, \u0449\u0435\u0440\u0431\u0430\u0442\u044B\u0439, \u043D\u043E
      \u0434\u043E\u0431\u0440\u043E\u0442\u043D\u044B\u0439. \u041D\u0430 \u043C\u0443\u0436\u0447\u0438\u043D\u0435
      \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u043D\u0430\u0433\u0440\u0443\u0434\u043D\u0438\u043A \u0441\u043E \u0441\u043B\u0435\u0434\u0430\u043C\u0438
      \u0443\u0434\u0430\u0440\u043E\u0432, \u043F\u044B\u043B\u044C\u043D\u044B\u0435
      \u0441\u0430\u043F\u043E\u0433\u0438, \u043D\u0430 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u0435
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u0431\u0440\u0430\u0441\u043B\u0435\u0442-\u043E\u0431\u0435\u0440\u0435\u0433
      \u0438\u0437 \u0432\u0438\u0442\u043E\u0439 \u0431\u0440\u043E\u043D\u0437\u044B.
      \u041E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u0443,
      \u043A\u043E\u0433\u0434\u0430 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u0433\u043E\u043B\u043E\u0432\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430:
      \u043B\u0438\u0446\u043E \u043E\u0431\u0432\u0435\u0442\u0440\u0435\u043D\u043D\u043E\u0435,
      \u0433\u043B\u0430\u0437\u0430 \u044F\u0441\u043D\u044B\u0435, \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
      \u043D\u0430 \u0436\u0430\u0440. \u0411\u044B\u0432\u0448\u0438\u0439 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A,
      \u044D\u0442\u043E \u0432\u0438\u0434\u043D\u043E \u043F\u043E \u0432\u044B\u043F\u0440\u0430\u0432\u043A\u0435
      \u0438 \u0448\u0440\u0430\u043C\u0430\u043C. \u0425\u0440\u0438\u043F\u043B\u043E,
      \u0441 \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u043C \u0430\u043A\u0446\u0435\u043D\u0442\u043E\u043C,
      \u043E\u043D \u043E\u043A\u043B\u0438\u043A\u0430\u0435\u0442 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449230
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432\u043E\u0434\u0443
      \u0438 \u0435\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449231
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0441\u0431\u0440\u043E\u0441\u0438\u043B
      \u0441 \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0431\u0443\u0440\u0434\u044E\u043A
      \u0432\u043E\u0434\u044B \u0438 \u0443\u0437\u0435\u043B\u043E\u043A \u0441
      \u043B\u0435\u043F\u0451\u0448\u043A\u0430\u043C\u0438. \u0420\u0430\u043D\u0435\u043D\u044B\u0439
      \u043A\u0438\u0432\u043D\u0443\u043B, \u043D\u0435 \u043E\u0442\u0432\u043E\u0434\u044F
      \u0433\u043B\u0430\u0437, \u0438 \u043F\u0440\u043E\u0448\u0435\u043F\u0442\u0430\u043B
      \xAB\u0441\u043F\u0430\u0441\u0438\u0431\u043E\xBB \u043D\u0430 \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u043C.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435, \u043B\u044E\u0434\u0438 \u043C\u043E\u043B\u0447\u0430\u0442,
      \u043D\u043E \u0432 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0438 \u043D\u0435\u0442
      \u0441\u0442\u044B\u0434\u0430. \u0412\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0447\u0442\u043E \u043C\u043E\u0433\u043B\u0438. \u041E\u043D \u0441\u043E\u043B\u0434\u0430\u0442,
      \u0432\u044B\u0436\u0438\u0432\u0435\u0442 \u0438\u043B\u0438 \u043D\u0435\u0442,
      \u043D\u043E \u043D\u0435 \u043E\u0442 \u0433\u043E\u043B\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449232
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u043F\u043E\u0434\u043B\u0430\u0442\u0430\u0442\u044C
      \u0438 \u0432\u0437\u044F\u0442\u044C \u0441 \u0441\u043E\u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449233
    m_Localized: "\u0420\u0430\u043D\u0443 \u043F\u0440\u043E\u043C\u044B\u043B\u0438
      \u043A\u0443\u043C\u044B\u0441\u043E\u043C (\u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C,
      \u0447\u0442\u043E \u043D\u0430\u0448\u043B\u043E\u0441\u044C), \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043B\u0438
      \u0447\u0438\u0441\u0442\u043E\u0439 \u0442\u0440\u044F\u043F\u0438\u0446\u0435\u0439,
      \u043F\u0440\u0438\u0442\u044F\u043D\u0443\u043B\u0438 \u043A \u0440\u0451\u0431\u0440\u0430\u043C
      \u043E\u0431\u0440\u044B\u0432\u043A\u043E\u043C \u0440\u0435\u043C\u043D\u044F.
      \u0420\u0430\u043D\u0435\u043D\u044B\u0439 \u0441\u0442\u0438\u0441\u043D\u0443\u043B
      \u0437\u0443\u0431\u044B, \u043F\u043E\u0431\u043B\u0435\u0434\u043D\u0435\u043B,
      \u043D\u043E \u043D\u0435 \u0438\u0437\u0434\u0430\u043B \u043D\u0438 \u0437\u0432\u0443\u043A\u0430.
      \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u043E\u043D \u0443\u0436\u0435
      \u0441\u0438\u0434\u0435\u043B \u043D\u0430 \u0437\u0430\u0434\u043D\u0435\u0439
      \u043F\u043E\u0432\u043E\u0437\u043A\u0435, \u0430 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430 \u0434\u043D\u044F \u0432\u0441\u0442\u0430\u043B \u043D\u0430
      \u043D\u043E\u0433\u0438. \xAB\u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442
      \u0424\u0430\u0440\u0440\u0443\u0445, - \u0441\u043A\u0430\u0437\u0430\u043B
      \u043E\u043D, \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044F \u0441\u0432\u043E\u0439
      \u043C\u0435\u0447. - \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0438\u0437 \u0411\u0443\u0445\u0430\u0440\u044B. \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
      \u043F\u0435\u0440\u0435\u0431\u0438\u043B\u0438 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445
      \u0443 \u0441\u0443\u0445\u043E\u0433\u043E \u0440\u0443\u0441\u043B\u0430,
      \u043C\u0435\u043D\u044F \u0431\u0440\u043E\u0441\u0438\u043B\u0438 \u0443\u043C\u0438\u0440\u0430\u0442\u044C.
      \u0414\u043E\u043B\u0433 \u0437\u0430 \u043C\u043D\u043E\u0439.\xBB \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0441\u0442\u0430\u043B \u043A\u0440\u0435\u043F\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449234
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u044F\u0437\u043A\u0430 \u0434\u0430\u043B\u0430\u0441\u044C
      \u0442\u044F\u0436\u0435\u043B\u043E: \u0440\u0430\u043D\u0430 \u0433\u043B\u0443\u0431\u0436\u0435,
      \u0447\u0435\u043C \u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C, \u043A\u0440\u043E\u0432\u044C
      \u043D\u0435 \u0443\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F. \u0420\u0430\u043D\u0435\u043D\u043E\u0433\u043E
      \u0443\u043B\u043E\u0436\u0438\u043B\u0438 \u043D\u0430 \u0442\u044E\u043A\u0438,
      \u043D\u043E \u043A \u0432\u0435\u0447\u0435\u0440\u0443 \u043D\u0430\u0447\u0430\u043B\u0441\u044F
      \u0436\u0430\u0440. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0432\u0441\u0442\u0430\u0442\u044C
      \u043B\u0430\u0433\u0435\u0440\u0435\u043C \u043D\u0430 \u0441\u0443\u0442\u043A\u0438,
      \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u044F \u043F\u0440\u0438\u043F\u0430\u0441\u044B.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0432\u043E\u0440\u0447\u0430\u0442:
      \u043B\u0438\u0448\u043D\u0438\u0439 \u0440\u043E\u0442, \u0430 \u0442\u043E\u043B\u043A\u0443
      \u043D\u0435\u0442. \u0427\u0435\u043B\u043E\u0432\u0435\u043A \u0436\u0438\u0432,
      \u043D\u043E \u0441\u043B\u0430\u0431, \u0438\u0434\u0442\u0438 \u043D\u0435
      \u043C\u043E\u0436\u0435\u0442. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449235
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0440\u0430\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449236
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043F\u0440\u0438\u0441\u0435\u043B
      \u0440\u044F\u0434\u043E\u043C, \u0440\u0430\u0441\u043A\u0440\u044B\u043B
      \u0441\u0432\u043E\u0439 \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u0441\u0432\u0451\u0440\u0442\u043E\u043A
      \u0441 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438
      \u0438 \u043C\u043E\u043B\u0447\u0430 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u0440\u0430\u043D\u0443. \xAB\u0427\u0438\u0441\u0442\u043E \u0432\u043E\u0448\u043B\u043E
      - \u0440\u0435\u0431\u0440\u043E \u043E\u0442\u0432\u0435\u043B\u043E \u043A\u043B\u0438\u043D\u043E\u043A,
      \u0438\u043D\u0430\u0447\u0435 \u0431\u044B\u043B \u0431\u044B \u043C\u0451\u0440\u0442\u0432.
      \u041D\u043E \u043A\u0440\u043E\u0432\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043B
      \u043C\u043D\u043E\u0433\u043E.\xBB \u041E\u043D \u043F\u0440\u043E\u043C\u044B\u043B
      \u043F\u043E\u0440\u0435\u0437 \u043D\u0430\u0441\u0442\u043E\u0435\u043C \u043F\u043E\u043B\u044B\u043D\u0438,
      \u043D\u0430\u043B\u043E\u0436\u0438\u043B \u0442\u0443\u0433\u0443\u044E \u043F\u043E\u0432\u044F\u0437\u043A\u0443
      \u0441 \u043F\u0447\u0435\u043B\u0438\u043D\u044B\u043C \u0432\u043E\u0441\u043A\u043E\u043C
      \u0438 \u0432\u043B\u0438\u043B \u0433\u043E\u0440\u044C\u043A\u0438\u0439
      \u043E\u0442\u0432\u0430\u0440. \u041A \u0443\u0442\u0440\u0443 \u0436\u0430\u0440
      \u0441\u043F\u0430\u043B. \u0427\u0435\u0440\u0435\u0437 \u0434\u0435\u043D\u044C
      \u0424\u0430\u0440\u0440\u0443\u0445 \u0441\u0442\u043E\u044F\u043B \u043D\u0430
      \u043D\u043E\u0433\u0430\u0445, \u0431\u043B\u0435\u0434\u043D\u044B\u0439,
      \u043D\u043E \u0442\u0432\u0451\u0440\u0434\u044B\u0439. \u041C\u043E\u043B\u0447\u0430
      \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u043B\u0441\u044F \u043B\u0435\u043A\u0430\u0440\u044E,
      \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u043A \u0432\u0430\u043C: \xAB\u041C\u043E\u044F \u0436\u0438\u0437\u043D\u044C
      - \u0432\u0430\u0448\u0430. \u041F\u043E\u043A\u0430 \u0434\u044B\u0448\u0443,
      \u0432\u0430\u0448 \u043F\u0443\u0442\u044C \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u0435\u043D\xBB.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0432\u044B\u043F\u0440\u044F\u043C\u0438\u043B\u0438
      \u0441\u043F\u0438\u043D\u044B: \u0432 \u043E\u0442\u0440\u044F\u0434\u0435
      \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
      \u0431\u043E\u0435\u0446."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449237
    m_Localized: "\u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0440\u0435\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449238
    m_Localized: "\u0411\u0440\u043E\u0434, \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u0439
      \u043D\u0430 \u043A\u0430\u0440\u0442\u0435 \u0447\u0451\u0440\u0442\u043E\u0447\u043A\u043E\u0439,
      \u0438\u0441\u0447\u0435\u0437: \u0432\u043C\u0435\u0441\u0442\u043E \u043C\u0435\u043B\u043A\u043E\u0433\u043E
      \u0440\u0443\u0447\u044C\u044F \u043F\u043E\u043F\u0435\u0440\u0451\u043A \u0434\u043E\u0440\u043E\u0433\u0438
      \u043D\u0435\u0441\u0451\u0442\u0441\u044F \u043C\u0443\u0442\u043D\u044B\u0439
      \u0431\u0443\u0440\u044B\u0439 \u043F\u043E\u0442\u043E\u043A \u0448\u0438\u0440\u0438\u043D\u043E\u0439
      \u0432 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0448\u0430\u0433\u043E\u0432.
      \u0422\u0430\u043B\u044B\u0435 \u0432\u043E\u0434\u044B \u0441 \u0434\u0430\u043B\u0451\u043A\u0438\u0445
      \u0433\u043E\u0440 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0438
      \u0440\u0435\u0447\u043A\u0443 \u0432 \u0440\u0435\u0432\u0443\u0449\u0443\u044E
      \u0441\u0442\u0435\u043D\u0443 \u0433\u0440\u044F\u0437\u0438, \u043D\u0435\u0441\u0443\u0449\u0443\u044E
      \u0432\u0435\u0442\u043A\u0438, \u0434\u0451\u0440\u043D \u0438 \u0434\u043E\u0445\u043B\u0443\u044E
      \u043E\u0432\u0446\u0443. \u041A\u043E\u043B\u0435\u044F \u043E\u0431\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0443 \u043A\u0440\u043E\u043C\u043A\u0438 \u0432\u043E\u0434\u044B, \u043C\u043E\u043A\u0440\u044B\u0439
      \u0433\u043B\u0438\u043D\u0438\u0441\u0442\u044B\u0439 \u0431\u0435\u0440\u0435\u0433
      \u043E\u043F\u043B\u044B\u0432\u0430\u0435\u0442 \u043D\u0430 \u0433\u043B\u0430\u0437\u0430\u0445.
      \u041F\u0435\u0440\u0435\u0434\u043D\u0438\u0439 \u0432\u043E\u043B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F,
      \u0443\u043F\u0451\u0440\u0441\u044F \u0438 \u043C\u043E\u0442\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439: \u0447\u0443\u0435\u0442 \u0433\u043B\u0443\u0431\u0438\u043D\u0443.
      \u0411\u0440\u043E\u0434 \u043D\u0435\u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043C,
      \u043E\u0431\u044A\u0435\u0437\u0434 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D,
      \u0430 \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u043D\u0435 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449239
    m_Localized: "\u0416\u0434\u0430\u0442\u044C, \u043F\u043E\u043A\u0430 \u0432\u043E\u0434\u0430
      \u0441\u043F\u0430\u0434\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449240
    m_Localized: "\u0414\u0432\u0430 \u0434\u043D\u044F \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443.
      \u0412\u043E\u0434\u0430 \u0441\u043F\u0430\u0434\u0430\u0435\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E.
      \u041D\u0430 \u0432\u0442\u043E\u0440\u043E\u0435 \u0443\u0442\u0440\u043E
      \u0434\u043D\u043E \u0443\u0436\u0435 \u0432\u0438\u0434\u043D\u043E, \u043A\u0430\u043C\u043D\u0438
      \u0431\u043B\u0435\u0441\u0442\u044F\u0442 \u043D\u0430 \u043C\u0435\u043B\u043A\u043E\u0432\u043E\u0434\u044C\u0435.
      \u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430 \u043F\u0440\u043E\u0448\u043B\u0430
      \u043F\u043E \u043F\u043E\u044F\u0441, \u0432\u043E\u043B\u044B \u0443\u043F\u0438\u0440\u0430\u043B\u0438\u0441\u044C,
      \u043D\u043E \u043F\u0440\u043E\u0448\u043B\u0438. \u0414\u0432\u0430 \u0434\u043D\u044F
      \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432, \u0434\u0432\u0430 \u0434\u043D\u044F
      \u043D\u0435\u0440\u0432\u043E\u0432 - \u0438 \u0441\u043A\u0443\u043B\u044F\u0449\u0438\u0439
      \u0432\u0435\u0442\u0435\u0440, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0442\u044F\u043D\u0435\u0442 \u0441 \u0432\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449241
    m_Localized: "\u0420\u0438\u0441\u043A\u043D\u0443\u0442\u044C \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449242
    m_Localized: "\u0412\u044B \u043D\u0430\u0448\u043B\u0438 \u043C\u0435\u0441\u0442\u043E
      \u0432\u044B\u0448\u0435 \u043F\u043E \u0442\u0435\u0447\u0435\u043D\u0438\u044E,
      \u0433\u0434\u0435 \u0440\u0443\u0441\u043B\u043E \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u0435\u0442\u0441\u044F
      \u0438 \u043C\u0435\u043B\u0435\u0435\u0442: \u043A\u0430\u043C\u043D\u0438
      \u0442\u043E\u0440\u0447\u0430\u0442 \u0438\u0437 \u0432\u043E\u0434\u044B,
      \u043E\u0431\u0440\u0430\u0437\u0443\u044F \u043F\u043E\u0434\u043E\u0431\u0438\u0435
      \u0433\u0440\u044F\u0434\u044B. \u0412\u043E\u043B\u043E\u0432 \u043F\u0435\u0440\u0435\u0432\u0435\u043B\u0438
      \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443, \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u043B\u0438 \u043D\u0430 \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u0445,
      \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0445 \u043A \u0434\u0435\u0440\u0435\u0432\u044C\u044F\u043C
      \u043D\u0430 \u0442\u043E\u043C \u0431\u0435\u0440\u0435\u0433\u0443. \u0412\u043E\u0434\u0430
      \u0445\u043B\u0435\u0441\u0442\u0430\u043B\u0430 \u043F\u043E \u0441\u0442\u0443\u043F\u0438\u0446\u044B,
      \u043D\u043E \u0434\u043D\u043E \u0434\u0435\u0440\u0436\u0430\u043B\u043E.
      \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0444\u0443\u0440\u0433\u043E\u043D
      \u0432\u044B\u0442\u044F\u043D\u0443\u043B\u0438 \u0443\u0436\u0435 \u0432
      \u0441\u0443\u043C\u0435\u0440\u043A\u0430\u0445 - \u043C\u043E\u043A\u0440\u044B\u0435,
      \u0433\u0440\u044F\u0437\u043D\u044B\u0435, \u043D\u043E \u0446\u0435\u043B\u044B\u0435.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043E\u0440\u0430\u043B\u0438
      \u0434\u0440\u0443\u0433 \u043D\u0430 \u0434\u0440\u0443\u0433\u0430 \u043E\u0442
      \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F, \u0430 \u043F\u043E\u0442\u043E\u043C
      \u0445\u043E\u0445\u043E\u0442\u0430\u043B\u0438 \u043E\u0442 \u043E\u0431\u043B\u0435\u0433\u0447\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449243
    m_Localized: "\u041D\u0430 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u043F\u043E\u0442\u043E\u043A\u0430
      \u0434\u043D\u043E \u0443\u0448\u043B\u043E \u0438\u0437-\u043F\u043E\u0434
      \u043A\u043E\u043B\u0451\u0441: \u044F\u043C\u0430, \u0441\u043A\u0440\u044B\u0442\u0430\u044F
      \u043C\u0443\u0442\u044C\u044E. \u041F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u043E \u0442\u0435\u0447\u0435\u043D\u0438\u0435\u043C,
      \u043E\u0441\u044C \u0445\u0440\u0443\u0441\u0442\u043D\u0443\u043B\u0430,
      \u0442\u044E\u043A \u0441 \u0442\u043E\u0432\u0430\u0440\u043E\u043C \u0441\u043E\u0440\u0432\u0430\u043B\u043E
      \u0438 \u0443\u043D\u0435\u0441\u043B\u043E \u0432\u043D\u0438\u0437 \u043F\u043E
      \u0440\u0435\u043A\u0435. \u0412\u043E\u043B\u044B \u0440\u0435\u0432\u0435\u043B\u0438,
      \u043B\u044E\u0434\u0438 \u0446\u0435\u043F\u043B\u044F\u043B\u0438\u0441\u044C
      \u0437\u0430 \u0431\u043E\u0440\u0442\u0430. \u041A\u043E\u0435-\u043A\u0430\u043A
      \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438 \u043D\u0430 \u0431\u0435\u0440\u0435\u0433
      - \u0441 \u0442\u0440\u0435\u0441\u043D\u0443\u0432\u0448\u0435\u0439 \u043E\u0441\u044C\u044E,
      \u043F\u0440\u043E\u043C\u043E\u043A\u0448\u0438\u043C \u0433\u0440\u0443\u0437\u043E\u043C
      \u0438 \u043E\u0434\u043D\u0438\u043C \u0442\u044E\u043A\u043E\u043C \u043C\u0435\u043D\u044C\u0448\u0435.
      \u041C\u043E\u043A\u0440\u044B\u0435 \u0434\u043E \u043D\u0438\u0442\u043A\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u043C\u043E\u043B\u0447\u0430
      \u0432\u044B\u043B\u0438\u0432\u0430\u044E\u0442 \u0432\u043E\u0434\u0443 \u0438\u0437
      \u0441\u0430\u043F\u043E\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449244
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u043E\u0431\u0445\u043E\u0434\u043D\u043E\u0439 \u0431\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449245
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0434\u043E\u043B\u0433\u043E
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043D\u0430 \u0432\u043E\u0434\u0443,
      \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u043A\u0430\u0447\u0430\u043B \u0433\u043E\u043B\u043E\u0432\u043E\u0439
      \u0438 \u043F\u043E\u0448\u0451\u043B \u0432\u0432\u0435\u0440\u0445 \u043F\u043E
      \u0431\u0435\u0440\u0435\u0433\u0443, \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u044F
      \u043D\u0438 \u0441\u043B\u043E\u0432\u0430. \u0427\u0435\u0440\u0435\u0437
      \u043F\u043E\u043B\u0447\u0430\u0441\u0430 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F,
      \u043E\u0442\u0440\u044F\u0445\u0438\u0432\u0430\u044F \u0433\u043B\u0438\u043D\u0443
      \u0441 \u0441\u0430\u043F\u043E\u0433. \xAB\u0412\u044B\u0448\u0435 \u043F\u043E
      \u0442\u0435\u0447\u0435\u043D\u0438\u044E, \u0437\u0430 \u0438\u0437\u043B\u0443\u0447\u0438\u043D\u043E\u0439,
      \u0435\u0441\u0442\u044C \u0441\u0442\u0430\u0440\u044B\u0439 \u0431\u0440\u043E\u0434;
      \u043C\u0435\u0441\u0442\u043D\u044B\u0435 \u0433\u043E\u043D\u044F\u0442 \u0441\u0442\u0430\u0434\u0430,
      \u0442\u0430\u043C \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0435
      \u0434\u043D\u043E \u0438 \u0448\u0438\u0440\u0438\u043D\u0430 \u0432\u0434\u0432\u043E\u0435:
      \u0433\u043B\u0443\u0431\u0438\u043D\u0430 \u0432\u0434\u0432\u043E\u0435 \u043C\u0435\u043D\u044C\u0448\u0435.
      \u041F\u043E\u043B\u0434\u043D\u044F \u043A\u0440\u044E\u043A, \u043D\u043E
      \u043A\u043E\u043B\u0451\u0441\u0430 \u043E\u0441\u0442\u0430\u043D\u0443\u0442\u0441\u044F
      \u0446\u0435\u043B\u044B.\xBB \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0431\u044B\u043B \u043D\u0430 \u0442\u043E\u043C \u0431\u0435\u0440\u0435\u0433\u0443
      - \u0441\u0443\u0445\u043E\u0439, \u0446\u0435\u043B\u044B\u0439, \u0441 \u043F\u043E\u0442\u0435\u0440\u0435\u0439
      \u0432\u0441\u0435\u0433\u043E \u043B\u0438\u0448\u044C \u043E\u0434\u043D\u043E\u0439
      \u043B\u0435\u043F\u0451\u0448\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u0432\u043E\u043B \u0441\u0442\u044F\u043D\u0443\u043B \u043D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435.
      \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043F\u0440\u0438\u043D\u044F\u043B
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u043C\u043E\u043B\u0447\u0430, \u043A\u0430\u043A \u0441\u0430\u043C\u043E
      \u0441\u043E\u0431\u043E\u0439 \u0440\u0430\u0437\u0443\u043C\u0435\u044E\u0449\u0435\u0435\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449246
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0441\u043F\u0435\u0446\u0438\u044F\u043C\u0438
      \u0443 \u043E\u0430\u0437\u0438\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449247
    m_Localized: "\u0423 \u043A\u0440\u0430\u044F \u043E\u0430\u0437\u0438\u0441\u0430,
      \u043F\u043E\u0434 \u0444\u0438\u043D\u0438\u043A\u043E\u0432\u043E\u0439 \u043F\u0430\u043B\u044C\u043C\u043E\u0439,
      \u0440\u0430\u0441\u0441\u0442\u0435\u043B\u0435\u043D \u043F\u043E\u043B\u043E\u0441\u0430\u0442\u044B\u0439
      \u043A\u043E\u0432\u0451\u0440: \u043C\u0435\u0448\u043E\u0447\u043A\u0438
      \u0441\u043E \u0441\u043F\u0435\u0446\u0438\u044F\u043C\u0438 \u0438 \u043B\u0430\u0442\u0443\u043D\u043D\u044B\u0435
      \u0432\u0435\u0441\u044B. \u0425\u0443\u0434\u043E\u0449\u0430\u0432\u044B\u0439
      \u0430\u0440\u0430\u0431 \u0432 \u0431\u0435\u043B\u043E\u043C \u0442\u044E\u0440\u0431\u0430\u043D\u0435
      \u0441\u0438\u0434\u0438\u0442 \u043D\u0430 \u043F\u044F\u0442\u043A\u0430\u0445,
      \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u044F \u043D\u0438\u0442\u0438
      \u0448\u0430\u0444\u0440\u0430\u043D\u0430 \u043D\u0430\u0434 \u043C\u0435\u0434\u043D\u043E\u0439
      \u043C\u0438\u0441\u043A\u043E\u0439. \u0417\u0430\u043F\u0430\u0445 \u0443\u0434\u0430\u0440\u044F\u0435\u0442
      \u043D\u0430 \u0434\u0435\u0441\u044F\u0442\u044C \u0448\u0430\u0433\u043E\u0432:
      \u0433\u043E\u0440\u044C\u043A\u0438\u0439, \u043F\u0440\u044F\u043D\u044B\u0439,
      \u0433\u0443\u0441\u0442\u043E\u0439 - \u043B\u0430\u0434\u0430\u043D \u0438
      \u0448\u0430\u0444\u0440\u0430\u043D, \u043C\u0443\u0441\u043A\u0443\u0441
      \u0438 \u043A\u0430\u043C\u0444\u043E\u0440\u0430. \u0421\u043B\u0435\u0434\u044B
      \u0441\u0442\u0430\u0440\u044B\u0445 \u043A\u043E\u0441\u0442\u0440\u0438\u0449
      \u0432\u043E\u043A\u0440\u0443\u0433 \u0433\u043E\u0432\u043E\u0440\u044F\u0442
      \u0441\u0430\u043C\u0438 \u0437\u0430 \u0441\u0435\u0431\u044F: \u043E\u043D
      \u0442\u043E\u0440\u0433\u0443\u0435\u0442 \u0437\u0434\u0435\u0441\u044C \u043D\u0435
      \u043F\u0435\u0440\u0432\u044B\u0439 \u0433\u043E\u0434.\r\n\r\n<npc_speech
      lang=\"Arabic\">\u041C\u0438\u0440 \u0432\u0430\u043C, \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446!
      \u0423 \u043C\u0435\u043D\u044F \u0448\u0430\u0444\u0440\u0430\u043D \u0438\u0437
      \u041F\u0435\u0440\u0441\u0438\u0438 \u0438 \u043B\u0430\u0434\u0430\u043D
      \u0438\u0437 \u0425\u0430\u0434\u0440\u0430\u043C\u0430\u0443\u0442\u0430.
      \u041A\u0443\u043F\u0438\u0442\u0435? \u0426\u0435\u043D\u0430 \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u0430
      - \u0430 \u0442\u043E\u0432\u0430\u0440 \u043B\u0443\u0447\u0448\u0435 \u043D\u0435
      \u043D\u0430\u0439\u0442\u0438!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449248
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u043F\u043E \u0437\u0430\u043F\u0440\u043E\u0448\u0435\u043D\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449249
    m_Localized: "\u0412\u044B \u043E\u0442\u0441\u0447\u0438\u0442\u0430\u043B\u0438
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E, \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0432\u0437\u0432\u0435\u0441\u0438\u043B \u043C\u043E\u043D\u0435\u0442\u044B
      \u043D\u0430 \u043B\u0430\u0434\u043E\u043D\u0438, \u043A\u0438\u0432\u043D\u0443\u043B
      \u0438 \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B \u0442\u0443\u0433\u043E\u0439
      \u043C\u0435\u0448\u043E\u0447\u0435\u043A \u0441 \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u043C:
      \u043D\u0438\u0442\u0438 \u044F\u0440\u043A\u0438\u0435, \u043B\u043E\u043C\u043A\u0438\u0435,
      \u0441\u0443\u0445\u0438\u0435, \u043F\u0435\u0440\u0432\u044B\u0439 \u0441\u043E\u0440\u0442.
      \u0421\u0432\u0435\u0440\u0445\u0443 \u043F\u043E\u043B\u043E\u0436\u0438\u043B
      \u0433\u043E\u0440\u0441\u0442\u044C \u0444\u0438\u043D\u0438\u043A\u043E\u0432
      \u0441 \u0448\u0438\u0440\u043E\u043A\u043E\u0439 \u0443\u043B\u044B\u0431\u043A\u043E\u0439.
      \xAB\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443, \u0431\u0440\u0430\u0442.
      \u0427\u0442\u043E\u0431\u044B \u043F\u043E\u043C\u043D\u0438\u043B, \u0443
      \u043A\u043E\u0433\u043E \u043F\u043E\u043A\u0443\u043F\u0430\u043B.\xBB \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0436\u0443\u044E\u0442 \u0444\u0438\u043D\u0438\u043A\u0438 \u0438 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B:
      \u0441\u043F\u0435\u0446\u0438\u044F \u0434\u043E\u0440\u043E\u0433\u0430\u044F,
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435 \u0438\u043B\u0438
      \u0411\u0430\u0433\u0434\u0430\u0434\u0435 \u043E\u0442\u043E\u0431\u044C\u0451\u0442\u0441\u044F
      \u0432\u0447\u0435\u0442\u0432\u0435\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449250
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449251
    m_Localized: "\u0412\u044B \u043F\u0440\u0438\u0441\u0435\u043B\u0438 \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432,
      \u0432\u0437\u044F\u043B\u0438 \u0449\u0435\u043F\u043E\u0442\u044C \u0448\u0430\u0444\u0440\u0430\u043D\u0430,
      \u0440\u0430\u0441\u0442\u0451\u0440\u043B\u0438 \u043C\u0435\u0436\u0434\u0443
      \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438, \u043F\u043E\u043D\u044E\u0445\u0430\u043B\u0438
      \u0438 \u043F\u043E\u043A\u0430\u0447\u0430\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \xAB\u0425\u043E\u0440\u043E\u0448, \u043D\u043E \u043D\u0435 \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u0435\u043D
      - \u0432\u0442\u043E\u0440\u0430\u044F \u0441\u0443\u0448\u043A\u0430, \u044F
      \u0432\u0438\u0436\u0443 \u043F\u043E \u0446\u0432\u0435\u0442\u0443 \u0440\u044B\u043B\u044C\u0446\u0430.\xBB
      \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043F\u0440\u0438\u0449\u0443\u0440\u0438\u043B\u0441\u044F,
      \u043F\u043E\u043C\u043E\u043B\u0447\u0430\u043B, \u043F\u043E\u0442\u043E\u043C
      \u0440\u0430\u0441\u0441\u043C\u0435\u044F\u043B\u0441\u044F. \xAB\u0417\u043D\u0430\u044E\u0449\u0438\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A. \u041B\u0430\u0434\u043D\u043E
      - \u0441\u0435\u043C\u044C \u043C\u043E\u043D\u0435\u0442, \u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0438
      \u043E\u0431\u043E \u043C\u043D\u0435 \u0432 \u0411\u0443\u0445\u0430\u0440\u0435.\xBB
      \u0420\u0443\u043A\u043E\u043F\u043E\u0436\u0430\u0442\u0438\u0435 \u0441\u043A\u0440\u0435\u043F\u0438\u043B\u043E
      \u0441\u0434\u0435\u043B\u043A\u0443. \u0412\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438
      \u0448\u0430\u0444\u0440\u0430\u043D \u043F\u043E \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435 \u0438 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430 \u0432 \u043F\u0440\u0438\u0434\u0430\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449252
    m_Localized: "\u0412\u044B \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
      \u0441\u0431\u0438\u0442\u044C \u0446\u0435\u043D\u0443, \u0443\u043A\u0430\u0437\u0430\u0432
      \u043D\u0430 \u044F\u043A\u043E\u0431\u044B \u043F\u043E\u0434\u043C\u043E\u0447\u0435\u043D\u043D\u044B\u0435
      \u043C\u0435\u0448\u043A\u0438, \u043D\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0442\u043E\u043B\u044C\u043A\u043E \u0445\u043C\u044B\u043A\u043D\u0443\u043B
      \u0438 \u0440\u0430\u0437\u0432\u044F\u0437\u0430\u043B \u043A\u0430\u0436\u0434\u044B\u0439:
      \u0441\u0443\u0445\u043E\u0439, \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439.
      \xAB\u0422\u044B, \u0432\u0438\u0434\u043D\u043E, \u0448\u0451\u043B\u043A\u043E\u043C
      \u0442\u043E\u0440\u0433\u0443\u0435\u0448\u044C, \u043D\u0435 \u0441\u043F\u0435\u0446\u0438\u044F\u043C\u0438.\xBB
      \u041D\u0435\u043B\u043E\u0432\u043A\u043E\u0441\u0442\u044C \u043E\u0431\u043E\u0448\u043B\u0430\u0441\u044C
      \u0434\u043E\u0440\u043E\u0433\u043E: \u043E\u043D \u043F\u043E\u0434\u043D\u044F\u043B
      \u0446\u0435\u043D\u0443 \u0437\u0430 \xAB\u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F\xBB \u0438 \u043D\u0435 \u0443\u0441\u0442\u0443\u043F\u0438\u043B
      \u043D\u0438 \u043C\u043E\u043D\u0435\u0442\u044B. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0441 \u043D\u0430\u0446\u0435\u043D\u043A\u043E\u0439
      \u0438\u043B\u0438 \u0443\u0445\u043E\u0434\u0438\u0442\u044C \u0431\u0435\u0437
      \u0442\u043E\u0432\u0430\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449253
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446-\u043A\u043E\u043C\u043F\u0430\u043D\u044C\u043E\u043D
      \u0437\u043D\u0430\u0435\u0442 \u0440\u044B\u043D\u043E\u043A \u0441\u043F\u0435\u0446\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449254
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u043F\u043E\u0434\u043E\u0448\u0451\u043B \u043F\u0435\u0440\u0432\u044B\u043C,
      \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B \u0441 \u0430\u0440\u0430\u0431\u043E\u043C
      \u043D\u0430 \u0435\u0433\u043E \u044F\u0437\u044B\u043A\u0435: <npc_speech
      lang=\"Arabic\">\u041C\u0438\u0440 \u0442\u0435\u0431\u0435, \u0431\u0440\u0430\u0442-\u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446.
      \u041C\u044B \u0441\u043B\u044B\u0448\u0430\u043B\u0438, \u0447\u0442\u043E
      \u0432 \u0425\u043E\u0440\u0430\u0441\u0430\u043D\u0435 \u0448\u0430\u0444\u0440\u0430\u043D
      \u043D\u044B\u043D\u0447\u0435 \u043D\u0430 \u0432\u0435\u0441 \u0437\u043E\u043B\u043E\u0442\u0430.
      \u041F\u0440\u0430\u0432\u0434\u0430 \u043B\u0438?</npc_speech> \u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u043F\u043E\u0442\u0451\u043A: \u043E \u0446\u0435\u043D\u0430\u0445 \u0432
      \u041C\u0435\u0448\u0445\u0435\u0434\u0435, \u043E \u043D\u0435\u0443\u0440\u043E\u0436\u0430\u0435
      \u0448\u0430\u0444\u0440\u0430\u043D\u0430 \u0432 \u0425\u043E\u0440\u0430\u0441\u0430\u043D\u0435,
      \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0435
      \u043F\u0435\u0440\u0435\u043A\u0443\u043F\u0449\u0438\u043A\u0438 \u0437\u0430\u0434\u0438\u0440\u0430\u044E\u0442
      \u0446\u0435\u043D\u0443. \u0410\u0440\u0430\u0431 \u0441\u043B\u0443\u0448\u0430\u043B
      \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E, \u043A\u0438\u0432\u0430\u043B,
      \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u043A \u0432\u0430\u043C \u0438 \u0432\u044B\u043B\u043E\u0436\u0438\u043B
      \u0434\u0432\u0430 \u043C\u0435\u0448\u043E\u0447\u043A\u0430 \u0432\u043C\u0435\u0441\u0442\u043E
      \u043E\u0434\u043D\u043E\u0433\u043E. \xAB\u0422\u0432\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0437\u043D\u0430\u0435\u0442 \u0434\u0435\u043B\u043E. \u041F\u044F\u0442\u044C
      \u043C\u043E\u043D\u0435\u0442 \u0437\u0430 \u043E\u0431\u0430 - \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0439
      \u043C\u043D\u0435 \u0432\u0435\u0441\u0442\u043E\u0447\u043A\u0443, \u043A\u043E\u0433\u0434\u0430
      \u0431\u0443\u0434\u0435\u0448\u044C \u0432 \u0420\u0435\u0435.\xBB \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0443\u0435\u0445\u0430\u043B \u0441 \u0434\u0432\u043E\u0439\u043D\u043E\u0439
      \u043F\u043E\u0440\u0446\u0438\u0435\u0439 \u0448\u0430\u0444\u0440\u0430\u043D\u0430,
      \u0430 \u0432\u044B \u0441 \u043F\u0430\u0440\u043E\u0439 \u043D\u043E\u0432\u044B\u0445
      \u0430\u0440\u0430\u0431\u0441\u043A\u0438\u0445 \u0441\u043B\u043E\u0432,
      \u043F\u043E\u0434\u0445\u0432\u0430\u0447\u0435\u043D\u043D\u044B\u0445 \u0438\u0437
      \u0431\u0435\u0441\u0435\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449255
    m_Localized: "\u0417\u0430\u0431\u043B\u0443\u0434\u0438\u0432\u0448\u0438\u0439\u0441\u044F
      \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449256
    m_Localized: "\u041D\u0430 \u043A\u0440\u0430\u044E \u0442\u0440\u043E\u043F\u044B,
      \u0432 \u0442\u0435\u043D\u0438 \u043A\u0430\u043C\u043D\u044F, \u043B\u0435\u0436\u0438\u0442
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A: \u0445\u0443\u0434\u043E\u0439,
      \u0432 \u0431\u0435\u043B\u043E\u043C \u0442\u044E\u0440\u0431\u0430\u043D\u0435
      \u0438 \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u043C \u043F\u043B\u0430\u0449\u0435,
      \u043F\u043E\u043A\u0440\u044B\u0442\u043E\u043C \u043F\u044B\u043B\u044C\u044E
      \u0438 \u043F\u043E\u0442\u043E\u043C. \u0411\u043E\u0441\u044B\u0435 \u043D\u043E\u0433\u0438
      \u0441\u0442\u0451\u0440\u0442\u044B \u0434\u043E \u043A\u0440\u043E\u0432\u0438,
      \u0433\u0443\u0431\u044B \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u043B\u0438\u0441\u044C.
      \u0420\u044F\u0434\u043E\u043C \u043E\u043F\u0443\u0441\u0442\u043E\u0448\u0451\u043D\u043D\u044B\u0439
      \u0431\u0443\u0440\u0434\u044E\u043A \u0438 \u043F\u043E\u0441\u043E\u0445
      \u0438\u0437 \u0441\u0443\u0445\u043E\u0433\u043E \u0442\u0430\u043C\u0430\u0440\u0438\u0441\u043A\u0430.
      \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A, \u0448\u0435\u0434\u0448\u0438\u0439
      \u0432 \u041C\u0435\u043A\u043A\u0443, \u043E\u0442\u0431\u0438\u043B\u0441\u044F
      \u043E\u0442 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0434\u043D\u044F
      \u0434\u0432\u0430 \u043D\u0430\u0437\u0430\u0434: \u0433\u043B\u0430\u0437\u0430
      \u0432\u0432\u0430\u043B\u0438\u043B\u0438\u0441\u044C, \u0434\u044B\u0445\u0430\u043D\u0438\u0435
      \u0447\u0430\u0441\u0442\u043E\u0435 \u0438 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u043D\u043E\u0435.
      \u041A\u043E\u0433\u0434\u0430 \u0433\u043E\u043B\u043E\u0432\u043D\u0430\u044F
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u043F\u043E\u0440\u0430\u0432\u043D\u044F\u043B\u0430\u0441\u044C
      \u0441 \u043D\u0438\u043C, \u043E\u043D \u043F\u0440\u0438\u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F
      \u043D\u0430 \u043B\u043E\u043A\u0442\u0435 \u0438 \u043F\u0440\u043E\u0445\u0440\u0438\u043F\u0435\u043B
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043B\u043E\u0432,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0431\u0435\u0437 \u0437\u043D\u0430\u043D\u0438\u044F
      \u0430\u0440\u0430\u0431\u0441\u043A\u043E\u0433\u043E \u043D\u0435 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F:
      \u043F\u043E\u043C\u043E\u0447\u044C \u0437\u043D\u0430\u0447\u0438\u0442 \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C
      \u0432\u043E\u0434\u0443 \u0438 \u0432\u0440\u0435\u043C\u044F; \u0431\u0440\u043E\u0441\u0438\u0442\u044C
      \u0437\u043D\u0430\u0447\u0438\u0442 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0443\u043C\u0438\u0440\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449257
    m_Localized: "\u0414\u0430\u0442\u044C \u0432\u043E\u0434\u044B \u0438 \u0435\u0434\u044B,
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043D\u0430 \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449258
    m_Localized: "\u0412\u044B \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u0438 \u0431\u0443\u0440\u0434\u044E\u043A
      \u0432\u043E\u0434\u044B \u0438 \u0443\u0437\u0435\u043B\u043E\u043A \u0441
      \u043B\u0435\u043F\u0451\u0448\u043A\u0430\u043C\u0438 \u0438 \u0444\u0438\u043D\u0438\u043A\u0430\u043C\u0438.
      \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A \u043F\u0438\u043B \u0434\u043E\u043B\u0433\u043E,
      \u0436\u0430\u0434\u043D\u043E, \u043F\u043E\u0442\u043E\u043C \u043F\u0440\u0438\u0436\u0430\u043B
      \u0440\u0443\u043A\u0443 \u043A \u0441\u0435\u0440\u0434\u0446\u0443 \u0438
      \u043F\u0440\u043E\u0448\u0435\u043F\u0442\u0430\u043B \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C:
      \u0441\u043B\u043E\u0432\u0430 \u043D\u0435\u0440\u0430\u0437\u0431\u043E\u0440\u0447\u0438\u0432\u044B,
      \u043D\u043E \u0436\u0435\u0441\u0442 \u043F\u043E\u043D\u044F\u0442\u0435\u043D
      \u043D\u0430 \u043B\u044E\u0431\u043E\u043C \u044F\u0437\u044B\u043A\u0435.
      \u041E\u0433\u043B\u044F\u043D\u0443\u0432\u0448\u0438\u0441\u044C, \u0432\u044B
      \u0443\u0432\u0438\u0434\u0435\u043B\u0438, \u0447\u0442\u043E \u043E\u043D
      \u0441\u0438\u0434\u0438\u0442, \u0435\u0441\u0442 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0437\u0430\u043F\u0430\u0434. \u041C\u043E\u0436\u0435\u0442,
      \u0434\u043E\u0439\u0434\u0451\u0442. \u041C\u043E\u0436\u0435\u0442, \u043D\u0435\u0442.
      \u041D\u043E \u0441\u043E\u0432\u0435\u0441\u0442\u044C \u0447\u0438\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449259
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u0443\u0431\u0435\u0434\u0438\u0442\u044C
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u043E\u0432 \u0432\u0437\u044F\u0442\u044C
      \u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449260
    m_Localized: "\u0412\u044B \u0441\u043A\u0430\u0437\u0430\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E:
      \xAB\u0427\u0435\u043B\u043E\u0432\u0435\u043A \u0443\u043C\u0438\u0440\u0430\u0435\u0442.
      \u041C\u044B \u043D\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
      \u0438 \u043D\u0435 \u0437\u0432\u0435\u0440\u0438.\xBB \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0437\u0430\u043C\u043E\u043B\u0447\u0430\u043B\u0438, \u043F\u043E\u0442\u043E\u043C
      \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u043A\u0438\u0432\u043D\u0443\u043B.
      \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0430 \u043F\u043E\u0434\u043D\u044F\u043B\u0438
      \u043D\u0430 \u0437\u0430\u0434\u043D\u0438\u0439 \u0432\u043E\u0437, \u043D\u0430\u043F\u043E\u0438\u043B\u0438,
      \u043E\u0431\u043C\u044B\u043B\u0438 \u043D\u043E\u0433\u0438. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u043E\u043D \u043F\u0440\u0438\u0448\u0451\u043B \u0432 \u0441\u0435\u0431\u044F
      \u0438 \u0434\u043E\u0441\u0442\u0430\u043B \u0438\u0437 \u0441\u043A\u043B\u0430\u0434\u043E\u043A
      \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0433\u043E \u043F\u043B\u0430\u0449\u0430
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0441\u0432\u0451\u0440\u0442\u043E\u043A,
      \u043A\u0443\u0441\u043E\u043A \u043B\u0430\u0434\u0430\u043D\u0430. \xAB\u041D\u0451\u0441
      \u043A \u041A\u0430\u0430\u0431\u0435, - \u043F\u0440\u043E\u0448\u0435\u043F\u0442\u0430\u043B
      \u043E\u043D. - \u041D\u043E \u0410\u043B\u043B\u0430\u0445 \u043F\u043E\u0441\u043B\u0430\u043B
      \u043C\u043D\u0435 \u0432\u0430\u0441. \u0412\u043E\u0437\u044C\u043C\u0438:
      \u0442\u044B \u0434\u043E\u0441\u0442\u043E\u0438\u043D.\xBB \u0414\u0430\u0436\u0435
      \u0432\u043E\u0440\u0447\u0443\u043D\u044B \u043F\u0440\u0438\u0442\u0438\u0445\u043B\u0438.
      \u0414\u043E\u0431\u0440\u043E\u0435 \u0434\u0435\u043B\u043E \u043D\u0430
      \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0435
      \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0436\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449261
    m_Localized: "\u0412\u044B \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
      \u0432\u043E\u0437\u0437\u0432\u0430\u0442\u044C \u043A \u0441\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043D\u0438\u044E,
      \u043D\u043E \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0443\u0436\u0435
      \u043F\u043E\u0434\u0441\u0447\u0438\u0442\u0430\u043B\u0438 \u0432 \u0443\u043C\u0435:
      \u043B\u0438\u0448\u043D\u0438\u0439 \u0440\u043E\u0442, \u043F\u043E\u0442\u0435\u0440\u044F
      \u0432\u043E\u0434\u044B, \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0430.
      \xAB\u041C\u044B \u043D\u0435 \u043B\u0435\u043A\u0430\u0440\u043D\u044F, \u0445\u043E\u0437\u044F\u0438\u043D,
      - \u0441\u043A\u0430\u0437\u0430\u043B \u0441\u0442\u0430\u0440\u0448\u0438\u0439,
      - \u0441\u0430\u043C\u0438 \u0435\u043B\u0435 \u0434\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u043C.\xBB
      \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0430 \u043F\u043E\u0434\u043D\u044F\u043B\u0438
      \u0438 \u0434\u0430\u043B\u0438 \u0432\u043E\u0434\u044B, \u043D\u043E \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435 \u0443\u043F\u0430\u043B\u043E.
      \u041B\u044E\u0434\u0438 \u0431\u0443\u0440\u0447\u0430\u0442, \u0447\u0442\u043E
      \u0445\u043E\u0437\u044F\u0438\u043D \u0442\u0440\u0430\u0442\u0438\u0442 \u043E\u0431\u0449\u0438\u0435
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u043D\u0430 \u0447\u0443\u0436\u0443\u044E
      \u0431\u0435\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449262
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0440\u0430\u043D\u044B \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449263
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0441\u043F\u0435\u0448\u0438\u043B\u0441\u044F,
      \u043D\u0435 \u0434\u043E\u0436\u0438\u0434\u0430\u044F\u0441\u044C \u043F\u0440\u0438\u043A\u0430\u0437\u0430,
      \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0441\u044F \u0440\u044F\u0434\u043E\u043C
      \u0441 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u043E\u043C, \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u043D\u043E\u0433\u0438, \u043F\u043E\u0449\u0443\u043F\u0430\u043B \u043F\u0443\u043B\u044C\u0441,
      \u043F\u043E\u043A\u0430\u0447\u0430\u043B \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \xAB\u0416\u0438\u0442\u044C \u0431\u0443\u0434\u0435\u0442. \u0422\u0435\u043F\u043B\u043E\u0432\u043E\u0439
      \u0443\u0434\u0430\u0440 \u0438 \u043E\u0431\u0435\u0437\u0432\u043E\u0436\u0438\u0432\u0430\u043D\u0438\u0435,
      \u043D\u043E \u043D\u0435 \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0430.\xBB
      \u041E\u043D \u043F\u0440\u043E\u043C\u044B\u043B \u0440\u0430\u043D\u044B,
      \u043D\u0430\u043B\u043E\u0436\u0438\u043B \u043C\u0430\u0437\u044C \u0438\u0437
      \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439 \u0430\u043F\u0442\u0435\u0447\u043A\u0438,
      \u0432\u043B\u0438\u043B \u0440\u0430\u0437\u0431\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
      \u043E\u0442\u0432\u0430\u0440 \u0442\u0440\u0430\u0432. \u0427\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A \u0443\u0436\u0435
      \u0441\u0438\u0434\u0435\u043B \u043D\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0435,
      \u0431\u043B\u0435\u0434\u043D\u044B\u0439, \u043D\u043E \u0441 \u044F\u0441\u043D\u044B\u043C\u0438
      \u0433\u043B\u0430\u0437\u0430\u043C\u0438. \u041E\u043D \u0440\u0430\u0437\u0432\u044F\u0437\u0430\u043B
      \u0442\u0440\u044F\u043F\u0438\u0446\u0443 \u043D\u0430 \u043F\u043E\u044F\u0441\u0435
      \u0438 \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B \u043A\u0443\u0441\u043E\u043A
      \u043C\u043E\u043B\u043E\u0447\u043D\u043E-\u0431\u0435\u043B\u043E\u0433\u043E
      \u043B\u0430\u0434\u0430\u043D\u0430. \xAB\u0410\u043B\u043B\u0430\u0445 \u043F\u043E\u0441\u043B\u0430\u043B
      \u043C\u043D\u0435 \u0430\u043D\u0433\u0435\u043B\u0430 \u0432 \u043E\u0431\u043B\u0438\u043A\u0435
      \u043B\u0435\u043A\u0430\u0440\u044F.\xBB \u0414\u0430\u0436\u0435 \u0441\u0430\u043C\u044B\u0435
      \u0447\u0451\u0440\u0441\u0442\u0432\u044B\u0435 \u043A\u0438\u0432\u043D\u0443\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449264
    m_Localized: "\u0411\u044B\u0432\u0448\u0438\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043D\u044B\u0439
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449265
    m_Localized: "\u0423 \u043F\u043E\u043B\u0443\u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043D\u043E\u0433\u043E
      \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u044F,
      \u0437\u0430\u043D\u0435\u0441\u0451\u043D\u043D\u043E\u0433\u043E \u043F\u0435\u0441\u043A\u043E\u043C
      \u0434\u043E \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B \u0441\u0442\u0435\u043D,
      \u0441\u0438\u0434\u0438\u0442 \u0448\u0438\u0440\u043E\u043A\u043E\u043F\u043B\u0435\u0447\u0438\u0439
      \u0442\u044E\u0440\u043A: \u043A\u043E\u0436\u0430\u043D\u0430\u044F \u0431\u0435\u0437\u0440\u0443\u043A\u0430\u0432\u043A\u0430,
      \u0441\u043E\u0441\u0442\u0430\u0432\u043D\u043E\u0439 \u043B\u0443\u043A \u0437\u0430
      \u0441\u043F\u0438\u043D\u043E\u0439, \u043A\u0440\u0438\u0432\u043E\u0439
      \u043A\u043B\u0438\u043D\u043E\u043A \u043D\u0430 \u043F\u043E\u044F\u0441\u0435.
      \u041B\u0438\u0446\u043E \u043E\u0431\u0432\u0435\u0442\u0440\u0435\u043D\u043D\u043E\u0435,
      \u0441\u043A\u0443\u043B\u0430\u0441\u0442\u043E\u0435, \u0441 \u0442\u043E\u043D\u043A\u0438\u043C
      \u0448\u0440\u0430\u043C\u043E\u043C \u043E\u0442 \u0432\u0438\u0441\u043A\u0430
      \u0434\u043E \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043A\u0430.
      \u0420\u044F\u0434\u043E\u043C \u0441\u0442\u0440\u0435\u043D\u043E\u0436\u0435\u043D\u043D\u044B\u0439
      \u0441\u0442\u0435\u043F\u043D\u043E\u0439 \u043A\u043E\u043D\u044C \u0449\u0438\u043F\u043B\u0435\u0442
      \u043A\u043E\u043B\u044E\u0447\u043A\u0443 \u0443 \u0441\u0442\u0435\u043D\u044B.
      \u0417\u0430\u043C\u0435\u0442\u0438\u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u043C\u0443\u0436\u0447\u0438\u043D\u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u0438 \u043E\u043A\u043B\u0438\u043A\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u043D\u0443\u044E
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443: \u0433\u043E\u043B\u043E\u0441
      \u0445\u0440\u0438\u043F\u043B\u044B\u0439, \u043D\u043E \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0439:\r\n\r\n<npc_speech
      lang=\"Turkic\">\u0417\u0434\u043E\u0440\u043E\u0432 \u0431\u0443\u0434\u044C,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A! \u042F - \u0410\u0440\u0441\u043B\u0430\u043D,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u043E\u0445\u0440\u0430\u043D\u044F\u043B
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u044B. \u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435
      \u043B\u0438\u0445\u0438\u0435 \u043B\u044E\u0434\u0438. \u041D\u0443\u0436\u0435\u043D
      \u043B\u0438 \u0442\u0435\u0431\u0435 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A?
      \u0421\u0438\u043B\u0430 \u0435\u0441\u0442\u044C, \u0443\u043C\u0435\u043D\u0438\u0435
      \u0435\u0441\u0442\u044C - \u043E \u0446\u0435\u043D\u0435 \u0441\u0433\u043E\u0432\u043E\u0440\u0438\u043C\u0441\u044F!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449266
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u0432\u0435\u0436\u043B\u0438\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449267
    m_Localized: "\u0412\u044B \u043F\u043E\u043A\u0430\u0447\u0430\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u043E\u0439:
      \u043B\u0438\u0448\u043D\u0438\u0445 \u043C\u043E\u043D\u0435\u0442 \u043D\u0435\u0442,
      \u0430 \u0447\u0443\u0436\u043E\u0439 \u043A\u043B\u0438\u043D\u043E\u043A
      \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435 \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
      \u043A \u0434\u043E\u0431\u0440\u0443. \u0422\u044E\u0440\u043A \u043A\u0438\u0432\u043D\u0443\u043B
      \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B, \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B
      \u0441 \u0442\u0440\u043E\u043F\u044B \u0438 \u0445\u043B\u043E\u043F\u043D\u0443\u043B
      \u043A\u043E\u043D\u044F \u043F\u043E \u0448\u0435\u0435. <npc_speech lang=\"Turkic\">\u041F\u0443\u0441\u0442\u044C
      \u0422\u0435\u043D\u0433\u0440\u0438 \u0445\u0440\u0430\u043D\u0438\u0442 \u0442\u0432\u043E\u0439
      \u043F\u0443\u0442\u044C</npc_speech>, \u0431\u0440\u043E\u0441\u0438\u043B
      \u043E\u043D \u0432\u0441\u043B\u0435\u0434. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B\u0438 \u0435\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u0430\u043C\u0438.
      \u041A\u0440\u0435\u043F\u043A\u0438\u0439 \u043C\u0443\u0436\u0438\u043A.
      \u0416\u0430\u043B\u044C, \u0447\u0442\u043E \u043D\u0435 \u043F\u0440\u0438
      \u0434\u0435\u043D\u044C\u0433\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449268
    m_Localized: "\u0421\u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0432\u044B\u0433\u043E\u0434\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449269
    m_Localized: "\u0412\u044B \u043E\u0433\u043B\u044F\u0434\u0435\u043B\u0438 \u0435\u0433\u043E
      \u0441 \u043D\u043E\u0433 \u0434\u043E \u0433\u043E\u043B\u043E\u0432\u044B:
      \u0448\u0440\u0430\u043C \u0431\u043E\u0435\u0432\u043E\u0439, \u043D\u0435
      \u043E\u0442 \u043D\u043E\u0436\u0430 \u0432 \u043A\u0430\u0431\u0430\u0446\u043A\u043E\u0439
      \u0434\u0440\u0430\u043A\u0435, \u043B\u0443\u043A \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435,
      \u043A\u043E\u043D\u044C \u0443\u0445\u043E\u0436\u0435\u043D. \xAB\u0412\u043E\u0441\u0435\u043C\u044C
      \u043C\u043E\u043D\u0435\u0442 \u0434\u043E \u0411\u0443\u0445\u0430\u0440\u044B,
      \u0435\u0434\u0430 \u043D\u0430\u0448\u0430, \u043F\u0440\u0438 \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u0438
      \u0442\u0432\u043E\u0439 \u043F\u0440\u043E\u0446\u0435\u043D\u0442 \u0441
      \u0434\u043E\u0431\u044B\u0447\u0438. \u0415\u0441\u043B\u0438 \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u0443\u0435\u0448\u044C,
      \u0441\u043B\u043E\u0432\u043E \u0410\u0440\u0441\u043B\u0430\u043D\u0430 \u043D\u0435
      \u0441\u0442\u043E\u0438\u0442 \u0438 \u043C\u0435\u0434\u044F\u043A\u0430.\xBB
      \u0422\u044E\u0440\u043A \u0443\u0441\u043C\u0435\u0445\u043D\u0443\u043B\u0441\u044F,
      \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B \u0440\u0443\u043A\u0443.
      \xAB\u0410\u0440\u0441\u043B\u0430\u043D \u043D\u0435 \u0431\u0435\u0433\u0430\u0435\u0442.
      \u0412\u043E\u0441\u0435\u043C\u044C, \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E.\xBB
      \u041E\u043D \u0432\u0441\u043A\u043E\u0447\u0438\u043B \u0432 \u0441\u0435\u0434\u043B\u043E
      \u0438 \u0437\u0430\u043D\u044F\u043B \u043C\u0435\u0441\u0442\u043E \u0432
      \u0430\u0440\u044C\u0435\u0440\u0433\u0430\u0440\u0434\u0435, \u043A\u0430\u043A
      \u0431\u0443\u0434\u0442\u043E \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C
      \u0435\u0445\u0430\u043B \u0441 \u044D\u0442\u0438\u043C \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u043C.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u043E\u0432\u0435\u0441\u0435\u043B\u0435\u043B\u0438:
      \u0441 \u0442\u0430\u043A\u0438\u043C \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439
      \u0441\u043F\u0438\u0442\u0441\u044F \u043A\u0440\u0435\u043F\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449270
    m_Localized: "\u0412\u044B \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
      \u0441\u0431\u0438\u0442\u044C \u0446\u0435\u043D\u0443, \u043D\u043E \u0410\u0440\u0441\u043B\u0430\u043D
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043A\u0430\u0447\u0430\u043B
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439: \xAB\u0414\u0435\u0448\u0451\u0432\u0430\u044F
      \u043E\u0445\u0440\u0430\u043D\u0430 - \u043C\u0451\u0440\u0442\u0432\u0430\u044F
      \u043E\u0445\u0440\u0430\u043D\u0430, \u0445\u043E\u0437\u044F\u0438\u043D.\xBB
      \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F:
      \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u043C\u043E\u043D\u0435\u0442
      \u0438 \u0434\u043E\u043B\u044F \u043E\u0442 \u043B\u044E\u0431\u043E\u0433\u043E
      \u0442\u0440\u043E\u0444\u0435\u044F. \u0414\u043E\u0440\u043E\u0433\u043E,
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u043E\u043C\u043E\u0440\u0449\u0438\u043B\u0438\u0441\u044C.
      \u041D\u043E \u043A\u043B\u0438\u043D\u043E\u043A \u043F\u0440\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435
      \u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C \u0441\u043E\u0432\u0441\u0435\u043C
      \u0431\u0435\u0437 \u043D\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449271
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0443\u0437\u043D\u0430\u0451\u0442 \u0437\u0435\u043C\u043B\u044F\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449272
    m_Localized: "\u0412\u0430\u0448 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u0432\u0434\u0440\u0443\u0433 \u0432\u044B\u0435\u0445\u0430\u043B \u0432\u043F\u0435\u0440\u0451\u0434
      \u0438 \u043A\u0440\u0438\u043A\u043D\u0443\u043B \u0447\u0442\u043E-\u0442\u043E
      \u043D\u0430 \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u043C: \u0440\u0435\u0437\u043A\u043E,
      \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u043C \u0442\u043E\u043D\u043E\u043C.
      \u0410\u0440\u0441\u043B\u0430\u043D \u0432\u0437\u0434\u0440\u043E\u0433\u043D\u0443\u043B,
      \u043F\u0440\u0438\u0449\u0443\u0440\u0438\u043B\u0441\u044F, \u0430 \u043F\u043E\u0442\u043E\u043C
      \u0440\u0430\u0441\u0445\u043E\u0445\u043E\u0442\u0430\u043B\u0441\u044F \u0438
      \u0443\u0434\u0430\u0440\u0438\u043B \u0441\u0435\u0431\u044F \u043F\u043E
      \u0431\u0435\u0434\u0440\u0443. <npc_speech lang=\"Turkic\">\u0422\u0435\u043C\u0438\u0440!
      \u0421\u0443\u043A\u0438\u043D \u0441\u044B\u043D, \u0442\u044B \u0436\u0438\u0432!</npc_speech>
      \u041E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u043E\u043D\u0438
      \u0441\u043B\u0443\u0436\u0438\u043B\u0438 \u0432\u043C\u0435\u0441\u0442\u0435:
      \u043E\u0445\u0440\u0430\u043D\u044F\u043B\u0438 \u0438\u0437 \u0424\u0435\u0440\u0433\u0430\u043D\u044B
      \u0442\u0440\u0438 \u0441\u0435\u0437\u043E\u043D\u0430 \u043F\u043E\u0434\u0440\u044F\u0434.
      \u041F\u043E\u043B\u0447\u0430\u0441\u0430 \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0439,
      \u043F\u0438\u0430\u043B\u0430 \u043A\u0443\u043C\u044B\u0441\u0430, \u0438
      \u0434\u0435\u043B\u043E \u0440\u0435\u0448\u0435\u043D\u043E: <npc_speech
      lang=\"Turkic\">\u041F\u044F\u0442\u044C \u043C\u043E\u043D\u0435\u0442 - \u0434\u043B\u044F
      \u0434\u0440\u0443\u0433\u0430 \u0422\u0435\u043C\u0438\u0440\u0430. \u0418
      \u043C\u043E\u0439 \u043A\u043E\u043D\u044C \u0432 \u043E\u0431\u0449\u0438\u0439
      \u0442\u0430\u0431\u0443\u043D.</npc_speech> \u0414\u0432\u0430 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430
      \u043B\u0443\u0447\u0448\u0435 \u043E\u0434\u043D\u043E\u0433\u043E, \u0430
      \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u043E\u043F\u044B\u0442
      \u0441\u0442\u043E\u0438\u0442 \u0446\u0435\u043B\u043E\u0433\u043E \u043E\u0442\u0440\u044F\u0434\u0430.
      \u0412\u044B \u043F\u043E\u0439\u043C\u0430\u043B\u0438 \u043F\u0430\u0440\u0443
      \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0445 \u0444\u0440\u0430\u0437 \u0438\u0437
      \u0438\u0445 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430: \u043F\u0440\u0438\u0433\u043E\u0434\u044F\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449273
    m_Localized: "\u0417\u044B\u0431\u0443\u0447\u0438\u0435 \u043F\u0435\u0441\u043A\u0438
      \u043D\u0430 \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449274
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u043D\u044B\u0440\u044F\u0435\u0442
      \u0432 \u043D\u0438\u0437\u0438\u043D\u0443 \u043C\u0435\u0436\u0434\u0443
      \u0434\u0432\u0443\u043C\u044F \u043F\u043E\u043B\u043E\u0433\u0438\u043C\u0438
      \u0431\u0430\u0440\u0445\u0430\u043D\u0430\u043C\u0438, \u0438 \u0437\u0434\u0435\u0441\u044C
      \u0447\u0442\u043E-\u0442\u043E \u043D\u0435 \u0442\u0430\u043A. \u041F\u0435\u0441\u043E\u043A
      \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0432\u043B\u0430\u0436\u043D\u044B\u043C,
      \u0442\u0451\u043C\u043D\u044B\u043C, \u0431\u0443\u0434\u0442\u043E \u043F\u0440\u043E\u043B\u0438\u0442\u044B\u0439
      \u0447\u0430\u0439. \u0413\u043E\u043B\u043E\u0432\u043D\u043E\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F, \u043F\u0435\u0440\u0435\u0441\u0442\u0443\u043F\u0438\u043B
      \u043A\u043E\u043F\u044B\u0442\u0430\u043C\u0438 \u0438 \u043E\u0442\u043F\u0440\u044F\u043D\u0443\u043B,
      \u0444\u044B\u0440\u043A\u0430\u044F. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0441\u043F\u0440\u044B\u0433\u043D\u0443\u043B, \u0442\u043A\u043D\u0443\u043B
      \u043F\u043E\u0441\u043E\u0445\u043E\u043C: \u0436\u0435\u0440\u0434\u044C
      \u0443\u0448\u043B\u0430 \u043F\u043E \u043B\u043E\u043A\u043E\u0442\u044C,
      \u043B\u0435\u0433\u043A\u043E, \u0431\u0435\u0437 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u044F.
      \u0417\u044B\u0431\u0443\u0447\u0438\u0435 \u043F\u0435\u0441\u043A\u0438.
      \u041D\u0435 \u0448\u0438\u0440\u043E\u043A\u0438\u0435, \u043D\u043E \u0442\u0440\u043E\u043F\u0430
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u043F\u0440\u044F\u043C\u043E
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0438\u0445, \u0430 \u043E\u0431\u0445\u043E\u0434
      \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0439
      \u0434\u0435\u043D\u044C \u0441\u0440\u0435\u0434\u0438 \u0431\u0430\u0440\u0445\u0430\u043D\u043E\u0432
      \u0431\u0435\u0437 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432.
      \u0417\u0430\u0434\u043D\u0438\u0435 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0443\u0436\u0435 \u0442\u043E\u0440\u043C\u043E\u0437\u044F\u0442, \u043A\u043E\u043B\u0451\u0441\u0430
      \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0432\u043E\u0437\u0430 \u0432\u044F\u0437\u043D\u0443\u0442
      \u0432 \u043F\u043E\u0434\u0442\u043E\u043F\u043B\u0435\u043D\u043D\u043E\u043C
      \u0433\u0440\u0443\u043D\u0442\u0435. \u0412\u0440\u0435\u043C\u0435\u043D\u0438
      \u043D\u0430 \u0440\u0430\u0437\u0434\u0443\u043C\u044C\u044F \u043C\u0430\u043B\u043E:
      \u043F\u0435\u0441\u043E\u043A \u0442\u044F\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449275
    m_Localized: "\u0420\u0430\u0437\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0438 \u0442\u0430\u0449\u0438\u0442\u044C \u043F\u043E \u0434\u043E\u0441\u043A\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449276
    m_Localized: "\u041F\u043E\u043B\u0434\u043D\u044F \u0443\u0448\u043B\u043E \u043D\u0430
      \u0440\u0430\u0437\u0433\u0440\u0443\u0437\u043A\u0443: \u0442\u044E\u043A\u0438
      \u0438 \u043C\u0435\u0448\u043A\u0438 \u0442\u0430\u0441\u043A\u0430\u043B\u0438
      \u043D\u0430 \u0440\u0443\u043A\u0430\u0445 \u043F\u043E \u0434\u043E\u0441\u043A\u0430\u043C,
      \u0443\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u043C \u043F\u043E\u0432\u0435\u0440\u0445
      \u0437\u044B\u0431\u0443\u0447\u0435\u0433\u043E \u043F\u0435\u0441\u043A\u0430.
      \u0414\u043E\u0441\u043A\u0438 \u043F\u0440\u043E\u0433\u0438\u0431\u0430\u043B\u0438\u0441\u044C
      \u0438 \u0445\u043B\u044E\u043F\u0430\u043B\u0438, \u043E\u0434\u0438\u043D
      \u043C\u0435\u0448\u043E\u043A \u0441 \u043C\u0443\u043A\u043E\u0439 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0441\u044F
      \u0438 \u0443\u0442\u043E\u043D\u0443\u043B, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u0435\u0433\u043E \u0443\u0441\u043F\u0435\u043B\u0438
      \u0432\u044B\u0445\u0432\u0430\u0442\u0438\u0442\u044C. \u041F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0432\u044B\u0442\u044F\u0433\u0438\u0432\u0430\u043B\u0438 \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u043C\u0438
      \u0432\u0441\u0435\u043C \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u043C,
      \u0432\u043E\u043B\u044B \u0443\u043F\u0438\u0440\u0430\u043B\u0438\u0441\u044C
      \u043A\u043E\u043F\u044B\u0442\u0430\u043C\u0438 \u0432 \u043C\u043E\u043A\u0440\u044B\u0439
      \u0433\u0440\u0443\u043D\u0442. \u041A \u0437\u0430\u043A\u0430\u0442\u0443
      \u043F\u0435\u0440\u0435\u0431\u0440\u0430\u043B\u0438\u0441\u044C, \u043D\u043E
      \u043B\u0430\u0433\u0435\u0440\u044C \u0440\u0430\u0437\u0431\u0438\u043B\u0438
      \u0442\u0443\u0442 \u0436\u0435: \u043B\u044E\u0434\u0438 \u0438\u0437\u043C\u043E\u0442\u0430\u043D\u044B,
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u0434\u0440\u043E\u0436\u0430\u0442.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043D \u0434\u0435\u043D\u044C \u0438
      \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449277
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u043E\u0431\u0445\u043E\u0434\u043D\u043E\u0439
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449278
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u043D\u044F\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0433\u0440\u0435\u0431\u0435\u043D\u044C \u0431\u0430\u0440\u0445\u0430\u043D\u0430
      \u0438 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u043D\u0438\u0437\u0438\u043D\u0443.
      \u0412\u043B\u0430\u0436\u043D\u043E\u0435 \u043F\u044F\u0442\u043D\u043E \u0442\u044F\u043D\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043F\u043E\u043B\u0432\u0435\u0440\u0441\u0442\u044B \u043A
      \u044E\u0433\u0443, \u043D\u043E \u043A \u0441\u0435\u0432\u0435\u0440\u0443
      \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u0439 \u0432\u044B\u0441\u0442\u0443\u043F
      \u043F\u0435\u0440\u0435\u0436\u0438\u043C\u0430\u0435\u0442 \u043B\u043E\u0436\u0431\u0438\u043D\u0443,
      \u0438 \u043F\u043E\u0434 \u043D\u0438\u043C \u0442\u0432\u0451\u0440\u0434\u044B\u0439
      \u0433\u0440\u0443\u043D\u0442. \u0423\u0437\u043A\u0438\u0439 \u043F\u0440\u043E\u0445\u043E\u0434,
      \u0435\u0434\u0432\u0430 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0434\u043B\u044F
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438, \u043D\u043E \u043A\u0430\u043C\u0435\u043D\u044C
      \u043D\u0435 \u043E\u0431\u043C\u0430\u043D\u0435\u0442. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u0440\u043E\u0448\u0451\u043B \u043F\u043E \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0439
      \u043A\u0440\u043E\u043C\u043A\u0435: \u043A\u043E\u043B\u0451\u0441\u0430
      \u0441\u043A\u0440\u0435\u0436\u0435\u0442\u0430\u043B\u0438 \u043F\u043E \u0449\u0435\u0431\u043D\u044E,
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u0441\u0442\u0443\u043F\u0430\u043B\u0438
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E. \u041A \u043F\u043E\u043B\u0443\u0434\u043D\u044E
      \u0437\u044B\u0431\u0443\u0447\u0438\u0435 \u043F\u0435\u0441\u043A\u0438 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u043F\u043E\u0437\u0430\u0434\u0438: \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C
      \u0438 \u0431\u0435\u0437 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449279
    m_Localized: "\u0412\u044B \u043F\u043E\u0432\u0435\u043B\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0432 \u043E\u0431\u0445\u043E\u0434, \u043D\u043E \u0431\u0430\u0440\u0445\u0430\u043D\u044B
      \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E:
      \u043E\u0434\u0438\u043D \u0433\u0440\u0435\u0431\u0435\u043D\u044C \u0437\u0430
      \u0434\u0440\u0443\u0433\u0438\u043C, \u043D\u0438 \u0435\u0434\u0438\u043D\u043E\u0433\u043E
      \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u0430. \u0427\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441 \u0441\u0442\u0430\u043B\u043E \u044F\u0441\u043D\u043E,
      \u0447\u0442\u043E \u0432\u044B \u043E\u043F\u0438\u0441\u0430\u043B\u0438
      \u043A\u0440\u0443\u0433. \u0412\u0442\u043E\u0440\u043E\u0439 \u0437\u0430\u0445\u043E\u0434
      \u0443\u0432\u0451\u043B \u0435\u0449\u0451 \u0434\u0430\u043B\u044C\u0448\u0435:
      \u043A \u043D\u043E\u0447\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0441\u0442\u043E\u044F\u043B \u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445
      \u0434\u044E\u043D, \u0431\u0443\u0440\u0434\u044E\u043A\u0438 \u043F\u043E\u043B\u0443\u043F\u0443\u0441\u0442\u044B,
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0432 \u0442\u0438\u0445\u043E\u0439
      \u043F\u0430\u043D\u0438\u043A\u0435. \u0414\u0432\u0430 \u0434\u043D\u044F
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u0443\u0442\u0440\u0435\u043D\u043D\u044F\u044F \u0437\u0432\u0435\u0437\u0434\u0430
      \u0432\u044B\u0432\u0435\u043B\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u043D\u0430 \u0442\u0440\u043E\u043F\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449280
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0439 \u043F\u0440\u043E\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449281
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0441\u043F\u0435\u0448\u0438\u043B\u0441\u044F,
      \u043F\u0440\u0438\u0441\u0435\u043B, \u043F\u043E\u0442\u0440\u043E\u0433\u0430\u043B
      \u0442\u0451\u043C\u043D\u044B\u0439 \u043F\u0435\u0441\u043E\u043A \u0438
      \u043F\u043E\u043D\u044E\u0445\u0430\u043B \u043F\u0430\u043B\u044C\u0446\u044B.
      \xAB\u041F\u043E\u0434\u0437\u0435\u043C\u043D\u044B\u0439 \u0440\u0443\u0447\u0435\u0439.
      \u042F \u0437\u043D\u0430\u044E \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E:
      \u0441\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F \u043A\u0430\u0436\u0434\u0443\u044E
      \u0432\u0435\u0441\u043D\u0443, \u043D\u043E \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0439
      \u043A\u0440\u0430\u0439 \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u0443\u0445\u043E\u0439.\xBB
      \u041E\u043D \u043F\u043E\u0432\u0451\u043B \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0432\u0434\u043E\u043B\u044C \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F
      \u043F\u0440\u0430\u0432\u043E\u0433\u043E \u0431\u0430\u0440\u0445\u0430\u043D\u0430,
      \u043F\u043E \u0443\u0437\u043A\u043E\u0439 \u043F\u043E\u043B\u043E\u0441\u0435
      \u0443\u0442\u0440\u0430\u043C\u0431\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
      \u043F\u0435\u0441\u043A\u0430, \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u043E\u0439
      \u0433\u043B\u0430\u0437\u0443, \u043D\u043E \u0442\u0432\u0451\u0440\u0434\u043E\u0439,
      \u043A\u0430\u043A \u043A\u0430\u043C\u0435\u043D\u044C. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u0448\u043B\u0438 \u0440\u043E\u0432\u043D\u043E, \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043D\u0435 \u0443\u0432\u044F\u0437\u043B\u0438 \u043D\u0438 \u0440\u0430\u0437\u0443.
      \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0432\u044B\u0448\u0435\u043B \u043D\u0430 \u0441\u0443\u0445\u0443\u044E
      \u0442\u0440\u043E\u043F\u0443 \u043F\u043E \u0434\u0440\u0443\u0433\u0443\u044E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u043D\u0438\u0437\u0438\u043D\u044B.
      \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0432\u044B\u0442\u0435\u0440
      \u0440\u0443\u043A\u0438 \u043E \u043F\u043E\u043B\u0443 \u0445\u0430\u043B\u0430\u0442\u0430
      \u0438 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B:
      \u0435\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0441\u0430\u043C\u0430 \u0437\u0430 \u0441\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449282
    m_Localized: "\u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0447\u0430\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449283
    m_Localized: "\u041D\u0430 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u043C \u0443\u0441\u0442\u0443\u043F\u0435
      \u0443 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430, \u043F\u043E\u0434
      \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u043C\u0438 \u043C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438
      \u0444\u043B\u0430\u0436\u043A\u0430\u043C\u0438, \u0440\u044F\u0434\u0430\u043C\u0438
      \u0432\u044B\u043B\u043E\u0436\u0435\u043D\u044B \u043A\u0438\u0440\u043F\u0438\u0447\u0438
      \u043F\u0440\u0435\u0441\u0441\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
      \u0447\u0430\u044F. \u041A\u043E\u0440\u0435\u043D\u0430\u0441\u0442\u044B\u0439
      \u0442\u0438\u0431\u0435\u0442\u0435\u0446 \u0432 \u0448\u0443\u0431\u0435
      \u0438\u0437 \u043E\u0432\u0447\u0438\u043D\u044B \u0441\u0438\u0434\u0438\u0442
      \u043D\u0430 \u043A\u043E\u0440\u0442\u043E\u0447\u043A\u0430\u0445 \u0443
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0433\u043E \u043E\u0433\u043D\u044F
      \u0438 \u043A\u0438\u043F\u044F\u0442\u0438\u0442 \u0432\u0430\u0440\u0435\u0432\u043E
      \u0432 \u043F\u043E\u0447\u0435\u0440\u043D\u0435\u0432\u0448\u0435\u043C \u043C\u0435\u0434\u043D\u043E\u043C
      \u043A\u043E\u0442\u0435\u043B\u043A\u0435: \u0447\u0430\u0439, \u043C\u0430\u0441\u043B\u043E,
      \u0449\u0435\u043F\u043E\u0442\u044C \u0441\u043E\u043B\u0438. \u0413\u043E\u0440\u044C\u043A\u043E\u0432\u0430\u0442\u044B\u0439
      \u0434\u044B\u043C\u043D\u044B\u0439 \u0437\u0430\u043F\u0430\u0445 \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u0434\u043E \u043E\u0431\u043E\u0437\u0430. \u0423\u0432\u0438\u0434\u0435\u0432
      \u0432\u0430\u0441, \u043E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0440\u0443\u043A\u0443 \u0438 \u043A\u0440\u0438\u0447\u0438\u0442 \u0433\u0443\u0441\u0442\u044B\u043C
      \u0433\u043E\u043B\u043E\u0441\u043E\u043C:\r\n\r\n<npc_speech lang=\"Tibetan\">\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E,
      \u0433\u043E\u0441\u0442\u044C! \u042D\u0442\u043E \u0447\u0451\u0440\u043D\u044B\u0439
      \u0447\u0430\u0439 - \u043B\u0443\u0447\u0448\u0438\u0439 \u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E\u0440\u043D\u044B\u0439
      \u0447\u0430\u0439 \u0422\u0438\u0431\u0435\u0442\u0430! \u0421 \u043C\u0430\u0441\u043B\u043E\u043C
      \u0438 \u0441\u043E\u043B\u044C\u044E - \u0432 \u0434\u043E\u0440\u043E\u0433\u0435
      \u0431\u0435\u0437 \u043D\u0435\u0433\u043E \u043D\u0438\u043A\u0430\u043A.
      \u041A\u0443\u043F\u0438\u0448\u044C?</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449284
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0447\u0430\u0439 \u0438
      \u043C\u0430\u0441\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449285
    m_Localized: "\u0412\u044B \u043E\u0442\u0441\u0447\u0438\u0442\u0430\u043B\u0438
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E, \u0442\u0438\u0431\u0435\u0442\u0435\u0446
      \u0432\u0437\u0432\u0435\u0441\u0438\u043B \u043C\u043E\u043D\u0435\u0442\u044B
      \u043D\u0430 \u043B\u0430\u0434\u043E\u043D\u0438, \u043A\u0438\u0432\u043D\u0443\u043B
      \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u043B \u0447\u0435\u0442\u044B\u0440\u0435
      \u043A\u0438\u0440\u043F\u0438\u0447\u0430 \u0447\u0430\u044F \u0438 \u0443\u0432\u0435\u0441\u0438\u0441\u0442\u044B\u0439
      \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u043C\u0435\u0448\u043E\u043A \u043C\u0430\u0441\u043B\u0430.
      \u0421\u0432\u0435\u0440\u0445\u0443 \u043F\u043E\u043B\u043E\u0436\u0438\u043B
      \u0449\u0435\u043F\u043E\u0442\u043A\u0443 \u0433\u043E\u0440\u043D\u043E\u0439
      \u043A\u0440\u0443\u043F\u043D\u043E\u0439 \u0441\u043E\u043B\u0438 \u0432
      \u043B\u043E\u0441\u043A\u0443\u0442\u0435 \u0442\u043A\u0430\u043D\u0438.
      \xAB\u041D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435 \u0431\u0435\u0437
      \u043C\u0430\u0441\u043B\u0430 - \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u0447\u0442\u043E \u0431\u0435\u0437 \u043D\u043E\u0433\xBB, - \u0441\u043A\u0430\u0437\u0430\u043B
      \u043E\u043D, \u0445\u043B\u043E\u043F\u043D\u0443\u0432 \u043F\u043E \u043C\u0435\u0448\u043A\u0443.
      \u0422\u0451\u043F\u043B\u044B\u0439 \u0441\u043E\u043B\u0451\u043D\u044B\u0439
      \u043C\u0430\u0441\u043B\u044F\u043D\u044B\u0439 \u0447\u0430\u0439 \u0440\u0430\u0437\u043B\u0438\u043B\u0438
      \u043F\u043E \u0447\u0430\u0448\u043A\u0430\u043C \u0432 \u0442\u043E\u0442
      \u0436\u0435 \u0432\u0435\u0447\u0435\u0440. \u0412\u043E\u0437\u043D\u0438\u0447\u0438\u0435
      \u0441\u043E\u0433\u0440\u0435\u043B\u0438\u0441\u044C \u0438 \u043F\u043E\u0432\u0435\u0441\u0435\u043B\u0435\u043B\u0438:
      \u0432 \u0433\u043E\u0440\u0430\u0445 \u044D\u0442\u043E\u0442 \u043D\u0430\u043F\u0438\u0442\u043E\u043A
      \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0436\u0435 \u0432\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449286
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0437\u0430 \u043B\u0443\u0447\u0448\u0443\u044E \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449287
    m_Localized: "\u0412\u044B \u043F\u0440\u0438\u0441\u0435\u043B\u0438 \u0440\u044F\u0434\u043E\u043C,
      \u0432\u0437\u044F\u043B\u0438 \u043A\u0438\u0440\u043F\u0438\u0447 \u0447\u0430\u044F,
      \u043F\u043E\u043D\u044E\u0445\u0430\u043B\u0438, \u043E\u0442\u043B\u043E\u043C\u0438\u043B\u0438
      \u0443\u0433\u043E\u043B\u043E\u043A: \u0442\u0451\u043C\u043D\u044B\u0439,
      \u043F\u043B\u043E\u0442\u043D\u044B\u0439, \u0441 \u0433\u043E\u0440\u044C\u043A\u043E\u0432\u0430\u0442\u044B\u043C
      \u0430\u0440\u043E\u043C\u0430\u0442\u043E\u043C. \xAB\u0425\u043E\u0440\u043E\u0448\u0438\u0439
      \u0447\u0430\u0439, \u043D\u043E \u0437\u0438\u043C\u043D\u0435\u0439 \u043F\u0440\u0435\u0441\u0441\u043E\u0432\u043A\u0438:
      \u0432\u0442\u043E\u0440\u0430\u044F \u043F\u0430\u0440\u0442\u0438\u044F,
      \u043D\u0435 \u043F\u0435\u0440\u0432\u0430\u044F. \u041F\u044F\u0442\u044C
      \u043C\u043E\u043D\u0435\u0442 \u0437\u0430 \u0432\u0441\u0451, \u0438 \u0434\u043E\u0431\u0440\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E \u043E \u0442\u0435\u0431\u0435 \u0432 \u041B\u0445\u0430\u0441\u0435\xBB.
      \u0422\u0438\u0431\u0435\u0442\u0435\u0446 \u0445\u043C\u044B\u043A\u043D\u0443\u043B,
      \u043F\u043E\u043A\u0440\u0443\u0442\u0438\u043B \u043C\u043E\u043D\u0435\u0442\u0443
      \u0432 \u043F\u0430\u043B\u044C\u0446\u0430\u0445, \u043F\u043E\u0442\u043E\u043C
      \u0437\u0430\u0441\u043C\u0435\u044F\u043B\u0441\u044F. \xAB\u0422\u043E\u0440\u0433\u0443\u0435\u0448\u044C\u0441\u044F
      \u043A\u0430\u043A \u0442\u0438\u0431\u0435\u0442\u0435\u0446! \u041F\u044F\u0442\u044C
      - \u0438\u0434\u0451\u0442. \u041C\u0430\u0441\u043B\u043E \u0442\u043E\u0436\u0435
      \u0431\u0435\u0440\u0438\xBB. \u0420\u0443\u043A\u043E\u043F\u043E\u0436\u0430\u0442\u0438\u0435
      \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435, \u0433\u0434\u0435 \u0432\u043E\u0437\u0434\u0443\u0445
      \u0440\u0435\u0436\u0435\u0442 \u0433\u043E\u0440\u043B\u043E, \u0441\u0442\u043E\u0438\u0442
      \u0434\u043E\u0440\u043E\u0436\u0435 \u0431\u0443\u043C\u0430\u0436\u043D\u043E\u0433\u043E
      \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449288
    m_Localized: "\u0412\u044B \u0443\u043A\u0430\u0437\u0430\u043B\u0438 \u043D\u0430
      \u0442\u0440\u0435\u0449\u0438\u043D\u044B \u0432 \u043A\u0438\u0440\u043F\u0438\u0447\u0430\u0445
      \u0438 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0438,
      \u0447\u0442\u043E \u0447\u0430\u0439 \u043E\u0442\u0441\u044B\u0440\u0435\u043B
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435. \u0422\u0438\u0431\u0435\u0442\u0435\u0446
      \u043C\u043E\u043B\u0447\u0430 \u0441\u043B\u043E\u043C\u0430\u043B \u043E\u0434\u0438\u043D,
      \u043F\u043E\u043A\u0430\u0437\u0430\u0432 \u0441\u0443\u0445\u043E\u0439 \u0442\u0451\u043C\u043D\u044B\u0439
      \u0438\u0437\u043B\u043E\u043C, \u043F\u043E\u043D\u044E\u0445\u0430\u043B
      \u0438 \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B \u0432\u0430\u043C:
      \u0437\u0430\u043F\u0430\u0445 \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u044B\u0439.
      \xAB\u0427\u0430\u0439 \u0441\u0443\u0445\u043E\u0439. \u0421\u044B\u0440\u043E\u0439
      \u0442\u043E\u0442 - \u043A\u0442\u043E \u0432 \u0447\u0430\u0435 \u043D\u0435
      \u0441\u043C\u044B\u0441\u043B\u0438\u0442\xBB. \u0414\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0439
      \u0442\u043E\u0440\u0433 \u0431\u044B\u043B \u0431\u0435\u0441\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u044B\u043C.
      \u0417\u0430\u043F\u043B\u0430\u0442\u0438\u043B\u0438 \u043F\u043E\u043B\u043D\u0443\u044E
      \u0446\u0435\u043D\u0443 \u0437\u0430 \u043C\u0435\u043D\u044C\u0448\u0443\u044E
      \u043F\u043E\u0440\u0446\u0438\u044E, \u0438 \u043C\u0430\u0441\u043B\u043E
      \u043E\u0431\u043E\u0448\u043B\u043E\u0441\u044C \u0434\u043E\u0440\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449289
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u0437\u043D\u0430\u0435\u0442 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439
      \u0440\u044B\u043D\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449290
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u043F\u043E\u0434\u043E\u0448\u0451\u043B \u043F\u0435\u0440\u0432\u044B\u043C,
      \u043A\u0438\u0432\u043D\u0443\u043B \u0442\u0438\u0431\u0435\u0442\u0446\u0443
      \u0438 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B \u043E \u0446\u0435\u043D\u0430\u0445
      \u043D\u0430 \u043C\u0430\u0441\u043B\u043E \u0432 \u041A\u0430\u0448\u0433\u0430\u0440\u0435,
      \u043E \u0434\u043E\u0440\u043E\u0433\u043E\u0432\u0438\u0437\u043D\u0435 \u0441\u043E\u043B\u0438
      \u043D\u0430 \u044E\u0436\u043D\u044B\u0445 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430\u0445,
      \u043E \u0442\u0430\u043D\u0433\u0443\u0442\u0441\u043A\u0438\u0445 \u043F\u0435\u0440\u0435\u043A\u0443\u043F\u0449\u0438\u043A\u0430\u0445,
      \u0447\u0442\u043E \u0441\u043A\u0443\u043F\u0430\u044E\u0442 \u0447\u0430\u0439
      \u0432\u0430\u0433\u043E\u043D\u0430\u043C\u0438 \u0438 \u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0434\u0430\u044E\u0442
      \u0432\u0442\u0440\u043E\u0435. \u0422\u0438\u0431\u0435\u0442\u0435\u0446
      \u0441\u043B\u0443\u0448\u0430\u043B, \u043F\u0440\u0438\u0449\u0443\u0440\u0438\u0432\u0448\u0438\u0441\u044C,
      \u043F\u043E\u0442\u043E\u043C \u0445\u043B\u043E\u043F\u043D\u0443\u043B \u043F\u043E
      \u043A\u043E\u043B\u0435\u043D\u0443. \xAB\u0422\u0432\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0437\u043D\u0430\u0435\u0442 \u0433\u043E\u0440\u044B! \u0427\u0435\u0442\u044B\u0440\u0435
      \u043C\u043E\u043D\u0435\u0442\u044B - \u0437\u0430\u0431\u0438\u0440\u0430\u0439
      \u0447\u0430\u0439, \u043C\u0430\u0441\u043B\u043E \u0438 \u0441\u043E\u043B\u044C.
      \u0418 \u043F\u0435\u0440\u0435\u0434\u0430\u0439 \u043C\u043D\u0435 \u0432\u0435\u0441\u0442\u043E\u0447\u043A\u0443
      \u0447\u0435\u0440\u0435\u0437 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u043E\u0432,
      \u043A\u043E\u0433\u0434\u0430 \u043F\u043E\u0439\u0434\u0451\u0448\u044C \u0432
      \u041B\u0445\u0430\u0441\u0443.\xBB \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0443\u0435\u0445\u0430\u043B \u0441 \u043F\u043E\u043B\u043D\u044B\u043C\u0438
      \u043C\u0435\u0448\u043A\u0430\u043C\u0438, \u0430 \u0432\u044B \u0443\u043B\u043E\u0432\u0438\u043B\u0438
      \u0438\u0437 \u0438\u0445 \u0431\u0435\u0441\u0435\u0434\u044B \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0445 \u0441\u043B\u043E\u0432,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u0442\u043E\u0438\u0442 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449291
    m_Localized: "\u0413\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A-\u043A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449292
    m_Localized: "\u041D\u0430 \u043E\u0431\u043E\u0447\u0438\u043D\u0435 \u0433\u043E\u0440\u043D\u043E\u0439
      \u0442\u0440\u043E\u043F\u044B, \u0443 \u0432\u0430\u043B\u0443\u043D\u0430
      \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C \u0441 \u043F\u043E\u0432\u043E\u0437\u043A\u0443,
      \u0441\u0438\u0434\u0438\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432
      \u0447\u0451\u0440\u043D\u043E\u0439 \u0448\u0435\u0440\u0441\u0442\u044F\u043D\u043E\u0439
      \u0440\u044F\u0441\u0435 \u0441 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u043C
      \u043A\u0440\u0435\u0441\u0442\u043E\u043C \u043D\u0430 \u0433\u0440\u0443\u0434\u0438.
      \u041D\u0430 \u043F\u043B\u043E\u0441\u043A\u043E\u043C \u043A\u0430\u043C\u043D\u0435
      \u043F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C \u043B\u0435\u0436\u0438\u0442
      \u043B\u0438\u0441\u0442 \u0436\u0435\u043B\u0442\u043E\u0432\u0430\u0442\u043E\u0439
      \u0431\u0443\u043C\u0430\u0433\u0438, \u043F\u0440\u0438\u0434\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
      \u0433\u0430\u043B\u044C\u043A\u043E\u0439. \u041E\u043D \u0447\u0435\u0440\u0442\u0438\u0442
      \u0442\u0440\u043E\u0441\u0442\u043D\u0438\u043A\u043E\u0432\u044B\u043C \u043F\u0435\u0440\u043E\u043C:
      \u043B\u0438\u043D\u0438\u0438 \u0433\u043E\u0440, \u0438\u0437\u0432\u0438\u0432\u044B
      \u0442\u0440\u043E\u043F, \u0437\u043D\u0430\u0447\u043A\u0438 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u043E\u0432.
      \u0420\u044F\u0434\u043E\u043C \u043A\u043E\u0436\u0430\u043D\u0430\u044F \u0441\u0443\u043C\u043A\u0430,
      \u043D\u0430\u0431\u0438\u0442\u0430\u044F \u0441\u0432\u0438\u0442\u043A\u0430\u043C\u0438.
      \u0417\u0430\u043C\u0435\u0442\u0438\u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u0433\u0440\u0435\u043A \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u0443, \u0449\u0443\u0440\u0438\u0442\u0441\u044F
      \u0431\u043B\u0438\u0437\u043E\u0440\u0443\u043A\u0438\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438
      \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043D\u0430
      \u043B\u043E\u043C\u0430\u043D\u043E\u043C \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C,
      \u043F\u043E\u0442\u043E\u043C \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u043D\u0430 \u0433\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u0439:\r\n\r\n<npc_speech
      lang=\"Greek\">\u0420\u0430\u0434\u0443\u0439\u0442\u0435\u0441\u044C, \u0447\u0443\u0436\u0435\u0441\u0442\u0440\u0430\u043D\u0446\u044B!
      \u042F - \u0424\u0435\u043E\u0434\u043E\u0440, \u043C\u043E\u043D\u0430\u0445
      \u0438 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A.
      \u041E\u043F\u0438\u0441\u044B\u0432\u0430\u044E \u0434\u043E\u0440\u043E\u0433\u0443
      \u043E\u0442 \u0422\u0440\u0430\u043F\u0435\u0437\u0443\u043D\u0434\u0430 \u0434\u043E
      \u0421\u0435\u0440\u0438\u043A\u0438. \u0417\u043D\u0430\u0435\u0442\u0435
      \u043B\u0438 \u0432\u044B \u0437\u0434\u0435\u0448\u043D\u0438\u0435 \u043F\u0443\u0442\u0438?
      \u041E\u0431\u043C\u0435\u043D\u044F\u0435\u043C\u0441\u044F - \u043C\u043E\u0438
      \u0437\u043D\u0430\u043D\u0438\u044F \u0437\u0430 \u0432\u0430\u0448\u0438!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449293
    m_Localized: "\u041F\u043E\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F\u043C\u0438
      \u043E \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449294
    m_Localized: "\u0412\u044B \u043F\u0440\u0438\u0441\u0435\u043B\u0438 \u0440\u044F\u0434\u043E\u043C
      \u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0438, \u0447\u0442\u043E
      \u043F\u043E\u043C\u043D\u0438\u043B\u0438: \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F
      \u043C\u0435\u0436\u0434\u0443 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430\u043C\u0438,
      \u0438\u043C\u0435\u043D\u0430 \u0434\u0435\u0440\u0435\u0432\u0435\u043D\u044C,
      \u0433\u0434\u0435 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438
      \u0432\u043E\u0434\u0443, \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0442\u0440\u043E\u043F, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u0431\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0443 \u0441\u043A\u0430\u043B. \u0413\u0440\u0435\u043A \u0441\u043B\u0443\u0448\u0430\u043B
      \u0436\u0430\u0434\u043D\u043E, \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u044F
      \u043A\u0430\u0436\u0434\u043E\u0435 \u0441\u043B\u043E\u0432\u043E, \u043F\u0435\u0440\u0435\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u044F
      \u0434\u0432\u0430\u0436\u0434\u044B. \u0412\u0437\u0430\u043C\u0435\u043D
      \u043E\u043D \u043F\u043E\u043A\u0430\u0437\u0430\u043B \u0441\u0432\u043E\u044E
      \u043A\u0430\u0440\u0442\u0443: \u0434\u043E\u0440\u043E\u0433\u0438 \u043E\u0442
      \u0422\u0440\u0430\u0431\u0437\u043E\u043D\u0430 \u0434\u043E \u041A\u0430\u0448\u0433\u0430\u0440\u0430,
      \u0441 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E, \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043F\u043E\u0437\u0430\u0432\u0438\u0434\u043E\u0432\u0430\u043B \u0431\u044B
      \u043B\u044E\u0431\u043E\u0439 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u043A\u0443\u043F\u0435\u0446. \u0412\u044B \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438
      \u043F\u0430\u0440\u0443 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0445 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u043E\u0432
      \u0438 \u043F\u043E\u0434\u0445\u0432\u0430\u0442\u0438\u043B\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0433\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u0445 \u0441\u043B\u043E\u0432
      \u0438\u0437 \u0435\u0433\u043E \u043F\u043E\u044F\u0441\u043D\u0435\u043D\u0438\u0439.
      \u041A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444 \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B
      \u0438 \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B \u043B\u0435\u043F\u0451\u0448\u043A\u0443
      \u0438\u0437 \u0441\u0432\u043E\u0438\u0445 \u0437\u0430\u043F\u0430\u0441\u043E\u0432:
      \u0447\u0451\u0440\u0441\u0442\u0432\u0443\u044E, \u043D\u043E \u0447\u0435\u0441\u0442\u043D\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449295
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C
      \u0435\u0433\u043E \u0437\u0430 \u043F\u043B\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449296
    m_Localized: "\xAB\u0422\u044B \u043E\u0434\u0438\u043D \u0432 \u0433\u043E\u0440\u0430\u0445
      - \u044D\u0442\u043E \u0431\u0435\u0437\u0443\u043C\u0438\u0435, \u043C\u043E\u043D\u0430\u0445.
      \u0418\u0434\u0438 \u0441 \u043D\u0430\u043C\u0438 \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430, \u043D\u0430\u0440\u0438\u0441\u0443\u0435\u0448\u044C
      \u0432\u0441\u0451, \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E, \u0430
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0448\u044C \u0437\u0430 \u043E\u0445\u0440\u0430\u043D\u0443
      \u0438 \u043F\u0438\u0449\u0443.\xBB \u0413\u0440\u0435\u043A \u0437\u0430\u0434\u0443\u043C\u0430\u043B\u0441\u044F,
      \u043F\u043E\u0442\u043E\u043C \u0434\u043E\u0441\u0442\u0430\u043B \u0438\u0437
      \u0441\u0443\u043C\u043A\u0438 \u0442\u0443\u0433\u043E\u0439 \u043A\u043E\u0448\u0435\u043B\u0451\u043A,
      \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E \u0443\u0432\u0435\u0441\u0438\u0441\u0442\u044B\u0439
      \u0434\u043B\u044F \u043C\u043E\u043D\u0430\u0445\u0430. \xAB\u0412\u0438\u0437\u0430\u043D\u0442\u0438\u0439\u0441\u043A\u0430\u044F
      \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u044F \u0449\u0435\u0434\u0440\u0430
      \u043A \u0442\u0435\u043C, \u043A\u0442\u043E \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u0435\u0442
      \u043A\u0430\u0440\u0442\u0443.\xBB \u0422\u0440\u0438 \u0434\u043D\u044F \u043E\u043D
      \u0448\u0451\u043B \u0441 \u043D\u0430\u043C\u0438, \u0440\u0438\u0441\u0443\u044F
      \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C \u043F\u0440\u0438\u0432\u0430\u043B\u0435.
      \u041D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435 \u0432\u0440\u0443\u0447\u0438\u043B
      \u0441\u0442\u043E\u043F\u043A\u0443 \u0447\u0438\u0441\u0442\u044B\u0445 \u043B\u0438\u0441\u0442\u043E\u0432
      \u043A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044C\u0441\u043A\u043E\u0439
      \u0431\u0443\u043C\u0430\u0433\u0438, \u0442\u043E\u043D\u043A\u043E\u0439
      \u0438 \u043F\u0440\u043E\u0447\u043D\u043E\u0439. \xAB\u0414\u043B\u044F \u043F\u0438\u0441\u0435\u043C
      \u0438\u043B\u0438 \u043A\u0430\u0440\u0442.\xBB \u0417\u0430 \u044D\u0442\u0438
      \u0434\u043D\u0438 \u0432\u044B \u0432\u044B\u0443\u0447\u0438\u043B\u0438
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E \u0433\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u0445
      \u0441\u043B\u043E\u0432, \u0447\u0442\u043E\u0431\u044B \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0422\u0440\u0430\u0431\u0437\u043E\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449297
    m_Localized: "\u0412\u044B \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B\u0438
      \u0433\u0440\u0435\u043A\u0430 \u0432\u0437\u044F\u0442\u044C \u0441 \u0441\u043E\u0431\u043E\u0439,
      \u043D\u043E \u0442\u043E\u0442 \u043D\u0430\u0441\u0442\u043E\u0440\u043E\u0436\u0438\u043B\u0441\u044F:
      \u043C\u043E\u043D\u0430\u0445 \u0432\u0438\u0434\u0435\u043B, \u043A\u0430\u043A
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u043F\u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u043B\u0438
      \u043D\u0430 \u0435\u0433\u043E \u0441\u0443\u043C\u043A\u0443 \u0441\u043E
      \u0441\u0432\u0438\u0442\u043A\u0430\u043C\u0438. \xAB\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E,
      \u043D\u043E \u043D\u0435\u0442. \u042F \u043F\u0440\u0438\u0432\u044B\u043A
      \u0445\u043E\u0434\u0438\u0442\u044C \u043E\u0434\u0438\u043D - \u0442\u0430\u043A
      \u043A\u0430\u0440\u0442\u0430 \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0447\u0435\u0441\u0442\u043D\u0435\u0435.\xBB
      \u041E\u043D \u0441\u043F\u0435\u0448\u043D\u043E \u0441\u043E\u0431\u0440\u0430\u043B
      \u0431\u0443\u043C\u0430\u0433\u0438 \u0438 \u0443\u0448\u0451\u043B \u043F\u043E
      \u0431\u043E\u043A\u043E\u0432\u043E\u0439 \u0442\u0440\u043E\u043F\u0435,
      \u043D\u0435 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C.
      \u0412\u0440\u0435\u043C\u044F \u0438 \u043B\u0435\u043F\u0451\u0448\u043A\u0430,
      \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u043D\u0430\u044F \u043D\u0430
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0430\u0445, \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B
      \u0432\u043F\u0443\u0441\u0442\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449298
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
      \u043E\u0431\u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F \u0437\u043D\u0430\u043D\u0438\u044F\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449299
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0441 \u0433\u0440\u0435\u043A\u043E\u043C \u043D\u0430 \u0435\u0433\u043E
      \u044F\u0437\u044B\u043A\u0435: <npc_speech lang=\"Greek\">\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E,
      \u043F\u0443\u0442\u043D\u0438\u043A. \u041C\u044B \u0432\u0438\u0434\u0435\u043B\u0438
      \u0442\u0432\u043E\u0438 \u043A\u0430\u0440\u0442\u044B - \u043E\u043D\u0438
      \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B. \u041D\u0435 \u043E\u0431\u043C\u0435\u043D\u044F\u0435\u043C\u0441\u044F
      \u043B\u0438 \u0437\u043D\u0430\u043D\u0438\u044F\u043C\u0438?</npc_speech>
      \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E,
      \u043F\u043E\u0442\u043E\u043C \u0431\u0435\u0433\u043B\u043E - \u043C\u043E\u043D\u0430\u0445
      \u0440\u0430\u0441\u0446\u0432\u0451\u043B, \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u043D\u0435 \u0441\u043B\u044B\u0448\u0430\u0432\u0448\u0438\u0439 \u0440\u043E\u0434\u043D\u043E\u0439
      \u0440\u0435\u0447\u0438 \u043C\u0435\u0441\u044F\u0446\u0430\u043C\u0438.
      \u041F\u043E\u043B\u0434\u043D\u044F \u043D\u0430\u0434 \u043A\u0430\u0440\u0442\u0430\u043C\u0438:
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0434\u0438\u043A\u0442\u043E\u0432\u0430\u043B
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u044B, \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F,
      \u043E\u043F\u0430\u0441\u043D\u044B\u0435 \u0443\u0447\u0430\u0441\u0442\u043A\u0438,
      \u0424\u0435\u043E\u0434\u043E\u0440 \u043D\u0430\u043D\u043E\u0441\u0438\u043B
      \u0441 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u0430.
      \u0412\u0437\u0430\u043C\u0435\u043D \u0433\u0440\u0435\u043A \u043E\u0442\u0434\u0430\u043B
      \u043A\u043E\u043F\u0438\u044E \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430
      \u043E\u0442 \u0422\u0440\u0430\u0431\u0437\u043E\u043D\u0430 \u0434\u043E
      \u0411\u0430\u043B\u0445\u0430 \u0441 \u043F\u043E\u043C\u0435\u0442\u043A\u0430\u043C\u0438
      \u043E \u0440\u043E\u0434\u043D\u0438\u043A\u0430\u0445, \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u0445
      \u0438 \u0437\u0430\u0441\u0430\u0434\u0430\u0445. \xAB\u0421\u043A\u0430\u0436\u0438
      \u0445\u043E\u0437\u044F\u0438\u043D\u0443: \u044D\u0442\u0430 \u043A\u0430\u0440\u0442\u0430
      \u0441\u0442\u043E\u0438\u0442 \u0431\u043E\u043B\u044C\u0448\u0435 \u043C\u0435\u0448\u043A\u0430
      \u0441\u0435\u0440\u0435\u0431\u0440\u0430.\xBB \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u043A\u0438\u0432\u043D\u0443\u043B. \u041C\u043E\u043D\u0430\u0445 \u0434\u043E\u0431\u0430\u0432\u0438\u043B
      \u043B\u0438\u0441\u0442\u044B \u0447\u0438\u0441\u0442\u043E\u0439 \u0431\u0443\u043C\u0430\u0433\u0438,
      \u043B\u0443\u0447\u0448\u0435\u0439 \u043A \u0432\u043E\u0441\u0442\u043E\u043A\u0443
      \u043E\u0442 \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044F.
      \u0417\u043D\u0430\u043D\u0438\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043D\u0435 \u043A\u0443\u043F\u0438\u0448\u044C \u043D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449300
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449301
    m_Localized: "\u0423 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438 \u0433\u043E\u0440\u043D\u044B\u0445
      \u0442\u0440\u043E\u043F (\u043E\u0434\u043D\u0430 \u0443\u0445\u043E\u0434\u0438\u0442
      \u0432\u0432\u0435\u0440\u0445, \u0432 \u043E\u0431\u043B\u0430\u043A\u0430,
      \u0434\u0440\u0443\u0433\u0430\u044F \u043E\u0433\u0438\u0431\u0430\u0435\u0442
      \u0445\u0440\u0435\u0431\u0435\u0442 \u043F\u043E \u0443\u0437\u043A\u043E\u043C\u0443
      \u043A\u0430\u0440\u043D\u0438\u0437\u0443) \u0441\u0438\u0434\u0438\u0442
      \u043D\u0430 \u0432\u0430\u043B\u0443\u043D\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0432 \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u043E\u0439 \u043E\u0432\u0447\u0438\u043D\u043D\u043E\u0439
      \u0447\u0443\u0431\u0435. \u041D\u0430 \u043F\u043E\u044F\u0441\u0435 \u043D\u043E\u0436
      \u0438 \u043C\u043E\u0442\u043E\u043A \u043F\u0435\u043D\u044C\u043A\u043E\u0432\u043E\u0439
      \u0432\u0435\u0440\u0451\u0432\u043A\u0438. \u0420\u044F\u0434\u043E\u043C
      \u0441\u0442\u043E\u0438\u0442 \u044F\u043A \u0441 \u043F\u0443\u0441\u0442\u043E\u0439
      \u0432\u044C\u044E\u0447\u043D\u043E\u0439 \u0440\u0430\u043C\u043E\u0439:
      \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0431\u0435\u0437 \u043A\u043B\u0438\u0435\u043D\u0442\u0430.
      \u041B\u0438\u0446\u043E \u0442\u0451\u043C\u043D\u043E\u0435, \u043E\u0431\u0432\u0435\u0442\u0440\u0435\u043D\u043D\u043E\u0435,
      \u0440\u0443\u043A\u0438 \u043A\u0430\u043A \u043A\u043E\u0440\u043D\u0438
      \u0433\u043E\u0440\u043D\u043E\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u0430.
      \u041E\u043D \u0436\u0443\u0451\u0442 \u0441\u0442\u0435\u0431\u0435\u043B\u044C
      \u0441\u0443\u0445\u043E\u0439 \u0442\u0440\u0430\u0432\u044B \u0438 \u0438\u0437\u0443\u0447\u0430\u0435\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0441 \u043B\u0435\u043D\u0438\u0432\u044B\u043C
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u043C \u0431\u044B\u0432\u0430\u043B\u043E\u0433\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.\r\n\r\n<npc_speech lang=\"Tibetan\">\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E.
      \u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442 \u0414\u043E\u0440\u0436\u0435.
      \u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442 \u0445\u043E\u0436\u0443
      \u0447\u0435\u0440\u0435\u0437 \u044D\u0442\u043E\u0442 \u043F\u0435\u0440\u0435\u0432\u0430\u043B.
      \u041F\u043E\u0433\u043E\u0434\u0430 \u043F\u043E\u0440\u0442\u0438\u0442\u0441\u044F
      - \u0432\u0430\u043C \u043D\u0443\u0436\u0435\u043D \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A.
      \u0426\u0435\u043D\u0430 \u0440\u0430\u0437\u0443\u043C\u043D\u0430\u044F.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449302
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C: \u0438\u0434\u0442\u0438
      \u0441\u0432\u043E\u0438\u043C \u043F\u0443\u0442\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449303
    m_Localized: "\u0412\u044B \u043F\u043E\u043A\u0430\u0447\u0430\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u043E\u0439:
      \u043B\u0438\u0448\u043D\u0438\u0445 \u043C\u043E\u043D\u0435\u0442 \u043D\u0435\u0442,
      \u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043D\u0435 \u043F\u0435\u0440\u0432\u044B\u0439
      \u0433\u043E\u0434 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u043A\u0438\u0432\u043D\u0443\u043B \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B,
      \u0441\u0435\u043B \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u043D\u0430
      \u0432\u0430\u043B\u0443\u043D \u0438 \u043F\u043E\u0442\u044F\u043D\u0443\u043B
      \u0441\u0442\u0435\u0431\u0435\u043B\u044C \u0442\u0440\u0430\u0432\u044B.
      <npc_speech lang=\"Turkic\">\u041F\u0443\u0441\u0442\u044C \u0422\u0435\u043D\u0433\u0440\u0438
      \u0445\u0440\u0430\u043D\u0438\u0442 \u0442\u0432\u043E\u0439 \u043F\u0443\u0442\u044C</npc_speech>,
      \u043F\u0440\u043E\u0431\u043E\u0440\u043C\u043E\u0442\u0430\u043B \u043E\u043D
      \u0432\u0441\u043B\u0435\u0434 \u043D\u0430 \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u043C,
      \u0441\u043B\u044B\u0448\u0430\u043D\u043D\u043E\u043C \u0433\u0434\u0435-\u0442\u043E
      \u043D\u0430 \u0431\u0430\u0437\u0430\u0440\u0430\u0445. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B\u0438 \u0435\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C.
      \u041A\u0440\u0435\u043F\u043A\u0438\u0439 \u043C\u0443\u0436\u0438\u043A,
      \u0437\u043D\u0430\u0435\u0442 \u0433\u043E\u0440\u044B. \u0416\u0430\u043B\u044C,
      \u0447\u0442\u043E \u043A\u043E\u0448\u0435\u043B\u0451\u043A \u043F\u0443\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449304
    m_Localized: "\u0421\u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0437\u0430 \u0443\u0441\u043B\u0443\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449305
    m_Localized: "\u0412\u044B \u043E\u0433\u043B\u044F\u0434\u0435\u043B\u0438 \u0435\u0433\u043E
      \u0441 \u043D\u043E\u0433 \u0434\u043E \u0433\u043E\u043B\u043E\u0432\u044B:
      \u0432\u0435\u0440\u0451\u0432\u043A\u0438 \u043A\u0440\u0435\u043F\u043A\u0438\u0435,
      \u043D\u043E\u0436 \u043D\u0430\u0442\u043E\u0447\u0435\u043D, \u044F\u043A
      \u0443\u0445\u043E\u0436\u0435\u043D, \u043D\u0430 \u0440\u0443\u043A\u0430\u0445
      \u0441\u0442\u0430\u0440\u044B\u0435 \u043C\u043E\u0437\u043E\u043B\u0438 \u043E\u0442
      \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u0445 \u0437\u0430\u0445\u0432\u0430\u0442\u043E\u0432.
      \u0427\u0435\u043B\u043E\u0432\u0435\u043A \u0434\u0435\u043B\u0430, \u043D\u0435
      \u043F\u043E\u043F\u0440\u043E\u0448\u0430\u0439\u043A\u0430. \xAB\u0412\u043E\u0441\u0435\u043C\u044C
      \u043C\u043E\u043D\u0435\u0442 \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430. \u0415\u0434\u0430 \u043D\u0430\u0448\u0430,
      \u043D\u043E\u0447\u0443\u0435\u0448\u044C \u0441 \u043D\u0430\u043C\u0438.
      \u0417\u0430\u0432\u0435\u0434\u0451\u0448\u044C \u043D\u0435 \u0442\u0443\u0434\u0430:
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E \u0432\u0435\u0440\u043D\u0451\u0448\u044C.\xBB
      \u0414\u043E\u0440\u0436\u0435 \u0445\u043C\u044B\u043A\u043D\u0443\u043B,
      \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B \u0436\u0451\u0441\u0442\u043A\u0443\u044E
      \u043B\u0430\u0434\u043E\u043D\u044C. \xAB\u0414\u043E\u0440\u0436\u0435 \u043D\u0435
      \u0432\u043E\u0434\u0438\u0442 \u043D\u0435 \u0442\u0443\u0434\u0430. \u0412\u043E\u0441\u0435\u043C\u044C
      - \u0447\u0435\u0441\u0442\u043D\u043E.\xBB \u041E\u043D \u0441\u0432\u0438\u0441\u0442\u043D\u0443\u043B
      \u044F\u043A\u0430, \u0437\u0430\u043A\u0438\u043D\u0443\u043B \u0432\u0435\u0440\u0451\u0432\u043A\u0443
      \u043D\u0430 \u043F\u043B\u0435\u0447\u043E \u0438 \u0432\u0441\u0442\u0430\u043B
      \u0432\u043E \u0433\u043B\u0430\u0432\u0435 \u043A\u043E\u043B\u043E\u043D\u043D\u044B,
      \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0432\u0451\u043B \u044D\u0442\u043E\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0441 \u0441\u0430\u043C\u043E\u0433\u043E
      \u041A\u0430\u0448\u0433\u0430\u0440\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u043E\u0432\u0435\u0441\u0435\u043B\u0435\u043B\u0438: \u0441 \u0442\u0430\u043A\u0438\u043C
      \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u043C \u043F\u0435\u0440\u0435\u0432\u0430\u043B
      \u0443\u0436\u0435 \u043D\u0435 \u0441\u0442\u0440\u0430\u0448\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449306
    m_Localized: "\u0412\u044B \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
      \u0441\u0431\u0438\u0442\u044C \u0446\u0435\u043D\u0443, \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0432
      \u043F\u044F\u0442\u044C, \u043D\u043E \u0414\u043E\u0440\u0436\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u043A\u0430\u0447\u0430\u043B \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \xAB\u041F\u044F\u0442\u044C - \u0446\u0435\u043D\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u0442
      \u0442\u0435\u0431\u044F \u0432 \u0442\u0443\u043C\u0430\u043D\u0435, \u0445\u043E\u0437\u044F\u0438\u043D.
      \u042F - \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C. \u0414\u0435\u0448\u0451\u0432\u044B\u0445
      \u0433\u043E\u0440 \u043D\u0435 \u0431\u044B\u0432\u0430\u0435\u0442.\xBB \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043F\u043E \u0435\u0433\u043E
      \u0441\u0442\u0430\u0432\u043A\u0435: \u043F\u043E\u0447\u0442\u0438 \u0432\u0434\u0432\u043E\u0435
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u043B\u0438.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0441\u043A\u0440\u0438\u0432\u0438\u043B\u0438\u0441\u044C,
      \u043D\u043E \u0414\u043E\u0440\u0436\u0435 \u0443\u0436\u0435 \u0437\u0430\u043D\u044F\u043B
      \u043C\u0435\u0441\u0442\u043E \u0432\u043F\u0435\u0440\u0435\u0434\u0438,
      \u0438 \u0441\u043F\u043E\u0440\u0438\u0442\u044C \u0431\u044B\u043B\u043E
      \u043F\u043E\u0437\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449307
    m_Localized: "\u0412\u0430\u0448 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0437\u043D\u0430\u0435\u0442 \u044D\u0442\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449308
    m_Localized: "\u0412\u0430\u0448 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0432\u0434\u0440\u0443\u0433 \u043E\u0441\u0430\u0434\u0438\u043B \u044F\u043A\u0430
      \u0438 \u043A\u0440\u0438\u043A\u043D\u0443\u043B \u0447\u0442\u043E-\u0442\u043E
      \u043F\u043E-\u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438: \u0440\u0435\u0437\u043A\u043E,
      \u0441 \u0438\u043D\u0442\u043E\u043D\u0430\u0446\u0438\u0435\u0439 \u0443\u0437\u043D\u0430\u0432\u0430\u043D\u0438\u044F.
      \u0414\u043E\u0440\u0436\u0435 \u0432\u0441\u043A\u043E\u0447\u0438\u043B \u0441
      \u0432\u0430\u043B\u0443\u043D\u0430, \u043F\u0440\u0438\u0449\u0443\u0440\u0438\u043B\u0441\u044F
      \u0438 \u0440\u0430\u0441\u0445\u043E\u0445\u043E\u0442\u0430\u043B\u0441\u044F,
      \u0445\u043B\u043E\u043F\u0430\u044F \u0441\u0435\u0431\u044F \u043F\u043E
      \u0431\u0451\u0434\u0440\u0430\u043C. <npc_speech lang=\"Tibetan\">\u041F\u0435\u043C\u0431\u0430!
      \u0421\u0442\u0430\u0440\u044B\u0439 \u043A\u043E\u0437\u0451\u043B, \u0442\u044B
      \u0436\u0438\u0432!</npc_speech> \u041E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
      \u043E\u043D\u0438 \u0432\u043C\u0435\u0441\u0442\u0435 \u0432\u043E\u0434\u0438\u043B\u0438
      \u0447\u0435\u0440\u0435\u0437 \u041A\u0430\u0440\u0430\u043A\u043E\u0440\u0443\u043C
      \u0447\u0435\u0442\u044B\u0440\u0435 \u0441\u0435\u0437\u043E\u043D\u0430 \u043D\u0430\u0437\u0430\u0434,
      \u0434\u0435\u043B\u0438\u043B\u0438 \u0432\u0435\u0440\u0451\u0432\u043A\u0443
      \u043D\u0430 \u043B\u0435\u0434\u043E\u0432\u043E\u043C \u0441\u043A\u043B\u043E\u043D\u0435
      \u0438 \u043E\u0434\u043D\u0430\u0436\u0434\u044B \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438
      \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430 \u0438\u0437 \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u044B.
      \u041F\u0435\u043C\u0431\u0430 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u043A \u0432\u0430\u043C: \xAB\u0414\u043E\u0440\u0436\u0435 - \u043B\u0443\u0447\u0448\u0438\u0439
      \u043D\u0430 \u044D\u0442\u043E\u043C \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435.
      \u0427\u0435\u0442\u044B\u0440\u0435 \u043C\u043E\u043D\u0435\u0442\u044B -
      \u0446\u0435\u043D\u0430 \u0434\u0440\u0443\u0436\u0431\u044B. \u0418 \u0435\u0433\u043E
      \u044F\u043A \u043F\u043E\u0439\u0434\u0451\u0442 \u0432 \u043D\u0430\u0448
      \u0442\u0430\u0431\u0443\u043D.\xBB \u0414\u0432\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430:
      \u0434\u0432\u043E\u0439\u043D\u0430\u044F \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u0438 \u0437\u043D\u0430\u043D\u0438\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u043A\u0430\u043C\u043D\u044F \u043D\u0430 \u0434\u0432\u0435\u0441\u0442\u0438
      \u043B\u0438 \u0432\u043E\u043A\u0440\u0443\u0433. \u0418\u0437 \u0438\u0445
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430 \u0432\u044B \u0432\u044B\u0443\u0447\u0438\u043B\u0438
      \u043F\u0430\u0440\u0443 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0445
      \u0441\u043B\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u0442\u043E\u0438\u0442
      \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C: \xAB\u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0430\xBB,
      \xAB\u043B\u0451\u0434\xBB, \xAB\u0432\u0435\u0440\u0451\u0432\u043A\u0443
      \u0434\u0435\u0440\u0436\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449309
    m_Localized: "\u041A\u0430\u043C\u043D\u0435\u043F\u0430\u0434 \u043D\u0430 \u0433\u043E\u0440\u043D\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449310
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u043E\u0433\u0438\u0431\u0430\u0435\u0442
      \u0441\u043A\u043B\u043E\u043D \u043F\u043E \u0443\u0437\u043A\u043E\u043C\u0443
      \u043A\u0430\u0440\u043D\u0438\u0437\u0443: \u0441\u043F\u0440\u0430\u0432\u0430
      \u0441\u0442\u0435\u043D\u0430 \u0438\u0437 \u0442\u0451\u043C\u043D\u043E\u0433\u043E
      \u0441\u043B\u043E\u0438\u0441\u0442\u043E\u0433\u043E \u043A\u0430\u043C\u043D\u044F,
      \u0441\u043B\u0435\u0432\u0430 \u043E\u0431\u0440\u044B\u0432 \u0432 \u0443\u0449\u0435\u043B\u044C\u0435,
      \u043D\u0430 \u0434\u043D\u0435 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u0431\u0435\u043B\u0435\u0435\u0442 \u043D\u0438\u0442\u043A\u0430 \u0440\u0435\u043A\u0438.
      \u0421\u0432\u0435\u0440\u0445\u0443 \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u0433\u0443\u043B, \u043F\u043E\u0445\u043E\u0436\u0438\u0439 \u043D\u0430
      \u0434\u0430\u043B\u0451\u043A\u0438\u0439 \u0433\u0440\u043E\u043C, \u043D\u043E
      \u043D\u0435\u0431\u043E \u0447\u0438\u0441\u0442\u043E\u0435. \u041C\u0435\u043B\u043A\u0438\u0435
      \u043A\u0430\u043C\u0435\u0448\u043A\u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
      \u0441\u043A\u0430\u0442\u044B\u0432\u0430\u0442\u044C\u0441\u044F \u043F\u043E
      \u0441\u0442\u0435\u043D\u0435, \u0441\u0442\u0443\u0447\u0430 \u043F\u043E
      \u043A\u043E\u0437\u044B\u0440\u044C\u043A\u0430\u043C \u043F\u043E\u0432\u043E\u0437\u043E\u043A.
      \u0413\u043E\u043B\u043E\u0432\u043D\u043E\u0439 \u044F\u043A \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
      \u0438 \u0437\u0430\u043C\u043E\u0442\u0430\u043B \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0437\u0430\u0434\u0440\u0430\u043B\u0438
      \u0433\u043E\u043B\u043E\u0432\u044B: \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443
      \u043F\u043E\u043B\u0437\u0451\u0442 \u0442\u0440\u0435\u0449\u0438\u043D\u0430,
      \u043F\u043B\u0430\u0441\u0442 \u043F\u043E\u0440\u043E\u0434\u044B \u0441\u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F,
      \u0438 \u0432\u043E\u043F\u0440\u043E\u0441 \u043D\u0435 \u0432 \u0442\u043E\u043C,
      \u0440\u0443\u0445\u043D\u0435\u0442 \u043B\u0438 \u043E\u043D, \u0430 \u043A\u043E\u0433\u0434\u0430.
      \u0420\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043D\u0435\u043A\u0443\u0434\u0430,
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u0437\u043D\u0430\u0447\u0438\u0442
      \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C \u043F\u043E\u043B\u0434\u043D\u044F,
      \u0430 \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F - \u0440\u0438\u0441\u043A
      \u0431\u044B\u0442\u044C \u043F\u043E\u0433\u0440\u0435\u0431\u0451\u043D\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449311
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u0447\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430 \u0438 \u0431\u0435\u0436\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449312
    m_Localized: "\xAB\u0411\u0440\u043E\u0441\u0430\u0439 \u0442\u044E\u043A\u0438,
      \u0431\u0435\u0433\u043E\u043C!\xBB \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u044E\u0442 \u043C\u0435\u0448\u043A\u0438
      \u0438 \u0441\u0432\u0451\u0440\u0442\u043A\u0438 \u0441 \u043F\u043E\u0432\u043E\u0437\u043E\u043A,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0431\u043B\u0435\u0433\u0447\u0438\u0442\u044C
      \u0445\u043E\u0434, \u0438 \u0433\u043E\u043D\u044F\u0442 \u044F\u043A\u043E\u0432
      \u0445\u043B\u044B\u0441\u0442\u0430\u043C\u0438 \u043F\u043E \u043A\u0430\u0440\u043D\u0438\u0437\u0443.
      \u041F\u0435\u0440\u0432\u044B\u0435 \u043A\u0430\u043C\u043D\u0438 \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C
      \u0441 \u043A\u0443\u043B\u0430\u043A \u0443\u0436\u0435 \u0431\u044C\u044E\u0442
      \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435, \u0432\u044B\u0441\u0435\u043A\u0430\u044F
      \u0438\u0441\u043A\u0440\u044B \u0438\u0437 \u0441\u043A\u0430\u043B\u044B.
      \u0417\u0430\u0434\u043D\u044F\u044F \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430 \u043C\u0435\u0448\u043E\u043A:
      \u043E\u043D \u043F\u043E\u043B\u0435\u0442\u0435\u043B \u0432 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C,
      \u043A\u0443\u0432\u044B\u0440\u043A\u0430\u044F\u0441\u044C, \u0438 \u0440\u0430\u0437\u0431\u0438\u043B\u0441\u044F
      \u0434\u0430\u043B\u0435\u043A\u043E \u0432\u043D\u0438\u0437\u0443. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u0440\u043E\u0441\u043A\u043E\u0447\u0438\u043B \u043E\u043F\u0430\u0441\u043D\u044B\u0439
      \u0443\u0447\u0430\u0441\u0442\u043E\u043A \u0437\u0430 \u043C\u0438\u043D\u0443\u0442\u0443
      \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u043F\u043B\u0430\u0441\u0442
      \u0440\u0443\u0445\u043D\u0443\u043B. \u0413\u0440\u043E\u0445\u043E\u0442
      \u0441\u0442\u043E\u044F\u043B \u0442\u0430\u043A\u043E\u0439, \u0447\u0442\u043E
      \u044F\u043A\u0438 \u043F\u0440\u0438\u0441\u0435\u043B\u0438 \u043D\u0430
      \u0437\u0430\u0434\u043D\u0438\u0435 \u043D\u043E\u0433\u0438. \u041F\u043E\u0437\u0430\u0434\u0438
      \u043E\u0441\u0435\u043B\u043E \u043E\u0431\u043B\u0430\u043A\u043E \u043F\u044B\u043B\u0438
      \u043D\u0430\u0434 \u0437\u0430\u0432\u0430\u043B\u043E\u043C, \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0434\u0438\u0432\u0448\u0438\u043C
      \u0442\u0440\u043E\u043F\u0443. \u0412\u0441\u0435 \u0436\u0438\u0432\u044B,
      \u043D\u043E \u0447\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u043F\u043E\u0434 \u043A\u0430\u043C\u043D\u044F\u043C\u0438
      \u0438\u043B\u0438 \u043D\u0430 \u0434\u043D\u0435 \u0443\u0449\u0435\u043B\u044C\u044F.
      \u041B\u044E\u0434\u0438 \u043C\u043E\u043B\u0447\u0430\u0442. \u0420\u0443\u043A\u0438
      \u0442\u0440\u044F\u0441\u0443\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449313
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449314
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u043D\u044F\u043B\u0438 \u0440\u0443\u043A\u0443:
      \u0442\u0438\u0448\u0438\u043D\u0430. \u041E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
      \u0441\u043A\u043B\u043E\u043D - \u0442\u0440\u0435\u0449\u0438\u043D\u0430
      \u043F\u043E\u043B\u0437\u0451\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E,
      \u043F\u043B\u0430\u0441\u0442 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043D\u0430 \u0432\u044B\u0441\u0442\u0443\u043F\u0435 \u0432 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438
      \u0441\u0430\u0436\u0435\u043D\u044F\u0445 \u0432\u044B\u0448\u0435. \u041D\u0443\u0436\u043D\u043E
      \u043F\u0440\u043E\u0439\u0442\u0438 \u0442\u0438\u0445\u043E: \u0431\u0435\u0437
      \u043A\u0440\u0438\u043A\u0430, \u0431\u0435\u0437 \u0445\u043B\u044B\u0441\u0442\u0430,
      \u043F\u043E \u043E\u0434\u043D\u043E\u0439 \u043F\u043E\u0432\u043E\u0437\u043A\u0435.
      \xAB\u042F\u043A\u043E\u0432 \u043F\u043E\u0434 \u0443\u0437\u0434\u0446\u044B,
      \u043A\u043E\u043B\u0451\u0441\u0430 \u0432\u0440\u0443\u0447\u043D\u0443\u044E,
      \u043D\u0438 \u0437\u0432\u0443\u043A\u0430.\xBB \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F \u0448\u0430\u0433\u043E\u043C,
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u0437\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u043E\u0439,
      \u0432\u043E\u0434\u0447\u0438\u0439 \u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u043A\u043E\u043B\u0435\u0441\u0430. \u041A\u0430\u043C\u0435\u0448\u043A\u0438
      \u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C, \u043F\u044B\u043B\u044C
      \u0449\u0438\u043F\u0430\u043B\u0430 \u0433\u043B\u0430\u0437\u0430, \u043D\u043E
      \u043F\u043B\u0430\u0441\u0442 \u0434\u0435\u0440\u0436\u0430\u043B\u0441\u044F.
      \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0432\u044B\u0435\u0445\u0430\u043B\u0430 \u0438\u0437-\u043F\u043E\u0434
      \u043A\u043E\u0437\u044B\u0440\u044C\u043A\u0430, \u043A\u043E\u0433\u0434\u0430
      \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 \u0441 \u0445\u0440\u0443\u0441\u0442\u043E\u043C
      \u043E\u0442\u0432\u0430\u043B\u0438\u043B\u0441\u044F \u043A\u0443\u0441\u043E\u043A
      \u0441\u043A\u0430\u043B\u044B \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C
      \u0441 \u0441\u0443\u043D\u0434\u0443\u043A \u0438 \u0437\u0430\u0433\u0440\u0435\u043C\u0435\u043B
      \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443. \u0412\u0441\u0435 \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u0438 \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B\u0438. \u041C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E
      \u0441\u0442\u043E\u0438\u043B\u043E \u043D\u0435\u0440\u0432\u043E\u0432,
      \u043D\u043E \u043D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0442\u044E\u043A\u0430
      \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449315
    m_Localized: "\u0412\u044B \u043F\u043E\u0432\u0435\u043B\u0438 \u0448\u0430\u0433\u043E\u043C,
      \u043D\u043E \u0442\u0440\u0435\u0442\u044C\u044F \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0437\u0430\u0446\u0435\u043F\u0438\u043B\u0430 \u043A\u043E\u043B\u0435\u0441\u043E\u043C
      \u0432\u044B\u0441\u0442\u0443\u043F: \u0441\u043A\u0440\u0435\u0436\u0435\u0442
      \u043E\u0442\u0434\u0430\u043B\u0441\u044F \u043F\u043E \u0432\u0441\u0435\u043C\u0443
      \u0441\u043A\u043B\u043E\u043D\u0443, \u043A\u0430\u043A \u0443\u0434\u0430\u0440
      \u043C\u043E\u043B\u043E\u0442\u0430. \u0427\u0435\u0440\u0435\u0437 \u0441\u0435\u043A\u0443\u043D\u0434\u0443
      \u0441\u0432\u0435\u0440\u0445\u0443 \u043F\u043E\u0448\u043B\u043E: \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u0449\u0435\u0431\u0435\u043D\u044C, \u043F\u043E\u0442\u043E\u043C \u0432\u0430\u043B\u0443\u043D\u044B.
      \u041F\u043B\u0430\u0441\u0442 \u0441\u044A\u0435\u0445\u0430\u043B \u0441\u043E
      \u0441\u043A\u043B\u043E\u043D\u0430, \u0443\u0434\u0430\u0440\u0438\u0432
      \u043F\u043E \u0437\u0430\u0434\u043D\u0435\u0439 \u0447\u0430\u0441\u0442\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430. \u041E\u0434\u043D\u0430
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u0441\u043C\u044F\u0442\u0430,
      \u0434\u0440\u0443\u0433\u0430\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430
      \u0431\u043E\u0440\u0442 \u0438 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u0433\u0440\u0443\u0437\u0430. \u042F\u043A \u0441 \u0432\u044C\u044E\u043A\u043E\u043C
      \u0440\u0443\u0445\u043D\u0443\u043B \u043D\u0430\u0431\u043E\u043A, \u043F\u0440\u0438\u0434\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
      \u043A\u0430\u043C\u043D\u0435\u043C. \u041A\u043E\u0433\u0434\u0430 \u043E\u0441\u0435\u043B\u043E:
      \u0442\u0440\u043E\u0435 \u0443\u0448\u0438\u0431\u043B\u0435\u043D\u043D\u044B\u0445,
      \u0434\u0432\u0435 \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u044B,
      \u0442\u0440\u043E\u043F\u0430 \u0437\u0430\u0432\u0430\u043B\u0435\u043D\u0430
      \u043D\u0430 \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u0448\u0430\u0433\u043E\u0432
      \u043F\u043E\u0437\u0430\u0434\u0438. \u0422\u043E\u043B\u044C\u043A\u043E
      \u0432\u043F\u0435\u0440\u0451\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449316
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0443\u0435\u0442
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0439 \u043F\u0440\u043E\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449317
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0441\u043F\u0435\u0448\u0438\u043B\u0441\u044F,
      \u043E\u0433\u043B\u044F\u0434\u0435\u043B \u0441\u043A\u043B\u043E\u043D,
      \u043F\u0440\u0438\u0449\u0443\u0440\u0438\u043B\u0441\u044F \u043D\u0430 \u0442\u0440\u0435\u0449\u0438\u043D\u0443
      \u0438 \u043A\u0438\u0432\u043D\u0443\u043B \u0441\u0430\u043C \u0441\u0435\u0431\u0435.
      \xAB\u042F \u0442\u0430\u043A\u043E\u0435 \u0432\u0438\u0434\u0435\u043B \u043F\u043E\u0434
      \u0413\u0438\u043D\u0434\u0443\u043A\u0443\u0448\u0435\u043C. \u041D\u0443\u0436\u043D\u043E
      \u0432\u044B\u0431\u0438\u0442\u044C \u043E\u043F\u043E\u0440\u0443 \u0440\u0430\u043D\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043F\u043B\u0430\u0441\u0442 \u0441\u043E\u0439\u0434\u0451\u0442
      \u0441\u0430\u043C, \u043F\u0443\u0441\u0442\u044C \u043F\u0430\u0434\u0430\u0435\u0442,
      \u043F\u043E\u043A\u0430 \u043C\u044B \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438.\xBB
      \u041E\u043D \u0432\u0437\u044F\u043B \u0432\u0435\u0440\u0451\u0432\u043A\u0443,
      \u043E\u0431\u0432\u044F\u0437\u0430\u043B\u0441\u044F \u0438 \u043F\u043E\u043B\u0435\u0437
      \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443: \u0431\u044B\u0441\u0442\u0440\u043E,
      \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E, \u0446\u0435\u043F\u043B\u044F\u044F\u0441\u044C
      \u0437\u0430 \u0432\u044B\u0441\u0442\u0443\u043F\u044B. \u0427\u0435\u0440\u0435\u0437
      \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C \u0447\u0430\u0441\u0430 \u0441\u0432\u0435\u0440\u0445\u0443
      \u0434\u043E\u043D\u0451\u0441\u0441\u044F \u0441\u0432\u0438\u0441\u0442,
      \u043F\u043E\u0442\u043E\u043C \u0443\u0434\u0430\u0440. \u0412\u044B\u0431\u0438\u043B
      \u043A\u0430\u043C\u0435\u043D\u044C-\u043F\u043E\u0434\u043F\u043E\u0440\u043A\u0443,
      \u043F\u043B\u0430\u0441\u0442 \u0441\u044A\u0435\u0445\u0430\u043B, \u0437\u0430\u0433\u0440\u0435\u043C\u0435\u043B
      \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443 \u0438 \u0440\u0443\u0445\u043D\u0443\u043B
      \u0432 \u0441\u0442\u0430 \u0448\u0430\u0433\u0430\u0445 \u0432\u043F\u0435\u0440\u0435\u0434\u0438,
      \u043F\u043E\u0434\u043D\u044F\u0432 \u043E\u0431\u043B\u0430\u043A\u043E \u043F\u044B\u043B\u0438.
      \u041A\u043E\u0433\u0434\u0430 \u043E\u0441\u0435\u043B\u043E, \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0441\u044F, \u043E\u0442\u0440\u044F\u0445\u043D\u0443\u043B
      \u0440\u0443\u043A\u0438: \xAB\u0422\u0435\u043F\u0435\u0440\u044C \u0447\u0438\u0441\u0442\u043E.
      \u0417\u0430 \u043F\u043E\u043B\u0447\u0430\u0441\u0430 \u0440\u0430\u0441\u0447\u0438\u0449\u0443
      \u043F\u0440\u043E\u0445\u043E\u0434.\xBB \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441
      \u043F\u0435\u0440\u0435\u0431\u0440\u0430\u043B\u0438\u0441\u044C \u0447\u0435\u0440\u0435\u0437
      \u0437\u0430\u0432\u0430\u043B. \u041D\u0438 \u0446\u0430\u0440\u0430\u043F\u0438\u043D\u044B,
      \u043D\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u043E\u0433\u043E
      \u0442\u044E\u043A\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0445\u043B\u043E\u043F\u0430\u043B\u0438 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430
      \u043F\u043E \u043F\u043B\u0435\u0447\u0430\u043C \u043C\u043E\u043B\u0447\u0430:
      \u0441\u043B\u043E\u0432\u0430 \u0431\u044B\u043B\u0438 \u043D\u0435 \u043D\u0443\u0436\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449318
    m_Localized: "\u0421\u043E\u0440\u0435\u0432\u043D\u043E\u0432\u0430\u043D\u0438\u0435
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449319
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u043F\u044B\u043B\u044C:
      \u0447\u0443\u0436\u043E\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D.
      \u0414\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0433\u0440\u0443\u0436\u0451\u043D\u044B\u0445
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432, \u043A\u0440\u0435\u043F\u043A\u0438\u0435
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438, \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0435
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0432 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0445
      \u043A\u0430\u0444\u0442\u0430\u043D\u0430\u0445. \u0421\u0442\u0430\u0440\u0448\u0438\u0439
      \u0447\u0443\u0436\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u043F\u0440\u0438\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430
      \u0438 \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F:
      \u0432 \u0433\u043B\u0430\u0437\u0430\u0445 \u0430\u0437\u0430\u0440\u0442.
      \u041E\u0431\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0438\u0434\u0443\u0442
      \u043A \u043E\u0434\u043D\u043E\u043C\u0443 \u0433\u043E\u0440\u043E\u0434\u0443,
      \u043E\u0431\u0430 \u0432\u0435\u0437\u0443\u0442 \u043F\u043E\u0445\u043E\u0436\u0438\u0439
      \u0442\u043E\u0432\u0430\u0440. \u041A\u0442\u043E \u043F\u0440\u0438\u0434\u0451\u0442
      \u043F\u0435\u0440\u0432\u044B\u043C, \u0442\u043E\u0442 \u043F\u0440\u043E\u0434\u0430\u0441\u0442
      \u0434\u043E\u0440\u043E\u0436\u0435, \u043F\u043E\u043A\u0430 \u0440\u044B\u043D\u043E\u043A
      \u043D\u0435 \u043D\u0430\u0441\u044B\u0442\u0438\u043B\u0441\u044F. \u0414\u043E\u0440\u043E\u0433\u0430
      \u0440\u0430\u0437\u0434\u0432\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438: \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
      \u0442\u0440\u0430\u043A\u0442 \u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449320
    m_Localized: "\u0414\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0433\u043E
      \u0442\u0440\u0430\u043A\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449321
    m_Localized: "\u041D\u0430\u0434\u0451\u0436\u043D\u044B\u0439 \u043F\u0443\u0442\u044C,
      \u0431\u0435\u0437 \u0441\u044E\u0440\u043F\u0440\u0438\u0437\u043E\u0432.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u0438\u0448\u0451\u043B
      \u0432\u0442\u043E\u0440\u044B\u043C, \u043D\u043E \u0440\u044B\u043D\u043E\u043A
      \u0435\u0449\u0451 \u043D\u0435 \u043F\u0435\u0440\u0435\u043F\u043E\u043B\u043D\u0435\u043D:
      \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u0440\u043E\u0434\u0430\u0442\u044C
      \u0447\u0430\u0441\u0442\u044C \u0442\u043E\u0432\u0430\u0440\u0430 \u043F\u043E
      \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u0446\u0435\u043D\u0435. \u041D\u0435
      \u043F\u043E\u0431\u0435\u0434\u0430, \u043D\u043E \u0438 \u043D\u0435 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435:
      \u0442\u0440\u0435\u0437\u0432\u044B\u0439 \u0440\u0430\u0441\u0447\u0451\u0442,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u0446\u0435\u043D\u0438\u043B\u0438
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449322
    m_Localized: "\u0421\u0440\u0435\u0437\u0430\u0442\u044C \u0447\u0435\u0440\u0435\u0437
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449323
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u0430\u043B \u043A\u0440\u0443\u0442
      \u0438 \u0443\u0437\u043E\u043A, \u043D\u043E \u0432\u044B \u0432\u0435\u0440\u043D\u043E
      \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043B\u0438 \u0432\u0440\u0435\u043C\u044F.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u043A\u0430\u0442\u0438\u043B\u0441\u044F
      \u0432 \u0433\u043E\u0440\u043E\u0434 \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435:
      \u0440\u044B\u043D\u043E\u043A \u043F\u0443\u0441\u0442, \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0438
      \u0436\u0434\u0443\u0442. \u041F\u0435\u0440\u0432\u044B\u0439 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044C,
      \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439 \u0432\u0435\u043B\u044C\u043C\u043E\u0436\u0430,
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B \u043D\u0435 \u0442\u043E\u0440\u0433\u0443\u044F\u0441\u044C
      \u0438 \u043F\u043E\u0434\u0430\u0440\u0438\u043B \u043E\u0442\u0440\u0435\u0437
      \u043F\u0430\u0440\u0447\u0438 \u0432 \u0437\u043D\u0430\u043A \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F.
      \u041A\u043E\u0433\u0434\u0430 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0438
      \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C \u043A \u043F\u043E\u043B\u0443\u0434\u043D\u044E,
      \u043B\u0443\u0447\u0448\u0438\u0439 \u0442\u043E\u0432\u0430\u0440 \u0443\u0436\u0435
      \u0443\u0448\u0451\u043B - \u043F\u043E \u0432\u0430\u0448\u0435\u0439 \u0446\u0435\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449324
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u0430\u043B \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0445\u0443\u0436\u0435, \u0447\u0435\u043C \u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0441 \u0434\u043E\u0440\u043E\u0433\u0438. \u041E\u0441\u044B\u043F\u0430\u044E\u0449\u0438\u0439\u0441\u044F
      \u0433\u0440\u0443\u043D\u0442, \u043A\u0440\u0443\u0442\u044B\u0435 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u044B:
      \u043E\u0434\u043D\u0430 \u0438\u0437 \u043F\u043E\u0432\u043E\u0437\u043E\u043A
      \u0437\u0430\u0446\u0435\u043F\u0438\u043B\u0430 \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u0439
      \u0432\u044B\u0441\u0442\u0443\u043F, \u0442\u0440\u0435\u0441\u043D\u0443\u043B\u0430
      \u043E\u0431\u0448\u0438\u0432\u043A\u0430 \u0431\u043E\u0440\u0442\u0430.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043E\u0442\u0435\u0440\u044F\u043B
      \u043F\u043E\u043B\u0434\u043D\u044F \u043D\u0430 \u0440\u0435\u043C\u043E\u043D\u0442
      \u0438 \u043F\u0440\u0438\u0448\u0451\u043B \u043F\u043E\u0437\u0436\u0435
      \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0430. \u0420\u044B\u043D\u043E\u043A
      \u0443\u0436\u0435 \u0441\u0431\u0438\u0442, \u0432\u044B\u0440\u0443\u0447\u043A\u0430
      \u0441\u043A\u0440\u043E\u043C\u043D\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449325
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0437\u043D\u0430\u0435\u0442
      \u0440\u044B\u043D\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449326
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0443\u0441\u043C\u0435\u0445\u043D\u0443\u043B\u0441\u044F
      \u0438 \u043F\u043E\u043A\u0430\u0447\u0430\u043B \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \xAB\u041D\u0435 \u0433\u043E\u043D\u0438\u0441\u044C - \u043E\u0431\u0433\u043E\u043D\u0438
      \u0443\u043C\u043E\u043C.\xBB \u041E\u043D \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B
      \u0441\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043A \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u043C\u0443
      \u0433\u043E\u0440\u043E\u0434\u0443, \u0433\u0434\u0435 \u0442\u043E\u0442
      \u0436\u0435 \u0442\u043E\u0432\u0430\u0440 \u0441\u0442\u043E\u0438\u0442
      \u0434\u043E\u0440\u043E\u0436\u0435, \u0430 \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u0432
      \u043D\u0435\u0442. \u0414\u0432\u0430 \u0434\u043D\u044F \u043A\u0440\u044E\u043A\u0430,
      \u0438 \u043F\u0440\u043E\u0434\u0430\u043B\u0438 \u0432\u0441\u0451 \u0434\u043E
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u0442\u044E\u043A\u0430
      \u043F\u043E \u0446\u0435\u043D\u0430\u043C, \u043E \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A \u0432 \u0441\u0432\u043E\u0451\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435 \u0438 \u043C\u0435\u0447\u0442\u0430\u0442\u044C
      \u043D\u0435 \u043C\u043E\u0433. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u043E\u0441\u043C\u0435\u0438\u0432\u0430\u043B\u0438\u0441\u044C: \u043B\u0443\u0447\u0448\u0430\u044F
      \u0433\u043E\u043D\u043A\u0430 - \u0442\u0430, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043D\u0435 \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449327
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u043E\u0435 \u0432\u044C\u044E\u0447\u043D\u043E\u0435
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449328
    m_Localized: "\u0421 \u0443\u0442\u0440\u0430 \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u0439
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434 \u0448\u0451\u043B \u043D\u0435\u0440\u043E\u0432\u043D\u043E:
      \u043F\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u043B\u0441\u044F, \u043E\u0442\u0441\u0442\u0430\u0432\u0430\u043B,
      \u0440\u043E\u043D\u044F\u043B \u043F\u0435\u043D\u0443 \u0441 \u0433\u0443\u0431.
      \u041A \u043F\u043E\u043B\u0443\u0434\u043D\u044E \u043E\u043D \u0432\u0441\u0442\u0430\u043B,
      \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u044F\u0441\u044C \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F.
      \u0413\u043B\u0430\u0437\u0430 \u043C\u0443\u0442\u043D\u044B\u0435, \u0431\u043E\u043A\u0430
      \u0445\u043E\u0434\u044F\u0442 \u0445\u043E\u0434\u0443\u043D\u043E\u043C,
      \u0438\u0437 \u043D\u043E\u0437\u0434\u0440\u0435\u0439 \u0442\u044F\u043D\u0435\u0442\u0441\u044F
      \u043D\u0438\u0442\u043A\u0430 \u0441\u043B\u0438\u0437\u0438. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0441\u0442\u043E\u043B\u043F\u0438\u043B\u0438\u0441\u044C \u0432\u043E\u043A\u0440\u0443\u0433,
      \u043A\u0430\u0447\u0430\u044E\u0442 \u0433\u043E\u043B\u043E\u0432\u0430\u043C\u0438.
      \u0422\u044E\u043A\u0438 \u0441 \u0435\u0433\u043E \u0441\u043F\u0438\u043D\u044B
      \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043D\u0435\u043A\u0443\u0434\u0430:
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435
      \u043D\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u044B \u0434\u043E \u043F\u0440\u0435\u0434\u0435\u043B\u0430.
      \u041D\u0443\u0436\u043D\u043E \u0440\u0435\u0448\u0430\u0442\u044C: \u043B\u0435\u0447\u0438\u0442\u044C,
      \u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0438\u043B\u0438 \u0440\u0438\u0441\u043A\u043D\u0443\u0442\u044C
      \u0438 \u0433\u043D\u0430\u0442\u044C \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449329
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435
      \u0438 \u0438\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449330
    m_Localized: "\u0422\u044E\u043A\u0438 \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043B\u0438
      \u0438 \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B\u0438
      \u043F\u043E \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430\u043C;
      \u043A\u043E\u0435-\u0447\u0442\u043E \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435.
      \u0411\u043E\u043B\u044C\u043D\u043E\u0433\u043E \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430
      \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
      \u0441 \u0431\u0443\u0440\u0434\u044E\u043A\u043E\u043C \u0432\u043E\u0434\u044B.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0443\u0445\u043E\u0434\u0438\u043B\u0438
      \u043C\u043E\u043B\u0447\u0430, \u043D\u0435 \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044F\u0441\u044C.
      \u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0439 \u0432\u043E\u0437\u043D\u0438\u0446\u0430
      \u0441\u043F\u043B\u044E\u043D\u0443\u043B: \xAB\u041F\u043B\u043E\u0445\u0430\u044F
      \u043F\u0440\u0438\u043C\u0435\u0442\u0430 - \u0431\u0440\u043E\u0441\u0430\u0442\u044C
      \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u0442\u0435\u0431\u044F \u043D\u0451\u0441\xBB.
      \u041C\u044F\u0441\u043E \u043F\u0443\u0441\u0442\u044F\u0442 \u043D\u0430
      \u0432\u044F\u043B\u0435\u043D\u0438\u043D\u0443, \u0435\u0441\u043B\u0438
      \u0437\u0432\u0435\u0440\u044C \u043D\u0435 \u043F\u0440\u043E\u0442\u044F\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449331
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u0432\u044B\u043B\u0435\u0447\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449332
    m_Localized: "\u0412\u044B \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430: \u0440\u0430\u0437\u0434\u0443\u0442\u044B\u0439
      \u0436\u0438\u0432\u043E\u0442, \u0436\u0430\u0440, \u0447\u0430\u0441\u0442\u043E\u0435
      \u0434\u044B\u0445\u0430\u043D\u0438\u0435. \u041E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0433\u0440\u044F\u0437\u043D\u043E\u0439 \u0432\u043E\u0434\u043E\u0439.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A-\u0442\u044E\u0440\u043E\u043A
      \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u0430\u043B \u0441\u0442\u0430\u0440\u043E\u0435
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E: \u043E\u0442\u0432\u0430\u0440
      \u0433\u043E\u0440\u044C\u043A\u043E\u0439 \u043F\u043E\u043B\u044B\u043D\u0438,
      \u0432\u043B\u0438\u0432\u0430\u0442\u044C \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u044F\u043F\u043A\u0443
      \u0432 \u043F\u0430\u0441\u0442\u044C. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u0432\u0441\u0442\u0430\u043B\u043E
      \u043D\u0430 \u043D\u043E\u0433\u0438, \u0448\u0430\u0442\u0430\u044F\u0441\u044C,
      \u043D\u043E \u0436\u0438\u0432\u043E\u0435. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u043F\u043E\u043B\u0434\u043D\u044F
      \u0438 \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u043D\u0430 \u0443\u0445\u043E\u0434, \u0437\u0430\u0442\u043E \u0432\u0441\u0435
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435: \u0438 \u043B\u044E\u0434\u0438,
      \u0438 \u0441\u043A\u043E\u0442\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449333
    m_Localized: "\u041E\u0442\u0432\u0430\u0440 \u043D\u0435 \u043F\u043E\u043C\u043E\u0433:
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434 \u0437\u0430\u0431\u0438\u043B\u0441\u044F
      \u0432 \u0441\u0443\u0434\u043E\u0440\u043E\u0433\u0430\u0445 \u0438 \u0437\u0430\u0442\u0438\u0445
      \u043A \u043D\u043E\u0447\u0438. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0440\u0430\u0437\u0434\u0435\u043B\u0430\u0442\u044C \u0442\u0443\u0448\u0443,
      \u0447\u0442\u043E\u0431\u044B \u0445\u043E\u0442\u044C \u043C\u044F\u0441\u043E
      \u043D\u0435 \u043F\u0440\u043E\u043F\u0430\u043B\u043E. \u0414\u0435\u043D\u044C
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D, \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B \u043D\u0430 \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0435
      \u043B\u0435\u0447\u0435\u043D\u0438\u0435, \u0430 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043C\u0440\u0430\u0447\u043D\u0435\u0435 \u0442\u0443\u0447\u0438. \u0422\u044E\u043A\u0438,
      \u0447\u0442\u043E \u043D\u0451\u0441 \u0432\u0435\u0440\u0431\u043B\u044E\u0434,
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0432\u043E\u043B\u043E\u0447\u044C
      \u043D\u0430 \u0440\u0443\u043A\u0430\u0445 \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043F\u0440\u0438\u0432\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449334
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0437\u043D\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449335
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0441\u044F
      \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u0438, \u043E\u0449\u0443\u043F\u0430\u043B
      \u0436\u0438\u0432\u043E\u0442 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430,
      \u043F\u0440\u0438\u043F\u043E\u0434\u043D\u044F\u043B \u0432\u0435\u043A\u043E,
      \u043F\u043E\u043D\u044E\u0445\u0430\u043B \u0434\u044B\u0445\u0430\u043D\u0438\u0435.
      \xAB\u0412\u0437\u0434\u0443\u0442\u0438\u0435 \u043E\u0442 \u044F\u0434\u043E\u0432\u0438\u0442\u043E\u0439
      \u0442\u0440\u0430\u0432\u044B. \u0412\u0438\u0434\u0435\u043B \u0442\u0430\u043A\u043E\u0435
      \u0432 \u0411\u0443\u0445\u0430\u0440\u0435 - \u0442\u0430\u043C \u043E\u0441\u043B\u044B
      \u0434\u043E\u0445\u043B\u0438 \u0434\u0435\u0441\u044F\u0442\u043A\u0430\u043C\u0438,
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u043D\u0430\u0448\u043B\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E.\xBB
      \u041E\u043D \u0441\u043C\u0435\u0448\u0430\u043B \u0442\u043E\u043B\u0447\u0451\u043D\u044B\u0439
      \u0443\u0433\u043E\u043B\u044C \u0441 \u0441\u043E\u043B\u0451\u043D\u043E\u0439
      \u0432\u043E\u0434\u043E\u0439 \u0438 \u0432\u043B\u0438\u043B \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0443
      \u0432 \u0433\u043B\u043E\u0442\u043A\u0443 \u0447\u0435\u0440\u0435\u0437
      \u043A\u043E\u0436\u0430\u043D\u0443\u044E \u0432\u043E\u0440\u043E\u043D\u043A\u0443.
      \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435
      \u0432\u0441\u0442\u0430\u043B\u043E, \u0442\u0440\u044F\u0445\u043D\u0443\u043B\u043E
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0438 \u043F\u043E\u0442\u044F\u043D\u0443\u043B\u043E\u0441\u044C
      \u043A \u043A\u043E\u0440\u043C\u0443\u0448\u043A\u0435. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u043D\u0430 \u043B\u0435\u043A\u0430\u0440\u044F
      \u0441 \u0442\u0435\u043C \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043D\u0435 \u043A\u0443\u043F\u0438\u0448\u044C
      \u0437\u0430 \u0434\u0435\u043D\u044C\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449336
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446 \u043A\u0430\u0440\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449337
    m_Localized: "\u0412 \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0435
      \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430 \u0441\u0438\u0434\u0438\u0442
      \u0445\u0443\u0434\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432
      \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u043E\u043C \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C
      \u043A\u0430\u0444\u0442\u0430\u043D\u0435, \u0440\u0430\u0437\u043B\u043E\u0436\u0438\u0432
      \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u044F\u0445 \u0441\u0432\u0451\u0440\u043D\u0443\u0442\u044B\u0435
      \u0441\u0432\u0438\u0442\u043A\u0438. \u041F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C:
      \u043A\u043E\u0436\u0430\u043D\u0430\u044F \u0441\u0443\u043C\u043A\u0430,
      \u043D\u0430\u0431\u0438\u0442\u0430\u044F \u0442\u0440\u0443\u0431\u043A\u0430\u043C\u0438
      \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0430, \u0438 \u0447\u0435\u0440\u043D\u0438\u043B\u044C\u043D\u0438\u0446\u0430
      \u0441 \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u043E\u0439 \u043A\u0440\u044B\u0448\u043A\u043E\u0439.
      \u0417\u0430\u0432\u0438\u0434\u0435\u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u043E\u043D \u0432\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u0435\u0442,
      \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u043E\u0434\u0438\u043D \u0441\u0432\u0438\u0442\u043E\u043A
      \u0438 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442:
      \u043B\u0438\u043D\u0438\u0438 \u0442\u0440\u043E\u043F, \u0437\u043D\u0430\u0447\u043A\u0438
      \u043A\u043E\u043B\u043E\u0434\u0446\u0435\u0432, \u043F\u043E\u043C\u0435\u0442\u043A\u0438
      \u043D\u0430 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C.
      \xAB\u0422\u0430\u0439\u043D\u044B\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442,
      - \u0448\u0435\u043F\u0447\u0435\u0442 \u043E\u043D, \u0442\u044B\u0447\u0430
      \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u0432 \u043A\u0430\u0440\u0442\u0443.
      - \u041A\u043E\u0440\u043E\u0447\u0435 \u043D\u0430 \u0434\u0435\u0441\u044F\u0442\u044C
      \u0434\u043D\u0435\u0439, \u043C\u0438\u043C\u043E \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u0447\u044C\u0438\u0445
      \u0437\u0430\u0441\u0442\u0430\u0432.\xBB \u0413\u043B\u0430\u0437\u0430 \u0431\u0435\u0433\u0430\u044E\u0442,
      \u0440\u0443\u043A\u0438 \u0434\u0440\u043E\u0436\u0430\u0442, \u0442\u043E
      \u043B\u0438 \u043E\u0442 \u0432\u043E\u043B\u043D\u0435\u043D\u0438\u044F,
      \u0442\u043E \u043B\u0438 \u043E\u0442 \u0447\u0435\u0433\u043E-\u0442\u043E
      \u0435\u0449\u0451.\r\n\r\n<npc_speech lang=\"Sogdian\">\u041F\u0440\u0438\u0432\u0435\u0442,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A! \u042D\u0442\u0430
      \u043A\u0430\u0440\u0442\u0430 - \u0442\u0430\u0439\u043D\u044B\u0439 \u043F\u0443\u0442\u044C,
      \u043D\u0430 \u0434\u0435\u0441\u044F\u0442\u044C \u0434\u043D\u0435\u0439
      \u043A\u043E\u0440\u043E\u0447\u0435, \u043C\u0438\u043C\u043E \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432.
      \u041F\u044F\u0442\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0445
      - \u0438 \u0434\u043E\u0440\u043E\u0433\u0430 \u0442\u0432\u043E\u044F \u0441\u0432\u0435\u0442\u043B\u0430!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449338
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449339
    m_Localized: "\u0412\u044B \u043F\u043E\u043A\u0430\u0447\u0430\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
      \u0438 \u043F\u0440\u043E\u0448\u043B\u0438 \u043C\u0438\u043C\u043E. \u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446
      \u0441\u043D\u0438\u043A, \u043D\u043E \u0442\u0443\u0442 \u0436\u0435 \u0432\u0441\u043A\u043E\u0447\u0438\u043B,
      \u0437\u0430\u0432\u0438\u0434\u0435\u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D. \u041C\u043E\u0436\u0435\u0442,
      \u043A\u0430\u0440\u0442\u0430 \u0438 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F,
      \u043D\u043E \u043D\u0430 \xAB\u043C\u043E\u0436\u0435\u0442\xBB \u043D\u0435
      \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0448\u044C \u0436\u0438\u0437\u043D\u044C
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449340
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043A\u0430\u0440\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449341
    m_Localized: "\u0412\u044B \u0441\u0431\u0438\u043B\u0438 \u0446\u0435\u043D\u0443
      \u0432\u0434\u0432\u043E\u0435 \u0438 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u043A\u0430\u0440\u0442\u0443.
      \u041F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442 \u0441\u0442\u0430\u0440\u044B\u0439,
      \u043D\u043E \u043F\u043E\u043C\u0435\u0442\u043A\u0438 \u0441\u0432\u0435\u0436\u0438\u0435:
      \u043A\u0442\u043E-\u0442\u043E \u043F\u0440\u043E\u0448\u0451\u043B \u044D\u0442\u0438\u043C
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u043E\u043C \u043D\u0435\u0434\u0430\u0432\u043D\u043E
      \u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u043B \u043A\u0430\u0440\u0442\u0443.
      \u041A\u043E\u043B\u043E\u0434\u0446\u044B \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u044B
      \u0432\u0435\u0440\u043D\u043E, \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u044B
      \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u044E\u0442 \u0441 \u0442\u0435\u043C,
      \u0447\u0442\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0438
      \u0434\u0440\u0443\u0433\u0438\u0435 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438.
      \u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446, \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u0439
      \u0445\u043E\u0442\u044F \u0431\u044B \u043C\u0430\u043B\u043E\u0439 \u0432\u044B\u0440\u0443\u0447\u043A\u043E\u0439,
      \u0442\u043A\u043D\u0443\u043B \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u0432
      \u043E\u0434\u0438\u043D \u0438\u0437 \u0437\u043D\u0430\u0447\u043A\u043E\u0432:
      \xAB\u0417\u0434\u0435\u0441\u044C \u0440\u043E\u0434\u043D\u0438\u043A, \u0432\u043E\u0434\u0430
      \u0441\u043B\u0430\u0434\u043A\u0430\u044F, \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043F\u044C\u044E\u0442 \u043E\u0445\u043E\u0442\u043D\u043E\xBB. \u041A\u0430\u0440\u0442\u0430
      \u043F\u043E\u0434\u043B\u0438\u043D\u043D\u0430\u044F, \u0438 \u0441\u0442\u043E\u0438\u0442
      \u043A\u0430\u0436\u0434\u043E\u0439 \u043C\u043E\u043D\u0435\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449342
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u043B\u0438\u0441\u044C
      \u0434\u043E\u043B\u0433\u043E, \u043D\u043E \u043F\u0440\u043E\u0434\u0430\u0432\u0435\u0446
      \u0443\u0441\u0442\u0443\u043F\u0438\u043B \u043D\u0435\u043E\u0445\u043E\u0442\u043D\u043E,
      \u0441\u043E\u0434\u0440\u0430\u0432 \u043F\u043E\u0447\u0442\u0438 \u043F\u043E\u043B\u043D\u0443\u044E
      \u0446\u0435\u043D\u0443. \u0410 \u043A\u0430\u0440\u0442\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043A\u043E\u043F\u0438\u0435\u0439 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430, \u0434\u0430\u0432\u043D\u043E
      \u0437\u0430\u043D\u0435\u0441\u0451\u043D\u043D\u043E\u0433\u043E \u043F\u0435\u0441\u043A\u043E\u043C.
      \u041A\u043E\u043B\u043E\u0434\u0446\u044B \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u043B\u0438,
      \u0442\u0440\u043E\u043F\u0430 \u043E\u0431\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044C
      \u0443 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u043D\u0430 \u0432\u0435\u0442\u0435\u0440,
      \u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0435\u0434\u0432\u0430
      \u043D\u0435 \u0441\u0432\u0435\u0440\u043D\u0443\u043B \u0432 \u043D\u0438\u043A\u0443\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449343
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0440\u0430\u0441\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449344
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0441 \u043F\u0440\u043E\u0434\u0430\u0432\u0446\u043E\u043C \u043D\u0430
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C: <npc_speech lang=\"Sogdian\">\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439,
      \u0434\u0440\u0443\u0433. \u042D\u0442\u0430 \u043A\u0430\u0440\u0442\u0430
      - \u0447\u044C\u044F \u0440\u0430\u0431\u043E\u0442\u0430? \u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438,
      \u043E\u0442\u043A\u0443\u0434\u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442.</npc_speech>
      \u0422\u043E\u0442 \u0432\u0437\u0434\u0440\u043E\u0433\u043D\u0443\u043B \u0438
      \u0440\u0430\u0441\u043F\u043B\u044B\u043B\u0441\u044F \u0432 \u0443\u043B\u044B\u0431\u043A\u0435.
      \u041F\u043E\u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C \u0438\u043C\u0435\u043D\u0430,
      \u0433\u043E\u0440\u043E\u0434\u0430, \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0435\u0432.
      \u0427\u0435\u0440\u0435\u0437 \u0434\u0435\u0441\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0437\u043D\u0430\u043B
      \u0432\u0441\u0451: \u043A\u0430\u0440\u0442\u0430 \u043F\u043E\u0434\u043B\u0438\u043D\u043D\u0430\u044F,
      \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u043E\u043C
      \u0438\u0437 \u0411\u0443\u0445\u0430\u0440\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043F\u0440\u043E\u0448\u0451\u043B \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u0442\u0440\u0438\u0436\u0434\u044B. \u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043F\u043B\u0435\u043C\u044F\u043D\u043D\u0438\u043A\u043E\u043C,
      \u043F\u0440\u043E\u0434\u0430\u0451\u0442 \u043A\u043E\u043F\u0438\u0438,
      \u0447\u0442\u043E\u0431\u044B \u043E\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0434\u044F\u0434\u0438\u043D \u0434\u043E\u043B\u0433. \u041D\u0430\u043F\u043E\u0441\u043B\u0435\u0434\u043E\u043A
      \u043E\u043D \u0434\u043E\u0431\u0430\u0432\u0438\u043B \u0434\u043E\u0432\u0435\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E:
      \xAB\u0422\u0440\u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0445,
      \u0438 \u044F \u043F\u043E\u043A\u0430\u0436\u0443, \u0433\u0434\u0435 \u0434\u044F\u0434\u044F
      \u0441\u043F\u0440\u044F\u0442\u0430\u043B \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0439
      \u0431\u0443\u0440\u0434\u044E\u043A \u0443 \u0432\u0442\u043E\u0440\u043E\u0433\u043E
      \u043A\u043E\u043B\u043E\u0434\u0446\u0430\xBB. \u041A\u0430\u0440\u0442\u0430
      \u043A\u0443\u043F\u043B\u0435\u043D\u0430 \u0437\u0430 \u0431\u0435\u0441\u0446\u0435\u043D\u043E\u043A,
      \u0438 \u0432 \u043F\u0440\u0438\u0434\u0430\u0447\u0443 \u0434\u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043D\u0435\u0442 \u043D\u0438 \u0443 \u043E\u0434\u043D\u043E\u0433\u043E
      \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449345
    m_Localized: "\u0421\u0431\u043E\u0440\u0449\u0438\u043A \u043D\u0430\u043B\u043E\u0433\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449346
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 - \u043F\u043E\u043B\u043E\u0441\u0430\u0442\u044B\u0439
      \u0448\u0430\u0442\u0451\u0440 \u0438 \u0431\u0430\u043C\u0431\u0443\u043A\u043E\u0432\u044B\u0439
      \u0448\u043B\u0430\u0433\u0431\u0430\u0443\u043C \u043F\u043E\u043F\u0435\u0440\u0451\u043A
      \u0442\u0440\u0430\u043A\u0442\u0430. \u0414\u0432\u0430 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430
      \u0441 \u043A\u043E\u043F\u044C\u044F\u043C\u0438 \u0441\u0442\u043E\u044F\u0442
      \u043F\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C. \u0417\u0430
      \u043D\u0438\u043C\u0438 \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u0432
      \u0447\u0438\u0441\u0442\u043E\u043C \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u043C
      \u0445\u0430\u043B\u0430\u0442\u0435, \u0441 \u0447\u0435\u0440\u043D\u0438\u043B\u044C\u043D\u0438\u0446\u0435\u0439
      \u043D\u0430 \u043F\u043E\u044F\u0441\u0435 \u0438 \u0441\u0432\u0438\u0442\u043A\u043E\u043C
      \u0432 \u0440\u0443\u043A\u0430\u0445. \u041E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u043B\u0430\u0434\u043E\u043D\u044C, \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044F
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D, \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0440\u0430\u0437\u043C\u0435\u0440\u0435\u043D\u043D\u043E, \u0441 \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u043E\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u043C\u0435\u0435\u0442
      \u043F\u0435\u0440\u0435\u0431\u0438\u0442\u044C. \u0420\u044F\u0434\u043E\u043C
      \u043D\u0430 \u0437\u0435\u043C\u043B\u0435 \u043B\u0435\u0436\u0438\u0442
      \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u0430\u044F \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0430
      \u0441 \u043C\u043E\u043D\u0435\u0442\u0430\u043C\u0438: \u0441\u0431\u043E\u0440\u044B
      \u0437\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F.\r\n\r\n<npc_speech
      lang=\"Persian\">\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A. \u041F\u043E
      \u0443\u043A\u0430\u0437\u0443 \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F,
      \u0434\u043E\u0440\u043E\u0436\u043D\u0430\u044F \u043F\u043E\u0448\u043B\u0438\u043D\u0430
      \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C \u0443\u043F\u043B\u0430\u0447\u0435\u043D\u0430.
      \u041E\u0434\u0438\u043D \u0434\u0438\u043D\u0430\u0440 \u0441 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0432\u044C\u044E\u043A\u0430. \u041F\u043B\u0430\u0442\u0438\u0442\u0435,
      \u0438\u043B\u0438 \u0432\u0430\u0448 \u0433\u0440\u0443\u0437 \u0431\u0443\u0434\u0435\u0442
      \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043D.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449347
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043F\u043E\u0448\u043B\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449348
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u043C\u043E\u043D\u0435\u0442
      \u043B\u0435\u0433\u043B\u0438 \u0432 \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0443.
      \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u043A\u0438\u0432\u043D\u0443\u043B,
      \u0441\u0434\u0435\u043B\u0430\u043B \u043F\u043E\u043C\u0435\u0442\u043A\u0443
      \u0432 \u0441\u0432\u0438\u0442\u043A\u0435 \u0438 \u043C\u0430\u0445\u043D\u0443\u043B
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430\u043C. \u0428\u043B\u0430\u0433\u0431\u0430\u0443\u043C
      \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F. \u0414\u043E\u0440\u043E\u0433\u043E,
      \u043D\u043E \u0431\u044B\u0441\u0442\u0440\u043E: \u043D\u0438\u043A\u0430\u043A\u0438\u0445
      \u043E\u0441\u043B\u043E\u0436\u043D\u0435\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449349
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0437\u0430 \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0435 \u043F\u043E\u0448\u043B\u0438\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449350
    m_Localized: "\u0412\u044B \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0438
      \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u0431\u0443\u043C\u0430\u0433\u0438:
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u043F\u0430\u0442\u0435\u043D\u0442,
      \u043F\u0435\u0447\u0430\u0442\u044C \u0433\u0438\u043B\u044C\u0434\u0438\u0438,
      \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0443 \u043E\u0442 \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E
      \u0441\u0431\u043E\u0440\u0449\u0438\u043A\u0430. \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u043F\u0440\u0438\u043F\u043E\u0434\u043D\u044F\u043B \u0431\u0440\u043E\u0432\u044C,
      \u043F\u0435\u0440\u0435\u0447\u0438\u0442\u0430\u043B \u043F\u0435\u0447\u0430\u0442\u044C
      \u0438 \u043A\u0438\u0432\u043D\u0443\u043B. \xAB\u0427\u0435\u0442\u044B\u0440\u0435
      \u043C\u043E\u043D\u0435\u0442\u044B - \u0434\u043B\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432
      \u0441 \u043F\u0430\u0442\u0435\u043D\u0442\u043E\u043C \u0441\u043A\u0438\u0434\u043A\u0430.\xBB
      \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438 \u043F\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u0438\u043B\u0438\u0441\u044C,
      \u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0448\u0451\u043B.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u043B\u0438\u0441\u044C
      \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C: \u0445\u043E\u0437\u044F\u0438\u043D
      \u0443\u043C\u0435\u0435\u0442 \u0441\u0447\u0438\u0442\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643520
    m_Localized: "\u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B
      \u0432\u0430\u0448\u0438 \u0434\u043E\u0432\u043E\u0434\u044B \u0441 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u043C
      \u043B\u0438\u0446\u043E\u043C, \u0437\u0430\u0442\u0435\u043C \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B
      \u0441\u0432\u0438\u0442\u043E\u043A \u0438 \u0442\u043A\u043D\u0443\u043B
      \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u0432 \u0441\u0442\u0440\u043E\u043A\u0443.
      \xAB\u041F\u043E\u043F\u044B\u0442\u043A\u0430 \u0443\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u044F
      - \u0448\u0442\u0440\u0430\u0444. \u041F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u043C\u043E\u043D\u0435\u0442, \u0438 \u0441\u043A\u0430\u0436\u0438\u0442\u0435
      \u0441\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u043D\u0435
      \u043A\u043E\u043D\u0444\u0438\u0441\u043A\u0443\u044E \u0442\u044E\u043A.\xBB
      \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438 \u043F\u043E\u0434\u0441\u0442\u0443\u043F\u0438\u043B\u0438
      \u0431\u043B\u0438\u0436\u0435, \u0440\u0443\u043A\u0438 \u043D\u0430 \u0440\u0443\u043A\u043E\u044F\u0442\u044F\u0445.
      \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0438 \u0442\u0435\u0440\u043F\u0435\u0442\u044C \u043D\u0430\u0441\u043C\u0435\u0448\u043B\u0438\u0432\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u043F\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643521
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0434\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441 \u043A\u043E\u043D\u0432\u043E\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643522
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0441\u043F\u0435\u0448\u0438\u043B\u0441\u044F,
      \u043F\u043E\u043F\u0440\u0430\u0432\u0438\u043B \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u044C
      \u0441 \u043C\u0435\u0447\u043E\u043C \u0438 \u043F\u043E\u0434\u043E\u0448\u0451\u043B
      \u043A \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0443, \u043D\u0435
      \u043A\u0430\u043A \u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C,
      \u0430 \u043A\u0430\u043A \u0440\u0430\u0432\u043D\u044B\u0439. \u0417\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u043F\u043E-\u0432\u043E\u0435\u043D\u043D\u043E\u043C\u0443, \u043A\u043E\u0440\u043E\u0442\u043A\u043E:
      \u043D\u0430\u0437\u0432\u0430\u043B \u0438\u043C\u044F \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0430
      \u043C\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u0433\u0430\u0440\u043D\u0438\u0437\u043E\u043D\u0430,
      \u0443\u043F\u043E\u043C\u044F\u043D\u0443\u043B \u043F\u0430\u0440\u0443 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u044B\u0445
      \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0439 \u043F\u0440\u043E\u0442\u0438\u0432
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432. \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u043F\u0440\u0438\u0449\u0443\u0440\u0438\u043B\u0441\u044F, \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u043B\u0441\u044F
      \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438 \u043A\u043E\u043F\u0435\u0439\u0449\u0438\u043A\u0430\u043C\u0438
      \u0438 \u043A\u0438\u0432\u043D\u0443\u043B. \xAB\u0422\u0440\u0438 \u043C\u043E\u043D\u0435\u0442\u044B
      - \u0434\u043B\u044F \u043B\u044E\u0434\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u043F\u043E\u0440\u044F\u0434\u043A\u0443.\xBB
      \u0428\u043B\u0430\u0433\u0431\u0430\u0443\u043C \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F
      \u0431\u0435\u0437 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443
      \u0438 \u043F\u043E\u0436\u0430\u043B \u043F\u043B\u0435\u0447\u0430\u043C\u0438:
      \xAB\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0430\u0445 \u0432\u0441\u0435
      \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430 \u0437\u043D\u0430\u044E\u0442.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643523
    m_Localized: "\u0417\u0430\u043A\u0430\u0442 \u043D\u0430\u0434 \u0441\u0442\u0435\u043F\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643524
    m_Localized: "\u041A\u043E\u0432\u044B\u043B\u044C \u0433\u043E\u0440\u0438\u0442
      \u043C\u0435\u0434\u044C\u044E, \u0442\u0435\u043D\u0438 \u043F\u043E\u0432\u043E\u0437\u043E\u043A
      \u0442\u044F\u043D\u0443\u0442\u0441\u044F \u0434\u043E \u043A\u0440\u0430\u044F
      \u0437\u0435\u043C\u043B\u0438. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0437\u0430\u043C\u043E\u043B\u043A\u0430\u044E\u0442 - \u0434\u0430\u0436\u0435
      \u0432\u043E\u043B\u044B \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u044E\u0442
      \u0448\u0430\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643525
    m_Localized: "\u041E\u0431\u043B\u0430\u043A\u043E \u043F\u044B\u043B\u0438 \u043D\u0430
      \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643526
    m_Localized: "\u0411\u0443\u0440\u043E\u0435 \u043E\u0431\u043B\u0430\u043A\u043E
      \u043F\u044B\u043B\u0438 \u043F\u043E\u043B\u0437\u0451\u0442 \u043F\u043E
      \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0443 - \u043A\u0442\u043E
      \u0442\u0430\u043C? \u0410\u0440\u043C\u0438\u044F, \u0441\u0430\u0439\u0433\u0430\u043A\u0438,
      \u0447\u0443\u0436\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C. \u041C\u0430\u0440\u0435\u0432\u043E \u0443\u043D\u0435\u0441\u043B\u043E
      \u043E\u0442\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643527
    m_Localized: "\u041F\u0430\u0441\u0442\u0443\u0445 \u0441\u043E \u0441\u0442\u0430\u0434\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643528
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u043F\u0430\u0441\u0442\u0443\u0445
      \u0441\u0432\u0438\u0441\u0442\u0438\u0442 \u0441\u043E\u0431\u0430\u043A\u0430\u043C,
      \u0441\u0442\u0430\u0434\u043E \u0440\u0430\u0441\u0441\u0442\u0443\u043F\u0430\u0435\u0442\u0441\u044F.
      \u041E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0440\u0443\u043A\u0443
      - \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u043E\u0435 \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435.
      \u0417\u043D\u0430\u0447\u0438\u0442, \u0440\u044F\u0434\u043E\u043C \u0436\u0438\u043B\u044C\u0451
      \u0438 \u0432\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643529
    m_Localized: "\u0417\u0432\u0451\u0437\u0434\u043D\u043E\u0435 \u043D\u0435\u0431\u043E
      \u043F\u0443\u0441\u0442\u044B\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643530
    m_Localized: "\u041C\u043B\u0435\u0447\u043D\u044B\u0439 \u041F\u0443\u0442\u044C
      \u043B\u043E\u0436\u0438\u0442\u0441\u044F \u0447\u0435\u0440\u0435\u0437 \u0437\u0435\u043D\u0438\u0442
      \u0431\u0435\u043B\u0451\u0441\u043E\u0439 \u0440\u0435\u043A\u043E\u0439.
      \u0422\u0438\u0448\u0438\u043D\u0430 \u0442\u0430\u043A\u0430\u044F, \u0447\u0442\u043E
      \u0441\u043B\u044B\u0448\u043D\u043E \u0434\u044B\u0445\u0430\u043D\u0438\u0435
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432 - \u0435\u0441\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0431\u043E, \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0435
      \u0438 \u0431\u043B\u0438\u0437\u043A\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643531
    m_Localized: "\u041C\u0438\u0440\u0430\u0436 \u0433\u043E\u0440\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643532
    m_Localized: "\u0412 \u043C\u0430\u0440\u0435\u0432\u0435 \u043D\u0430\u0434
      \u0440\u0430\u0441\u043A\u0430\u043B\u0451\u043D\u043D\u043E\u0439 \u0440\u0430\u0432\u043D\u0438\u043D\u043E\u0439
      \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u0430\u044E\u0442 \u0431\u0430\u0448\u043D\u0438
      \u0438 \u043A\u0443\u043F\u043E\u043B\u0430. \u0412\u0438\u0434\u0435\u043D\u0438\u0435
      \u0442\u0430\u0435\u0442, \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F
      \u0433\u043E\u0440\u0435\u0447\u044C - \u043F\u0443\u0441\u0442\u044B\u043D\u044F
      \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442: \u0442\u043E,
      \u0447\u0442\u043E \u0432\u0438\u0434\u0438\u0448\u044C, \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
      \u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643533
    m_Localized: "\u041E\u0440\u0451\u043B \u043D\u0430\u0434 \u0443\u0449\u0435\u043B\u044C\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643534
    m_Localized: "\u0411\u0435\u0440\u043A\u0443\u0442 \u0432\u0438\u0441\u0438\u0442
      \u043D\u0430\u0434 \u0443\u0449\u0435\u043B\u044C\u0435\u043C \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E,
      \u043A\u0430\u043A \u0432\u044B\u0440\u0435\u0437\u0430\u043D\u043D\u044B\u0439
      \u0438\u0437 \u0442\u0451\u043C\u043D\u043E\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u0430
      - \u0442\u043E\u043B\u044C\u043A\u043E \u0433\u043E\u043B\u043E\u0432\u0430
      \u0441\u043B\u0435\u0434\u0438\u0442 \u0437\u0430 \u043F\u0443\u0442\u043D\u0438\u043A\u0430\u043C\u0438.
      \u0414\u043E\u0431\u0440\u044B\u0439 \u0437\u043D\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643535
    m_Localized: "\u041C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u0444\u043B\u0430\u0433\u0438 \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643536
    m_Localized: "\u041D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435 \u0444\u043B\u0430\u0433\u0438
      \u0441 \u043C\u0430\u043D\u0442\u0440\u0430\u043C\u0438 \u0442\u0440\u0435\u043F\u0435\u0449\u0443\u0442
      \u043A\u0430\u043A \u0436\u0438\u0432\u044B\u0435 - \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u0435,
      \u043F\u043E\u043B\u0443\u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0435,
      \u043F\u043E\u0432\u0435\u0448\u0435\u043D\u043D\u044B\u0435 \u043A\u0435\u043C-\u0442\u043E
      \u0437\u0430\u0434\u043E\u043B\u0433\u043E \u0434\u043E \u043D\u0430\u0441.
      \u0414\u0430\u0436\u0435 \u044F\u043A\u0438 \u0441\u0442\u0443\u043F\u0430\u044E\u0442
      \u043C\u044F\u0433\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643537
    m_Localized: "\u041B\u0435\u0434\u044F\u043D\u043E\u0439 \u0432\u0435\u0442\u0435\u0440
      \u0441 \u0432\u0435\u0440\u0448\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643538
    m_Localized: "\u041B\u0435\u0434\u044F\u043D\u043E\u0439 \u0432\u0435\u0442\u0435\u0440
      \u0441 \u0432\u0435\u0440\u0448\u0438\u043D \u0431\u044C\u0451\u0442 \u0432
      \u043B\u0438\u0446\u043E \u0441\u043D\u0435\u0436\u043D\u043E\u0439 \u043A\u0440\u0443\u043F\u043E\u0439.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0441\u0443\u0442\u0443\u043B\u044F\u0442\u0441\u044F,
      \u044F\u043A\u0438 \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E\u0442
      \u043C\u043E\u0440\u0434\u044B - \u0437\u0434\u0435\u0441\u044C \u043D\u0435
      \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u043F\u0440\u0438\u0432\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643539
    m_Localized: "\u041F\u0435\u0441\u043D\u044F \u0443 \u043A\u043E\u0441\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643540
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0437\u0430\u0442\u044F\u043D\u0443\u043B \u043F\u0435\u0441\u043D\u044E \u043D\u0430
      \u043F\u043E\u043B\u0443\u0437\u0430\u0431\u044B\u0442\u043E\u043C \u0434\u0438\u0430\u043B\u0435\u043A\u0442\u0435.
      \u0418\u0441\u043A\u0440\u044B \u043B\u0435\u0442\u044F\u0442 \u0432 \u0442\u0451\u043C\u043D\u043E\u0435
      \u043D\u0435\u0431\u043E - \u043C\u0438\u043D\u0443\u0442\u0443 \u043D\u0430\u0437\u0430\u0434
      \u0432\u0441\u0435 \u0431\u044B\u043B\u0438 \u0447\u0443\u0436\u0438\u043C\u0438,
      \u0442\u0435\u043F\u0435\u0440\u044C \u043E\u0434\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643541
    m_Localized: "\u0421\u043A\u0440\u0438\u043F\u044F\u0449\u0435\u0435 \u043A\u043E\u043B\u0435\u0441\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643542
    m_Localized: "\u0417\u0430\u0434\u043D\u0435\u0435 \u043A\u043E\u043B\u0435\u0441\u043E
      \u0441\u043A\u0440\u0438\u043F\u0438\u0442 \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C
      \u043E\u0431\u043E\u0440\u043E\u0442\u0435 - \u043C\u043E\u043D\u043E\u0442\u043E\u043D\u043D\u043E,
      \u0437\u0430\u043D\u0443\u0434\u043D\u043E. \u0414\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043F\u043E\u043A\u0430. \u041F\u043E\u0447\u0438\u043D\u0438\u043C \u043D\u0430
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u043F\u0440\u0438\u0432\u0430\u043B\u0435,
      \u0435\u0441\u043B\u0438 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643543
    m_Localized: "\u0413\u043E\u043B\u043E\u0434 \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643544
    m_Localized: "\u041F\u044F\u0442\u044B\u0439 \u0434\u0435\u043D\u044C \u043D\u0430
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043D\u043E\u043C \u043F\u0430\u0439\u043A\u0435.
      \u0412\u043E\u0437\u043D\u0438\u0447\u0438\u0435 \u0436\u0443\u044E\u0442 \u0441\u0443\u0445\u0443\u044E
      \u043A\u043E\u0440\u0443 \u0438 \u043F\u044C\u044E\u0442 \u043C\u0443\u0442\u043D\u0443\u044E
      \u0432\u043E\u0434\u0443 \u0438\u0437 \u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0445
      \u043B\u0443\u0436. \u0412\u044C\u044E\u0447\u043D\u044B\u0439 \u0431\u044B\u043A
      \u0448\u0430\u0442\u0430\u0435\u0442\u0441\u044F, \u0440\u0451\u0431\u0440\u0430
      \u0442\u043E\u0440\u0447\u0430\u0442 \u043A\u0430\u043A \u043E\u0431\u0440\u0443\u0447\u0438
      \u0431\u043E\u0447\u043A\u0438, \u0438\u0437 \u043D\u043E\u0437\u0434\u0440\u0435\u0439
      \u043F\u0443\u0437\u044B\u0440\u0438\u0442\u0441\u044F \u0440\u043E\u0437\u043E\u0432\u0430\u0442\u0430\u044F
      \u043F\u0435\u043D\u0430. \u0414\u0432\u0430 \u043D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0430
      \u0441\u0432\u0430\u043B\u0438\u043B\u0438\u0441\u044C \u0443 \u043E\u0431\u043E\u0447\u0438\u043D\u044B:
      \u0441\u0438\u043B \u043D\u0435\u0441\u0442\u0438 \u0442\u044E\u043A\u0438
      \u0443\u0436\u0435 \u043D\u0435\u0442. \u0421\u0442\u0430\u0440\u0448\u0438\u0439
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E,
      \u0431\u0435\u0437 \u0437\u043B\u043E\u0431\u044B: \u0440\u0435\u0448\u0430\u0439
      \u0441\u0435\u0439\u0447\u0430\u0441, \u0438\u043D\u0430\u0447\u0435 \u0437\u0430\u0432\u0442\u0440\u0430
      \u0440\u0435\u0448\u0430\u0442\u044C \u0431\u0443\u0434\u0435\u0442 \u043D\u0435\u043A\u043E\u043C\u0443.
      \u041C\u043E\u0436\u043D\u043E \u0437\u0430\u0440\u0435\u0437\u0430\u0442\u044C
      \u043E\u0441\u043B\u0430\u0431\u0448\u0435\u0433\u043E \u0431\u044B\u043A\u0430,
      \u043F\u043E\u0441\u043B\u0430\u0442\u044C \u043B\u044E\u0434\u0435\u0439 \u043D\u0430
      \u043E\u0445\u043E\u0442\u0443 \u0438\u043B\u0438 \u0443\u0440\u0435\u0437\u0430\u0442\u044C
      \u043F\u043E\u0440\u0446\u0438\u044E \u0434\u043E \u0433\u043E\u0440\u0441\u0442\u0438
      \u043C\u0443\u043A\u0438 \u0432 \u0434\u0435\u043D\u044C \u0438 \u043F\u043E\u043B\u0437\u0442\u0438
      \u0434\u043E \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643545
    m_Localized: "\u0417\u0430\u0431\u0438\u0442\u044C \u043E\u0441\u043B\u0430\u0431\u0435\u0432\u0448\u0435\u0433\u043E
      \u0431\u044B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643546
    m_Localized: "\u041D\u043E\u0436 \u0431\u044B\u043B \u0431\u044B\u0441\u0442\u0440\u044B\u043C:
      \u0441\u0442\u0430\u0440\u044B\u0439 \u0431\u044B\u043A \u0434\u0430\u0436\u0435
      \u043D\u0435 \u0432\u0437\u0434\u0440\u043E\u0433\u043D\u0443\u043B. \u0412\u043E\u0437\u043D\u0438\u0447\u0438\u0435
      \u0440\u0430\u0437\u0434\u0435\u043B\u0430\u043B\u0438 \u0442\u0443\u0448\u0443
      \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435,
      \u0437\u0430\u043F\u0430\u043B\u0438\u043B\u0438 \u043E\u0433\u043E\u043D\u044C
      \u0438\u0437 \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u043E\u0433\u043E \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0433\u043E
      \u0434\u044B\u0448\u043B\u0430. \u041C\u044F\u0441\u043E \u0436\u0451\u0441\u0442\u043A\u043E\u0435,
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0445\u0432\u043E\u0440\u044C\u044E,
      \u043D\u043E \u043B\u044E\u0434\u0438 \u0435\u0434\u044F\u0442 \u0436\u0430\u0434\u043D\u043E,
      \u043E\u0431\u0436\u0438\u0433\u0430\u044F \u043F\u0430\u043B\u044C\u0446\u044B.
      \u0425\u0432\u0430\u0442\u0438\u0442 \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439. \u0422\u0435\u043F\u0435\u0440\u044C \u0442\u044F\u043D\u0443\u0442\u044C
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443 \u043D\u0435\u043A\u043E\u043C\u0443:
      \u0445\u043E\u043C\u0443\u0442 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u0442\u044C, \u0442\u0435\u043B\u0435\u0433\u0430
      \u0441\u043A\u0440\u0438\u043F\u0438\u0442 \u043F\u043E\u0434 \u043F\u0435\u0440\u0435\u043A\u043E\u0441\u0438\u0432\u0448\u0435\u0439\u0441\u044F
      \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643547
    m_Localized: "\u041F\u043E\u0441\u043B\u0430\u0442\u044C \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432
      \u0432 \u0441\u0442\u0435\u043F\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643548
    m_Localized: "\u0422\u0440\u043E\u0435 \u0443\u0448\u043B\u0438 \u043D\u0430
      \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u0441 \u043B\u0443\u043A\u0430\u043C\u0438
      \u0438 \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u043C\u0438. \u041A \u043F\u043E\u043B\u0443\u0434\u043D\u044E
      \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C: \u0434\u0432\u043E\u0435
      \u043D\u0435\u0441\u0443\u0442 \u043C\u043E\u043B\u043E\u0434\u0443\u044E \u0430\u043D\u0442\u0438\u043B\u043E\u043F\u0443
      \u043D\u0430 \u0448\u0435\u0441\u0442\u0435, \u0442\u0440\u0435\u0442\u0438\u0439
      \u0442\u0430\u0449\u0438\u0442 \u043C\u0435\u0448\u043E\u043A \u043A\u043E\u0440\u0435\u043D\u044C\u0435\u0432
      \u0438 \u0434\u0438\u043A\u043E\u0433\u043E \u043B\u0443\u043A\u0430. \u0412
      \u0442\u043E\u0442 \u0432\u0435\u0447\u0435\u0440, \u0432\u043F\u0435\u0440\u0432\u044B\u0435
      \u0437\u0430 \u043D\u0435\u0434\u0435\u043B\u044E, \u043B\u0430\u0433\u0435\u0440\u044C
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0436\u0430\u0440\u0435\u043D\u044B\u043C
      \u043C\u044F\u0441\u043E\u043C. \u041B\u044E\u0434\u0438 \u043E\u0436\u0438\u0432\u0438\u043B\u0438\u0441\u044C.
      \u041E\u0441\u0442\u0430\u0442\u043A\u0438 \u043C\u044F\u0441\u0430 \u0432\u044B\u0441\u0443\u0448\u0438\u043B\u0438
      \u0432 \u0434\u043E\u0440\u043E\u0433\u0443 - \u0445\u0432\u0430\u0442\u0438\u0442
      \u0435\u0449\u0451 \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643549
    m_Localized: "\u041E\u0445\u043E\u0442\u043D\u0438\u043A\u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u043F\u043E\u0441\u043B\u0435 \u0442\u0435\u043C\u043D\u043E\u0442\u044B \u0441
      \u043F\u0443\u0441\u0442\u044B\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438:
      \u043E\u0434\u0438\u043D \u0445\u0440\u043E\u043C\u0430\u0435\u0442, \u0432\u0442\u043E\u0440\u043E\u0439
      \u043C\u043E\u043B\u0447\u0438\u0442, \u0442\u0440\u0435\u0442\u0438\u0439
      \u0441\u043F\u043B\u0451\u0432\u044B\u0432\u0430\u0435\u0442 \u043A\u0440\u043E\u0432\u044C.
      \u041D\u0430\u0442\u043A\u043D\u0443\u043B\u0438\u0441\u044C \u043D\u0430 \u0432\u043E\u043B\u0447\u044C\u0435
      \u043B\u043E\u0433\u043E\u0432\u043E \u0438 \u0435\u0434\u0432\u0430 \u0443\u0448\u043B\u0438.
      \u041B\u044E\u0434\u0438 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438
      \u0438\u0445 \u0442\u0438\u0448\u0438\u043D\u043E\u0439, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u0445\u0443\u0436\u0435 \u043A\u0440\u0438\u043A\u0430. \u041A \u0443\u0442\u0440\u0443
      \u0434\u0432\u043E\u0435 \u043D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u043E\u0432
      \u0438\u0441\u0447\u0435\u0437\u043B\u0438, \u043F\u0440\u0438\u0445\u0432\u0430\u0442\u0438\u0432
      \u0431\u0443\u0440\u0434\u044E\u043A \u0441 \u0432\u043E\u0434\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643550
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0433\u043E\u0442\u043E\u0432\u0438\u0442
      \u043E\u0442\u0432\u0430\u0440 \u0438\u0437 \u0442\u0440\u0430\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643551
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0448\u0451\u043B \u0432\u0434\u043E\u043B\u044C
      \u0434\u043E\u0440\u043E\u0433\u0438, \u0441\u043E\u0431\u0438\u0440\u0430\u044F
      \u0442\u043E, \u043D\u0430 \u0447\u0442\u043E \u0434\u0440\u0443\u0433\u0438\u0435
      \u043D\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u043B\u0438 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F:
      \u0449\u0430\u0432\u0435\u043B\u044C, \u043A\u043E\u0440\u043D\u0438 \u043B\u043E\u043F\u0443\u0445\u0430,
      \u0441\u0442\u0435\u0431\u043B\u0438 \u0434\u0438\u043A\u043E\u0433\u043E \u0447\u0435\u0441\u043D\u043E\u043A\u0430,
      \u0433\u043E\u0440\u0441\u0442\u044C \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0445
      \u0447\u044C\u0438\u043C-\u0442\u043E \u0447\u0443\u0436\u0438\u043C \u043C\u0435\u0448\u043A\u043E\u043C
      \u0437\u0451\u0440\u0435\u043D \u044F\u0447\u043C\u0435\u043D\u044F. \u041A
      \u0432\u0435\u0447\u0435\u0440\u0443 \u043D\u0430\u0434 \u043E\u0433\u043D\u0451\u043C
      \u043A\u0438\u043F\u0435\u043B \u0433\u0443\u0441\u0442\u043E\u0439 \u043E\u0442\u0432\u0430\u0440
      - \u0433\u043E\u0440\u044C\u043A\u0438\u0439, \u043D\u043E \u0441\u044B\u0442\u043D\u044B\u0439.
      \u041B\u0435\u043A\u0430\u0440\u044C \u0434\u043E\u0431\u0430\u0432\u0438\u043B
      \u0442\u043E\u043B\u0447\u0451\u043D\u044B\u0439 \u043A\u043E\u0440\u0435\u043D\u044C,
      \u0441\u043D\u044F\u0432\u0448\u0438\u0439 \u0434\u0440\u043E\u0436\u044C \u0443
      \u043B\u044E\u0434\u0435\u0439. \xAB\u042D\u0442\u043E \u043D\u0435 \u0435\u0434\u0430
      - \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F. \u0414\u0432\u0430 \u0434\u043D\u044F.
      \u0425\u0432\u0430\u0442\u0438\u0442, \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u0433\u043E\u0440\u043E\u0434\u0430\xBB. \u041E\u0431\u0442\u0451\u0440
      \u043E\u0441\u0442\u0430\u0442\u043A\u0438 \u043C\u044F\u0441\u0430 \u0441
      \u043A\u043E\u0441\u0442\u0435\u0439 \u0431\u044B\u043A\u0430 \u0438 \u0437\u0430\u0432\u0435\u0440\u043D\u0443\u043B
      \u0432 \u0442\u0440\u044F\u043F\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643552
    m_Localized: "\u041C\u044F\u0442\u0435\u0436 \u043D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643553
    m_Localized: "\u041A\u0440\u0438\u043A \u0440\u0430\u0437\u043E\u0440\u0432\u0430\u043B
      \u0443\u0442\u0440\u0435\u043D\u043D\u044E\u044E \u0442\u0438\u0448\u0438\u043D\u0443.
      \u041D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0438 \u043F\u043E\u0431\u0440\u043E\u0441\u0430\u043B\u0438
      \u0442\u044E\u043A\u0438 \u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u0434\u043E\u0440\u043E\u0433\u0438
      \u0438 \u0441\u0442\u043E\u044F\u0442 \u0441\u0442\u0435\u043D\u043E\u0439:
      \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0441 \u043F\u0430\u043B\u043A\u0430\u043C\u0438, \u0433\u0440\u0443\u0437\u043E\u0432\u044B\u043C\u0438
      \u043A\u0440\u044E\u043A\u0430\u043C\u0438 \u0438 \u043A\u043E\u043B\u044C\u044F\u043C\u0438
      \u043E\u0442 \u043F\u0430\u043B\u0430\u0442\u043A\u0438. \u0412\u043F\u0435\u0440\u0435\u0434\u0438
      \u043A\u0440\u044F\u0436\u0438\u0441\u0442\u044B\u0439 \u043C\u0443\u0436\u0447\u0438\u043D\u0430
      \u0441 \u0431\u0430\u0433\u0440\u043E\u0432\u044B\u043C \u0448\u0440\u0430\u043C\u043E\u043C
      \u0447\u0435\u0440\u0435\u0437 \u0441\u043A\u0443\u043B\u0443, \u0431\u044B\u0432\u0448\u0438\u0439
      \u0441\u043E\u043B\u0434\u0430\u0442. \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0437\u0430 \u0432\u0441\u0435\u0445: \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u0435
      \u043D\u0435 \u043F\u043B\u0430\u0442\u0438\u043B\u0438 \u0434\u0432\u0430
      \u043C\u0435\u0441\u044F\u0446\u0430, \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u0433\u043D\u0438\u043B\u044B\u0435, \u0430 \u0445\u043E\u0437\u044F\u0438\u043D
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0440\u0430\u0437\u044A\u0435\u0437\u0436\u0430\u0435\u0442
      \u043D\u0430 \u043C\u044F\u0433\u043A\u0438\u0445 \u043F\u043E\u0434\u0443\u0448\u043A\u0430\u0445.
      \u041E\u043D\u0438 \u0442\u0440\u0435\u0431\u0443\u044E\u0442 \u0434\u0432\u043E\u0439\u043D\u0443\u044E
      \u043E\u043F\u043B\u0430\u0442\u0443, \u043F\u0440\u044F\u043C\u043E \u0441\u0435\u0439\u0447\u0430\u0441,
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C \u043D\u0430 \u043B\u0430\u0434\u043E\u043D\u044C.
      \u0418\u043D\u0430\u0447\u0435 \u0431\u0440\u043E\u0441\u044F\u0442 \u0433\u0440\u0443\u0437
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u0438 \u0443\u0439\u0434\u0443\u0442.
      \u0417\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 \u0437\u0430\u0447\u0438\u043D\u0449\u0438\u043A\u0430
      \u043A\u0442\u043E-\u0442\u043E \u0434\u043E\u0441\u0442\u0430\u043B \u043D\u043E\u0436.\r\n\r\n<npc_speech
      lang=\"Arabic\">\u042D\u0439, \u0445\u043E\u0437\u044F\u0438\u043D \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430!
      \u041C\u044B \u043D\u0435 \u0440\u0430\u0431\u044B! \u041E\u0442\u0434\u0430\u0439
      \u043D\u0430\u043C \u043D\u0430\u0448\u0438 \u043F\u0440\u0430\u0432\u0430,
      \u0438\u043B\u0438 \u043C\u044B \u0431\u0440\u043E\u0441\u0438\u043C \u0432\u0441\u0451
      \u0437\u0434\u0435\u0441\u044C \u0438 \u0443\u0439\u0434\u0451\u043C!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643554
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643555
    m_Localized: "\u0412\u044B \u0440\u0430\u0437\u0432\u044F\u0437\u0430\u043B\u0438
      \u043A\u043E\u0448\u0435\u043B\u044C \u0438 \u043E\u0442\u0441\u0447\u0438\u0442\u0430\u043B\u0438
      \u043C\u043E\u043D\u0435\u0442\u044B, \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E,
      \u043D\u0430 \u0432\u0438\u0434\u0443 \u0443 \u0432\u0441\u0435\u0445. \u0421\u0435\u0440\u0435\u0431\u0440\u043E
      \u0437\u0432\u0435\u043D\u0435\u043B\u043E \u043E \u043B\u0430\u0434\u043E\u043D\u0438,
      \u0438 \u0441 \u043A\u0430\u0436\u0434\u043E\u0439 \u043C\u043E\u043D\u0435\u0442\u043E\u0439
      \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u0442\u0430\u044F\u043B\u043E.
      \u0417\u0430\u0447\u0438\u043D\u0449\u0438\u043A \u0441\u0433\u0440\u0451\u0431
      \u0434\u0435\u043D\u044C\u0433\u0438, \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043B,
      \u043A\u0438\u0432\u043D\u0443\u043B. \u041D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0438
      \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043B\u0438 \u0442\u044E\u043A\u0438
      \u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u043D\u0430
      \u043C\u0435\u0441\u0442\u0430. \u041C\u044F\u0442\u0435\u0436 \u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F,
      \u043D\u043E \u043A\u043E\u0448\u0435\u043B\u044C \u043F\u043E\u043B\u0435\u0433\u0447\u0430\u043B
      \u0432\u0434\u0432\u043E\u0435, \u0430 \u0432 \u0433\u043B\u0430\u0437\u0430\u0445
      \u0431\u044B\u0432\u0448\u0435\u0433\u043E \u0441\u043E\u043B\u0434\u0430\u0442\u0430
      \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u0435
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043F\u043E\u043D\u044F\u0432\u0448\u0435\u0433\u043E
      \u0441\u0432\u043E\u044E \u0441\u0438\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643556
    m_Localized: "\u0423\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0438 \u043F\u0440\u0438\u0441\u0442\u044B\u0434\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643557
    m_Localized: "\u0412\u044B \u043D\u0435 \u0441\u0442\u0430\u043B\u0438 \u043A\u0440\u0438\u0447\u0430\u0442\u044C.
      \u041F\u043E\u0434\u043E\u0448\u043B\u0438 \u043A \u0437\u0430\u0447\u0438\u043D\u0449\u0438\u043A\u0443,
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u0432 \u0433\u043B\u0430\u0437\u0430
      \u0438 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438 \u0442\u0438\u0445\u043E,
      \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B \u0441\u043B\u044B\u0448\u0430\u043B\u0438
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0432\u044B\u0435 \u0440\u044F\u0434\u044B.
      \u041E \u0434\u043E\u0440\u043E\u0433\u0435, \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043D\u043E\u0439
      \u0432\u043C\u0435\u0441\u0442\u0435. \u041E \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0430\u0445,
      \u0447\u0442\u043E \u043D\u0435 \u0434\u043E\u0448\u043B\u0438. \u041E \u0433\u043E\u0440\u043E\u0434\u0435
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438, \u0433\u0434\u0435 \u0436\u0434\u0443\u0442
      \u0440\u044B\u043D\u043A\u0438 \u0438 \u0433\u043E\u0440\u044F\u0447\u0430\u044F
      \u0435\u0434\u0430. \u041F\u043E\u0442\u043E\u043C \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u043A \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C: \xAB\u041A\u0442\u043E
      \u0438\u0437 \u0432\u0430\u0441 \u0445\u043E\u0447\u0435\u0442 \u0431\u0440\u043E\u0441\u0438\u0442\u044C
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0437\u0430 \u0434\u0432\u0430
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430 \u0434\u043E \u0431\u0430\u0437\u0430\u0440\u0430?\xBB
      \u041C\u043E\u043B\u0447\u0430\u043D\u0438\u0435. \u0417\u0430\u0447\u0438\u043D\u0449\u0438\u043A
      \u043E\u043F\u0443\u0441\u0442\u0438\u043B \u043A\u0440\u044E\u043A. \u041D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A
      \u0441 \u043D\u043E\u0436\u043E\u043C \u0441\u043F\u0440\u044F\u0442\u0430\u043B
      \u0435\u0433\u043E \u043E\u0431\u0440\u0430\u0442\u043D\u043E. \u041B\u044E\u0434\u0438
      \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C - \u043C\u043E\u043B\u0447\u0430,
      \u043D\u043E \u0431\u0435\u0437 \u043D\u0435\u043D\u0430\u0432\u0438\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643558
    m_Localized: "\u0421\u043B\u043E\u0432\u0430 \u0443\u0432\u044F\u0437\u043B\u0438
      \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435, \u043A\u0430\u043A \u043A\u0430\u043C\u043D\u0438
      \u0432 \u0431\u043E\u043B\u043E\u0442\u0435. \u0417\u0430\u0447\u0438\u043D\u0449\u0438\u043A
      \u0440\u0430\u0441\u0445\u043E\u0445\u043E\u0442\u0430\u043B\u0441\u044F: \xAB\u041A\u0440\u0430\u0441\u0438\u0432\u043E
      \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C, \u0445\u043E\u0437\u044F\u0438\u043D.
      \u0410 \u043C\u044B \u0436\u0440\u0430\u0442\u044C \u0431\u0443\u0434\u0435\u043C
      \u0442\u0432\u043E\u0438 \u0440\u0435\u0447\u0438?\xBB \u0422\u043E\u043B\u043F\u0430
      \u043A\u0430\u0447\u043D\u0443\u043B\u0430\u0441\u044C \u0432\u043F\u0435\u0440\u0451\u0434.
      \u041A\u0442\u043E-\u0442\u043E \u0432\u0441\u043F\u043E\u0440\u043E\u043B
      \u0442\u044E\u043A \u043D\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0435
      \u0438 \u0432\u044B\u0442\u0440\u044F\u0445\u043D\u0443\u043B \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443. \u041F\u043E\u043A\u0430
      \u0432\u044B \u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C \u043D\u0430\u0432\u0435\u0441\u0442\u0438
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A, \u0442\u0440\u043E\u0435 \u0443\u0448\u043B\u0438,
      \u043F\u0440\u0438\u0445\u0432\u0430\u0442\u0438\u0432 \u043C\u0435\u0448\u043E\u043A
      \u0441 \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0435\u0439 \u0438 \u043E\u0434\u0438\u043D
      \u0438\u0437 \u0442\u044E\u043A\u043E\u0432. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u043D\u0430 \u043C\u0435\u0441\u0442\u0430
      - \u043D\u043E \u0434\u043E\u0432\u0435\u0440\u0438\u044F \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643559
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0432\u0441\u0442\u0430\u0451\u0442
      \u0440\u044F\u0434\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643560
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043D\u0435 \u0441\u0442\u0430\u043B
      \u0436\u0434\u0430\u0442\u044C \u043F\u0440\u0438\u043A\u0430\u0437\u0430.
      \u0412\u044B\u0448\u0435\u043B \u0432\u043F\u0435\u0440\u0451\u0434, \u0432\u0441\u0442\u0430\u043B
      \u0440\u044F\u0434\u043E\u043C \u0441 \u0432\u0430\u043C\u0438. \u041C\u043E\u043B\u0447\u0430,
      \u043D\u0435 \u043A\u0430\u0441\u0430\u044F\u0441\u044C \u043E\u0440\u0443\u0436\u0438\u044F.
      \u041F\u0440\u043E\u0441\u0442\u043E \u0432\u0441\u0442\u0430\u043B. \u0411\u044B\u0432\u0448\u0438\u0439
      \u0441\u043E\u043B\u0434\u0430\u0442 \u0443\u0437\u043D\u0430\u043B \u043F\u043E\u0432\u0430\u0434\u043A\u0443:
      \u0441\u043B\u0443\u0436\u0438\u0432\u044B\u0439 \u043F\u0440\u043E\u0442\u0438\u0432
      \u0441\u043B\u0443\u0436\u0438\u0432\u043E\u0433\u043E. \u041E\u043D\u0438
      \u043C\u0435\u0440\u044F\u043B\u0438\u0441\u044C \u0432\u0437\u0433\u043B\u044F\u0434\u0430\u043C\u0438
      \u0434\u0435\u0441\u044F\u0442\u044C \u0443\u0434\u0430\u0440\u043E\u0432 \u0441\u0435\u0440\u0434\u0446\u0430.
      \u041F\u043E\u0442\u043E\u043C \u0437\u0430\u0447\u0438\u043D\u0449\u0438\u043A
      \u0441\u043F\u043B\u044E\u043D\u0443\u043B \u0438 \u0431\u0443\u0440\u043A\u043D\u0443\u043B:
      \xAB\u041B\u0430\u0434\u043D\u043E. \u041D\u043E \u0432 \u0433\u043E\u0440\u043E\u0434\u0435
      - \u0440\u0430\u0441\u0447\u0451\u0442. \u041F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E.\xBB
      \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043A\u0438\u0432\u043D\u0443\u043B.
      \u041D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0438 \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043B\u0438
      \u0442\u044E\u043A\u0438. \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043B
      \u043B\u0438\u0446\u0430 - \u0430 \u044D\u0442\u043E \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435
      \u0434\u043E\u0440\u043E\u0436\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643561
    m_Localized: "\u0421\u043B\u0443\u0445\u0438 \u043E \u0447\u0443\u043C\u0435
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643562
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u043D\u044B\u0439 \u043F\u0443\u0442\u043D\u0438\u043A,
      \u043E\u0431\u043E\u0440\u0432\u0430\u043D\u043D\u044B\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043C\u0443\u043B\u043E\u0432 \u0441 \u0431\u0435\u0437\u0443\u043C\u043D\u044B\u043C\u0438
      \u0433\u043B\u0430\u0437\u0430\u043C\u0438, \u043A\u0440\u0438\u0447\u0438\u0442,
      \u0440\u0430\u0437\u043C\u0430\u0445\u0438\u0432\u0430\u044F \u0440\u0443\u043A\u0430\u043C\u0438:
      \u0433\u043E\u0440\u043E\u0434 \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u0437\u0430\u043A\u0440\u044B\u0442.
      \u0427\u0443\u043C\u0430. \u0422\u0440\u0443\u043F\u044B \u043B\u0435\u0436\u0430\u0442
      \u043D\u0430 \u0443\u043B\u0438\u0446\u0430\u0445, \u0432\u043E\u0440\u043E\u0442\u0430
      \u0437\u0430\u043A\u043E\u043B\u043E\u0447\u0435\u043D\u044B \u0438\u0437\u043D\u0443\u0442\u0440\u0438,
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438 \u0441\u0442\u0440\u0435\u043B\u044F\u044E\u0442
      \u0432 \u043A\u0430\u0436\u0434\u043E\u0433\u043E, \u043A\u0442\u043E \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0435\u0442\u0441\u044F.
      \u041F\u0440\u0430\u0432\u0434\u0430 \u044D\u0442\u043E \u0438\u043B\u0438
      \u043F\u0430\u043D\u0438\u043A\u0430, \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E,
      \u043D\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0443\u0436\u0435 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u0432\u043F\u0435\u0440\u0451\u0434 \u0432\u0435\u0434\u0451\u0442
      \u043F\u0440\u044F\u043C\u043E \u043A \u0437\u0430\u043F\u0435\u0440\u0442\u044B\u043C
      \u0432\u043E\u0440\u043E\u0442\u0430\u043C. \u041E\u0431\u044A\u0435\u0437\u0434
      \u0437\u0430\u0439\u043C\u0451\u0442 \u043D\u0435\u0434\u0435\u043B\u044E \u0438
      \u0438\u0441\u0442\u043E\u0449\u0438\u0442 \u043F\u0440\u0438\u043F\u0430\u0441\u044B.
      \u0410 \u043C\u043E\u0436\u043D\u043E \u0440\u0438\u0441\u043A\u043D\u0443\u0442\u044C
      \u0438 \u043F\u043E\u0434\u043E\u0439\u0442\u0438 \u0431\u043B\u0438\u0436\u0435
      - \u0432\u0434\u0440\u0443\u0433 \u0441\u043B\u0443\u0445\u0438 \u043F\u0440\u0435\u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u044B,
      \u0438 \u0433\u043E\u0440\u043E\u0434 \u0442\u043E\u0440\u0433\u0443\u0435\u0442
      \u0447\u0435\u0440\u0435\u0437 \u0432\u043D\u0435\u0448\u043D\u0438\u0439 \u043A\u0430\u0440\u0430\u043D\u0442\u0438\u043D.\r\n\r\n<npc_speech
      lang=\"Persian\">\u041D\u0430\u0437\u0430\u0434! \u041D\u0430\u0437\u0430\u0434!
      \u0413\u043E\u0440\u043E\u0434 \u043C\u0451\u0440\u0442\u0432! \u0427\u0443\u043C\u0430
      \u0432\u0441\u0435\u0445 \u0443\u0431\u0438\u043B\u0430 - \u044F \u043E\u0434\u0438\u043D
      \u0441\u043F\u0430\u0441\u0441\u044F!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643563
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u0433\u043E\u0440\u043E\u0434
      \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643564
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0441\u0432\u0435\u0440\u043D\u0443\u043B
      \u043D\u0430 \u043F\u0440\u043E\u0441\u0451\u043B\u043E\u043A, \u043E\u0433\u0438\u0431\u0430\u044F
      \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0435 \u0441\u0442\u0435\u043D\u044B
      \u043F\u043E \u0448\u0438\u0440\u043E\u043A\u043E\u0439 \u0434\u0443\u0433\u0435.
      \u0422\u0440\u0438 \u0434\u043D\u044F \u043F\u043E \u0431\u0435\u0437\u0434\u043E\u0440\u043E\u0436\u044C\u044E,
      \u0431\u0435\u0437 \u043A\u043E\u043B\u043E\u0434\u0446\u0435\u0432 \u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0435\u0432.
      \u041F\u0440\u0438\u043F\u0430\u0441\u044B \u0442\u0430\u044E\u0442, \u043B\u044E\u0434\u0438
      \u0432\u043E\u0440\u0447\u0430\u0442, \u0432\u043E\u043B\u044B \u0435\u043B\u0435
      \u0442\u044F\u043D\u0443\u0442 \u043F\u043E \u0440\u0430\u0437\u043C\u044B\u0442\u043E\u0439
      \u043A\u043E\u043B\u0435\u0435. \u041D\u043E \u0436\u0438\u0432\u044B. \u041D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u043A\u0430\u0448\u043B\u044F\u0435\u0442, \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u043F\u043E\u043A\u0440\u044B\u043B\u0441\u044F \u044F\u0437\u0432\u0430\u043C\u0438.
      \u0413\u043E\u0440\u043E\u0434 \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0437\u0430
      \u0441\u043F\u0438\u043D\u043E\u0439 \u0442\u0451\u043C\u043D\u044B\u043C \u0441\u0438\u043B\u0443\u044D\u0442\u043E\u043C,
      \u0438 \u0434\u044B\u043C \u043D\u0430\u0434 \u043D\u0438\u043C \u043A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E \u0434\u043D\u044F \u0441\u0442\u0430\u043B
      \u0433\u0443\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643565
    m_Localized: "\u041F\u043E\u0434\u043E\u0439\u0442\u0438 \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643566
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u043E\u0448\u043B\u0438 \u043A
      \u0441\u0442\u0435\u043D\u0430\u043C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E,
      \u0431\u0435\u043B\u044B\u043C \u0444\u043B\u0430\u0433\u043E\u043C \u043D\u0430
      \u043F\u0430\u043B\u043A\u0435. \u0427\u0443\u043C\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043D\u0435 \u0432\u044B\u0434\u0443\u043C\u043A\u043E\u0439, \u043D\u043E
      \u0433\u043E\u0440\u043E\u0434 \u043D\u0435 \u043C\u0451\u0440\u0442\u0432.
      \u0417\u0430 \u0432\u043D\u0435\u0448\u043D\u0438\u043C\u0438 \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438
      \u0443\u0441\u0442\u0440\u043E\u0435\u043D \u043A\u0430\u0440\u0430\u043D\u0442\u0438\u043D\u043D\u044B\u0439
      \u0440\u044B\u043D\u043E\u043A: \u0442\u043E\u0432\u0430\u0440\u044B \u043F\u0435\u0440\u0435\u0434\u0430\u044E\u0442
      \u0447\u0435\u0440\u0435\u0437 \u0449\u0435\u043B\u044C \u0432 \u0441\u0442\u0435\u043D\u0435,
      \u043C\u043E\u043D\u0435\u0442\u044B \u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442
      \u0432 \u0443\u043A\u0441\u0443\u0441. \u0426\u0435\u043D\u044B \u0431\u0435\u0437\u0443\u043C\u043D\u044B\u0435:
      \u0433\u043E\u0440\u043E\u0436\u0430\u043D\u0435 \u0432 \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u0438
      \u0438 \u043F\u043B\u0430\u0442\u044F\u0442 \u0432\u0442\u0440\u043E\u0435
      \u0437\u0430 \u043F\u0440\u0438\u043F\u0430\u0441\u044B. \u0412\u044B \u043F\u0440\u043E\u0434\u0430\u043B\u0438
      \u0447\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430 \u043F\u043E
      \u0446\u0435\u043D\u0430\u043C, \u043E \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043E\u0431\u044B\u0447\u043D\u043E \u043D\u0435 \u043C\u0435\u0447\u0442\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643567
    m_Localized: "\u0421\u0442\u0435\u043D\u044B \u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0442\u0438\u0445\u0438\u043C\u0438. \u0412\u044B \u043F\u043E\u0434\u043E\u0448\u043B\u0438
      \u0431\u043B\u0438\u0436\u0435, \u0438 \u0442\u0443\u0442 \u0432\u0435\u0442\u0435\u0440
      \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u0438\u043B\u0441\u044F. \u0421\u043C\u0440\u0430\u0434
      \u0443\u0434\u0430\u0440\u0438\u043B \u0432 \u043B\u0438\u0446\u043E: \u0441\u043B\u0430\u0434\u043A\u043E\u0432\u0430\u0442\u044B\u0439,
      \u0442\u044F\u0436\u0451\u043B\u044B\u0439, \u0431\u0435\u0437\u043E\u0448\u0438\u0431\u043E\u0447\u043D\u044B\u0439
      \u0437\u0430\u043F\u0430\u0445 \u043C\u043E\u0440\u0430. \u0423 \u0432\u043E\u0440\u043E\u0442
      \u043B\u0435\u0436\u0430\u043B\u0438 \u0442\u0435\u043B\u0430, \u043E\u0431\u043B\u0435\u043F\u043B\u0435\u043D\u043D\u044B\u0435
      \u043C\u0443\u0445\u0430\u043C\u0438. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0431\u0440\u043E\u0441\u0438\u043B\u0441\u044F \u043F\u0440\u043E\u0447\u044C,
      \u043D\u043E \u0431\u044B\u043B\u043E \u043F\u043E\u0437\u0434\u043D\u043E:
      \u043A \u0432\u0435\u0447\u0435\u0440\u0443 \u0443 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F
      \u0436\u0430\u0440. \u0427\u0451\u0440\u043D\u044B\u0435 \u043F\u044F\u0442\u043D\u0430
      \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C \u043D\u0430 \u0442\u0440\u0435\u0442\u0438\u0439
      \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643568
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0437\u043D\u0430\u0435\u0442
      \u043E\u0431\u0445\u043E\u0434\u043D\u044B\u0435 \u0440\u044B\u043D\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643569
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B
      \u043A\u0440\u0438\u043A\u0443\u043D\u0430, \u043F\u043E\u0447\u0435\u0441\u0430\u043B
      \u0431\u043E\u0440\u043E\u0434\u0443 \u0438 \u0441\u043A\u0430\u0437\u0430\u043B:
      \xAB\u042F \u0437\u043D\u0430\u044E \u044D\u0442\u043E\u0442 \u0433\u043E\u0440\u043E\u0434.
      \u0415\u0441\u0442\u044C \u043F\u043E\u0434\u0432\u043E\u0440\u044C\u0435 \u0437\u0430
      \u044E\u0436\u043D\u043E\u0439 \u0441\u0442\u0435\u043D\u043E\u0439 - \u043A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u0438\u0439
      \u0434\u0432\u043E\u0440 \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u0442\u043E
      \u043D\u0435 \u0432\u0445\u043E\u0434\u0438\u0442 \u0432 \u0432\u043E\u0440\u043E\u0442\u0430.
      \u0422\u0430\u043C \u0442\u043E\u0440\u0433\u0443\u044E\u0442 \u0447\u0435\u0440\u0435\u0437
      \u043E\u0433\u0440\u0430\u0434\u0443, \u0430 \u0432\u043E\u0434\u0430 \u0438\u0437
      \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0433\u043E \u043A\u043E\u043B\u043E\u0434\u0446\u0430.\xBB
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0431\u043E\u0448\u0451\u043B
      \u0433\u043E\u0440\u043E\u0434 \u0438 \u043D\u0430\u0448\u0451\u043B \u043F\u043E\u0434\u0432\u043E\u0440\u044C\u0435:
      \u0434\u0435\u0441\u044F\u0442\u043E\u043A \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432
      \u0443\u0436\u0435 \u0441\u0442\u043E\u044F\u043B\u0438 \u043B\u0430\u0433\u0435\u0440\u0435\u043C,
      \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u044F\u0441\u044C \u0442\u043E\u0432\u0430\u0440\u0430\u043C\u0438
      \u0447\u0435\u0440\u0435\u0437 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439
      \u0431\u0430\u0440\u044C\u0435\u0440. \u041D\u0435 \u0431\u0430\u0437\u0430\u0440,
      \u043D\u043E \u0434\u0435\u043B\u043E \u0441\u0434\u0435\u043B\u0430\u043D\u043E:
      \u0432\u044B \u043F\u0440\u043E\u0434\u0430\u043B\u0438 \u0447\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430, \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u043B\u0438
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u0438 \u0443\u0448\u043B\u0438,
      \u043D\u0435 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u044F\u0441\u044C
      \u043A \u0437\u0430\u0440\u0430\u0437\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643570
    m_Localized: "\u0414\u043E\u043B\u0433\u043E\u0432\u0430\u044F \u043B\u043E\u0432\u0443\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643571
    m_Localized: "\u041D\u0430 \u043F\u0435\u0440\u0435\u043A\u0440\u0451\u0441\u0442\u043A\u0435
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043D\u044B\u0445 \u0442\u0440\u043E\u043F
      \u0432\u0430\u0441 \u0436\u0434\u0451\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0432 \u0442\u0451\u043C\u043D\u043E-\u0441\u0438\u043D\u0435\u043C \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C
      \u043A\u0430\u0444\u0442\u0430\u043D\u0435 \u0441 \u043F\u043E\u0442\u0451\u0440\u0442\u043E\u0439
      \u0437\u043E\u043B\u043E\u0442\u043E\u0439 \u0432\u044B\u0448\u0438\u0432\u043A\u043E\u0439.
      \u0417\u0430 \u043D\u0438\u043C \u0434\u0432\u043E\u0435 \u043A\u0440\u0435\u043F\u043A\u0438\u0445
      \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u044B\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432
      \u0441 \u043F\u0430\u043B\u0438\u0446\u0430\u043C\u0438. \u041E\u043D \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F,
      \u043A\u0430\u043A \u0441\u0442\u0430\u0440\u044B\u0439 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439,
      \u0438 \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0438\u0437 \u043A\u043E\u0436\u0430\u043D\u043E\u0439
      \u0441\u0443\u043C\u043A\u0438 \u0434\u043E\u043B\u0433\u043E\u0432\u0443\u044E
      \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0443 \u0441 \u0432\u0430\u0448\u0435\u0439
      \u043F\u0435\u0447\u0430\u0442\u044C\u044E. \u0417\u0430\u0451\u043C, \u0432\u0437\u044F\u0442\u044B\u0439
      \u0442\u0440\u0438 \u0433\u043E\u0440\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434
      \u043D\u0430 \u0437\u0430\u043A\u0443\u043F\u043A\u0443 \u0442\u043E\u0432\u0430\u0440\u0430,
      \u0441 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u0430\u043C\u0438 \u0432\u044B\u0440\u043E\u0441
      \u0432\u0442\u0440\u043E\u0435. \u0421\u0440\u043E\u043A \u0438\u0441\u0442\u0451\u043A.
      \u041E\u043D \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0430:
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C \u0438\u043B\u0438 \u0442\u043E\u0432\u0430\u0440\u043E\u043C.
      \u0415\u0441\u043B\u0438 \u043D\u0435 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u0435,
      \u0435\u0433\u043E \u043B\u044E\u0434\u0438 \u043E\u043F\u0438\u0448\u0443\u0442
      \u0432\u0430\u0448 \u0433\u0440\u0443\u0437, \u0430 \u0441\u043B\u043E\u0432\u043E
      \u043E \u043D\u0435\u043F\u043B\u0430\u0442\u0451\u0436\u0435\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
      \u0440\u0430\u0437\u043B\u0435\u0442\u0438\u0442\u0441\u044F \u043F\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u044F\u043C
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0432\u0435\u0442\u0440\u0430.\r\n\r\n<npc_speech
      lang=\"Sogdian\">\u041F\u0440\u0438\u0432\u0435\u0442, \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A!
      \u041F\u043E\u043C\u043D\u0438\u0448\u044C - \u0441\u0435\u0440\u0435\u0431\u0440\u043E,
      \u0447\u0442\u043E \u0431\u0440\u0430\u043B, \u043D\u0430\u0434\u043E \u0432\u0435\u0440\u043D\u0443\u0442\u044C.
      \u0421\u0440\u043E\u043A \u0432\u044B\u0448\u0435\u043B. \u0427\u0435\u043C
      \u043F\u043B\u0430\u0442\u0438\u0448\u044C - \u0437\u043E\u043B\u043E\u0442\u043E\u043C
      \u0438\u043B\u0438 \u0442\u043E\u0432\u0430\u0440\u043E\u043C?</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643572
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u0447\u0430\u0441\u0442\u044C
      \u0442\u043E\u0432\u0430\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643573
    m_Localized: "\u0412\u044B \u0441\u0446\u0435\u043F\u0438\u043B\u0438 \u0437\u0443\u0431\u044B
      \u0438 \u043A\u0438\u0432\u043D\u0443\u043B\u0438. \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438
      \u0434\u0435\u043B\u043E\u0432\u0438\u0442\u043E \u0432\u0441\u043A\u0440\u044B\u043B\u0438
      \u0434\u0432\u0430 \u0442\u044E\u043A\u0430, \u0432\u0437\u0432\u0435\u0441\u0438\u043B\u0438
      \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435 \u043D\u0430 \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0445
      \u0432\u0435\u0441\u0430\u0445 \u0438 \u043F\u043E\u0433\u0440\u0443\u0437\u0438\u043B\u0438
      \u043D\u0430 \u0441\u0432\u043E\u0435\u0433\u043E \u043C\u0443\u043B\u0430.
      \u0420\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A \u0441\u0432\u0435\u0440\u043D\u0443\u043B
      \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0443 \u0438 \u0441\u0436\u0451\u0433
      \u043D\u0430 \u043E\u0433\u043D\u0435 \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0439
      \u043B\u0430\u043C\u043F\u044B. \xAB\u0414\u043E\u043B\u0433 \u0437\u0430\u043A\u0440\u044B\u0442\xBB,
      - \u0441\u043A\u0430\u0437\u0430\u043B \u043E\u043D \u0440\u043E\u0432\u043D\u043E
      \u0438 \u0443\u0448\u0451\u043B, \u043D\u0435 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
      \u0432\u0441\u043B\u0435\u0434 \u043C\u043E\u043B\u0447\u0430. \u0427\u0435\u0442\u0432\u0435\u0440\u0442\u044C
      \u0442\u043E\u0432\u0430\u0440\u0430 (\u0440\u0430\u0431\u043E\u0442\u0430
      \u0434\u0432\u0443\u0445 \u043C\u0435\u0441\u044F\u0446\u0435\u0432) \u0438\u0441\u0447\u0435\u0437\u043B\u0430
      \u0437\u0430 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C \u0447\u0430\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643574
    m_Localized: "\u041E\u0441\u043F\u043E\u0440\u0438\u0442\u044C \u0434\u043E\u043B\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643575
    m_Localized: "\u0412\u044B \u0432\u0437\u044F\u043B\u0438 \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0443,
      \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0438 \u0438 \u0441\u0442\u0430\u043B\u0438
      \u0447\u0438\u0442\u0430\u0442\u044C \u0432\u0441\u043B\u0443\u0445, \u043F\u0443\u043D\u043A\u0442
      \u0437\u0430 \u043F\u0443\u043D\u043A\u0442\u043E\u043C. \u041F\u0440\u043E\u0446\u0435\u043D\u0442
      \u043D\u0430\u0447\u0438\u0441\u043B\u0435\u043D \u0434\u0432\u0430\u0436\u0434\u044B
      \u043D\u0430 \u043E\u0434\u043D\u0443 \u0441\u0443\u043C\u043C\u0443. \u0428\u0442\u0440\u0430\u0444
      \u0437\u0430 \u043F\u0440\u043E\u0441\u0440\u043E\u0447\u043A\u0443 \u043F\u0440\u043E\u043F\u0438\u0441\u0430\u043D,
      \u043D\u043E \u0434\u0430\u0442\u0430 \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430
      \u0437\u0430\u0434\u043D\u0438\u043C \u0447\u0438\u0441\u043B\u043E\u043C.
      \xAB\u0422\u044B \u043F\u043E\u0434\u0434\u0435\u043B\u0430\u043B \u0440\u0430\u0441\u0447\u0451\u0442\xBB,
      - \u0441\u043A\u0430\u0437\u0430\u043B\u0438 \u0432\u044B \u0442\u0438\u0445\u043E,
      \u043D\u043E \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B \u0441\u043B\u044B\u0448\u0430\u043B\u0438
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438. \u0420\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A
      \u043F\u043E\u0431\u043B\u0435\u0434\u043D\u0435\u043B. \u0422\u043E\u0440\u0433
      \u0431\u044B\u043B \u0436\u0451\u0441\u0442\u043A\u0438\u043C, \u043D\u043E
      \u0432 \u0438\u0442\u043E\u0433\u0435 \u0432\u044B \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B\u0438
      \u0447\u0435\u0441\u0442\u043D\u0443\u044E \u0441\u0443\u043C\u043C\u0443,
      \u0431\u0435\u0437 \u0442\u0440\u043E\u0439\u043D\u043E\u0439 \u043D\u0430\u043A\u0440\u0443\u0442\u043A\u0438.
      \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u043B\u0438\u0441\u044C
      \u0438 \u0447\u0443\u0442\u044C \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438
      \u043F\u0430\u043B\u0438\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643576
    m_Localized: "\u0412\u044B \u0442\u043A\u043D\u0443\u043B\u0438 \u043F\u0430\u043B\u044C\u0446\u0435\u043C
      \u0432 \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0443, \u043D\u043E \u0440\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A
      \u0436\u0434\u0430\u043B \u044D\u0442\u043E\u0433\u043E. \u041E\u043D \u0434\u043E\u0441\u0442\u0430\u043B
      \u0432\u0442\u043E\u0440\u043E\u0439 \u0441\u0432\u0438\u0442\u043E\u043A:
      \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u043E\u0442 \u043C\u0435\u043D\u044F\u043B\u044B \u0432 \u0411\u0443\u0445\u0430\u0440\u0435,
      \u0437\u0430\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0435 \u043F\u0435\u0447\u0430\u0442\u044C\u044E
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438. \xAB\u041E\u0441\u043F\u0430\u0440\u0438\u0432\u0430\u0439
      \u0432 \u0441\u0443\u0434\u0435 - \u0435\u0441\u043B\u0438 \u0434\u043E\u0439\u0434\u0451\u0448\u044C.\xBB
      \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438 \u0448\u0430\u0433\u043D\u0443\u043B\u0438
      \u0432\u043F\u0435\u0440\u0451\u0434. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043E\u0442\u0434\u0430\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043E\u043D \u043F\u0440\u043E\u0441\u0438\u043B \u0438\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E:
      \u043E\u043D \u0434\u043E\u0431\u0430\u0432\u0438\u043B \u0448\u0442\u0440\u0430\u0444
      \u0437\u0430 \xAB\u043E\u0441\u043A\u043E\u0440\u0431\u043B\u0435\u043D\u0438\u0435\xBB.
      \u0421\u043B\u043E\u0432\u043E \u043E \u0432\u0430\u0448\u0435\u0439 \u043D\u0435\u0441\u0433\u043E\u0432\u043E\u0440\u0447\u0438\u0432\u043E\u0441\u0442\u0438
      \u043F\u043E\u0431\u0435\u0436\u0438\u0442 \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643577
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643578
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u044B\u0441\u0442\u0443\u043F\u0438\u043B
      \u0432\u043F\u0435\u0440\u0451\u0434 \u0438 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0441 \u0440\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A\u043E\u043C \u043D\u0430
      \u0447\u0438\u0441\u0442\u043E\u043C \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C:
      <npc_speech lang=\"Sogdian\">\u042D\u0442\u0430 \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0430
      \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u0441 \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0435\u043C
      \u0437\u0430\u043A\u043E\u043D\u0430 \u0411\u0443\u0445\u0430\u0440\u044B.
      \u0422\u044B \u044D\u0442\u043E \u0437\u043D\u0430\u0435\u0448\u044C, \u0438
      \u044F \u044D\u0442\u043E \u0437\u043D\u0430\u044E. \u0414\u0430\u0432\u0430\u0439
      \u0440\u0435\u0448\u0438\u043C \u043F\u043E-\u0447\u0435\u0441\u0442\u043D\u043E\u043C\u0443.</npc_speech>
      \u0420\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A \u043D\u0430\u0441\u0442\u043E\u0440\u043E\u0436\u0438\u043B\u0441\u044F:
      \u043F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C \u043D\u0435 \u0431\u0435\u0437\u0433\u0440\u0430\u043C\u043E\u0442\u043D\u044B\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A, \u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0437\u043D\u0430\u0435\u0442,
      \u043A\u0430\u043A \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0435
      \u0441\u0443\u0434\u044B. \u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u0448\u0451\u043B \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C \u0447\u0430\u0441\u0430.
      \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0442\u043A\u043D\u0443\u043B
      \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u0432 \u0442\u0440\u0438 \u043F\u0443\u043D\u043A\u0442\u0430
      \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0438, \u043F\u0440\u043E\u0446\u0438\u0442\u0438\u0440\u043E\u0432\u0430\u043B
      \u0437\u0430\u043A\u043E\u043D \u0411\u0443\u0445\u0430\u0440\u044B \u043E
      \u0440\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u0447\u0435\u0441\u0442\u0432\u0435
      \u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u0447\u0435\u0441\u0442\u043D\u044B\u0439
      \u0440\u0430\u0441\u0447\u0451\u0442: \u0442\u0440\u0435\u0442\u044C \u043E\u0442
      \u0442\u0440\u0435\u0431\u0443\u0435\u043C\u043E\u0433\u043E. \u0420\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A
      \u0441\u043A\u0440\u0438\u0432\u0438\u043B\u0441\u044F, \u043D\u043E \u0432\u0437\u044F\u043B
      \u0434\u0435\u043D\u044C\u0433\u0438. \u0423\u0445\u043E\u0434\u044F, \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0441\u044F: \xAB\u041E\u043D \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043F\u0440\u0438\u0434\u0451\u0442. \u042F \u0443\u043F\u043E\u043C\u044F\u043D\u0443\u043B
      \u0433\u0438\u043B\u044C\u0434\u0435\u0439\u0441\u043A\u043E\u0433\u043E \u0441\u0443\u0434\u044C\u044E
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435 - \u043E\u043D\u0438
      \u0437\u043D\u0430\u043A\u043E\u043C\u044B, \u0438 \u043D\u0435 \u0432 \u0445\u043E\u0440\u043E\u0448\u0435\u043C
      \u0441\u043C\u044B\u0441\u043B\u0435.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643579
    m_Localized: "\u0411\u0430\u0437\u0430\u0440\u043D\u0430\u044F \u0430\u0444\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643580
    m_Localized: "\u0411\u0430\u0437\u0430\u0440\u043D\u044B\u0439 \u0433\u0443\u043B
      \u043E\u0431\u0432\u043E\u043B\u0430\u043A\u0438\u0432\u0430\u0435\u0442, \u043A\u0430\u043A
      \u0436\u0430\u0440\u0430: \u043A\u0440\u0438\u043A\u0438 \u0437\u0430\u0437\u044B\u0432\u0430\u043B,
      \u0437\u0432\u043E\u043D \u0447\u0435\u043A\u0430\u043D\u043D\u044B\u0445 \u043C\u043E\u043D\u0435\u0442,
      \u0437\u0430\u043F\u0430\u0445 \u0436\u0430\u0440\u0435\u043D\u043E\u0433\u043E
      \u043A\u0443\u043D\u0436\u0443\u0442\u0430 \u0438 \u0433\u043E\u0440\u044F\u0447\u0435\u0439
      \u043C\u0435\u0434\u0438. \u0423 \u043B\u0430\u0432\u043A\u0438 \u0441 \u0442\u043A\u0430\u043D\u044F\u043C\u0438
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0440\u0430\u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043D\u0430
      \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0435 \u0440\u0443\u043B\u043E\u043D\u044B
      \u0448\u0451\u043B\u043A\u0430, \u0442\u043E\u043D\u043A\u043E\u0433\u043E,
      \u0441 \u043F\u0435\u0440\u0435\u043B\u0438\u0432\u0447\u0430\u0442\u044B\u043C
      \u0431\u043B\u0435\u0441\u043A\u043E\u043C, \u043A\u0430\u043A\u043E\u0433\u043E
      \u043D\u0435 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0448\u044C \u043D\u0430
      \u043A\u0430\u0436\u0434\u043E\u043C \u0443\u0433\u043B\u0443. \u041E\u043D
      \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F \u0442\u043A\u0430\u043D\u0438
      \u043A\u043E\u043D\u0447\u0438\u043A\u0430\u043C\u0438 \u043F\u0430\u043B\u044C\u0446\u0435\u0432,
      \u0431\u0443\u0434\u0442\u043E \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u043E\u0441\u0442\u0438,
      \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043A
      \u0432\u0430\u043C \u0441 \u0448\u0438\u0440\u043E\u043A\u043E\u0439 \u0443\u043B\u044B\u0431\u043A\u043E\u0439:\r\n\r\n<npc_speech
      lang=\"Sogdian\">\u041F\u0440\u0438\u0432\u0435\u0442, \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A!
      \u042D\u0442\u0430 \u043F\u0430\u0440\u0447\u0430 - \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u0439
      \u0448\u0451\u043B\u043A, \u043F\u0440\u044F\u043C\u043E \u0438\u0437 \u0427\u0430\u043D\u044A\u0430\u043D\u044F!
      \u0414\u0435\u0441\u044F\u0442\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0445
      - \u0434\u0435\u0448\u0435\u0432\u043B\u0435 \u043D\u0435 \u043D\u0430\u0439\u0434\u0451\u0448\u044C
      \u043D\u0438\u0433\u0434\u0435.</npc_speech>\r\n\r\n\u0426\u0435\u043D\u0430
      \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0438\u0437\u043A\u0430\u044F \u0434\u043B\u044F \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E
      \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u0433\u043E \u0448\u0451\u043B\u043A\u0430.
      \u041D\u0438\u0442\u043A\u0438 \u0431\u043B\u0435\u0441\u0442\u044F\u0442,
      \u043D\u043E \u0431\u043B\u0435\u0441\u043A \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
      \u043C\u0430\u0441\u043B\u044F\u043D\u0438\u0441\u0442\u044B\u0439 - \u0442\u043E
      \u043B\u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \u0442\u0430\u043A\u043E\u0435,
      \u0442\u043E \u043B\u0438 \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643581
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043E\u0442
      \u0441\u0434\u0435\u043B\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643582
    m_Localized: "\u0412\u044B \u043A\u0430\u0447\u0430\u0435\u0442\u0435 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
      \u0438 \u043E\u0442\u0445\u043E\u0434\u0438\u0442\u0435 \u043E\u0442 \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0430.
      \u0421\u043E\u0433\u0434\u0438\u0435\u0446 \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442
      \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438 \u0442\u0443\u0442 \u0436\u0435
      \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044F.
      \u041C\u043E\u0436\u0435\u0442, \u0448\u0451\u043B\u043A \u0438 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439,
      \u043D\u043E \u043D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435 \u043A\u0442\u043E
      \u043D\u0435 \u0440\u0438\u0441\u043A\u0443\u0435\u0442, \u0442\u043E\u0442
      \u043D\u0435 \u043F\u043B\u0430\u0442\u0438\u0442 \u0434\u0432\u0430\u0436\u0434\u044B.
      \u0421\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0438\u0435 \u0434\u043E\u0440\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643583
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0442\u043A\u0430\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643584
    m_Localized: "\u0412\u044B \u0431\u0435\u0440\u0451\u0442\u0435 \u043A\u0440\u0430\u0439
      \u0442\u043A\u0430\u043D\u0438, \u0440\u0430\u0441\u0442\u0438\u0440\u0430\u0435\u0442\u0435
      \u043C\u0435\u0436\u0434\u0443 \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438
      \u0438 \u043F\u043E\u0434\u043D\u043E\u0441\u0438\u0442\u0435 \u043A \u0441\u0432\u0435\u0442\u0443.
      \u041D\u0438\u0442\u0438 \u043D\u0435\u0440\u043E\u0432\u043D\u044B\u0435,
      \u0431\u043B\u0435\u0441\u043A \u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u043E\u0442
      \u043B\u044C\u043D\u044F\u043D\u043E\u0433\u043E \u043C\u0430\u0441\u043B\u0430,
      \u0430 \u043D\u0435 \u043E\u0442 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430
      \u043F\u0440\u044F\u0434\u0435\u043D\u0438\u044F. \xAB\u042D\u0442\u043E \u043D\u0435
      \u0447\u0430\u043D\u044A\u0430\u043D\u044C\u0441\u043A\u0438\u0439 \u0448\u0451\u043B\u043A,
      \u0430 \u0431\u0443\u0445\u0430\u0440\u0441\u043A\u0430\u044F \u043F\u043E\u043B\u0443\u0448\u0435\u0440\u0441\u0442\u044C\xBB,
      - \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u0432\u044B. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0431\u043B\u0435\u0434\u043D\u0435\u0435\u0442, \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442
      \u0446\u0435\u043D\u0443 \u0432\u0434\u0432\u043E\u0435, \u0438 \u0432\u044B
      \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E
      \u043F\u0430\u0440\u0447\u0443 \u0441 \u043D\u0438\u0436\u043D\u0435\u0439
      \u043F\u043E\u043B\u043A\u0438 (\u0442\u0443, \u0447\u0442\u043E \u043E\u043D
      \u043F\u0440\u0438\u043F\u0440\u044F\u0442\u0430\u043B \u0434\u043B\u044F \u0437\u043D\u0430\u0442\u043E\u043A\u043E\u0432)."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643585
    m_Localized: "\u0422\u043A\u0430\u043D\u044C \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E - \u0432\u044B
      \u043F\u043B\u0430\u0442\u0438\u0442\u0435 \u043F\u043E\u043B\u043D\u0443\u044E
      \u0446\u0435\u043D\u0443 \u0438 \u0443\u0445\u043E\u0434\u0438\u0442\u0435
      \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u0439. \u0427\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430 \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0430 \u0441\u0442\u0430\u0440\u044B\u0439
      \u043A\u0440\u0430\u0441\u0438\u043B\u044C\u0449\u0438\u043A \u0443 \u0444\u043E\u043D\u0442\u0430\u043D\u0430
      \u043E\u043A\u0438\u0434\u044B\u0432\u0430\u0435\u0442 \u0432\u0430\u0448 \u0441\u0432\u0451\u0440\u0442\u043E\u043A
      \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C \u0438 \u0446\u043E\u043A\u0430\u0435\u0442
      \u044F\u0437\u044B\u043A\u043E\u043C: \xAB\u041A\u0440\u0430\u0448\u0435\u043D\u044B\u0439
      \u043B\u0451\u043D, \u0434\u0440\u0443\u0433 \u043C\u043E\u0439. \u0428\u0451\u043B\u043A\u043E\u043C
      \u0442\u0443\u0442 \u0438 \u043D\u0435 \u043F\u0430\u0445\u043D\u0435\u0442\xBB.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B,
      \u0430 \u0442\u043E\u0432\u0430\u0440 \u043D\u0435 \u0441\u0442\u043E\u0438\u0442
      \u0438 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643586
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u0442
      \u0442\u043A\u0430\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643587
    m_Localized: "\u0412\u0430\u0448 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u0431\u0435\u0440\u0451\u0442 \u0440\u0443\u043B\u043E\u043D, \u043D\u044E\u0445\u0430\u0435\u0442,
      \u0434\u0451\u0440\u0433\u0430\u0435\u0442 \u043D\u0438\u0442\u044C \u0437\u0443\u0431\u0430\u043C\u0438
      \u0438 \u043C\u043E\u043B\u0447\u0430 \u043A\u043B\u0430\u0434\u0451\u0442
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E. \u0417\u0430\u0442\u0435\u043C
      \u043D\u0430\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0441\u044F \u043A \u0441\u043E\u0433\u0434\u0438\u0439\u0446\u0443
      \u0438 \u0447\u0442\u043E-\u0442\u043E \u0448\u0435\u043F\u0447\u0435\u0442.
      \u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446 \u0432\u0437\u0434\u0440\u0430\u0433\u0438\u0432\u0430\u0435\u0442,
      \u043B\u0435\u0437\u0435\u0442 \u043F\u043E\u0434 \u043F\u0440\u0438\u043B\u0430\u0432\u043E\u043A
      \u0438 \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0434\u0440\u0443\u0433\u043E\u0439
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A: \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E
      \u043F\u0430\u0440\u0447\u0443, \u0442\u044F\u0436\u0451\u043B\u0443\u044E
      \u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u0443\u044E \u043D\u0430 \u043E\u0449\u0443\u043F\u044C.
      \xAB\u041F\u044F\u0442\u044C \u043C\u043E\u043D\u0435\u0442, \u0438 \u043C\u044B
      \u0437\u0430\u0431\u044B\u0432\u0430\u0435\u043C \u043F\u0440\u043E \u0442\u0432\u043E\u0439
      \u0444\u043E\u043A\u0443\u0441 \u0441 \u043C\u0430\u0441\u043B\u043E\u043C\xBB,
      - \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0432\u0430\u0448 \u0441\u043F\u0443\u0442\u043D\u0438\u043A.
      \u0421\u043E\u0433\u0434\u0438\u0435\u0446 \u043A\u0438\u0432\u0430\u0435\u0442,
      \u0438 \u0432\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u043B\u0443\u0447\u0448\u0438\u043C
      \u0442\u043E\u0432\u0430\u0440\u043E\u043C \u0437\u0430 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C
      \u0446\u0435\u043D\u044B. \u041D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435
      \u0448\u0451\u043F\u043E\u0442\u043E\u043C \u043F\u0435\u0440\u0435\u0434\u0430\u044E\u0442:
      \u044D\u0442\u0438\u0445 \u043D\u0435 \u043F\u0440\u043E\u0432\u0435\u0434\u0451\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643588
    m_Localized: "\u0420\u0430\u0441\u0441\u043A\u0430\u0437 \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643589
    m_Localized: "\u0412\u0435\u0447\u0435\u0440 \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0435.
      \u041C\u0430\u0441\u043B\u044F\u043D\u044B\u0435 \u043B\u0430\u043C\u043F\u044B
      \u0431\u0440\u043E\u0441\u0430\u044E\u0442 \u0440\u044B\u0436\u0438\u0439 \u0441\u0432\u0435\u0442
      \u043D\u0430 \u043A\u0438\u0440\u043F\u0438\u0447\u043D\u044B\u0435 \u0441\u0442\u0435\u043D\u044B,
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0434\u044B\u043C\u043E\u043C, \u0432\u0430\u0440\u0451\u043D\u044B\u043C
      \u0440\u0438\u0441\u043E\u043C \u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u044C\u0435\u0439
      \u0448\u0435\u0440\u0441\u0442\u044C\u044E. \u0412\u043E \u0434\u0432\u043E\u0440\u0435
      \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D\u044B \u043C\u0443\u043B\u044B
      \u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B, \u0430 \u0432 \u043E\u0431\u0449\u0435\u043C
      \u0437\u0430\u043B\u0435, \u043D\u0430 \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u0445
      \u043A\u043E\u0432\u0440\u0430\u0445, \u0441\u0438\u0434\u044F\u0442 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B
      \u0438\u0437 \u0434\u044E\u0436\u0438\u043D\u044B \u0441\u0442\u0440\u0430\u043D.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445, \u0441\u0435\u0434\u043E\u0439
      \u043F\u0435\u0440\u0441 \u0432 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0435\u043C
      \u0437\u0435\u043B\u0451\u043D\u043E\u043C \u0445\u0430\u043B\u0430\u0442\u0435,
      \u0434\u043E\u043F\u0438\u0432\u0430\u0435\u0442 \u0447\u0430\u0439 \u0438
      \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u0432\u0430\u0448\u0435\u043C\u0443 \u043E\u0433\u043D\u044E. \u0415\u0433\u043E
      \u0433\u043B\u0430\u0437\u0430 \u0431\u043B\u0435\u0441\u0442\u044F\u0442 \u0432
      \u043F\u043E\u043B\u0443\u043C\u0440\u0430\u043A\u0435.\r\n\r\n<npc_speech
      lang=\"Persian\">\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A. \u042F \u0438\u0434\u0443
      \u0438\u0437 \u0411\u0430\u043B\u0445\u0430. \u0412 \u0433\u043E\u0440\u0430\u0445
      \u041F\u0430\u043C\u0438\u0440\u0430 \u0435\u0441\u0442\u044C \u0434\u0440\u0435\u0432\u043D\u0435\u0435
      \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0435 - \u0435\u0441\u043B\u0438
      \u0437\u043D\u0430\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0443. \u0422\u044B
      \u043F\u043E\u0439\u0434\u0451\u0448\u044C \u0438\u043B\u0438 \u0431\u043E\u0438\u0448\u044C\u0441\u044F?</npc_speech>\r\n\r\n\u041E\u043D
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0430\u0445
      \u0432 \u043F\u0430\u043C\u0438\u0440\u0441\u043A\u0438\u0445 \u043F\u0435\u0449\u0435\u0440\u0430\u0445.
      \u041C\u043E\u0436\u0435\u0442, \u0441\u0442\u0430\u0440\u0438\u043A \u0431\u0440\u0435\u0434\u0438\u0442.
      \u0410 \u043C\u043E\u0436\u0435\u0442, \u0437\u043D\u0430\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643590
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u0442\u044C
      \u0438 \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643591
    m_Localized: "\u0412\u044B \u0441\u043B\u0443\u0448\u0430\u0435\u0442\u0435 \u0434\u043E
      \u043A\u043E\u043D\u0446\u0430, \u043A\u0438\u0432\u0430\u0435\u0442\u0435
      \u0438 \u0436\u0435\u043B\u0430\u0435\u0442\u0435 \u0441\u0442\u0430\u0440\u0438\u043A\u0443
      \u0434\u043E\u0431\u0440\u043E\u0439 \u043D\u043E\u0447\u0438. \u0418\u0441\u0442\u043E\u0440\u0438\u044F
      \u043A\u0440\u0430\u0441\u0438\u0432\u0430\u044F: \u0433\u043E\u0440\u043D\u044B\u0435
      \u0445\u0440\u0430\u043C\u044B, \u0437\u043E\u043B\u043E\u0442\u044B\u0435
      \u0441\u0442\u0430\u0442\u0443\u0438, \u0441\u043A\u0435\u043B\u0435\u0442\u044B
      \u043D\u0435\u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u0445 \u0438\u0441\u043A\u0430\u0442\u0435\u043B\u0435\u0439.
      \u041F\u0440\u0430\u0432\u0434\u0430 \u0438\u043B\u0438 \u043D\u0435\u0442,
      \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C \u043D\u0435\u0437\u0430\u0447\u0435\u043C.
      \u041D\u043E \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0435 \u0441\u043B\u043E\u0432\u0430
      \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438\u0441\u044C, \u0438
      \u044D\u0442\u043E \u0443\u0436\u0435 \u0447\u0442\u043E-\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643592
    m_Localized: "\u0420\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C
      \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643593
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u0441\u0430\u0436\u0438\u0432\u0430\u0435\u0442\u0435\u0441\u044C
      \u0431\u043B\u0438\u0436\u0435, \u043F\u043E\u0434\u043B\u0438\u0432\u0430\u0435\u0442\u0435
      \u0441\u0442\u0430\u0440\u0438\u043A\u0443 \u0447\u0430\u044E \u0438 \u0437\u0430\u0434\u0430\u0451\u0442\u0435
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0435 \u0432\u043E\u043F\u0440\u043E\u0441\u044B,
      \u043D\u0435 \u043E \u0437\u043E\u043B\u043E\u0442\u0435, \u0430 \u043E \u0434\u043E\u0440\u043E\u0433\u0435.
      \u041F\u0435\u0440\u0441 \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u044F\u0435\u0442\u0441\u044F
      \u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0432\u0441\u0435\u0440\u044C\u0451\u0437: \u043F\u0435\u0440\u0435\u0432\u0430\u043B
      \u043A \u044E\u0433\u0443 \u043E\u0442 \u041E\u0448\u0430, \u043F\u0435\u0449\u0435\u0440\u0430
      \u0437\u0430 \u0432\u043E\u0434\u043E\u043F\u0430\u0434\u043E\u043C, \u043C\u0435\u0442\u043A\u0438
      \u043D\u0430 \u043A\u0430\u043C\u043D\u044F\u0445. \xAB\u042F \u0431\u044B\u043B
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u0442\u0430\u0440, \u0447\u0442\u043E\u0431\u044B
      \u0438\u0434\u0442\u0438, - \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D.
      - \u041D\u043E \u0442\u044B, \u043C\u043E\u0436\u0435\u0442, \u043D\u0435\u0442.\xBB
      \u0414\u0440\u0443\u0433\u0438\u0435 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B
      \u0432 \u0437\u0430\u043B\u0435 \u043F\u0440\u0438\u043C\u043E\u043B\u043A\u043B\u0438:
      \u0432\u0430\u0441 \u0441\u043B\u0443\u0448\u0430\u044E\u0442 \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643594
    m_Localized: "\u0421\u0442\u0430\u0440\u0438\u043A \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442
      \u0436\u0430\u0434\u043D\u044B\u0439 \u0431\u043B\u0435\u0441\u043A \u0432
      \u0432\u0430\u0448\u0438\u0445 \u0433\u043B\u0430\u0437\u0430\u0445 \u0438
      \u0437\u0430\u043C\u044B\u043A\u0430\u0435\u0442\u0441\u044F. \xAB\u042F \u043F\u043E\u0448\u0443\u0442\u0438\u043B.
      \u041D\u0435\u0442 \u043D\u0438\u043A\u0430\u043A\u0438\u0445 \u043F\u0435\u0449\u0435\u0440.
      \u0421\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0439 \u043D\u043E\u0447\u0438\xBB,
      - \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D \u0441\u0443\u0445\u043E.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u0437\u0430
      \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u043C \u043A\u043E\u0432\u0440\u043E\u043C
      \u043F\u043E\u0441\u043C\u0435\u0438\u0432\u0430\u044E\u0442\u0441\u044F: \u043F\u0440\u043E\u0441\u0442\u0430\u043A,
      \u043F\u043E\u0432\u0435\u0440\u0438\u043B \u0432 \u0441\u043A\u0430\u0437\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643595
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u0431\u0435\u0441\u0435\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643596
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u043E\u0434\u0441\u0430\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u0441\u0442\u0430\u0440\u0438\u043A\u0443 \u0438 \u0437\u0430\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0444\u0430\u0440\u0441\u0438: <npc_speech lang=\"Persian\">\u041C\u0438\u0440
      \u0432\u0430\u043C, \u0443\u0432\u0430\u0436\u0430\u0435\u043C\u044B\u0439.
      \u042F \u0441\u043B\u044B\u0448\u0430\u043B \u0432\u0430\u0448\u0443 \u0438\u0441\u0442\u043E\u0440\u0438\u044E
      - \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0438\u0442\u0435 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435,
      \u043F\u0440\u043E\u0448\u0443.</npc_speech> \u041F\u0435\u0440\u0441 \u043E\u0436\u0438\u0432\u043B\u044F\u0435\u0442\u0441\u044F:
      \u0437\u0435\u043C\u043B\u044F\u043A! \u0417\u0430 \u043F\u043E\u043B\u0447\u0430\u0441\u0430
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0438\u0437 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u0445
      \u043D\u0430\u043C\u0451\u043A\u043E\u0432 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0443\u044E \u043A\u0430\u0440\u0442\u0443,
      \u043D\u0430\u0447\u0435\u0440\u0447\u0435\u043D\u043D\u0443\u044E \u043F\u0430\u043B\u044C\u0446\u0435\u043C
      \u043D\u0430 \u043F\u044B\u043B\u044C\u043D\u043E\u043C \u043F\u043E\u043B\u0443.
      \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
      \u043A\u0430\u0436\u0434\u044B\u0439 \u043F\u043E\u0432\u043E\u0440\u043E\u0442.
      \u0421\u0442\u0430\u0440\u0438\u043A \u0445\u043B\u043E\u043F\u0430\u0435\u0442
      \u0435\u0433\u043E \u043F\u043E \u043F\u043B\u0435\u0447\u0443 \u0438 \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u0438\u0437-\u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u0438 \u043C\u0435\u0434\u043D\u044B\u0439
      \u0430\u043C\u0443\u043B\u0435\u0442 (\xAB\u043D\u0430 \u0443\u0434\u0430\u0447\u0443,
      \u0435\u0441\u043B\u0438 \u0440\u0435\u0448\u0438\u0442\u0435\u0441\u044C\xBB).
      \u0412\u0435\u0441\u044C \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0439
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0441 \u0437\u0430\u0432\u0438\u0441\u0442\u044C\u044E:
      \u0443 \u044D\u0442\u0438\u0445 \u043B\u044E\u0434\u0435\u0439 \u0435\u0441\u0442\u044C
      \u0441\u0432\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643597
    m_Localized: "\u0410\u0443\u0434\u0438\u0435\u043D\u0446\u0438\u044F \u0443 \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643598
    m_Localized: "\u0413\u043E\u043D\u0435\u0446 \u0432 \u0440\u0430\u0441\u0448\u0438\u0442\u043E\u043C
      \u0445\u0430\u043B\u0430\u0442\u0435 \u043D\u0430\u0448\u0451\u043B \u0432\u0430\u0441
      \u043D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435: \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C
      \u0433\u043E\u0440\u043E\u0434\u0430 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u0435\u0442
      \u043D\u0430 \u043F\u0440\u0438\u0451\u043C. \u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C
      \u043D\u0435\u043B\u044C\u0437\u044F. \u0414\u0432\u043E\u0440\u0446\u043E\u0432\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0440\u0430\u0441\u043F\u0430\u0445\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u0432 \u043C\u043E\u0437\u0430\u0438\u0447\u043D\u044B\u0439 \u0434\u0432\u043E\u0440
      \u0441 \u0444\u043E\u043D\u0442\u0430\u043D\u043E\u043C. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438
      \u0432 \u043D\u0430\u0447\u0438\u0449\u0435\u043D\u043D\u044B\u0445 \u0448\u043B\u0435\u043C\u0430\u0445
      \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u044E\u0442 \u0432\u0430\u0441 \u043A
      \u0442\u0440\u043E\u043D\u043D\u043E\u043C\u0443 \u0432\u043E\u0437\u0432\u044B\u0448\u0435\u043D\u0438\u044E.
      \u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C (\u0433\u0440\u0443\u0437\u043D\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432 \u0431\u0435\u043B\u043E\u043C
      \u0442\u044E\u0440\u0431\u0430\u043D\u0435 \u0441 \u0438\u0437\u0443\u043C\u0440\u0443\u0434\u043D\u043E\u0439
      \u0437\u0430\u043A\u043E\u043B\u043A\u043E\u0439) \u0441\u0438\u0434\u0438\u0442
      \u043D\u0430 \u043F\u043E\u0434\u0443\u0448\u043A\u0430\u0445 \u0438 \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0441 \u043B\u0435\u043D\u0438\u0432\u044B\u043C \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u0441\u0442\u0432\u043E\u043C.\r\n\r\n<npc_speech
      lang=\"Arabic\">\u041C\u0438\u0440 \u0442\u0435\u0431\u0435, \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446.
      \u041C\u043D\u0435 \u0434\u043E\u043D\u0435\u0441\u043B\u0438, \u0447\u0442\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0442\u0432\u043E\u0439 \u0434\u043E\u0441\u0442\u043E\u0438\u043D
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F. \u042F \u0436\u0435\u043B\u0430\u044E
      \u0432\u0438\u0434\u0435\u0442\u044C \u0442\u0432\u043E\u0438 \u0442\u043E\u0432\u0430\u0440\u044B
      - \u0438, \u0431\u044B\u0442\u044C \u043C\u043E\u0436\u0435\u0442, \u043C\u044B
      \u0437\u0430\u043A\u043B\u044E\u0447\u0438\u043C \u0441\u0434\u0435\u043B\u043A\u0443.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643599
    m_Localized: "\u041F\u0440\u0435\u043F\u043E\u0434\u043D\u0435\u0441\u0442\u0438
      \u0441\u043A\u0440\u043E\u043C\u043D\u044B\u0439 \u0434\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643600
    m_Localized: "\u0412\u044B \u043A\u043B\u0430\u0434\u0451\u0442\u0435 \u043F\u0435\u0440\u0435\u0434
      \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u0435\u043C \u043A\u043E\u0448\u0435\u043B\u044C
      \u0441\u0435\u0440\u0435\u0431\u0440\u0430 \u0438 \u0441\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0435
      \u0433\u043E\u043B\u043E\u0432\u0443. \u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C
      \u0431\u043B\u0430\u0433\u043E\u0441\u043A\u043B\u043E\u043D\u043D\u043E \u043A\u0438\u0432\u0430\u0435\u0442,
      \u0431\u0435\u0440\u0451\u0442 \u043E\u0434\u043D\u0443 \u043C\u043E\u043D\u0435\u0442\u0443,
      \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442
      \u0447\u0435\u043A\u0430\u043D\u043A\u0443 \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442
      \u0432\u0438\u0437\u0438\u0440\u044E. \xAB\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0437\u043D\u0430\u0435\u0442 \u043E\u0431\u044B\u0447\u0430\u0438, - \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043E\u043D. - \u041F\u0443\u0441\u0442\u044C \u0442\u043E\u0440\u0433\u0443\u0435\u0442
      \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E.\xBB \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438
      \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u044E\u0442 \u0432\u0430\u0441 \u043A
      \u0432\u044B\u0445\u043E\u0434\u0443. \u0414\u0432\u0435\u0440\u0438 \u0433\u043E\u0440\u043E\u0434\u0430
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B, \u0430 \u044D\u0442\u043E \u0434\u043E\u0440\u043E\u0436\u0435
      \u0441\u0435\u0440\u0435\u0431\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643601
    m_Localized: "\u041F\u0440\u043E\u0438\u0437\u0432\u0435\u0441\u0442\u0438 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435
      \u0440\u0435\u0447\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643602
    m_Localized: "\u0412\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u043E
      \u0434\u043E\u0440\u043E\u0433\u0430\u0445, \u043E \u0442\u043E\u043C, \u0447\u0442\u043E
      \u0432\u0438\u0434\u0435\u043B\u0438 \u043C\u0435\u0436\u0434\u0443 \u0427\u0430\u043D\u044A\u0430\u043D\u0435\u043C
      \u0438 \u044D\u0442\u0438\u043C \u0433\u043E\u0440\u043E\u0434\u043E\u043C:
      \u043E \u0448\u0451\u043B\u043A\u0435 \u0438 \u0436\u0435\u043B\u0435\u0437\u0435,
      \u043E \u0431\u0443\u0440\u044F\u0445 \u0438 \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u0445,
      \u043E \u044F\u0437\u044B\u043A\u0430\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0443\u0447\u0438\u043B\u0438 \u0432 \u043F\u0443\u0442\u0438. \u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C
      \u0441\u043B\u0443\u0448\u0430\u0435\u0442, \u043F\u043E\u0434\u0430\u0432\u0448\u0438\u0441\u044C
      \u0432\u043F\u0435\u0440\u0451\u0434. \u0412\u0438\u0437\u0438\u0440\u044C
      \u0437\u0430\u0431\u044B\u043B \u043E \u0441\u0432\u043E\u0438\u0445 \u0437\u0430\u043F\u0438\u0441\u044F\u0445.
      \u041A\u043E\u0433\u0434\u0430 \u0432\u044B \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0435,
      \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C \u0445\u043B\u043E\u043F\u0430\u0435\u0442
      \u0432 \u043B\u0430\u0434\u043E\u0448\u0438: \xAB\u0422\u0430\u043A\u0438\u0445,
      \u043A\u0430\u043A \u0442\u044B, \u044F \u0434\u0430\u0432\u043D\u043E \u043D\u0435
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043B. \u0412\u043E\u0442 \u043C\u043E\u0439
      \u0437\u043D\u0430\u043A - \u043F\u043E\u043A\u0430\u0436\u0438 \u043D\u0430
      \u043B\u044E\u0431\u043E\u043C \u0431\u0430\u0437\u0430\u0440\u0435, \u0438
      \u0442\u0435\u0431\u044F \u043F\u0440\u0438\u043C\u0443\u0442 \u043A\u0430\u043A
      \u0434\u0440\u0443\u0433\u0430 \u0434\u0432\u043E\u0440\u0446\u0430.\xBB \u041E\u043D
      \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u0441 \u043F\u0430\u043B\u044C\u0446\u0430
      \u0437\u043E\u043B\u043E\u0442\u043E\u0435 \u043A\u043E\u043B\u044C\u0446\u043E
      \u0438 \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0432\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643603
    m_Localized: "\u0412\u0430\u0448\u0438 \u0441\u043B\u043E\u0432\u0430 \u0437\u0432\u0443\u0447\u0430\u0442
      \u0437\u0430\u0443\u0447\u0435\u043D\u043D\u043E: \u0434\u0432\u043E\u0440\u0446\u043E\u0432\u044B\u0439
      \u044D\u0442\u0438\u043A\u0435\u0442 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u044F\u0437\u044B\u043A\u0430,
      \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0440\u0438\u0442\u043C\u0430.
      \u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C \u0445\u043C\u0443\u0440\u0438\u0442\u0441\u044F.
      \u0412\u0438\u0437\u0438\u0440\u044C \u0447\u0442\u043E-\u0442\u043E \u0448\u0435\u043F\u0447\u0435\u0442
      \u0435\u043C\u0443 \u043D\u0430 \u0443\u0445\u043E. \xAB\u0421\u0442\u0443\u043F\u0430\u0439,
      - \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C.
      - \u0418 \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0441\u044F
      \u0432 \u043C\u043E\u0451\u043C \u0433\u043E\u0440\u043E\u0434\u0435.\xBB \u041D\u0430
      \u0431\u0430\u0437\u0430\u0440\u0435 \u0432\u0430\u0441 \u0441\u0442\u043E\u0440\u043E\u043D\u044F\u0442\u0441\u044F:
      \u0441\u043B\u0443\u0445\u0438 \u0431\u0435\u0433\u0443\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u043D\u043E\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643604
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0432\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643605
    m_Localized: "\u0412\u0430\u0448 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u0448\u0430\u0433\u0430\u0435\u0442 \u0432\u043F\u0435\u0440\u0451\u0434,
      \u0432\u0441\u0442\u0430\u0451\u0442 \u043F\u043E \u0441\u0442\u043E\u0439\u043A\u0435
      \xAB\u0441\u043C\u0438\u0440\u043D\u043E\xBB \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u043A \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044E \u043D\u0430
      \u044F\u0437\u044B\u043A\u0435 \u0432\u043E\u0438\u043D\u043E\u0432: \u043A\u043E\u0440\u043E\u0442\u043A\u043E,
      \u0441 \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u043E\u043C.
      \u041E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0432\u0430\u0441,
      \u043F\u0435\u0440\u0435\u0447\u0438\u0441\u043B\u044F\u0435\u0442 \u0434\u043E\u0440\u043E\u0433\u0438,
      \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043D\u044B\u0435 \u0431\u0435\u0437
      \u043F\u043E\u0442\u0435\u0440\u044C, \u0438 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
      \u0437\u0430\u0441\u0430\u0434\u044B, \u043E\u0442\u0431\u0438\u0442\u044B\u0435
      \u043F\u043E\u0434 \u0435\u0433\u043E \u043D\u0430\u0447\u0430\u043B\u043E\u043C.
      \u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u044E\u0449\u0435
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430:
      \u0432\u044B\u043F\u0440\u0430\u0432\u043A\u0430, \u0448\u0440\u0430\u043C\u044B,
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439 \u0432\u0437\u0433\u043B\u044F\u0434.
      \u041A\u0438\u0432\u0430\u0435\u0442. \xAB\u0427\u0435\u043B\u043E\u0432\u0435\u043A,
      \u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0440\u0443\u0447\u0430\u0435\u0442\u0441\u044F
      \u0442\u0430\u043A\u043E\u0439 \u0432\u043E\u0438\u043D, \u0434\u043E\u0441\u0442\u043E\u0438\u043D
      \u043C\u043E\u0435\u0433\u043E \u0434\u043E\u0432\u0435\u0440\u0438\u044F.\xBB
      \u0412\u0438\u0437\u0438\u0440\u044C \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
      \u0432\u0430\u0448\u0435 \u0438\u043C\u044F \u0432 \u043E\u0445\u0440\u0430\u043D\u043D\u0443\u044E
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443, \u0430 \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C
      \u043F\u043E\u0434\u0437\u044B\u0432\u0430\u0435\u0442 \u0441\u043B\u0443\u0433\u0443
      \u0441 \u043F\u043E\u0434\u043D\u043E\u0441\u043E\u043C: \u0437\u043E\u043B\u043E\u0442\u043E\u0435
      \u043E\u0436\u0435\u0440\u0435\u043B\u044C\u0435 \u043B\u043E\u0436\u0438\u0442\u0441\u044F
      \u0432\u0430\u043C \u043D\u0430 \u043B\u0430\u0434\u043E\u043D\u0438. \u0414\u0432\u043E\u0440
      \u0440\u0430\u0441\u0441\u0442\u0443\u043F\u0430\u0435\u0442\u0441\u044F \u0441
      \u043F\u043E\u0447\u0442\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643606
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442
      \u0432 \u043F\u043E\u0440\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643607
    m_Localized: "\u041F\u043E\u0440\u0442\u043E\u0432\u044B\u0439 \u043A\u0432\u0430\u0440\u0442\u0430\u043B
      \u043A \u0432\u0435\u0447\u0435\u0440\u0443 \u043F\u0430\u0445\u043D\u0435\u0442
      \u0441\u043C\u043E\u043B\u043E\u0439, \u0433\u043D\u0438\u044E\u0449\u0438\u043C\u0438
      \u0432\u043E\u0434\u043E\u0440\u043E\u0441\u043B\u044F\u043C\u0438 \u0438 \u0436\u0430\u0440\u0435\u043D\u043E\u0439
      \u0440\u044B\u0431\u043E\u0439. \u041C\u0435\u0436\u0434\u0443 \u0441\u043A\u043B\u0430\u0434\u043E\u0432,
      \u0433\u0434\u0435 \u0433\u0440\u043E\u043C\u043E\u0437\u0434\u044F\u0442\u0441\u044F
      \u0431\u043E\u0447\u043A\u0438 \u0438 \u0442\u044E\u043A\u0438, \u043A \u0432\u0430\u043C
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0436\u0438\u043B\u0438\u0441\u0442\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432 \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u043E\u043C
      \u0445\u0430\u043B\u0430\u0442\u0435 (\u043B\u0438\u0446\u043E \u043E\u0431\u0432\u0435\u0442\u0440\u0435\u043D\u043D\u043E\u0435,
      \u0440\u0443\u043A\u0438 \u0432 \u0434\u0451\u0433\u0442\u0435, \u0433\u043B\u0430\u0437\u0430
      \u0431\u0435\u0433\u0430\u044E\u0442, \u043A\u0430\u043A \u0443 \u043A\u0440\u044B\u0441\u044B
      \u043C\u0435\u0436\u0434\u0443 \u043C\u0435\u0448\u043A\u043E\u0432). \u041E\u043D
      \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043F\u043E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C \u0438 \u043F\u043E\u043D\u0438\u0436\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0441:\r\n\r\n<npc_speech lang=\"Arabic\">\u042D\u0439,
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446! \u0423 \u043C\u0435\u043D\u044F
      \u0442\u043E\u0432\u0430\u0440 \u0438\u0437 \u0418\u043D\u0434\u0438\u0438
      - \u0448\u0430\u0444\u0440\u0430\u043D, \u0441\u043B\u043E\u043D\u043E\u0432\u0430\u044F
      \u043A\u043E\u0441\u0442\u044C, \u0436\u0435\u043C\u0447\u0443\u0433. \u0417\u0430
      \u043F\u043E\u043B\u0446\u0435\u043D\u044B, \u0431\u0435\u0437 \u043F\u043E\u0448\u043B\u0438\u043D.
      \u041D\u043E \u0440\u0435\u0448\u0430\u0439 \u0441\u043A\u043E\u0440\u0435\u0439
      - \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u0441\u0442\u0440\u0430\u0436\u0430
      \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F.</npc_speech>\r\n\r\n\u0428\u0430\u0444\u0440\u0430\u043D,
      \u0441\u043B\u043E\u043D\u043E\u0432\u0430\u044F \u043A\u043E\u0441\u0442\u044C,
      \u0436\u0435\u043C\u0447\u0443\u0433 - \u043F\u043E \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435, \u0431\u0435\u0437 \u043F\u043E\u0448\u043B\u0438\u043D.
      \u041D\u043E \u0441\u0442\u0440\u0430\u0436\u0430 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435, \u0438 \u0435\u0441\u043B\u0438
      \u043F\u043E\u0439\u043C\u0430\u044E\u0442 \u0441 \u043A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u043E\u0439,
      \u0448\u0442\u0440\u0430\u0444\u043E\u043C \u043D\u0435 \u043E\u0442\u0434\u0435\u043B\u0430\u0435\u0448\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643608
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643609
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0435
      \u0440\u0443\u043A\u0438 \u043B\u0430\u0434\u043E\u043D\u044F\u043C\u0438 \u0432\u043F\u0435\u0440\u0451\u0434
      \u0438 \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0435\u0442\u0435. \xAB\u041C\u043D\u0435
      \u043D\u0438 \u043A \u0447\u0435\u043C\u0443 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0441\u0442\u0438
      \u0441 \u0437\u0430\u043A\u043E\u043D\u043E\u043C.\xBB \u041A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442
      \u0441\u043F\u043B\u0451\u0432\u044B\u0432\u0430\u0435\u0442, \u043F\u043E\u0434\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A \u0438 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044F\u0435\u0442\u0441\u044F
      \u043C\u0435\u0436\u0434\u0443 \u0441\u043A\u043B\u0430\u0434\u043E\u0432.
      \u0423\u0442\u0440\u043E\u043C \u043D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435
      \u0432\u044B \u0441\u043B\u044B\u0448\u0438\u0442\u0435, \u0447\u0442\u043E
      \u0441\u0442\u0440\u0430\u0436\u0430 \u0430\u0440\u0435\u0441\u0442\u043E\u0432\u0430\u043B\u0430
      \u043A\u043E\u0433\u043E-\u0442\u043E \u0441 \u043D\u0435\u043F\u043E\u0448\u043B\u0438\u043D\u043D\u044B\u043C
      \u0442\u043E\u0432\u0430\u0440\u043E\u043C. \u0425\u043E\u0440\u043E\u0448\u043E,
      \u0447\u0442\u043E \u044D\u0442\u043E \u0431\u044B\u043B\u0438 \u043D\u0435
      \u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643610
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643611
    m_Localized: "\u0412\u044B \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442\u0435
      \u0442\u043E\u0432\u0430\u0440 \u043F\u0440\u0438 \u0441\u0432\u0435\u0442\u0435
      \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0439 \u043B\u0430\u043C\u043F\u044B:
      \u0448\u0430\u0444\u0440\u0430\u043D \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439,
      \u043D\u0438\u0442\u0438 \u0434\u043B\u0438\u043D\u043D\u044B\u0435, \u0446\u0432\u0435\u0442
      \u0433\u0443\u0441\u0442\u043E\u0439. \u0411\u044B\u0441\u0442\u0440\u044B\u0439
      \u043E\u0431\u043C\u0435\u043D \u043C\u043E\u043D\u0435\u0442 \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435,
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A \u043F\u043E\u0434 \u043F\u043B\u0430\u0449,
      \u0438 \u0432\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u043F\u0435\u0440\u0435\u0443\u043B\u043A\u0430\u043C\u0438,
      \u043E\u0431\u0445\u043E\u0434\u044F \u043F\u0430\u0442\u0440\u0443\u043B\u0438.
      \u041A \u0443\u0442\u0440\u0443 \u0442\u043E\u0432\u0430\u0440 \u0441\u043F\u0440\u044F\u0442\u0430\u043D
      \u0441\u0440\u0435\u0434\u0438 \u0437\u0430\u043A\u043E\u043D\u043D\u043E\u0433\u043E
      \u0433\u0440\u0443\u0437\u0430, \u0438 \u043E\u0442\u043B\u0438\u0447\u0438\u0442\u044C
      \u0435\u0433\u043E \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643612
    m_Localized: "\u0421\u0434\u0435\u043B\u043A\u0430 \u043F\u0440\u043E\u0448\u043B\u0430,
      \u043D\u043E \u043D\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u043C
      \u043F\u0443\u0442\u0438 \u0432\u0430\u0441 \u043E\u043A\u043B\u0438\u043A\u043D\u0443\u043B
      \u043F\u043E\u0440\u0442\u043E\u0432\u044B\u0439 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A.
      \u0421\u0432\u0451\u0440\u0442\u043E\u043A \u043D\u0430\u0448\u043B\u0438 \u043F\u0440\u0438
      \u043E\u0431\u044B\u0441\u043A\u0435 - \u0448\u0430\u0444\u0440\u0430\u043D
      \u0431\u0435\u0437 \u043F\u043E\u0448\u043B\u0438\u043D\u043D\u043E\u0439 \u043F\u0435\u0447\u0430\u0442\u0438.
      \u0428\u0442\u0440\u0430\u0444, \u043A\u043E\u043D\u0444\u0438\u0441\u043A\u0430\u0446\u0438\u044F
      \u0438 \u0432\u0430\u0448\u0435 \u0438\u043C\u044F \u0432 \u0447\u0451\u0440\u043D\u043E\u043C
      \u0441\u043F\u0438\u0441\u043A\u0435 \u043F\u043E\u0440\u0442\u0430. \u0422\u043E\u0440\u0433\u043E\u0432\u0446\u044B
      \u0448\u0435\u043F\u0447\u0443\u0442\u0441\u044F: \u0441 \u044D\u0442\u0438\u043C
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u043E\u043C \u0434\u0435\u043B\u0430
      \u043B\u0443\u0447\u0448\u0435 \u043D\u0435 \u0438\u043C\u0435\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643613
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442
      \u043B\u0435\u0433\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643614
    m_Localized: "\u0412\u0430\u0448 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u043C\u043E\u043B\u0447\u0430 \u043E\u0442\u043E\u0434\u0432\u0438\u0433\u0430\u0435\u0442
      \u0432\u0430\u0441 \u043F\u043B\u0435\u0447\u043E\u043C \u0438 \u0432\u0441\u0442\u0430\u0451\u0442
      \u043F\u0435\u0440\u0435\u0434 \u043A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442\u043E\u043C.
      \xAB\u041F\u043E\u043A\u0430\u0436\u0438 \u0442\u043E\u0432\u0430\u0440, \u0432\u0435\u0441\u044C\xBB,
      - \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D \u0442\u043E\u043D\u043E\u043C,
      \u043D\u0435 \u0442\u0435\u0440\u043F\u044F\u0449\u0438\u043C \u0432\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0439.
      \u041A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442
      \u043D\u0435\u0440\u0432\u043D\u043E \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u043A\u0430\u0436\u0434\u044B\u0439
      \u043C\u0435\u0448\u043E\u0447\u0435\u043A, \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0434\u0432\u0430 (\xAB\u043A\u0440\u0430\u0434\u0435\u043D\u044B\u0435, \u043A\u043B\u0435\u0439\u043C\u043E
      \u0441\u043E\u0441\u043A\u043E\u0431\u043B\u0435\u043D\u043E\xBB) \u0438 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0442\u0440\u0435\u0442\u0438\u0439: \xAB\u0412\u043E\u0442 \u044D\u0442\u043E
      \u0447\u0438\u0441\u0442\u044B\u0439, \u0431\u0435\u0437 \u043A\u043B\u0435\u0439\u043C\u0430
      \u043F\u043E\u0440\u0442\u0430-\u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F.
      \u0417\u0430\u043A\u043E\u043D\u043D\u0430\u044F \u0434\u043E\u0431\u044B\u0447\u0430,
      \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u0435\u0437 \u043F\u043E\u0448\u043B\u0438\u043D\u044B.\xBB
      \u0412\u044B \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0442\u0435 \u0437\u0430
      \u0431\u0435\u0441\u0446\u0435\u043D\u043E\u043A, \u0430 \u043A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442
      \u0440\u0430\u0434, \u0447\u0442\u043E \u0443\u0448\u0451\u043B \u0441 \u0437\u0443\u0431\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643615
    m_Localized: "\u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u0433\u0438\u043B\u044C\u0434\u043C\u0430\u0441\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643616
    m_Localized: "\u041D\u0430 \u0441\u0442\u043E\u044F\u043D\u043A\u0435 \u043A
      \u0432\u0430\u043C \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0441\u043E\u0433\u0434\u0438\u0435\u0446
      \u0432 \u0442\u0451\u043C\u043D\u043E-\u0441\u0438\u043D\u0435\u043C \u043A\u0430\u0444\u0442\u0430\u043D\u0435
      \u0441 \u0437\u043E\u043B\u043E\u0442\u044B\u043C \u0448\u0438\u0442\u044C\u0451\u043C
      \u043F\u043E \u0432\u043E\u0440\u043E\u0442\u0443: \u043D\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A,
      \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u043A\u0443\u043F\u0435\u0446.
      \u041F\u0430\u043B\u044C\u0446\u044B \u0443\u043D\u0438\u0437\u0430\u043D\u044B
      \u043F\u0435\u0440\u0441\u0442\u043D\u044F\u043C\u0438, \u043D\u043E \u0440\u0443\u043A\u0438
      \u0436\u0438\u043B\u0438\u0441\u0442\u044B\u0435, \u0440\u0430\u0431\u043E\u0447\u0438\u0435.
      \u041E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0441\u0435\u0431\u044F
      \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445 \u0441\u043B\u043E\u0432
      \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0442\u0430\u043A, \u043A\u0430\u043A
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0441\u0442\u0430\u0440\u044B\u0439
      \u0438\u0433\u0440\u043E\u043A, \u043D\u0430\u0448\u0435\u0434\u0448\u0438\u0439
      \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u043E\u0433\u043E
      \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u0430. \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434,
      \u0433\u0438\u043B\u044C\u0434\u0438\u044F, \u0434\u0435\u043D\u044C\u0433\u0438
      \u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435,
      \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0435
      \u0443\u0445\u043E\u0434\u044F\u0442 \u0441 \u043B\u0451\u0433\u043A\u0438\u043C
      \u0441\u0435\u0440\u0434\u0446\u0435\u043C.\r\n\r\n<npc_speech lang=\"Sogdian\">\u041F\u0440\u0438\u0432\u0435\u0442,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A! \u042F \u0412\u0430\u0445\u0443-\u041C\u0430\u043D,
      \u0438\u0437 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0439 \u0433\u0438\u043B\u044C\u0434\u0438\u0438
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430. \u042F \u0432\u0438\u0434\u0435\u043B
      \u0442\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443 - \u0434\u0435\u043B\u043E
      \u043B\u0430\u0434\u0438\u0442\u0441\u044F, \u0438\u043C\u044F \u043D\u0430
      \u0441\u043B\u0443\u0445\u0443. \u0415\u0441\u0442\u044C \u043F\u0443\u0442\u044C
      \u043E\u0442 \u041A\u0438\u0442\u0430\u044F \u0434\u043E \u0420\u0443\u043C\u0430
      - \u043F\u043E\u043B\u043D\u044B\u0439 \u0437\u043E\u043B\u043E\u0442\u0430,
      \u043F\u043E\u043B\u043D\u044B\u0439 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438.
      \u0425\u0432\u0430\u0442\u0438\u0442 \u043B\u0438 \u0443 \u0442\u0435\u0431\u044F
      \u0434\u0435\u0440\u0437\u043E\u0441\u0442\u0438?</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643617
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643618
    m_Localized: "\u0412\u044B \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u0435
      \u0412\u0430\u0445\u0443-\u041C\u0430\u043D\u0430 \u0438 \u043A\u0430\u0447\u0430\u0435\u0442\u0435
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439. \u0421\u043E\u0433\u0434\u0438\u0435\u0446
      \u043D\u0435 \u043D\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u0435\u0442:
      \u043A\u0438\u0432\u0430\u0435\u0442, \u043F\u0440\u044F\u0447\u0435\u0442
      \u0443\u043B\u044B\u0431\u043A\u0443 \u0432 \u0431\u043E\u0440\u043E\u0434\u0443
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442: \xAB\u0414\u043E\u0440\u043E\u0433\u0430
      \u0434\u043B\u0438\u043D\u043D\u0430. \u041C\u043E\u0436\u0435\u0442, \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F
      \u0441\u043D\u043E\u0432\u0430\xBB. \u041E\u043D \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044F\u0435\u0442\u0441\u044F
      \u0441\u0440\u0435\u0434\u0438 \u043F\u043E\u0432\u043E\u0437\u043E\u043A,
      \u0430 \u0432\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0435
      \u043F\u0443\u0442\u044C, \u043A\u0430\u043A \u043F\u0440\u0435\u0436\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643619
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643620
    m_Localized: "\u0412\u044B \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442\u0435
      \u0440\u0443\u043A\u0443 \u0412\u0430\u0445\u0443-\u041C\u0430\u043D\u0430
      \u0438 \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0435\u0442\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F:
      \u0437\u0430\u043B\u043E\u0433, \u043C\u0430\u0440\u0448\u0440\u0443\u0442,
      \u0434\u043E\u043B\u044E \u043F\u0440\u0438\u0431\u044B\u043B\u0438. \u041A\u0430\u0436\u0434\u044B\u0439
      \u0432\u0430\u0448 \u0434\u043E\u0432\u043E\u0434 \u043E\u043D \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u043A\u0438\u0432\u043A\u043E\u043C: \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442
      \u043D\u0435 \u0446\u0438\u0444\u0440\u044B, \u0430 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440.
      \u041A \u043A\u043E\u043D\u0446\u0443 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430
      \u043E\u043D \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0438\u0437-\u0437\u0430
      \u043F\u0430\u0437\u0443\u0445\u0438 \u0441\u0432\u0451\u0440\u043D\u0443\u0442\u0443\u044E
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443 \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438 \u0438 \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0432\u0430\u043C \u0432 \u0440\u0443\u043A\u0443. \xAB\u041F\u0435\u0440\u0432\u0430\u044F
      \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0430: \u0434\u0435\u0441\u044F\u0442\u044C
      \u0442\u044E\u043A\u043E\u0432 \u0448\u0451\u043B\u043A\u0430 \u0438\u0437
      \u0427\u0430\u043D\u044A\u0430\u043D\u044F \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434.
      \u0421\u043F\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F - \u0434\u0430\u043B\u044C\u0448\u0435
      \u0431\u0443\u0434\u0435\u0442 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0435\u0435.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643621
    m_Localized: "\u0412\u044B \u043F\u044B\u0442\u0430\u0435\u0442\u0435\u0441\u044C
      \u043E\u0431\u0441\u0443\u0434\u0438\u0442\u044C \u0443\u0441\u043B\u043E\u0432\u0438\u044F,
      \u043D\u043E \u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u043C\u043E\u0440\u0449\u0438\u0442\u0441\u044F:
      \u0432\u0430\u0448\u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F
      \u0432\u044B\u0434\u0430\u044E\u0442 \u043D\u0435\u043E\u043F\u044B\u0442\u043D\u043E\u0441\u0442\u044C.
      \xAB\u0422\u043E\u0440\u0433\u043E\u0432\u043B\u044F \u043D\u0435 \u0432 \u043F\u043E\u0434\u0441\u0447\u0451\u0442\u0435
      \u043C\u043E\u043D\u0435\u0442, \u0441\u0430\u0440\u0442\u0431\u0430\u0432.\xBB
      \u041E\u043D \u043C\u043E\u043B\u0447\u0438\u0442, \u0432\u0435\u0440\u0442\u044F
      \u0432 \u043F\u0430\u043B\u044C\u0446\u0430\u0445 \u043F\u0435\u0447\u0430\u0442\u043A\u0443,
      \u043F\u043E\u0442\u043E\u043C \u0432\u0437\u0434\u044B\u0445\u0430\u0435\u0442.
      \xAB\u041D\u043E \u0434\u043E\u0440\u043E\u0433\u0430 \u0443\u0447\u0438\u0442
      \u043B\u0443\u0447\u0448\u0435 \u0431\u0430\u0437\u0430\u0440\u0430. \u0412\u043E\u0442
      \u0433\u0440\u0430\u043C\u043E\u0442\u0430: \u043F\u0435\u0440\u0432\u0430\u044F
      \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u0438\u0437 \u0427\u0430\u043D\u044A\u0430\u043D\u044F
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434. \u0417\u0430\u043B\u043E\u0433
      \u0443\u0432\u0435\u043B\u0438\u0447\u0443, \u0434\u043E\u043B\u044E \u0443\u043C\u0435\u043D\u044C\u0448\u0443.
      \u041D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F, \u0432\u0435\u0440\u043D\u0438
      \u0431\u0443\u043C\u0430\u0433\u0443.\xBB \u041E\u043D \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A \u0432\u0430\u043C \u0432 \u0440\u0443\u043A\u0443,
      \u043D\u043E \u0442\u043E\u043D \u044F\u0441\u0435\u043D: \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0435
      \u0441 \u0445\u0443\u0434\u0448\u0438\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u0439,
      \u0438 \u043A\u0430\u0436\u0434\u044B\u0439 \u043F\u0440\u043E\u043C\u0430\u0445
      \u043E\u0431\u043E\u0439\u0434\u0451\u0442\u0441\u044F \u0434\u043E\u0440\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643622
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442
      \u0432\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643623
    m_Localized: "\u0412\u0430\u0448 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u0448\u0430\u0433\u0430\u0435\u0442 \u0432\u043F\u0435\u0440\u0451\u0434 \u0438
      \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0441
      \u0412\u0430\u0445\u0443-\u041C\u0430\u043D\u043E\u043C \u0440\u0443\u043A\u043E\u043F\u043E\u0436\u0430\u0442\u0438\u0435\u043C:
      \u043E\u043D\u0438, \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0437\u043D\u0430\u043A\u043E\u043C\u044B \u043F\u043E \u0411\u0443\u0445\u0430\u0440\u0441\u043A\u043E\u043C\u0443
      \u0431\u0430\u0437\u0430\u0440\u0443. <npc_speech lang=\"Sogdian\">\u0420\u0430\u0445\u0448,
      \u0441\u0442\u0430\u0440\u044B\u0439 \u043B\u0438\u0441! \u0421\u043A\u043E\u043B\u044C\u043A\u043E
      \u043B\u0435\u0442, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043E\u0440\u043E\u0433!</npc_speech>
      \u0421\u043C\u0435\u0445, \u0445\u043B\u043E\u043F\u043E\u043A \u043F\u043E
      \u043F\u043B\u0435\u0447\u0443, \u0438 \u0412\u0430\u0445\u0443-\u041C\u0430\u043D
      \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0433\u0440\u0430\u043C\u043E\u0442\u0443
      \u0431\u0435\u0437 \u0432\u0441\u044F\u043A\u043E\u0433\u043E \u0442\u043E\u0440\u0433\u0430.
      \xAB\u0415\u0441\u043B\u0438 \u0420\u0430\u0445\u0448 \u0437\u0430 \u0442\u0435\u0431\u044F
      \u0440\u0443\u0447\u0430\u0435\u0442\u0441\u044F, \u0437\u043D\u0430\u0447\u0438\u0442,
      \u0442\u044B \u0438\u0437 \u043D\u0430\u0448\u0438\u0445.\xBB \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u043F\u043E\u0434\u043C\u0438\u0433\u0438\u0432\u0430\u0435\u0442 \u0432\u0430\u043C:
      \xAB\u041D\u0435 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438. \u041F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0435 \u043F\u043E\u0434\u0432\u0435\u0434\u0438.\xBB \u0413\u0438\u043B\u044C\u0434\u0438\u044F
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043F\u0443\u0442\u044C
      \u043A \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044E:
      \u043D\u0430\u0447\u0430\u043B\u043E \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0438\u0433\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643624
    m_Localized: "\u0413\u043E\u043B\u043E\u0441 \u0441 \u0432\u0435\u0440\u0448\u0438\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643625
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u0432\u044B\u0432\u043E\u0434\u0438\u0442
      \u043A \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u043C\u0443 \u0433\u043E\u0440\u043D\u043E\u043C\u0443
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044E: \u0431\u0435\u043B\u0451\u043D\u044B\u0435
      \u0441\u0442\u0435\u043D\u044B, \u043A\u0440\u044B\u0448\u0430 \u0438\u0437
      \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0445 \u043F\u043B\u0438\u0442,
      \u043C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u0444\u043B\u0430\u0433\u0438
      \u0442\u0440\u0435\u0449\u0430\u0442 \u043D\u0430 \u0432\u0435\u0442\u0440\u0443
      \u043C\u0435\u0436\u0434\u0443 \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u043C\u0438
      \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u043C\u0438. \u0423 \u0432\u0445\u043E\u0434\u0430
      \u0441\u0438\u0434\u0438\u0442 \u043C\u043E\u043D\u0430\u0445 \u043F\u0440\u0435\u043A\u043B\u043E\u043D\u043D\u044B\u0445
      \u043B\u0435\u0442 \u0432 \u0431\u0430\u0433\u0440\u044F\u043D\u043E\u0439
      \u043A\u0430\u0448\u0430\u0435, \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u044F
      \u0447\u0451\u0442\u043A\u0438 \u0438\u0437 \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
      \u043A\u043E\u0441\u0442\u0438. \u041B\u0438\u0446\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E,
      \u043A\u0430\u043A \u0433\u043E\u0440\u043D\u043E\u0435 \u043E\u0437\u0435\u0440\u043E,
      \u043D\u043E \u0433\u043B\u0430\u0437\u0430 \u0436\u0438\u0432\u044B\u0435,
      \u043F\u0440\u043E\u043D\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435.
      \u041E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0432\u0437\u0433\u043B\u044F\u0434
      \u043D\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0438 \u0432\u0441\u0442\u0430\u0451\u0442,
      \u0441\u043B\u043E\u0432\u043D\u043E \u0436\u0434\u0430\u043B \u0438\u043C\u0435\u043D\u043D\u043E
      \u0432\u0430\u0441.\r\n\r\n<npc_speech lang=\"Tibetan\">\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E,
      \u0433\u043E\u0441\u0442\u044C! \u042F \u041B\u043E\u0431\u0441\u0430\u043D\u0433.
      \u0412\u043E \u0441\u043D\u0435 \u044F \u0432\u0438\u0434\u0435\u043B \u0442\u0432\u043E\u0439
      \u043F\u0440\u0438\u0445\u043E\u0434. \u0415\u0441\u0442\u044C \u043E\u0434\u0438\u043D
      \u0445\u0440\u0430\u043C - \u0441\u043E\u043A\u0440\u044B\u0442\u044B\u0439
      \u0432 \u0433\u043E\u0440\u0430\u0445 - \u0442\u0430\u043C \u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F
      \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0435
      \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0441\u0443\u0434\u044C\u0431\u0443
      \u043F\u0443\u0442\u043D\u0438\u043A\u0430. \u0422\u0435\u0431\u0435 \u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442
      \u0438\u0434\u0442\u0438!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643626
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u0438 \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643627
    m_Localized: "\u0412\u044B \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0435\u0441\u044C
      \u043C\u043E\u043D\u0430\u0445\u0443 \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0435
      \u043F\u0443\u0442\u044C. \u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u043D\u0435
      \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 - \u043B\u0438\u0448\u044C
      \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043B\u0430\u0434\u043E\u043D\u0438
      \u0438 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442 \u0432\u0441\u043B\u0435\u0434
      \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435.
      \u041C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u0444\u043B\u0430\u0433\u0438
      \u0442\u0440\u0435\u0449\u0430\u0442 \u043D\u0430 \u0432\u0435\u0442\u0440\u0443,
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043F\u043E\u0437\u0430\u0434\u0438. \u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C,
      \u0434\u043E\u0440\u043E\u0433\u0430 \u043F\u0440\u0438\u0432\u0435\u0434\u0451\u0442
      \u0432\u0430\u0441 \u0441\u044E\u0434\u0430 \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643628
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0432\u0438\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643629
    m_Localized: "\u0412\u044B \u0441\u0430\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432
      \u041B\u043E\u0431\u0441\u0430\u043D\u0433\u0430, \u0438 \u043E\u043D \u0434\u043E\u043B\u0433\u043E
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u0430\u043C \u0432 \u0433\u043B\u0430\u0437\u0430,
      \u043C\u043E\u043B\u0447\u0430, \u043D\u0435 \u043C\u0438\u0433\u0430\u044F.
      \u041F\u043E\u0442\u043E\u043C \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F
      \u0438 \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0438\u0437-\u0437\u0430
      \u043F\u0430\u0437\u0443\u0445\u0438 \u0441\u0432\u0438\u0442\u043E\u043A,
      \u043E\u0431\u0451\u0440\u043D\u0443\u0442\u044B\u0439 \u0432 \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u0432\u0443\u044E
      \u0442\u043A\u0430\u043D\u044C. \xAB\u0412\u0438\u0436\u0443: \u0434\u043E\u0440\u043E\u0433\u0430
      \u0442\u0435\u0431\u044F \u043D\u0435 \u0441\u043B\u043E\u043C\u0430\u043B\u0430.
      \u0414\u043E\u0441\u0442\u0430\u0432\u044C \u044D\u0442\u043E \u0432 \u0410\u043D\u044C\u0441\u0438,
      \u0432 \u043F\u0435\u0449\u0435\u0440\u044B \u041C\u043E\u0433\u0430\u043E.
      \u041C\u043E\u043D\u0430\u0445 \u043F\u043E \u0438\u043C\u0435\u043D\u0438
      \u0422\u0438\u043D\u043B\u0435\u0439 \u043F\u0440\u0438\u043C\u0435\u0442 \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435.\xBB
      \u041E\u043D \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u0432
      \u0432\u0430\u0448\u0443 \u0440\u0443\u043A\u0443 \u0441\u0432\u0438\u0442\u043E\u043A
      \u0438 \u043F\u0430\u043B\u043E\u0447\u043A\u0443 \u043B\u0430\u0434\u0430\u043D\u0430.
      \xAB\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u0436\u0433\u0438, \u0437\u0430\u043F\u0430\u0445
      \u043E\u0442\u0433\u043E\u043D\u0438\u0442 \u0437\u043B\u043E.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643630
    m_Localized: "\u0412\u044B \u0441\u0430\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432
      \u041B\u043E\u0431\u0441\u0430\u043D\u0433\u0430, \u043D\u043E \u043F\u043E\u0434
      \u0435\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043D\u0435 \u043F\u043E \u0441\u0435\u0431\u0435. \u0421\u043B\u043E\u0432\u0430
      \u043F\u0443\u0442\u0430\u044E\u0442\u0441\u044F, \u043C\u044B\u0441\u043B\u0438
      \u0440\u0430\u0437\u0431\u0435\u0433\u0430\u044E\u0442\u0441\u044F: \u0442\u043E
      \u043B\u0438 \u0432\u044B\u0441\u043E\u0442\u0430, \u0442\u043E \u043B\u0438
      \u0447\u0442\u043E-\u0442\u043E \u0438\u043D\u043E\u0435. \u041C\u043E\u043D\u0430\u0445
      \u0434\u043E\u043B\u0433\u043E \u043C\u043E\u043B\u0447\u0438\u0442. \u041F\u043E\u0442\u043E\u043C
      \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0441\u0432\u0438\u0442\u043E\u043A,
      \u043E\u0431\u0451\u0440\u043D\u0443\u0442\u044B\u0439 \u0432 \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u0432\u0443\u044E
      \u0442\u043A\u0430\u043D\u044C, \u0438 \u043A\u043B\u0430\u0434\u0451\u0442
      \u043D\u0430 \u0437\u0435\u043C\u043B\u044E \u043C\u0435\u0436\u0434\u0443
      \u0432\u0430\u043C\u0438. \xAB\u042F \u0432\u0438\u0436\u0443: \u0442\u044B
      \u043D\u0435 \u0433\u043E\u0442\u043E\u0432. \u041D\u043E \u0441\u0432\u0438\u0442\u043E\u043A
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0436\u0434\u0430\u0442\u044C,
      \u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u044B \u0438\u0434\u0443\u0442
      \u043D\u0430 \u044E\u0433 \u0432\u0441\u0451 \u0440\u0435\u0436\u0435.\xBB
      \u041E\u043D \u043D\u0435 \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0441\u0432\u0438\u0442\u043E\u043A \u0432 \u0440\u0443\u043A\u0443, \u043F\u0440\u043E\u0441\u0442\u043E
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043D\u0430 \u043A\u0430\u043C\u043D\u0435.
      \u041B\u0430\u0434\u0430\u043D\u0430 \u043D\u0435 \u0434\u0430\u0451\u0442.
      \xAB\u041B\u0430\u0434\u0430\u043D \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u044E\u0442
      \u0442\u0435, \u043A\u0442\u043E \u043D\u0435\u0441\u0451\u0442 \u0441\u0432\u0435\u0442.
      \u0422\u044B \u043F\u043E\u043A\u0430 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0435\u0441\u0451\u0448\u044C \u0433\u0440\u0443\u0437. \u0414\u043E\u0441\u0442\u0430\u0432\u044C
      \u0441\u0432\u0438\u0442\u043E\u043A \u0432 \u0410\u043D\u044C\u0441\u0438,
      \u0432 \u043F\u0435\u0449\u0435\u0440\u044B \u041C\u043E\u0433\u0430\u043E,
      \u043C\u043E\u043D\u0430\u0445\u0443 \u043F\u043E \u0438\u043C\u0435\u043D\u0438
      \u0422\u0438\u043D\u043B\u0435\u0439. \u0415\u0441\u043B\u0438 \u0434\u043E\u0440\u043E\u0433\u0430
      \u043D\u0435 \u0441\u043B\u043E\u043C\u0430\u0435\u0442 \u0442\u0435\u0431\u044F,
      \u043C\u043E\u0436\u0435\u0442, \u043D\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u043C
      \u043F\u0443\u0442\u0438 \u0442\u044B \u0431\u0443\u0434\u0435\u0448\u044C
      \u0434\u0440\u0443\u0433\u0438\u043C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643631
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0441 \u043C\u043E\u043D\u0430\u0445\u043E\u043C \u043D\u0430 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643632
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043A \u041B\u043E\u0431\u0441\u0430\u043D\u0433\u0443
      \u043D\u0430 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u043C, \u0431\u0435\u0433\u043B\u043E
      \u0438 \u0441 \u043F\u043E\u0447\u0442\u0435\u043D\u0438\u0435\u043C: <npc_speech
      lang=\"Tibetan\">\u041F\u043E\u0447\u0442\u0435\u043D\u043D\u044B\u0439 \u041B\u043E\u0431\u0441\u0430\u043D\u0433,
      \u043C\u044B \u043F\u0440\u0438\u0448\u043B\u0438 \u0441 \u043C\u0438\u0440\u043E\u043C.
      \u041C\u043E\u0439 \u0433\u043E\u0441\u043F\u043E\u0434\u0438\u043D \u0433\u043E\u0442\u043E\u0432
      \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u0442\u044C \u0432\u0430\u0448\u0435
      \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435.</npc_speech> \u0421\u0442\u0430\u0440\u0438\u043A
      \u0441\u0432\u0435\u0442\u043B\u0435\u0435\u0442 \u043B\u0438\u0446\u043E\u043C
      \u0438 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u0435\u0442 \u043E\u0431\u043E\u0438\u0445
      \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C. \u0417\u0430
      \u0447\u0430\u0448\u043A\u043E\u0439 \u0441\u043E\u043B\u0451\u043D\u043E\u0433\u043E
      \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0433\u043E \u0447\u0430\u044F \u043E\u043D
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043E
      \u0445\u0440\u0430\u043C\u0435 \u0432 \u0433\u043E\u0440\u0430\u0445, \u043E
      \u0441\u0432\u0438\u0442\u043A\u0435 \u0438 \u043E \u043F\u0443\u0442\u0438,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0436\u0434\u0451\u0442 \u0432\u043F\u0435\u0440\u0435\u0434\u0438.
      \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442
      \u043A\u0430\u0436\u0434\u043E\u0435 \u0441\u043B\u043E\u0432\u043E, \u0430
      \u0432\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435,
      \u043A\u0430\u043A \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0435 \u0444\u0440\u0430\u0437\u044B
      \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0433\u043E\u043B\u043E\u0432\u0435. \u041B\u043E\u0431\u0441\u0430\u043D\u0433
      \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u0432\u0430\u043C \u0441\u0432\u0438\u0442\u043E\u043A
      \u0438 \u043F\u0430\u043B\u043E\u0447\u043A\u0443 \u043B\u0430\u0434\u0430\u043D\u0430
      \u0441 \u043B\u0451\u0433\u043A\u0438\u043C \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C.
      \xAB\u0422\u0432\u043E\u0439 \u0441\u043F\u0443\u0442\u043D\u0438\u043A \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442
      \u043C\u0438\u0440\u044B. \u0411\u0435\u0440\u0435\u0433\u0438 \u0435\u0433\u043E.\xBB
      \u0412\u044B \u043F\u043E\u043A\u0438\u0434\u0430\u0435\u0442\u0435 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C
      \u0441 \u043D\u043E\u0432\u044B\u043C \u0437\u0430\u0434\u0430\u043D\u0438\u0435\u043C
      \u0438 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435\u043C, \u0447\u0442\u043E
      \u0433\u043E\u0440\u044B \u043F\u0440\u0438\u043D\u044F\u043B\u0438 \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643633
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643634
    m_Localized: "\u041D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435 \u043A
      \u0432\u0430\u0448\u0435\u043C\u0443 \u043A\u043E\u0441\u0442\u0440\u0443 \u043F\u043E\u0434\u0441\u0430\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u0442\u0430\u0440\u0438\u043A: \u0441\u0443\u0445\u043E\u0439, \u0436\u0438\u043B\u0438\u0441\u0442\u044B\u0439,
      \u0441 \u043B\u0438\u0446\u043E\u043C, \u0432\u044B\u0442\u0435\u0441\u0430\u043D\u043D\u044B\u043C
      \u0432\u0435\u0442\u0440\u043E\u043C \u0438 \u0441\u043E\u043B\u043D\u0446\u0435\u043C
      \u0434\u043E \u0446\u0432\u0435\u0442\u0430 \u0441\u0442\u0430\u0440\u043E\u0439
      \u043A\u043E\u0436\u0438. \u041B\u0435\u0432\u0430\u044F \u0440\u0443\u043A\u0430
      \u0438\u0441\u043A\u0430\u043B\u0435\u0447\u0435\u043D\u0430: \u0434\u0432\u0430
      \u043F\u0430\u043B\u044C\u0446\u0430 \u043D\u0435 \u0433\u043D\u0443\u0442\u0441\u044F,
      \u0441\u043B\u0435\u0434\u044B \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u043E\u0436\u043E\u0433\u0430.
      \u041E\u043D \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0414\u0430\u0440\u0438\u0443\u0448\u0435\u043C \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u0447\u0442\u043E \u0432\u043E\u0434\u0438\u043B \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u044B
      \u0441\u043E\u0440\u043E\u043A \u043B\u0435\u0442, \u043E\u0442 \u0427\u0430\u043D\u044A\u0430\u043D\u044F
      \u0434\u043E \u0411\u0430\u0433\u0434\u0430\u0434\u0430, \u0447\u0435\u0440\u0435\u0437
      \u043F\u0435\u0441\u043A\u0438 \u0438 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u044B,
      \u0447\u0435\u0440\u0435\u0437 \u0432\u043E\u0439\u043D\u044B \u0438 \u0447\u0443\u043C\u0443.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043E\u043D \u0441\u0442\u0430\u0440
      \u0438 \u0438\u0449\u0435\u0442 \u043F\u0440\u0435\u0435\u043C\u043D\u0438\u043A\u0430
      - \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u0441\u043C\u043E\u0436\u0435\u0442
      \u043F\u0440\u043E\u0439\u0442\u0438 \u0435\u0433\u043E \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u0438 \u0441\u0442\u0430\u0442\u044C \u043B\u0435\u0433\u0435\u043D\u0434\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433. \u041E\u043D \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u0438\u0437 \u043C\u0435\u0448\u043A\u0430 \u043F\u043E\u043B\u043E\u0441\u043A\u0443
      \u0432\u044F\u043B\u0435\u043D\u043E\u0433\u043E \u043C\u044F\u0441\u0430,
      \u0440\u0430\u0437\u043B\u0430\u043C\u044B\u0432\u0430\u0435\u0442 \u043F\u043E\u043F\u043E\u043B\u0430\u043C
      \u0438 \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0432\u0430\u043C.
      \u0421\u0442\u0430\u0440\u0438\u043A \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442:
      \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0438 \u0436\u0434\u0451\u0442 \u043E\u0442\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643635
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643636
    m_Localized: "\u0412\u044B \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u0435
      \u0414\u0430\u0440\u0438\u0443\u0448\u0430, \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442\u0435
      \u043C\u044F\u0441\u043E \u0438 \u0441\u043B\u0443\u0448\u0430\u0435\u0442\u0435
      \u0435\u0433\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B \u0434\u043E
      \u043F\u043E\u043B\u0443\u043D\u043E\u0447\u0438: \u043E \u043F\u0435\u0441\u0447\u0430\u043D\u044B\u0445
      \u0431\u0443\u0440\u044F\u0445 \u043F\u043E\u0434 \u041A\u0430\u0448\u0433\u0430\u0440\u043E\u043C,
      \u043E \u0432\u043E\u043B\u043A\u0430\u0445 \u043D\u0430 \u041F\u0430\u043C\u0438\u0440\u0435,
      \u043E \u0447\u0443\u043C\u0435 \u0432 \u041C\u0435\u0448\u0445\u0435\u0434\u0435.
      \u0425\u043E\u0440\u043E\u0448\u0438\u0435 \u0438\u0441\u0442\u043E\u0440\u0438\u0438,
      \u043D\u043E \u043D\u0435 \u0432\u0430\u0448\u0430 \u0434\u043E\u0440\u043E\u0433\u0430.
      \u0421\u0442\u0430\u0440\u0438\u043A \u043A\u0438\u0432\u0430\u0435\u0442 \u0431\u0435\u0437
      \u043E\u0431\u0438\u0434\u044B, \u0434\u043E\u043F\u0438\u0432\u0430\u0435\u0442
      \u0447\u0430\u0439 \u0438 \u0443\u0445\u043E\u0434\u0438\u0442 \u0437\u0430\u0442\u0435\u043C\u043D\u043E.
      \u0411\u044B\u0442\u044C \u043C\u043E\u0436\u0435\u0442, \u0435\u0449\u0451
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643637
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0432\u044B\u0437\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643638
    m_Localized: "\u0412\u044B \u0431\u0435\u0440\u0451\u0442\u0435 \u043C\u044F\u0441\u043E,
      \u043E\u0442\u043A\u0443\u0441\u044B\u0432\u0430\u0435\u0442\u0435 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
      \u0441\u0442\u0430\u0440\u0438\u043A\u0443 \u0432 \u0433\u043B\u0430\u0437\u0430.
      \u0414\u0430\u0440\u0438\u0443\u0448 \u0443\u0441\u043C\u0435\u0445\u0430\u0435\u0442\u0441\u044F:
      \u0432 \u044D\u0442\u043E\u043C \u0436\u0435\u0441\u0442\u0435 \u043E\u043D
      \u043F\u0440\u043E\u0447\u0451\u043B \u0432\u0441\u0451, \u0447\u0442\u043E
      \u0445\u043E\u0442\u0435\u043B. \u0414\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430
      \u043E\u043D \u0440\u0438\u0441\u0443\u0435\u0442 \u043D\u0430 \u0437\u0435\u043C\u043B\u0435
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442: \u043A\u0430\u0436\u0434\u044B\u0439
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B, \u043A\u0430\u0436\u0434\u044B\u0439
      \u043A\u043E\u043B\u043E\u0434\u0435\u0446, \u043A\u0430\u0436\u0434\u0443\u044E
      \u0437\u0430\u0441\u0430\u0434\u0443, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u043F\u043E\u043C\u043D\u0438\u0442 \u0437\u0430 \u0441\u043E\u0440\u043E\u043A
      \u043B\u0435\u0442. \u0412\u044B \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442\u0435.
      \u0423\u0445\u043E\u0434\u044F, \u043E\u043D \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u043C\u0435\u0448\u043E\u043A \u0432\u044F\u043B\u0435\u043D\u043E\u0433\u043E
      \u043C\u044F\u0441\u0430 \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0447\u0435\u0440\u0435\u0437 \u043F\u043B\u0435\u0447\u043E: \xAB\u041F\u0435\u0440\u0432\u044B\u0439
      \u043A\u043E\u043D\u0432\u043E\u0439: \u0434\u043E\u0432\u0435\u0441\u0442\u0438
      \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432 \u0434\u043E \u0410\u043D\u044C\u0441\u0438.
      \u0421\u043F\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F - \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C
      \u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0445 \u0434\u043E\u0440\u043E\u0433\u0430\u0445.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643639
    m_Localized: "\u0412\u044B \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0435\u0441\u044C,
      \u0438 \u0414\u0430\u0440\u0438\u0443\u0448 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u0440\u0430\u0441\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C:
      \u043E \u0434\u043E\u0440\u043E\u0433\u0430\u0445, \u043E \u0441\u043B\u0435\u0434\u0430\u0445,
      \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043B\u0430\u0433\u0435\u0440\u044C \u043D\u0430 \u0441\u043A\u043B\u043E\u043D\u0435.
      \u0412\u0430\u0448\u0438 \u043E\u0442\u0432\u0435\u0442\u044B \u0435\u0433\u043E
      \u043D\u0435 \u0443\u0431\u0435\u0436\u0434\u0430\u044E\u0442. \u041E\u043D
      \u0445\u043C\u0443\u0440\u0438\u0442\u0441\u044F \u0438 \u0434\u043E\u043B\u0433\u043E
      \u043C\u043E\u043B\u0447\u0438\u0442, \u0433\u043B\u044F\u0434\u044F \u0432
      \u043E\u0433\u043E\u043D\u044C. \xAB\u0422\u044B \u043D\u0435 \u0443\u043C\u0435\u0435\u0448\u044C
      \u0447\u0438\u0442\u0430\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0443.
      \u041D\u043E \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432 \u043A\u0442\u043E-\u0442\u043E
      \u0434\u043E\u043B\u0436\u0435\u043D \u0434\u043E\u0432\u0435\u0441\u0442\u0438
      \u0434\u043E \u0410\u043D\u044C\u0441\u0438, \u0430 \u043C\u043E\u0451 \u043A\u043E\u043B\u0435\u043D\u043E
      \u0443\u0436\u0435 \u043D\u0435 \u0433\u043D\u0451\u0442\u0441\u044F \u0434\u043B\u044F
      \u0441\u0435\u0434\u043B\u0430.\xBB \u041E\u043D \u0432\u0441\u0442\u0430\u0451\u0442
      \u0438 \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u0441\u0432\u043E\u0439
      \u043C\u0435\u0448\u043E\u043A \u0441 \u043C\u044F\u0441\u043E\u043C. \u041A\u0430\u0440\u0442\u0443
      \u0440\u0438\u0441\u0443\u0435\u0442 - \u043D\u043E \u043A\u0440\u0438\u0432\u0443\u044E,
      \u0431\u0435\u0437 \u0434\u0435\u0442\u0430\u043B\u0435\u0439. \xAB\u041E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u0443\u0437\u043D\u0430\u0435\u0448\u044C \u0441\u0430\u043C, \u0435\u0441\u043B\u0438
      \u0434\u043E\u0436\u0438\u0432\u0451\u0448\u044C.\xBB \u041C\u0430\u0440\u0448\u0440\u0443\u0442\u0430
      \u0442\u043E\u043B\u043A\u043E\u043C \u043D\u0435\u0442, \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B, \u0438 \u0432 \u0435\u0433\u043E
      \u0433\u043E\u043B\u043E\u0441\u0435 \u0432\u043C\u0435\u0441\u0442\u043E \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F
      \u0443\u0441\u0442\u0430\u043B\u043E\u0435 \xAB\u043D\u0430 \u0431\u0435\u0437\u0440\u044B\u0431\u044C\u0435\xBB.
      \u0417\u0430\u0434\u0430\u043D\u0438\u0435 \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438,
      \u043D\u043E \u0431\u0435\u0437 \u043A\u0430\u0440\u0442\u044B \u0414\u0430\u0440\u0438\u0443\u0448\u0430
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0441\u0442\u0430\u043B\u0430 \u043E\u043F\u0430\u0441\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643640
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u0414\u0430\u0440\u0438\u0443\u0448\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643641
    m_Localized: "\u0412\u0430\u0448 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0437\u0430\u043C\u0438\u0440\u0430\u0435\u0442, \u0443\u0432\u0438\u0434\u0435\u0432
      \u0441\u0442\u0430\u0440\u0438\u043A\u0430, \u0430 \u043F\u043E\u0442\u043E\u043C
      \u0448\u0438\u0440\u043E\u043A\u043E \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F.
      \xAB\u0414\u0430\u0440\u0438\u0443\u0448-\u0430\u0433\u0430! \u042D\u0442\u043E
      \u0442\u044B \u0443\u0447\u0438\u043B \u043C\u0435\u043D\u044F \u0447\u0438\u0442\u0430\u0442\u044C
      \u0441\u043B\u0435\u0434\u044B \u043F\u043E\u0434 \u041A\u0430\u0448\u0433\u0430\u0440\u043E\u043C
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434!\xBB
      \u0421\u0442\u0430\u0440\u0438\u043A \u0441\u043C\u043E\u0442\u0440\u0438\u0442,
      \u0449\u0443\u0440\u0438\u0442\u0441\u044F \u0438 \u0432\u0434\u0440\u0443\u0433
      \u0445\u043E\u0445\u043E\u0447\u0435\u0442, \u0445\u043B\u043E\u043F\u0430\u044F
      \u0441\u0435\u0431\u044F \u043F\u043E \u043A\u043E\u043B\u0435\u043D\u0443.
      \xAB\u041C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0437\u0430\u0431\u043B\u0443\u0434\u0438\u043B\u0441\u044F \u0432 \u0442\u0440\u0451\u0445
      \u0431\u0430\u0440\u0445\u0430\u043D\u0430\u0445? \u0412\u044B\u0440\u043E\u0441!\xBB
      \u041E\u043D\u0438 \u043E\u0431\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F,
      \u0438 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0438\u0434\u0451\u0442
      \u043B\u0435\u0433\u043A\u043E: \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0440\u0443\u0447\u0430\u0435\u0442\u0441\u044F \u0437\u0430 \u0432\u0430\u0441,
      \u0414\u0430\u0440\u0438\u0443\u0448 \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u043A\u0430\u0440\u0442\u0443 \u0438 \u043C\u0435\u0448\u043E\u043A \u0432\u044F\u043B\u0435\u043D\u043E\u0433\u043E
      \u043C\u044F\u0441\u0430, \u0438 \u043A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443
      \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C \u0437\u0430\u0434\u0430\u043D\u0438\u0435,
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0438 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u0437\u043D\u0430\u044E\u0449\u0435\u0433\u043E
      \u043A\u0430\u0436\u0434\u044B\u0439 \u043A\u0430\u043C\u0435\u043D\u044C \u043E\u0442
      \u0427\u0430\u043D\u044A\u0430\u043D\u044F \u0434\u043E \u0411\u0430\u0433\u0434\u0430\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643642
    m_Localized: "\u0421\u0435\u043A\u0440\u0435\u0442 \u043A\u0440\u0430\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643643
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u043F\u0440\u0438\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u043E\u0433\u043E
      \u0433\u043E\u0440\u043E\u0434\u043A\u0430 \u043F\u043E\u0436\u0438\u043B\u043E\u0439
      \u043A\u0438\u0442\u0430\u0435\u0446 \u0432 \u0437\u0430\u043B\u0430\u0442\u0430\u043D\u043D\u043E\u043C
      \u0448\u0451\u043B\u043A\u043E\u0432\u043E\u043C \u0445\u0430\u043B\u0430\u0442\u0435
      \u043E\u043A\u043B\u0438\u043A\u0430\u0435\u0442 \u0432\u0430\u0441; \u043F\u0430\u043B\u044C\u0446\u044B
      \u0443 \u043D\u0435\u0433\u043E \u0441\u0438\u043D\u0438\u0435 \u043E\u0442
      \u0438\u043D\u0434\u0438\u0433\u043E, \u043F\u043E\u0434 \u043D\u043E\u0433\u0442\u044F\u043C\u0438
      \u0437\u0430\u0441\u043E\u0445\u0448\u0430\u044F \u043A\u0440\u0430\u0441\u043A\u0430.
      \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E,
      \u043F\u043E\u0447\u0442\u0438 \u0448\u0451\u043F\u043E\u0442\u043E\u043C,
      \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C \u043F\u043E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C. \u0412 \u0435\u0433\u043E
      \u0433\u043E\u043B\u043E\u0441\u0435 \u0441\u043B\u044B\u0448\u0438\u0442\u0441\u044F
      \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
      \u043F\u043E\u0442\u0435\u0440\u044F\u0432\u0448\u0435\u0433\u043E \u0434\u0435\u043B\u043E
      \u0432\u0441\u0435\u0439 \u0436\u0438\u0437\u043D\u0438, \u0438 \u0443\u043F\u0440\u044F\u043C\u0441\u0442\u0432\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043D\u0435 \u043D\u0430\u043C\u0435\u0440\u0435\u043D \u0441\u0434\u0430\u0442\u044C\u0441\u044F.\r\n\r\n<npc_speech
      lang=\"Chinese\">\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446. \u042F \u0427\u044D\u043D\u044C
      \u0412\u044D\u0439, \u043A\u0440\u0430\u0441\u0438\u043B\u044C\u0449\u0438\u043A
      \u0438\u0437 \u0427\u0430\u043D\u044A\u0430\u043D\u044F. \u042D\u0442\u043E\u0442
      \u0448\u0451\u043B\u043A - \u0432\u0430\u0448? \u041E\u0442\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430. \u042F \u0437\u043D\u0430\u044E
      \u043E\u0434\u0438\u043D \u0446\u0432\u0435\u0442 - \u043F\u0443\u0440\u043F\u0443\u0440\u043D\u044B\u0439,
      \u0447\u0442\u043E \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435
      \u0432\u044B\u0446\u0432\u0435\u0442\u0430\u0435\u0442. \u041D\u043E \u043C\u043D\u0435
      \u043D\u0443\u0436\u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C. \u0412\u044B\u0441\u043B\u0443\u0448\u0430\u0435\u0442\u0435?</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643644
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643645
    m_Localized: "\u0412\u044B \u043A\u0438\u0432\u0430\u0435\u0442\u0435 \u043C\u0430\u0441\u0442\u0435\u0440\u0443
      \u0427\u044D\u043D\u044E \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0435
      \u043F\u0443\u0442\u044C. \u0421\u0442\u0430\u0440\u0438\u043A \u043D\u0435
      \u043E\u0431\u0438\u0436\u0430\u0435\u0442\u0441\u044F - \u043F\u0440\u044F\u0447\u0435\u0442
      \u0440\u0443\u043A\u0438 \u0432 \u0440\u0443\u043A\u0430\u0432\u0430 \u0438
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043A
      \u0441\u0432\u043E\u0438\u043C \u043A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044F\u043C.
      \u0421\u0435\u043A\u0440\u0435\u0442\u044B \u0448\u0451\u043B\u043A\u0430 \u043F\u043E\u0434\u043E\u0436\u0434\u0443\u0442
      \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643646
    m_Localized: "\u0412\u044B\u0441\u043B\u0443\u0448\u0430\u0442\u044C \u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643647
    m_Localized: "\u0412\u044B \u043E\u0442\u0432\u043E\u0434\u0438\u0442\u0435 \u043C\u0430\u0441\u0442\u0435\u0440\u0430
      \u0427\u044D\u043D\u044F \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u0438 \u0441\u043B\u0443\u0448\u0430\u0435\u0442\u0435. \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043E \u0441\u043E\u0440\u0442\u0430\u0445 \u0441\u044B\u0440\u044C\u044F,
      \u043E \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0435 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0430,
      \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u043E\u0442\u043B\u0438\u0447\u0438\u0442\u044C
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u043A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044C
      \u043E\u0442 \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0438. \u0421 \u043A\u0430\u0436\u0434\u044B\u043C
      \u0441\u043B\u043E\u0432\u043E\u043C \u0432\u044B \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442\u0435:
      \u044D\u0442\u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0437\u043D\u0430\u0435\u0442
      \u0441\u0432\u043E\u0451 \u0434\u0435\u043B\u043E \u043B\u0443\u0447\u0448\u0435,
      \u0447\u0435\u043C \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432 \u0437\u043D\u0430\u044E\u0442
      \u0441\u0432\u043E\u0439 \u0442\u043E\u0432\u0430\u0440. \u0412\u044B \u0436\u043C\u0451\u0442\u0435
      \u0435\u043C\u0443 \u0440\u0443\u043A\u0443. \u041E\u043D \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u0438\u0437 \u043C\u0435\u0448\u043A\u0430 \u043F\u043B\u043E\u0448\u043A\u0443
      \u0438\u043D\u0434\u0438\u0433\u043E (\xAB\u0437\u0430\u0434\u0430\u0442\u043E\u043A
      \u0438 \u043F\u0435\u0440\u0432\u044B\u0439 \u0443\u0440\u043E\u043A\xBB) \u0438
      \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442, \u0447\u0442\u043E
      \u043D\u0443\u0436\u043D\u043E: \u043A\u0443\u043F\u0438\u0442\u044C \u043F\u044F\u0442\u044C
      \u0435\u0434\u0438\u043D\u0438\u0446 \u0441\u044B\u0440\u044C\u044F \u0438
      \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0435\u043C\u0443 \u0432
      \u0427\u0430\u043D\u044A\u0430\u043D\u044C. \u041F\u0443\u0442\u044C \u043A
      \u0441\u0435\u043A\u0440\u0435\u0442\u0430\u043C \u0448\u0451\u043B\u043A\u0430
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0441 \u043C\u0430\u043B\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643648
    m_Localized: "\u0412\u044B \u043F\u044B\u0442\u0430\u0435\u0442\u0435\u0441\u044C
      \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F, \u043D\u043E
      \u043C\u0430\u0441\u0442\u0435\u0440 \u0427\u044D\u043D\u044C \u0431\u044B\u0441\u0442\u0440\u043E
      \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442, \u0447\u0442\u043E \u0432\u044B
      \u043D\u0435 \u043E\u0442\u043B\u0438\u0447\u0438\u0442\u0435 \u0438\u043D\u0434\u0438\u0433\u043E
      \u043E\u0442 \u0441\u0430\u0436\u0438. \u041E\u043D \u043A\u0430\u0447\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u043F\u043B\u043E\u0448\u043A\u0438.
      \u041F\u043E\u0442\u043E\u043C \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0441
      \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u044E\u0449\u0435. \xAB\u0422\u044B
      \u043D\u0435 \u0437\u043D\u0430\u0435\u0448\u044C \u043A\u0440\u0430\u0441\u043E\u043A.
      \u041D\u043E \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u0430 \u043C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D \u043A\u0443\u0440\u044C\u0435\u0440,
      \u043D\u0435 \u0443\u0447\u0451\u043D\u044B\u0439.\xBB \u041E\u043D \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u0438\u043D\u0434\u0438\u0433\u043E \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u0432 \u043C\u0435\u0448\u043E\u043A: \u0437\u0430\u0434\u0430\u0442\u043A\u0430
      \u043D\u0435 \u0431\u0443\u0434\u0435\u0442. \xAB\u041F\u044F\u0442\u044C \u0435\u0434\u0438\u043D\u0438\u0446
      \u0441\u044B\u0440\u044C\u044F, \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u044C. \u0414\u0435\u043D\u0435\u0433
      \u043D\u0430 \u0437\u0430\u043A\u0443\u043F\u043A\u0443 \u0434\u0430\u043C
      \u0432 \u043E\u0431\u0440\u0435\u0437, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u0438\u0437 \u0441\u0432\u043E\u0435\u0433\u043E \u043A\u043E\u0448\u0435\u043B\u044C\u043A\u0430.
      \u0415\u0441\u043B\u0438 \u043F\u0440\u0438\u0432\u0435\u0437\u0451\u0448\u044C
      \u0432\u043E\u0432\u0440\u0435\u043C\u044F \u0438 \u043D\u0435 \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u0448\u044C,
      \u0442\u043E\u0433\u0434\u0430 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C
      \u043E \u043A\u0440\u0430\u0441\u043A\u0430\u0445.\xBB \u041E\u043D \u0441\u0443\u0451\u0442
      \u0432\u0430\u043C \u0437\u0430\u043F\u0438\u0441\u043A\u0443 \u0441 \u0430\u0434\u0440\u0435\u0441\u043E\u043C,
      \u043D\u043E \u043D\u0438 \u0443\u0440\u043E\u043A\u0430, \u043D\u0438 \u0437\u0430\u0434\u0430\u0442\u043A\u0430:
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0435
      \u0438 \u0441\u043A\u0443\u043F\u043E \u043E\u0442\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u0435
      \u0434\u043E\u0432\u0435\u0440\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643649
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0440\u0430\u0441\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u043D\u0430 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643650
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B \u0441 \u043C\u0430\u0441\u0442\u0435\u0440\u043E\u043C
      \u0427\u044D\u043D\u0435\u043C \u043D\u0430 \u0440\u043E\u0434\u043D\u043E\u043C:
      <npc_speech lang=\"Chinese\">\u041C\u0430\u0441\u0442\u0435\u0440 \u0427\u044D\u043D\u044C,
      \u043C\u043E\u0439 \u0433\u043E\u0441\u043F\u043E\u0434\u0438\u043D - \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0448\u0451\u043B\u043A\u043E\u043C. \u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438\u0442\u0435
      \u0435\u043C\u0443 \u043E \u0432\u0430\u0448\u0435\u043C \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435,
      \u043F\u0440\u043E\u0448\u0443.</npc_speech> \u0421\u0442\u0430\u0440\u0438\u043A
      \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u0438\u043B\u0441\u044F. \u041E\u043D
      \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B \u0431\u044B\u0441\u0442\u0440\u043E,
      \u0436\u0435\u0441\u0442\u0438\u043A\u0443\u043B\u0438\u0440\u0443\u044F \u0441\u0438\u043D\u0438\u043C\u0438
      \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438, \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044F
      \u043D\u0430 \u0442\u043A\u0430\u043D\u0438, \u043D\u0430 \u043D\u0435\u0431\u043E,
      \u043D\u0430 \u0437\u0435\u043C\u043B\u044E. \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u0435\u0434\u0432\u0430 \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0442 \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0442\u044C:
      \u0440\u0435\u0447\u044C \u0438\u0434\u0451\u0442 \u043E \u0440\u0435\u0434\u043A\u043E\u043C
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0438 \u0432 \u043E\u043A\u0440\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044F\u0445
      \u0410\u043D\u044C\u0441\u0438, \u043E \u0441\u0435\u043A\u0440\u0435\u0442\u0435
      \u043F\u0443\u0440\u043F\u0443\u0440\u0430, \u043E \u0442\u043E\u043C, \u043A\u0430\u043A
      \u0438\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0441\u043A\u0438\u0439
      \u0434\u0432\u043E\u0440 \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0437\u0430\u043A\u0430\u0437\u044B\u0432\u0430\u043B
      \u0442\u043A\u0430\u043D\u0438 \u0438\u043C\u0435\u043D\u043D\u043E \u0443
      \u0435\u0433\u043E \u0441\u0435\u043C\u044C\u0438. \u041C\u0430\u0441\u0442\u0435\u0440
      \u0427\u044D\u043D\u044C \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0432\u0430\u043C \u0432 \u0440\u0443\u043A\u0443 \u043F\u043B\u043E\u0448\u043A\u0443
      \u0441 \u0438\u043D\u0434\u0438\u0433\u043E \u0438 \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F.
      \xAB\u0427\u0435\u043B\u043E\u0432\u0435\u043A, \u043F\u0440\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u0435\u0441\u0442\u044C \u0442\u043E\u043B\u043C\u0430\u0447, \u0443\u043C\u0435\u044E\u0449\u0438\u0439
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043F\u043E-\u043D\u0430\u0448\u0435\u043C\u0443
      - \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446.
      \u042F \u0434\u043E\u0432\u0435\u0440\u044F\u044E.\xBB \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435
      \u0441 \u0440\u044B\u043D\u043A\u0430 \u0441 \u0437\u0430\u0434\u0430\u043D\u0438\u0435\u043C,
      \u043A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u0435\u043C \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C\u0438
      \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u043C\u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438,
      \u043E\u0441\u0435\u0432\u0448\u0438\u043C\u0438 \u0432 \u043F\u0430\u043C\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643651
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u043D\u044B\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043D\u0430 \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643652
    m_Localized: "\u0423\u0437\u043A\u0430\u044F \u0442\u0440\u043E\u043F\u0430 \u043D\u0430\u0434
      \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C\u044E. \u0418\u0437-\u0437\u0430
      \u0432\u044B\u0441\u0442\u0443\u043F\u0430 \u0441\u043A\u0430\u043B\u044B \u0432\u044B\u0445\u043E\u0434\u0438\u0442
      \u0432\u0441\u0442\u0440\u0435\u0447\u043D\u044B\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D:
      \u0448\u0438\u0440\u043E\u043A\u043E\u043F\u043B\u0435\u0447\u0438\u0439 \u0442\u044E\u0440\u043E\u043A-\u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A,
      \u0442\u0440\u0438 \u044F\u043A\u0430 \u0441 \u0442\u044E\u043A\u0430\u043C\u0438
      \u0448\u0435\u0440\u0441\u0442\u0438, \u0442\u0440\u0438 \u043F\u043E\u0432\u043E\u0437\u043A\u0438.
      \u0414\u0432\u043E\u0438\u043C \u0437\u0434\u0435\u0441\u044C \u043D\u0435
      \u0440\u0430\u0437\u044A\u0435\u0445\u0430\u0442\u044C\u0441\u044F, \u043A\u0442\u043E-\u0442\u043E
      \u0434\u043E\u043B\u0436\u0435\u043D \u0443\u0441\u0442\u0443\u043F\u0438\u0442\u044C.
      \u0422\u044E\u0440\u043E\u043A \u0443\u043F\u0438\u0440\u0430\u0435\u0442 \u0440\u0443\u043A\u0438
      \u0432 \u0431\u043E\u043A\u0430 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0441 \u0432\u044B\u0436\u0438\u0434\u0430\u044E\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643653
    m_Localized: "\u0421\u0442\u043E\u044F\u0442\u044C \u043D\u0430\u0441\u043C\u0435\u0440\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643654
    m_Localized: "\u0412\u044B \u0443\u043F\u0438\u0440\u0430\u0435\u0442\u0435\u0441\u044C
      \u0438 \u043D\u0435 \u0441\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u0442\u0440\u043E\u043F\u044B.
      \u0427\u0430\u0441 \u0441\u043F\u043E\u0440, \u0434\u0432\u0430 \u0447\u0430\u0441\u0430
      \u043A\u0440\u0438\u043A\u0438, \u0442\u0440\u0438 \u0447\u0430\u0441\u0430
      \u0432\u0437\u0430\u0438\u043C\u043D\u043E\u0439 \u0440\u0443\u0433\u0430\u043D\u0438.
      \u0422\u044E\u0440\u043E\u043A \u043F\u043B\u044E\u0451\u0442 \u0438 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0441\u0432\u043E\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D, \u043D\u043E
      \u0434\u0435\u043D\u044C \u043F\u043E\u0442\u0435\u0440\u044F\u043D, \u043D\u0435\u0440\u0432\u044B
      \u0438\u0437\u043C\u043E\u0442\u0430\u043D\u044B, \u0438 \u0432 \u0433\u043E\u0440\u0430\u0445
      \u0442\u0435\u043C\u043D\u0435\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643655
    m_Localized: "\u0421\u0434\u0430\u0442\u044C \u043D\u0430\u0437\u0430\u0434 \u0434\u043E
      \u0443\u0441\u0442\u0443\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643656
    m_Localized: "\u0412\u0430\u0448\u0438 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E \u043E\u0442\u0432\u043E\u0434\u044F\u0442
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043D\u0430\u0437\u0430\u0434,
      \u043C\u0435\u0442\u0440 \u0437\u0430 \u043C\u0435\u0442\u0440\u043E\u043C,
      \u043A \u0441\u043A\u0430\u043B\u044C\u043D\u043E\u043C\u0443 \u0443\u0441\u0442\u0443\u043F\u0443.
      \u0422\u044E\u0440\u043E\u043A \u043A\u0438\u0432\u0430\u0435\u0442 \u0441
      \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C \u0438 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u043F\u0435\u0440\u0432\u044B\u043C; \u043D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0440\u0443\u043A\u043E\u0439
      \u0432\u043F\u0435\u0440\u0451\u0434: \xAB\u0427\u0435\u0440\u0435\u0437 \u0434\u0432\u0435
      \u0432\u0435\u0440\u0441\u0442\u044B - \u043E\u0431\u0432\u0430\u043B. \u0411\u0443\u0434\u044C\u0442\u0435
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B.\xBB \u0412\u044B \u0443\u0435\u0437\u0436\u0430\u0435\u0442\u0435
      \u0441 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435\u043C
      \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u043C, \u0447\u0442\u043E
      \u0433\u043E\u0440\u044B \u043F\u0440\u0438\u0437\u043D\u0430\u044E\u0442 \u0442\u0435\u0445,
      \u043A\u0442\u043E \u0443\u043C\u0435\u0435\u0442 \u0443\u0441\u0442\u0443\u043F\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643657
    m_Localized: "\u041C\u0430\u043D\u0451\u0432\u0440 \u0438\u0434\u0451\u0442 \u043A\u0440\u0438\u0432\u043E.
      \u0417\u0430\u0434\u043D\u0435\u0435 \u043A\u043E\u043B\u0435\u0441\u043E \u043E\u0434\u043D\u043E\u0439
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0441\u043E\u0441\u043A\u0430\u043B\u044C\u0437\u044B\u0432\u0430\u0435\u0442
      \u0441 \u043A\u0440\u0430\u044F, \u0442\u044E\u043A\u0438 \u043A\u0430\u0448\u0435\u043C\u0438\u0440\u0430
      \u0432\u0430\u043B\u044F\u0442\u0441\u044F \u0432\u043D\u0438\u0437, \u0432
      \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C. \u0415\u0434\u0432\u0430
      \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0442\u0435 \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435. \u0422\u044E\u0440\u043E\u043A
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442, \u0431\u0440\u043E\u0441\u0438\u0432
      \u0447\u0435\u0440\u0435\u0437 \u043F\u043B\u0435\u0447\u043E: \xAB\u0423\u0447\u0438\u0441\u044C
      \u0432\u043E\u0434\u0438\u0442\u044C \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043B\u0435\u0437\u0442\u044C
      \u0432 \u041F\u0430\u043C\u0438\u0440.\xBB \u041D\u0430 \u0438\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0443\u0449\u0435\u0440\u0431\u0430 \u0443\u0439\u0434\u0443\u0442 \u0434\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643658
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u043F\u043E\u043B\u044E\u0431\u043E\u0432\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643659
    m_Localized: "\u0412\u044B \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u0435 \u0432\u043F\u0435\u0440\u0451\u0434
      \u0441 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438
      \u0438 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442\u0435 \u043E\u0431\u043C\u0435\u043D:
      \u043C\u044B \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u0435\u043C \u0441\u0435\u0439\u0447\u0430\u0441,
      \u0442\u044B \u043F\u043E\u0434\u0441\u043A\u0430\u0436\u0435\u0448\u044C \u0434\u043E\u0440\u043E\u0433\u0443.
      \u0422\u044E\u0440\u043E\u043A \u0437\u0430\u0434\u0443\u043C\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
      \u043F\u043E\u0442\u043E\u043C \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u043C\u043E\u0437\u043E\u043B\u0438\u0441\u0442\u0443\u044E \u043B\u0430\u0434\u043E\u043D\u044C.
      \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u043E\u0431\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0443\u0436\u0435 \u0443\u0436\u0438\u043D\u0430\u044E\u0442 \u0432\u043C\u0435\u0441\u0442\u0435
      \u0443 \u043E\u0431\u0449\u0435\u0433\u043E \u043A\u043E\u0441\u0442\u0440\u0430,
      \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u044F\u0441\u044C \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430\u043C\u0438
      \u0438 \u0441\u043B\u0443\u0445\u0430\u043C\u0438. \u041D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435
      \u043E\u043D \u0434\u0430\u0440\u0438\u0442 \u0442\u044E\u043A \u043A\u0430\u0448\u0435\u043C\u0438\u0440\u0430
      - \xAB\u0437\u0430 \u0443\u043C\u043D\u0443\u044E \u0433\u043E\u043B\u043E\u0432\u0443\xBB.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u0441\u0442\u0430\u043B\u0430 \u044F\u0441\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643660
    m_Localized: "\u041A\u043E\u043B\u043E\u0434\u0435\u0446 \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643661
    m_Localized: "\u041F\u043E\u0441\u0440\u0435\u0434\u0438 \u043F\u0435\u0441\u043A\u043E\u0432
      \u0441\u0442\u043E\u0438\u0442 \u043F\u043E\u043B\u0443\u0437\u0430\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0439
      \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439 \u043A\u043E\u043B\u043E\u0434\u0435\u0446.
      \u0420\u044F\u0434\u043E\u043C \u043B\u0435\u0436\u0438\u0442 \u043C\u0451\u0440\u0442\u0432\u044B\u0439
      \u0432\u043E\u0440\u043E\u043D \u0441 \u0440\u0430\u0441\u043A\u0438\u043D\u0443\u0442\u044B\u043C\u0438
      \u043A\u0440\u044B\u043B\u044C\u044F\u043C\u0438. \u0412\u044B\u0441\u043E\u0445\u0448\u0438\u0435
      \u0442\u043E\u043F\u043E\u043B\u044F \u0442\u043E\u0440\u0447\u0430\u0442 \u0438\u0437
      \u0434\u044E\u043D, \u043A\u0430\u043A \u0441\u0435\u0440\u044B\u0435 \u043A\u043E\u0441\u0442\u043B\u044F\u0432\u044B\u0435
      \u0440\u0443\u043A\u0438. \u041E\u0434\u0438\u043D \u0438\u0437 \u0432\u0430\u0448\u0438\u0445
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u043E\u043F\u0443\u0441\u0442\u0438\u043B
      \u043C\u0435\u0434\u043D\u0443\u044E \u0447\u0430\u0448\u0443 \u0432 \u0448\u0430\u0445\u0442\u0443:
      \u0432\u043E\u0434\u0430 \u0435\u0441\u0442\u044C, \u043D\u043E \u043C\u0443\u0442\u043D\u0430\u044F
      \u0438 \u043F\u0430\u0445\u043D\u0435\u0442 \u0436\u0435\u043B\u0435\u0437\u043E\u043C.
      \u0417\u0430\u043F\u0430\u0441\u044B \u0432\u043E\u0434\u044B \u043D\u0430
      \u0438\u0441\u0445\u043E\u0434\u0435, \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430 \u0434\u0432\u0430 \u0434\u043D\u044F
      \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643662
    m_Localized: "\u041F\u0438\u0442\u044C, \u043A\u0430\u043A \u0435\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643663
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0436\u0430\u0434\u043D\u043E
      \u043D\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u0432\u043E\u0434\u0443.
      \u0416\u0430\u0436\u0434\u0430 \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0435\u0442,
      \u043D\u043E \u043A \u0432\u0435\u0447\u0435\u0440\u0443 \u0443 \u0442\u0440\u043E\u0438\u0445
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442\u0441\u044F
      \u0441\u043F\u0430\u0437\u043C\u044B \u0432 \u0436\u0438\u0432\u043E\u0442\u0435.
      \u041A \u0443\u0442\u0440\u0443 \u0443 \u0434\u0432\u043E\u0438\u0445 \u043A\u0440\u043E\u0432\u0430\u0432\u0430\u044F
      \u0434\u0438\u0437\u0435\u043D\u0442\u0435\u0440\u0438\u044F. \u0412\u043E\u0434\u0443
      \u043F\u0438\u0442\u044C \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C,
      \u043D\u043E \u043C\u0451\u0440\u0442\u0432\u044B\u0439 \u0432\u043E\u0440\u043E\u043D
      \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u043B
      \u043D\u0435 \u0437\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643664
    m_Localized: "\u041F\u0440\u043E\u043A\u0438\u043F\u044F\u0442\u0438\u0442\u044C
      \u0438 \u043F\u0440\u043E\u0446\u0435\u0434\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643665
    m_Localized: "\u0412\u044B \u043F\u043E\u043C\u043D\u0438\u0442\u0435 \u0443\u0440\u043E\u043A\u0438
      \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0430:
      \u043A\u0438\u043F\u044F\u0442\u0438\u0442\u044C, \u043F\u043E\u0442\u043E\u043C
      \u0446\u0435\u0434\u0438\u0442\u044C \u0447\u0435\u0440\u0435\u0437 \u0442\u043A\u0430\u043D\u044C
      \u0441 \u0443\u0433\u043B\u0451\u043C. \u041E\u0433\u043E\u043D\u044C \u0440\u0430\u0437\u0432\u0435\u0441\u0442\u0438
      \u0442\u0440\u0443\u0434\u043D\u043E, \u0432\u0435\u0442\u0435\u0440 \u043C\u0435\u0448\u0430\u0435\u0442,
      \u043D\u043E \u0432\u044B \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0435\u0441\u044C.
      \u0412\u043E\u0434\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u043E\u0439 \u0438 \u043F\u0440\u0438\u0433\u043E\u0434\u043D\u043E\u0439.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u044C\u0451\u0442 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E,
      \u0438 \u043F\u0443\u0441\u0442\u044B\u043D\u044F \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0451\u0442
      \u043F\u0443\u0433\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643666
    m_Localized: "\u0412\u0430\u0448\u0430 \u043F\u043E\u043F\u044B\u0442\u043A\u0430
      \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0432\u043E\u0434\u0443 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043F\u043B\u043E\u0445\u043E: \u043A\u043E\u0441\u0442\u0451\u0440 \u0433\u0430\u0441\u043D\u0435\u0442,
      \u0444\u0438\u043B\u044C\u0442\u0440 \u0437\u0430\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0431\u0443\u0440\u0434\u044E\u043A\u0438 \u043E\u043F\u0440\u043E\u043A\u0438\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F.
      \u0411\u043E\u043B\u044C\u0448\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u0437\u0430\u043F\u0430\u0441\u0430
      \u0443\u0442\u0435\u043A\u0430\u0435\u0442 \u0432 \u043F\u0435\u0441\u043E\u043A.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u044B\u043D\u0443\u0436\u0434\u0435\u043D
      \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C \u043A\u0430\u0436\u0434\u0443\u044E
      \u043A\u0430\u043F\u043B\u044E \u0438 \u0438\u0434\u0442\u0438 \u0431\u044B\u0441\u0442\u0440\u0435\u0435,
      \u0447\u0435\u043C \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0431\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643667
    m_Localized: "\u041F\u043E\u0441\u043B\u0430\u0442\u044C \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0443
      \u0438\u0441\u043A\u0430\u0442\u044C \u0434\u0440\u0443\u0433\u043E\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643668
    m_Localized: "\u0414\u0432\u043E\u0435 \u043B\u0443\u0447\u0448\u0438\u0445 \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u043E\u0432
      \u0443\u0445\u043E\u0434\u044F\u0442 \u043D\u0430 \u0437\u0430\u043A\u0430\u0442
      \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F
      \u0441 \u0432\u043E\u0441\u0445\u043E\u0434\u043E\u043C: \u043D\u0430\u0448\u043B\u0438
      \u0441\u043F\u0440\u044F\u0442\u0430\u043D\u043D\u044B\u0439 \u0441\u0440\u0435\u0434\u0438
      \u0441\u043A\u0430\u043B \u0440\u043E\u0434\u043D\u0438\u043A, \u0447\u0438\u0441\u0442\u044B\u0439
      \u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0440\u0430\u0434\u043E\u0441\u0442\u043D\u043E \u043C\u0435\u043D\u044F\u0435\u0442
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0438 \u043F\u043E\u043F\u043E\u043B\u043D\u044F\u0435\u0442
      \u0437\u0430\u043F\u0430\u0441\u044B \u0432\u0434\u043E\u0432\u043E\u043B\u044C.
      \u041C\u0451\u0440\u0442\u0432\u044B\u0439 \u0432\u043E\u0440\u043E\u043D \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C \u043E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
      \u043A\u043E\u043B\u043E\u0434\u0435\u0446 - \u043F\u0443\u0441\u0442\u044C
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u0442 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643669
    m_Localized: "\u0422\u0430\u043D\u0441\u043A\u0438\u0439 \u043F\u0430\u0442\u0440\u0443\u043B\u044C
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643670
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u0447\u0435\u0440\u0435\u0437
      \u0413\u0430\u043D\u044C\u0441\u0443\u0439\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u0438\u0434\u043E\u0440
      - \u0442\u0430\u043D\u0441\u043A\u0438\u0439 \u043F\u043E\u0441\u0442: \u0434\u0432\u0435
      \u0433\u043B\u0438\u043D\u043E\u0431\u0438\u0442\u043D\u044B\u0435 \u0431\u0430\u0448\u043D\u0438,
      \u0431\u0430\u043C\u0431\u0443\u043A\u043E\u0432\u0430\u044F \u0436\u0435\u0440\u0434\u044C
      \u043F\u043E\u043F\u0435\u0440\u0451\u043A \u0434\u043E\u0440\u043E\u0433\u0438,
      \u0448\u0451\u043B\u043A\u043E\u0432\u044B\u0439 \u0448\u0442\u0430\u043D\u0434\u0430\u0440\u0442
      \u0441 \u0437\u043E\u043B\u043E\u0442\u044B\u043C \u0434\u0440\u0430\u043A\u043E\u043D\u043E\u043C.
      \u041E\u0444\u0438\u0446\u0435\u0440 \u0432 \u043A\u0440\u0430\u0441\u043D\u044B\u0445
      \u043B\u0430\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445 \u0434\u043E\u0441\u043F\u0435\u0445\u0430\u0445
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0433\u0440\u0430\u043C\u043E\u0442\u044B.
      \u041D\u0430 \u0441\u0442\u043E\u043B\u0431\u0435 \u0443 \u0432\u0445\u043E\u0434\u0430
      \u0438\u0435\u0440\u043E\u0433\u043B\u0438\u0444\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0432\u0430\u0448 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043D\u0435
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u0442. \u0414\u0432\u043E\u0435
      \u0441\u043E\u043B\u0434\u0430\u0442 \u0441 \u0430\u043B\u0435\u0431\u0430\u0440\u0434\u0430\u043C\u0438
      \u0441\u0442\u043E\u044F\u0442 \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439
      \u043E\u0444\u0438\u0446\u0435\u0440\u0430. \u0411\u0435\u0437 \u0431\u0443\u043C\u0430\u0433
      - \u043D\u0435 \u043F\u0440\u043E\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643671
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043F\u043E\u0448\u043B\u0438\u043D\u0443
      \u0441\u0440\u0430\u0437\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643672
    m_Localized: "\u0412\u044B \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E \u043D\u0430 \u043B\u0430\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043F\u043E\u0434\u043D\u043E\u0441, \u043D\u0435 \u0442\u043E\u0440\u0433\u0443\u044F\u0441\u044C.
      \u041E\u0444\u0438\u0446\u0435\u0440 \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442,
      \u0441\u0442\u0430\u0432\u0438\u0442 \u043F\u0435\u0447\u0430\u0442\u044C \u043D\u0430
      \u0431\u0443\u043C\u0430\u0433\u0443 \u0438 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0448\u043B\u0430\u0433\u0431\u0430\u0443\u043C. \u041D\u0438 \u043B\u0438\u0448\u043D\u0435\u0433\u043E
      \u0441\u043B\u043E\u0432\u0430, \u043D\u0438 \u0432\u0437\u0433\u043B\u044F\u0434\u0430.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0430,
      \u043A\u043E\u0448\u0435\u043B\u044C \u043B\u0435\u0433\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643673
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0436\u0435\u0441\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643674
    m_Localized: "\u0412\u044B \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0435\u0441\u044C,
      \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435 \u0440\u0443\u043A\u0438
      \u0432 \u0437\u043D\u0430\u043A \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F,
      \u043D\u0430 \u043F\u0430\u043B\u044C\u0446\u0430\u0445 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435
      \u0446\u0438\u0444\u0440\u0443 \u043C\u0435\u043D\u044C\u0448\u0443\u044E \u0438
      \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0435\u0441\u044C \u0442\u0430\u043A,
      \u043A\u0430\u043A \u0443\u043B\u044B\u0431\u0430\u044E\u0442\u0441\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B
      \u043F\u043E \u0432\u0441\u0435\u0439 \u0410\u0437\u0438\u0438. \u041E\u0444\u0438\u0446\u0435\u0440
      \u0445\u043C\u044B\u043A\u0430\u0435\u0442, \u0441\u043A\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u0433\u043B\u0430\u0437\u0430 \u043D\u0430 \u0442\u043E\u0432\u0430\u0440\u044B,
      \u0438 \u0447\u0435\u0440\u0435\u0437 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C
      \u0447\u0430\u0441\u0430 \u0432\u044B \u0440\u0430\u0441\u0445\u043E\u0434\u0438\u0442\u0435\u0441\u044C
      \u043A \u043E\u0431\u043E\u044E\u0434\u043D\u043E\u043C\u0443 \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u044E.
      \u041D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435 \u043E\u043D
      \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u043B\u0438\u0441\u0442 \u0440\u0438\u0441\u043E\u0432\u043E\u0439
      \u0431\u0443\u043C\u0430\u0433\u0438 \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E
      - \u043F\u0440\u043E\u043F\u0443\u0441\u043A \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
      \u043F\u043E\u0441\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643675
    m_Localized: "\u0412\u0430\u0448\u0438 \u0436\u0435\u0441\u0442\u044B \u043E\u0444\u0438\u0446\u0435\u0440
      \u0438\u0441\u0442\u043E\u043B\u043A\u043E\u0432\u044B\u0432\u0430\u0435\u0442
      \u043A\u0430\u043A \u043F\u043E\u043F\u044B\u0442\u043A\u0443 \u0443\u0432\u0438\u043B\u044C\u043D\u0443\u0442\u044C.
      \u041B\u0438\u0446\u043E \u0435\u0433\u043E \u0442\u0435\u043C\u043D\u0435\u0435\u0442,
      \u0441\u043E\u043B\u0434\u0430\u0442\u044B \u0434\u0435\u043B\u0430\u044E\u0442
      \u0448\u0430\u0433 \u0432\u043F\u0435\u0440\u0451\u0434. \u0412 \u0438\u0442\u043E\u0433\u0435
      \u0432\u044B \u043F\u043B\u0430\u0442\u0438\u0442\u0435 \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0441\u0442\u043E\u0438\u043B\u043E \u0431\u044B, \u0435\u0449\u0451
      \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435 \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0435
      \u0432 \u043D\u0435\u0447\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438.
      \u041E\u0444\u0438\u0446\u0435\u0440 \u0434\u0435\u043B\u0430\u0435\u0442 \u043F\u043E\u043C\u0435\u0442\u043A\u0443
      \u0432 \u0441\u043F\u0438\u0441\u043A\u0435 - \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u043F\u043E\u0441\u0442\u0443 \u0432\u0430\u0441 \u0432\u0441\u0442\u0440\u0435\u0442\u044F\u0442
      \u0441\u0442\u0440\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643676
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643677
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0432\u043F\u0435\u0440\u0451\u0434
      \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043A
      \u043E\u0444\u0438\u0446\u0435\u0440\u0443 \u043D\u0430 \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u043E\u043C
      \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C, \u0446\u0438\u0442\u0438\u0440\u0443\u044F
      \u0441\u0442\u0440\u043E\u043A\u0443 \u0438\u0437 \xAB\u041B\u0443\u043D\u044C
      \u042E\u0439\xBB. \u041E\u0444\u0438\u0446\u0435\u0440 \u0443\u0434\u0438\u0432\u043B\u0451\u043D\u043D\u043E
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0431\u0440\u043E\u0432\u0438,
      \u043F\u043E\u0442\u043E\u043C \u0441\u043C\u0435\u0451\u0442\u0441\u044F \u0438
      \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u0435\u0442 \u0432\u0430\u0441
      \u043A \u0447\u0430\u044E \u0432 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0441\u043A\u043E\u0439
      \u043F\u0430\u043B\u0430\u0442\u043A\u0435. \u0417\u0430 \u0447\u0430\u0448\u043A\u043E\u0439
      \u0441\u0432\u0435\u0442\u043B\u043E\u0433\u043E \u0437\u0435\u043B\u0451\u043D\u043E\u0433\u043E
      \u0447\u0430\u044F \u043E\u043D \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442,
      \u043A\u0430\u043A \u043B\u0443\u0447\u0448\u0435 \u043F\u0440\u043E\u0439\u0442\u0438
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u043F\u043E\u0441\u0442\u044B,
      \u0441\u0442\u0430\u0432\u0438\u0442 \u043D\u0430 \u0431\u0443\u043C\u0430\u0433\u0435
      \u0434\u0432\u043E\u0439\u043D\u0443\u044E \u043F\u0435\u0447\u0430\u0442\u044C
      \u0438 \u0436\u0435\u043B\u0430\u0435\u0442 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0438. \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435
      \u0441 \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u043E\u043C, \u0441\u043E\u0432\u0435\u0442\u0430\u043C\u0438
      \u0438 \u043F\u0430\u0440\u043E\u0439 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u0445
      \u0444\u0440\u0430\u0437, \u043E\u0441\u0435\u0432\u0448\u0438\u0445 \u0432
      \u043F\u0430\u043C\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643678
    m_Localized: "\u041B\u0435\u0432\u0430\u043D\u0442\u0438\u0439\u0441\u043A\u0438\u0435
      \u043F\u0438\u0440\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643679
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u0438\u0434\u0451\u0442 \u043D\u0430\u0434
      \u043C\u043E\u0440\u0435\u043C: \u0441\u043F\u0440\u0430\u0432\u0430 \u043E\u0431\u0440\u044B\u0432,
      \u0432\u043D\u0438\u0437\u0443 \u043F\u043B\u0435\u0449\u0435\u0442\u0441\u044F
      \u0441\u0435\u0440\u0430\u044F \u0432\u043E\u0434\u0430. \u0418\u0437-\u0437\u0430
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430 \u0432\u044B\u0445\u043E\u0434\u044F\u0442
      \u0448\u0435\u0441\u0442\u0435\u0440\u043E \u0432 \u0442\u0451\u043C\u043D\u044B\u0445
      \u0442\u0440\u044F\u043F\u043A\u0430\u0445. \u0413\u043B\u0430\u0432\u0430\u0440\u044C
      (\u0445\u0443\u0434\u043E\u0439, \u0441\u043E \u0448\u0440\u0430\u043C\u043E\u043C
      \u0447\u0435\u0440\u0435\u0437 \u0449\u0451\u043A\u0443) \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u043A\u0440\u0438\u0432\u0443\u044E \u0441\u0430\u0431\u043B\u044E. \u041D\u0430
      \u043F\u043B\u044F\u0436\u0435 \u043D\u0438\u0436\u0435 \u0441\u0442\u043E\u044F\u0442
      \u0434\u0432\u0435 \u043B\u043E\u0434\u043A\u0438 \u0441 \u0437\u0430\u043B\u0430\u0442\u0430\u043D\u043D\u044B\u043C\u0438
      \u043F\u0430\u0440\u0443\u0441\u0430\u043C\u0438. \u041F\u0438\u0440\u0430\u0442\u044B
      \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u044F\u0442\u0441\u044F: \u043E\u043D\u0438
      \u0434\u043E\u043C\u0430 \u043D\u0430 \u044D\u0442\u043E\u0439 \u0437\u0435\u043C\u043B\u0435,
      \u0430 \u0432\u0430\u0448 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0437\u0430\u0436\u0430\u0442
      \u043C\u0435\u0436\u0434\u0443 \u0441\u043A\u0430\u043B\u043E\u0439 \u0438
      \u043E\u0431\u0440\u044B\u0432\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643680
    m_Localized: "\u041E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F \u0431\u0435\u0437
      \u0431\u043E\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643681
    m_Localized: "\u0412\u044B \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u043A\u043E\u0448\u0435\u043B\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u0430.
      \u0413\u043B\u0430\u0432\u0430\u0440\u044C \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442
      \u043D\u0435 \u0441\u043F\u0435\u0448\u0430, \u043F\u043E\u0442\u043E\u043C
      \u043A\u0438\u0432\u0430\u0435\u0442 - \u0441\u043B\u043E\u0432\u043E \u0434\u0435\u0440\u0436\u0438\u0442.
      \u041F\u0438\u0440\u0430\u0442\u044B \u0440\u0430\u0441\u0441\u0442\u0443\u043F\u0430\u044E\u0442\u0441\u044F,
      \u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0438\u0434\u0451\u0442
      \u043C\u0438\u043C\u043E. \u041F\u043E\u0442 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439,
      \u043D\u043E \u043B\u044E\u0434\u0438 \u0436\u0438\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643682
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u043E \u0432\u044B\u043A\u0443\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643683
    m_Localized: "\u0412\u044B \u0437\u0430\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442\u0435
      \u0441 \u0433\u043B\u0430\u0432\u0430\u0440\u0451\u043C \u043A\u0430\u043A
      \u043A\u0443\u043F\u0435\u0446 \u0441 \u043A\u0443\u043F\u0446\u043E\u043C:
      \u0440\u0430\u0441\u0445\u0432\u0430\u043B\u0438\u0432\u0430\u0435\u0442\u0435
      \u0442\u043E\u0432\u0430\u0440\u044B, \u0436\u0430\u043B\u0443\u0435\u0442\u0435\u0441\u044C
      \u043D\u0430 \u0442\u044F\u0433\u043E\u0442\u044B \u0434\u043E\u0440\u043E\u0433\u0438,
      \u0442\u043E\u0440\u0433\u0443\u0435\u0442\u0435\u0441\u044C \u0437\u0430 \u043A\u0430\u0436\u0434\u0443\u044E
      \u043C\u043E\u043D\u0435\u0442\u0443. \u0428\u0440\u0430\u043C \u043D\u0430
      \u0435\u0433\u043E \u0449\u0435\u043A\u0435 \u043A\u0440\u0438\u0432\u0438\u0442\u0441\u044F
      \u0432 \u043D\u0435\u043E\u0445\u043E\u0442\u043D\u043E\u0439 \u0443\u043B\u044B\u0431\u043A\u0435.
      \u0421\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C \u043D\u0430
      \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u0438 \u0437\u0430\u043F\u0440\u043E\u0448\u0435\u043D\u043D\u043E\u0433\u043E.
      \u041D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435 \u043E\u043D
      \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u0432\u0430\u043C \u043A\u0443\u0441\u043E\u043A
      \u043A\u043E\u0440\u0430\u043B\u043B\u0430 - \xAB\u0437\u0430 \u0441\u043C\u0435\u043B\u044B\u0439
      \u044F\u0437\u044B\u043A\xBB. \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643684
    m_Localized: "\u0413\u043B\u0430\u0432\u0430\u0440\u044C \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0451\u043D\u043D\u043E
      \u043E\u0431\u0440\u044B\u0432\u0430\u0435\u0442 \u0442\u043E\u0440\u0433 \u0438
      \u043F\u0440\u0438\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043E\u0431\u044B\u0441\u043A\u0430\u0442\u044C
      \u043E\u0431\u043E\u0437. \u041F\u0438\u0440\u0430\u0442\u044B \u0440\u043E\u044E\u0442\u0441\u044F
      \u0432 \u0442\u044E\u043A\u0430\u0445, \u0432\u044B\u0433\u0440\u0435\u0431\u0430\u044E\u0442
      \u0432\u0441\u0451 \u0446\u0435\u043D\u043D\u043E\u0435, \u0431\u044C\u044E\u0442
      \u0434\u0432\u0443\u0445 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432.
      \u041B\u043E\u0434\u043A\u0438 \u0443\u0445\u043E\u0434\u044F\u0442 \u0432
      \u043C\u043E\u0440\u0435, \u0442\u044F\u0436\u0435\u043B\u043E \u0433\u0440\u0443\u0436\u0451\u043D\u044B\u0435,
      \u0430 \u0432\u044B \u043E\u0441\u0442\u0430\u0451\u0442\u0435\u0441\u044C
      \u0441\u043E \u0441\u0441\u0430\u0434\u0438\u043D\u0430\u043C\u0438, \u0434\u0443\u0440\u043D\u044B\u043C
      \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435\u043C \u0438 \u043F\u043E\u043A\u043B\u0430\u0436\u0435\u0439
      \u043B\u0435\u0433\u0447\u0435, \u0447\u0435\u043C \u0431\u044B\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643685
    m_Localized: "\u0414\u0430\u0442\u044C \u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643686
    m_Localized: "\u0412\u0430\u0448\u0438 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438
      \u0431\u0440\u043E\u0441\u0430\u044E\u0442\u0441\u044F \u0432 \u0430\u0442\u0430\u043A\u0443,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043B\u043E\u0442\u043D\u043E
      \u0441\u0431\u0438\u0442 \u0438 \u043D\u0435 \u043F\u0430\u043D\u0438\u043A\u0443\u0435\u0442.
      \u041F\u0438\u0440\u0430\u0442\u044B \u043D\u0435 \u043E\u0436\u0438\u0434\u0430\u043B\u0438
      \u043E\u0442\u043F\u043E\u0440\u0430 - \u0434\u0432\u043E\u0435 \u043F\u0430\u0434\u0430\u044E\u0442
      \u0441\u0440\u0430\u0437\u0443, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u044E\u0442 \u043A \u043B\u043E\u0434\u043A\u0430\u043C,
      \u0431\u0440\u043E\u0441\u0430\u044F \u0434\u043E\u0431\u044B\u0447\u0443.
      \u0421\u0440\u0435\u0434\u0438 \u0442\u0440\u043E\u0444\u0435\u0435\u0432:
      \u043A\u0443\u0441\u043E\u043A \u043A\u043E\u0440\u0430\u043B\u043B\u0430,
      \u043A\u043E\u0448\u0435\u043B\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u0430,
      \u043A\u0440\u0438\u0432\u0430\u044F \u0441\u0430\u0431\u043B\u044F. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0438\u0437 \u0431\u043E\u044F
      \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C, \u0438 \u0432\u0435\u0441\u0442\u044C
      \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u044D\u0442\u0443 \u0442\u0440\u043E\u043F\u0443
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0432\u043E\u0437\u044C\u043C\u0443\u0442
      \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A, \u0440\u0430\u0437\u043B\u0435\u0442\u0438\u0442\u0441\u044F
      \u043F\u043E \u043F\u043E\u0431\u0435\u0440\u0435\u0436\u044C\u044E. \u0421\u043B\u0430\u0432\u0430
      \u0432\u0430\u0448\u0430 \u0440\u0430\u0441\u0442\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643687
    m_Localized: "\u0417\u0432\u043E\u043D \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u0447\u0438\u043A\u043E\u0432
      \u0434\u0430\u043B\u0451\u043A\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643688
    m_Localized: "\u0418\u0437-\u0437\u0430 \u0431\u0430\u0440\u0445\u0430\u043D\u043E\u0432
      \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u0441\u0435\u0440\u0435\u0431\u0440\u0438\u0441\u0442\u044B\u0439
      \u043F\u0435\u0440\u0435\u0437\u0432\u043E\u043D \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u0447\u0438\u043A\u043E\u0432
      - \u0442\u0430\u043C, \u0437\u0430 \u043F\u0435\u0441\u043A\u043E\u043C, \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F
      \u0434\u0440\u0443\u0433\u043E\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0438 \u0443\u043B\u044B\u0431\u0430\u044E\u0442\u0441\u044F: \u043C\u044B
      \u043D\u0435 \u043E\u0434\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643689
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u0432\u043E\u0434\u043E\u043F\u0430\u0434
      \u0443 \u0442\u0440\u043E\u043F\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643690
    m_Localized: "\u0421 \u0447\u0451\u0440\u043D\u043E\u0433\u043E \u0443\u0441\u0442\u0443\u043F\u0430
      \u0441\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0432\u043E\u0434\u043E\u043F\u0430\u0434
      - \u0432\u0437\u0432\u0435\u0441\u044C \u043E\u0441\u0435\u0434\u0430\u0435\u0442
      \u043D\u0430 \u043B\u0438\u0446\u0430\u0445 \u0438 \u0448\u0435\u0440\u0441\u0442\u0438
      \u044F\u043A\u043E\u0432. \u0413\u043E\u0440\u044B \u0441\u0443\u0440\u043E\u0432\u044B,
      \u043D\u043E \u0438\u043D\u043E\u0433\u0434\u0430 \u0434\u0430\u0440\u044F\u0442
      \u0431\u0435\u0437 \u043F\u0440\u043E\u0441\u044C\u0431\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643691
    m_Localized: "\u041F\u043E\u043B\u0435 \u0434\u0438\u043A\u0438\u0445 \u0446\u0432\u0435\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643692
    m_Localized: "\u0421\u0442\u0435\u043F\u044C \u0440\u0430\u0441\u0441\u0442\u0443\u043F\u0430\u0435\u0442\u0441\u044F
      - \u043A\u043E\u043B\u0435\u044F \u043D\u044B\u0440\u044F\u0435\u0442 \u0432
      \u043C\u043E\u0440\u0435 \u0430\u043B\u044B\u0445 \u043C\u0430\u043A\u043E\u0432
      \u0438 \u043B\u0438\u043B\u043E\u0432\u044B\u0445 \u0438\u0440\u0438\u0441\u043E\u0432.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0437\u0430\u0442\u044B\u043A\u0430\u044E\u0442
      \u0446\u0432\u0435\u0442\u044B \u0437\u0430 \u0443\u0445\u043E, \u0438 \u043D\u0430
      \u0447\u0430\u0441 \u043F\u0443\u0442\u044C \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643693
    m_Localized: "\u041F\u0430\u0434\u0430\u044E\u0449\u0430\u044F \u0437\u0432\u0435\u0437\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643694
    m_Localized: "\u0417\u0435\u043B\u0451\u043D\u043E-\u0431\u0435\u043B\u0430\u044F
      \u043F\u043E\u043B\u043E\u0441\u0430 \u043F\u0440\u043E\u0447\u0435\u0440\u0447\u0438\u0432\u0430\u0435\u0442
      \u043D\u0435\u0431\u043E \u043E\u0442 \u0437\u0435\u043D\u0438\u0442\u0430
      \u043A \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0443. \u041A\u0430\u0436\u0434\u044B\u0439
      \u0448\u0435\u043F\u0447\u0435\u0442 \u0441\u0432\u043E\u0451 - \u043F\u0435\u0440\u0441\u0438\u044F\u043D\u0438\u043D
      \u0436\u0435\u043B\u0430\u0435\u0442 \u0431\u043E\u0433\u0430\u0442\u0441\u0442\u0432\u0430,
      \u043C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u0430-\u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u043E\u043C\u043E\u0439. \u041D\u0435\u0431\u043E
      \u0441\u043B\u0443\u0448\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643695
    m_Localized: "\u041A\u043E\u0441\u0442\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0432 \u043F\u0435\u0441\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643696
    m_Localized: "\u0418\u0437 \u043F\u0435\u0441\u043A\u0430 \u0442\u043E\u0440\u0447\u0430\u0442
      \u043A\u043E\u0441\u0442\u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432,
      \u0440\u0430\u0437\u0431\u0438\u0442\u044B\u0435 \u0434\u043E\u0441\u043A\u0438,
      \u043E\u0431\u043E\u0440\u0432\u0430\u043D\u043D\u0430\u044F \u043A\u043E\u0436\u0430\u043D\u0430\u044F
      \u0441\u0443\u043C\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0442 \u043C\u043E\u043B\u0447\u0430
      - \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0445\u043E\u0447\u0435\u0442
      \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C, \u0447\u0442\u043E
      \u0437\u0434\u0435\u0441\u044C \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643697
    m_Localized: "\u041F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643698
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643699
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643700
    m_Localized: "\u0417\u043D\u0430\u043C\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 12957013737725952
    m_Localized: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643201191936
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u043D\u0438\u043A \u0441 \u043A\u0430\u0440\u0442\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643234746368
    m_Localized: "\u041D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435, \u043C\u0435\u0436
      \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u043E\u0432 \u0441 \u043F\u0440\u044F\u043D\u043E\u0441\u0442\u044F\u043C\u0438
      \u0438 \u043C\u0435\u0434\u043D\u043E\u0439 \u043F\u043E\u0441\u0443\u0434\u043E\u0439,
      \u0432\u044B \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0438 \u043F\u0440\u043E\u0434\u0430\u0451\u0442,
      \u043D\u0438 \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0442: \u0441\u0442\u043E\u0438\u0442
      \u0443 \u0441\u0442\u0435\u043D\u044B, \u0438\u0437\u0443\u0447\u0430\u0435\u0442
      \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u0439 \u0441\u0432\u0438\u0442\u043E\u043A.
      \u0415\u0433\u043E \u043E\u0434\u0435\u0436\u0434\u0430 \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u0430,
      \u043D\u043E \u0442\u043A\u0430\u043D\u044C \u043A\u043E\u0433\u0434\u0430-\u0442\u043E
      \u0431\u044B\u043B\u0430 \u0434\u043E\u0440\u043E\u0433\u043E\u0439. \u0412\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0432\u0430\u0448 \u0432\u0437\u0433\u043B\u044F\u0434 \u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442,
      \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0441\u0432\u0438\u0442\u043E\u043A: \u0434\u0440\u0435\u0432\u043D\u044F\u044F
      \u043A\u0430\u0440\u0442\u0430 \u043D\u0430 \u043F\u043E\u0436\u0435\u043B\u0442\u0435\u0432\u0448\u0435\u043C
      \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0435, \u043F\u043E\u043A\u0440\u044B\u0442\u0430\u044F
      \u0437\u043D\u0430\u043A\u0430\u043C\u0438 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0433\u043E
      \u044F\u0437\u044B\u043A\u0430.\r\n\r\n<npc_speech lang=\"Persian\">\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E,
      \u043A\u0443\u043F\u0435\u0446! \u042F \u0424\u0430\u0440\u0443\u0445 - \u0440\u043E\u044E\u0441\u044C
      \u0432 \u0441\u0442\u0430\u0440\u044B\u0445 \u0440\u0443\u0438\u043D\u0430\u0445
      \u0438 \u0438\u0449\u0443 \u0437\u0430\u0431\u044B\u0442\u043E\u0435. \u042D\u0442\u0430
      \u043A\u0430\u0440\u0442\u0430 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F,
      \u043A\u043B\u044F\u043D\u0443\u0441\u044C \u043F\u0440\u0430\u0445\u043E\u043C
      \u043E\u0442\u0446\u0430. \u041D\u043E \u043C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D
      \u043E\u0431\u043E\u0437. \u0422\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u044B
      \u0434\u0435\u043D\u044C\u0433\u0438. \u041C\u043E\u0436\u0435\u0442, \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C\u0441\u044F?</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940672
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940673
    m_Localized: "\u0412\u044B \u043A\u0430\u0447\u0430\u0435\u0442\u0435 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
      \u0438 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u0435 \u0424\u0430\u0440\u0443\u0445\u0430
      \u0437\u0430 \u0438\u0441\u0442\u043E\u0440\u0438\u044E. \u041E\u043D \u043D\u0435
      \u043E\u0431\u0438\u0436\u0430\u0435\u0442\u0441\u044F, \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u043A\u0430\u0440\u0442\u0443 \u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u0443
      \u0438 \u043A\u0438\u0432\u0430\u0435\u0442. \xAB\u0414\u043E\u0440\u043E\u0433\u0430
      \u0434\u043B\u0438\u043D\u043D\u0430\u044F, \u043C\u043E\u0436\u0435\u0442,
      \u0435\u0449\u0451 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F\xBB.
      \u0412\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0435
      \u043F\u0443\u0442\u044C \u0441 \u043B\u0451\u0433\u043A\u0438\u043C \u0441\u0435\u0440\u0434\u0446\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940674
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043A\u0430\u0440\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940675
    m_Localized: "\u0412\u044B \u0432\u043C\u0435\u0441\u0442\u0435 \u0438\u0437\u0443\u0447\u0430\u0435\u0442\u0435
      \u043A\u0430\u0440\u0442\u0443: \u0437\u043D\u0430\u043A\u0438 \u0441\u0442\u0430\u0440\u044B\u0435,
      \u043D\u043E \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      - \u0447\u0435\u0440\u0435\u0437 \u043F\u0443\u0441\u0442\u044B\u043D\u0438
      \u0438 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u044B \u043A \u043C\u0435\u0441\u0442\u0430\u043C,
      \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u043C \u0442\u043E\u0447\u043A\u0430\u043C\u0438
      \u0438 \u043F\u043E\u043B\u0443\u043C\u0435\u0441\u044F\u0446\u0430\u043C\u0438.
      \u0424\u0430\u0440\u0443\u0445 \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0441\u0432\u0438\u0442\u043E\u043A \u0432 \u0440\u0443\u043A\u0443. \xAB\u0411\u0435\u0440\u0435\u0433\u0438.
      \u041F\u0435\u0440\u0432\u0430\u044F \u043C\u0435\u0442\u043A\u0430 - \u0433\u0434\u0435-\u0442\u043E
      \u043C\u0435\u0436\u0434\u0443 \u041A\u0430\u0448\u0433\u0430\u0440\u043E\u043C
      \u0438 \u0410\u043D\u044C\u0441\u0438. \u0420\u0430\u0437\u0433\u0430\u0434\u0430\u0439
      \u0437\u043D\u0430\u043A\u0438 \u0438 \u0443\u0437\u043D\u0430\u0435\u0448\u044C,
      \u0447\u0442\u043E \u0438\u0441\u043A\u0430\u0442\u044C\xBB. \u041E\u043D \u0445\u043B\u043E\u043F\u0430\u0435\u0442
      \u0432\u0430\u0441 \u043F\u043E \u043F\u043B\u0435\u0447\u0443 \u0438 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044F\u0435\u0442\u0441\u044F
      \u0432 \u0442\u043E\u043B\u043F\u0435 \u0431\u0430\u0437\u0430\u0440\u0430,
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F \u0432\u0430\u0441 \u0441
      \u043A\u0430\u0440\u0442\u043E\u0439 \u0438 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435\u043C
      \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940676
    m_Localized: "\u0412\u044B \u0431\u0435\u0440\u0451\u0442\u0435 \u043A\u0430\u0440\u0442\u0443,
      \u043D\u043E \u0424\u0430\u0440\u0443\u0445 \u0432\u0438\u0434\u0438\u0442:
      \u0432\u044B \u043D\u0435 \u043F\u0440\u043E\u0447\u0442\u0451\u0442\u0435
      \u043D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0437\u043D\u0430\u043A\u0430.
      \u041E\u043D \u0432\u0437\u0434\u044B\u0445\u0430\u0435\u0442, \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442
      \u0441\u0432\u0438\u0442\u043E\u043A \u043E\u0431\u0440\u0430\u0442\u043D\u043E,
      \u043F\u043E\u0442\u043E\u043C \u043D\u0435\u043E\u0445\u043E\u0442\u043D\u043E
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442. \xAB\u041B\u0430\u0434\u043D\u043E.
      \u041A\u0430\u0440\u0442\u0430 \u0442\u0432\u043E\u044F, \u043D\u043E \u0431\u0435\u0437
      \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043E\u043A. \u041F\u0435\u0440\u0432\u0430\u044F
      \u043C\u0435\u0442\u043A\u0430 \u0433\u0434\u0435-\u0442\u043E \u043D\u0430
      \u0432\u043E\u0441\u0442\u043E\u043A\u0435. \u0420\u0430\u0437\u0431\u0438\u0440\u0430\u0439\u0441\u044F
      \u0441\u0430\u043C\xBB. \u0423\u0445\u043E\u0434\u0438\u0442, \u043D\u0435
      \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C. \u041A\u0430\u0440\u0442\u0430
      \u0432 \u0440\u0443\u043A\u0430\u0445, \u043D\u043E \u0431\u0435\u0437 \u043F\u043E\u043C\u043E\u0449\u0438
      \u0424\u0430\u0440\u0443\u0445\u0430 \u0434\u043E\u0440\u043E\u0433\u0430 \u0431\u0443\u0434\u0435\u0442
      \u0442\u044F\u0436\u0435\u043B\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940677
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430\u0434\u043F\u0438\u0441\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940678
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u0441\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0441\u044F \u043D\u0430\u0434
      \u043A\u0430\u0440\u0442\u043E\u0439 \u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u0447\u0438\u0442\u0430\u0442\u044C: \u043D\u0430\u0434\u043F\u0438\u0441\u0438
      \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u043D\u0430 \u0441\u0442\u0430\u0440\u043E\u0440\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u043C
      \u0432\u043F\u0435\u0440\u0435\u043C\u0435\u0448\u043A\u0443 \u0441 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u043C.
      \u0424\u0430\u0440\u0443\u0445 \u0449\u0451\u043B\u043A\u0430\u0435\u0442 \u044F\u0437\u044B\u043A\u043E\u043C
      \u0441 \u0432\u043E\u0441\u0445\u0438\u0449\u0435\u043D\u0438\u0435\u043C.
      \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0438 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B,
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0438\u0442 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F,
      \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0435 \u043C\u0435\u043B\u043A\u0438\u043C
      \u043F\u043E\u0447\u0435\u0440\u043A\u043E\u043C \u043D\u0430 \u043F\u043E\u043B\u044F\u0445.
      \u0424\u0430\u0440\u0443\u0445 \u0442\u043E\u0440\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
      \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043A\u0430\u0440\u0442\u0443
      \u0432 \u0440\u0443\u043A\u0443. \xAB\u0421 \u0442\u0430\u043A\u0438\u043C
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u043E\u043C \u0441\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u0441\u044C.
      \u041F\u0435\u0440\u0432\u0430\u044F \u043C\u0435\u0442\u043A\u0430 - \u043C\u0435\u0436\u0434\u0443
      \u041A\u0430\u0448\u0433\u0430\u0440\u043E\u043C \u0438 \u0410\u043D\u044C\u0441\u0438,
      \u0430 \u0434\u0430\u043B\u044C\u0448\u0435 \u043A\u0430\u0440\u0442\u0430
      \u0441\u0430\u043C\u0430 \u043F\u043E\u0432\u0435\u0434\u0451\u0442\xBB. \u0412\u044B
      \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u0440\u044B\u043D\u043A\u0430
      \u0441 \u044F\u0441\u043D\u043E\u0439 \u0446\u0435\u043B\u044C\u044E \u0438
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C\u0438 \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u043C\u0438
      \u0441\u043B\u043E\u0432\u0430\u043C\u0438 \u0432 \u043F\u0430\u043C\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940679
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940680
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      \u0440\u0430\u0441\u043F\u0430\u0445\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u0448\u0438\u043C \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u043C,
      \u0438 \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u043F\u0435\u0440\u0435\u0434
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0435\u043C
      \u0432\u0430\u0441 \u0443\u0436\u0435 \u0436\u0434\u0451\u0442 \u0412\u0430\u0445\u0443-\u041C\u0430\u043D.
      \u041E\u043D \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442
      \u0442\u044E\u043A\u0438 \u0448\u0451\u043B\u043A\u0430 \u043F\u0440\u0438\u0434\u0438\u0440\u0447\u0438\u0432\u043E,
      \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044F \u043A\u0430\u0436\u0434\u044B\u0439,
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044F \u043D\u0438\u0442\u0438 \u043D\u0430
      \u0441\u0432\u0435\u0442. \u041F\u043E\u0442\u043E\u043C \u0432\u044B\u043F\u0440\u044F\u043C\u043B\u044F\u0435\u0442\u0441\u044F
      \u0438 \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443.
      \xAB\u0414\u0435\u0441\u044F\u0442\u044C \u0442\u044E\u043A\u043E\u0432, \u0431\u0435\u0437
      \u0435\u0434\u0438\u043D\u043E\u0439 \u043C\u043E\u043B\u0438, \u0431\u0435\u0437
      \u0441\u043B\u0435\u0434\u043E\u0432 \u0432\u043E\u0434\u044B. \u0422\u044B
      \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A:
      \u0442\u044B \u043C\u0430\u0441\u0442\u0435\u0440.\xBB \u041E\u043D \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u0438\u0437-\u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u0438 \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u043A\u043E\u0448\u0435\u043B\u044C \u0441 \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C
      \u0438 \u043D\u043E\u0432\u0443\u044E \u0433\u0440\u0430\u043C\u043E\u0442\u0443
      \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E \u0433\u0438\u043B\u044C\u0434\u0438\u0438.
      \xAB\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442
      \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u0435\u0435. \u0413\u043E\u0442\u043E\u0432?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940681
    m_Localized: "\u0413\u043E\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940682
    m_Localized: "\u0412\u044B \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442\u0435
      \u0440\u0443\u043A\u0443 \u0412\u0430\u0445\u0443-\u041C\u0430\u043D\u0430.
      \u0413\u0440\u0430\u043C\u043E\u0442\u0430 \u0433\u0438\u043B\u044C\u0434\u0438\u0438
      \u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u043E\u0439, \u0441\u0435\u0440\u0435\u0431\u0440\u043E
      \u0432 \u043A\u043E\u0448\u0435\u043B\u0435, \u043F\u0443\u0442\u044C \u0432
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434 \u043F\u043E\u0437\u0430\u0434\u0438
      - \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940683
    m_Localized: "\u0421\u0432\u0438\u0442\u043E\u043A \u0434\u043B\u044F \u0422\u0438\u043D\u043B\u0435\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940684
    m_Localized: "\u041F\u0435\u0449\u0435\u0440\u044B \u041C\u043E\u0433\u0430\u043E
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0442 \u0432\u0430\u0441 \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043E\u0439
      \u0438 \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u0431\u043B\u0430\u0433\u043E\u0432\u043E\u043D\u0438\u0439.
      \u0412 \u043F\u043E\u043B\u0443\u043C\u0440\u0430\u043A\u0435 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u0437\u0430\u043B\u0430 \u043C\u043E\u043D\u0430\u0445 \u0432 \u0431\u0430\u0433\u0440\u044F\u043D\u043E\u0439
      \u043A\u0430\u0448\u0430\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 - \u0445\u0443\u0434\u043E\u0439,
      \u0441 \u0431\u0440\u0438\u0442\u043E\u0439 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
      \u0438 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438.
      \xAB\u042F \u0422\u0438\u043D\u043B\u0435\u0439. \u041B\u043E\u0431\u0441\u0430\u043D\u0433
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B, \u0447\u0442\u043E \u0442\u044B
      \u043F\u0440\u0438\u0434\u0451\u0448\u044C.\xBB \u0412\u044B \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442\u0435
      \u0441\u0432\u0438\u0442\u043E\u043A, \u0438 \u043C\u043E\u043D\u0430\u0445
      \u0431\u0435\u0440\u0435\u0436\u043D\u043E \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0435\u0433\u043E, \u0447\u0438\u0442\u0430\u044F \u043F\u0440\u0438 \u0441\u0432\u0435\u0442\u0435
      \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0439 \u043B\u0430\u043C\u043F\u044B.
      \u0415\u0433\u043E \u043B\u0438\u0446\u043E \u043E\u0437\u0430\u0440\u044F\u0435\u0442\u0441\u044F.
      \xAB\u042D\u0442\u043E \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435 \u0434\u0440\u0435\u0432\u043D\u0435\u0435,
      \u0447\u0435\u043C \u044F \u0434\u0443\u043C\u0430\u043B. \u0422\u044B \u0441\u0434\u0435\u043B\u0430\u043B
      \u0434\u043E\u0431\u0440\u043E\u0435 \u0434\u0435\u043B\u043E, \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A.\xBB
      \u041E\u043D \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0441\u0432\u0438\u0442\u043E\u043A
      \u0432 \u043A\u0430\u043C\u0435\u043D\u043D\u0443\u044E \u043D\u0438\u0448\u0443
      \u0438 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u0432\u0430\u043C. \xAB\u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u043F\u0440\u043E\u0441\u0438\u043B
      \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C: \u043F\u0443\u0442\u044C
      \u043D\u0435 \u043E\u043A\u043E\u043D\u0447\u0435\u043D. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435
      \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435 \u0436\u0434\u0451\u0442.
      \u0413\u043E\u0442\u043E\u0432 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940685
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940686
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0432 \u0432\u0430\u0448\u0443 \u0440\u0443\u043A\u0443 \u043D\u043E\u0432\u044B\u0439
      \u0441\u0432\u0438\u0442\u043E\u043A \u0438 \u043F\u0430\u043B\u043E\u0447\u043A\u0443
      \u043B\u0430\u0434\u0430\u043D\u0430. \xAB\u0414\u043E\u0440\u043E\u0433\u0430
      \u0437\u043D\u0430\u0435\u0442 \u0442\u0435\u0431\u044F \u0442\u0435\u043F\u0435\u0440\u044C.
      \u0418\u0434\u0438.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940687
    m_Localized: "\u041A\u043E\u043D\u0432\u043E\u0439 \u0432 \u0410\u043D\u044C\u0441\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940688
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0410\u043D\u044C\u0441\u0438
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0437\u0430
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u043C
      \u0434\u043E\u0440\u043E\u0433\u0438, \u0438 \u0432\u0430\u0448\u0438 \u043F\u043E\u0434\u043E\u043F\u0435\u0447\u043D\u044B\u0435
      (\u0433\u0440\u0443\u043F\u043F\u0430 \u043C\u043E\u043B\u043E\u0434\u044B\u0445
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432, \u0432\u043F\u0435\u0440\u0432\u044B\u0435
      \u0432\u044B\u0448\u0435\u0434\u0448\u0438\u0445 \u043D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C) \u0440\u0430\u0437\u0440\u0430\u0436\u0430\u044E\u0442\u0441\u044F
      \u0440\u0430\u0434\u043E\u0441\u0442\u043D\u044B\u043C\u0438 \u043A\u0440\u0438\u043A\u0430\u043C\u0438.
      \u0414\u0430\u0440\u0438\u0443\u0448 \u0431\u044B\u043B \u043F\u0440\u0430\u0432:
      \u043E\u043D\u0438 \u043D\u0435\u043E\u043F\u044B\u0442\u043D\u044B, \u043D\u043E
      \u0436\u0438\u0432\u044B \u0438 \u043F\u0440\u0438 \u0442\u043E\u0432\u0430\u0440\u0435.
      \u041D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u0443 \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u044F
      \u0432\u0430\u0441 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u043C\u0435\u0441\u0442\u043D\u044B\u0439
      \u0441\u0442\u0430\u0440\u0448\u0438\u043D\u0430. \u041E\u043D \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442
      \u043Aa\u0440\u0430\u0432\u0430\u043D, \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442
      \u043B\u044E\u0434\u0435\u0439 \u0438 \u043A\u0438\u0432\u0430\u0435\u0442
      \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C. \xAB\u0414\u0430\u0440\u0438\u0443\u0448
      \u0432\u044B\u0431\u0440\u0430\u043B \u0445\u043E\u0440\u043E\u0448\u043E.
      \u0417\u0430 \u043A\u043E\u043D\u0432\u043E\u0439 - \u043D\u0430\u0433\u0440\u0430\u0434\u0430.\xBB
      \u041E\u043D \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u0444\u0443\u0442\u043B\u044F\u0440
      \u0441 \u0433\u043B\u0438\u043D\u044F\u043D\u044B\u043C \u0441\u043E\u0441\u0443\u0434\u043E\u043C.
      \xAB\u0413\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u0439 \u043E\u0433\u043E\u043D\u044C.
      \u0414\u0430\u0440\u0438\u0443\u0448 \u043F\u0440\u043E\u0441\u0438\u0442:
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u0447\u0435\u0440\u0435\u0437 \u041C\u0435\u0448\u0445\u0435\u0434 - \u043E\u043F\u0430\u0441\u043D\u044B\u0439
      \u0433\u0440\u0443\u0437. \u0411\u0435\u0440\u0451\u0448\u044C\u0441\u044F
      \u0441\u0440\u0430\u0437\u0443 \u0438\u043B\u0438 \u043E\u0431\u0434\u0443\u043C\u0430\u0435\u0448\u044C?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940689
    m_Localized: "\u0411\u0435\u0440\u0443 \u043C\u0430\u0440\u0448\u0440\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940690
    m_Localized: "\u0421\u0442\u0430\u0440\u0448\u0438\u043D\u0430 \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0445\u043B\u043E\u043F\u0430\u0435\u0442 \u0432\u0430\u0441 \u043F\u043E
      \u043F\u043B\u0435\u0447\u0443 \u0438 \u0448\u0451\u043F\u043E\u0442\u043E\u043C
      \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442: \xAB\u0414\u0430\u0440\u0438\u0443\u0448
      \u0436\u0434\u0451\u0442 \u0442\u0435\u0431\u044F \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435.
      \u0421 \u0433\u0440\u0443\u0437\u043E\u043C \u043D\u0435 \u0442\u044F\u043D\u0438.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940691
    m_Localized: "\u041A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044C \u0438\u0437
      \u0427\u0430\u043D\u044A\u0430\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940692
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0433\u0443\u043B\u043E\u043C \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0435\u0433\u043E
      \u0440\u044B\u043D\u043A\u0430 \u043C\u0438\u0440\u0430. \u041C\u0430\u0441\u0442\u0435\u0440
      \u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u0436\u0434\u0451\u0442 \u0443
      \u0432\u043E\u0440\u043E\u0442 \u0441\u0432\u043E\u0435\u0439 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u043E\u0439
      - \u0443\u0437\u043A\u043E\u0439, \u043F\u0440\u043E\u043F\u0430\u0445\u0448\u0435\u0439
      \u0438\u043D\u0434\u0438\u0433\u043E, \u0441 \u0440\u044F\u0434\u0430\u043C\u0438
      \u0433\u043B\u0438\u043D\u044F\u043D\u044B\u0445 \u0447\u0430\u043D\u043E\u0432
      \u0432\u0434\u043E\u043B\u044C \u0441\u0442\u0435\u043D. \u041E\u043D \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0441\u044B\u0440\u044C\u0451, \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u0432\u0451\u0440\u0442\u043E\u043A,
      \u043D\u044E\u0445\u0430\u0435\u0442, \u0440\u0430\u0441\u0442\u0438\u0440\u0430\u0435\u0442
      \u043C\u0435\u0436\u0434\u0443 \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438.
      \u041F\u043E\u0442\u043E\u043C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0433\u043B\u0430\u0437\u0430 \u0438 \u043A\u0438\u0432\u0430\u0435\u0442.
      \xAB\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435. \u0422\u044B \u043D\u0435
      \u043F\u043E\u0434\u0432\u0451\u043B.\xBB \u041E\u043D \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442
      \u0432\u0430\u0441 \u0432 \u0437\u0430\u0434\u043D\u044E\u044E \u043A\u043E\u043C\u043D\u0430\u0442\u0443,
      \u0433\u0434\u0435 \u043D\u0430 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u043C
      \u0441\u0442\u043E\u043B\u0435 \u043B\u0435\u0436\u0430\u0442 \u043E\u0431\u0440\u0430\u0437\u0446\u044B
      \u0442\u043A\u0430\u043D\u0438 \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0433\u043E
      \u043F\u0443\u0440\u043F\u0443\u0440\u043D\u043E\u0433\u043E \u043E\u0442\u0442\u0435\u043D\u043A\u0430.
      \xAB\u0421\u0435\u043A\u0440\u0435\u0442 \u043F\u0443\u0440\u043F\u0443\u0440\u0430
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043D\u043E\u0432\u043E\u0433\u043E
      \u0448\u0430\u0433\u0430. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435
      \u0434\u0435\u043B\u043E \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u0435\u0435.
      \u0412\u043E\u0437\u044C\u043C\u0451\u0448\u044C\u0441\u044F \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      - \u0438\u043B\u0438 \u0437\u0430\u0439\u0434\u0451\u0448\u044C, \u043A\u043E\u0433\u0434\u0430
      \u0431\u0443\u0434\u0435\u0448\u044C \u0433\u043E\u0442\u043E\u0432?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940693
    m_Localized: "\u0413\u043E\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940694
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440 \u0427\u044D\u043D\u044C \u0412\u044D\u0439
      \u043A\u0438\u0432\u0430\u0435\u0442, \u043F\u0440\u044F\u0447\u0435\u0442
      \u0443\u043B\u044B\u0431\u043A\u0443 \u0432 \u0441\u0435\u0434\u044B\u0435
      \u0443\u0441\u044B \u0438 \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0438\u0437
      \u0448\u043A\u0430\u0444\u0430 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A \u0441 \u043E\u0431\u0440\u0430\u0437\u0446\u0430\u043C\u0438.
      \xAB\u0422\u043E\u0433\u0434\u0430 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C
      \u043E \u043F\u0443\u0440\u043F\u0443\u0440\u0435. \u0418\u0434\u0451\u043C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940695
    m_Localized: "\u0420\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0430
      \u043A\u0430\u0440\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940696
    m_Localized: "\u041F\u0440\u0438\u0432\u0430\u043B \u0443 \u043A\u043E\u0441\u0442\u0440\u0430.
      \u0412\u044B \u0434\u043E\u0441\u0442\u0430\u0451\u0442\u0435 \u043A\u0430\u0440\u0442\u0443
      \u0424\u0430\u0440\u0443\u0445\u0430 \u0438 \u0440\u0430\u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u043D\u0430 \u043F\u043B\u043E\u0441\u043A\u043E\u043C \u043A\u0430\u043C\u043D\u0435.
      \u041F\u0440\u0438 \u0441\u0432\u0435\u0442\u0435 \u043E\u0433\u043D\u044F
      \u0437\u043D\u0430\u043A\u0438 \u043D\u0430 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0435
      \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F \u044F\u0441\u043D\u0435\u0435:
      \u0437\u0430\u0432\u0438\u0442\u043A\u0438 \u0441\u0442\u0430\u0440\u043E-\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u0433\u043E
      \u043F\u0438\u0441\u044C\u043C\u0430 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0432 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u043C\u0435\u0441\u0442,
      \u0441\u0442\u0440\u0435\u043B\u043A\u0438 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F, \u0430
      \u043C\u0435\u043B\u043A\u0438\u0435 \u043F\u043E\u043C\u0435\u0442\u043A\u0438
      \u043D\u0430 \u043F\u043E\u043B\u044F\u0445 \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u044E\u0442
      \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B. \u041C\u0430\u0440\u0448\u0440\u0443\u0442
      \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u0430\u0435\u0442: \u043F\u0435\u0440\u0432\u0430\u044F
      \u0442\u043E\u0447\u043A\u0430 \u0432\u0435\u0434\u0451\u0442 \u043A \u0440\u0443\u0438\u043D\u0430\u043C
      \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u043E \u0445\u0440\u0430\u043C\u0430,
      \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u0443\u043C\u0435\u0441\u044F\u0446\u0435\u043C.
      \u041A\u0430\u0440\u0442\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C. \u0420\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0438\u043B\u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u043A \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0435 \u043F\u043E\u0437\u0436\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940697
    m_Localized: "\u0420\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u0442\u044C
      \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940698
    m_Localized: "\u0412\u044B \u0441\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0435\u0441\u044C
      \u043D\u0430\u0434 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u043E\u043C
      \u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442\u0435 \u0434\u043E
      \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u043D\u043E\u0447\u0438.
      \u0417\u043D\u0430\u043A\u0438 \u0443\u0441\u0442\u0443\u043F\u0430\u044E\u0442,
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u0430\u0435\u0442
      \u0447\u0451\u0442\u0447\u0435. \u041F\u0435\u0440\u0432\u0430\u044F \u0442\u043E\u0447\u043A\u0430
      \u044F\u0441\u043D\u0430, \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u043A\u0430\u0440\u0442\u0430
      \u0441\u0442\u0430\u043D\u0435\u0442 \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u043C
      \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940699
    m_Localized: "\u041F\u0435\u0440\u0432\u0430\u044F \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940700
    m_Localized: "\u0420\u0443\u0438\u043D\u044B \u0445\u0440\u0430\u043C\u0430 \u0432\u043E\u0437\u0432\u044B\u0448\u0430\u044E\u0442\u0441\u044F
      \u043D\u0430\u0434 \u043F\u0435\u0441\u043A\u0430\u043C\u0438: \u043E\u0431\u043B\u043E\u043C\u043A\u0438
      \u043A\u043E\u043B\u043E\u043D\u043D, \u043E\u0441\u0442\u0430\u0442\u043A\u0438
      \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0445 \u0441\u0442\u0435\u043D,
      \u0437\u0430\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0435 \u043F\u0435\u0441\u043A\u043E\u043C
      \u0441\u0442\u0443\u043F\u0435\u043D\u0438. \u0412\u044B \u0441\u0432\u0435\u0440\u044F\u0435\u0442\u0435\u0441\u044C
      \u0441 \u043A\u0430\u0440\u0442\u043E\u0439 \u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435
      \u043D\u0443\u0436\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E: \u043D\u0438\u0448\u0443
      \u0432 \u0443\u0446\u0435\u043B\u0435\u0432\u0448\u0435\u0439 \u0441\u0442\u0435\u043D\u0435,
      \u0441\u043A\u0440\u044B\u0442\u0443\u044E \u0437\u0430 \u043E\u0431\u0432\u0430\u043B\u0438\u0432\u0448\u0438\u043C\u0441\u044F
      \u043A\u0430\u043C\u043D\u0435\u043C. \u0412\u043D\u0443\u0442\u0440\u0438
      \u043B\u0435\u0436\u0438\u0442 \u0437\u0430\u0432\u0451\u0440\u043D\u0443\u0442\u0430\u044F
      \u0432 \u0438\u0441\u0442\u043B\u0435\u0432\u0448\u0443\u044E \u0442\u043A\u0430\u043D\u044C
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u0430\u044F \u0444\u0438\u0433\u0443\u0440\u043A\u0430:
      \u0434\u0440\u0435\u0432\u043D\u0438\u0439 \u0431\u043E\u0436\u043E\u043A \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445
      \u043F\u0443\u0442\u0435\u0439 \u0441 \u043B\u0438\u0446\u043E\u043C, \u0441\u0442\u0451\u0440\u0442\u044B\u043C
      \u0432\u0435\u043A\u0430\u043C\u0438. \u041A\u0430\u0440\u0442\u0430 \u043D\u0435
      \u0441\u043E\u043B\u0433\u0430\u043B\u0430. \u0424\u0430\u0440\u0443\u0445
      \u0437\u043D\u0430\u043B \u0441\u0432\u043E\u0451 \u0434\u0435\u043B\u043E.
      \u041D\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
      \u0444\u0438\u0433\u0443\u0440\u043A\u0438 \u0432\u044B\u0446\u0430\u0440\u0430\u043F\u0430\u043D\u0430
      \u043D\u0430\u0434\u043F\u0438\u0441\u044C - \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
      \u0442\u043E\u0447\u043A\u0438: \u0425\u043E\u0442\u0430\u043D, \u0411\u0430\u043B\u0445,
      \u041A\u0443\u0447\u0430. \u041E\u0445\u043E\u0442\u0430 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940701
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940702
    m_Localized: "\u0412\u044B \u043F\u0440\u044F\u0447\u0435\u0442\u0435 \u0444\u0438\u0433\u0443\u0440\u043A\u0443,
      \u0434\u0435\u043B\u0430\u0435\u0442\u0435 \u0433\u043B\u043E\u0442\u043E\u043A
      \u0432\u043E\u0434\u044B \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0435
      \u043F\u0443\u0442\u044C. \u041A\u0430\u0440\u0442\u0430 \u0424\u0430\u0440\u0443\u0445\u0430
      \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
      \u0442\u043E\u0447\u043A\u0438 - \u0425\u043E\u0442\u0430\u043D, \u0411\u0430\u043B\u0445
      \u0438 \u041A\u0443\u0447\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240325435392
    m_Localized: "\u041B\u043E\u0432\u0443\u0448\u043A\u0438 \u0432 \u0442\u0440\u0430\u0432\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378432
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u043A\u0442\u043E-\u0442\u043E
      \u0441\u043B\u044B\u0448\u0430\u043B \u0432\u043E\u0437\u043D\u044E \u0443
      \u0431\u043B\u0438\u0436\u043D\u0438\u0445 \u043A\u0443\u0441\u0442\u043E\u0432.
      \u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B \u043F\u0440\u0438\u043C\u044F\u0442\u0443\u044E
      \u0442\u0440\u043E\u043F\u043A\u0443: \u0437\u0430\u0439\u0446\u044B. \u041E\u043D
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043F\u0435\u0442\u043B\u044E
      \u0438\u0437 \u043A\u043E\u043D\u0441\u043A\u043E\u0433\u043E \u0432\u043E\u043B\u043E\u0441\u0430
      \u0438 \u043A\u0438\u0432\u0430\u0435\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u0441\u0442\u0435\u043F\u0438. \u0417\u0430\u043F\u0430\u0441\u044B \u043D\u0430
      \u0442\u0440\u0438 \u0434\u043D\u044F, \u043D\u0435 \u0431\u043E\u043B\u044C\u0448\u0435.
      \u0414\u0438\u0447\u044C \u0440\u044F\u0434\u043E\u043C, \u043D\u043E \u043F\u0435\u0442\u043B\u044F
      \u043D\u0435\u043D\u0430\u0434\u0451\u0436\u043D\u0430, \u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0432 \u0442\u0440\u0430\u0432\u0435 \u0432\u0438\u0434\u0435\u043D \u0442\u043E\u043C\u0443,
      \u043A\u0442\u043E \u043D\u0435 \u0441\u043F\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378433
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u0435\u0442\u043B\u0438
      \u0443 \u043B\u0430\u0433\u0435\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378434
    m_Localized: "\u041F\u0435\u0442\u043B\u0438 \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u0432\u0434\u043E\u043B\u044C \u0442\u0440\u043E\u043F\u043E\u043A \u0432
      \u043F\u044F\u0442\u0438\u0434\u0435\u0441\u044F\u0442\u0438 \u0448\u0430\u0433\u0430\u0445
      \u043E\u0442 \u043B\u0430\u0433\u0435\u0440\u044F. \u041A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443
      \u0432 \u0434\u0432\u0443\u0445 \u0438\u0437 \u043D\u0438\u0445 \u0441\u0438\u0434\u0435\u043B\u0438
      \u0436\u0438\u0440\u043D\u044B\u0435 \u0437\u0430\u0439\u0446\u044B. \u041D\u0435\u0433\u0443\u0441\u0442\u043E,
      \u043D\u043E \u043A\u043E\u0442\u0451\u043B \u0431\u0443\u043B\u044C\u043A\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378435
    m_Localized: "\u0423\u0433\u043B\u0443\u0431\u0438\u0442\u044C\u0441\u044F \u0432
      \u0441\u0442\u0435\u043F\u044C \u0441 \u0441\u0435\u0442\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378436
    m_Localized: "\u041E\u0445\u043E\u0442\u043D\u0438\u043A \u043F\u0440\u043E\u0441\u043B\u0435\u0434\u0438\u043B
      \u0442\u0440\u043E\u043F\u043A\u0438 \u0434\u043E \u0441\u0442\u0430\u0440\u0438\u0446\u044B.
      \u0422\u0430\u043C \u043F\u0438\u0440\u043E\u0432\u0430\u043B\u0430 \u0441\u0442\u0430\u044F
      \u043A\u0443\u0440\u043E\u043F\u0430\u0442\u043E\u043A. \u0421\u0435\u0442\u044C
      \u043B\u0435\u0433\u043B\u0430 \u0442\u043E\u0447\u043D\u043E. \u0414\u0432\u0430
      \u0447\u0430\u0441\u0430, \u0438 \u043E\u0431\u043E\u0437 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D
      \u043C\u044F\u0441\u043E\u043C \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378437
    m_Localized: "\u0412 \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u043E\u0445\u043E\u0442\u043D\u0438\u043A
      \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u043D\u043E\u0440\u0443
      \u0438 \u0432\u044B\u0432\u0438\u0445\u043D\u0443\u043B \u043B\u043E\u0434\u044B\u0436\u043A\u0443.
      \u041F\u0435\u0442\u043B\u0438 \u043D\u0430\u0448\u043B\u0438 \u043F\u0443\u0441\u0442\u044B\u043C\u0438.
      \u0412\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0441 \u043F\u0443\u0441\u0442\u044B\u043C\u0438
      \u0440\u0443\u043A\u0430\u043C\u0438 \u0438 \u0432\u0441\u0442\u0440\u0435\u0432\u043E\u0436\u0435\u043D\u043D\u044B\u043C
      \u043B\u0438\u0446\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378438
    m_Localized: "\u041E\u043F\u044B\u0442\u043D\u044B\u0439 \u0441\u043B\u0435\u0434\u043E\u043F\u044B\u0442
      \u0431\u0435\u0440\u0451\u0442 \u0441\u043B\u0435\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378439
    m_Localized: "\u0421\u043B\u0435\u0434\u043E\u043F\u044B\u0442 \u043F\u0440\u043E\u0432\u0451\u043B
      \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u043F\u043E \u043F\u0440\u0438\u043C\u044F\u0442\u043E\u0439
      \u0442\u0440\u0430\u0432\u0435. \"\u0414\u0436\u0435\u0439\u0440\u0430\u043D\u044B.
      \u0412\u043E\u0434\u043E\u043F\u043E\u0439 \u0437\u0430 \u0433\u0440\u044F\u0434\u043E\u0439.\"
      \u041A \u043F\u043E\u043B\u0443\u0434\u043D\u044E \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0441 \u0442\u0443\u0448\u0435\u0439 \u043D\u0430 \u043F\u043B\u0435\u0447\u0430\u0445.
      \u041C\u044F\u0441\u0430 \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0433\u043E\u0440\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378440
    m_Localized: "\u042F\u0433\u043E\u0434\u043D\u0430\u044F \u043B\u043E\u0449\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378441
    m_Localized: "\u0423 \u0440\u0443\u0447\u044C\u044F, \u0432 \u043D\u0438\u0437\u0438\u043D\u043A\u0435,
      \u0441\u0442\u0435\u043D\u0430 \u0431\u043E\u044F\u0440\u044B\u0448\u043D\u0438\u043A\u0430:
      \u043A\u0440\u0430\u0441\u043D\u044B\u0435 \u0433\u0440\u043E\u0437\u0434\u044C\u044F
      \u0431\u043B\u0435\u0441\u0442\u044F\u0442 \u043E\u0442 \u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439
      \u0440\u043E\u0441\u044B. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043D\u044E\u0445\u0430\u0435\u0442 \u0433\u043E\u0440\u0441\u0442\u044C.
      \"\u041A\u0438\u0441\u043B\u044B\u0435, \u043D\u043E \u0432 \u0441\u0430\u043C\u044B\u0439
      \u0440\u0430\u0437.\" \u0420\u044F\u0434\u043E\u043C \u0435\u0436\u0435\u0432\u0438\u043A\u0430
      \u0438 \u0434\u0438\u043A\u0438\u0439 \u0448\u0438\u043F\u043E\u0432\u043D\u0438\u043A.
      \u041B\u043E\u0449\u0438\u043D\u0430 \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0430,
      \u043D\u043E \u044D\u0442\u043E \u0436\u0438\u0432\u043E\u0439 \u0441\u043A\u043B\u0430\u0434.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430\u0434\u043E \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E:
      \u0432 \u0442\u0430\u043A\u0438\u0445 \u0437\u0430\u0440\u043E\u0441\u043B\u044F\u0445
      \u043B\u044E\u0431\u0438\u0442 \u043F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F
      \u043A\u0442\u043E \u043F\u043E\u043F\u0430\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378442
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u0443 \u043A\u0440\u0430\u044F
      \u0437\u0430\u0440\u043E\u0441\u043B\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378443
    m_Localized: "\u041F\u043E\u043B\u0447\u0430\u0441\u0430 \u0443 \u043A\u0440\u0430\u044F
      \u0437\u0430\u0440\u043E\u0441\u043B\u0435\u0439, \u0438 \u0434\u0432\u0430
      \u043C\u0435\u0448\u043E\u0447\u043A\u0430 \u0431\u043E\u044F\u0440\u044B\u0448\u043D\u0438\u043A\u0430
      \u0441 \u0448\u0438\u043F\u043E\u0432\u043D\u0438\u043A\u043E\u043C. \u041A\u0438\u0441\u043B\u043E,
      \u0432\u0438\u0442\u0430\u043C\u0438\u043D\u043D\u043E, \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0434\u043B\u044F \u043A\u0430\u0448\u0438 \u043A \u0443\u0436\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378444
    m_Localized: "\u0423\u0433\u043B\u0443\u0431\u0438\u0442\u044C\u0441\u044F \u0437\u0430
      \u0435\u0436\u0435\u0432\u0438\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378445
    m_Localized: "\u0412 \u0433\u043B\u0443\u0431\u0438\u043D\u0435 \u0441\u043F\u0435\u043B\u0430\u044F
      \u0435\u0436\u0435\u0432\u0438\u043A\u0430 \u0433\u0440\u043E\u0437\u0434\u044C\u044F\u043C\u0438
      \u0441 \u043A\u0443\u043B\u0430\u043A. \u0421\u043E\u0431\u0440\u0430\u043B\u0438
      \u043F\u043E\u043B\u043D\u0443\u044E \u0441\u0443\u043C\u0443. \u041F\u0430\u043B\u044C\u0446\u044B
      \u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u0435, \u043D\u043E
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0436\u0430\u043B\u0443\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378446
    m_Localized: "\u0412 \u0437\u0430\u0440\u043E\u0441\u043B\u044F\u0445 \u043A\u0430\u0431\u0430\u043D
      \u0441 \u0432\u044B\u0432\u043E\u0434\u043A\u043E\u043C. \u041B\u044E\u0434\u0438
      \u0440\u0430\u0437\u0431\u0435\u0436\u0430\u043B\u0438\u0441\u044C, \u0434\u0432\u043E\u0435
      \u043F\u043E\u0446\u0430\u0440\u0430\u043F\u0430\u043B\u0438\u0441\u044C \u043E\u0431
      \u0448\u0438\u043F\u044B. \u042F\u0433\u043E\u0434 \u043D\u0435 \u0441\u043E\u0431\u0440\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378447
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u0441\u044A\u0435\u0434\u043E\u0431\u043D\u044B\u0435 \u043C\u0435\u0441\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378448
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043E\u0431\u043E\u0448\u0451\u043B
      \u043B\u043E\u0449\u0438\u043D\u0443 \u043F\u043E \u043A\u0440\u0430\u044E
      \u0438 \u043F\u0440\u0438\u0432\u0451\u043B \u043A \u043F\u043E\u043B\u044F\u043D\u043A\u0435
      \u0441 \u0434\u0438\u043A\u0438\u043C \u043B\u0443\u043A\u043E\u043C \u0438
      \u043C\u0435\u043B\u043A\u0438\u043C\u0438 \u044F\u0431\u043B\u043E\u043D\u044F\u043C\u0438.
      \"\u041D\u0435 \u0442\u0440\u043E\u0433\u0430\u0439\u0442\u0435 \u0435\u0436\u0435\u0432\u0438\u043A\u0443
      - \u0442\u0430\u043C \u043C\u044B\u0448\u0438. \u0411\u0435\u0440\u0438\u0442\u0435
      \u044F\u0431\u043B\u043E\u043A\u0438 \u0438 \u043B\u0443\u043A.\" \u0417\u0430\u043F\u0430\u0441\u044B
      \u043F\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378449
    m_Localized: "\u041F\u0430\u0441\u0442\u0443\u0445 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378450
    m_Localized: "\u0421\u0442\u0430\u0434\u043E \u0431\u0430\u0440\u0430\u043D\u043E\u0432
      \u0440\u0430\u0441\u0442\u0435\u043A\u043B\u043E\u0441\u044C \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443.
      \u041F\u0430\u0441\u0442\u0443\u0445 \u0441 \u043C\u043E\u043D\u0433\u043E\u043B\u044C\u0441\u043A\u0438\u043C\u0438
      \u0441\u043A\u0443\u043B\u0430\u043C\u0438 \u0441\u0438\u0434\u0438\u0442 \u043D\u0430
      \u043A\u0430\u043C\u043D\u0435 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0431\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0430. \u0423 \u043D\u043E\u0433
      \u0431\u0443\u0440\u0434\u044E\u043A \u0441 \u043A\u0443\u043C\u044B\u0441\u043E\u043C
      \u0438 \u043F\u0435\u0440\u0435\u043C\u0451\u0442\u043D\u0430\u044F \u0441\u0443\u043C\u0430.
      \u041A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0438 \u0432 \u044D\u0442\u0438\u0445
      \u043A\u0440\u0430\u044F\u0445 \u043D\u0435 \u0442\u043E\u0440\u0433\u0443\u044E\u0442
      \u0441 \u0447\u0443\u0436\u0430\u043A\u0430\u043C\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0442\u0430\u043A: \u043D\u0443\u0436\u0435\u043D \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0438\u043B\u0438 \u043D\u0443\u0436\u043D\u044B\u0439
      \u0442\u043E\u0432\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378451
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u043C\u043E\u043D\u0435\u0442\u0443
      \u0437\u0430 \u0431\u0430\u0440\u0430\u043D\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378452
    m_Localized: "\u041F\u0430\u0441\u0442\u0443\u0445 \u043F\u043E\u0432\u0435\u0440\u0442\u0435\u043B
      \u043C\u043E\u043D\u0435\u0442\u0443 \u0438 \u0441\u043F\u0440\u044F\u0442\u0430\u043B.
      \u041E\u0442\u0440\u0435\u0437\u0430\u043B \u043F\u043E\u043B\u0431\u043E\u043A\u0430
      \u0431\u0430\u0440\u0430\u043D\u0430, \u043D\u0435 \u0442\u043E\u0440\u0433\u0443\u044F\u0441\u044C.
      \u041C\u044F\u0441\u043E \u0441\u0432\u0435\u0436\u0435\u0435, \u0436\u0438\u0440\u043D\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378453
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u043E\u0431 \u043E\u0431\u043C\u0435\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378454
    m_Localized: "\u0427\u0430\u0441 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430
      \u0436\u0435\u0441\u0442\u0430\u043C\u0438, \u0438 \u0441\u043E\u0448\u043B\u0438\u0441\u044C:
      \u0431\u0430\u0440\u0430\u043D\u044C\u044F \u0442\u0443\u0448\u0430 \u0437\u0430
      \u043A\u0443\u0441\u043E\u043A \u043D\u0430\u0434\u043E\u0440\u0432\u0430\u043D\u043D\u043E\u0433\u043E
      \u0448\u0451\u043B\u043A\u0430. \u041F\u0430\u0441\u0442\u0443\u0445 \u0441\u0438\u044F\u043B.
      \u041C\u044F\u0441\u0430 \u043D\u0430 \u0442\u0440\u0438 \u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378455
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B \u0437\u0430\u0448\u043B\u0438
      \u0432 \u0442\u0443\u043F\u0438\u043A. \u0420\u0430\u0441\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u0431\u0435\u0437 \u0441\u0434\u0435\u043B\u043A\u0438 \u0438 \u0441 \u043B\u0451\u0433\u043A\u043E\u0439
      \u0432\u0437\u0430\u0438\u043C\u043D\u043E\u0439 \u043E\u0431\u0438\u0434\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378456
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0437\u043D\u0430\u0435\u0442 \u043E\u0431\u044B\u0447\u0430\u0439
      \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378457
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u043F\u0435\u0440\u0432\u044B\u043C
      \u043F\u0440\u0438\u043D\u044F\u043B \u043A\u0443\u043C\u044B\u0441 \u0438
      \u0432\u044B\u043F\u0438\u043B \u043D\u0435 \u043C\u043E\u0440\u0449\u0430\u0441\u044C.
      \u041F\u0430\u0441\u0442\u0443\u0445 \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u0438\u043B
      \u043F\u043B\u0435\u0447\u0438. \u0414\u0432\u0430 \u0431\u0430\u0440\u0430\u043D\u0430,
      \u0442\u0440\u0430\u0432\u044B \u0438 \u0442\u0430\u0431\u0430\u043A \u0437\u0430
      \u0441\u0432\u044F\u0437\u043A\u0443 \u0431\u0443\u0441. \u0414\u043E\u0431\u0440\u043E\u0434\u0443\u0448\u0438\u0435
      \u0434\u0435\u0448\u0435\u0432\u043B\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378458
    m_Localized: "\u041E\u0434\u0438\u043D\u043E\u043A\u0430\u044F \u043F\u0430\u043B\u044C\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378459
    m_Localized: "\u041F\u0430\u043B\u044C\u043C\u0430 \u0441\u0442\u043E\u0438\u0442
      \u043E\u0434\u043D\u0430 \u043D\u0430 \u043A\u0440\u0430\u044E \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0439
      \u0433\u0440\u044F\u0434\u044B. \u041A\u0440\u043E\u043D\u0430 \u0432 \u043F\u044F\u0442\u043D\u0430\u0445
      \u043E\u0442 \u0437\u043D\u043E\u044F, \u043D\u043E \u0433\u0440\u043E\u0437\u0434\u044C\u044F
      \u0444\u0438\u043D\u0438\u043A\u043E\u0432 \u0442\u0451\u043C\u043D\u044B\u0435,
      \u043D\u0430\u043B\u0438\u0442\u044B\u0435. \u0412\u0435\u0442\u0435\u0440
      \u043D\u0435\u0441\u0451\u0442 \u0441\u043B\u0430\u0434\u043A\u043E\u0432\u0430\u0442\u044B\u0439
      \u0437\u0430\u043F\u0430\u0445 \u043F\u0435\u0440\u0435\u0437\u0440\u0435\u043B\u043E\u0433\u043E
      \u043F\u043B\u043E\u0434\u0430. \u0421\u0442\u0432\u043E\u043B \u0433\u043B\u0430\u0434\u043A\u0438\u0439
      \u0438 \u043E\u0431\u043E\u0436\u0436\u0451\u043D\u043D\u044B\u0439 \u0441\u043E\u043B\u043D\u0446\u0435\u043C,
      \u0430 \u0443 \u043A\u043E\u0440\u043D\u0435\u0439 \u043F\u0435\u0442\u043B\u044F\u044E\u0442
      \u0441\u043B\u0435\u0434\u044B \u0437\u043C\u0435\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378460
    m_Localized: "\u0421\u0431\u0438\u0442\u044C \u043D\u0438\u0436\u043D\u0438\u0435
      \u0433\u0440\u043E\u0437\u0434\u044C\u044F \u0448\u0435\u0441\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378461
    m_Localized: "\u0428\u0435\u0441\u0442 \u0434\u043E\u0441\u0442\u0430\u043B \u043D\u0438\u0436\u043D\u0438\u0435
      \u0433\u0440\u043E\u0437\u0434\u0438. \u0424\u0438\u043D\u0438\u043A\u0438
      \u043E\u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C \u0432 \u043F\u044B\u043B\u044C.
      \u041D\u0430\u0431\u0440\u0430\u043B\u0438 \u043F\u0440\u0438\u0433\u043E\u0440\u0448\u043D\u0438.
      \u041D\u0435\u043C\u043D\u043E\u0433\u043E, \u043D\u043E \u0432 \u0441\u0447\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378462
    m_Localized: "\u0417\u0430\u043B\u0435\u0437\u0442\u044C \u0437\u0430 \u0432\u0435\u0440\u0445\u043D\u0438\u043C\u0438
      \u0433\u0440\u043E\u0437\u0434\u044C\u044F\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378463
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u043E\u0431\u0432\u044F\u0437\u0430\u043B
      \u0441\u0442\u0432\u043E\u043B \u0432\u0435\u0440\u0451\u0432\u043A\u043E\u0439
      \u0438 \u043F\u043E\u043B\u0435\u0437. \u041D\u0430\u0432\u0435\u0440\u0445\u0443
      \u0442\u0440\u0438 \u0442\u044F\u0436\u0451\u043B\u044B\u0435 \u0433\u0440\u043E\u0437\u0434\u0438.
      \u041B\u0430\u0433\u0435\u0440\u044C \u0435\u043B \u0434\u043E\u043B\u0433\u043E
      \u0438 \u043C\u043E\u043B\u0447\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378464
    m_Localized: "\u041D\u0430 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u043F\u043E\u0434\u044A\u0451\u043C\u0430
      \u043D\u043E\u0433\u0430 \u0441\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0430,
      \u0443\u043F\u0430\u043B \u043D\u0430 \u0441\u043F\u0438\u043D\u0443, \u043E\u0442\u0431\u0438\u043B
      \u043F\u043B\u0435\u0447\u043E. \u0418\u0437-\u043F\u043E\u0434 \u043A\u043E\u0440\u043D\u0435\u0439
      \u0432\u044B\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0430 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F
      \u0431\u0443\u0440\u0430\u044F \u0437\u043C\u0435\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378465
    m_Localized: "\u041E\u043F\u044B\u0442\u043D\u044B\u0439 \u0432\u044B\u0436\u0438\u0432\u0430\u043B\u044C\u0449\u0438\u043A
      \u0437\u043D\u0430\u0435\u0442 \u043F\u0440\u0438\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378466
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0441\u043A\u0440\u0443\u0442\u0438\u043B
      \u0440\u0435\u043C\u043D\u0438 \u043F\u0435\u0442\u043B\u0451\u0439, \u043D\u0430\u0431\u0440\u043E\u0441\u0438\u043B
      \u043D\u0430 \u0441\u0442\u0432\u043E\u043B \u0438 \u043F\u043E\u0448\u0451\u043B
      \u0432\u0432\u0435\u0440\u0445 \u0431\u0435\u0437 \u0440\u0443\u043A. \u0417\u0430
      \u043F\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442 \u0441\u043D\u044F\u043B
      \u0432\u0441\u0435 \u0433\u0440\u043E\u0437\u0434\u0438. \"\u0412 \u0410\u0440\u0430\u0432\u0438\u0438
      \u0442\u0430\u043A \u0443\u0447\u0430\u0442 \u0434\u0435\u0442\u0435\u0439.\""
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378467
    m_Localized: "\u041F\u0443\u0441\u0442\u044B\u043D\u043D\u044B\u0439 \u043B\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378468
    m_Localized: "\u041D\u0430 \u0437\u0430\u043A\u0430\u0442\u0435 \u0438\u0437-\u0437\u0430
      \u0431\u0430\u0440\u0445\u0430\u043D\u0430 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u043B\u0438\u0441\u0438\u0446\u0430. \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F,
      \u0436\u0451\u043B\u0442\u043E-\u0440\u044B\u0436\u0430\u044F, \u0441 \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u043C\u0438
      \u0443\u0448\u0430\u043C\u0438 - \u0444\u0435\u043D\u0435\u043A. \u0421\u0430\u0434\u0438\u0442\u0441\u044F
      \u0432 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438 \u0448\u0430\u0433\u0430\u0445
      \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0431\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0430,
      \u043D\u043E\u0441 \u043F\u043E\u0434\u0440\u0430\u0433\u0438\u0432\u0430\u0435\u0442.
      \u041C\u044F\u0441\u0430 \u043C\u0430\u043B\u043E, \u043D\u043E \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435
      \u043B\u044E\u0431\u0430\u044F \u0434\u043E\u0431\u044B\u0447\u0430 - \u043F\u043E\u0434\u0430\u0440\u043E\u043A.
      \u0412\u043E\u043F\u0440\u043E\u0441 \u0432 \u0442\u043E\u043C, \u043A\u0430\u043A
      \u0435\u0451 \u0432\u0437\u044F\u0442\u044C, \u043D\u0435 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0432
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0441\u0438\u043B, \u0447\u0435\u043C
      \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378469
    m_Localized: "\u041F\u043E\u0434\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u0440\u0438\u043C\u0430\u043D\u043A\u0443
      \u0438 \u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378470
    m_Localized: "\u0421\u0443\u0445\u0430\u0440\u044C \u043D\u0430 \u0432\u0435\u0440\u0451\u0432\u043A\u0435.
      \u0424\u0435\u043D\u0435\u043A \u043F\u043E\u0434\u043E\u0448\u0451\u043B,
      \u043F\u043E\u0442\u044F\u043D\u0443\u043B, \u043D\u043E \u0443\u0441\u043F\u0435\u043B
      \u043F\u0440\u044B\u0433\u043D\u0443\u0442\u044C. \u0412\u0441\u0451 \u0436\u0435
      \u043F\u0440\u043E\u0431\u044B\u043B \u0440\u044F\u0434\u043E\u043C \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u043D\u044F\u0442\u044C \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0432 \u043B\u0430\u0433\u0435\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378471
    m_Localized: "\u0417\u0430\u0433\u043D\u0430\u0442\u044C \u0441\u0435\u0442\u044C\u044E
      \u043D\u0430 \u0437\u0430\u043A\u0430\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378472
    m_Localized: "\u0414\u0432\u043E\u0435 \u043E\u0431\u043E\u0448\u043B\u0438 \u0441\u0431\u043E\u043A\u0443,
      \u0442\u0440\u0435\u0442\u0438\u0439 \u0441 \u0444\u0430\u043A\u0435\u043B\u043E\u043C
      \u0433\u043D\u0430\u043B \u043A \u0441\u0435\u0442\u0438. \u0424\u0435\u043D\u0435\u043A
      \u0437\u0430\u043F\u0443\u0442\u0430\u043B\u0441\u044F. \u0416\u0438\u0440
      \u043F\u043E\u0434 \u0448\u043A\u0443\u0440\u043E\u0439. \u0412\u0435\u0447\u0435\u0440\u043E\u043C
      \u0432\u0430\u0440\u0438\u043B\u0438 \u0441\u0443\u043F, \u043F\u0430\u0445\u043D\u0443\u0449\u0438\u0439
      \u043F\u0440\u044F\u043D\u043E\u0441\u0442\u044F\u043C\u0438 \u0438 \u0434\u044B\u043C\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378473
    m_Localized: "\u0424\u0435\u043D\u0435\u043A \u0443\u0448\u0451\u043B \u0432
      \u043D\u043E\u0440\u0443 \u0437\u0430 \u0434\u043E\u043B\u044E \u0441\u0435\u043A\u0443\u043D\u0434\u044B
      \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0441\u0435\u0442\u044C
      \u043B\u0435\u0433\u043B\u0430. \u0412\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u0441 \u043F\u0443\u0441\u0442\u044B\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438
      \u0438 \u0441\u0431\u0438\u0442\u044B\u043C\u0438 \u043D\u043E\u0433\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378474
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u043D\u043E\u0440\u044B \u0444\u0435\u043D\u0435\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378475
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043E\u0431\u043E\u0448\u0451\u043B
      \u043D\u043E\u0440\u0443 \u0441 \u043F\u043E\u0434\u0432\u0435\u0442\u0440\u0435\u043D\u043D\u043E\u0439
      \u0441\u0442\u043E\u0440\u043E\u043D\u044B, \u043D\u0430\u043A\u0440\u044B\u043B
      \u0432\u044B\u0445\u043E\u0434 \u0445\u0430\u043B\u0430\u0442\u043E\u043C \u0438
      \u0445\u043B\u043E\u043F\u043D\u0443\u043B \u0432 \u043B\u0430\u0434\u043E\u0448\u0438.
      \u0424\u0435\u043D\u0435\u043A \u0432\u044B\u0441\u043A\u043E\u0447\u0438\u043B
      \u043F\u0440\u044F\u043C\u043E \u0432 \u0442\u043A\u0430\u043D\u044C. \"\u0412
      \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u0442\u0430\u043A \u043B\u043E\u0432\u0438\u043B
      \u0434\u044E\u0436\u0438\u043D\u0430\u043C\u0438.\" \u0428\u043A\u0443\u0440\u043A\u0430
      \u0432 \u0434\u0435\u043B\u043E, \u043C\u044F\u0441\u043E \u0432 \u043A\u043E\u0442\u0451\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378476
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0435 \u0441\u043B\u0435\u0434\u044B
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378477
    m_Localized: "\u041D\u0430 \u0442\u0432\u0451\u0440\u0434\u043E\u043C \u0442\u0430\u043A\u044B\u0440\u0435
      \u043E\u0442\u043F\u0435\u0447\u0430\u0442\u043A\u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u044C\u0438\u0445
      \u043D\u043E\u0433 \u0443\u0445\u043E\u0434\u044F\u0442 \u043D\u0430 \u0441\u0435\u0432\u0435\u0440\u043E-\u0432\u043E\u0441\u0442\u043E\u043A.
      \u0421\u0442\u0430\u0440\u044B\u0435, \u043D\u043E \u043D\u0435 \u0437\u0430\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0435.
      \u0420\u044F\u0434\u043E\u043C \u0440\u0430\u0437\u0431\u0438\u0442\u0430\u044F
      \u0433\u043B\u0438\u043D\u044F\u043D\u0430\u044F \u0444\u043B\u044F\u0433\u0430
      \u0438 \u0433\u043E\u0440\u0441\u0442\u044C \u0441\u0443\u0445\u0438\u0445
      \u0444\u0438\u043D\u0438\u043A\u043E\u0432 \u0432 \u043F\u044B\u043B\u0438.
      \u0412 \u043F\u0443\u0441\u0442\u044B\u043D\u0435 \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439
      \u0441\u043B\u0435\u0434 \u043C\u043E\u0436\u0435\u0442 \u0432\u0435\u0441\u0442\u0438
      \u043A \u0432\u043E\u0434\u0435, \u043A \u0442\u0430\u0439\u043D\u0438\u043A\u0443,
      \u0430 \u043C\u043E\u0436\u0435\u0442 - \u043A \u043D\u0438\u0447\u0435\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378478
    m_Localized: "\u041F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C \u0444\u0438\u043D\u0438\u043A\u0438
      \u0438 \u0438\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378479
    m_Localized: "\u0424\u0438\u043D\u0438\u043A\u0438 \u0441\u0443\u0445\u0438\u0435,
      \u043D\u043E \u0433\u043E\u0434\u043D\u044B\u0435. \u041F\u043E\u0434\u043E\u0431\u0440\u0430\u043B\u0438
      \u0432\u0441\u0451. \u041D\u0435\u043C\u043D\u043E\u0433\u043E, \u043D\u043E
      \u0432 \u0441\u0447\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378480
    m_Localized: "\u041F\u0440\u043E\u0441\u043B\u0435\u0434\u0438\u0442\u044C \u0441\u043B\u0435\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378481
    m_Localized: "\u0421\u043B\u0435\u0434\u044B \u043F\u0440\u0438\u0432\u0435\u043B\u0438
      \u043A \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0439 \u0433\u0440\u044F\u0434\u0435.
      \u0422\u0430\u043C \u0441\u0442\u0430\u0440\u044B\u0439 \u043A\u043E\u043B\u043E\u0434\u0435\u0446,
      \u043F\u043E\u0447\u0442\u0438 \u0437\u0430\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0439.
      \u0414\u0432\u043E\u0435 \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u043B\u0438
      \u0433\u043E\u0440\u043B\u043E\u0432\u0438\u043D\u0443, \u0438 \u0441\u043E
      \u0434\u043D\u0430 \u043F\u043E\u0442\u044F\u043D\u0443\u043B\u043E \u0445\u043E\u043B\u043E\u0434\u043E\u043C.
      \u0412\u043E\u0434\u0430 \u0435\u0441\u0442\u044C. \u0411\u0443\u0440\u0434\u044E\u043A\u0438
      \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378482
    m_Localized: "\u0421\u043B\u0435\u0434\u044B \u043E\u0431\u0440\u044B\u0432\u0430\u043B\u0438\u0441\u044C
      \u0443 \u0440\u0430\u0437\u043C\u044B\u0442\u043E\u0433\u043E \u043E\u0431\u0440\u044B\u0432\u0430.
      \u041D\u0438 \u0432\u043E\u0434\u044B, \u043D\u0438 \u0442\u0430\u0439\u043D\u0438\u043A\u0430.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0432\u044B\u0431\u0438\u0442\u044B\u0435
      \u0441\u0438\u043B\u044B \u0438 \u0447\u0430\u0441\u044B \u0432\u043F\u0443\u0441\u0442\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378483
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0447\u0438\u0442\u0430\u0435\u0442
      \u0441\u043B\u0435\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378484
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043F\u043E\u0442\u0440\u043E\u0433\u0430\u043B
      \u043E\u0442\u043F\u0435\u0447\u0430\u0442\u043E\u043A, \u043F\u043E\u0434\u043D\u044F\u043B
      \u0433\u043E\u043B\u043E\u0432\u0443. \"\u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u043E\u0431\u043E\u0437. \u0422\u0440\u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430,
      \u043E\u0434\u0438\u043D \u0445\u0440\u043E\u043C\u043E\u0439. \u0414\u0432\u0430
      \u0434\u043D\u044F \u043D\u0430\u0437\u0430\u0434. \u0417\u0430 \u0441\u043A\u0430\u043B\u043E\u0439
      \u0438\u0445 \u043F\u0440\u0438\u0432\u0430\u043B.\" \u041D\u0430\u0448\u043B\u0438
      \u043A\u043E\u043B\u044C\u0446\u043E \u043A\u0430\u043C\u043D\u0435\u0439,
      \u043F\u043E\u0434 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C
      - \u043A\u0438\u0441\u0435\u0442 \u0441 \u0435\u0434\u043E\u0439, \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
      \u0434\u043B\u044F \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378485
    m_Localized: "\u041A\u0435\u0434\u0440\u043E\u0432\u044B\u0435 \u0448\u0438\u0448\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378486
    m_Localized: "\u0421\u043A\u043B\u043E\u043D \u043D\u0430\u0434 \u043B\u0430\u0433\u0435\u0440\u0435\u043C
      \u0443\u0441\u0435\u044F\u043D \u043A\u0435\u0434\u0440\u0430\u043C\u0438.
      \u0412\u0435\u0442\u0435\u0440 \u0434\u043E\u043D\u043E\u0441\u0438\u0442 \u0441\u043C\u043E\u043B\u0438\u0441\u0442\u044B\u0439
      \u0437\u0430\u043F\u0430\u0445, \u0438 \u043F\u043E\u0434 \u0434\u0435\u0440\u0435\u0432\u044C\u044F\u043C\u0438
      \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043D\u044B \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E\u0434\u043D\u0438\u0435
      \u0448\u0438\u0448\u043A\u0438. \u041E\u0434\u0438\u043D \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0448\u0438\u0448\u043A\u0443,
      \u043C\u043D\u0451\u0442 \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438:
      \u0441\u0435\u043C\u0435\u043D\u0430 \u043A\u0440\u0443\u043F\u043D\u044B\u0435,
      \u043C\u0430\u0441\u043B\u044F\u043D\u0438\u0441\u0442\u044B\u0435. \u0425\u0432\u0430\u0442\u0438\u0442
      \u043D\u0430\u0431\u0438\u0442\u044C \u043F\u0430\u0440\u0443 \u043C\u0435\u0448\u043A\u043E\u0432.
      \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0441\u043A\u043B\u043E\u043D\u0435
      \u0441\u043A\u043E\u043B\u044C\u0437\u043A\u043E, \u043A\u0430\u043C\u043D\u0438
      \u0443\u0445\u043E\u0434\u044F\u0442 \u0438\u0437-\u043F\u043E\u0434 \u043D\u043E\u0433,
      \u0430 \u0432 \u043A\u0430\u043C\u043D\u044F\u0445 \u043C\u0435\u0436\u0434\u0443
      \u043A\u043E\u0440\u043D\u044F\u043C\u0438 \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C
      \u043D\u043E\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378487
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u0448\u0438\u0448\u043A\u0438
      \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u044C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378488
    m_Localized: "\u041F\u043E\u043B\u0447\u0430\u0441\u0430 \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u044C\u044F
      \u0434\u0430\u043B\u043E \u043F\u043E\u043B\u043D\u044B\u0439 \u043C\u0435\u0448\u043E\u043A
      \u0448\u0438\u0448\u0435\u043A. \u041E\u0440\u0435\u0445\u0438 \u043C\u0435\u043B\u043A\u0438\u0435
      \u0432 \u043D\u0438\u0436\u043D\u0438\u0445, \u043D\u043E \u0433\u043E\u0434\u043D\u044B\u0435.
      \u0423\u0436\u0438\u043D \u043F\u0430\u0445\u043D\u0435\u0442 \u0441\u043C\u043E\u043B\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378489
    m_Localized: "\u041F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F \u0437\u0430
      \u043A\u0440\u0443\u043F\u043D\u044B\u043C\u0438 \u0448\u0438\u0448\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378490
    m_Localized: "\u0412\u044B\u0448\u0435 \u0448\u0438\u0448\u043A\u0438 \u043A\u0440\u0443\u043F\u043D\u0435\u0435,
      \u0441\u0435\u043C\u0435\u043D\u0430 - \u0441 \u043D\u043E\u0433\u043E\u0442\u044C,
      \u043C\u0430\u0441\u043B\u044F\u043D\u0438\u0441\u0442\u044B\u0435. \u041D\u0430\u0431\u0440\u0430\u043B\u0438
      \u0434\u0432\u0430 \u043C\u0435\u0448\u043A\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0440\u0430\u0441\u043A\u043E\u043B\u043E\u043B\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043F\u0440\u044F\u043C\u043E \u0441\u0435\u0439\u0447\u0430\u0441, \u0436\u0435\u0432\u0430\u043B\u0438
      \u043C\u043E\u043B\u0447\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378491
    m_Localized: "\u041A\u0430\u043C\u0435\u043D\u044C \u043F\u043E\u0434 \u043D\u043E\u0433\u043E\u0439
      \u0441\u043F\u043E\u043B\u0437, \u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u043F\u043E\u043A\u0430\u0442\u0438\u043B\u0441\u044F \u043F\u043E \u043E\u0441\u044B\u043F\u0438.
      \u0412\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0441 \u043E\u0431\u043E\u0434\u0440\u0430\u043D\u043D\u044B\u043C\u0438
      \u0440\u0443\u043A\u0430\u043C\u0438 \u0438 \u043F\u0443\u0441\u0442\u044B\u043C
      \u043C\u0435\u0448\u043A\u043E\u043C. \u0428\u0438\u0448\u043A\u0438 \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C
      \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378492
    m_Localized: "\u0421\u043B\u0435\u0434\u043E\u043F\u044B\u0442 \u0437\u043D\u0430\u0435\u0442
      \u043B\u0443\u0447\u0448\u0438\u0435 \u0434\u0435\u0440\u0435\u0432\u044C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378493
    m_Localized: "\u0421\u043B\u0435\u0434\u043E\u043F\u044B\u0442 \u043F\u0440\u043E\u0448\u0451\u043B
      \u0432\u0434\u043E\u043B\u044C \u0441\u043A\u043B\u043E\u043D\u0430 \u0438
      \u043D\u0430\u0448\u0451\u043B \u0441\u0442\u0430\u0440\u044B\u0439 \u043A\u0435\u0434\u0440
      \u0432 \u0440\u0430\u0441\u043F\u0430\u0434\u043A\u0435: \u0441\u0442\u0432\u043E\u043B
      \u0432 \u0434\u0432\u0430 \u043E\u0431\u0445\u0432\u0430\u0442\u0430, \u0448\u0438\u0448\u043A\u0438
      \u0441 \u043A\u0443\u043B\u0430\u043A. \u041E\u0440\u0435\u0445\u043E\u0432
      \u043D\u0430\u0431\u0440\u0430\u043B\u0438 \u0441\u0442\u043E\u043B\u044C\u043A\u043E,
      \u0447\u0442\u043E \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043D\u0435\u0441\u0442\u0438 \u0432 \u0440\u0443\u0431\u0430\u0445\u0430\u0445.
      \u0425\u0432\u0430\u0442\u0438\u0442 \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430 \u0438 \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378494
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u043A\u043E\u0437\u0451\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378495
    m_Localized: "\u041D\u0430 \u0443\u0441\u0442\u0443\u043F\u0435 \u043D\u0430\u0434
      \u043B\u0430\u0433\u0435\u0440\u0435\u043C \u0441\u0442\u043E\u0438\u0442 \u043A\u043E\u0437\u0451\u043B.
      \u0420\u043E\u0433\u0430 \u0437\u0430\u043A\u0440\u0443\u0447\u0435\u043D\u043D\u044B\u0435,
      \u0448\u0435\u0440\u0441\u0442\u044C \u0441\u0435\u0440\u0430\u044F \u0441
      \u0438\u043D\u0435\u0435\u043C. \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0432\u043D\u0438\u0437 \u0431\u0435\u0437 \u043E\u0441\u043E\u0431\u043E\u0433\u043E
      \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0430: \u0432
      \u0433\u043E\u0440\u0430\u0445 \u043A\u043E\u0437\u043B\u044B \u0437\u043D\u0430\u044E\u0442,
      \u0447\u0442\u043E \u0441\u043A\u0430\u043B\u0430 \u0438\u0445 \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442
      \u043B\u0443\u0447\u0448\u0435 \u043B\u044E\u0431\u043E\u0433\u043E \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430.
      \u0414\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F \u0432\u0435\u043B\u0438\u043A\u0430,
      \u0432\u0435\u0442\u0435\u0440 \u043F\u043E\u0440\u044B\u0432\u0438\u0441\u0442\u044B\u0439,
      \u0430 \u0441\u043A\u043B\u043E\u043D \u043F\u043E\u0434 \u043D\u0438\u043C
      \u043D\u0435\u043D\u0430\u0434\u0451\u0436\u0435\u043D. \u041C\u044F\u0441\u0430
      \u0442\u0430\u043C \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439, \u0438 \u0448\u043A\u0443\u0440\u0430 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F,
      \u043D\u043E \u043B\u044E\u0431\u0430\u044F \u043E\u0448\u0438\u0431\u043A\u0430
      \u043C\u043E\u0436\u0435\u0442 \u0441\u0442\u043E\u0438\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378496
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u0432\u044B\u0439\u0442\u0438
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378497
    m_Localized: "\u041F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C:
      \u043A\u043E\u0437\u0451\u043B \u0443\u0448\u0451\u043B \u0432\u044B\u0448\u0435,
      \u043F\u0435\u0440\u0435\u043F\u0440\u044B\u0433\u043D\u0443\u0432 \u0442\u0440\u0435\u0449\u0438\u043D\u0443.
      \u041E\u0445\u043E\u0442\u043D\u0438\u043A \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F,
      \u043D\u043E \u043F\u0440\u0438\u043D\u0451\u0441 \u0433\u043E\u0440\u0441\u0442\u044C
      \u043F\u043E\u043C\u0451\u0442\u0430: \u043F\u0430\u0441\u0442\u0431\u0438\u0449\u0435
      \u0440\u044F\u0434\u043E\u043C. \u0417\u043D\u0430\u0447\u0438\u0442, \u043A\u043E\u0437\u043B\u044B
      \u0432\u0435\u0440\u043D\u0443\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378498
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u0438 \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C
      \u0437\u0430\u0441\u0430\u0434\u0443 \u043D\u0430 \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378499
    m_Localized: "\u0414\u0432\u043E\u0435 \u043E\u0431\u043E\u0448\u043B\u0438 \u0443\u0441\u0442\u0443\u043F
      \u043F\u043E \u0432\u0435\u0440\u0445\u0443, \u0432\u044B\u0431\u0440\u0430\u043B\u0438
      \u043A\u043E\u0437\u044C\u044E \u0442\u0440\u043E\u043F\u0443 \u0438 \u0436\u0434\u0430\u043B\u0438.
      \u041A\u043E\u0437\u0451\u043B \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0441\u044F
      \u043A \u0432\u0435\u0447\u0435\u0440\u0443. \u041E\u0434\u0438\u043D \u0432\u044B\u0441\u0442\u0440\u0435\u043B.
      \u0422\u0443\u0448\u0430 \u0442\u044F\u0436\u0451\u043B\u0430\u044F, \u0441\u043F\u0443\u0441\u043A\u0430\u043B\u0438
      \u043D\u0430 \u0432\u0435\u0440\u0451\u0432\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378500
    m_Localized: "\u041D\u0430 \u0442\u0440\u043E\u043F\u0435 \u043A\u043E\u0437\u0451\u043B
      \u0443\u0447\u0443\u044F\u043B \u043B\u044E\u0434\u0435\u0439 \u0437\u0430
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0448\u0430\u0433\u043E\u0432.
      \u041F\u0440\u044B\u0436\u043E\u043A \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u0438 \u043E\u043D \u0438\u0441\u0447\u0435\u0437 \u0437\u0430 \u0433\u0440\u0435\u0431\u043D\u0435\u043C.
      \u0414\u0432\u043E\u0435 \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432
      \u043F\u0440\u043E\u0441\u0438\u0434\u0435\u043B\u0438 \u0432 \u043A\u0430\u043C\u043D\u044F\u0445
      \u0442\u0440\u0438 \u0447\u0430\u0441\u0430 \u0437\u0440\u044F. \u041E\u0434\u0438\u043D
      \u043E\u0431\u043C\u043E\u0440\u043E\u0437\u0438\u043B \u043F\u0430\u043B\u044C\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378501
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u043A\u043E\u0437\u044C\u0438 \u0442\u0440\u043E\u043F\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378502
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043F\u0440\u043E\u0432\u0451\u043B
      \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432 \u043F\u043E \u0442\u0435\u043D\u0435\u0432\u043E\u043C\u0443
      \u0441\u043A\u043B\u043E\u043D\u0443, \u043E\u0431\u0445\u043E\u0434\u044F
      \u0432\u0441\u0435 \u0442\u0440\u0435\u0449\u0438\u043D\u044B. \u041F\u043E\u043A\u0430\u0437\u0430\u043B
      \u0442\u0440\u043E\u043F\u0443 \u0443 \u0441\u043D\u0435\u0433\u043E\u0432\u043E\u0439
      \u043F\u043E\u043B\u043E\u0441\u044B, \u0433\u0434\u0435 \u043A\u043E\u0437\u043B\u044B
      \u0445\u043E\u0434\u044F\u0442 \u0437\u0430 \u0441\u043E\u043B\u044C\u044E.
      \u0417\u0430\u0441\u0430\u0434\u0430 \u0431\u044B\u043B\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0439:
      \u0434\u0432\u0430 \u043A\u043E\u0437\u043B\u0430, \u0434\u043E\u0431\u044B\u0442\u044B\u0445
      \u0447\u0438\u0441\u0442\u043E. \u0428\u043A\u0443\u0440\u044B, \u043C\u044F\u0441\u043E,
      \u0440\u043E\u0433\u0430 - \u0432\u0441\u0451 \u043F\u043E\u0439\u0434\u0451\u0442
      \u0432 \u0434\u0435\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378503
    m_Localized: "\u041B\u0435\u0434\u044F\u043D\u043E\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378504
    m_Localized: "\u0418\u0437-\u043F\u043E\u0434 \u043D\u0430\u0432\u0438\u0441\u0448\u0435\u0433\u043E
      \u043A\u0430\u043C\u043D\u044F \u0432\u044B\u0442\u0435\u043A\u0430\u0435\u0442
      \u0442\u043E\u043D\u043A\u0430\u044F \u0441\u0442\u0440\u0443\u0439\u043A\u0430:
      \u043B\u0435\u0434\u044F\u043D\u0430\u044F \u0432\u043E\u0434\u0430, \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u0430\u044F
      \u043A\u0430\u043A \u0441\u0442\u0435\u043A\u043B\u043E, \u043F\u0430\u0445\u043D\u0435\u0442
      \u0441\u043D\u0435\u0433\u043E\u043C \u0438 \u043A\u0430\u043C\u043D\u0435\u043C.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u043F\u043E\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u043B\u0430\u0434\u043E\u043D\u044C. \"\u0425\u043E\u0440\u043E\u0448\u0430\u044F
      \u0432\u043E\u0434\u0430\". \u0420\u044F\u0434\u043E\u043C \u043C\u043E\u0445
      \u0438 \u043C\u0435\u043B\u043A\u0438\u0435 \u0433\u043E\u0440\u043D\u044B\u0435
      \u0446\u0432\u0435\u0442\u044B. \u0422\u043E\u043B\u044C\u043A\u043E \u043A\u0430\u043C\u0435\u043D\u044C
      \u043D\u0430\u0434 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u043C
      \u0432\u0438\u0441\u0438\u0442 \u043D\u0435\u0440\u043E\u0432\u043D\u043E,
      \u0438 \u0441 \u0443\u0442\u0440\u0435\u043D\u043D\u0438\u043C \u043E\u0442\u0442\u0435\u043F\u0435\u043B\u044C\u044E
      \u043E\u043D \u043C\u043E\u0433 \u0441\u0434\u0432\u0438\u043D\u0443\u0442\u044C\u0441\u044F.
      \u041D\u0430\u0431\u0438\u0440\u0430\u0442\u044C \u0438\u043B\u0438 \u043E\u0431\u043E\u0439\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378505
    m_Localized: "\u041D\u0430\u0431\u0440\u0430\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0438 \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378506
    m_Localized: "\u041D\u0430\u0431\u0440\u0430\u043B\u0438 \u0442\u0440\u0438 \u0431\u0443\u0440\u0434\u044E\u043A\u0430
      \u0431\u044B\u0441\u0442\u0440\u043E, \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F\u0441\u044C.
      \u0412\u043E\u0434\u0430 \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F,
      \u0447\u0438\u0441\u0442\u0430\u044F. \u0413\u043E\u0440\u043D\u044B\u0435
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0438 \u0440\u0435\u0434\u043A\u043E
      \u043E\u0431\u043C\u0430\u043D\u044B\u0432\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378507
    m_Localized: "\u0420\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
      \u0438 \u043D\u0430\u0431\u0440\u0430\u0442\u044C \u043F\u043E\u043B\u043D\u044B\u0435
      \u0437\u0430\u043F\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378508
    m_Localized: "\u0420\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u043B\u0438 \u043A\u0430\u043C\u043D\u0438
      \u0432\u043E\u043A\u0440\u0443\u0433, \u043F\u043E\u0442\u043E\u043A \u0441\u0442\u0430\u043B
      \u0448\u0438\u0440\u0435. \u041D\u0430\u0431\u0440\u0430\u043B\u0438 \u0432\u0441\u0435
      \u0431\u0443\u0440\u0434\u044E\u043A\u0438 \u0434\u043E \u043E\u0442\u043A\u0430\u0437\u0430.
      \u0412\u043E\u0434\u0430 \u043B\u0435\u0434\u044F\u043D\u0430\u044F, \u043B\u0430\u0433\u0435\u0440\u044C
      \u043F\u044C\u0451\u0442 \u0441 \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435\u043C.
      \u0417\u0430\u043F\u0430\u0441\u0430 \u0445\u0432\u0430\u0442\u0438\u0442 \u043D\u0430
      \u0434\u0432\u0430 \u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378509
    m_Localized: "\u041F\u0440\u0438 \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u043A\u0435
      \u043F\u043E\u0442\u0440\u0435\u0432\u043E\u0436\u0438\u043B\u0438 \u043A\u0430\u043C\u0435\u043D\u044C.
      \u041E\u043D \u0441\u043F\u043E\u043B\u0437 \u0438 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u043B
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443.
      \u041D\u0430\u0431\u0440\u0430\u043B\u0438 \u043C\u0435\u043D\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0445\u043E\u0442\u0435\u043B\u0438, \u0438 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B\u0438
      \u0447\u0430\u0441 \u043D\u0430 \u043F\u0443\u0441\u0442\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378510
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442
      \u0432\u043E\u0434\u0443 \u043D\u0430 \u043F\u0440\u0438\u0433\u043E\u0434\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378511
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u043F\u0443\u0441\u0442\u0438\u043B
      \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u0443\u044E \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u043A\u0443
      \u0432 \u0432\u043E\u0434\u0443 \u0438 \u043F\u043E\u043D\u0430\u0431\u043B\u044E\u0434\u0430\u043B.
      \"\u0427\u0438\u0441\u0442\u0430\u044F. \u041D\u0438 \u0438\u043B\u0430, \u043D\u0438
      \u044F\u0434\u0430. \u0418 \u0435\u0449\u0451: \u043C\u043E\u0445 \u0443 \u043A\u0440\u0430\u044F
      - \u043E\u0447\u0438\u0449\u0430\u0435\u0442 \u0436\u0435\u043B\u0443\u0434\u043E\u043A.
      \u0417\u0430\u0432\u0430\u0440\u0438\u0442\u0435 \u0449\u0435\u043F\u043E\u0442\u044C\".
      \u041D\u0430\u0431\u0440\u0430\u043B\u0438 \u0432\u043E\u0434\u044B \u0438
      \u043C\u0445\u0430. \u041B\u0430\u0433\u0435\u0440\u044C \u0437\u0434\u043E\u0440\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378512
    m_Localized: "\u041D\u043E\u0447\u044C \u0432 \u044E\u0440\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378513
    m_Localized: "\u0412\u043E\u0439\u043B\u043E\u0447\u043D\u0430\u044F \u044E\u0440\u0442\u0430
      \u0441\u0442\u043E\u0438\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
      \u043E\u0442 \u0434\u043E\u0440\u043E\u0433\u0438, \u0443 \u043D\u0435\u0451
      \u0442\u0435\u043F\u043B\u0438\u0442\u0441\u044F \u043E\u0447\u0430\u0433.
      \u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442
      \u0438\u0437 \u043F\u043E\u043B\u043E\u0433\u0430, \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0431\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0430. \u041A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0438
      \u0441\u0442\u0435\u043F\u0435\u0439 \u043F\u0440\u0438\u0432\u044B\u043A\u043B\u0438
      \u043A \u0447\u0443\u0436\u0430\u043A\u0430\u043C \u043D\u0430 \u0442\u0440\u0430\u043A\u0442\u0435,
      \u043D\u043E \u0433\u043E\u0441\u0442\u0435\u043F\u0440\u0438\u0438\u043C\u0441\u0442\u0432\u043E
      \u0443 \u043D\u0438\u0445 \u0443\u0441\u043B\u043E\u0432\u043D\u043E\u0435:
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0434\u043E \u0437\u043D\u0430\u0442\u044C
      \u043F\u0440\u0430\u0432\u0438\u043B\u0430. \u0417\u0430\u043F\u0430\u0445
      \u0434\u044B\u043C\u043D\u043E\u0433\u043E \u043E\u0447\u0430\u0433\u0430 \u0438
      \u0432\u0430\u0440\u0451\u043D\u043E\u0439 \u0431\u0430\u0440\u0430\u043D\u0438\u043D\u044B
      \u0449\u0435\u043A\u043E\u0447\u0435\u0442 \u043D\u043E\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378514
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0443 \u044E\u0440\u0442\u044B \u043D\u0430 \u043D\u043E\u0447\u043B\u0435\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378515
    m_Localized: "\u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430
      \u043F\u0438\u0430\u043B\u0443 \u0441 \u043A\u0443\u043C\u044B\u0441\u043E\u043C
      \u0438 \u043E\u0442\u0440\u0435\u0437\u0430\u043B\u0430 \u043E\u0442 \u0432\u0430\u0440\u0451\u043D\u043E\u0433\u043E
      \u0431\u043E\u043A\u0430. \u0415\u043B\u0438 \u043C\u043E\u043B\u0447\u0430,
      \u043F\u043E-\u0445\u043E\u0440\u043E\u0448\u0435\u043C\u0443. \u0423\u0442\u0440\u043E\u043C
      \u043B\u044E\u0434\u0438 \u0432\u0441\u0442\u0430\u043B\u0438 \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0432\u0448\u0438\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378516
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0432\u0435\u0447\u0435\u0440
      \u0432 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0435 \u0441 \u0445\u043E\u0437\u044F\u0438\u043D\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378517
    m_Localized: "\u0425\u043E\u0437\u044F\u0438\u043D \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0441\u043B\u043E\u0432\u043E\u043E\u0445\u043E\u0442\u043B\u0438\u0432\u044B\u043C:
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B \u043E \u0434\u043E\u0440\u043E\u0433\u0430\u0445
      \u043A \u0441\u0435\u0432\u0435\u0440\u0443, \u043E \u0442\u043E\u043C, \u0433\u0434\u0435
      \u0441\u0442\u0435\u043F\u043D\u044B\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
      \u043D\u044B\u043D\u0447\u0435 \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u044F\u044E\u0442,
      \u0430 \u0433\u0434\u0435 \u043D\u0435\u0442. \u0412\u0435\u0447\u0435\u0440
      \u043F\u0440\u043E\u0448\u0451\u043B \u0443 \u043E\u0433\u043D\u044F \u0441
      \u0447\u0430\u0435\u043C \u0438 \u0446\u0435\u043D\u043D\u044B\u043C\u0438
      \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378518
    m_Localized: "\u0425\u043E\u0437\u044F\u0438\u043D \u043F\u0440\u0438\u043D\u044F\u043B
      \u0433\u043E\u0441\u0442\u0435\u043F\u0440\u0438\u0438\u043C\u043D\u043E, \u043D\u043E
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u043D\u0435 \u0432\u044B\u0448\u0435\u043B:
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0440\u0430\u0437\u043D\u044B\u0435
      \u043D\u0430\u0440\u0435\u0447\u0438\u044F, \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043C\u0430\u043B\u043E \u043E\u0431\u0449\u0438\u0445 \u0441\u043B\u043E\u0432.
      \u041F\u0435\u0440\u0435\u043D\u043E\u0447\u0435\u0432\u0430\u043B\u0438 \u0442\u0435\u043F\u043B\u043E,
      \u043D\u043E \u0443\u0435\u0445\u0430\u043B\u0438 \u0431\u0435\u0437 \u043D\u043E\u0432\u043E\u0441\u0442\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378519
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043D\u0430 \u043C\u0435\u0441\u0442\u043D\u043E\u043C \u043D\u0430\u0440\u0435\u0447\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378520
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0441 \u0445\u043E\u0437\u044F\u0438\u043D\u043E\u043C \u043D\u0430 \u0435\u0433\u043E
      \u044F\u0437\u044B\u043A\u0435, \u0438 \u0442\u043E\u0442 \u0440\u0430\u0441\u0446\u0432\u0451\u043B.
      \u0412\u0435\u0447\u0435\u0440 \u0437\u0430\u0442\u044F\u043D\u0443\u043B\u0441\u044F:
      \u043F\u0435\u0441\u043D\u0438, \u0431\u0430\u0439\u043A\u0438 \u043E \u0441\u0442\u0435\u043F\u043D\u044B\u0445
      \u0434\u0443\u0445\u0430\u0445 \u0438 \u043F\u043E\u0434\u0430\u0440\u043E\u043A
      \u043D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435 - \u0441\u0443\u0448\u0451\u043D\u043E\u0435
      \u043C\u044F\u0441\u043E \u0432 \u043A\u043E\u0436\u0430\u043D\u043E\u043C
      \u043C\u0435\u0448\u043A\u0435. \"\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F,
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446.\""
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378521
    m_Localized: "\u041F\u0435\u0441\u043D\u044F \u043F\u0430\u0441\u0442\u0443\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378522
    m_Localized: "\u041E\u0442\u043A\u0443\u0434\u0430-\u0442\u043E \u0438\u0437
      \u0442\u0435\u043C\u043D\u043E\u0442\u044B \u0437\u0430 \u043E\u0433\u043D\u0451\u043C
      \u0442\u044F\u043D\u0435\u0442\u0441\u044F \u0433\u043E\u043B\u043E\u0441:
      \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439, \u0440\u043E\u0432\u043D\u044B\u0439,
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0433\u043D\u0443\u0441\u0430\u0432\u044B\u0439.
      \u041F\u0430\u0441\u0442\u0443\u0445 \u0441\u0438\u0434\u0438\u0442 \u0432
      \u0441\u0442\u043E\u0440\u043E\u043D\u0435, \u043E\u0431\u0445\u0432\u0430\u0442\u0438\u0432
      \u043A\u043E\u043B\u0435\u043D\u0438 \u0440\u0443\u043A\u0430\u043C\u0438,
      \u0438 \u043F\u043E\u0451\u0442 - \u043D\u0435 \u0434\u043B\u044F \u0432\u0430\u0441,
      \u0430 \u0434\u043B\u044F \u0441\u0442\u0435\u043F\u0438. \u041C\u0435\u043B\u043E\u0434\u0438\u044F
      \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0430\u044F, \u0441\u043B\u043E\u0432\u0430
      \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0435, \u043D\u043E
      \u0447\u0442\u043E-\u0442\u043E \u0432 \u043D\u0435\u0439 \u0441\u043D\u0438\u043C\u0430\u0435\u0442
      \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C, \u043A\u0430\u043A
      \u0441\u043D\u0438\u043C\u0430\u044E\u0442 \u0442\u044F\u0436\u0451\u043B\u044B\u0439
      \u0433\u0440\u0443\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378523
    m_Localized: "\u0421\u043B\u0443\u0448\u0430\u0442\u044C \u043C\u043E\u043B\u0447\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378524
    m_Localized: "\u0421\u0438\u0434\u0435\u043B\u0438 \u0438 \u0441\u043B\u0443\u0448\u0430\u043B\u0438.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B. \u041A \u043A\u043E\u043D\u0446\u0443
      \u043F\u0435\u0441\u043D\u0438 \u043B\u0430\u0433\u0435\u0440\u044C \u0441\u0442\u0430\u043B
      \u0434\u0440\u0443\u0433\u0438\u043C: \u0442\u0438\u0448\u0435, \u043B\u0435\u0433\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378525
    m_Localized: "\u041F\u043E\u0434\u043F\u0435\u0442\u044C \u0438\u043B\u0438 \u0445\u043B\u043E\u043F\u0430\u0442\u044C
      \u0432 \u043B\u0430\u0434\u043E\u0448\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378526
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u043D\u0430\u0447\u0430\u043B \u0445\u043B\u043E\u043F\u0430\u0442\u044C,
      \u0434\u0440\u0443\u0433\u043E\u0439 \u043F\u043E\u0434\u0445\u0432\u0430\u0442\u0438\u043B
      \u043C\u0435\u043B\u043E\u0434\u0438\u044E \u043D\u0430 \u0444\u043B\u0435\u0439\u0442\u0435.
      \u041F\u0430\u0441\u0442\u0443\u0445 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u0443\u0434\u0438\u0432\u043B\u0451\u043D\u043D\u043E, \u043F\u043E\u0442\u043E\u043C
      \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F \u0438 \u0437\u0430\u0438\u0433\u0440\u0430\u043B
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435. \u041B\u0430\u0433\u0435\u0440\u044C
      \u043F\u043B\u044F\u0441\u0430\u043B \u0434\u043E \u043F\u043E\u043B\u0443\u043D\u043E\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378527
    m_Localized: "\u041A\u0442\u043E-\u0442\u043E \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0441\u044F
      \u043F\u043E\u0434\u043F\u0435\u0442\u044C, \u043D\u043E \u043F\u043E\u043F\u0430\u043B
      \u043D\u0435 \u0432 \u043B\u0430\u0434. \u041F\u0430\u0441\u0442\u0443\u0445
      \u0437\u0430\u043C\u043E\u043B\u0447\u0430\u043B, \u0432\u0441\u0442\u0430\u043B
      \u0438 \u0443\u0448\u0451\u043B \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0443.
      \u0412\u0435\u0447\u0435\u0440 \u0441\u043A\u043E\u043C\u043A\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378528
    m_Localized: "\u0411\u044B\u0432\u0430\u043B\u044B\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0437\u043D\u0430\u0435\u0442 \u0441\u0442\u0435\u043F\u043D\u044B\u0435 \u043E\u0431\u044B\u0447\u0430\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378529
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0434\u043E\u0441\u0442\u0430\u043B
      \u0431\u0443\u0440\u0434\u044E\u043A \u0441 \u043A\u0443\u043C\u044B\u0441\u043E\u043C,
      \u043D\u0430\u043B\u0438\u043B \u0438 \u043F\u043E\u0434\u043D\u0451\u0441
      \u043F\u0430\u0441\u0442\u0443\u0445\u0443 \u043C\u043E\u043B\u0447\u0430,
      \u0434\u0432\u0443\u043C\u044F \u0440\u0443\u043A\u0430\u043C\u0438. \u0422\u043E\u0442
      \u043F\u0440\u0438\u043D\u044F\u043B, \u043A\u0438\u0432\u043D\u0443\u043B.
      \u0422\u0430\u043A \u043E\u043D\u0438 \u043F\u0440\u043E\u0441\u0438\u0434\u0435\u043B\u0438
      \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430: \u043E\u0434\u0438\u043D
      \u043F\u0435\u043B, \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u043B\u0443\u0448\u0430\u043B,
      \u0438 \u0441 \u043A\u0430\u0436\u0434\u043E\u0439 \u043F\u0435\u0441\u043D\u0435\u0439
      \u0432 \u043B\u0430\u0433\u0435\u0440\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u043E\u0441\u044C
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572736
    m_Localized: "\u041D\u043E\u0447\u043D\u043E\u0439 \u0434\u043E\u0436\u0434\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572737
    m_Localized: "\u0414\u043E\u0436\u0434\u044C \u043F\u0440\u0438\u0448\u0451\u043B
      \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F:
      \u0442\u0451\u043F\u043B\u044B\u0439, \u043C\u0435\u043B\u043A\u0438\u0439,
      \u043F\u0430\u0445\u043D\u0443\u0449\u0438\u0439 \u043F\u043E\u043B\u044B\u043D\u044C\u044E
      \u0438 \u043C\u043E\u043A\u0440\u043E\u0439 \u0437\u0435\u043C\u043B\u0451\u0439.
      \u0421\u0442\u0435\u043F\u044C \u0437\u0430\u0448\u0438\u043F\u0435\u043B\u0430,
      \u043A\u043E\u0441\u0442\u0451\u0440 \u0437\u0430\u0447\u0430\u0434\u0438\u043B.
      \u041B\u044E\u0434\u0438 \u0437\u0430\u0448\u0435\u0432\u0435\u043B\u0438\u043B\u0438\u0441\u044C:
      \u043A\u0442\u043E \u043D\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u043F\u043E\u043B\u043E\u0433, \u043A\u0442\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442
      \u0442\u044E\u043A\u0438. \u0414\u043E\u0436\u0434\u044C \u0432 \u0441\u0442\u0435\u043F\u0438
      \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0434\u043E\u0431\u0440\u044B\u043C
      \u0433\u043E\u0441\u0442\u0435\u043C, \u0430 \u043C\u043E\u0436\u0435\u0442
      - \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u0442\u044C \u0432\u0441\u0451,
      \u0447\u0442\u043E \u043D\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572738
    m_Localized: "\u0423\u043A\u0440\u044B\u0442\u044C \u0442\u043E\u0432\u0430\u0440
      \u0438 \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572739
    m_Localized: "\u0422\u044E\u043A\u0438 \u0443\u043A\u0440\u044B\u043B\u0438 \u0432\u043E\u0439\u043B\u043E\u043A\u043E\u043C,
      \u043B\u044E\u0434\u0438 \u0437\u0430\u0431\u0440\u0430\u043B\u0438\u0441\u044C
      \u043F\u043E\u0434 \u043F\u043E\u0432\u043E\u0437\u043A\u0438. \u0414\u043E\u0436\u0434\u044C
      \u043F\u0440\u043E\u0448\u0451\u043B \u0437\u0430 \u0447\u0430\u0441. \u041D\u0430\u0443\u0442\u0440\u043E
      \u0442\u0440\u0430\u0432\u0430 \u0431\u043B\u0435\u0441\u0442\u0435\u043B\u0430
      \u0438 \u0432\u043E\u0437\u0434\u0443\u0445 \u0431\u044B\u043B \u0447\u0438\u0441\u0442\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572740
    m_Localized: "\u0420\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u043E\u0441\u0443\u0434\u0443
      \u0434\u043B\u044F \u0441\u0431\u043E\u0440\u0430 \u0432\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572741
    m_Localized: "\u0420\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0432\u0441\u0435
      \u043A\u043E\u0442\u043B\u044B \u0438 \u0431\u0443\u0440\u0434\u044E\u043A\u0438.
      \u041A \u0443\u0442\u0440\u0443 \u043D\u0430\u0431\u0440\u0430\u043B\u0438
      \u0434\u0432\u0430 \u0434\u043D\u044F \u0437\u0430\u043F\u0430\u0441\u0430
      \u0432\u043E\u0434\u044B. \u0414\u043E\u0436\u0434\u044C \u0442\u0451\u043F\u043B\u044B\u0439,
      \u0432\u043E\u0434\u0430 \u043C\u044F\u0433\u043A\u0430\u044F. \u0417\u0430\u0434\u0430\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572742
    m_Localized: "\u041F\u043E\u043A\u0430 \u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u043F\u043E\u0441\u0443\u0434\u0443, \u0437\u0430\u0431\u044B\u043B\u0438
      \u043E \u0442\u044E\u043A\u0430\u0445. \u0427\u0430\u0441\u0442\u044C \u0442\u043E\u0432\u0430\u0440\u0430
      \u043F\u0440\u043E\u043C\u043E\u043A\u043B\u0430. \u0423\u0442\u0440\u043E\u043C
      \u0441\u0443\u0448\u0438\u043B\u0438 \u043D\u0430 \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u0445
      \u0438 \u0440\u0443\u0433\u0430\u043B\u0438\u0441\u044C \u0442\u0438\u0445\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572743
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0437\u0430\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0434\u043E\u0436\u0434\u0435\u0432\u0443\u044E \u0432\u043E\u0434\u0443 \u0438
      \u0442\u0440\u0430\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572744
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0432\u044B\u0448\u0435\u043B
      \u043F\u043E\u0434 \u0434\u043E\u0436\u0434\u044C \u0441 \u0441\u0443\u043C\u043A\u043E\u0439
      \u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043C\u043E\u043A\u0440\u044B\u043C,
      \u043D\u043E \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u043C: \u043D\u0430\u0431\u0440\u0430\u043B
      \u043C\u044F\u0433\u043A\u043E\u0439 \u0432\u043E\u0434\u044B, \u043D\u0430\u0440\u0432\u0430\u043B
      \u043C\u043E\u043A\u0440\u043E\u0439 \u043F\u043E\u043B\u044B\u043D\u0438 \u0438
      \u043B\u0438\u0441\u0442\u044C\u0435\u0432 \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u0438\u043A\u0430.
      \"\u0414\u043E\u0436\u0434\u044C \u0432 \u0441\u0442\u0435\u043F\u0438 - \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430
      \u0430\u043F\u0442\u0435\u043A\u0438.\" \u0417\u0430\u043F\u0430\u0441\u044B
      \u0432\u043E\u0434\u044B \u0438 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432
      \u043F\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572745
    m_Localized: "\u041F\u0440\u043E\u0445\u043B\u0430\u0434\u0430 \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u043E\u0439
      \u043D\u043E\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572746
    m_Localized: "\u0421\u043E\u043B\u043D\u0446\u0435 \u0443\u0448\u043B\u043E,
      \u0438 \u043F\u0443\u0441\u0442\u044B\u043D\u044F \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B\u0430.
      \u041F\u0435\u0441\u043E\u043A \u0435\u0449\u0451 \u0442\u0451\u043F\u043B\u044B\u0439
      \u043F\u043E\u0434 \u043B\u0430\u0434\u043E\u043D\u044C\u044E, \u043D\u043E
      \u0432\u043E\u0437\u0434\u0443\u0445 \u0443\u0436\u0435 \u043F\u0430\u0445\u043D\u0435\u0442
      \u0445\u043E\u043B\u043E\u0434\u043E\u043C \u0438 \u0437\u0432\u0451\u0437\u0434\u0430\u043C\u0438.
      \u041F\u043E\u0441\u043B\u0435 \u0434\u043D\u0435\u0432\u043D\u043E\u0433\u043E
      \u043F\u0435\u043A\u043B\u0430 \u043D\u043E\u0447\u044C \u0437\u0434\u0435\u0441\u044C
      - \u043A\u0430\u043A \u043D\u0430\u0433\u0440\u0430\u0434\u0430. \u041B\u044E\u0434\u0438
      \u0440\u0430\u0437\u043B\u0435\u0433\u043B\u0438\u0441\u044C \u043D\u0430 \u043A\u043E\u0448\u043C\u0430\u0445,
      \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u0432 \u043D\u0435\u0431\u043E.
      \u041C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C,
      \u0430 \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u0443, \u043F\u043E\u043A\u0430
      \u043E\u043D\u0430 \u043D\u0435 \u0443\u0448\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572747
    m_Localized: "\u041F\u043E\u0441\u043F\u0430\u0442\u044C \u0432\u0441\u0435\u043C
      \u0438 \u043D\u0430\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0441\u0438\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572748
    m_Localized: "\u041B\u0430\u0433\u0435\u0440\u044C \u0437\u0430\u0442\u0438\u0445
      \u0440\u0430\u043D\u043E. \u0423\u0442\u0440\u043E\u043C \u0432\u0441\u0442\u0430\u043B\u0438
      \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0432\u0448\u0438\u043C\u0438: \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u0430\u044F
      \u043D\u043E\u0447\u044C \u0432\u0435\u0440\u043D\u0443\u043B\u0430 \u0441\u0438\u043B\u044B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0434\u0435\u043D\u044C \u0437\u0430\u0431\u0440\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572749
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0432\u0435\u0447\u0435\u0440
      \u0437\u0430 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u043E\u043C \u0438
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0434\u0443\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572750
    m_Localized: "\u0412\u044B \u0441\u043E\u0431\u0440\u0430\u043B\u0438 \u043B\u044E\u0434\u0435\u0439
      \u0443 \u0443\u0433\u0430\u0441\u0430\u044E\u0449\u0435\u0433\u043E \u043E\u0433\u043D\u044F.
      \u0413\u043E\u0432\u043E\u0440\u0438\u043B\u0438 \u043E \u041C\u0435\u0440\u0432\u0435,
      \u043E \u0446\u0435\u043D\u0430\u0445 \u043D\u0430 \u0448\u0451\u043B\u043A
      \u0432 \u0411\u0430\u0433\u0434\u0430\u0434\u0435, \u043E \u0441\u0435\u043C\u044C\u044F\u0445
      \u0434\u043E\u043C\u0430. \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0437\u0430\u0441\u043D\u0443\u043B.
      \u041A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443 \u043B\u0430\u0433\u0435\u0440\u044C
      \u0431\u044B\u043B \u043E\u0434\u043D\u0438\u043C \u0442\u0435\u043B\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572751
    m_Localized: "\u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u043D\u0435 \u043F\u043E\u0448\u0451\u043B:
      \u043B\u044E\u0434\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0443\u0441\u0442\u0430\u043B\u0438,
      \u0447\u0442\u043E\u0431\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C,
      \u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043D\u0435\u0440\u0432\u043D\u0438\u0447\u0430\u043B\u0438,
      \u0447\u0442\u043E\u0431\u044B \u043C\u043E\u043B\u0447\u0430\u0442\u044C.
      \u0420\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C \u043F\u043E \u043C\u0435\u0441\u0442\u0430\u043C
      \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0451\u043D\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572752
    m_Localized: "\u0425\u0430\u0440\u0438\u0437\u043C\u0430\u0442\u0438\u0447\u043D\u044B\u0439
      \u043A\u0443\u043F\u0435\u0446 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0434\u0443\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572753
    m_Localized: "\u0412\u044B \u0432\u0441\u0442\u0430\u043B\u0438 \u0443 \u043E\u0433\u043D\u044F
      \u0438 \u0441\u043A\u0430\u0437\u0430\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E:
      \"\u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043D\u0430 \u043D\u0435\u0431\u043E.
      \u0412\u043E\u0442 \u0437\u0432\u0435\u0437\u0434\u0430 \u0421\u0443\u0445\u0430\u0439\u043B
      - \u043E\u043D\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u043A \u044E\u0433\u0443.
      \u041F\u043E\u043A\u0430 \u043E\u043D\u0430 \u0441\u0432\u0435\u0442\u0438\u0442,
      \u043C\u044B \u0437\u043D\u0430\u0435\u043C, \u043A\u0443\u0434\u0430 \u0438\u0434\u0451\u043C.\"
      \u041C\u043E\u043B\u0447\u0430\u043D\u0438\u0435. \u041F\u043E\u0442\u043E\u043C
      \u043A\u0442\u043E-\u0442\u043E \u0442\u0438\u0445\u043E \u043F\u0440\u043E\u0438\u0437\u043D\u0451\u0441:
      \"\u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u0445\u043E\u0437\u044F\u0438\u043D.\"
      \u0418 \u044D\u0442\u043E\u0433\u043E \u0445\u0432\u0430\u0442\u0438\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572754
    m_Localized: "\u041C\u043E\u043B\u0438\u0442\u0432\u0430 \u043F\u043E\u0434 \u0437\u0432\u0451\u0437\u0434\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572755
    m_Localized: "\u041F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0440\u0430\u0441\u0441\u0442\u0435\u043B\u0438\u043B \u043A\u043E\u0432\u0440\u0438\u043A
      \u043B\u0438\u0446\u043E\u043C \u043D\u0430 \u044E\u0433\u043E-\u0437\u0430\u043F\u0430\u0434,
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u041C\u0435\u043A\u043A\u0438,
      \u043F\u043E\u0434\u043D\u044F\u043B \u043B\u0430\u0434\u043E\u043D\u0438.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044E\u0442
      - \u043A\u0442\u043E \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C,
      \u043A\u0442\u043E \u0441 \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u0441\u0442\u0432\u043E\u043C.
      \u0417\u0432\u0451\u0437\u0434\u043D\u043E\u0435 \u043D\u0435\u0431\u043E \u043D\u0430\u0434
      \u043F\u0443\u0441\u0442\u044B\u043D\u0435\u0439 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E\u0435:
      \u043D\u0438 \u0442\u0443\u0447, \u043D\u0438 \u0434\u044B\u043C\u0430. \u0415\u0433\u043E
      \u043C\u043E\u043B\u0438\u0442\u0432\u0430 \u0432 \u0442\u0438\u0448\u0438\u043D\u0435
      \u0437\u0432\u0443\u0447\u0438\u0442 \u043A\u0430\u043A \u0447\u0430\u0441\u0442\u044C
      \u044D\u0442\u043E\u0433\u043E \u043D\u0435\u0431\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572756
    m_Localized: "\u0414\u0430\u0442\u044C \u043C\u043E\u043B\u0438\u0442\u044C\u0441\u044F
      \u0438 \u043E\u0442\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572757
    m_Localized: "\u041B\u0430\u0433\u0435\u0440\u044C \u043F\u0440\u0438\u0442\u0438\u0445.
      \u041A\u043E\u0433\u0434\u0430 \u043C\u043E\u043B\u0438\u0442\u0432\u0430 \u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C,
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0441\u0432\u0435\u0440\u043D\u0443\u043B
      \u043A\u043E\u0432\u0440\u0438\u043A \u0438 \u0441\u0435\u043B \u0443 \u043E\u0433\u043D\u044F
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u043C. \u0423\u0432\u0430\u0436\u0435\u043D\u0438\u0435
      \u0441\u0442\u043E\u0438\u0442 \u043C\u0430\u043B\u043E \u0438 \u0434\u0430\u0451\u0442
      \u043C\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572758
    m_Localized: "\u041F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F
      \u0438 \u043F\u043E\u0434\u043D\u044F\u0442\u044C \u0434\u0443\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572759
    m_Localized: "\u0412\u044B \u0432\u0441\u0442\u0430\u043B\u0438 \u0440\u044F\u0434\u043E\u043C
      - \u043D\u0435 \u043C\u043E\u043B\u044F\u0441\u044C, \u043D\u043E \u0441\u0442\u043E\u044F.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0437\u0430\u043C\u0435\u0442\u0438\u043B
      \u0438 \u043F\u043E\u0441\u043B\u0435 \u043C\u043E\u043B\u0438\u0442\u0432\u044B
      \u043A\u0438\u0432\u043D\u0443\u043B. \"\u0425\u043E\u0437\u044F\u0438\u043D
      \u0443\u0432\u0430\u0436\u0430\u0435\u0442 \u043F\u0443\u0442\u044C.\" \u042D\u0442\u043E
      \u0440\u0430\u0437\u043E\u0448\u043B\u043E\u0441\u044C \u043F\u043E \u043B\u0430\u0433\u0435\u0440\u044E
      \u0431\u044B\u0441\u0442\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572760
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u043A\u0430 \u043F\u0440\u043E\u0438\u0437\u043D\u0435\u0441\u0442\u0438
      \u0441\u043B\u043E\u0432\u0430 \u043C\u043E\u043B\u0438\u0442\u0432\u044B \u0432\u044B\u0448\u043B\u0430
      \u043D\u0435\u043B\u043E\u0432\u043A\u043E\u0439. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043F\u043E\u043C\u043E\u0440\u0449\u0438\u043B\u0441\u044F, \u043D\u043E
      \u043F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u043B. \u041D\u0435\u043B\u043E\u0432\u043A\u043E\u0441\u0442\u044C
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572761
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442
      \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u043C\u043E\u043B\u0438\u0442\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572762
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0442\u0438\u0445\u043E
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C:
      \u043E\u0431 \u043E\u0431\u0440\u044F\u0434\u0435, \u043E \u0442\u043E\u043C,
      \u0447\u0442\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0436\u0435\u0441\u0442. \u041B\u044E\u0434\u0438 \u0441\u043B\u0443\u0448\u0430\u043B\u0438
      \u0431\u0435\u0437 \u0443\u0441\u043C\u0435\u0448\u0435\u043A. \"\u0425\u043E\u0440\u043E\u0448\u043E,
      \u0447\u0442\u043E \u0437\u043D\u0430\u0435\u043C\", - \u0441\u043A\u0430\u0437\u0430\u043B
      \u043A\u0442\u043E-\u0442\u043E. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
      \u0434\u043D\u0438 \u0432 \u043F\u0443\u0442\u0438 \u043F\u0440\u043E\u0448\u043B\u0438
      \u0431\u0435\u0437 \u0441\u0441\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572763
    m_Localized: "\u041B\u0435\u0433\u0435\u043D\u0434\u0430 \u043E \u043F\u0443\u0441\u0442\u044B\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572764
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A-\u0431\u0435\u0434\u0443\u0438\u043D
      \u0441\u0438\u0434\u0438\u0442 \u0447\u0443\u0442\u044C \u043F\u043E\u043E\u0434\u0430\u043B\u044C,
      \u043F\u043E\u0434\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442 \u0449\u0435\u043F\u043A\u0443
      \u0432 \u043E\u0433\u043E\u043D\u044C. \u041F\u043E\u0442\u043E\u043C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u0443: \"\u0421\u043B\u044B\u0448\u0430\u043B\u0438
      \u043F\u0440\u043E \u0412\u0430\u0431\u0431\u0430\u0440?\" \u041D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0441\u043B\u044B\u0448\u0430\u043B. \u041E\u043D \u0443\u0441\u043C\u0435\u0445\u0430\u0435\u0442\u0441\u044F.
      \u041B\u0435\u0433\u0435\u043D\u0434\u044B \u0443 \u0442\u0430\u043A\u0438\u0445
      \u043B\u044E\u0434\u0435\u0439 \u043D\u0435 \u0434\u043B\u044F \u043D\u043E\u0447\u043D\u044B\u0445
      \u0441\u0442\u0440\u0430\u0445\u043E\u0432: \u043E\u043D\u0438 \u0434\u043B\u044F
      \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u0437\u043D\u0430\u0442\u044C,
      \u0433\u0434\u0435 \u043D\u0435\u043B\u044C\u0437\u044F \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572765
    m_Localized: "\u0421\u043B\u0443\u0448\u0430\u0442\u044C \u043C\u043E\u043B\u0447\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572766
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B
      \u043D\u0435\u0442\u043E\u0440\u043E\u043F\u043B\u0438\u0432\u043E: \u043E
      \u0441\u0442\u0435\u043A\u043B\u044F\u043D\u043D\u044B\u0445 \u0434\u044E\u043D\u0430\u0445
      \u0412\u0430\u0431\u0431\u0430\u0440\u0430, \u043E \u0433\u043E\u0440\u043E\u0434\u0435,
      \u0441\u043E\u0436\u0436\u0451\u043D\u043D\u043E\u043C \u043D\u0435\u0431\u0435\u0441\u043D\u044B\u043C
      \u043E\u0433\u043D\u0451\u043C. \u041D\u0438\u043A\u0442\u043E \u043D\u0435
      \u0437\u0430\u0441\u043D\u0443\u043B \u0440\u0430\u043D\u044C\u0448\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438.
      \u041D\u043E \u0441\u0442\u0440\u0430\u0445\u0430 \u043D\u0435 \u0431\u044B\u043B\u043E:
      \u0442\u043E\u043B\u044C\u043A\u043E \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572767
    m_Localized: "\u0420\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C
      \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435 \u043E \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572768
    m_Localized: "\u0412\u044B \u0441\u043F\u0440\u043E\u0441\u0438\u043B\u0438:
      \"\u0410 \u0433\u0434\u0435 \u043D\u0435\u043B\u044C\u0437\u044F \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043D\u043E\u0447\u044C?\" \u0421\u0442\u0430\u0440\u0438\u043A
      \u043E\u0436\u0438\u0432\u0438\u043B\u0441\u044F. \u0420\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B
      \u0447\u0430\u0441. \u0417\u0430\u043F\u0438\u0441\u0430\u043B\u0438 \u043C\u044B\u0441\u043B\u0435\u043D\u043D\u043E:
      \u0442\u0440\u0438 \u043C\u0435\u0441\u0442\u0430 \u043E\u0431\u043E\u0439\u0442\u0438
      \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439, \u043E\u0434\u043D\u043E
      \u0445\u043E\u0440\u043E\u0448\u0435\u0435. \u0417\u043D\u0430\u043D\u0438\u0435
      \u0434\u043E\u0440\u043E\u0436\u0435 \u0437\u043E\u043B\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572769
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u043A\u0430 \u0443\u0442\u043E\u0447\u043D\u0438\u0442\u044C
      \u0434\u0435\u0442\u0430\u043B\u0438 \u043F\u0440\u0438\u0432\u0435\u043B\u0430
      \u043A \u0442\u043E\u043C\u0443, \u0447\u0442\u043E \u0441\u0442\u0430\u0440\u0438\u043A
      \u0437\u0430\u043C\u043E\u043B\u0447\u0430\u043B. \"\u041D\u0435 \u0432\u0441\u0451
      \u0434\u043B\u044F \u0447\u0443\u0436\u0438\u0445 \u0443\u0448\u0435\u0439.\"
      \u041E\u0441\u0442\u0430\u0442\u043E\u043A \u0432\u0435\u0447\u0435\u0440\u0430
      \u043F\u0440\u043E\u0448\u0451\u043B \u0432 \u0442\u0438\u0448\u0438\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572770
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442
      \u0441\u0432\u043E\u044E \u0438\u0441\u0442\u043E\u0440\u0438\u044E \u0432
      \u043E\u0442\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572771
    m_Localized: "\u0412\u044B \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0438
      \u043E\u0431 \u043E\u0431\u0445\u043E\u0434\u0435 \u043B\u0435\u0434\u043D\u0438\u043A\u0430
      \u0432 \u0421\u043E\u0433\u0434\u0435: \u0442\u043E\u0433\u0434\u0430 \u0442\u043E\u0436\u0435
      \u0434\u0443\u043C\u0430\u043B\u0438, \u0447\u0442\u043E \u043F\u0443\u0442\u044C
      \u043F\u0440\u043E\u043A\u043B\u044F\u0442, \u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C:
      \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435\u0432\u0435\u0440\u043D\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430. \u0421\u0442\u0430\u0440\u0438\u043A
      \u043A\u0438\u0432\u043D\u0443\u043B \u0438 \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B
      \u0441\u0443\u0448\u0451\u043D\u044B\u0439 \u0444\u0438\u043D\u0438\u043A.
      \u041E\u0431\u043C\u0435\u043D \u0438\u0441\u0442\u043E\u0440\u0438\u044F\u043C\u0438
      \u0438 \u0435\u0441\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572772
    m_Localized: "\u041A\u0440\u0443\u0436\u043A\u0430 \u0447\u0430\u044F \u043D\u0430
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572773
    m_Localized: "\u0412\u0435\u0442\u0435\u0440 \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435
      \u0440\u0435\u0436\u0435\u0442 \u0449\u0451\u043A\u0438. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A-\u0431\u0430\u043A\u0442\u0440\u0438\u0435\u0446
      \u0440\u0430\u0441\u043F\u0430\u043A\u043E\u0432\u044B\u0432\u0430\u0435\u0442
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043C\u0435\u0448\u043E\u043A,
      \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u043F\u043B\u0438\u0442\u043A\u0443
      \u043F\u0440\u0435\u0441\u0441\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
      \u0447\u0430\u044F \u0438 \u043C\u0435\u0434\u043D\u044B\u0439 \u043A\u043E\u0442\u0435\u043B\u043E\u043A.
      \u0412\u043E\u0434\u0430 \u0438\u0437 \u043B\u0443\u0436\u0438\u0446\u044B
      \u0442\u0430\u043B\u043E\u0433\u043E \u0441\u043D\u0435\u0433\u0430 \u0437\u0430\u043A\u0438\u043F\u0430\u0435\u0442
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E - \u0432\u044B\u0441\u043E\u0442\u0430
      \u0431\u043E\u043B\u044C\u0448\u0430\u044F. \u041F\u0430\u0440 \u043E\u0442
      \u043A\u0440\u0443\u0436\u043A\u0438 \u043F\u0430\u0445\u043D\u0435\u0442 \u0434\u044B\u043C\u043A\u043E\u043C
      \u0438 \u0447\u0435\u043C-\u0442\u043E \u0433\u043E\u0440\u044C\u043A\u043E\u0432\u0430\u0442\u044B\u043C.
      \u041B\u044E\u0434\u0438 \u0442\u044F\u043D\u0443\u0442\u0441\u044F \u043A
      \u0442\u0435\u043F\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572774
    m_Localized: "\u0414\u0430\u0442\u044C \u0432\u0441\u0435\u043C \u043F\u043E
      \u043A\u0440\u0443\u0436\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572775
    m_Localized: "\u041F\u043B\u0438\u0442\u043A\u0438 \u0445\u0432\u0430\u0442\u0438\u043B\u043E
      \u043D\u0430 \u0432\u0441\u0435\u0445 - \u043F\u043E \u043E\u0434\u043D\u043E\u0439
      \u043A\u0440\u0443\u0436\u043A\u0435, \u043A\u0440\u0435\u043F\u043A\u043E\u0439
      \u0438 \u0433\u043E\u0440\u044F\u0447\u0435\u0439. \u041B\u044E\u0434\u0438
      \u0437\u0430\u0434\u0432\u0438\u0433\u0430\u043B\u0438\u0441\u044C \u0436\u0438\u0432\u0435\u0435.
      \u041F\u0435\u0440\u0435\u0432\u0430\u043B \u0432\u0437\u044F\u043B\u0438 \u043D\u0430
      \u0447\u0430\u0441 \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u0447\u0435\u043C
      \u043E\u0436\u0438\u0434\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572776
    m_Localized: "\u0420\u0430\u0437\u0432\u0430\u0440\u0438\u0442\u044C \u0447\u0430\u0439
      \u0433\u0443\u0449\u0435, \u0434\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0443\u0441\u0442\u0430\u0432\u0448\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572777
    m_Localized: "\u0412\u044B \u0432\u044B\u0431\u0440\u0430\u043B\u0438 \u0447\u0435\u0442\u0432\u0435\u0440\u044B\u0445,
      \u043A\u0442\u043E \u0448\u0430\u0442\u0430\u043B\u0441\u044F \u043D\u0430
      \u0445\u043E\u0434\u0443. \u0413\u043E\u0440\u044F\u0447\u0438\u0439 \u043D\u0430\u0441\u0442\u043E\u0439
      \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0438\u0445 \u043D\u0430
      \u043D\u043E\u0433\u0438 \u0431\u044B\u0441\u0442\u0440\u043E. \u042D\u043A\u043E\u043D\u043E\u043C\u0438\u044F
      \u0437\u0430\u043F\u0430\u0441\u043E\u0432 - \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u0435\u0449\u0451 \u0434\u043D\u0438 \u0432 \u0433\u043E\u0440\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572778
    m_Localized: "\u0412\u044B\u0431\u043E\u0440 \u0432\u044B\u0437\u0432\u0430\u043B
      \u043E\u0431\u0438\u0434\u044B. \u0422\u0435, \u043A\u043E\u0433\u043E \u043E\u0431\u0434\u0435\u043B\u0438\u043B\u0438,
      \u0432\u043E\u0440\u0447\u0430\u043B\u0438 \u0434\u043E \u0432\u0435\u0447\u0435\u0440\u0430.
      \u0427\u0430\u0439 \u0434\u0430\u043B \u0441\u0438\u043B\u044B \u0442\u0435\u043B\u0443,
      \u043D\u043E \u043D\u0435 \u0434\u0443\u0445\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572779
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u0447\u0430\u0439 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0443
      \u043A\u0430\u043A \u043F\u043B\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572780
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043F\u0440\u0438\u043D\u044F\u043B
      \u043F\u043B\u0438\u0442\u043A\u0443 \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C.
      \u0412\u0437\u0430\u043C\u0435\u043D \u043E\u043D \u043F\u043E\u0432\u0451\u043B
      \u0447\u0435\u0440\u0435\u0437 \u043E\u0431\u0445\u043E\u0434\u043D\u0443\u044E
      \u0442\u0440\u043E\u043F\u0443, \u0433\u0434\u0435 \u0432\u0435\u0442\u0435\u0440
      \u0441\u043B\u0430\u0431\u0435\u0435 \u0438 \u0441\u043A\u043B\u043E\u043D
      \u043F\u043E\u043B\u043E\u0436\u0435. \u042D\u043A\u043E\u043D\u043E\u043C\u0438\u044F
      \u0441\u0438\u043B \u0434\u043E\u0440\u043E\u0436\u0435 \u043A\u0440\u0443\u0436\u043A\u0438
      \u0447\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572781
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u043D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572782
    m_Localized: "\u041D\u0430 \u043F\u043B\u043E\u0441\u043A\u043E\u043C \u043A\u0430\u043C\u043D\u0435
      \u0443 \u0442\u0440\u043E\u043F\u044B \u0441\u0438\u0434\u0438\u0442 \u0431\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u043C\u043E\u043D\u0430\u0445 - \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u043E\u0435
      \u043E\u0434\u0435\u044F\u043D\u0438\u0435, \u0431\u0440\u0438\u0442\u0430\u044F
      \u0433\u043E\u043B\u043E\u0432\u0430, \u0447\u0451\u0442\u043A\u0438 \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u0435\u0442
      \u043D\u0435 \u0433\u043B\u044F\u0434\u044F. \u041E\u043D \u043D\u0435 \u043F\u0440\u043E\u0441\u0438\u0442
      \u043F\u043E\u0434\u0430\u044F\u043D\u0438\u044F \u0438 \u043D\u0435 \u043C\u0435\u0448\u0430\u0435\u0442.
      \u041F\u0440\u043E\u0441\u0442\u043E \u0441\u0438\u0434\u0438\u0442. \u041C\u043E\u043B\u043E\u0434\u043E\u0439
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0445\u043E\u0447\u0435\u0442
      \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0448\u0438\u043A\u0430\u044E\u0442 \u043D\u0430 \u043D\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572783
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043C\u043E\u043D\u0430\u0445\u0430
      \u0432 \u043F\u043E\u043A\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572784
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0432\u0435\u043B\u0438 \u043C\u0438\u043C\u043E
      \u0432\u0435\u0441\u044C \u043E\u0431\u043E\u0437 \u0442\u0438\u0445\u043E.
      \u041C\u043E\u043D\u0430\u0445 \u043D\u0435 \u043F\u043E\u0434\u043D\u044F\u043B
      \u0433\u043B\u0430\u0437. \u041A\u043E\u0433\u0434\u0430 \u043E\u0433\u043B\u044F\u043D\u0443\u043B\u0438\u0441\u044C
      \u0441 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430 - \u0435\u0433\u043E
      \u0443\u0436\u0435 \u043D\u0435 \u0431\u044B\u043B\u043E. \u0413\u043E\u0440\u044B
      \u0443\u043C\u0435\u044E\u0442 \u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0442\u0438\u0448\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572785
    m_Localized: "\u041F\u0440\u0435\u043F\u043E\u0434\u043D\u0435\u0441\u0442\u0438
      \u043C\u043E\u043D\u0430\u0445\u0443 \u0434\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572786
    m_Localized: "\u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043F\u043E\u043B\u043E\u0436\u0438\u043B \u043F\u0435\u0440\u0435\u0434 \u043C\u043E\u043D\u0430\u0445\u043E\u043C
      \u043B\u0435\u043F\u0451\u0448\u043A\u0443 \u0438 \u0433\u043E\u0440\u0441\u0442\u044C
      \u043E\u0440\u0435\u0445\u043E\u0432. \u041C\u043E\u043D\u0430\u0445 \u043E\u0442\u043A\u0440\u044B\u043B
      \u0433\u043B\u0430\u0437\u0430, \u043A\u043E\u0440\u043E\u0442\u043A\u043E
      \u0441\u043B\u043E\u0436\u0438\u043B \u043B\u0430\u0434\u043E\u043D\u0438 \u0438
      \u0441\u043D\u043E\u0432\u0430 \u0437\u0430\u043A\u0440\u044B\u043B. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      - \u0436\u0435\u0441\u0442, \u0430 \u043D\u0435 \u0441\u043B\u043E\u0432\u043E.
      \u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u0431\u044B\u043B \u0434\u043E\u0432\u043E\u043B\u0435\u043D
      \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572787
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u043A\u0430 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0441 \u043C\u043E\u043D\u0430\u0445\u043E\u043C \u043F\u0440\u0438\u0432\u0435\u043B\u0430
      \u043A \u0442\u043E\u043C\u0443, \u0447\u0442\u043E \u043E\u043D \u0432\u0441\u0442\u0430\u043B
      \u0438 \u0443\u0448\u0451\u043B \u043F\u043E \u0442\u0440\u043E\u043F\u0435
      \u0432\u0432\u0435\u0440\u0445, \u043D\u0435 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C.
      \u041D\u0438\u043A\u0430\u043A\u043E\u0433\u043E \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430
      \u043D\u0435 \u0432\u044B\u0448\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572788
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043E
      \u0433\u043E\u0440\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572789
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043E\u0442\u043A\u0440\u044B\u043B \u0433\u043B\u0430\u0437\u0430 \u0438
      \u0441\u043A\u0430\u0437\u0430\u043B \u043F\u043E-\u0442\u044E\u0440\u043A\u0441\u043A\u0438:
      \xAB\u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u0442\u0440\u0438 \u0434\u043D\u044F
      \u0434\u043E \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F. \u0422\u0430\u043C
      \u043C\u043E\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C
      \u0441\u043D\u0435\u0433.\xBB \u0411\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u0447\u0435\u0433\u043E.
      \u0422\u0440\u0438 \u0434\u043D\u044F - \u0446\u0435\u043D\u043D\u043E\u0435
      \u0437\u043D\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572790
    m_Localized: "\u041E\u0436\u0438\u0434\u0430\u043D\u0438\u0435 \u0432 \u043C\u0435\u0442\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572791
    m_Localized: "\u041C\u0435\u0442\u0435\u043B\u044C \u0443\u0434\u0430\u0440\u0438\u043B\u0430
      \u0441 \u0443\u0442\u0440\u0430: \u0432\u0435\u0442\u0435\u0440 \u043D\u0435\u0441\u0451\u0442
      \u0441\u043D\u0435\u0433 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u043E,
      \u0442\u0440\u043E\u043F\u0430 \u0438\u0441\u0447\u0435\u0437\u043B\u0430.
      \u0412\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u044C \u043F\u044F\u0442\u044C
      \u0448\u0430\u0433\u043E\u0432. \u041C\u0443\u043B\u044B \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0438\u0434\u0442\u0438, \u0438 \u043E\u043D\u0438 \u043F\u0440\u0430\u0432\u044B.
      \u041C\u043E\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C
      \u0437\u0430 \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u043C \u0432\u044B\u0441\u0442\u0443\u043F\u043E\u043C,
      \u043D\u043E \u0437\u0430\u043F\u0430\u0441\u044B \u043D\u0435 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B,
      \u0438 \u0443 \u043B\u044E\u0434\u0435\u0439 \u0443\u0436\u0435 \u0435\u0441\u0442\u044C
      \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u0432 \u0433\u043B\u0430\u0437\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572792
    m_Localized: "\u0423\u043A\u0440\u044B\u0442\u044C\u0441\u044F \u0438 \u0436\u0434\u0430\u0442\u044C
      \u043A\u043E\u043D\u0446\u0430 \u0431\u0443\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572793
    m_Localized: "\u0428\u0430\u0442\u0440\u044B \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u0432\u043F\u043B\u043E\u0442\u043D\u0443\u044E \u043A \u0441\u043A\u0430\u043B\u0435.
      \u041F\u0440\u043E\u0448\u043B\u043E \u043F\u043E\u0447\u0442\u0438 \u043F\u043E\u043B\u0442\u043E\u0440\u0430
      \u0434\u043D\u044F. \u0411\u0443\u0440\u044F \u0443\u0442\u0438\u0445\u043B\u0430
      \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443 \u0443\u0442\u0440\u0443.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0434\u0435\u043D\u044C,
      \u0437\u0430\u0442\u043E \u0432\u0441\u0435 \u0436\u0438\u0432\u044B \u0438
      \u0433\u0440\u0443\u0437 \u0446\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572794
    m_Localized: "\u041F\u043E\u0441\u043B\u0430\u0442\u044C \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u0430
      \u0438\u0441\u043A\u0430\u0442\u044C \u0443\u043A\u0440\u044B\u0442\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572795
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A \u0443\u0448\u0451\u043B
      \u0432 \u043C\u0435\u0442\u0435\u043B\u044C \u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441: \u0432 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u0438
      \u043B\u0438 - \u0437\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u0430\u044F
      \u0447\u0430\u0431\u0430\u043D\u0441\u043A\u0430\u044F \u0445\u0438\u0436\u0438\u043D\u0430.
      \u0412\u0435\u0441\u044C \u043E\u0431\u043E\u0437 \u043F\u0435\u0440\u0435\u0431\u0440\u0430\u043B\u0441\u044F
      \u0442\u0443\u0434\u0430. \u041D\u043E\u0447\u0435\u0432\u0430\u043B\u0438
      \u043F\u043E\u0434 \u043A\u0440\u044B\u0448\u0435\u0439 - \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u0430\u044F
      \u0443\u0434\u0430\u0447\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572796
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A \u0437\u0430\u0431\u043B\u0443\u0434\u0438\u043B\u0441\u044F.
      \u0415\u0433\u043E \u043D\u0430\u0448\u043B\u0438 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430 \u0447\u0430\u0441\u0430 \u0432 \u0441\u043D\u0435\u0433\u0443,
      \u0436\u0438\u0432\u043E\u0433\u043E, \u043D\u043E \u043E\u0431\u043C\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u043E\u0433\u043E.
      \u0425\u0438\u0436\u0438\u043D\u044B \u043D\u0435\u0442. \u041B\u0430\u0433\u0435\u0440\u044C
      \u0441\u0438\u0434\u0438\u0442 \u0442\u0430\u043C \u0436\u0435, \u0442\u043E\u043B\u044C\u043A\u043E
      \u043B\u044E\u0434\u0438 \u043D\u0430\u043F\u0443\u0433\u0430\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572797
    m_Localized: "\u0414\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043F\u043E \u043F\u0430\u043C\u044F\u0442\u0438 \u0442\u0440\u043E\u043F\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572798
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0432\u0451\u043B
      \u043F\u043E \u043F\u0430\u043C\u044F\u0442\u0438, \u0449\u0443\u043F\u0430\u044F
      \u043A\u0430\u043C\u043D\u0438 \u043D\u043E\u0433\u043E\u0439. \u041F\u0440\u043E\u0448\u043B\u0438
      \u0442\u0440\u0438 \u043B\u0438 \u0437\u0430 \u0447\u0435\u0442\u044B\u0440\u0435
      \u0447\u0430\u0441\u0430. \u0412\u044B\u0448\u043B\u0438 \u0438\u0437 \u0437\u043E\u043D\u044B
      \u0431\u0443\u0440\u0438 \u043A \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0443
      - \u0442\u0430\u043C \u0432\u0435\u0442\u0435\u0440 \u0441\u0442\u0438\u0445.
      \u0420\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u043D\u043E, \u0437\u0430\u0442\u043E
      \u0432\u043F\u0435\u0440\u0451\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572799
    m_Localized: "\u0421\u043B\u043E\u043C\u0430\u043D\u043D\u0430\u044F \u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572800
    m_Localized: "\u0421\u043A\u0440\u0438\u043F \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u0432 \u0442\u0440\u0435\u0441\u043A, \u0438 \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043E\u0441\u0435\u0434\u0430\u0435\u0442 \u043D\u0430 \u043F\u0440\u0430\u0432\u044B\u0439
      \u0431\u043E\u043A. \u041E\u0441\u044C \u043F\u0435\u0440\u0435\u043B\u043E\u043C\u0438\u043B\u0430\u0441\u044C
      \u0443 \u0441\u0442\u0443\u043F\u0438\u0446\u044B: \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u0430
      \u043F\u043E\u0434\u0433\u043D\u0438\u043B\u0430 \u0438\u0437\u043D\u0443\u0442\u0440\u0438,
      \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438 \u0432\u043E\u0432\u0440\u0435\u043C\u044F.
      \u0413\u0440\u0443\u0437 \u0441\u043F\u043E\u043B\u0437, \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u0448\u0430\u0440\u0430\u0445\u043D\u0443\u043B\u0441\u044F. \u041D\u0430
      \u0434\u043E\u0440\u043E\u0433\u0435 \u0437\u0430\u043F\u0430\u0441\u043D\u0430\u044F
      \u043E\u0441\u044C \u0435\u0441\u0442\u044C, \u043D\u043E \u043F\u043E\u0434\u0433\u043E\u043D\u043A\u0430
      \u0437\u0430\u0439\u043C\u0451\u0442 \u0432\u0440\u0435\u043C\u044F \u0438
      \u0445\u043E\u0440\u043E\u0448\u0438\u0435 \u0440\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572801
    m_Localized: "\u041F\u043E\u0447\u0438\u043D\u0438\u0442\u044C \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572802
    m_Localized: "\u041F\u043B\u043E\u0442\u043D\u0438\u043A \u043E\u0431\u043E\u0437\u0430
      \u043F\u0440\u043E\u0432\u043E\u0437\u0438\u043B\u0441\u044F \u0442\u0440\u0438
      \u0447\u0430\u0441\u0430. \u0420\u0443\u043A\u0438 \u0432 \u0441\u043C\u043E\u043B\u0435,
      \u043F\u043E\u0442 \u0433\u0440\u0430\u0434\u043E\u043C, \u043D\u043E \u043E\u0441\u044C
      \u0432\u0441\u0442\u0430\u043B\u0430. \u041F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0441\u043D\u043E\u0432\u0430 \u043D\u0430 \u0445\u043E\u0434\u0443. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043F\u043E\u043B\u0434\u043D\u044F, \u0437\u0430\u0442\u043E \u043D\u0435
      \u0431\u0440\u043E\u0441\u0438\u043B\u0438 \u0433\u0440\u0443\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572803
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u043A\u0443\u0437\u043D\u0435\u0446\u0430
      \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C \u0441\u0435\u043B\u0435\u043D\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572804
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0441 \u0438\u0437\u0432\u0435\u0441\u0442\u0438\u0435\u043C: \u043A\u0443\u0437\u043D\u0435\u0446
      \u0432 \u0434\u0432\u0443\u0445 \u043B\u0438, \u0443 \u0440\u0435\u043A\u0438.
      \u0422\u0443\u0434\u0430 \u043E\u0442\u0432\u0435\u043B\u0438 \u043F\u043E\u0432\u043E\u0437\u043A\u0443,
      \u043C\u0430\u0441\u0442\u0435\u0440 \u043E\u0431\u0448\u0438\u043B \u043E\u0441\u044C
      \u0436\u0435\u043B\u0435\u0437\u043D\u044B\u043C\u0438 \u043F\u043E\u043B\u043E\u0441\u0430\u043C\u0438.
      \u041A\u0440\u0435\u043F\u0447\u0435 \u043F\u0440\u0435\u0436\u043D\u0435\u0433\u043E.
      \u0417\u0430\u043D\u044F\u043B\u043E \u0434\u0435\u043D\u044C \u0438 \u0441\u0442\u043E\u0438\u043B\u043E
      \u043C\u043E\u043D\u0435\u0442\u0443, \u043D\u043E \u0441\u0434\u0435\u043B\u0430\u043D\u043E
      \u043D\u0430 \u0441\u043E\u0432\u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572805
    m_Localized: "\u041A\u0443\u0437\u043D\u0435\u0446\u0430 \u0434\u043E\u043C\u0430
      \u043D\u0435 \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C - \u0443\u0448\u0451\u043B
      \u043D\u0430 \u044F\u0440\u043C\u0430\u0440\u043A\u0443. \u0412\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u043D\u0438 \u0441 \u0447\u0435\u043C, \u0447\u0438\u043D\u0438\u043B\u0438
      \u0441\u0430\u043C\u0438. \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0435\u0445\u0430\u043B\u0430, \u043D\u043E \u043D\u0435\u043D\u0430\u0434\u0451\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572806
    m_Localized: "\u041F\u0435\u0440\u0435\u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
      \u0433\u0440\u0443\u0437 \u043C\u0435\u0436\u0434\u0443 \u0432\u044C\u044E\u0447\u043D\u044B\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572807
    m_Localized: "\u041F\u043E\u0432\u043E\u0437\u043A\u0443 \u0431\u0440\u043E\u0441\u0438\u043B\u0438
      - \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u043E\u043B\u0433\u043E
      \u0447\u0438\u043D\u0438\u0442\u044C. \u0413\u0440\u0443\u0437 \u0440\u0430\u0441\u043A\u0438\u0434\u0430\u043B\u0438
      \u043F\u043E \u0432\u044C\u044E\u043A\u0430\u043C. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043D\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u044B \u0441\u0438\u043B\u044C\u043D\u0435\u0435,
      \u043D\u043E \u0438\u0434\u0443\u0442. \u041F\u043E\u0432\u043E\u0437\u043A\u0443
      \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0443 \u0434\u0435\u0440\u0435\u0432\u0430
      - \u043C\u043E\u0436\u0435\u0442, \u043A\u0442\u043E \u043D\u0430\u0439\u0434\u0451\u0442
      \u0438 \u043F\u043E\u0447\u0438\u043D\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572808
    m_Localized: "\u041F\u043E\u0440\u0432\u0430\u043D\u043D\u0430\u044F \u0443\u043F\u0440\u044F\u0436\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572809
    m_Localized: "\u041A\u043E\u0436\u0430\u043D\u044B\u0439 \u043D\u0430\u0433\u0440\u0443\u0434\u043D\u0438\u043A
      \u0442\u0440\u0435\u0441\u043D\u0443\u043B \u043F\u043E \u0448\u0432\u0443
      - \u0443 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0433\u043E \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430
      \u0443\u043F\u0440\u044F\u0436\u044C \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043D\u0430 \u0434\u0432\u0443\u0445 \u0440\u0435\u043C\u043D\u044F\u0445
      \u0432\u043C\u0435\u0441\u0442\u043E \u0448\u0435\u0441\u0442\u0438. \u0415\u0449\u0451
      \u0447\u0430\u0441 \u0445\u043E\u0434\u0430, \u0438 \u043E\u043D\u0430 \u043E\u0442\u0432\u0430\u043B\u0438\u0442\u0441\u044F
      \u0441\u043E\u0432\u0441\u0435\u043C. \u041A\u043E\u0436\u0430 \u0441\u0442\u0430\u0440\u0430\u044F,
      \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u0448\u0430\u044F - \u0432 \u0441\u0442\u0435\u043F\u0438
      \u043D\u0435\u0442 \u043D\u0438 \u0442\u0435\u043D\u0438. \u0428\u043E\u0440\u043D\u0438\u043A
      \u043D\u0443\u0436\u0435\u043D, \u0438\u043B\u0438 \u0445\u043E\u0442\u044F
      \u0431\u044B \u0437\u0430\u043F\u0430\u0441\u043D\u0430\u044F \u043A\u043E\u0436\u0430
      \u0438 \u0448\u0438\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572810
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0438 \u0437\u0430\u0448\u0438\u0442\u044C \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572811
    m_Localized: "\u0428\u043E\u0440\u043D\u0438\u043A \u0441\u0435\u043B \u043F\u0440\u044F\u043C\u043E
      \u043D\u0430 \u0442\u0440\u0430\u0432\u0435. \u0421\u043E\u0440\u043E\u043A
      \u043C\u0438\u043D\u0443\u0442 \u0440\u0430\u0431\u043E\u0442\u044B: \u0434\u0440\u0430\u0442\u0432\u0430,
      \u0448\u0438\u043B\u043E, \u043F\u0430\u043B\u044C\u0446\u044B \u0432 \u0443\u043A\u043E\u043B\u0430\u0445.
      \u0423\u043F\u0440\u044F\u0436\u044C \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0442
      \u0434\u043E \u0433\u043E\u0440\u043E\u0434\u0430. \u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 - \u043D\u0435 \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572812
    m_Localized: "\u041F\u0443\u0441\u0442\u0438\u0442\u044C \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430
      \u0431\u0435\u0437 \u043D\u0430\u0433\u0440\u0443\u0434\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572813
    m_Localized: "\u041E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u043B\u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430
      \u043E\u0442 \u043F\u043E\u0440\u0432\u0430\u043D\u043D\u043E\u0439 \u0443\u043F\u0440\u044F\u0436\u0438,
      \u043F\u0435\u0440\u0435\u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B\u0438
      \u0432\u044C\u044E\u043A\u0438 \u043D\u0430 \u0434\u0440\u0443\u0433\u0438\u0445.
      \u0416\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u0448\u043B\u043E \u043D\u0430\u043B\u0435\u0433\u043A\u0435,
      \u043F\u043E\u0447\u0438\u043D\u0438\u043B\u0438 \u0432 \u043B\u0430\u0433\u0435\u0440\u0435
      \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u044F\u0441\u044C.
      \u041C\u0435\u043D\u044C\u0448\u0435 \u0441\u0443\u0435\u0442\u044B \u0432
      \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572814
    m_Localized: "\u0411\u0435\u0437 \u043D\u0430\u0433\u0440\u0443\u0434\u043D\u0438\u043A\u0430
      \u0432\u044C\u044E\u043A \u0441\u043F\u043E\u043B\u0437 \u043D\u0430\u0431\u043E\u043A
      \u043D\u0430 \u043F\u043E\u0434\u044A\u0451\u043C\u0435. \u0412\u0435\u0440\u0431\u043B\u044E\u0434
      \u0441\u043F\u043E\u0442\u043A\u043D\u0443\u043B\u0441\u044F, \u0447\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430 \u0443\u043F\u0430\u043B\u0430 \u0432 \u0433\u0440\u044F\u0437\u044C.
      \u041F\u043E\u0442\u0435\u0440\u0438 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435,
      \u043D\u043E \u043D\u0435\u043B\u043E\u0432\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572815
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0432\u0435\u0440\u0451\u0432\u043A\u0443 \u043A\u0430\u043A \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0443\u044E
      \u0437\u0430\u043C\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572816
    m_Localized: "\u0414\u0432\u0430 \u043A\u043E\u043D\u043E\u043F\u043B\u044F\u043D\u044B\u0445
      \u043A\u0430\u043D\u0430\u0442\u0430 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438
      \u0447\u0435\u0440\u0435\u0437 \u043A\u043E\u043B\u044C\u0446\u0430 \u0438
      \u0441\u0442\u044F\u043D\u0443\u043B\u0438 \u043A\u0440\u0435\u0441\u0442-\u043D\u0430\u043A\u0440\u0435\u0441\u0442.
      \u041D\u0435\u043A\u0440\u0430\u0441\u0438\u0432\u043E, \u043D\u043E \u0434\u0435\u0440\u0436\u0438\u0442.
      \u0414\u043E\u0448\u043B\u0438 \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0441\u0442\u043E\u044F\u043D\u043A\u0438, \u0442\u0430\u043C \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u044B\u0439 \u0440\u0435\u043C\u043E\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572817
    m_Localized: "\u041A\u043E\u043B\u0451\u0441\u043D\u0430\u044F \u0441\u043C\u0430\u0437\u043A\u0430
      \u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572818
    m_Localized: "\u0421\u043A\u0440\u0438\u043F \u043A\u043E\u043B\u0451\u0441 \u0441\u043B\u044B\u0448\u0435\u043D
      \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430 - \u0441\u0442\u0443\u043F\u0438\u0446\u0430
      \u0442\u0440\u0451\u0442\u0441\u044F \u043E \u0434\u0435\u0440\u0435\u0432\u043E
      \u0431\u0435\u0437 \u0441\u043C\u0430\u0437\u043A\u0438. \u0414\u0435\u0433\u043E\u0442\u044C
      \u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F \u0442\u0440\u0438 \u0434\u043D\u044F
      \u043D\u0430\u0437\u0430\u0434, \u0430 \u043D\u043E\u0432\u044B\u0439 \u043A\u0443\u043F\u0438\u0442\u044C
      \u043D\u0435 \u0431\u044B\u043B\u043E \u0441\u043B\u0443\u0447\u0430\u044F.
      \u0415\u0441\u043B\u0438 \u043D\u0435 \u0441\u043C\u0430\u0437\u0430\u0442\u044C
      \u0441\u0435\u0439\u0447\u0430\u0441, \u0447\u0435\u0440\u0435\u0437 \u0434\u0435\u043D\u044C-\u0434\u0440\u0443\u0433\u043E\u0439
      \u043A\u043E\u043B\u0435\u0441\u043E \u0437\u0430\u043A\u043B\u0438\u043D\u0438\u0442
      \u043D\u0430\u043C\u0435\u0440\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572819
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0439 \u0436\u0438\u0440 \u0438\u0437
      \u0437\u0430\u043F\u0430\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572820
    m_Localized: "\u041A\u043E\u0442\u0435\u043B\u043E\u043A \u0441\u0442\u0430\u0440\u043E\u0433\u043E
      \u0431\u0430\u0440\u0430\u043D\u044C\u0435\u0433\u043E \u0436\u0438\u0440\u0430
      \u0440\u0430\u0441\u0442\u043E\u043F\u0438\u043B\u0438 \u0438 \u0437\u0430\u043B\u0438\u043B\u0438
      \u0432 \u0441\u0442\u0443\u043F\u0438\u0446\u044B. \u0421\u043A\u0440\u0438\u043F
      \u0443\u0442\u0438\u0445. \u0417\u0430\u043F\u0430\u0441 \u0436\u0438\u0440\u0430
      \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u043B\u0441\u044F, \u043D\u043E
      \u0434\u043E\u0440\u043E\u0433\u0430 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F.
      \u041C\u044F\u0441\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u043F\u0430\u0445\u0438\u0432\u0430\u0435\u0442,
      \u043D\u043E \u0432\u0441\u0451 \u0442\u0435\u0440\u043F\u0438\u043C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572821
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u0441\u043C\u043E\u043B\u0443 \u0438\u043B\u0438
      \u0434\u0435\u0433\u043E\u0442\u044C \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572822
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u0441 \u0433\u043E\u0440\u0448\u043A\u043E\u043C
      \u0434\u0451\u0433\u0442\u044F: \u043A\u0443\u043F\u0438\u043B \u0443 \u0432\u0441\u0442\u0440\u0435\u0447\u043D\u043E\u0433\u043E
      \u0433\u043E\u043D\u0446\u0430 \u0437\u0430 \u043C\u0435\u0434\u044C. \u0414\u043E\u0440\u043E\u0433\u043E
      \u0432\u044B\u0448\u043B\u043E, \u043D\u043E \u043A\u043E\u043B\u0451\u0441\u0430
      \u0441\u043C\u0430\u0437\u0430\u043D\u044B \u043A\u0430\u043A \u0441\u043B\u0435\u0434\u0443\u0435\u0442.
      \u042D\u043A\u043E\u043D\u043E\u043C\u0438\u044F \u043D\u0430 \u0440\u0435\u043C\u043E\u043D\u0442\u0435
      \u0441\u0442\u043E\u0438\u0442 \u0431\u043E\u043B\u044C\u0448\u0438\u0445 \u043F\u043E\u0442\u0435\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572823
    m_Localized: "\u0414\u0451\u0433\u0442\u044F \u043D\u0438\u0433\u0434\u0435 \u043D\u0435
      \u043D\u0430\u0448\u043B\u0438. \u0412\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u0441 \u043F\u0443\u0441\u0442\u044B\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438.
      \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u043E\u0434\u043D\u043E \u043A\u043E\u043B\u0435\u0441\u043E
      \u043D\u0430\u0447\u0430\u043B\u043E \u043B\u044E\u0444\u0442\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572824
    m_Localized: "\u0421\u043D\u044F\u0442\u044C \u043E\u0434\u043D\u0443 \u043F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0441 \u0445\u043E\u0434\u0430 \u0434\u043E \u043F\u043E\u0447\u0438\u043D\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572825
    m_Localized: "\u0413\u0440\u0443\u0437 \u0441 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043D\u043E\u0439
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043F\u0435\u0440\u0435\u043B\u043E\u0436\u0438\u043B\u0438
      \u043D\u0430 \u0434\u0440\u0443\u0433\u0438\u0445. \u041F\u043E\u0432\u043E\u0437\u043A\u0443
      \u043A\u0430\u0442\u0438\u043B\u0438 \u043D\u0430\u043B\u0435\u0433\u043A\u0435.
      \u041A \u043F\u043E\u043B\u0443\u0434\u043D\u044E \u043D\u0430\u0448\u043B\u0438
      \u0441\u0435\u043B\u0435\u043D\u0438\u0435 \u0441 \u043A\u0443\u0437\u043D\u0435\u0446\u043E\u043C
      - \u0442\u0430\u043C \u0441\u043C\u0430\u0437\u0430\u043B\u0438 \u0438 \u0443\u043A\u0440\u0435\u043F\u0438\u043B\u0438
      \u0441\u0442\u0443\u043F\u0438\u0446\u044B \u043A\u0430\u043A \u0441\u043B\u0435\u0434\u0443\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572826
    m_Localized: "\u0420\u0430\u0441\u0441\u043E\u0445\u0448\u0438\u0435\u0441\u044F
      \u0431\u043E\u0447\u043A\u0438 \u0441 \u0432\u043E\u0434\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572827
    m_Localized: "\u0416\u0430\u0440\u0430 \u0441\u0434\u0435\u043B\u0430\u043B\u0430
      \u0441\u0432\u043E\u0451 \u0434\u0435\u043B\u043E: \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0435
      \u043E\u0431\u0440\u0443\u0447\u0438 \u043D\u0430 \u0431\u043E\u0447\u043A\u0430\u0445
      \u043E\u0441\u043B\u0430\u0431\u043B\u0438, \u043A\u043B\u0451\u043F\u043A\u0438
      \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C. \u0418\u0437 \u043E\u0434\u043D\u043E\u0439
      \u0443\u0436\u0435 \u0441\u043E\u0447\u0438\u0442\u0441\u044F \u0432\u043E\u0434\u0430,
      \u0442\u043E\u043D\u043A\u0430\u044F \u0441\u0442\u0440\u0443\u0439\u043A\u0430
      \u0432 \u0440\u0430\u0441\u043A\u0430\u043B\u0451\u043D\u043D\u044B\u0439 \u043F\u0435\u0441\u043E\u043A.
      \u0412\u0442\u043E\u0440\u0430\u044F \u0432\u043E\u0442-\u0432\u043E\u0442
      \u0440\u0430\u0441\u0441\u044B\u043F\u043B\u0435\u0442\u0441\u044F. \u0411\u0435\u0437
      \u044D\u0442\u043E\u0439 \u0432\u043E\u0434\u044B \u0434\u0432\u0430 \u0434\u043D\u044F
      \u043F\u0443\u0442\u0438 \u0431\u0435\u0437 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572828
    m_Localized: "\u0421\u0440\u043E\u0447\u043D\u043E \u043F\u0435\u0440\u0435\u043B\u0438\u0442\u044C
      \u0432\u043E\u0434\u0443 \u0432 \u0431\u0443\u0440\u0434\u044E\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572829
    m_Localized: "\u0411\u0443\u0440\u0434\u044E\u043A\u0438 \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u043B\u0438
      \u0432\u0441\u0435 \u0434\u043E \u043E\u0442\u043A\u0430\u0437\u0430 - \u0434\u0430\u0436\u0435
      \u043A\u043E\u0442\u043B\u044B \u0434\u043B\u044F \u0432\u0430\u0440\u043A\u0438.
      \u0412\u043E\u0434\u044B \u0445\u0432\u0430\u0442\u0438\u0442 \u0440\u043E\u0432\u043D\u043E
      \u043D\u0430 \u0434\u0432\u0430 \u0434\u043D\u044F. \u041F\u0443\u0441\u0442\u044B\u0435
      \u0431\u043E\u0447\u043A\u0438 \u0431\u0440\u043E\u0441\u0438\u043B\u0438:
      \u043E\u043D\u0438 \u0441\u0442\u0430\u043B\u0438 \u0449\u0435\u043F\u043A\u0430\u043C\u0438.
      \u0412\u043E\u0434\u0430 \u0441\u043F\u0430\u0441\u0435\u043D\u0430, \u0442\u0430\u0440\u0430
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572830
    m_Localized: "\u0421\u0442\u044F\u043D\u0443\u0442\u044C \u043E\u0431\u0440\u0443\u0447\u0438
      \u0432\u0435\u0440\u0451\u0432\u043A\u043E\u0439 \u0438 \u043F\u043E\u0434\u043C\u043E\u0442\u0430\u0442\u044C
      \u0442\u043A\u0430\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572831
    m_Localized: "\u041F\u043B\u043E\u0442\u043D\u0438\u043A \u043D\u0430\u043C\u043E\u0447\u0438\u043B
      \u0442\u0440\u044F\u043F\u043A\u0438 \u0438 \u043F\u043B\u043E\u0442\u043D\u043E
      \u043E\u0431\u0435\u0440\u043D\u0443\u043B \u043A\u043B\u0451\u043F\u043A\u0438,
      \u043F\u043E\u0442\u043E\u043C \u0441\u0442\u044F\u043D\u0443\u043B \u0432\u0435\u0440\u0451\u0432\u043A\u043E\u0439.
      \u0421\u0430\u043C\u043E\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u0440\u0435\u043C\u043E\u043D\u0442.
      \u0414\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u043E\u0430\u0437\u0438\u0441\u0430
      \u0431\u043E\u0447\u043A\u0438 \u0434\u043E\u0442\u044F\u043D\u0443\u043B\u0438
      - \u0442\u0430\u043C \u0438\u0445 \u043F\u043E\u0447\u0438\u043D\u0438\u043B\u0438
      \u043A\u0430\u043A \u0441\u043B\u0435\u0434\u0443\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572832
    m_Localized: "\u0412\u0435\u0440\u0451\u0432\u043A\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043E\u0441\u043B\u0430\u0431\u043B\u0438 \u043D\u0430 \u0436\u0430\u0440\u0435
      \u043A \u043F\u043E\u043B\u0443\u0434\u043D\u044E. \u0411\u043E\u0447\u043A\u0430
      \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u0430\u0441\u044C
      - \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0447\u0430\u0441\u0442\u044C
      \u0432\u043E\u0434\u044B \u043F\u0440\u0435\u0436\u0434\u0435, \u0447\u0435\u043C
      \u0443\u0441\u043F\u0435\u043B\u0438 \u043F\u0435\u0440\u0435\u043B\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572833
    m_Localized: "\u0412\u044B\u043B\u0438\u0442\u044C \u043B\u0438\u0448\u043D\u0435\u0435
      \u0438 \u0443\u043A\u0440\u0435\u043F\u0438\u0442\u044C \u043E\u0434\u043D\u0443
      \u0431\u043E\u0447\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572834
    m_Localized: "\u0412\u043E\u0434\u0443 \u0438\u0437 \u0445\u0443\u0436\u0435
      \u0431\u043E\u0447\u043A\u0438 \u0441\u043B\u0438\u043B\u0438 \u0432 \u043B\u0443\u0447\u0448\u0443\u044E,
      \u0434\u043E\u0431\u0430\u0432\u0438\u0432 \u043A\u043E\u0436\u0430\u043D\u044B\u0435
      \u043F\u0440\u043E\u043A\u043B\u0430\u0434\u043A\u0438 \u043F\u043E\u0434 \u043E\u0431\u0440\u0443\u0447\u0438.
      \u041E\u0434\u043D\u0430 \u0431\u043E\u0447\u043A\u0430 \u0432\u044B\u0436\u0438\u043B\u0430.
      \u0412\u043E\u0434\u044B \u0441\u0442\u0430\u043B\u043E \u043C\u0435\u043D\u044C\u0448\u0435,
      \u043D\u043E \u043E\u043D\u0430 \u0432 \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0439
      \u0442\u0430\u0440\u0435. \u0420\u0430\u0441\u0447\u0451\u0442 \u0441\u043E\u0448\u0451\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572835
    m_Localized: "\u041F\u0430\u0440\u0443\u0441\u0438\u043D\u0430 \u0448\u0430\u0442\u0440\u0430
      \u043F\u0440\u043E\u0433\u043E\u0440\u0435\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572836
    m_Localized: "\u0423\u0433\u043E\u043B\u0451\u043A \u0438\u0437 \u043A\u0430\u043B\u044C\u044F\u043D\u0430
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430 \u0443\u043F\u0430\u043B
      \u043D\u0430 \u0440\u0430\u0441\u0442\u044F\u043D\u0443\u0442\u0443\u044E \u043F\u0430\u0440\u0443\u0441\u0438\u043D\u0443
      - \u0434\u044B\u0440\u0430 \u0441 \u043B\u0430\u0434\u043E\u043D\u044C. \u041D\u043E\u0447\u044C\u044E
      \u0441\u043A\u0432\u043E\u0437\u044C \u043D\u0435\u0451 \u0431\u0443\u0434\u0435\u0442
      \u0434\u0443\u0442\u044C \u0432\u0435\u0442\u0435\u0440 \u0441 \u043F\u0435\u0441\u043A\u043E\u043C,
      \u0430 \u0435\u0441\u043B\u0438 \u043F\u043E\u0439\u0434\u0451\u0442 \u0440\u0435\u0434\u043A\u0438\u0439
      \u0437\u0434\u0435\u0441\u044C \u0434\u043E\u0436\u0434\u044C - \u0432\u0441\u0451
      \u043D\u0430\u043C\u043E\u043A\u043D\u0435\u0442. \u041F\u0430\u0440\u0443\u0441\u0438\u043D\u0430
      \u0441\u0442\u0430\u0440\u0430\u044F: \u043B\u0438\u0448\u043D\u0438\u0439
      \u0440\u0430\u0437 \u043D\u0435 \u0437\u0430\u0448\u044C\u0451\u0448\u044C
      - \u0440\u0430\u0441\u043F\u043E\u043B\u0437\u0451\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572837
    m_Localized: "\u0410\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u0437\u0430\u0448\u0438\u0442\u044C
      \u043A\u043E\u0436\u0430\u043D\u043E\u0439 \u0437\u0430\u043F\u043B\u0430\u0442\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572838
    m_Localized: "\u0421\u0435\u0434\u0435\u043B\u044C\u0449\u0438\u043A \u0440\u0430\u0431\u043E\u0442\u0430\u043B
      \u043F\u0440\u0438 \u0441\u0432\u0435\u0442\u0435 \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0433\u043E
      \u0441\u0432\u0435\u0442\u0438\u043B\u044C\u043D\u0438\u043A\u0430. \u0417\u0430\u043F\u043B\u0430\u0442\u0430
      \u043B\u0435\u0433\u043B\u0430 \u0440\u043E\u0432\u043D\u043E, \u0441\u0442\u0435\u0436\u043A\u0438
      \u043C\u0435\u043B\u043A\u0438\u0435 \u0438 \u0442\u0443\u0433\u0438\u0435.
      \u041F\u0430\u0440\u0443\u0441\u0438\u043D\u0430 \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0442
      \u0435\u0449\u0451 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0434\u0435\u043B\u044C.
      \u0425\u043E\u0440\u043E\u0448\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430
      \u0432 \u043F\u043B\u043E\u0445\u0438\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572839
    m_Localized: "\u0417\u0430\u043B\u0438\u0442\u044C \u0434\u044B\u0440\u0443 \u0441\u043C\u043E\u043B\u043E\u0439
      \u0438\u0437 \u0437\u0430\u043F\u0430\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572840
    m_Localized: "\u0413\u043E\u0440\u044F\u0447\u0430\u044F \u0441\u043C\u043E\u043B\u0430
      \u043B\u0435\u0433\u043B\u0430 \u0431\u044B\u0441\u0442\u0440\u043E. \u0417\u0430\u043F\u0430\u0445
      \u0440\u0435\u0437\u043A\u0438\u0439, \u043D\u043E \u0434\u044B\u0440\u044B
      \u043D\u0435\u0442. \u041F\u0430\u0440\u0443\u0441\u0438\u043D\u0430 \u0441\u0442\u0430\u043B\u0430
      \u0436\u0451\u0441\u0442\u043A\u043E\u0439 \u0432 \u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435,
      \u0437\u0430\u0442\u043E \u0432\u043E\u0434\u0430 \u043D\u0435 \u043F\u0440\u043E\u0439\u0434\u0451\u0442.
      \u0417\u0430\u043F\u0430\u0441 \u0441\u043C\u043E\u043B\u044B \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572841
    m_Localized: "\u0421\u043C\u043E\u043B\u0430 \u0435\u0449\u0451 \u0433\u043E\u0440\u044F\u0447\u0435\u0439
      \u043F\u043E\u0442\u0435\u043A\u043B\u0430 \u043F\u043E \u043A\u0440\u0430\u044F\u043C
      \u0434\u044B\u0440\u044B \u0438 \u043F\u0440\u043E\u0436\u0433\u043B\u0430
      \u043D\u043E\u0432\u044B\u0435 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435
      \u0434\u044B\u0440\u043E\u0447\u043A\u0438. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0438\u0445 \u0442\u0440\u0438 \u0432\u043C\u0435\u0441\u0442\u043E \u043E\u0434\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572842
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u0442\u044C \u043F\u0430\u0440\u0443\u0441\u0438\u043D\u0443
      \u043F\u043E\u0434 \u0434\u0440\u0443\u0433\u0438\u043C \u0443\u0433\u043B\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572843
    m_Localized: "\u0414\u044B\u0440\u0443 \u0441\u043C\u0435\u0441\u0442\u0438\u043B\u0438
      \u043A \u043A\u043E\u043D\u044C\u043A\u0443 - \u0442\u0430\u043C \u043E\u043D\u0430
      \u043C\u0435\u043D\u044C\u0448\u0435 \u043F\u0440\u043E\u0434\u0443\u0432\u0430\u0435\u0442\u0441\u044F.
      \u0412\u0435\u0440\u0451\u0432\u043A\u0438 \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043B\u0438.
      \u041D\u0435\u043A\u0440\u0430\u0441\u0438\u0432\u043E, \u0437\u0430\u0442\u043E
      \u0431\u044B\u0441\u0442\u0440\u043E. \u041D\u043E\u0447\u044C \u043F\u0440\u043E\u0448\u043B\u0430
      \u0441\u043D\u043E\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572844
    m_Localized: "\u041F\u0435\u0441\u043E\u043A \u0432 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u0430\u0445
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572845
    m_Localized: "\u0421\u043A\u0440\u0438\u043F \u043A\u043E\u043B\u0435\u0441\u0430
      \u0441\u043C\u0435\u043D\u0438\u043B\u0441\u044F \u0445\u0440\u0443\u0441\u0442\u043E\u043C
      - \u0432 \u0441\u0442\u0443\u043F\u0438\u0446\u0443 \u043D\u0430\u0431\u0438\u043B\u0441\u044F
      \u043C\u0435\u043B\u043A\u0438\u0439 \u043F\u0435\u0441\u043E\u043A \u043F\u0443\u0441\u0442\u044B\u043D\u0438
      \u0422\u0430\u043A\u043B\u0430-\u041C\u0430\u043A\u0430\u043D, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0440\u0435\u0436\u0435\u0442 \u0434\u0435\u0440\u0435\u0432\u043E \u043A\u0430\u043A
      \u043D\u0430\u0436\u0434\u0430\u043A. \u041E\u0441\u044C \u0433\u0440\u0435\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0445\u043E\u0434\u0443. \u0415\u0441\u043B\u0438 \u043D\u0435
      \u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E,
      \u043A \u043A\u043E\u043D\u0446\u0443 \u043D\u0435\u0434\u0435\u043B\u0438
      \u043A\u043E\u043B\u0435\u0441\u043E \u0437\u0430\u043A\u043B\u0438\u043D\u0438\u0442
      \u043D\u0430\u0441\u043E\u0432\u0441\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572846
    m_Localized: "\u0412\u044B\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0432\u0441\u0435
      \u0441\u0442\u0443\u043F\u0438\u0446\u044B \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572847
    m_Localized: "\u0414\u0432\u0443\u0445 \u0447\u0430\u0441\u043E\u0432 \u0440\u0430\u0431\u043E\u0442\u044B
      \u0445\u0432\u0430\u0442\u0438\u043B\u043E \u043D\u0430 \u0432\u0441\u0435
      \u0447\u0435\u0442\u044B\u0440\u0435 \u043A\u043E\u043B\u0435\u0441\u0430.
      \u0422\u0440\u044F\u043F\u043A\u0438 \u043F\u043E\u0447\u0435\u0440\u043D\u0435\u043B\u0438
      \u043E\u0442 \u0441\u043C\u0435\u0441\u0438 \u043F\u0435\u0441\u043A\u0430
      \u0438 \u0434\u0451\u0433\u0442\u044F. \u0417\u0430\u0442\u043E \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043F\u043E\u0448\u043B\u0430 \u043F\u043B\u0430\u0432\u043D\u043E, \u0431\u0435\u0437
      \u0445\u0440\u0443\u0441\u0442\u0430. \u041F\u0440\u043E\u0444\u0438\u043B\u0430\u043A\u0442\u0438\u043A\u0430
      \u0434\u0435\u0448\u0435\u0432\u043B\u0435 \u0440\u0435\u043C\u043E\u043D\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572848
    m_Localized: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0432\u043E\u0439\u043B\u043E\u0447\u043D\u044B\u0435
      \u0443\u043F\u043B\u043E\u0442\u043D\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572849
    m_Localized: "\u041F\u043B\u043E\u0442\u043D\u0438\u043A \u0432\u044B\u0440\u0435\u0437\u0430\u043B
      \u043A\u043E\u043B\u044C\u0446\u0430 \u0438\u0437 \u0432\u043E\u0439\u043B\u043E\u043A\u0430
      \u0438 \u043D\u0430\u0431\u0438\u043B \u0438\u0445 \u0432 \u0437\u0430\u0437\u043E\u0440\u044B
      \u0441\u0442\u0443\u043F\u0438\u0446. \u0425\u0438\u0442\u0440\u043E\u0441\u0442\u044C
      \u043F\u0440\u043E\u0441\u0442\u0430\u044F, \u043D\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F.
      \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u0442\u0440\u0438 \u0434\u043D\u044F
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u0448\u043B\u0430 \u0431\u0435\u0437
      \u0441\u043A\u0440\u0438\u043F\u0430. \u0412\u043E\u0439\u043B\u043E\u043A
      \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u0441\u043E\u0442\u0440\u0451\u0442\u0441\u044F,
      \u043D\u043E \u0441\u0435\u0439\u0447\u0430\u0441 - \u043F\u043E\u0440\u044F\u0434\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572850
    m_Localized: "\u0412\u043E\u0439\u043B\u043E\u043A \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0433\u0440\u0443\u0431\u044B\u043C
      - \u0432\u043C\u0435\u0441\u0442\u043E \u0443\u043F\u043B\u043E\u0442\u043D\u0435\u043D\u0438\u044F
      \u043E\u043D \u0435\u0449\u0451 \u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043B
      \u043F\u0435\u0441\u043E\u043A \u0432\u043D\u0443\u0442\u0440\u0438. \u0425\u0440\u0443\u0441\u0442
      \u0443\u0441\u0438\u043B\u0438\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572851
    m_Localized: "\u0417\u0430\u043C\u0435\u0434\u043B\u0438\u0442\u044C \u0442\u0435\u043C\u043F
      \u0438 \u0447\u0438\u0441\u0442\u0438\u0442\u044C \u043A\u0430\u0436\u0434\u044B\u0439
      \u0432\u0435\u0447\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572852
    m_Localized: "\u0412\u044B \u0432\u0432\u0435\u043B\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u043E:
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0432\u0435\u0447\u0435\u0440 - \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430
      \u0441\u0442\u0443\u043F\u0438\u0446. \u0422\u0435\u043C\u043F \u0443\u043F\u0430\u043B
      \u043D\u0435\u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0437\u0430\u0442\u043E \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u0434\u043E\u0448\u043B\u0430
      \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u0430
      \u0431\u0435\u0437 \u043F\u043E\u043B\u043E\u043C\u043A\u0438. \u0414\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0430
      \u0432\u0430\u0436\u043D\u0435\u0435 \u0441\u043F\u0435\u0448\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572853
    m_Localized: "\u041F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u0430\u044F \u043F\u043E\u0434\u043A\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572854
    m_Localized: "\u041D\u0430 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0439 \u0442\u0440\u043E\u043F\u0435
      \u043E\u0434\u043D\u0430 \u0438\u0437 \u043B\u043E\u0448\u0430\u0434\u0435\u0439
      \u043D\u0430\u0447\u0430\u043B\u0430 \u0445\u0440\u043E\u043C\u0430\u0442\u044C.
      \u041A\u0443\u0437\u043D\u0435\u0446 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u043A\u043E\u043F\u044B\u0442\u043E: \u043F\u043E\u0434\u043A\u043E\u0432\u0430
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u0430, \u043A\u043E\u043F\u044B\u0442\u043E
      \u0443\u0436\u0435 \u0441\u0442\u0451\u0441\u0430\u043D\u043E \u043E \u043A\u0430\u043C\u043D\u0438.
      \u0417\u0430\u043F\u0430\u0441\u043D\u044B\u0445 \u043F\u043E\u0434\u043A\u043E\u0432
      \u043D\u0435\u0442 - \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u043F\u0440\u0438
      \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0435. \u0412\u043F\u0435\u0440\u0435\u0434\u0438
      \u0435\u0449\u0451 \u0442\u0440\u0438 \u0434\u043D\u044F \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572855
    m_Localized: "\u041E\u0431\u043C\u043E\u0442\u0430\u0442\u044C \u043A\u043E\u043F\u044B\u0442\u043E
      \u043A\u043E\u0436\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572856
    m_Localized: "\u041A\u0443\u0441\u043E\u043A \u0437\u0430\u0434\u0443\u0431\u0435\u043B\u043E\u0439
      \u0432\u043E\u043B\u043E\u0432\u044C\u0435\u0439 \u043A\u043E\u0436\u0438 \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0438
      \u0432\u043E\u043A\u0440\u0443\u0433 \u043A\u043E\u043F\u044B\u0442\u0430 \u0438
      \u0437\u0430\u043A\u0440\u0435\u043F\u0438\u043B\u0438 \u0431\u0435\u0447\u0435\u0432\u043E\u0439.
      \u0412\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439 \u0431\u0430\u0448\u043C\u0430\u043A.
      \u041B\u043E\u0448\u0430\u0434\u044C \u0432\u0441\u0451 \u0435\u0449\u0451
      \u043F\u0440\u0438\u0445\u0440\u0430\u043C\u044B\u0432\u0430\u0435\u0442, \u043D\u043E
      \u0438\u0434\u0451\u0442. \u0417\u0430\u043C\u0435\u043D\u0443 \u043C\u0435\u043D\u044F\u044E\u0442
      \u0440\u0430\u0437 \u0432 \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572857
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u043A\u0443\u0437\u043D\u0435\u0446\u0430
      \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0435 \u0432\u043F\u0435\u0440\u0435\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572858
    m_Localized: "\u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0432 \u0434\u043D\u0435 \u043F\u0443\u0442\u0438. \u0422\u0430\u043C \u0431\u044B\u043B
      \u043C\u0430\u0441\u0442\u0435\u0440 - \u043C\u043E\u043D\u0430\u0445, \u0437\u043D\u0430\u0432\u0448\u0438\u0439
      \u043A\u0443\u0437\u043D\u0435\u0447\u043D\u043E\u0435 \u0434\u0435\u043B\u043E.
      \u041F\u043E\u0434\u043A\u043E\u0432\u0443 \u0432\u044B\u043A\u043E\u0432\u0430\u043B\u0438
      \u0438\u0437 \u043E\u0441\u0442\u0430\u0442\u043A\u043E\u0432 \u0436\u0435\u043B\u0435\u0437\u0430.
      \u041B\u043E\u0448\u0430\u0434\u044C \u0441\u043D\u043E\u0432\u0430 \u0432
      \u0441\u0442\u0440\u043E\u044E. \u041C\u043E\u043D\u0430\u0445\u0443 \u043E\u0442\u0434\u0430\u043B\u0438
      \u0441\u0432\u0435\u0447\u0438 \u0432 \u0434\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572859
    m_Localized: "\u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0437\u0430\u0431\u0440\u043E\u0448\u0435\u043D. \u041F\u0443\u0441\u0442\u044B\u0435
      \u043A\u0435\u043B\u044C\u0438, \u043F\u043E\u043A\u043E\u0441\u0438\u0432\u0448\u0438\u0435\u0441\u044F
      \u0432\u043E\u0440\u043E\u0442\u0430. \u041A\u0443\u0437\u043D\u0435\u0446\u0430
      \u043D\u0435\u0442. \u0412\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u043A \u043A\u043E\u0436\u0435 \u0438 \u0431\u0435\u0447\u0435\u0432\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572860
    m_Localized: "\u041F\u0443\u0441\u0442\u0438\u0442\u044C \u043B\u043E\u0448\u0430\u0434\u044C
      \u0432 \u0430\u0440\u044C\u0435\u0440\u0433\u0430\u0440\u0434 \u043D\u0430\u043B\u0435\u0433\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572861
    m_Localized: "\u0413\u0440\u0443\u0437 \u0441 \u043B\u043E\u0448\u0430\u0434\u0438
      \u043F\u0435\u0440\u0435\u043B\u043E\u0436\u0438\u043B\u0438 \u043D\u0430 \u043C\u0443\u043B\u043E\u0432.
      \u0411\u0435\u0437 \u0432\u044C\u044E\u043A\u0430 \u043E\u043D\u0430 \u0448\u043B\u0430
      \u043B\u0435\u0433\u0447\u0435 \u0438 \u043D\u0435 \u043E\u0442\u0441\u0442\u0430\u0432\u0430\u043B\u0430.
      \u041A \u0433\u043E\u0440\u043E\u0434\u0443 \u0434\u043E\u0448\u043B\u0430
      \u0441\u0430\u043C\u0430 - \u0442\u0430\u043C \u0435\u0451 \u043F\u043E\u0434\u043A\u043E\u0432\u0430\u043B
      \u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u043A\u0443\u0437\u043D\u0435\u0446."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572862
    m_Localized: "\u0413\u043D\u0438\u043B\u044B\u0435 \u0432\u0435\u0440\u0451\u0432\u043A\u0438
      \u0432\u044C\u044E\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572863
    m_Localized: "\u0412\u043B\u0430\u0433\u0430 \u0433\u043E\u0440\u043D\u044B\u0445
      \u0443\u0449\u0435\u043B\u0438\u0439 \u0441\u0434\u0435\u043B\u0430\u043B\u0430
      \u0441\u0432\u043E\u0451: \u0432\u0435\u0440\u0451\u0432\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438
      \u0441\u0442\u044F\u043D\u0443\u0442\u044B \u0442\u044E\u043A\u0438, \u043F\u043E\u0442\u0435\u043C\u043D\u0435\u043B\u0438
      \u0438 \u043D\u0430 \u043E\u0449\u0443\u043F\u044C \u0441\u043A\u043E\u043B\u044C\u0437\u043A\u0438\u0435.
      \u041E\u0434\u043D\u0430 \u0443\u0436\u0435 \u043B\u043E\u043F\u043D\u0443\u043B\u0430
      - \u0442\u044E\u043A \u0435\u0434\u0432\u0430 \u043D\u0435 \u0443\u043B\u0435\u0442\u0435\u043B
      \u0432 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u043D\u0435 \u043B\u0443\u0447\u0448\u0435. \u0413\u043E\u0440\u043D\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0435\u0449\u0451 \u0434\u043D\u044F
      \u0434\u0432\u0430, \u0438 \u043F\u043E\u0434 \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u043E\u0439
      \u043D\u0430 \u043F\u043E\u0434\u044A\u0451\u043C\u0430\u0445 \u043E\u043D\u0438
      \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572864
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u0442\u044C \u0432\u0441\u0435
      \u0442\u044E\u043A\u0438 \u043D\u043E\u0432\u044B\u043C\u0438 \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572865
    m_Localized: "\u0418\u0437 \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0433\u043E
      \u043C\u043E\u0442\u043A\u0430 \u043D\u0430\u0440\u0435\u0437\u0430\u043B\u0438
      \u043D\u043E\u0432\u044B\u0435 \u0432\u0435\u0440\u0451\u0432\u043A\u0438.
      \u0427\u0430\u0441 \u0440\u0430\u0431\u043E\u0442\u044B, \u0437\u0430\u0442\u043E
      \u0432\u0441\u0435 \u0442\u044E\u043A\u0438 \u0437\u0430\u0442\u044F\u043D\u0443\u0442\u044B
      \u043D\u0430\u0434\u0451\u0436\u043D\u043E. \u0413\u043E\u0440\u043D\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430 \u043F\u0440\u043E\u0448\u043B\u0430 \u0431\u0435\u0437
      \u043F\u0440\u043E\u0438\u0441\u0448\u0435\u0441\u0442\u0432\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572866
    m_Localized: "\u0423\u0441\u0438\u043B\u0438\u0442\u044C \u0441\u043B\u0430\u0431\u044B\u0435
      \u043C\u0435\u0441\u0442\u0430 \u043A\u043E\u043D\u043E\u043F\u043B\u044F\u043D\u043E\u0439
      \u0432\u0435\u0440\u0451\u0432\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572867
    m_Localized: "\u041F\u0440\u043E\u0448\u043B\u0438\u0441\u044C \u043F\u043E \u043A\u0430\u0436\u0434\u043E\u043C\u0443
      \u0442\u044E\u043A\u0443, \u043D\u0430\u0448\u043B\u0438 \u0441\u0430\u043C\u044B\u0435
      \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u043C\u0435\u0441\u0442\u0430 \u0438 \u0443\u0434\u0432\u043E\u0438\u043B\u0438
      \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435. \u0411\u044B\u0441\u0442\u0440\u0435\u0435,
      \u0447\u0435\u043C \u043F\u043E\u043B\u043D\u0430\u044F \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u043A\u0430.
      \u041E\u0434\u0438\u043D \u0442\u044E\u043A \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u043E\u0441\u043B\u0430\u0431 \u043D\u0430 \u0441\u043F\u0443\u0441\u043A\u0435
      - \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0438\u043B\u0438 \u0432\u043E\u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572868
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u0432\u0441\u0435 \u0441\u043B\u0430\u0431\u044B\u0435
      \u043C\u0435\u0441\u0442\u0430 \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      - \u0432\u0435\u0440\u0451\u0432\u043A\u0438 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u0438
      \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E. \u0414\u0432\u0430
      \u0442\u044E\u043A\u0430 \u0441\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0438
      \u043D\u0430 \u043A\u0440\u0443\u0442\u043E\u043C \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0435.
      \u0413\u0440\u0443\u0437 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0451\u043D
      \u0441\u043B\u0435\u0433\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572869
    m_Localized: "\u0423\u043C\u0435\u043D\u044C\u0448\u0438\u0442\u044C \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0443:
      \u0447\u0430\u0441\u0442\u044C \u0442\u044E\u043A\u043E\u0432 \u043D\u0430
      \u0440\u0443\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572870
    m_Localized: "\u0421\u0430\u043C\u044B\u0435 \u0442\u044F\u0436\u0451\u043B\u044B\u0435
      \u0442\u044E\u043A\u0438 \u043D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0438
      \u043D\u0435\u0441\u043B\u0438 \u043D\u0430 \u0440\u0443\u043A\u0430\u0445
      \u0447\u0435\u0440\u0435\u0437 \u043E\u0441\u043E\u0431\u043E \u043E\u043F\u0430\u0441\u043D\u044B\u0435
      \u0443\u0447\u0430\u0441\u0442\u043A\u0438. \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u043E,
      \u043D\u043E \u043D\u0430\u0434\u0451\u0436\u043D\u043E. \u041A \u043D\u043E\u0447\u0451\u0432\u043A\u0435
      - \u0432\u0441\u0435 \u0446\u0435\u043B\u044B, \u0432\u0435\u0440\u0451\u0432\u043A\u0438
      \u0437\u0430\u043C\u0435\u043D\u0438\u043B\u0438 \u0432 \u043B\u0430\u0433\u0435\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572871
    m_Localized: "\u0420\u0435\u043C\u043E\u043D\u0442 \u0432 \u0441\u043D\u0435\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572872
    m_Localized: "\u0421\u043D\u0435\u0433\u043E\u043F\u0430\u0434 \u043D\u0430\u0447\u0430\u043B\u0441\u044F
      \u0432 \u043F\u043E\u043B\u0434\u0435\u043D\u044C \u0438 \u043A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0437\u0430\u0432\u0430\u043B\u0438\u043B \u043B\u0430\u0433\u0435\u0440\u044C
      \u043F\u043E \u043A\u043E\u043B\u0435\u043D\u043E. \u041F\u043E\u0434 \u0442\u044F\u0436\u0435\u0441\u0442\u044C\u044E
      \u0441\u043D\u0435\u0433\u0430 \u043B\u043E\u043F\u043D\u0443\u043B\u0430 \u0436\u0435\u0440\u0434\u044C
      \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0448\u0430\u0442\u0440\u0430:
      \u043A\u0440\u043E\u0432 \u043F\u0440\u043E\u0432\u0438\u0441. \u0420\u0443\u043A\u0438
      \u0443 \u043F\u043B\u043E\u0442\u043D\u0438\u043A\u0430 \u043A\u043E\u0447\u0435\u043D\u0435\u044E\u0442
      \u0447\u0435\u0440\u0435\u0437 \u043C\u0438\u043D\u0443\u0442\u0443 \u0440\u0430\u0431\u043E\u0442\u044B
      \u043D\u0430 \u043C\u043E\u0440\u043E\u0437\u0435. \u041F\u043E\u0447\u0438\u043D\u0438\u0442\u044C
      \u043D\u0430\u0434\u043E \u0441\u0435\u0439\u0447\u0430\u0441, \u0438\u043D\u0430\u0447\u0435
      \u043A \u0443\u0442\u0440\u0443 \u0448\u0430\u0442\u0451\u0440 \u0441\u043B\u043E\u0436\u0438\u0442\u0441\u044F
      \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572873
    m_Localized: "\u0427\u0438\u043D\u0438\u0442\u044C \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572874
    m_Localized: "\u041F\u043E \u0442\u0440\u043E\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u043B\u0438
      \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0436\u0434\u0430\u043B\u0438 \u0443 \u043E\u0433\u043D\u044F. \u041A\u0430\u0436\u0434\u044B\u0435
      \u043F\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442: \u0441\u043C\u0435\u043D\u0430.
      \u0428\u0430\u0442\u0451\u0440 \u043F\u043E\u0447\u0438\u043D\u0438\u043B\u0438
      \u0437\u0430 \u0447\u0430\u0441. \u0420\u0443\u043A\u0438 \u0446\u0435\u043B\u044B,
      \u043A\u0440\u043E\u0432 \u0446\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572875
    m_Localized: "\u0423\u043A\u0440\u0435\u043F\u0438\u0442\u044C \u0448\u0435\u0441\u0442\u043E\u043C
      \u0438\u0437 \u043D\u0430\u0440\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572876
    m_Localized: "\u0418\u0437 \u0441\u0430\u043D\u0435\u0439 \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438
      \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0439 \u043F\u043E\u043B\u043E\u0437
      \u0438 \u043F\u043E\u0434\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u043F\u043E\u0434
      \u043F\u0440\u043E\u0432\u0438\u0441\u0448\u0438\u0439 \u043A\u0440\u043E\u0432.
      \u041D\u0435 \u043A\u0440\u0430\u0441\u0438\u0432\u043E, \u043D\u043E \u0434\u0435\u0440\u0436\u0438\u0442.
      \u0414\u043E \u0443\u0442\u0440\u0430 \u0434\u043E\u0442\u044F\u043D\u0443\u043B\u0438,
      \u0430 \u0441 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u043E\u043C \u043D\u0430\u0440\u0435\u0437\u0430\u043B\u0438
      \u043D\u043E\u0432\u0443\u044E \u0436\u0435\u0440\u0434\u044C \u0438\u0437
      \u0441\u0443\u0445\u043E\u0441\u0442\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572877
    m_Localized: "\u041F\u043E\u043B\u043E\u0437 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C: \u043D\u0435 \u0434\u043E\u0441\u0442\u0430\u043B
      \u0434\u043E \u043A\u043E\u043D\u044C\u043A\u0430. \u041F\u043E\u043A\u0430
      \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u043B\u0438 \u0437\u0430\u043C\u0435\u043D\u0443,
      \u0441\u043D\u0435\u0433 \u043D\u0430\u0432\u0430\u043B\u0438\u043B \u0435\u0449\u0451.
      \u041F\u0440\u043E\u0432\u0438\u0441 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572878
    m_Localized: "\u041F\u0435\u0440\u0435\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0432 \u043E\u0434\u043D\u0443 \u043F\u0430\u043B\u0430\u0442\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572879
    m_Localized: "\u0412\u0441\u0435 \u043D\u0430\u0431\u0438\u043B\u0438\u0441\u044C
      \u0432 \u043C\u0435\u043D\u044C\u0448\u0438\u0439 \u0448\u0430\u0442\u0451\u0440.
      \u0422\u0435\u0441\u043D\u043E, \u043A\u0430\u043A \u0432 \u0431\u043E\u0447\u043A\u0435
      \u0441 \u0441\u0435\u043B\u044C\u0434\u044C\u044E, \u0437\u0430\u0442\u043E
      \u0442\u0435\u043F\u043B\u043E. \u0421\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u0439
      \u0448\u0430\u0442\u0451\u0440 \u043F\u043E\u0447\u0438\u043D\u0438\u043B\u0438
      \u0443\u0442\u0440\u043E\u043C \u043D\u0430 \u0441\u0432\u0435\u0436\u0443\u044E
      \u0433\u043E\u043B\u043E\u0432\u0443. \u041E\u0434\u043D\u0430 \u043D\u043E\u0447\u044C
      \u0442\u0435\u0441\u043D\u043E\u0442\u044B: \u043D\u0435 \u0431\u0435\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572880
    m_Localized: "\u0421\u043F\u043E\u0440 \u0438\u0437-\u0437\u0430 \u043C\u0435\u0441\u0442\u0430
      \u0443 \u043A\u043E\u0441\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572881
    m_Localized: "\u0414\u0432\u043E\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0443\u0436\u0435 \u0441\u0442\u043E\u044F\u0442 \u0434\u0440\u0443\u0433
      \u043F\u0440\u043E\u0442\u0438\u0432 \u0434\u0440\u0443\u0433\u0430: \u043A\u0443\u043B\u0430\u043A\u0438
      \u0441\u0436\u0430\u0442\u044B, \u0433\u043E\u043B\u043E\u0441\u0430 \u0433\u0440\u043E\u043C\u043A\u0438\u0435.
      \u041E\u0434\u0438\u043D \u0437\u0430\u043D\u044F\u043B \u043B\u0443\u0447\u0448\u0435\u0435
      \u043C\u0435\u0441\u0442\u043E \u0443 \u043A\u043E\u0441\u0442\u0440\u0430,
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u0447\u0442\u043E \u043E\u043D\u043E \u0435\u0433\u043E \u043F\u043E \u0443\u0433\u043E\u0432\u043E\u0440\u0443.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044E\u0442.
      \u0415\u0441\u043B\u0438 \u043D\u0435 \u0432\u043C\u0435\u0448\u0430\u0442\u044C\u0441\u044F,
      \u043A \u0443\u0442\u0440\u0443 \u0431\u0443\u0434\u0435\u0442 \u0441\u0438\u043D\u044F\u043A,
      \u0430 \u0442\u043E \u0438 \u0445\u0443\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572882
    m_Localized: "\u0420\u0430\u0441\u0441\u0443\u0434\u0438\u0442\u044C \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E
      \u043F\u0440\u0438 \u0432\u0441\u0435\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572883
    m_Localized: "\u0412\u044B \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B\u0438
      \u043E\u0431\u043E\u0438\u0445, \u043D\u0435 \u043F\u0435\u0440\u0435\u0431\u0438\u0432\u0430\u044F.
      \u0420\u0435\u0448\u0435\u043D\u0438\u0435 \u0432\u044B\u043D\u0435\u0441\u043B\u0438
      \u043F\u0440\u043E\u0441\u0442\u043E: \u043C\u0435\u0441\u0442\u0430 \u0443
      \u043A\u043E\u0441\u0442\u0440\u0430 \u0434\u0435\u043B\u0438\u0442\u044C \u043F\u043E\u0440\u043E\u0432\u043D\u0443,
      \u0441\u0442\u0430\u0440\u0448\u0438\u043D\u0441\u0442\u0432\u0430 \u043D\u0435\u0442.
      \u041E\u0431\u0430 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0438\u0441\u044C,
      \u0445\u043E\u0442\u044F \u0438 \u043D\u0435\u043E\u0445\u043E\u0442\u043D\u043E.
      \u041D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u0441\u043F\u0430\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572884
    m_Localized: "\u0417\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043E\u0431\u043E\u0438\u0445
      \u043D\u0435\u0441\u0442\u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
      \u0432\u0430\u0445\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572885
    m_Localized: "\xAB\u0425\u043E\u0442\u0438\u0442\u0435 \u0440\u0443\u0433\u0430\u0442\u044C\u0441\u044F,
      \u0440\u0443\u0433\u0430\u0439\u0442\u0435\u0441\u044C \u0443 \u0432\u043D\u0435\u0448\u043D\u0435\u0433\u043E
      \u043F\u0435\u0440\u0438\u043C\u0435\u0442\u0440\u0430, \u0441 \u043A\u043E\u043F\u044C\u0451\u043C
      \u0432 \u0440\u0443\u043A\u0430\u0445.\xBB \u041E\u0431\u0430 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438
      \u043F\u043E \u0442\u0440\u0438 \u0447\u0430\u0441\u0430 \u0434\u043E\u0437\u043E\u0440\u0430.
      \u041D\u0430\u0443\u0442\u0440\u043E \u043C\u0438\u0440\u0438\u043B\u0438\u0441\u044C
      \u043C\u043E\u043B\u0447\u0430, \u043D\u043E \u043A\u0440\u0435\u043F\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572886
    m_Localized: "\u041D\u0430\u043A\u0430\u0437\u0430\u043D\u0438\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u0443\u0440\u043E\u0432\u044B\u043C
      - \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0437\u0430\u0448\u0435\u043F\u0442\u0430\u043B\u0438\u0441\u044C \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E.
      \u0414\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0430,
      \u043D\u043E \u0441\u0438\u043C\u043F\u0430\u0442\u0438\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572887
    m_Localized: "\u0418\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C:
      \u043F\u0443\u0441\u0442\u044C \u0441\u0430\u043C\u0438 \u0440\u0430\u0437\u0431\u0435\u0440\u0443\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572888
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u043E\u0434\u0438\u043D
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0440\u0430\u0437\u0431\u0438\u0442\u044B\u0439
      \u043D\u043E\u0441, \u0432\u0442\u043E\u0440\u043E\u0439 \u0440\u0430\u0441\u0446\u0430\u0440\u0430\u043F\u0430\u043D\u043D\u0443\u044E
      \u0440\u0443\u043A\u0443. \u041E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F
      \u0438\u0441\u043F\u043E\u0440\u0447\u0435\u043D\u044B \u043D\u0430\u0434\u043E\u043B\u0433\u043E.
      \u041B\u0430\u0433\u0435\u0440\u044C \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u043B\u0441\u044F
      \u043D\u0430 \u0434\u0432\u0430 \u043B\u0430\u0433\u0435\u0440\u044F. \u041D\u0435\u0432\u043C\u0435\u0448\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u043E\u0431\u043E\u0448\u043B\u043E\u0441\u044C \u0434\u043E\u0440\u043E\u0436\u0435,
      \u0447\u0435\u043C \u0441\u043B\u043E\u0432\u043E \u0432\u043E\u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572889
    m_Localized: "\u0421\u043E\u043D\u043D\u044B\u0439 \u0447\u0430\u0441\u043E\u0432\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572890
    m_Localized: "\u041E\u0431\u0445\u043E\u0434\u044F \u043B\u0430\u0433\u0435\u0440\u044C
      \u043F\u0435\u0440\u0435\u0434 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u043E\u043C,
      \u0432\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435 \u0447\u0430\u0441\u043E\u0432\u043E\u0433\u043E
      - \u043E\u043D \u0441\u043F\u0438\u0442 \u0441\u0438\u0434\u044F, \u043A\u043E\u043F\u044C\u0451
      \u043F\u0440\u0438\u0441\u043B\u043E\u043D\u0435\u043D\u043E \u043A \u0431\u0435\u0434\u0440\u0443.
      \u0421\u0442\u0435\u043F\u044C \u0442\u0438\u0445\u0430, \u043D\u0438\u043A\u0430\u043A\u043E\u0439
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u043D\u0435 \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C.
      \u041D\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u043E \u0435\u0441\u0442\u044C
      \u043F\u0440\u0430\u0432\u0438\u043B\u043E: \u0443\u0441\u043D\u0443\u0442\u044C
      \u043D\u0430 \u043F\u043E\u0441\u0442\u0443 - \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u044B\u0439
      \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u043E\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0432\u0438\u0434\u0435\u043B\u0438
      \u0438\u043B\u0438 \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0443\u0437\u043D\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572891
    m_Localized: "\u0420\u0430\u0437\u0431\u0443\u0434\u0438\u0442\u044C \u0438 \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u043E
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572892
    m_Localized: "\u0412\u044B \u043F\u043D\u0443\u043B\u0438 \u0435\u0433\u043E
      \u043D\u043E\u0433\u0443. \u041E\u043D \u0432\u0441\u043A\u043E\u0447\u0438\u043B,
      \u043B\u0438\u0446\u043E \u043A\u0440\u0430\u0441\u043D\u043E\u0435. \u041F\u0440\u0438
      \u0432\u0441\u0435\u0445 \u043E\u0431\u044A\u044F\u0432\u0438\u043B\u0438:
      \u0435\u0449\u0451 \u0440\u0430\u0437 - \u0438 \u0438\u0437 \u043E\u0445\u0440\u0430\u043D\u044B
      \u0443\u0432\u043E\u043B\u0435\u043D. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438 \u043D\u0435 \u0441\u043F\u0430\u043B\u0438
      \u043E\u0441\u0442\u0430\u0442\u043E\u043A \u043D\u043E\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572893
    m_Localized: "\u0422\u0438\u0445\u043E \u0440\u0430\u0437\u0431\u0443\u0434\u0438\u0442\u044C
      \u0438 \u043F\u0440\u043E\u0441\u0442\u0438\u0442\u044C \u043D\u0430 \u043F\u0435\u0440\u0432\u044B\u0439
      \u0440\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572894
    m_Localized: "\u0412\u044B \u0442\u0440\u043E\u043D\u0443\u043B\u0438 \u0435\u0433\u043E
      \u0437\u0430 \u043F\u043B\u0435\u0447\u043E, \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u044F
      \u043D\u0438 \u0441\u043B\u043E\u0432\u0430. \u041E\u043D \u043F\u043E\u043D\u044F\u043B.
      \u0414\u043E \u0443\u0442\u0440\u0430 \u043F\u0440\u043E\u0441\u0442\u043E\u044F\u043B
      \u043A\u0430\u043A \u0432\u043A\u043E\u043F\u0430\u043D\u043D\u044B\u0439,
      \u0431\u043B\u0435\u0434\u043D\u044B\u0439. \u041E\u0448\u0438\u0431\u043A\u0430
      \u0443\u0447\u0442\u0435\u043D\u0430, \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u043E
      \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572895
    m_Localized: "\u0421\u043B\u0443\u0445 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u0440\u0430\u0437\u043E\u0448\u0451\u043B\u0441\u044F \u043F\u043E \u043B\u0430\u0433\u0435\u0440\u044E.
      \u0414\u0440\u0443\u0433\u0438\u0435 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438
      \u0440\u0435\u0448\u0438\u043B\u0438, \u0447\u0442\u043E \u043C\u043E\u0436\u043D\u043E
      \u0438 \u0438\u043C - \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0440\u0430\u0441\u0448\u0430\u0442\u0430\u043D
      \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0439 \u043C\u044F\u0433\u043A\u043E\u0441\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572896
    m_Localized: "\u041D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0443\u0432\u043E\u043B\u0438\u0442\u044C
      \u0438\u0437 \u043E\u0445\u0440\u0430\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572897
    m_Localized: "\u0420\u0435\u0448\u0435\u043D\u0438\u0435 \u0436\u0451\u0441\u0442\u043A\u043E\u0435,
      \u043D\u043E \u0447\u0435\u0441\u0442\u043D\u043E\u0435. \u0412\u0441\u0435
      \u0432\u0438\u0434\u0435\u043B\u0438, \u0447\u0442\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u043E
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442. \u0417\u0430\u043C\u0435\u043D\u0443
      \u043D\u0430\u0448\u043B\u0438 \u0441\u0440\u0435\u0434\u0438 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u043A \u0443\u0442\u0440\u0443. \u0423\u0432\u043E\u043B\u0435\u043D\u043D\u044B\u0439
      \u0448\u0451\u043B \u0432 \u0445\u0432\u043E\u0441\u0442\u0435 \u043E\u0431\u043E\u0437\u0430
      \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C \u043C\u043E\u043B\u0447\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572898
    m_Localized: "\u041C\u0430\u0440\u043E\u0434\u0451\u0440\u0441\u0442\u0432\u043E
      \u0432 \u043B\u0430\u0433\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572899
    m_Localized: "\u0423\u0442\u0440\u043E\u043C \u043E\u0434\u0438\u043D \u0438\u0437
      \u043D\u043E\u0432\u044B\u0445 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0435\u0442 \u043F\u0440\u043E\u043F\u0430\u0436\u0443:
      \u043A\u043E\u0448\u0435\u043B\u044C \u0441 \u043C\u0435\u0434\u044F\u043A\u0430\u043C\u0438
      \u0438\u0441\u0447\u0435\u0437 \u0438\u0437-\u043F\u043E\u0434 \u043D\u0430\u043A\u0438\u0434\u043A\u0438.
      \u041F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0435 \u043F\u0430\u0434\u0430\u0435\u0442
      \u043D\u0430 \u0441\u043E\u0441\u0435\u0434\u0430 \u043F\u043E \u0448\u0430\u0442\u0440\u0443.
      \u0423\u043B\u0438\u043A \u043F\u0440\u044F\u043C\u044B\u0445 \u043D\u0435\u0442,
      \u043D\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E
      \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0445 \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0439.
      \u041B\u0430\u0433\u0435\u0440\u044C \u043D\u0430\u043F\u0440\u044F\u0436\u0451\u043D
      - \u0435\u0441\u043B\u0438 \u043D\u0435 \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C,
      \u0432\u043E\u0440\u043E\u0432\u0441\u0442\u0432\u043E \u0441\u0442\u0430\u043D\u0435\u0442
      \u043D\u043E\u0440\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572900
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u043E\u0431\u044B\u0441\u043A
      \u043E\u0442\u043A\u0440\u044B\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572901
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E
      \u0432\u0441\u0435\u0445 \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u043E.
      \u041A\u043E\u0448\u0435\u043B\u044C \u043D\u0430\u0448\u043B\u0438 \u0432
      \u0442\u044E\u0444\u044F\u043A\u0435 \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u043C\u043E\u0433\u043E.
      \u0422\u043E\u0442 \u043D\u0435 \u043E\u0442\u043F\u0438\u0440\u0430\u043B\u0441\u044F
      \u0434\u043E\u043B\u0433\u043E. \u041D\u0430\u043A\u0430\u0437\u0430\u043D\u0438\u0435:
      \u0434\u043E \u0433\u043E\u0440\u043E\u0434\u0430 \u043D\u0435\u0441\u0451\u0442
      \u0434\u0432\u043E\u0439\u043D\u0443\u044E \u043D\u043E\u0448\u0443. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572902
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u043C\u044B\u043C
      \u043D\u0430\u0435\u0434\u0438\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572903
    m_Localized: "\u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u043E\u0434\u0438\u043D
      \u043D\u0430 \u043E\u0434\u0438\u043D \u0434\u0430\u043B \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442:
      \u0432\u0438\u043D\u043E\u0432\u043D\u044B\u0439 \u0432\u0435\u0440\u043D\u0443\u043B
      \u043C\u043E\u043D\u0435\u0442\u044B \u0438 \u043F\u0440\u0438\u0437\u043D\u0430\u043B\u0441\u044F
      - \u043D\u0443\u0436\u0434\u0430, \u043D\u0435 \u0437\u043B\u043E\u0439 \u0443\u043C\u044B\u0441\u0435\u043B.
      \u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C \u043D\u0430
      \u0432\u044B\u0447\u0435\u0442 \u0438\u0437 \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u044F.
      \u0414\u0435\u043B\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u043E \u0431\u0435\u0437
      \u043E\u0433\u043B\u0430\u0441\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572904
    m_Localized: "\u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0437\u0430\u0448\u0451\u043B
      \u0432 \u0442\u0443\u043F\u0438\u043A. \u0422\u043E\u0442 \u043E\u0442\u0440\u0438\u0446\u0430\u043B.
      \u0423\u043B\u0438\u043A \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u043B\u043E,
      \u0432\u0438\u043D\u043E\u0432\u043D\u043E\u0433\u043E \u043D\u0435 \u043D\u0430\u0448\u043B\u0438.
      \u041F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u0432\u0448\u0438\u0439 \u0437\u043B\u0438\u0442\u0441\u044F,
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043D\u0435\u0440\u0432\u043D\u0438\u0447\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572905
    m_Localized: "\u041E\u0431\u044A\u044F\u0432\u0438\u0442\u044C \u043E\u0431\u0449\u0438\u0439
      \u0448\u0442\u0440\u0430\u0444: \u0432\u0441\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u044E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572906
    m_Localized: "\xAB\u041F\u043E\u043A\u0430 \u0432\u0438\u043D\u043E\u0432\u043D\u044B\u0439
      \u043D\u0435 \u043E\u0431\u044A\u044F\u0432\u0438\u0442\u0441\u044F - \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u0435
      \u0432\u0441\u0435\u043C \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442\u0441\u044F.\xBB
      \u0427\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u0447\u0430\u0441\u0430
      \u0432\u0438\u043D\u043E\u0432\u043D\u044B\u0439 \u0441\u0430\u043C \u043F\u0440\u0438\u0448\u0451\u043B
      \u043F\u0440\u0438\u0437\u043D\u0430\u0432\u0430\u0442\u044C\u0441\u044F: \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u043A\u043E\u043B\u043B\u0435\u043A\u0442\u0438\u0432\u0430 \u0441\u0434\u0435\u043B\u0430\u043B\u043E
      \u0441\u0432\u043E\u0451. \u041C\u0435\u0442\u043E\u0434 \u0436\u0451\u0441\u0442\u043A\u0438\u0439,
      \u043D\u043E \u0431\u044B\u0441\u0442\u0440\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572907
    m_Localized: "\u041D\u0435\u0445\u0432\u0430\u0442\u043A\u0430 \u0432\u043E\u0434\u044B:
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0440\u0430\u0437\u0434\u0430\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572908
    m_Localized: "\u041F\u043E\u043B\u0434\u0435\u043D\u044C. \u0416\u0430\u0440\u0430
      \u0441\u0442\u043E\u0438\u0442 \u0441\u0442\u0435\u043D\u043E\u0439. \u041E\u0434\u0438\u043D
      \u0438\u0437 \u0431\u0443\u0440\u0434\u044E\u043A\u043E\u0432 \u043F\u043E\u0442\u0451\u043A
      \u043D\u043E\u0447\u044C\u044E: \u043F\u043E\u0442\u0435\u0440\u0438 \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u044B\u0435,
      \u043D\u043E \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435. \u041E\u0441\u0442\u0430\u0432\u0448\u0435\u0439\u0441\u044F
      \u0432\u043E\u0434\u044B \u043D\u0430 \u043F\u043E\u043B\u0442\u043E\u0440\u0430
      \u0434\u043D\u044F, \u0430 \u0434\u043E \u043E\u0430\u0437\u0438\u0441\u0430
      \u0434\u0432\u0430. \u041B\u044E\u0434\u0438 \u0443\u0436\u0435 \u043F\u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E\u0442
      \u043D\u0430 \u0447\u0443\u0436\u0438\u0435 \u0431\u0443\u0440\u0434\u044E\u043A\u0438.
      \u0411\u0435\u0437 \u0447\u0451\u0442\u043A\u043E\u0433\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0430
      \u0440\u0430\u0437\u0434\u0430\u0447\u0438 \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F
      \u0442\u043E, \u0447\u0435\u0433\u043E \u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572909
    m_Localized: "\u0412\u0432\u0435\u0441\u0442\u0438 \u0441\u0442\u0440\u043E\u0433\u0443\u044E
      \u043D\u043E\u0440\u043C\u0443 \u0434\u043B\u044F \u0432\u0441\u0435\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572910
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0440\u043E\u0432\u043D\u043E \u043F\u043E \u043F\u0438\u0430\u043B\u0435
      \u0434\u0432\u0430\u0436\u0434\u044B \u0432 \u0434\u0435\u043D\u044C: \u0438
      \u043A\u0443\u043F\u0435\u0446, \u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A. \u041D\u0438\u043A\u0430\u043A\u0438\u0445
      \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439. \u0420\u043E\u043F\u0442\u0430\u043B\u0438,
      \u043D\u043E \u043F\u043E\u0434\u0447\u0438\u043D\u0438\u043B\u0438\u0441\u044C.
      \u0414\u043E \u043E\u0430\u0437\u0438\u0441\u0430 \u0434\u043E\u0448\u043B\u0438
      \u0432\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572911
    m_Localized: "\u0414\u0430\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435 \u0442\u0435\u043C,
      \u043A\u0442\u043E \u043D\u0435\u0441\u0451\u0442 \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572912
    m_Localized: "\u041D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0438 \u0438
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438
      \u043F\u043E\u043B\u0442\u043E\u0440\u044B \u043D\u043E\u0440\u043C\u044B:
      \u0440\u0430\u0431\u043E\u0442\u0430 \u0442\u0440\u0435\u0431\u0443\u0435\u0442.
      \u041E\u0445\u0440\u0430\u043D\u0430 \u0438 \u043A\u0443\u043F\u0435\u0446
      \u043F\u043E \u043D\u043E\u0440\u043C\u0435. \u041D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0441\u043F\u043E\u0440\u0438\u043B \u0432\u0441\u0435\u0440\u044C\u0451\u0437:
      \u043B\u043E\u0433\u0438\u043A\u0430 \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u0430.
      \u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u0442\u0440\u0443\u0434 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572913
    m_Localized: "\u0420\u0435\u0448\u0435\u043D\u0438\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
      \u043D\u0435\u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u044B\u043C
      \u043E\u0445\u0440\u0430\u043D\u0435. \u0414\u0432\u043E\u0435 \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u043D\u0435\u0441\u0442\u0438 \u0432\u0430\u0445\u0442\u0443 \u0432 \u0437\u043D\u0430\u043A
      \u043F\u0440\u043E\u0442\u0435\u0441\u0442\u0430. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043F\u0435\u0440\u0435\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044C
      \u043D\u043E\u0440\u043C\u044B \u043D\u0430 \u0445\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572914
    m_Localized: "\u042D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C \u0432\u043E\u0434\u0443:
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u043A \u043E\u0430\u0437\u0438\u0441\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572915
    m_Localized: "\u0422\u0435\u043C\u043F \u043F\u043E\u0434\u043D\u044F\u043B\u0438.
      \u041D\u043E\u0440\u043C\u044B \u0441\u0440\u0435\u0437\u0430\u043B\u0438 \u0434\u043E
      \u043C\u0438\u043D\u0438\u043C\u0443\u043C\u0430. \u041B\u044E\u0434\u0438
      \u0448\u043B\u0438, \u0441\u0442\u0438\u0441\u043D\u0443\u0432 \u0437\u0443\u0431\u044B.
      \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u0432\u0442\u043E\u0440\u043E\u0433\u043E
      \u0434\u043D\u044F - \u043E\u0430\u0437\u0438\u0441. \u0414\u0432\u043E\u0435
      \u0432\u044B\u0431\u0438\u043B\u0438\u0441\u044C \u0438\u0437 \u0441\u0438\u043B,
      \u043D\u043E \u0434\u043E\u0448\u043B\u0438. \u0412\u043E\u043B\u0438 \u0445\u0432\u0430\u0442\u0438\u043B\u043E
      \u0440\u043E\u0432\u043D\u043E \u043D\u0430 \u0441\u0442\u043E\u043B\u044C\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572916
    m_Localized: "\u0422\u0430\u0439\u043D\u044B\u0435 \u0437\u0430\u043F\u0430\u0441\u044B
      \u0435\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572917
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0436\u0430\u0440\u0435\u043D\u043E\u0433\u043E
      \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u0438\u0437 \u0443\u0433\u043B\u0430,
      \u0433\u0434\u0435 \u0441\u043F\u044F\u0442 \u0442\u0440\u043E\u0435 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0445
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432, \u043D\u0430\u043D\u044F\u0442\u044B\u0445
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430\u043C\u0438. \u041E\u043D\u0438
      \u044F\u0432\u043D\u043E \u0435\u0434\u044F\u0442 \u0447\u0442\u043E-\u0442\u043E
      \u0441\u0432\u043E\u0451, \u043F\u043E\u043A\u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0436\u0443\u044E\u0442 \u0441\u0443\u0445\u0438\u0435 \u043B\u0435\u043F\u0451\u0448\u043A\u0438.
      \u0415\u0441\u043B\u0438 \u043F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u0442\u044C,
      \u043E\u0431\u0438\u0434\u0430 \u0440\u0430\u0437\u044A\u0435\u0441\u0442 \u043B\u0430\u0433\u0435\u0440\u044C.
      \u0415\u0441\u043B\u0438 \u043D\u0430\u0434\u0430\u0432\u0438\u0442\u044C,
      \u043E\u0441\u043A\u043E\u0440\u0431\u0438\u0448\u044C \u043B\u044E\u0434\u0435\u0439,
      \u0443 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0435\u0441\u0442\u044C
      \u043F\u0440\u0430\u0432\u043E \u043D\u0430 \u043B\u0438\u0447\u043D\u044B\u0435
      \u0437\u0430\u043F\u0430\u0441\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572918
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043E
      \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0445 \u043E\u0431\u0449\u0435\u0433\u043E
      \u0441\u0442\u043E\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572919
    m_Localized: "\u0412\u044B \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B\u0438
      \u043D\u0435\u0433\u0440\u043E\u043C\u043A\u043E: \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435
      \u043F\u0440\u0430\u0432\u0438\u043B\u043E \u043E\u0434\u043D\u043E: \u0435\u0441\u043B\u0438
      \u0435\u0448\u044C \u0443 \u0432\u0441\u0435\u0445 \u043D\u0430 \u0432\u0438\u0434\u0443,
      \u0434\u0435\u043B\u0438\u0441\u044C. \u0418\u043B\u0438 \u0435\u0448\u044C
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0435. \u0421\u043E\u0433\u0434\u0438\u0439\u0446\u044B
      \u043F\u043E\u043D\u044F\u043B\u0438, \u043D\u0435 \u043E\u0431\u0438\u0434\u0435\u043B\u0438\u0441\u044C
      - \u0438 \u043F\u043E\u0434\u0435\u043B\u0438\u043B\u0438\u0441\u044C \u043E\u0441\u0442\u0430\u0442\u043A\u0430\u043C\u0438.
      \u041F\u0440\u0430\u0432\u0438\u043B\u043E \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E
      \u0431\u0435\u0437 \u0441\u043A\u0430\u043D\u0434\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572920
    m_Localized: "\u041F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
      \u0441\u0434\u0430\u0442\u044C \u043B\u0438\u0447\u043D\u044B\u0435 \u0437\u0430\u043F\u0430\u0441\u044B
      \u0432 \u043E\u0431\u0449\u0438\u0439 \u043A\u043E\u0442\u0451\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572921
    m_Localized: "\u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u043B\u0438,
      \u043D\u043E \u0441 \u043D\u0435\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u043C\u044B\u043C
      \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E\u043C.
      \u0417\u0430\u043F\u0430\u0441\u044B \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0445\u043E\u0440\u043E\u0448\u0438\u043C\u0438: \u043E\u0431\u0449\u0438\u0439
      \u043A\u043E\u0442\u0451\u043B \u0441\u0442\u0430\u043B \u0441\u044B\u0442\u043D\u0435\u0435.
      \u041D\u043E \u0442\u0440\u043E\u0435 \u0435\u043B\u0438 \u043C\u043E\u043B\u0447\u0430
      \u0438 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
      \u0435\u0449\u0451 \u0434\u0432\u0430 \u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767040
    m_Localized: "\u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u0435 \u0432\u044B\u0437\u0432\u0430\u043B\u043E
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0439 \u043E\u0442\u043A\u0430\u0437.
      \xAB\u041D\u0430\u0448\u0435, \u0447\u0442\u043E \u0445\u043E\u0442\u0438\u043C
      - \u0442\u043E \u0438 \u0435\u0434\u0438\u043C.\xBB \u0410\u0432\u0442\u043E\u0440\u0438\u0442\u0435\u0442
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0448\u0430\u0442\u043D\u0443\u043B\u0441\u044F,
      \u0441\u043E\u0433\u0434\u0438\u0439\u0446\u044B \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F
      \u043E\u0441\u043E\u0431\u043D\u044F\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767041
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C \u0433\u043B\u0430\u0437\u0430:
      \u043D\u0435 \u0432\u0430\u0448\u0435 \u0434\u0435\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767042
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u043B\u0438.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438.
      \u041A \u0443\u0442\u0440\u0443 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u044B
      \u043E \xAB\u043B\u044E\u0431\u0438\u043C\u0447\u0438\u043A\u0430\u0445\xBB
      \u0443\u0436\u0435 \u0445\u043E\u0434\u0438\u043B\u0438 \u043F\u043E \u043B\u0430\u0433\u0435\u0440\u044E.
      \u041C\u0435\u043B\u043E\u0447\u044C, \u043D\u043E \u043A\u0430\u043C\u0435\u043D\u044C
      \u0432 \u0441\u0442\u0435\u043D\u0443 \u043D\u0435\u0434\u043E\u0432\u0435\u0440\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767043
    m_Localized: "\u0420\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435
      \u043D\u043E\u0447\u043D\u044B\u0445 \u0432\u0430\u0445\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767044
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0442\u044F\u0436\u0451\u043B\u043E\u0433\u043E
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430 \u043F\u043E \u0436\u0430\u0440\u0435
      \u043B\u044E\u0434\u0438 \u0432\u0430\u043B\u044F\u0442\u0441\u044F \u0441
      \u043D\u043E\u0433. \u041D\u043E \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435
      \u043D\u043E\u0447\u0438 \u043E\u043F\u0430\u0441\u043D\u044B: \u0431\u0430\u043D\u0434\u044B
      \u043C\u0430\u0440\u043E\u0434\u0451\u0440\u043E\u0432, \u0434\u0438\u043A\u0438\u0435
      \u0441\u043E\u0431\u0430\u043A\u0438, \u043D\u0435\u043D\u0443\u0436\u043D\u044B\u0435
      \u0433\u043E\u0441\u0442\u0438. \u0412\u0430\u0445\u0442\u0430 \u043D\u0443\u0436\u043D\u0430,
      \u043D\u043E \u0436\u0435\u043B\u0430\u044E\u0449\u0438\u0445 \u043D\u0435\u0442.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0441\u0447\u0438\u0442\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0434\u0440\u0443\u0433\u043E\u0439 \u0443\u0441\u0442\u0430\u043B
      \u0431\u043E\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767045
    m_Localized: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0436\u0451\u0441\u0442\u043A\u0438\u0439
      \u0433\u0440\u0430\u0444\u0438\u043A \u043F\u043E \u0436\u0440\u0435\u0431\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767046
    m_Localized: "\u0421\u043E\u043B\u043E\u043C\u0438\u043D\u043A\u0438 \u0432\u044B\u0442\u044F\u043D\u0443\u043B\u0438
      \u0432\u0441\u0435 \u043F\u043E\u0440\u043E\u0432\u043D\u0443. \u041A\u043E\u043C\u0443
      \u0432\u044B\u043F\u0430\u043B\u043E - \u043D\u0451\u0441 \u0432\u0430\u0445\u0442\u0443
      \u0431\u0435\u0437 \u0441\u043F\u043E\u0440\u043E\u0432: \u0436\u0440\u0435\u0431\u0438\u0439
      \u0435\u0441\u0442\u044C \u0436\u0440\u0435\u0431\u0438\u0439. \u041D\u043E\u0447\u044C
      \u043F\u0440\u043E\u0448\u043B\u0430 \u0431\u0435\u0437 \u043F\u0440\u043E\u0438\u0441\u0448\u0435\u0441\u0442\u0432\u0438\u0439,
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B
      \u0441\u0435\u0431\u044F \u043E\u0431\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767047
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0434\u0432\u043E\u0439\u043D\u043E\u0435
      \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u0435 \u0437\u0430 \u0432\u0430\u0445\u0442\u0443
      \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u0446\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767048
    m_Localized: "\u0414\u0435\u043D\u044C\u0433\u0438 \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0441\u0432\u043E\u0451: \u0442\u0440\u043E\u0435 \u0432\u044B\u0437\u0432\u0430\u043B\u0438\u0441\u044C
      \u0441\u0440\u0430\u0437\u0443. \u0411\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0432\u0430\u0445\u0442\u0430 \u0438\u0437 \u0436\u0435\u043B\u0430\u044E\u0449\u0438\u0445
      \u043B\u0443\u0447\u0448\u0435 \u0441\u043E\u043D\u043D\u043E\u0439 \u0438\u0437
      \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u044B\u0445. \u041D\u043E\u0447\u044C
      \u043F\u0440\u043E\u0448\u043B\u0430 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767049
    m_Localized: "\u0416\u0435\u043B\u0430\u044E\u0449\u0438\u0445 \u043D\u0435 \u043D\u0430\u0448\u043B\u043E\u0441\u044C
      \u0434\u0430\u0436\u0435 \u0437\u0430 \u0434\u0432\u043E\u0439\u043D\u0443\u044E
      \u043F\u043B\u0430\u0442\u0443 - \u0432\u0441\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0432\u044B\u043C\u043E\u0442\u0430\u043D\u044B. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F \u043A
      \u0436\u0435\u0440\u0435\u0431\u044C\u0451\u0432\u043A\u0435, \u043F\u043E\u0442\u0435\u0440\u044F\u0432
      \u0432\u0440\u0435\u043C\u044F \u0438 \u0430\u0432\u0442\u043E\u0440\u0438\u0442\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767050
    m_Localized: "\u0421\u0430\u043C\u043E\u043C\u0443 \u043D\u0435\u0441\u0442\u0438
      \u043F\u0435\u0440\u0432\u0443\u044E \u0432\u0430\u0445\u0442\u0443 - \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C
      \u043F\u0440\u0438\u043C\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767051
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0433\u043B\u0430\u0432\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0431\u0435\u0440\u0451\u0442 \u043A\u043E\u043F\u044C\u0451 \u0438 \u0432\u0441\u0442\u0430\u0451\u0442
      \u043F\u0435\u0440\u0432\u044B\u043C, \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442\u043E\u0432
      \u043D\u0435 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0432\u0430\u0445\u0442\u044B \u0437\u0430\u043D\u044F\u043B\u0438 \u043E\u0445\u043E\u0442\u043D\u043E.
      \u041B\u0438\u0447\u043D\u044B\u0439 \u043F\u0440\u0438\u043C\u0435\u0440:
      \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
      \u043F\u043E\u0440\u044F\u0434\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767052
    m_Localized: "\u0423\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C \u0432 \u0433\u043E\u0440\u0430\u0445:
      \u0431\u0443\u043D\u0442 \u043F\u0440\u043E\u0442\u0438\u0432 \u0442\u0435\u043C\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767053
    m_Localized: "\u041A\u0440\u0443\u0442\u043E\u0439 \u043F\u043E\u0434\u044A\u0451\u043C
      \u0442\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C \u043F\u043E\u0434\u0440\u044F\u0434:
      \u0443 \u043B\u044E\u0434\u0435\u0439 \u043F\u043E\u0434\u0433\u0438\u0431\u0430\u044E\u0442\u0441\u044F
      \u043D\u043E\u0433\u0438. \u0414\u0432\u043E\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0441\u0435\u043B\u0438 \u043D\u0430 \u043A\u0430\u043C\u043D\u0438 \u0438
      \u043E\u0431\u044A\u044F\u0432\u0438\u043B\u0438: \u0434\u0430\u043B\u044C\u0448\u0435
      \u043D\u0435 \u0438\u0434\u0443\u0442 \u0431\u0435\u0437 \u0434\u043B\u0438\u043D\u043D\u043E\u0433\u043E
      \u043F\u0440\u0438\u0432\u0430\u043B\u0430. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0441\u043C\u043E\u0442\u0440\u044F\u0442, \u043A\u0442\u043E \u043F\u043E\u0431\u0435\u0434\u0438\u0442.
      \u041F\u043E\u0433\u043E\u0434\u0430 \u0445\u043E\u0440\u043E\u0448\u0430\u044F,
      \u043D\u043E \u043A \u0432\u0435\u0447\u0435\u0440\u0443 \u043C\u043E\u0436\u0435\u0442
      \u0441\u043C\u0435\u043D\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767054
    m_Localized: "\u0414\u0430\u0442\u044C \u0447\u0430\u0441\u043E\u0432\u043E\u0439
      \u043F\u0440\u0438\u0432\u0430\u043B \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767055
    m_Localized: "\u0427\u0430\u0441 \u043B\u0451\u0436\u043A\u0438 \u043D\u0430
      \u043A\u0430\u043C\u043D\u044F\u0445 \u0441\u0434\u0435\u043B\u0430\u043B \u0447\u0443\u0434\u043E.
      \u0412\u0441\u0442\u0430\u0432\u0430\u043B\u0438 \u0441 \u043A\u0440\u044F\u0445\u0442\u0435\u043D\u0438\u0435\u043C,
      \u043D\u043E \u0432\u0441\u0442\u0430\u0432\u0430\u043B\u0438. \u0412\u0442\u043E\u0440\u0430\u044F
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u043F\u043E\u0434\u044A\u0451\u043C\u0430
      \u043F\u0440\u043E\u0448\u043B\u0430 \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u043F\u0435\u0440\u0432\u043E\u0439 - \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0432\u0448\u0438\u0435
      \u043D\u043E\u0433\u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442 \u0438\u043D\u0430\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767056
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0435\u0449\u0451 \u043B\u0438
      \u0434\u043E \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430: \u0442\u0430\u043C
      \u043F\u0440\u0438\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767057
    m_Localized: "\u0412\u044B \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B\u0438:
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435 \u0432\u0435\u0442\u0435\u0440
      \u0441\u043B\u0430\u0431\u0435\u0435 \u0438 \u043C\u0435\u0441\u0442\u043E
      \u0440\u043E\u0432\u043D\u043E\u0435. \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u0445
      \u0443\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438. \u041F\u0440\u043E\u0448\u043B\u0438
      \u0435\u0449\u0451 \u043B\u0438 - \u0438 \u043F\u0440\u0430\u0432\u0434\u0430:
      \u0437\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u043E\u043C \u0443\u043A\u0440\u044B\u0442\u0430\u044F
      \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0430. \u041F\u0440\u0438\u0432\u0430\u043B
      \u0442\u0430\u043C \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043B\u0443\u0447\u0448\u0435,
      \u0447\u0435\u043C \u043D\u0430 \u0441\u043A\u043B\u043E\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767058
    m_Localized: "\u0423\u0433\u043E\u0432\u043E\u0440\u044B \u043D\u0435 \u043F\u043E\u043C\u043E\u0433\u043B\u0438.
      \u0414\u0432\u043E\u0435 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0441\u0438\u0434\u0435\u0442\u044C.
      \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u044B\u0432\u0430\u0442\u044C
      \u043F\u043E\u0434\u043C\u043E\u0433\u0443 \u0438 \u0442\u0435\u0440\u044F\u0442\u044C
      \u043F\u043E\u043B\u0447\u0430\u0441\u0430. \u041F\u0435\u0440\u0435\u0432\u0430\u043B
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B \u043D\u0435\u043F\u043E\u0433\u043E\u0434\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767059
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0443\u043F\u0440\u044F\u043C\u0446\u0435\u0432:
      \u043D\u0430\u0433\u043E\u043D\u044F\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767060
    m_Localized: "\u041E\u0431\u043E\u0437 \u043F\u043E\u0448\u0451\u043B. \u0414\u0432\u043E\u0435
      \u043E\u0442\u0441\u0442\u0430\u0432\u0448\u0438\u0445 \u0441\u0438\u0434\u0435\u043B\u0438,
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438, \u043F\u043E\u0442\u043E\u043C
      \u0432\u0441\u0442\u0430\u043B\u0438 \u0438 \u043F\u043E\u0431\u0435\u0436\u0430\u043B\u0438
      \u0434\u043E\u0433\u043E\u043D\u044F\u0442\u044C. \u0418\u043D\u043E\u0433\u0434\u0430
      \u043B\u0443\u0447\u0448\u0438\u0439 \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442
      - \u0443\u0445\u043E\u0434\u044F\u0449\u0438\u0435 \u0441\u043F\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767061
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u043F\u043E\u0441\u0442:
      \u043F\u043B\u0430\u0442\u0430 \u0437\u0430 \u043F\u0440\u043E\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767062
    m_Localized: "\u041D\u0430 \u0442\u0440\u043E\u043F\u0435 \u0441\u0442\u043E\u0438\u0442
      \u0433\u0440\u0443\u0431\u043E \u0441\u043B\u043E\u0436\u0435\u043D\u043D\u0430\u044F
      \u0441\u0442\u0435\u043D\u0430 \u0438\u0437 \u043A\u0430\u043C\u043D\u0435\u0439,
      \u0443 \u043D\u0435\u0451 \u0442\u0440\u043E\u0435 \u0432\u043E\u0438\u043D\u043E\u0432
      \u0432 \u043C\u0435\u0445\u043E\u0432\u044B\u0445 \u0448\u0430\u043F\u043A\u0430\u0445.
      \u0422\u0440\u0435\u0431\u0443\u044E\u0442 \u043F\u043E\u0448\u043B\u0438\u043D\u0443:
      \u0434\u0435\u0441\u044F\u0442\u0443\u044E \u0434\u043E\u043B\u044E \u043E\u0442
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0442\u044E\u043A\u0430. \u041D\u0438\u043A\u0430\u043A\u0438\u0445
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432, \u043D\u0438\u043A\u0430\u043A\u043E\u0439
      \u043F\u0435\u0447\u0430\u0442\u0438 - \u043F\u0440\u043E\u0441\u0442\u043E
      \u0441\u0438\u043B\u0430. \u041E\u0431\u043E\u0439\u0442\u0438 \u043D\u0435\u043B\u044C\u0437\u044F:
      \u0441\u043F\u0440\u0430\u0432\u0430 \u043E\u0431\u0440\u044B\u0432, \u0441\u043B\u0435\u0432\u0430
      \u0441\u043D\u0435\u0436\u043D\u044B\u0439 \u0441\u043A\u043B\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767063
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0438 \u043F\u0440\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767064
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B \u0437\u0430\u043D\u044F\u043B\u0438
      \u043F\u043E\u043B\u0447\u0430\u0441\u0430 - \u0441\u0431\u0438\u043B\u0438
      \u0434\u043E \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u043E\u0439 \u0434\u043E\u043B\u0438.
      \u0417\u0430\u043F\u043B\u0430\u0442\u0438\u043B\u0438, \u043F\u0440\u043E\u0448\u043B\u0438.
      \u0413\u043E\u0440\u044B \u0442\u0430\u044F\u0442 \u043C\u043D\u043E\u0433\u043E
      \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0445 \u043F\u043E\u0441\u0442\u043E\u0432,
      \u0438 \u043D\u0435 \u0441 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0443\u0439\u0434\u0451\u0448\u044C
      \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767065
    m_Localized: "\u041F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
      \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767066
    m_Localized: "\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430 \u043D\u0435
      \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C. \u0412\u044B \u0443\u043A\u0430\u0437\u0430\u043B\u0438
      \u043D\u0430 \u044D\u0442\u043E \u043F\u0440\u0438 \u0432\u0441\u0435\u0445
      - \u0432\u043E\u0438\u043D\u044B \u0441\u043C\u0443\u0442\u0438\u043B\u0438\u0441\u044C.
      \u041E\u0434\u0438\u043D \u043E\u0442\u043E\u0448\u0451\u043B \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C. \u0412
      \u0438\u0442\u043E\u0433\u0435 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438
      \u0437\u0430 \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u043F\u043B\u0430\u0442\u0443: \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043B\u0438\u0446\u043E, \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u043B\u0438
      \u043F\u0440\u043E\u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767067
    m_Localized: "\u0412\u044B\u0437\u043E\u0432 \u0432\u044B\u0448\u0435\u043B \u0440\u0435\u0437\u043A\u0438\u043C,
      \u0432\u043E\u0438\u043D\u044B \u0440\u0430\u0441\u0441\u0435\u0440\u0434\u0438\u043B\u0438\u0441\u044C.
      \u0417\u0430\u0434\u0435\u0440\u0436\u0430\u043B\u0438 \u043D\u0430 \u0434\u0432\u0430
      \u0447\u0430\u0441\u0430 \u0434\u043B\u044F \xAB\u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438
      \u0442\u044E\u043A\u043E\u0432\xBB. \u041F\u0440\u043E\u0448\u043B\u0438, \u043D\u043E
      \u0437\u043B\u044B\u0435 \u0438 \u0441 \u0440\u0430\u0441\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u044B\u043C
      \u0433\u0440\u0443\u0437\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767068
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0442\u043E\u0432\u0430\u0440
      \u0432\u043C\u0435\u0441\u0442\u043E \u043C\u043E\u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767069
    m_Localized: "\u0413\u043E\u0440\u0441\u0442\u044C \u043F\u0435\u0440\u0446\u0430
      \u0438 \u043A\u0443\u0441\u043E\u043A \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E
      \u0441\u0443\u043A\u043D\u0430 - \u0432\u043E\u0438\u043D\u044B \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u043B\u0438\u0441\u044C
      \u0438 \u043A\u0438\u0432\u043D\u0443\u043B\u0438. \u0422\u043E\u0432\u0430\u0440
      \u0432 \u0433\u043E\u0440\u0430\u0445 \u0446\u0435\u043D\u043D\u0435\u0435
      \u043C\u043E\u043D\u0435\u0442\u044B. \u041F\u0440\u043E\u0448\u043B\u0438
      \u0431\u0435\u0437 \u0441\u043F\u043E\u0440\u043E\u0432, \u0434\u0430\u0436\u0435
      \u043F\u043E\u0436\u0435\u043B\u0430\u043B\u0438 \u043F\u043E\u043F\u0443\u0442\u043D\u043E\u0433\u043E
      \u0432\u0435\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767070
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u0430 \u043B\u0430\u0433\u0435\u0440\u044F
      \u0432 \u043D\u0435\u043F\u043E\u0433\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767071
    m_Localized: "\u0422\u0443\u043C\u0430\u043D \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0441\u044F
      \u043D\u0430 \u0443\u0449\u0435\u043B\u044C\u0435, \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u044C
      - \u0434\u0435\u0441\u044F\u0442\u044C \u0448\u0430\u0433\u043E\u0432. \u0412
      \u044D\u0442\u0438\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u043B\u0430\u0433\u0435\u0440\u044C
      \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0432
      \u0445\u0430\u043E\u0441: \u043A\u0442\u043E-\u0442\u043E \u0440\u0430\u0437\u0436\u0438\u0433\u0430\u0435\u0442
      \u043A\u043E\u0441\u0442\u0451\u0440 \u0442\u0430\u043C, \u0433\u0434\u0435
      \u043D\u0435\u043B\u044C\u0437\u044F, \u043A\u0442\u043E-\u0442\u043E \u0431\u0440\u043E\u0434\u0438\u0442
      \u043C\u0438\u043C\u043E \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432
      \u0438 \u043F\u0443\u0433\u0430\u0435\u0442 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445.
      \u041D\u0443\u0436\u043D\u044B \u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u043F\u0440\u044F\u043C\u043E
      \u0441\u0435\u0439\u0447\u0430\u0441, \u0438\u043D\u0430\u0447\u0435 \u043F\u0430\u043D\u0438\u043A\u0430
      \u0441\u0442\u0430\u043D\u0435\u0442 \u0441\u0430\u043C\u044B\u043C \u043E\u043F\u0430\u0441\u043D\u044B\u043C
      \u0432\u0440\u0430\u0433\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767072
    m_Localized: "\u041E\u0431\u044A\u044F\u0432\u0438\u0442\u044C \u0437\u043E\u043D\u044B
      \u0438 \u0437\u0430\u043F\u0440\u0435\u0442\u044B \u0433\u0440\u043E\u043C\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767073
    m_Localized: "\u0422\u0440\u0438 \u043A\u0440\u0438\u043A\u0430 \u043D\u0430
      \u0432\u0435\u0441\u044C \u0442\u0443\u043C\u0430\u043D - \u0437\u043E\u043D\u044B
      \u043E\u0447\u0435\u0440\u0447\u0435\u043D\u044B \u0433\u043E\u043B\u043E\u0441\u043E\u043C.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0437\u043D\u0430\u0435\u0442, \u0433\u0434\u0435
      \u0435\u043C\u0443 \u0441\u0442\u043E\u044F\u0442\u044C. \u0425\u0430\u043E\u0441
      \u0441\u0436\u0430\u043B\u0441\u044F \u0434\u043E \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u043C\u043E\u0433\u043E
      \u0431\u0435\u0441\u043F\u043E\u0440\u044F\u0434\u043A\u0430. \u0422\u0443\u043C\u0430\u043D
      \u0440\u0430\u0441\u0441\u0435\u044F\u043B\u0441\u044F \u043A \u043F\u043E\u043B\u0443\u0434\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767074
    m_Localized: "\u0412\u044B\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u0432
      \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C \u0443\u0437\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767075
    m_Localized: "\u0427\u0435\u0442\u0432\u0435\u0440\u043E \u043E\u043F\u044B\u0442\u043D\u044B\u0445
      \u043B\u044E\u0434\u0435\u0439 \u0432\u0441\u0442\u0430\u043B\u0438 \u0443
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432, \u0443 \u0441\u043A\u043B\u0430\u0434\u0430,
      \u0443 \u0442\u0440\u043E\u043F\u044B \u0432\u043D\u0438\u0437. \u041A\u0430\u0436\u0434\u044B\u0439
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0441\u043F\u0438\u0441\u043E\u043A
      \u043A\u043E\u043C\u0430\u043D\u0434. \u0422\u0443\u043C\u0430\u043D \u0441\u0442\u0430\u043B
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C\u044E \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767076
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u0432
      \u0441\u0430\u043C \u0437\u0430\u043F\u043B\u0443\u0442\u0430\u043B \u0432
      \u0442\u0443\u043C\u0430\u043D\u0435 \u0438 \u043D\u0430\u0447\u0430\u043B
      \u043A\u0440\u0438\u0447\u0430\u0442\u044C. \u041F\u0435\u0440\u0435\u043F\u043E\u043B\u043E\u0445
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0445\u0443\u0436\u0435 \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767077
    m_Localized: "\u041F\u0440\u0438\u043A\u0430\u0437\u0430\u0442\u044C \u0432\u0441\u0435\u043C
      \u043D\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0434\u043E
      \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767078
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u0435\u0439\u0448\u0435\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435.
      \u0412\u0441\u0435 \u0441\u0435\u043B\u0438 \u0438\u043B\u0438 \u043B\u0435\u0433\u043B\u0438
      \u0442\u0430\u043C, \u0433\u0434\u0435 \u0441\u0442\u043E\u044F\u043B\u0438.
      \u0416\u0434\u0430\u043B\u0438. \u0422\u0443\u043C\u0430\u043D \u0443\u0448\u0451\u043B
      \u0441 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u043E\u043C. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0447\u0430\u0441\u0442\u044C \u0434\u043D\u044F, \u0437\u0430\u0442\u043E
      \u0431\u0435\u0437 \u0436\u0435\u0440\u0442\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767079
    m_Localized: "\u0417\u0430\u043A\u043E\u043D \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767080
    m_Localized: "\u041F\u0435\u0440\u0435\u0434 \u0432\u044B\u0445\u043E\u0434\u043E\u043C
      \u0438\u0437 \u0433\u043E\u0440\u043E\u0434\u0430 \u043E\u0434\u0438\u043D
      \u0438\u0437 \u043E\u043F\u044B\u0442\u043D\u044B\u0445 \u043A\u0443\u043F\u0446\u043E\u0432
      \u043F\u043E\u0434\u043D\u044F\u043B \u0440\u0443\u043A\u0443: \u043D\u0430\u0434\u043E
      \u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C \u043F\u0440\u0430\u0432\u0438\u043B\u0430
      \u043D\u0430 \u0432\u0435\u0441\u044C \u043F\u0443\u0442\u044C, \u043F\u043E\u043A\u0430
      \u0432\u0441\u0435 \u0432\u043C\u0435\u0441\u0442\u0435 \u0438 \u0442\u0440\u0435\u0437\u0432\u044B.
      \u041D\u0435 \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u044B\u0435 \u0437\u0430\u043A\u043E\u043D\u044B,
      \u0430 \u0436\u0438\u0432\u044B\u0435 \u0441\u043B\u043E\u0432\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u0432\u0441\u0435. \u0427\u0442\u043E
      \u043C\u043E\u0436\u043D\u043E, \u0447\u0435\u0433\u043E \u043D\u0435\u043B\u044C\u0437\u044F,
      \u043A\u0442\u043E \u0437\u0430 \u0447\u0442\u043E \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442.
      \u0411\u0435\u0437 \u044D\u0442\u043E\u0433\u043E \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430
      \u043F\u043E\u0445\u043E\u0434 \u0447\u0442\u043E \u043B\u043E\u0442\u0435\u0440\u0435\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767081
    m_Localized: "\u041E\u0433\u043B\u0430\u0441\u0438\u0442\u044C \u043F\u0440\u0430\u0432\u0438\u043B\u0430
      \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767082
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442
      \u0440\u0435\u0447\u0438. \u041A\u0430\u0436\u0434\u044B\u0439 \u043A\u0438\u0432\u043D\u0443\u043B,
      \u0438\u043B\u0438 \u043D\u0435 \u043A\u0438\u0432\u043D\u0443\u043B, \u0447\u0442\u043E
      \u0442\u043E\u0436\u0435 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438.
      \u0421\u043B\u043E\u0432\u0430 \u0441\u043A\u0430\u0437\u0430\u043D\u044B \u043F\u0440\u0438
      \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044F\u0445. \u041F\u0435\u0440\u0432\u044B\u0439
      \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442 \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043B\u0438
      \u043B\u0435\u0433\u043A\u043E: \xAB\u0422\u044B \u0436\u0435 \u0441\u043B\u044B\u0448\u0430\u043B\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767083
    m_Localized: "\u0421\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u043F\u0438\u0441\u043E\u043A
      \u043F\u0440\u0430\u0432\u0438\u043B \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767084
    m_Localized: "\u041F\u0438\u0441\u0435\u0446 \u0437\u0430\u043F\u0438\u0441\u0430\u043B
      \u043D\u0430 \u043A\u043E\u0436\u0435. \u041A\u0430\u0436\u0434\u044B\u0439,
      \u043A\u0442\u043E \u0443\u043C\u0435\u043B, \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u0437\u043D\u0430\u043A. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C
      \u0437\u0430\u0447\u0438\u0442\u0430\u043B\u0438 \u0432\u0441\u043B\u0443\u0445.
      \u0411\u0443\u043C\u0430\u0433\u0430 \u0441\u043B\u0430\u0431\u0435\u0435 \u0441\u043B\u043E\u0432\u0430,
      \u043D\u043E \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442. \u041A \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435
      \u043F\u0443\u0442\u0438 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u0441\u044B\u043B\u0430\u043B\u0441\u044F
      \u043D\u0430 \u043D\u0435\u0437\u043D\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767085
    m_Localized: "\u041F\u043E\u043A\u0430 \u043F\u0438\u0441\u0430\u043B\u0438,
      \u0441\u043F\u043E\u0440\u0438\u043B\u0438 \u043E \u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u043A\u0430\u0445
      \u0447\u0430\u0441. \u0418\u0442\u043E\u0433\u043E\u0432\u044B\u0439 \u0442\u0435\u043A\u0441\u0442
      \u0432\u044B\u0448\u0435\u043B \u043F\u0443\u0442\u0430\u043D\u044B\u043C.
      \u041F\u0435\u0440\u0432\u044B\u0439 \u0436\u0435 \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B
      \u0434\u044B\u0440\u044B \u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767086
    m_Localized: "\u041E\u0442\u043B\u043E\u0436\u0438\u0442\u044C: \u0440\u0430\u0437\u0431\u0435\u0440\u0451\u043C\u0441\u044F
      \u043F\u043E \u0445\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767087
    m_Localized: "\xAB\u0420\u0430\u0437\u0431\u0435\u0440\u0451\u043C\u0441\u044F\xBB
      \u0441\u0442\u0430\u043B\u043E \u0433\u043B\u0430\u0432\u043D\u044B\u043C \u0441\u043B\u043E\u0432\u043E\u043C
      \u043F\u0435\u0440\u0432\u043E\u0439 \u043D\u0435\u0434\u0435\u043B\u0438.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0441\u043F\u043E\u0440 \u0441 \u0447\u0438\u0441\u0442\u043E\u0433\u043E
      \u043B\u0438\u0441\u0442\u0430. \u041A \u0434\u0435\u0441\u044F\u0442\u043E\u043C\u0443
      \u0434\u043D\u044E \u0442\u0440\u0438 \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u0430
      \u0432\u0438\u0441\u0435\u043B\u0438 \u043D\u0435\u0440\u0435\u0448\u0451\u043D\u043D\u044B\u043C\u0438.
      \u041F\u0440\u0430\u0432\u0438\u043B \u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767088
    m_Localized: "\u041D\u043E\u0432\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0432 \u043E\u0431\u043E\u0437\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767089
    m_Localized: "\u0423 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430 \u043A \u043E\u0431\u043E\u0437\u0443 \u043F\u0440\u043E\u0441\u0438\u0442\u0441\u044F
      \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0441 \u0443\u0437\u043B\u043E\u043C \u043D\u0430 \u043F\u043B\u0435\u0447\u0435.
      \u0413\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u0437\u043D\u0430\u0435\u0442
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0432\u043F\u0435\u0440\u0451\u0434,
      \u0433\u043E\u0442\u043E\u0432 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0437\u0430 \u0435\u0434\u0443 \u0438 \u043A\u0440\u044B\u0448\u0443 \u043D\u0430\u0434
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439. \u0412\u0437\u0433\u043B\u044F\u0434
      \u043F\u0440\u044F\u043C\u043E\u0439, \u043D\u043E \u0440\u0443\u043A\u0438
      \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0435, \u0430 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u043F\u0438\u0441\u044C\u043C\u0430 \u043D\u0435\u0442. \u041B\u044E\u0434\u0438
      \u0432 \u043E\u0431\u043E\u0437\u0435 \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u043D\u0430 \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767090
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043F\u043E\u0434 \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u043E\u043C:
      \u0438\u0441\u043F\u044B\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0441\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767091
    m_Localized: "\u0422\u0440\u0438 \u0434\u043D\u044F \u0440\u0430\u0431\u043E\u0442\u044B
      \u043F\u043E\u0434 \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u043E\u043C
      \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043E \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430.
      \u041F\u0430\u0440\u0435\u043D\u044C \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0438\u0441\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
      \u0438 \u0437\u043D\u0430\u043B \u0434\u043E\u0440\u043E\u0433\u0443 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0445\u043E\u0440\u043E\u0448\u043E. \u041A \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u043E\u043C\u0443
      \u0434\u043D\u044E \u0435\u0433\u043E \u043F\u0440\u0438\u043D\u044F\u043B\u0438
      \u043A\u0430\u043A \u0441\u0432\u043E\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767092
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u0447\u0443\u0436\u0430\u043A
      \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767093
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u043B\u0438 \u0432\u0435\u0436\u043B\u0438\u0432\u043E,
      \u043D\u043E \u0442\u0432\u0451\u0440\u0434\u043E. \u042E\u043D\u043E\u0448\u0430
      \u043F\u043E\u0436\u0430\u043B \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438
      \u043F\u043E\u0448\u0451\u043B \u0434\u0430\u043B\u044C\u0448\u0435. \u041C\u043E\u0436\u0435\u0442,
      \u044D\u0442\u043E \u0431\u044B\u043B\u043E \u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0430 \u043C\u043E\u0436\u0435\u0442, \u0443\u043F\u0443\u0441\u0442\u0438\u043B\u0438
      \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.
      \u041D\u0435 \u0443\u0437\u043D\u0430\u0442\u044C \u0442\u0435\u043F\u0435\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767094
    m_Localized: "\u041E\u0442\u043A\u0430\u0437 \u043F\u0440\u043E\u0437\u0432\u0443\u0447\u0430\u043B
      \u0433\u0440\u0443\u0431\u043E. \u042E\u043D\u043E\u0448\u0430 \u043E\u0431\u0438\u0434\u0435\u043B\u0441\u044F
      \u0438 \u043F\u0440\u0438 \u0432\u0441\u0435\u0445 \u0441\u043A\u0430\u0437\u0430\u043B
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043B\u043E\u0432
      \u043E \u0436\u0430\u0434\u043D\u044B\u0445 \u043A\u0443\u043F\u0446\u0430\u0445.
      \u041B\u0430\u0433\u0435\u0440\u044C \u0441\u043B\u044B\u0448\u0430\u043B.
      \u041D\u0435\u043B\u043E\u0432\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767095
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0440\u0430\u0437\u0443
      - \u043B\u0438\u0448\u043D\u0438\u0435 \u0440\u0443\u043A\u0438 \u043D\u0443\u0436\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767096
    m_Localized: "\u0412\u0437\u044F\u043B\u0438 \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432. \u0420\u0430\u0431\u043E\u0442\u0430\u043B
      \u0445\u043E\u0440\u043E\u0448\u043E. \u0427\u0435\u0440\u0435\u0437 \u043D\u0435\u0434\u0435\u043B\u044E
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438, \u0447\u0442\u043E
      \u043E\u043D \u0437\u043D\u0430\u043B \u0434\u043E\u0440\u043E\u0433\u0443
      \u043A \u0441\u043A\u0440\u044B\u0442\u043E\u043C\u0443 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0443
      \u0432\u043E\u0434\u044B - \u0437\u043D\u0430\u043D\u0438\u0435, \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u0441\u0440\u0430\u0437\u0443.
      \u0414\u043E\u0431\u0440\u043E\u0442\u0430 \u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
      \u0441 \u043F\u0440\u0438\u0431\u044B\u043B\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767097
    m_Localized: "\u041D\u0443\u0436\u0435\u043D \u0441\u043F\u0443\u0442\u043D\u0438\u043A:
      {companion_name}"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767098
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u043C\u0438\u043D\u0438\u043C\u0443\u043C
      {count} \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856263475200
    m_Localized: "\u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856301223936
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0441\u043E\u0442\u0435\u043D \u0434\u043D\u0435\u0439
      \u043F\u0443\u0442\u0438 \u0437\u043E\u043B\u043E\u0442\u044B\u0435 \u043A\u0443\u043F\u043E\u043B\u0430
      \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044F
      \u0441\u0438\u044F\u044E\u0442 \u0432\u043F\u0435\u0440\u0435\u0434\u0438.
      \u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0441\u0442\u043E\u0438\u0442
      \u0440\u044F\u0434\u043E\u043C, \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442. \xAB\u0412\u0441\u0451
      \u0433\u043E\u0442\u043E\u0432\u043E. \u041E\u0434\u0438\u043D \u0448\u0430\u0433
      - \u0438 \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C
      \u043F\u0440\u043E\u0439\u0434\u0435\u043D.\xBB \u041E\u043D \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u0432\u0430\u043C. \xAB\u0412\u0445\u043E\u0434\u0438\u043C?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856301223937
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856301223938
    m_Localized: "\u0412\u044B \u043F\u0435\u0440\u0435\u0441\u0442\u0443\u043F\u0430\u0435\u0442\u0435
      \u043F\u043E\u0440\u043E\u0433 \u0412\u0435\u043B\u0438\u043A\u0438\u0445 \u0412\u0440\u0430\u0442
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0412\u0430\u0445\u0443-\u041C\u0430\u043D\u043E\u043C.
      \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C \u043F\u0440\u043E\u0439\u0434\u0435\u043D.
      \u0413\u0438\u043B\u044C\u0434\u0438\u044F \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      \u0437\u0430\u0439\u043C\u0451\u0442 \u0441\u0432\u043E\u0451 \u043C\u0435\u0441\u0442\u043E
      \u043D\u0430 \u043A\u0430\u0440\u0442\u0430\u0445 \u043C\u0438\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856301223939
    m_Localized: "\u041F\u0435\u0441\u0447\u0430\u043D\u0430\u044F \u0431\u0443\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856301223940
    m_Localized: "\u0427\u0451\u0440\u043D\u0430\u044F \u0441\u0442\u0435\u043D\u0430
      \u043F\u0435\u0441\u043A\u0430 \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0430\u0441\u044C
      \u043D\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D. \u041A\u043E\u0433\u0434\u0430
      \u0431\u0443\u0440\u044F \u0441\u0442\u0438\u0445\u043B\u0430, \u043D\u0438
      \u043C\u0435\u0448\u043A\u0430 \u0441 \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0435\u0439
      \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u2014 \u0432\u0441\u0451
      \u0443\u043D\u0435\u0441\u0435\u043D\u043E \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u044E.
      \u0413\u043E\u043B\u043E\u0434 \u043D\u0435\u0438\u0437\u0431\u0435\u0436\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856301223941
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0443\u0434\u044C\u0431\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418240
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u0443\u0433\u0430\u0441\u0430\u0435\u0442 \u0432 \u043F\u0435\u0441\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418241
    m_Localized: "\u041D\u0430\u0448\u0435\u0441\u0442\u0432\u0438\u0435 \u0441\u0430\u0440\u0430\u043D\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418242
    m_Localized: "\u0422\u0451\u043C\u043D\u0430\u044F \u0442\u0443\u0447\u0430 \u043D\u0430\u043A\u0440\u044B\u043B\u0430
      \u043D\u0435\u0431\u043E \u2014 \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u044B
      \u0441\u0430\u0440\u0430\u043D\u0447\u0438 \u0432 \u0441\u0447\u0438\u0442\u0430\u043D\u043D\u044B\u0435
      \u0447\u0430\u0441\u044B \u043F\u043E\u0436\u0440\u0430\u043B\u0438 \u0432\u0441\u0435
      \u0437\u0430\u043F\u0430\u0441\u044B. \u0422\u044E\u043A\u0438 \u0441 \u0437\u0435\u0440\u043D\u043E\u043C,
      \u0432\u044F\u043B\u0435\u043D\u043E\u0435 \u043C\u044F\u0441\u043E, \u0441\u0443\u0448\u0451\u043D\u044B\u0435
      \u0444\u0440\u0443\u043A\u0442\u044B \u2014 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C. \u0411\u0435\u0437
      \u0435\u0434\u044B \u0434\u043E\u0440\u043E\u0433\u0443 \u043D\u0435 \u043F\u0440\u043E\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418243
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0443\u0434\u044C\u0431\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418244
    m_Localized: "\u041E\u043F\u0443\u0441\u0442\u043E\u0448\u0451\u043D\u043D\u044B\u0439
      \u043E\u0431\u043E\u0437 \u0437\u0430\u043C\u0438\u0440\u0430\u0435\u0442 \u043F\u043E\u0441\u0440\u0435\u0434\u0438
      \u043F\u0443\u0441\u0442\u043E\u0433\u043E \u043F\u043E\u043B\u044F. \u0418\u0434\u0442\u0438
      \u043D\u0435\u043A\u0443\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418245
    m_Localized: "\u041E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F
      \u0432\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418246
    m_Localized: "\u041F\u0440\u0438\u0432\u0430\u043B \u0443 \u0440\u043E\u0434\u043D\u0438\u043A\u0430
      \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0431\u0435\u0434\u043E\u0439
      \u2014 \u0432\u043E\u0434\u0430 \u043E\u0442\u0434\u0430\u0432\u0430\u043B\u0430
      \u0433\u043E\u0440\u0435\u0447\u044C\u044E, \u043D\u043E \u0443\u0441\u0442\u0430\u043B\u044B\u0435
      \u043B\u044E\u0434\u0438 \u043F\u0438\u043B\u0438. \u041D\u0430\u0443\u0442\u0440\u043E
      \u0432\u0441\u0435 \u0437\u0430\u043F\u0430\u0441\u044B \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0432\u044B\u0431\u0440\u043E\u0441\u0438\u0442\u044C: \u043E\u0430\u0437\u0438\u0441
      \u0431\u044B\u043B \u043E\u0442\u0440\u0430\u0432\u043B\u0435\u043D. \u041F\u0443\u0441\u0442\u044B\u0435
      \u0444\u043B\u044F\u0433\u0438 \u0438 \u043E\u0431\u0435\u0441\u0441\u0438\u043B\u0435\u0432\u0448\u0438\u0435
      \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u0438 \u2014 \u0432\u043E\u0442
      \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043E\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418247
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0443\u0434\u044C\u0431\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418248
    m_Localized: "\u0421\u0438\u043B\u044B \u043F\u043E\u043A\u0438\u043D\u0443\u043B\u0438
      \u043B\u044E\u0434\u0435\u0439. \u041F\u0443\u0442\u044C \u043E\u043A\u043E\u043D\u0447\u0435\u043D
      \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418249
    m_Localized: "\u041A\u0440\u0435\u0434\u0438\u0442\u043E\u0440\u044B \u043F\u0440\u0438\u0448\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418250
    m_Localized: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u0443
      \u0432\u043E\u0440\u043E\u0442 \u043B\u0430\u0433\u0435\u0440\u044F \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C
      \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0435 \u043B\u044E\u0434\u0438
      \u0441 \u0432\u0435\u043A\u0441\u0435\u043B\u044F\u043C\u0438. \u0414\u043E\u043B\u0433\u0438
      \u043D\u0430\u043A\u043E\u043F\u0438\u043B\u0438\u0441\u044C \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0434\u0430\u0432\u043D\u043E \u2014 \u043A\u0443\u043F\u0435\u0446 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C
      \u0440\u0430\u0441\u043F\u043B\u0430\u0442\u0443. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u043C\u043E\u043D\u0435\u0442\u044B \u0443\u0445\u043E\u0434\u044F\u0442 \u0432
      \u0447\u0443\u0436\u0438\u0435 \u0440\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418251
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u0432\u0441\u0451"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418252
    m_Localized: "\u041F\u0443\u0441\u0442\u0430\u044F \u043A\u0430\u0437\u043D\u0430.
      \u0422\u043E\u0440\u0433\u043E\u0432\u043E\u0435 \u0434\u0435\u043B\u043E \u043F\u043E\u0433\u0443\u0431\u043B\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418253
    m_Localized: "\u041E\u0433\u0440\u0430\u0431\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418254
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u0432 \u043B\u0430\u0433\u0435\u0440\u044C
      \u043F\u0440\u043E\u043D\u0438\u043A\u043B\u0438 \u0432\u043E\u0440\u044B.
      \u041E\u0445\u0440\u0430\u043D\u0430 \u043D\u0435 \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0430
      \u2014 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0443\u0441\u0442\u0430\u043B\u0430.
      \u041A\u043E\u0433\u0434\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u043B\u043E,
      \u043A\u043E\u0448\u0435\u043B\u0438 \u0441 \u043C\u043E\u043D\u0435\u0442\u0430\u043C\u0438
      \u0438\u0441\u0447\u0435\u0437\u043B\u0438. \u0412\u0441\u0435 \u0434\u043E
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u0434\u0438\u0440\u0445\u0430\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418255
    m_Localized: "\u041F\u0440\u0438\u0437\u043D\u0430\u0442\u044C \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418256
    m_Localized: "\u0411\u0435\u0437 \u0434\u0435\u043D\u0435\u0433 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0437\u0430\u043A\u0440\u044B\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418257
    m_Localized: "\u041A\u043E\u043D\u0444\u0438\u0441\u043A\u0430\u0446\u0438\u044F
      \u0442\u043E\u0432\u0430\u0440\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418258
    m_Localized: "\u0422\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u044B\u0439 \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u043B \u0434\u043E\u043B\u0433\u043E\u0432\u044B\u0435
      \u0433\u0440\u0430\u043C\u043E\u0442\u044B \u0438 \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043B
      \u0432\u0441\u0435 \u0442\u044E\u043A\u0438. \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C \u0432\u043E\u0437\u043C\u043E\u0436\u0435\u043D \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u0440\u0438 \u043D\u0430\u043B\u0438\u0447\u0438\u0438 \u043A\u0430\u0437\u043D\u044B
      \u2014 \u043D\u043E \u043A\u0430\u0437\u043D\u0430 \u043F\u0443\u0441\u0442\u0430.
      \u0422\u043E\u0432\u0430\u0440\u044B \u0430\u0440\u0435\u0441\u0442\u043E\u0432\u0430\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418259
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u0441\u0443\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418260
    m_Localized: "\u041E\u043F\u0443\u0441\u0442\u0435\u0432\u0448\u0438\u0439 \u043E\u0431\u043E\u0437
      \u0441\u0442\u043E\u0438\u0442 \u0443 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418261
    m_Localized: "\u0411\u0443\u0440\u044F \u0440\u0430\u0437\u0431\u0438\u043B\u0430
      \u043E\u0431\u043E\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418262
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u0443\u0440\u0430\u0433\u0430\u043D
      \u043D\u0430\u043B\u0435\u0442\u0435\u043B \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F.
      \u0422\u0435\u043B\u0435\u0433\u0438 \u0448\u0432\u044B\u0440\u044F\u043B\u043E
      \u043E \u0441\u043A\u0430\u043B\u044B, \u0432\u0435\u0440\u0451\u0432\u043A\u0438
      \u043B\u043E\u043F\u0430\u043B\u0438\u0441\u044C \u043A\u0430\u043A \u043D\u0438\u0442\u0438.
      \u041A\u043E\u0433\u0434\u0430 \u0432\u0435\u0442\u0435\u0440 \u0441\u0442\u0438\u0445,
      \u043E\u0442 \u043E\u0431\u043E\u0437\u0430 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C
      \u043B\u0438\u0448\u044C \u0449\u0435\u043F\u0430 \u0434\u0430 \u0440\u0430\u0437\u0431\u0440\u043E\u0441\u0430\u043D\u043D\u044B\u0439
      \u043F\u043E \u043A\u0430\u043C\u043D\u044F\u043C \u0442\u043E\u0432\u0430\u0440.
      \u0418\u0434\u0442\u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435
      \u043D\u0430 \u0447\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418263
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0443\u0434\u044C\u0431\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418264
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u0442\u044B\u0439 \u043E\u0431\u043E\u0437
      \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u044C\u044F
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418265
    m_Localized: "\u041C\u043E\u0440\u043E\u0432\u0430\u044F \u0431\u043E\u043B\u0435\u0437\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418266
    m_Localized: "\u0411\u043E\u043B\u0435\u0437\u043D\u044C \u043F\u0440\u0438\u0448\u043B\u0430
      \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E \u2014 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u0436\u0430\u0440, \u043F\u043E\u0442\u043E\u043C \u0431\u0440\u0435\u0434.
      \u0417\u0430 \u043D\u0435\u0434\u0435\u043B\u044E \u044D\u043F\u0438\u0434\u0435\u043C\u0438\u044F
      \u043E\u043F\u0443\u0441\u0442\u043E\u0448\u0438\u043B\u0430 \u0440\u044F\u0434\u044B
      \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u0437\u0434\u043E\u0440\u043E\u0432\u044B\u0435 \u0440\u0430\u0437\u0431\u0435\u0436\u0430\u043B\u0438\u0441\u044C,
      \u043D\u0435 \u0434\u043E\u0436\u0438\u0434\u0430\u044F\u0441\u044C \u0441\u0432\u043E\u0435\u0439
      \u043E\u0447\u0435\u0440\u0435\u0434\u0438. \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C \u0431\u0435\u0437 \u043B\u044E\u0434\u0435\u0439
      \u2014 \u043D\u0435 \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418267
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0443\u0434\u044C\u0431\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418268
    m_Localized: "\u041E\u0434\u0438\u043D\u043E\u043A\u0438\u0439 \u043A\u0443\u043F\u0435\u0446
      \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043F\u043E\u0441\u0440\u0435\u0434\u0438
      \u043E\u043F\u0443\u0441\u0442\u0435\u0432\u0448\u0435\u0439 \u0434\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418269
    m_Localized: "\u041B\u0430\u0432\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418270
    m_Localized: "\u0413\u0440\u043E\u0445\u043E\u0442 \u0440\u0430\u0437\u0434\u0430\u043B\u0441\u044F
      \u0441\u0432\u0435\u0440\u0445\u0443 \u2014 \u0438 \u0441\u043D\u0435\u0436\u043D\u0430\u044F
      \u043C\u0430\u0441\u0441\u0430 \u043D\u0430\u043A\u0440\u044B\u043B\u0430 \u0443\u0449\u0435\u043B\u044C\u0435.
      \u041A\u043E\u0433\u0434\u0430 \u043F\u0440\u0438\u0448\u043B\u0438 \u0432\u044B\u0436\u0438\u0432\u0448\u0438\u0435
      \u0438\u0437 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0433\u043E \u043E\u0442\u0440\u044F\u0434\u0430,
      \u043E\u0442\u043A\u0430\u043F\u044B\u0432\u0430\u0442\u044C \u0431\u044B\u043B\u043E
      \u043D\u0435\u043A\u043E\u0433\u043E. \u041E\u0431\u043E\u0437 \u043F\u043E\u0433\u0440\u0435\u0431\u0451\u043D
      \u0432 \u0433\u043E\u0440\u0430\u0445 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418271
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0443\u0434\u044C\u0431\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418272
    m_Localized: "\u0413\u043E\u0440\u044B \u043D\u0435 \u043E\u0442\u0434\u0430\u044E\u0442
      \u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418273
    m_Localized: "\u0411\u0443\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418274
    m_Localized: "\u0414\u043E\u043B\u0433\u0438\u0435 \u043B\u0438\u0448\u0435\u043D\u0438\u044F
      \u043F\u0435\u0440\u0435\u043F\u043E\u043B\u043D\u0438\u043B\u0438 \u0447\u0430\u0448\u0443.
      \u0421\u043F\u0443\u0442\u043D\u0438\u043A\u0438 \u043E\u043A\u0440\u0443\u0436\u0438\u043B\u0438
      \u043A\u0443\u043F\u0446\u0430 \u0443 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u0433\u043E
      \u043E\u0433\u043D\u044F \u2014 \u043B\u0438\u0446\u0430 \u0443\u0433\u0440\u044E\u043C\u044B,
      \u0440\u0443\u043A\u0438 \u0441\u0436\u0430\u0442\u044B. \u0421\u043B\u043E\u0432\u0430
      \u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C, \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F
      \u0443\u043B\u044C\u0442\u0438\u043C\u0430\u0442\u0438\u0432\u043D\u044B. \u0412\u043B\u0430\u0441\u0442\u044C
      \u043D\u0430\u0434 \u043E\u0431\u043E\u0437\u043E\u043C \u0443\u0442\u0440\u0430\u0447\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418275
    m_Localized: "\u041E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418276
    m_Localized: "\u0411\u0443\u043D\u0442\u043E\u0432\u0449\u0438\u043A\u0438 \u0440\u0430\u0437\u0433\u043E\u043D\u044F\u044E\u0442
      \u043E\u0431\u043E\u0437 \u043F\u043E \u0432\u0435\u0442\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418277
    m_Localized: "\u0414\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u0441\u0442\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418278
    m_Localized: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u043B\u0430\u0433\u0435\u0440\u044C
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043F\u0443\u0441\u0442.
      \u041B\u044E\u0434\u0438 \u0443\u0448\u043B\u0438 \u043D\u043E\u0447\u044C\u044E
      \u2014 \u0442\u0438\u0445\u043E, \u0431\u0435\u0437 \u043A\u0440\u0438\u043A\u043E\u0432,
      \u0432\u0437\u044F\u0432 \u0447\u0430\u0441\u0442\u044C \u0437\u0430\u043F\u0430\u0441\u043E\u0432.
      \u041E\u0441\u0442\u0430\u0432\u0448\u0438\u0439\u0441\u044F \u043A\u0443\u043F\u0435\u0446
      \u0441\u0442\u043E\u0438\u0442 \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u0442\u0443\u0445\u0448\u0438\u043C
      \u043A\u043E\u0441\u0442\u0440\u043E\u043C \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0435.
      \u0411\u0435\u0437 \u043B\u044E\u0434\u0435\u0439 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0431\u0435\u0441\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418279
    m_Localized: "\u041F\u0440\u0438\u0437\u043D\u0430\u0442\u044C \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418280
    m_Localized: "\u041E\u0431\u043E\u0437 \u0431\u0440\u043E\u0448\u0435\u043D.
      \u041F\u0443\u0442\u044C \u043F\u0440\u0435\u0440\u0432\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418281
    m_Localized: "\u0413\u0438\u0431\u0435\u043B\u044C \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418282
    m_Localized: "\u0421\u0440\u0435\u0434\u0438 \u043D\u043E\u0447\u0438 \u0448\u0451\u043F\u043E\u0442
      \u0438 \u0442\u0435\u043D\u0438 \u0443 \u0448\u0430\u0442\u0440\u0430. \u0423\u0442\u0440\u043E\u043C
      \u043A\u0443\u043F\u0435\u0446 \u043D\u0435 \u0432\u0441\u0442\u0430\u043B
      \u2014 \u043D\u0430\u0448\u043B\u0438 \u0435\u0433\u043E \u0443 \u043F\u043E\u0445\u043E\u0434\u043D\u043E\u0439
      \u043A\u0440\u043E\u0432\u0430\u0442\u0438. \u0423\u0431\u0438\u0439\u0446\u044B
      \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C \u0432
      \u043D\u043E\u0447\u0438 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043A\u0430\u0437\u043D\u043E\u0439.
      \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418283
    m_Localized: "\u041A\u043E\u043D\u0435\u0446 \u043F\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418284
    m_Localized: "\u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C
      \u0436\u0435\u0441\u0442\u043E\u043A \u043A \u0441\u043B\u0430\u0431\u044B\u043C
      \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777125122048
    m_Localized: "\u041B\u0435\u0447\u044C \u0433\u043E\u043B\u043E\u0434\u0430\u0442\u044C
      \u0441\u043E \u0432\u0441\u0435\u043C\u0438. \u041A\u043E\u043D\u0435\u0446
      \u043F\u043E\u0445\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870784
    m_Localized: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u043B\u0430\u0433\u0435\u0440\u044C
      \u043D\u0435 \u0432\u0441\u0442\u0430\u043B. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0432 \u043F\u0435\u0441\u043A\u0430\u0445
      \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870785
    m_Localized: "\u041F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u0442\u044C \u0442\u043E\u0440\u0433.
      \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C \u043E\u043A\u043E\u043D\u0447\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870786
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u043D\u0438 \u0441 \u0447\u0435\u043C. \u0413\u043E\u043B\u043E\u0434 \u0434\u043E\u0433\u043E\u043D\u044F\u0435\u0442
      \u043D\u0430 \u043F\u0443\u0442\u0438 \u043D\u0430\u0437\u0430\u0434. \u041D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0434\u043E\u0445\u043E\u0434\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870787
    m_Localized: "\u041E\u0431\u044A\u044F\u0432\u0438\u0442\u044C \u0441\u0435\u0431\u044F
      \u0431\u0430\u043D\u043A\u0440\u043E\u0442\u043E\u043C. \u041F\u043E\u0445\u043E\u0434
      \u043E\u043A\u043E\u043D\u0447\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870788
    m_Localized: "\u041A\u0440\u0435\u0434\u0438\u0442\u043E\u0440\u044B \u0437\u0430\u0431\u0438\u0440\u0430\u044E\u0442
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0438 \u0442\u043E\u0432\u0430\u0440\u044B.
      \u0414\u0430\u043B\u044C\u0448\u0435 \u0438\u0434\u0442\u0438 \u043D\u0435
      \u043D\u0430 \u0447\u0435\u043C. \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C \u0437\u0430\u043A\u0440\u044B\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870789
    m_Localized: "\u041F\u0440\u0438\u0437\u043D\u0430\u0442\u044C \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435.
      \u041F\u0443\u0442\u044C \u043E\u043A\u043E\u043D\u0447\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870790
    m_Localized: "\u0412\u043E\u0440\u044B \u0443\u043D\u0435\u0441\u043B\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u043C\u043E\u043D\u0435\u0442\u044B. \u0411\u0435\u0437 \u0434\u0435\u043D\u0435\u0433
      \u043D\u0435 \u043F\u0440\u043E\u0439\u0442\u0438 \u043D\u0438 \u043E\u0434\u043D\u043E\u0439
      \u0437\u0430\u0441\u0442\u0430\u0432\u044B. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0431\u0440\u043E\u0448\u0435\u043D \u043D\u0430 \u043F\u043E\u043B\u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870791
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0432\u0441\u0435\u0445
      \u0438 \u0441\u0434\u0430\u0442\u044C\u0441\u044F. \u041A\u043E\u043D\u0435\u0446
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870792
    m_Localized: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u043B\u0430\u0433\u0435\u0440\u044C
      \u043F\u0443\u0441\u0442. \u041A\u0443\u043F\u0435\u0446 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u0431\u0435\u0437 \u0440\u0443\u043A, \u0431\u0435\u0437 \u043F\u043E\u0432\u043E\u0437\u043E\u043A,
      \u0431\u0435\u0437 \u043D\u0430\u0434\u0435\u0436\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870793
    m_Localized: "\u0421\u0434\u0430\u0442\u044C\u0441\u044F \u0448\u0451\u043F\u043E\u0442\u0443.
      \u041F\u0443\u0442\u044C \u043E\u043A\u043E\u043D\u0447\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870794
    m_Localized: "\u041A \u0443\u0442\u0440\u0443 \u0432 \u043B\u0430\u0433\u0435\u0440\u0435
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0442\u0438\u0448\u0438\u043D\u0430 \u0438 \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439
      \u043A\u043E\u0441\u0442\u0451\u0440. \u041D\u0438\u043A\u0442\u043E \u043D\u0435
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870795
    m_Localized: "\u041D\u0435 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u044F\u0442\u044C\u0441\u044F.
      \u041A\u043E\u043D\u0435\u0446 \u043F\u043E\u0445\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870796
    m_Localized: "\u0411\u0443\u043D\u0442\u043E\u0432\u0449\u0438\u043A\u0438 \u0443\u0432\u043E\u0434\u044F\u0442
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0438 \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432
      \u0432 \u043D\u043E\u0447\u044C. \u041A\u0443\u043F\u0435\u0446 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u043E\u0434\u0438\u043D \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777183842304
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0433\u043E\u043B\u043E\u0434.
      \u041A\u043E\u043D\u0435\u0446 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777183842305
    m_Localized: "\u041E\u0434\u0438\u043D \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u043C
      \u043F\u0443\u0442\u043D\u0438\u043A\u0438 \u043F\u0430\u0434\u0430\u044E\u0442
      \u0432 \u043F\u0435\u0441\u043A\u0438. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0443\u0433\u0430\u0441\u0430\u0435\u0442 \u0431\u0435\u0437\u043C\u043E\u043B\u0432\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777183842306
    m_Localized: "\u0421\u043B\u043E\u0436\u0438\u0442\u044C \u043F\u043E\u043B\u043D\u043E\u043C\u043E\u0447\u0438\u044F.
      \u041F\u043E\u0445\u043E\u0434 \u043E\u043A\u043E\u043D\u0447\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777183842307
    m_Localized: "\u041D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0438 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u044E\u0442
      \u0442\u044E\u043A\u0438 \u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F.
      \u041A\u0443\u043F\u0435\u0446 \u043E\u0434\u0438\u043D \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435,
      \u0431\u0435\u0437 \u0433\u0440\u0443\u0437\u0430 \u0438 \u0431\u0435\u0437
      \u0441\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777183842308
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u0432\u0441\u0451 \u0437\u0430
      \u0434\u043E\u043B\u0433\u0438. \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C \u0437\u0430\u043A\u0440\u044B\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777183842309
    m_Localized: "\u0417\u0430\u0438\u043C\u043E\u0434\u0430\u0432\u0435\u0446 \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0446\u0435\u043B\u0438\u043A\u043E\u043C.
      \u041A\u0443\u043F\u0435\u0446 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0434\u043E\u043C\u043E\u0439 \u043F\u0435\u0448\u043A\u043E\u043C \u0438
      \u0431\u0435\u0437 \u0433\u0440\u043E\u0448\u0430."
    m_Metadata:
      m_Items: []
