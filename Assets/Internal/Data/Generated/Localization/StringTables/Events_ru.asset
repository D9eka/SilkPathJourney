  - m_Id: 12985643238940702
    m_Localized: "\u0412\u044B \u0431\u0435\u0440\u0435\u0436\u043D\u043E \u0437\u0430\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0435
      \u0444\u0438\u0433\u0443\u0440\u043A\u0443 \u0438 \u043F\u0440\u044F\u0447\u0435\u0442\u0435
      \u0432 \u0433\u0440\u0443\u0437. \u0421\u0435\u0440\u0435\u0431\u0440\u043E
      \u0438\u0437 \u0442\u0430\u0439\u043D\u0438\u043A\u0430 \u043F\u043E\u043A\u0440\u043E\u0435\u0442
      \u0440\u0430\u0441\u0445\u043E\u0434\u044B, \u0430 \u043D\u0430\u0434\u043F\u0438\u0441\u044C
      \u043D\u0430 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0438 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043F\u0443\u0442\u044C \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u043D\u0430\u0445\u043E\u0434\u043A\u0435. \u041F\u0435\u0440\u0432\u044B\u0439
      \u044D\u0442\u0430\u043F \u043F\u0440\u043E\u0439\u0434\u0435\u043D \u2014
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u043D\u043E\u0432\u044B\u0435 \u0440\u0443\u0438\u043D\u044B,
      \u043D\u043E\u0432\u044B\u0435 \u0437\u0430\u0433\u0430\u0434\u043A\u0438 \u0438
      \u0432\u0441\u0451 \u0431\u043E\u043B\u0435\u0435 \u0446\u0435\u043D\u043D\u044B\u0435
      \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0438."
