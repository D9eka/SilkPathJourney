  - m_Id: 10857774509449220
    m_Localized: "\u0417\u0430 \u043F\u043E\u043B\u043E\u0433\u0438\u043C \u0445\u043E\u043B\u043C\u043E\u043C
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0448\u0443\u043C\u043D\u043E\u0435
      \u0437\u0440\u0435\u043B\u0438\u0449\u0435: \u0434\u0435\u0441\u044F\u0442\u043A\u0438
      \u0432\u043E\u0439\u043B\u043E\u0447\u043D\u044B\u0445 \u044E\u0440\u0442,
      \u0434\u044B\u043C\u044F\u0449\u0438\u0435\u0441\u044F \u043A\u043E\u0441\u0442\u0440\u044B,
      \u0440\u0436\u0430\u043D\u0438\u0435 \u043B\u043E\u0448\u0430\u0434\u0435\u0439.
      \u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0435 \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0438
      \u0443\u0441\u0442\u0440\u043E\u0438\u043B\u0438 \u044F\u0440\u043C\u0430\u0440\u043A\u0443
      \u2014 \u0442\u0430\u0431\u0443\u043D\u044B \u0441\u0442\u043E\u044F\u0442
      \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0435 \u043A \u0434\u043B\u0438\u043D\u043D\u044B\u043C
      \u043A\u043E\u043D\u043E\u0432\u044F\u0437\u044F\u043C, \u043A\u0440\u0435\u043F\u043A\u0438\u0435
      \u043D\u0438\u0437\u043A\u043E\u0440\u043E\u0441\u043B\u044B\u0435 \u0441\u0442\u0435\u043F\u043D\u044B\u0435
      \u043A\u043E\u043D\u0438, \u0430 \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438
      \u2014 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u0430\u0442\u043D\u044B\u0445
      \u0436\u0435\u0440\u0435\u0431\u0446\u043E\u0432, \u043B\u043E\u0441\u043D\u044F\u0449\u0438\u0445\u0441\u044F
      \u043D\u0430 \u0441\u043E\u043B\u043D\u0446\u0435. \u041C\u0443\u0436\u0447\u0438\u043D\u044B
      \u0432 \u043A\u043E\u0436\u0430\u043D\u044B\u0445 \u0431\u0435\u0437\u0440\u0443\u043A\u0430\u0432\u043A\u0430\u0445
      \u0438 \u043C\u0435\u0445\u043E\u0432\u044B\u0445 \u0448\u0430\u043F\u043A\u0430\u0445
      \u0432\u0435\u0434\u0443\u0442 \u043A\u043E\u043D\u0435\u0439 \u043F\u043E
      \u043A\u0440\u0443\u0433\u0443, \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044F
      \u0430\u043B\u043B\u044E\u0440. \u0417\u0430\u043F\u0430\u0445 \u043A\u043E\u043D\u0441\u043A\u043E\u0433\u043E
      \u043F\u043E\u0442\u0430, \u043A\u0443\u043C\u044B\u0441\u0430 \u0438 \u0436\u0430\u0440\u0435\u043D\u043E\u0433\u043E
      \u0431\u0430\u0440\u0430\u043D\u044C\u0435\u0433\u043E \u0436\u0438\u0440\u0430
      \u0432\u0438\u0441\u0438\u0442 \u0432 \u0442\u0451\u043F\u043B\u043E\u043C
      \u0432\u043E\u0437\u0434\u0443\u0445\u0435. \u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430
      \u0441 \u0437\u0430\u043F\u043B\u0435\u0442\u0451\u043D\u043D\u043E\u0439 \u0432
      \u043A\u043E\u0441\u0443 \u0431\u043E\u0440\u043E\u0434\u043E\u0439 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0438 \u043C\u0430\u0448\u0435\u0442
      \u0440\u0443\u043A\u043E\u0439, \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u044F
      \u043F\u043E\u0434\u043E\u0439\u0442\u0438:\r\n\r\n<npc_speech lang=\"Turkic\">\u0417\u0434\u043E\u0440\u043E\u0432
      \u0431\u0443\u0434\u044C, \u043F\u0443\u0442\u043D\u0438\u043A! \u0423 \u043D\u0430\u0441
      \u043A\u043E\u043D\u0438 \u0435\u0441\u0442\u044C \u2014 \u0434\u043E\u0431\u0440\u044B\u0435,
      \u043A\u0440\u0435\u043F\u043A\u0438\u0435, \u0431\u044B\u0441\u0442\u0440\u044B\u0435.
      \u041F\u043E\u0434\u0445\u043E\u0434\u0438, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438
      \u2014 \u043C\u043E\u0436\u0435\u0442, \u0441\u0442\u043E\u0440\u0433\u0443\u0435\u043C\u0441\u044F!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449221
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E
      \u043A\u043E\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449222
    m_Localized: "\u0412\u044B \u0443\u043A\u0430\u0437\u0430\u043B\u0438 \u043D\u0430
      \u043A\u0440\u0435\u043F\u043A\u043E\u0433\u043E \u0433\u043D\u0435\u0434\u043E\u0433\u043E
      \u043A\u043E\u043D\u044C\u043A\u0430 \u2014 \u043D\u0435 \u043A\u0440\u0430\u0441\u0430\u0432\u0435\u0446,
      \u043D\u043E \u0448\u0438\u0440\u043E\u043A\u043E\u0433\u0440\u0443\u0434\u044B\u0439,
      \u0441 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C\u0438 \u043A\u0440\u0435\u043F\u043A\u0438\u043C\u0438
      \u043D\u043E\u0433\u0430\u043C\u0438. \u041A\u043E\u0447\u0435\u0432\u043D\u0438\u043A
      \u043A\u0438\u0432\u043D\u0443\u043B, \u043F\u0440\u0438\u043D\u044F\u043B
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E, \u043F\u0435\u0440\u0435\u043A\u0438\u043D\u0443\u043B
      \u043F\u043E\u0432\u043E\u0434. \u041A\u043E\u043D\u044C \u0442\u043A\u043D\u0443\u043B\u0441\u044F
      \u043C\u043E\u0440\u0434\u043E\u0439 \u0432\u0430\u043C \u0432 \u043F\u043B\u0435\u0447\u043E
      \u2014 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439,
      \u043A \u0443\u043F\u0440\u044F\u0436\u0438 \u043F\u0440\u0438\u0432\u044B\u0447\u043D\u044B\u0439.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0446\u043E\u043A\u0430\u044E\u0442: \u0437\u0430\u043F\u0430\u0441\u043D\u0430\u044F
      \u0442\u044F\u0433\u043B\u043E\u0432\u0430\u044F \u0441\u0438\u043B\u0430 \u043D\u0430
      \u0434\u043E\u0440\u043E\u0433\u0435 \u2014 \u043D\u0435 \u0440\u043E\u0441\u043A\u043E\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449223
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0437\u0430 \u043F\u043E\u0440\u043E\u0434\u0438\u0441\u0442\u043E\u0433\u043E
      \u0436\u0435\u0440\u0435\u0431\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449224
    m_Localized: "\u0412\u044B \u043F\u0440\u0438\u043C\u0435\u0442\u0438\u043B\u0438
      \u0440\u043E\u0441\u043B\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u043A\u043E\u0432\u043E\u0433\u043E
      \u0436\u0435\u0440\u0435\u0431\u0446\u0430 \u043D\u0430 \u0434\u0430\u043B\u044C\u043D\u0435\u043C
      \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u043E\u0432\u044F\u0437\u0438
      \u2014 \u0442\u0430\u043A\u043E\u0433\u043E \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0434\u0430\u0448\u044C \u0432\u0442\u0440\u043E\u0435.
      \u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430 \u0437\u0430\u043B\u043E\u043C\u0438\u043B
      \u0446\u0435\u043D\u0443, \u043D\u043E \u0432\u044B \u0437\u043D\u0430\u043B\u0438
      \u043F\u0440\u0438\u0451\u043C\u044B: \u043F\u043E\u0445\u0432\u0430\u043B\u0438\u043B\u0438
      \u0435\u0433\u043E \u0442\u0430\u0431\u0443\u043D, \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0434\u043B\u0438\u043D\u043D\u044B\u0439 \u043F\u0443\u0442\u044C,
      \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B\u0438 \u043E\u0431\u043C\u0435\u043D
      \u2014 \u043C\u0435\u0448\u043E\u043A \u0441\u0443\u0448\u0451\u043D\u044B\u0445
      \u0444\u0438\u043D\u0438\u043A\u043E\u0432 \u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u043E.
      \u0422\u0440\u0438 \u043A\u0440\u0443\u0433\u0430 \u0442\u043E\u0440\u0433\u0430,
      \u0438 \u0436\u0435\u0440\u0435\u0431\u0435\u0446 \u0432\u0430\u0448 \u2014
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u043C
      \u0441\u0435\u0434\u043B\u043E\u043C \u0438\u0437 \u0432\u043E\u0439\u043B\u043E\u043A\u0430
      \u0438 \u043A\u043E\u0436\u0438. \u041A\u043E\u0447\u0435\u0432\u043D\u0438\u043A
      \u0445\u043B\u043E\u043F\u043D\u0443\u043B \u043F\u043E \u0440\u0443\u043A\u0430\u043C
      \u0438 \u043D\u0430\u043B\u0438\u043B \u0432\u0430\u043C \u043F\u0438\u0430\u043B\u0443
      \u043A\u0443\u043C\u044B\u0441\u0430 \u2014 \u0437\u043D\u0430\u043A \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F
      \u043A \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u043E\u043C\u0443 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449225
    m_Localized: "\u0421\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043A\u0440\u0435\u043F\u043A\u0438\u043C \u043E\u0440\u0435\u0448\u043A\u043E\u043C.
      \u0412\u0430\u0448\u0438 \u0434\u043E\u0432\u043E\u0434\u044B \u0441\u043A\u043E\u043B\u044C\u0437\u0438\u043B\u0438
      \u043C\u0438\u043C\u043E \u2014 \u043E\u043D \u0442\u043E\u043B\u044C\u043A\u043E
      \u043A\u0430\u0447\u0430\u043B \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0438
      \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u043B \u0446\u0435\u043D\u0443.
      \u0412 \u0438\u0442\u043E\u0433\u0435 \u0432\u044B \u0443\u0441\u0442\u0443\u043F\u0438\u043B\u0438
      \u043F\u0435\u0440\u0432\u044B\u043C\u0438: \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B\u0438
      \u043F\u043E\u043B\u043D\u0443\u044E \u0446\u0435\u043D\u0443 \u0437\u0430
      \u043A\u043E\u043D\u044F, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0445\u043E\u0440\u043E\u0448, \u043D\u043E \u043D\u0435 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E.
      \u041A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0438 \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u043B\u0438\u0441\u044C
      \u0438 \u043F\u043E\u0441\u043C\u0435\u0438\u0432\u0430\u043B\u0438\u0441\u044C.
      \u0423\u0440\u043E\u043A: \u0441\u0442\u0435\u043F\u043D\u043E\u0439 \u0442\u043E\u0440\u0433
      \u2014 \u043D\u0435 \u0431\u0430\u0437\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449226
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u0442
      \u043B\u043E\u0448\u0430\u0434\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449227
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043E\u043A\u0438\u043D\u0443\u043B
      \u0442\u0430\u0431\u0443\u043D \u0446\u0435\u043F\u043A\u0438\u043C \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C
      \u0438 \u0442\u0440\u043E\u043D\u0443\u043B \u0432\u0430\u0441 \u0437\u0430
      \u043B\u043E\u043A\u043E\u0442\u044C: \xAB\u0412\u043E\u043D \u0442\u043E\u0442,
      \u043F\u0435\u0433\u0438\u0439, \u0442\u0440\u0435\u0442\u0438\u0439 \u0441\u043F\u0440\u0430\u0432\u0430
      \u2014 \u0432\u0438\u0434\u0438\u0448\u044C, \u043A\u0430\u043A \u0441\u0442\u0430\u0432\u0438\u0442
      \u0437\u0430\u0434\u043D\u0438\u0435? \u042D\u0442\u043E \u0444\u0435\u0440\u0433\u0430\u043D\u0441\u043A\u0430\u044F
      \u043A\u0440\u043E\u0432\u044C, \u043D\u0435 \u0447\u0438\u0441\u0442\u0430\u044F
      \u0441\u0442\u0435\u043F\u043D\u0430\u044F. \u0421\u0442\u043E\u0438\u0442
      \u0432\u0447\u0435\u0442\u0432\u0435\u0440\u043E \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043F\u0440\u043E\u0441\u044F\u0442, \u043D\u043E \u0445\u043E\u0437\u044F\u0438\u043D
      \u043D\u0435 \u0437\u043D\u0430\u0435\u0442\xBB. \u0412\u044B \u043F\u043E\u0434\u043E\u0448\u043B\u0438
      \u043A \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0443, \u043A\u0430\u043A
      \u0431\u0443\u0434\u0442\u043E \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u0443\u044F\u0441\u044C
      \u0433\u043D\u0435\u0434\u044B\u043C \u0440\u044F\u0434\u043E\u043C, \u0430
      \u043F\u043E\u0442\u043E\u043C \u043A\u0430\u043A \u0431\u044B \u043D\u0435\u0432\u0437\u043D\u0430\u0447\u0430\u0439
      \u0443\u043A\u0430\u0437\u0430\u043B\u0438 \u043D\u0430 \u043F\u0435\u0433\u043E\u0433\u043E.
      \u0422\u043E\u0440\u0433 \u0434\u043B\u0438\u043B\u0441\u044F \u043D\u0435\u0434\u043E\u043B\u0433\u043E
      \u2014 \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A \u043E\u0442\u0434\u0430\u043B
      \u043A\u043E\u043D\u044F \u0437\u0430 \u0432\u043E\u0441\u0435\u043C\u044C
      \u043C\u043E\u043D\u0435\u0442, \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u0439,
      \u0447\u0442\u043E \u0441\u0431\u044B\u043B \xAB\u043D\u0435\u0441\u043A\u043B\u0430\u0434\u043D\u043E\u0433\u043E\xBB.
      \u0412 \u043F\u0440\u0438\u0434\u0430\u0447\u0443 \u0432\u0440\u0443\u0447\u0438\u043B
      \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0435 \u0441\u0435\u0434\u043B\u043E.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B
      \u0441\u0435\u0431\u0435 \u0435\u0434\u0432\u0430 \u0437\u0430\u043C\u0435\u0442\u043D\u0443\u044E
      \u0443\u043B\u044B\u0431\u043A\u0443, \u043A\u043E\u0433\u0434\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449228
    m_Localized: "\u0420\u0430\u043D\u0435\u043D\u044B\u0439 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449229
    m_Localized: "\u0423 \u043E\u0431\u043E\u0447\u0438\u043D\u044B, \u0432 \u0442\u0435\u043D\u0438
      \u0437\u0430\u0441\u043E\u0445\u0448\u0435\u0433\u043E \u043A\u0430\u0440\u0430\u0433\u0430\u0447\u0430,
      \u0441\u0438\u0434\u0438\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u2014
      \u043F\u0440\u0438\u0441\u043B\u043E\u043D\u0438\u043B\u0441\u044F \u0441\u043F\u0438\u043D\u043E\u0439
      \u043A \u0441\u0442\u0432\u043E\u043B\u0443, \u043D\u043E\u0433\u0438 \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u044B,
      \u043B\u0435\u0432\u0430\u044F \u0440\u0443\u043A\u0430 \u043F\u0440\u0438\u0436\u0430\u0442\u0430
      \u043A \u0431\u043E\u043A\u0443 \u0433\u0440\u044F\u0437\u043D\u043E\u0439
      \u0442\u0440\u044F\u043F\u043A\u043E\u0439, \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D\u043D\u043E\u0439
      \u0431\u0443\u0440\u044B\u043C. \u0420\u044F\u0434\u043E\u043C \u0432\u043E\u0442\u043A\u043D\u0443\u0442
      \u0432 \u0437\u0435\u043C\u043B\u044E \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
      \u043C\u0435\u0447, \u0449\u0435\u0440\u0431\u0430\u0442\u044B\u0439, \u043D\u043E
      \u0434\u043E\u0431\u0440\u043E\u0442\u043D\u044B\u0439. \u041D\u0430 \u043C\u0443\u0436\u0447\u0438\u043D\u0435
      \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u044B\u0439 \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u043D\u0430\u0433\u0440\u0443\u0434\u043D\u0438\u043A \u0441\u043E \u0441\u043B\u0435\u0434\u0430\u043C\u0438
      \u0443\u0434\u0430\u0440\u043E\u0432, \u043F\u044B\u043B\u044C\u043D\u044B\u0435
      \u0441\u0430\u043F\u043E\u0433\u0438, \u043D\u0430 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u0435
      \u2014 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u0431\u0440\u0430\u0441\u043B\u0435\u0442-\u043E\u0431\u0435\u0440\u0435\u0433
      \u0438\u0437 \u0432\u0438\u0442\u043E\u0439 \u0431\u0440\u043E\u043D\u0437\u044B.
      \u041E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u0443,
      \u043A\u043E\u0433\u0434\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0435\u0442\u0441\u044F:
      \u043B\u0438\u0446\u043E \u043E\u0431\u0432\u0435\u0442\u0440\u0435\u043D\u043D\u043E\u0435,
      \u0433\u043B\u0430\u0437\u0430 \u044F\u0441\u043D\u044B\u0435, \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
      \u043D\u0430 \u0436\u0430\u0440. \u0411\u044B\u0432\u0448\u0438\u0439 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u2014 \u044D\u0442\u043E
      \u0432\u0438\u0434\u043D\u043E \u043F\u043E \u0432\u044B\u043F\u0440\u0430\u0432\u043A\u0435
      \u0438 \u043F\u043E \u0448\u0440\u0430\u043C\u0430\u043C. \u0425\u0440\u0438\u043F\u043B\u043E,
      \u0441 \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u043C \u0430\u043A\u0446\u0435\u043D\u0442\u043E\u043C,
      \u043E\u043D \u043E\u043A\u043B\u0438\u043A\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u043D\u0443\u044E
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449230
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432\u043E\u0434\u0443
      \u0438 \u0435\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449231
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0441\u0431\u0440\u043E\u0441\u0438\u043B
      \u0441 \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0431\u0443\u0440\u0434\u044E\u043A
      \u0432\u043E\u0434\u044B \u0438 \u0443\u0437\u0435\u043B\u043E\u043A \u0441
      \u043B\u0435\u043F\u0451\u0448\u043A\u0430\u043C\u0438. \u0420\u0430\u043D\u0435\u043D\u044B\u0439
      \u043A\u0438\u0432\u043D\u0443\u043B, \u043D\u0435 \u043E\u0442\u0432\u043E\u0434\u044F
      \u0433\u043B\u0430\u0437, \u0438 \u043F\u0440\u043E\u0448\u0435\u043F\u0442\u0430\u043B
      \xAB\u0441\u043F\u0430\u0441\u0438\u0431\u043E\xBB \u043D\u0430 \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u043C.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435 \u2014 \u043B\u044E\u0434\u0438 \u043C\u043E\u043B\u0447\u0430\u0442,
      \u043D\u043E \u0432 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0438 \u043D\u0435\u0442
      \u0441\u0442\u044B\u0434\u0430. \u0412\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0447\u0442\u043E \u043C\u043E\u0433\u043B\u0438. \u041E\u043D \u2014 \u0441\u043E\u043B\u0434\u0430\u0442,
      \u043E\u043D \u0432\u044B\u0436\u0438\u0432\u0435\u0442 \u0438\u043B\u0438
      \u043D\u0435\u0442, \u043D\u043E \u043D\u0435 \u043E\u0442 \u0433\u043E\u043B\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449232
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u043F\u043E\u0434\u043B\u0430\u0442\u0430\u0442\u044C
      \u0438 \u0432\u0437\u044F\u0442\u044C \u0441 \u0441\u043E\u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449233
    m_Localized: "\u0420\u0430\u043D\u0443 \u043F\u0440\u043E\u043C\u044B\u043B\u0438
      \u043A\u0443\u043C\u044B\u0441\u043E\u043C \u2014 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C,
      \u0447\u0442\u043E \u043D\u0430\u0448\u043B\u043E\u0441\u044C, \u2014 \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043B\u0438
      \u0447\u0438\u0441\u0442\u043E\u0439 \u0442\u0440\u044F\u043F\u0438\u0446\u0435\u0439,
      \u043F\u0440\u0438\u0442\u044F\u043D\u0443\u043B\u0438 \u043A \u0440\u0451\u0431\u0440\u0430\u043C
      \u043E\u0431\u0440\u044B\u0432\u043A\u043E\u043C \u0440\u0435\u043C\u043D\u044F.
      \u0420\u0430\u043D\u0435\u043D\u044B\u0439 \u0441\u0442\u0438\u0441\u043D\u0443\u043B
      \u0437\u0443\u0431\u044B, \u043F\u043E\u0431\u043B\u0435\u0434\u043D\u0435\u043B,
      \u043D\u043E \u043D\u0435 \u0438\u0437\u0434\u0430\u043B \u043D\u0438 \u0437\u0432\u0443\u043A\u0430.
      \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u043E\u043D \u0443\u0436\u0435
      \u0441\u0438\u0434\u0435\u043B \u043D\u0430 \u0437\u0430\u0434\u043D\u0435\u0439
      \u043F\u043E\u0432\u043E\u0437\u043A\u0435, \u0430 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430 \u0434\u043D\u044F \u0432\u0441\u0442\u0430\u043B \u043D\u0430
      \u043D\u043E\u0433\u0438. \xAB\u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442
      \u0424\u0430\u0440\u0440\u0443\u0445, \u2014 \u0441\u043A\u0430\u0437\u0430\u043B
      \u043E\u043D, \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044F \u0441\u0432\u043E\u0439
      \u043C\u0435\u0447. \u2014 \u042F \u0431\u044B\u043B \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u043C
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0438\u0437 \u0411\u0443\u0445\u0430\u0440\u044B.
      \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438 \u043F\u0435\u0440\u0435\u0431\u0438\u043B\u0438
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445 \u0443 \u0441\u0443\u0445\u043E\u0433\u043E
      \u0440\u0443\u0441\u043B\u0430, \u0430 \u043C\u0435\u043D\u044F \u0431\u0440\u043E\u0441\u0438\u043B\u0438
      \u0443\u043C\u0438\u0440\u0430\u0442\u044C. \u0414\u043E\u043B\u0433 \u0437\u0430
      \u043C\u043D\u043E\u0439.\xBB \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0441\u0442\u0430\u043B
      \u043A\u0440\u0435\u043F\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449234
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u044F\u0437\u043A\u0430 \u0434\u0430\u043B\u0430\u0441\u044C
      \u0442\u044F\u0436\u0435\u043B\u043E \u2014 \u0440\u0430\u043D\u0430 \u0433\u043B\u0443\u0431\u0436\u0435,
      \u0447\u0435\u043C \u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C, \u0438
      \u043A\u0440\u043E\u0432\u044C \u043D\u0435 \u0443\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F.
      \u0420\u0430\u043D\u0435\u043D\u043E\u0433\u043E \u0443\u043B\u043E\u0436\u0438\u043B\u0438
      \u043D\u0430 \u0442\u044E\u043A\u0438, \u043D\u043E \u043A \u0432\u0435\u0447\u0435\u0440\u0443
      \u043D\u0430\u0447\u0430\u043B\u0441\u044F \u0436\u0430\u0440. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0432\u0441\u0442\u0430\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u0435\u043C
      \u043D\u0430 \u0441\u0443\u0442\u043A\u0438, \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u044F
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0432\u043E\u0440\u0447\u0430\u0442: \u043B\u0438\u0448\u043D\u0438\u0439
      \u0440\u043E\u0442, \u0430 \u0442\u043E\u043B\u043A\u0443 \u043F\u043E\u043A\u0430
      \u043D\u0435\u0442. \u0427\u0435\u043B\u043E\u0432\u0435\u043A \u0436\u0438\u0432,
      \u043D\u043E \u0441\u043B\u0430\u0431 \u2014 \u0438\u0434\u0442\u0438 \u043D\u0435
      \u043C\u043E\u0436\u0435\u0442, \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449235
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0440\u0430\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449236
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043F\u0440\u0438\u0441\u0435\u043B
      \u0440\u044F\u0434\u043E\u043C, \u0440\u0430\u0441\u043A\u0440\u044B\u043B
      \u0441\u0432\u043E\u0439 \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u0441\u0432\u0451\u0440\u0442\u043E\u043A
      \u0441 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438
      \u0438 \u043C\u043E\u043B\u0447\u0430 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u0440\u0430\u043D\u0443. \xAB\u0427\u0438\u0441\u0442\u043E \u0432\u043E\u0448\u043B\u043E
      \u2014 \u0440\u0435\u0431\u0440\u043E \u043E\u0442\u0432\u0435\u043B\u043E
      \u043A\u043B\u0438\u043D\u043E\u043A, \u0438\u043D\u0430\u0447\u0435 \u0431\u044B\u043B
      \u0431\u044B \u043C\u0451\u0440\u0442\u0432. \u041D\u043E \u043A\u0440\u043E\u0432\u0438
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u043C\u043D\u043E\u0433\u043E.\xBB
      \u041E\u043D \u043F\u0440\u043E\u043C\u044B\u043B \u043F\u043E\u0440\u0435\u0437
      \u043D\u0430\u0441\u0442\u043E\u0435\u043C \u043F\u043E\u043B\u044B\u043D\u0438,
      \u043D\u0430\u043B\u043E\u0436\u0438\u043B \u0442\u0443\u0433\u0443\u044E \u043F\u043E\u0432\u044F\u0437\u043A\u0443
      \u0441 \u043F\u0447\u0435\u043B\u0438\u043D\u044B\u043C \u0432\u043E\u0441\u043A\u043E\u043C
      \u0438 \u0432\u043B\u0438\u043B \u0440\u0430\u043D\u0435\u043D\u043E\u043C\u0443
      \u0432 \u0440\u043E\u0442 \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u0433\u043E\u0440\u044C\u043A\u0438\u0439
      \u043E\u0442\u0432\u0430\u0440. \u041A \u0443\u0442\u0440\u0443 \u0436\u0430\u0440
      \u0441\u043F\u0430\u043B. \u0427\u0435\u0440\u0435\u0437 \u0434\u0435\u043D\u044C
      \u0424\u0430\u0440\u0440\u0443\u0445 \u0441\u0442\u043E\u044F\u043B \u043D\u0430
      \u043D\u043E\u0433\u0430\u0445 \u2014 \u0431\u043B\u0435\u0434\u043D\u044B\u0439,
      \u043D\u043E \u0442\u0432\u0451\u0440\u0434\u044B\u0439. \u041E\u043D \u043C\u043E\u043B\u0447\u0430
      \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u043B\u0441\u044F \u043B\u0435\u043A\u0430\u0440\u044E,
      \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u043A \u0432\u0430\u043C: \xAB\u041C\u043E\u044F \u0436\u0438\u0437\u043D\u044C
      \u2014 \u0432\u0430\u0448\u0430. \u041F\u043E\u043A\u0430 \u0434\u044B\u0448\u0443
      \u2014 \u0432\u0430\u0448 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0432
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438\xBB.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438, \u0432\u0438\u0434\u0435\u0432\u0448\u0438\u0435
      \u0432\u0441\u0451, \u0432\u044B\u043F\u0440\u044F\u043C\u0438\u043B\u0438
      \u0441\u043F\u0438\u043D\u044B \u2014 \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435
      \u0442\u0435\u043F\u0435\u0440\u044C \u0435\u0441\u0442\u044C \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
      \u0431\u043E\u0435\u0446."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449237
    m_Localized: "\u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0440\u0435\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449238
    m_Localized: "\u0411\u0440\u043E\u0434, \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u0439
      \u043D\u0430 \u043A\u0430\u0440\u0442\u0435 \u0447\u0451\u0440\u0442\u043E\u0447\u043A\u043E\u0439,
      \u0438\u0441\u0447\u0435\u0437 \u2014 \u0432\u043C\u0435\u0441\u0442\u043E
      \u043C\u0435\u043B\u043A\u043E\u0433\u043E \u0440\u0443\u0447\u044C\u044F \u043F\u043E\u043F\u0435\u0440\u0451\u043A
      \u0434\u043E\u0440\u043E\u0433\u0438 \u043D\u0435\u0441\u0451\u0442\u0441\u044F
      \u043C\u0443\u0442\u043D\u044B\u0439 \u0431\u0443\u0440\u044B\u0439 \u043F\u043E\u0442\u043E\u043A
      \u0448\u0438\u0440\u0438\u043D\u043E\u0439 \u0432 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C
      \u0448\u0430\u0433\u043E\u0432. \u0422\u0430\u043B\u044B\u0435 \u0432\u043E\u0434\u044B
      \u0441 \u0434\u0430\u043B\u0451\u043A\u0438\u0445 \u0433\u043E\u0440 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0438
      \u0440\u0435\u0447\u043A\u0443 \u0432 \u0440\u0435\u0432\u0443\u0449\u0443\u044E
      \u0441\u0442\u0435\u043D\u0443 \u0433\u0440\u044F\u0437\u0438, \u043D\u0435\u0441\u0443\u0449\u0443\u044E
      \u0432\u0435\u0442\u043A\u0438, \u0434\u0451\u0440\u043D \u0438 \u0434\u043E\u0445\u043B\u0443\u044E
      \u043E\u0432\u0446\u0443. \u041A\u043E\u043B\u0435\u044F \u043E\u0431\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0443 \u043A\u0440\u043E\u043C\u043A\u0438 \u0432\u043E\u0434\u044B, \u043C\u043E\u043A\u0440\u044B\u0439
      \u0433\u043B\u0438\u043D\u0438\u0441\u0442\u044B\u0439 \u0431\u0435\u0440\u0435\u0433
      \u043E\u043F\u043B\u044B\u0432\u0430\u0435\u0442 \u043D\u0430 \u0433\u043B\u0430\u0437\u0430\u0445.
      \u041F\u0435\u0440\u0435\u0434\u043D\u0438\u0439 \u0432\u043E\u043B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F,
      \u0443\u043F\u0451\u0440\u0441\u044F \u0438 \u043C\u043E\u0442\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u2014 \u0447\u0443\u0435\u0442
      \u0433\u043B\u0443\u0431\u0438\u043D\u0443. \u0411\u0440\u043E\u0434 \u043D\u0435\u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043C,
      \u043E\u0431\u044A\u0435\u0437\u0434 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D,
      \u0430 \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u043D\u0435 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449239
    m_Localized: "\u0416\u0434\u0430\u0442\u044C, \u043F\u043E\u043A\u0430 \u0432\u043E\u0434\u0430
      \u0441\u043F\u0430\u0434\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449240
    m_Localized: "\u0414\u0432\u0430 \u0434\u043D\u044F \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443.
      \u0412\u043E\u0434\u0430 \u0441\u043F\u0430\u0434\u0430\u0435\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u2014 \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u0435 \u0443\u0442\u0440\u043E
      \u0434\u043D\u043E \u0443\u0436\u0435 \u0432\u0438\u0434\u043D\u043E, \u043A\u0430\u043C\u043D\u0438
      \u0431\u043B\u0435\u0441\u0442\u044F\u0442 \u043D\u0430 \u043C\u0435\u043B\u043A\u043E\u0432\u043E\u0434\u044C\u0435.
      \u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430 \u043F\u0440\u043E\u0448\u043B\u0430
      \u043F\u043E \u043F\u043E\u044F\u0441, \u0432\u043E\u043B\u044B \u0443\u043F\u0438\u0440\u0430\u043B\u0438\u0441\u044C,
      \u043D\u043E \u043F\u0440\u043E\u0448\u043B\u0438. \u0414\u0432\u0430 \u0434\u043D\u044F
      \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432, \u0434\u0432\u0430 \u0434\u043D\u044F
      \u043D\u0435\u0440\u0432\u043E\u0432 \u2014 \u0438 \u0441\u043A\u0443\u043B\u044F\u0449\u0438\u0439
      \u0432\u0435\u0442\u0435\u0440, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0442\u044F\u043D\u0435\u0442 \u0441 \u0432\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449241
    m_Localized: "\u0420\u0438\u0441\u043A\u043D\u0443\u0442\u044C \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449242
    m_Localized: "\u0412\u044B \u043D\u0430\u0448\u043B\u0438 \u043C\u0435\u0441\u0442\u043E
      \u0432\u044B\u0448\u0435 \u043F\u043E \u0442\u0435\u0447\u0435\u043D\u0438\u044E,
      \u0433\u0434\u0435 \u0440\u0443\u0441\u043B\u043E \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u0435\u0442\u0441\u044F
      \u0438 \u043C\u0435\u043B\u0435\u0435\u0442 \u2014 \u043A\u0430\u043C\u043D\u0438
      \u0442\u043E\u0440\u0447\u0430\u0442 \u0438\u0437 \u0432\u043E\u0434\u044B,
      \u043E\u0431\u0440\u0430\u0437\u0443\u044F \u043F\u043E\u0434\u043E\u0431\u0438\u0435
      \u0433\u0440\u044F\u0434\u044B. \u0412\u043E\u043B\u043E\u0432 \u043F\u0435\u0440\u0435\u0432\u0435\u043B\u0438
      \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443, \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u043B\u0438 \u043D\u0430 \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u0445,
      \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0445 \u043A \u0434\u0435\u0440\u0435\u0432\u044C\u044F\u043C
      \u043D\u0430 \u0442\u043E\u043C \u0431\u0435\u0440\u0435\u0433\u0443. \u0412\u043E\u0434\u0430
      \u0445\u043B\u0435\u0441\u0442\u0430\u043B\u0430 \u043F\u043E \u0441\u0442\u0443\u043F\u0438\u0446\u044B,
      \u043D\u043E \u0434\u043D\u043E \u0434\u0435\u0440\u0436\u0430\u043B\u043E.
      \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0444\u0443\u0440\u0433\u043E\u043D
      \u0432\u044B\u0442\u044F\u043D\u0443\u043B\u0438 \u0443\u0436\u0435 \u0432
      \u0441\u0443\u043C\u0435\u0440\u043A\u0430\u0445 \u2014 \u043C\u043E\u043A\u0440\u044B\u0435,
      \u0433\u0440\u044F\u0437\u043D\u044B\u0435, \u043D\u043E \u0446\u0435\u043B\u044B\u0435.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043E\u0440\u0430\u043B\u0438
      \u0434\u0440\u0443\u0433 \u043D\u0430 \u0434\u0440\u0443\u0433\u0430 \u043E\u0442
      \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F, \u0430 \u043F\u043E\u0442\u043E\u043C
      \u0445\u043E\u0445\u043E\u0442\u0430\u043B\u0438 \u043E\u0442 \u043E\u0431\u043B\u0435\u0433\u0447\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449243
    m_Localized: "\u041D\u0430 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u043F\u043E\u0442\u043E\u043A\u0430
      \u0434\u043D\u043E \u0443\u0448\u043B\u043E \u0438\u0437-\u043F\u043E\u0434
      \u043A\u043E\u043B\u0451\u0441 \u2014 \u044F\u043C\u0430, \u0441\u043A\u0440\u044B\u0442\u0430\u044F
      \u043C\u0443\u0442\u044C\u044E. \u041F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u043E \u0442\u0435\u0447\u0435\u043D\u0438\u0435\u043C,
      \u043E\u0441\u044C \u0445\u0440\u0443\u0441\u0442\u043D\u0443\u043B\u0430,
      \u0442\u044E\u043A \u0441 \u0442\u043E\u0432\u0430\u0440\u043E\u043C \u0441\u043E\u0440\u0432\u0430\u043B\u043E
      \u0438 \u0443\u043D\u0435\u0441\u043B\u043E \u0432\u043D\u0438\u0437 \u043F\u043E
      \u0440\u0435\u043A\u0435. \u0412\u043E\u043B\u044B \u0440\u0435\u0432\u0435\u043B\u0438,
      \u043B\u044E\u0434\u0438 \u0446\u0435\u043F\u043B\u044F\u043B\u0438\u0441\u044C
      \u0437\u0430 \u0431\u043E\u0440\u0442\u0430. \u041A\u043E\u0435-\u043A\u0430\u043A
      \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438 \u043D\u0430 \u0431\u0435\u0440\u0435\u0433
      \u2014 \u0441 \u0442\u0440\u0435\u0441\u043D\u0443\u0432\u0448\u0435\u0439
      \u043E\u0441\u044C\u044E, \u043F\u0440\u043E\u043C\u043E\u043A\u0448\u0438\u043C
      \u0433\u0440\u0443\u0437\u043E\u043C \u0438 \u043E\u0434\u043D\u0438\u043C
      \u0442\u044E\u043A\u043E\u043C \u043C\u0435\u043D\u044C\u0448\u0435. \u041C\u043E\u043A\u0440\u044B\u0435
      \u0434\u043E \u043D\u0438\u0442\u043A\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u043C\u043E\u043B\u0447\u0430 \u0432\u044B\u043B\u0438\u0432\u0430\u044E\u0442
      \u0432\u043E\u0434\u0443 \u0438\u0437 \u0441\u0430\u043F\u043E\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449244
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u043E\u0431\u0445\u043E\u0434\u043D\u043E\u0439 \u0431\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449245
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0434\u043E\u043B\u0433\u043E
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043D\u0430 \u0432\u043E\u0434\u0443,
      \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u043A\u0430\u0447\u0430\u043B \u0433\u043E\u043B\u043E\u0432\u043E\u0439
      \u0438 \u043F\u043E\u0448\u0451\u043B \u0432\u0432\u0435\u0440\u0445 \u043F\u043E
      \u0431\u0435\u0440\u0435\u0433\u0443, \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u044F
      \u043D\u0438 \u0441\u043B\u043E\u0432\u0430. \u0427\u0435\u0440\u0435\u0437
      \u043F\u043E\u043B\u0447\u0430\u0441\u0430 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F,
      \u043E\u0442\u0440\u044F\u0445\u0438\u0432\u0430\u044F \u0433\u043B\u0438\u043D\u0443
      \u0441 \u0441\u0430\u043F\u043E\u0433. \xAB\u0412\u044B\u0448\u0435 \u043F\u043E
      \u0442\u0435\u0447\u0435\u043D\u0438\u044E, \u0437\u0430 \u0438\u0437\u043B\u0443\u0447\u0438\u043D\u043E\u0439,
      \u0435\u0441\u0442\u044C \u0441\u0442\u0430\u0440\u044B\u0439 \u0431\u0440\u043E\u0434
      \u2014 \u043C\u0435\u0441\u0442\u043D\u044B\u0435 \u0433\u043E\u043D\u044F\u0442
      \u0441\u0442\u0430\u0434\u0430, \u0442\u0430\u043C \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0435
      \u0434\u043D\u043E \u0438 \u0448\u0438\u0440\u0438\u043D\u0430 \u0432\u0434\u0432\u043E\u0435,
      \u0437\u043D\u0430\u0447\u0438\u0442 \u2014 \u0433\u043B\u0443\u0431\u0438\u043D\u0430
      \u0432\u0434\u0432\u043E\u0435 \u043C\u0435\u043D\u044C\u0448\u0435. \u041F\u043E\u043B\u0434\u043D\u044F
      \u043A\u0440\u044E\u043A, \u043D\u043E \u043A\u043E\u043B\u0451\u0441\u0430
      \u043E\u0441\u0442\u0430\u043D\u0443\u0442\u0441\u044F \u0446\u0435\u043B\u044B.\xBB
      \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0431\u044B\u043B \u043D\u0430 \u0442\u043E\u043C \u0431\u0435\u0440\u0435\u0433\u0443
      \u2014 \u0441\u0443\u0445\u043E\u0439, \u0446\u0435\u043B\u044B\u0439, \u0441
      \u043F\u043E\u0442\u0435\u0440\u0435\u0439 \u0432\u0441\u0435\u0433\u043E \u043B\u0438\u0448\u044C
      \u043E\u0434\u043D\u043E\u0439 \u043B\u0435\u043F\u0451\u0448\u043A\u0438,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0432\u043E\u043B \u0441\u0442\u044F\u043D\u0443\u043B
      \u043D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u043F\u0440\u0438\u043D\u044F\u043B \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u043C\u043E\u043B\u0447\u0430, \u043A\u0430\u043A \u0441\u0430\u043C\u043E
      \u0441\u043E\u0431\u043E\u0439 \u0440\u0430\u0437\u0443\u043C\u0435\u044E\u0449\u0435\u0435\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449246
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0441\u043F\u0435\u0446\u0438\u044F\u043C\u0438
      \u0443 \u043E\u0430\u0437\u0438\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449247
    m_Localized: "\u0423 \u043A\u0440\u0430\u044F \u043E\u0430\u0437\u0438\u0441\u0430,
      \u043F\u043E\u0434 \u0444\u0438\u043D\u0438\u043A\u043E\u0432\u043E\u0439 \u043F\u0430\u043B\u044C\u043C\u043E\u0439,
      \u0440\u0430\u0441\u0441\u0442\u0435\u043B\u0435\u043D \u043F\u043E\u043B\u043E\u0441\u0430\u0442\u044B\u0439
      \u043A\u043E\u0432\u0451\u0440 \u2014 \u043D\u0430 \u043D\u0451\u043C \u043C\u0435\u0448\u043E\u0447\u043A\u0438
      \u0441\u043E \u0441\u043F\u0435\u0446\u0438\u044F\u043C\u0438 \u0438 \u043B\u0430\u0442\u0443\u043D\u043D\u044B\u0435
      \u0432\u0435\u0441\u044B. \u0425\u0443\u0434\u043E\u0449\u0430\u0432\u044B\u0439
      \u0430\u0440\u0430\u0431 \u0432 \u0431\u0435\u043B\u043E\u043C \u0442\u044E\u0440\u0431\u0430\u043D\u0435
      \u0441\u0438\u0434\u0438\u0442 \u043D\u0430 \u043F\u044F\u0442\u043A\u0430\u0445,
      \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u044F \u043D\u0438\u0442\u0438
      \u0448\u0430\u0444\u0440\u0430\u043D\u0430 \u043D\u0430\u0434 \u043C\u0435\u0434\u043D\u043E\u0439
      \u043C\u0438\u0441\u043A\u043E\u0439. \u0417\u0430\u043F\u0430\u0445 \u0443\u0434\u0430\u0440\u044F\u0435\u0442
      \u043D\u0430 \u0434\u0435\u0441\u044F\u0442\u044C \u0448\u0430\u0433\u043E\u0432
      \u2014 \u0433\u043E\u0440\u044C\u043A\u0438\u0439, \u043F\u0440\u044F\u043D\u044B\u0439,
      \u0433\u0443\u0441\u0442\u043E\u0439: \u043B\u0430\u0434\u0430\u043D \u0438
      \u0448\u0430\u0444\u0440\u0430\u043D, \u043C\u0443\u0441\u043A\u0443\u0441
      \u0438 \u043A\u0430\u043C\u0444\u043E\u0440\u0430. \u0421\u043B\u0435\u0434\u044B
      \u0441\u0442\u0430\u0440\u044B\u0445 \u043A\u043E\u0441\u0442\u0440\u0438\u0449
      \u0432\u043E\u043A\u0440\u0443\u0433 \u0433\u043E\u0432\u043E\u0440\u044F\u0442
      \u0441\u0430\u043C\u0438 \u0437\u0430 \u0441\u0435\u0431\u044F: \u043E\u043D
      \u0442\u043E\u0440\u0433\u0443\u0435\u0442 \u0437\u0434\u0435\u0441\u044C \u043D\u0435
      \u043F\u0435\u0440\u0432\u044B\u0439 \u0433\u043E\u0434.\r\n\r\n<npc_speech
      lang=\"Arabic\">\u041C\u0438\u0440 \u0432\u0430\u043C, \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446!
      \u0423 \u043C\u0435\u043D\u044F \u0448\u0430\u0444\u0440\u0430\u043D \u0438\u0437
      \u041F\u0435\u0440\u0441\u0438\u0438 \u0438 \u043B\u0430\u0434\u0430\u043D
      \u0438\u0437 \u0425\u0430\u0434\u0440\u0430\u043C\u0430\u0443\u0442\u0430.
      \u041A\u0443\u043F\u0438\u0442\u0435? \u0426\u0435\u043D\u0430 \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u0430
      \u2014 \u0430 \u0442\u043E\u0432\u0430\u0440 \u043B\u0443\u0447\u0448\u0435
      \u043D\u0435 \u043D\u0430\u0439\u0442\u0438!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449248
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u043F\u043E \u0437\u0430\u043F\u0440\u043E\u0448\u0435\u043D\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449249
    m_Localized: "\u0412\u044B \u043E\u0442\u0441\u0447\u0438\u0442\u0430\u043B\u0438
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E, \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0432\u0437\u0432\u0435\u0441\u0438\u043B \u043C\u043E\u043D\u0435\u0442\u044B
      \u043D\u0430 \u043B\u0430\u0434\u043E\u043D\u0438, \u043A\u0438\u0432\u043D\u0443\u043B
      \u0438 \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B \u0442\u0443\u0433\u043E\u0439
      \u043C\u0435\u0448\u043E\u0447\u0435\u043A \u0441 \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u043C
      \u2014 \u043D\u0438\u0442\u0438 \u044F\u0440\u043A\u0438\u0435, \u043B\u043E\u043C\u043A\u0438\u0435,
      \u0441\u0443\u0445\u0438\u0435, \u043F\u0435\u0440\u0432\u044B\u0439 \u0441\u043E\u0440\u0442.
      \u0421\u0432\u0435\u0440\u0445\u0443 \u043F\u043E\u043B\u043E\u0436\u0438\u043B
      \u0433\u043E\u0440\u0441\u0442\u044C \u0444\u0438\u043D\u0438\u043A\u043E\u0432
      \u0441 \u0448\u0438\u0440\u043E\u043A\u043E\u0439 \u0443\u043B\u044B\u0431\u043A\u043E\u0439.
      \xAB\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443, \u0431\u0440\u0430\u0442.
      \u0427\u0442\u043E\u0431\u044B \u043F\u043E\u043C\u043D\u0438\u043B, \u0443
      \u043A\u043E\u0433\u043E \u043F\u043E\u043A\u0443\u043F\u0430\u043B.\xBB \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0436\u0443\u044E\u0442 \u0444\u0438\u043D\u0438\u043A\u0438 \u0438 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B:
      \u0441\u043F\u0435\u0446\u0438\u044F \u0434\u043E\u0440\u043E\u0433\u0430\u044F,
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435 \u0438\u043B\u0438
      \u0411\u0430\u0433\u0434\u0430\u0434\u0435 \u043E\u0442\u043E\u0431\u044C\u0451\u0442\u0441\u044F
      \u0432\u0447\u0435\u0442\u0432\u0435\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449250
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449251
    m_Localized: "\u0412\u044B \u043F\u0440\u0438\u0441\u0435\u043B\u0438 \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432,
      \u0432\u0437\u044F\u043B\u0438 \u0449\u0435\u043F\u043E\u0442\u044C \u0448\u0430\u0444\u0440\u0430\u043D\u0430,
      \u0440\u0430\u0441\u0442\u0451\u0440\u043B\u0438 \u043C\u0435\u0436\u0434\u0443
      \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438, \u043F\u043E\u043D\u044E\u0445\u0430\u043B\u0438
      \u2014 \u0438 \u043F\u043E\u043A\u0430\u0447\u0430\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \xAB\u0425\u043E\u0440\u043E\u0448, \u043D\u043E \u043D\u0435 \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u0435\u043D
      \u2014 \u0432\u0442\u043E\u0440\u0430\u044F \u0441\u0443\u0448\u043A\u0430,
      \u044F \u0432\u0438\u0436\u0443 \u043F\u043E \u0446\u0432\u0435\u0442\u0443
      \u0440\u044B\u043B\u044C\u0446\u0430.\xBB \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u043F\u0440\u0438\u0449\u0443\u0440\u0438\u043B\u0441\u044F, \u043F\u043E\u043C\u043E\u043B\u0447\u0430\u043B,
      \u043F\u043E\u0442\u043E\u043C \u0440\u0430\u0441\u0441\u043C\u0435\u044F\u043B\u0441\u044F.
      \xAB\u0417\u043D\u0430\u044E\u0449\u0438\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A.
      \u041B\u0430\u0434\u043D\u043E \u2014 \u0441\u0435\u043C\u044C \u043C\u043E\u043D\u0435\u0442,
      \u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0438 \u043E\u0431\u043E
      \u043C\u043D\u0435 \u0432 \u0411\u0443\u0445\u0430\u0440\u0435.\xBB \u0420\u0443\u043A\u043E\u043F\u043E\u0436\u0430\u0442\u0438\u0435
      \u0441\u043A\u0440\u0435\u043F\u0438\u043B\u043E \u0441\u0434\u0435\u043B\u043A\u0443.
      \u0412\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u0448\u0430\u0444\u0440\u0430\u043D
      \u043F\u043E \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043D\u043E\u0439 \u0446\u0435\u043D\u0435
      \u2014 \u0438 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430
      \u0432 \u043F\u0440\u0438\u0434\u0430\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449252
    m_Localized: "\u0412\u044B \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
      \u0441\u0431\u0438\u0442\u044C \u0446\u0435\u043D\u0443, \u0443\u043A\u0430\u0437\u0430\u0432
      \u043D\u0430 \u044F\u043A\u043E\u0431\u044B \u043F\u043E\u0434\u043C\u043E\u0447\u0435\u043D\u043D\u044B\u0435
      \u043C\u0435\u0448\u043A\u0438, \u043D\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0442\u043E\u043B\u044C\u043A\u043E \u0445\u043C\u044B\u043A\u043D\u0443\u043B
      \u0438 \u0440\u0430\u0437\u0432\u044F\u0437\u0430\u043B \u043A\u0430\u0436\u0434\u044B\u0439
      \u2014 \u0441\u0443\u0445\u043E\u0439, \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u044B\u0439.
      \xAB\u0422\u044B, \u0432\u0438\u0434\u043D\u043E, \u0448\u0451\u043B\u043A\u043E\u043C
      \u0442\u043E\u0440\u0433\u0443\u0435\u0448\u044C, \u043D\u0435 \u0441\u043F\u0435\u0446\u0438\u044F\u043C\u0438.\xBB
      \u041D\u0435\u043B\u043E\u0432\u043A\u043E\u0441\u0442\u044C \u043E\u0431\u043E\u0448\u043B\u0430\u0441\u044C
      \u0434\u043E\u0440\u043E\u0433\u043E: \u043E\u043D \u043F\u043E\u0434\u043D\u044F\u043B
      \u0446\u0435\u043D\u0443 \u0437\u0430 \xAB\u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F\xBB \u0438 \u043D\u0435 \u0443\u0441\u0442\u0443\u043F\u0438\u043B
      \u043D\u0438 \u043C\u043E\u043D\u0435\u0442\u044B. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0441 \u043D\u0430\u0446\u0435\u043D\u043A\u043E\u0439
      \u0438\u043B\u0438 \u0443\u0445\u043E\u0434\u0438\u0442\u044C \u0431\u0435\u0437
      \u0442\u043E\u0432\u0430\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449253
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446-\u043A\u043E\u043C\u043F\u0430\u043D\u044C\u043E\u043D
      \u0437\u043D\u0430\u0435\u0442 \u0440\u044B\u043D\u043E\u043A \u0441\u043F\u0435\u0446\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449254
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u043F\u043E\u0434\u043E\u0448\u0451\u043B \u043F\u0435\u0440\u0432\u044B\u043C,
      \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B \u0441 \u0430\u0440\u0430\u0431\u043E\u043C
      \u043D\u0430 \u0435\u0433\u043E \u044F\u0437\u044B\u043A\u0435: <npc_speech
      lang=\"Arabic\">\u041C\u0438\u0440 \u0442\u0435\u0431\u0435, \u0431\u0440\u0430\u0442-\u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446.
      \u041C\u044B \u0441\u043B\u044B\u0448\u0430\u043B\u0438, \u0447\u0442\u043E
      \u0432 \u0425\u043E\u0440\u0430\u0441\u0430\u043D\u0435 \u0448\u0430\u0444\u0440\u0430\u043D
      \u043D\u044B\u043D\u0447\u0435 \u043D\u0430 \u0432\u0435\u0441 \u0437\u043E\u043B\u043E\u0442\u0430.
      \u041F\u0440\u0430\u0432\u0434\u0430 \u043B\u0438?</npc_speech> \u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u043F\u043E\u0442\u0451\u043A \u2014 \u043E \u0446\u0435\u043D\u0430\u0445
      \u0432 \u041C\u0435\u0448\u0445\u0435\u0434\u0435, \u043E \u043D\u0435\u0443\u0440\u043E\u0436\u0430\u0435
      \u0448\u0430\u0444\u0440\u0430\u043D\u0430 \u0432 \u0425\u043E\u0440\u0430\u0441\u0430\u043D\u0435,
      \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0435
      \u043F\u0435\u0440\u0435\u043A\u0443\u043F\u0449\u0438\u043A\u0438 \u0437\u0430\u0434\u0438\u0440\u0430\u044E\u0442
      \u0446\u0435\u043D\u0443. \u0410\u0440\u0430\u0431 \u0441\u043B\u0443\u0448\u0430\u043B
      \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E, \u043A\u0438\u0432\u0430\u043B,
      \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u043A \u0432\u0430\u043C \u0438 \u0432\u044B\u043B\u043E\u0436\u0438\u043B
      \u0434\u0432\u0430 \u043C\u0435\u0448\u043E\u0447\u043A\u0430 \u0432\u043C\u0435\u0441\u0442\u043E
      \u043E\u0434\u043D\u043E\u0433\u043E. \xAB\u0422\u0432\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0437\u043D\u0430\u0435\u0442 \u0434\u0435\u043B\u043E. \u041F\u044F\u0442\u044C
      \u043C\u043E\u043D\u0435\u0442 \u0437\u0430 \u043E\u0431\u0430 \u2014 \u0438
      \u043F\u0435\u0440\u0435\u0434\u0430\u0439 \u043C\u043D\u0435 \u0432\u0435\u0441\u0442\u043E\u0447\u043A\u0443,
      \u043A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0448\u044C \u0432
      \u0420\u0435\u0435.\xBB \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0443\u0435\u0445\u0430\u043B
      \u0441 \u0434\u0432\u043E\u0439\u043D\u043E\u0439 \u043F\u043E\u0440\u0446\u0438\u0435\u0439
      \u0448\u0430\u0444\u0440\u0430\u043D\u0430, \u0430 \u0432\u044B \u2014 \u0441
      \u043F\u0430\u0440\u043E\u0439 \u043D\u043E\u0432\u044B\u0445 \u0430\u0440\u0430\u0431\u0441\u043A\u0438\u0445
      \u0441\u043B\u043E\u0432, \u043F\u043E\u0434\u0445\u0432\u0430\u0447\u0435\u043D\u043D\u044B\u0445
      \u0438\u0437 \u0431\u0435\u0441\u0435\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449255
    m_Localized: "\u0417\u0430\u0431\u043B\u0443\u0434\u0438\u0432\u0448\u0438\u0439\u0441\u044F
      \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449256
    m_Localized: "\u041D\u0430 \u043A\u0440\u0430\u044E \u0442\u0440\u043E\u043F\u044B,
      \u0432 \u0442\u0435\u043D\u0438 \u043A\u0430\u043C\u043D\u044F, \u043B\u0435\u0436\u0438\u0442
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u2014 \u0445\u0443\u0434\u043E\u0439,
      \u0432 \u0431\u0435\u043B\u043E\u043C \u0442\u044E\u0440\u0431\u0430\u043D\u0435
      \u0438 \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u043C \u043F\u043B\u0430\u0449\u0435,
      \u043F\u043E\u043A\u0440\u044B\u0442\u043E\u043C \u043F\u044B\u043B\u044C\u044E
      \u0438 \u043F\u043E\u0442\u043E\u043C. \u0411\u043E\u0441\u044B\u0435 \u043D\u043E\u0433\u0438
      \u0441\u0442\u0451\u0440\u0442\u044B \u0434\u043E \u043A\u0440\u043E\u0432\u0438,
      \u0433\u0443\u0431\u044B \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u043B\u0438\u0441\u044C.
      \u0420\u044F\u0434\u043E\u043C \u2014 \u043E\u043F\u0443\u0441\u0442\u043E\u0448\u0451\u043D\u043D\u044B\u0439
      \u0431\u0443\u0440\u0434\u044E\u043A \u0438 \u043F\u043E\u0441\u043E\u0445
      \u0438\u0437 \u0441\u0443\u0445\u043E\u0433\u043E \u0442\u0430\u043C\u0430\u0440\u0438\u0441\u043A\u0430.
      \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A \u0438\u0434\u0443\u0449\u0438\u0439
      \u0432 \u041C\u0435\u043A\u043A\u0443 \u0441\u0431\u0438\u043B\u0441\u044F
      \u0441 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430, \u0434\u043E\u043B\u0436\u043D\u043E
      \u0431\u044B\u0442\u044C, \u0434\u0432\u0430 \u0434\u043D\u044F \u043D\u0430\u0437\u0430\u0434:
      \u0433\u043B\u0430\u0437\u0430 \u0432\u0432\u0430\u043B\u0438\u043B\u0438\u0441\u044C,
      \u0434\u044B\u0445\u0430\u043D\u0438\u0435 \u0447\u0430\u0441\u0442\u043E\u0435
      \u0438 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u043D\u043E\u0435.
      \u041A\u043E\u0433\u0434\u0430 \u0433\u043E\u043B\u043E\u0432\u043D\u0430\u044F
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u043F\u043E\u0440\u0430\u0432\u043D\u044F\u043B\u0430\u0441\u044C
      \u0441 \u043D\u0438\u043C, \u043E\u043D \u043F\u0440\u0438\u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F
      \u043D\u0430 \u043B\u043E\u043A\u0442\u0435 \u0438 \u043F\u0440\u043E\u0445\u0440\u0438\u043F\u0435\u043B
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043B\u043E\u0432,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0431\u0435\u0437 \u0437\u043D\u0430\u043D\u0438\u044F
      \u0430\u0440\u0430\u0431\u0441\u043A\u043E\u0433\u043E \u043D\u0435 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u2014 \u043F\u043E\u043C\u043E\u0447\u044C \u0437\u043D\u0430\u0447\u0438\u0442
      \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C \u0432\u043E\u0434\u0443 \u0438
      \u0432\u0440\u0435\u043C\u044F, \u0431\u0440\u043E\u0441\u0438\u0442\u044C
      \u2014 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0443\u043C\u0438\u0440\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449257
    m_Localized: "\u0414\u0430\u0442\u044C \u0432\u043E\u0434\u044B \u0438 \u0435\u0434\u044B,
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043D\u0430 \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449258
    m_Localized: "\u0412\u044B \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u0438 \u0431\u0443\u0440\u0434\u044E\u043A
      \u0432\u043E\u0434\u044B \u0438 \u0443\u0437\u0435\u043B\u043E\u043A \u0441
      \u043B\u0435\u043F\u0451\u0448\u043A\u0430\u043C\u0438 \u0438 \u0444\u0438\u043D\u0438\u043A\u0430\u043C\u0438.
      \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A \u043F\u0438\u043B \u0434\u043E\u043B\u0433\u043E,
      \u0436\u0430\u0434\u043D\u043E, \u043F\u043E\u0442\u043E\u043C \u043F\u0440\u0438\u0436\u0430\u043B
      \u0440\u0443\u043A\u0443 \u043A \u0441\u0435\u0440\u0434\u0446\u0443 \u0438
      \u043F\u0440\u043E\u0448\u0435\u043F\u0442\u0430\u043B \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u2014 \u0441\u043B\u043E\u0432\u0430 \u0431\u044B\u043B\u0438 \u043D\u0435\u0440\u0430\u0437\u0431\u043E\u0440\u0447\u0438\u0432\u044B,
      \u043D\u043E \u0436\u0435\u0441\u0442 \u043F\u043E\u043D\u044F\u0442\u0435\u043D
      \u043D\u0430 \u043B\u044E\u0431\u043E\u043C \u044F\u0437\u044B\u043A\u0435.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435. \u041E\u0433\u043B\u044F\u043D\u0443\u0432\u0448\u0438\u0441\u044C,
      \u0432\u044B \u0443\u0432\u0438\u0434\u0435\u043B\u0438, \u0447\u0442\u043E
      \u043E\u043D \u0441\u0438\u0434\u0438\u0442, \u0435\u0441\u0442 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0437\u0430\u043F\u0430\u0434. \u041C\u043E\u0436\u0435\u0442,
      \u0434\u043E\u0439\u0434\u0451\u0442. \u041C\u043E\u0436\u0435\u0442, \u043D\u0435\u0442.
      \u041D\u043E \u0441\u043E\u0432\u0435\u0441\u0442\u044C \u0447\u0438\u0441\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449259
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u0443\u0431\u0435\u0434\u0438\u0442\u044C
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u043E\u0432 \u0432\u0437\u044F\u0442\u044C
      \u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449260
    m_Localized: "\u0412\u044B \u0441\u043A\u0430\u0437\u0430\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E:
      \xAB\u0427\u0435\u043B\u043E\u0432\u0435\u043A \u0443\u043C\u0438\u0440\u0430\u0435\u0442.
      \u041C\u044B \u043D\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
      \u0438 \u043D\u0435 \u0437\u0432\u0435\u0440\u0438.\xBB \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0437\u0430\u043C\u043E\u043B\u0447\u0430\u043B\u0438, \u043F\u043E\u0442\u043E\u043C
      \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u043A\u0438\u0432\u043D\u0443\u043B.
      \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0430 \u043F\u043E\u0434\u043D\u044F\u043B\u0438
      \u043D\u0430 \u0437\u0430\u0434\u043D\u0438\u0439 \u0432\u043E\u0437, \u043D\u0430\u043F\u043E\u0438\u043B\u0438,
      \u043E\u0431\u043C\u044B\u043B\u0438 \u043D\u043E\u0433\u0438. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u043E\u043D \u043F\u0440\u0438\u0448\u0451\u043B \u0432 \u0441\u0435\u0431\u044F
      \u0438 \u0434\u043E\u0441\u0442\u0430\u043B \u0438\u0437 \u0441\u043A\u043B\u0430\u0434\u043E\u043A
      \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0433\u043E \u043F\u043B\u0430\u0449\u0430
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u0441\u0432\u0451\u0440\u0442\u043E\u043A
      \u2014 \u043A\u0443\u0441\u043E\u043A \u043B\u0430\u0434\u0430\u043D\u0430.
      \xAB\u041D\u0451\u0441 \u043A \u041A\u0430\u0430\u0431\u0435, \u2014 \u043F\u0440\u043E\u0448\u0435\u043F\u0442\u0430\u043B
      \u043E\u043D. \u2014 \u041D\u043E \u0410\u043B\u043B\u0430\u0445 \u043F\u043E\u0441\u043B\u0430\u043B
      \u043C\u043D\u0435 \u0432\u0430\u0441. \u0412\u043E\u0437\u044C\u043C\u0438,
      \u0442\u044B \u0434\u043E\u0441\u0442\u043E\u0438\u043D \u044D\u0442\u043E\u0433\u043E
      \u0431\u043E\u043B\u044C\u0448\u0435.\xBB \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u043F\u0440\u0438\u0442\u0438\u0445\u043B\u0438 \u2014 \u0434\u0430\u0436\u0435
      \u0432\u043E\u0440\u0447\u0443\u043D\u044B. \u0414\u043E\u0431\u0440\u043E\u0435
      \u0434\u0435\u043B\u043E \u043D\u0430 \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0435 \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0436\u0435
      \u0441\u0435\u0440\u0435\u0431\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449261
    m_Localized: "\u0412\u044B \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
      \u0432\u043E\u0437\u0437\u0432\u0430\u0442\u044C \u043A \u0441\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043D\u0438\u044E,
      \u043D\u043E \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0443\u0436\u0435
      \u043F\u043E\u0434\u0441\u0447\u0438\u0442\u0430\u043B\u0438 \u0432 \u0443\u043C\u0435:
      \u043B\u0438\u0448\u043D\u0438\u0439 \u0440\u043E\u0442, \u043F\u043E\u0442\u0435\u0440\u044F
      \u0432\u043E\u0434\u044B, \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0430.
      \xAB\u041C\u044B \u043D\u0435 \u043B\u0435\u043A\u0430\u0440\u043D\u044F, \u0445\u043E\u0437\u044F\u0438\u043D,
      \u2014 \u0441\u043A\u0430\u0437\u0430\u043B \u0441\u0442\u0430\u0440\u0448\u0438\u0439,
      \u2014 \u0441\u0430\u043C\u0438 \u0435\u043B\u0435 \u0434\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u043C.\xBB
      \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0430 \u043F\u043E\u0434\u043D\u044F\u043B\u0438,
      \u0434\u0430\u043B\u0438 \u0432\u043E\u0434\u044B, \u043D\u043E \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435 \u0443\u043F\u0430\u043B\u043E.
      \u041B\u044E\u0434\u0438 \u0431\u0443\u0440\u0447\u0430\u0442, \u0447\u0442\u043E
      \u0445\u043E\u0437\u044F\u0438\u043D \u0442\u0440\u0430\u0442\u0438\u0442 \u0447\u0443\u0436\u0438\u0435
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u043D\u0430 \u0447\u0443\u0436\u0438\u0435
      \u0431\u0435\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449262
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u0431\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0440\u0430\u043D\u044B \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449263
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0441\u043F\u0435\u0448\u0438\u043B\u0441\u044F,
      \u043D\u0435 \u0434\u043E\u0436\u0438\u0434\u0430\u044F\u0441\u044C \u043F\u0440\u0438\u043A\u0430\u0437\u0430,
      \u2014 \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0441\u044F \u0440\u044F\u0434\u043E\u043C
      \u0441 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u043E\u043C, \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u043D\u043E\u0433\u0438, \u043F\u043E\u0449\u0443\u043F\u0430\u043B \u043F\u0443\u043B\u044C\u0441,
      \u043F\u043E\u043A\u0430\u0447\u0430\u043B \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \xAB\u0416\u0438\u0442\u044C \u0431\u0443\u0434\u0435\u0442. \u0422\u0435\u043F\u043B\u043E\u0432\u043E\u0439
      \u0443\u0434\u0430\u0440 \u0438 \u043E\u0431\u0435\u0437\u0432\u043E\u0436\u0438\u0432\u0430\u043D\u0438\u0435,
      \u043D\u043E \u043D\u0435 \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0430.\xBB
      \u041E\u043D \u043F\u0440\u043E\u043C\u044B\u043B \u0440\u0430\u043D\u044B,
      \u043D\u0430\u043B\u043E\u0436\u0438\u043B \u043C\u0430\u0437\u044C \u0438\u0437
      \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439 \u0430\u043F\u0442\u0435\u0447\u043A\u0438,
      \u0432\u043B\u0438\u043B \u0432 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0430
      \u0440\u0430\u0437\u0431\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u043E\u0442\u0432\u0430\u0440
      \u0442\u0440\u0430\u0432. \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441
      \u0442\u043E\u0442 \u0443\u0436\u0435 \u0441\u0438\u0434\u0435\u043B \u043D\u0430
      \u043F\u043E\u0432\u043E\u0437\u043A\u0435, \u0431\u043B\u0435\u0434\u043D\u044B\u0439,
      \u043D\u043E \u0441 \u044F\u0441\u043D\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438.
      \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A \u0440\u0430\u0437\u0432\u044F\u0437\u0430\u043B
      \u0442\u0440\u044F\u043F\u0438\u0446\u0443 \u043D\u0430 \u043F\u043E\u044F\u0441\u0435
      \u0438 \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B \u043A\u0443\u0441\u043E\u043A
      \u043C\u043E\u043B\u043E\u0447\u043D\u043E-\u0431\u0435\u043B\u043E\u0433\u043E
      \u043B\u0430\u0434\u0430\u043D\u0430 \u2014 \u043B\u0443\u0447\u0448\u0438\u0439,
      \u043A\u0430\u043A\u043E\u0439 \u0431\u044B\u0432\u0430\u0435\u0442. \xAB\u0410\u043B\u043B\u0430\u0445
      \u043F\u043E\u0441\u043B\u0430\u043B \u043C\u043D\u0435 \u0430\u043D\u0433\u0435\u043B\u0430
      \u0432 \u043E\u0431\u043B\u0438\u043A\u0435 \u043B\u0435\u043A\u0430\u0440\u044F.\xBB
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
      \u043C\u043E\u043B\u0447\u0430, \u0438 \u0434\u0430\u0436\u0435 \u0441\u0430\u043C\u044B\u0435
      \u0447\u0451\u0440\u0441\u0442\u0432\u044B\u0435 \u043A\u0438\u0432\u043D\u0443\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449264
    m_Localized: "\u0411\u044B\u0432\u0448\u0438\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043D\u044B\u0439
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449265
    m_Localized: "\u0423 \u043F\u043E\u043B\u0443\u0440\u0430\u0437\u0440\u0443\u0448\u0435\u043D\u043D\u043E\u0433\u043E
      \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u044F,
      \u0437\u0430\u043D\u0435\u0441\u0451\u043D\u043D\u043E\u0433\u043E \u043F\u0435\u0441\u043A\u043E\u043C
      \u0434\u043E \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B \u0441\u0442\u0435\u043D,
      \u0441\u0438\u0434\u0438\u0442 \u0448\u0438\u0440\u043E\u043A\u043E\u043F\u043B\u0435\u0447\u0438\u0439
      \u0442\u044E\u0440\u043A \u2014 \u043A\u043E\u0436\u0430\u043D\u0430\u044F
      \u0431\u0435\u0437\u0440\u0443\u043A\u0430\u0432\u043A\u0430, \u0441\u043E\u0441\u0442\u0430\u0432\u043D\u043E\u0439
      \u043B\u0443\u043A \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439, \u043A\u0440\u0438\u0432\u043E\u0439
      \u043A\u043B\u0438\u043D\u043E\u043A \u043D\u0430 \u043F\u043E\u044F\u0441\u0435.
      \u041B\u0438\u0446\u043E \u043E\u0431\u0432\u0435\u0442\u0440\u0435\u043D\u043D\u043E\u0435,
      \u0441\u043A\u0443\u043B\u0430\u0441\u0442\u043E\u0435, \u0441 \u0442\u043E\u043D\u043A\u0438\u043C
      \u0448\u0440\u0430\u043C\u043E\u043C \u043E\u0442 \u0432\u0438\u0441\u043A\u0430
      \u0434\u043E \u043F\u043E\u0434\u0431\u043E\u0440\u043E\u0434\u043A\u0430.
      \u0420\u044F\u0434\u043E\u043C \u0441\u0442\u0440\u0435\u043D\u043E\u0436\u0435\u043D\u043D\u044B\u0439
      \u0441\u0442\u0435\u043F\u043D\u043E\u0439 \u043A\u043E\u043D\u044C \u0449\u0438\u043F\u043B\u0435\u0442
      \u043A\u043E\u043B\u044E\u0447\u043A\u0443 \u0443 \u0441\u0442\u0435\u043D\u044B.
      \u0417\u0430\u043C\u0435\u0442\u0438\u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u043C\u0443\u0436\u0447\u0438\u043D\u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u0438 \u043E\u043A\u043B\u0438\u043A\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u043D\u0443\u044E
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443 \u2014 \u0433\u043E\u043B\u043E\u0441
      \u0445\u0440\u0438\u043F\u043B\u044B\u0439, \u043D\u043E \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0439:\r\n\r\n<npc_speech
      lang=\"Turkic\">\u0417\u0434\u043E\u0440\u043E\u0432 \u0431\u0443\u0434\u044C,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A! \u042F \u2014
      \u0410\u0440\u0441\u043B\u0430\u043D, \u043F\u0440\u0435\u0436\u0434\u0435
      \u043E\u0445\u0440\u0430\u043D\u044F\u043B \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u044B.
      \u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u043B\u0438\u0445\u0438\u0435
      \u043B\u044E\u0434\u0438. \u041D\u0443\u0436\u0435\u043D \u043B\u0438 \u0442\u0435\u0431\u0435
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A? \u0421\u0438\u043B\u0430
      \u0435\u0441\u0442\u044C, \u0443\u043C\u0435\u043D\u0438\u0435 \u0435\u0441\u0442\u044C
      \u2014 \u043E \u0446\u0435\u043D\u0435 \u0441\u0433\u043E\u0432\u043E\u0440\u0438\u043C\u0441\u044F!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449266
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u0432\u0435\u0436\u043B\u0438\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449267
    m_Localized: "\u0412\u044B \u043F\u043E\u043A\u0430\u0447\u0430\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
      \u2014 \u043B\u0438\u0448\u043D\u0438\u0445 \u043C\u043E\u043D\u0435\u0442
      \u043D\u0435\u0442, \u0430 \u0447\u0443\u0436\u043E\u0439 \u043A\u043B\u0438\u043D\u043E\u043A
      \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435 \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
      \u043A \u0434\u043E\u0431\u0440\u0443. \u0422\u044E\u0440\u043A \u043A\u0438\u0432\u043D\u0443\u043B
      \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B, \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B
      \u0441 \u0442\u0440\u043E\u043F\u044B \u0438 \u0445\u043B\u043E\u043F\u043D\u0443\u043B
      \u043A\u043E\u043D\u044F \u043F\u043E \u0448\u0435\u0435. <npc_speech lang=\"Turkic\">\u041F\u0443\u0441\u0442\u044C
      \u0422\u0435\u043D\u0433\u0440\u0438 \u0445\u0440\u0430\u043D\u0438\u0442 \u0442\u0432\u043E\u0439
      \u043F\u0443\u0442\u044C</npc_speech> \u2014 \u0431\u0440\u043E\u0441\u0438\u043B
      \u043E\u043D \u0432\u0441\u043B\u0435\u0434. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B\u0438 \u0435\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u0430\u043C\u0438.
      \u041A\u0440\u0435\u043F\u043A\u0438\u0439 \u043C\u0443\u0436\u0438\u043A.
      \u0416\u0430\u043B\u044C, \u0447\u0442\u043E \u043D\u0435 \u043F\u0440\u0438
      \u0434\u0435\u043D\u044C\u0433\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449268
    m_Localized: "\u0421\u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0432\u044B\u0433\u043E\u0434\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449269
    m_Localized: "\u0412\u044B \u043E\u0433\u043B\u044F\u0434\u0435\u043B\u0438 \u0435\u0433\u043E
      \u0441 \u043D\u043E\u0433 \u0434\u043E \u0433\u043E\u043B\u043E\u0432\u044B
      \u2014 \u0448\u0440\u0430\u043C \u0431\u043E\u0435\u0432\u043E\u0439, \u043D\u0435
      \u043E\u0442 \u043D\u043E\u0436\u0430 \u0432 \u043A\u0430\u0431\u0430\u0446\u043A\u043E\u0439
      \u0434\u0440\u0430\u043A\u0435, \u043B\u0443\u043A \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435,
      \u043A\u043E\u043D\u044C \u0443\u0445\u043E\u0436\u0435\u043D. \xAB\u0412\u043E\u0441\u0435\u043C\u044C
      \u043C\u043E\u043D\u0435\u0442 \u0434\u043E \u0411\u0443\u0445\u0430\u0440\u044B,
      \u0435\u0434\u0430 \u043D\u0430\u0448\u0430, \u043F\u0440\u0438 \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u0438
      \u2014 \u0442\u0432\u043E\u0439 \u043F\u0440\u043E\u0446\u0435\u043D\u0442
      \u0441 \u0434\u043E\u0431\u044B\u0447\u0438. \u0415\u0441\u043B\u0438 \u0434\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u0443\u0435\u0448\u044C
      \u2014 \u0441\u043B\u043E\u0432\u043E \u0410\u0440\u0441\u043B\u0430\u043D\u0430
      \u043D\u0435 \u0441\u0442\u043E\u0438\u0442 \u0438 \u043C\u0435\u0434\u044F\u043A\u0430.\xBB
      \u0422\u044E\u0440\u043A \u0443\u0441\u043C\u0435\u0445\u043D\u0443\u043B\u0441\u044F,
      \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B \u0440\u0443\u043A\u0443.
      \xAB\u0410\u0440\u0441\u043B\u0430\u043D \u043D\u0435 \u0431\u0435\u0433\u0430\u0435\u0442.
      \u0412\u043E\u0441\u0435\u043C\u044C \u2014 \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E.\xBB
      \u041E\u043D \u0432\u0441\u043A\u043E\u0447\u0438\u043B \u0432 \u0441\u0435\u0434\u043B\u043E
      \u0438 \u0437\u0430\u043D\u044F\u043B \u043C\u0435\u0441\u0442\u043E \u0432
      \u0430\u0440\u044C\u0435\u0440\u0433\u0430\u0440\u0434\u0435, \u043A\u0430\u043A
      \u0431\u0443\u0434\u0442\u043E \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C
      \u0435\u0445\u0430\u043B \u0441 \u044D\u0442\u0438\u043C \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u043C.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u043E\u0432\u0435\u0441\u0435\u043B\u0435\u043B\u0438
      \u2014 \u0441 \u0442\u0430\u043A\u0438\u043C \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439
      \u0441\u043F\u0438\u0442\u0441\u044F \u043A\u0440\u0435\u043F\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449270
    m_Localized: "\u0412\u044B \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
      \u0441\u0431\u0438\u0442\u044C \u0446\u0435\u043D\u0443, \u043D\u043E \u0410\u0440\u0441\u043B\u0430\u043D
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043A\u0430\u0447\u0430\u043B
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439: \xAB\u0414\u0435\u0448\u0451\u0432\u0430\u044F
      \u043E\u0445\u0440\u0430\u043D\u0430 \u2014 \u043C\u0451\u0440\u0442\u0432\u0430\u044F
      \u043E\u0445\u0440\u0430\u043D\u0430, \u0445\u043E\u0437\u044F\u0438\u043D.\xBB
      \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0435\u0433\u043E \u0443\u0441\u043B\u043E\u0432\u0438\u044F
      \u2014 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u043C\u043E\u043D\u0435\u0442
      \u0438 \u0434\u043E\u043B\u044E \u043E\u0442 \u043B\u044E\u0431\u043E\u0433\u043E
      \u0442\u0440\u043E\u0444\u0435\u044F. \u0414\u043E\u0440\u043E\u0433\u043E,
      \u0438 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u043E\u043C\u043E\u0440\u0449\u0438\u043B\u0438\u0441\u044C.
      \u041D\u043E \u043A\u043B\u0438\u043D\u043E\u043A \u043F\u0440\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435
      \u2014 \u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C \u0431\u0435\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449271
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0443\u0437\u043D\u0430\u0451\u0442 \u0437\u0435\u043C\u043B\u044F\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449272
    m_Localized: "\u0412\u0430\u0448 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u0432\u0434\u0440\u0443\u0433 \u0432\u044B\u0435\u0445\u0430\u043B \u0432\u043F\u0435\u0440\u0451\u0434
      \u0438 \u043A\u0440\u0438\u043A\u043D\u0443\u043B \u0447\u0442\u043E-\u0442\u043E
      \u043D\u0430 \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u043C \u2014 \u0440\u0435\u0437\u043A\u043E,
      \u043A\u043E\u043C\u0430\u043D\u0434\u043D\u044B\u043C \u0442\u043E\u043D\u043E\u043C.
      \u0410\u0440\u0441\u043B\u0430\u043D \u0432\u0437\u0434\u0440\u043E\u0433\u043D\u0443\u043B,
      \u043F\u0440\u0438\u0449\u0443\u0440\u0438\u043B\u0441\u044F, \u0430 \u043F\u043E\u0442\u043E\u043C
      \u0440\u0430\u0441\u0445\u043E\u0445\u043E\u0442\u0430\u043B\u0441\u044F \u0438
      \u0443\u0434\u0430\u0440\u0438\u043B \u0441\u0435\u0431\u044F \u043F\u043E
      \u0431\u0435\u0434\u0440\u0443. <npc_speech lang=\"Turkic\">\u0422\u0435\u043C\u0438\u0440!
      \u0421\u0443\u043A\u0438\u043D \u0441\u044B\u043D, \u0442\u044B \u0436\u0438\u0432!</npc_speech>
      \u041E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u043E\u043D\u0438
      \u0441\u043B\u0443\u0436\u0438\u043B\u0438 \u0432\u043C\u0435\u0441\u0442\u0435
      \u2014 \u043E\u0445\u0440\u0430\u043D\u044F\u043B\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u044B
      \u0438\u0437 \u0424\u0435\u0440\u0433\u0430\u043D\u044B \u0442\u0440\u0438
      \u0441\u0435\u0437\u043E\u043D\u0430 \u043F\u043E\u0434\u0440\u044F\u0434.
      \u041F\u043E\u043B\u0447\u0430\u0441\u0430 \u0432\u043E\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0439,
      \u043F\u0438\u0430\u043B\u0430 \u043A\u0443\u043C\u044B\u0441\u0430 \u0438\u0437
      \u0437\u0430\u043F\u0430\u0441\u043E\u0432 \u0410\u0440\u0441\u043B\u0430\u043D\u0430,
      \u0438 \u0434\u0435\u043B\u043E \u0440\u0435\u0448\u0435\u043D\u043E: <npc_speech
      lang=\"Turkic\">\u041F\u044F\u0442\u044C \u043C\u043E\u043D\u0435\u0442 \u2014
      \u0434\u043B\u044F \u0434\u0440\u0443\u0433\u0430 \u0422\u0435\u043C\u0438\u0440\u0430.
      \u0418 \u043C\u043E\u0439 \u043A\u043E\u043D\u044C \u2014 \u0432 \u043E\u0431\u0449\u0438\u0439
      \u0442\u0430\u0431\u0443\u043D.</npc_speech> \u0414\u0432\u0430 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430
      \u2014 \u043B\u0443\u0447\u0448\u0435 \u043E\u0434\u043D\u043E\u0433\u043E,
      \u0430 \u0438\u0445 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u044B\u0439
      \u043E\u043F\u044B\u0442 \u0441\u0442\u043E\u0438\u0442 \u0446\u0435\u043B\u043E\u0433\u043E
      \u043E\u0442\u0440\u044F\u0434\u0430. \u0412\u044B \u043F\u043E\u0439\u043C\u0430\u043B\u0438
      \u043F\u0430\u0440\u0443 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0445 \u0444\u0440\u0430\u0437
      \u0438\u0437 \u0438\u0445 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430
      \u2014 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449273
    m_Localized: "\u0417\u044B\u0431\u0443\u0447\u0438\u0435 \u043F\u0435\u0441\u043A\u0438
      \u043D\u0430 \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449274
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u043D\u044B\u0440\u044F\u0435\u0442
      \u0432 \u043D\u0438\u0437\u0438\u043D\u0443 \u043C\u0435\u0436\u0434\u0443
      \u0434\u0432\u0443\u043C\u044F \u043F\u043E\u043B\u043E\u0433\u0438\u043C\u0438
      \u0431\u0430\u0440\u0445\u0430\u043D\u0430\u043C\u0438 \u2014 \u0438 \u0437\u0434\u0435\u0441\u044C
      \u0447\u0442\u043E-\u0442\u043E \u043D\u0435 \u0442\u0430\u043A. \u041F\u0435\u0441\u043E\u043A
      \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0432\u043B\u0430\u0436\u043D\u044B\u043C,
      \u0442\u0451\u043C\u043D\u044B\u043C, \u0431\u0443\u0434\u0442\u043E \u043F\u0440\u043E\u043B\u0438\u0442\u044B\u0439
      \u0447\u0430\u0439. \u0413\u043E\u043B\u043E\u0432\u043D\u043E\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F, \u043F\u0435\u0440\u0435\u0441\u0442\u0443\u043F\u0438\u043B
      \u043A\u043E\u043F\u044B\u0442\u0430\u043C\u0438 \u0438 \u043E\u0442\u043F\u0440\u044F\u043D\u0443\u043B,
      \u0444\u044B\u0440\u043A\u0430\u044F. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0441\u043F\u0440\u044B\u0433\u043D\u0443\u043B, \u0442\u043A\u043D\u0443\u043B
      \u043F\u043E\u0441\u043E\u0445\u043E\u043C \u2014 \u0436\u0435\u0440\u0434\u044C
      \u0443\u0448\u043B\u0430 \u043F\u043E \u043B\u043E\u043A\u043E\u0442\u044C,
      \u043B\u0435\u0433\u043A\u043E, \u0431\u0435\u0437 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u044F.
      \u0417\u044B\u0431\u0443\u0447\u0438\u0435 \u043F\u0435\u0441\u043A\u0438.
      \u041D\u0435 \u0448\u0438\u0440\u043E\u043A\u0438\u0435, \u043D\u043E \u0442\u0440\u043E\u043F\u0430
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u043F\u0440\u044F\u043C\u043E
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0438\u0445, \u0430 \u043E\u0431\u0445\u043E\u0434
      \u2014 \u0435\u0441\u043B\u0438 \u043E\u043D \u0435\u0441\u0442\u044C \u2014
      \u044D\u0442\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0439
      \u0434\u0435\u043D\u044C \u0441\u0440\u0435\u0434\u0438 \u0431\u0430\u0440\u0445\u0430\u043D\u043E\u0432
      \u0431\u0435\u0437 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432.
      \u0417\u0430\u0434\u043D\u0438\u0435 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0443\u0436\u0435 \u0442\u043E\u0440\u043C\u043E\u0437\u044F\u0442, \u043A\u043E\u043B\u0451\u0441\u0430
      \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0432\u043E\u0437\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
      \u0432\u044F\u0437\u043D\u0443\u0442\u044C \u0432 \u043F\u043E\u0434\u0442\u043E\u043F\u043B\u0435\u043D\u043D\u043E\u043C
      \u0433\u0440\u0443\u043D\u0442\u0435. \u0412\u0440\u0435\u043C\u0435\u043D\u0438
      \u043D\u0430 \u0440\u0430\u0437\u0434\u0443\u043C\u044C\u044F \u043C\u0430\u043B\u043E:
      \u043F\u0435\u0441\u043E\u043A \u0442\u044F\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449275
    m_Localized: "\u0420\u0430\u0437\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0438 \u0442\u0430\u0449\u0438\u0442\u044C \u043F\u043E \u0434\u043E\u0441\u043A\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449276
    m_Localized: "\u041F\u043E\u043B\u0434\u043D\u044F \u0443\u0448\u043B\u043E \u043D\u0430
      \u0440\u0430\u0437\u0433\u0440\u0443\u0437\u043A\u0443 \u2014 \u0442\u044E\u043A\u0438
      \u0438 \u043C\u0435\u0448\u043A\u0438 \u0442\u0430\u0441\u043A\u0430\u043B\u0438
      \u043D\u0430 \u0440\u0443\u043A\u0430\u0445 \u043F\u043E \u0434\u043E\u0441\u043A\u0430\u043C,
      \u0443\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u043C \u043F\u043E\u0432\u0435\u0440\u0445
      \u0437\u044B\u0431\u0443\u0447\u0435\u0433\u043E \u043F\u0435\u0441\u043A\u0430.
      \u0414\u043E\u0441\u043A\u0438 \u043F\u0440\u043E\u0433\u0438\u0431\u0430\u043B\u0438\u0441\u044C
      \u0438 \u0445\u043B\u044E\u043F\u0430\u043B\u0438, \u043E\u0434\u0438\u043D
      \u043C\u0435\u0448\u043E\u043A \u0441 \u043C\u0443\u043A\u043E\u0439 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0441\u044F
      \u0438 \u0443\u0442\u043E\u043D\u0443\u043B, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u0435\u0433\u043E \u0443\u0441\u043F\u0435\u043B\u0438
      \u0432\u044B\u0445\u0432\u0430\u0442\u0438\u0442\u044C. \u041F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0432\u044B\u0442\u044F\u0433\u0438\u0432\u0430\u043B\u0438 \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u043C\u0438
      \u0432\u0441\u0435\u043C \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u043C,
      \u0432\u043E\u043B\u044B \u0443\u043F\u0438\u0440\u0430\u043B\u0438\u0441\u044C
      \u043A\u043E\u043F\u044B\u0442\u0430\u043C\u0438 \u0432 \u043C\u043E\u043A\u0440\u044B\u0439
      \u0433\u0440\u0443\u043D\u0442. \u041A \u0437\u0430\u043A\u0430\u0442\u0443
      \u043F\u0435\u0440\u0435\u0431\u0440\u0430\u043B\u0438\u0441\u044C, \u043D\u043E
      \u043B\u0430\u0433\u0435\u0440\u044C \u0440\u0430\u0437\u0431\u0438\u043B\u0438
      \u0442\u0443\u0442 \u0436\u0435 \u2014 \u043B\u044E\u0434\u0438 \u0438\u0437\u043C\u043E\u0442\u0430\u043D\u044B,
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u0434\u0440\u043E\u0436\u0430\u0442.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043D \u0434\u0435\u043D\u044C \u0438
      \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449277
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u043E\u0431\u0445\u043E\u0434\u043D\u043E\u0439
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449278
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u043D\u044F\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0433\u0440\u0435\u0431\u0435\u043D\u044C \u0431\u0430\u0440\u0445\u0430\u043D\u0430
      \u0438 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u043D\u0438\u0437\u0438\u043D\u0443
      \u2014 \u0432\u043B\u0430\u0436\u043D\u043E\u0435 \u043F\u044F\u0442\u043D\u043E
      \u0442\u044F\u043D\u0435\u0442\u0441\u044F \u043D\u0430 \u043F\u043E\u043B\u0432\u0435\u0440\u0441\u0442\u044B
      \u043A \u044E\u0433\u0443, \u043D\u043E \u043A \u0441\u0435\u0432\u0435\u0440\u0443
      \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u0439 \u0432\u044B\u0441\u0442\u0443\u043F
      \u043F\u0435\u0440\u0435\u0436\u0438\u043C\u0430\u0435\u0442 \u043B\u043E\u0436\u0431\u0438\u043D\u0443,
      \u0438 \u043F\u043E\u0434 \u043D\u0438\u043C \u2014 \u0442\u0432\u0451\u0440\u0434\u044B\u0439
      \u0433\u0440\u0443\u043D\u0442. \u0423\u0437\u043A\u0438\u0439 \u043F\u0440\u043E\u0445\u043E\u0434,
      \u0435\u0434\u0432\u0430 \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0434\u043B\u044F
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438, \u043D\u043E \u043A\u0430\u043C\u0435\u043D\u044C
      \u043D\u0435 \u043E\u0431\u043C\u0430\u043D\u0435\u0442. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u0440\u043E\u0448\u0451\u043B \u043F\u043E \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0439
      \u043A\u0440\u043E\u043C\u043A\u0435, \u043A\u043E\u043B\u0451\u0441\u0430
      \u0441\u043A\u0440\u0435\u0436\u0435\u0442\u0430\u043B\u0438 \u043F\u043E \u0449\u0435\u0431\u043D\u044E,
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u0441\u0442\u0443\u043F\u0430\u043B\u0438
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E. \u041A \u043F\u043E\u043B\u0443\u0434\u043D\u044E
      \u0437\u044B\u0431\u0443\u0447\u0438\u0435 \u043F\u0435\u0441\u043A\u0438 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u043F\u043E\u0437\u0430\u0434\u0438 \u2014 \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C
      \u0438 \u0431\u0435\u0437 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449279
    m_Localized: "\u0412\u044B \u043F\u043E\u0432\u0435\u043B\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0432 \u043E\u0431\u0445\u043E\u0434, \u043D\u043E \u0431\u0430\u0440\u0445\u0430\u043D\u044B
      \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E
      \u2014 \u043E\u0434\u0438\u043D \u0433\u0440\u0435\u0431\u0435\u043D\u044C
      \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u043C, \u043D\u0438 \u0435\u0434\u0438\u043D\u043E\u0433\u043E
      \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u0430. \u0427\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441 \u0441\u0442\u0430\u043B\u043E \u044F\u0441\u043D\u043E,
      \u0447\u0442\u043E \u0432\u044B \u043E\u043F\u0438\u0441\u0430\u043B\u0438
      \u043A\u0440\u0443\u0433. \u0412\u0442\u043E\u0440\u043E\u0439 \u0437\u0430\u0445\u043E\u0434
      \u0443\u0432\u0451\u043B \u0435\u0449\u0451 \u0434\u0430\u043B\u044C\u0448\u0435
      \u2014 \u043A \u043D\u043E\u0447\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0441\u0442\u043E\u044F\u043B \u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0445
      \u0434\u044E\u043D, \u0431\u0443\u0440\u0434\u044E\u043A\u0438 \u043F\u043E\u043B\u0443\u043F\u0443\u0441\u0442\u044B,
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0432 \u0442\u0438\u0445\u043E\u0439
      \u043F\u0430\u043D\u0438\u043A\u0435. \u0414\u0432\u0430 \u0434\u043D\u044F
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u0443\u0442\u0440\u0435\u043D\u043D\u044F\u044F \u0437\u0432\u0435\u0437\u0434\u0430
      \u0432\u044B\u0432\u0435\u043B\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u043D\u0430 \u0442\u0440\u043E\u043F\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449280
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0439 \u043F\u0440\u043E\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449281
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0441\u043F\u0435\u0448\u0438\u043B\u0441\u044F,
      \u043F\u0440\u0438\u0441\u0435\u043B, \u043F\u043E\u0442\u0440\u043E\u0433\u0430\u043B
      \u0442\u0451\u043C\u043D\u044B\u0439 \u043F\u0435\u0441\u043E\u043A \u0438
      \u043F\u043E\u043D\u044E\u0445\u0430\u043B \u043F\u0430\u043B\u044C\u0446\u044B.
      \xAB\u041F\u043E\u0434\u0437\u0435\u043C\u043D\u044B\u0439 \u0440\u0443\u0447\u0435\u0439.
      \u042F \u0437\u043D\u0430\u044E \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E
      \u2014 \u043E\u043D \u0441\u043C\u0435\u0449\u0430\u0435\u0442\u0441\u044F
      \u043A\u0430\u0436\u0434\u0443\u044E \u0432\u0435\u0441\u043D\u0443, \u043D\u043E
      \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0439 \u043A\u0440\u0430\u0439 \u0432\u0441\u0435\u0433\u0434\u0430
      \u0441\u0443\u0445\u043E\u0439.\xBB \u041E\u043D \u043F\u043E\u0432\u0451\u043B
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u0434\u043E\u043B\u044C \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F
      \u043F\u0440\u0430\u0432\u043E\u0433\u043E \u0431\u0430\u0440\u0445\u0430\u043D\u0430,
      \u043F\u043E \u0443\u0437\u043A\u043E\u0439 \u043F\u043E\u043B\u043E\u0441\u0435
      \u0443\u0442\u0440\u0430\u043C\u0431\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
      \u043F\u0435\u0441\u043A\u0430, \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u043E\u0439
      \u0433\u043B\u0430\u0437\u0443, \u043D\u043E \u0442\u0432\u0451\u0440\u0434\u043E\u0439,
      \u043A\u0430\u043A \u043A\u0430\u043C\u0435\u043D\u044C. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u0448\u043B\u0438 \u0440\u043E\u0432\u043D\u043E, \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043D\u0435 \u0443\u0432\u044F\u0437\u043B\u0438 \u043D\u0438 \u0440\u0430\u0437\u0443.
      \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0432\u044B\u0448\u0435\u043B \u043D\u0430 \u0441\u0443\u0445\u0443\u044E
      \u0442\u0440\u043E\u043F\u0443 \u043F\u043E \u0434\u0440\u0443\u0433\u0443\u044E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u043D\u0438\u0437\u0438\u043D\u044B.
      \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0432\u044B\u0442\u0435\u0440
      \u0440\u0443\u043A\u0438 \u043E \u043F\u043E\u043B\u0443 \u0445\u0430\u043B\u0430\u0442\u0430
      \u0438 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B
      \u2014 \u0435\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0441\u0430\u043C\u0430 \u0437\u0430 \u0441\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449282
    m_Localized: "\u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0447\u0430\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449283
    m_Localized: "\u041D\u0430 \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0439
      \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0435 \u0443 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430,
      \u043F\u043E\u0434 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u043C\u0438
      \u043C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u043C\u0438 \u0444\u043B\u0430\u0433\u0430\u043C\u0438,
      \u0440\u0430\u0437\u043B\u043E\u0436\u0435\u043D\u044B \u0440\u044F\u0434\u0430\u043C\u0438
      \u043A\u0438\u0440\u043F\u0438\u0447\u0438\u043A\u0438 \u043F\u0440\u0435\u0441\u0441\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
      \u0447\u0430\u044F. \u041A\u0440\u0435\u043F\u043A\u0438\u0439 \u0442\u0438\u0431\u0435\u0442\u0435\u0446
      \u0432 \u043E\u0432\u0447\u0438\u043D\u043D\u043E\u0439 \u0447\u0443\u0431\u0435
      \u0441\u0438\u0434\u0438\u0442 \u043D\u0430 \u043A\u043E\u0440\u0442\u043E\u0447\u043A\u0430\u0445
      \u0443 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0433\u043E \u043A\u043E\u0441\u0442\u0440\u0430,
      \u043F\u043E\u043C\u0435\u0448\u0438\u0432\u0430\u044F \u0432\u0430\u0440\u0435\u0432\u043E
      \u0432 \u0437\u0430\u043A\u043E\u043F\u0447\u0451\u043D\u043D\u043E\u043C \u043C\u0435\u0434\u043D\u043E\u043C
      \u043A\u043E\u0442\u0435\u043B\u043A\u0435 \u2014 \u0447\u0430\u0439, \u043C\u0430\u0441\u043B\u043E,
      \u0449\u0435\u043F\u043E\u0442\u044C \u0441\u043E\u043B\u0438. \u0417\u0430\u043F\u0430\u0445
      \u0433\u043E\u0440\u044C\u043A\u043E\u0433\u043E \u0447\u0430\u044F \u0441
      \u0434\u044B\u043C\u043A\u043E\u043C \u0442\u044F\u043D\u0435\u0442\u0441\u044F
      \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443.
      \u0423\u0432\u0438\u0434\u0435\u0432 \u0432\u0430\u0441, \u043E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0440\u0443\u043A\u0443 \u0438 \u043E\u043A\u043B\u0438\u043A\u0430\u0435\u0442
      \u043D\u0438\u0437\u043A\u0438\u043C \u0433\u043E\u043B\u043E\u0441\u043E\u043C:\r\n\r\n<npc_speech
      lang=\"Tibetan\">\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E,
      \u0433\u043E\u0441\u0442\u044C! \u042D\u0442\u043E \u0447\u0451\u0440\u043D\u044B\u0439
      \u0447\u0430\u0439 \u2014 \u043B\u0443\u0447\u0448\u0438\u0439 \u0433\u043E\u0440\u043D\u044B\u0439
      \u0447\u0430\u0439 \u0422\u0438\u0431\u0435\u0442\u0430! \u0421 \u043C\u0430\u0441\u043B\u043E\u043C
      \u0438 \u0441\u043E\u043B\u044C\u044E \u2014 \u0432 \u0434\u043E\u0440\u043E\u0433\u0435
      \u0431\u0435\u0437 \u043D\u0435\u0433\u043E \u043D\u0438\u043A\u0430\u043A.
      \u0411\u0435\u0440\u0451\u0442\u0435?</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449284
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0447\u0430\u0439 \u0438
      \u043C\u0430\u0441\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449285
    m_Localized: "\u0412\u044B \u043E\u0442\u0441\u0447\u0438\u0442\u0430\u043B\u0438
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E, \u0442\u0438\u0431\u0435\u0442\u0435\u0446
      \u0432\u0437\u0432\u0435\u0441\u0438\u043B \u043C\u043E\u043D\u0435\u0442\u044B
      \u043D\u0430 \u043B\u0430\u0434\u043E\u043D\u0438, \u043A\u0438\u0432\u043D\u0443\u043B
      \u0438 \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B \u0447\u0435\u0442\u044B\u0440\u0435
      \u043A\u0438\u0440\u043F\u0438\u0447\u0438\u043A\u0430 \u0447\u0430\u044F \u0438
      \u0443\u0432\u0435\u0441\u0438\u0441\u0442\u044B\u0439 \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u043C\u0435\u0448\u043E\u043A \u0441 \u043C\u0430\u0441\u043B\u043E\u043C.
      \u0421\u0432\u0435\u0440\u0445\u0443 \u043F\u043E\u043B\u043E\u0436\u0438\u043B
      \u0449\u0435\u043F\u043E\u0442\u044C \u0433\u0440\u0443\u0431\u043E\u0439 \u0433\u043E\u0440\u043D\u043E\u0439
      \u0441\u043E\u043B\u0438, \u0437\u0430\u0432\u0451\u0440\u043D\u0443\u0442\u0443\u044E
      \u0432 \u043B\u043E\u0441\u043A\u0443\u0442 \u0442\u043A\u0430\u043D\u0438.
      \xAB\u041D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435 \u0431\u0435\u0437
      \u043C\u0430\u0441\u043B\u0430 \u2014 \u043A\u0430\u043A \u0431\u0435\u0437
      \u043D\u043E\u0433,\xBB \u2014 \u0441\u043A\u0430\u0437\u0430\u043B \u043E\u043D,
      \u0445\u043B\u043E\u043F\u043D\u0443\u0432 \u043F\u043E \u043C\u0435\u0448\u043A\u0443.
      \u0413\u043E\u0440\u044F\u0447\u0438\u0439 \u0441\u043E\u043B\u0451\u043D\u044B\u0439
      \u0447\u0430\u0439 \u0441 \u043C\u0430\u0441\u043B\u043E\u043C \u0440\u0430\u0437\u043B\u0438\u043B\u0438
      \u043F\u043E \u0447\u0430\u0448\u0430\u043C \u0432 \u0442\u043E\u0442 \u0436\u0435
      \u0432\u0435\u0447\u0435\u0440. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043E\u0442\u043E\u0433\u0440\u0435\u043B\u0438\u0441\u044C \u0438 \u043F\u043E\u0432\u0435\u0441\u0435\u043B\u0435\u043B\u0438
      \u2014 \u0432 \u0433\u043E\u0440\u0430\u0445 \u0442\u0430\u043A\u043E\u0435
      \u0432\u0430\u0440\u0435\u0432\u043E \u0446\u0435\u043D\u043D\u0435\u0435 \u0432\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449286
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0437\u0430 \u043B\u0443\u0447\u0448\u0443\u044E \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449287
    m_Localized: "\u0412\u044B \u043F\u0440\u0438\u0441\u0435\u043B\u0438 \u0440\u044F\u0434\u043E\u043C,
      \u0432\u0437\u044F\u043B\u0438 \u043A\u0438\u0440\u043F\u0438\u0447\u0438\u043A
      \u0447\u0430\u044F, \u043F\u043E\u043D\u044E\u0445\u0430\u043B\u0438, \u043D\u0430\u0434\u043B\u043E\u043C\u0438\u043B\u0438
      \u043A\u0440\u0430\u0439 \u2014 \u0442\u0451\u043C\u043D\u044B\u0439, \u043F\u043B\u043E\u0442\u043D\u044B\u0439,
      \u0441 \u0433\u043E\u0440\u044C\u043A\u043E\u0432\u0430\u0442\u044B\u043C \u0430\u0440\u043E\u043C\u0430\u0442\u043E\u043C.
      \xAB\u0427\u0430\u0439 \u0445\u043E\u0440\u043E\u0448, \u043D\u043E \u043F\u0440\u0435\u0441\u0441\u043E\u0432\u043A\u0430
      \u0437\u0438\u043C\u043D\u044F\u044F \u2014 \u0432\u0442\u043E\u0440\u0430\u044F
      \u043F\u0430\u0440\u0442\u0438\u044F, \u043D\u0435 \u043F\u0435\u0440\u0432\u0430\u044F.
      \u041F\u044F\u0442\u044C \u043C\u043E\u043D\u0435\u0442 \u0437\u0430 \u0432\u0441\u0451,
      \u0438 \u044F \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0443 \u043E \u0442\u0435\u0431\u0435
      \u0432 \u041B\u0445\u0430\u0441\u0435.\xBB \u0422\u0438\u0431\u0435\u0442\u0435\u0446
      \u0445\u043C\u044B\u043A\u043D\u0443\u043B, \u043F\u043E\u043A\u0440\u0443\u0442\u0438\u043B
      \u043C\u043E\u043D\u0435\u0442\u0443 \u0432 \u043F\u0430\u043B\u044C\u0446\u0430\u0445,
      \u043F\u043E\u0442\u043E\u043C \u0440\u0430\u0441\u0441\u043C\u0435\u044F\u043B\u0441\u044F.
      \xAB\u0422\u044B \u0442\u043E\u0440\u0433\u0443\u0435\u0448\u044C\u0441\u044F
      \u043A\u0430\u043A \u0442\u0438\u0431\u0435\u0442\u0435\u0446! \u041F\u044F\u0442\u044C
      \u2014 \u0442\u0430\u043A \u043F\u044F\u0442\u044C. \u0414\u0435\u0440\u0436\u0438
      \u043C\u0430\u0441\u043B\u043E \u0432 \u043F\u0440\u0438\u0434\u0430\u0447\u0443.\xBB
      \u0420\u0443\u043A\u043E\u043F\u043E\u0436\u0430\u0442\u0438\u0435 \u043D\u0430
      \u0432\u044B\u0441\u043E\u0442\u0435, \u0433\u0434\u0435 \u0432\u043E\u0437\u0434\u0443\u0445
      \u0440\u0435\u0436\u0435\u0442 \u0433\u043E\u0440\u043B\u043E, \u0441\u0442\u043E\u0438\u0442
      \u0434\u043E\u0440\u043E\u0436\u0435 \u0431\u0443\u043C\u0430\u0436\u043D\u043E\u0433\u043E
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449288
    m_Localized: "\u0412\u044B \u0443\u043A\u0430\u0437\u0430\u043B\u0438 \u043D\u0430
      \u0442\u0440\u0435\u0449\u0438\u043D\u044B \u0432 \u043A\u0438\u0440\u043F\u0438\u0447\u0438\u043A\u0430\u0445
      \u0438 \u043F\u0440\u0435\u0434\u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0438,
      \u0447\u0442\u043E \u0447\u0430\u0439 \u043E\u0442\u0441\u044B\u0440\u0435\u043B
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435. \u0422\u0438\u0431\u0435\u0442\u0435\u0446
      \u043C\u043E\u043B\u0447\u0430 \u0440\u0430\u0437\u043B\u043E\u043C\u0438\u043B
      \u043E\u0434\u0438\u043D, \u043F\u043E\u043A\u0430\u0437\u0430\u043B \u0441\u0443\u0445\u043E\u0439
      \u0442\u0451\u043C\u043D\u044B\u0439 \u0438\u0437\u043B\u043E\u043C, \u043F\u043E\u043D\u044E\u0445\u0430\u043B
      \u0438 \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B \u0432\u0430\u043C
      \u2014 \u0437\u0430\u043F\u0430\u0445 \u0431\u044B\u043B \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u0435\u043D.
      \xAB\u0427\u0430\u0439 \u0441\u0443\u0445\u043E\u0439. \u0421\u044B\u0440\u043E\u0439
      \u2014 \u0442\u043E\u0442, \u043A\u0442\u043E \u043D\u0435 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F.\xBB
      \u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435
      \u0431\u044B\u043B\u043E \u0431\u0435\u0441\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u043E.
      \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u043F\u043E\u043B\u043D\u0443\u044E \u0446\u0435\u043D\u0443 \u0437\u0430
      \u043C\u0435\u043D\u044C\u0448\u0443\u044E \u043F\u043E\u0440\u0446\u0438\u044E,
      \u0438 \u043C\u0430\u0441\u043B\u043E \u043E\u043D \u043F\u0440\u043E\u0434\u0430\u043B
      \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449289
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u0437\u043D\u0430\u0435\u0442 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439
      \u0440\u044B\u043D\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449290
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u043F\u043E\u0434\u043E\u0448\u0451\u043B \u043F\u0435\u0440\u0432\u044B\u043C,
      \u043A\u0438\u0432\u043D\u0443\u043B \u0442\u0438\u0431\u0435\u0442\u0446\u0443
      \u0438 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B \u043E \u0446\u0435\u043D\u0430\u0445
      \u043D\u0430 \u043C\u0430\u0441\u043B\u043E \u0432 \u041A\u0430\u0448\u0433\u0430\u0440\u0435,
      \u043E \u0434\u043E\u0440\u043E\u0433\u043E\u0432\u0438\u0437\u043D\u0435 \u0441\u043E\u043B\u0438
      \u043D\u0430 \u044E\u0436\u043D\u044B\u0445 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430\u0445,
      \u043E \u0442\u0430\u043D\u0433\u0443\u0442\u0441\u043A\u0438\u0445 \u043F\u0435\u0440\u0435\u043A\u0443\u043F\u0449\u0438\u043A\u0430\u0445,
      \u0447\u0442\u043E \u0441\u043A\u0443\u043F\u0430\u044E\u0442 \u0447\u0430\u0439
      \u0432\u0430\u0433\u043E\u043D\u0430\u043C\u0438 \u0438 \u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0434\u0430\u044E\u0442
      \u0432\u0442\u0440\u043E\u0435. \u0422\u0438\u0431\u0435\u0442\u0435\u0446
      \u0441\u043B\u0443\u0448\u0430\u043B, \u043F\u0440\u0438\u0449\u0443\u0440\u0438\u0432\u0448\u0438\u0441\u044C,
      \u043F\u043E\u0442\u043E\u043C \u0445\u043B\u043E\u043F\u043D\u0443\u043B \u043F\u043E
      \u043A\u043E\u043B\u0435\u043D\u0443. \xAB\u0422\u0432\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0437\u043D\u0430\u0435\u0442 \u0433\u043E\u0440\u044B! \u0427\u0435\u0442\u044B\u0440\u0435
      \u043C\u043E\u043D\u0435\u0442\u044B \u2014 \u0437\u0430\u0431\u0438\u0440\u0430\u0439
      \u0447\u0430\u0439, \u043C\u0430\u0441\u043B\u043E \u0438 \u0441\u043E\u043B\u044C.
      \u0418 \u043F\u0435\u0440\u0435\u0434\u0430\u0439 \u043C\u043D\u0435 \u0432\u0435\u0441\u0442\u043E\u0447\u043A\u0443
      \u0447\u0435\u0440\u0435\u0437 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u043E\u0432,
      \u043A\u043E\u0433\u0434\u0430 \u043F\u043E\u0439\u0434\u0451\u0448\u044C \u0432
      \u041B\u0445\u0430\u0441\u0443.\xBB \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0443\u0435\u0445\u0430\u043B \u0441 \u043F\u043E\u043B\u043D\u044B\u043C\u0438
      \u043C\u0435\u0448\u043A\u0430\u043C\u0438, \u0430 \u0432\u044B \u0443\u043B\u043E\u0432\u0438\u043B\u0438
      \u0438\u0437 \u0438\u0445 \u0431\u0435\u0441\u0435\u0434\u044B \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0445 \u0441\u043B\u043E\u0432,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u0442\u043E\u0438\u0442 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449291
    m_Localized: "\u0413\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u0439 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A-\u043A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449292
    m_Localized: "\u041D\u0430 \u043E\u0431\u043E\u0447\u0438\u043D\u0435 \u0433\u043E\u0440\u043D\u043E\u0439
      \u0442\u0440\u043E\u043F\u044B, \u0443 \u0432\u0430\u043B\u0443\u043D\u0430
      \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C \u0441 \u043F\u043E\u0432\u043E\u0437\u043A\u0443,
      \u0441\u0438\u0434\u0438\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432
      \u0447\u0451\u0440\u043D\u043E\u0439 \u0448\u0435\u0440\u0441\u0442\u044F\u043D\u043E\u0439
      \u0440\u044F\u0441\u0435 \u0441 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u043C
      \u043A\u0440\u0435\u0441\u0442\u043E\u043C \u043D\u0430 \u0433\u0440\u0443\u0434\u0438.
      \u041D\u0430 \u043F\u043B\u043E\u0441\u043A\u043E\u043C \u043A\u0430\u043C\u043D\u0435
      \u043F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C \u2014 \u043B\u0438\u0441\u0442
      \u0436\u0435\u043B\u0442\u043E\u0432\u0430\u0442\u043E\u0439 \u0431\u0443\u043C\u0430\u0433\u0438,
      \u043F\u0440\u0438\u0434\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u0433\u0430\u043B\u044C\u043A\u043E\u0439.
      \u041E\u043D \u0447\u0435\u0440\u0442\u0438\u0442 \u0442\u0440\u043E\u0441\u0442\u043D\u0438\u043A\u043E\u0432\u044B\u043C
      \u043F\u0435\u0440\u043E\u043C: \u043B\u0438\u043D\u0438\u0438 \u0433\u043E\u0440,
      \u0438\u0437\u0432\u0438\u0432\u044B \u0442\u0440\u043E\u043F, \u0437\u043D\u0430\u0447\u043A\u0438
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u043E\u0432. \u0420\u044F\u0434\u043E\u043C
      \u043A\u043E\u0436\u0430\u043D\u0430\u044F \u0441\u0443\u043C\u043A\u0430,
      \u043D\u0430\u0431\u0438\u0442\u0430\u044F \u0441\u0432\u0438\u0442\u043A\u0430\u043C\u0438.
      \u0417\u0430\u043C\u0435\u0442\u0438\u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u0433\u0440\u0435\u043A \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u0443, \u0449\u0443\u0440\u0438\u0442\u0441\u044F
      \u0431\u043B\u0438\u0437\u043E\u0440\u0443\u043A\u0438\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438
      \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043D\u0430
      \u043B\u043E\u043C\u0430\u043D\u043E\u043C \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C,
      \u043F\u043E\u0442\u043E\u043C \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u043D\u0430 \u0433\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u0439:\r\n\r\n<npc_speech
      lang=\"Greek\">\u0420\u0430\u0434\u0443\u0439\u0442\u0435\u0441\u044C, \u0447\u0443\u0436\u0435\u0441\u0442\u0440\u0430\u043D\u0446\u044B!
      \u042F \u2014 \u0424\u0435\u043E\u0434\u043E\u0440, \u043C\u043E\u043D\u0430\u0445
      \u0438 \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A.
      \u041E\u043F\u0438\u0441\u044B\u0432\u0430\u044E \u0434\u043E\u0440\u043E\u0433\u0443
      \u043E\u0442 \u0422\u0440\u0430\u043F\u0435\u0437\u0443\u043D\u0434\u0430 \u0434\u043E
      \u0421\u0435\u0440\u0438\u043A\u0438. \u0417\u043D\u0430\u0435\u0442\u0435
      \u043B\u0438 \u0432\u044B \u0437\u0434\u0435\u0448\u043D\u0438\u0435 \u043F\u0443\u0442\u0438?
      \u041E\u0431\u043C\u0435\u043D\u044F\u0435\u043C\u0441\u044F \u2014 \u043C\u043E\u0438
      \u0437\u043D\u0430\u043D\u0438\u044F \u0437\u0430 \u0432\u0430\u0448\u0438!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449293
    m_Localized: "\u041F\u043E\u0434\u0435\u043B\u0438\u0442\u044C\u0441\u044F \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F\u043C\u0438
      \u043E \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449294
    m_Localized: "\u0412\u044B \u043F\u0440\u0438\u0441\u0435\u043B\u0438 \u0440\u044F\u0434\u043E\u043C
      \u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0438, \u0447\u0442\u043E
      \u043F\u043E\u043C\u043D\u0438\u043B\u0438: \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F
      \u043C\u0435\u0436\u0434\u0443 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430\u043C\u0438,
      \u0438\u043C\u0435\u043D\u0430 \u0434\u0435\u0440\u0435\u0432\u0435\u043D\u044C,
      \u0433\u0434\u0435 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438
      \u0432\u043E\u0434\u0443, \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0442\u0440\u043E\u043F, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043E\u0431\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0443 \u0441\u043A\u0430\u043B. \u0413\u0440\u0435\u043A \u0441\u043B\u0443\u0448\u0430\u043B
      \u0436\u0430\u0434\u043D\u043E, \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u044F
      \u043A\u0430\u0436\u0434\u043E\u0435 \u0441\u043B\u043E\u0432\u043E, \u043F\u0435\u0440\u0435\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u044F
      \u0434\u0432\u0430\u0436\u0434\u044B. \u0412\u0437\u0430\u043C\u0435\u043D
      \u043E\u043D \u043F\u043E\u043A\u0430\u0437\u0430\u043B \u0441\u0432\u043E\u044E
      \u043A\u0430\u0440\u0442\u0443 \u2014 \u0434\u043E\u0440\u043E\u0433\u0438
      \u043E\u0442 \u0422\u0440\u0430\u0431\u0437\u043E\u043D\u0430 \u0434\u043E
      \u041A\u0430\u0448\u0433\u0430\u0440\u0430, \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u0435
      \u0441 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E, \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043F\u043E\u0437\u0430\u0432\u0438\u0434\u043E\u0432\u0430\u043B \u0431\u044B
      \u043B\u044E\u0431\u043E\u0439 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u043A\u0443\u043F\u0435\u0446. \u0412\u044B \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438
      \u043F\u0430\u0440\u0443 \u043F\u043E\u043B\u0435\u0437\u043D\u044B\u0445 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u043E\u0432
      \u0438 \u043F\u043E\u0434\u0445\u0432\u0430\u0442\u0438\u043B\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0433\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u0445 \u0441\u043B\u043E\u0432
      \u0438\u0437 \u0435\u0433\u043E \u043F\u043E\u044F\u0441\u043D\u0435\u043D\u0438\u0439.
      \u041A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444 \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B
      \u0438 \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B \u043B\u0435\u043F\u0451\u0448\u043A\u0443
      \u0438\u0437 \u0441\u0432\u043E\u0438\u0445 \u0437\u0430\u043F\u0430\u0441\u043E\u0432
      \u2014 \u0447\u0451\u0440\u0441\u0442\u0432\u0443\u044E, \u043D\u043E \u0447\u0435\u0441\u0442\u043D\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449295
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C
      \u0435\u0433\u043E \u0437\u0430 \u043F\u043B\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449296
    m_Localized: "\xAB\u0422\u044B \u043E\u0434\u0438\u043D \u0432 \u0433\u043E\u0440\u0430\u0445
      \u2014 \u044D\u0442\u043E \u0431\u0435\u0437\u0443\u043C\u0438\u0435, \u043C\u043E\u043D\u0430\u0445.
      \u0418\u0434\u0438 \u0441 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u043C
      \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430,
      \u043D\u0430\u0440\u0438\u0441\u0443\u0435\u0448\u044C \u0432\u0441\u0451,
      \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E, \u0430 \u043C\u043D\u0435
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0448\u044C \u0437\u0430 \u043E\u0445\u0440\u0430\u043D\u0443
      \u0438 \u043F\u0438\u0449\u0443.\xBB \u0413\u0440\u0435\u043A \u0437\u0430\u0434\u0443\u043C\u0430\u043B\u0441\u044F,
      \u043F\u043E\u0442\u043E\u043C \u0434\u043E\u0441\u0442\u0430\u043B \u0438\u0437
      \u0441\u0443\u043C\u043A\u0438 \u0442\u0443\u0433\u043E\u0439 \u043A\u043E\u0448\u0435\u043B\u0451\u043A
      \u2014 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E \u0443\u0432\u0435\u0441\u0438\u0441\u0442\u044B\u0439
      \u0434\u043B\u044F \u043C\u043E\u043D\u0430\u0445\u0430. \xAB\u0412\u0438\u0437\u0430\u043D\u0442\u0438\u0439\u0441\u043A\u0430\u044F
      \u0430\u043A\u0430\u0434\u0435\u043C\u0438\u044F \u0449\u0435\u0434\u0440\u0430
      \u043A \u0442\u0435\u043C, \u043A\u0442\u043E \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u0435\u0442
      \u043A\u0430\u0440\u0442\u0443 \u0438\u043C\u043F\u0435\u0440\u0438\u0438.\xBB
      \u0422\u0440\u0438 \u0434\u043D\u044F \u043E\u043D \u0448\u0451\u043B \u0441
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u043C, \u0440\u0438\u0441\u0443\u044F
      \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C \u043F\u0440\u0438\u0432\u0430\u043B\u0435.
      \u041D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435 \u0432\u0440\u0443\u0447\u0438\u043B
      \u0441\u0442\u043E\u043F\u043A\u0443 \u0447\u0438\u0441\u0442\u044B\u0445 \u043B\u0438\u0441\u0442\u043E\u0432
      \u0431\u0443\u043C\u0430\u0433\u0438 \u2014 \u043A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044C\u0441\u043A\u043E\u0439,
      \u0442\u043E\u043D\u043A\u043E\u0439 \u0438 \u043F\u0440\u043E\u0447\u043D\u043E\u0439.
      \xAB\u0414\u043B\u044F \u043F\u0438\u0441\u0435\u043C \u2014 \u0438\u043B\u0438
      \u0434\u043B\u044F \u043A\u0430\u0440\u0442, \u0435\u0441\u043B\u0438 \u0440\u0435\u0448\u0438\u0448\u044C
      \u0441\u0430\u043C \u0441\u0442\u0430\u0442\u044C \u043A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444\u043E\u043C.\xBB
      \u0412\u044B \u0432\u044B\u0443\u0447\u0438\u043B\u0438 \u0437\u0430 \u044D\u0442\u0438
      \u0434\u043D\u0438 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0433\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u0445 \u0441\u043B\u043E\u0432,
      \u0447\u0442\u043E\u0431\u044B \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0422\u0440\u0430\u0431\u0437\u043E\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449297
    m_Localized: "\u0412\u044B \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B\u0438
      \u0433\u0440\u0435\u043A\u0430 \u0432\u0437\u044F\u0442\u044C \u0441 \u0441\u043E\u0431\u043E\u0439,
      \u043D\u043E \u0442\u043E\u0442 \u043D\u0430\u0441\u0442\u043E\u0440\u043E\u0436\u0438\u043B\u0441\u044F
      \u2014 \u043C\u043E\u043D\u0430\u0445 \u0432\u0438\u0434\u0435\u043B, \u043A\u0430\u043A
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u043F\u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u043B\u0438
      \u043D\u0430 \u0435\u0433\u043E \u0441\u0443\u043C\u043A\u0443 \u0441\u043E
      \u0441\u0432\u0438\u0442\u043A\u0430\u043C\u0438. \xAB\u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044E,
      \u043D\u043E \u043D\u0435\u0442. \u042F \u043F\u0440\u0438\u0432\u044B\u043A
      \u0445\u043E\u0434\u0438\u0442\u044C \u043E\u0434\u0438\u043D \u2014 \u0442\u0430\u043A
      \u043A\u0430\u0440\u0442\u0430 \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0447\u0435\u0441\u0442\u043D\u0435\u0435.\xBB
      \u041E\u043D \u0441\u043F\u0435\u0448\u043D\u043E \u0441\u043E\u0431\u0440\u0430\u043B
      \u0431\u0443\u043C\u0430\u0433\u0438 \u0438 \u0443\u0448\u0451\u043B \u043F\u043E
      \u0431\u043E\u043A\u043E\u0432\u043E\u0439 \u0442\u0440\u043E\u043F\u0435,
      \u043D\u0435 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u043F\u043E\u0436\u0430\u043B\u0438
      \u043F\u043B\u0435\u0447\u0430\u043C\u0438, \u0430 \u0432\u044B \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B\u0438
      \u0432\u0440\u0435\u043C\u044F \u0438 \u043B\u0435\u043F\u0451\u0448\u043A\u0443,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B\u0438
      \u0435\u043C\u0443 \u043D\u0430 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0430\u0445,
      \u2014 \u0432\u043F\u0443\u0441\u0442\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449298
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
      \u043E\u0431\u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F \u0437\u043D\u0430\u043D\u0438\u044F\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449299
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0441 \u0433\u0440\u0435\u043A\u043E\u043C \u043D\u0430 \u0435\u0433\u043E
      \u044F\u0437\u044B\u043A\u0435: <npc_speech lang=\"Greek\">\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E,
      \u043F\u0443\u0442\u043D\u0438\u043A. \u041C\u044B \u0432\u0438\u0434\u0435\u043B\u0438
      \u0442\u0432\u043E\u0438 \u043A\u0430\u0440\u0442\u044B \u2014 \u043E\u043D\u0438
      \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B. \u041D\u0435 \u043E\u0431\u043C\u0435\u043D\u044F\u0435\u043C\u0441\u044F
      \u043B\u0438 \u0437\u043D\u0430\u043D\u0438\u044F\u043C\u0438?</npc_speech>
      \u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E,
      \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u044F \u0441\u043B\u043E\u0432\u0430,
      \u043F\u043E\u0442\u043E\u043C \u0431\u0435\u0433\u043B\u043E, \u0438 \u043C\u043E\u043D\u0430\u0445
      \u0440\u0430\u0441\u0446\u0432\u0451\u043B, \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u043D\u0435 \u0441\u043B\u044B\u0448\u0430\u0432\u0448\u0438\u0439 \u0440\u043E\u0434\u043D\u043E\u0439
      \u0440\u0435\u0447\u0438 \u043C\u0435\u0441\u044F\u0446\u0430\u043C\u0438.
      \u041F\u043E\u043B\u0434\u043D\u044F \u043E\u043D\u0438 \u043F\u0440\u043E\u0432\u0435\u043B\u0438
      \u043D\u0430\u0434 \u043A\u0430\u0440\u0442\u0430\u043C\u0438 \u2014 \u0432\u0430\u0448
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0434\u0438\u043A\u0442\u043E\u0432\u0430\u043B
      \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u043E\u0432,
      \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F, \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u044F
      \u043E\u043F\u0430\u0441\u043D\u044B\u0445 \u0443\u0447\u0430\u0441\u0442\u043A\u043E\u0432,
      \u0430 \u0424\u0435\u043E\u0434\u043E\u0440 \u043D\u0430\u043D\u043E\u0441\u0438\u043B
      \u0438\u0445 \u043D\u0430 \u0431\u0443\u043C\u0430\u0433\u0443 \u0441 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C\u044E
      \u0432\u043E\u0435\u043D\u043D\u043E\u0433\u043E \u0438\u043D\u0436\u0435\u043D\u0435\u0440\u0430.
      \u0412\u0437\u0430\u043C\u0435\u043D \u0433\u0440\u0435\u043A \u043E\u0442\u0434\u0430\u043B
      \u043A\u043E\u043F\u0438\u044E \u0441\u0432\u043E\u0435\u0439 \u043A\u0430\u0440\u0442\u044B
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430 \u043E\u0442 \u0422\u0440\u0430\u0431\u0437\u043E\u043D\u0430
      \u0434\u043E \u0411\u0430\u043B\u0445\u0430 \u2014 \u0441 \u043F\u043E\u043C\u0435\u0442\u043A\u0430\u043C\u0438
      \u043E \u0440\u043E\u0434\u043D\u0438\u043A\u0430\u0445, \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u0445,
      \u043C\u0435\u0441\u0442\u0430\u0445, \u0433\u0434\u0435 \u0431\u0430\u043D\u0434\u0438\u0442\u044B
      \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044E\u0442 \u0437\u0430\u0441\u0430\u0434\u044B.
      \xAB\u0421\u043A\u0430\u0436\u0438 \u0441\u0432\u043E\u0435\u043C\u0443 \u0445\u043E\u0437\u044F\u0438\u043D\u0443:
      \u044D\u0442\u0430 \u043A\u0430\u0440\u0442\u0430 \u0441\u0442\u043E\u0438\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043C\u0435\u0448\u043E\u043A
      \u0441\u0435\u0440\u0435\u0431\u0440\u0430.\xBB \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u043A\u0438\u0432\u043D\u0443\u043B. \u041E\u043D \u0431\u044B\u043B \u043F\u0440\u0430\u0432.
      \u041A \u0441\u0442\u043E\u043F\u043A\u0435 \u043A\u0430\u0440\u0442 \u043C\u043E\u043D\u0430\u0445
      \u0434\u043E\u0431\u0430\u0432\u0438\u043B \u043B\u0438\u0441\u0442\u044B \u0447\u0438\u0441\u0442\u043E\u0439
      \u0431\u0443\u043C\u0430\u0433\u0438 \u2014 \u043F\u043E \u0435\u0433\u043E
      \u0441\u043B\u043E\u0432\u0430\u043C, \u043B\u0443\u0447\u0448\u0435\u0439
      \u043A \u0432\u043E\u0441\u0442\u043E\u043A\u0443 \u043E\u0442 \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044F.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435 \u0441 \u043A\u0430\u0440\u0442\u043E\u0439,
      \u0431\u0443\u043C\u0430\u0433\u043E\u0439 \u0438 \u0437\u043D\u0430\u043D\u0438\u0435\u043C,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043D\u0435 \u043A\u0443\u043F\u0438\u0448\u044C
      \u043D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449300
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449301
    m_Localized: "\u0423 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438 \u0433\u043E\u0440\u043D\u044B\u0445
      \u0442\u0440\u043E\u043F \u2014 \u043E\u0434\u043D\u0430 \u0443\u0445\u043E\u0434\u0438\u0442
      \u0432\u0432\u0435\u0440\u0445, \u0432 \u043E\u0431\u043B\u0430\u043A\u0430,
      \u0434\u0440\u0443\u0433\u0430\u044F \u043E\u0433\u0438\u0431\u0430\u0435\u0442
      \u0445\u0440\u0435\u0431\u0435\u0442 \u043F\u043E \u0443\u0437\u043A\u043E\u043C\u0443
      \u043A\u0430\u0440\u043D\u0438\u0437\u0443 \u2014 \u0441\u0438\u0434\u0438\u0442
      \u043D\u0430 \u0432\u0430\u043B\u0443\u043D\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0432 \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u043E\u0439 \u043E\u0432\u0447\u0438\u043D\u043D\u043E\u0439
      \u0447\u0443\u0431\u0435. \u041D\u0430 \u043F\u043E\u044F\u0441\u0435 \u2014
      \u043D\u043E\u0436 \u0438 \u043C\u043E\u0442\u043E\u043A \u043F\u0435\u043D\u044C\u043A\u043E\u0432\u043E\u0439
      \u0432\u0435\u0440\u0451\u0432\u043A\u0438. \u0420\u044F\u0434\u043E\u043C
      \u0441\u0442\u043E\u0438\u0442 \u044F\u043A \u0441 \u043F\u0443\u0441\u0442\u043E\u0439
      \u0432\u044C\u044E\u0447\u043D\u043E\u0439 \u0440\u0430\u043C\u043E\u0439:
      \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0431\u0435\u0437 \u043A\u043B\u0438\u0435\u043D\u0442\u0430.
      \u041B\u0438\u0446\u043E \u0442\u0451\u043C\u043D\u043E\u0435, \u043E\u0431\u0432\u0435\u0442\u0440\u0435\u043D\u043D\u043E\u0435,
      \u0440\u0443\u043A\u0438 \u2014 \u043A\u0430\u043A \u043A\u043E\u0440\u043D\u0438
      \u0433\u043E\u0440\u043D\u043E\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u0430.
      \u041E\u043D \u0436\u0443\u0451\u0442 \u0441\u0442\u0435\u0431\u0435\u043B\u044C
      \u0441\u0443\u0445\u043E\u0439 \u0442\u0440\u0430\u0432\u044B \u0438 \u0438\u0437\u0443\u0447\u0430\u0435\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0441 \u043B\u0435\u043D\u0438\u0432\u044B\u043C
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u043C \u0431\u044B\u0432\u0430\u043B\u043E\u0433\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.\r\n\r\n<npc_speech lang=\"Tibetan\">\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E.
      \u041C\u0435\u043D\u044F \u0437\u043E\u0432\u0443\u0442 \u0414\u043E\u0440\u0436\u0435.
      \u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442 \u0445\u043E\u0436\u0443
      \u0447\u0435\u0440\u0435\u0437 \u044D\u0442\u043E\u0442 \u043F\u0435\u0440\u0435\u0432\u0430\u043B.
      \u041F\u043E\u0433\u043E\u0434\u0430 \u043F\u043E\u0440\u0442\u0438\u0442\u0441\u044F
      \u2014 \u0432\u0430\u043C \u043D\u0443\u0436\u0435\u043D \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A.
      \u0426\u0435\u043D\u0430 \u0440\u0430\u0437\u0443\u043C\u043D\u0430\u044F.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449302
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u2014 \u0438\u0434\u0442\u0438
      \u0441\u0432\u043E\u0438\u043C \u043F\u0443\u0442\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449303
    m_Localized: "\u0412\u044B \u043F\u043E\u043A\u0430\u0447\u0430\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
      \u2014 \u043B\u0438\u0448\u043D\u0438\u0445 \u043C\u043E\u043D\u0435\u0442
      \u043D\u0435\u0442, \u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043D\u0435
      \u043F\u0435\u0440\u0432\u044B\u0439 \u0433\u043E\u0434 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435.
      \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043A\u0438\u0432\u043D\u0443\u043B
      \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B, \u0441\u0435\u043B \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u043D\u0430 \u0432\u0430\u043B\u0443\u043D \u0438 \u043F\u043E\u0442\u044F\u043D\u0443\u043B
      \u0441\u0442\u0435\u0431\u0435\u043B\u044C \u0442\u0440\u0430\u0432\u044B.
      <npc_speech lang=\"Turkic\">\u041F\u0443\u0441\u0442\u044C \u0422\u0435\u043D\u0433\u0440\u0438
      \u0445\u0440\u0430\u043D\u0438\u0442 \u0442\u0432\u043E\u0439 \u043F\u0443\u0442\u044C</npc_speech>
      \u2014 \u043F\u0440\u043E\u0431\u043E\u0440\u043C\u043E\u0442\u0430\u043B \u043E\u043D
      \u0432\u0441\u043B\u0435\u0434 \u043D\u0430 \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u043C,
      \u0441\u043B\u044B\u0448\u0430\u043D\u043D\u043E\u043C \u0433\u0434\u0435-\u0442\u043E
      \u043D\u0430 \u0431\u0430\u0437\u0430\u0440\u0430\u0445. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B\u0438 \u0435\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C.
      \u041A\u0440\u0435\u043F\u043A\u0438\u0439 \u043C\u0443\u0436\u0438\u043A,
      \u0437\u043D\u0430\u0435\u0442 \u0433\u043E\u0440\u044B. \u0416\u0430\u043B\u044C,
      \u0447\u0442\u043E \u043A\u043E\u0448\u0435\u043B\u0451\u043A \u043F\u0443\u0441\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449304
    m_Localized: "\u0421\u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0437\u0430 \u0443\u0441\u043B\u0443\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449305
    m_Localized: "\u0412\u044B \u043E\u0433\u043B\u044F\u0434\u0435\u043B\u0438 \u0435\u0433\u043E
      \u0441 \u043D\u043E\u0433 \u0434\u043E \u0433\u043E\u043B\u043E\u0432\u044B
      \u2014 \u0432\u0435\u0440\u0451\u0432\u043A\u0438 \u043A\u0440\u0435\u043F\u043A\u0438\u0435,
      \u043D\u043E\u0436 \u043D\u0430\u0442\u043E\u0447\u0435\u043D, \u044F\u043A
      \u0443\u0445\u043E\u0436\u0435\u043D, \u043D\u0430 \u0440\u0443\u043A\u0430\u0445
      \u0441\u0442\u0430\u0440\u044B\u0435 \u043C\u043E\u0437\u043E\u043B\u0438 \u043E\u0442
      \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u0445 \u0437\u0430\u0445\u0432\u0430\u0442\u043E\u0432.
      \u0427\u0435\u043B\u043E\u0432\u0435\u043A \u0434\u0435\u043B\u0430, \u043D\u0435
      \u043F\u043E\u043F\u0440\u043E\u0448\u0430\u0439\u043A\u0430. \xAB\u0412\u043E\u0441\u0435\u043C\u044C
      \u043C\u043E\u043D\u0435\u0442 \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430. \u0415\u0434\u0430 \u043D\u0430\u0448\u0430,
      \u043D\u043E\u0447\u0443\u0435\u0448\u044C \u0441 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u043C.
      \u0415\u0441\u043B\u0438 \u0437\u0430\u0432\u0435\u0434\u0451\u0448\u044C \u043D\u0435
      \u0442\u0443\u0434\u0430 \u2014 \u0441\u0435\u0440\u0435\u0431\u0440\u043E
      \u0432\u0435\u0440\u043D\u0451\u0448\u044C.\xBB \u0414\u043E\u0440\u0436\u0435
      \u0445\u043C\u044B\u043A\u043D\u0443\u043B, \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B
      \u0436\u0451\u0441\u0442\u043A\u0443\u044E \u043B\u0430\u0434\u043E\u043D\u044C.
      \xAB\u0414\u043E\u0440\u0436\u0435 \u043D\u0435 \u0432\u043E\u0434\u0438\u0442
      \u043D\u0435 \u0442\u0443\u0434\u0430. \u0412\u043E\u0441\u0435\u043C\u044C
      \u2014 \u0447\u0435\u0441\u0442\u043D\u043E.\xBB \u041E\u043D \u0441\u0432\u0438\u0441\u0442\u043D\u0443\u043B
      \u044F\u043A\u0430, \u0437\u0430\u043A\u0438\u043D\u0443\u043B \u0432\u0435\u0440\u0451\u0432\u043A\u0443
      \u043D\u0430 \u043F\u043B\u0435\u0447\u043E \u0438 \u0432\u0441\u0442\u0430\u043B
      \u0432\u043E \u0433\u043B\u0430\u0432\u0435 \u043A\u043E\u043B\u043E\u043D\u043D\u044B,
      \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0432\u0451\u043B \u044D\u0442\u043E\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0441 \u0441\u0430\u043C\u043E\u0433\u043E
      \u041A\u0430\u0448\u0433\u0430\u0440\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u043E\u0432\u0435\u0441\u0435\u043B\u0435\u043B\u0438 \u2014 \u0441
      \u0442\u0430\u043A\u0438\u043C \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u043C
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B \u0443\u0436\u0435 \u043D\u0435
      \u0441\u0442\u0440\u0430\u0448\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449306
    m_Localized: "\u0412\u044B \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C
      \u0441\u0431\u0438\u0442\u044C \u0446\u0435\u043D\u0443, \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0432
      \u043F\u044F\u0442\u044C, \u043D\u043E \u0414\u043E\u0440\u0436\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u043A\u0430\u0447\u0430\u043B \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \xAB\u041F\u044F\u0442\u044C \u2014 \u044D\u0442\u043E \u0446\u0435\u043D\u0430
      \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u0442 \u0442\u0435\u0431\u044F \u0432
      \u0442\u0443\u043C\u0430\u043D\u0435, \u0445\u043E\u0437\u044F\u0438\u043D.
      \u042F \u2014 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C.
      \u0414\u0435\u0448\u0451\u0432\u044B\u0445 \u0433\u043E\u0440 \u043D\u0435
      \u0431\u044B\u0432\u0430\u0435\u0442.\xBB \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043F\u043E \u0435\u0433\u043E
      \u0441\u0442\u0430\u0432\u043A\u0435 \u2014 \u043F\u043E\u0447\u0442\u0438
      \u0432\u0434\u0432\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C
      \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u043B\u0438. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0441\u043A\u0440\u0438\u0432\u0438\u043B\u0438\u0441\u044C, \u043D\u043E
      \u0414\u043E\u0440\u0436\u0435 \u0443\u0436\u0435 \u0437\u0430\u043D\u044F\u043B
      \u043C\u0435\u0441\u0442\u043E \u0432\u043F\u0435\u0440\u0435\u0434\u0438,
      \u0438 \u0441\u043F\u043E\u0440\u0438\u0442\u044C \u0431\u044B\u043B\u043E
      \u043F\u043E\u0437\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449307
    m_Localized: "\u0412\u0430\u0448 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0437\u043D\u0430\u0435\u0442 \u044D\u0442\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449308
    m_Localized: "\u0412\u0430\u0448 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0432\u0434\u0440\u0443\u0433 \u043E\u0441\u0430\u0434\u0438\u043B \u044F\u043A\u0430
      \u0438 \u043A\u0440\u0438\u043A\u043D\u0443\u043B \u0447\u0442\u043E-\u0442\u043E
      \u043F\u043E-\u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438 \u2014 \u0440\u0435\u0437\u043A\u043E,
      \u0441 \u0438\u043D\u0442\u043E\u043D\u0430\u0446\u0438\u0435\u0439 \u0443\u0437\u043D\u0430\u0432\u0430\u043D\u0438\u044F.
      \u0414\u043E\u0440\u0436\u0435 \u0432\u0441\u043A\u043E\u0447\u0438\u043B \u0441
      \u0432\u0430\u043B\u0443\u043D\u0430, \u043F\u0440\u0438\u0449\u0443\u0440\u0438\u043B\u0441\u044F
      \u2014 \u0438 \u0440\u0430\u0441\u0445\u043E\u0445\u043E\u0442\u0430\u043B\u0441\u044F,
      \u0445\u043B\u043E\u043F\u0430\u044F \u0441\u0435\u0431\u044F \u043F\u043E
      \u0431\u0451\u0434\u0440\u0430\u043C. <npc_speech lang=\"Tibetan\">\u041F\u0435\u043C\u0431\u0430!
      \u0421\u0442\u0430\u0440\u044B\u0439 \u043A\u043E\u0437\u0451\u043B, \u0442\u044B
      \u0436\u0438\u0432!</npc_speech> \u041E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
      \u043E\u043D\u0438 \u0432\u043C\u0435\u0441\u0442\u0435 \u0432\u043E\u0434\u0438\u043B\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u044B \u0447\u0435\u0440\u0435\u0437
      \u041A\u0430\u0440\u0430\u043A\u043E\u0440\u0443\u043C \u0447\u0435\u0442\u044B\u0440\u0435
      \u0441\u0435\u0437\u043E\u043D\u0430 \u043D\u0430\u0437\u0430\u0434, \u0434\u0435\u043B\u0438\u043B\u0438
      \u0432\u0435\u0440\u0451\u0432\u043A\u0443 \u043D\u0430 \u043B\u0435\u0434\u043E\u0432\u043E\u043C
      \u0441\u043A\u043B\u043E\u043D\u0435 \u0438 \u043E\u0434\u043D\u0430\u0436\u0434\u044B
      \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438 \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430
      \u0438\u0437 \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u044B. \u041F\u0435\u043C\u0431\u0430
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043A \u0432\u0430\u043C:
      \xAB\u0414\u043E\u0440\u0436\u0435 \u2014 \u043B\u0443\u0447\u0448\u0438\u0439
      \u043D\u0430 \u044D\u0442\u043E\u043C \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435.
      \u0427\u0435\u0442\u044B\u0440\u0435 \u043C\u043E\u043D\u0435\u0442\u044B \u2014
      \u0446\u0435\u043D\u0430 \u0434\u0440\u0443\u0436\u0431\u044B. \u0418 \u0435\u0433\u043E
      \u044F\u043A \u043F\u043E\u0439\u0434\u0451\u0442 \u0432 \u043D\u0430\u0448
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D.\xBB \u0414\u0432\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430
      \u2014 \u044D\u0442\u043E \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0434\u0432\u043E\u0439\u043D\u0430\u044F \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C,
      \u043D\u043E \u0438 \u0437\u043D\u0430\u043D\u0438\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u043A\u0430\u043C\u043D\u044F \u043D\u0430 \u0434\u0432\u0435\u0441\u0442\u0438
      \u043B\u0438 \u0432\u043E\u043A\u0440\u0443\u0433. \u0412\u044B \u0432\u044B\u0443\u0447\u0438\u043B\u0438
      \u0438\u0437 \u0438\u0445 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430
      \u043F\u0430\u0440\u0443 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0445
      \u0441\u043B\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0441\u0442\u043E\u0438\u0442
      \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C: \xAB\u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0430\xBB,
      \xAB\u043B\u0451\u0434\xBB, \xAB\u0432\u0435\u0440\u0451\u0432\u043A\u0443
      \u0434\u0435\u0440\u0436\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449309
    m_Localized: "\u041A\u0430\u043C\u043D\u0435\u043F\u0430\u0434 \u043D\u0430 \u0433\u043E\u0440\u043D\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449310
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u043E\u0433\u0438\u0431\u0430\u0435\u0442
      \u0441\u043A\u043B\u043E\u043D \u043F\u043E \u0443\u0437\u043A\u043E\u043C\u0443
      \u043A\u0430\u0440\u043D\u0438\u0437\u0443 \u2014 \u0441\u043F\u0440\u0430\u0432\u0430
      \u0441\u0442\u0435\u043D\u0430 \u0438\u0437 \u0442\u0451\u043C\u043D\u043E\u0433\u043E
      \u0441\u043B\u043E\u0438\u0441\u0442\u043E\u0433\u043E \u043A\u0430\u043C\u043D\u044F,
      \u0441\u043B\u0435\u0432\u0430 \u043E\u0431\u0440\u044B\u0432 \u0432 \u0443\u0449\u0435\u043B\u044C\u0435,
      \u043D\u0430 \u0434\u043D\u0435 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u0431\u0435\u043B\u0435\u0435\u0442 \u043D\u0438\u0442\u043A\u0430 \u0440\u0435\u043A\u0438.
      \u0421\u0432\u0435\u0440\u0445\u0443 \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u0433\u0443\u043B, \u043F\u043E\u0445\u043E\u0436\u0438\u0439 \u043D\u0430
      \u0434\u0430\u043B\u0451\u043A\u0438\u0439 \u0433\u0440\u043E\u043C, \u043D\u043E
      \u043D\u0435\u0431\u043E \u0447\u0438\u0441\u0442\u043E\u0435. \u041C\u0435\u043B\u043A\u0438\u0435
      \u043A\u0430\u043C\u0435\u0448\u043A\u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
      \u0441\u043A\u0430\u0442\u044B\u0432\u0430\u0442\u044C\u0441\u044F \u043F\u043E
      \u0441\u0442\u0435\u043D\u0435, \u0441\u0442\u0443\u0447\u0430 \u043F\u043E
      \u043A\u043E\u0437\u044B\u0440\u044C\u043A\u0430\u043C \u043F\u043E\u0432\u043E\u0437\u043E\u043A.
      \u0413\u043E\u043B\u043E\u0432\u043D\u043E\u0439 \u044F\u043A \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
      \u0438 \u0437\u0430\u043C\u043E\u0442\u0430\u043B \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0437\u0430\u0434\u0440\u0430\u043B\u0438
      \u0433\u043E\u043B\u043E\u0432\u044B: \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443
      \u043D\u0430\u0434 \u0442\u0440\u043E\u043F\u043E\u0439 \u043F\u043E\u043B\u0437\u0451\u0442
      \u0442\u0440\u0435\u0449\u0438\u043D\u0430 \u2014 \u043F\u043B\u0430\u0441\u0442
      \u043F\u043E\u0440\u043E\u0434\u044B \u0441\u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F,
      \u0438 \u0432\u043E\u043F\u0440\u043E\u0441 \u043D\u0435 \u0432 \u0442\u043E\u043C,
      \u0440\u0443\u0445\u043D\u0435\u0442 \u043B\u0438 \u043E\u043D, \u0430 \u043A\u043E\u0433\u0434\u0430.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0440\u0430\u0441\u0442\u044F\u043D\u0443\u043B\u0441\u044F
      \u043F\u043E \u043A\u0430\u0440\u043D\u0438\u0437\u0443 \u043D\u0430 \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u0448\u0430\u0433\u043E\u0432 \u2014 \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u043D\u0435\u043A\u0443\u0434\u0430, \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C
      \u2014 \u0437\u043D\u0430\u0447\u0438\u0442 \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C
      \u043F\u043E\u043B\u0434\u043D\u044F, \u0430 \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
      \u2014 \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C \u0431\u044B\u0442\u044C
      \u043F\u043E\u0433\u0440\u0435\u0431\u0451\u043D\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449311
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u0447\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430 \u0438 \u0431\u0435\u0436\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449312
    m_Localized: "\xAB\u0411\u0440\u043E\u0441\u0430\u0439 \u0442\u044E\u043A\u0438
      \u2014 \u0431\u0435\u0433\u043E\u043C!\xBB \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u044E\u0442 \u043C\u0435\u0448\u043A\u0438
      \u0438 \u0441\u0432\u0451\u0440\u0442\u043A\u0438 \u0441 \u043F\u043E\u0432\u043E\u0437\u043E\u043A,
      \u0447\u0442\u043E\u0431\u044B \u043E\u0431\u043B\u0435\u0433\u0447\u0438\u0442\u044C
      \u0445\u043E\u0434, \u0438 \u0433\u043E\u043D\u044F\u0442 \u044F\u043A\u043E\u0432
      \u0445\u043B\u044B\u0441\u0442\u0430\u043C\u0438 \u043F\u043E \u043A\u0430\u0440\u043D\u0438\u0437\u0443.
      \u041F\u0435\u0440\u0432\u044B\u0435 \u043A\u0430\u043C\u043D\u0438 \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C
      \u0441 \u043A\u0443\u043B\u0430\u043A \u0443\u0436\u0435 \u0431\u044C\u044E\u0442
      \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435, \u0432\u044B\u0441\u0435\u043A\u0430\u044F
      \u0438\u0441\u043A\u0440\u044B \u0438\u0437 \u0441\u043A\u0430\u043B\u044B.
      \u0417\u0430\u0434\u043D\u044F\u044F \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430 \u043C\u0435\u0448\u043E\u043A
      \u2014 \u043E\u043D \u043F\u043E\u043B\u0435\u0442\u0435\u043B \u0432 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C,
      \u043A\u0443\u0432\u044B\u0440\u043A\u0430\u044F\u0441\u044C, \u0438 \u0440\u0430\u0437\u0431\u0438\u043B\u0441\u044F
      \u0434\u0430\u043B\u0435\u043A\u043E \u0432\u043D\u0438\u0437\u0443. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u0440\u043E\u0441\u043A\u043E\u0447\u0438\u043B \u043E\u043F\u0430\u0441\u043D\u044B\u0439
      \u0443\u0447\u0430\u0441\u0442\u043E\u043A \u0437\u0430 \u043C\u0438\u043D\u0443\u0442\u0443
      \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u043F\u043B\u0430\u0441\u0442
      \u0440\u0443\u0445\u043D\u0443\u043B, \u2014 \u0433\u0440\u043E\u0445\u043E\u0442
      \u0441\u0442\u043E\u044F\u043B \u0442\u0430\u043A\u043E\u0439, \u0447\u0442\u043E
      \u044F\u043A\u0438 \u043F\u0440\u0438\u0441\u0435\u043B\u0438 \u043D\u0430
      \u0437\u0430\u0434\u043D\u0438\u0435 \u043D\u043E\u0433\u0438. \u041F\u043E\u0437\u0430\u0434\u0438
      \u2014 \u043E\u0431\u043B\u0430\u043A\u043E \u043F\u044B\u043B\u0438 \u0438
      \u0437\u0430\u0432\u0430\u043B, \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0434\u0438\u0432\u0448\u0438\u0439
      \u0442\u0440\u043E\u043F\u0443. \u0412\u0441\u0435 \u0436\u0438\u0432\u044B,
      \u043D\u043E \u0447\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u043F\u043E\u0434 \u043A\u0430\u043C\u043D\u044F\u043C\u0438
      \u0438\u043B\u0438 \u043D\u0430 \u0434\u043D\u0435 \u0443\u0449\u0435\u043B\u044C\u044F.
      \u041B\u044E\u0434\u0438 \u043C\u043E\u043B\u0447\u0430\u0442. \u0420\u0443\u043A\u0438
      \u0442\u0440\u044F\u0441\u0443\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449313
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u043F\u0440\u043E\u0432\u0435\u0441\u0442\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449314
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u043D\u044F\u043B\u0438 \u0440\u0443\u043A\u0443
      \u2014 \u0442\u0438\u0448\u0438\u043D\u0430. \u041E\u0433\u043B\u044F\u0434\u0435\u043B\u0438
      \u0441\u043A\u043B\u043E\u043D: \u0442\u0440\u0435\u0449\u0438\u043D\u0430
      \u043F\u043E\u043B\u0437\u0451\u0442, \u043D\u043E \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E,
      \u043F\u043B\u0430\u0441\u0442 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043D\u0430 \u0441\u043A\u0430\u043B\u044C\u043D\u043E\u043C \u0432\u044B\u0441\u0442\u0443\u043F\u0435
      \u0432 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438 \u0441\u0430\u0436\u0435\u043D\u044F\u0445
      \u0432\u044B\u0448\u0435. \u041D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0439\u0442\u0438
      \u0442\u0438\u0445\u043E \u2014 \u0431\u0435\u0437 \u043A\u0440\u0438\u043A\u0430,
      \u0431\u0435\u0437 \u0445\u043B\u044B\u0441\u0442\u0430, \u043F\u043E \u043E\u0434\u043D\u043E\u0439
      \u043F\u043E\u0432\u043E\u0437\u043A\u0435. \xAB\u042F\u043A\u043E\u0432 \u2014
      \u043F\u043E\u0434 \u0443\u0437\u0434\u0446\u044B, \u043A\u043E\u043B\u0451\u0441\u0430
      \u2014 \u0432\u0440\u0443\u0447\u043D\u0443\u044E, \u043D\u0438 \u0437\u0432\u0443\u043A\u0430.\xBB
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0448\u0430\u0433\u043E\u043C, \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0437\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u043E\u0439, \u0432\u043E\u0434\u0447\u0438\u0439
      \u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u043A\u043E\u043B\u0435\u0441\u0430.
      \u041A\u0430\u043C\u0435\u0448\u043A\u0438 \u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C,
      \u043F\u044B\u043B\u044C \u0449\u0438\u043F\u0430\u043B\u0430 \u0433\u043B\u0430\u0437\u0430,
      \u043D\u043E \u043F\u043B\u0430\u0441\u0442 \u0434\u0435\u0440\u0436\u0430\u043B\u0441\u044F.
      \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0432\u044B\u0435\u0445\u0430\u043B\u0430 \u0438\u0437-\u043F\u043E\u0434
      \u043A\u043E\u0437\u044B\u0440\u044C\u043A\u0430, \u043A\u043E\u0433\u0434\u0430
      \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 \u0441 \u0445\u0440\u0443\u0441\u0442\u043E\u043C
      \u043E\u0442\u0432\u0430\u043B\u0438\u043B\u0441\u044F \u043A\u0443\u0441\u043E\u043A
      \u0441\u043A\u0430\u043B\u044B \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C
      \u0441 \u0441\u0443\u043D\u0434\u0443\u043A \u0438 \u0437\u0430\u0433\u0440\u0435\u043C\u0435\u043B
      \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443. \u0412\u0441\u0435 \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u2014 \u0438 \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B\u0438. \u041C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E
      \u0441\u0442\u043E\u0438\u043B\u043E \u043D\u0435\u0440\u0432\u043E\u0432,
      \u043D\u043E \u043D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0442\u044E\u043A\u0430
      \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449315
    m_Localized: "\u0412\u044B \u043F\u043E\u0432\u0435\u043B\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0448\u0430\u0433\u043E\u043C, \u043D\u043E \u0442\u0440\u0435\u0442\u044C\u044F
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u0437\u0430\u0446\u0435\u043F\u0438\u043B\u0430
      \u043A\u043E\u043B\u0435\u0441\u043E\u043C \u0432\u044B\u0441\u0442\u0443\u043F
      \u2014 \u0441\u043A\u0440\u0435\u0436\u0435\u0442 \u043E\u0442\u0434\u0430\u043B\u0441\u044F
      \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u0441\u043A\u043B\u043E\u043D\u0443,
      \u043A\u0430\u043A \u0443\u0434\u0430\u0440 \u043C\u043E\u043B\u043E\u0442\u0430.
      \u0427\u0435\u0440\u0435\u0437 \u0441\u0435\u043A\u0443\u043D\u0434\u0443 \u0441\u0432\u0435\u0440\u0445\u0443
      \u043F\u043E\u0448\u043B\u043E: \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u0449\u0435\u0431\u0435\u043D\u044C, \u043F\u043E\u0442\u043E\u043C \u0432\u0430\u043B\u0443\u043D\u044B.
      \u041F\u043B\u0430\u0441\u0442 \u0441\u044A\u0435\u0445\u0430\u043B \u0441\u043E
      \u0441\u043A\u043B\u043E\u043D\u0430, \u0443\u0434\u0430\u0440\u0438\u0432
      \u043F\u043E \u0437\u0430\u0434\u043D\u0435\u0439 \u0447\u0430\u0441\u0442\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430. \u041E\u0434\u043D\u0430
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u0441\u043C\u044F\u0442\u0430,
      \u0434\u0440\u0443\u0433\u0430\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0430
      \u0431\u043E\u0440\u0442 \u0438 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u0433\u0440\u0443\u0437\u0430. \u042F\u043A \u0441 \u0432\u044C\u044E\u043A\u043E\u043C
      \u0440\u0443\u0445\u043D\u0443\u043B \u043D\u0430\u0431\u043E\u043A, \u043F\u0440\u0438\u0434\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
      \u043A\u0430\u043C\u043D\u0435\u043C. \u041B\u044E\u0434\u0438 \u043A\u0440\u0438\u0447\u0430\u0442,
      \u043F\u044B\u043B\u044C \u0441\u0442\u043E\u0438\u0442 \u0441\u0442\u0435\u043D\u043E\u0439.
      \u041A\u043E\u0433\u0434\u0430 \u043E\u0441\u0435\u043B\u043E \u2014 \u0442\u0440\u043E\u0435
      \u0443\u0448\u0438\u0431\u043B\u0435\u043D\u043D\u044B\u0445, \u0434\u0432\u0435
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u044B,
      \u0442\u0440\u043E\u043F\u0430 \u0437\u0430\u0432\u0430\u043B\u0435\u043D\u0430
      \u043D\u0430 \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u0448\u0430\u0433\u043E\u0432
      \u043F\u043E\u0437\u0430\u0434\u0438. \u0412\u043F\u0435\u0440\u0451\u0434
      \u2014 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0439
      \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449316
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0443\u0435\u0442
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0439 \u043F\u0440\u043E\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449317
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0441\u043F\u0435\u0448\u0438\u043B\u0441\u044F,
      \u043E\u0433\u043B\u044F\u0434\u0435\u043B \u0441\u043A\u043B\u043E\u043D,
      \u043F\u0440\u0438\u0449\u0443\u0440\u0438\u043B\u0441\u044F \u043D\u0430 \u0442\u0440\u0435\u0449\u0438\u043D\u0443
      \u0438 \u043A\u0438\u0432\u043D\u0443\u043B \u0441\u0430\u043C \u0441\u0435\u0431\u0435.
      \xAB\u042F \u0442\u0430\u043A\u043E\u0435 \u0432\u0438\u0434\u0435\u043B \u043F\u043E\u0434
      \u0413\u0438\u043D\u0434\u0443\u043A\u0443\u0448\u0435\u043C. \u041D\u0443\u0436\u043D\u043E
      \u0432\u044B\u0431\u0438\u0442\u044C \u043E\u043F\u043E\u0440\u0443 \u0440\u0430\u043D\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043F\u043B\u0430\u0441\u0442 \u0441\u043E\u0439\u0434\u0451\u0442
      \u0441\u0430\u043C \u2014 \u043F\u0443\u0441\u0442\u044C \u043F\u0430\u0434\u0430\u0435\u0442,
      \u043F\u043E\u043A\u0430 \u043C\u044B \u043D\u0430 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u043C
      \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438.\xBB \u041E\u043D
      \u0432\u0437\u044F\u043B \u0432\u0435\u0440\u0451\u0432\u043A\u0443, \u043E\u0431\u0432\u044F\u0437\u0430\u043B\u0441\u044F
      \u0438 \u043F\u043E\u043B\u0435\u0437 \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443
      \u2014 \u0431\u044B\u0441\u0442\u0440\u043E, \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E,
      \u0446\u0435\u043F\u043B\u044F\u044F\u0441\u044C \u0437\u0430 \u0432\u044B\u0441\u0442\u0443\u043F\u044B.
      \u0427\u0435\u0440\u0435\u0437 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C
      \u0447\u0430\u0441\u0430 \u0441\u0432\u0435\u0440\u0445\u0443 \u0434\u043E\u043D\u0451\u0441\u0441\u044F
      \u0441\u0432\u0438\u0441\u0442, \u043F\u043E\u0442\u043E\u043C \u0443\u0434\u0430\u0440
      \u2014 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0432\u044B\u0431\u0438\u043B
      \u043A\u0430\u043C\u0435\u043D\u044C-\u043F\u043E\u0434\u043F\u043E\u0440\u043A\u0443,
      \u0438 \u043F\u043B\u0430\u0441\u0442 \u0441\u044A\u0435\u0445\u0430\u043B,
      \u0437\u0430\u0433\u0440\u0435\u043C\u0435\u0432 \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443
      \u0438 \u0440\u0443\u0445\u043D\u0443\u0432 \u043D\u0430 \u0442\u0440\u043E\u043F\u0443
      \u0432 \u0441\u0442\u0430 \u0448\u0430\u0433\u0430\u0445 \u0432\u043F\u0435\u0440\u0435\u0434\u0438,
      \u043F\u043E\u0434\u043D\u044F\u0432 \u043E\u0431\u043B\u0430\u043A\u043E \u043F\u044B\u043B\u0438.
      \u041A\u043E\u0433\u0434\u0430 \u043F\u044B\u043B\u044C \u043E\u0441\u0435\u043B\u0430,
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0441\u044F,
      \u043E\u0442\u0440\u044F\u0445\u043D\u0443\u043B \u0440\u0443\u043A\u0438 \u0438
      \u0441\u043A\u0430\u0437\u0430\u043B: \xAB\u0422\u0435\u043F\u0435\u0440\u044C
      \u0447\u0438\u0441\u0442\u043E. \u0414\u0430\u0439\u0442\u0435 \u043C\u043D\u0435
      \u043F\u043E\u043B\u0447\u0430\u0441\u0430 \u2014 \u0440\u0430\u0441\u0447\u0438\u0449\u0443
      \u043F\u0440\u043E\u0445\u043E\u0434.\xBB \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0435\u0440\u0435\u0431\u0440\u0430\u043B\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0437\u0430\u0432\u0430\u043B, \u043F\u043E\u0434\u0442\u0430\u043B\u043A\u0438\u0432\u0430\u044F
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438. \u041D\u0438 \u0446\u0430\u0440\u0430\u043F\u0438\u043D\u044B,
      \u043D\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u043E\u0433\u043E
      \u0442\u044E\u043A\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043C\u043E\u043B\u0447\u0430 \u0445\u043B\u043E\u043F\u0430\u043B\u0438 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430
      \u043F\u043E \u043F\u043B\u0435\u0447\u0430\u043C \u2014 \u0441\u043B\u043E\u0432\u0430
      \u0431\u044B\u043B\u0438 \u043D\u0435 \u043D\u0443\u0436\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449318
    m_Localized: "\u0421\u043E\u0440\u0435\u0432\u043D\u043E\u0432\u0430\u043D\u0438\u0435
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449319
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u043F\u044B\u043B\u044C
      \u2014 \u0447\u0443\u0436\u043E\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D.
      \u0414\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0433\u0440\u0443\u0436\u0451\u043D\u044B\u0445
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432, \u043A\u0440\u0435\u043F\u043A\u0438\u0435
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438, \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0435
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0432 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0445
      \u043A\u0430\u0444\u0442\u0430\u043D\u0430\u0445. \u0421\u0442\u0430\u0440\u0448\u0438\u0439
      \u0447\u0443\u0436\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u043F\u0440\u0438\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430
      \u0438 \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u2014 \u0432 \u0433\u043B\u0430\u0437\u0430\u0445 \u0430\u0437\u0430\u0440\u0442.
      \u041E\u0431\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0438\u0434\u0443\u0442
      \u043A \u043E\u0434\u043D\u043E\u043C\u0443 \u0433\u043E\u0440\u043E\u0434\u0443,
      \u043E\u0431\u0430 \u0432\u0435\u0437\u0443\u0442 \u043F\u043E\u0445\u043E\u0436\u0438\u0439
      \u0442\u043E\u0432\u0430\u0440. \u041A\u0442\u043E \u043F\u0440\u0438\u0434\u0451\u0442
      \u043F\u0435\u0440\u0432\u044B\u043C \u2014 \u0442\u043E\u0442 \u043F\u0440\u043E\u0434\u0430\u0441\u0442
      \u0434\u043E\u0440\u043E\u0436\u0435, \u043F\u043E\u043A\u0430 \u0440\u044B\u043D\u043E\u043A
      \u043D\u0435 \u043D\u0430\u0441\u044B\u0442\u0438\u043B\u0441\u044F. \u0414\u043E\u0440\u043E\u0433\u0430
      \u0440\u0430\u0437\u0434\u0432\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438: \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
      \u0442\u0440\u0430\u043A\u0442 \u0438 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449320
    m_Localized: "\u0414\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0433\u043E
      \u0442\u0440\u0430\u043A\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449321
    m_Localized: "\u041D\u0430\u0434\u0451\u0436\u043D\u044B\u0439 \u043F\u0443\u0442\u044C
      \u2014 \u0431\u0435\u0437 \u0441\u044E\u0440\u043F\u0440\u0438\u0437\u043E\u0432.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u0438\u0448\u0451\u043B
      \u0432\u0442\u043E\u0440\u044B\u043C, \u043D\u043E \u0440\u044B\u043D\u043E\u043A
      \u0435\u0449\u0451 \u043D\u0435 \u043F\u0435\u0440\u0435\u043F\u043E\u043B\u043D\u0435\u043D:
      \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043F\u0440\u043E\u0434\u0430\u0442\u044C
      \u0447\u0430\u0441\u0442\u044C \u0442\u043E\u0432\u0430\u0440\u0430 \u043F\u043E
      \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u0446\u0435\u043D\u0435. \u041D\u0435
      \u043F\u043E\u0431\u0435\u0434\u0430, \u043D\u043E \u0438 \u043D\u0435 \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435
      \u2014 \u0442\u0440\u0435\u0437\u0432\u044B\u0439 \u0440\u0430\u0441\u0447\u0451\u0442,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u0446\u0435\u043D\u0438\u043B\u0438
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449322
    m_Localized: "\u0421\u0440\u0435\u0437\u0430\u0442\u044C \u0447\u0435\u0440\u0435\u0437
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449323
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u0430\u043B \u043A\u0440\u0443\u0442
      \u0438 \u0443\u0437\u043E\u043A, \u043D\u043E \u0432\u044B \u0432\u0435\u0440\u043D\u043E
      \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043B\u0438 \u0432\u0440\u0435\u043C\u044F.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u043A\u0430\u0442\u0438\u043B\u0441\u044F
      \u0432 \u0433\u043E\u0440\u043E\u0434 \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435
      \u2014 \u0440\u044B\u043D\u043E\u043A \u043F\u0443\u0441\u0442, \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0438
      \u0436\u0434\u0443\u0442. \u041F\u0435\u0440\u0432\u044B\u0439 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044C,
      \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439 \u0432\u0435\u043B\u044C\u043C\u043E\u0436\u0430,
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B \u043D\u0435 \u0442\u043E\u0440\u0433\u0443\u044F\u0441\u044C
      \u0438 \u043F\u043E\u0434\u0430\u0440\u0438\u043B \u043E\u0442\u0440\u0435\u0437
      \u043F\u0430\u0440\u0447\u0438 \u0432 \u0437\u043D\u0430\u043A \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F.
      \u041A\u043E\u0433\u0434\u0430 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0438
      \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C \u043A \u043F\u043E\u043B\u0443\u0434\u043D\u044E,
      \u043B\u0443\u0447\u0448\u0438\u0439 \u0442\u043E\u0432\u0430\u0440 \u0443\u0436\u0435
      \u0443\u0448\u0451\u043B \u2014 \u043F\u043E \u0432\u0430\u0448\u0435\u0439
      \u0446\u0435\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449324
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u0430\u043B \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0445\u0443\u0436\u0435, \u0447\u0435\u043C \u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0441 \u0434\u043E\u0440\u043E\u0433\u0438. \u041E\u0441\u044B\u043F\u0430\u044E\u0449\u0438\u0439\u0441\u044F
      \u0433\u0440\u0443\u043D\u0442, \u043A\u0440\u0443\u0442\u044B\u0435 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u044B
      \u2014 \u043E\u0434\u043D\u0430 \u0438\u0437 \u043F\u043E\u0432\u043E\u0437\u043E\u043A
      \u0437\u0430\u0446\u0435\u043F\u0438\u043B\u0430 \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u0439
      \u0432\u044B\u0441\u0442\u0443\u043F, \u0442\u0440\u0435\u0441\u043D\u0443\u043B\u0430
      \u043E\u0431\u0448\u0438\u0432\u043A\u0430 \u0431\u043E\u0440\u0442\u0430.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043E\u0442\u0435\u0440\u044F\u043B
      \u043F\u043E\u043B\u0434\u043D\u044F \u043D\u0430 \u0440\u0435\u043C\u043E\u043D\u0442
      \u0438 \u043F\u0440\u0438\u0448\u0451\u043B \u043F\u043E\u0437\u0436\u0435
      \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A\u0430. \u0420\u044B\u043D\u043E\u043A
      \u0443\u0436\u0435 \u0441\u0431\u0438\u0442, \u0432\u044B\u0440\u0443\u0447\u043A\u0430
      \u0441\u043A\u0440\u043E\u043C\u043D\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449325
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0437\u043D\u0430\u0435\u0442
      \u0440\u044B\u043D\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449326
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0443\u0441\u043C\u0435\u0445\u043D\u0443\u043B\u0441\u044F
      \u0438 \u043F\u043E\u043A\u0430\u0447\u0430\u043B \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \xAB\u041D\u0435 \u0433\u043E\u043D\u0438\u0441\u044C \u2014 \u043E\u0431\u0433\u043E\u043D\u0438
      \u0443\u043C\u043E\u043C.\xBB \u041E\u043D \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B
      \u0441\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043A \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u043C\u0443
      \u0433\u043E\u0440\u043E\u0434\u0443, \u0433\u0434\u0435 \u0442\u043E\u0442
      \u0436\u0435 \u0442\u043E\u0432\u0430\u0440 \u0441\u0442\u043E\u0438\u0442
      \u0434\u043E\u0440\u043E\u0436\u0435, \u0430 \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u0432
      \u043D\u0435\u0442. \u0414\u0432\u0430 \u0434\u043D\u044F \u043A\u0440\u044E\u043A\u0430
      \u2014 \u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0434\u0430\u043B
      \u0432\u0441\u0451 \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
      \u0442\u044E\u043A\u0430 \u043F\u043E \u0446\u0435\u043D\u0430\u043C, \u043E
      \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0441\u043E\u043F\u0435\u0440\u043D\u0438\u043A
      \u0432 \u0441\u0432\u043E\u0451\u043C \u0433\u043E\u0440\u043E\u0434\u0435
      \u0438 \u043C\u0435\u0447\u0442\u0430\u0442\u044C \u043D\u0435 \u043C\u043E\u0433.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u043E\u0441\u043C\u0435\u0438\u0432\u0430\u043B\u0438\u0441\u044C:
      \u043B\u0443\u0447\u0448\u0430\u044F \u0433\u043E\u043D\u043A\u0430 \u2014
      \u0442\u0430, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043D\u0435
      \u0443\u0447\u0430\u0441\u0442\u0432\u0443\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449327
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u043E\u0435 \u0432\u044C\u044E\u0447\u043D\u043E\u0435
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449328
    m_Localized: "\u0421 \u0443\u0442\u0440\u0430 \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u0439
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434 \u0448\u0451\u043B \u043D\u0435\u0440\u043E\u0432\u043D\u043E
      \u2014 \u043F\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u043B\u0441\u044F,
      \u043E\u0442\u0441\u0442\u0430\u0432\u0430\u043B, \u0440\u043E\u043D\u044F\u043B
      \u043F\u0435\u043D\u0443 \u0441 \u0433\u0443\u0431. \u041A \u043F\u043E\u043B\u0443\u0434\u043D\u044E
      \u043E\u043D \u0432\u0441\u0442\u0430\u043B, \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u044F\u0441\u044C
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F. \u0413\u043B\u0430\u0437\u0430
      \u043C\u0443\u0442\u043D\u044B\u0435, \u0431\u043E\u043A\u0430 \u0445\u043E\u0434\u044F\u0442
      \u0445\u043E\u0434\u0443\u043D\u043E\u043C, \u0438\u0437 \u043D\u043E\u0437\u0434\u0440\u0435\u0439
      \u0442\u044F\u043D\u0435\u0442\u0441\u044F \u043D\u0438\u0442\u043A\u0430 \u0441\u043B\u0438\u0437\u0438.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0441\u0442\u043E\u043B\u043F\u0438\u043B\u0438\u0441\u044C
      \u0432\u043E\u043A\u0440\u0443\u0433, \u043A\u0430\u0447\u0430\u044E\u0442
      \u0433\u043E\u043B\u043E\u0432\u0430\u043C\u0438. \u0422\u044E\u043A\u0438
      \u0441 \u0435\u0433\u043E \u0441\u043F\u0438\u043D\u044B \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u0438\u0442\u044C
      \u043D\u0435\u043A\u0443\u0434\u0430 \u2014 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u043D\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u044B
      \u0434\u043E \u043F\u0440\u0435\u0434\u0435\u043B\u0430. \u041D\u0443\u0436\u043D\u043E
      \u0440\u0435\u0448\u0430\u0442\u044C: \u043B\u0435\u0447\u0438\u0442\u044C,
      \u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0438\u043B\u0438 \u0440\u0438\u0441\u043A\u043D\u0443\u0442\u044C
      \u0438 \u0433\u043D\u0430\u0442\u044C \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449329
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435
      \u0438 \u0438\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449330
    m_Localized: "\u0422\u044E\u043A\u0438 \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043B\u0438,
      \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B\u0438 \u043F\u043E
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430\u043C
      \u2014 \u043A\u043E\u0435-\u0447\u0442\u043E \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0431\u0440\u043E\u0441\u0438\u0442\u044C. \u0411\u043E\u043B\u044C\u043D\u043E\u0433\u043E
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u0443 \u0434\u043E\u0440\u043E\u0433\u0438 \u0441 \u0431\u0443\u0440\u0434\u044E\u043A\u043E\u043C
      \u0432\u043E\u0434\u044B. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0443\u0445\u043E\u0434\u0438\u043B\u0438 \u043C\u043E\u043B\u0447\u0430,
      \u043D\u0435 \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044F\u0441\u044C.
      \u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0439 \u0432\u043E\u0437\u043D\u0438\u0446\u0430
      \u0441\u043F\u043B\u044E\u043D\u0443\u043B: \xAB\u041F\u043B\u043E\u0445\u0430\u044F
      \u043F\u0440\u0438\u043C\u0435\u0442\u0430 \u2014 \u0431\u0440\u043E\u0441\u0430\u0442\u044C
      \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u0442\u0435\u0431\u044F \u043D\u0451\u0441\xBB.
      \u041C\u044F\u0441\u043E \u043F\u0443\u0441\u0442\u044F\u0442 \u043D\u0430
      \u0432\u044F\u043B\u0435\u043D\u0438\u043D\u0443, \u0435\u0441\u043B\u0438
      \u0437\u0432\u0435\u0440\u044C \u043D\u0435 \u043F\u0440\u043E\u0442\u044F\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449331
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u0432\u044B\u043B\u0435\u0447\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449332
    m_Localized: "\u0412\u044B \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430 \u2014 \u0440\u0430\u0437\u0434\u0443\u0442\u044B\u0439
      \u0436\u0438\u0432\u043E\u0442, \u0436\u0430\u0440, \u0447\u0430\u0441\u0442\u043E\u0435
      \u0434\u044B\u0445\u0430\u043D\u0438\u0435. \u041E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0433\u0440\u044F\u0437\u043D\u043E\u0439 \u0432\u043E\u0434\u043E\u0439.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A-\u0442\u044E\u0440\u043E\u043A
      \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u0430\u043B \u0441\u0442\u0430\u0440\u043E\u0435
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E: \u043E\u0442\u0432\u0430\u0440
      \u0433\u043E\u0440\u044C\u043A\u043E\u0439 \u043F\u043E\u043B\u044B\u043D\u0438,
      \u0432\u043B\u0438\u0432\u0430\u0442\u044C \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u044F\u043F\u043A\u0443
      \u0432 \u043F\u0430\u0441\u0442\u044C. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u0432\u0441\u0442\u0430\u043B\u043E
      \u043D\u0430 \u043D\u043E\u0433\u0438, \u0448\u0430\u0442\u0430\u044F\u0441\u044C,
      \u043D\u043E \u0436\u0438\u0432\u043E\u0435. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u043F\u043E\u043B\u0434\u043D\u044F
      \u0438 \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u043D\u0430 \u0443\u0445\u043E\u0434, \u0437\u0430\u0442\u043E \u0432\u0441\u0435
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435 \u2014 \u0438 \u043B\u044E\u0434\u0438,
      \u0438 \u0441\u043A\u043E\u0442\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449333
    m_Localized: "\u041E\u0442\u0432\u0430\u0440 \u043D\u0435 \u043F\u043E\u043C\u043E\u0433
      \u2014 \u0432\u0435\u0440\u0431\u043B\u044E\u0434 \u0437\u0430\u0431\u0438\u043B\u0441\u044F
      \u0432 \u0441\u0443\u0434\u043E\u0440\u043E\u0433\u0430\u0445 \u0438 \u0437\u0430\u0442\u0438\u0445
      \u043A \u043D\u043E\u0447\u0438. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0440\u0430\u0437\u0434\u0435\u043B\u0430\u0442\u044C \u0442\u0443\u0448\u0443,
      \u0447\u0442\u043E\u0431\u044B \u0445\u043E\u0442\u044C \u043C\u044F\u0441\u043E
      \u043D\u0435 \u043F\u0440\u043E\u043F\u0430\u043B\u043E. \u0414\u0435\u043D\u044C
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D, \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B \u043D\u0430 \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u043E\u0435
      \u043B\u0435\u0447\u0435\u043D\u0438\u0435, \u0430 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043C\u0440\u0430\u0447\u043D\u0435\u0435 \u0442\u0443\u0447\u0438. \u0422\u044E\u043A\u0438,
      \u0447\u0442\u043E \u043D\u0451\u0441 \u0432\u0435\u0440\u0431\u043B\u044E\u0434,
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0432\u043E\u043B\u043E\u0447\u044C
      \u043D\u0430 \u0440\u0443\u043A\u0430\u0445 \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043F\u0440\u0438\u0432\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449334
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0437\u043D\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449335
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0441\u044F
      \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u0438, \u043E\u0449\u0443\u043F\u0430\u043B
      \u0436\u0438\u0432\u043E\u0442 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430,
      \u043F\u0440\u0438\u043F\u043E\u0434\u043D\u044F\u043B \u0432\u0435\u043A\u043E,
      \u043F\u043E\u043D\u044E\u0445\u0430\u043B \u0434\u044B\u0445\u0430\u043D\u0438\u0435.
      \xAB\u0412\u0437\u0434\u0443\u0442\u0438\u0435 \u043E\u0442 \u044F\u0434\u043E\u0432\u0438\u0442\u043E\u0439
      \u0442\u0440\u0430\u0432\u044B. \u0412\u0438\u0434\u0435\u043B \u0442\u0430\u043A\u043E\u0435
      \u0432 \u0411\u0443\u0445\u0430\u0440\u0435 \u2014 \u0442\u0430\u043C \u043E\u0441\u043B\u044B
      \u0434\u043E\u0445\u043B\u0438 \u0434\u0435\u0441\u044F\u0442\u043A\u0430\u043C\u0438,
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u043D\u0430\u0448\u043B\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u043E.\xBB
      \u041E\u043D \u0441\u043C\u0435\u0448\u0430\u043B \u0442\u043E\u043B\u0447\u0451\u043D\u044B\u0439
      \u0443\u0433\u043E\u043B\u044C \u0441 \u0441\u043E\u043B\u0451\u043D\u043E\u0439
      \u0432\u043E\u0434\u043E\u0439 \u0438 \u0432\u043B\u0438\u043B \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0443
      \u0432 \u0433\u043B\u043E\u0442\u043A\u0443 \u0447\u0435\u0440\u0435\u0437
      \u043A\u043E\u0436\u0430\u043D\u0443\u044E \u0432\u043E\u0440\u043E\u043D\u043A\u0443.
      \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435
      \u0432\u0441\u0442\u0430\u043B\u043E, \u0442\u0440\u044F\u0445\u043D\u0443\u043B\u043E
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0438 \u043F\u043E\u0442\u044F\u043D\u0443\u043B\u043E\u0441\u044C
      \u043A \u043A\u043E\u0440\u043C\u0443\u0448\u043A\u0435. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u043D\u0430 \u043B\u0435\u043A\u0430\u0440\u044F
      \u0441 \u0442\u0435\u043C \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043D\u0435 \u043A\u0443\u043F\u0438\u0448\u044C
      \u0437\u0430 \u0434\u0435\u043D\u044C\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449336
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446 \u043A\u0430\u0440\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449337
    m_Localized: "\u0412 \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0435
      \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430 \u0441\u0438\u0434\u0438\u0442
      \u0445\u0443\u0434\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432
      \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u043E\u043C \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C
      \u043A\u0430\u0444\u0442\u0430\u043D\u0435, \u0440\u0430\u0437\u043B\u043E\u0436\u0438\u0432
      \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u044F\u0445 \u0441\u0432\u0451\u0440\u043D\u0443\u0442\u044B\u0435
      \u0441\u0432\u0438\u0442\u043A\u0438. \u041F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C
      \u2014 \u043A\u043E\u0436\u0430\u043D\u0430\u044F \u0441\u0443\u043C\u043A\u0430,
      \u043D\u0430\u0431\u0438\u0442\u0430\u044F \u0442\u0440\u0443\u0431\u043A\u0430\u043C\u0438
      \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0430, \u0438 \u0447\u0435\u0440\u043D\u0438\u043B\u044C\u043D\u0438\u0446\u0430
      \u0441 \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u043E\u0439 \u043A\u0440\u044B\u0448\u043A\u043E\u0439.
      \u0417\u0430\u0432\u0438\u0434\u0435\u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u043E\u043D \u0432\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u0435\u0442,
      \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u043E\u0434\u0438\u043D \u0441\u0432\u0438\u0442\u043E\u043A
      \u0438 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442:
      \u043B\u0438\u043D\u0438\u0438 \u0442\u0440\u043E\u043F, \u0437\u043D\u0430\u0447\u043A\u0438
      \u043A\u043E\u043B\u043E\u0434\u0446\u0435\u0432, \u043F\u043E\u043C\u0435\u0442\u043A\u0438
      \u043D\u0430 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C.
      \xAB\u0422\u0430\u0439\u043D\u044B\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442,
      \u2014 \u0448\u0435\u043F\u0447\u0435\u0442 \u043E\u043D, \u0442\u044B\u0447\u0430
      \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u0432 \u043A\u0430\u0440\u0442\u0443.
      \u2014 \u041A\u043E\u0440\u043E\u0447\u0435 \u043D\u0430 \u0434\u0435\u0441\u044F\u0442\u044C
      \u0434\u043D\u0435\u0439, \u043C\u0438\u043C\u043E \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u0447\u044C\u0438\u0445
      \u0437\u0430\u0441\u0442\u0430\u0432.\xBB \u0413\u043B\u0430\u0437\u0430 \u0431\u0435\u0433\u0430\u044E\u0442,
      \u0440\u0443\u043A\u0438 \u0434\u0440\u043E\u0436\u0430\u0442 \u2014 \u0442\u043E
      \u043B\u0438 \u043E\u0442 \u0432\u043E\u043B\u043D\u0435\u043D\u0438\u044F,
      \u0442\u043E \u043B\u0438 \u043E\u0442 \u0447\u0435\u0433\u043E-\u0442\u043E
      \u0435\u0449\u0451.\r\n\r\n<npc_speech lang=\"Sogdian\">\u041F\u0440\u0438\u0432\u0435\u0442,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A! \u042D\u0442\u0430
      \u043A\u0430\u0440\u0442\u0430 \u2014 \u0442\u0430\u0439\u043D\u044B\u0439
      \u043F\u0443\u0442\u044C, \u043D\u0430 \u0434\u0435\u0441\u044F\u0442\u044C
      \u0434\u043D\u0435\u0439 \u043A\u043E\u0440\u043E\u0447\u0435, \u043C\u0438\u043C\u043E
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432. \u041F\u044F\u0442\u044C
      \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0445 \u2014 \u0438
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0442\u0432\u043E\u044F \u0441\u0432\u0435\u0442\u043B\u0430!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449338
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449339
    m_Localized: "\u0412\u044B \u043F\u043E\u043A\u0430\u0447\u0430\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
      \u0438 \u043F\u0440\u043E\u0448\u043B\u0438 \u043C\u0438\u043C\u043E. \u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446
      \u0441\u043D\u0438\u043A, \u043D\u043E \u0442\u0443\u0442 \u0436\u0435 \u0432\u0441\u043A\u043E\u0447\u0438\u043B,
      \u0437\u0430\u0432\u0438\u0434\u0435\u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D. \u041C\u043E\u0436\u0435\u0442,
      \u043A\u0430\u0440\u0442\u0430 \u0438 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F
      \u2014 \u043D\u043E \u043D\u0430 \xAB\u043C\u043E\u0436\u0435\u0442\xBB \u043D\u0435
      \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0448\u044C \u0436\u0438\u0437\u043D\u044C
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449340
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u043A\u0430\u0440\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449341
    m_Localized: "\u0412\u044B \u0441\u0431\u0438\u043B\u0438 \u0446\u0435\u043D\u0443
      \u0432\u0434\u0432\u043E\u0435 \u0438 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u043A\u0430\u0440\u0442\u0443.
      \u041F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442 \u0441\u0442\u0430\u0440\u044B\u0439,
      \u043D\u043E \u043F\u043E\u043C\u0435\u0442\u043A\u0438 \u0441\u0432\u0435\u0436\u0438\u0435
      \u2014 \u043A\u0442\u043E-\u0442\u043E \u043F\u0440\u043E\u0448\u0451\u043B
      \u044D\u0442\u0438\u043C \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u043E\u043C
      \u043D\u0435\u0434\u0430\u0432\u043D\u043E \u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u043B
      \u043A\u0430\u0440\u0442\u0443. \u041A\u043E\u043B\u043E\u0434\u0446\u044B
      \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u044B \u0432\u0435\u0440\u043D\u043E,
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u044B \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u044E\u0442
      \u0441 \u0442\u0435\u043C, \u0447\u0442\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0438
      \u0434\u0440\u0443\u0433\u0438\u0435 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438.
      \u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446, \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u0439
      \u0445\u043E\u0442\u044F \u0431\u044B \u043C\u0430\u043B\u043E\u0439 \u0432\u044B\u0440\u0443\u0447\u043A\u043E\u0439,
      \u0442\u043A\u043D\u0443\u043B \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u0432
      \u043E\u0434\u0438\u043D \u0438\u0437 \u0437\u043D\u0430\u0447\u043A\u043E\u0432:
      \xAB\u0417\u0434\u0435\u0441\u044C \u0440\u043E\u0434\u043D\u0438\u043A \u2014
      \u0432\u043E\u0434\u0430 \u0441\u043B\u0430\u0434\u043A\u0430\u044F, \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043F\u044C\u044E\u0442 \u043E\u0445\u043E\u0442\u043D\u043E\xBB. \u041A\u0430\u0440\u0442\u0430
      \u043F\u043E\u0434\u043B\u0438\u043D\u043D\u0430\u044F \u2014 \u0438 \u0441\u0442\u043E\u0438\u0442
      \u043A\u0430\u0436\u0434\u043E\u0439 \u043C\u043E\u043D\u0435\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449342
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u043B\u0438\u0441\u044C
      \u0434\u043E\u043B\u0433\u043E, \u043D\u043E \u043F\u0440\u043E\u0434\u0430\u0432\u0435\u0446
      \u0443\u0441\u0442\u0443\u043F\u0438\u043B \u043D\u0435\u043E\u0445\u043E\u0442\u043D\u043E
      \u2014 \u0441\u043E\u0434\u0440\u0430\u043B \u043F\u043E\u0447\u0442\u0438
      \u043F\u043E\u043B\u043D\u0443\u044E \u0446\u0435\u043D\u0443. \u0410 \u043A\u0430\u0440\u0442\u0430
      \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u043A\u043E\u043F\u0438\u0435\u0439
      \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430,
      \u0434\u0430\u0432\u043D\u043E \u0437\u0430\u043D\u0435\u0441\u0451\u043D\u043D\u043E\u0433\u043E
      \u043F\u0435\u0441\u043A\u043E\u043C. \u041A\u043E\u043B\u043E\u0434\u0446\u044B
      \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u043B\u0438, \u0442\u0440\u043E\u043F\u0430
      \u043E\u0431\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044C \u0443 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430. \u0414\u0435\u043D\u044C\u0433\u0438
      \u043D\u0430 \u0432\u0435\u0442\u0435\u0440, \u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0435\u0434\u0432\u0430 \u043D\u0435 \u0441\u0432\u0435\u0440\u043D\u0443\u043B
      \u0432 \u043D\u0438\u043A\u0443\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449343
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0440\u0430\u0441\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449344
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0441 \u043F\u0440\u043E\u0434\u0430\u0432\u0446\u043E\u043C \u043D\u0430
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C: <npc_speech lang=\"Sogdian\">\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439,
      \u0434\u0440\u0443\u0433. \u042D\u0442\u0430 \u043A\u0430\u0440\u0442\u0430
      \u2014 \u0447\u044C\u044F \u0440\u0430\u0431\u043E\u0442\u0430? \u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438,
      \u043E\u0442\u043A\u0443\u0434\u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442.</npc_speech>
      \u0422\u043E\u0442 \u0432\u0437\u0434\u0440\u043E\u0433\u043D\u0443\u043B \u0438
      \u0440\u0430\u0441\u043F\u043B\u044B\u043B\u0441\u044F \u0432 \u0443\u043B\u044B\u0431\u043A\u0435.
      \u041F\u043E\u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C \u0438\u043C\u0435\u043D\u0430,
      \u0433\u043E\u0440\u043E\u0434\u0430, \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0435\u0432.
      \u0427\u0435\u0440\u0435\u0437 \u0434\u0435\u0441\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0437\u043D\u0430\u043B
      \u0432\u0441\u0451: \u043A\u0430\u0440\u0442\u0430 \u043F\u043E\u0434\u043B\u0438\u043D\u043D\u0430\u044F,
      \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u043E\u043C
      \u0438\u0437 \u0411\u0443\u0445\u0430\u0440\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043F\u0440\u043E\u0448\u0451\u043B \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u0442\u0440\u0438\u0436\u0434\u044B. \u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446
      \u2014 \u0435\u0433\u043E \u043F\u043B\u0435\u043C\u044F\u043D\u043D\u0438\u043A,
      \u043F\u0440\u043E\u0434\u0430\u0451\u0442 \u043A\u043E\u043F\u0438\u0438,
      \u0447\u0442\u043E\u0431\u044B \u043E\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0434\u044F\u0434\u0438\u043D \u0434\u043E\u043B\u0433. \xAB\u0422\u0440\u0438
      \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0445 \u2014 \u0438
      \u044F \u043F\u043E\u043A\u0430\u0436\u0443, \u0433\u0434\u0435 \u0434\u044F\u0434\u044F
      \u0441\u043F\u0440\u044F\u0442\u0430\u043B \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0439
      \u0431\u0443\u0440\u0434\u044E\u043A \u0443 \u0432\u0442\u043E\u0440\u043E\u0433\u043E
      \u043A\u043E\u043B\u043E\u0434\u0446\u0430\xBB, \u2014 \u0434\u043E\u0431\u0430\u0432\u0438\u043B
      \u043E\u043D \u0434\u043E\u0432\u0435\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E.
      \u041A\u0430\u0440\u0442\u0430 \u043A\u0443\u043F\u043B\u0435\u043D\u0430 \u0437\u0430
      \u0431\u0435\u0441\u0446\u0435\u043D\u043E\u043A, \u0430 \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u043D\u0435\u0439 \u2014 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043D\u0435\u0442 \u043D\u0438
      \u0443 \u043E\u0434\u043D\u043E\u0433\u043E \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449345
    m_Localized: "\u0421\u0431\u043E\u0440\u0449\u0438\u043A \u043D\u0430\u043B\u043E\u0433\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449346
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u2014 \u043F\u043E\u043B\u043E\u0441\u0430\u0442\u044B\u0439
      \u0448\u0430\u0442\u0451\u0440 \u0438 \u0431\u0430\u043C\u0431\u0443\u043A\u043E\u0432\u044B\u0439
      \u0448\u043B\u0430\u0433\u0431\u0430\u0443\u043C \u043F\u043E\u043F\u0435\u0440\u0451\u043A
      \u0442\u0440\u0430\u043A\u0442\u0430. \u0414\u0432\u0430 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430
      \u0441 \u043A\u043E\u043F\u044C\u044F\u043C\u0438 \u0441\u0442\u043E\u044F\u0442
      \u043F\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C, \u0437\u0430
      \u043D\u0438\u043C\u0438 \u2014 \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u0432 \u0447\u0438\u0441\u0442\u043E\u043C \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u043C
      \u0445\u0430\u043B\u0430\u0442\u0435, \u0441 \u0447\u0435\u0440\u043D\u0438\u043B\u044C\u043D\u0438\u0446\u0435\u0439
      \u043D\u0430 \u043F\u043E\u044F\u0441\u0435 \u0438 \u0441\u0432\u0438\u0442\u043A\u043E\u043C
      \u0432 \u0440\u0443\u043A\u0430\u0445. \u041E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u043B\u0430\u0434\u043E\u043D\u044C, \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044F
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D, \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0440\u0430\u0437\u043C\u0435\u0440\u0435\u043D\u043D\u043E, \u0441 \u043F\u0440\u0438\u0432\u044B\u0447\u043A\u043E\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u043C\u0435\u0435\u0442
      \u043F\u0435\u0440\u0435\u0431\u0438\u0442\u044C. \u0420\u044F\u0434\u043E\u043C
      \u043D\u0430 \u0437\u0435\u043C\u043B\u0435 \u043B\u0435\u0436\u0438\u0442
      \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u0430\u044F \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0430
      \u0441 \u043C\u043E\u043D\u0435\u0442\u0430\u043C\u0438 \u2014 \u0441\u0431\u043E\u0440\u044B
      \u0437\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F.\r\n\r\n<npc_speech
      lang=\"Persian\">\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A. \u041F\u043E
      \u0443\u043A\u0430\u0437\u0443 \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F,
      \u0434\u043E\u0440\u043E\u0436\u043D\u0430\u044F \u043F\u043E\u0448\u043B\u0438\u043D\u0430
      \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C \u0443\u043F\u043B\u0430\u0447\u0435\u043D\u0430.
      \u041E\u0434\u0438\u043D \u0434\u0438\u043D\u0430\u0440 \u0441 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0432\u044C\u044E\u043A\u0430. \u041F\u043B\u0430\u0442\u0438\u0442\u0435,
      \u0438\u043B\u0438 \u0432\u0430\u0448 \u0433\u0440\u0443\u0437 \u0431\u0443\u0434\u0435\u0442
      \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043D.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449347
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043F\u043E\u0448\u043B\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449348
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u043C\u043E\u043D\u0435\u0442
      \u043B\u0435\u0433\u043B\u0438 \u0432 \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0443.
      \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u043A\u0438\u0432\u043D\u0443\u043B,
      \u0441\u0434\u0435\u043B\u0430\u043B \u043F\u043E\u043C\u0435\u0442\u043A\u0443
      \u0432 \u0441\u0432\u0438\u0442\u043A\u0435 \u0438 \u043C\u0430\u0445\u043D\u0443\u043B
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430\u043C. \u0428\u043B\u0430\u0433\u0431\u0430\u0443\u043C
      \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F. \u0414\u043E\u0440\u043E\u0433\u043E,
      \u043D\u043E \u0431\u044B\u0441\u0442\u0440\u043E \u2014 \u0438 \u043D\u0438\u043A\u0430\u043A\u0438\u0445
      \u043E\u0441\u043B\u043E\u0436\u043D\u0435\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449349
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0437\u0430 \u0441\u043D\u0438\u0436\u0435\u043D\u0438\u0435 \u043F\u043E\u0448\u043B\u0438\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774509449350
    m_Localized: "\u0412\u044B \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0438
      \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u0431\u0443\u043C\u0430\u0433\u0438
      \u2014 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u043F\u0430\u0442\u0435\u043D\u0442,
      \u043F\u0435\u0447\u0430\u0442\u044C \u0433\u0438\u043B\u044C\u0434\u0438\u0438,
      \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0443 \u043E\u0442 \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E
      \u0441\u0431\u043E\u0440\u0449\u0438\u043A\u0430. \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u043F\u0440\u0438\u043F\u043E\u0434\u043D\u044F\u043B \u0431\u0440\u043E\u0432\u044C,
      \u043F\u0435\u0440\u0435\u0447\u0438\u0442\u0430\u043B \u043F\u0435\u0447\u0430\u0442\u044C
      \u0438 \u043A\u0438\u0432\u043D\u0443\u043B. \xAB\u0427\u0435\u0442\u044B\u0440\u0435
      \u043C\u043E\u043D\u0435\u0442\u044B \u2014 \u0434\u043B\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432
      \u0441 \u043F\u0430\u0442\u0435\u043D\u0442\u043E\u043C \u0441\u043A\u0438\u0434\u043A\u0430.\xBB
      \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438 \u043F\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u0438\u043B\u0438\u0441\u044C,
      \u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0448\u0451\u043B.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u043B\u0438\u0441\u044C
      \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C: \u0445\u043E\u0437\u044F\u0438\u043D
      \u0443\u043C\u0435\u0435\u0442 \u0441\u0447\u0438\u0442\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643520
    m_Localized: "\u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B
      \u0432\u0430\u0448\u0438 \u0434\u043E\u0432\u043E\u0434\u044B \u0441 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u043C
      \u043B\u0438\u0446\u043E\u043C, \u0437\u0430\u0442\u0435\u043C \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B
      \u0441\u0432\u0438\u0442\u043E\u043A \u0438 \u0442\u043A\u043D\u0443\u043B
      \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u0432 \u0441\u0442\u0440\u043E\u043A\u0443.
      \xAB\u041F\u043E\u043F\u044B\u0442\u043A\u0430 \u0443\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u044F
      \u2014 \u0448\u0442\u0440\u0430\u0444. \u041F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u043C\u043E\u043D\u0435\u0442, \u0438 \u0441\u043A\u0430\u0436\u0438\u0442\u0435
      \u0441\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u043D\u0435
      \u043A\u043E\u043D\u0444\u0438\u0441\u043A\u0443\u044E \u0442\u044E\u043A.\xBB
      \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438 \u043F\u043E\u0434\u0441\u0442\u0443\u043F\u0438\u043B\u0438
      \u0431\u043B\u0438\u0436\u0435, \u0440\u0443\u043A\u0438 \u043D\u0430 \u0440\u0443\u043A\u043E\u044F\u0442\u044F\u0445.
      \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u2014 \u0438 \u0442\u0435\u0440\u043F\u0435\u0442\u044C \u043D\u0430\u0441\u043C\u0435\u0448\u043B\u0438\u0432\u044B\u0439
      \u0432\u0437\u0433\u043B\u044F\u0434 \u0432 \u0441\u043F\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643521
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0434\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441 \u043A\u043E\u043D\u0432\u043E\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643522
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0441\u043F\u0435\u0448\u0438\u043B\u0441\u044F,
      \u043F\u043E\u043F\u0440\u0430\u0432\u0438\u043B \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u044C
      \u0441 \u043C\u0435\u0447\u043E\u043C \u0438 \u043F\u043E\u0434\u043E\u0448\u0451\u043B
      \u043A \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0443 \u2014 \u043D\u0435
      \u043A\u0430\u043A \u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C,
      \u0430 \u043A\u0430\u043A \u0440\u0430\u0432\u043D\u044B\u0439. \u0417\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u043F\u043E-\u0432\u043E\u0435\u043D\u043D\u043E\u043C\u0443, \u043A\u043E\u0440\u043E\u0442\u043A\u043E:
      \u043D\u0430\u0437\u0432\u0430\u043B \u0438\u043C\u044F \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0430
      \u043C\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u0433\u0430\u0440\u043D\u0438\u0437\u043E\u043D\u0430,
      \u0443\u043F\u043E\u043C\u044F\u043D\u0443\u043B \u043F\u0430\u0440\u0443 \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u044B\u0445
      \u043E\u043F\u0435\u0440\u0430\u0446\u0438\u0439 \u043F\u0440\u043E\u0442\u0438\u0432
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432. \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u043F\u0440\u0438\u0449\u0443\u0440\u0438\u043B\u0441\u044F, \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u043B\u0441\u044F
      \u0441\u043E \u0441\u0432\u043E\u0438\u043C\u0438 \u043A\u043E\u043F\u0435\u0439\u0449\u0438\u043A\u0430\u043C\u0438
      \u0438 \u043A\u0438\u0432\u043D\u0443\u043B. \xAB\u0422\u0440\u0438 \u043C\u043E\u043D\u0435\u0442\u044B
      \u2014 \u0434\u043B\u044F \u043B\u044E\u0434\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043F\u043E\u043C\u043E\u0433\u0430\u044E\u0442 \u043F\u043E\u0440\u044F\u0434\u043A\u0443.\xBB
      \u0428\u043B\u0430\u0433\u0431\u0430\u0443\u043C \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F
      \u0431\u0435\u0437 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443
      \u0438 \u043F\u043E\u0436\u0430\u043B \u043F\u043B\u0435\u0447\u0430\u043C\u0438:
      \xAB\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0430\u0445 \u0432\u0441\u0435
      \u0434\u0440\u0443\u0433 \u0434\u0440\u0443\u0433\u0430 \u0437\u043D\u0430\u044E\u0442.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643523
    m_Localized: "\u0417\u0430\u043A\u0430\u0442 \u043D\u0430\u0434 \u0441\u0442\u0435\u043F\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643524
    m_Localized: "\u041A\u043E\u0432\u044B\u043B\u044C \u0433\u043E\u0440\u0438\u0442
      \u043C\u0435\u0434\u044C\u044E, \u0442\u0435\u043D\u0438 \u043F\u043E\u0432\u043E\u0437\u043E\u043A
      \u0442\u044F\u043D\u0443\u0442\u0441\u044F \u0434\u043E \u043A\u0440\u0430\u044F
      \u0437\u0435\u043C\u043B\u0438. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0437\u0430\u043C\u043E\u043B\u043A\u0430\u044E\u0442 \u2014 \u0434\u0430\u0436\u0435
      \u0432\u043E\u043B\u044B \u0437\u0430\u043C\u0435\u0434\u043B\u044F\u044E\u0442
      \u0448\u0430\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643525
    m_Localized: "\u041E\u0431\u043B\u0430\u043A\u043E \u043F\u044B\u043B\u0438 \u043D\u0430
      \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643526
    m_Localized: "\u0411\u0443\u0440\u043E\u0435 \u043E\u0431\u043B\u0430\u043A\u043E
      \u043F\u044B\u043B\u0438 \u043F\u043E\u043B\u0437\u0451\u0442 \u043F\u043E
      \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0443 \u2014 \u043A\u0442\u043E
      \u0442\u0430\u043C? \u0410\u0440\u043C\u0438\u044F, \u0441\u0430\u0439\u0433\u0430\u043A\u0438,
      \u0447\u0443\u0436\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C. \u041C\u0430\u0440\u0435\u0432\u043E \u0443\u043D\u0435\u0441\u043B\u043E
      \u043E\u0442\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643527
    m_Localized: "\u041F\u0430\u0441\u0442\u0443\u0445 \u0441\u043E \u0441\u0442\u0430\u0434\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643528
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u043F\u0430\u0441\u0442\u0443\u0445
      \u0441\u0432\u0438\u0441\u0442\u0438\u0442 \u0441\u043E\u0431\u0430\u043A\u0430\u043C,
      \u0441\u0442\u0430\u0434\u043E \u0440\u0430\u0441\u0441\u0442\u0443\u043F\u0430\u0435\u0442\u0441\u044F.
      \u041E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0440\u0443\u043A\u0443
      \u2014 \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u043E\u0435 \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435.
      \u0417\u043D\u0430\u0447\u0438\u0442, \u0440\u044F\u0434\u043E\u043C \u0436\u0438\u043B\u044C\u0451
      \u0438 \u0432\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643529
    m_Localized: "\u0417\u0432\u0451\u0437\u0434\u043D\u043E\u0435 \u043D\u0435\u0431\u043E
      \u043F\u0443\u0441\u0442\u044B\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643530
    m_Localized: "\u041C\u043B\u0435\u0447\u043D\u044B\u0439 \u041F\u0443\u0442\u044C
      \u043B\u043E\u0436\u0438\u0442\u0441\u044F \u0447\u0435\u0440\u0435\u0437 \u0437\u0435\u043D\u0438\u0442
      \u0431\u0435\u043B\u0451\u0441\u043E\u0439 \u0440\u0435\u043A\u043E\u0439.
      \u0422\u0438\u0448\u0438\u043D\u0430 \u0442\u0430\u043A\u0430\u044F, \u0447\u0442\u043E
      \u0441\u043B\u044B\u0448\u043D\u043E \u0434\u044B\u0445\u0430\u043D\u0438\u0435
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432 \u2014 \u0435\u0441\u0442\u044C
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0431\u043E, \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u0435
      \u0438 \u0431\u043B\u0438\u0437\u043A\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643531
    m_Localized: "\u041C\u0438\u0440\u0430\u0436 \u0433\u043E\u0440\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643532
    m_Localized: "\u0412 \u043C\u0430\u0440\u0435\u0432\u0435 \u043D\u0430\u0434
      \u0440\u0430\u0441\u043A\u0430\u043B\u0451\u043D\u043D\u043E\u0439 \u0440\u0430\u0432\u043D\u0438\u043D\u043E\u0439
      \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u0430\u044E\u0442 \u0431\u0430\u0448\u043D\u0438
      \u0438 \u043A\u0443\u043F\u043E\u043B\u0430. \u0412\u0438\u0434\u0435\u043D\u0438\u0435
      \u0442\u0430\u0435\u0442, \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044F
      \u0433\u043E\u0440\u0435\u0447\u044C \u2014 \u043F\u0443\u0441\u0442\u044B\u043D\u044F
      \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442: \u0442\u043E,
      \u0447\u0442\u043E \u0432\u0438\u0434\u0438\u0448\u044C, \u043D\u0435 \u0432\u0441\u0435\u0433\u0434\u0430
      \u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643533
    m_Localized: "\u041E\u0440\u0451\u043B \u043D\u0430\u0434 \u0443\u0449\u0435\u043B\u044C\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643534
    m_Localized: "\u0411\u0435\u0440\u043A\u0443\u0442 \u0432\u0438\u0441\u0438\u0442
      \u043D\u0430\u0434 \u0443\u0449\u0435\u043B\u044C\u0435\u043C \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E,
      \u043A\u0430\u043A \u0432\u044B\u0440\u0435\u0437\u0430\u043D\u043D\u044B\u0439
      \u0438\u0437 \u0442\u0451\u043C\u043D\u043E\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u0430
      \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0433\u043E\u043B\u043E\u0432\u0430
      \u0441\u043B\u0435\u0434\u0438\u0442 \u0437\u0430 \u043F\u0443\u0442\u043D\u0438\u043A\u0430\u043C\u0438.
      \u0414\u043E\u0431\u0440\u044B\u0439 \u0437\u043D\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643535
    m_Localized: "\u041C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u0444\u043B\u0430\u0433\u0438 \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643536
    m_Localized: "\u041D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435 \u0444\u043B\u0430\u0433\u0438
      \u0441 \u043C\u0430\u043D\u0442\u0440\u0430\u043C\u0438 \u0442\u0440\u0435\u043F\u0435\u0449\u0443\u0442
      \u043A\u0430\u043A \u0436\u0438\u0432\u044B\u0435 \u2014 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u0435,
      \u043F\u043E\u043B\u0443\u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0435,
      \u043F\u043E\u0432\u0435\u0448\u0435\u043D\u043D\u044B\u0435 \u043A\u0435\u043C-\u0442\u043E
      \u0437\u0430\u0434\u043E\u043B\u0433\u043E \u0434\u043E \u043D\u0430\u0441.
      \u0414\u0430\u0436\u0435 \u044F\u043A\u0438 \u0441\u0442\u0443\u043F\u0430\u044E\u0442
      \u043C\u044F\u0433\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643537
    m_Localized: "\u041B\u0435\u0434\u044F\u043D\u043E\u0439 \u0432\u0435\u0442\u0435\u0440
      \u0441 \u0432\u0435\u0440\u0448\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643538
    m_Localized: "\u041B\u0435\u0434\u044F\u043D\u043E\u0439 \u0432\u0435\u0442\u0435\u0440
      \u0441 \u0432\u0435\u0440\u0448\u0438\u043D \u0431\u044C\u0451\u0442 \u0432
      \u043B\u0438\u0446\u043E \u0441\u043D\u0435\u0436\u043D\u043E\u0439 \u043A\u0440\u0443\u043F\u043E\u0439.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0441\u0443\u0442\u0443\u043B\u044F\u0442\u0441\u044F,
      \u044F\u043A\u0438 \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E\u0442
      \u043C\u043E\u0440\u0434\u044B \u2014 \u0437\u0434\u0435\u0441\u044C \u043D\u0435
      \u043C\u0435\u0441\u0442\u043E \u0434\u043B\u044F \u043F\u0440\u0438\u0432\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643539
    m_Localized: "\u041F\u0435\u0441\u043D\u044F \u0443 \u043A\u043E\u0441\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643540
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0437\u0430\u0442\u044F\u043D\u0443\u043B \u043F\u0435\u0441\u043D\u044E \u043D\u0430
      \u043F\u043E\u043B\u0443\u0437\u0430\u0431\u044B\u0442\u043E\u043C \u0434\u0438\u0430\u043B\u0435\u043A\u0442\u0435.
      \u0418\u0441\u043A\u0440\u044B \u043B\u0435\u0442\u044F\u0442 \u0432 \u0442\u0451\u043C\u043D\u043E\u0435
      \u043D\u0435\u0431\u043E \u2014 \u043C\u0438\u043D\u0443\u0442\u0443 \u043D\u0430\u0437\u0430\u0434
      \u0432\u0441\u0435 \u0431\u044B\u043B\u0438 \u0447\u0443\u0436\u0438\u043C\u0438,
      \u0442\u0435\u043F\u0435\u0440\u044C \u043E\u0434\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643541
    m_Localized: "\u0421\u043A\u0440\u0438\u043F\u044F\u0449\u0435\u0435 \u043A\u043E\u043B\u0435\u0441\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643542
    m_Localized: "\u0417\u0430\u0434\u043D\u0435\u0435 \u043A\u043E\u043B\u0435\u0441\u043E
      \u0441\u043A\u0440\u0438\u043F\u0438\u0442 \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C
      \u043E\u0431\u043E\u0440\u043E\u0442\u0435 \u2014 \u043C\u043E\u043D\u043E\u0442\u043E\u043D\u043D\u043E,
      \u0437\u0430\u043D\u0443\u0434\u043D\u043E. \u0414\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043F\u043E\u043A\u0430. \u041F\u043E\u0447\u0438\u043D\u0438\u043C \u043D\u0430
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u043F\u0440\u0438\u0432\u0430\u043B\u0435,
      \u0435\u0441\u043B\u0438 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643543
    m_Localized: "\u0413\u043E\u043B\u043E\u0434 \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643544
    m_Localized: "\u041F\u044F\u0442\u044B\u0439 \u0434\u0435\u043D\u044C \u043D\u0430
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043D\u044B\u0445 \u043F\u043E\u0440\u0446\u0438\u044F\u0445.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0436\u0443\u044E\u0442
      \u0441\u0443\u0445\u0443\u044E \u043A\u043E\u0440\u0443 \u0438 \u043F\u044C\u044E\u0442
      \u043C\u0443\u0442\u043D\u0443\u044E \u0432\u043E\u0434\u0443 \u0438\u0437
      \u043F\u0440\u0438\u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0445 \u043B\u0443\u0436.
      \u0412\u044C\u044E\u0447\u043D\u044B\u0439 \u0431\u044B\u043A \u0448\u0430\u0442\u0430\u0435\u0442\u0441\u044F,
      \u0440\u0451\u0431\u0440\u0430 \u0442\u043E\u0440\u0447\u0430\u0442 \u043A\u0430\u043A
      \u043E\u0431\u0440\u0443\u0447\u0438 \u0431\u043E\u0447\u043A\u0438, \u0438\u0437
      \u043D\u043E\u0437\u0434\u0440\u0435\u0439 \u0438\u0434\u0451\u0442 \u0440\u043E\u0437\u043E\u0432\u0430\u0442\u0430\u044F
      \u043F\u0435\u043D\u0430. \u0414\u0432\u043E\u0435 \u043D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u043E\u0432
      \u0441\u0432\u0430\u043B\u0438\u043B\u0438\u0441\u044C \u043D\u0430 \u043E\u0431\u043E\u0447\u0438\u043D\u0435
      \u2014 \u0443 \u043D\u0438\u0445 \u043D\u0435\u0442 \u0441\u0438\u043B \u043D\u0435\u0441\u0442\u0438
      \u0442\u044E\u043A\u0438. \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0442\u0438\u0445\u043E, \u0431\u0435\u0437 \u0437\u043B\u043E\u0441\u0442\u0438:
      \u043D\u0443\u0436\u043D\u043E \u0440\u0435\u0448\u0430\u0442\u044C \u0441\u0435\u0439\u0447\u0430\u0441,
      \u0438\u043B\u0438 \u0437\u0430\u0432\u0442\u0440\u0430 \u0440\u0435\u0448\u0430\u0442\u044C
      \u0431\u0443\u0434\u0435\u0442 \u043D\u0435\u043A\u043E\u043C\u0443. \u041C\u043E\u0436\u043D\u043E
      \u0437\u0430\u0431\u0438\u0442\u044C \u043E\u0441\u043B\u0430\u0431\u0435\u0432\u0448\u0435\u0433\u043E
      \u0431\u044B\u043A\u0430, \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u0441\u043B\u0430\u0442\u044C
      \u043B\u044E\u0434\u0435\u0439 \u043D\u0430 \u043E\u0445\u043E\u0442\u0443,
      \u0430 \u043C\u043E\u0436\u043D\u043E \u0443\u0440\u0435\u0437\u0430\u0442\u044C
      \u043F\u043E\u0440\u0446\u0438\u0438 \u0434\u043E \u0433\u043E\u0440\u0441\u0442\u0438
      \u043C\u0443\u043A\u0438 \u0432 \u0434\u0435\u043D\u044C \u0438 \u043A\u043E\u0432\u044B\u043B\u044F\u0442\u044C
      \u0434\u043E \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643545
    m_Localized: "\u0417\u0430\u0431\u0438\u0442\u044C \u043E\u0441\u043B\u0430\u0431\u0435\u0432\u0448\u0435\u0433\u043E
      \u0431\u044B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643546
    m_Localized: "\u041D\u043E\u0436 \u043F\u0440\u043E\u0448\u0451\u043B \u0431\u044B\u0441\u0442\u0440\u043E
      \u2014 \u0441\u0442\u0430\u0440\u044B\u0439 \u0431\u044B\u043A \u0434\u0430\u0436\u0435
      \u043D\u0435 \u0434\u0451\u0440\u043D\u0443\u043B\u0441\u044F. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0440\u0430\u0437\u0434\u0435\u043B\u0430\u043B\u0438 \u0442\u0443\u0448\u0443
      \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435,
      \u0440\u0430\u0437\u0432\u0435\u043B\u0438 \u043E\u0433\u043E\u043D\u044C \u0438\u0437
      \u043E\u0431\u043B\u043E\u043C\u043A\u043E\u0432 \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0433\u043E
      \u0434\u044B\u0448\u043B\u0430. \u041C\u044F\u0441\u043E \u0436\u0451\u0441\u0442\u043A\u043E\u0435,
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0431\u043E\u043B\u0435\u0437\u043D\u044C\u044E,
      \u043D\u043E \u043B\u044E\u0434\u0438 \u0435\u0434\u044F\u0442 \u0436\u0430\u0434\u043D\u043E,
      \u043E\u0431\u0436\u0438\u0433\u0430\u044F \u043F\u0430\u043B\u044C\u0446\u044B.
      \u041D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439
      \u0445\u0432\u0430\u0442\u0438\u0442. \u041D\u043E \u0442\u044F\u043D\u0443\u0442\u044C
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443 \u0442\u0435\u043F\u0435\u0440\u044C
      \u043D\u0435\u043A\u043E\u043C\u0443 \u2014 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u0442\u044C \u0443\u043F\u0440\u044F\u0436\u044C,
      \u0438 \u0442\u0435\u043B\u0435\u0433\u0430 \u0441\u043A\u0440\u0438\u043F\u0438\u0442
      \u043F\u043E\u0434 \u043F\u0435\u0440\u0435\u043A\u043E\u0441\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643547
    m_Localized: "\u041F\u043E\u0441\u043B\u0430\u0442\u044C \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432
      \u0432 \u0441\u0442\u0435\u043F\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643548
    m_Localized: "\u0422\u0440\u043E\u0435 \u0443\u0448\u043B\u0438 \u043D\u0430
      \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u0441 \u043B\u0443\u043A\u0430\u043C\u0438
      \u0438 \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u043C\u0438. \u041A \u043F\u043E\u043B\u0443\u0434\u043D\u044E
      \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u2014 \u0434\u0432\u043E\u0435
      \u043D\u0435\u0441\u0443\u0442 \u043D\u0430 \u0436\u0435\u0440\u0434\u0438
      \u0442\u0443\u0448\u0443 \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0430\u043D\u0442\u0438\u043B\u043E\u043F\u044B,
      \u0442\u0440\u0435\u0442\u0438\u0439 \u0442\u0430\u0449\u0438\u0442 \u043C\u0435\u0448\u043E\u043A
      \u0441 \u043A\u043E\u0440\u0435\u043D\u044C\u044F\u043C\u0438 \u0438 \u0434\u0438\u043A\u0438\u043C
      \u043B\u0443\u043A\u043E\u043C. \u0412\u0435\u0447\u0435\u0440\u043E\u043C
      \u043D\u0430\u0434 \u043B\u0430\u0433\u0435\u0440\u0435\u043C \u0432\u043F\u0435\u0440\u0432\u044B\u0435
      \u0437\u0430 \u043D\u0435\u0434\u0435\u043B\u044E \u0441\u0442\u043E\u0438\u0442
      \u0437\u0430\u043F\u0430\u0445 \u0436\u0430\u0440\u043A\u043E\u0433\u043E.
      \u041B\u044E\u0434\u0438 \u043E\u0436\u0438\u0432\u0430\u044E\u0442. \u041C\u044F\u0441\u043E
      \u0437\u0430\u0432\u044F\u043B\u0438\u043B\u0438 \u0432\u043F\u0440\u043E\u043A
      \u2014 \u0445\u0432\u0430\u0442\u0438\u0442 \u0435\u0449\u0451 \u043D\u0430
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643549
    m_Localized: "\u041E\u0445\u043E\u0442\u043D\u0438\u043A\u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u0437\u0430\u0442\u0435\u043C\u043D\u043E \u0441 \u043F\u0443\u0441\u0442\u044B\u043C\u0438
      \u0440\u0443\u043A\u0430\u043C\u0438 \u2014 \u043E\u0434\u0438\u043D \u0445\u0440\u043E\u043C\u0430\u0435\u0442,
      \u0432\u0442\u043E\u0440\u043E\u0439 \u043C\u043E\u043B\u0447\u0438\u0442,
      \u0442\u0440\u0435\u0442\u0438\u0439 \u0441\u043F\u043B\u0451\u0432\u044B\u0432\u0430\u0435\u0442
      \u043A\u0440\u043E\u0432\u044C\u044E. \u041D\u0430\u0440\u0432\u0430\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0432\u043E\u043B\u0447\u044C\u044E \u043D\u043E\u0440\u0443
      \u0438 \u0435\u043B\u0435 \u0443\u043D\u0435\u0441\u043B\u0438 \u043D\u043E\u0433\u0438.
      \u041B\u044E\u0434\u0438 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438
      \u0438\u0445 \u0442\u0438\u0448\u0438\u043D\u043E\u0439, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u0445\u0443\u0436\u0435 \u043A\u0440\u0438\u043A\u0430. \u0423\u0442\u0440\u043E\u043C
      \u0434\u0432\u043E\u0435 \u043D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u043E\u0432
      \u0438\u0441\u0447\u0435\u0437\u043B\u0438, \u043F\u0440\u0438\u0445\u0432\u0430\u0442\u0438\u0432
      \u0431\u0443\u0440\u0434\u044E\u043A \u0432\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643550
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0433\u043E\u0442\u043E\u0432\u0438\u0442
      \u043E\u0442\u0432\u0430\u0440 \u0438\u0437 \u0442\u0440\u0430\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643551
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u0431\u043E\u0448\u0451\u043B
      \u043E\u0431\u043E\u0447\u0438\u043D\u0443, \u0441\u043E\u0431\u0438\u0440\u0430\u044F
      \u0442\u043E, \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u043B\u0438: \u0449\u0430\u0432\u0435\u043B\u044C,
      \u043A\u043E\u0440\u043D\u0438 \u043B\u043E\u043F\u0443\u0445\u0430, \u0441\u0442\u0435\u0431\u043B\u0438
      \u0434\u0438\u043A\u043E\u0433\u043E \u0447\u0435\u0441\u043D\u043E\u043A\u0430,
      \u0433\u043E\u0440\u0441\u0442\u044C \u044F\u0447\u043C\u0435\u043D\u043D\u044B\u0445
      \u0437\u0451\u0440\u0435\u043D, \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0432\u0448\u0438\u0445\u0441\u044F
      \u0438\u0437 \u0447\u0443\u0436\u043E\u0433\u043E \u043C\u0435\u0448\u043A\u0430
      \u043D\u0430 \u0442\u0440\u043E\u043F\u0435. \u0412\u0435\u0447\u0435\u0440\u043E\u043C
      \u043D\u0430\u0434 \u043A\u043E\u0441\u0442\u0440\u043E\u043C \u043A\u0438\u043F\u0438\u0442
      \u0433\u0443\u0441\u0442\u043E\u0439 \u043E\u0442\u0432\u0430\u0440 \u2014
      \u0433\u043E\u0440\u044C\u043A\u0438\u0439, \u043D\u043E \u0441\u044B\u0442\u043D\u044B\u0439.
      \u041B\u0435\u043A\u0430\u0440\u044C \u0434\u043E\u0431\u0430\u0432\u0438\u043B
      \u0442\u043E\u043B\u0447\u0451\u043D\u044B\u0439 \u043A\u043E\u0440\u0435\u043D\u044C,
      \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043B\u044E\u0434\u0438
      \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043B\u0438 \u0434\u0440\u043E\u0436\u0430\u0442\u044C.
      \xAB\u042D\u0442\u043E \u043D\u0435 \u0435\u0434\u0430, \u2014 \u0441\u043A\u0430\u0437\u0430\u043B
      \u043E\u043D \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E, \u2014 \u044D\u0442\u043E
      \u0432\u0440\u0435\u043C\u044F. \u0414\u0432\u0430 \u0434\u043D\u044F. \u0425\u0432\u0430\u0442\u0438\u0442,
      \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u0439\u0442\u0438.\xBB \u041E\u0441\u0442\u0430\u0442\u043A\u0438
      \u043C\u044F\u0441\u0430, \u0441\u043D\u044F\u0442\u043E\u0433\u043E \u0441
      \u043A\u043E\u0441\u0442\u0435\u0439 \u0431\u044B\u043A\u0430, \u043E\u043D
      \u0437\u0430\u0441\u043E\u043B\u0438\u043B \u0438 \u0437\u0430\u0432\u0435\u0440\u043D\u0443\u043B
      \u0432 \u0442\u0440\u044F\u043F\u0438\u0446\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643552
    m_Localized: "\u041C\u044F\u0442\u0435\u0436 \u043D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643553
    m_Localized: "\u041A\u0440\u0438\u043A \u0440\u0430\u0437\u043E\u0440\u0432\u0430\u043B
      \u0443\u0442\u0440\u0435\u043D\u043D\u044E\u044E \u0442\u0438\u0448\u0438\u043D\u0443.
      \u041D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0438 \u043F\u043E\u0431\u0440\u043E\u0441\u0430\u043B\u0438
      \u0442\u044E\u043A\u0438 \u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u0434\u043E\u0440\u043E\u0433\u0438
      \u0438 \u0441\u0442\u043E\u044F\u0442 \u0441\u0442\u0435\u043D\u043E\u0439
      \u2014 \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0441 \u043F\u0430\u043B\u043A\u0430\u043C\u0438, \u0433\u0440\u0443\u0437\u043E\u0432\u044B\u043C\u0438
      \u043A\u0440\u044E\u043A\u0430\u043C\u0438 \u0438 \u043A\u043E\u043B\u044C\u044F\u043C\u0438
      \u043E\u0442 \u043F\u0430\u043B\u0430\u0442\u043A\u0438. \u0412\u043F\u0435\u0440\u0435\u0434\u0438
      \u2014 \u043A\u0440\u044F\u0436\u0438\u0441\u0442\u044B\u0439 \u043C\u0443\u0436\u0447\u0438\u043D\u0430
      \u0441 \u0431\u0430\u0433\u0440\u043E\u0432\u044B\u043C \u0448\u0440\u0430\u043C\u043E\u043C
      \u0447\u0435\u0440\u0435\u0437 \u0441\u043A\u0443\u043B\u0443, \u0431\u044B\u0432\u0448\u0438\u0439
      \u0441\u043E\u043B\u0434\u0430\u0442. \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0437\u0430 \u0432\u0441\u0435\u0445: \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u0435
      \u043D\u0435 \u043F\u043B\u0430\u0442\u0438\u043B\u0438 \u0434\u0432\u0430
      \u043C\u0435\u0441\u044F\u0446\u0430, \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u0433\u043D\u0438\u043B\u044B\u0435, \u0430 \u0445\u043E\u0437\u044F\u0438\u043D
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0440\u0430\u0437\u044A\u0435\u0437\u0436\u0430\u0435\u0442
      \u043D\u0430 \u043C\u044F\u0433\u043A\u0438\u0445 \u043F\u043E\u0434\u0443\u0448\u043A\u0430\u0445.
      \u041E\u043D\u0438 \u0442\u0440\u0435\u0431\u0443\u044E\u0442 \u0434\u0432\u043E\u0439\u043D\u0443\u044E
      \u043E\u043F\u043B\u0430\u0442\u0443 \u2014 \u043F\u0440\u044F\u043C\u043E
      \u0441\u0435\u0439\u0447\u0430\u0441, \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C
      \u043D\u0430 \u043B\u0430\u0434\u043E\u043D\u044C. \u0418\u043D\u0430\u0447\u0435
      \u0431\u0440\u043E\u0441\u044F\u0442 \u0433\u0440\u0443\u0437 \u043D\u0430
      \u0434\u043E\u0440\u043E\u0433\u0435 \u0438 \u0443\u0439\u0434\u0443\u0442.
      \u0417\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 \u0437\u0430\u0447\u0438\u043D\u0449\u0438\u043A\u0430
      \u043A\u0442\u043E-\u0442\u043E \u0434\u043E\u0441\u0442\u0430\u043B \u043D\u043E\u0436.\r\n\r\n<npc_speech
      lang=\"Arabic\">\u042D\u0439, \u0445\u043E\u0437\u044F\u0438\u043D \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430!
      \u041C\u044B \u043D\u0435 \u0440\u0430\u0431\u044B! \u041E\u0442\u0434\u0430\u0439
      \u043D\u0430\u043C \u043D\u0430\u0448\u0438 \u043F\u0440\u0430\u0432\u0430,
      \u0438\u043B\u0438 \u043C\u044B \u0431\u0440\u043E\u0441\u0438\u043C \u0432\u0441\u0451
      \u0437\u0434\u0435\u0441\u044C \u0438 \u0443\u0439\u0434\u0451\u043C!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643554
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643555
    m_Localized: "\u0412\u044B \u0440\u0430\u0437\u0432\u044F\u0437\u0430\u043B\u0438
      \u043A\u043E\u0448\u0435\u043B\u044C \u0438 \u043E\u0442\u0441\u0447\u0438\u0442\u0430\u043B\u0438
      \u043C\u043E\u043D\u0435\u0442\u044B \u2014 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E,
      \u043D\u0430 \u0432\u0438\u0434\u0443 \u0443 \u0432\u0441\u0435\u0445. \u0421\u0435\u0440\u0435\u0431\u0440\u043E
      \u0437\u0432\u0435\u043D\u0435\u043B\u043E \u043E \u043B\u0430\u0434\u043E\u043D\u0438,
      \u0438 \u0441 \u043A\u0430\u0436\u0434\u043E\u0439 \u043C\u043E\u043D\u0435\u0442\u043E\u0439
      \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u0442\u0430\u044F\u043B\u043E.
      \u0417\u0430\u0447\u0438\u043D\u0449\u0438\u043A \u0441\u0433\u0440\u0451\u0431
      \u0434\u0435\u043D\u044C\u0433\u0438, \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043B,
      \u043A\u0438\u0432\u043D\u0443\u043B. \u041D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0438
      \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043B\u0438 \u0442\u044E\u043A\u0438
      \u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u043D\u0430
      \u043C\u0435\u0441\u0442\u0430. \u041C\u044F\u0442\u0435\u0436 \u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F
      \u2014 \u043D\u043E \u043A\u043E\u0448\u0435\u043B\u044C \u043F\u043E\u043B\u0435\u0433\u0447\u0430\u043B
      \u0432\u0434\u0432\u043E\u0435, \u0430 \u0432 \u0433\u043B\u0430\u0437\u0430\u0445
      \u0431\u044B\u0432\u0448\u0435\u0433\u043E \u0441\u043E\u043B\u0434\u0430\u0442\u0430
      \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u0435
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043F\u043E\u043D\u044F\u0432\u0448\u0435\u0433\u043E
      \u0441\u0432\u043E\u044E \u0441\u0438\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643556
    m_Localized: "\u0423\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0438 \u043F\u0440\u0438\u0441\u0442\u044B\u0434\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643557
    m_Localized: "\u0412\u044B \u043D\u0435 \u0441\u0442\u0430\u043B\u0438 \u043A\u0440\u0438\u0447\u0430\u0442\u044C.
      \u041F\u043E\u0434\u043E\u0448\u043B\u0438 \u043A \u0437\u0430\u0447\u0438\u043D\u0449\u0438\u043A\u0443,
      \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u0432 \u0433\u043B\u0430\u0437\u0430
      \u0438 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438 \u0442\u0438\u0445\u043E
      \u2014 \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B \u0441\u043B\u044B\u0448\u0430\u043B\u0438
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0432\u044B\u0435 \u0440\u044F\u0434\u044B.
      \u041E \u0434\u043E\u0440\u043E\u0433\u0435, \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043D\u043E\u0439
      \u0432\u043C\u0435\u0441\u0442\u0435. \u041E \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0430\u0445,
      \u0447\u0442\u043E \u043D\u0435 \u0434\u043E\u0448\u043B\u0438. \u041E \u0433\u043E\u0440\u043E\u0434\u0435
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438, \u0433\u0434\u0435 \u0436\u0434\u0443\u0442
      \u0440\u044B\u043D\u043A\u0438 \u0438 \u0433\u043E\u0440\u044F\u0447\u0430\u044F
      \u0435\u0434\u0430. \u041F\u043E\u0442\u043E\u043C \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u043A \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C: \xAB\u041A\u0442\u043E
      \u0438\u0437 \u0432\u0430\u0441 \u0445\u043E\u0447\u0435\u0442 \u0431\u0440\u043E\u0441\u0438\u0442\u044C
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0437\u0430 \u0434\u0432\u0430
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430 \u0434\u043E \u0431\u0430\u0437\u0430\u0440\u0430?\xBB
      \u041C\u043E\u043B\u0447\u0430\u043D\u0438\u0435. \u0417\u0430\u0447\u0438\u043D\u0449\u0438\u043A
      \u043E\u043F\u0443\u0441\u0442\u0438\u043B \u043A\u0440\u044E\u043A. \u041D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A
      \u0441 \u043D\u043E\u0436\u043E\u043C \u0441\u043F\u0440\u044F\u0442\u0430\u043B
      \u0435\u0433\u043E \u043E\u0431\u0440\u0430\u0442\u043D\u043E. \u041B\u044E\u0434\u0438
      \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C \u2014 \u043C\u043E\u043B\u0447\u0430,
      \u043D\u043E \u0431\u0435\u0437 \u043D\u0435\u043D\u0430\u0432\u0438\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643558
    m_Localized: "\u0421\u043B\u043E\u0432\u0430 \u0443\u0432\u044F\u0437\u043B\u0438
      \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435, \u043A\u0430\u043A \u043A\u0430\u043C\u043D\u0438
      \u0432 \u0431\u043E\u043B\u043E\u0442\u0435. \u0417\u0430\u0447\u0438\u043D\u0449\u0438\u043A
      \u0440\u0430\u0441\u0445\u043E\u0445\u043E\u0442\u0430\u043B\u0441\u044F: \xAB\u041A\u0440\u0430\u0441\u0438\u0432\u043E
      \u0433\u043E\u0432\u043E\u0440\u0438\u0448\u044C, \u0445\u043E\u0437\u044F\u0438\u043D.
      \u0410 \u043C\u044B \u0436\u0440\u0430\u0442\u044C \u0431\u0443\u0434\u0435\u043C
      \u0442\u0432\u043E\u0438 \u0440\u0435\u0447\u0438?\xBB \u0422\u043E\u043B\u043F\u0430
      \u043A\u0430\u0447\u043D\u0443\u043B\u0430\u0441\u044C \u0432\u043F\u0435\u0440\u0451\u0434.
      \u041A\u0442\u043E-\u0442\u043E \u0432\u0441\u043F\u043E\u0440\u043E\u043B
      \u0442\u044E\u043A \u043D\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0435
      \u0438 \u0432\u044B\u0442\u0440\u044F\u0445\u043D\u0443\u043B \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443. \u041F\u043E\u043A\u0430
      \u0432\u044B \u043F\u044B\u0442\u0430\u043B\u0438\u0441\u044C \u043D\u0430\u0432\u0435\u0441\u0442\u0438
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A, \u0442\u0440\u043E\u0435 \u0443\u0448\u043B\u0438,
      \u043F\u0440\u0438\u0445\u0432\u0430\u0442\u0438\u0432 \u043C\u0435\u0448\u043E\u043A
      \u0441 \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0435\u0439 \u0438 \u043E\u0434\u0438\u043D
      \u0438\u0437 \u0442\u044E\u043A\u043E\u0432. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u043D\u0430 \u043C\u0435\u0441\u0442\u0430
      \u2014 \u043D\u043E \u0434\u043E\u0432\u0435\u0440\u0438\u044F \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643559
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0432\u0441\u0442\u0430\u0451\u0442
      \u0440\u044F\u0434\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643560
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043D\u0435 \u0441\u0442\u0430\u043B
      \u0436\u0434\u0430\u0442\u044C \u043F\u0440\u0438\u043A\u0430\u0437\u0430.
      \u0412\u044B\u0448\u0435\u043B \u0432\u043F\u0435\u0440\u0451\u0434, \u0432\u0441\u0442\u0430\u043B
      \u0440\u044F\u0434\u043E\u043C \u0441 \u0432\u0430\u043C\u0438 \u2014 \u043C\u043E\u043B\u0447\u0430,
      \u043D\u0435 \u043A\u0430\u0441\u0430\u044F\u0441\u044C \u043E\u0440\u0443\u0436\u0438\u044F.
      \u041F\u0440\u043E\u0441\u0442\u043E \u0432\u0441\u0442\u0430\u043B. \u0411\u044B\u0432\u0448\u0438\u0439
      \u0441\u043E\u043B\u0434\u0430\u0442 \u0443\u0437\u043D\u0430\u043B \u043F\u043E\u0432\u0430\u0434\u043A\u0443
      \u2014 \u0441\u043B\u0443\u0436\u0438\u0432\u044B\u0439 \u043F\u0440\u043E\u0442\u0438\u0432
      \u0441\u043B\u0443\u0436\u0438\u0432\u043E\u0433\u043E. \u041E\u043D\u0438
      \u043C\u0435\u0440\u044F\u043B\u0438\u0441\u044C \u0432\u0437\u0433\u043B\u044F\u0434\u0430\u043C\u0438
      \u0434\u0435\u0441\u044F\u0442\u044C \u0443\u0434\u0430\u0440\u043E\u0432 \u0441\u0435\u0440\u0434\u0446\u0430.
      \u041F\u043E\u0442\u043E\u043C \u0437\u0430\u0447\u0438\u043D\u0449\u0438\u043A
      \u0441\u043F\u043B\u044E\u043D\u0443\u043B \u0438 \u0431\u0443\u0440\u043A\u043D\u0443\u043B:
      \xAB\u041B\u0430\u0434\u043D\u043E. \u041D\u043E \u0432 \u0433\u043E\u0440\u043E\u0434\u0435
      \u2014 \u0440\u0430\u0441\u0447\u0451\u0442. \u041F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E.\xBB
      \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043A\u0438\u0432\u043D\u0443\u043B.
      \u041D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0438 \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043B\u0438
      \u0442\u044E\u043A\u0438. \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043B
      \u043B\u0438\u0446\u0430 \u2014 \u0430 \u044D\u0442\u043E \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435
      \u0434\u043E\u0440\u043E\u0436\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643561
    m_Localized: "\u0421\u043B\u0443\u0445\u0438 \u043E \u0447\u0443\u043C\u0435
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643562
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u043D\u044B\u0439 \u043F\u0443\u0442\u043D\u0438\u043A
      \u2014 \u043E\u0431\u043E\u0440\u0432\u0430\u043D\u043D\u044B\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043C\u0443\u043B\u043E\u0432 \u0441 \u0431\u0435\u0437\u0443\u043C\u043D\u044B\u043C\u0438
      \u0433\u043B\u0430\u0437\u0430\u043C\u0438 \u2014 \u043A\u0440\u0438\u0447\u0438\u0442,
      \u0440\u0430\u0437\u043C\u0430\u0445\u0438\u0432\u0430\u044F \u0440\u0443\u043A\u0430\u043C\u0438:
      \u0433\u043E\u0440\u043E\u0434 \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u0437\u0430\u043A\u0440\u044B\u0442.
      \u0427\u0443\u043C\u0430. \u0422\u0440\u0443\u043F\u044B \u043B\u0435\u0436\u0430\u0442
      \u043D\u0430 \u0443\u043B\u0438\u0446\u0430\u0445, \u0432\u043E\u0440\u043E\u0442\u0430
      \u0437\u0430\u043A\u043E\u043B\u043E\u0447\u0435\u043D\u044B \u0438\u0437\u043D\u0443\u0442\u0440\u0438,
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438 \u0441\u0442\u0440\u0435\u043B\u044F\u044E\u0442
      \u0432 \u043A\u0430\u0436\u0434\u043E\u0433\u043E, \u043A\u0442\u043E \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0435\u0442\u0441\u044F.
      \u041F\u0440\u0430\u0432\u0434\u0430 \u044D\u0442\u043E \u0438\u043B\u0438
      \u043F\u0430\u043D\u0438\u043A\u0430 \u2014 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E,
      \u043D\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0443\u0436\u0435 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u0432\u043F\u0435\u0440\u0451\u0434 \u0432\u0435\u0434\u0451\u0442
      \u043F\u0440\u044F\u043C\u043E \u043A \u0437\u0430\u043F\u0435\u0440\u0442\u044B\u043C
      \u0432\u043E\u0440\u043E\u0442\u0430\u043C. \u041E\u0431\u044A\u0435\u0437\u0434
      \u0437\u0430\u0439\u043C\u0451\u0442 \u043D\u0435\u0434\u0435\u043B\u044E \u0438
      \u0438\u0441\u0442\u043E\u0449\u0438\u0442 \u043F\u0440\u0438\u043F\u0430\u0441\u044B.
      \u0410 \u043C\u043E\u0436\u043D\u043E \u0440\u0438\u0441\u043A\u043D\u0443\u0442\u044C
      \u0438 \u043F\u043E\u0434\u043E\u0439\u0442\u0438 \u0431\u043B\u0438\u0436\u0435
      \u2014 \u0432\u0434\u0440\u0443\u0433 \u0441\u043B\u0443\u0445\u0438 \u043F\u0440\u0435\u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u044B,
      \u0438 \u0433\u043E\u0440\u043E\u0434 \u0442\u043E\u0440\u0433\u0443\u0435\u0442
      \u0447\u0435\u0440\u0435\u0437 \u0432\u043D\u0435\u0448\u043D\u0438\u0439 \u043A\u0430\u0440\u0430\u043D\u0442\u0438\u043D.\r\n\r\n<npc_speech
      lang=\"Persian\">\u041D\u0430\u0437\u0430\u0434! \u041D\u0430\u0437\u0430\u0434!
      \u0413\u043E\u0440\u043E\u0434 \u043C\u0451\u0440\u0442\u0432! \u0427\u0443\u043C\u0430
      \u0432\u0441\u0435\u0445 \u0443\u0431\u0438\u043B\u0430 \u2014 \u044F \u043E\u0434\u0438\u043D
      \u0441\u043F\u0430\u0441\u0441\u044F!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643563
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u0433\u043E\u0440\u043E\u0434
      \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643564
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0441\u0432\u0435\u0440\u043D\u0443\u043B
      \u043D\u0430 \u043F\u0440\u043E\u0441\u0451\u043B\u043E\u043A, \u043E\u0433\u0438\u0431\u0430\u044F
      \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0435 \u0441\u0442\u0435\u043D\u044B
      \u043F\u043E \u0448\u0438\u0440\u043E\u043A\u043E\u0439 \u0434\u0443\u0433\u0435.
      \u0422\u0440\u0438 \u0434\u043D\u044F \u043F\u043E \u0431\u0435\u0437\u0434\u043E\u0440\u043E\u0436\u044C\u044E,
      \u0431\u0435\u0437 \u043A\u043E\u043B\u043E\u0434\u0446\u0435\u0432 \u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0435\u0432.
      \u041F\u0440\u0438\u043F\u0430\u0441\u044B \u0442\u0430\u044E\u0442, \u043B\u044E\u0434\u0438
      \u0432\u043E\u0440\u0447\u0430\u0442, \u0432\u043E\u043B\u044B \u0435\u043B\u0435
      \u0442\u044F\u043D\u0443\u0442 \u043F\u043E \u0440\u0430\u0437\u043C\u044B\u0442\u043E\u0439
      \u043A\u043E\u043B\u0435\u0435. \u041D\u043E \u2014 \u0436\u0438\u0432\u044B.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u043A\u0430\u0448\u043B\u044F\u0435\u0442,
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u043A\u0440\u044B\u043B\u0441\u044F
      \u044F\u0437\u0432\u0430\u043C\u0438. \u0413\u043E\u0440\u043E\u0434 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 \u0442\u0451\u043C\u043D\u044B\u043C
      \u0441\u0438\u043B\u0443\u044D\u0442\u043E\u043C, \u0438 \u0434\u044B\u043C
      \u043D\u0430\u0434 \u043D\u0438\u043C \u043A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E \u0434\u043D\u044F \u0441\u0442\u0430\u043B
      \u0433\u0443\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643565
    m_Localized: "\u041F\u043E\u0434\u043E\u0439\u0442\u0438 \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643566
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u043E\u0448\u043B\u0438 \u043A
      \u0441\u0442\u0435\u043D\u0430\u043C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E,
      \u0431\u0435\u043B\u044B\u043C \u0444\u043B\u0430\u0433\u043E\u043C \u043D\u0430
      \u043F\u0430\u043B\u043A\u0435. \u0427\u0443\u043C\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043D\u0435 \u0432\u044B\u0434\u0443\u043C\u043A\u043E\u0439 \u2014 \u043D\u043E
      \u0433\u043E\u0440\u043E\u0434 \u043D\u0435 \u043C\u0451\u0440\u0442\u0432.
      \u0417\u0430 \u0432\u043D\u0435\u0448\u043D\u0438\u043C\u0438 \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438
      \u0443\u0441\u0442\u0440\u043E\u0435\u043D \u043A\u0430\u0440\u0430\u043D\u0442\u0438\u043D\u043D\u044B\u0439
      \u0440\u044B\u043D\u043E\u043A: \u0442\u043E\u0432\u0430\u0440\u044B \u043F\u0435\u0440\u0435\u0434\u0430\u044E\u0442
      \u0447\u0435\u0440\u0435\u0437 \u0449\u0435\u043B\u044C \u0432 \u0441\u0442\u0435\u043D\u0435,
      \u043C\u043E\u043D\u0435\u0442\u044B \u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442
      \u0432 \u0443\u043A\u0441\u0443\u0441. \u0426\u0435\u043D\u044B \u0431\u0435\u0437\u0443\u043C\u043D\u044B\u0435
      \u2014 \u0433\u043E\u0440\u043E\u0436\u0430\u043D\u0435 \u0432 \u043E\u0442\u0447\u0430\u044F\u043D\u0438\u0438
      \u0438 \u043F\u043B\u0430\u0442\u044F\u0442 \u0432\u0442\u0440\u043E\u0435
      \u0437\u0430 \u043F\u0440\u0438\u043F\u0430\u0441\u044B. \u0412\u044B \u043F\u0440\u043E\u0434\u0430\u043B\u0438
      \u0447\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430 \u043F\u043E
      \u0446\u0435\u043D\u0430\u043C, \u043E \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043E\u0431\u044B\u0447\u043D\u043E \u043D\u0435 \u043C\u0435\u0447\u0442\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643567
    m_Localized: "\u0421\u0442\u0435\u043D\u044B \u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0442\u0438\u0445\u0438\u043C\u0438. \u0412\u044B \u043F\u043E\u0434\u043E\u0448\u043B\u0438
      \u0431\u043B\u0438\u0436\u0435 \u2014 \u0438 \u0442\u0443\u0442 \u0432\u0435\u0442\u0435\u0440
      \u043F\u0435\u0440\u0435\u043C\u0435\u043D\u0438\u043B\u0441\u044F. \u0421\u043C\u0440\u0430\u0434
      \u0443\u0434\u0430\u0440\u0438\u043B \u0432 \u043B\u0438\u0446\u043E: \u0441\u043B\u0430\u0434\u043A\u043E\u0432\u0430\u0442\u044B\u0439,
      \u0442\u044F\u0436\u0451\u043B\u044B\u0439, \u0431\u0435\u0437\u043E\u0448\u0438\u0431\u043E\u0447\u043D\u044B\u0439
      \u0437\u0430\u043F\u0430\u0445 \u043C\u043E\u0440\u0430. \u0423 \u0432\u043E\u0440\u043E\u0442
      \u043B\u0435\u0436\u0430\u043B\u0438 \u0442\u0435\u043B\u0430, \u043E\u0431\u043B\u0435\u043F\u043B\u0435\u043D\u043D\u044B\u0435
      \u043C\u0443\u0445\u0430\u043C\u0438. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0431\u0440\u043E\u0441\u0438\u043B\u0441\u044F \u043F\u0440\u043E\u0447\u044C,
      \u043D\u043E \u0431\u044B\u043B\u043E \u043F\u043E\u0437\u0434\u043D\u043E
      \u2014 \u043A \u0432\u0435\u0447\u0435\u0440\u0443 \u0443 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F
      \u0436\u0430\u0440. \u0427\u0451\u0440\u043D\u044B\u0435 \u043F\u044F\u0442\u043D\u0430
      \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C \u043D\u0430 \u0442\u0440\u0435\u0442\u0438\u0439
      \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643568
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0437\u043D\u0430\u0435\u0442
      \u043E\u0431\u0445\u043E\u0434\u043D\u044B\u0435 \u0440\u044B\u043D\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643569
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B
      \u043A\u0440\u0438\u043A\u0443\u043D\u0430, \u043F\u043E\u0447\u0435\u0441\u0430\u043B
      \u0431\u043E\u0440\u043E\u0434\u0443 \u0438 \u0441\u043A\u0430\u0437\u0430\u043B:
      \xAB\u042F \u0437\u043D\u0430\u044E \u044D\u0442\u043E\u0442 \u0433\u043E\u0440\u043E\u0434.
      \u0415\u0441\u0442\u044C \u043F\u043E\u0434\u0432\u043E\u0440\u044C\u0435 \u0437\u0430
      \u044E\u0436\u043D\u043E\u0439 \u0441\u0442\u0435\u043D\u043E\u0439 \u2014
      \u043A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u0438\u0439 \u0434\u0432\u043E\u0440
      \u0434\u043B\u044F \u0442\u0435\u0445, \u043A\u0442\u043E \u043D\u0435 \u0432\u0445\u043E\u0434\u0438\u0442
      \u0432 \u0432\u043E\u0440\u043E\u0442\u0430. \u0422\u0430\u043C \u0442\u043E\u0440\u0433\u0443\u044E\u0442
      \u0447\u0435\u0440\u0435\u0437 \u043E\u0433\u0440\u0430\u0434\u0443, \u0430
      \u0432\u043E\u0434\u0430 \u0438\u0437 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u043A\u043E\u043B\u043E\u0434\u0446\u0430.\xBB \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043E\u0431\u043E\u0448\u0451\u043B \u0433\u043E\u0440\u043E\u0434 \u0438
      \u043D\u0430\u0448\u0451\u043B \u043F\u043E\u0434\u0432\u043E\u0440\u044C\u0435
      \u2014 \u0434\u0435\u0441\u044F\u0442\u043E\u043A \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432
      \u0443\u0436\u0435 \u0441\u0442\u043E\u044F\u043B\u0438 \u043B\u0430\u0433\u0435\u0440\u0435\u043C,
      \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u044F\u0441\u044C \u0442\u043E\u0432\u0430\u0440\u0430\u043C\u0438
      \u0447\u0435\u0440\u0435\u0437 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439
      \u0431\u0430\u0440\u044C\u0435\u0440. \u041D\u0435 \u0431\u0430\u0437\u0430\u0440,
      \u043D\u043E \u0434\u0435\u043B\u043E \u0441\u0434\u0435\u043B\u0430\u043D\u043E:
      \u0432\u044B \u043F\u0440\u043E\u0434\u0430\u043B\u0438 \u0447\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430, \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u043B\u0438
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u0438 \u0443\u0448\u043B\u0438,
      \u043D\u0435 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u044F\u0441\u044C
      \u043A \u0437\u0430\u0440\u0430\u0437\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643570
    m_Localized: "\u0414\u043E\u043B\u0433\u043E\u0432\u0430\u044F \u043B\u043E\u0432\u0443\u0448\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643571
    m_Localized: "\u041D\u0430 \u043F\u0435\u0440\u0435\u043A\u0440\u0451\u0441\u0442\u043A\u0435
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043D\u044B\u0445 \u0442\u0440\u043E\u043F
      \u0432\u0430\u0441 \u0436\u0434\u0451\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0432 \u0442\u0451\u043C\u043D\u043E-\u0441\u0438\u043D\u0435\u043C \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C
      \u043A\u0430\u0444\u0442\u0430\u043D\u0435 \u0441 \u043F\u043E\u0442\u0451\u0440\u0442\u043E\u0439
      \u0437\u043E\u043B\u043E\u0442\u043E\u0439 \u0432\u044B\u0448\u0438\u0432\u043A\u043E\u0439.
      \u0417\u0430 \u043D\u0438\u043C \u2014 \u0434\u0432\u043E\u0435 \u043A\u0440\u0435\u043F\u043A\u0438\u0445
      \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u044B\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432
      \u0441 \u043F\u0430\u043B\u0438\u0446\u0430\u043C\u0438. \u041E\u043D \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F,
      \u043A\u0430\u043A \u0441\u0442\u0430\u0440\u044B\u0439 \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439,
      \u0438 \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0438\u0437 \u043A\u043E\u0436\u0430\u043D\u043E\u0439
      \u0441\u0443\u043C\u043A\u0438 \u0441\u0432\u0438\u0442\u043E\u043A \u2014
      \u0434\u043E\u043B\u0433\u043E\u0432\u0443\u044E \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0443
      \u0441 \u0432\u0430\u0448\u0435\u0439 \u043F\u0435\u0447\u0430\u0442\u044C\u044E.
      \u0417\u0430\u0451\u043C, \u0432\u0437\u044F\u0442\u044B\u0439 \u0442\u0440\u0438
      \u0433\u043E\u0440\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434 \u043D\u0430
      \u0437\u0430\u043A\u0443\u043F\u043A\u0443 \u0442\u043E\u0432\u0430\u0440\u0430,
      \u0441 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u0430\u043C\u0438 \u0432\u044B\u0440\u043E\u0441
      \u0432\u0442\u0440\u043E\u0435. \u0421\u0440\u043E\u043A \u0438\u0441\u0442\u0451\u043A.
      \u041E\u043D \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0430
      \u2014 \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C \u0438\u043B\u0438
      \u0442\u043E\u0432\u0430\u0440\u043E\u043C. \u0415\u0441\u043B\u0438 \u043D\u0435
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u0435, \u0435\u0433\u043E
      \u043B\u044E\u0434\u0438 \u043E\u043F\u0438\u0448\u0443\u0442 \u0432\u0430\u0448
      \u0433\u0440\u0443\u0437, \u0430 \u0441\u043B\u043E\u0432\u043E \u043E \u043D\u0435\u043F\u043B\u0430\u0442\u0451\u0436\u0435\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
      \u0440\u0430\u0437\u043B\u0435\u0442\u0438\u0442\u0441\u044F \u043F\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u044F\u043C
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0432\u0435\u0442\u0440\u0430.\r\n\r\n<npc_speech
      lang=\"Sogdian\">\u041F\u0440\u0438\u0432\u0435\u0442, \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A!
      \u041F\u043E\u043C\u043D\u0438\u0448\u044C \u2014 \u0441\u0435\u0440\u0435\u0431\u0440\u043E,
      \u0447\u0442\u043E \u0431\u0440\u0430\u043B, \u043D\u0430\u0434\u043E \u0432\u0435\u0440\u043D\u0443\u0442\u044C.
      \u0421\u0440\u043E\u043A \u0432\u044B\u0448\u0435\u043B. \u0427\u0435\u043C
      \u043F\u043B\u0430\u0442\u0438\u0448\u044C \u2014 \u0437\u043E\u043B\u043E\u0442\u043E\u043C
      \u0438\u043B\u0438 \u0442\u043E\u0432\u0430\u0440\u043E\u043C?</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643572
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u0447\u0430\u0441\u0442\u044C
      \u0442\u043E\u0432\u0430\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643573
    m_Localized: "\u0412\u044B \u0441\u0446\u0435\u043F\u0438\u043B\u0438 \u0437\u0443\u0431\u044B
      \u0438 \u043A\u0438\u0432\u043D\u0443\u043B\u0438. \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438
      \u0434\u0435\u043B\u043E\u0432\u0438\u0442\u043E \u0432\u0441\u043A\u0440\u044B\u043B\u0438
      \u0434\u0432\u0430 \u0442\u044E\u043A\u0430, \u0432\u0437\u0432\u0435\u0441\u0438\u043B\u0438
      \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435 \u043D\u0430 \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0445
      \u0432\u0435\u0441\u0430\u0445 \u0438 \u043F\u043E\u0433\u0440\u0443\u0437\u0438\u043B\u0438
      \u043D\u0430 \u0441\u0432\u043E\u0435\u0433\u043E \u043C\u0443\u043B\u0430.
      \u0420\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A \u0441\u0432\u0435\u0440\u043D\u0443\u043B
      \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0443 \u0438 \u0441\u0436\u0451\u0433
      \u043D\u0430 \u043E\u0433\u043D\u0435 \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0439
      \u043B\u0430\u043C\u043F\u044B. \xAB\u0414\u043E\u043B\u0433 \u0437\u0430\u043A\u0440\u044B\u0442,\xBB
      \u2014 \u0441\u043A\u0430\u0437\u0430\u043B \u043E\u043D \u0440\u043E\u0432\u043D\u043E
      \u0438 \u0443\u0448\u0451\u043B, \u043D\u0435 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
      \u0432\u0441\u043B\u0435\u0434 \u043C\u043E\u043B\u0447\u0430. \u0427\u0435\u0442\u0432\u0435\u0440\u0442\u044C
      \u0442\u043E\u0432\u0430\u0440\u0430 \u2014 \u0440\u0430\u0431\u043E\u0442\u0430
      \u0434\u0432\u0443\u0445 \u043C\u0435\u0441\u044F\u0446\u0435\u0432 \u2014
      \u0438\u0441\u0447\u0435\u0437\u043B\u0430 \u0437\u0430 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C
      \u0447\u0430\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643574
    m_Localized: "\u041E\u0441\u043F\u043E\u0440\u0438\u0442\u044C \u0434\u043E\u043B\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643575
    m_Localized: "\u0412\u044B \u0432\u0437\u044F\u043B\u0438 \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0443,
      \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u043B\u0438 \u0438 \u0441\u0442\u0430\u043B\u0438
      \u0447\u0438\u0442\u0430\u0442\u044C \u0432\u0441\u043B\u0443\u0445 \u2014
      \u043F\u0443\u043D\u043A\u0442 \u0437\u0430 \u043F\u0443\u043D\u043A\u0442\u043E\u043C.
      \u041F\u0440\u043E\u0446\u0435\u043D\u0442 \u043D\u0430\u0447\u0438\u0441\u043B\u0435\u043D
      \u0434\u0432\u0430\u0436\u0434\u044B \u043D\u0430 \u043E\u0434\u043D\u0443
      \u0441\u0443\u043C\u043C\u0443. \u0428\u0442\u0440\u0430\u0444 \u0437\u0430
      \u043F\u0440\u043E\u0441\u0440\u043E\u0447\u043A\u0443 \u043F\u0440\u043E\u043F\u0438\u0441\u0430\u043D,
      \u043D\u043E \u0434\u0430\u0442\u0430 \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430
      \u0437\u0430\u0434\u043D\u0438\u043C \u0447\u0438\u0441\u043B\u043E\u043C.
      \xAB\u0422\u044B \u043F\u043E\u0434\u0434\u0435\u043B\u0430\u043B \u0440\u0430\u0441\u0447\u0451\u0442,\xBB
      \u2014 \u0441\u043A\u0430\u0437\u0430\u043B\u0438 \u0432\u044B \u0442\u0438\u0445\u043E,
      \u043D\u043E \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B \u0441\u043B\u044B\u0448\u0430\u043B\u0438
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438. \u0420\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A
      \u043F\u043E\u0431\u043B\u0435\u0434\u043D\u0435\u043B. \u0422\u043E\u0440\u0433
      \u0431\u044B\u043B \u0436\u0451\u0441\u0442\u043A\u0438\u043C \u2014 \u043D\u043E
      \u0432 \u0438\u0442\u043E\u0433\u0435 \u0432\u044B \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B\u0438
      \u0447\u0435\u0441\u0442\u043D\u0443\u044E \u0441\u0443\u043C\u043C\u0443,
      \u0431\u0435\u0437 \u0442\u0440\u043E\u0439\u043D\u043E\u0439 \u043D\u0430\u043A\u0440\u0443\u0442\u043A\u0438.
      \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u043B\u0438\u0441\u044C
      \u0438 \u0447\u0443\u0442\u044C \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438
      \u043F\u0430\u043B\u0438\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643576
    m_Localized: "\u0412\u044B \u0442\u043A\u043D\u0443\u043B\u0438 \u043F\u0430\u043B\u044C\u0446\u0435\u043C
      \u0432 \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0443 \u2014 \u043D\u043E
      \u0440\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A \u0436\u0434\u0430\u043B
      \u044D\u0442\u043E\u0433\u043E. \u041E\u043D \u0434\u043E\u0441\u0442\u0430\u043B
      \u0432\u0442\u043E\u0440\u043E\u0439 \u0441\u0432\u0438\u0442\u043E\u043A:
      \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u043E\u0442 \u043C\u0435\u043D\u044F\u043B\u044B \u0432 \u0411\u0443\u0445\u0430\u0440\u0435,
      \u0437\u0430\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0435 \u043F\u0435\u0447\u0430\u0442\u044C\u044E
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438. \xAB\u041E\u0441\u043F\u0430\u0440\u0438\u0432\u0430\u0439
      \u0432 \u0441\u0443\u0434\u0435 \u2014 \u0435\u0441\u043B\u0438 \u0434\u043E\u0439\u0434\u0451\u0448\u044C.\xBB
      \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438 \u0448\u0430\u0433\u043D\u0443\u043B\u0438
      \u0432\u043F\u0435\u0440\u0451\u0434. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043E\u0442\u0434\u0430\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043E\u043D \u043F\u0440\u043E\u0441\u0438\u043B \u0438\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E:
      \u043E\u043D \u0434\u043E\u0431\u0430\u0432\u0438\u043B \u0448\u0442\u0440\u0430\u0444
      \u0437\u0430 \xAB\u043E\u0441\u043A\u043E\u0440\u0431\u043B\u0435\u043D\u0438\u0435\xBB.
      \u0421\u043B\u043E\u0432\u043E \u043E \u0432\u0430\u0448\u0435\u0439 \u043D\u0435\u0441\u0433\u043E\u0432\u043E\u0440\u0447\u0438\u0432\u043E\u0441\u0442\u0438
      \u043F\u043E\u0431\u0435\u0436\u0438\u0442 \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643577
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643578
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u044B\u0441\u0442\u0443\u043F\u0438\u043B
      \u0432\u043F\u0435\u0440\u0451\u0434 \u0438 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0441 \u0440\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A\u043E\u043C \u043D\u0430
      \u0447\u0438\u0441\u0442\u043E\u043C \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C:
      <npc_speech lang=\"Sogdian\">\u042D\u0442\u0430 \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0430
      \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u0441 \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u0438\u0435\u043C
      \u0437\u0430\u043A\u043E\u043D\u0430 \u0411\u0443\u0445\u0430\u0440\u044B.
      \u0422\u044B \u044D\u0442\u043E \u0437\u043D\u0430\u0435\u0448\u044C, \u0438
      \u044F \u044D\u0442\u043E \u0437\u043D\u0430\u044E. \u0414\u0430\u0432\u0430\u0439
      \u0440\u0435\u0448\u0438\u043C \u043F\u043E-\u0447\u0435\u0441\u0442\u043D\u043E\u043C\u0443.</npc_speech>
      \u0420\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A \u043D\u0430\u0441\u0442\u043E\u0440\u043E\u0436\u0438\u043B\u0441\u044F:
      \u043F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C \u043D\u0435 \u0431\u0435\u0437\u0433\u0440\u0430\u043C\u043E\u0442\u043D\u044B\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A, \u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0437\u043D\u0430\u0435\u0442,
      \u043A\u0430\u043A \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0435
      \u0441\u0443\u0434\u044B. \u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u0448\u0451\u043B \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C \u0447\u0430\u0441\u0430.
      \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0442\u043A\u043D\u0443\u043B
      \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u0432 \u0442\u0440\u0438 \u043F\u0443\u043D\u043A\u0442\u0430
      \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0438, \u043F\u0440\u043E\u0446\u0438\u0442\u0438\u0440\u043E\u0432\u0430\u043B
      \u0437\u0430\u043A\u043E\u043D \u0411\u0443\u0445\u0430\u0440\u044B \u043E
      \u0440\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u0447\u0435\u0441\u0442\u0432\u0435
      \u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u0447\u0435\u0441\u0442\u043D\u044B\u0439
      \u0440\u0430\u0441\u0447\u0451\u0442 \u2014 \u0442\u0440\u0435\u0442\u044C
      \u043E\u0442 \u0442\u0440\u0435\u0431\u0443\u0435\u043C\u043E\u0433\u043E.
      \u0420\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A \u0441\u043A\u0440\u0438\u0432\u0438\u043B\u0441\u044F,
      \u043D\u043E \u0432\u0437\u044F\u043B \u0434\u0435\u043D\u044C\u0433\u0438.
      \u0423\u0445\u043E\u0434\u044F, \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0441\u044F: \xAB\u041E\u043D \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043F\u0440\u0438\u0434\u0451\u0442. \u042F \u0443\u043F\u043E\u043C\u044F\u043D\u0443\u043B
      \u0433\u0438\u043B\u044C\u0434\u0435\u0439\u0441\u043A\u043E\u0433\u043E \u0441\u0443\u0434\u044C\u044E
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435 \u2014
      \u043E\u043D\u0438 \u0437\u043D\u0430\u043A\u043E\u043C\u044B, \u0438 \u043D\u0435
      \u0432 \u0445\u043E\u0440\u043E\u0448\u0435\u043C \u0441\u043C\u044B\u0441\u043B\u0435.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643579
    m_Localized: "\u0411\u0430\u0437\u0430\u0440\u043D\u0430\u044F \u0430\u0444\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643580
    m_Localized: "\u0411\u0430\u0437\u0430\u0440\u043D\u044B\u0439 \u0433\u0443\u043B
      \u043E\u0431\u0432\u043E\u043B\u0430\u043A\u0438\u0432\u0430\u0435\u0442, \u043A\u0430\u043A
      \u0436\u0430\u0440\u0430 \u2014 \u043A\u0440\u0438\u043A\u0438 \u0437\u0430\u0437\u044B\u0432\u0430\u043B,
      \u0437\u0432\u043E\u043D \u0447\u0435\u043A\u0430\u043D\u043D\u044B\u0445 \u043C\u043E\u043D\u0435\u0442,
      \u0437\u0430\u043F\u0430\u0445 \u0436\u0430\u0440\u0435\u043D\u043E\u0433\u043E
      \u043A\u0443\u043D\u0436\u0443\u0442\u0430 \u0438 \u0433\u043E\u0440\u044F\u0447\u0435\u0439
      \u043C\u0435\u0434\u0438. \u0423 \u043B\u0430\u0432\u043A\u0438 \u0441 \u0442\u043A\u0430\u043D\u044F\u043C\u0438
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0440\u0430\u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043D\u0430
      \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0435 \u0440\u0443\u043B\u043E\u043D\u044B
      \u0448\u0451\u043B\u043A\u0430 \u2014 \u0442\u043E\u043D\u043A\u043E\u0433\u043E,
      \u0441 \u043F\u0435\u0440\u0435\u043B\u0438\u0432\u0447\u0430\u0442\u044B\u043C
      \u0431\u043B\u0435\u0441\u043A\u043E\u043C, \u043A\u0430\u043A\u043E\u0433\u043E
      \u043D\u0435 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0448\u044C \u043D\u0430
      \u043A\u0430\u0436\u0434\u043E\u043C \u0443\u0433\u043B\u0443. \u041E\u043D
      \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F \u0442\u043A\u0430\u043D\u0438
      \u043A\u043E\u043D\u0447\u0438\u043A\u0430\u043C\u0438 \u043F\u0430\u043B\u044C\u0446\u0435\u0432,
      \u0431\u0443\u0434\u0442\u043E \u0434\u0440\u0430\u0433\u043E\u0446\u0435\u043D\u043D\u043E\u0441\u0442\u0438,
      \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043A
      \u0432\u0430\u043C \u0441 \u0448\u0438\u0440\u043E\u043A\u043E\u0439 \u0443\u043B\u044B\u0431\u043A\u043E\u0439:\r\n\r\n<npc_speech
      lang=\"Sogdian\">\u041F\u0440\u0438\u0432\u0435\u0442, \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A!
      \u042D\u0442\u0430 \u043F\u0430\u0440\u0447\u0430 \u2014 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u0439
      \u0448\u0451\u043B\u043A, \u043F\u0440\u044F\u043C\u043E \u0438\u0437 \u0427\u0430\u043D\u044A\u0430\u043D\u044F!
      \u0414\u0435\u0441\u044F\u0442\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0445
      \u2014 \u0434\u0435\u0448\u0435\u0432\u043B\u0435 \u043D\u0435 \u043D\u0430\u0439\u0434\u0451\u0448\u044C
      \u043D\u0438\u0433\u0434\u0435.</npc_speech>\r\n\r\n\u0426\u0435\u043D\u0430
      \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0438\u0437\u043A\u0430\u044F \u0434\u043B\u044F \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E
      \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u0433\u043E \u0448\u0451\u043B\u043A\u0430.
      \u041D\u0438\u0442\u043A\u0438 \u0431\u043B\u0435\u0441\u0442\u044F\u0442,
      \u043D\u043E \u0431\u043B\u0435\u0441\u043A \u043A\u0430\u043A\u043E\u0439-\u0442\u043E
      \u043C\u0430\u0441\u043B\u044F\u043D\u0438\u0441\u0442\u044B\u0439 \u2014 \u0442\u043E
      \u043B\u0438 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u043E \u0442\u0430\u043A\u043E\u0435,
      \u0442\u043E \u043B\u0438 \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643581
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043E\u0442
      \u0441\u0434\u0435\u043B\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643582
    m_Localized: "\u0412\u044B \u043A\u0430\u0447\u0430\u0435\u0442\u0435 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
      \u0438 \u043E\u0442\u0445\u043E\u0434\u0438\u0442\u0435 \u043E\u0442 \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0430.
      \u0421\u043E\u0433\u0434\u0438\u0435\u0446 \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442
      \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438 \u0442\u0443\u0442 \u0436\u0435
      \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044F.
      \u041C\u043E\u0436\u0435\u0442, \u0448\u0451\u043B\u043A \u0438 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
      \u2014 \u043D\u043E \u043D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435 \u043A\u0442\u043E
      \u043D\u0435 \u0440\u0438\u0441\u043A\u0443\u0435\u0442, \u0442\u043E\u0442
      \u043D\u0435 \u043F\u043B\u0430\u0442\u0438\u0442 \u0434\u0432\u0430\u0436\u0434\u044B.
      \u0421\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0438\u0435 \u0434\u043E\u0440\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643583
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0442\u043A\u0430\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643584
    m_Localized: "\u0412\u044B \u0431\u0435\u0440\u0451\u0442\u0435 \u043A\u0440\u0430\u0439
      \u0442\u043A\u0430\u043D\u0438, \u0440\u0430\u0441\u0442\u0438\u0440\u0430\u0435\u0442\u0435
      \u043C\u0435\u0436\u0434\u0443 \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438
      \u0438 \u043F\u043E\u0434\u043D\u043E\u0441\u0438\u0442\u0435 \u043A \u0441\u0432\u0435\u0442\u0443.
      \u041D\u0438\u0442\u0438 \u043D\u0435\u0440\u043E\u0432\u043D\u044B\u0435,
      \u0431\u043B\u0435\u0441\u043A \u2014 \u043E\u0442 \u043B\u044C\u043D\u044F\u043D\u043E\u0433\u043E
      \u043C\u0430\u0441\u043B\u0430, \u0430 \u043D\u0435 \u043E\u0442 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430
      \u043F\u0440\u044F\u0434\u0435\u043D\u0438\u044F. \xAB\u042D\u0442\u043E \u043D\u0435
      \u0447\u0430\u043D\u044A\u0430\u043D\u044C\u0441\u043A\u0438\u0439 \u0448\u0451\u043B\u043A,
      \u0430 \u0431\u0443\u0445\u0430\u0440\u0441\u043A\u0430\u044F \u043F\u043E\u043B\u0443\u0448\u0435\u0440\u0441\u0442\u044C\xBB,
      \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u0432\u044B. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0431\u043B\u0435\u0434\u043D\u0435\u0435\u0442, \u0441\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442
      \u0446\u0435\u043D\u0443 \u0432\u0434\u0432\u043E\u0435, \u0438 \u0432\u044B
      \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E
      \u043F\u0430\u0440\u0447\u0443 \u0441 \u043D\u0438\u0436\u043D\u0435\u0439
      \u043F\u043E\u043B\u043A\u0438 \u2014 \u0442\u0443, \u0447\u0442\u043E \u043E\u043D
      \u043F\u0440\u0438\u043F\u0440\u044F\u0442\u0430\u043B \u0434\u043B\u044F \u0437\u043D\u0430\u0442\u043E\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643585
    m_Localized: "\u0422\u043A\u0430\u043D\u044C \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0443\u0431\u0435\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u2014 \u0432\u044B
      \u043F\u043B\u0430\u0442\u0438\u0442\u0435 \u043F\u043E\u043B\u043D\u0443\u044E
      \u0446\u0435\u043D\u0443 \u0438 \u0443\u0445\u043E\u0434\u0438\u0442\u0435
      \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u0439. \u0427\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430 \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0430 \u0441\u0442\u0430\u0440\u044B\u0439
      \u043A\u0440\u0430\u0441\u0438\u043B\u044C\u0449\u0438\u043A \u0443 \u0444\u043E\u043D\u0442\u0430\u043D\u0430
      \u043E\u043A\u0438\u0434\u044B\u0432\u0430\u0435\u0442 \u0432\u0430\u0448 \u0441\u0432\u0451\u0440\u0442\u043E\u043A
      \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C \u0438 \u0446\u043E\u043A\u0430\u0435\u0442
      \u044F\u0437\u044B\u043A\u043E\u043C: \xAB\u041A\u0440\u0430\u0448\u0435\u043D\u044B\u0439
      \u043B\u0451\u043D, \u0434\u0440\u0443\u0433 \u043C\u043E\u0439. \u0428\u0451\u043B\u043A\u043E\u043C
      \u0442\u0443\u0442 \u0438 \u043D\u0435 \u043F\u0430\u0445\u043D\u0435\u0442\xBB.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B,
      \u0430 \u0442\u043E\u0432\u0430\u0440 \u043D\u0435 \u0441\u0442\u043E\u0438\u0442
      \u0438 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643586
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u0442
      \u0442\u043A\u0430\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643587
    m_Localized: "\u0412\u0430\u0448 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u0431\u0435\u0440\u0451\u0442 \u0440\u0443\u043B\u043E\u043D, \u043D\u044E\u0445\u0430\u0435\u0442,
      \u0434\u0451\u0440\u0433\u0430\u0435\u0442 \u043D\u0438\u0442\u044C \u0437\u0443\u0431\u0430\u043C\u0438
      \u0438 \u043C\u043E\u043B\u0447\u0430 \u043A\u043B\u0430\u0434\u0451\u0442
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E. \u0417\u0430\u0442\u0435\u043C
      \u043D\u0430\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0441\u044F \u043A \u0441\u043E\u0433\u0434\u0438\u0439\u0446\u0443
      \u0438 \u0447\u0442\u043E-\u0442\u043E \u0448\u0435\u043F\u0447\u0435\u0442.
      \u041F\u0440\u043E\u0434\u0430\u0432\u0435\u0446 \u0432\u0437\u0434\u0440\u0430\u0433\u0438\u0432\u0430\u0435\u0442,
      \u043B\u0435\u0437\u0435\u0442 \u043F\u043E\u0434 \u043F\u0440\u0438\u043B\u0430\u0432\u043E\u043A
      \u0438 \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0434\u0440\u0443\u0433\u043E\u0439
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A \u2014 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E
      \u043F\u0430\u0440\u0447\u0443, \u0442\u044F\u0436\u0451\u043B\u0443\u044E
      \u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u0443\u044E \u043D\u0430 \u043E\u0449\u0443\u043F\u044C.
      \xAB\u041F\u044F\u0442\u044C \u043C\u043E\u043D\u0435\u0442, \u0438 \u043C\u044B
      \u0437\u0430\u0431\u044B\u0432\u0430\u0435\u043C \u043F\u0440\u043E \u0442\u0432\u043E\u0439
      \u0444\u043E\u043A\u0443\u0441 \u0441 \u043C\u0430\u0441\u043B\u043E\u043C\xBB,
      \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0432\u0430\u0448 \u0441\u043F\u0443\u0442\u043D\u0438\u043A.
      \u0421\u043E\u0433\u0434\u0438\u0435\u0446 \u043A\u0438\u0432\u0430\u0435\u0442,
      \u0438 \u0432\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u043B\u0443\u0447\u0448\u0438\u043C
      \u0442\u043E\u0432\u0430\u0440\u043E\u043C \u0437\u0430 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C
      \u0446\u0435\u043D\u044B. \u041D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435
      \u0448\u0451\u043F\u043E\u0442\u043E\u043C \u043F\u0435\u0440\u0435\u0434\u0430\u044E\u0442:
      \u044D\u0442\u0438\u0445 \u043D\u0435 \u043F\u0440\u043E\u0432\u0435\u0434\u0451\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643588
    m_Localized: "\u0420\u0430\u0441\u0441\u043A\u0430\u0437 \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643589
    m_Localized: "\u0412\u0435\u0447\u0435\u0440 \u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0435.
      \u041C\u0430\u0441\u043B\u044F\u043D\u044B\u0435 \u043B\u0430\u043C\u043F\u044B
      \u0431\u0440\u043E\u0441\u0430\u044E\u0442 \u0440\u044B\u0436\u0438\u0439 \u0441\u0432\u0435\u0442
      \u043D\u0430 \u043A\u0438\u0440\u043F\u0438\u0447\u043D\u044B\u0435 \u0441\u0442\u0435\u043D\u044B,
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0434\u044B\u043C\u043E\u043C, \u0432\u0430\u0440\u0451\u043D\u044B\u043C
      \u0440\u0438\u0441\u043E\u043C \u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u044C\u0435\u0439
      \u0448\u0435\u0440\u0441\u0442\u044C\u044E. \u0412\u043E \u0434\u0432\u043E\u0440\u0435
      \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D\u044B \u043C\u0443\u043B\u044B
      \u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B, \u0430 \u0432 \u043E\u0431\u0449\u0435\u043C
      \u0437\u0430\u043B\u0435, \u043D\u0430 \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u0445
      \u043A\u043E\u0432\u0440\u0430\u0445, \u0441\u0438\u0434\u044F\u0442 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B
      \u0438\u0437 \u0434\u044E\u0436\u0438\u043D\u044B \u0441\u0442\u0440\u0430\u043D.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445 \u2014 \u0441\u0435\u0434\u043E\u0439
      \u043F\u0435\u0440\u0441 \u0432 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0435\u043C
      \u0437\u0435\u043B\u0451\u043D\u043E\u043C \u0445\u0430\u043B\u0430\u0442\u0435
      \u2014 \u0434\u043E\u043F\u0438\u0432\u0430\u0435\u0442 \u0447\u0430\u0439
      \u0438 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u0432\u0430\u0448\u0435\u043C\u0443 \u043E\u0433\u043D\u044E. \u0415\u0433\u043E
      \u0433\u043B\u0430\u0437\u0430 \u0431\u043B\u0435\u0441\u0442\u044F\u0442 \u0432
      \u043F\u043E\u043B\u0443\u043C\u0440\u0430\u043A\u0435.\r\n\r\n<npc_speech
      lang=\"Persian\">\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A. \u042F \u0438\u0434\u0443
      \u0438\u0437 \u0411\u0430\u043B\u0445\u0430. \u0412 \u0433\u043E\u0440\u0430\u0445
      \u041F\u0430\u043C\u0438\u0440\u0430 \u0435\u0441\u0442\u044C \u0434\u0440\u0435\u0432\u043D\u0435\u0435
      \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0435 \u2014 \u0435\u0441\u043B\u0438
      \u0437\u043D\u0430\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0443. \u0422\u044B
      \u043F\u043E\u0439\u0434\u0451\u0448\u044C \u0438\u043B\u0438 \u0431\u043E\u0438\u0448\u044C\u0441\u044F?</npc_speech>\r\n\r\n\u041E\u043D
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E \u0441\u043E\u043A\u0440\u043E\u0432\u0438\u0449\u0430\u0445
      \u0432 \u043F\u0430\u043C\u0438\u0440\u0441\u043A\u0438\u0445 \u043F\u0435\u0449\u0435\u0440\u0430\u0445.
      \u041C\u043E\u0436\u0435\u0442, \u0441\u0442\u0430\u0440\u0438\u043A \u0431\u0440\u0435\u0434\u0438\u0442.
      \u0410 \u043C\u043E\u0436\u0435\u0442, \u0437\u043D\u0430\u0435\u0442 \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643590
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u0442\u044C
      \u0438 \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643591
    m_Localized: "\u0412\u044B \u0441\u043B\u0443\u0448\u0430\u0435\u0442\u0435 \u0434\u043E
      \u043A\u043E\u043D\u0446\u0430, \u043A\u0438\u0432\u0430\u0435\u0442\u0435
      \u0438 \u0436\u0435\u043B\u0430\u0435\u0442\u0435 \u0441\u0442\u0430\u0440\u0438\u043A\u0443
      \u0434\u043E\u0431\u0440\u043E\u0439 \u043D\u043E\u0447\u0438. \u0418\u0441\u0442\u043E\u0440\u0438\u044F
      \u043A\u0440\u0430\u0441\u0438\u0432\u0430\u044F \u2014 \u0433\u043E\u0440\u043D\u044B\u0435
      \u0445\u0440\u0430\u043C\u044B, \u0437\u043E\u043B\u043E\u0442\u044B\u0435
      \u0441\u0442\u0430\u0442\u0443\u0438, \u0441\u043A\u0435\u043B\u0435\u0442\u044B
      \u043D\u0435\u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u0445 \u0438\u0441\u043A\u0430\u0442\u0435\u043B\u0435\u0439.
      \u041F\u0440\u0430\u0432\u0434\u0430 \u0438\u043B\u0438 \u043D\u0435\u0442
      \u2014 \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C \u043D\u0435\u0437\u0430\u0447\u0435\u043C.
      \u041D\u043E \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0435 \u0441\u043B\u043E\u0432\u0430
      \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438\u0441\u044C, \u0438
      \u044D\u0442\u043E \u0443\u0436\u0435 \u0447\u0442\u043E-\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643592
    m_Localized: "\u0420\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C
      \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643593
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u0441\u0430\u0436\u0438\u0432\u0430\u0435\u0442\u0435\u0441\u044C
      \u0431\u043B\u0438\u0436\u0435, \u043F\u043E\u0434\u043B\u0438\u0432\u0430\u0435\u0442\u0435
      \u0441\u0442\u0430\u0440\u0438\u043A\u0443 \u0447\u0430\u044E \u0438 \u0437\u0430\u0434\u0430\u0451\u0442\u0435
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0435 \u0432\u043E\u043F\u0440\u043E\u0441\u044B
      \u2014 \u043D\u0435 \u043E \u0437\u043E\u043B\u043E\u0442\u0435, \u0430 \u043E
      \u0434\u043E\u0440\u043E\u0433\u0435. \u041F\u0435\u0440\u0441 \u0440\u0430\u0441\u0441\u043B\u0430\u0431\u043B\u044F\u0435\u0442\u0441\u044F
      \u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0432\u0441\u0435\u0440\u044C\u0451\u0437: \u043F\u0435\u0440\u0435\u0432\u0430\u043B
      \u043A \u044E\u0433\u0443 \u043E\u0442 \u041E\u0448\u0430, \u043F\u0435\u0449\u0435\u0440\u0430
      \u0437\u0430 \u0432\u043E\u0434\u043E\u043F\u0430\u0434\u043E\u043C, \u043C\u0435\u0442\u043A\u0438
      \u043D\u0430 \u043A\u0430\u043C\u043D\u044F\u0445. \xAB\u042F \u0431\u044B\u043B
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u0442\u0430\u0440, \u0447\u0442\u043E\u0431\u044B
      \u0438\u0434\u0442\u0438, \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043E\u043D. \u2014 \u041D\u043E \u0442\u044B, \u043C\u043E\u0436\u0435\u0442,
      \u043D\u0435\u0442.\xBB \u0414\u0440\u0443\u0433\u0438\u0435 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B
      \u0432 \u0437\u0430\u043B\u0435 \u043F\u0440\u0438\u043C\u043E\u043B\u043A\u043B\u0438
      \u2014 \u0432\u0430\u0441 \u0441\u043B\u0443\u0448\u0430\u044E\u0442 \u0441
      \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643594
    m_Localized: "\u0421\u0442\u0430\u0440\u0438\u043A \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442
      \u0436\u0430\u0434\u043D\u044B\u0439 \u0431\u043B\u0435\u0441\u043A \u0432
      \u0432\u0430\u0448\u0438\u0445 \u0433\u043B\u0430\u0437\u0430\u0445 \u0438
      \u0437\u0430\u043C\u044B\u043A\u0430\u0435\u0442\u0441\u044F. \xAB\u042F \u043F\u043E\u0448\u0443\u0442\u0438\u043B,
      \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D \u0441\u0443\u0445\u043E.
      \u2014 \u041D\u0435\u0442 \u043D\u0438\u043A\u0430\u043A\u0438\u0445 \u043F\u0435\u0449\u0435\u0440.
      \u0421\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0439 \u043D\u043E\u0447\u0438.\xBB
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438 \u0437\u0430
      \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u043C \u043A\u043E\u0432\u0440\u043E\u043C
      \u043F\u043E\u0441\u043C\u0435\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u2014
      \u043F\u0440\u043E\u0441\u0442\u0430\u043A, \u043F\u043E\u0432\u0435\u0440\u0438\u043B
      \u0432 \u0441\u043A\u0430\u0437\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643595
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u0431\u0435\u0441\u0435\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643596
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u043E\u0434\u0441\u0430\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u0441\u0442\u0430\u0440\u0438\u043A\u0443 \u0438 \u0437\u0430\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0444\u0430\u0440\u0441\u0438: <npc_speech lang=\"Persian\">\u041C\u0438\u0440
      \u0432\u0430\u043C, \u0443\u0432\u0430\u0436\u0430\u0435\u043C\u044B\u0439.
      \u042F \u0441\u043B\u044B\u0448\u0430\u043B \u0432\u0430\u0448\u0443 \u0438\u0441\u0442\u043E\u0440\u0438\u044E
      \u2014 \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0438\u0442\u0435 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435,
      \u043F\u0440\u043E\u0448\u0443.</npc_speech> \u041F\u0435\u0440\u0441 \u043E\u0436\u0438\u0432\u043B\u044F\u0435\u0442\u0441\u044F:
      \u0437\u0435\u043C\u043B\u044F\u043A! \u0417\u0430 \u043F\u043E\u043B\u0447\u0430\u0441\u0430
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0438\u0437 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u0445
      \u043D\u0430\u043C\u0451\u043A\u043E\u0432 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0443\u044E \u043A\u0430\u0440\u0442\u0443,
      \u043D\u0430\u0447\u0435\u0440\u0447\u0435\u043D\u043D\u0443\u044E \u043F\u0430\u043B\u044C\u0446\u0435\u043C
      \u043D\u0430 \u043F\u044B\u043B\u044C\u043D\u043E\u043C \u043F\u043E\u043B\u0443.
      \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
      \u043A\u0430\u0436\u0434\u044B\u0439 \u043F\u043E\u0432\u043E\u0440\u043E\u0442.
      \u0421\u0442\u0430\u0440\u0438\u043A \u0445\u043B\u043E\u043F\u0430\u0435\u0442
      \u0435\u0433\u043E \u043F\u043E \u043F\u043B\u0435\u0447\u0443 \u0438 \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u0438\u0437-\u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u0438 \u043C\u0435\u0434\u043D\u044B\u0439
      \u0430\u043C\u0443\u043B\u0435\u0442 \u2014 \xAB\u043D\u0430 \u0443\u0434\u0430\u0447\u0443,
      \u0435\u0441\u043B\u0438 \u0440\u0435\u0448\u0438\u0442\u0435\u0441\u044C\xBB.
      \u0412\u0435\u0441\u044C \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0439
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0441 \u0437\u0430\u0432\u0438\u0441\u0442\u044C\u044E:
      \u0443 \u044D\u0442\u0438\u0445 \u043B\u044E\u0434\u0435\u0439 \u0435\u0441\u0442\u044C
      \u0441\u0432\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643597
    m_Localized: "\u0410\u0443\u0434\u0438\u0435\u043D\u0446\u0438\u044F \u0443 \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643598
    m_Localized: "\u0413\u043E\u043D\u0435\u0446 \u0432 \u0440\u0430\u0441\u0448\u0438\u0442\u043E\u043C
      \u0445\u0430\u043B\u0430\u0442\u0435 \u043D\u0430\u0448\u0451\u043B \u0432\u0430\u0441
      \u043D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435 \u2014 \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C
      \u0433\u043E\u0440\u043E\u0434\u0430 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u0435\u0442
      \u043D\u0430 \u043F\u0440\u0438\u0451\u043C. \u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C
      \u043D\u0435\u043B\u044C\u0437\u044F. \u0414\u0432\u043E\u0440\u0446\u043E\u0432\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0440\u0430\u0441\u043F\u0430\u0445\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u0432 \u043C\u043E\u0437\u0430\u0438\u0447\u043D\u044B\u0439 \u0434\u0432\u043E\u0440
      \u0441 \u0444\u043E\u043D\u0442\u0430\u043D\u043E\u043C. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438
      \u0432 \u043D\u0430\u0447\u0438\u0449\u0435\u043D\u043D\u044B\u0445 \u0448\u043B\u0435\u043C\u0430\u0445
      \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u044E\u0442 \u0432\u0430\u0441 \u043A
      \u0442\u0440\u043E\u043D\u043D\u043E\u043C\u0443 \u0432\u043E\u0437\u0432\u044B\u0448\u0435\u043D\u0438\u044E.
      \u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C \u2014 \u0433\u0440\u0443\u0437\u043D\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432 \u0431\u0435\u043B\u043E\u043C
      \u0442\u044E\u0440\u0431\u0430\u043D\u0435 \u0441 \u0438\u0437\u0443\u043C\u0440\u0443\u0434\u043D\u043E\u0439
      \u0437\u0430\u043A\u043E\u043B\u043A\u043E\u0439 \u2014 \u0441\u0438\u0434\u0438\u0442
      \u043D\u0430 \u043F\u043E\u0434\u0443\u0448\u043A\u0430\u0445 \u0438 \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0441 \u043B\u0435\u043D\u0438\u0432\u044B\u043C \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u0441\u0442\u0432\u043E\u043C.\r\n\r\n<npc_speech
      lang=\"Arabic\">\u041C\u0438\u0440 \u0442\u0435\u0431\u0435, \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446.
      \u041C\u043D\u0435 \u0434\u043E\u043D\u0435\u0441\u043B\u0438, \u0447\u0442\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0442\u0432\u043E\u0439 \u0434\u043E\u0441\u0442\u043E\u0438\u043D
      \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F. \u042F \u0436\u0435\u043B\u0430\u044E
      \u0432\u0438\u0434\u0435\u0442\u044C \u0442\u0432\u043E\u0438 \u0442\u043E\u0432\u0430\u0440\u044B
      \u2014 \u0438, \u0431\u044B\u0442\u044C \u043C\u043E\u0436\u0435\u0442, \u043C\u044B
      \u0437\u0430\u043A\u043B\u044E\u0447\u0438\u043C \u0441\u0434\u0435\u043B\u043A\u0443.</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643599
    m_Localized: "\u041F\u0440\u0435\u043F\u043E\u0434\u043D\u0435\u0441\u0442\u0438
      \u0441\u043A\u0440\u043E\u043C\u043D\u044B\u0439 \u0434\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643600
    m_Localized: "\u0412\u044B \u043A\u043B\u0430\u0434\u0451\u0442\u0435 \u043F\u0435\u0440\u0435\u0434
      \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u0435\u043C \u043A\u043E\u0448\u0435\u043B\u044C
      \u0441\u0435\u0440\u0435\u0431\u0440\u0430 \u0438 \u0441\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0435
      \u0433\u043E\u043B\u043E\u0432\u0443. \u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C
      \u0431\u043B\u0430\u0433\u043E\u0441\u043A\u043B\u043E\u043D\u043D\u043E \u043A\u0438\u0432\u0430\u0435\u0442,
      \u0431\u0435\u0440\u0451\u0442 \u043E\u0434\u043D\u0443 \u043C\u043E\u043D\u0435\u0442\u0443,
      \u0440\u0430\u0441\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442
      \u0447\u0435\u043A\u0430\u043D\u043A\u0443 \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442
      \u0432\u0438\u0437\u0438\u0440\u044E. \xAB\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0437\u043D\u0430\u0435\u0442 \u043E\u0431\u044B\u0447\u0430\u0438, \u2014
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D. \u2014 \u041F\u0443\u0441\u0442\u044C
      \u0442\u043E\u0440\u0433\u0443\u0435\u0442 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u043E.\xBB
      \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438 \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u044E\u0442
      \u0432\u0430\u0441 \u043A \u0432\u044B\u0445\u043E\u0434\u0443. \u0414\u0432\u0435\u0440\u0438
      \u0433\u043E\u0440\u043E\u0434\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u044B
      \u2014 \u0430 \u044D\u0442\u043E \u0434\u043E\u0440\u043E\u0436\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643601
    m_Localized: "\u041F\u0440\u043E\u0438\u0437\u0432\u0435\u0441\u0442\u0438 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435
      \u0440\u0435\u0447\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643602
    m_Localized: "\u0412\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u043E
      \u0434\u043E\u0440\u043E\u0433\u0430\u0445, \u043E \u0442\u043E\u043C, \u0447\u0442\u043E
      \u0432\u0438\u0434\u0435\u043B\u0438 \u043C\u0435\u0436\u0434\u0443 \u0427\u0430\u043D\u044A\u0430\u043D\u0435\u043C
      \u0438 \u044D\u0442\u0438\u043C \u0433\u043E\u0440\u043E\u0434\u043E\u043C,
      \u2014 \u043E \u0448\u0451\u043B\u043A\u0435 \u0438 \u0436\u0435\u043B\u0435\u0437\u0435,
      \u043E \u0431\u0443\u0440\u044F\u0445 \u0438 \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u0445,
      \u043E \u044F\u0437\u044B\u043A\u0430\u0445, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0443\u0447\u0438\u043B\u0438 \u0432 \u043F\u0443\u0442\u0438. \u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C
      \u0441\u043B\u0443\u0448\u0430\u0435\u0442, \u043F\u043E\u0434\u0430\u0432\u0448\u0438\u0441\u044C
      \u0432\u043F\u0435\u0440\u0451\u0434. \u0412\u0438\u0437\u0438\u0440\u044C
      \u0437\u0430\u0431\u044B\u043B \u043E \u0441\u0432\u043E\u0438\u0445 \u0437\u0430\u043F\u0438\u0441\u044F\u0445.
      \u041A\u043E\u0433\u0434\u0430 \u0432\u044B \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0435,
      \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C \u0445\u043B\u043E\u043F\u0430\u0435\u0442
      \u0432 \u043B\u0430\u0434\u043E\u0448\u0438: \xAB\u0422\u0430\u043A\u0438\u0445,
      \u043A\u0430\u043A \u0442\u044B, \u044F \u0434\u0430\u0432\u043D\u043E \u043D\u0435
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u043B. \u0412\u043E\u0442 \u0442\u0435\u0431\u0435
      \u043C\u043E\u0439 \u0437\u043D\u0430\u043A \u2014 \u043F\u043E\u043A\u0430\u0436\u0438
      \u043D\u0430 \u043B\u044E\u0431\u043E\u043C \u0431\u0430\u0437\u0430\u0440\u0435,
      \u0438 \u0442\u0435\u0431\u044F \u043F\u0440\u0438\u043C\u0443\u0442 \u043A\u0430\u043A
      \u0434\u0440\u0443\u0433\u0430 \u0434\u0432\u043E\u0440\u0446\u0430.\xBB \u041E\u043D
      \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u0441 \u043F\u0430\u043B\u044C\u0446\u0430
      \u0437\u043E\u043B\u043E\u0442\u043E\u0435 \u043A\u043E\u043B\u044C\u0446\u043E
      \u0438 \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0432\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643603
    m_Localized: "\u0412\u0430\u0448\u0438 \u0441\u043B\u043E\u0432\u0430 \u0437\u0432\u0443\u0447\u0430\u0442
      \u0437\u0430\u0443\u0447\u0435\u043D\u043D\u043E \u2014 \u0434\u0432\u043E\u0440\u0446\u043E\u0432\u044B\u0439
      \u044D\u0442\u0438\u043A\u0435\u0442 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u044F\u0437\u044B\u043A\u0430,
      \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0440\u0438\u0442\u043C\u0430.
      \u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C \u0445\u043C\u0443\u0440\u0438\u0442\u0441\u044F.
      \u0412\u0438\u0437\u0438\u0440\u044C \u0447\u0442\u043E-\u0442\u043E \u0448\u0435\u043F\u0447\u0435\u0442
      \u0435\u043C\u0443 \u043D\u0430 \u0443\u0445\u043E. \xAB\u0421\u0442\u0443\u043F\u0430\u0439,
      \u2014 \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C.
      \u2014 \u0418 \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0441\u044F
      \u0432 \u043C\u043E\u0451\u043C \u0433\u043E\u0440\u043E\u0434\u0435.\xBB \u041D\u0430
      \u0431\u0430\u0437\u0430\u0440\u0435 \u0432\u0430\u0441 \u0441\u0442\u043E\u0440\u043E\u043D\u044F\u0442\u0441\u044F
      \u2014 \u0441\u043B\u0443\u0445\u0438 \u0431\u0435\u0433\u0443\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u043D\u043E\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643604
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0432\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643605
    m_Localized: "\u0412\u0430\u0448 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u0448\u0430\u0433\u0430\u0435\u0442 \u0432\u043F\u0435\u0440\u0451\u0434,
      \u0432\u0441\u0442\u0430\u0451\u0442 \u043F\u043E \u0441\u0442\u043E\u0439\u043A\u0435
      \xAB\u0441\u043C\u0438\u0440\u043D\u043E\xBB \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u043A \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044E \u043D\u0430
      \u044F\u0437\u044B\u043A\u0435 \u0432\u043E\u0438\u043D\u043E\u0432 \u2014
      \u043A\u043E\u0440\u043E\u0442\u043A\u043E, \u0441 \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u043E\u043C.
      \u041E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0432\u0430\u0441,
      \u043F\u0435\u0440\u0435\u0447\u0438\u0441\u043B\u044F\u0435\u0442 \u0434\u043E\u0440\u043E\u0433\u0438,
      \u043F\u0440\u043E\u0439\u0434\u0435\u043D\u043D\u044B\u0435 \u0431\u0435\u0437
      \u043F\u043E\u0442\u0435\u0440\u044C, \u0438 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
      \u0437\u0430\u0441\u0430\u0434\u044B, \u043E\u0442\u0431\u0438\u0442\u044B\u0435
      \u043F\u043E\u0434 \u0435\u0433\u043E \u043D\u0430\u0447\u0430\u043B\u043E\u043C.
      \u041F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u044E\u0449\u0435
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430
      \u2014 \u0432\u044B\u043F\u0440\u0430\u0432\u043A\u0430, \u0448\u0440\u0430\u043C\u044B,
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439 \u0432\u0437\u0433\u043B\u044F\u0434
      \u2014 \u0438 \u043A\u0438\u0432\u0430\u0435\u0442. \xAB\u0427\u0435\u043B\u043E\u0432\u0435\u043A,
      \u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0440\u0443\u0447\u0430\u0435\u0442\u0441\u044F
      \u0442\u0430\u043A\u043E\u0439 \u0432\u043E\u0438\u043D, \u0434\u043E\u0441\u0442\u043E\u0438\u043D
      \u043C\u043E\u0435\u0433\u043E \u0434\u043E\u0432\u0435\u0440\u0438\u044F.\xBB
      \u0412\u0438\u0437\u0438\u0440\u044C \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
      \u0432\u0430\u0448\u0435 \u0438\u043C\u044F \u0432 \u043E\u0445\u0440\u0430\u043D\u043D\u0443\u044E
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443, \u0430 \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044C
      \u0436\u0435\u0441\u0442\u043E\u043C \u043F\u043E\u0434\u0437\u044B\u0432\u0430\u0435\u0442
      \u0441\u043B\u0443\u0433\u0443 \u0441 \u043F\u043E\u0434\u043D\u043E\u0441\u043E\u043C
      \u2014 \u0437\u043E\u043B\u043E\u0442\u043E\u0435 \u043E\u0436\u0435\u0440\u0435\u043B\u044C\u0435
      \u043B\u043E\u0436\u0438\u0442\u0441\u044F \u0432\u0430\u043C \u043D\u0430
      \u043B\u0430\u0434\u043E\u043D\u0438. \u0414\u0432\u043E\u0440 \u0440\u0430\u0441\u0441\u0442\u0443\u043F\u0430\u0435\u0442\u0441\u044F
      \u0441 \u043F\u043E\u0447\u0442\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643606
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442
      \u0432 \u043F\u043E\u0440\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643607
    m_Localized: "\u041F\u043E\u0440\u0442\u043E\u0432\u044B\u0439 \u043A\u0432\u0430\u0440\u0442\u0430\u043B
      \u043A \u0432\u0435\u0447\u0435\u0440\u0443 \u043F\u0430\u0445\u043D\u0435\u0442
      \u0441\u043C\u043E\u043B\u043E\u0439, \u0433\u043D\u0438\u044E\u0449\u0438\u043C\u0438
      \u0432\u043E\u0434\u043E\u0440\u043E\u0441\u043B\u044F\u043C\u0438 \u0438 \u0436\u0430\u0440\u0435\u043D\u043E\u0439
      \u0440\u044B\u0431\u043E\u0439. \u041C\u0435\u0436\u0434\u0443 \u0441\u043A\u043B\u0430\u0434\u043E\u0432,
      \u0433\u0434\u0435 \u0433\u0440\u043E\u043C\u043E\u0437\u0434\u044F\u0442\u0441\u044F
      \u0431\u043E\u0447\u043A\u0438 \u0438 \u0442\u044E\u043A\u0438, \u043A \u0432\u0430\u043C
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0436\u0438\u043B\u0438\u0441\u0442\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432 \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u043E\u043C
      \u0445\u0430\u043B\u0430\u0442\u0435 \u2014 \u043B\u0438\u0446\u043E \u043E\u0431\u0432\u0435\u0442\u0440\u0435\u043D\u043D\u043E\u0435,
      \u0440\u0443\u043A\u0438 \u0432 \u0434\u0451\u0433\u0442\u0435, \u0430 \u0433\u043B\u0430\u0437\u0430
      \u0431\u0435\u0433\u0430\u044E\u0442, \u043A\u0430\u043A \u0443 \u043A\u0440\u044B\u0441\u044B
      \u043C\u0435\u0436\u0434\u0443 \u043C\u0435\u0448\u043A\u043E\u0432. \u041E\u043D
      \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043F\u043E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C \u0438 \u043F\u043E\u043D\u0438\u0436\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0441:\r\n\r\n<npc_speech lang=\"Arabic\">\u042D\u0439,
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446! \u0423 \u043C\u0435\u043D\u044F
      \u0442\u043E\u0432\u0430\u0440 \u0438\u0437 \u0418\u043D\u0434\u0438\u0438
      \u2014 \u0448\u0430\u0444\u0440\u0430\u043D, \u0441\u043B\u043E\u043D\u043E\u0432\u0430\u044F
      \u043A\u043E\u0441\u0442\u044C, \u0436\u0435\u043C\u0447\u0443\u0433. \u0417\u0430
      \u043F\u043E\u043B\u0446\u0435\u043D\u044B, \u0431\u0435\u0437 \u043F\u043E\u0448\u043B\u0438\u043D.
      \u041D\u043E \u0440\u0435\u0448\u0430\u0439 \u0441\u043A\u043E\u0440\u0435\u0439
      \u2014 \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u0441\u0442\u0440\u0430\u0436\u0430
      \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F.</npc_speech>\r\n\r\n\u0428\u0430\u0444\u0440\u0430\u043D,
      \u0441\u043B\u043E\u043D\u043E\u0432\u0430\u044F \u043A\u043E\u0441\u0442\u044C,
      \u0436\u0435\u043C\u0447\u0443\u0433 \u2014 \u043F\u043E \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435, \u0431\u0435\u0437 \u043F\u043E\u0448\u043B\u0438\u043D.
      \u041D\u043E \u0441\u0442\u0440\u0430\u0436\u0430 \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435, \u0438 \u0435\u0441\u043B\u0438
      \u043F\u043E\u0439\u043C\u0430\u044E\u0442 \u0441 \u043A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u043E\u0439,
      \u0448\u0442\u0440\u0430\u0444\u043E\u043C \u043D\u0435 \u043E\u0442\u0434\u0435\u043B\u0430\u0435\u0448\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643608
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643609
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0435
      \u0440\u0443\u043A\u0438 \u043B\u0430\u0434\u043E\u043D\u044F\u043C\u0438 \u0432\u043F\u0435\u0440\u0451\u0434
      \u0438 \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0435\u0442\u0435. \xAB\u041C\u043D\u0435
      \u043D\u0438 \u043A \u0447\u0435\u043C\u0443 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0441\u0442\u0438
      \u0441 \u0437\u0430\u043A\u043E\u043D\u043E\u043C.\xBB \u041A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442
      \u0441\u043F\u043B\u0451\u0432\u044B\u0432\u0430\u0435\u0442, \u043F\u043E\u0434\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A \u0438 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044F\u0435\u0442\u0441\u044F
      \u043C\u0435\u0436\u0434\u0443 \u0441\u043A\u043B\u0430\u0434\u043E\u0432.
      \u0423\u0442\u0440\u043E\u043C \u043D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435
      \u0432\u044B \u0441\u043B\u044B\u0448\u0438\u0442\u0435, \u0447\u0442\u043E
      \u0441\u0442\u0440\u0430\u0436\u0430 \u0430\u0440\u0435\u0441\u0442\u043E\u0432\u0430\u043B\u0430
      \u043A\u043E\u0433\u043E-\u0442\u043E \u0441 \u043D\u0435\u043F\u043E\u0448\u043B\u0438\u043D\u043D\u044B\u043C
      \u0442\u043E\u0432\u0430\u0440\u043E\u043C. \u0425\u043E\u0440\u043E\u0448\u043E,
      \u0447\u0442\u043E \u044D\u0442\u043E \u0431\u044B\u043B\u0438 \u043D\u0435
      \u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643610
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643611
    m_Localized: "\u0412\u044B \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442\u0435
      \u0442\u043E\u0432\u0430\u0440 \u043F\u0440\u0438 \u0441\u0432\u0435\u0442\u0435
      \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0439 \u043B\u0430\u043C\u043F\u044B
      \u2014 \u0448\u0430\u0444\u0440\u0430\u043D \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439,
      \u043D\u0438\u0442\u0438 \u0434\u043B\u0438\u043D\u043D\u044B\u0435, \u0446\u0432\u0435\u0442
      \u0433\u0443\u0441\u0442\u043E\u0439. \u0411\u044B\u0441\u0442\u0440\u044B\u0439
      \u043E\u0431\u043C\u0435\u043D \u043C\u043E\u043D\u0435\u0442 \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435,
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A \u043F\u043E\u0434 \u043F\u043B\u0430\u0449
      \u2014 \u0438 \u0432\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u043F\u0435\u0440\u0435\u0443\u043B\u043A\u0430\u043C\u0438,
      \u043E\u0431\u0445\u043E\u0434\u044F \u043F\u0430\u0442\u0440\u0443\u043B\u0438.
      \u041A \u0443\u0442\u0440\u0443 \u0442\u043E\u0432\u0430\u0440 \u0441\u043F\u0440\u044F\u0442\u0430\u043D
      \u0441\u0440\u0435\u0434\u0438 \u0437\u0430\u043A\u043E\u043D\u043D\u043E\u0433\u043E
      \u0433\u0440\u0443\u0437\u0430, \u0438 \u043E\u0442\u043B\u0438\u0447\u0438\u0442\u044C
      \u0435\u0433\u043E \u043D\u0435\u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643612
    m_Localized: "\u0421\u0434\u0435\u043B\u043A\u0430 \u043F\u0440\u043E\u0448\u043B\u0430,
      \u043D\u043E \u043D\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u043C
      \u043F\u0443\u0442\u0438 \u0432\u0430\u0441 \u043E\u043A\u043B\u0438\u043A\u043D\u0443\u043B
      \u043F\u043E\u0440\u0442\u043E\u0432\u044B\u0439 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A.
      \u0421\u0432\u0451\u0440\u0442\u043E\u043A \u043D\u0430\u0448\u043B\u0438 \u043F\u0440\u0438
      \u043E\u0431\u044B\u0441\u043A\u0435 \u2014 \u0448\u0430\u0444\u0440\u0430\u043D
      \u0431\u0435\u0437 \u043F\u043E\u0448\u043B\u0438\u043D\u043D\u043E\u0439 \u043F\u0435\u0447\u0430\u0442\u0438.
      \u0428\u0442\u0440\u0430\u0444, \u043A\u043E\u043D\u0444\u0438\u0441\u043A\u0430\u0446\u0438\u044F
      \u0438 \u0432\u0430\u0448\u0435 \u0438\u043C\u044F \u0432 \u0447\u0451\u0440\u043D\u043E\u043C
      \u0441\u043F\u0438\u0441\u043A\u0435 \u043F\u043E\u0440\u0442\u0430. \u0422\u043E\u0440\u0433\u043E\u0432\u0446\u044B
      \u0448\u0435\u043F\u0447\u0443\u0442\u0441\u044F: \u0441 \u044D\u0442\u0438\u043C
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u043E\u043C \u0434\u0435\u043B\u0430
      \u043B\u0443\u0447\u0448\u0435 \u043D\u0435 \u0438\u043C\u0435\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643613
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442
      \u043B\u0435\u0433\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643614
    m_Localized: "\u0412\u0430\u0448 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u043C\u043E\u043B\u0447\u0430 \u043E\u0442\u043E\u0434\u0432\u0438\u0433\u0430\u0435\u0442
      \u0432\u0430\u0441 \u043F\u043B\u0435\u0447\u043E\u043C \u0438 \u0432\u0441\u0442\u0430\u0451\u0442
      \u043F\u0435\u0440\u0435\u0434 \u043A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442\u043E\u043C.
      \xAB\u041F\u043E\u043A\u0430\u0436\u0438 \u0442\u043E\u0432\u0430\u0440 \u2014
      \u0432\u0435\u0441\u044C\xBB, \u2014 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043E\u043D \u0442\u043E\u043D\u043E\u043C, \u043D\u0435 \u0442\u0435\u0440\u043F\u044F\u0449\u0438\u043C
      \u0432\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0439. \u041A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442
      \u043D\u0435\u0440\u0432\u043D\u043E \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u043A\u0430\u0436\u0434\u044B\u0439
      \u043C\u0435\u0448\u043E\u0447\u0435\u043A, \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0434\u0432\u0430 \u2014 \xAB\u043A\u0440\u0430\u0434\u0435\u043D\u044B\u0435,
      \u043A\u043B\u0435\u0439\u043C\u043E \u0441\u043E\u0441\u043A\u043E\u0431\u043B\u0435\u043D\u043E\xBB
      \u2014 \u0438 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043D\u0430
      \u0442\u0440\u0435\u0442\u0438\u0439: \xAB\u0412\u043E\u0442 \u044D\u0442\u043E
      \u0447\u0438\u0441\u0442\u044B\u0439, \u0431\u0435\u0437 \u043A\u043B\u0435\u0439\u043C\u0430
      \u043F\u043E\u0440\u0442\u0430-\u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F.
      \u0417\u0430\u043A\u043E\u043D\u043D\u0430\u044F \u0434\u043E\u0431\u044B\u0447\u0430,
      \u043F\u0440\u043E\u0441\u0442\u043E \u0431\u0435\u0437 \u043F\u043E\u0448\u043B\u0438\u043D\u044B.\xBB
      \u0412\u044B \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0442\u0435 \u0437\u0430
      \u0431\u0435\u0441\u0446\u0435\u043D\u043E\u043A, \u0430 \u043A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u0438\u0441\u0442
      \u0440\u0430\u0434, \u0447\u0442\u043E \u0443\u0448\u0451\u043B \u0441 \u0437\u0443\u0431\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643615
    m_Localized: "\u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u0433\u0438\u043B\u044C\u0434\u043C\u0430\u0441\u0442\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643616
    m_Localized: "\u041D\u0430 \u0441\u0442\u043E\u044F\u043D\u043A\u0435 \u043A
      \u0432\u0430\u043C \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0441\u043E\u0433\u0434\u0438\u0435\u0446
      \u0432 \u0442\u0451\u043C\u043D\u043E-\u0441\u0438\u043D\u0435\u043C \u043A\u0430\u0444\u0442\u0430\u043D\u0435
      \u0441 \u0437\u043E\u043B\u043E\u0442\u044B\u043C \u0448\u0438\u0442\u044C\u0451\u043C
      \u043F\u043E \u0432\u043E\u0440\u043E\u0442\u0443 \u2014 \u043D\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A,
      \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u043A\u0443\u043F\u0435\u0446.
      \u041F\u0430\u043B\u044C\u0446\u044B \u0443\u043D\u0438\u0437\u0430\u043D\u044B
      \u043F\u0435\u0440\u0441\u0442\u043D\u044F\u043C\u0438, \u043D\u043E \u0440\u0443\u043A\u0438
      \u0436\u0438\u043B\u0438\u0441\u0442\u044B\u0435, \u0440\u0430\u0431\u043E\u0447\u0438\u0435.
      \u041E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0441\u0435\u0431\u044F
      \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445 \u0441\u043B\u043E\u0432
      \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0442\u0430\u043A, \u043A\u0430\u043A
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0441\u0442\u0430\u0440\u044B\u0439
      \u0438\u0433\u0440\u043E\u043A, \u043D\u0430\u0448\u0435\u0434\u0448\u0438\u0439
      \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u043E\u0433\u043E
      \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u0430. \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434,
      \u0433\u0438\u043B\u044C\u0434\u0438\u044F, \u0434\u0435\u043D\u044C\u0433\u0438
      \u2014 \u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435,
      \u043E\u0442 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0435
      \u0443\u0445\u043E\u0434\u044F\u0442 \u0441 \u043B\u0451\u0433\u043A\u0438\u043C
      \u0441\u0435\u0440\u0434\u0446\u0435\u043C.\r\n\r\n<npc_speech lang=\"Sogdian\">\u041F\u0440\u0438\u0432\u0435\u0442,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A! \u042F \u0412\u0430\u0445\u0443-\u041C\u0430\u043D,
      \u0438\u0437 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0439 \u0433\u0438\u043B\u044C\u0434\u0438\u0438
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430. \u042F \u0432\u0438\u0434\u0435\u043B
      \u0442\u0432\u043E\u044E \u0440\u0430\u0431\u043E\u0442\u0443 \u2014 \u0434\u0435\u043B\u043E
      \u043B\u0430\u0434\u0438\u0442\u0441\u044F, \u0438\u043C\u044F \u043D\u0430
      \u0441\u043B\u0443\u0445\u0443. \u0415\u0441\u0442\u044C \u043F\u0443\u0442\u044C
      \u043E\u0442 \u041A\u0438\u0442\u0430\u044F \u0434\u043E \u0420\u0443\u043C\u0430
      \u2014 \u043F\u043E\u043B\u043D\u044B\u0439 \u0437\u043E\u043B\u043E\u0442\u0430,
      \u043F\u043E\u043B\u043D\u044B\u0439 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438.
      \u0425\u0432\u0430\u0442\u0438\u0442 \u043B\u0438 \u0443 \u0442\u0435\u0431\u044F
      \u0434\u0435\u0440\u0437\u043E\u0441\u0442\u0438?</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643617
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643618
    m_Localized: "\u0412\u044B \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u0435
      \u0412\u0430\u0445\u0443-\u041C\u0430\u043D\u0430 \u0438 \u043A\u0430\u0447\u0430\u0435\u0442\u0435
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439. \u0421\u043E\u0433\u0434\u0438\u0435\u0446
      \u043D\u0435 \u043D\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u0435\u0442 \u2014
      \u043A\u0438\u0432\u0430\u0435\u0442, \u043F\u0440\u044F\u0447\u0435\u0442
      \u0443\u043B\u044B\u0431\u043A\u0443 \u0432 \u0431\u043E\u0440\u043E\u0434\u0443
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442: \xAB\u0414\u043E\u0440\u043E\u0433\u0430
      \u0434\u043B\u0438\u043D\u043D\u0430. \u041C\u043E\u0436\u0435\u0442, \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F
      \u0441\u043D\u043E\u0432\u0430\xBB. \u041E\u043D \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044F\u0435\u0442\u0441\u044F
      \u0441\u0440\u0435\u0434\u0438 \u043F\u043E\u0432\u043E\u0437\u043E\u043A,
      \u0430 \u0432\u044B \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0435
      \u043F\u0443\u0442\u044C, \u043A\u0430\u043A \u043F\u0440\u0435\u0436\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643619
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643620
    m_Localized: "\u0412\u044B \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442\u0435
      \u0440\u0443\u043A\u0443 \u0412\u0430\u0445\u0443-\u041C\u0430\u043D\u0430
      \u0438 \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0435\u0442\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F
      \u2014 \u0437\u0430\u043B\u043E\u0433, \u043C\u0430\u0440\u0448\u0440\u0443\u0442,
      \u0434\u043E\u043B\u044E \u043F\u0440\u0438\u0431\u044B\u043B\u0438. \u041A\u0430\u0436\u0434\u044B\u0439
      \u0432\u0430\u0448 \u0434\u043E\u0432\u043E\u0434 \u043E\u043D \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u043A\u0438\u0432\u043A\u043E\u043C: \u0432\u0438\u0434\u043D\u043E, \u0447\u0442\u043E
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442 \u043D\u0435 \u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0446\u0438\u0444\u0440\u044B, \u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440. \u041A \u043A\u043E\u043D\u0446\u0443
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430 \u043E\u043D \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u0438\u0437-\u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u0438 \u0441\u0432\u0451\u0440\u043D\u0443\u0442\u0443\u044E
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443 \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438 \u0438 \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0432\u0430\u043C \u0432 \u0440\u0443\u043A\u0443. \xAB\u041F\u0435\u0440\u0432\u0430\u044F
      \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u2014 \u0434\u0435\u0441\u044F\u0442\u044C
      \u0442\u044E\u043A\u043E\u0432 \u0448\u0451\u043B\u043A\u0430 \u0438\u0437
      \u0427\u0430\u043D\u044A\u0430\u043D\u044F \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434.
      \u0421\u043F\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F \u2014 \u0434\u0430\u043B\u044C\u0448\u0435
      \u0431\u0443\u0434\u0435\u0442 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0435\u0435.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643621
    m_Localized: "\u0412\u044B \u043F\u044B\u0442\u0430\u0435\u0442\u0435\u0441\u044C
      \u043E\u0431\u0441\u0443\u0434\u0438\u0442\u044C \u0443\u0441\u043B\u043E\u0432\u0438\u044F,
      \u043D\u043E \u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u043C\u043E\u0440\u0449\u0438\u0442\u0441\u044F
      \u2014 \u0432\u0430\u0448\u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F
      \u0432\u044B\u0434\u0430\u044E\u0442 \u043D\u0435\u043E\u043F\u044B\u0442\u043D\u043E\u0441\u0442\u044C.
      \xAB\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C \u2014 \u043D\u0435
      \u0437\u043D\u0430\u0447\u0438\u0442 \u0441\u0447\u0438\u0442\u0430\u0442\u044C
      \u043C\u043E\u043D\u0435\u0442\u044B, \u0441\u0430\u0440\u0442\u0431\u0430\u0432.\xBB
      \u041E\u043D \u043C\u043E\u043B\u0447\u0438\u0442, \u0432\u0435\u0440\u0442\u044F
      \u0432 \u043F\u0430\u043B\u044C\u0446\u0430\u0445 \u043F\u0435\u0447\u0430\u0442\u043A\u0443,
      \u043F\u043E\u0442\u043E\u043C \u0432\u0437\u0434\u044B\u0445\u0430\u0435\u0442.
      \xAB\u041D\u043E \u0434\u043E\u0440\u043E\u0433\u0430 \u0443\u0447\u0438\u0442
      \u043B\u0443\u0447\u0448\u0435 \u0431\u0430\u0437\u0430\u0440\u0430. \u0412\u043E\u0442
      \u0433\u0440\u0430\u043C\u043E\u0442\u0430 \u2014 \u043F\u0435\u0440\u0432\u0430\u044F
      \u043F\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u0438\u0437 \u0427\u0430\u043D\u044A\u0430\u043D\u044F
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434. \u0417\u0430\u043B\u043E\u0433
      \u0443\u0432\u0435\u043B\u0438\u0447\u0443, \u0434\u043E\u043B\u044E \u0443\u043C\u0435\u043D\u044C\u0448\u0443.
      \u041D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F \u2014 \u0432\u0435\u0440\u043D\u0438
      \u0431\u0443\u043C\u0430\u0433\u0443.\xBB \u041E\u043D \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A \u0432\u0430\u043C \u0432 \u0440\u0443\u043A\u0443,
      \u043D\u043E \u0442\u043E\u043D \u0435\u0433\u043E \u044F\u0441\u0435\u043D:
      \u0432\u044B \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0435 \u0441
      \u0445\u0443\u0434\u0448\u0438\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u0439,
      \u0438 \u043A\u0430\u0436\u0434\u044B\u0439 \u043F\u0440\u043E\u043C\u0430\u0445
      \u043E\u0431\u043E\u0439\u0434\u0451\u0442\u0441\u044F \u0434\u043E\u0440\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643622
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442
      \u0432\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643623
    m_Localized: "\u0412\u0430\u0448 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u0448\u0430\u0433\u0430\u0435\u0442 \u0432\u043F\u0435\u0440\u0451\u0434 \u0438
      \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0441
      \u0412\u0430\u0445\u0443-\u041C\u0430\u043D\u043E\u043C \u0440\u0443\u043A\u043E\u043F\u043E\u0436\u0430\u0442\u0438\u0435\u043C
      \u2014 \u043E\u043D\u0438, \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0437\u043D\u0430\u043A\u043E\u043C\u044B \u043F\u043E \u0411\u0443\u0445\u0430\u0440\u0441\u043A\u043E\u043C\u0443
      \u0431\u0430\u0437\u0430\u0440\u0443. <npc_speech lang=\"Sogdian\">\u0420\u0430\u0445\u0448,
      \u0441\u0442\u0430\u0440\u044B\u0439 \u043B\u0438\u0441! \u0421\u043A\u043E\u043B\u044C\u043A\u043E
      \u043B\u0435\u0442, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043E\u0440\u043E\u0433!</npc_speech>
      \u0421\u043C\u0435\u0445, \u0445\u043B\u043E\u043F\u043E\u043A \u043F\u043E
      \u043F\u043B\u0435\u0447\u0443 \u2014 \u0438 \u0432\u043E\u0442 \u0412\u0430\u0445\u0443-\u041C\u0430\u043D
      \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0433\u0440\u0430\u043C\u043E\u0442\u0443
      \u0431\u0435\u0437 \u0432\u0441\u044F\u043A\u043E\u0433\u043E \u0442\u043E\u0440\u0433\u0430.
      \xAB\u0415\u0441\u043B\u0438 \u0420\u0430\u0445\u0448 \u0437\u0430 \u0442\u0435\u0431\u044F
      \u0440\u0443\u0447\u0430\u0435\u0442\u0441\u044F \u2014 \u0437\u043D\u0430\u0447\u0438\u0442,
      \u0442\u044B \u0438\u0437 \u043D\u0430\u0448\u0438\u0445.\xBB \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u043F\u043E\u0434\u043C\u0438\u0433\u0438\u0432\u0430\u0435\u0442 \u0432\u0430\u043C:
      \xAB\u041D\u0435 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438. \u041F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0435 \u043F\u043E\u0434\u0432\u0435\u0434\u0438.\xBB \u0413\u0438\u043B\u044C\u0434\u0438\u044F
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043F\u0435\u0440\u0435\u0434
      \u0432\u0430\u043C\u0438 \u043F\u0443\u0442\u044C \u043A \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044E
      \u2014 \u043D\u0430\u0447\u0430\u043B\u043E \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0438\u0433\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643624
    m_Localized: "\u0413\u043E\u043B\u043E\u0441 \u0441 \u0432\u0435\u0440\u0448\u0438\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643625
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u0432\u044B\u0432\u043E\u0434\u0438\u0442
      \u043A \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u043C\u0443 \u0433\u043E\u0440\u043D\u043E\u043C\u0443
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044E \u2014 \u0431\u0435\u043B\u0451\u043D\u044B\u0435
      \u0441\u0442\u0435\u043D\u044B, \u043A\u0440\u044B\u0448\u0430 \u0438\u0437
      \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0445 \u043F\u043B\u0438\u0442,
      \u043C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u0444\u043B\u0430\u0433\u0438
      \u0442\u0440\u0435\u0449\u0430\u0442 \u043D\u0430 \u0432\u0435\u0442\u0440\u0443
      \u043C\u0435\u0436\u0434\u0443 \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u043C\u0438
      \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u043C\u0438. \u0423 \u0432\u0445\u043E\u0434\u0430
      \u0441\u0438\u0434\u0438\u0442 \u043C\u043E\u043D\u0430\u0445 \u043F\u0440\u0435\u043A\u043B\u043E\u043D\u043D\u044B\u0445
      \u043B\u0435\u0442 \u0432 \u0431\u0430\u0433\u0440\u044F\u043D\u043E\u0439
      \u043A\u0430\u0448\u0430\u0435, \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u044F
      \u0447\u0451\u0442\u043A\u0438 \u0438\u0437 \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
      \u043A\u043E\u0441\u0442\u0438. \u041B\u0438\u0446\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E,
      \u043A\u0430\u043A \u0433\u043E\u0440\u043D\u043E\u0435 \u043E\u0437\u0435\u0440\u043E,
      \u043D\u043E \u0433\u043B\u0430\u0437\u0430 \u2014 \u0436\u0438\u0432\u044B\u0435,
      \u043F\u0440\u043E\u043D\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435.
      \u041E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0432\u0437\u0433\u043B\u044F\u0434
      \u043D\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0438 \u0432\u0441\u0442\u0430\u0451\u0442,
      \u0441\u043B\u043E\u0432\u043D\u043E \u0436\u0434\u0430\u043B \u0438\u043C\u0435\u043D\u043D\u043E
      \u0432\u0430\u0441.\r\n\r\n<npc_speech lang=\"Tibetan\">\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E,
      \u0433\u043E\u0441\u0442\u044C! \u042F \u041B\u043E\u0431\u0441\u0430\u043D\u0433.
      \u0412\u043E \u0441\u043D\u0435 \u044F \u0432\u0438\u0434\u0435\u043B \u0442\u0432\u043E\u0439
      \u043F\u0440\u0438\u0445\u043E\u0434. \u0415\u0441\u0442\u044C \u043E\u0434\u0438\u043D
      \u0445\u0440\u0430\u043C \u2014 \u0441\u043E\u043A\u0440\u044B\u0442\u044B\u0439
      \u0432 \u0433\u043E\u0440\u0430\u0445 \u2014 \u0442\u0430\u043C \u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F
      \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0435
      \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0441\u0443\u0434\u044C\u0431\u0443
      \u043F\u0443\u0442\u043D\u0438\u043A\u0430. \u0422\u0435\u0431\u0435 \u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442
      \u0438\u0434\u0442\u0438!</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643626
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u0438 \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643627
    m_Localized: "\u0412\u044B \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0435\u0441\u044C
      \u043C\u043E\u043D\u0430\u0445\u0443 \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0435
      \u043F\u0443\u0442\u044C. \u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u043D\u0435
      \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u2014 \u043B\u0438\u0448\u044C
      \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043B\u0430\u0434\u043E\u043D\u0438
      \u0438 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442 \u0432\u0441\u043B\u0435\u0434
      \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435.
      \u041C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u0444\u043B\u0430\u0433\u0438
      \u0442\u0440\u0435\u0449\u0430\u0442 \u043D\u0430 \u0432\u0435\u0442\u0440\u0443,
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043F\u043E\u0437\u0430\u0434\u0438. \u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C,
      \u0434\u043E\u0440\u043E\u0433\u0430 \u043F\u0440\u0438\u0432\u0435\u0434\u0451\u0442
      \u0432\u0430\u0441 \u0441\u044E\u0434\u0430 \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643628
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0432\u0438\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643629
    m_Localized: "\u0412\u044B \u0441\u0430\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432
      \u041B\u043E\u0431\u0441\u0430\u043D\u0433\u0430, \u0438 \u043E\u043D \u0434\u043E\u043B\u0433\u043E
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u0430\u043C \u0432 \u0433\u043B\u0430\u0437\u0430
      \u2014 \u043C\u043E\u043B\u0447\u0430, \u043D\u0435 \u043C\u0438\u0433\u0430\u044F.
      \u041F\u043E\u0442\u043E\u043C \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F
      \u0438 \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0438\u0437-\u0437\u0430
      \u043F\u0430\u0437\u0443\u0445\u0438 \u0441\u0432\u0438\u0442\u043E\u043A,
      \u043E\u0431\u0451\u0440\u043D\u0443\u0442\u044B\u0439 \u0432 \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u0432\u0443\u044E
      \u0442\u043A\u0430\u043D\u044C. \xAB\u0412\u0438\u0436\u0443 \u2014 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0442\u0435\u0431\u044F \u043D\u0435 \u0441\u043B\u043E\u043C\u0430\u043B\u0430.
      \u0414\u043E\u0441\u0442\u0430\u0432\u044C \u044D\u0442\u043E \u0432 \u0410\u043D\u044C\u0441\u0438,
      \u0432 \u043F\u0435\u0449\u0435\u0440\u044B \u041C\u043E\u0433\u0430\u043E.
      \u041C\u043E\u043D\u0430\u0445 \u043F\u043E \u0438\u043C\u0435\u043D\u0438
      \u0422\u0438\u043D\u043B\u0435\u0439 \u043F\u0440\u0438\u043C\u0435\u0442 \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435.\xBB
      \u041E\u043D \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u0432
      \u0432\u0430\u0448\u0443 \u0440\u0443\u043A\u0443 \u0441\u0432\u0438\u0442\u043E\u043A
      \u0438 \u043F\u0430\u043B\u043E\u0447\u043A\u0443 \u043B\u0430\u0434\u0430\u043D\u0430.
      \xAB\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u0436\u0433\u0438 \u2014
      \u0437\u0430\u043F\u0430\u0445 \u043E\u0442\u0433\u043E\u043D\u0438\u0442 \u0437\u043B\u043E.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643630
    m_Localized: "\u0412\u044B \u0441\u0430\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432
      \u041B\u043E\u0431\u0441\u0430\u043D\u0433\u0430, \u043D\u043E \u043F\u043E\u0434
      \u0435\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043D\u0435 \u043F\u043E \u0441\u0435\u0431\u0435. \u0421\u043B\u043E\u0432\u0430
      \u043F\u0443\u0442\u0430\u044E\u0442\u0441\u044F, \u043C\u044B\u0441\u043B\u0438
      \u0440\u0430\u0437\u0431\u0435\u0433\u0430\u044E\u0442\u0441\u044F \u2014 \u0442\u043E
      \u043B\u0438 \u0432\u044B\u0441\u043E\u0442\u0430, \u0442\u043E \u043B\u0438
      \u0447\u0442\u043E-\u0442\u043E \u0438\u043D\u043E\u0435. \u041C\u043E\u043D\u0430\u0445
      \u0434\u043E\u043B\u0433\u043E \u043C\u043E\u043B\u0447\u0438\u0442. \u041F\u043E\u0442\u043E\u043C
      \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0441\u0432\u0438\u0442\u043E\u043A,
      \u043E\u0431\u0451\u0440\u043D\u0443\u0442\u044B\u0439 \u0432 \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u0432\u0443\u044E
      \u0442\u043A\u0430\u043D\u044C, \u0438 \u043A\u043B\u0430\u0434\u0451\u0442
      \u043D\u0430 \u0437\u0435\u043C\u043B\u044E \u043C\u0435\u0436\u0434\u0443
      \u0432\u0430\u043C\u0438. \xAB\u042F \u0432\u0438\u0436\u0443 \u2014 \u0442\u044B
      \u043D\u0435 \u0433\u043E\u0442\u043E\u0432. \u041D\u043E \u0441\u0432\u0438\u0442\u043E\u043A
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0436\u0434\u0430\u0442\u044C,
      \u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u044B \u0438\u0434\u0443\u0442
      \u043D\u0430 \u044E\u0433 \u0432\u0441\u0451 \u0440\u0435\u0436\u0435.\xBB
      \u041E\u043D \u043D\u0435 \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0441\u0432\u0438\u0442\u043E\u043A \u0432 \u0440\u0443\u043A\u0443 \u2014
      \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u043D\u0430 \u043A\u0430\u043C\u043D\u0435. \u041B\u0430\u0434\u0430\u043D\u0430
      \u043D\u0435 \u0434\u0430\u0451\u0442. \xAB\u041B\u0430\u0434\u0430\u043D \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u044E\u0442
      \u0442\u0435, \u043A\u0442\u043E \u043D\u0435\u0441\u0451\u0442 \u0441\u0432\u0435\u0442.
      \u0422\u044B \u043F\u043E\u043A\u0430 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0435\u0441\u0451\u0448\u044C \u0433\u0440\u0443\u0437. \u0414\u043E\u0441\u0442\u0430\u0432\u044C
      \u0441\u0432\u0438\u0442\u043E\u043A \u0432 \u0410\u043D\u044C\u0441\u0438,
      \u0432 \u043F\u0435\u0449\u0435\u0440\u044B \u041C\u043E\u0433\u0430\u043E
      \u2014 \u043C\u043E\u043D\u0430\u0445\u0443 \u043F\u043E \u0438\u043C\u0435\u043D\u0438
      \u0422\u0438\u043D\u043B\u0435\u0439. \u0415\u0441\u043B\u0438 \u0434\u043E\u0440\u043E\u0433\u0430
      \u043D\u0435 \u0441\u043B\u043E\u043C\u0430\u0435\u0442 \u0442\u0435\u0431\u044F,
      \u043C\u043E\u0436\u0435\u0442, \u043D\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u043C
      \u043F\u0443\u0442\u0438 \u0442\u044B \u0431\u0443\u0434\u0435\u0448\u044C
      \u0434\u0440\u0443\u0433\u0438\u043C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643631
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0441 \u043C\u043E\u043D\u0430\u0445\u043E\u043C \u043D\u0430 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643632
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043A \u041B\u043E\u0431\u0441\u0430\u043D\u0433\u0443
      \u043D\u0430 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u043C \u2014
      \u0431\u0435\u0433\u043B\u043E, \u0441 \u043F\u043E\u0447\u0442\u0435\u043D\u0438\u0435\u043C:
      <npc_speech lang=\"Tibetan\">\u041F\u043E\u0447\u0442\u0435\u043D\u043D\u044B\u0439
      \u041B\u043E\u0431\u0441\u0430\u043D\u0433, \u043C\u044B \u043F\u0440\u0438\u0448\u043B\u0438
      \u0441 \u043C\u0438\u0440\u043E\u043C. \u041C\u043E\u0439 \u0433\u043E\u0441\u043F\u043E\u0434\u0438\u043D
      \u0433\u043E\u0442\u043E\u0432 \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u0442\u044C
      \u0432\u0430\u0448\u0435 \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435.</npc_speech>
      \u0421\u0442\u0430\u0440\u0438\u043A \u0441\u0432\u0435\u0442\u043B\u0435\u0435\u0442
      \u043B\u0438\u0446\u043E\u043C \u0438 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u0435\u0442
      \u043E\u0431\u043E\u0438\u0445 \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C.
      \u0417\u0430 \u0447\u0430\u0448\u043A\u043E\u0439 \u0441\u043E\u043B\u0451\u043D\u043E\u0433\u043E
      \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0433\u043E \u0447\u0430\u044F \u043E\u043D
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043E
      \u0445\u0440\u0430\u043C\u0435 \u0432 \u0433\u043E\u0440\u0430\u0445, \u043E
      \u0441\u0432\u0438\u0442\u043A\u0435 \u0438 \u043E \u043F\u0443\u0442\u0438,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0436\u0434\u0451\u0442 \u0432\u043F\u0435\u0440\u0435\u0434\u0438.
      \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442
      \u043A\u0430\u0436\u0434\u043E\u0435 \u0441\u043B\u043E\u0432\u043E, \u0430
      \u0432\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435,
      \u043A\u0430\u043A \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0435 \u0444\u0440\u0430\u0437\u044B
      \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0433\u043E\u043B\u043E\u0432\u0435. \u041B\u043E\u0431\u0441\u0430\u043D\u0433
      \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u0432\u0430\u043C \u0441\u0432\u0438\u0442\u043E\u043A
      \u0438 \u043F\u0430\u043B\u043E\u0447\u043A\u0443 \u043B\u0430\u0434\u0430\u043D\u0430
      \u0441 \u043B\u0451\u0433\u043A\u0438\u043C \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C.
      \xAB\u0422\u0432\u043E\u0439 \u0441\u043F\u0443\u0442\u043D\u0438\u043A \u2014
      \u043C\u043E\u0441\u0442 \u043C\u0435\u0436\u0434\u0443 \u043C\u0438\u0440\u0430\u043C\u0438.
      \u0411\u0435\u0440\u0435\u0433\u0438 \u0435\u0433\u043E.\xBB \u0412\u044B \u043F\u043E\u043A\u0438\u0434\u0430\u0435\u0442\u0435
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u0441 \u043D\u043E\u0432\u044B\u043C
      \u0437\u0430\u0434\u0430\u043D\u0438\u0435\u043C \u0438 \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435\u043C,
      \u0447\u0442\u043E \u0433\u043E\u0440\u044B \u043F\u0440\u0438\u043D\u044F\u043B\u0438
      \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643633
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643634
    m_Localized: "\u041D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435 \u043A
      \u0432\u0430\u0448\u0435\u043C\u0443 \u043A\u043E\u0441\u0442\u0440\u0443 \u043F\u043E\u0434\u0441\u0430\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u0442\u0430\u0440\u0438\u043A \u2014 \u0441\u0443\u0445\u043E\u0439,
      \u0436\u0438\u043B\u0438\u0441\u0442\u044B\u0439, \u0441 \u043B\u0438\u0446\u043E\u043C,
      \u0432\u044B\u0442\u0435\u0441\u0430\u043D\u043D\u044B\u043C \u0432\u0435\u0442\u0440\u043E\u043C
      \u0438 \u0441\u043E\u043B\u043D\u0446\u0435\u043C \u0434\u043E \u0446\u0432\u0435\u0442\u0430
      \u0441\u0442\u0430\u0440\u043E\u0439 \u043A\u043E\u0436\u0438. \u041B\u0435\u0432\u0430\u044F
      \u0440\u0443\u043A\u0430 \u0438\u0441\u043A\u0430\u043B\u0435\u0447\u0435\u043D\u0430
      \u2014 \u0434\u0432\u0430 \u043F\u0430\u043B\u044C\u0446\u0430 \u043D\u0435
      \u0433\u043D\u0443\u0442\u0441\u044F, \u0441\u043B\u0435\u0434\u044B \u0441\u0442\u0430\u0440\u043E\u0433\u043E
      \u043E\u0436\u043E\u0433\u0430. \u041E\u043D \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0414\u0430\u0440\u0438\u0443\u0448\u0435\u043C \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u0447\u0442\u043E \u0432\u043E\u0434\u0438\u043B \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u044B
      \u0441\u043E\u0440\u043E\u043A \u043B\u0435\u0442, \u043E\u0442 \u0427\u0430\u043D\u044A\u0430\u043D\u044F
      \u0434\u043E \u0411\u0430\u0433\u0434\u0430\u0434\u0430, \u0447\u0435\u0440\u0435\u0437
      \u043F\u0435\u0441\u043A\u0438 \u0438 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u044B,
      \u0447\u0435\u0440\u0435\u0437 \u0432\u043E\u0439\u043D\u044B \u0438 \u0447\u0443\u043C\u0443.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043E\u043D \u0441\u0442\u0430\u0440
      \u0438 \u0438\u0449\u0435\u0442 \u043F\u0440\u0435\u0435\u043C\u043D\u0438\u043A\u0430
      \u2014 \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u0441\u043C\u043E\u0436\u0435\u0442
      \u043F\u0440\u043E\u0439\u0442\u0438 \u0435\u0433\u043E \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u0438 \u0441\u0442\u0430\u0442\u044C \u043B\u0435\u0433\u0435\u043D\u0434\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433. \u041E\u043D \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u0438\u0437 \u043C\u0435\u0448\u043A\u0430 \u043F\u043E\u043B\u043E\u0441\u043A\u0443
      \u0432\u044F\u043B\u0435\u043D\u043E\u0433\u043E \u043C\u044F\u0441\u0430,
      \u0440\u0430\u0437\u043B\u0430\u043C\u044B\u0432\u0430\u0435\u0442 \u043F\u043E\u043F\u043E\u043B\u0430\u043C
      \u0438 \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0432\u0430\u043C.
      \u0421\u0442\u0430\u0440\u0438\u043A \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442
      \u2014 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0438 \u0436\u0434\u0451\u0442 \u043E\u0442\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643635
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643636
    m_Localized: "\u0412\u044B \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u0435
      \u0414\u0430\u0440\u0438\u0443\u0448\u0430, \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442\u0435
      \u043C\u044F\u0441\u043E \u0438 \u0441\u043B\u0443\u0448\u0430\u0435\u0442\u0435
      \u0435\u0433\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B \u0434\u043E
      \u043F\u043E\u043B\u0443\u043D\u043E\u0447\u0438 \u2014 \u043E \u043F\u0435\u0441\u0447\u0430\u043D\u044B\u0445
      \u0431\u0443\u0440\u044F\u0445 \u043F\u043E\u0434 \u041A\u0430\u0448\u0433\u0430\u0440\u043E\u043C,
      \u043E \u0432\u043E\u043B\u043A\u0430\u0445 \u043D\u0430 \u041F\u0430\u043C\u0438\u0440\u0435,
      \u043E \u0447\u0443\u043C\u0435 \u0432 \u041C\u0435\u0448\u0445\u0435\u0434\u0435.
      \u0425\u043E\u0440\u043E\u0448\u0438\u0435 \u0438\u0441\u0442\u043E\u0440\u0438\u0438,
      \u043D\u043E \u043D\u0435 \u0432\u0430\u0448\u0430 \u0434\u043E\u0440\u043E\u0433\u0430.
      \u0421\u0442\u0430\u0440\u0438\u043A \u043A\u0438\u0432\u0430\u0435\u0442 \u0431\u0435\u0437
      \u043E\u0431\u0438\u0434\u044B, \u0434\u043E\u043F\u0438\u0432\u0430\u0435\u0442
      \u0447\u0430\u0439 \u0438 \u0443\u0445\u043E\u0434\u0438\u0442 \u0437\u0430\u0442\u0435\u043C\u043D\u043E.
      \u041C\u043E\u0436\u0435\u0442, \u0432\u044B \u0435\u0449\u0451 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643637
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0432\u044B\u0437\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643638
    m_Localized: "\u0412\u044B \u0431\u0435\u0440\u0451\u0442\u0435 \u043C\u044F\u0441\u043E,
      \u043E\u0442\u043A\u0443\u0441\u044B\u0432\u0430\u0435\u0442\u0435 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
      \u0441\u0442\u0430\u0440\u0438\u043A\u0443 \u0432 \u0433\u043B\u0430\u0437\u0430.
      \u0414\u0430\u0440\u0438\u0443\u0448 \u0443\u0441\u043C\u0435\u0445\u0430\u0435\u0442\u0441\u044F
      \u2014 \u0432 \u044D\u0442\u043E\u043C \u0436\u0435\u0441\u0442\u0435 \u043E\u043D
      \u043F\u0440\u043E\u0447\u0451\u043B \u0432\u0441\u0451, \u0447\u0442\u043E
      \u0445\u043E\u0442\u0435\u043B. \u0414\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430
      \u043E\u043D \u0440\u0438\u0441\u0443\u0435\u0442 \u043D\u0430 \u0437\u0435\u043C\u043B\u0435
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u2014 \u043A\u0430\u0436\u0434\u044B\u0439
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B, \u043A\u0430\u0436\u0434\u044B\u0439
      \u043A\u043E\u043B\u043E\u0434\u0435\u0446, \u043A\u0430\u0436\u0434\u0443\u044E
      \u0437\u0430\u0441\u0430\u0434\u0443, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u043F\u043E\u043C\u043D\u0438\u0442 \u0437\u0430 \u0441\u043E\u0440\u043E\u043A
      \u043B\u0435\u0442. \u0412\u044B \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442\u0435.
      \u0423\u0445\u043E\u0434\u044F, \u043E\u043D \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u043C\u0435\u0448\u043E\u043A \u0432\u044F\u043B\u0435\u043D\u043E\u0433\u043E
      \u043C\u044F\u0441\u0430 \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0447\u0435\u0440\u0435\u0437 \u043F\u043B\u0435\u0447\u043E: \xAB\u041F\u0435\u0440\u0432\u044B\u0439
      \u043A\u043E\u043D\u0432\u043E\u0439 \u2014 \u0434\u043E\u0432\u0435\u0441\u0442\u0438
      \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432 \u0434\u043E \u0410\u043D\u044C\u0441\u0438.
      \u0421\u043F\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F \u2014 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C
      \u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0445 \u0434\u043E\u0440\u043E\u0433\u0430\u0445.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643639
    m_Localized: "\u0412\u044B \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0435\u0441\u044C,
      \u0438 \u0414\u0430\u0440\u0438\u0443\u0448 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u0440\u0430\u0441\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C
      \u2014 \u043E \u0434\u043E\u0440\u043E\u0433\u0430\u0445, \u043E \u0441\u043B\u0435\u0434\u0430\u0445,
      \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043B\u0430\u0433\u0435\u0440\u044C \u043D\u0430 \u0441\u043A\u043B\u043E\u043D\u0435.
      \u0412\u0430\u0448\u0438 \u043E\u0442\u0432\u0435\u0442\u044B \u0435\u0433\u043E
      \u043D\u0435 \u0443\u0431\u0435\u0436\u0434\u0430\u044E\u0442. \u041E\u043D
      \u0445\u043C\u0443\u0440\u0438\u0442\u0441\u044F \u0438 \u0434\u043E\u043B\u0433\u043E
      \u043C\u043E\u043B\u0447\u0438\u0442, \u0433\u043B\u044F\u0434\u044F \u0432
      \u043E\u0433\u043E\u043D\u044C. \xAB\u0422\u044B \u043D\u0435 \u0443\u043C\u0435\u0435\u0448\u044C
      \u0447\u0438\u0442\u0430\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0443.
      \u041D\u043E \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432 \u043A\u0442\u043E-\u0442\u043E
      \u0434\u043E\u043B\u0436\u0435\u043D \u0434\u043E\u0432\u0435\u0441\u0442\u0438
      \u0434\u043E \u0410\u043D\u044C\u0441\u0438, \u0430 \u043C\u043E\u0451 \u043A\u043E\u043B\u0435\u043D\u043E
      \u0443\u0436\u0435 \u043D\u0435 \u0433\u043D\u0451\u0442\u0441\u044F \u0434\u043B\u044F
      \u0441\u0435\u0434\u043B\u0430.\xBB \u041E\u043D \u0432\u0441\u0442\u0430\u0451\u0442
      \u0438 \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u0441\u0432\u043E\u0439
      \u043C\u0435\u0448\u043E\u043A \u0441 \u043C\u044F\u0441\u043E\u043C. \u041A\u0430\u0440\u0442\u0443
      \u0440\u0438\u0441\u0443\u0435\u0442 \u2014 \u043D\u043E \u043A\u0440\u0438\u0432\u0443\u044E,
      \u0431\u0435\u0437 \u0434\u0435\u0442\u0430\u043B\u0435\u0439: \xAB\u041E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u0443\u0437\u043D\u0430\u0435\u0448\u044C \u0441\u0430\u043C, \u0435\u0441\u043B\u0438
      \u0434\u043E\u0436\u0438\u0432\u0451\u0448\u044C.\xBB \u041C\u0430\u0440\u0448\u0440\u0443\u0442\u0430
      \u0442\u043E\u043B\u043A\u043E\u043C \u043D\u0435\u0442, \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432
      \u043E\u043D \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0438\u043B, \u0430
      \u0432 \u0435\u0433\u043E \u0433\u043E\u043B\u043E\u0441\u0435 \u0432\u043C\u0435\u0441\u0442\u043E
      \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F \u2014 \u0443\u0441\u0442\u0430\u043B\u043E\u0435
      \xAB\u043D\u0430 \u0431\u0435\u0437\u0440\u044B\u0431\u044C\u0435\xBB. \u0417\u0430\u0434\u0430\u043D\u0438\u0435
      \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438, \u043D\u043E
      \u0431\u0435\u0437 \u043A\u0430\u0440\u0442\u044B \u0414\u0430\u0440\u0438\u0443\u0448\u0430
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0441\u0442\u0430\u043B\u0430 \u043E\u043F\u0430\u0441\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643640
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u0414\u0430\u0440\u0438\u0443\u0448\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643641
    m_Localized: "\u0412\u0430\u0448 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0437\u0430\u043C\u0438\u0440\u0430\u0435\u0442, \u0443\u0432\u0438\u0434\u0435\u0432
      \u0441\u0442\u0430\u0440\u0438\u043A\u0430, \u0430 \u043F\u043E\u0442\u043E\u043C
      \u0448\u0438\u0440\u043E\u043A\u043E \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F.
      \xAB\u0414\u0430\u0440\u0438\u0443\u0448-\u0430\u0433\u0430! \u042D\u0442\u043E
      \u0442\u044B \u0443\u0447\u0438\u043B \u043C\u0435\u043D\u044F \u0447\u0438\u0442\u0430\u0442\u044C
      \u0441\u043B\u0435\u0434\u044B \u043F\u043E\u0434 \u041A\u0430\u0448\u0433\u0430\u0440\u043E\u043C
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434!\xBB
      \u0421\u0442\u0430\u0440\u0438\u043A \u0441\u043C\u043E\u0442\u0440\u0438\u0442,
      \u0449\u0443\u0440\u0438\u0442\u0441\u044F \u2014 \u0438 \u0432\u0434\u0440\u0443\u0433
      \u0445\u043E\u0445\u043E\u0447\u0435\u0442, \u0445\u043B\u043E\u043F\u0430\u044F
      \u0441\u0435\u0431\u044F \u043F\u043E \u043A\u043E\u043B\u0435\u043D\u0443.
      \xAB\u041C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0437\u0430\u0431\u043B\u0443\u0434\u0438\u043B\u0441\u044F \u0432 \u0442\u0440\u0451\u0445
      \u0431\u0430\u0440\u0445\u0430\u043D\u0430\u0445? \u0412\u044B\u0440\u043E\u0441!\xBB
      \u041E\u043D\u0438 \u043E\u0431\u043D\u0438\u043C\u0430\u044E\u0442\u0441\u044F,
      \u0438 \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0439 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u0438\u0434\u0451\u0442 \u043B\u0435\u0433\u043A\u043E \u2014 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0440\u0443\u0447\u0430\u0435\u0442\u0441\u044F \u0437\u0430 \u0432\u0430\u0441,
      \u0414\u0430\u0440\u0438\u0443\u0448 \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u043A\u0430\u0440\u0442\u0443 \u0438 \u043C\u0435\u0448\u043E\u043A \u0432\u044F\u043B\u0435\u043D\u043E\u0433\u043E
      \u043C\u044F\u0441\u0430, \u0438 \u043A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443
      \u0443 \u0432\u0430\u0441 \u0435\u0441\u0442\u044C \u0437\u0430\u0434\u0430\u043D\u0438\u0435,
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0438 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u0437\u043D\u0430\u044E\u0449\u0435\u0433\u043E
      \u043A\u0430\u0436\u0434\u044B\u0439 \u043A\u0430\u043C\u0435\u043D\u044C \u043E\u0442
      \u0427\u0430\u043D\u044A\u0430\u043D\u044F \u0434\u043E \u0411\u0430\u0433\u0434\u0430\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643642
    m_Localized: "\u0421\u0435\u043A\u0440\u0435\u0442 \u043A\u0440\u0430\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643643
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u043F\u0440\u0438\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u043E\u0433\u043E
      \u0433\u043E\u0440\u043E\u0434\u043A\u0430 \u043F\u043E\u0436\u0438\u043B\u043E\u0439
      \u043A\u0438\u0442\u0430\u0435\u0446 \u0432 \u0437\u0430\u043B\u0430\u0442\u0430\u043D\u043D\u043E\u043C
      \u0448\u0451\u043B\u043A\u043E\u0432\u043E\u043C \u0445\u0430\u043B\u0430\u0442\u0435
      \u043E\u043A\u043B\u0438\u043A\u0430\u0435\u0442 \u0432\u0430\u0441 \u2014
      \u043F\u0430\u043B\u044C\u0446\u044B \u0443 \u043D\u0435\u0433\u043E \u0441\u0438\u043D\u0438\u0435
      \u043E\u0442 \u0438\u043D\u0434\u0438\u0433\u043E, \u043F\u043E\u0434 \u043D\u043E\u0433\u0442\u044F\u043C\u0438
      \u0437\u0430\u0441\u043E\u0445\u0448\u0430\u044F \u043A\u0440\u0430\u0441\u043A\u0430.
      \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E,
      \u043F\u043E\u0447\u0442\u0438 \u0448\u0451\u043F\u043E\u0442\u043E\u043C,
      \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C \u043F\u043E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0430\u043C. \u0412 \u0435\u0433\u043E
      \u0433\u043E\u043B\u043E\u0441\u0435 \u0441\u043B\u044B\u0448\u0438\u0442\u0441\u044F
      \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
      \u043F\u043E\u0442\u0435\u0440\u044F\u0432\u0448\u0435\u0433\u043E \u0434\u0435\u043B\u043E
      \u0432\u0441\u0435\u0439 \u0436\u0438\u0437\u043D\u0438, \u2014 \u0438 \u0443\u043F\u0440\u044F\u043C\u0441\u0442\u0432\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043D\u0435 \u043D\u0430\u043C\u0435\u0440\u0435\u043D \u0441\u0434\u0430\u0442\u044C\u0441\u044F.\r\n\r\n<npc_speech
      lang=\"Chinese\">\u0417\u0434\u0440\u0430\u0432\u0441\u0442\u0432\u0443\u0439\u0442\u0435,
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446. \u042F \u0427\u044D\u043D\u044C
      \u0412\u044D\u0439, \u043A\u0440\u0430\u0441\u0438\u043B\u044C\u0449\u0438\u043A
      \u0438\u0437 \u0427\u0430\u043D\u044A\u0430\u043D\u044F. \u042D\u0442\u043E\u0442
      \u0448\u0451\u043B\u043A \u2014 \u0432\u0430\u0448? \u041E\u0442\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430. \u042F \u0437\u043D\u0430\u044E
      \u043E\u0434\u0438\u043D \u0446\u0432\u0435\u0442 \u2014 \u043F\u0443\u0440\u043F\u0443\u0440\u043D\u044B\u0439,
      \u0447\u0442\u043E \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435
      \u0432\u044B\u0446\u0432\u0435\u0442\u0430\u0435\u0442. \u041D\u043E \u043C\u043D\u0435
      \u043D\u0443\u0436\u043D\u0430 \u043F\u043E\u043C\u043E\u0449\u044C. \u0412\u044B\u0441\u043B\u0443\u0448\u0430\u0435\u0442\u0435?</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643644
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643645
    m_Localized: "\u0412\u044B \u043A\u0438\u0432\u0430\u0435\u0442\u0435 \u043C\u0430\u0441\u0442\u0435\u0440\u0443
      \u0427\u044D\u043D\u044E \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0435
      \u043F\u0443\u0442\u044C. \u0421\u0442\u0430\u0440\u0438\u043A \u043D\u0435
      \u043E\u0431\u0438\u0436\u0430\u0435\u0442\u0441\u044F \u2014 \u043F\u0440\u044F\u0447\u0435\u0442
      \u0440\u0443\u043A\u0438 \u0432 \u0440\u0443\u043A\u0430\u0432\u0430 \u0438
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043A
      \u0441\u0432\u043E\u0438\u043C \u043A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044F\u043C.
      \u0421\u0435\u043A\u0440\u0435\u0442\u044B \u0448\u0451\u043B\u043A\u0430 \u043F\u043E\u0434\u043E\u0436\u0434\u0443\u0442
      \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643646
    m_Localized: "\u0412\u044B\u0441\u043B\u0443\u0448\u0430\u0442\u044C \u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643647
    m_Localized: "\u0412\u044B \u043E\u0442\u0432\u043E\u0434\u0438\u0442\u0435 \u043C\u0430\u0441\u0442\u0435\u0440\u0430
      \u0427\u044D\u043D\u044F \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u0438 \u0441\u043B\u0443\u0448\u0430\u0435\u0442\u0435. \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043E \u0441\u043E\u0440\u0442\u0430\u0445 \u0441\u044B\u0440\u044C\u044F,
      \u043E \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0435 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0430,
      \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u043E\u0442\u043B\u0438\u0447\u0438\u0442\u044C
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u043A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044C
      \u043E\u0442 \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0438 \u2014 \u0438
      \u0441 \u043A\u0430\u0436\u0434\u044B\u043C \u0441\u043B\u043E\u0432\u043E\u043C
      \u0432\u044B \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442\u0435: \u044D\u0442\u043E\u0442
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0437\u043D\u0430\u0435\u0442 \u0441\u0432\u043E\u0451
      \u0434\u0435\u043B\u043E \u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C
      \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432
      \u0437\u043D\u0430\u044E\u0442 \u0441\u0432\u043E\u0439 \u0442\u043E\u0432\u0430\u0440.
      \u0412\u044B \u0436\u043C\u0451\u0442\u0435 \u0435\u043C\u0443 \u0440\u0443\u043A\u0443.
      \u041E\u043D \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0438\u0437 \u043C\u0435\u0448\u043A\u0430
      \u043F\u043B\u043E\u0448\u043A\u0443 \u0438\u043D\u0434\u0438\u0433\u043E \u2014
      \xAB\u0437\u0430\u0434\u0430\u0442\u043E\u043A \u0438 \u043F\u0435\u0440\u0432\u044B\u0439
      \u0443\u0440\u043E\u043A\xBB \u2014 \u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442,
      \u0447\u0442\u043E \u043D\u0443\u0436\u043D\u043E: \u043A\u0443\u043F\u0438\u0442\u044C
      \u043F\u044F\u0442\u044C \u0435\u0434\u0438\u043D\u0438\u0446 \u0441\u044B\u0440\u044C\u044F
      \u0438 \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0435\u043C\u0443
      \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u044C. \u041F\u0443\u0442\u044C
      \u043A \u0441\u0435\u043A\u0440\u0435\u0442\u0430\u043C \u0448\u0451\u043B\u043A\u0430
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0441 \u043C\u0430\u043B\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643648
    m_Localized: "\u0412\u044B \u043F\u044B\u0442\u0430\u0435\u0442\u0435\u0441\u044C
      \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F, \u043D\u043E
      \u043C\u0430\u0441\u0442\u0435\u0440 \u0427\u044D\u043D\u044C \u0431\u044B\u0441\u0442\u0440\u043E
      \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442, \u0447\u0442\u043E \u0432\u044B
      \u043D\u0435 \u043E\u0442\u043B\u0438\u0447\u0438\u0442\u0435 \u0438\u043D\u0434\u0438\u0433\u043E
      \u043E\u0442 \u0441\u0430\u0436\u0438. \u041E\u043D \u043A\u0430\u0447\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C \u043F\u043B\u043E\u0448\u043A\u0438.
      \u041F\u043E\u0442\u043E\u043C \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0441
      \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u044E\u0449\u0435. \xAB\u0422\u044B
      \u043D\u0435 \u0437\u043D\u0430\u0435\u0448\u044C \u043A\u0440\u0430\u0441\u043E\u043A.
      \u041D\u043E \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u0430 \u043C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D \u043A\u0443\u0440\u044C\u0435\u0440,
      \u043D\u0435 \u0443\u0447\u0451\u043D\u044B\u0439.\xBB \u041E\u043D \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u0438\u043D\u0434\u0438\u0433\u043E \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u0432 \u043C\u0435\u0448\u043E\u043A \u2014 \u0437\u0430\u0434\u0430\u0442\u043A\u0430
      \u043D\u0435 \u0431\u0443\u0434\u0435\u0442. \xAB\u041F\u044F\u0442\u044C \u0435\u0434\u0438\u043D\u0438\u0446
      \u0441\u044B\u0440\u044C\u044F, \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u044C. \u0414\u0435\u043D\u0435\u0433
      \u043D\u0430 \u0437\u0430\u043A\u0443\u043F\u043A\u0443 \u0434\u0430\u043C
      \u0432 \u043E\u0431\u0440\u0435\u0437 \u2014 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u0438\u0437 \u0441\u0432\u043E\u0435\u0433\u043E \u043A\u043E\u0448\u0435\u043B\u044C\u043A\u0430.
      \u0415\u0441\u043B\u0438 \u043F\u0440\u0438\u0432\u0435\u0437\u0451\u0448\u044C
      \u0432\u043E\u0432\u0440\u0435\u043C\u044F \u0438 \u043D\u0435 \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u0448\u044C,
      \u0442\u043E\u0433\u0434\u0430 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C
      \u043E \u043A\u0440\u0430\u0441\u043A\u0430\u0445.\xBB \u041E\u043D \u0441\u0443\u0451\u0442
      \u0432\u0430\u043C \u0437\u0430\u043F\u0438\u0441\u043A\u0443 \u0441 \u0430\u0434\u0440\u0435\u0441\u043E\u043C,
      \u043D\u043E \u043D\u0438 \u0443\u0440\u043E\u043A\u0430, \u043D\u0438 \u0437\u0430\u0434\u0430\u0442\u043A\u0430
      \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0435
      \u0438 \u0441\u043A\u0443\u043F\u043E \u043E\u0442\u043C\u0435\u0440\u0435\u043D\u043D\u043E\u0435
      \u0434\u043E\u0432\u0435\u0440\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643649
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0440\u0430\u0441\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u043D\u0430 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643650
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B \u0441 \u043C\u0430\u0441\u0442\u0435\u0440\u043E\u043C
      \u0427\u044D\u043D\u0435\u043C \u043D\u0430 \u0440\u043E\u0434\u043D\u043E\u043C:
      <npc_speech lang=\"Chinese\">\u041C\u0430\u0441\u0442\u0435\u0440 \u0427\u044D\u043D\u044C,
      \u043C\u043E\u0439 \u0433\u043E\u0441\u043F\u043E\u0434\u0438\u043D \u2014
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0448\u0451\u043B\u043A\u043E\u043C.
      \u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438\u0442\u0435 \u0435\u043C\u0443
      \u043E \u0432\u0430\u0448\u0435\u043C \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435,
      \u043F\u0440\u043E\u0448\u0443.</npc_speech> \u0421\u0442\u0430\u0440\u0438\u043A
      \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u0438\u043B\u0441\u044F. \u041E\u043D
      \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B \u0431\u044B\u0441\u0442\u0440\u043E,
      \u0436\u0435\u0441\u0442\u0438\u043A\u0443\u043B\u0438\u0440\u0443\u044F \u0441\u0438\u043D\u0438\u043C\u0438
      \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438, \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044F
      \u043D\u0430 \u0442\u043A\u0430\u043D\u0438, \u043D\u0430 \u043D\u0435\u0431\u043E,
      \u043D\u0430 \u0437\u0435\u043C\u043B\u044E. \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u0435\u0434\u0432\u0430 \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0442 \u043F\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0442\u044C
      \u2014 \u0440\u0435\u0447\u044C \u0438\u0434\u0451\u0442 \u043E \u0440\u0435\u0434\u043A\u043E\u043C
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0438 \u0432 \u043E\u043A\u0440\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044F\u0445
      \u0410\u043D\u044C\u0441\u0438, \u043E \u0441\u0435\u043A\u0440\u0435\u0442\u0435
      \u043F\u0443\u0440\u043F\u0443\u0440\u0430, \u043E \u0442\u043E\u043C, \u043A\u0430\u043A
      \u0438\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0441\u043A\u0438\u0439
      \u0434\u0432\u043E\u0440 \u043A\u043E\u0433\u0434\u0430-\u0442\u043E \u0437\u0430\u043A\u0430\u0437\u044B\u0432\u0430\u043B
      \u0442\u043A\u0430\u043D\u0438 \u0438\u043C\u0435\u043D\u043D\u043E \u0443
      \u0435\u0433\u043E \u0441\u0435\u043C\u044C\u0438. \u041C\u0430\u0441\u0442\u0435\u0440
      \u0427\u044D\u043D\u044C \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0432\u0430\u043C \u0432 \u0440\u0443\u043A\u0443 \u043F\u043B\u043E\u0448\u043A\u0443
      \u0441 \u0438\u043D\u0434\u0438\u0433\u043E \u0438 \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F.
      \xAB\u0427\u0435\u043B\u043E\u0432\u0435\u043A, \u043F\u0440\u0438 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u0435\u0441\u0442\u044C \u0442\u043E\u043B\u043C\u0430\u0447, \u0443\u043C\u0435\u044E\u0449\u0438\u0439
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043F\u043E-\u043D\u0430\u0448\u0435\u043C\u0443
      \u2014 \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446.
      \u042F \u0434\u043E\u0432\u0435\u0440\u044F\u044E.\xBB \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435
      \u0441 \u0440\u044B\u043D\u043A\u0430 \u0441 \u0437\u0430\u0434\u0430\u043D\u0438\u0435\u043C,
      \u043A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u0435\u043C \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C\u0438
      \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u043C\u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438,
      \u043E\u0441\u0435\u0432\u0448\u0438\u043C\u0438 \u0432 \u043F\u0430\u043C\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643651
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u043D\u044B\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043D\u0430 \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643652
    m_Localized: "\u0423\u0437\u043A\u0430\u044F \u0442\u0440\u043E\u043F\u0430 \u043D\u0430\u0434
      \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C\u044E. \u0418\u0437-\u0437\u0430
      \u0432\u044B\u0441\u0442\u0443\u043F\u0430 \u0441\u043A\u0430\u043B\u044B \u0432\u044B\u0445\u043E\u0434\u0438\u0442
      \u0432\u0441\u0442\u0440\u0435\u0447\u043D\u044B\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u2014 \u0448\u0438\u0440\u043E\u043A\u043E\u043F\u043B\u0435\u0447\u0438\u0439
      \u0442\u044E\u0440\u043E\u043A-\u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A,
      \u0442\u0440\u0438 \u044F\u043A\u0430 \u0441 \u0442\u044E\u043A\u0430\u043C\u0438
      \u0448\u0435\u0440\u0441\u0442\u0438, \u0442\u0440\u0438 \u043F\u043E\u0432\u043E\u0437\u043A\u0438.
      \u0414\u0432\u043E\u0438\u043C \u0437\u0434\u0435\u0441\u044C \u043D\u0435
      \u0440\u0430\u0437\u044A\u0435\u0445\u0430\u0442\u044C\u0441\u044F, \u043A\u0442\u043E-\u0442\u043E
      \u0434\u043E\u043B\u0436\u0435\u043D \u0443\u0441\u0442\u0443\u043F\u0438\u0442\u044C.
      \u0422\u044E\u0440\u043E\u043A \u0443\u043F\u0438\u0440\u0430\u0435\u0442 \u0440\u0443\u043A\u0438
      \u0432 \u0431\u043E\u043A\u0430 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0441 \u0432\u044B\u0436\u0438\u0434\u0430\u044E\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643653
    m_Localized: "\u0421\u0442\u043E\u044F\u0442\u044C \u043D\u0430\u0441\u043C\u0435\u0440\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643654
    m_Localized: "\u0412\u044B \u0443\u043F\u0438\u0440\u0430\u0435\u0442\u0435\u0441\u044C
      \u0438 \u043D\u0435 \u0441\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u0442\u0440\u043E\u043F\u044B.
      \u0427\u0430\u0441 \u0441\u043F\u043E\u0440, \u0434\u0432\u0430 \u0447\u0430\u0441\u0430
      \u043A\u0440\u0438\u043A\u0438, \u0442\u0440\u0438 \u0447\u0430\u0441\u0430
      \u0432\u0437\u0430\u0438\u043C\u043D\u043E\u0439 \u0440\u0443\u0433\u0430\u043D\u0438.
      \u0422\u044E\u0440\u043E\u043A \u043F\u043B\u044E\u0451\u0442 \u0438 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0441\u0432\u043E\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u2014
      \u043D\u043E \u0434\u0435\u043D\u044C \u043F\u043E\u0442\u0435\u0440\u044F\u043D,
      \u043D\u0435\u0440\u0432\u044B \u0438\u0437\u043C\u043E\u0442\u0430\u043D\u044B,
      \u0438 \u0432 \u0433\u043E\u0440\u0430\u0445 \u0442\u0435\u043C\u043D\u0435\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643655
    m_Localized: "\u0421\u0434\u0430\u0442\u044C \u043D\u0430\u0437\u0430\u0434 \u0434\u043E
      \u0443\u0441\u0442\u0443\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643656
    m_Localized: "\u0412\u0430\u0448\u0438 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E \u043E\u0442\u0432\u043E\u0434\u044F\u0442
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043D\u0430\u0437\u0430\u0434 \u2014
      \u043C\u0435\u0442\u0440 \u0437\u0430 \u043C\u0435\u0442\u0440\u043E\u043C,
      \u043A \u0441\u043A\u0430\u043B\u044C\u043D\u043E\u043C\u0443 \u0443\u0441\u0442\u0443\u043F\u0443.
      \u0422\u044E\u0440\u043E\u043A \u043A\u0438\u0432\u0430\u0435\u0442 \u0441
      \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C \u0438 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u043F\u0435\u0440\u0432\u044B\u043C; \u043D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0440\u0443\u043A\u043E\u0439
      \u0432\u043F\u0435\u0440\u0451\u0434: \xAB\u0427\u0435\u0440\u0435\u0437 \u0434\u0432\u0435
      \u0432\u0435\u0440\u0441\u0442\u044B \u2014 \u043E\u0431\u0432\u0430\u043B.
      \u0411\u0443\u0434\u044C\u0442\u0435 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B.\xBB
      \u0412\u044B \u0443\u0435\u0437\u0436\u0430\u0435\u0442\u0435 \u0441 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435\u043C
      \u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u043C, \u0447\u0442\u043E
      \u0433\u043E\u0440\u044B \u043F\u0440\u0438\u0437\u043D\u0430\u044E\u0442 \u0442\u0435\u0445,
      \u043A\u0442\u043E \u0443\u043C\u0435\u0435\u0442 \u0443\u0441\u0442\u0443\u043F\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643657
    m_Localized: "\u041C\u0430\u043D\u0451\u0432\u0440 \u0438\u0434\u0451\u0442 \u043A\u0440\u0438\u0432\u043E.
      \u0417\u0430\u0434\u043D\u0435\u0435 \u043A\u043E\u043B\u0435\u0441\u043E \u043E\u0434\u043D\u043E\u0439
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0441\u043E\u0441\u043A\u0430\u043B\u044C\u0437\u044B\u0432\u0430\u0435\u0442
      \u0441 \u043A\u0440\u0430\u044F, \u0442\u044E\u043A\u0438 \u043A\u0430\u0448\u0435\u043C\u0438\u0440\u0430
      \u0432\u0430\u043B\u044F\u0442\u0441\u044F \u0432\u043D\u0438\u0437, \u0432
      \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C. \u0415\u0434\u0432\u0430
      \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0442\u0435 \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435. \u0422\u044E\u0440\u043E\u043A
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442, \u0431\u0440\u043E\u0441\u0438\u0432
      \u0447\u0435\u0440\u0435\u0437 \u043F\u043B\u0435\u0447\u043E: \xAB\u0423\u0447\u0438\u0441\u044C
      \u0432\u043E\u0434\u0438\u0442\u044C \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043B\u0435\u0437\u0442\u044C
      \u0432 \u041F\u0430\u043C\u0438\u0440.\xBB \u041D\u0430 \u0438\u0441\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0443\u0449\u0435\u0440\u0431\u0430 \u0443\u0439\u0434\u0443\u0442 \u0434\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643658
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u043F\u043E\u043B\u044E\u0431\u043E\u0432\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643659
    m_Localized: "\u0412\u044B \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u0435 \u0432\u043F\u0435\u0440\u0451\u0434
      \u0441 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438
      \u0438 \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442\u0435 \u043E\u0431\u043C\u0435\u043D
      \u2014 \u043C\u044B \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043C
      \u0441\u0435\u0439\u0447\u0430\u0441, \u0442\u044B \u043F\u043E\u0434\u0441\u043A\u0430\u0436\u0435\u0448\u044C
      \u0434\u043E\u0440\u043E\u0433\u0443. \u0422\u044E\u0440\u043E\u043A \u0437\u0430\u0434\u0443\u043C\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
      \u043F\u043E\u0442\u043E\u043C \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u043C\u043E\u0437\u043E\u043B\u0438\u0441\u0442\u0443\u044E \u043B\u0430\u0434\u043E\u043D\u044C.
      \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u043E\u0431\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0443\u0436\u0435 \u0443\u0436\u0438\u043D\u0430\u044E\u0442 \u0432\u043C\u0435\u0441\u0442\u0435
      \u0443 \u043E\u0431\u0449\u0435\u0433\u043E \u043A\u043E\u0441\u0442\u0440\u0430,
      \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u044F\u0441\u044C \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430\u043C\u0438
      \u0438 \u0441\u043B\u0443\u0445\u0430\u043C\u0438. \u041D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435
      \u043E\u043D \u0434\u0430\u0440\u0438\u0442 \u0442\u044E\u043A \u043A\u0430\u0448\u0435\u043C\u0438\u0440\u0430
      \u2014 \xAB\u0437\u0430 \u0443\u043C\u043D\u0443\u044E \u0433\u043E\u043B\u043E\u0432\u0443\xBB.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u0441\u0442\u0430\u043B\u0430 \u044F\u0441\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643660
    m_Localized: "\u041A\u043E\u043B\u043E\u0434\u0435\u0446 \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643661
    m_Localized: "\u041F\u043E\u0441\u0440\u0435\u0434\u0438 \u043F\u0435\u0441\u043A\u043E\u0432
      \u2014 \u043F\u043E\u043B\u0443\u0437\u0430\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0439
      \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439 \u043A\u043E\u043B\u043E\u0434\u0435\u0446.
      \u0420\u044F\u0434\u043E\u043C \u2014 \u043C\u0451\u0440\u0442\u0432\u044B\u0439
      \u0432\u043E\u0440\u043E\u043D \u0441 \u0440\u0430\u0441\u043A\u0438\u043D\u0443\u0442\u044B\u043C\u0438
      \u043A\u0440\u044B\u043B\u044C\u044F\u043C\u0438. \u0412\u044B\u0441\u043E\u0445\u0448\u0438\u0435
      \u0442\u043E\u043F\u043E\u043B\u044F \u0442\u043E\u0440\u0447\u0430\u0442 \u0438\u0437
      \u0434\u044E\u043D, \u043A\u0430\u043A \u0441\u0435\u0440\u044B\u0435 \u043A\u043E\u0441\u0442\u043B\u044F\u0432\u044B\u0435
      \u0440\u0443\u043A\u0438. \u041E\u0434\u0438\u043D \u0438\u0437 \u0432\u0430\u0448\u0438\u0445
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u043E\u043F\u0443\u0441\u0442\u0438\u043B
      \u043C\u0435\u0434\u043D\u0443\u044E \u0447\u0430\u0448\u0443 \u0432 \u0448\u0430\u0445\u0442\u0443:
      \u0432\u043E\u0434\u0430 \u0435\u0441\u0442\u044C, \u043D\u043E \u043C\u0443\u0442\u043D\u0430\u044F
      \u0438 \u043F\u0430\u0445\u043D\u0435\u0442 \u0436\u0435\u043B\u0435\u0437\u043E\u043C.
      \u0417\u0430\u043F\u0430\u0441\u044B \u0432\u043E\u0434\u044B \u043D\u0430
      \u0438\u0441\u0445\u043E\u0434\u0435, \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430 \u2014 \u0434\u0432\u0430
      \u0434\u043D\u044F \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643662
    m_Localized: "\u041F\u0438\u0442\u044C, \u043A\u0430\u043A \u0435\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643663
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0436\u0430\u0434\u043D\u043E
      \u043D\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u0432\u043E\u0434\u0443.
      \u0416\u0430\u0436\u0434\u0430 \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0435\u0442,
      \u043D\u043E \u043A \u0432\u0435\u0447\u0435\u0440\u0443 \u0443 \u0442\u0440\u043E\u0438\u0445
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442\u0441\u044F
      \u0441\u043F\u0430\u0437\u043C\u044B \u0432 \u0436\u0438\u0432\u043E\u0442\u0435.
      \u041A \u0443\u0442\u0440\u0443 \u0443 \u0434\u0432\u043E\u0438\u0445 \u2014
      \u043A\u0440\u043E\u0432\u0430\u0432\u0430\u044F \u0434\u0438\u0437\u0435\u043D\u0442\u0435\u0440\u0438\u044F.
      \u0412\u043E\u0434\u0443 \u043F\u0438\u0442\u044C \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u2014 \u043D\u043E \u043C\u0451\u0440\u0442\u0432\u044B\u0439 \u0432\u043E\u0440\u043E\u043D
      \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u043B
      \u043D\u0435 \u0437\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643664
    m_Localized: "\u041F\u0440\u043E\u043A\u0438\u043F\u044F\u0442\u0438\u0442\u044C
      \u0438 \u043F\u0440\u043E\u0446\u0435\u0434\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643665
    m_Localized: "\u0412\u044B \u043F\u043E\u043C\u043D\u0438\u0442\u0435 \u0443\u0440\u043E\u043A\u0438
      \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0430
      \u2014 \u043A\u0438\u043F\u044F\u0442\u0438\u0442\u044C, \u043F\u043E\u0442\u043E\u043C
      \u0446\u0435\u0434\u0438\u0442\u044C \u0447\u0435\u0440\u0435\u0437 \u0442\u043A\u0430\u043D\u044C
      \u0441 \u0443\u0433\u043B\u0451\u043C. \u041E\u0433\u043E\u043D\u044C \u0440\u0430\u0437\u0432\u0435\u0441\u0442\u0438
      \u0442\u0440\u0443\u0434\u043D\u043E, \u0432\u0435\u0442\u0435\u0440 \u043C\u0435\u0448\u0430\u0435\u0442,
      \u043D\u043E \u0432\u044B \u0441\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0435\u0441\u044C.
      \u0412\u043E\u0434\u0430 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u043E\u0439 \u0438 \u043F\u0440\u0438\u0433\u043E\u0434\u043D\u043E\u0439.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u044C\u0451\u0442 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E,
      \u0438 \u043F\u0443\u0441\u0442\u044B\u043D\u044F \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0451\u0442
      \u043F\u0443\u0433\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643666
    m_Localized: "\u0412\u0430\u0448\u0430 \u043F\u043E\u043F\u044B\u0442\u043A\u0430
      \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0432\u043E\u0434\u0443 \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043F\u043B\u043E\u0445\u043E: \u043A\u043E\u0441\u0442\u0451\u0440 \u0433\u0430\u0441\u043D\u0435\u0442,
      \u0444\u0438\u043B\u044C\u0442\u0440 \u0437\u0430\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0431\u0443\u0440\u0434\u044E\u043A\u0438 \u043E\u043F\u0440\u043E\u043A\u0438\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F.
      \u0411\u043E\u043B\u044C\u0448\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u0437\u0430\u043F\u0430\u0441\u0430
      \u0443\u0442\u0435\u043A\u0430\u0435\u0442 \u0432 \u043F\u0435\u0441\u043E\u043A.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u044B\u043D\u0443\u0436\u0434\u0435\u043D
      \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C \u043A\u0430\u0436\u0434\u0443\u044E
      \u043A\u0430\u043F\u043B\u044E \u0438 \u0438\u0434\u0442\u0438 \u0431\u044B\u0441\u0442\u0440\u0435\u0435,
      \u0447\u0435\u043C \u0445\u043E\u0442\u0435\u043B\u043E\u0441\u044C \u0431\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643667
    m_Localized: "\u041F\u043E\u0441\u043B\u0430\u0442\u044C \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0443
      \u0438\u0441\u043A\u0430\u0442\u044C \u0434\u0440\u0443\u0433\u043E\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643668
    m_Localized: "\u0414\u0432\u043E\u0435 \u043B\u0443\u0447\u0448\u0438\u0445 \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u043E\u0432
      \u0443\u0445\u043E\u0434\u044F\u0442 \u043D\u0430 \u0437\u0430\u043A\u0430\u0442
      \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u044E\u0442\u0441\u044F
      \u0441 \u0432\u043E\u0441\u0445\u043E\u0434\u043E\u043C \u2014 \u043D\u0430\u0448\u043B\u0438
      \u0441\u043F\u0440\u044F\u0442\u0430\u043D\u043D\u044B\u0439 \u0441\u0440\u0435\u0434\u0438
      \u0441\u043A\u0430\u043B \u0440\u043E\u0434\u043D\u0438\u043A, \u0447\u0438\u0441\u0442\u044B\u0439
      \u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0440\u0430\u0434\u043E\u0441\u0442\u043D\u043E \u043C\u0435\u043D\u044F\u0435\u0442
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0438 \u043F\u043E\u043F\u043E\u043B\u043D\u044F\u0435\u0442
      \u0437\u0430\u043F\u0430\u0441\u044B \u0432\u0434\u043E\u0432\u043E\u043B\u044C.
      \u041C\u0451\u0440\u0442\u0432\u044B\u0439 \u0432\u043E\u0440\u043E\u043D \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C \u043E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
      \u043A\u043E\u043B\u043E\u0434\u0435\u0446 \u2014 \u043F\u0443\u0441\u0442\u044C
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u0442 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643669
    m_Localized: "\u0422\u0430\u043D\u0441\u043A\u0438\u0439 \u043F\u0430\u0442\u0440\u0443\u043B\u044C
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643670
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u0447\u0435\u0440\u0435\u0437
      \u0413\u0430\u043D\u044C\u0441\u0443\u0439\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u0438\u0434\u043E\u0440
      \u2014 \u0442\u0430\u043D\u0441\u043A\u0438\u0439 \u043F\u043E\u0441\u0442:
      \u0434\u0432\u0435 \u0433\u043B\u0438\u043D\u043E\u0431\u0438\u0442\u043D\u044B\u0435
      \u0431\u0430\u0448\u043D\u0438, \u0431\u0430\u043C\u0431\u0443\u043A\u043E\u0432\u0430\u044F
      \u0436\u0435\u0440\u0434\u044C \u043F\u043E\u043F\u0435\u0440\u0451\u043A \u0434\u043E\u0440\u043E\u0433\u0438,
      \u0448\u0451\u043B\u043A\u043E\u0432\u044B\u0439 \u0448\u0442\u0430\u043D\u0434\u0430\u0440\u0442
      \u0441 \u0437\u043E\u043B\u043E\u0442\u044B\u043C \u0434\u0440\u0430\u043A\u043E\u043D\u043E\u043C.
      \u041E\u0444\u0438\u0446\u0435\u0440 \u0432 \u043A\u0440\u0430\u0441\u043D\u044B\u0445
      \u043B\u0430\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0445 \u0434\u043E\u0441\u043F\u0435\u0445\u0430\u0445
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0433\u0440\u0430\u043C\u043E\u0442\u044B.
      \u041D\u0430 \u0441\u0442\u043E\u043B\u0431\u0435 \u0443 \u0432\u0445\u043E\u0434\u0430
      \u2014 \u0438\u0435\u0440\u043E\u0433\u043B\u0438\u0444\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0432\u0430\u0448 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043D\u0435
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u0442. \u0414\u0432\u043E\u0435
      \u0441\u043E\u043B\u0434\u0430\u0442 \u0441 \u0430\u043B\u0435\u0431\u0430\u0440\u0434\u0430\u043C\u0438
      \u0441\u0442\u043E\u044F\u0442 \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439
      \u043E\u0444\u0438\u0446\u0435\u0440\u0430. \u0411\u0435\u0437 \u0431\u0443\u043C\u0430\u0433
      \u2014 \u043D\u0435 \u043F\u0440\u043E\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643671
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043F\u043E\u0448\u043B\u0438\u043D\u0443
      \u0441\u0440\u0430\u0437\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643672
    m_Localized: "\u0412\u044B \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E \u043D\u0430 \u043B\u0430\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043F\u043E\u0434\u043D\u043E\u0441, \u043D\u0435 \u0442\u043E\u0440\u0433\u0443\u044F\u0441\u044C.
      \u041E\u0444\u0438\u0446\u0435\u0440 \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442,
      \u0441\u0442\u0430\u0432\u0438\u0442 \u043F\u0435\u0447\u0430\u0442\u044C \u043D\u0430
      \u0431\u0443\u043C\u0430\u0433\u0443 \u0438 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0448\u043B\u0430\u0433\u0431\u0430\u0443\u043C. \u041D\u0438 \u043B\u0438\u0448\u043D\u0435\u0433\u043E
      \u0441\u043B\u043E\u0432\u0430, \u043D\u0438 \u0432\u0437\u0433\u043B\u044F\u0434\u0430.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0430,
      \u043A\u043E\u0448\u0435\u043B\u044C \u043B\u0435\u0433\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643673
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0436\u0435\u0441\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643674
    m_Localized: "\u0412\u044B \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0435\u0441\u044C,
      \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435 \u0440\u0443\u043A\u0438
      \u0432 \u0437\u043D\u0430\u043A \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F,
      \u043D\u0430 \u043F\u0430\u043B\u044C\u0446\u0430\u0445 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435
      \u0446\u0438\u0444\u0440\u0443 \u043C\u0435\u043D\u044C\u0448\u0443\u044E \u2014
      \u0438 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0435\u0441\u044C \u0442\u0430\u043A,
      \u043A\u0430\u043A \u0443\u043B\u044B\u0431\u0430\u044E\u0442\u0441\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B
      \u043F\u043E \u0432\u0441\u0435\u0439 \u0410\u0437\u0438\u0438. \u041E\u0444\u0438\u0446\u0435\u0440
      \u0445\u043C\u044B\u043A\u0430\u0435\u0442, \u0441\u043A\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u0433\u043B\u0430\u0437\u0430 \u043D\u0430 \u0442\u043E\u0432\u0430\u0440\u044B,
      \u0438 \u0447\u0435\u0440\u0435\u0437 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C
      \u0447\u0430\u0441\u0430 \u0432\u044B \u0440\u0430\u0441\u0445\u043E\u0434\u0438\u0442\u0435\u0441\u044C
      \u043A \u043E\u0431\u043E\u044E\u0434\u043D\u043E\u043C\u0443 \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u044E.
      \u041D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435 \u043E\u043D
      \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u043B\u0438\u0441\u0442 \u0440\u0438\u0441\u043E\u0432\u043E\u0439
      \u0431\u0443\u043C\u0430\u0433\u0438 \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E
      \u2014 \u043F\u0440\u043E\u043F\u0443\u0441\u043A \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
      \u043F\u043E\u0441\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643675
    m_Localized: "\u0412\u0430\u0448\u0438 \u0436\u0435\u0441\u0442\u044B \u043E\u0444\u0438\u0446\u0435\u0440
      \u0438\u0441\u0442\u043E\u043B\u043A\u043E\u0432\u044B\u0432\u0430\u0435\u0442
      \u043A\u0430\u043A \u043F\u043E\u043F\u044B\u0442\u043A\u0443 \u0443\u0432\u0438\u043B\u044C\u043D\u0443\u0442\u044C.
      \u041B\u0438\u0446\u043E \u0435\u0433\u043E \u0442\u0435\u043C\u043D\u0435\u0435\u0442,
      \u0441\u043E\u043B\u0434\u0430\u0442\u044B \u0434\u0435\u043B\u0430\u044E\u0442
      \u0448\u0430\u0433 \u0432\u043F\u0435\u0440\u0451\u0434. \u0412 \u0438\u0442\u043E\u0433\u0435
      \u0432\u044B \u043F\u043B\u0430\u0442\u0438\u0442\u0435 \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0441\u0442\u043E\u0438\u043B\u043E \u0431\u044B, \u0435\u0449\u0451
      \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435 \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0435
      \u0432 \u043D\u0435\u0447\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438.
      \u041E\u0444\u0438\u0446\u0435\u0440 \u0434\u0435\u043B\u0430\u0435\u0442 \u043F\u043E\u043C\u0435\u0442\u043A\u0443
      \u0432 \u0441\u043F\u0438\u0441\u043A\u0435 \u2014 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u043F\u043E\u0441\u0442\u0443 \u0432\u0430\u0441 \u0432\u0441\u0442\u0440\u0435\u0442\u044F\u0442
      \u0441\u0442\u0440\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643676
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643677
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0432\u043F\u0435\u0440\u0451\u0434
      \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043A
      \u043E\u0444\u0438\u0446\u0435\u0440\u0443 \u043D\u0430 \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u043E\u043C
      \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C, \u0446\u0438\u0442\u0438\u0440\u0443\u044F
      \u0441\u0442\u0440\u043E\u043A\u0443 \u0438\u0437 \xAB\u041B\u0443\u043D\u044C
      \u042E\u0439\xBB. \u041E\u0444\u0438\u0446\u0435\u0440 \u0443\u0434\u0438\u0432\u043B\u0451\u043D\u043D\u043E
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0431\u0440\u043E\u0432\u0438,
      \u043F\u043E\u0442\u043E\u043C \u0441\u043C\u0435\u0451\u0442\u0441\u044F \u0438
      \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u0435\u0442 \u0432\u0430\u0441
      \u043A \u0447\u0430\u044E \u0432 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0441\u043A\u043E\u0439
      \u043F\u0430\u043B\u0430\u0442\u043A\u0435. \u0417\u0430 \u0447\u0430\u0448\u043A\u043E\u0439
      \u0441\u0432\u0435\u0442\u043B\u043E\u0433\u043E \u0437\u0435\u043B\u0451\u043D\u043E\u0433\u043E
      \u0447\u0430\u044F \u043E\u043D \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442,
      \u043A\u0430\u043A \u043B\u0443\u0447\u0448\u0435 \u043F\u0440\u043E\u0439\u0442\u0438
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u043F\u043E\u0441\u0442\u044B,
      \u0441\u0442\u0430\u0432\u0438\u0442 \u043D\u0430 \u0431\u0443\u043C\u0430\u0433\u0435
      \u0434\u0432\u043E\u0439\u043D\u0443\u044E \u043F\u0435\u0447\u0430\u0442\u044C
      \u0438 \u0436\u0435\u043B\u0430\u0435\u0442 \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0438. \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435
      \u0441 \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u043E\u043C, \u0441\u043E\u0432\u0435\u0442\u0430\u043C\u0438
      \u0438 \u043F\u0430\u0440\u043E\u0439 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u0445
      \u0444\u0440\u0430\u0437, \u043E\u0441\u0435\u0432\u0448\u0438\u0445 \u0432
      \u043F\u0430\u043C\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643678
    m_Localized: "\u041B\u0435\u0432\u0430\u043D\u0442\u0438\u0439\u0441\u043A\u0438\u0435
      \u043F\u0438\u0440\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643679
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u043D\u0430\u0434 \u043C\u043E\u0440\u0435\u043C
      \u2014 \u0441\u043F\u0440\u0430\u0432\u0430 \u043E\u0431\u0440\u044B\u0432,
      \u0432\u043D\u0438\u0437\u0443 \u043F\u043B\u0435\u0449\u0435\u0442\u0441\u044F
      \u0441\u0435\u0440\u0430\u044F \u0432\u043E\u0434\u0430. \u0418\u0437-\u0437\u0430
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430 \u0432\u044B\u0445\u043E\u0434\u044F\u0442
      \u0448\u0435\u0441\u0442\u0435\u0440\u043E \u0432 \u0442\u0451\u043C\u043D\u044B\u0445
      \u0442\u0440\u044F\u043F\u043A\u0430\u0445. \u0413\u043B\u0430\u0432\u0430\u0440\u044C
      \u2014 \u0445\u0443\u0434\u043E\u0439, \u0441\u043E \u0448\u0440\u0430\u043C\u043E\u043C
      \u0447\u0435\u0440\u0435\u0437 \u0449\u0451\u043A\u0443 \u2014 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u043A\u0440\u0438\u0432\u0443\u044E \u0441\u0430\u0431\u043B\u044E. \u041D\u0430
      \u043F\u043B\u044F\u0436\u0435 \u043D\u0438\u0436\u0435 \u0441\u0442\u043E\u044F\u0442
      \u0434\u0432\u0435 \u043B\u043E\u0434\u043A\u0438 \u0441 \u0437\u0430\u043B\u0430\u0442\u0430\u043D\u043D\u044B\u043C\u0438
      \u043F\u0430\u0440\u0443\u0441\u0430\u043C\u0438. \u041F\u0438\u0440\u0430\u0442\u044B
      \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u044F\u0442\u0441\u044F: \u043E\u043D\u0438
      \u0434\u043E\u043C\u0430 \u043D\u0430 \u044D\u0442\u043E\u0439 \u0437\u0435\u043C\u043B\u0435,
      \u0430 \u0432\u0430\u0448 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0437\u0430\u0436\u0430\u0442
      \u043C\u0435\u0436\u0434\u0443 \u0441\u043A\u0430\u043B\u043E\u0439 \u0438
      \u043E\u0431\u0440\u044B\u0432\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643680
    m_Localized: "\u041E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F \u0431\u0435\u0437
      \u0431\u043E\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643681
    m_Localized: "\u0412\u044B \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u043A\u043E\u0448\u0435\u043B\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u0430.
      \u0413\u043B\u0430\u0432\u0430\u0440\u044C \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442
      \u043D\u0435 \u0441\u043F\u0435\u0448\u0430, \u043F\u043E\u0442\u043E\u043C
      \u043A\u0438\u0432\u0430\u0435\u0442 \u2014 \u0441\u043B\u043E\u0432\u043E
      \u0434\u0435\u0440\u0436\u0438\u0442. \u041F\u0438\u0440\u0430\u0442\u044B
      \u0440\u0430\u0441\u0441\u0442\u0443\u043F\u0430\u044E\u0442\u0441\u044F, \u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0438\u0434\u0451\u0442 \u043C\u0438\u043C\u043E.
      \u041F\u043E\u0442 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439, \u043D\u043E
      \u043B\u044E\u0434\u0438 \u0436\u0438\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643682
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u043E \u0432\u044B\u043A\u0443\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643683
    m_Localized: "\u0412\u044B \u0437\u0430\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442\u0435
      \u0441 \u0433\u043B\u0430\u0432\u0430\u0440\u0451\u043C \u043A\u0430\u043A
      \u043A\u0443\u043F\u0435\u0446 \u0441 \u043A\u0443\u043F\u0446\u043E\u043C
      \u2014 \u0440\u0430\u0441\u0445\u0432\u0430\u043B\u0438\u0432\u0430\u0435\u0442\u0435
      \u0442\u043E\u0432\u0430\u0440\u044B, \u0436\u0430\u043B\u0443\u0435\u0442\u0435\u0441\u044C
      \u043D\u0430 \u0442\u044F\u0433\u043E\u0442\u044B \u0434\u043E\u0440\u043E\u0433\u0438,
      \u0442\u043E\u0440\u0433\u0443\u0435\u0442\u0435\u0441\u044C \u0437\u0430 \u043A\u0430\u0436\u0434\u0443\u044E
      \u043C\u043E\u043D\u0435\u0442\u0443. \u0428\u0440\u0430\u043C \u043D\u0430
      \u0435\u0433\u043E \u0449\u0435\u043A\u0435 \u043A\u0440\u0438\u0432\u0438\u0442\u0441\u044F
      \u0432 \u043D\u0435\u043E\u0445\u043E\u0442\u043D\u043E\u0439 \u0443\u043B\u044B\u0431\u043A\u0435.
      \u0421\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C \u043D\u0430
      \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u0438 \u0437\u0430\u043F\u0440\u043E\u0448\u0435\u043D\u043D\u043E\u0433\u043E.
      \u041D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435 \u043E\u043D
      \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u0432\u0430\u043C \u043A\u0443\u0441\u043E\u043A
      \u043A\u043E\u0440\u0430\u043B\u043B\u0430 \u2014 \xAB\u0437\u0430 \u0441\u043C\u0435\u043B\u044B\u0439
      \u044F\u0437\u044B\u043A\xBB. \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643684
    m_Localized: "\u0413\u043B\u0430\u0432\u0430\u0440\u044C \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0451\u043D\u043D\u043E
      \u043E\u0431\u0440\u044B\u0432\u0430\u0435\u0442 \u0442\u043E\u0440\u0433 \u0438
      \u043F\u0440\u0438\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043E\u0431\u044B\u0441\u043A\u0430\u0442\u044C
      \u043E\u0431\u043E\u0437. \u041F\u0438\u0440\u0430\u0442\u044B \u0440\u043E\u044E\u0442\u0441\u044F
      \u0432 \u0442\u044E\u043A\u0430\u0445, \u0432\u044B\u0433\u0440\u0435\u0431\u0430\u044E\u0442
      \u0432\u0441\u0451 \u0446\u0435\u043D\u043D\u043E\u0435, \u0431\u044C\u044E\u0442
      \u0434\u0432\u0443\u0445 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432.
      \u041B\u043E\u0434\u043A\u0438 \u0443\u0445\u043E\u0434\u044F\u0442 \u0432
      \u043C\u043E\u0440\u0435, \u0442\u044F\u0436\u0435\u043B\u043E \u0433\u0440\u0443\u0436\u0451\u043D\u044B\u0435,
      \u0430 \u0432\u044B \u043E\u0441\u0442\u0430\u0451\u0442\u0435\u0441\u044C
      \u0441\u043E \u0441\u0441\u0430\u0434\u0438\u043D\u0430\u043C\u0438, \u0434\u0443\u0440\u043D\u044B\u043C
      \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435\u043C \u0438 \u043F\u043E\u043A\u043B\u0430\u0436\u0435\u0439
      \u043B\u0435\u0433\u0447\u0435, \u0447\u0435\u043C \u0431\u044B\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643685
    m_Localized: "\u0414\u0430\u0442\u044C \u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643686
    m_Localized: "\u0412\u0430\u0448\u0438 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438
      \u0431\u0440\u043E\u0441\u0430\u044E\u0442\u0441\u044F \u0432 \u0430\u0442\u0430\u043A\u0443,
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043B\u043E\u0442\u043D\u043E
      \u0441\u0431\u0438\u0442 \u0438 \u043D\u0435 \u043F\u0430\u043D\u0438\u043A\u0443\u0435\u0442.
      \u041F\u0438\u0440\u0430\u0442\u044B \u043D\u0435 \u043E\u0436\u0438\u0434\u0430\u043B\u0438
      \u043E\u0442\u043F\u043E\u0440\u0430 \u2014 \u0434\u0432\u043E\u0435 \u043F\u0430\u0434\u0430\u044E\u0442
      \u0441\u0440\u0430\u0437\u0443, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u044E\u0442 \u043A \u043B\u043E\u0434\u043A\u0430\u043C,
      \u0431\u0440\u043E\u0441\u0430\u044F \u0434\u043E\u0431\u044B\u0447\u0443.
      \u0421\u0440\u0435\u0434\u0438 \u0442\u0440\u043E\u0444\u0435\u0435\u0432 \u2014
      \u043A\u0443\u0441\u043E\u043A \u043A\u043E\u0440\u0430\u043B\u043B\u0430,
      \u043A\u043E\u0448\u0435\u043B\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u0430,
      \u043A\u0440\u0438\u0432\u0430\u044F \u0441\u0430\u0431\u043B\u044F. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0438\u0437 \u0431\u043E\u044F
      \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C, \u0438 \u0432\u0435\u0441\u0442\u044C
      \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u044D\u0442\u0443 \u0442\u0440\u043E\u043F\u0443
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0432\u043E\u0437\u044C\u043C\u0443\u0442
      \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A, \u0440\u0430\u0437\u043B\u0435\u0442\u0438\u0442\u0441\u044F
      \u043F\u043E \u043F\u043E\u0431\u0435\u0440\u0435\u0436\u044C\u044E. \u0421\u043B\u0430\u0432\u0430
      \u0432\u0430\u0448\u0430 \u0440\u0430\u0441\u0442\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643687
    m_Localized: "\u0417\u0432\u043E\u043D \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u0447\u0438\u043A\u043E\u0432
      \u0434\u0430\u043B\u0451\u043A\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643688
    m_Localized: "\u0418\u0437-\u0437\u0430 \u0431\u0430\u0440\u0445\u0430\u043D\u043E\u0432
      \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u0441\u0435\u0440\u0435\u0431\u0440\u0438\u0441\u0442\u044B\u0439
      \u043F\u0435\u0440\u0435\u0437\u0432\u043E\u043D \u043A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u0447\u0438\u043A\u043E\u0432
      \u2014 \u0442\u0430\u043C, \u0437\u0430 \u043F\u0435\u0441\u043A\u043E\u043C,
      \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F \u0434\u0440\u0443\u0433\u043E\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0438 \u0443\u043B\u044B\u0431\u0430\u044E\u0442\u0441\u044F: \u043C\u044B
      \u043D\u0435 \u043E\u0434\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643689
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u0432\u043E\u0434\u043E\u043F\u0430\u0434
      \u0443 \u0442\u0440\u043E\u043F\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643690
    m_Localized: "\u0421 \u0447\u0451\u0440\u043D\u043E\u0433\u043E \u0443\u0441\u0442\u0443\u043F\u0430
      \u0441\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0432\u043E\u0434\u043E\u043F\u0430\u0434
      \u2014 \u0432\u0437\u0432\u0435\u0441\u044C \u043E\u0441\u0435\u0434\u0430\u0435\u0442
      \u043D\u0430 \u043B\u0438\u0446\u0430\u0445 \u0438 \u0448\u0435\u0440\u0441\u0442\u0438
      \u044F\u043A\u043E\u0432. \u0413\u043E\u0440\u044B \u0441\u0443\u0440\u043E\u0432\u044B,
      \u043D\u043E \u0438\u043D\u043E\u0433\u0434\u0430 \u0434\u0430\u0440\u044F\u0442
      \u0431\u0435\u0437 \u043F\u0440\u043E\u0441\u044C\u0431\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643691
    m_Localized: "\u041F\u043E\u043B\u0435 \u0434\u0438\u043A\u0438\u0445 \u0446\u0432\u0435\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643692
    m_Localized: "\u0421\u0442\u0435\u043F\u044C \u0440\u0430\u0441\u0441\u0442\u0443\u043F\u0430\u0435\u0442\u0441\u044F
      \u2014 \u043A\u043E\u043B\u0435\u044F \u043D\u044B\u0440\u044F\u0435\u0442
      \u0432 \u043C\u043E\u0440\u0435 \u0430\u043B\u044B\u0445 \u043C\u0430\u043A\u043E\u0432
      \u0438 \u043B\u0438\u043B\u043E\u0432\u044B\u0445 \u0438\u0440\u0438\u0441\u043E\u0432.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0437\u0430\u0442\u044B\u043A\u0430\u044E\u0442
      \u0446\u0432\u0435\u0442\u044B \u0437\u0430 \u0443\u0445\u043E, \u0438 \u043D\u0430
      \u0447\u0430\u0441 \u043F\u0443\u0442\u044C \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u043F\u0440\u0430\u0437\u0434\u043D\u0438\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643693
    m_Localized: "\u041F\u0430\u0434\u0430\u044E\u0449\u0430\u044F \u0437\u0432\u0435\u0437\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643694
    m_Localized: "\u0417\u0435\u043B\u0451\u043D\u043E-\u0431\u0435\u043B\u0430\u044F
      \u043F\u043E\u043B\u043E\u0441\u0430 \u043F\u0440\u043E\u0447\u0435\u0440\u0447\u0438\u0432\u0430\u0435\u0442
      \u043D\u0435\u0431\u043E \u043E\u0442 \u0437\u0435\u043D\u0438\u0442\u0430
      \u043A \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0443. \u041A\u0430\u0436\u0434\u044B\u0439
      \u0448\u0435\u043F\u0447\u0435\u0442 \u0441\u0432\u043E\u0451 \u2014 \u043F\u0435\u0440\u0441\u0438\u044F\u043D\u0438\u043D
      \u0436\u0435\u043B\u0430\u0435\u0442 \u0431\u043E\u0433\u0430\u0442\u0441\u0442\u0432\u0430,
      \u043C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u0430-\u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043F\u0440\u043E\u0441\u0442\u043E \u0434\u043E\u043C\u043E\u0439. \u041D\u0435\u0431\u043E
      \u0441\u043B\u0443\u0448\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643695
    m_Localized: "\u041A\u043E\u0441\u0442\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0432 \u043F\u0435\u0441\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643696
    m_Localized: "\u0418\u0437 \u043F\u0435\u0441\u043A\u0430 \u0442\u043E\u0440\u0447\u0430\u0442
      \u043A\u043E\u0441\u0442\u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432,
      \u0440\u0430\u0437\u0431\u0438\u0442\u044B\u0435 \u0434\u043E\u0441\u043A\u0438,
      \u043E\u0431\u043E\u0440\u0432\u0430\u043D\u043D\u0430\u044F \u043A\u043E\u0436\u0430\u043D\u0430\u044F
      \u0441\u0443\u043C\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0442 \u043C\u043E\u043B\u0447\u0430
      \u2014 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0445\u043E\u0447\u0435\u0442
      \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C, \u0447\u0442\u043E
      \u0437\u0434\u0435\u0441\u044C \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643697
    m_Localized: "\u041F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643698
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643699
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 10857774513643700
    m_Localized: "\u0417\u043D\u0430\u043C\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 12957013737725952
    m_Localized: "\u0417\u0430\u0434\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643201191936
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u043D\u0438\u043A \u0441 \u043A\u0430\u0440\u0442\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643234746368
    m_Localized: "\u041D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435, \u043C\u0435\u0436\u0434\u0443
      \u043B\u043E\u0442\u043A\u0430\u043C\u0438 \u0441 \u043F\u0440\u044F\u043D\u043E\u0441\u0442\u044F\u043C\u0438
      \u0438 \u043C\u0435\u0434\u043D\u043E\u0439 \u043F\u043E\u0441\u0443\u0434\u043E\u0439,
      \u0432\u044B \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442\u0435 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0435 \u0442\u043E\u0440\u0433\u0443\u0435\u0442
      \u0438 \u043D\u0435 \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0442 \u2014
      \u043E\u043D \u0441\u0442\u043E\u0438\u0442 \u0443 \u0441\u0442\u0435\u043D\u044B,
      \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u044B\u0439
      \u0441\u0432\u0438\u0442\u043E\u043A. \u041E\u0434\u0435\u0436\u0434\u0430
      \u043F\u043E\u0442\u0451\u0440\u0442\u0430\u044F, \u0434\u043E\u0440\u043E\u0436\u043D\u0430\u044F,
      \u043D\u043E \u0442\u043A\u0430\u043D\u044C \u043A\u043E\u0433\u0434\u0430-\u0442\u043E
      \u0431\u044B\u043B\u0430 \u0434\u043E\u0440\u043E\u0433\u043E\u0439. \u0417\u0430\u043C\u0435\u0442\u0438\u0432
      \u0432\u0430\u0448 \u0432\u0437\u0433\u043B\u044F\u0434, \u043E\u043D \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u0438 \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0441\u0432\u0438\u0442\u043E\u043A:
      \u0434\u0440\u0435\u0432\u043D\u044F\u044F \u043A\u0430\u0440\u0442\u0430 \u043D\u0430
      \u043F\u043E\u0436\u0435\u043B\u0442\u0435\u0432\u0448\u0435\u043C \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0435,
      \u0438\u0441\u043F\u0435\u0449\u0440\u0451\u043D\u043D\u0430\u044F \u0437\u043D\u0430\u043A\u0430\u043C\u0438
      \u043D\u0430 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u043E\u043C \u044F\u0437\u044B\u043A\u0435.\r\n\r\n<npc_speech
      lang=\"Persian\">\u041F\u0440\u0438\u0432\u0435\u0442, \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446!
      \u042F \u0424\u0430\u0440\u0443\u0445 \u2014 \u043A\u043E\u043F\u0430\u044E
      \u0441\u0442\u0430\u0440\u044B\u0435 \u0440\u0443\u0438\u043D\u044B \u0438
      \u0438\u0449\u0443 \u0437\u0430\u0431\u044B\u0442\u043E\u0435. \u042D\u0442\u0430
      \u043A\u0430\u0440\u0442\u0430 \u2014 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F,
      \u043A\u043B\u044F\u043D\u0443\u0441\u044C \u043F\u0440\u0430\u0445\u043E\u043C
      \u043E\u0442\u0446\u0430. \u041D\u043E \u043C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D. \u0422\u0435\u0431\u0435 \u2014
      \u0434\u0435\u043D\u044C\u0433\u0438. \u041C\u043E\u0436\u0435\u0442, \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C\u0441\u044F?</npc_speech>"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940672
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940673
    m_Localized: "\u0412\u044B \u043A\u0430\u0447\u0430\u0435\u0442\u0435 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
      \u0438 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u0435 \u0424\u0430\u0440\u0443\u0445\u0430
      \u0437\u0430 \u0440\u0430\u0441\u0441\u043A\u0430\u0437. \u041E\u043D \u043D\u0435
      \u043E\u0431\u0438\u0436\u0430\u0435\u0442\u0441\u044F \u2014 \u043F\u0440\u044F\u0447\u0435\u0442
      \u043A\u0430\u0440\u0442\u0443 \u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u0443
      \u0438 \u043A\u0438\u0432\u0430\u0435\u0442. \xAB\u0414\u043E\u0440\u043E\u0433\u0430
      \u0434\u043B\u0438\u043D\u043D\u0430, \u043C\u043E\u0436\u0435\u0442, \u0435\u0449\u0451
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F.\xBB \u0412\u044B
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0435 \u043F\u0443\u0442\u044C
      \u0441 \u043B\u0451\u0433\u043A\u0438\u043C \u0441\u0435\u0440\u0434\u0446\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940674
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043A\u0430\u0440\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940675
    m_Localized: "\u0412\u044B \u0440\u0430\u0437\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u043A\u0430\u0440\u0442\u0443 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441
      \u0424\u0430\u0440\u0443\u0445\u043E\u043C \u2014 \u0437\u043D\u0430\u043A\u0438
      \u0441\u0442\u0430\u0440\u044B\u0435, \u043D\u043E \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F: \u0447\u0435\u0440\u0435\u0437
      \u043F\u0443\u0441\u0442\u044B\u043D\u0438 \u0438 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u044B
      \u043A \u043C\u0435\u0441\u0442\u0430\u043C, \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u043C
      \u0442\u043E\u0447\u043A\u0430\u043C\u0438 \u0438 \u043F\u043E\u043B\u0443\u043C\u0435\u0441\u044F\u0446\u0430\u043C\u0438.
      \u0424\u0430\u0440\u0443\u0445 \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0441\u0432\u0438\u0442\u043E\u043A \u0432\u0430\u043C \u0432 \u0440\u0443\u043A\u0443.
      \xAB\u0411\u0435\u0440\u0435\u0433\u0438 \u0435\u0451. \u041F\u0435\u0440\u0432\u0430\u044F
      \u043C\u0435\u0442\u043A\u0430 \u2014 \u0433\u0434\u0435-\u0442\u043E \u043C\u0435\u0436\u0434\u0443
      \u041A\u0430\u0448\u0433\u0430\u0440\u043E\u043C \u0438 \u0410\u043D\u044C\u0441\u0438.
      \u0420\u0430\u0441\u0448\u0438\u0444\u0440\u0443\u0439 \u0437\u043D\u0430\u043A\u0438
      \u2014 \u0438 \u0443\u0437\u043D\u0430\u0435\u0448\u044C, \u0447\u0442\u043E
      \u0438\u0441\u043A\u0430\u0442\u044C.\xBB \u041E\u043D \u0445\u043B\u043E\u043F\u0430\u0435\u0442
      \u0432\u0430\u0441 \u043F\u043E \u043F\u043B\u0435\u0447\u0443 \u0438 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044F\u0435\u0442\u0441\u044F
      \u0432 \u0442\u043E\u043B\u043F\u0435 \u0431\u0430\u0437\u0430\u0440\u0430,
      \u043E\u0441\u0442\u0430\u0432\u0438\u0432 \u043A\u0430\u0440\u0442\u0443 \u0438
      \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435 \u043D\u0430\u0447\u0430\u043B\u0430
      \u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940676
    m_Localized: "\u0412\u044B \u0431\u0435\u0440\u0451\u0442\u0435 \u043A\u0430\u0440\u0442\u0443,
      \u043D\u043E \u0424\u0430\u0440\u0443\u0445 \u0432\u0438\u0434\u0438\u0442,
      \u0447\u0442\u043E \u0432\u044B \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442\u0435
      \u043D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0437\u043D\u0430\u043A\u0430.
      \u041E\u043D \u0432\u0437\u0434\u044B\u0445\u0430\u0435\u0442 \u0438 \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442
      \u0441\u0432\u0438\u0442\u043E\u043A \u043E\u0431\u0440\u0430\u0442\u043D\u043E,
      \u043F\u043E\u0442\u043E\u043C \u043D\u0435\u0445\u043E\u0442\u044F \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442.
      \xAB\u041B\u0430\u0434\u043D\u043E. \u041A\u0430\u0440\u0442\u0430 \u0442\u0432\u043E\u044F,
      \u043D\u043E \u0431\u0435\u0437 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043E\u043A.
      \u041F\u0435\u0440\u0432\u0430\u044F \u043C\u0435\u0442\u043A\u0430 \u2014
      \u0433\u0434\u0435-\u0442\u043E \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A\u0435.
      \u0420\u0430\u0437\u0431\u0435\u0440\u0451\u0448\u044C\u0441\u044F \u0441\u0430\u043C.\xBB
      \u041E\u043D \u0443\u0445\u043E\u0434\u0438\u0442, \u043D\u0435 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C.
      \u041A\u0430\u0440\u0442\u0430 \u0432 \u0432\u0430\u0448\u0438\u0445 \u0440\u0443\u043A\u0430\u0445,
      \u043D\u043E \u0431\u0435\u0437 \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0439
      \u0424\u0430\u0440\u0443\u0445\u0430 \u0434\u043E\u0440\u043E\u0433\u0430 \u0431\u0443\u0434\u0435\u0442
      \u0442\u0440\u0443\u0434\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940677
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430\u0434\u043F\u0438\u0441\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940678
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u0441\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0441\u044F \u043D\u0430\u0434
      \u043A\u0430\u0440\u0442\u043E\u0439 \u0438 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u0447\u0438\u0442\u0430\u0442\u044C \u2014 \u043D\u0430\u0434\u043F\u0438\u0441\u0438
      \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u043D\u0430 \u0441\u0442\u0430\u0440\u043E-\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u043C,
      \u0441 \u043F\u0440\u0438\u043C\u0435\u0441\u044C\u044E \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0433\u043E.
      \u0424\u0430\u0440\u0443\u0445 \u0432\u043E\u0441\u0445\u0438\u0449\u0451\u043D\u043D\u043E
      \u0446\u043E\u043A\u0430\u0435\u0442 \u044F\u0437\u044B\u043A\u043E\u043C.
      \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442, \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u043A\u043B\u044E\u0447\u0435\u0432\u044B\u0435 \u043C\u0435\u0442\u043A\u0438
      \u0438 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0438\u0442 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F,
      \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0435 \u043C\u0435\u043B\u043A\u0438\u043C
      \u043F\u043E\u0447\u0435\u0440\u043A\u043E\u043C \u043D\u0430 \u043F\u043E\u043B\u044F\u0445.
      \u0424\u0430\u0440\u0443\u0445 \u0442\u043E\u0440\u0436\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
      \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043A\u0430\u0440\u0442\u0443
      \u0432\u0430\u043C \u0432 \u0440\u0443\u043A\u0443. \xAB\u0421 \u0442\u0430\u043A\u0438\u043C
      \u0442\u043E\u043B\u043C\u0430\u0447\u043E\u043C \u2014 \u0441\u043F\u0440\u0430\u0432\u0438\u0442\u0435\u0441\u044C.
      \u041F\u0435\u0440\u0432\u0430\u044F \u043C\u0435\u0442\u043A\u0430 \u043C\u0435\u0436\u0434\u0443
      \u041A\u0430\u0448\u0433\u0430\u0440\u043E\u043C \u0438 \u0410\u043D\u044C\u0441\u0438,
      \u0430 \u0434\u0430\u043B\u044C\u0448\u0435 \u2014 \u043A\u0430\u0440\u0442\u0430
      \u043F\u043E\u0434\u0441\u043A\u0430\u0436\u0435\u0442.\xBB \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435
      \u0441 \u0440\u044B\u043D\u043A\u0430 \u0441 \u0447\u0451\u0442\u043A\u043E\u0439
      \u0446\u0435\u043B\u044C\u044E \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C\u0438
      \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u043C\u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438,
      \u043E\u0441\u0435\u0432\u0448\u0438\u043C\u0438 \u0432 \u043F\u0430\u043C\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940679
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940680
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      \u0440\u0430\u0441\u043F\u0430\u0445\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u0448\u0438\u043C \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u043C,
      \u0438 \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u043F\u0435\u0440\u0435\u0434
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u0435\u043C
      \u0432\u0430\u0441 \u0443\u0436\u0435 \u0436\u0434\u0451\u0442 \u0412\u0430\u0445\u0443-\u041C\u0430\u043D.
      \u041E\u043D \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442
      \u0442\u044E\u043A\u0438 \u0448\u0451\u043B\u043A\u0430 \u2014 \u043F\u0440\u0438\u0434\u0438\u0440\u0447\u0438\u0432\u043E,
      \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044F \u043A\u0430\u0436\u0434\u044B\u0439,
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044F \u043D\u0438\u0442\u0438 \u043D\u0430
      \u0441\u0432\u0435\u0442. \u041F\u043E\u0442\u043E\u043C \u0432\u044B\u043F\u0440\u044F\u043C\u043B\u044F\u0435\u0442\u0441\u044F
      \u0438 \u0432\u043F\u0435\u0440\u0432\u044B\u0435 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E-\u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u043C\u0443.
      \xAB\u0414\u0435\u0441\u044F\u0442\u044C \u0442\u044E\u043A\u043E\u0432, \u0431\u0435\u0437
      \u0435\u0434\u0438\u043D\u043E\u0439 \u043C\u043E\u043B\u0438, \u0431\u0435\u0437
      \u0441\u043B\u0435\u0434\u043E\u0432 \u0432\u043E\u0434\u044B. \u0422\u044B
      \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A
      \u2014 \u0442\u044B \u043C\u0430\u0441\u0442\u0435\u0440.\xBB \u041E\u043D
      \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0438\u0437-\u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u0438
      \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u043A\u043E\u0448\u0435\u043B\u044C
      \u0441 \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C \u0438 \u043D\u043E\u0432\u0443\u044E
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443 \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438. \xAB\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u2014 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u0435\u0435.
      \u0413\u043E\u0442\u043E\u0432?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940681
    m_Localized: "\u0413\u043E\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940682
    m_Localized: "\u0412\u044B \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442\u0435
      \u0440\u0443\u043A\u0443 \u0412\u0430\u0445\u0443-\u041C\u0430\u043D\u0430.
      \u0413\u0440\u0430\u043C\u043E\u0442\u0430 \u0433\u0438\u043B\u044C\u0434\u0438\u0438
      \u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u043E\u0439, \u0441\u0435\u0440\u0435\u0431\u0440\u043E
      \u0432 \u043A\u043E\u0448\u0435\u043B\u0435, \u043F\u0443\u0442\u044C \u0432
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434 \u043F\u043E\u0437\u0430\u0434\u0438
      \u2014 \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940683
    m_Localized: "\u0421\u0432\u0438\u0442\u043E\u043A \u0434\u043B\u044F \u0422\u0438\u043D\u043B\u0435\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940684
    m_Localized: "\u041F\u0435\u0449\u0435\u0440\u044B \u041C\u043E\u0433\u0430\u043E
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0442 \u0432\u0430\u0441 \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043E\u0439
      \u0438 \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u0431\u043B\u0430\u0433\u043E\u0432\u043E\u043D\u0438\u0439.
      \u0412 \u043F\u043E\u043B\u0443\u043C\u0440\u0430\u043A\u0435 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0433\u043E
      \u0437\u0430\u043B\u0430 \u043C\u043E\u043D\u0430\u0445 \u0432 \u0431\u0430\u0433\u0440\u044F\u043D\u043E\u0439
      \u043A\u0430\u0448\u0430\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443 \u2014 \u0445\u0443\u0434\u043E\u0439,
      \u0441 \u0431\u0440\u0438\u0442\u043E\u0439 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
      \u0438 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438.
      \xAB\u042F \u0422\u0438\u043D\u043B\u0435\u0439. \u041B\u043E\u0431\u0441\u0430\u043D\u0433
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B, \u0447\u0442\u043E \u0442\u044B
      \u043F\u0440\u0438\u0434\u0451\u0448\u044C.\xBB \u0412\u044B \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442\u0435
      \u0441\u0432\u0438\u0442\u043E\u043A, \u0438 \u043C\u043E\u043D\u0430\u0445
      \u0431\u0435\u0440\u0435\u0436\u043D\u043E \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0435\u0433\u043E, \u0447\u0438\u0442\u0430\u044F \u043F\u0440\u0438 \u0441\u0432\u0435\u0442\u0435
      \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0439 \u043B\u0430\u043C\u043F\u044B.
      \u0415\u0433\u043E \u043B\u0438\u0446\u043E \u043E\u0437\u0430\u0440\u044F\u0435\u0442\u0441\u044F.
      \xAB\u042D\u0442\u043E \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435 \u0434\u0440\u0435\u0432\u043D\u0435\u0435,
      \u0447\u0435\u043C \u044F \u0434\u0443\u043C\u0430\u043B. \u0422\u044B \u0441\u0434\u0435\u043B\u0430\u043B
      \u0434\u043E\u0431\u0440\u043E\u0435 \u0434\u0435\u043B\u043E, \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A.\xBB
      \u041E\u043D \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0441\u0432\u0438\u0442\u043E\u043A
      \u0432 \u043A\u0430\u043C\u0435\u043D\u043D\u0443\u044E \u043D\u0438\u0448\u0443
      \u0438 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u0432\u0430\u043C. \xAB\u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u043F\u0440\u043E\u0441\u0438\u043B
      \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C: \u043F\u0443\u0442\u044C
      \u043D\u0435 \u043E\u043A\u043E\u043D\u0447\u0435\u043D. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435
      \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435 \u0436\u0434\u0451\u0442.
      \u0413\u043E\u0442\u043E\u0432 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940685
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u044E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940686
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u0432\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0432 \u0432\u0430\u0448\u0443 \u0440\u0443\u043A\u0443 \u043D\u043E\u0432\u044B\u0439
      \u0441\u0432\u0438\u0442\u043E\u043A \u0438 \u043F\u0430\u043B\u043E\u0447\u043A\u0443
      \u043B\u0430\u0434\u0430\u043D\u0430. \xAB\u0414\u043E\u0440\u043E\u0433\u0430
      \u0437\u043D\u0430\u0435\u0442 \u0442\u0435\u0431\u044F \u0442\u0435\u043F\u0435\u0440\u044C.
      \u0418\u0434\u0438.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940687
    m_Localized: "\u041A\u043E\u043D\u0432\u043E\u0439 \u0432 \u0410\u043D\u044C\u0441\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940688
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0410\u043D\u044C\u0441\u0438
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0437\u0430
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u043C
      \u0434\u043E\u0440\u043E\u0433\u0438, \u0438 \u0432\u0430\u0448\u0438 \u043F\u043E\u0434\u043E\u043F\u0435\u0447\u043D\u044B\u0435
      \u2014 \u0433\u0440\u0443\u043F\u043F\u0430 \u043C\u043E\u043B\u043E\u0434\u044B\u0445
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432, \u0432\u043F\u0435\u0440\u0432\u044B\u0435
      \u0432\u044B\u0448\u0435\u0434\u0448\u0438\u0445 \u043D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C \u2014 \u0440\u0430\u0437\u0440\u0430\u0436\u0430\u044E\u0442\u0441\u044F
      \u0440\u0430\u0434\u043E\u0441\u0442\u043D\u044B\u043C\u0438 \u043A\u0440\u0438\u043A\u0430\u043C\u0438.
      \u0414\u0430\u0440\u0438\u0443\u0448 \u0431\u044B\u043B \u043F\u0440\u0430\u0432:
      \u043E\u043D\u0438 \u043D\u0435\u043E\u043F\u044B\u0442\u043D\u044B, \u043D\u043E
      \u0436\u0438\u0432\u044B \u0438 \u043F\u0440\u0438 \u0442\u043E\u0432\u0430\u0440\u0435.
      \u041D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u0443 \u043A\u0430\u0440\u0430\u0432\u0430\u043D-\u0441\u0430\u0440\u0430\u044F
      \u0432\u0430\u0441 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u043C\u0435\u0441\u0442\u043D\u044B\u0439
      \u0441\u0442\u0430\u0440\u0448\u0438\u043D\u0430. \u041E\u043D \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442
      \u043Aa\u0440\u0430\u0432\u0430\u043D, \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442
      \u043B\u044E\u0434\u0435\u0439 \u0438 \u043A\u0438\u0432\u0430\u0435\u0442
      \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C. \xAB\u0414\u0430\u0440\u0438\u0443\u0448
      \u0432\u044B\u0431\u0440\u0430\u043B \u0445\u043E\u0440\u043E\u0448\u043E.
      \u0417\u0430 \u043A\u043E\u043D\u0432\u043E\u0439 \u2014 \u043D\u0430\u0433\u0440\u0430\u0434\u0430.\xBB
      \u041E\u043D \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u0444\u0443\u0442\u043B\u044F\u0440
      \u0441 \u0433\u043B\u0438\u043D\u044F\u043D\u044B\u043C \u0441\u043E\u0441\u0443\u0434\u043E\u043C.
      \xAB\u0413\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u0439 \u043E\u0433\u043E\u043D\u044C.
      \u0414\u0430\u0440\u0438\u0443\u0448 \u043F\u0440\u043E\u0441\u0438\u0442:
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u0447\u0435\u0440\u0435\u0437 \u041C\u0435\u0448\u0445\u0435\u0434 \u2014
      \u043E\u043F\u0430\u0441\u043D\u044B\u0439 \u0433\u0440\u0443\u0437. \u0411\u0435\u0440\u0451\u0448\u044C\u0441\u044F
      \u0441\u0440\u0430\u0437\u0443 \u0438\u043B\u0438 \u043E\u0431\u0434\u0443\u043C\u0430\u0435\u0448\u044C?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940689
    m_Localized: "\u0411\u0435\u0440\u0443 \u043C\u0430\u0440\u0448\u0440\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940690
    m_Localized: "\u0421\u0442\u0430\u0440\u0448\u0438\u043D\u0430 \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0445\u043B\u043E\u043F\u0430\u0435\u0442 \u0432\u0430\u0441 \u043F\u043E
      \u043F\u043B\u0435\u0447\u0443 \u0438 \u0448\u0451\u043F\u043E\u0442\u043E\u043C
      \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442: \xAB\u0414\u0430\u0440\u0438\u0443\u0448
      \u0436\u0434\u0451\u0442 \u0442\u0435\u0431\u044F \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435.
      \u0421 \u0433\u0440\u0443\u0437\u043E\u043C \u043D\u0435 \u0442\u044F\u043D\u0438.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940691
    m_Localized: "\u041A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044C \u0438\u0437
      \u0427\u0430\u043D\u044A\u0430\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940692
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0433\u0443\u043B\u043E\u043C \u0432\u0435\u043B\u0438\u0447\u0430\u0439\u0448\u0435\u0433\u043E
      \u0440\u044B\u043D\u043A\u0430 \u043C\u0438\u0440\u0430. \u041C\u0430\u0441\u0442\u0435\u0440
      \u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u0436\u0434\u0451\u0442 \u0443
      \u0432\u043E\u0440\u043E\u0442 \u0441\u0432\u043E\u0435\u0439 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u043E\u0439
      \u2014 \u0443\u0437\u043A\u043E\u0439, \u043F\u0440\u043E\u043F\u0430\u0445\u0448\u0435\u0439
      \u0438\u043D\u0434\u0438\u0433\u043E, \u0441 \u0440\u044F\u0434\u0430\u043C\u0438
      \u0433\u043B\u0438\u043D\u044F\u043D\u044B\u0445 \u0447\u0430\u043D\u043E\u0432
      \u0432\u0434\u043E\u043B\u044C \u0441\u0442\u0435\u043D. \u041E\u043D \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0441\u044B\u0440\u044C\u0451, \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u0432\u0451\u0440\u0442\u043E\u043A,
      \u043D\u044E\u0445\u0430\u0435\u0442, \u0440\u0430\u0441\u0442\u0438\u0440\u0430\u0435\u0442
      \u043C\u0435\u0436\u0434\u0443 \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438.
      \u041F\u043E\u0442\u043E\u043C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0433\u043B\u0430\u0437\u0430 \u0438 \u043A\u0438\u0432\u0430\u0435\u0442.
      \xAB\u041D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435. \u0422\u044B \u043D\u0435
      \u043F\u043E\u0434\u0432\u0451\u043B.\xBB \u041E\u043D \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442
      \u0432\u0430\u0441 \u0432 \u0437\u0430\u0434\u043D\u044E\u044E \u043A\u043E\u043C\u043D\u0430\u0442\u0443,
      \u0433\u0434\u0435 \u043D\u0430 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u043C
      \u0441\u0442\u043E\u043B\u0435 \u043B\u0435\u0436\u0430\u0442 \u043E\u0431\u0440\u0430\u0437\u0446\u044B
      \u0442\u043A\u0430\u043D\u0438 \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E\u0433\u043E
      \u043F\u0443\u0440\u043F\u0443\u0440\u043D\u043E\u0433\u043E \u043E\u0442\u0442\u0435\u043D\u043A\u0430.
      \xAB\u0421\u0435\u043A\u0440\u0435\u0442 \u043F\u0443\u0440\u043F\u0443\u0440\u0430
      \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043D\u043E\u0432\u043E\u0433\u043E
      \u0448\u0430\u0433\u0430. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435
      \u0434\u0435\u043B\u043E \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u0435\u0435.
      \u0412\u043E\u0437\u044C\u043C\u0451\u0448\u044C\u0441\u044F \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u2014 \u0438\u043B\u0438 \u0437\u0430\u0439\u0434\u0451\u0448\u044C, \u043A\u043E\u0433\u0434\u0430
      \u0431\u0443\u0434\u0435\u0448\u044C \u0433\u043E\u0442\u043E\u0432?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940693
    m_Localized: "\u0413\u043E\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940694
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440 \u0427\u044D\u043D\u044C \u0412\u044D\u0439
      \u043A\u0438\u0432\u0430\u0435\u0442, \u043F\u0440\u044F\u0447\u0435\u0442
      \u0443\u043B\u044B\u0431\u043A\u0443 \u0432 \u0441\u0435\u0434\u044B\u0435
      \u0443\u0441\u044B \u0438 \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0438\u0437
      \u0448\u043A\u0430\u0444\u0430 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A \u0441 \u043E\u0431\u0440\u0430\u0437\u0446\u0430\u043C\u0438.
      \xAB\u0422\u043E\u0433\u0434\u0430 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C
      \u043E \u043F\u0443\u0440\u043F\u0443\u0440\u0435. \u0418\u0434\u0451\u043C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940695
    m_Localized: "\u0420\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0430
      \u043A\u0430\u0440\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940696
    m_Localized: "\u041F\u0440\u0438\u0432\u0430\u043B \u0443 \u043A\u043E\u0441\u0442\u0440\u0430.
      \u0412\u044B \u0434\u043E\u0441\u0442\u0430\u0451\u0442\u0435 \u043A\u0430\u0440\u0442\u0443
      \u0424\u0430\u0440\u0443\u0445\u0430 \u0438 \u0440\u0430\u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u043D\u0430 \u043F\u043B\u043E\u0441\u043A\u043E\u043C \u043A\u0430\u043C\u043D\u0435.
      \u041F\u0440\u0438 \u0441\u0432\u0435\u0442\u0435 \u043E\u0433\u043D\u044F
      \u0437\u043D\u0430\u043A\u0438 \u043D\u0430 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0435
      \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F \u044F\u0441\u043D\u0435\u0435
      \u2014 \u0437\u0430\u0432\u0438\u0442\u043A\u0438 \u0441\u0442\u0430\u0440\u043E-\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u0433\u043E
      \u043F\u0438\u0441\u044C\u043C\u0430 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0432 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F \u043C\u0435\u0441\u0442,
      \u0441\u0442\u0440\u0435\u043B\u043A\u0438 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F, \u0430
      \u043C\u0435\u043B\u043A\u0438\u0435 \u043F\u043E\u043C\u0435\u0442\u043A\u0438
      \u043D\u0430 \u043F\u043E\u043B\u044F\u0445 \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u044E\u0442
      \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B. \u041C\u0430\u0440\u0448\u0440\u0443\u0442
      \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u0430\u0435\u0442: \u043F\u0435\u0440\u0432\u0430\u044F
      \u0442\u043E\u0447\u043A\u0430 \u0432\u0435\u0434\u0451\u0442 \u043A \u0440\u0443\u0438\u043D\u0430\u043C
      \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u043E \u0445\u0440\u0430\u043C\u0430,
      \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u043E\u0433\u043E \u043F\u043E\u043B\u0443\u043C\u0435\u0441\u044F\u0446\u0435\u043C.
      \u041A\u0430\u0440\u0442\u0430 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C. \u0421\u0435\u0441\u0442\u044C
      \u0438 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0441\u0435\u0439\u0447\u0430\u0441
      \u2014 \u0438\u043B\u0438 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u043A \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0435 \u043F\u043E\u0437\u0436\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940697
    m_Localized: "\u0420\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u0442\u044C
      \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940698
    m_Localized: "\u0412\u044B \u0441\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0435\u0441\u044C
      \u043D\u0430\u0434 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u043E\u043C
      \u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442\u0435 \u0434\u043E
      \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u043D\u043E\u0447\u0438.
      \u0417\u043D\u0430\u043A\u0438 \u0443\u0441\u0442\u0443\u043F\u0430\u044E\u0442,
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u0430\u0435\u0442
      \u0447\u0451\u0442\u0447\u0435. \u041F\u0435\u0440\u0432\u0430\u044F \u0442\u043E\u0447\u043A\u0430
      \u044F\u0441\u043D\u0430 \u2014 \u0438 \u0442\u0435\u043F\u0435\u0440\u044C
      \u043A\u0430\u0440\u0442\u0430 \u0441\u0442\u0430\u043D\u0435\u0442 \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u043C
      \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940699
    m_Localized: "\u041F\u0435\u0440\u0432\u0430\u044F \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940700
    m_Localized: "\u0420\u0443\u0438\u043D\u044B \u0445\u0440\u0430\u043C\u0430 \u0432\u043E\u0437\u0432\u044B\u0448\u0430\u044E\u0442\u0441\u044F
      \u043D\u0430\u0434 \u043F\u0435\u0441\u043A\u0430\u043C\u0438 \u2014 \u043E\u0431\u043B\u043E\u043C\u043A\u0438
      \u043A\u043E\u043B\u043E\u043D\u043D, \u043E\u0441\u0442\u0430\u0442\u043A\u0438
      \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0445 \u0441\u0442\u0435\u043D,
      \u0437\u0430\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0435 \u043F\u0435\u0441\u043A\u043E\u043C
      \u0441\u0442\u0443\u043F\u0435\u043D\u0438. \u0412\u044B \u0441\u0432\u0435\u0440\u044F\u0435\u0442\u0435\u0441\u044C
      \u0441 \u043A\u0430\u0440\u0442\u043E\u0439 \u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435
      \u043D\u0443\u0436\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E \u2014
      \u043D\u0438\u0448\u0443 \u0432 \u0443\u0446\u0435\u043B\u0435\u0432\u0448\u0435\u0439
      \u0441\u0442\u0435\u043D\u0435, \u0441\u043A\u0440\u044B\u0442\u0443\u044E
      \u0437\u0430 \u043E\u0431\u0432\u0430\u043B\u0438\u0432\u0448\u0438\u043C\u0441\u044F
      \u043A\u0430\u043C\u043D\u0435\u043C. \u0412\u043D\u0443\u0442\u0440\u0438
      \u2014 \u0437\u0430\u0432\u0451\u0440\u043D\u0443\u0442\u0430\u044F \u0432
      \u0438\u0441\u0442\u043B\u0435\u0432\u0448\u0443\u044E \u0442\u043A\u0430\u043D\u044C
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u0430\u044F \u0444\u0438\u0433\u0443\u0440\u043A\u0430:
      \u0434\u0440\u0435\u0432\u043D\u0438\u0439 \u0431\u043E\u0436\u043E\u043A \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445
      \u043F\u0443\u0442\u0435\u0439 \u0441 \u043B\u0438\u0446\u043E\u043C, \u0441\u0442\u0451\u0440\u0442\u044B\u043C
      \u0432\u0435\u043A\u0430\u043C\u0438. \u041A\u0430\u0440\u0442\u0430 \u043D\u0435
      \u0441\u043E\u043B\u0433\u0430\u043B\u0430. \u0424\u0430\u0440\u0443\u0445
      \u0437\u043D\u0430\u043B \u0441\u0432\u043E\u0451 \u0434\u0435\u043B\u043E.
      \u041D\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
      \u0444\u0438\u0433\u0443\u0440\u043A\u0438 \u0432\u044B\u0446\u0430\u0440\u0430\u043F\u0430\u043D\u0430
      \u043D\u0430\u0434\u043F\u0438\u0441\u044C \u2014 \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0442\u0430\u0439\u043D\u0438\u043A\u0430.
      \u041E\u0445\u043E\u0442\u0430 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F.
      \u0414\u0432\u0438\u043D\u0443\u0442\u044C\u0441\u044F \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0442\u043E\u0447\u043A\u0435 \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u2014 \u0438\u043B\u0438 \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434?"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940701
    m_Localized: "\u041A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u0442\u043E\u0447\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 12985643238940702
    m_Localized: "\u0411\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0439 \u0438\u0434\u043E\u043B
      \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432
      \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u043C\u0435\u0448\u043E\u043A,
      \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B \u2014 \u0432
      \u043F\u0430\u043C\u044F\u0442\u044C. \u041A\u0430\u0440\u0442\u0430 \u0424\u0430\u0440\u0443\u0445\u0430
      \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u044F\u0445, \u0438 \u0432\u044B
      \u043F\u0440\u043E\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u043A\u0443\u0440\u0441 \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443
      \u0445\u0440\u0430\u043C\u0443. \u041E\u0445\u043E\u0442\u0430 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240325435392
    m_Localized: "\u041B\u043E\u0432\u0443\u0448\u043A\u0438 \u0432 \u0442\u0440\u0430\u0432\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378432
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u043A\u0442\u043E-\u0442\u043E
      \u0441\u043B\u044B\u0448\u0430\u043B \u0432\u043E\u0437\u043D\u044E \u0443
      \u0431\u043B\u0438\u0436\u043D\u0438\u0445 \u043A\u0443\u0441\u0442\u043E\u0432.
      \u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B \u043F\u0440\u0438\u043C\u044F\u0442\u0443\u044E
      \u0442\u0440\u043E\u043F\u043A\u0443: \u0437\u0430\u0439\u0446\u044B. \u041E\u043D
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043F\u0435\u0442\u043B\u044E
      \u0438\u0437 \u043A\u043E\u043D\u0441\u043A\u043E\u0433\u043E \u0432\u043E\u043B\u043E\u0441\u0430
      \u0438 \u043A\u0438\u0432\u0430\u0435\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u0441\u0442\u0435\u043F\u0438. \u0417\u0430\u043F\u0430\u0441\u044B \u043D\u0430
      \u0442\u0440\u0438 \u0434\u043D\u044F, \u043D\u0435 \u0431\u043E\u043B\u044C\u0448\u0435.
      \u0414\u0438\u0447\u044C \u0440\u044F\u0434\u043E\u043C, \u043D\u043E \u043F\u0435\u0442\u043B\u044F
      \u043D\u0435\u043D\u0430\u0434\u0451\u0436\u043D\u0430, \u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0432 \u0442\u0440\u0430\u0432\u0435 \u0432\u0438\u0434\u0435\u043D \u0442\u043E\u043C\u0443,
      \u043A\u0442\u043E \u043D\u0435 \u0441\u043F\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378433
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u0435\u0442\u043B\u0438
      \u0443 \u043B\u0430\u0433\u0435\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378434
    m_Localized: "\u041F\u0435\u0442\u043B\u0438 \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u0432\u0434\u043E\u043B\u044C \u0442\u0440\u043E\u043F\u043E\u043A \u0432
      \u043F\u044F\u0442\u0438\u0434\u0435\u0441\u044F\u0442\u0438 \u0448\u0430\u0433\u0430\u0445
      \u043E\u0442 \u043B\u0430\u0433\u0435\u0440\u044F. \u041A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443
      \u0432 \u0434\u0432\u0443\u0445 \u0438\u0437 \u043D\u0438\u0445 \u0441\u0438\u0434\u0435\u043B\u0438
      \u0436\u0438\u0440\u043D\u044B\u0435 \u0437\u0430\u0439\u0446\u044B. \u041D\u0435\u0433\u0443\u0441\u0442\u043E,
      \u043D\u043E \u043A\u043E\u0442\u0451\u043B \u0431\u0443\u043B\u044C\u043A\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378435
    m_Localized: "\u0423\u0433\u043B\u0443\u0431\u0438\u0442\u044C\u0441\u044F \u0432
      \u0441\u0442\u0435\u043F\u044C \u0441 \u0441\u0435\u0442\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378436
    m_Localized: "\u041E\u0445\u043E\u0442\u043D\u0438\u043A \u043F\u0440\u043E\u0441\u043B\u0435\u0434\u0438\u043B
      \u0442\u0440\u043E\u043F\u043A\u0438 \u0434\u043E \u0441\u0442\u0430\u0440\u0438\u0446\u044B.
      \u0422\u0430\u043C \u043F\u0438\u0440\u043E\u0432\u0430\u043B\u0430 \u0441\u0442\u0430\u044F
      \u043A\u0443\u0440\u043E\u043F\u0430\u0442\u043E\u043A. \u0421\u0435\u0442\u044C
      \u043B\u0435\u0433\u043B\u0430 \u0442\u043E\u0447\u043D\u043E. \u0414\u0432\u0430
      \u0447\u0430\u0441\u0430, \u0438 \u043E\u0431\u043E\u0437 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0435\u043D
      \u043C\u044F\u0441\u043E\u043C \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378437
    m_Localized: "\u0412 \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u043E\u0445\u043E\u0442\u043D\u0438\u043A
      \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u043B \u0432 \u043D\u043E\u0440\u0443
      \u0438 \u0432\u044B\u0432\u0438\u0445\u043D\u0443\u043B \u043B\u043E\u0434\u044B\u0436\u043A\u0443.
      \u041F\u0435\u0442\u043B\u0438 \u043D\u0430\u0448\u043B\u0438 \u043F\u0443\u0441\u0442\u044B\u043C\u0438.
      \u0412\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0441 \u043F\u0443\u0441\u0442\u044B\u043C\u0438
      \u0440\u0443\u043A\u0430\u043C\u0438 \u0438 \u0432\u0441\u0442\u0440\u0435\u0432\u043E\u0436\u0435\u043D\u043D\u044B\u043C
      \u043B\u0438\u0446\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378438
    m_Localized: "\u041E\u043F\u044B\u0442\u043D\u044B\u0439 \u0441\u043B\u0435\u0434\u043E\u043F\u044B\u0442
      \u0431\u0435\u0440\u0451\u0442 \u0441\u043B\u0435\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378439
    m_Localized: "\u0421\u043B\u0435\u0434\u043E\u043F\u044B\u0442 \u043F\u0440\u043E\u0432\u0451\u043B
      \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u043F\u043E \u043F\u0440\u0438\u043C\u044F\u0442\u043E\u0439
      \u0442\u0440\u0430\u0432\u0435. \"\u0414\u0436\u0435\u0439\u0440\u0430\u043D\u044B.
      \u0412\u043E\u0434\u043E\u043F\u043E\u0439 \u0437\u0430 \u0433\u0440\u044F\u0434\u043E\u0439.\"
      \u041A \u043F\u043E\u043B\u0443\u0434\u043D\u044E \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0441 \u0442\u0443\u0448\u0435\u0439 \u043D\u0430 \u043F\u043B\u0435\u0447\u0430\u0445.
      \u041C\u044F\u0441\u0430 \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0433\u043E\u0440\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378440
    m_Localized: "\u042F\u0433\u043E\u0434\u043D\u0430\u044F \u043B\u043E\u0449\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378441
    m_Localized: "\u0423 \u0440\u0443\u0447\u044C\u044F, \u0432 \u043D\u0438\u0437\u0438\u043D\u043A\u0435,
      \u0441\u0442\u0435\u043D\u0430 \u0431\u043E\u044F\u0440\u044B\u0448\u043D\u0438\u043A\u0430:
      \u043A\u0440\u0430\u0441\u043D\u044B\u0435 \u0433\u0440\u043E\u0437\u0434\u044C\u044F
      \u0431\u043B\u0435\u0441\u0442\u044F\u0442 \u043E\u0442 \u0443\u0442\u0440\u0435\u043D\u043D\u0435\u0439
      \u0440\u043E\u0441\u044B. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043D\u044E\u0445\u0430\u0435\u0442 \u0433\u043E\u0440\u0441\u0442\u044C.
      \"\u041A\u0438\u0441\u043B\u044B\u0435, \u043D\u043E \u0432 \u0441\u0430\u043C\u044B\u0439
      \u0440\u0430\u0437.\" \u0420\u044F\u0434\u043E\u043C \u0435\u0436\u0435\u0432\u0438\u043A\u0430
      \u0438 \u0434\u0438\u043A\u0438\u0439 \u0448\u0438\u043F\u043E\u0432\u043D\u0438\u043A.
      \u041B\u043E\u0449\u0438\u043D\u0430 \u043D\u0435\u0432\u0435\u043B\u0438\u043A\u0430,
      \u043D\u043E \u044D\u0442\u043E \u0436\u0438\u0432\u043E\u0439 \u0441\u043A\u043B\u0430\u0434.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430\u0434\u043E \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E:
      \u0432 \u0442\u0430\u043A\u0438\u0445 \u0437\u0430\u0440\u043E\u0441\u043B\u044F\u0445
      \u043B\u044E\u0431\u0438\u0442 \u043F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F
      \u043A\u0442\u043E \u043F\u043E\u043F\u0430\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378442
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u0443 \u043A\u0440\u0430\u044F
      \u0437\u0430\u0440\u043E\u0441\u043B\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378443
    m_Localized: "\u041F\u043E\u043B\u0447\u0430\u0441\u0430 \u0443 \u043A\u0440\u0430\u044F
      \u0437\u0430\u0440\u043E\u0441\u043B\u0435\u0439, \u0438 \u0434\u0432\u0430
      \u043C\u0435\u0448\u043E\u0447\u043A\u0430 \u0431\u043E\u044F\u0440\u044B\u0448\u043D\u0438\u043A\u0430
      \u0441 \u0448\u0438\u043F\u043E\u0432\u043D\u0438\u043A\u043E\u043C. \u041A\u0438\u0441\u043B\u043E,
      \u0432\u0438\u0442\u0430\u043C\u0438\u043D\u043D\u043E, \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
      \u0434\u043B\u044F \u043A\u0430\u0448\u0438 \u043A \u0443\u0436\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378444
    m_Localized: "\u0423\u0433\u043B\u0443\u0431\u0438\u0442\u044C\u0441\u044F \u0437\u0430
      \u0435\u0436\u0435\u0432\u0438\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378445
    m_Localized: "\u0412 \u0433\u043B\u0443\u0431\u0438\u043D\u0435 \u0441\u043F\u0435\u043B\u0430\u044F
      \u0435\u0436\u0435\u0432\u0438\u043A\u0430 \u0433\u0440\u043E\u0437\u0434\u044C\u044F\u043C\u0438
      \u0441 \u043A\u0443\u043B\u0430\u043A. \u0421\u043E\u0431\u0440\u0430\u043B\u0438
      \u043F\u043E\u043B\u043D\u0443\u044E \u0441\u0443\u043C\u0443. \u041F\u0430\u043B\u044C\u0446\u044B
      \u0444\u0438\u043E\u043B\u0435\u0442\u043E\u0432\u044B\u0435, \u043D\u043E
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0436\u0430\u043B\u0443\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378446
    m_Localized: "\u0412 \u0437\u0430\u0440\u043E\u0441\u043B\u044F\u0445 \u043A\u0430\u0431\u0430\u043D
      \u0441 \u0432\u044B\u0432\u043E\u0434\u043A\u043E\u043C. \u041B\u044E\u0434\u0438
      \u0440\u0430\u0437\u0431\u0435\u0436\u0430\u043B\u0438\u0441\u044C, \u0434\u0432\u043E\u0435
      \u043F\u043E\u0446\u0430\u0440\u0430\u043F\u0430\u043B\u0438\u0441\u044C \u043E\u0431
      \u0448\u0438\u043F\u044B. \u042F\u0433\u043E\u0434 \u043D\u0435 \u0441\u043E\u0431\u0440\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378447
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u0441\u044A\u0435\u0434\u043E\u0431\u043D\u044B\u0435 \u043C\u0435\u0441\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378448
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043E\u0431\u043E\u0448\u0451\u043B
      \u043B\u043E\u0449\u0438\u043D\u0443 \u043F\u043E \u043A\u0440\u0430\u044E
      \u0438 \u043F\u0440\u0438\u0432\u0451\u043B \u043A \u043F\u043E\u043B\u044F\u043D\u043A\u0435
      \u0441 \u0434\u0438\u043A\u0438\u043C \u043B\u0443\u043A\u043E\u043C \u0438
      \u043C\u0435\u043B\u043A\u0438\u043C\u0438 \u044F\u0431\u043B\u043E\u043D\u044F\u043C\u0438.
      \"\u041D\u0435 \u0442\u0440\u043E\u0433\u0430\u0439\u0442\u0435 \u0435\u0436\u0435\u0432\u0438\u043A\u0443
      \u2014 \u0442\u0430\u043C \u043C\u044B\u0448\u0438. \u0411\u0435\u0440\u0438\u0442\u0435
      \u044F\u0431\u043B\u043E\u043A\u0438 \u0438 \u043B\u0443\u043A.\" \u0417\u0430\u043F\u0430\u0441\u044B
      \u043F\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378449
    m_Localized: "\u041F\u0430\u0441\u0442\u0443\u0445 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378450
    m_Localized: "\u0421\u0442\u0430\u0434\u043E \u0431\u0430\u0440\u0430\u043D\u043E\u0432
      \u0440\u0430\u0441\u0442\u0435\u043A\u043B\u043E\u0441\u044C \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443.
      \u041F\u0430\u0441\u0442\u0443\u0445 \u0441 \u043C\u043E\u043D\u0433\u043E\u043B\u044C\u0441\u043A\u0438\u043C\u0438
      \u0441\u043A\u0443\u043B\u0430\u043C\u0438 \u0441\u0438\u0434\u0438\u0442 \u043D\u0430
      \u043A\u0430\u043C\u043D\u0435 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0431\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0430. \u0423 \u043D\u043E\u0433
      \u0431\u0443\u0440\u0434\u044E\u043A \u0441 \u043A\u0443\u043C\u044B\u0441\u043E\u043C
      \u0438 \u043F\u0435\u0440\u0435\u043C\u0451\u0442\u043D\u0430\u044F \u0441\u0443\u043C\u0430.
      \u041A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0438 \u0432 \u044D\u0442\u0438\u0445
      \u043A\u0440\u0430\u044F\u0445 \u043D\u0435 \u0442\u043E\u0440\u0433\u0443\u044E\u0442
      \u0441 \u0447\u0443\u0436\u0430\u043A\u0430\u043C\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
      \u0442\u0430\u043A: \u043D\u0443\u0436\u0435\u043D \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0438\u043B\u0438 \u043D\u0443\u0436\u043D\u044B\u0439
      \u0442\u043E\u0432\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378451
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u043C\u043E\u043D\u0435\u0442\u0443
      \u0437\u0430 \u0431\u0430\u0440\u0430\u043D\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378452
    m_Localized: "\u041F\u0430\u0441\u0442\u0443\u0445 \u043F\u043E\u0432\u0435\u0440\u0442\u0435\u043B
      \u043C\u043E\u043D\u0435\u0442\u0443 \u0438 \u0441\u043F\u0440\u044F\u0442\u0430\u043B.
      \u041E\u0442\u0440\u0435\u0437\u0430\u043B \u043F\u043E\u043B\u0431\u043E\u043A\u0430
      \u0431\u0430\u0440\u0430\u043D\u0430, \u043D\u0435 \u0442\u043E\u0440\u0433\u0443\u044F\u0441\u044C.
      \u041C\u044F\u0441\u043E \u0441\u0432\u0435\u0436\u0435\u0435, \u0436\u0438\u0440\u043D\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378453
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u043E\u0431 \u043E\u0431\u043C\u0435\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378454
    m_Localized: "\u0427\u0430\u0441 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430
      \u0436\u0435\u0441\u0442\u0430\u043C\u0438, \u0438 \u0441\u043E\u0448\u043B\u0438\u0441\u044C:
      \u0431\u0430\u0440\u0430\u043D\u044C\u044F \u0442\u0443\u0448\u0430 \u0437\u0430
      \u043A\u0443\u0441\u043E\u043A \u043D\u0430\u0434\u043E\u0440\u0432\u0430\u043D\u043D\u043E\u0433\u043E
      \u0448\u0451\u043B\u043A\u0430. \u041F\u0430\u0441\u0442\u0443\u0445 \u0441\u0438\u044F\u043B.
      \u041C\u044F\u0441\u0430 \u043D\u0430 \u0442\u0440\u0438 \u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378455
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B \u0437\u0430\u0448\u043B\u0438
      \u0432 \u0442\u0443\u043F\u0438\u043A. \u0420\u0430\u0441\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u0431\u0435\u0437 \u0441\u0434\u0435\u043B\u043A\u0438 \u0438 \u0441 \u043B\u0451\u0433\u043A\u043E\u0439
      \u0432\u0437\u0430\u0438\u043C\u043D\u043E\u0439 \u043E\u0431\u0438\u0434\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378456
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0437\u043D\u0430\u0435\u0442 \u043E\u0431\u044B\u0447\u0430\u0439
      \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378457
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u043F\u0435\u0440\u0432\u044B\u043C
      \u043F\u0440\u0438\u043D\u044F\u043B \u043A\u0443\u043C\u044B\u0441 \u0438
      \u0432\u044B\u043F\u0438\u043B \u043D\u0435 \u043C\u043E\u0440\u0449\u0430\u0441\u044C.
      \u041F\u0430\u0441\u0442\u0443\u0445 \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u0438\u043B
      \u043F\u043B\u0435\u0447\u0438. \u0414\u0432\u0430 \u0431\u0430\u0440\u0430\u043D\u0430,
      \u0442\u0440\u0430\u0432\u044B \u0438 \u0442\u0430\u0431\u0430\u043A \u0437\u0430
      \u0441\u0432\u044F\u0437\u043A\u0443 \u0431\u0443\u0441. \u0414\u043E\u0431\u0440\u043E\u0434\u0443\u0448\u0438\u0435
      \u0434\u0435\u0448\u0435\u0432\u043B\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378458
    m_Localized: "\u041E\u0434\u0438\u043D\u043E\u043A\u0430\u044F \u043F\u0430\u043B\u044C\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378459
    m_Localized: "\u041F\u0430\u043B\u044C\u043C\u0430 \u0441\u0442\u043E\u0438\u0442
      \u043E\u0434\u043D\u0430 \u043D\u0430 \u043A\u0440\u0430\u044E \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0439
      \u0433\u0440\u044F\u0434\u044B. \u041A\u0440\u043E\u043D\u0430 \u0432 \u043F\u044F\u0442\u043D\u0430\u0445
      \u043E\u0442 \u0437\u043D\u043E\u044F, \u043D\u043E \u0433\u0440\u043E\u0437\u0434\u044C\u044F
      \u0444\u0438\u043D\u0438\u043A\u043E\u0432 \u0442\u0451\u043C\u043D\u044B\u0435,
      \u043D\u0430\u043B\u0438\u0442\u044B\u0435. \u0412\u0435\u0442\u0435\u0440
      \u043D\u0435\u0441\u0451\u0442 \u0441\u043B\u0430\u0434\u043A\u043E\u0432\u0430\u0442\u044B\u0439
      \u0437\u0430\u043F\u0430\u0445 \u043F\u0435\u0440\u0435\u0437\u0440\u0435\u043B\u043E\u0433\u043E
      \u043F\u043B\u043E\u0434\u0430. \u0421\u0442\u0432\u043E\u043B \u0433\u043B\u0430\u0434\u043A\u0438\u0439
      \u0438 \u043E\u0431\u043E\u0436\u0436\u0451\u043D\u043D\u044B\u0439 \u0441\u043E\u043B\u043D\u0446\u0435\u043C,
      \u0430 \u0443 \u043A\u043E\u0440\u043D\u0435\u0439 \u043F\u0435\u0442\u043B\u044F\u044E\u0442
      \u0441\u043B\u0435\u0434\u044B \u0437\u043C\u0435\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378460
    m_Localized: "\u0421\u0431\u0438\u0442\u044C \u043D\u0438\u0436\u043D\u0438\u0435
      \u0433\u0440\u043E\u0437\u0434\u044C\u044F \u0448\u0435\u0441\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378461
    m_Localized: "\u0428\u0435\u0441\u0442 \u0434\u043E\u0441\u0442\u0430\u043B \u043D\u0438\u0436\u043D\u0438\u0435
      \u0433\u0440\u043E\u0437\u0434\u0438. \u0424\u0438\u043D\u0438\u043A\u0438
      \u043E\u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C \u0432 \u043F\u044B\u043B\u044C.
      \u041D\u0430\u0431\u0440\u0430\u043B\u0438 \u043F\u0440\u0438\u0433\u043E\u0440\u0448\u043D\u0438.
      \u041D\u0435\u043C\u043D\u043E\u0433\u043E, \u043D\u043E \u0432 \u0441\u0447\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378462
    m_Localized: "\u0417\u0430\u043B\u0435\u0437\u0442\u044C \u0437\u0430 \u0432\u0435\u0440\u0445\u043D\u0438\u043C\u0438
      \u0433\u0440\u043E\u0437\u0434\u044C\u044F\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378463
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u043E\u0431\u0432\u044F\u0437\u0430\u043B
      \u0441\u0442\u0432\u043E\u043B \u0432\u0435\u0440\u0451\u0432\u043A\u043E\u0439
      \u0438 \u043F\u043E\u043B\u0435\u0437. \u041D\u0430\u0432\u0435\u0440\u0445\u0443
      \u0442\u0440\u0438 \u0442\u044F\u0436\u0451\u043B\u044B\u0435 \u0433\u0440\u043E\u0437\u0434\u0438.
      \u041B\u0430\u0433\u0435\u0440\u044C \u0435\u043B \u0434\u043E\u043B\u0433\u043E
      \u0438 \u043C\u043E\u043B\u0447\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378464
    m_Localized: "\u041D\u0430 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u043F\u043E\u0434\u044A\u0451\u043C\u0430
      \u043D\u043E\u0433\u0430 \u0441\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0430,
      \u0443\u043F\u0430\u043B \u043D\u0430 \u0441\u043F\u0438\u043D\u0443, \u043E\u0442\u0431\u0438\u043B
      \u043F\u043B\u0435\u0447\u043E. \u0418\u0437-\u043F\u043E\u0434 \u043A\u043E\u0440\u043D\u0435\u0439
      \u0432\u044B\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0430 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F
      \u0431\u0443\u0440\u0430\u044F \u0437\u043C\u0435\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378465
    m_Localized: "\u041E\u043F\u044B\u0442\u043D\u044B\u0439 \u0432\u044B\u0436\u0438\u0432\u0430\u043B\u044C\u0449\u0438\u043A
      \u0437\u043D\u0430\u0435\u0442 \u043F\u0440\u0438\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378466
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0441\u043A\u0440\u0443\u0442\u0438\u043B
      \u0440\u0435\u043C\u043D\u0438 \u043F\u0435\u0442\u043B\u0451\u0439, \u043D\u0430\u0431\u0440\u043E\u0441\u0438\u043B
      \u043D\u0430 \u0441\u0442\u0432\u043E\u043B \u0438 \u043F\u043E\u0448\u0451\u043B
      \u0432\u0432\u0435\u0440\u0445 \u0431\u0435\u0437 \u0440\u0443\u043A. \u0417\u0430
      \u043F\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442 \u0441\u043D\u044F\u043B
      \u0432\u0441\u0435 \u0433\u0440\u043E\u0437\u0434\u0438. \"\u0412 \u0410\u0440\u0430\u0432\u0438\u0438
      \u0442\u0430\u043A \u0443\u0447\u0430\u0442 \u0434\u0435\u0442\u0435\u0439.\""
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378467
    m_Localized: "\u041F\u0443\u0441\u0442\u044B\u043D\u043D\u044B\u0439 \u043B\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378468
    m_Localized: "\u041D\u0430 \u0437\u0430\u043A\u0430\u0442\u0435 \u0438\u0437-\u0437\u0430
      \u0431\u0430\u0440\u0445\u0430\u043D\u0430 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u043B\u0438\u0441\u0438\u0446\u0430. \u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0430\u044F,
      \u0436\u0451\u043B\u0442\u043E-\u0440\u044B\u0436\u0430\u044F, \u0441 \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u043C\u0438
      \u0443\u0448\u0430\u043C\u0438 \u2014 \u0444\u0435\u043D\u0435\u043A. \u0421\u0430\u0434\u0438\u0442\u0441\u044F
      \u0432 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438 \u0448\u0430\u0433\u0430\u0445
      \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0431\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0430,
      \u043D\u043E\u0441 \u043F\u043E\u0434\u0440\u0430\u0433\u0438\u0432\u0430\u0435\u0442.
      \u041C\u044F\u0441\u0430 \u043C\u0430\u043B\u043E, \u043D\u043E \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435
      \u043B\u044E\u0431\u0430\u044F \u0434\u043E\u0431\u044B\u0447\u0430 \u2014
      \u043F\u043E\u0434\u0430\u0440\u043E\u043A. \u0412\u043E\u043F\u0440\u043E\u0441
      \u0432 \u0442\u043E\u043C, \u043A\u0430\u043A \u0435\u0451 \u0432\u0437\u044F\u0442\u044C,
      \u043D\u0435 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0432 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0441\u0438\u043B, \u0447\u0435\u043C \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378469
    m_Localized: "\u041F\u043E\u0434\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u0440\u0438\u043C\u0430\u043D\u043A\u0443
      \u0438 \u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378470
    m_Localized: "\u0421\u0443\u0445\u0430\u0440\u044C \u043D\u0430 \u0432\u0435\u0440\u0451\u0432\u043A\u0435.
      \u0424\u0435\u043D\u0435\u043A \u043F\u043E\u0434\u043E\u0448\u0451\u043B,
      \u043F\u043E\u0442\u044F\u043D\u0443\u043B, \u043D\u043E \u0443\u0441\u043F\u0435\u043B
      \u043F\u0440\u044B\u0433\u043D\u0443\u0442\u044C. \u0412\u0441\u0451 \u0436\u0435
      \u043F\u0440\u043E\u0431\u044B\u043B \u0440\u044F\u0434\u043E\u043C \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u043D\u044F\u0442\u044C \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0432 \u043B\u0430\u0433\u0435\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378471
    m_Localized: "\u0417\u0430\u0433\u043D\u0430\u0442\u044C \u0441\u0435\u0442\u044C\u044E
      \u043D\u0430 \u0437\u0430\u043A\u0430\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378472
    m_Localized: "\u0414\u0432\u043E\u0435 \u043E\u0431\u043E\u0448\u043B\u0438 \u0441\u0431\u043E\u043A\u0443,
      \u0442\u0440\u0435\u0442\u0438\u0439 \u0441 \u0444\u0430\u043A\u0435\u043B\u043E\u043C
      \u0433\u043D\u0430\u043B \u043A \u0441\u0435\u0442\u0438. \u0424\u0435\u043D\u0435\u043A
      \u0437\u0430\u043F\u0443\u0442\u0430\u043B\u0441\u044F. \u0416\u0438\u0440
      \u043F\u043E\u0434 \u0448\u043A\u0443\u0440\u043E\u0439. \u0412\u0435\u0447\u0435\u0440\u043E\u043C
      \u0432\u0430\u0440\u0438\u043B\u0438 \u0441\u0443\u043F, \u043F\u0430\u0445\u043D\u0443\u0449\u0438\u0439
      \u043F\u0440\u044F\u043D\u043E\u0441\u0442\u044F\u043C\u0438 \u0438 \u0434\u044B\u043C\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378473
    m_Localized: "\u0424\u0435\u043D\u0435\u043A \u0443\u0448\u0451\u043B \u0432
      \u043D\u043E\u0440\u0443 \u0437\u0430 \u0434\u043E\u043B\u044E \u0441\u0435\u043A\u0443\u043D\u0434\u044B
      \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0441\u0435\u0442\u044C
      \u043B\u0435\u0433\u043B\u0430. \u0412\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u0441 \u043F\u0443\u0441\u0442\u044B\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438
      \u0438 \u0441\u0431\u0438\u0442\u044B\u043C\u0438 \u043D\u043E\u0433\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378474
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u043D\u043E\u0440\u044B \u0444\u0435\u043D\u0435\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378475
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043E\u0431\u043E\u0448\u0451\u043B
      \u043D\u043E\u0440\u0443 \u0441 \u043F\u043E\u0434\u0432\u0435\u0442\u0440\u0435\u043D\u043D\u043E\u0439
      \u0441\u0442\u043E\u0440\u043E\u043D\u044B, \u043D\u0430\u043A\u0440\u044B\u043B
      \u0432\u044B\u0445\u043E\u0434 \u0445\u0430\u043B\u0430\u0442\u043E\u043C \u0438
      \u0445\u043B\u043E\u043F\u043D\u0443\u043B \u0432 \u043B\u0430\u0434\u043E\u0448\u0438.
      \u0424\u0435\u043D\u0435\u043A \u0432\u044B\u0441\u043A\u043E\u0447\u0438\u043B
      \u043F\u0440\u044F\u043C\u043E \u0432 \u0442\u043A\u0430\u043D\u044C. \"\u0412
      \u0434\u0435\u0442\u0441\u0442\u0432\u0435 \u0442\u0430\u043A \u043B\u043E\u0432\u0438\u043B
      \u0434\u044E\u0436\u0438\u043D\u0430\u043C\u0438.\" \u0428\u043A\u0443\u0440\u043A\u0430
      \u0432 \u0434\u0435\u043B\u043E, \u043C\u044F\u0441\u043E \u0432 \u043A\u043E\u0442\u0451\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378476
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0435 \u0441\u043B\u0435\u0434\u044B
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378477
    m_Localized: "\u041D\u0430 \u0442\u0432\u0451\u0440\u0434\u043E\u043C \u0442\u0430\u043A\u044B\u0440\u0435
      \u043E\u0442\u043F\u0435\u0447\u0430\u0442\u043A\u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u044C\u0438\u0445
      \u043D\u043E\u0433 \u0443\u0445\u043E\u0434\u044F\u0442 \u043D\u0430 \u0441\u0435\u0432\u0435\u0440\u043E-\u0432\u043E\u0441\u0442\u043E\u043A.
      \u0421\u0442\u0430\u0440\u044B\u0435, \u043D\u043E \u043D\u0435 \u0437\u0430\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0435.
      \u0420\u044F\u0434\u043E\u043C \u0440\u0430\u0437\u0431\u0438\u0442\u0430\u044F
      \u0433\u043B\u0438\u043D\u044F\u043D\u0430\u044F \u0444\u043B\u044F\u0433\u0430
      \u0438 \u0433\u043E\u0440\u0441\u0442\u044C \u0441\u0443\u0445\u0438\u0445
      \u0444\u0438\u043D\u0438\u043A\u043E\u0432 \u0432 \u043F\u044B\u043B\u0438.
      \u0412 \u043F\u0443\u0441\u0442\u044B\u043D\u0435 \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439
      \u0441\u043B\u0435\u0434 \u043C\u043E\u0436\u0435\u0442 \u0432\u0435\u0441\u0442\u0438
      \u043A \u0432\u043E\u0434\u0435, \u043A \u0442\u0430\u0439\u043D\u0438\u043A\u0443,
      \u0430 \u043C\u043E\u0436\u0435\u0442 \u2014 \u043A \u043D\u0438\u0447\u0435\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378478
    m_Localized: "\u041F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C \u0444\u0438\u043D\u0438\u043A\u0438
      \u0438 \u0438\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378479
    m_Localized: "\u0424\u0438\u043D\u0438\u043A\u0438 \u0441\u0443\u0445\u0438\u0435,
      \u043D\u043E \u0433\u043E\u0434\u043D\u044B\u0435. \u041F\u043E\u0434\u043E\u0431\u0440\u0430\u043B\u0438
      \u0432\u0441\u0451. \u041D\u0435\u043C\u043D\u043E\u0433\u043E, \u043D\u043E
      \u0432 \u0441\u0447\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378480
    m_Localized: "\u041F\u0440\u043E\u0441\u043B\u0435\u0434\u0438\u0442\u044C \u0441\u043B\u0435\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378481
    m_Localized: "\u0421\u043B\u0435\u0434\u044B \u043F\u0440\u0438\u0432\u0435\u043B\u0438
      \u043A \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0439 \u0433\u0440\u044F\u0434\u0435.
      \u0422\u0430\u043C \u0441\u0442\u0430\u0440\u044B\u0439 \u043A\u043E\u043B\u043E\u0434\u0435\u0446,
      \u043F\u043E\u0447\u0442\u0438 \u0437\u0430\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0439.
      \u0414\u0432\u043E\u0435 \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u043B\u0438
      \u0433\u043E\u0440\u043B\u043E\u0432\u0438\u043D\u0443, \u0438 \u0441\u043E
      \u0434\u043D\u0430 \u043F\u043E\u0442\u044F\u043D\u0443\u043B\u043E \u0445\u043E\u043B\u043E\u0434\u043E\u043C.
      \u0412\u043E\u0434\u0430 \u0435\u0441\u0442\u044C. \u0411\u0443\u0440\u0434\u044E\u043A\u0438
      \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378482
    m_Localized: "\u0421\u043B\u0435\u0434\u044B \u043E\u0431\u0440\u044B\u0432\u0430\u043B\u0438\u0441\u044C
      \u0443 \u0440\u0430\u0437\u043C\u044B\u0442\u043E\u0433\u043E \u043E\u0431\u0440\u044B\u0432\u0430.
      \u041D\u0438 \u0432\u043E\u0434\u044B, \u043D\u0438 \u0442\u0430\u0439\u043D\u0438\u043A\u0430.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0432\u044B\u0431\u0438\u0442\u044B\u0435
      \u0441\u0438\u043B\u044B \u0438 \u0447\u0430\u0441\u044B \u0432\u043F\u0443\u0441\u0442\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378483
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0447\u0438\u0442\u0430\u0435\u0442
      \u0441\u043B\u0435\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378484
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043F\u043E\u0442\u0440\u043E\u0433\u0430\u043B
      \u043E\u0442\u043F\u0435\u0447\u0430\u0442\u043E\u043A, \u043F\u043E\u0434\u043D\u044F\u043B
      \u0433\u043E\u043B\u043E\u0432\u0443. \"\u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u043E\u0431\u043E\u0437. \u0422\u0440\u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430,
      \u043E\u0434\u0438\u043D \u0445\u0440\u043E\u043C\u043E\u0439. \u0414\u0432\u0430
      \u0434\u043D\u044F \u043D\u0430\u0437\u0430\u0434. \u0417\u0430 \u0441\u043A\u0430\u043B\u043E\u0439
      \u0438\u0445 \u043F\u0440\u0438\u0432\u0430\u043B.\" \u041D\u0430\u0448\u043B\u0438
      \u043A\u043E\u043B\u044C\u0446\u043E \u043A\u0430\u043C\u043D\u0435\u0439,
      \u043F\u043E\u0434 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u044B\u043C
      \u2014 \u043A\u0438\u0441\u0435\u0442 \u0441 \u0435\u0434\u043E\u0439, \u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439
      \u0434\u043B\u044F \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378485
    m_Localized: "\u041A\u0435\u0434\u0440\u043E\u0432\u044B\u0435 \u0448\u0438\u0448\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378486
    m_Localized: "\u0421\u043A\u043B\u043E\u043D \u043D\u0430\u0434 \u043B\u0430\u0433\u0435\u0440\u0435\u043C
      \u0443\u0441\u0435\u044F\u043D \u043A\u0435\u0434\u0440\u0430\u043C\u0438.
      \u0412\u0435\u0442\u0435\u0440 \u0434\u043E\u043D\u043E\u0441\u0438\u0442 \u0441\u043C\u043E\u043B\u0438\u0441\u0442\u044B\u0439
      \u0437\u0430\u043F\u0430\u0445, \u0438 \u043F\u043E\u0434 \u0434\u0435\u0440\u0435\u0432\u044C\u044F\u043C\u0438
      \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043D\u044B \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E\u0434\u043D\u0438\u0435
      \u0448\u0438\u0448\u043A\u0438. \u041E\u0434\u0438\u043D \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0448\u0438\u0448\u043A\u0443,
      \u043C\u043D\u0451\u0442 \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438:
      \u0441\u0435\u043C\u0435\u043D\u0430 \u043A\u0440\u0443\u043F\u043D\u044B\u0435,
      \u043C\u0430\u0441\u043B\u044F\u043D\u0438\u0441\u0442\u044B\u0435. \u0425\u0432\u0430\u0442\u0438\u0442
      \u043D\u0430\u0431\u0438\u0442\u044C \u043F\u0430\u0440\u0443 \u043C\u0435\u0448\u043A\u043E\u0432.
      \u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0441\u043A\u043B\u043E\u043D\u0435
      \u0441\u043A\u043E\u043B\u044C\u0437\u043A\u043E, \u043A\u0430\u043C\u043D\u0438
      \u0443\u0445\u043E\u0434\u044F\u0442 \u0438\u0437-\u043F\u043E\u0434 \u043D\u043E\u0433,
      \u0430 \u0432 \u043A\u0430\u043C\u043D\u044F\u0445 \u043C\u0435\u0436\u0434\u0443
      \u043A\u043E\u0440\u043D\u044F\u043C\u0438 \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C
      \u043D\u043E\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378487
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u0448\u0438\u0448\u043A\u0438
      \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u044C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378488
    m_Localized: "\u041F\u043E\u043B\u0447\u0430\u0441\u0430 \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u044C\u044F
      \u0434\u0430\u043B\u043E \u043F\u043E\u043B\u043D\u044B\u0439 \u043C\u0435\u0448\u043E\u043A
      \u0448\u0438\u0448\u0435\u043A. \u041E\u0440\u0435\u0445\u0438 \u043C\u0435\u043B\u043A\u0438\u0435
      \u0432 \u043D\u0438\u0436\u043D\u0438\u0445, \u043D\u043E \u0433\u043E\u0434\u043D\u044B\u0435.
      \u0423\u0436\u0438\u043D \u043F\u0430\u0445\u043D\u0435\u0442 \u0441\u043C\u043E\u043B\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378489
    m_Localized: "\u041F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F \u0437\u0430
      \u043A\u0440\u0443\u043F\u043D\u044B\u043C\u0438 \u0448\u0438\u0448\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378490
    m_Localized: "\u0412\u044B\u0448\u0435 \u0448\u0438\u0448\u043A\u0438 \u043A\u0440\u0443\u043F\u043D\u0435\u0435,
      \u0441\u0435\u043C\u0435\u043D\u0430 \u2014 \u0441 \u043D\u043E\u0433\u043E\u0442\u044C,
      \u043C\u0430\u0441\u043B\u044F\u043D\u0438\u0441\u0442\u044B\u0435. \u041D\u0430\u0431\u0440\u0430\u043B\u0438
      \u0434\u0432\u0430 \u043C\u0435\u0448\u043A\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0440\u0430\u0441\u043A\u043E\u043B\u043E\u043B\u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043F\u0440\u044F\u043C\u043E \u0441\u0435\u0439\u0447\u0430\u0441, \u0436\u0435\u0432\u0430\u043B\u0438
      \u043C\u043E\u043B\u0447\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378491
    m_Localized: "\u041A\u0430\u043C\u0435\u043D\u044C \u043F\u043E\u0434 \u043D\u043E\u0433\u043E\u0439
      \u0441\u043F\u043E\u043B\u0437, \u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u043F\u043E\u043A\u0430\u0442\u0438\u043B\u0441\u044F \u043F\u043E \u043E\u0441\u044B\u043F\u0438.
      \u0412\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0441 \u043E\u0431\u043E\u0434\u0440\u0430\u043D\u043D\u044B\u043C\u0438
      \u0440\u0443\u043A\u0430\u043C\u0438 \u0438 \u043F\u0443\u0441\u0442\u044B\u043C
      \u043C\u0435\u0448\u043A\u043E\u043C. \u0428\u0438\u0448\u043A\u0438 \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C
      \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378492
    m_Localized: "\u0421\u043B\u0435\u0434\u043E\u043F\u044B\u0442 \u0437\u043D\u0430\u0435\u0442
      \u043B\u0443\u0447\u0448\u0438\u0435 \u0434\u0435\u0440\u0435\u0432\u044C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378493
    m_Localized: "\u0421\u043B\u0435\u0434\u043E\u043F\u044B\u0442 \u043F\u0440\u043E\u0448\u0451\u043B
      \u0432\u0434\u043E\u043B\u044C \u0441\u043A\u043B\u043E\u043D\u0430 \u0438
      \u043D\u0430\u0448\u0451\u043B \u0441\u0442\u0430\u0440\u044B\u0439 \u043A\u0435\u0434\u0440
      \u0432 \u0440\u0430\u0441\u043F\u0430\u0434\u043A\u0435: \u0441\u0442\u0432\u043E\u043B
      \u0432 \u0434\u0432\u0430 \u043E\u0431\u0445\u0432\u0430\u0442\u0430, \u0448\u0438\u0448\u043A\u0438
      \u0441 \u043A\u0443\u043B\u0430\u043A. \u041E\u0440\u0435\u0445\u043E\u0432
      \u043D\u0430\u0431\u0440\u0430\u043B\u0438 \u0441\u0442\u043E\u043B\u044C\u043A\u043E,
      \u0447\u0442\u043E \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043D\u0435\u0441\u0442\u0438 \u0432 \u0440\u0443\u0431\u0430\u0445\u0430\u0445.
      \u0425\u0432\u0430\u0442\u0438\u0442 \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430 \u0438 \u0434\u0430\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378494
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u043A\u043E\u0437\u0451\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378495
    m_Localized: "\u041D\u0430 \u0443\u0441\u0442\u0443\u043F\u0435 \u043D\u0430\u0434
      \u043B\u0430\u0433\u0435\u0440\u0435\u043C \u0441\u0442\u043E\u0438\u0442 \u043A\u043E\u0437\u0451\u043B.
      \u0420\u043E\u0433\u0430 \u0437\u0430\u043A\u0440\u0443\u0447\u0435\u043D\u043D\u044B\u0435,
      \u0448\u0435\u0440\u0441\u0442\u044C \u0441\u0435\u0440\u0430\u044F \u0441
      \u0438\u043D\u0435\u0435\u043C. \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0432\u043D\u0438\u0437 \u0431\u0435\u0437 \u043E\u0441\u043E\u0431\u043E\u0433\u043E
      \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u0430: \u0432
      \u0433\u043E\u0440\u0430\u0445 \u043A\u043E\u0437\u043B\u044B \u0437\u043D\u0430\u044E\u0442,
      \u0447\u0442\u043E \u0441\u043A\u0430\u043B\u0430 \u0438\u0445 \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442
      \u043B\u0443\u0447\u0448\u0435 \u043B\u044E\u0431\u043E\u0433\u043E \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430.
      \u0414\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u044F \u0432\u0435\u043B\u0438\u043A\u0430,
      \u0432\u0435\u0442\u0435\u0440 \u043F\u043E\u0440\u044B\u0432\u0438\u0441\u0442\u044B\u0439,
      \u0430 \u0441\u043A\u043B\u043E\u043D \u043F\u043E\u0434 \u043D\u0438\u043C
      \u043D\u0435\u043D\u0430\u0434\u0451\u0436\u0435\u043D. \u041C\u044F\u0441\u0430
      \u0442\u0430\u043C \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439, \u0438 \u0448\u043A\u0443\u0440\u0430 \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F,
      \u043D\u043E \u043B\u044E\u0431\u0430\u044F \u043E\u0448\u0438\u0431\u043A\u0430
      \u043C\u043E\u0436\u0435\u0442 \u0441\u0442\u043E\u0438\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378496
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u0430\u0442\u044C\u0441\u044F \u0432\u044B\u0439\u0442\u0438
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378497
    m_Localized: "\u041F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u043D\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C:
      \u043A\u043E\u0437\u0451\u043B \u0443\u0448\u0451\u043B \u0432\u044B\u0448\u0435,
      \u043F\u0435\u0440\u0435\u043F\u0440\u044B\u0433\u043D\u0443\u0432 \u0442\u0440\u0435\u0449\u0438\u043D\u0443.
      \u041E\u0445\u043E\u0442\u043D\u0438\u043A \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F,
      \u043D\u043E \u043F\u0440\u0438\u043D\u0451\u0441 \u0433\u043E\u0440\u0441\u0442\u044C
      \u043F\u043E\u043C\u0451\u0442\u0430: \u043F\u0430\u0441\u0442\u0431\u0438\u0449\u0435
      \u0440\u044F\u0434\u043E\u043C. \u0417\u043D\u0430\u0447\u0438\u0442, \u043A\u043E\u0437\u043B\u044B
      \u0432\u0435\u0440\u043D\u0443\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378498
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u0438 \u0443\u0441\u0442\u0440\u043E\u0438\u0442\u044C
      \u0437\u0430\u0441\u0430\u0434\u0443 \u043D\u0430 \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378499
    m_Localized: "\u0414\u0432\u043E\u0435 \u043E\u0431\u043E\u0448\u043B\u0438 \u0443\u0441\u0442\u0443\u043F
      \u043F\u043E \u0432\u0435\u0440\u0445\u0443, \u0432\u044B\u0431\u0440\u0430\u043B\u0438
      \u043A\u043E\u0437\u044C\u044E \u0442\u0440\u043E\u043F\u0443 \u0438 \u0436\u0434\u0430\u043B\u0438.
      \u041A\u043E\u0437\u0451\u043B \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0441\u044F
      \u043A \u0432\u0435\u0447\u0435\u0440\u0443. \u041E\u0434\u0438\u043D \u0432\u044B\u0441\u0442\u0440\u0435\u043B.
      \u0422\u0443\u0448\u0430 \u0442\u044F\u0436\u0451\u043B\u0430\u044F, \u0441\u043F\u0443\u0441\u043A\u0430\u043B\u0438
      \u043D\u0430 \u0432\u0435\u0440\u0451\u0432\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378500
    m_Localized: "\u041D\u0430 \u0442\u0440\u043E\u043F\u0435 \u043A\u043E\u0437\u0451\u043B
      \u0443\u0447\u0443\u044F\u043B \u043B\u044E\u0434\u0435\u0439 \u0437\u0430
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0448\u0430\u0433\u043E\u0432.
      \u041F\u0440\u044B\u0436\u043E\u043A \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u0438 \u043E\u043D \u0438\u0441\u0447\u0435\u0437 \u0437\u0430 \u0433\u0440\u0435\u0431\u043D\u0435\u043C.
      \u0414\u0432\u043E\u0435 \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432
      \u043F\u0440\u043E\u0441\u0438\u0434\u0435\u043B\u0438 \u0432 \u043A\u0430\u043C\u043D\u044F\u0445
      \u0442\u0440\u0438 \u0447\u0430\u0441\u0430 \u0437\u0440\u044F. \u041E\u0434\u0438\u043D
      \u043E\u0431\u043C\u043E\u0440\u043E\u0437\u0438\u043B \u043F\u0430\u043B\u044C\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378501
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u043A\u043E\u0437\u044C\u0438 \u0442\u0440\u043E\u043F\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378502
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043F\u0440\u043E\u0432\u0451\u043B
      \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432 \u043F\u043E \u0442\u0435\u043D\u0435\u0432\u043E\u043C\u0443
      \u0441\u043A\u043B\u043E\u043D\u0443, \u043E\u0431\u0445\u043E\u0434\u044F
      \u0432\u0441\u0435 \u0442\u0440\u0435\u0449\u0438\u043D\u044B. \u041F\u043E\u043A\u0430\u0437\u0430\u043B
      \u0442\u0440\u043E\u043F\u0443 \u0443 \u0441\u043D\u0435\u0433\u043E\u0432\u043E\u0439
      \u043F\u043E\u043B\u043E\u0441\u044B, \u0433\u0434\u0435 \u043A\u043E\u0437\u043B\u044B
      \u0445\u043E\u0434\u044F\u0442 \u0437\u0430 \u0441\u043E\u043B\u044C\u044E.
      \u0417\u0430\u0441\u0430\u0434\u0430 \u0431\u044B\u043B\u0430 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0439:
      \u0434\u0432\u0430 \u043A\u043E\u0437\u043B\u0430, \u0434\u043E\u0431\u044B\u0442\u044B\u0445
      \u0447\u0438\u0441\u0442\u043E. \u0428\u043A\u0443\u0440\u044B, \u043C\u044F\u0441\u043E,
      \u0440\u043E\u0433\u0430 \u2014 \u0432\u0441\u0451 \u043F\u043E\u0439\u0434\u0451\u0442
      \u0432 \u0434\u0435\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378503
    m_Localized: "\u041B\u0435\u0434\u044F\u043D\u043E\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378504
    m_Localized: "\u0418\u0437-\u043F\u043E\u0434 \u043D\u0430\u0432\u0438\u0441\u0448\u0435\u0433\u043E
      \u043A\u0430\u043C\u043D\u044F \u0432\u044B\u0442\u0435\u043A\u0430\u0435\u0442
      \u0442\u043E\u043D\u043A\u0430\u044F \u0441\u0442\u0440\u0443\u0439\u043A\u0430:
      \u043B\u0435\u0434\u044F\u043D\u0430\u044F \u0432\u043E\u0434\u0430, \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u0430\u044F
      \u043A\u0430\u043A \u0441\u0442\u0435\u043A\u043B\u043E, \u043F\u0430\u0445\u043D\u0435\u0442
      \u0441\u043D\u0435\u0433\u043E\u043C \u0438 \u043A\u0430\u043C\u043D\u0435\u043C.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u043F\u043E\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u043B\u0430\u0434\u043E\u043D\u044C. \"\u0425\u043E\u0440\u043E\u0448\u0430\u044F
      \u0432\u043E\u0434\u0430\". \u0420\u044F\u0434\u043E\u043C \u043C\u043E\u0445
      \u0438 \u043C\u0435\u043B\u043A\u0438\u0435 \u0433\u043E\u0440\u043D\u044B\u0435
      \u0446\u0432\u0435\u0442\u044B. \u0422\u043E\u043B\u044C\u043A\u043E \u043A\u0430\u043C\u0435\u043D\u044C
      \u043D\u0430\u0434 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u043C
      \u0432\u0438\u0441\u0438\u0442 \u043D\u0435\u0440\u043E\u0432\u043D\u043E,
      \u0438 \u0441 \u0443\u0442\u0440\u0435\u043D\u043D\u0438\u043C \u043E\u0442\u0442\u0435\u043F\u0435\u043B\u044C\u044E
      \u043E\u043D \u043C\u043E\u0433 \u0441\u0434\u0432\u0438\u043D\u0443\u0442\u044C\u0441\u044F.
      \u041D\u0430\u0431\u0438\u0440\u0430\u0442\u044C \u0438\u043B\u0438 \u043E\u0431\u043E\u0439\u0442\u0438?"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378505
    m_Localized: "\u041D\u0430\u0431\u0440\u0430\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0438 \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378506
    m_Localized: "\u041D\u0430\u0431\u0440\u0430\u043B\u0438 \u0442\u0440\u0438 \u0431\u0443\u0440\u0434\u044E\u043A\u0430
      \u0431\u044B\u0441\u0442\u0440\u043E, \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F\u0441\u044C.
      \u0412\u043E\u0434\u0430 \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F,
      \u0447\u0438\u0441\u0442\u0430\u044F. \u0413\u043E\u0440\u043D\u044B\u0435
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0438 \u0440\u0435\u0434\u043A\u043E
      \u043E\u0431\u043C\u0430\u043D\u044B\u0432\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378507
    m_Localized: "\u0420\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
      \u0438 \u043D\u0430\u0431\u0440\u0430\u0442\u044C \u043F\u043E\u043B\u043D\u044B\u0435
      \u0437\u0430\u043F\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378508
    m_Localized: "\u0420\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u043B\u0438 \u043A\u0430\u043C\u043D\u0438
      \u0432\u043E\u043A\u0440\u0443\u0433, \u043F\u043E\u0442\u043E\u043A \u0441\u0442\u0430\u043B
      \u0448\u0438\u0440\u0435. \u041D\u0430\u0431\u0440\u0430\u043B\u0438 \u0432\u0441\u0435
      \u0431\u0443\u0440\u0434\u044E\u043A\u0438 \u0434\u043E \u043E\u0442\u043A\u0430\u0437\u0430.
      \u0412\u043E\u0434\u0430 \u043B\u0435\u0434\u044F\u043D\u0430\u044F, \u043B\u0430\u0433\u0435\u0440\u044C
      \u043F\u044C\u0451\u0442 \u0441 \u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435\u043C.
      \u0417\u0430\u043F\u0430\u0441\u0430 \u0445\u0432\u0430\u0442\u0438\u0442 \u043D\u0430
      \u0434\u0432\u0430 \u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378509
    m_Localized: "\u041F\u0440\u0438 \u0440\u0430\u0441\u0447\u0438\u0441\u0442\u043A\u0435
      \u043F\u043E\u0442\u0440\u0435\u0432\u043E\u0436\u0438\u043B\u0438 \u043A\u0430\u043C\u0435\u043D\u044C.
      \u041E\u043D \u0441\u043F\u043E\u043B\u0437 \u0438 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u043B
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443.
      \u041D\u0430\u0431\u0440\u0430\u043B\u0438 \u043C\u0435\u043D\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0445\u043E\u0442\u0435\u043B\u0438, \u0438 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B\u0438
      \u0447\u0430\u0441 \u043D\u0430 \u043F\u0443\u0441\u0442\u0443\u044E \u0440\u0430\u0431\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378510
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442
      \u0432\u043E\u0434\u0443 \u043D\u0430 \u043F\u0440\u0438\u0433\u043E\u0434\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378511
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u043F\u0443\u0441\u0442\u0438\u043B
      \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u0443\u044E \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u043A\u0443
      \u0432 \u0432\u043E\u0434\u0443 \u0438 \u043F\u043E\u043D\u0430\u0431\u043B\u044E\u0434\u0430\u043B.
      \"\u0427\u0438\u0441\u0442\u0430\u044F. \u041D\u0438 \u0438\u043B\u0430, \u043D\u0438
      \u044F\u0434\u0430. \u0418 \u0435\u0449\u0451: \u043C\u043E\u0445 \u0443 \u043A\u0440\u0430\u044F
      \u2014 \u043E\u0447\u0438\u0449\u0430\u0435\u0442 \u0436\u0435\u043B\u0443\u0434\u043E\u043A.
      \u0417\u0430\u0432\u0430\u0440\u0438\u0442\u0435 \u0449\u0435\u043F\u043E\u0442\u044C\".
      \u041D\u0430\u0431\u0440\u0430\u043B\u0438 \u0432\u043E\u0434\u044B \u0438
      \u043C\u0445\u0430. \u041B\u0430\u0433\u0435\u0440\u044C \u0437\u0434\u043E\u0440\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378512
    m_Localized: "\u041D\u043E\u0447\u044C \u0432 \u044E\u0440\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378513
    m_Localized: "\u0412\u043E\u0439\u043B\u043E\u0447\u043D\u0430\u044F \u044E\u0440\u0442\u0430
      \u0441\u0442\u043E\u0438\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
      \u043E\u0442 \u0434\u043E\u0440\u043E\u0433\u0438, \u0443 \u043D\u0435\u0451
      \u0442\u0435\u043F\u043B\u0438\u0442\u0441\u044F \u043E\u0447\u0430\u0433.
      \u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442
      \u0438\u0437 \u043F\u043E\u043B\u043E\u0433\u0430, \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0431\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0430. \u041A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0438
      \u0441\u0442\u0435\u043F\u0435\u0439 \u043F\u0440\u0438\u0432\u044B\u043A\u043B\u0438
      \u043A \u0447\u0443\u0436\u0430\u043A\u0430\u043C \u043D\u0430 \u0442\u0440\u0430\u043A\u0442\u0435,
      \u043D\u043E \u0433\u043E\u0441\u0442\u0435\u043F\u0440\u0438\u0438\u043C\u0441\u0442\u0432\u043E
      \u0443 \u043D\u0438\u0445 \u0443\u0441\u043B\u043E\u0432\u043D\u043E\u0435:
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430 \u043D\u0430\u0434\u043E \u0437\u043D\u0430\u0442\u044C
      \u043F\u0440\u0430\u0432\u0438\u043B\u0430. \u0417\u0430\u043F\u0430\u0445
      \u0434\u044B\u043C\u043D\u043E\u0433\u043E \u043E\u0447\u0430\u0433\u0430 \u0438
      \u0432\u0430\u0440\u0451\u043D\u043E\u0439 \u0431\u0430\u0440\u0430\u043D\u0438\u043D\u044B
      \u0449\u0435\u043A\u043E\u0447\u0435\u0442 \u043D\u043E\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378514
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0443 \u044E\u0440\u0442\u044B \u043D\u0430 \u043D\u043E\u0447\u043B\u0435\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378515
    m_Localized: "\u0425\u043E\u0437\u044F\u0439\u043A\u0430 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0430
      \u043F\u0438\u0430\u043B\u0443 \u0441 \u043A\u0443\u043C\u044B\u0441\u043E\u043C
      \u0438 \u043E\u0442\u0440\u0435\u0437\u0430\u043B\u0430 \u043E\u0442 \u0432\u0430\u0440\u0451\u043D\u043E\u0433\u043E
      \u0431\u043E\u043A\u0430. \u0415\u043B\u0438 \u043C\u043E\u043B\u0447\u0430,
      \u043F\u043E-\u0445\u043E\u0440\u043E\u0448\u0435\u043C\u0443. \u0423\u0442\u0440\u043E\u043C
      \u043B\u044E\u0434\u0438 \u0432\u0441\u0442\u0430\u043B\u0438 \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0432\u0448\u0438\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378516
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0432\u0435\u0447\u0435\u0440
      \u0432 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0435 \u0441 \u0445\u043E\u0437\u044F\u0438\u043D\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378517
    m_Localized: "\u0425\u043E\u0437\u044F\u0438\u043D \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0441\u043B\u043E\u0432\u043E\u043E\u0445\u043E\u0442\u043B\u0438\u0432\u044B\u043C:
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B \u043E \u0434\u043E\u0440\u043E\u0433\u0430\u0445
      \u043A \u0441\u0435\u0432\u0435\u0440\u0443, \u043E \u0442\u043E\u043C, \u0433\u0434\u0435
      \u0441\u0442\u0435\u043F\u043D\u044B\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
      \u043D\u044B\u043D\u0447\u0435 \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u044F\u044E\u0442,
      \u0430 \u0433\u0434\u0435 \u043D\u0435\u0442. \u0412\u0435\u0447\u0435\u0440
      \u043F\u0440\u043E\u0448\u0451\u043B \u0443 \u043E\u0433\u043D\u044F \u0441
      \u0447\u0430\u0435\u043C \u0438 \u0446\u0435\u043D\u043D\u044B\u043C\u0438
      \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378518
    m_Localized: "\u0425\u043E\u0437\u044F\u0438\u043D \u043F\u0440\u0438\u043D\u044F\u043B
      \u0433\u043E\u0441\u0442\u0435\u043F\u0440\u0438\u0438\u043C\u043D\u043E, \u043D\u043E
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u043D\u0435 \u0432\u044B\u0448\u0435\u043B:
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0440\u0430\u0437\u043D\u044B\u0435
      \u043D\u0430\u0440\u0435\u0447\u0438\u044F, \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043C\u0430\u043B\u043E \u043E\u0431\u0449\u0438\u0445 \u0441\u043B\u043E\u0432.
      \u041F\u0435\u0440\u0435\u043D\u043E\u0447\u0435\u0432\u0430\u043B\u0438 \u0442\u0435\u043F\u043B\u043E,
      \u043D\u043E \u0443\u0435\u0445\u0430\u043B\u0438 \u0431\u0435\u0437 \u043D\u043E\u0432\u043E\u0441\u0442\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378519
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043D\u0430 \u043C\u0435\u0441\u0442\u043D\u043E\u043C \u043D\u0430\u0440\u0435\u0447\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378520
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0441 \u0445\u043E\u0437\u044F\u0438\u043D\u043E\u043C \u043D\u0430 \u0435\u0433\u043E
      \u044F\u0437\u044B\u043A\u0435, \u0438 \u0442\u043E\u0442 \u0440\u0430\u0441\u0446\u0432\u0451\u043B.
      \u0412\u0435\u0447\u0435\u0440 \u0437\u0430\u0442\u044F\u043D\u0443\u043B\u0441\u044F:
      \u043F\u0435\u0441\u043D\u0438, \u0431\u0430\u0439\u043A\u0438 \u043E \u0441\u0442\u0435\u043F\u043D\u044B\u0445
      \u0434\u0443\u0445\u0430\u0445 \u0438 \u043F\u043E\u0434\u0430\u0440\u043E\u043A
      \u043D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435 \u2014 \u0441\u0443\u0448\u0451\u043D\u043E\u0435
      \u043C\u044F\u0441\u043E \u0432 \u043A\u043E\u0436\u0430\u043D\u043E\u043C
      \u043C\u0435\u0448\u043A\u0435. \"\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F,
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446.\""
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378521
    m_Localized: "\u041F\u0435\u0441\u043D\u044F \u043F\u0430\u0441\u0442\u0443\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378522
    m_Localized: "\u041E\u0442\u043A\u0443\u0434\u0430-\u0442\u043E \u0438\u0437
      \u0442\u0435\u043C\u043D\u043E\u0442\u044B \u0437\u0430 \u043E\u0433\u043D\u0451\u043C
      \u0442\u044F\u043D\u0435\u0442\u0441\u044F \u0433\u043E\u043B\u043E\u0441:
      \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439, \u0440\u043E\u0432\u043D\u044B\u0439,
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0433\u043D\u0443\u0441\u0430\u0432\u044B\u0439.
      \u041F\u0430\u0441\u0442\u0443\u0445 \u0441\u0438\u0434\u0438\u0442 \u0432
      \u0441\u0442\u043E\u0440\u043E\u043D\u0435, \u043E\u0431\u0445\u0432\u0430\u0442\u0438\u0432
      \u043A\u043E\u043B\u0435\u043D\u0438 \u0440\u0443\u043A\u0430\u043C\u0438,
      \u0438 \u043F\u043E\u0451\u0442 \u2014 \u043D\u0435 \u0434\u043B\u044F \u0432\u0430\u0441,
      \u0430 \u0434\u043B\u044F \u0441\u0442\u0435\u043F\u0438. \u041C\u0435\u043B\u043E\u0434\u0438\u044F
      \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0430\u044F, \u0441\u043B\u043E\u0432\u0430
      \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u044B\u0435, \u043D\u043E
      \u0447\u0442\u043E-\u0442\u043E \u0432 \u043D\u0435\u0439 \u0441\u043D\u0438\u043C\u0430\u0435\u0442
      \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C, \u043A\u0430\u043A
      \u0441\u043D\u0438\u043C\u0430\u044E\u0442 \u0442\u044F\u0436\u0451\u043B\u044B\u0439
      \u0433\u0440\u0443\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378523
    m_Localized: "\u0421\u043B\u0443\u0448\u0430\u0442\u044C \u043C\u043E\u043B\u0447\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378524
    m_Localized: "\u0421\u0438\u0434\u0435\u043B\u0438 \u0438 \u0441\u043B\u0443\u0448\u0430\u043B\u0438.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B. \u041A \u043A\u043E\u043D\u0446\u0443
      \u043F\u0435\u0441\u043D\u0438 \u043B\u0430\u0433\u0435\u0440\u044C \u0441\u0442\u0430\u043B
      \u0434\u0440\u0443\u0433\u0438\u043C: \u0442\u0438\u0448\u0435, \u043B\u0435\u0433\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378525
    m_Localized: "\u041F\u043E\u0434\u043F\u0435\u0442\u044C \u0438\u043B\u0438 \u0445\u043B\u043E\u043F\u0430\u0442\u044C
      \u0432 \u043B\u0430\u0434\u043E\u0448\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378526
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u043D\u0430\u0447\u0430\u043B \u0445\u043B\u043E\u043F\u0430\u0442\u044C,
      \u0434\u0440\u0443\u0433\u043E\u0439 \u043F\u043E\u0434\u0445\u0432\u0430\u0442\u0438\u043B
      \u043C\u0435\u043B\u043E\u0434\u0438\u044E \u043D\u0430 \u0444\u043B\u0435\u0439\u0442\u0435.
      \u041F\u0430\u0441\u0442\u0443\u0445 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u0443\u0434\u0438\u0432\u043B\u0451\u043D\u043D\u043E, \u043F\u043E\u0442\u043E\u043C
      \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F \u0438 \u0437\u0430\u0438\u0433\u0440\u0430\u043B
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435. \u041B\u0430\u0433\u0435\u0440\u044C
      \u043F\u043B\u044F\u0441\u0430\u043B \u0434\u043E \u043F\u043E\u043B\u0443\u043D\u043E\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378527
    m_Localized: "\u041A\u0442\u043E-\u0442\u043E \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0441\u044F
      \u043F\u043E\u0434\u043F\u0435\u0442\u044C, \u043D\u043E \u043F\u043E\u043F\u0430\u043B
      \u043D\u0435 \u0432 \u043B\u0430\u0434. \u041F\u0430\u0441\u0442\u0443\u0445
      \u0437\u0430\u043C\u043E\u043B\u0447\u0430\u043B, \u0432\u0441\u0442\u0430\u043B
      \u0438 \u0443\u0448\u0451\u043B \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0443.
      \u0412\u0435\u0447\u0435\u0440 \u0441\u043A\u043E\u043C\u043A\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378528
    m_Localized: "\u0411\u044B\u0432\u0430\u043B\u044B\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0437\u043D\u0430\u0435\u0442 \u0441\u0442\u0435\u043F\u043D\u044B\u0435 \u043E\u0431\u044B\u0447\u0430\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240367378529
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0434\u043E\u0441\u0442\u0430\u043B
      \u0431\u0443\u0440\u0434\u044E\u043A \u0441 \u043A\u0443\u043C\u044B\u0441\u043E\u043C,
      \u043D\u0430\u043B\u0438\u043B \u0438 \u043F\u043E\u0434\u043D\u0451\u0441
      \u043F\u0430\u0441\u0442\u0443\u0445\u0443 \u043C\u043E\u043B\u0447\u0430,
      \u0434\u0432\u0443\u043C\u044F \u0440\u0443\u043A\u0430\u043C\u0438. \u0422\u043E\u0442
      \u043F\u0440\u0438\u043D\u044F\u043B, \u043A\u0438\u0432\u043D\u0443\u043B.
      \u0422\u0430\u043A \u043E\u043D\u0438 \u043F\u0440\u043E\u0441\u0438\u0434\u0435\u043B\u0438
      \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430: \u043E\u0434\u0438\u043D
      \u043F\u0435\u043B, \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u043B\u0443\u0448\u0430\u043B,
      \u0438 \u0441 \u043A\u0430\u0436\u0434\u043E\u0439 \u043F\u0435\u0441\u043D\u0435\u0439
      \u0432 \u043B\u0430\u0433\u0435\u0440\u0435 \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u043E\u0441\u044C
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572736
    m_Localized: "\u041D\u043E\u0447\u043D\u043E\u0439 \u0434\u043E\u0436\u0434\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572737
    m_Localized: "\u0414\u043E\u0436\u0434\u044C \u043F\u0440\u0438\u0448\u0451\u043B
      \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F:
      \u0442\u0451\u043F\u043B\u044B\u0439, \u043C\u0435\u043B\u043A\u0438\u0439,
      \u043F\u0430\u0445\u043D\u0443\u0449\u0438\u0439 \u043F\u043E\u043B\u044B\u043D\u044C\u044E
      \u0438 \u043C\u043E\u043A\u0440\u043E\u0439 \u0437\u0435\u043C\u043B\u0451\u0439.
      \u0421\u0442\u0435\u043F\u044C \u0437\u0430\u0448\u0438\u043F\u0435\u043B\u0430,
      \u043A\u043E\u0441\u0442\u0451\u0440 \u0437\u0430\u0447\u0430\u0434\u0438\u043B.
      \u041B\u044E\u0434\u0438 \u0437\u0430\u0448\u0435\u0432\u0435\u043B\u0438\u043B\u0438\u0441\u044C:
      \u043A\u0442\u043E \u043D\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u043F\u043E\u043B\u043E\u0433, \u043A\u0442\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442
      \u0442\u044E\u043A\u0438. \u0414\u043E\u0436\u0434\u044C \u0432 \u0441\u0442\u0435\u043F\u0438
      \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0434\u043E\u0431\u0440\u044B\u043C
      \u0433\u043E\u0441\u0442\u0435\u043C, \u0430 \u043C\u043E\u0436\u0435\u0442
      \u2014 \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u0442\u044C \u0432\u0441\u0451,
      \u0447\u0442\u043E \u043D\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572738
    m_Localized: "\u0423\u043A\u0440\u044B\u0442\u044C \u0442\u043E\u0432\u0430\u0440
      \u0438 \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572739
    m_Localized: "\u0422\u044E\u043A\u0438 \u0443\u043A\u0440\u044B\u043B\u0438 \u0432\u043E\u0439\u043B\u043E\u043A\u043E\u043C,
      \u043B\u044E\u0434\u0438 \u0437\u0430\u0431\u0440\u0430\u043B\u0438\u0441\u044C
      \u043F\u043E\u0434 \u043F\u043E\u0432\u043E\u0437\u043A\u0438. \u0414\u043E\u0436\u0434\u044C
      \u043F\u0440\u043E\u0448\u0451\u043B \u0437\u0430 \u0447\u0430\u0441. \u041D\u0430\u0443\u0442\u0440\u043E
      \u0442\u0440\u0430\u0432\u0430 \u0431\u043B\u0435\u0441\u0442\u0435\u043B\u0430
      \u0438 \u0432\u043E\u0437\u0434\u0443\u0445 \u0431\u044B\u043B \u0447\u0438\u0441\u0442\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572740
    m_Localized: "\u0420\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u043E\u0441\u0443\u0434\u0443
      \u0434\u043B\u044F \u0441\u0431\u043E\u0440\u0430 \u0432\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572741
    m_Localized: "\u0420\u0430\u0441\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0432\u0441\u0435
      \u043A\u043E\u0442\u043B\u044B \u0438 \u0431\u0443\u0440\u0434\u044E\u043A\u0438.
      \u041A \u0443\u0442\u0440\u0443 \u043D\u0430\u0431\u0440\u0430\u043B\u0438
      \u0434\u0432\u0430 \u0434\u043D\u044F \u0437\u0430\u043F\u0430\u0441\u0430
      \u0432\u043E\u0434\u044B. \u0414\u043E\u0436\u0434\u044C \u0442\u0451\u043F\u043B\u044B\u0439,
      \u0432\u043E\u0434\u0430 \u043C\u044F\u0433\u043A\u0430\u044F. \u0417\u0430\u0434\u0430\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572742
    m_Localized: "\u041F\u043E\u043A\u0430 \u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u043F\u043E\u0441\u0443\u0434\u0443, \u0437\u0430\u0431\u044B\u043B\u0438
      \u043E \u0442\u044E\u043A\u0430\u0445. \u0427\u0430\u0441\u0442\u044C \u0442\u043E\u0432\u0430\u0440\u0430
      \u043F\u0440\u043E\u043C\u043E\u043A\u043B\u0430. \u0423\u0442\u0440\u043E\u043C
      \u0441\u0443\u0448\u0438\u043B\u0438 \u043D\u0430 \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u0445
      \u0438 \u0440\u0443\u0433\u0430\u043B\u0438\u0441\u044C \u0442\u0438\u0445\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572743
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0437\u0430\u0433\u043E\u0442\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0434\u043E\u0436\u0434\u0435\u0432\u0443\u044E \u0432\u043E\u0434\u0443 \u0438
      \u0442\u0440\u0430\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572744
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0432\u044B\u0448\u0435\u043B
      \u043F\u043E\u0434 \u0434\u043E\u0436\u0434\u044C \u0441 \u0441\u0443\u043C\u043A\u043E\u0439
      \u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043C\u043E\u043A\u0440\u044B\u043C,
      \u043D\u043E \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u043C: \u043D\u0430\u0431\u0440\u0430\u043B
      \u043C\u044F\u0433\u043A\u043E\u0439 \u0432\u043E\u0434\u044B, \u043D\u0430\u0440\u0432\u0430\u043B
      \u043C\u043E\u043A\u0440\u043E\u0439 \u043F\u043E\u043B\u044B\u043D\u0438 \u0438
      \u043B\u0438\u0441\u0442\u044C\u0435\u0432 \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u0438\u043A\u0430.
      \"\u0414\u043E\u0436\u0434\u044C \u0432 \u0441\u0442\u0435\u043F\u0438 \u2014
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u0430\u043F\u0442\u0435\u043A\u0438.\"
      \u0417\u0430\u043F\u0430\u0441\u044B \u0432\u043E\u0434\u044B \u0438 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432
      \u043F\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572745
    m_Localized: "\u041F\u0440\u043E\u0445\u043B\u0430\u0434\u0430 \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u043E\u0439
      \u043D\u043E\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572746
    m_Localized: "\u0421\u043E\u043B\u043D\u0446\u0435 \u0443\u0448\u043B\u043E,
      \u0438 \u043F\u0443\u0441\u0442\u044B\u043D\u044F \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B\u0430.
      \u041F\u0435\u0441\u043E\u043A \u0435\u0449\u0451 \u0442\u0451\u043F\u043B\u044B\u0439
      \u043F\u043E\u0434 \u043B\u0430\u0434\u043E\u043D\u044C\u044E, \u043D\u043E
      \u0432\u043E\u0437\u0434\u0443\u0445 \u0443\u0436\u0435 \u043F\u0430\u0445\u043D\u0435\u0442
      \u0445\u043E\u043B\u043E\u0434\u043E\u043C \u0438 \u0437\u0432\u0451\u0437\u0434\u0430\u043C\u0438.
      \u041F\u043E\u0441\u043B\u0435 \u0434\u043D\u0435\u0432\u043D\u043E\u0433\u043E
      \u043F\u0435\u043A\u043B\u0430 \u043D\u043E\u0447\u044C \u0437\u0434\u0435\u0441\u044C
      \u2014 \u043A\u0430\u043A \u043D\u0430\u0433\u0440\u0430\u0434\u0430. \u041B\u044E\u0434\u0438
      \u0440\u0430\u0437\u043B\u0435\u0433\u043B\u0438\u0441\u044C \u043D\u0430 \u043A\u043E\u0448\u043C\u0430\u0445,
      \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u0432 \u043D\u0435\u0431\u043E.
      \u041C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C,
      \u0430 \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u0443, \u043F\u043E\u043A\u0430
      \u043E\u043D\u0430 \u043D\u0435 \u0443\u0448\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572747
    m_Localized: "\u041F\u043E\u0441\u043F\u0430\u0442\u044C \u0432\u0441\u0435\u043C
      \u0438 \u043D\u0430\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0441\u0438\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572748
    m_Localized: "\u041B\u0430\u0433\u0435\u0440\u044C \u0437\u0430\u0442\u0438\u0445
      \u0440\u0430\u043D\u043E. \u0423\u0442\u0440\u043E\u043C \u0432\u0441\u0442\u0430\u043B\u0438
      \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0432\u0448\u0438\u043C\u0438: \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u0430\u044F
      \u043D\u043E\u0447\u044C \u0432\u0435\u0440\u043D\u0443\u043B\u0430 \u0441\u0438\u043B\u044B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0434\u0435\u043D\u044C \u0437\u0430\u0431\u0440\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572749
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u0432\u0435\u0447\u0435\u0440
      \u0437\u0430 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u043E\u043C \u0438
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0434\u0443\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572750
    m_Localized: "\u0412\u044B \u0441\u043E\u0431\u0440\u0430\u043B\u0438 \u043B\u044E\u0434\u0435\u0439
      \u0443 \u0443\u0433\u0430\u0441\u0430\u044E\u0449\u0435\u0433\u043E \u043E\u0433\u043D\u044F.
      \u0413\u043E\u0432\u043E\u0440\u0438\u043B\u0438 \u043E \u041C\u0435\u0440\u0432\u0435,
      \u043E \u0446\u0435\u043D\u0430\u0445 \u043D\u0430 \u0448\u0451\u043B\u043A
      \u0432 \u0411\u0430\u0433\u0434\u0430\u0434\u0435, \u043E \u0441\u0435\u043C\u044C\u044F\u0445
      \u0434\u043E\u043C\u0430. \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0437\u0430\u0441\u043D\u0443\u043B.
      \u041A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443 \u043B\u0430\u0433\u0435\u0440\u044C
      \u0431\u044B\u043B \u043E\u0434\u043D\u0438\u043C \u0442\u0435\u043B\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572751
    m_Localized: "\u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u043D\u0435 \u043F\u043E\u0448\u0451\u043B:
      \u043B\u044E\u0434\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0443\u0441\u0442\u0430\u043B\u0438,
      \u0447\u0442\u043E\u0431\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C,
      \u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043D\u0435\u0440\u0432\u043D\u0438\u0447\u0430\u043B\u0438,
      \u0447\u0442\u043E\u0431\u044B \u043C\u043E\u043B\u0447\u0430\u0442\u044C.
      \u0420\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C \u043F\u043E \u043C\u0435\u0441\u0442\u0430\u043C
      \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0451\u043D\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572752
    m_Localized: "\u0425\u0430\u0440\u0438\u0437\u043C\u0430\u0442\u0438\u0447\u043D\u044B\u0439
      \u043A\u0443\u043F\u0435\u0446 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0434\u0443\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572753
    m_Localized: "\u0412\u044B \u0432\u0441\u0442\u0430\u043B\u0438 \u0443 \u043E\u0433\u043D\u044F
      \u0438 \u0441\u043A\u0430\u0437\u0430\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E:
      \"\u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043D\u0430 \u043D\u0435\u0431\u043E.
      \u0412\u043E\u0442 \u0437\u0432\u0435\u0437\u0434\u0430 \u0421\u0443\u0445\u0430\u0439\u043B
      \u2014 \u043E\u043D\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u043A \u044E\u0433\u0443.
      \u041F\u043E\u043A\u0430 \u043E\u043D\u0430 \u0441\u0432\u0435\u0442\u0438\u0442,
      \u043C\u044B \u0437\u043D\u0430\u0435\u043C, \u043A\u0443\u0434\u0430 \u0438\u0434\u0451\u043C.\"
      \u041C\u043E\u043B\u0447\u0430\u043D\u0438\u0435. \u041F\u043E\u0442\u043E\u043C
      \u043A\u0442\u043E-\u0442\u043E \u0442\u0438\u0445\u043E \u043F\u0440\u043E\u0438\u0437\u043D\u0451\u0441:
      \"\u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u0445\u043E\u0437\u044F\u0438\u043D.\"
      \u0418 \u044D\u0442\u043E\u0433\u043E \u0445\u0432\u0430\u0442\u0438\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572754
    m_Localized: "\u041C\u043E\u043B\u0438\u0442\u0432\u0430 \u043F\u043E\u0434 \u0437\u0432\u0451\u0437\u0434\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572755
    m_Localized: "\u041F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0440\u0430\u0441\u0441\u0442\u0435\u043B\u0438\u043B \u043A\u043E\u0432\u0440\u0438\u043A
      \u043B\u0438\u0446\u043E\u043C \u043D\u0430 \u044E\u0433\u043E-\u0437\u0430\u043F\u0430\u0434,
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u041C\u0435\u043A\u043A\u0438,
      \u043F\u043E\u0434\u043D\u044F\u043B \u043B\u0430\u0434\u043E\u043D\u0438.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044E\u0442
      \u2014 \u043A\u0442\u043E \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C,
      \u043A\u0442\u043E \u0441 \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u0441\u0442\u0432\u043E\u043C.
      \u0417\u0432\u0451\u0437\u0434\u043D\u043E\u0435 \u043D\u0435\u0431\u043E \u043D\u0430\u0434
      \u043F\u0443\u0441\u0442\u044B\u043D\u0435\u0439 \u0430\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u043E\u0435:
      \u043D\u0438 \u0442\u0443\u0447, \u043D\u0438 \u0434\u044B\u043C\u0430. \u0415\u0433\u043E
      \u043C\u043E\u043B\u0438\u0442\u0432\u0430 \u0432 \u0442\u0438\u0448\u0438\u043D\u0435
      \u0437\u0432\u0443\u0447\u0438\u0442 \u043A\u0430\u043A \u0447\u0430\u0441\u0442\u044C
      \u044D\u0442\u043E\u0433\u043E \u043D\u0435\u0431\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572756
    m_Localized: "\u0414\u0430\u0442\u044C \u043C\u043E\u043B\u0438\u0442\u044C\u0441\u044F
      \u0438 \u043E\u0442\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572757
    m_Localized: "\u041B\u0430\u0433\u0435\u0440\u044C \u043F\u0440\u0438\u0442\u0438\u0445.
      \u041A\u043E\u0433\u0434\u0430 \u043C\u043E\u043B\u0438\u0442\u0432\u0430 \u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C,
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0441\u0432\u0435\u0440\u043D\u0443\u043B
      \u043A\u043E\u0432\u0440\u0438\u043A \u0438 \u0441\u0435\u043B \u0443 \u043E\u0433\u043D\u044F
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u043C. \u0423\u0432\u0430\u0436\u0435\u043D\u0438\u0435
      \u0441\u0442\u043E\u0438\u0442 \u043C\u0430\u043B\u043E \u0438 \u0434\u0430\u0451\u0442
      \u043C\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572758
    m_Localized: "\u041F\u0440\u0438\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u044C\u0441\u044F
      \u0438 \u043F\u043E\u0434\u043D\u044F\u0442\u044C \u0434\u0443\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572759
    m_Localized: "\u0412\u044B \u0432\u0441\u0442\u0430\u043B\u0438 \u0440\u044F\u0434\u043E\u043C
      \u2014 \u043D\u0435 \u043C\u043E\u043B\u044F\u0441\u044C, \u043D\u043E \u0441\u0442\u043E\u044F.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0437\u0430\u043C\u0435\u0442\u0438\u043B
      \u0438 \u043F\u043E\u0441\u043B\u0435 \u043C\u043E\u043B\u0438\u0442\u0432\u044B
      \u043A\u0438\u0432\u043D\u0443\u043B. \"\u0425\u043E\u0437\u044F\u0438\u043D
      \u0443\u0432\u0430\u0436\u0430\u0435\u0442 \u043F\u0443\u0442\u044C.\" \u042D\u0442\u043E
      \u0440\u0430\u0437\u043E\u0448\u043B\u043E\u0441\u044C \u043F\u043E \u043B\u0430\u0433\u0435\u0440\u044E
      \u0431\u044B\u0441\u0442\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572760
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u043A\u0430 \u043F\u0440\u043E\u0438\u0437\u043D\u0435\u0441\u0442\u0438
      \u0441\u043B\u043E\u0432\u0430 \u043C\u043E\u043B\u0438\u0442\u0432\u044B \u0432\u044B\u0448\u043B\u0430
      \u043D\u0435\u043B\u043E\u0432\u043A\u043E\u0439. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043F\u043E\u043C\u043E\u0440\u0449\u0438\u043B\u0441\u044F, \u043D\u043E
      \u043F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u043B. \u041D\u0435\u043B\u043E\u0432\u043A\u043E\u0441\u0442\u044C
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572761
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442
      \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u043C\u043E\u043B\u0438\u0442\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572762
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0442\u0438\u0445\u043E
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C:
      \u043E\u0431 \u043E\u0431\u0440\u044F\u0434\u0435, \u043E \u0442\u043E\u043C,
      \u0447\u0442\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u043A\u0430\u0436\u0434\u044B\u0439
      \u0436\u0435\u0441\u0442. \u041B\u044E\u0434\u0438 \u0441\u043B\u0443\u0448\u0430\u043B\u0438
      \u0431\u0435\u0437 \u0443\u0441\u043C\u0435\u0448\u0435\u043A. \"\u0425\u043E\u0440\u043E\u0448\u043E,
      \u0447\u0442\u043E \u0437\u043D\u0430\u0435\u043C\", \u2014 \u0441\u043A\u0430\u0437\u0430\u043B
      \u043A\u0442\u043E-\u0442\u043E. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
      \u0434\u043D\u0438 \u0432 \u043F\u0443\u0442\u0438 \u043F\u0440\u043E\u0448\u043B\u0438
      \u0431\u0435\u0437 \u0441\u0441\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572763
    m_Localized: "\u041B\u0435\u0433\u0435\u043D\u0434\u0430 \u043E \u043F\u0443\u0441\u0442\u044B\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572764
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A-\u0431\u0435\u0434\u0443\u0438\u043D
      \u0441\u0438\u0434\u0438\u0442 \u0447\u0443\u0442\u044C \u043F\u043E\u043E\u0434\u0430\u043B\u044C,
      \u043F\u043E\u0434\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442 \u0449\u0435\u043F\u043A\u0443
      \u0432 \u043E\u0433\u043E\u043D\u044C. \u041F\u043E\u0442\u043E\u043C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u0443: \"\u0421\u043B\u044B\u0448\u0430\u043B\u0438
      \u043F\u0440\u043E \u0412\u0430\u0431\u0431\u0430\u0440?\" \u041D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0441\u043B\u044B\u0448\u0430\u043B. \u041E\u043D \u0443\u0441\u043C\u0435\u0445\u0430\u0435\u0442\u0441\u044F.
      \u041B\u0435\u0433\u0435\u043D\u0434\u044B \u0443 \u0442\u0430\u043A\u0438\u0445
      \u043B\u044E\u0434\u0435\u0439 \u043D\u0435 \u0434\u043B\u044F \u043D\u043E\u0447\u043D\u044B\u0445
      \u0441\u0442\u0440\u0430\u0445\u043E\u0432 \u2014 \u043E\u043D\u0438 \u0434\u043B\u044F
      \u0442\u043E\u0433\u043E, \u0447\u0442\u043E\u0431\u044B \u0437\u043D\u0430\u0442\u044C,
      \u0433\u0434\u0435 \u043D\u0435\u043B\u044C\u0437\u044F \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572765
    m_Localized: "\u0421\u043B\u0443\u0448\u0430\u0442\u044C \u043C\u043E\u043B\u0447\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572766
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B
      \u043D\u0435\u0442\u043E\u0440\u043E\u043F\u043B\u0438\u0432\u043E: \u043E
      \u0441\u0442\u0435\u043A\u043B\u044F\u043D\u043D\u044B\u0445 \u0434\u044E\u043D\u0430\u0445
      \u0412\u0430\u0431\u0431\u0430\u0440\u0430, \u043E \u0433\u043E\u0440\u043E\u0434\u0435,
      \u0441\u043E\u0436\u0436\u0451\u043D\u043D\u043E\u043C \u043D\u0435\u0431\u0435\u0441\u043D\u044B\u043C
      \u043E\u0433\u043D\u0451\u043C. \u041D\u0438\u043A\u0442\u043E \u043D\u0435
      \u0437\u0430\u0441\u043D\u0443\u043B \u0440\u0430\u043D\u044C\u0448\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438.
      \u041D\u043E \u0441\u0442\u0440\u0430\u0445\u0430 \u043D\u0435 \u0431\u044B\u043B\u043E
      \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572767
    m_Localized: "\u0420\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C
      \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0435\u0435 \u043E \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572768
    m_Localized: "\u0412\u044B \u0441\u043F\u0440\u043E\u0441\u0438\u043B\u0438:
      \"\u0410 \u0433\u0434\u0435 \u043D\u0435\u043B\u044C\u0437\u044F \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043D\u043E\u0447\u044C?\" \u0421\u0442\u0430\u0440\u0438\u043A
      \u043E\u0436\u0438\u0432\u0438\u043B\u0441\u044F. \u0420\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u043B
      \u0447\u0430\u0441. \u0417\u0430\u043F\u0438\u0441\u0430\u043B\u0438 \u043C\u044B\u0441\u043B\u0435\u043D\u043D\u043E:
      \u0442\u0440\u0438 \u043C\u0435\u0441\u0442\u0430 \u043E\u0431\u043E\u0439\u0442\u0438
      \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439, \u043E\u0434\u043D\u043E
      \u2014 \u0445\u043E\u0440\u043E\u0448\u0435\u0435. \u0417\u043D\u0430\u043D\u0438\u0435
      \u0434\u043E\u0440\u043E\u0436\u0435 \u0437\u043E\u043B\u043E\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572769
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u043A\u0430 \u0443\u0442\u043E\u0447\u043D\u0438\u0442\u044C
      \u0434\u0435\u0442\u0430\u043B\u0438 \u043F\u0440\u0438\u0432\u0435\u043B\u0430
      \u043A \u0442\u043E\u043C\u0443, \u0447\u0442\u043E \u0441\u0442\u0430\u0440\u0438\u043A
      \u0437\u0430\u043C\u043E\u043B\u0447\u0430\u043B. \"\u041D\u0435 \u0432\u0441\u0451
      \u0434\u043B\u044F \u0447\u0443\u0436\u0438\u0445 \u0443\u0448\u0435\u0439.\"
      \u041E\u0441\u0442\u0430\u0442\u043E\u043A \u0432\u0435\u0447\u0435\u0440\u0430
      \u043F\u0440\u043E\u0448\u0451\u043B \u0432 \u0442\u0438\u0448\u0438\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572770
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442
      \u0441\u0432\u043E\u044E \u0438\u0441\u0442\u043E\u0440\u0438\u044E \u0432
      \u043E\u0442\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572771
    m_Localized: "\u0412\u044B \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0438
      \u043E\u0431 \u043E\u0431\u0445\u043E\u0434\u0435 \u043B\u0435\u0434\u043D\u0438\u043A\u0430
      \u0432 \u0421\u043E\u0433\u0434\u0435 \u2014 \u043A\u0430\u043A \u0442\u043E\u0433\u0434\u0430
      \u0442\u043E\u0436\u0435 \u0434\u0443\u043C\u0430\u043B\u0438, \u0447\u0442\u043E
      \u043F\u0443\u0442\u044C \u043F\u0440\u043E\u043A\u043B\u044F\u0442, \u0430
      \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C: \u043F\u0440\u043E\u0441\u0442\u043E
      \u043D\u0435\u0432\u0435\u0440\u043D\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430.
      \u0421\u0442\u0430\u0440\u0438\u043A \u043A\u0438\u0432\u043D\u0443\u043B \u0438
      \u043F\u0440\u043E\u0442\u044F\u043D\u0443\u043B \u0441\u0443\u0448\u0451\u043D\u044B\u0439
      \u0444\u0438\u043D\u0438\u043A. \u041E\u0431\u043C\u0435\u043D \u0438\u0441\u0442\u043E\u0440\u0438\u044F\u043C\u0438
      \u2014 \u044D\u0442\u043E \u0438 \u0435\u0441\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572772
    m_Localized: "\u041A\u0440\u0443\u0436\u043A\u0430 \u0447\u0430\u044F \u043D\u0430
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572773
    m_Localized: "\u0412\u0435\u0442\u0435\u0440 \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435
      \u0440\u0435\u0436\u0435\u0442 \u0449\u0451\u043A\u0438. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A-\u0431\u0430\u043A\u0442\u0440\u0438\u0435\u0446
      \u0440\u0430\u0441\u043F\u0430\u043A\u043E\u0432\u044B\u0432\u0430\u0435\u0442
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043C\u0435\u0448\u043E\u043A,
      \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u043F\u043B\u0438\u0442\u043A\u0443
      \u043F\u0440\u0435\u0441\u0441\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
      \u0447\u0430\u044F \u0438 \u043C\u0435\u0434\u043D\u044B\u0439 \u043A\u043E\u0442\u0435\u043B\u043E\u043A.
      \u0412\u043E\u0434\u0430 \u0438\u0437 \u043B\u0443\u0436\u0438\u0446\u044B
      \u0442\u0430\u043B\u043E\u0433\u043E \u0441\u043D\u0435\u0433\u0430 \u0437\u0430\u043A\u0438\u043F\u0430\u0435\u0442
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u2014 \u0432\u044B\u0441\u043E\u0442\u0430
      \u0431\u043E\u043B\u044C\u0448\u0430\u044F. \u041F\u0430\u0440 \u043E\u0442
      \u043A\u0440\u0443\u0436\u043A\u0438 \u043F\u0430\u0445\u043D\u0435\u0442 \u0434\u044B\u043C\u043A\u043E\u043C
      \u0438 \u0447\u0435\u043C-\u0442\u043E \u0433\u043E\u0440\u044C\u043A\u043E\u0432\u0430\u0442\u044B\u043C.
      \u041B\u044E\u0434\u0438 \u0442\u044F\u043D\u0443\u0442\u0441\u044F \u043A
      \u0442\u0435\u043F\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572774
    m_Localized: "\u0414\u0430\u0442\u044C \u0432\u0441\u0435\u043C \u043F\u043E
      \u043A\u0440\u0443\u0436\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572775
    m_Localized: "\u041F\u043B\u0438\u0442\u043A\u0438 \u0445\u0432\u0430\u0442\u0438\u043B\u043E
      \u043D\u0430 \u0432\u0441\u0435\u0445 \u2014 \u043F\u043E \u043E\u0434\u043D\u043E\u0439
      \u043A\u0440\u0443\u0436\u043A\u0435, \u043A\u0440\u0435\u043F\u043A\u043E\u0439
      \u0438 \u0433\u043E\u0440\u044F\u0447\u0435\u0439. \u041B\u044E\u0434\u0438
      \u0437\u0430\u0434\u0432\u0438\u0433\u0430\u043B\u0438\u0441\u044C \u0436\u0438\u0432\u0435\u0435.
      \u041F\u0435\u0440\u0435\u0432\u0430\u043B \u0432\u0437\u044F\u043B\u0438 \u043D\u0430
      \u0447\u0430\u0441 \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u0447\u0435\u043C
      \u043E\u0436\u0438\u0434\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572776
    m_Localized: "\u0420\u0430\u0437\u0432\u0430\u0440\u0438\u0442\u044C \u0447\u0430\u0439
      \u0433\u0443\u0449\u0435, \u0434\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0443\u0441\u0442\u0430\u0432\u0448\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572777
    m_Localized: "\u0412\u044B \u0432\u044B\u0431\u0440\u0430\u043B\u0438 \u0447\u0435\u0442\u0432\u0435\u0440\u044B\u0445,
      \u043A\u0442\u043E \u0448\u0430\u0442\u0430\u043B\u0441\u044F \u043D\u0430
      \u0445\u043E\u0434\u0443. \u0413\u043E\u0440\u044F\u0447\u0438\u0439 \u043D\u0430\u0441\u0442\u043E\u0439
      \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0438\u0445 \u043D\u0430
      \u043D\u043E\u0433\u0438 \u0431\u044B\u0441\u0442\u0440\u043E. \u042D\u043A\u043E\u043D\u043E\u043C\u0438\u044F
      \u0437\u0430\u043F\u0430\u0441\u043E\u0432 \u2014 \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u0435\u0449\u0451 \u0434\u043D\u0438 \u0432 \u0433\u043E\u0440\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572778
    m_Localized: "\u0412\u044B\u0431\u043E\u0440 \u0432\u044B\u0437\u0432\u0430\u043B
      \u043E\u0431\u0438\u0434\u044B. \u0422\u0435, \u043A\u043E\u0433\u043E \u043E\u0431\u0434\u0435\u043B\u0438\u043B\u0438,
      \u0432\u043E\u0440\u0447\u0430\u043B\u0438 \u0434\u043E \u0432\u0435\u0447\u0435\u0440\u0430.
      \u0427\u0430\u0439 \u0434\u0430\u043B \u0441\u0438\u043B\u044B \u0442\u0435\u043B\u0443,
      \u043D\u043E \u043D\u0435 \u0434\u0443\u0445\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572779
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u0447\u0430\u0439 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0443
      \u043A\u0430\u043A \u043F\u043B\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572780
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043F\u0440\u0438\u043D\u044F\u043B
      \u043F\u043B\u0438\u0442\u043A\u0443 \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C.
      \u0412\u0437\u0430\u043C\u0435\u043D \u043E\u043D \u043F\u043E\u0432\u0451\u043B
      \u0447\u0435\u0440\u0435\u0437 \u043E\u0431\u0445\u043E\u0434\u043D\u0443\u044E
      \u0442\u0440\u043E\u043F\u0443, \u0433\u0434\u0435 \u0432\u0435\u0442\u0435\u0440
      \u0441\u043B\u0430\u0431\u0435\u0435 \u0438 \u0441\u043A\u043B\u043E\u043D
      \u043F\u043E\u043B\u043E\u0436\u0435. \u042D\u043A\u043E\u043D\u043E\u043C\u0438\u044F
      \u0441\u0438\u043B \u0434\u043E\u0440\u043E\u0436\u0435 \u043A\u0440\u0443\u0436\u043A\u0438
      \u0447\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572781
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u043D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572782
    m_Localized: "\u041D\u0430 \u043F\u043B\u043E\u0441\u043A\u043E\u043C \u043A\u0430\u043C\u043D\u0435
      \u0443 \u0442\u0440\u043E\u043F\u044B \u0441\u0438\u0434\u0438\u0442 \u0431\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u043C\u043E\u043D\u0430\u0445 \u2014 \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u043E\u0435
      \u043E\u0434\u0435\u044F\u043D\u0438\u0435, \u0431\u0440\u0438\u0442\u0430\u044F
      \u0433\u043E\u043B\u043E\u0432\u0430, \u0447\u0451\u0442\u043A\u0438 \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u0435\u0442
      \u043D\u0435 \u0433\u043B\u044F\u0434\u044F. \u041E\u043D \u043D\u0435 \u043F\u0440\u043E\u0441\u0438\u0442
      \u043F\u043E\u0434\u0430\u044F\u043D\u0438\u044F \u0438 \u043D\u0435 \u043C\u0435\u0448\u0430\u0435\u0442.
      \u041F\u0440\u043E\u0441\u0442\u043E \u0441\u0438\u0434\u0438\u0442. \u041C\u043E\u043B\u043E\u0434\u043E\u0439
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0445\u043E\u0447\u0435\u0442
      \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0448\u0438\u043A\u0430\u044E\u0442 \u043D\u0430 \u043D\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572783
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043C\u043E\u043D\u0430\u0445\u0430
      \u0432 \u043F\u043E\u043A\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572784
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0432\u0435\u043B\u0438 \u043C\u0438\u043C\u043E
      \u0432\u0435\u0441\u044C \u043E\u0431\u043E\u0437 \u0442\u0438\u0445\u043E.
      \u041C\u043E\u043D\u0430\u0445 \u043D\u0435 \u043F\u043E\u0434\u043D\u044F\u043B
      \u0433\u043B\u0430\u0437. \u041A\u043E\u0433\u0434\u0430 \u043E\u0433\u043B\u044F\u043D\u0443\u043B\u0438\u0441\u044C
      \u0441 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430 \u2014 \u0435\u0433\u043E
      \u0443\u0436\u0435 \u043D\u0435 \u0431\u044B\u043B\u043E. \u0413\u043E\u0440\u044B
      \u0443\u043C\u0435\u044E\u0442 \u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0442\u0438\u0448\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572785
    m_Localized: "\u041F\u0440\u0435\u043F\u043E\u0434\u043D\u0435\u0441\u0442\u0438
      \u043C\u043E\u043D\u0430\u0445\u0443 \u0434\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572786
    m_Localized: "\u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043F\u043E\u043B\u043E\u0436\u0438\u043B \u043F\u0435\u0440\u0435\u0434 \u043C\u043E\u043D\u0430\u0445\u043E\u043C
      \u043B\u0435\u043F\u0451\u0448\u043A\u0443 \u0438 \u0433\u043E\u0440\u0441\u0442\u044C
      \u043E\u0440\u0435\u0445\u043E\u0432. \u041C\u043E\u043D\u0430\u0445 \u043E\u0442\u043A\u0440\u044B\u043B
      \u0433\u043B\u0430\u0437\u0430, \u043A\u043E\u0440\u043E\u0442\u043A\u043E
      \u0441\u043B\u043E\u0436\u0438\u043B \u043B\u0430\u0434\u043E\u043D\u0438 \u0438
      \u0441\u043D\u043E\u0432\u0430 \u0437\u0430\u043A\u0440\u044B\u043B. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u2014 \u0436\u0435\u0441\u0442, \u0430 \u043D\u0435 \u0441\u043B\u043E\u0432\u043E.
      \u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u0431\u044B\u043B \u0434\u043E\u0432\u043E\u043B\u0435\u043D
      \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572787
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u043A\u0430 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0441 \u043C\u043E\u043D\u0430\u0445\u043E\u043C \u043F\u0440\u0438\u0432\u0435\u043B\u0430
      \u043A \u0442\u043E\u043C\u0443, \u0447\u0442\u043E \u043E\u043D \u0432\u0441\u0442\u0430\u043B
      \u0438 \u0443\u0448\u0451\u043B \u043F\u043E \u0442\u0440\u043E\u043F\u0435
      \u0432\u0432\u0435\u0440\u0445, \u043D\u0435 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C.
      \u041D\u0438\u043A\u0430\u043A\u043E\u0433\u043E \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430
      \u043D\u0435 \u0432\u044B\u0448\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572788
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043E
      \u0433\u043E\u0440\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572789
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043E\u0442\u043A\u0440\u044B\u043B \u0433\u043B\u0430\u0437\u0430 \u0438
      \u0441\u043A\u0430\u0437\u0430\u043B \u043F\u043E-\u0442\u044E\u0440\u043A\u0441\u043A\u0438:
      \xAB\u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u0442\u0440\u0438 \u0434\u043D\u044F
      \u0434\u043E \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F. \u0422\u0430\u043C
      \u043C\u043E\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C
      \u0441\u043D\u0435\u0433.\xBB \u0411\u043E\u043B\u044C\u0448\u0435 \u043D\u0438\u0447\u0435\u0433\u043E.
      \u0422\u0440\u0438 \u0434\u043D\u044F \u2014 \u0446\u0435\u043D\u043D\u043E\u0435
      \u0437\u043D\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572790
    m_Localized: "\u041E\u0436\u0438\u0434\u0430\u043D\u0438\u0435 \u0432 \u043C\u0435\u0442\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572791
    m_Localized: "\u041C\u0435\u0442\u0435\u043B\u044C \u0443\u0434\u0430\u0440\u0438\u043B\u0430
      \u0441 \u0443\u0442\u0440\u0430 \u2014 \u0432\u0435\u0442\u0435\u0440 \u043D\u0435\u0441\u0451\u0442
      \u0441\u043D\u0435\u0433 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u043E,
      \u0442\u0440\u043E\u043F\u0430 \u0438\u0441\u0447\u0435\u0437\u043B\u0430.
      \u0412\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u044C \u2014 \u043F\u044F\u0442\u044C
      \u0448\u0430\u0433\u043E\u0432. \u041C\u0443\u043B\u044B \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u0438\u0434\u0442\u0438, \u0438 \u043E\u043D\u0438 \u043F\u0440\u0430\u0432\u044B.
      \u041C\u043E\u0436\u043D\u043E \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C
      \u0437\u0430 \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u043C \u0432\u044B\u0441\u0442\u0443\u043F\u043E\u043C,
      \u043D\u043E \u0437\u0430\u043F\u0430\u0441\u044B \u043D\u0435 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u044B,
      \u0438 \u0443 \u043B\u044E\u0434\u0435\u0439 \u0443\u0436\u0435 \u0435\u0441\u0442\u044C
      \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u0432 \u0433\u043B\u0430\u0437\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572792
    m_Localized: "\u0423\u043A\u0440\u044B\u0442\u044C\u0441\u044F \u0438 \u0436\u0434\u0430\u0442\u044C
      \u043A\u043E\u043D\u0446\u0430 \u0431\u0443\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572793
    m_Localized: "\u0428\u0430\u0442\u0440\u044B \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u0432\u043F\u043B\u043E\u0442\u043D\u0443\u044E \u043A \u0441\u043A\u0430\u043B\u0435.
      \u041F\u0440\u043E\u0448\u043B\u043E \u043F\u043E\u0447\u0442\u0438 \u043F\u043E\u043B\u0442\u043E\u0440\u0430
      \u0434\u043D\u044F. \u0411\u0443\u0440\u044F \u0443\u0442\u0438\u0445\u043B\u0430
      \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443 \u0443\u0442\u0440\u0443.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0434\u0435\u043D\u044C,
      \u0437\u0430\u0442\u043E \u0432\u0441\u0435 \u0436\u0438\u0432\u044B \u0438
      \u0433\u0440\u0443\u0437 \u0446\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572794
    m_Localized: "\u041F\u043E\u0441\u043B\u0430\u0442\u044C \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u0430
      \u0438\u0441\u043A\u0430\u0442\u044C \u0443\u043A\u0440\u044B\u0442\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572795
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A \u0443\u0448\u0451\u043B
      \u0432 \u043C\u0435\u0442\u0435\u043B\u044C \u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441: \u0432 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u0438
      \u043B\u0438 \u2014 \u0437\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u0430\u044F
      \u0447\u0430\u0431\u0430\u043D\u0441\u043A\u0430\u044F \u0445\u0438\u0436\u0438\u043D\u0430.
      \u0412\u0435\u0441\u044C \u043E\u0431\u043E\u0437 \u043F\u0435\u0440\u0435\u0431\u0440\u0430\u043B\u0441\u044F
      \u0442\u0443\u0434\u0430. \u041D\u043E\u0447\u0435\u0432\u0430\u043B\u0438
      \u043F\u043E\u0434 \u043A\u0440\u044B\u0448\u0435\u0439 \u2014 \u043D\u0435\u0432\u0435\u0440\u043E\u044F\u0442\u043D\u0430\u044F
      \u0443\u0434\u0430\u0447\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572796
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A \u0437\u0430\u0431\u043B\u0443\u0434\u0438\u043B\u0441\u044F.
      \u0415\u0433\u043E \u043D\u0430\u0448\u043B\u0438 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430 \u0447\u0430\u0441\u0430 \u0432 \u0441\u043D\u0435\u0433\u0443,
      \u0436\u0438\u0432\u043E\u0433\u043E, \u043D\u043E \u043E\u0431\u043C\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u043E\u0433\u043E.
      \u0425\u0438\u0436\u0438\u043D\u044B \u043D\u0435\u0442. \u041B\u0430\u0433\u0435\u0440\u044C
      \u0441\u0438\u0434\u0438\u0442 \u0442\u0430\u043C \u0436\u0435, \u0442\u043E\u043B\u044C\u043A\u043E
      \u043B\u044E\u0434\u0438 \u043D\u0430\u043F\u0443\u0433\u0430\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572797
    m_Localized: "\u0414\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043F\u043E \u043F\u0430\u043C\u044F\u0442\u0438 \u0442\u0440\u043E\u043F\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572798
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0432\u0451\u043B
      \u043F\u043E \u043F\u0430\u043C\u044F\u0442\u0438, \u0449\u0443\u043F\u0430\u044F
      \u043A\u0430\u043C\u043D\u0438 \u043D\u043E\u0433\u043E\u0439. \u041F\u0440\u043E\u0448\u043B\u0438
      \u0442\u0440\u0438 \u043B\u0438 \u0437\u0430 \u0447\u0435\u0442\u044B\u0440\u0435
      \u0447\u0430\u0441\u0430. \u0412\u044B\u0448\u043B\u0438 \u0438\u0437 \u0437\u043E\u043D\u044B
      \u0431\u0443\u0440\u0438 \u043A \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0443
      \u2014 \u0442\u0430\u043C \u0432\u0435\u0442\u0435\u0440 \u0441\u0442\u0438\u0445.
      \u0420\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u043D\u043E, \u0437\u0430\u0442\u043E
      \u0432\u043F\u0435\u0440\u0451\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572799
    m_Localized: "\u0421\u043B\u043E\u043C\u0430\u043D\u043D\u0430\u044F \u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572800
    m_Localized: "\u0421\u043A\u0440\u0438\u043F \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u0432 \u0442\u0440\u0435\u0441\u043A \u2014 \u0438 \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043E\u0441\u0435\u0434\u0430\u0435\u0442 \u043D\u0430 \u043F\u0440\u0430\u0432\u044B\u0439
      \u0431\u043E\u043A. \u041E\u0441\u044C \u043F\u0435\u0440\u0435\u043B\u043E\u043C\u0438\u043B\u0430\u0441\u044C
      \u0443 \u0441\u0442\u0443\u043F\u0438\u0446\u044B: \u0434\u0440\u0435\u0432\u0435\u0441\u0438\u043D\u0430
      \u043F\u043E\u0434\u0433\u043D\u0438\u043B\u0430 \u0438\u0437\u043D\u0443\u0442\u0440\u0438,
      \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438 \u0432\u043E\u0432\u0440\u0435\u043C\u044F.
      \u0413\u0440\u0443\u0437 \u0441\u043F\u043E\u043B\u0437, \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u0448\u0430\u0440\u0430\u0445\u043D\u0443\u043B\u0441\u044F. \u041D\u0430
      \u0434\u043E\u0440\u043E\u0433\u0435 \u0437\u0430\u043F\u0430\u0441\u043D\u0430\u044F
      \u043E\u0441\u044C \u0435\u0441\u0442\u044C, \u043D\u043E \u043F\u043E\u0434\u0433\u043E\u043D\u043A\u0430
      \u0437\u0430\u0439\u043C\u0451\u0442 \u0432\u0440\u0435\u043C\u044F \u0438
      \u0445\u043E\u0440\u043E\u0448\u0438\u0435 \u0440\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572801
    m_Localized: "\u041F\u043E\u0447\u0438\u043D\u0438\u0442\u044C \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572802
    m_Localized: "\u041F\u043B\u043E\u0442\u043D\u0438\u043A \u043E\u0431\u043E\u0437\u0430
      \u043F\u0440\u043E\u0432\u043E\u0437\u0438\u043B\u0441\u044F \u0442\u0440\u0438
      \u0447\u0430\u0441\u0430. \u0420\u0443\u043A\u0438 \u0432 \u0441\u043C\u043E\u043B\u0435,
      \u043F\u043E\u0442 \u0433\u0440\u0430\u0434\u043E\u043C, \u043D\u043E \u043E\u0441\u044C
      \u0432\u0441\u0442\u0430\u043B\u0430. \u041F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0441\u043D\u043E\u0432\u0430 \u043D\u0430 \u0445\u043E\u0434\u0443. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043F\u043E\u043B\u0434\u043D\u044F, \u0437\u0430\u0442\u043E \u043D\u0435
      \u0431\u0440\u043E\u0441\u0438\u043B\u0438 \u0433\u0440\u0443\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572803
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u043A\u0443\u0437\u043D\u0435\u0446\u0430
      \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C \u0441\u0435\u043B\u0435\u043D\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572804
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0441 \u0438\u0437\u0432\u0435\u0441\u0442\u0438\u0435\u043C: \u043A\u0443\u0437\u043D\u0435\u0446
      \u0432 \u0434\u0432\u0443\u0445 \u043B\u0438, \u0443 \u0440\u0435\u043A\u0438.
      \u0422\u0443\u0434\u0430 \u043E\u0442\u0432\u0435\u043B\u0438 \u043F\u043E\u0432\u043E\u0437\u043A\u0443,
      \u043C\u0430\u0441\u0442\u0435\u0440 \u043E\u0431\u0448\u0438\u043B \u043E\u0441\u044C
      \u0436\u0435\u043B\u0435\u0437\u043D\u044B\u043C\u0438 \u043F\u043E\u043B\u043E\u0441\u0430\u043C\u0438.
      \u041A\u0440\u0435\u043F\u0447\u0435 \u043F\u0440\u0435\u0436\u043D\u0435\u0433\u043E.
      \u0417\u0430\u043D\u044F\u043B\u043E \u0434\u0435\u043D\u044C \u0438 \u0441\u0442\u043E\u0438\u043B\u043E
      \u043C\u043E\u043D\u0435\u0442\u0443, \u043D\u043E \u0441\u0434\u0435\u043B\u0430\u043D\u043E
      \u043D\u0430 \u0441\u043E\u0432\u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572805
    m_Localized: "\u041A\u0443\u0437\u043D\u0435\u0446\u0430 \u0434\u043E\u043C\u0430
      \u043D\u0435 \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u2014
      \u0443\u0448\u0451\u043B \u043D\u0430 \u044F\u0440\u043C\u0430\u0440\u043A\u0443.
      \u0412\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u043D\u0438 \u0441
      \u0447\u0435\u043C, \u0447\u0438\u043D\u0438\u043B\u0438 \u0441\u0430\u043C\u0438.
      \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0435\u0445\u0430\u043B\u0430, \u043D\u043E \u043D\u0435\u043D\u0430\u0434\u0451\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572806
    m_Localized: "\u041F\u0435\u0440\u0435\u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
      \u0433\u0440\u0443\u0437 \u043C\u0435\u0436\u0434\u0443 \u0432\u044C\u044E\u0447\u043D\u044B\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572807
    m_Localized: "\u041F\u043E\u0432\u043E\u0437\u043A\u0443 \u0431\u0440\u043E\u0441\u0438\u043B\u0438
      \u2014 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u043E\u043B\u0433\u043E
      \u0447\u0438\u043D\u0438\u0442\u044C. \u0413\u0440\u0443\u0437 \u0440\u0430\u0441\u043A\u0438\u0434\u0430\u043B\u0438
      \u043F\u043E \u0432\u044C\u044E\u043A\u0430\u043C. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043D\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u044B \u0441\u0438\u043B\u044C\u043D\u0435\u0435,
      \u043D\u043E \u0438\u0434\u0443\u0442. \u041F\u043E\u0432\u043E\u0437\u043A\u0443
      \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0443 \u0434\u0435\u0440\u0435\u0432\u0430
      \u2014 \u043C\u043E\u0436\u0435\u0442, \u043A\u0442\u043E \u043D\u0430\u0439\u0434\u0451\u0442
      \u0438 \u043F\u043E\u0447\u0438\u043D\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572808
    m_Localized: "\u041F\u043E\u0440\u0432\u0430\u043D\u043D\u0430\u044F \u0443\u043F\u0440\u044F\u0436\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572809
    m_Localized: "\u041A\u043E\u0436\u0430\u043D\u044B\u0439 \u043D\u0430\u0433\u0440\u0443\u0434\u043D\u0438\u043A
      \u0442\u0440\u0435\u0441\u043D\u0443\u043B \u043F\u043E \u0448\u0432\u0443
      \u2014 \u0443 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0433\u043E \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430
      \u0443\u043F\u0440\u044F\u0436\u044C \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043D\u0430 \u0434\u0432\u0443\u0445 \u0440\u0435\u043C\u043D\u044F\u0445
      \u0432\u043C\u0435\u0441\u0442\u043E \u0448\u0435\u0441\u0442\u0438. \u0415\u0449\u0451
      \u0447\u0430\u0441 \u0445\u043E\u0434\u0430, \u0438 \u043E\u043D\u0430 \u043E\u0442\u0432\u0430\u043B\u0438\u0442\u0441\u044F
      \u0441\u043E\u0432\u0441\u0435\u043C. \u041A\u043E\u0436\u0430 \u0441\u0442\u0430\u0440\u0430\u044F,
      \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u0448\u0430\u044F \u2014 \u0432
      \u0441\u0442\u0435\u043F\u0438 \u043D\u0435\u0442 \u043D\u0438 \u0442\u0435\u043D\u0438.
      \u0428\u043E\u0440\u043D\u0438\u043A \u043D\u0443\u0436\u0435\u043D, \u0438\u043B\u0438
      \u0445\u043E\u0442\u044F \u0431\u044B \u0437\u0430\u043F\u0430\u0441\u043D\u0430\u044F
      \u043A\u043E\u0436\u0430 \u0438 \u0448\u0438\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572810
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0438 \u0437\u0430\u0448\u0438\u0442\u044C \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572811
    m_Localized: "\u0428\u043E\u0440\u043D\u0438\u043A \u0441\u0435\u043B \u043F\u0440\u044F\u043C\u043E
      \u043D\u0430 \u0442\u0440\u0430\u0432\u0435. \u0421\u043E\u0440\u043E\u043A
      \u043C\u0438\u043D\u0443\u0442 \u0440\u0430\u0431\u043E\u0442\u044B: \u0434\u0440\u0430\u0442\u0432\u0430,
      \u0448\u0438\u043B\u043E, \u043F\u0430\u043B\u044C\u0446\u044B \u0432 \u0443\u043A\u043E\u043B\u0430\u0445.
      \u0423\u043F\u0440\u044F\u0436\u044C \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0442
      \u0434\u043E \u0433\u043E\u0440\u043E\u0434\u0430. \u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430 \u2014 \u043D\u0435
      \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572812
    m_Localized: "\u041F\u0443\u0441\u0442\u0438\u0442\u044C \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430
      \u0431\u0435\u0437 \u043D\u0430\u0433\u0440\u0443\u0434\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572813
    m_Localized: "\u041E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u043B\u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430
      \u043E\u0442 \u043F\u043E\u0440\u0432\u0430\u043D\u043D\u043E\u0439 \u0443\u043F\u0440\u044F\u0436\u0438,
      \u043F\u0435\u0440\u0435\u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B\u0438
      \u0432\u044C\u044E\u043A\u0438 \u043D\u0430 \u0434\u0440\u0443\u0433\u0438\u0445.
      \u0416\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u0448\u043B\u043E \u043D\u0430\u043B\u0435\u0433\u043A\u0435,
      \u043F\u043E\u0447\u0438\u043D\u0438\u043B\u0438 \u0432 \u043B\u0430\u0433\u0435\u0440\u0435
      \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u044F\u0441\u044C.
      \u041C\u0435\u043D\u044C\u0448\u0435 \u0441\u0443\u0435\u0442\u044B \u0432
      \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572814
    m_Localized: "\u0411\u0435\u0437 \u043D\u0430\u0433\u0440\u0443\u0434\u043D\u0438\u043A\u0430
      \u0432\u044C\u044E\u043A \u0441\u043F\u043E\u043B\u0437 \u043D\u0430\u0431\u043E\u043A
      \u043D\u0430 \u043F\u043E\u0434\u044A\u0451\u043C\u0435. \u0412\u0435\u0440\u0431\u043B\u044E\u0434
      \u0441\u043F\u043E\u0442\u043A\u043D\u0443\u043B\u0441\u044F, \u0447\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430 \u0443\u043F\u0430\u043B\u0430 \u0432 \u0433\u0440\u044F\u0437\u044C.
      \u041F\u043E\u0442\u0435\u0440\u0438 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435,
      \u043D\u043E \u043D\u0435\u043B\u043E\u0432\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572815
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0432\u0435\u0440\u0451\u0432\u043A\u0443 \u043A\u0430\u043A \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0443\u044E
      \u0437\u0430\u043C\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572816
    m_Localized: "\u0414\u0432\u0430 \u043A\u043E\u043D\u043E\u043F\u043B\u044F\u043D\u044B\u0445
      \u043A\u0430\u043D\u0430\u0442\u0430 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438
      \u0447\u0435\u0440\u0435\u0437 \u043A\u043E\u043B\u044C\u0446\u0430 \u0438
      \u0441\u0442\u044F\u043D\u0443\u043B\u0438 \u043A\u0440\u0435\u0441\u0442-\u043D\u0430\u043A\u0440\u0435\u0441\u0442.
      \u041D\u0435\u043A\u0440\u0430\u0441\u0438\u0432\u043E, \u043D\u043E \u0434\u0435\u0440\u0436\u0438\u0442.
      \u0414\u043E\u0448\u043B\u0438 \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0441\u0442\u043E\u044F\u043D\u043A\u0438, \u0442\u0430\u043C \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u044B\u0439 \u0440\u0435\u043C\u043E\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572817
    m_Localized: "\u041A\u043E\u043B\u0451\u0441\u043D\u0430\u044F \u0441\u043C\u0430\u0437\u043A\u0430
      \u043A\u043E\u043D\u0447\u0438\u043B\u0430\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572818
    m_Localized: "\u0421\u043A\u0440\u0438\u043F \u043A\u043E\u043B\u0451\u0441 \u0441\u043B\u044B\u0448\u0435\u043D
      \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430 \u2014 \u0441\u0442\u0443\u043F\u0438\u0446\u0430
      \u0442\u0440\u0451\u0442\u0441\u044F \u043E \u0434\u0435\u0440\u0435\u0432\u043E
      \u0431\u0435\u0437 \u0441\u043C\u0430\u0437\u043A\u0438. \u0414\u0435\u0433\u043E\u0442\u044C
      \u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F \u0442\u0440\u0438 \u0434\u043D\u044F
      \u043D\u0430\u0437\u0430\u0434, \u0430 \u043D\u043E\u0432\u044B\u0439 \u043A\u0443\u043F\u0438\u0442\u044C
      \u043D\u0435 \u0431\u044B\u043B\u043E \u0441\u043B\u0443\u0447\u0430\u044F.
      \u0415\u0441\u043B\u0438 \u043D\u0435 \u0441\u043C\u0430\u0437\u0430\u0442\u044C
      \u0441\u0435\u0439\u0447\u0430\u0441, \u0447\u0435\u0440\u0435\u0437 \u0434\u0435\u043D\u044C-\u0434\u0440\u0443\u0433\u043E\u0439
      \u043A\u043E\u043B\u0435\u0441\u043E \u0437\u0430\u043A\u043B\u0438\u043D\u0438\u0442
      \u043D\u0430\u043C\u0435\u0440\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572819
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0439 \u0436\u0438\u0440 \u0438\u0437
      \u0437\u0430\u043F\u0430\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572820
    m_Localized: "\u041A\u043E\u0442\u0435\u043B\u043E\u043A \u0441\u0442\u0430\u0440\u043E\u0433\u043E
      \u0431\u0430\u0440\u0430\u043D\u044C\u0435\u0433\u043E \u0436\u0438\u0440\u0430
      \u0440\u0430\u0441\u0442\u043E\u043F\u0438\u043B\u0438 \u0438 \u0437\u0430\u043B\u0438\u043B\u0438
      \u0432 \u0441\u0442\u0443\u043F\u0438\u0446\u044B. \u0421\u043A\u0440\u0438\u043F
      \u0443\u0442\u0438\u0445. \u0417\u0430\u043F\u0430\u0441 \u0436\u0438\u0440\u0430
      \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u043B\u0441\u044F, \u043D\u043E
      \u0434\u043E\u0440\u043E\u0433\u0430 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F.
      \u041C\u044F\u0441\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u043F\u0430\u0445\u0438\u0432\u0430\u0435\u0442,
      \u043D\u043E \u0432\u0441\u0451 \u0442\u0435\u0440\u043F\u0438\u043C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572821
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u0441\u043C\u043E\u043B\u0443 \u0438\u043B\u0438
      \u0434\u0435\u0433\u043E\u0442\u044C \u043F\u043E \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572822
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u0441 \u0433\u043E\u0440\u0448\u043A\u043E\u043C
      \u0434\u0451\u0433\u0442\u044F: \u043A\u0443\u043F\u0438\u043B \u0443 \u0432\u0441\u0442\u0440\u0435\u0447\u043D\u043E\u0433\u043E
      \u0433\u043E\u043D\u0446\u0430 \u0437\u0430 \u043C\u0435\u0434\u044C. \u0414\u043E\u0440\u043E\u0433\u043E
      \u0432\u044B\u0448\u043B\u043E, \u043D\u043E \u043A\u043E\u043B\u0451\u0441\u0430
      \u0441\u043C\u0430\u0437\u0430\u043D\u044B \u043A\u0430\u043A \u0441\u043B\u0435\u0434\u0443\u0435\u0442.
      \u042D\u043A\u043E\u043D\u043E\u043C\u0438\u044F \u043D\u0430 \u0440\u0435\u043C\u043E\u043D\u0442\u0435
      \u0441\u0442\u043E\u0438\u0442 \u0431\u043E\u043B\u044C\u0448\u0438\u0445 \u043F\u043E\u0442\u0435\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572823
    m_Localized: "\u0414\u0451\u0433\u0442\u044F \u043D\u0438\u0433\u0434\u0435 \u043D\u0435
      \u043D\u0430\u0448\u043B\u0438. \u0412\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u0441 \u043F\u0443\u0441\u0442\u044B\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438.
      \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u043E\u0434\u043D\u043E \u043A\u043E\u043B\u0435\u0441\u043E
      \u043D\u0430\u0447\u0430\u043B\u043E \u043B\u044E\u0444\u0442\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572824
    m_Localized: "\u0421\u043D\u044F\u0442\u044C \u043E\u0434\u043D\u0443 \u043F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0441 \u0445\u043E\u0434\u0430 \u0434\u043E \u043F\u043E\u0447\u0438\u043D\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572825
    m_Localized: "\u0413\u0440\u0443\u0437 \u0441 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043D\u043E\u0439
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043F\u0435\u0440\u0435\u043B\u043E\u0436\u0438\u043B\u0438
      \u043D\u0430 \u0434\u0440\u0443\u0433\u0438\u0445. \u041F\u043E\u0432\u043E\u0437\u043A\u0443
      \u043A\u0430\u0442\u0438\u043B\u0438 \u043D\u0430\u043B\u0435\u0433\u043A\u0435.
      \u041A \u043F\u043E\u043B\u0443\u0434\u043D\u044E \u043D\u0430\u0448\u043B\u0438
      \u0441\u0435\u043B\u0435\u043D\u0438\u0435 \u0441 \u043A\u0443\u0437\u043D\u0435\u0446\u043E\u043C
      \u2014 \u0442\u0430\u043C \u0441\u043C\u0430\u0437\u0430\u043B\u0438 \u0438
      \u0443\u043A\u0440\u0435\u043F\u0438\u043B\u0438 \u0441\u0442\u0443\u043F\u0438\u0446\u044B
      \u043A\u0430\u043A \u0441\u043B\u0435\u0434\u0443\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572826
    m_Localized: "\u0420\u0430\u0441\u0441\u043E\u0445\u0448\u0438\u0435\u0441\u044F
      \u0431\u043E\u0447\u043A\u0438 \u0441 \u0432\u043E\u0434\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572827
    m_Localized: "\u0416\u0430\u0440\u0430 \u0441\u0434\u0435\u043B\u0430\u043B\u0430
      \u0441\u0432\u043E\u0451 \u0434\u0435\u043B\u043E: \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0435
      \u043E\u0431\u0440\u0443\u0447\u0438 \u043D\u0430 \u0431\u043E\u0447\u043A\u0430\u0445
      \u043E\u0441\u043B\u0430\u0431\u043B\u0438, \u043A\u043B\u0451\u043F\u043A\u0438
      \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C. \u0418\u0437 \u043E\u0434\u043D\u043E\u0439
      \u0443\u0436\u0435 \u0441\u043E\u0447\u0438\u0442\u0441\u044F \u0432\u043E\u0434\u0430
      \u2014 \u0442\u043E\u043D\u043A\u0430\u044F \u0441\u0442\u0440\u0443\u0439\u043A\u0430
      \u0432 \u0440\u0430\u0441\u043A\u0430\u043B\u0451\u043D\u043D\u044B\u0439 \u043F\u0435\u0441\u043E\u043A.
      \u0412\u0442\u043E\u0440\u0430\u044F \u0432\u043E\u0442-\u0432\u043E\u0442
      \u0440\u0430\u0441\u0441\u044B\u043F\u043B\u0435\u0442\u0441\u044F. \u0411\u0435\u0437
      \u044D\u0442\u043E\u0439 \u0432\u043E\u0434\u044B \u2014 \u0434\u0432\u0430
      \u0434\u043D\u044F \u043F\u0443\u0442\u0438 \u0431\u0435\u0437 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572828
    m_Localized: "\u0421\u0440\u043E\u0447\u043D\u043E \u043F\u0435\u0440\u0435\u043B\u0438\u0442\u044C
      \u0432\u043E\u0434\u0443 \u0432 \u0431\u0443\u0440\u0434\u044E\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572829
    m_Localized: "\u0411\u0443\u0440\u0434\u044E\u043A\u0438 \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u043B\u0438
      \u0432\u0441\u0435 \u0434\u043E \u043E\u0442\u043A\u0430\u0437\u0430 \u2014
      \u0434\u0430\u0436\u0435 \u043A\u043E\u0442\u043B\u044B \u0434\u043B\u044F
      \u0432\u0430\u0440\u043A\u0438. \u0412\u043E\u0434\u044B \u0445\u0432\u0430\u0442\u0438\u0442
      \u0440\u043E\u0432\u043D\u043E \u043D\u0430 \u0434\u0432\u0430 \u0434\u043D\u044F.
      \u041F\u0443\u0441\u0442\u044B\u0435 \u0431\u043E\u0447\u043A\u0438 \u0431\u0440\u043E\u0441\u0438\u043B\u0438:
      \u043E\u043D\u0438 \u0441\u0442\u0430\u043B\u0438 \u0449\u0435\u043F\u043A\u0430\u043C\u0438.
      \u0412\u043E\u0434\u0430 \u0441\u043F\u0430\u0441\u0435\u043D\u0430, \u0442\u0430\u0440\u0430
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572830
    m_Localized: "\u0421\u0442\u044F\u043D\u0443\u0442\u044C \u043E\u0431\u0440\u0443\u0447\u0438
      \u0432\u0435\u0440\u0451\u0432\u043A\u043E\u0439 \u0438 \u043F\u043E\u0434\u043C\u043E\u0442\u0430\u0442\u044C
      \u0442\u043A\u0430\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572831
    m_Localized: "\u041F\u043B\u043E\u0442\u043D\u0438\u043A \u043D\u0430\u043C\u043E\u0447\u0438\u043B
      \u0442\u0440\u044F\u043F\u043A\u0438 \u0438 \u043F\u043B\u043E\u0442\u043D\u043E
      \u043E\u0431\u0435\u0440\u043D\u0443\u043B \u043A\u043B\u0451\u043F\u043A\u0438,
      \u043F\u043E\u0442\u043E\u043C \u0441\u0442\u044F\u043D\u0443\u043B \u0432\u0435\u0440\u0451\u0432\u043A\u043E\u0439.
      \u0421\u0430\u043C\u043E\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u0440\u0435\u043C\u043E\u043D\u0442.
      \u0414\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u043E\u0430\u0437\u0438\u0441\u0430
      \u0431\u043E\u0447\u043A\u0438 \u0434\u043E\u0442\u044F\u043D\u0443\u043B\u0438
      \u2014 \u0442\u0430\u043C \u0438\u0445 \u043F\u043E\u0447\u0438\u043D\u0438\u043B\u0438
      \u043A\u0430\u043A \u0441\u043B\u0435\u0434\u0443\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572832
    m_Localized: "\u0412\u0435\u0440\u0451\u0432\u043A\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043E\u0441\u043B\u0430\u0431\u043B\u0438 \u043D\u0430 \u0436\u0430\u0440\u0435
      \u043A \u043F\u043E\u043B\u0443\u0434\u043D\u044E. \u0411\u043E\u0447\u043A\u0430
      \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u0430\u0441\u044C
      \u2014 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0447\u0430\u0441\u0442\u044C
      \u0432\u043E\u0434\u044B \u043F\u0440\u0435\u0436\u0434\u0435, \u0447\u0435\u043C
      \u0443\u0441\u043F\u0435\u043B\u0438 \u043F\u0435\u0440\u0435\u043B\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572833
    m_Localized: "\u0412\u044B\u043B\u0438\u0442\u044C \u043B\u0438\u0448\u043D\u0435\u0435
      \u0438 \u0443\u043A\u0440\u0435\u043F\u0438\u0442\u044C \u043E\u0434\u043D\u0443
      \u0431\u043E\u0447\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572834
    m_Localized: "\u0412\u043E\u0434\u0443 \u0438\u0437 \u0445\u0443\u0436\u0435
      \u0431\u043E\u0447\u043A\u0438 \u0441\u043B\u0438\u043B\u0438 \u0432 \u043B\u0443\u0447\u0448\u0443\u044E,
      \u0434\u043E\u0431\u0430\u0432\u0438\u0432 \u043A\u043E\u0436\u0430\u043D\u044B\u0435
      \u043F\u0440\u043E\u043A\u043B\u0430\u0434\u043A\u0438 \u043F\u043E\u0434 \u043E\u0431\u0440\u0443\u0447\u0438.
      \u041E\u0434\u043D\u0430 \u0431\u043E\u0447\u043A\u0430 \u0432\u044B\u0436\u0438\u043B\u0430.
      \u0412\u043E\u0434\u044B \u0441\u0442\u0430\u043B\u043E \u043C\u0435\u043D\u044C\u0448\u0435,
      \u043D\u043E \u043E\u043D\u0430 \u0432 \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0439
      \u0442\u0430\u0440\u0435. \u0420\u0430\u0441\u0447\u0451\u0442 \u0441\u043E\u0448\u0451\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572835
    m_Localized: "\u041F\u0430\u0440\u0443\u0441\u0438\u043D\u0430 \u0448\u0430\u0442\u0440\u0430
      \u043F\u0440\u043E\u0433\u043E\u0440\u0435\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572836
    m_Localized: "\u0423\u0433\u043E\u043B\u0451\u043A \u0438\u0437 \u043A\u0430\u043B\u044C\u044F\u043D\u0430
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430 \u0443\u043F\u0430\u043B
      \u043D\u0430 \u0440\u0430\u0441\u0442\u044F\u043D\u0443\u0442\u0443\u044E \u043F\u0430\u0440\u0443\u0441\u0438\u043D\u0443
      \u2014 \u0434\u044B\u0440\u0430 \u0441 \u043B\u0430\u0434\u043E\u043D\u044C.
      \u041D\u043E\u0447\u044C\u044E \u0441\u043A\u0432\u043E\u0437\u044C \u043D\u0435\u0451
      \u0431\u0443\u0434\u0435\u0442 \u0434\u0443\u0442\u044C \u0432\u0435\u0442\u0435\u0440
      \u0441 \u043F\u0435\u0441\u043A\u043E\u043C, \u0430 \u0435\u0441\u043B\u0438
      \u043F\u043E\u0439\u0434\u0451\u0442 \u0440\u0435\u0434\u043A\u0438\u0439 \u0437\u0434\u0435\u0441\u044C
      \u0434\u043E\u0436\u0434\u044C \u2014 \u0432\u0441\u0451 \u043D\u0430\u043C\u043E\u043A\u043D\u0435\u0442.
      \u041F\u0430\u0440\u0443\u0441\u0438\u043D\u0430 \u0441\u0442\u0430\u0440\u0430\u044F:
      \u043B\u0438\u0448\u043D\u0438\u0439 \u0440\u0430\u0437 \u043D\u0435 \u0437\u0430\u0448\u044C\u0451\u0448\u044C
      \u2014 \u0440\u0430\u0441\u043F\u043E\u043B\u0437\u0451\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572837
    m_Localized: "\u0410\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u0437\u0430\u0448\u0438\u0442\u044C
      \u043A\u043E\u0436\u0430\u043D\u043E\u0439 \u0437\u0430\u043F\u043B\u0430\u0442\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572838
    m_Localized: "\u0421\u0435\u0434\u0435\u043B\u044C\u0449\u0438\u043A \u0440\u0430\u0431\u043E\u0442\u0430\u043B
      \u043F\u0440\u0438 \u0441\u0432\u0435\u0442\u0435 \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0433\u043E
      \u0441\u0432\u0435\u0442\u0438\u043B\u044C\u043D\u0438\u043A\u0430. \u0417\u0430\u043F\u043B\u0430\u0442\u0430
      \u043B\u0435\u0433\u043B\u0430 \u0440\u043E\u0432\u043D\u043E, \u0441\u0442\u0435\u0436\u043A\u0438
      \u043C\u0435\u043B\u043A\u0438\u0435 \u0438 \u0442\u0443\u0433\u0438\u0435.
      \u041F\u0430\u0440\u0443\u0441\u0438\u043D\u0430 \u0432\u044B\u0434\u0435\u0440\u0436\u0438\u0442
      \u0435\u0449\u0451 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0434\u0435\u043B\u044C.
      \u0425\u043E\u0440\u043E\u0448\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430
      \u0432 \u043F\u043B\u043E\u0445\u0438\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572839
    m_Localized: "\u0417\u0430\u043B\u0438\u0442\u044C \u0434\u044B\u0440\u0443 \u0441\u043C\u043E\u043B\u043E\u0439
      \u0438\u0437 \u0437\u0430\u043F\u0430\u0441\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572840
    m_Localized: "\u0413\u043E\u0440\u044F\u0447\u0430\u044F \u0441\u043C\u043E\u043B\u0430
      \u043B\u0435\u0433\u043B\u0430 \u0431\u044B\u0441\u0442\u0440\u043E. \u0417\u0430\u043F\u0430\u0445
      \u0440\u0435\u0437\u043A\u0438\u0439, \u043D\u043E \u0434\u044B\u0440\u044B
      \u043D\u0435\u0442. \u041F\u0430\u0440\u0443\u0441\u0438\u043D\u0430 \u0441\u0442\u0430\u043B\u0430
      \u0436\u0451\u0441\u0442\u043A\u043E\u0439 \u0432 \u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435,
      \u0437\u0430\u0442\u043E \u0432\u043E\u0434\u0430 \u043D\u0435 \u043F\u0440\u043E\u0439\u0434\u0451\u0442.
      \u0417\u0430\u043F\u0430\u0441 \u0441\u043C\u043E\u043B\u044B \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572841
    m_Localized: "\u0421\u043C\u043E\u043B\u0430 \u0435\u0449\u0451 \u0433\u043E\u0440\u044F\u0447\u0435\u0439
      \u043F\u043E\u0442\u0435\u043A\u043B\u0430 \u043F\u043E \u043A\u0440\u0430\u044F\u043C
      \u0434\u044B\u0440\u044B \u0438 \u043F\u0440\u043E\u0436\u0433\u043B\u0430
      \u043D\u043E\u0432\u044B\u0435 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435
      \u0434\u044B\u0440\u043E\u0447\u043A\u0438. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0438\u0445 \u0442\u0440\u0438 \u0432\u043C\u0435\u0441\u0442\u043E \u043E\u0434\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572842
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u0442\u044C \u043F\u0430\u0440\u0443\u0441\u0438\u043D\u0443
      \u043F\u043E\u0434 \u0434\u0440\u0443\u0433\u0438\u043C \u0443\u0433\u043B\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572843
    m_Localized: "\u0414\u044B\u0440\u0443 \u0441\u043C\u0435\u0441\u0442\u0438\u043B\u0438
      \u043A \u043A\u043E\u043D\u044C\u043A\u0443 \u2014 \u0442\u0430\u043C \u043E\u043D\u0430
      \u043C\u0435\u043D\u044C\u0448\u0435 \u043F\u0440\u043E\u0434\u0443\u0432\u0430\u0435\u0442\u0441\u044F.
      \u0412\u0435\u0440\u0451\u0432\u043A\u0438 \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043B\u0438.
      \u041D\u0435\u043A\u0440\u0430\u0441\u0438\u0432\u043E, \u0437\u0430\u0442\u043E
      \u0431\u044B\u0441\u0442\u0440\u043E. \u041D\u043E\u0447\u044C \u043F\u0440\u043E\u0448\u043B\u0430
      \u0441\u043D\u043E\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572844
    m_Localized: "\u041F\u0435\u0441\u043E\u043A \u0432 \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u0430\u0445
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572845
    m_Localized: "\u0421\u043A\u0440\u0438\u043F \u043A\u043E\u043B\u0435\u0441\u0430
      \u0441\u043C\u0435\u043D\u0438\u043B\u0441\u044F \u0445\u0440\u0443\u0441\u0442\u043E\u043C
      \u2014 \u0432 \u0441\u0442\u0443\u043F\u0438\u0446\u0443 \u043D\u0430\u0431\u0438\u043B\u0441\u044F
      \u043C\u0435\u043B\u043A\u0438\u0439 \u043F\u0435\u0441\u043E\u043A \u043F\u0443\u0441\u0442\u044B\u043D\u0438
      \u0422\u0430\u043A\u043B\u0430-\u041C\u0430\u043A\u0430\u043D, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0440\u0435\u0436\u0435\u0442 \u0434\u0435\u0440\u0435\u0432\u043E \u043A\u0430\u043A
      \u043D\u0430\u0436\u0434\u0430\u043A. \u041E\u0441\u044C \u0433\u0440\u0435\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0445\u043E\u0434\u0443. \u0415\u0441\u043B\u0438 \u043D\u0435
      \u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u043E,
      \u043A \u043A\u043E\u043D\u0446\u0443 \u043D\u0435\u0434\u0435\u043B\u0438
      \u043A\u043E\u043B\u0435\u0441\u043E \u0437\u0430\u043A\u043B\u0438\u043D\u0438\u0442
      \u043D\u0430\u0441\u043E\u0432\u0441\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572846
    m_Localized: "\u0412\u044B\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0432\u0441\u0435
      \u0441\u0442\u0443\u043F\u0438\u0446\u044B \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572847
    m_Localized: "\u0414\u0432\u0443\u0445 \u0447\u0430\u0441\u043E\u0432 \u0440\u0430\u0431\u043E\u0442\u044B
      \u0445\u0432\u0430\u0442\u0438\u043B\u043E \u043D\u0430 \u0432\u0441\u0435
      \u0447\u0435\u0442\u044B\u0440\u0435 \u043A\u043E\u043B\u0435\u0441\u0430.
      \u0422\u0440\u044F\u043F\u043A\u0438 \u043F\u043E\u0447\u0435\u0440\u043D\u0435\u043B\u0438
      \u043E\u0442 \u0441\u043C\u0435\u0441\u0438 \u043F\u0435\u0441\u043A\u0430
      \u0438 \u0434\u0451\u0433\u0442\u044F. \u0417\u0430\u0442\u043E \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043F\u043E\u0448\u043B\u0430 \u043F\u043B\u0430\u0432\u043D\u043E, \u0431\u0435\u0437
      \u0445\u0440\u0443\u0441\u0442\u0430. \u041F\u0440\u043E\u0444\u0438\u043B\u0430\u043A\u0442\u0438\u043A\u0430
      \u0434\u0435\u0448\u0435\u0432\u043B\u0435 \u0440\u0435\u043C\u043E\u043D\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572848
    m_Localized: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0432\u043E\u0439\u043B\u043E\u0447\u043D\u044B\u0435
      \u0443\u043F\u043B\u043E\u0442\u043D\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572849
    m_Localized: "\u041F\u043B\u043E\u0442\u043D\u0438\u043A \u0432\u044B\u0440\u0435\u0437\u0430\u043B
      \u043A\u043E\u043B\u044C\u0446\u0430 \u0438\u0437 \u0432\u043E\u0439\u043B\u043E\u043A\u0430
      \u0438 \u043D\u0430\u0431\u0438\u043B \u0438\u0445 \u0432 \u0437\u0430\u0437\u043E\u0440\u044B
      \u0441\u0442\u0443\u043F\u0438\u0446. \u0425\u0438\u0442\u0440\u043E\u0441\u0442\u044C
      \u043F\u0440\u043E\u0441\u0442\u0430\u044F, \u043D\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u0435\u043D\u043D\u0430\u044F.
      \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u0442\u0440\u0438 \u0434\u043D\u044F
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u0448\u043B\u0430 \u0431\u0435\u0437
      \u0441\u043A\u0440\u0438\u043F\u0430. \u0412\u043E\u0439\u043B\u043E\u043A
      \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C \u0441\u043E\u0442\u0440\u0451\u0442\u0441\u044F,
      \u043D\u043E \u0441\u0435\u0439\u0447\u0430\u0441 \u2014 \u043F\u043E\u0440\u044F\u0434\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572850
    m_Localized: "\u0412\u043E\u0439\u043B\u043E\u043A \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0433\u0440\u0443\u0431\u044B\u043C
      \u2014 \u0432\u043C\u0435\u0441\u0442\u043E \u0443\u043F\u043B\u043E\u0442\u043D\u0435\u043D\u0438\u044F
      \u043E\u043D \u0435\u0449\u0451 \u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043B
      \u043F\u0435\u0441\u043E\u043A \u0432\u043D\u0443\u0442\u0440\u0438. \u0425\u0440\u0443\u0441\u0442
      \u0443\u0441\u0438\u043B\u0438\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572851
    m_Localized: "\u0417\u0430\u043C\u0435\u0434\u043B\u0438\u0442\u044C \u0442\u0435\u043C\u043F
      \u0438 \u0447\u0438\u0441\u0442\u0438\u0442\u044C \u043A\u0430\u0436\u0434\u044B\u0439
      \u0432\u0435\u0447\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572852
    m_Localized: "\u0412\u044B \u0432\u0432\u0435\u043B\u0438 \u043F\u0440\u0430\u0432\u0438\u043B\u043E:
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0432\u0435\u0447\u0435\u0440 \u2014
      \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0441\u0442\u0443\u043F\u0438\u0446.
      \u0422\u0435\u043C\u043F \u0443\u043F\u0430\u043B \u043D\u0435\u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0437\u0430\u0442\u043E \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u0434\u043E\u0448\u043B\u0430
      \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0433\u043E\u0440\u043E\u0434\u0430
      \u0431\u0435\u0437 \u043F\u043E\u043B\u043E\u043C\u043A\u0438. \u0414\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0430
      \u0432\u0430\u0436\u043D\u0435\u0435 \u0441\u043F\u0435\u0448\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572853
    m_Localized: "\u041F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u0430\u044F \u043F\u043E\u0434\u043A\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572854
    m_Localized: "\u041D\u0430 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0439 \u0442\u0440\u043E\u043F\u0435
      \u043E\u0434\u043D\u0430 \u0438\u0437 \u043B\u043E\u0448\u0430\u0434\u0435\u0439
      \u043D\u0430\u0447\u0430\u043B\u0430 \u0445\u0440\u043E\u043C\u0430\u0442\u044C.
      \u041A\u0443\u0437\u043D\u0435\u0446 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u043A\u043E\u043F\u044B\u0442\u043E: \u043F\u043E\u0434\u043A\u043E\u0432\u0430
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u0430, \u043A\u043E\u043F\u044B\u0442\u043E
      \u0443\u0436\u0435 \u0441\u0442\u0451\u0441\u0430\u043D\u043E \u043E \u043A\u0430\u043C\u043D\u0438.
      \u0417\u0430\u043F\u0430\u0441\u043D\u044B\u0445 \u043F\u043E\u0434\u043A\u043E\u0432
      \u043D\u0435\u0442 \u2014 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043F\u0440\u0438 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0435.
      \u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u0435\u0449\u0451 \u0442\u0440\u0438
      \u0434\u043D\u044F \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572855
    m_Localized: "\u041E\u0431\u043C\u043E\u0442\u0430\u0442\u044C \u043A\u043E\u043F\u044B\u0442\u043E
      \u043A\u043E\u0436\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572856
    m_Localized: "\u041A\u0443\u0441\u043E\u043A \u0437\u0430\u0434\u0443\u0431\u0435\u043B\u043E\u0439
      \u0432\u043E\u043B\u043E\u0432\u044C\u0435\u0439 \u043A\u043E\u0436\u0438 \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0438
      \u0432\u043E\u043A\u0440\u0443\u0433 \u043A\u043E\u043F\u044B\u0442\u0430 \u0438
      \u0437\u0430\u043A\u0440\u0435\u043F\u0438\u043B\u0438 \u0431\u0435\u0447\u0435\u0432\u043E\u0439.
      \u0412\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439 \u0431\u0430\u0448\u043C\u0430\u043A.
      \u041B\u043E\u0448\u0430\u0434\u044C \u0432\u0441\u0451 \u0435\u0449\u0451
      \u043F\u0440\u0438\u0445\u0440\u0430\u043C\u044B\u0432\u0430\u0435\u0442, \u043D\u043E
      \u0438\u0434\u0451\u0442. \u0417\u0430\u043C\u0435\u043D\u0443 \u043C\u0435\u043D\u044F\u044E\u0442
      \u0440\u0430\u0437 \u0432 \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572857
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u043A\u0443\u0437\u043D\u0435\u0446\u0430
      \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0435 \u0432\u043F\u0435\u0440\u0435\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572858
    m_Localized: "\u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0432 \u0434\u043D\u0435 \u043F\u0443\u0442\u0438. \u0422\u0430\u043C \u0431\u044B\u043B
      \u043C\u0430\u0441\u0442\u0435\u0440 \u2014 \u043C\u043E\u043D\u0430\u0445,
      \u0437\u043D\u0430\u0432\u0448\u0438\u0439 \u043A\u0443\u0437\u043D\u0435\u0447\u043D\u043E\u0435
      \u0434\u0435\u043B\u043E. \u041F\u043E\u0434\u043A\u043E\u0432\u0443 \u0432\u044B\u043A\u043E\u0432\u0430\u043B\u0438
      \u0438\u0437 \u043E\u0441\u0442\u0430\u0442\u043A\u043E\u0432 \u0436\u0435\u043B\u0435\u0437\u0430.
      \u041B\u043E\u0448\u0430\u0434\u044C \u0441\u043D\u043E\u0432\u0430 \u0432
      \u0441\u0442\u0440\u043E\u044E. \u041C\u043E\u043D\u0430\u0445\u0443 \u043E\u0442\u0434\u0430\u043B\u0438
      \u0441\u0432\u0435\u0447\u0438 \u0432 \u0434\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572859
    m_Localized: "\u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0437\u0430\u0431\u0440\u043E\u0448\u0435\u043D. \u041F\u0443\u0441\u0442\u044B\u0435
      \u043A\u0435\u043B\u044C\u0438, \u043F\u043E\u043A\u043E\u0441\u0438\u0432\u0448\u0438\u0435\u0441\u044F
      \u0432\u043E\u0440\u043E\u0442\u0430. \u041A\u0443\u0437\u043D\u0435\u0446\u0430
      \u043D\u0435\u0442. \u0412\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u043A \u043A\u043E\u0436\u0435 \u0438 \u0431\u0435\u0447\u0435\u0432\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572860
    m_Localized: "\u041F\u0443\u0441\u0442\u0438\u0442\u044C \u043B\u043E\u0448\u0430\u0434\u044C
      \u0432 \u0430\u0440\u044C\u0435\u0440\u0433\u0430\u0440\u0434 \u043D\u0430\u043B\u0435\u0433\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572861
    m_Localized: "\u0413\u0440\u0443\u0437 \u0441 \u043B\u043E\u0448\u0430\u0434\u0438
      \u043F\u0435\u0440\u0435\u043B\u043E\u0436\u0438\u043B\u0438 \u043D\u0430 \u043C\u0443\u043B\u043E\u0432.
      \u0411\u0435\u0437 \u0432\u044C\u044E\u043A\u0430 \u043E\u043D\u0430 \u0448\u043B\u0430
      \u043B\u0435\u0433\u0447\u0435 \u0438 \u043D\u0435 \u043E\u0442\u0441\u0442\u0430\u0432\u0430\u043B\u0430.
      \u041A \u0433\u043E\u0440\u043E\u0434\u0443 \u0434\u043E\u0448\u043B\u0430
      \u0441\u0430\u043C\u0430 \u2014 \u0442\u0430\u043C \u0435\u0451 \u043F\u043E\u0434\u043A\u043E\u0432\u0430\u043B
      \u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u043A\u0443\u0437\u043D\u0435\u0446."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572862
    m_Localized: "\u0413\u043D\u0438\u043B\u044B\u0435 \u0432\u0435\u0440\u0451\u0432\u043A\u0438
      \u0432\u044C\u044E\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572863
    m_Localized: "\u0412\u043B\u0430\u0433\u0430 \u0433\u043E\u0440\u043D\u044B\u0445
      \u0443\u0449\u0435\u043B\u0438\u0439 \u0441\u0434\u0435\u043B\u0430\u043B\u0430
      \u0441\u0432\u043E\u0451: \u0432\u0435\u0440\u0451\u0432\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438
      \u0441\u0442\u044F\u043D\u0443\u0442\u044B \u0442\u044E\u043A\u0438, \u043F\u043E\u0442\u0435\u043C\u043D\u0435\u043B\u0438
      \u0438 \u043D\u0430 \u043E\u0449\u0443\u043F\u044C \u0441\u043A\u043E\u043B\u044C\u0437\u043A\u0438\u0435.
      \u041E\u0434\u043D\u0430 \u0443\u0436\u0435 \u043B\u043E\u043F\u043D\u0443\u043B\u0430
      \u2014 \u0442\u044E\u043A \u0435\u0434\u0432\u0430 \u043D\u0435 \u0443\u043B\u0435\u0442\u0435\u043B
      \u0432 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u043D\u0435 \u043B\u0443\u0447\u0448\u0435. \u0413\u043E\u0440\u043D\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0435\u0449\u0451 \u0434\u043D\u044F
      \u0434\u0432\u0430, \u0438 \u043F\u043E\u0434 \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u043E\u0439
      \u043D\u0430 \u043F\u043E\u0434\u044A\u0451\u043C\u0430\u0445 \u043E\u043D\u0438
      \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572864
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u0442\u044C \u0432\u0441\u0435
      \u0442\u044E\u043A\u0438 \u043D\u043E\u0432\u044B\u043C\u0438 \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572865
    m_Localized: "\u0418\u0437 \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0433\u043E
      \u043C\u043E\u0442\u043A\u0430 \u043D\u0430\u0440\u0435\u0437\u0430\u043B\u0438
      \u043D\u043E\u0432\u044B\u0435 \u0432\u0435\u0440\u0451\u0432\u043A\u0438.
      \u0427\u0430\u0441 \u0440\u0430\u0431\u043E\u0442\u044B, \u0437\u0430\u0442\u043E
      \u0432\u0441\u0435 \u0442\u044E\u043A\u0438 \u0437\u0430\u0442\u044F\u043D\u0443\u0442\u044B
      \u043D\u0430\u0434\u0451\u0436\u043D\u043E. \u0413\u043E\u0440\u043D\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430 \u043F\u0440\u043E\u0448\u043B\u0430 \u0431\u0435\u0437
      \u043F\u0440\u043E\u0438\u0441\u0448\u0435\u0441\u0442\u0432\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572866
    m_Localized: "\u0423\u0441\u0438\u043B\u0438\u0442\u044C \u0441\u043B\u0430\u0431\u044B\u0435
      \u043C\u0435\u0441\u0442\u0430 \u043A\u043E\u043D\u043E\u043F\u043B\u044F\u043D\u043E\u0439
      \u0432\u0435\u0440\u0451\u0432\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572867
    m_Localized: "\u041F\u0440\u043E\u0448\u043B\u0438\u0441\u044C \u043F\u043E \u043A\u0430\u0436\u0434\u043E\u043C\u0443
      \u0442\u044E\u043A\u0443, \u043D\u0430\u0448\u043B\u0438 \u0441\u0430\u043C\u044B\u0435
      \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u043C\u0435\u0441\u0442\u0430 \u0438 \u0443\u0434\u0432\u043E\u0438\u043B\u0438
      \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u0435. \u0411\u044B\u0441\u0442\u0440\u0435\u0435,
      \u0447\u0435\u043C \u043F\u043E\u043B\u043D\u0430\u044F \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u043A\u0430.
      \u041E\u0434\u0438\u043D \u0442\u044E\u043A \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u043E\u0441\u043B\u0430\u0431 \u043D\u0430 \u0441\u043F\u0443\u0441\u043A\u0435
      \u2014 \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0438\u043B\u0438 \u0432\u043E\u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572868
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u0432\u0441\u0435 \u0441\u043B\u0430\u0431\u044B\u0435
      \u043C\u0435\u0441\u0442\u0430 \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u2014 \u0432\u0435\u0440\u0451\u0432\u043A\u0438 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u0438
      \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E. \u0414\u0432\u0430
      \u0442\u044E\u043A\u0430 \u0441\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0438
      \u043D\u0430 \u043A\u0440\u0443\u0442\u043E\u043C \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0435.
      \u0413\u0440\u0443\u0437 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0451\u043D
      \u0441\u043B\u0435\u0433\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572869
    m_Localized: "\u0423\u043C\u0435\u043D\u044C\u0448\u0438\u0442\u044C \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0443:
      \u0447\u0430\u0441\u0442\u044C \u0442\u044E\u043A\u043E\u0432 \u043D\u0430
      \u0440\u0443\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572870
    m_Localized: "\u0421\u0430\u043C\u044B\u0435 \u0442\u044F\u0436\u0451\u043B\u044B\u0435
      \u0442\u044E\u043A\u0438 \u043D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0438
      \u043D\u0435\u0441\u043B\u0438 \u043D\u0430 \u0440\u0443\u043A\u0430\u0445
      \u0447\u0435\u0440\u0435\u0437 \u043E\u0441\u043E\u0431\u043E \u043E\u043F\u0430\u0441\u043D\u044B\u0435
      \u0443\u0447\u0430\u0441\u0442\u043A\u0438. \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u043E,
      \u043D\u043E \u043D\u0430\u0434\u0451\u0436\u043D\u043E. \u041A \u043D\u043E\u0447\u0451\u0432\u043A\u0435
      \u2014 \u0432\u0441\u0435 \u0446\u0435\u043B\u044B, \u0432\u0435\u0440\u0451\u0432\u043A\u0438
      \u0437\u0430\u043C\u0435\u043D\u0438\u043B\u0438 \u0432 \u043B\u0430\u0433\u0435\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572871
    m_Localized: "\u0420\u0435\u043C\u043E\u043D\u0442 \u0432 \u0441\u043D\u0435\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572872
    m_Localized: "\u0421\u043D\u0435\u0433\u043E\u043F\u0430\u0434 \u043D\u0430\u0447\u0430\u043B\u0441\u044F
      \u0432 \u043F\u043E\u043B\u0434\u0435\u043D\u044C \u0438 \u043A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0437\u0430\u0432\u0430\u043B\u0438\u043B \u043B\u0430\u0433\u0435\u0440\u044C
      \u043F\u043E \u043A\u043E\u043B\u0435\u043D\u043E. \u041F\u043E\u0434 \u0442\u044F\u0436\u0435\u0441\u0442\u044C\u044E
      \u0441\u043D\u0435\u0433\u0430 \u043B\u043E\u043F\u043D\u0443\u043B\u0430 \u0436\u0435\u0440\u0434\u044C
      \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0448\u0430\u0442\u0440\u0430
      \u2014 \u043A\u0440\u043E\u0432 \u043F\u0440\u043E\u0432\u0438\u0441. \u0420\u0443\u043A\u0438
      \u0443 \u043F\u043B\u043E\u0442\u043D\u0438\u043A\u0430 \u043A\u043E\u0447\u0435\u043D\u0435\u044E\u0442
      \u0447\u0435\u0440\u0435\u0437 \u043C\u0438\u043D\u0443\u0442\u0443 \u0440\u0430\u0431\u043E\u0442\u044B
      \u043D\u0430 \u043C\u043E\u0440\u043E\u0437\u0435. \u041F\u043E\u0447\u0438\u043D\u0438\u0442\u044C
      \u043D\u0430\u0434\u043E \u0441\u0435\u0439\u0447\u0430\u0441, \u0438\u043D\u0430\u0447\u0435
      \u043A \u0443\u0442\u0440\u0443 \u0448\u0430\u0442\u0451\u0440 \u0441\u043B\u043E\u0436\u0438\u0442\u0441\u044F
      \u043E\u043A\u043E\u043D\u0447\u0430\u0442\u0435\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572873
    m_Localized: "\u0427\u0438\u043D\u0438\u0442\u044C \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u2014 \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u0433\u0440\u0435\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572874
    m_Localized: "\u041F\u043E \u0442\u0440\u043E\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u043B\u0438
      \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0436\u0434\u0430\u043B\u0438 \u0443 \u043E\u0433\u043D\u044F. \u041A\u0430\u0436\u0434\u044B\u0435
      \u043F\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442 \u2014 \u0441\u043C\u0435\u043D\u0430.
      \u0428\u0430\u0442\u0451\u0440 \u043F\u043E\u0447\u0438\u043D\u0438\u043B\u0438
      \u0437\u0430 \u0447\u0430\u0441. \u0420\u0443\u043A\u0438 \u0446\u0435\u043B\u044B,
      \u043A\u0440\u043E\u0432 \u0446\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572875
    m_Localized: "\u0423\u043A\u0440\u0435\u043F\u0438\u0442\u044C \u0448\u0435\u0441\u0442\u043E\u043C
      \u0438\u0437 \u043D\u0430\u0440\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572876
    m_Localized: "\u0418\u0437 \u0441\u0430\u043D\u0435\u0439 \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438
      \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0439 \u043F\u043E\u043B\u043E\u0437
      \u0438 \u043F\u043E\u0434\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u043F\u043E\u0434
      \u043F\u0440\u043E\u0432\u0438\u0441\u0448\u0438\u0439 \u043A\u0440\u043E\u0432.
      \u041D\u0435 \u043A\u0440\u0430\u0441\u0438\u0432\u043E, \u043D\u043E \u0434\u0435\u0440\u0436\u0438\u0442.
      \u0414\u043E \u0443\u0442\u0440\u0430 \u0434\u043E\u0442\u044F\u043D\u0443\u043B\u0438,
      \u0430 \u0441 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u043E\u043C \u043D\u0430\u0440\u0435\u0437\u0430\u043B\u0438
      \u043D\u043E\u0432\u0443\u044E \u0436\u0435\u0440\u0434\u044C \u0438\u0437
      \u0441\u0443\u0445\u043E\u0441\u0442\u043E\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572877
    m_Localized: "\u041F\u043E\u043B\u043E\u0437 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C \u2014 \u043D\u0435 \u0434\u043E\u0441\u0442\u0430\u043B
      \u0434\u043E \u043A\u043E\u043D\u044C\u043A\u0430. \u041F\u043E\u043A\u0430
      \u043F\u043E\u0434\u0431\u0438\u0440\u0430\u043B\u0438 \u0437\u0430\u043C\u0435\u043D\u0443,
      \u0441\u043D\u0435\u0433 \u043D\u0430\u0432\u0430\u043B\u0438\u043B \u0435\u0449\u0451.
      \u041F\u0440\u043E\u0432\u0438\u0441 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572878
    m_Localized: "\u041F\u0435\u0440\u0435\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0432 \u043E\u0434\u043D\u0443 \u043F\u0430\u043B\u0430\u0442\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572879
    m_Localized: "\u0412\u0441\u0435 \u043D\u0430\u0431\u0438\u043B\u0438\u0441\u044C
      \u0432 \u043C\u0435\u043D\u044C\u0448\u0438\u0439 \u0448\u0430\u0442\u0451\u0440.
      \u0422\u0435\u0441\u043D\u043E, \u043A\u0430\u043A \u0432 \u0431\u043E\u0447\u043A\u0435
      \u0441 \u0441\u0435\u043B\u044C\u0434\u044C\u044E, \u0437\u0430\u0442\u043E
      \u0442\u0435\u043F\u043B\u043E. \u0421\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u0439
      \u0448\u0430\u0442\u0451\u0440 \u043F\u043E\u0447\u0438\u043D\u0438\u043B\u0438
      \u0443\u0442\u0440\u043E\u043C \u043D\u0430 \u0441\u0432\u0435\u0436\u0443\u044E
      \u0433\u043E\u043B\u043E\u0432\u0443. \u041E\u0434\u043D\u0430 \u043D\u043E\u0447\u044C
      \u0442\u0435\u0441\u043D\u043E\u0442\u044B \u2014 \u043D\u0435 \u0431\u0435\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572880
    m_Localized: "\u0421\u043F\u043E\u0440 \u0438\u0437-\u0437\u0430 \u043C\u0435\u0441\u0442\u0430
      \u0443 \u043A\u043E\u0441\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572881
    m_Localized: "\u0414\u0432\u043E\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0443\u0436\u0435 \u0441\u0442\u043E\u044F\u0442 \u0434\u0440\u0443\u0433
      \u043F\u0440\u043E\u0442\u0438\u0432 \u0434\u0440\u0443\u0433\u0430 \u2014
      \u043A\u0443\u043B\u0430\u043A\u0438 \u0441\u0436\u0430\u0442\u044B, \u0433\u043E\u043B\u043E\u0441\u0430
      \u0433\u0440\u043E\u043C\u043A\u0438\u0435. \u041E\u0434\u0438\u043D \u0437\u0430\u043D\u044F\u043B
      \u043B\u0443\u0447\u0448\u0435\u0435 \u043C\u0435\u0441\u0442\u043E \u0443
      \u043A\u043E\u0441\u0442\u0440\u0430, \u0434\u0440\u0443\u0433\u043E\u0439
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u043E\u043D\u043E
      \u0435\u0433\u043E \u043F\u043E \u0443\u0433\u043E\u0432\u043E\u0440\u0443.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044E\u0442.
      \u0415\u0441\u043B\u0438 \u043D\u0435 \u0432\u043C\u0435\u0448\u0430\u0442\u044C\u0441\u044F
      \u2014 \u043A \u0443\u0442\u0440\u0443 \u0431\u0443\u0434\u0435\u0442 \u0441\u0438\u043D\u044F\u043A,
      \u0430 \u0442\u043E \u0438 \u0445\u0443\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572882
    m_Localized: "\u0420\u0430\u0441\u0441\u0443\u0434\u0438\u0442\u044C \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E
      \u043F\u0440\u0438 \u0432\u0441\u0435\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572883
    m_Localized: "\u0412\u044B \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B\u0438
      \u043E\u0431\u043E\u0438\u0445, \u043D\u0435 \u043F\u0435\u0440\u0435\u0431\u0438\u0432\u0430\u044F.
      \u0420\u0435\u0448\u0435\u043D\u0438\u0435 \u0432\u044B\u043D\u0435\u0441\u043B\u0438
      \u043F\u0440\u043E\u0441\u0442\u043E: \u043C\u0435\u0441\u0442\u0430 \u0443
      \u043A\u043E\u0441\u0442\u0440\u0430 \u0434\u0435\u043B\u0438\u0442\u044C \u043F\u043E\u0440\u043E\u0432\u043D\u0443,
      \u0441\u0442\u0430\u0440\u0448\u0438\u043D\u0441\u0442\u0432\u0430 \u043D\u0435\u0442.
      \u041E\u0431\u0430 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0438\u0441\u044C,
      \u0445\u043E\u0442\u044F \u0438 \u043D\u0435\u043E\u0445\u043E\u0442\u043D\u043E.
      \u041D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u0435 \u0441\u043F\u0430\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572884
    m_Localized: "\u0417\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043E\u0431\u043E\u0438\u0445
      \u043D\u0435\u0441\u0442\u0438 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
      \u0432\u0430\u0445\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572885
    m_Localized: "\xAB\u0425\u043E\u0442\u0438\u0442\u0435 \u0440\u0443\u0433\u0430\u0442\u044C\u0441\u044F
      \u2014 \u0440\u0443\u0433\u0430\u0439\u0442\u0435\u0441\u044C \u0443 \u0432\u043D\u0435\u0448\u043D\u0435\u0433\u043E
      \u043F\u0435\u0440\u0438\u043C\u0435\u0442\u0440\u0430, \u0441 \u043A\u043E\u043F\u044C\u0451\u043C
      \u0432 \u0440\u0443\u043A\u0430\u0445.\xBB \u041E\u0431\u0430 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438
      \u043F\u043E \u0442\u0440\u0438 \u0447\u0430\u0441\u0430 \u0434\u043E\u0437\u043E\u0440\u0430.
      \u041D\u0430\u0443\u0442\u0440\u043E \u043C\u0438\u0440\u0438\u043B\u0438\u0441\u044C
      \u043C\u043E\u043B\u0447\u0430, \u043D\u043E \u043A\u0440\u0435\u043F\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572886
    m_Localized: "\u041D\u0430\u043A\u0430\u0437\u0430\u043D\u0438\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u0443\u0440\u043E\u0432\u044B\u043C
      \u2014 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0437\u0430\u0448\u0435\u043F\u0442\u0430\u043B\u0438\u0441\u044C \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E.
      \u0414\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0430,
      \u043D\u043E \u0441\u0438\u043C\u043F\u0430\u0442\u0438\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572887
    m_Localized: "\u0418\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C:
      \u043F\u0443\u0441\u0442\u044C \u0441\u0430\u043C\u0438 \u0440\u0430\u0437\u0431\u0435\u0440\u0443\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572888
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u043E\u0434\u0438\u043D
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0440\u0430\u0437\u0431\u0438\u0442\u044B\u0439
      \u043D\u043E\u0441, \u0432\u0442\u043E\u0440\u043E\u0439 \u2014 \u0440\u0430\u0441\u0446\u0430\u0440\u0430\u043F\u0430\u043D\u043D\u0443\u044E
      \u0440\u0443\u043A\u0443. \u041E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F
      \u0438\u0441\u043F\u043E\u0440\u0447\u0435\u043D\u044B \u043D\u0430\u0434\u043E\u043B\u0433\u043E.
      \u041B\u0430\u0433\u0435\u0440\u044C \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u043B\u0441\u044F
      \u043D\u0430 \u0434\u0432\u0430 \u043B\u0430\u0433\u0435\u0440\u044F. \u041D\u0435\u0432\u043C\u0435\u0448\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u043E\u0431\u043E\u0448\u043B\u043E\u0441\u044C \u0434\u043E\u0440\u043E\u0436\u0435,
      \u0447\u0435\u043C \u0441\u043B\u043E\u0432\u043E \u0432\u043E\u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572889
    m_Localized: "\u0421\u043E\u043D\u043D\u044B\u0439 \u0447\u0430\u0441\u043E\u0432\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572890
    m_Localized: "\u041E\u0431\u0445\u043E\u0434\u044F \u043B\u0430\u0433\u0435\u0440\u044C
      \u043F\u0435\u0440\u0435\u0434 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u043E\u043C,
      \u0432\u044B \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435 \u0447\u0430\u0441\u043E\u0432\u043E\u0433\u043E
      \u2014 \u043E\u043D \u0441\u043F\u0438\u0442 \u0441\u0438\u0434\u044F, \u043A\u043E\u043F\u044C\u0451
      \u043F\u0440\u0438\u0441\u043B\u043E\u043D\u0435\u043D\u043E \u043A \u0431\u0435\u0434\u0440\u0443.
      \u0421\u0442\u0435\u043F\u044C \u0442\u0438\u0445\u0430, \u043D\u0438\u043A\u0430\u043A\u043E\u0439
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u043D\u0435 \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C.
      \u041D\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u043E \u0435\u0441\u0442\u044C
      \u043F\u0440\u0430\u0432\u0438\u043B\u043E: \u0443\u0441\u043D\u0443\u0442\u044C
      \u043D\u0430 \u043F\u043E\u0441\u0442\u0443 \u2014 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u044B\u0439
      \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u043E\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0432\u0438\u0434\u0435\u043B\u0438
      \u0438\u043B\u0438 \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0443\u0437\u043D\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572891
    m_Localized: "\u0420\u0430\u0437\u0431\u0443\u0434\u0438\u0442\u044C \u0438 \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u043E
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572892
    m_Localized: "\u0412\u044B \u043F\u043D\u0443\u043B\u0438 \u0435\u0433\u043E
      \u043D\u043E\u0433\u0443. \u041E\u043D \u0432\u0441\u043A\u043E\u0447\u0438\u043B,
      \u043B\u0438\u0446\u043E \u043A\u0440\u0430\u0441\u043D\u043E\u0435. \u041F\u0440\u0438
      \u0432\u0441\u0435\u0445 \u043E\u0431\u044A\u044F\u0432\u0438\u043B\u0438:
      \u0435\u0449\u0451 \u0440\u0430\u0437 \u2014 \u0438 \u0438\u0437 \u043E\u0445\u0440\u0430\u043D\u044B
      \u0443\u0432\u043E\u043B\u0435\u043D. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438 \u043D\u0435 \u0441\u043F\u0430\u043B\u0438
      \u043E\u0441\u0442\u0430\u0442\u043E\u043A \u043D\u043E\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572893
    m_Localized: "\u0422\u0438\u0445\u043E \u0440\u0430\u0437\u0431\u0443\u0434\u0438\u0442\u044C
      \u0438 \u043F\u0440\u043E\u0441\u0442\u0438\u0442\u044C \u043D\u0430 \u043F\u0435\u0440\u0432\u044B\u0439
      \u0440\u0430\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572894
    m_Localized: "\u0412\u044B \u0442\u0440\u043E\u043D\u0443\u043B\u0438 \u0435\u0433\u043E
      \u0437\u0430 \u043F\u043B\u0435\u0447\u043E, \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u044F
      \u043D\u0438 \u0441\u043B\u043E\u0432\u0430. \u041E\u043D \u043F\u043E\u043D\u044F\u043B.
      \u0414\u043E \u0443\u0442\u0440\u0430 \u043F\u0440\u043E\u0441\u0442\u043E\u044F\u043B
      \u043A\u0430\u043A \u0432\u043A\u043E\u043F\u0430\u043D\u043D\u044B\u0439,
      \u0431\u043B\u0435\u0434\u043D\u044B\u0439. \u041E\u0448\u0438\u0431\u043A\u0430
      \u0443\u0447\u0442\u0435\u043D\u0430, \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u043E
      \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572895
    m_Localized: "\u0421\u043B\u0443\u0445 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E
      \u0440\u0430\u0437\u043E\u0448\u0451\u043B\u0441\u044F \u043F\u043E \u043B\u0430\u0433\u0435\u0440\u044E.
      \u0414\u0440\u0443\u0433\u0438\u0435 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438
      \u0440\u0435\u0448\u0438\u043B\u0438, \u0447\u0442\u043E \u043C\u043E\u0436\u043D\u043E
      \u0438 \u0438\u043C \u2014 \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0440\u0430\u0441\u0448\u0430\u0442\u0430\u043D
      \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E\u0439 \u043C\u044F\u0433\u043A\u043E\u0441\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572896
    m_Localized: "\u041D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0443\u0432\u043E\u043B\u0438\u0442\u044C
      \u0438\u0437 \u043E\u0445\u0440\u0430\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572897
    m_Localized: "\u0420\u0435\u0448\u0435\u043D\u0438\u0435 \u0436\u0451\u0441\u0442\u043A\u043E\u0435,
      \u043D\u043E \u0447\u0435\u0441\u0442\u043D\u043E\u0435. \u0412\u0441\u0435
      \u0432\u0438\u0434\u0435\u043B\u0438, \u0447\u0442\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u043E
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442. \u0417\u0430\u043C\u0435\u043D\u0443
      \u043D\u0430\u0448\u043B\u0438 \u0441\u0440\u0435\u0434\u0438 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u043A \u0443\u0442\u0440\u0443. \u0423\u0432\u043E\u043B\u0435\u043D\u043D\u044B\u0439
      \u0448\u0451\u043B \u0432 \u0445\u0432\u043E\u0441\u0442\u0435 \u043E\u0431\u043E\u0437\u0430
      \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C \u043C\u043E\u043B\u0447\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572898
    m_Localized: "\u041C\u0430\u0440\u043E\u0434\u0451\u0440\u0441\u0442\u0432\u043E
      \u0432 \u043B\u0430\u0433\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572899
    m_Localized: "\u0423\u0442\u0440\u043E\u043C \u043E\u0434\u0438\u043D \u0438\u0437
      \u043D\u043E\u0432\u044B\u0445 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0435\u0442 \u043F\u0440\u043E\u043F\u0430\u0436\u0443:
      \u043A\u043E\u0448\u0435\u043B\u044C \u0441 \u043C\u0435\u0434\u044F\u043A\u0430\u043C\u0438
      \u0438\u0441\u0447\u0435\u0437 \u0438\u0437-\u043F\u043E\u0434 \u043D\u0430\u043A\u0438\u0434\u043A\u0438.
      \u041F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0435 \u043F\u0430\u0434\u0430\u0435\u0442
      \u043D\u0430 \u0441\u043E\u0441\u0435\u0434\u0430 \u043F\u043E \u0448\u0430\u0442\u0440\u0443.
      \u0423\u043B\u0438\u043A \u043F\u0440\u044F\u043C\u044B\u0445 \u043D\u0435\u0442,
      \u043D\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043C\u043D\u043E\u0433\u043E
      \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0445 \u0441\u043E\u0432\u043F\u0430\u0434\u0435\u043D\u0438\u0439.
      \u041B\u0430\u0433\u0435\u0440\u044C \u043D\u0430\u043F\u0440\u044F\u0436\u0451\u043D
      \u2014 \u0435\u0441\u043B\u0438 \u043D\u0435 \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C,
      \u0432\u043E\u0440\u043E\u0432\u0441\u0442\u0432\u043E \u0441\u0442\u0430\u043D\u0435\u0442
      \u043D\u043E\u0440\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572900
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0441\u0442\u0438 \u043E\u0431\u044B\u0441\u043A
      \u043E\u0442\u043A\u0440\u044B\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572901
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E
      \u0432\u0441\u0435\u0445 \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u043E.
      \u041A\u043E\u0448\u0435\u043B\u044C \u043D\u0430\u0448\u043B\u0438 \u0432
      \u0442\u044E\u0444\u044F\u043A\u0435 \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u043C\u043E\u0433\u043E.
      \u0422\u043E\u0442 \u043D\u0435 \u043E\u0442\u043F\u0438\u0440\u0430\u043B\u0441\u044F
      \u0434\u043E\u043B\u0433\u043E. \u041D\u0430\u043A\u0430\u0437\u0430\u043D\u0438\u0435:
      \u0434\u043E \u0433\u043E\u0440\u043E\u0434\u0430 \u043D\u0435\u0441\u0451\u0442
      \u0434\u0432\u043E\u0439\u043D\u0443\u044E \u043D\u043E\u0448\u0443. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572902
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u0432\u0430\u0435\u043C\u044B\u043C
      \u043D\u0430\u0435\u0434\u0438\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572903
    m_Localized: "\u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u043E\u0434\u0438\u043D
      \u043D\u0430 \u043E\u0434\u0438\u043D \u0434\u0430\u043B \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442:
      \u0432\u0438\u043D\u043E\u0432\u043D\u044B\u0439 \u0432\u0435\u0440\u043D\u0443\u043B
      \u043C\u043E\u043D\u0435\u0442\u044B \u0438 \u043F\u0440\u0438\u0437\u043D\u0430\u043B\u0441\u044F
      \u2014 \u043D\u0443\u0436\u0434\u0430, \u043D\u0435 \u0437\u043B\u043E\u0439
      \u0443\u043C\u044B\u0441\u0435\u043B. \u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0432\u044B\u0447\u0435\u0442 \u0438\u0437 \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u044F.
      \u0414\u0435\u043B\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u043E \u0431\u0435\u0437
      \u043E\u0433\u043B\u0430\u0441\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572904
    m_Localized: "\u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0437\u0430\u0448\u0451\u043B
      \u0432 \u0442\u0443\u043F\u0438\u043A. \u0422\u043E\u0442 \u043E\u0442\u0440\u0438\u0446\u0430\u043B.
      \u0423\u043B\u0438\u043A \u043D\u0435 \u0445\u0432\u0430\u0442\u0438\u043B\u043E,
      \u0432\u0438\u043D\u043E\u0432\u043D\u043E\u0433\u043E \u043D\u0435 \u043D\u0430\u0448\u043B\u0438.
      \u041F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u0432\u0448\u0438\u0439 \u0437\u043B\u0438\u0442\u0441\u044F,
      \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043D\u0435\u0440\u0432\u043D\u0438\u0447\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572905
    m_Localized: "\u041E\u0431\u044A\u044F\u0432\u0438\u0442\u044C \u043E\u0431\u0449\u0438\u0439
      \u0448\u0442\u0440\u0430\u0444: \u0432\u0441\u0435 \u043E\u0442\u0432\u0435\u0447\u0430\u044E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572906
    m_Localized: "\xAB\u041F\u043E\u043A\u0430 \u0432\u0438\u043D\u043E\u0432\u043D\u044B\u0439
      \u043D\u0435 \u043E\u0431\u044A\u044F\u0432\u0438\u0442\u0441\u044F \u2014
      \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u0435 \u0432\u0441\u0435\u043C
      \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442\u0441\u044F.\xBB \u0427\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430 \u0447\u0430\u0441\u0430 \u0432\u0438\u043D\u043E\u0432\u043D\u044B\u0439
      \u0441\u0430\u043C \u043F\u0440\u0438\u0448\u0451\u043B \u043F\u0440\u0438\u0437\u043D\u0430\u0432\u0430\u0442\u044C\u0441\u044F:
      \u0434\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u043A\u043E\u043B\u043B\u0435\u043A\u0442\u0438\u0432\u0430
      \u0441\u0434\u0435\u043B\u0430\u043B\u043E \u0441\u0432\u043E\u0451. \u041C\u0435\u0442\u043E\u0434
      \u0436\u0451\u0441\u0442\u043A\u0438\u0439, \u043D\u043E \u0431\u044B\u0441\u0442\u0440\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572907
    m_Localized: "\u041D\u0435\u0445\u0432\u0430\u0442\u043A\u0430 \u0432\u043E\u0434\u044B:
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A \u0440\u0430\u0437\u0434\u0430\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572908
    m_Localized: "\u041F\u043E\u043B\u0434\u0435\u043D\u044C. \u0416\u0430\u0440\u0430
      \u0441\u0442\u043E\u0438\u0442 \u0441\u0442\u0435\u043D\u043E\u0439. \u041E\u0434\u0438\u043D
      \u0438\u0437 \u0431\u0443\u0440\u0434\u044E\u043A\u043E\u0432 \u043F\u043E\u0442\u0451\u043A
      \u043D\u043E\u0447\u044C\u044E \u2014 \u043F\u043E\u0442\u0435\u0440\u0438
      \u043D\u0435\u0432\u0438\u0434\u0438\u043C\u044B\u0435, \u043D\u043E \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u0435.
      \u041E\u0441\u0442\u0430\u0432\u0448\u0435\u0439\u0441\u044F \u0432\u043E\u0434\u044B
      \u043D\u0430 \u043F\u043E\u043B\u0442\u043E\u0440\u0430 \u0434\u043D\u044F,
      \u0430 \u0434\u043E \u043E\u0430\u0437\u0438\u0441\u0430 \u2014 \u0434\u0432\u0430.
      \u041B\u044E\u0434\u0438 \u0443\u0436\u0435 \u043F\u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E\u0442
      \u043D\u0430 \u0447\u0443\u0436\u0438\u0435 \u0431\u0443\u0440\u0434\u044E\u043A\u0438.
      \u0411\u0435\u0437 \u0447\u0451\u0442\u043A\u043E\u0433\u043E \u043F\u043E\u0440\u044F\u0434\u043A\u0430
      \u0440\u0430\u0437\u0434\u0430\u0447\u0438 \u043D\u0430\u0447\u043D\u0451\u0442\u0441\u044F
      \u0442\u043E, \u0447\u0435\u0433\u043E \u043D\u0435 \u0445\u043E\u0447\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572909
    m_Localized: "\u0412\u0432\u0435\u0441\u0442\u0438 \u0441\u0442\u0440\u043E\u0433\u0443\u044E
      \u043D\u043E\u0440\u043C\u0443 \u0434\u043B\u044F \u0432\u0441\u0435\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572910
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0439 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0440\u043E\u0432\u043D\u043E \u043F\u043E \u043F\u0438\u0430\u043B\u0435
      \u0434\u0432\u0430\u0436\u0434\u044B \u0432 \u0434\u0435\u043D\u044C \u2014
      \u0438 \u043A\u0443\u043F\u0435\u0446, \u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A. \u041D\u0438\u043A\u0430\u043A\u0438\u0445
      \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439. \u0420\u043E\u043F\u0442\u0430\u043B\u0438,
      \u043D\u043E \u043F\u043E\u0434\u0447\u0438\u043D\u0438\u043B\u0438\u0441\u044C.
      \u0414\u043E \u043E\u0430\u0437\u0438\u0441\u0430 \u0434\u043E\u0448\u043B\u0438
      \u0432\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572911
    m_Localized: "\u0414\u0430\u0442\u044C \u0431\u043E\u043B\u044C\u0448\u0435 \u0442\u0435\u043C,
      \u043A\u0442\u043E \u043D\u0435\u0441\u0451\u0442 \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572912
    m_Localized: "\u041D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0438 \u0438
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438
      \u043F\u043E\u043B\u0442\u043E\u0440\u044B \u043D\u043E\u0440\u043C\u044B \u2014
      \u0440\u0430\u0431\u043E\u0442\u0430 \u0442\u0440\u0435\u0431\u0443\u0435\u0442.
      \u041E\u0445\u0440\u0430\u043D\u0430 \u0438 \u043A\u0443\u043F\u0435\u0446
      \u2014 \u043F\u043E \u043D\u043E\u0440\u043C\u0435. \u041D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0441\u043F\u043E\u0440\u0438\u043B \u0432\u0441\u0435\u0440\u044C\u0451\u0437:
      \u043B\u043E\u0433\u0438\u043A\u0430 \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u0430.
      \u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u0442\u0440\u0443\u0434 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572913
    m_Localized: "\u0420\u0435\u0448\u0435\u043D\u0438\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
      \u043D\u0435\u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u044B\u043C
      \u043E\u0445\u0440\u0430\u043D\u0435. \u0414\u0432\u043E\u0435 \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u043D\u0435\u0441\u0442\u0438 \u0432\u0430\u0445\u0442\u0443 \u0432 \u0437\u043D\u0430\u043A
      \u043F\u0440\u043E\u0442\u0435\u0441\u0442\u0430. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043F\u0435\u0440\u0435\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044C
      \u043D\u043E\u0440\u043C\u044B \u043D\u0430 \u0445\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572914
    m_Localized: "\u042D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C \u0432\u043E\u0434\u0443:
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u043A \u043E\u0430\u0437\u0438\u0441\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572915
    m_Localized: "\u0422\u0435\u043C\u043F \u043F\u043E\u0434\u043D\u044F\u043B\u0438.
      \u041D\u043E\u0440\u043C\u044B \u0441\u0440\u0435\u0437\u0430\u043B\u0438 \u0434\u043E
      \u043C\u0438\u043D\u0438\u043C\u0443\u043C\u0430. \u041B\u044E\u0434\u0438
      \u0448\u043B\u0438, \u0441\u0442\u0438\u0441\u043D\u0443\u0432 \u0437\u0443\u0431\u044B.
      \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u0432\u0442\u043E\u0440\u043E\u0433\u043E
      \u0434\u043D\u044F \u2014 \u043E\u0430\u0437\u0438\u0441. \u0414\u0432\u043E\u0435
      \u0432\u044B\u0431\u0438\u043B\u0438\u0441\u044C \u0438\u0437 \u0441\u0438\u043B,
      \u043D\u043E \u0434\u043E\u0448\u043B\u0438. \u0412\u043E\u043B\u0438 \u0445\u0432\u0430\u0442\u0438\u043B\u043E
      \u0440\u043E\u0432\u043D\u043E \u043D\u0430 \u0441\u0442\u043E\u043B\u044C\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572916
    m_Localized: "\u0422\u0430\u0439\u043D\u044B\u0435 \u0437\u0430\u043F\u0430\u0441\u044B
      \u0435\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572917
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0436\u0430\u0440\u0435\u043D\u043E\u0433\u043E
      \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F \u0438\u0437 \u0443\u0433\u043B\u0430,
      \u0433\u0434\u0435 \u0441\u043F\u044F\u0442 \u0442\u0440\u043E\u0435 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0445
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432, \u043D\u0430\u043D\u044F\u0442\u044B\u0445
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430\u043C\u0438. \u041E\u043D\u0438
      \u044F\u0432\u043D\u043E \u0435\u0434\u044F\u0442 \u0447\u0442\u043E-\u0442\u043E
      \u0441\u0432\u043E\u0451, \u043F\u043E\u043A\u0430 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0436\u0443\u044E\u0442 \u0441\u0443\u0445\u0438\u0435 \u043B\u0435\u043F\u0451\u0448\u043A\u0438.
      \u0415\u0441\u043B\u0438 \u043F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u0442\u044C
      \u2014 \u043E\u0431\u0438\u0434\u0430 \u0440\u0430\u0437\u044A\u0435\u0441\u0442
      \u043B\u0430\u0433\u0435\u0440\u044C. \u0415\u0441\u043B\u0438 \u043D\u0430\u0434\u0430\u0432\u0438\u0442\u044C
      \u2014 \u043E\u0441\u043A\u043E\u0440\u0431\u0438\u0448\u044C \u043B\u044E\u0434\u0435\u0439,
      \u0443 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0435\u0441\u0442\u044C
      \u043F\u0440\u0430\u0432\u043E \u043D\u0430 \u043B\u0438\u0447\u043D\u044B\u0435
      \u0437\u0430\u043F\u0430\u0441\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572918
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u043E
      \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0445 \u043E\u0431\u0449\u0435\u0433\u043E
      \u0441\u0442\u043E\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572919
    m_Localized: "\u0412\u044B \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B\u0438
      \u043D\u0435\u0433\u0440\u043E\u043C\u043A\u043E: \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435
      \u043F\u0440\u0430\u0432\u0438\u043B\u043E \u043E\u0434\u043D\u043E \u2014
      \u0435\u0441\u043B\u0438 \u0435\u0448\u044C \u0443 \u0432\u0441\u0435\u0445
      \u043D\u0430 \u0432\u0438\u0434\u0443, \u0434\u0435\u043B\u0438\u0441\u044C.
      \u0418\u043B\u0438 \u0435\u0448\u044C \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0435.
      \u0421\u043E\u0433\u0434\u0438\u0439\u0446\u044B \u043F\u043E\u043D\u044F\u043B\u0438,
      \u043D\u0435 \u043E\u0431\u0438\u0434\u0435\u043B\u0438\u0441\u044C \u2014
      \u0438 \u043F\u043E\u0434\u0435\u043B\u0438\u043B\u0438\u0441\u044C \u043E\u0441\u0442\u0430\u0442\u043A\u0430\u043C\u0438.
      \u041F\u0440\u0430\u0432\u0438\u043B\u043E \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043E
      \u0431\u0435\u0437 \u0441\u043A\u0430\u043D\u0434\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572920
    m_Localized: "\u041F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
      \u0441\u0434\u0430\u0442\u044C \u043B\u0438\u0447\u043D\u044B\u0435 \u0437\u0430\u043F\u0430\u0441\u044B
      \u0432 \u043E\u0431\u0449\u0438\u0439 \u043A\u043E\u0442\u0451\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240371572921
    m_Localized: "\u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u0435 \u0432\u044B\u043F\u043E\u043B\u043D\u0438\u043B\u0438,
      \u043D\u043E \u0441 \u043D\u0435\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u043C\u044B\u043C
      \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u043E\u043C.
      \u0417\u0430\u043F\u0430\u0441\u044B \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0445\u043E\u0440\u043E\u0448\u0438\u043C\u0438 \u2014 \u043E\u0431\u0449\u0438\u0439
      \u043A\u043E\u0442\u0451\u043B \u0441\u0442\u0430\u043B \u0441\u044B\u0442\u043D\u0435\u0435.
      \u041D\u043E \u0442\u0440\u043E\u0435 \u0435\u043B\u0438 \u043C\u043E\u043B\u0447\u0430
      \u0438 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
      \u0435\u0449\u0451 \u0434\u0432\u0430 \u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767040
    m_Localized: "\u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u0435 \u0432\u044B\u0437\u0432\u0430\u043B\u043E
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0439 \u043E\u0442\u043A\u0430\u0437.
      \xAB\u041D\u0430\u0448\u0435, \u0447\u0442\u043E \u0445\u043E\u0442\u0438\u043C
      \u2014 \u0442\u043E \u0438 \u0435\u0434\u0438\u043C.\xBB \u0410\u0432\u0442\u043E\u0440\u0438\u0442\u0435\u0442
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0448\u0430\u0442\u043D\u0443\u043B\u0441\u044F,
      \u0441\u043E\u0433\u0434\u0438\u0439\u0446\u044B \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F
      \u043E\u0441\u043E\u0431\u043D\u044F\u043A\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767041
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C \u0433\u043B\u0430\u0437\u0430:
      \u043D\u0435 \u0432\u0430\u0448\u0435 \u0434\u0435\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767042
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u043B\u0438.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438.
      \u041A \u0443\u0442\u0440\u0443 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u044B
      \u043E \xAB\u043B\u044E\u0431\u0438\u043C\u0447\u0438\u043A\u0430\u0445\xBB
      \u0443\u0436\u0435 \u0445\u043E\u0434\u0438\u043B\u0438 \u043F\u043E \u043B\u0430\u0433\u0435\u0440\u044E.
      \u041C\u0435\u043B\u043E\u0447\u044C, \u043D\u043E \u043A\u0430\u043C\u0435\u043D\u044C
      \u0432 \u0441\u0442\u0435\u043D\u0443 \u043D\u0435\u0434\u043E\u0432\u0435\u0440\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767043
    m_Localized: "\u0420\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u0435
      \u043D\u043E\u0447\u043D\u044B\u0445 \u0432\u0430\u0445\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767044
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0442\u044F\u0436\u0451\u043B\u043E\u0433\u043E
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430 \u043F\u043E \u0436\u0430\u0440\u0435
      \u043B\u044E\u0434\u0438 \u0432\u0430\u043B\u044F\u0442\u0441\u044F \u0441
      \u043D\u043E\u0433. \u041D\u043E \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435
      \u043D\u043E\u0447\u0438 \u043E\u043F\u0430\u0441\u043D\u044B \u2014 \u0431\u0430\u043D\u0434\u044B
      \u043C\u0430\u0440\u043E\u0434\u0451\u0440\u043E\u0432, \u0434\u0438\u043A\u0438\u0435
      \u0441\u043E\u0431\u0430\u043A\u0438, \u043D\u0435\u043D\u0443\u0436\u043D\u044B\u0435
      \u0433\u043E\u0441\u0442\u0438. \u0412\u0430\u0445\u0442\u0430 \u043D\u0443\u0436\u043D\u0430,
      \u043D\u043E \u0436\u0435\u043B\u0430\u044E\u0449\u0438\u0445 \u043D\u0435\u0442.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0441\u0447\u0438\u0442\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0434\u0440\u0443\u0433\u043E\u0439 \u0443\u0441\u0442\u0430\u043B
      \u0431\u043E\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767045
    m_Localized: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0436\u0451\u0441\u0442\u043A\u0438\u0439
      \u0433\u0440\u0430\u0444\u0438\u043A \u043F\u043E \u0436\u0440\u0435\u0431\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767046
    m_Localized: "\u0421\u043E\u043B\u043E\u043C\u0438\u043D\u043A\u0438 \u0432\u044B\u0442\u044F\u043D\u0443\u043B\u0438
      \u0432\u0441\u0435 \u043F\u043E\u0440\u043E\u0432\u043D\u0443. \u041A\u043E\u043C\u0443
      \u0432\u044B\u043F\u0430\u043B\u043E \u2014 \u043D\u0451\u0441 \u0432\u0430\u0445\u0442\u0443
      \u0431\u0435\u0437 \u0441\u043F\u043E\u0440\u043E\u0432: \u0436\u0440\u0435\u0431\u0438\u0439
      \u0435\u0441\u0442\u044C \u0436\u0440\u0435\u0431\u0438\u0439. \u041D\u043E\u0447\u044C
      \u043F\u0440\u043E\u0448\u043B\u0430 \u0431\u0435\u0437 \u043F\u0440\u043E\u0438\u0441\u0448\u0435\u0441\u0442\u0432\u0438\u0439,
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u0432\u0430\u043B
      \u0441\u0435\u0431\u044F \u043E\u0431\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767047
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0434\u0432\u043E\u0439\u043D\u043E\u0435
      \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u0435 \u0437\u0430 \u0432\u0430\u0445\u0442\u0443
      \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u0446\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767048
    m_Localized: "\u0414\u0435\u043D\u044C\u0433\u0438 \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0441\u0432\u043E\u0451: \u0442\u0440\u043E\u0435 \u0432\u044B\u0437\u0432\u0430\u043B\u0438\u0441\u044C
      \u0441\u0440\u0430\u0437\u0443. \u0411\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0432\u0430\u0445\u0442\u0430 \u0438\u0437 \u0436\u0435\u043B\u0430\u044E\u0449\u0438\u0445
      \u043B\u0443\u0447\u0448\u0435 \u0441\u043E\u043D\u043D\u043E\u0439 \u0438\u0437
      \u043E\u0431\u044F\u0437\u0430\u043D\u043D\u044B\u0445. \u041D\u043E\u0447\u044C
      \u043F\u0440\u043E\u0448\u043B\u0430 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767049
    m_Localized: "\u0416\u0435\u043B\u0430\u044E\u0449\u0438\u0445 \u043D\u0435 \u043D\u0430\u0448\u043B\u043E\u0441\u044C
      \u0434\u0430\u0436\u0435 \u0437\u0430 \u0434\u0432\u043E\u0439\u043D\u0443\u044E
      \u043F\u043B\u0430\u0442\u0443 \u2014 \u0432\u0441\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0432\u044B\u043C\u043E\u0442\u0430\u043D\u044B. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F \u043A
      \u0436\u0435\u0440\u0435\u0431\u044C\u0451\u0432\u043A\u0435, \u043F\u043E\u0442\u0435\u0440\u044F\u0432
      \u0432\u0440\u0435\u043C\u044F \u0438 \u0430\u0432\u0442\u043E\u0440\u0438\u0442\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767050
    m_Localized: "\u0421\u0430\u043C\u043E\u043C\u0443 \u043D\u0435\u0441\u0442\u0438
      \u043F\u0435\u0440\u0432\u0443\u044E \u0432\u0430\u0445\u0442\u0443 \u2014
      \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043F\u0440\u0438\u043C\u0435\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767051
    m_Localized: "\u041A\u043E\u0433\u0434\u0430 \u0433\u043B\u0430\u0432\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0431\u0435\u0440\u0451\u0442 \u043A\u043E\u043F\u044C\u0451 \u0438 \u0432\u0441\u0442\u0430\u0451\u0442
      \u043F\u0435\u0440\u0432\u044B\u043C, \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442\u043E\u0432
      \u043D\u0435 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0432\u0430\u0445\u0442\u044B \u0437\u0430\u043D\u044F\u043B\u0438 \u043E\u0445\u043E\u0442\u043D\u043E.
      \u041B\u0438\u0447\u043D\u044B\u0439 \u043F\u0440\u0438\u043C\u0435\u0440 \u2014
      \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442
      \u043F\u043E\u0440\u044F\u0434\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767052
    m_Localized: "\u0423\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C \u0432 \u0433\u043E\u0440\u0430\u0445:
      \u0431\u0443\u043D\u0442 \u043F\u0440\u043E\u0442\u0438\u0432 \u0442\u0435\u043C\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767053
    m_Localized: "\u041A\u0440\u0443\u0442\u043E\u0439 \u043F\u043E\u0434\u044A\u0451\u043C
      \u0442\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C \u043F\u043E\u0434\u0440\u044F\u0434
      \u2014 \u0443 \u043B\u044E\u0434\u0435\u0439 \u043F\u043E\u0434\u0433\u0438\u0431\u0430\u044E\u0442\u0441\u044F
      \u043D\u043E\u0433\u0438. \u0414\u0432\u043E\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0441\u0435\u043B\u0438 \u043D\u0430 \u043A\u0430\u043C\u043D\u0438 \u0438
      \u043E\u0431\u044A\u044F\u0432\u0438\u043B\u0438: \u0434\u0430\u043B\u044C\u0448\u0435
      \u043D\u0435 \u0438\u0434\u0443\u0442 \u0431\u0435\u0437 \u0434\u043B\u0438\u043D\u043D\u043E\u0433\u043E
      \u043F\u0440\u0438\u0432\u0430\u043B\u0430. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u2014 \u043A\u0442\u043E \u043F\u043E\u0431\u0435\u0434\u0438\u0442.
      \u041F\u043E\u0433\u043E\u0434\u0430 \u0445\u043E\u0440\u043E\u0448\u0430\u044F,
      \u043D\u043E \u043A \u0432\u0435\u0447\u0435\u0440\u0443 \u043C\u043E\u0436\u0435\u0442
      \u0441\u043C\u0435\u043D\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767054
    m_Localized: "\u0414\u0430\u0442\u044C \u0447\u0430\u0441\u043E\u0432\u043E\u0439
      \u043F\u0440\u0438\u0432\u0430\u043B \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767055
    m_Localized: "\u0427\u0430\u0441 \u043B\u0451\u0436\u043A\u0438 \u043D\u0430
      \u043A\u0430\u043C\u043D\u044F\u0445 \u0441\u0434\u0435\u043B\u0430\u043B \u0447\u0443\u0434\u043E.
      \u0412\u0441\u0442\u0430\u0432\u0430\u043B\u0438 \u0441 \u043A\u0440\u044F\u0445\u0442\u0435\u043D\u0438\u0435\u043C,
      \u043D\u043E \u0432\u0441\u0442\u0430\u0432\u0430\u043B\u0438. \u0412\u0442\u043E\u0440\u0430\u044F
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u043F\u043E\u0434\u044A\u0451\u043C\u0430
      \u043F\u0440\u043E\u0448\u043B\u0430 \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u043F\u0435\u0440\u0432\u043E\u0439 \u2014 \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0432\u0448\u0438\u0435
      \u043D\u043E\u0433\u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442 \u0438\u043D\u0430\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767056
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0435\u0449\u0451 \u043B\u0438
      \u0434\u043E \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430 \u2014 \u0442\u0430\u043C
      \u043F\u0440\u0438\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767057
    m_Localized: "\u0412\u044B \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B\u0438:
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435 \u0432\u0435\u0442\u0435\u0440
      \u0441\u043B\u0430\u0431\u0435\u0435 \u0438 \u043C\u0435\u0441\u0442\u043E
      \u0440\u043E\u0432\u043D\u043E\u0435. \u041D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u0445
      \u0443\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438. \u041F\u0440\u043E\u0448\u043B\u0438
      \u0435\u0449\u0451 \u043B\u0438 \u2014 \u0438 \u043F\u0440\u0430\u0432\u0434\u0430:
      \u0437\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u043E\u043C \u0443\u043A\u0440\u044B\u0442\u0430\u044F
      \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0430. \u041F\u0440\u0438\u0432\u0430\u043B
      \u0442\u0430\u043C \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043B\u0443\u0447\u0448\u0435,
      \u0447\u0435\u043C \u043D\u0430 \u0441\u043A\u043B\u043E\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767058
    m_Localized: "\u0423\u0433\u043E\u0432\u043E\u0440\u044B \u043D\u0435 \u043F\u043E\u043C\u043E\u0433\u043B\u0438.
      \u0414\u0432\u043E\u0435 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0441\u0438\u0434\u0435\u0442\u044C.
      \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u044B\u0432\u0430\u0442\u044C
      \u043F\u043E\u0434\u043C\u043E\u0433\u0443 \u0438 \u0442\u0435\u0440\u044F\u0442\u044C
      \u043F\u043E\u043B\u0447\u0430\u0441\u0430. \u041F\u0435\u0440\u0435\u0432\u0430\u043B
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B \u043D\u0435\u043F\u043E\u0433\u043E\u0434\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767059
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0443\u043F\u0440\u044F\u043C\u0446\u0435\u0432:
      \u043D\u0430\u0433\u043E\u043D\u044F\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767060
    m_Localized: "\u041E\u0431\u043E\u0437 \u043F\u043E\u0448\u0451\u043B. \u0414\u0432\u043E\u0435
      \u043E\u0442\u0441\u0442\u0430\u0432\u0448\u0438\u0445 \u0441\u0438\u0434\u0435\u043B\u0438,
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438, \u043F\u043E\u0442\u043E\u043C
      \u0432\u0441\u0442\u0430\u043B\u0438 \u0438 \u043F\u043E\u0431\u0435\u0436\u0430\u043B\u0438
      \u0434\u043E\u0433\u043E\u043D\u044F\u0442\u044C. \u0418\u043D\u043E\u0433\u0434\u0430
      \u043B\u0443\u0447\u0448\u0438\u0439 \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442
      \u2014 \u0443\u0445\u043E\u0434\u044F\u0449\u0438\u0435 \u0441\u043F\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767061
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u043F\u043E\u0441\u0442:
      \u043F\u043B\u0430\u0442\u0430 \u0437\u0430 \u043F\u0440\u043E\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767062
    m_Localized: "\u041D\u0430 \u0442\u0440\u043E\u043F\u0435 \u2014 \u0433\u0440\u0443\u0431\u043E
      \u0441\u043B\u043E\u0436\u0435\u043D\u043D\u0430\u044F \u0441\u0442\u0435\u043D\u0430
      \u0438\u0437 \u043A\u0430\u043C\u043D\u0435\u0439, \u0443 \u043D\u0435\u0451
      \u0442\u0440\u043E\u0435 \u0432\u043E\u0438\u043D\u043E\u0432 \u0432 \u043C\u0435\u0445\u043E\u0432\u044B\u0445
      \u0448\u0430\u043F\u043A\u0430\u0445. \u0422\u0440\u0435\u0431\u0443\u044E\u0442
      \u043F\u043E\u0448\u043B\u0438\u043D\u0443: \u0434\u0435\u0441\u044F\u0442\u0443\u044E
      \u0434\u043E\u043B\u044E \u043E\u0442 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0442\u044E\u043A\u0430. \u041D\u0438\u043A\u0430\u043A\u0438\u0445 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432,
      \u043D\u0438\u043A\u0430\u043A\u043E\u0439 \u043F\u0435\u0447\u0430\u0442\u0438
      \u2014 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0438\u043B\u0430. \u041E\u0431\u043E\u0439\u0442\u0438
      \u043D\u0435\u043B\u044C\u0437\u044F: \u0441\u043F\u0440\u0430\u0432\u0430
      \u2014 \u043E\u0431\u0440\u044B\u0432, \u0441\u043B\u0435\u0432\u0430 \u2014
      \u0441\u043D\u0435\u0436\u043D\u044B\u0439 \u0441\u043A\u043B\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767063
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0438 \u043F\u0440\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767064
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B \u0437\u0430\u043D\u044F\u043B\u0438
      \u043F\u043E\u043B\u0447\u0430\u0441\u0430 \u2014 \u0441\u0431\u0438\u043B\u0438
      \u0434\u043E \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u043E\u0439 \u0434\u043E\u043B\u0438.
      \u0417\u0430\u043F\u043B\u0430\u0442\u0438\u043B\u0438, \u043F\u0440\u043E\u0448\u043B\u0438.
      \u0413\u043E\u0440\u044B \u0442\u0430\u044F\u0442 \u043C\u043D\u043E\u0433\u043E
      \u043F\u043E\u0434\u043E\u0431\u043D\u044B\u0445 \u043F\u043E\u0441\u0442\u043E\u0432,
      \u0438 \u043D\u0435 \u0441 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0443\u0439\u0434\u0451\u0448\u044C
      \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767065
    m_Localized: "\u041F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
      \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767066
    m_Localized: "\u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430 \u043D\u0435
      \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C. \u0412\u044B \u0443\u043A\u0430\u0437\u0430\u043B\u0438
      \u043D\u0430 \u044D\u0442\u043E \u043F\u0440\u0438 \u0432\u0441\u0435\u0445
      \u2014 \u0432\u043E\u0438\u043D\u044B \u0441\u043C\u0443\u0442\u0438\u043B\u0438\u0441\u044C.
      \u041E\u0434\u0438\u043D \u043E\u0442\u043E\u0448\u0451\u043B \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C. \u0412
      \u0438\u0442\u043E\u0433\u0435 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438
      \u0437\u0430 \u0441\u0438\u043C\u0432\u043E\u043B\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u043F\u043B\u0430\u0442\u0443: \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043B\u0438\u0446\u043E, \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u043B\u0438
      \u043F\u0440\u043E\u0445\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767067
    m_Localized: "\u0412\u044B\u0437\u043E\u0432 \u0432\u044B\u0448\u0435\u043B \u0440\u0435\u0437\u043A\u0438\u043C,
      \u0432\u043E\u0438\u043D\u044B \u0440\u0430\u0441\u0441\u0435\u0440\u0434\u0438\u043B\u0438\u0441\u044C.
      \u0417\u0430\u0434\u0435\u0440\u0436\u0430\u043B\u0438 \u043D\u0430 \u0434\u0432\u0430
      \u0447\u0430\u0441\u0430 \u0434\u043B\u044F \xAB\u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438
      \u0442\u044E\u043A\u043E\u0432\xBB. \u041F\u0440\u043E\u0448\u043B\u0438, \u043D\u043E
      \u0437\u043B\u044B\u0435 \u0438 \u0441 \u0440\u0430\u0441\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u044B\u043C
      \u0433\u0440\u0443\u0437\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767068
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0442\u043E\u0432\u0430\u0440
      \u0432\u043C\u0435\u0441\u0442\u043E \u043C\u043E\u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767069
    m_Localized: "\u0413\u043E\u0440\u0441\u0442\u044C \u043F\u0435\u0440\u0446\u0430
      \u0438 \u043A\u0443\u0441\u043E\u043A \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E
      \u0441\u0443\u043A\u043D\u0430 \u2014 \u0432\u043E\u0438\u043D\u044B \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u043B\u0438\u0441\u044C
      \u0438 \u043A\u0438\u0432\u043D\u0443\u043B\u0438. \u0422\u043E\u0432\u0430\u0440
      \u0432 \u0433\u043E\u0440\u0430\u0445 \u0446\u0435\u043D\u043D\u0435\u0435
      \u043C\u043E\u043D\u0435\u0442\u044B. \u041F\u0440\u043E\u0448\u043B\u0438
      \u0431\u0435\u0437 \u0441\u043F\u043E\u0440\u043E\u0432, \u0434\u0430\u0436\u0435
      \u043F\u043E\u0436\u0435\u043B\u0430\u043B\u0438 \u043F\u043E\u043F\u0443\u0442\u043D\u043E\u0433\u043E
      \u0432\u0435\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767070
    m_Localized: "\u041F\u0440\u0430\u0432\u0438\u043B\u0430 \u043B\u0430\u0433\u0435\u0440\u044F
      \u0432 \u043D\u0435\u043F\u043E\u0433\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767071
    m_Localized: "\u0422\u0443\u043C\u0430\u043D \u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0441\u044F
      \u043D\u0430 \u0443\u0449\u0435\u043B\u044C\u0435, \u0432\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u044C
      \u2014 \u0434\u0435\u0441\u044F\u0442\u044C \u0448\u0430\u0433\u043E\u0432.
      \u0412 \u044D\u0442\u0438\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445
      \u043B\u0430\u0433\u0435\u0440\u044C \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0445\u0430\u043E\u0441: \u043A\u0442\u043E-\u0442\u043E \u0440\u0430\u0437\u0436\u0438\u0433\u0430\u0435\u0442
      \u043A\u043E\u0441\u0442\u0451\u0440 \u0442\u0430\u043C, \u0433\u0434\u0435
      \u043D\u0435\u043B\u044C\u0437\u044F, \u043A\u0442\u043E-\u0442\u043E \u0431\u0440\u043E\u0434\u0438\u0442
      \u043C\u0438\u043C\u043E \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432
      \u0438 \u043F\u0443\u0433\u0430\u0435\u0442 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445.
      \u041D\u0443\u0436\u043D\u044B \u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u043F\u0440\u044F\u043C\u043E
      \u0441\u0435\u0439\u0447\u0430\u0441, \u0438\u043D\u0430\u0447\u0435 \u043F\u0430\u043D\u0438\u043A\u0430
      \u0441\u0442\u0430\u043D\u0435\u0442 \u0441\u0430\u043C\u044B\u043C \u043E\u043F\u0430\u0441\u043D\u044B\u043C
      \u0432\u0440\u0430\u0433\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767072
    m_Localized: "\u041E\u0431\u044A\u044F\u0432\u0438\u0442\u044C \u0437\u043E\u043D\u044B
      \u0438 \u0437\u0430\u043F\u0440\u0435\u0442\u044B \u0433\u0440\u043E\u043C\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767073
    m_Localized: "\u0422\u0440\u0438 \u043A\u0440\u0438\u043A\u0430 \u043D\u0430
      \u0432\u0435\u0441\u044C \u0442\u0443\u043C\u0430\u043D \u2014 \u0437\u043E\u043D\u044B
      \u043E\u0447\u0435\u0440\u0447\u0435\u043D\u044B \u0433\u043E\u043B\u043E\u0441\u043E\u043C.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0437\u043D\u0430\u0435\u0442, \u0433\u0434\u0435
      \u0435\u043C\u0443 \u0441\u0442\u043E\u044F\u0442\u044C. \u0425\u0430\u043E\u0441
      \u0441\u0436\u0430\u043B\u0441\u044F \u0434\u043E \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u0435\u043C\u043E\u0433\u043E
      \u0431\u0435\u0441\u043F\u043E\u0440\u044F\u0434\u043A\u0430. \u0422\u0443\u043C\u0430\u043D
      \u0440\u0430\u0441\u0441\u0435\u044F\u043B\u0441\u044F \u043A \u043F\u043E\u043B\u0443\u0434\u043D\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767074
    m_Localized: "\u0412\u044B\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u0432
      \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C \u0443\u0437\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767075
    m_Localized: "\u0427\u0435\u0442\u0432\u0435\u0440\u043E \u043E\u043F\u044B\u0442\u043D\u044B\u0445
      \u043B\u044E\u0434\u0435\u0439 \u0432\u0441\u0442\u0430\u043B\u0438 \u0443
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432, \u0443 \u0441\u043A\u043B\u0430\u0434\u0430,
      \u0443 \u0442\u0440\u043E\u043F\u044B \u0432\u043D\u0438\u0437. \u041A\u0430\u0436\u0434\u044B\u0439
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0441\u043F\u0438\u0441\u043E\u043A
      \u043A\u043E\u043C\u0430\u043D\u0434. \u0422\u0443\u043C\u0430\u043D \u0441\u0442\u0430\u043B
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C\u044E \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u043C\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767076
    m_Localized: "\u041E\u0434\u0438\u043D \u0438\u0437 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u0432
      \u0441\u0430\u043C \u0437\u0430\u043F\u043B\u0443\u0442\u0430\u043B \u0432
      \u0442\u0443\u043C\u0430\u043D\u0435 \u0438 \u043D\u0430\u0447\u0430\u043B
      \u043A\u0440\u0438\u0447\u0430\u0442\u044C. \u041F\u0435\u0440\u0435\u043F\u043E\u043B\u043E\u0445
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0445\u0443\u0436\u0435 \u043F\u0435\u0440\u0432\u043E\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767077
    m_Localized: "\u041F\u0440\u0438\u043A\u0430\u0437\u0430\u0442\u044C \u0432\u0441\u0435\u043C
      \u043D\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0434\u043E
      \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767078
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u0435\u0439\u0448\u0435\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435.
      \u0412\u0441\u0435 \u0441\u0435\u043B\u0438 \u0438\u043B\u0438 \u043B\u0435\u0433\u043B\u0438
      \u0442\u0430\u043C, \u0433\u0434\u0435 \u0441\u0442\u043E\u044F\u043B\u0438.
      \u0416\u0434\u0430\u043B\u0438. \u0422\u0443\u043C\u0430\u043D \u0443\u0448\u0451\u043B
      \u0441 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u043E\u043C. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0447\u0430\u0441\u0442\u044C \u0434\u043D\u044F, \u0437\u0430\u0442\u043E
      \u0431\u0435\u0437 \u0436\u0435\u0440\u0442\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767079
    m_Localized: "\u0417\u0430\u043A\u043E\u043D \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767080
    m_Localized: "\u041F\u0435\u0440\u0435\u0434 \u0432\u044B\u0445\u043E\u0434\u043E\u043C
      \u0438\u0437 \u0433\u043E\u0440\u043E\u0434\u0430 \u043E\u0434\u0438\u043D
      \u0438\u0437 \u043E\u043F\u044B\u0442\u043D\u044B\u0445 \u043A\u0443\u043F\u0446\u043E\u0432
      \u043F\u043E\u0434\u043D\u044F\u043B \u0440\u0443\u043A\u0443: \u043D\u0430\u0434\u043E
      \u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C \u043F\u0440\u0430\u0432\u0438\u043B\u0430
      \u043D\u0430 \u0432\u0435\u0441\u044C \u043F\u0443\u0442\u044C, \u043F\u043E\u043A\u0430
      \u0432\u0441\u0435 \u0432\u043C\u0435\u0441\u0442\u0435 \u0438 \u0442\u0440\u0435\u0437\u0432\u044B.
      \u041D\u0435 \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u044B\u0435 \u0437\u0430\u043A\u043E\u043D\u044B
      \u2014 \u0436\u0438\u0432\u044B\u0435 \u0441\u043B\u043E\u0432\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u0432\u0441\u0435. \u0427\u0442\u043E
      \u043C\u043E\u0436\u043D\u043E, \u0447\u0435\u0433\u043E \u043D\u0435\u043B\u044C\u0437\u044F,
      \u043A\u0442\u043E \u0437\u0430 \u0447\u0442\u043E \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442.
      \u0411\u0435\u0437 \u044D\u0442\u043E\u0433\u043E \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430
      \u043F\u043E\u0445\u043E\u0434 \u2014 \u043B\u043E\u0442\u0435\u0440\u0435\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767081
    m_Localized: "\u041E\u0433\u043B\u0430\u0441\u0438\u0442\u044C \u043F\u0440\u0430\u0432\u0438\u043B\u0430
      \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767082
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442
      \u0440\u0435\u0447\u0438. \u041A\u0430\u0436\u0434\u044B\u0439 \u043A\u0438\u0432\u043D\u0443\u043B
      \u2014 \u0438\u043B\u0438 \u043D\u0435 \u043A\u0438\u0432\u043D\u0443\u043B,
      \u0447\u0442\u043E \u0442\u043E\u0436\u0435 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438.
      \u0421\u043B\u043E\u0432\u0430 \u0441\u043A\u0430\u0437\u0430\u043D\u044B \u043F\u0440\u0438
      \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044F\u0445. \u041F\u0435\u0440\u0432\u044B\u0439
      \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442 \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u043B\u0438
      \u043B\u0435\u0433\u043A\u043E: \xAB\u0422\u044B \u0436\u0435 \u0441\u043B\u044B\u0448\u0430\u043B\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767083
    m_Localized: "\u0421\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u043F\u0438\u0441\u043E\u043A
      \u043F\u0440\u0430\u0432\u0438\u043B \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767084
    m_Localized: "\u041F\u0438\u0441\u0435\u0446 \u0437\u0430\u043F\u0438\u0441\u0430\u043B
      \u043D\u0430 \u043A\u043E\u0436\u0435. \u041A\u0430\u0436\u0434\u044B\u0439,
      \u043A\u0442\u043E \u0443\u043C\u0435\u043B, \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u0437\u043D\u0430\u043A. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u043C
      \u0437\u0430\u0447\u0438\u0442\u0430\u043B\u0438 \u0432\u0441\u043B\u0443\u0445.
      \u0411\u0443\u043C\u0430\u0433\u0430 \u2014 \u0441\u043B\u0430\u0431\u0435\u0435
      \u0441\u043B\u043E\u0432\u0430, \u043D\u043E \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435
      \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442. \u041A \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435
      \u043F\u0443\u0442\u0438 \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u0441\u044B\u043B\u0430\u043B\u0441\u044F
      \u043D\u0430 \u043D\u0435\u0437\u043D\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767085
    m_Localized: "\u041F\u043E\u043A\u0430 \u043F\u0438\u0441\u0430\u043B\u0438,
      \u0441\u043F\u043E\u0440\u0438\u043B\u0438 \u043E \u0444\u043E\u0440\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u043A\u0430\u0445
      \u0447\u0430\u0441. \u0418\u0442\u043E\u0433\u043E\u0432\u044B\u0439 \u0442\u0435\u043A\u0441\u0442
      \u0432\u044B\u0448\u0435\u043B \u043F\u0443\u0442\u0430\u043D\u044B\u043C.
      \u041F\u0435\u0440\u0432\u044B\u0439 \u0436\u0435 \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B
      \u0434\u044B\u0440\u044B \u0432 \u043F\u0440\u0430\u0432\u0438\u043B\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767086
    m_Localized: "\u041E\u0442\u043B\u043E\u0436\u0438\u0442\u044C: \u0440\u0430\u0437\u0431\u0435\u0440\u0451\u043C\u0441\u044F
      \u043F\u043E \u0445\u043E\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767087
    m_Localized: "\xAB\u0420\u0430\u0437\u0431\u0435\u0440\u0451\u043C\u0441\u044F\xBB
      \u0441\u0442\u0430\u043B\u043E \u0433\u043B\u0430\u0432\u043D\u044B\u043C \u0441\u043B\u043E\u0432\u043E\u043C
      \u043F\u0435\u0440\u0432\u043E\u0439 \u043D\u0435\u0434\u0435\u043B\u0438.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0441\u043F\u043E\u0440 \u2014 \u0441
      \u0447\u0438\u0441\u0442\u043E\u0433\u043E \u043B\u0438\u0441\u0442\u0430.
      \u041A \u0434\u0435\u0441\u044F\u0442\u043E\u043C\u0443 \u0434\u043D\u044E
      \u0442\u0440\u0438 \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u0430 \u0432\u0438\u0441\u0435\u043B\u0438
      \u043D\u0435\u0440\u0435\u0448\u0451\u043D\u043D\u044B\u043C\u0438. \u041F\u0440\u0430\u0432\u0438\u043B
      \u043D\u0435\u0442 \u2014 \u043D\u0435\u0442 \u0438 \u043E\u043F\u043E\u0440\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767088
    m_Localized: "\u041D\u043E\u0432\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0432 \u043E\u0431\u043E\u0437\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767089
    m_Localized: "\u0423 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430 \u043A \u043E\u0431\u043E\u0437\u0443 \u043F\u0440\u043E\u0441\u0438\u0442\u0441\u044F
      \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0435\u0446 \u2014 \u043C\u043E\u043B\u043E\u0434\u043E\u0439,
      \u0441 \u0443\u0437\u043B\u043E\u043C \u043D\u0430 \u043F\u043B\u0435\u0447\u0435.
      \u0413\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u0437\u043D\u0430\u0435\u0442
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0432\u043F\u0435\u0440\u0451\u0434,
      \u0433\u043E\u0442\u043E\u0432 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0437\u0430 \u0435\u0434\u0443 \u0438 \u043A\u0440\u044B\u0448\u0443 \u043D\u0430\u0434
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439. \u0412\u0437\u0433\u043B\u044F\u0434
      \u043F\u0440\u044F\u043C\u043E\u0439, \u043D\u043E \u0440\u0443\u043A\u0438
      \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0435, \u0430 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u043F\u0438\u0441\u044C\u043C\u0430 \u043D\u0435\u0442. \u041B\u044E\u0434\u0438
      \u0432 \u043E\u0431\u043E\u0437\u0435 \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u043D\u0430 \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767090
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043F\u043E\u0434 \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u043E\u043C:
      \u0438\u0441\u043F\u044B\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0441\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767091
    m_Localized: "\u0422\u0440\u0438 \u0434\u043D\u044F \u0440\u0430\u0431\u043E\u0442\u044B
      \u043F\u043E\u0434 \u043F\u0440\u0438\u0441\u043C\u043E\u0442\u0440\u043E\u043C
      \u0441\u0442\u0430\u0440\u0448\u0435\u0433\u043E \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430.
      \u041F\u0430\u0440\u0435\u043D\u044C \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0438\u0441\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
      \u0438 \u0437\u043D\u0430\u043B \u0434\u043E\u0440\u043E\u0433\u0443 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0445\u043E\u0440\u043E\u0448\u043E. \u041A \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u043E\u043C\u0443
      \u0434\u043D\u044E \u0435\u0433\u043E \u043F\u0440\u0438\u043D\u044F\u043B\u0438
      \u043A\u0430\u043A \u0441\u0432\u043E\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767092
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u2014 \u0447\u0443\u0436\u0430\u043A
      \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767093
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u043B\u0438 \u0432\u0435\u0436\u043B\u0438\u0432\u043E,
      \u043D\u043E \u0442\u0432\u0451\u0440\u0434\u043E. \u041D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0435\u0446
      \u043F\u043E\u0436\u0430\u043B \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438
      \u043F\u043E\u0448\u0451\u043B \u0434\u0430\u043B\u044C\u0448\u0435. \u041C\u043E\u0436\u0435\u0442,
      \u044D\u0442\u043E \u0431\u044B\u043B\u043E \u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0430 \u043C\u043E\u0436\u0435\u0442, \u0443\u043F\u0443\u0441\u0442\u0438\u043B\u0438
      \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.
      \u041D\u0435 \u0443\u0437\u043D\u0430\u0442\u044C \u0442\u0435\u043F\u0435\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767094
    m_Localized: "\u041E\u0442\u043A\u0430\u0437 \u043F\u0440\u043E\u0437\u0432\u0443\u0447\u0430\u043B
      \u0433\u0440\u0443\u0431\u043E. \u041D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0435\u0446
      \u043E\u0431\u0438\u0434\u0435\u043B\u0441\u044F \u0438 \u043F\u0440\u0438
      \u0432\u0441\u0435\u0445 \u0441\u043A\u0430\u0437\u0430\u043B \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0441\u043B\u043E\u0432 \u043E \u0436\u0430\u0434\u043D\u044B\u0445 \u043A\u0443\u043F\u0446\u0430\u0445.
      \u041B\u0430\u0433\u0435\u0440\u044C \u0441\u043B\u044B\u0448\u0430\u043B.
      \u041D\u0435\u043B\u043E\u0432\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767095
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0440\u0430\u0437\u0443
      \u2014 \u043B\u0438\u0448\u043D\u0438\u0435 \u0440\u0443\u043A\u0438 \u043D\u0443\u0436\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767096
    m_Localized: "\u0412\u0437\u044F\u043B\u0438 \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432. \u0420\u0430\u0431\u043E\u0442\u0430\u043B
      \u0445\u043E\u0440\u043E\u0448\u043E. \u0427\u0435\u0440\u0435\u0437 \u043D\u0435\u0434\u0435\u043B\u044E
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438, \u0447\u0442\u043E
      \u043E\u043D \u0437\u043D\u0430\u043B\u0434\u043E\u0440\u043E\u0433\u0443 \u043A
      \u0441\u043A\u0440\u044B\u0442\u043E\u043C\u0443 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0443
      \u0432\u043E\u0434\u044B \u2014 \u0437\u043D\u0430\u043D\u0438\u0435, \u043E
      \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0441\u0440\u0430\u0437\u0443. \u0414\u043E\u0431\u0440\u043E\u0442\u0430
      \u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C \u0441 \u043F\u0440\u0438\u0431\u044B\u043B\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767097
    m_Localized: "\u041D\u0443\u0436\u0435\u043D \u0441\u043F\u0443\u0442\u043D\u0438\u043A:
      {companion_name}"
    m_Metadata:
      m_Items: []
  - m_Id: 25356240375767098
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u043C\u0438\u043D\u0438\u043C\u0443\u043C
      {count} \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856263475200
    m_Localized: "\u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044C!"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856301223936
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0441\u043E\u0442\u0435\u043D \u0434\u043D\u0435\u0439
      \u043F\u0443\u0442\u0438 \u0437\u043E\u043B\u043E\u0442\u044B\u0435 \u043A\u0443\u043F\u043E\u043B\u0430
      \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044F
      \u0441\u0438\u044F\u044E\u0442 \u0432\u043F\u0435\u0440\u0435\u0434\u0438.
      \u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0441\u0442\u043E\u0438\u0442
      \u0440\u044F\u0434\u043E\u043C, \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442. \xAB\u0412\u0441\u0451
      \u0433\u043E\u0442\u043E\u0432\u043E. \u041E\u0434\u0438\u043D \u0448\u0430\u0433
      \u2014 \u0438 \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C
      \u043F\u0440\u043E\u0439\u0434\u0435\u043D.\xBB \u041E\u043D \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u0432\u0430\u043C. \xAB\u0412\u0445\u043E\u0434\u0438\u043C?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856301223937
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856301223938
    m_Localized: "\u0412\u044B \u043F\u0435\u0440\u0435\u0441\u0442\u0443\u043F\u0430\u0435\u0442\u0435
      \u043F\u043E\u0440\u043E\u0433 \u0412\u0435\u043B\u0438\u043A\u0438\u0445 \u0412\u0440\u0430\u0442
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0412\u0430\u0445\u0443-\u041C\u0430\u043D\u043E\u043C.
      \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C \u043F\u0440\u043E\u0439\u0434\u0435\u043D.
      \u0413\u0438\u043B\u044C\u0434\u0438\u044F \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      \u0437\u0430\u0439\u043C\u0451\u0442 \u0441\u0432\u043E\u0451 \u043C\u0435\u0441\u0442\u043E
      \u043D\u0430 \u043A\u0430\u0440\u0442\u0430\u0445 \u043C\u0438\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856301223939
    m_Localized: "\u041F\u0435\u0441\u0447\u0430\u043D\u0430\u044F \u0431\u0443\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856301223940
    m_Localized: "\u0427\u0451\u0440\u043D\u0430\u044F \u0441\u0442\u0435\u043D\u0430
      \u043F\u0435\u0441\u043A\u0430 \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0430\u0441\u044C
      \u043D\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D. \u041A\u043E\u0433\u0434\u0430
      \u0431\u0443\u0440\u044F \u0441\u0442\u0438\u0445\u043B\u0430, \u043D\u0438
      \u043C\u0435\u0448\u043A\u0430 \u0441 \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0435\u0439
      \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u2014 \u0432\u0441\u0451
      \u0443\u043D\u0435\u0441\u0435\u043D\u043E \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u044E.
      \u0413\u043E\u043B\u043E\u0434 \u043D\u0435\u0438\u0437\u0431\u0435\u0436\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856301223941
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0443\u0434\u044C\u0431\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418240
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u0443\u0433\u0430\u0441\u0430\u0435\u0442 \u0432 \u043F\u0435\u0441\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418241
    m_Localized: "\u041D\u0430\u0448\u0435\u0441\u0442\u0432\u0438\u0435 \u0441\u0430\u0440\u0430\u043D\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418242
    m_Localized: "\u0422\u0451\u043C\u043D\u0430\u044F \u0442\u0443\u0447\u0430 \u043D\u0430\u043A\u0440\u044B\u043B\u0430
      \u043D\u0435\u0431\u043E \u2014 \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u044B
      \u0441\u0430\u0440\u0430\u043D\u0447\u0438 \u0432 \u0441\u0447\u0438\u0442\u0430\u043D\u043D\u044B\u0435
      \u0447\u0430\u0441\u044B \u043F\u043E\u0436\u0440\u0430\u043B\u0438 \u0432\u0441\u0435
      \u0437\u0430\u043F\u0430\u0441\u044B. \u0422\u044E\u043A\u0438 \u0441 \u0437\u0435\u0440\u043D\u043E\u043C,
      \u0432\u044F\u043B\u0435\u043D\u043E\u0435 \u043C\u044F\u0441\u043E, \u0441\u0443\u0448\u0451\u043D\u044B\u0435
      \u0444\u0440\u0443\u043A\u0442\u044B \u2014 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C. \u0411\u0435\u0437
      \u0435\u0434\u044B \u0434\u043E\u0440\u043E\u0433\u0443 \u043D\u0435 \u043F\u0440\u043E\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418243
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0443\u0434\u044C\u0431\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418244
    m_Localized: "\u041E\u043F\u0443\u0441\u0442\u043E\u0448\u0451\u043D\u043D\u044B\u0439
      \u043E\u0431\u043E\u0437 \u0437\u0430\u043C\u0438\u0440\u0430\u0435\u0442 \u043F\u043E\u0441\u0440\u0435\u0434\u0438
      \u043F\u0443\u0441\u0442\u043E\u0433\u043E \u043F\u043E\u043B\u044F. \u0418\u0434\u0442\u0438
      \u043D\u0435\u043A\u0443\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418245
    m_Localized: "\u041E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F
      \u0432\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418246
    m_Localized: "\u041F\u0440\u0438\u0432\u0430\u043B \u0443 \u0440\u043E\u0434\u043D\u0438\u043A\u0430
      \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0431\u0435\u0434\u043E\u0439
      \u2014 \u0432\u043E\u0434\u0430 \u043E\u0442\u0434\u0430\u0432\u0430\u043B\u0430
      \u0433\u043E\u0440\u0435\u0447\u044C\u044E, \u043D\u043E \u0443\u0441\u0442\u0430\u043B\u044B\u0435
      \u043B\u044E\u0434\u0438 \u043F\u0438\u043B\u0438. \u041D\u0430\u0443\u0442\u0440\u043E
      \u0432\u0441\u0435 \u0437\u0430\u043F\u0430\u0441\u044B \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0432\u044B\u0431\u0440\u043E\u0441\u0438\u0442\u044C: \u043E\u0430\u0437\u0438\u0441
      \u0431\u044B\u043B \u043E\u0442\u0440\u0430\u0432\u043B\u0435\u043D. \u041F\u0443\u0441\u0442\u044B\u0435
      \u0444\u043B\u044F\u0433\u0438 \u0438 \u043E\u0431\u0435\u0441\u0441\u0438\u043B\u0435\u0432\u0448\u0438\u0435
      \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u0438 \u2014 \u0432\u043E\u0442
      \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043E\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418247
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0443\u0434\u044C\u0431\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418248
    m_Localized: "\u0421\u0438\u043B\u044B \u043F\u043E\u043A\u0438\u043D\u0443\u043B\u0438
      \u043B\u044E\u0434\u0435\u0439. \u041F\u0443\u0442\u044C \u043E\u043A\u043E\u043D\u0447\u0435\u043D
      \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418249
    m_Localized: "\u041A\u0440\u0435\u0434\u0438\u0442\u043E\u0440\u044B \u043F\u0440\u0438\u0448\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418250
    m_Localized: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u0443
      \u0432\u043E\u0440\u043E\u0442 \u043B\u0430\u0433\u0435\u0440\u044F \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C
      \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0435 \u043B\u044E\u0434\u0438
      \u0441 \u0432\u0435\u043A\u0441\u0435\u043B\u044F\u043C\u0438. \u0414\u043E\u043B\u0433\u0438
      \u043D\u0430\u043A\u043E\u043F\u0438\u043B\u0438\u0441\u044C \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0434\u0430\u0432\u043D\u043E \u2014 \u043A\u0443\u043F\u0435\u0446 \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0442\u044C
      \u0440\u0430\u0441\u043F\u043B\u0430\u0442\u0443. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u043C\u043E\u043D\u0435\u0442\u044B \u0443\u0445\u043E\u0434\u044F\u0442 \u0432
      \u0447\u0443\u0436\u0438\u0435 \u0440\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418251
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u0432\u0441\u0451"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418252
    m_Localized: "\u041F\u0443\u0441\u0442\u0430\u044F \u043A\u0430\u0437\u043D\u0430.
      \u0422\u043E\u0440\u0433\u043E\u0432\u043E\u0435 \u0434\u0435\u043B\u043E \u043F\u043E\u0433\u0443\u0431\u043B\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418253
    m_Localized: "\u041E\u0433\u0440\u0430\u0431\u043B\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418254
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u0432 \u043B\u0430\u0433\u0435\u0440\u044C
      \u043F\u0440\u043E\u043D\u0438\u043A\u043B\u0438 \u0432\u043E\u0440\u044B.
      \u041E\u0445\u0440\u0430\u043D\u0430 \u043D\u0435 \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0430
      \u2014 \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0443\u0441\u0442\u0430\u043B\u0430.
      \u041A\u043E\u0433\u0434\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u043B\u043E,
      \u043A\u043E\u0448\u0435\u043B\u0438 \u0441 \u043C\u043E\u043D\u0435\u0442\u0430\u043C\u0438
      \u0438\u0441\u0447\u0435\u0437\u043B\u0438. \u0412\u0441\u0435 \u0434\u043E
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u0434\u0438\u0440\u0445\u0430\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418255
    m_Localized: "\u041F\u0440\u0438\u0437\u043D\u0430\u0442\u044C \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418256
    m_Localized: "\u0411\u0435\u0437 \u0434\u0435\u043D\u0435\u0433 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0437\u0430\u043A\u0440\u044B\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418257
    m_Localized: "\u041A\u043E\u043D\u0444\u0438\u0441\u043A\u0430\u0446\u0438\u044F
      \u0442\u043E\u0432\u0430\u0440\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418258
    m_Localized: "\u0422\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u044B\u0439 \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u043B \u0434\u043E\u043B\u0433\u043E\u0432\u044B\u0435
      \u0433\u0440\u0430\u043C\u043E\u0442\u044B \u0438 \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043B
      \u0432\u0441\u0435 \u0442\u044E\u043A\u0438. \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C \u0432\u043E\u0437\u043C\u043E\u0436\u0435\u043D \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u0440\u0438 \u043D\u0430\u043B\u0438\u0447\u0438\u0438 \u043A\u0430\u0437\u043D\u044B
      \u2014 \u043D\u043E \u043A\u0430\u0437\u043D\u0430 \u043F\u0443\u0441\u0442\u0430.
      \u0422\u043E\u0432\u0430\u0440\u044B \u0430\u0440\u0435\u0441\u0442\u043E\u0432\u0430\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418259
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u0441\u0443\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418260
    m_Localized: "\u041E\u043F\u0443\u0441\u0442\u0435\u0432\u0448\u0438\u0439 \u043E\u0431\u043E\u0437
      \u0441\u0442\u043E\u0438\u0442 \u0443 \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418261
    m_Localized: "\u0411\u0443\u0440\u044F \u0440\u0430\u0437\u0431\u0438\u043B\u0430
      \u043E\u0431\u043E\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418262
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u0443\u0440\u0430\u0433\u0430\u043D
      \u043D\u0430\u043B\u0435\u0442\u0435\u043B \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F.
      \u0422\u0435\u043B\u0435\u0433\u0438 \u0448\u0432\u044B\u0440\u044F\u043B\u043E
      \u043E \u0441\u043A\u0430\u043B\u044B, \u0432\u0435\u0440\u0451\u0432\u043A\u0438
      \u043B\u043E\u043F\u0430\u043B\u0438\u0441\u044C \u043A\u0430\u043A \u043D\u0438\u0442\u0438.
      \u041A\u043E\u0433\u0434\u0430 \u0432\u0435\u0442\u0435\u0440 \u0441\u0442\u0438\u0445,
      \u043E\u0442 \u043E\u0431\u043E\u0437\u0430 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C
      \u043B\u0438\u0448\u044C \u0449\u0435\u043F\u0430 \u0434\u0430 \u0440\u0430\u0437\u0431\u0440\u043E\u0441\u0430\u043D\u043D\u044B\u0439
      \u043F\u043E \u043A\u0430\u043C\u043D\u044F\u043C \u0442\u043E\u0432\u0430\u0440.
      \u0418\u0434\u0442\u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435
      \u043D\u0430 \u0447\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418263
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0443\u0434\u044C\u0431\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418264
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u0442\u044B\u0439 \u043E\u0431\u043E\u0437
      \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u044C\u044F
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418265
    m_Localized: "\u041C\u043E\u0440\u043E\u0432\u0430\u044F \u0431\u043E\u043B\u0435\u0437\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418266
    m_Localized: "\u0411\u043E\u043B\u0435\u0437\u043D\u044C \u043F\u0440\u0438\u0448\u043B\u0430
      \u043D\u0435\u0437\u0430\u043C\u0435\u0442\u043D\u043E \u2014 \u0441\u043D\u0430\u0447\u0430\u043B\u0430
      \u0436\u0430\u0440, \u043F\u043E\u0442\u043E\u043C \u0431\u0440\u0435\u0434.
      \u0417\u0430 \u043D\u0435\u0434\u0435\u043B\u044E \u044D\u043F\u0438\u0434\u0435\u043C\u0438\u044F
      \u043E\u043F\u0443\u0441\u0442\u043E\u0448\u0438\u043B\u0430 \u0440\u044F\u0434\u044B
      \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432. \u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u0437\u0434\u043E\u0440\u043E\u0432\u044B\u0435 \u0440\u0430\u0437\u0431\u0435\u0436\u0430\u043B\u0438\u0441\u044C,
      \u043D\u0435 \u0434\u043E\u0436\u0438\u0434\u0430\u044F\u0441\u044C \u0441\u0432\u043E\u0435\u0439
      \u043E\u0447\u0435\u0440\u0435\u0434\u0438. \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C \u0431\u0435\u0437 \u043B\u044E\u0434\u0435\u0439
      \u2014 \u043D\u0435 \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418267
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0443\u0434\u044C\u0431\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418268
    m_Localized: "\u041E\u0434\u0438\u043D\u043E\u043A\u0438\u0439 \u043A\u0443\u043F\u0435\u0446
      \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043F\u043E\u0441\u0440\u0435\u0434\u0438
      \u043E\u043F\u0443\u0441\u0442\u0435\u0432\u0448\u0435\u0439 \u0434\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418269
    m_Localized: "\u041B\u0430\u0432\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418270
    m_Localized: "\u0413\u0440\u043E\u0445\u043E\u0442 \u0440\u0430\u0437\u0434\u0430\u043B\u0441\u044F
      \u0441\u0432\u0435\u0440\u0445\u0443 \u2014 \u0438 \u0441\u043D\u0435\u0436\u043D\u0430\u044F
      \u043C\u0430\u0441\u0441\u0430 \u043D\u0430\u043A\u0440\u044B\u043B\u0430 \u0443\u0449\u0435\u043B\u044C\u0435.
      \u041A\u043E\u0433\u0434\u0430 \u043F\u0440\u0438\u0448\u043B\u0438 \u0432\u044B\u0436\u0438\u0432\u0448\u0438\u0435
      \u0438\u0437 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0433\u043E \u043E\u0442\u0440\u044F\u0434\u0430,
      \u043E\u0442\u043A\u0430\u043F\u044B\u0432\u0430\u0442\u044C \u0431\u044B\u043B\u043E
      \u043D\u0435\u043A\u043E\u0433\u043E. \u041E\u0431\u043E\u0437 \u043F\u043E\u0433\u0440\u0435\u0431\u0451\u043D
      \u0432 \u0433\u043E\u0440\u0430\u0445 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418271
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0443\u0434\u044C\u0431\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418272
    m_Localized: "\u0413\u043E\u0440\u044B \u043D\u0435 \u043E\u0442\u0434\u0430\u044E\u0442
      \u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418273
    m_Localized: "\u0411\u0443\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418274
    m_Localized: "\u0414\u043E\u043B\u0433\u0438\u0435 \u043B\u0438\u0448\u0435\u043D\u0438\u044F
      \u043F\u0435\u0440\u0435\u043F\u043E\u043B\u043D\u0438\u043B\u0438 \u0447\u0430\u0448\u0443.
      \u0421\u043F\u0443\u0442\u043D\u0438\u043A\u0438 \u043E\u043A\u0440\u0443\u0436\u0438\u043B\u0438
      \u043A\u0443\u043F\u0446\u0430 \u0443 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u0433\u043E
      \u043E\u0433\u043D\u044F \u2014 \u043B\u0438\u0446\u0430 \u0443\u0433\u0440\u044E\u043C\u044B,
      \u0440\u0443\u043A\u0438 \u0441\u0436\u0430\u0442\u044B. \u0421\u043B\u043E\u0432\u0430
      \u043A\u043E\u043D\u0447\u0438\u043B\u0438\u0441\u044C, \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F
      \u0443\u043B\u044C\u0442\u0438\u043C\u0430\u0442\u0438\u0432\u043D\u044B. \u0412\u043B\u0430\u0441\u0442\u044C
      \u043D\u0430\u0434 \u043E\u0431\u043E\u0437\u043E\u043C \u0443\u0442\u0440\u0430\u0447\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418275
    m_Localized: "\u041E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418276
    m_Localized: "\u0411\u0443\u043D\u0442\u043E\u0432\u0449\u0438\u043A\u0438 \u0440\u0430\u0437\u0433\u043E\u043D\u044F\u044E\u0442
      \u043E\u0431\u043E\u0437 \u043F\u043E \u0432\u0435\u0442\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418277
    m_Localized: "\u0414\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u0441\u0442\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418278
    m_Localized: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u043B\u0430\u0433\u0435\u0440\u044C
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043F\u0443\u0441\u0442.
      \u041B\u044E\u0434\u0438 \u0443\u0448\u043B\u0438 \u043D\u043E\u0447\u044C\u044E
      \u2014 \u0442\u0438\u0445\u043E, \u0431\u0435\u0437 \u043A\u0440\u0438\u043A\u043E\u0432,
      \u0432\u0437\u044F\u0432 \u0447\u0430\u0441\u0442\u044C \u0437\u0430\u043F\u0430\u0441\u043E\u0432.
      \u041E\u0441\u0442\u0430\u0432\u0448\u0438\u0439\u0441\u044F \u043A\u0443\u043F\u0435\u0446
      \u0441\u0442\u043E\u0438\u0442 \u043F\u0435\u0440\u0435\u0434 \u043F\u043E\u0442\u0443\u0445\u0448\u0438\u043C
      \u043A\u043E\u0441\u0442\u0440\u043E\u043C \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0435.
      \u0411\u0435\u0437 \u043B\u044E\u0434\u0435\u0439 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0431\u0435\u0441\u0441\u043C\u044B\u0441\u043B\u0435\u043D\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418279
    m_Localized: "\u041F\u0440\u0438\u0437\u043D\u0430\u0442\u044C \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418280
    m_Localized: "\u041E\u0431\u043E\u0437 \u0431\u0440\u043E\u0448\u0435\u043D.
      \u041F\u0443\u0442\u044C \u043F\u0440\u0435\u0440\u0432\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418281
    m_Localized: "\u0413\u0438\u0431\u0435\u043B\u044C \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418282
    m_Localized: "\u0421\u0440\u0435\u0434\u0438 \u043D\u043E\u0447\u0438 \u0448\u0451\u043F\u043E\u0442
      \u0438 \u0442\u0435\u043D\u0438 \u0443 \u0448\u0430\u0442\u0440\u0430. \u0423\u0442\u0440\u043E\u043C
      \u043A\u0443\u043F\u0435\u0446 \u043D\u0435 \u0432\u0441\u0442\u0430\u043B
      \u2014 \u043D\u0430\u0448\u043B\u0438 \u0435\u0433\u043E \u0443 \u043F\u043E\u0445\u043E\u0434\u043D\u043E\u0439
      \u043A\u0440\u043E\u0432\u0430\u0442\u0438. \u0423\u0431\u0438\u0439\u0446\u044B
      \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C \u0432
      \u043D\u043E\u0447\u0438 \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043A\u0430\u0437\u043D\u043E\u0439.
      \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C \u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418283
    m_Localized: "\u041A\u043E\u043D\u0435\u0446 \u043F\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 28642856305418284
    m_Localized: "\u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C
      \u0436\u0435\u0441\u0442\u043E\u043A \u043A \u0441\u043B\u0430\u0431\u044B\u043C
      \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777125122048
    m_Localized: "\u041B\u0435\u0447\u044C \u0433\u043E\u043B\u043E\u0434\u0430\u0442\u044C
      \u0441\u043E \u0432\u0441\u0435\u043C\u0438. \u041A\u043E\u043D\u0435\u0446
      \u043F\u043E\u0445\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870784
    m_Localized: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u043B\u0430\u0433\u0435\u0440\u044C
      \u043D\u0435 \u0432\u0441\u0442\u0430\u043B. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0432 \u043F\u0435\u0441\u043A\u0430\u0445
      \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870785
    m_Localized: "\u041F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u0442\u044C \u0442\u043E\u0440\u0433.
      \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C \u043E\u043A\u043E\u043D\u0447\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870786
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u043D\u0438 \u0441 \u0447\u0435\u043C. \u0413\u043E\u043B\u043E\u0434 \u0434\u043E\u0433\u043E\u043D\u044F\u0435\u0442
      \u043D\u0430 \u043F\u0443\u0442\u0438 \u043D\u0430\u0437\u0430\u0434. \u041D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0434\u043E\u0445\u043E\u0434\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870787
    m_Localized: "\u041E\u0431\u044A\u044F\u0432\u0438\u0442\u044C \u0441\u0435\u0431\u044F
      \u0431\u0430\u043D\u043A\u0440\u043E\u0442\u043E\u043C. \u041F\u043E\u0445\u043E\u0434
      \u043E\u043A\u043E\u043D\u0447\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870788
    m_Localized: "\u041A\u0440\u0435\u0434\u0438\u0442\u043E\u0440\u044B \u0437\u0430\u0431\u0438\u0440\u0430\u044E\u0442
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0438 \u0442\u043E\u0432\u0430\u0440\u044B.
      \u0414\u0430\u043B\u044C\u0448\u0435 \u0438\u0434\u0442\u0438 \u043D\u0435
      \u043D\u0430 \u0447\u0435\u043C. \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C \u0437\u0430\u043A\u0440\u044B\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870789
    m_Localized: "\u041F\u0440\u0438\u0437\u043D\u0430\u0442\u044C \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u0435.
      \u041F\u0443\u0442\u044C \u043E\u043A\u043E\u043D\u0447\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870790
    m_Localized: "\u0412\u043E\u0440\u044B \u0443\u043D\u0435\u0441\u043B\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u043C\u043E\u043D\u0435\u0442\u044B. \u0411\u0435\u0437 \u0434\u0435\u043D\u0435\u0433
      \u043D\u0435 \u043F\u0440\u043E\u0439\u0442\u0438 \u043D\u0438 \u043E\u0434\u043D\u043E\u0439
      \u0437\u0430\u0441\u0442\u0430\u0432\u044B. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0431\u0440\u043E\u0448\u0435\u043D \u043D\u0430 \u043F\u043E\u043B\u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870791
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0432\u0441\u0435\u0445
      \u0438 \u0441\u0434\u0430\u0442\u044C\u0441\u044F. \u041A\u043E\u043D\u0435\u0446
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870792
    m_Localized: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u043B\u0430\u0433\u0435\u0440\u044C
      \u043F\u0443\u0441\u0442. \u041A\u0443\u043F\u0435\u0446 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u0431\u0435\u0437 \u0440\u0443\u043A, \u0431\u0435\u0437 \u043F\u043E\u0432\u043E\u0437\u043E\u043A,
      \u0431\u0435\u0437 \u043D\u0430\u0434\u0435\u0436\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870793
    m_Localized: "\u0421\u0434\u0430\u0442\u044C\u0441\u044F \u0448\u0451\u043F\u043E\u0442\u0443.
      \u041F\u0443\u0442\u044C \u043E\u043A\u043E\u043D\u0447\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870794
    m_Localized: "\u041A \u0443\u0442\u0440\u0443 \u0432 \u043B\u0430\u0433\u0435\u0440\u0435
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0442\u0438\u0448\u0438\u043D\u0430 \u0438 \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439
      \u043A\u043E\u0441\u0442\u0451\u0440. \u041D\u0438\u043A\u0442\u043E \u043D\u0435
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870795
    m_Localized: "\u041D\u0435 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u044F\u0442\u044C\u0441\u044F.
      \u041A\u043E\u043D\u0435\u0446 \u043F\u043E\u0445\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777162870796
    m_Localized: "\u0411\u0443\u043D\u0442\u043E\u0432\u0449\u0438\u043A\u0438 \u0443\u0432\u043E\u0434\u044F\u0442
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0438 \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432
      \u0432 \u043D\u043E\u0447\u044C. \u041A\u0443\u043F\u0435\u0446 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u043E\u0434\u0438\u043D \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777183842304
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0433\u043E\u043B\u043E\u0434.
      \u041A\u043E\u043D\u0435\u0446 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777183842305
    m_Localized: "\u041E\u0434\u0438\u043D \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u043C
      \u043F\u0443\u0442\u043D\u0438\u043A\u0438 \u043F\u0430\u0434\u0430\u044E\u0442
      \u0432 \u043F\u0435\u0441\u043A\u0438. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0443\u0433\u0430\u0441\u0430\u0435\u0442 \u0431\u0435\u0437\u043C\u043E\u043B\u0432\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777183842306
    m_Localized: "\u0421\u043B\u043E\u0436\u0438\u0442\u044C \u043F\u043E\u043B\u043D\u043E\u043C\u043E\u0447\u0438\u044F.
      \u041F\u043E\u0445\u043E\u0434 \u043E\u043A\u043E\u043D\u0447\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777183842307
    m_Localized: "\u041D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0438 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u044E\u0442
      \u0442\u044E\u043A\u0438 \u0438 \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F.
      \u041A\u0443\u043F\u0435\u0446 \u043E\u0434\u0438\u043D \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435,
      \u0431\u0435\u0437 \u0433\u0440\u0443\u0437\u0430 \u0438 \u0431\u0435\u0437
      \u0441\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 28649777183842308
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u0432\u0441\u0451 \u0437\u0430
      \u0434\u043E\u043B\u0433\u0438. \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C \u0437\u0430\u043A\u0440\u044B\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 28649777183842309
    m_Localized: "\u0417\u0430\u0438\u043C\u043E\u0434\u0430\u0432\u0435\u0446 \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0446\u0435\u043B\u0438\u043A\u043E\u043C.
      \u041A\u0443\u043F\u0435\u0446 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0434\u043E\u043C\u043E\u0439 \u043F\u0435\u0448\u043A\u043E\u043C \u0438
      \u0431\u0435\u0437 \u0433\u0440\u043E\u0448\u0430."
    m_Metadata:
      m_Items: []
