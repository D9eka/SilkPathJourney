  - m_Id: 651148099838029
    m_Localized: "\u0413\u0440\u0443\u0437 \u043F\u0435\u0440\u0435\u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B\u0438
      \u043C\u0435\u0436\u0434\u0443 \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u043C\u0438\u0441\u044F
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u043C\u0438. \u0418\u0434\u0443\u0442
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838030
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0440\u0432\u0430\u043B\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u043A\u043E\u043B\u044C\u0446\u043E \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432
      \u0441 \u043F\u043E\u0442\u0435\u0440\u044F\u043C\u0438. \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0442\u044E\u043A\u043E\u0432 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E
      \u0432 \u0431\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838031
    m_Localized: "\u0411\u0430\u043D\u0434\u0438\u0442\u044B \u0437\u0430\u0431\u0440\u0430\u043B\u0438
      \u0447\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430 \u0438 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438.
      \u041B\u044E\u0434\u0438 \u0446\u0435\u043B\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838032
    m_Localized: "\u0423\u0434\u0430\u043B\u043E\u0441\u044C \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u2014 \u0431\u0430\u043D\u0434\u0438\u0442\u044B \u0432\u0437\u044F\u043B\u0438
      \u043E\u0442\u043A\u0443\u043F \u0438 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D. \u041C\u043E\u0433\u043B\u043E
      \u0431\u044B\u0442\u044C \u0445\u0443\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838033
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0434\u043E\u043B\u0433\u0438\u0445
      \u043F\u043E\u0438\u0441\u043A\u043E\u0432 \u043D\u0430\u0439\u0434\u0435\u043D
      \u0441\u043A\u0440\u044B\u0442\u044B\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A.
      \u0411\u0443\u0440\u0434\u044E\u043A\u0438 \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u044B
      \u2014 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0441\u043F\u0430\u0441\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838034
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u043D\u044B\u0435 \u043F\u0443\u0442\u043D\u0438\u043A\u0438
      \u043F\u0440\u043E\u0434\u0430\u043B\u0438 \u0432\u043E\u0434\u0443 \u0432\u0442\u0440\u0438\u0434\u043E\u0440\u043E\u0433\u0430.
      \u0414\u043E\u0440\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838035
    m_Localized: "\u0412\u043E\u0434\u0443 \u044D\u043A\u043E\u043D\u043E\u043C\u044F\u0442
      \u043F\u043E \u043A\u0430\u043F\u043B\u044F\u043C. \u041B\u044E\u0434\u0438
      \u0441\u0442\u0440\u0430\u0434\u0430\u044E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838036
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u044B\u0445 \u0438\u0437\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043B\u0438.
      \u0411\u043E\u043B\u0435\u0437\u043D\u044C \u043D\u0435 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0438\u043B\u0430\u0441\u044C
      \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838037
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u043B
      \u0441\u043D\u0430\u0434\u043E\u0431\u044C\u044F \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u0431\u043E\u043B\u044C\u043D\u044B\u0445 \u043D\u0430 \u043D\u043E\u0433\u0438.
      \u0415\u0433\u043E \u0443\u0441\u043B\u0443\u0433\u0438 \u043E\u0431\u043E\u0448\u043B\u0438\u0441\u044C
      \u043D\u0435\u0434\u0451\u0448\u0435\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838038
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838039
    m_Localized: "\u0413\u0440\u0443\u0437 \u0431\u0440\u043E\u0448\u0435\u043D \u043F\u043E\u0441\u0440\u0435\u0434\u0438
      \u043F\u0443\u0441\u0442\u043E\u0448\u0438. \u041D\u0430\u043B\u0435\u0433\u043A\u0435
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838040
    m_Localized: "\u041E\u0442\u0447\u0430\u044F\u043D\u043D\u044B\u0439 \u0431\u043E\u0439
      \u2014 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u044B\u0441\u0442\u043E\u044F\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838041
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u043B\u0441\u044F.
      \u0427\u0430\u0441\u0442\u044C \u0443\u0448\u043B\u0430 \u043D\u0430 \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838042
    m_Localized: "\u0412 \u043E\u0442\u0447\u0430\u044F\u043D\u043D\u043E\u043C \u0431\u043E\u044E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0442\u0431\u0438\u043B\u0441\u044F.
      \u0412\u044B\u0436\u0438\u0432\u0448\u0438\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0442
      \u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838043
    m_Localized: "\u0421\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435
      \u0431\u0435\u0441\u043F\u043E\u043B\u0435\u0437\u043D\u043E \u2014 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0441\u0434\u0430\u043B\u0441\u044F. \u041D\u0430\u043F\u0430\u0434\u0430\u0432\u0448\u0438\u0435
      \u0437\u0430\u0431\u0440\u0430\u043B\u0438 \u0432\u0441\u0451 \u0446\u0435\u043D\u043D\u043E\u0435
      \u0438 \u0443\u0448\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838044
    m_Localized: "\u041F\u043E\u0434 \u043F\u043E\u043A\u0440\u043E\u0432\u043E\u043C
      \u0445\u0430\u043E\u0441\u0430 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0431\u0435\u0436\u0430\u0442\u044C.
      \u0427\u0430\u0441\u0442\u044C \u043B\u044E\u0434\u0435\u0439 \u0438 \u0433\u0440\u0443\u0437\u0430
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838045
    m_Localized: "\u0414\u0438\u043A\u0438\u0435 \u0437\u0432\u0435\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838046
    m_Localized: "\u0421\u0442\u0438\u0445\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838047
    m_Localized: "\u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838048
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838049
    m_Localized: "\u041F\u043E\u043B\u043E\u043C\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838050
    m_Localized: "\u041D\u0430\u0445\u043E\u0434\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838051
    m_Localized: "\u0421\u043F\u0443\u0442\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099838052
    m_Localized: "\u041A\u0440\u0438\u0437\u0438\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 4296128710303744
    m_Localized: "\u0417\u0430\u0440\u043E\u0441\u0448\u0430\u044F \u0442\u0440\u043E\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 4296128756441088
    m_Localized: "\u0421\u043A\u0432\u043E\u0437\u044C \u0433\u0443\u0441\u0442\u044B\u0435
      \u0437\u0430\u0440\u043E\u0441\u043B\u0438 \u043F\u0440\u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442
      \u0441\u0442\u0430\u0440\u0430\u044F, \u043F\u043E\u0447\u0442\u0438 \u0437\u0430\u0431\u044B\u0442\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430. \u0412\u044B\u0431\u043E\u0438\u043D\u044B
      \u043E\u0442 \u043A\u043E\u043B\u0451\u0441 \u0434\u0430\u0432\u043D\u043E
      \u0437\u0430\u0440\u043E\u0441\u043B\u0438 \u0442\u0440\u0430\u0432\u043E\u0439,
      \u043D\u043E \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u0435\u0449\u0451 \u0443\u0433\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F.
      \u041C\u0435\u0441\u0442\u043D\u044B\u0435 \u043E\u0431\u0445\u043E\u0434\u044F\u0442
      \u044D\u0442\u043E \u043C\u0435\u0441\u0442\u043E \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439
      - \u0433\u043E\u0432\u043E\u0440\u044F\u0442, \u043F\u0443\u0442\u044C \u043E\u043F\u0430\u0441\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 4296128756441089
    m_Localized: "\u0420\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 4296128756441090
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0441\u043A\u0432\u043E\u0437\u044C \u0437\u0430\u0440\u043E\u0441\u043B\u0438.
      \u0417\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u043C \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043F\u0440\u0438\u0433\u043E\u0434\u043D\u044B\u0439 \u0434\u043B\u044F \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      \u0442\u0440\u0430\u043A\u0442 - \u043D\u043E\u0432\u044B\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u043D\u0430\u0439\u0434\u0435\u043D!"
    m_Metadata:
      m_Items: []
  - m_Id: 4296128756441091
    m_Localized: "\u041D\u0435 \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 4296128756441092
    m_Localized: "\u0412\u044B \u0440\u0435\u0448\u0430\u0435\u0442\u0435 \u043D\u0435
      \u0441\u0445\u043E\u0434\u0438\u0442\u044C \u0441 \u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438. \u0417\u0430\u0440\u043E\u0441\u0448\u0430\u044F
      \u0442\u0440\u043E\u043F\u0430 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043F\u043E\u0437\u0430\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 4296128756441093
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 4296128756441094
    m_Localized: "\u0421\u0435\u0434\u043E\u0439 \u0441\u0442\u0430\u0440\u0438\u043A
      \u0432 \u043F\u044B\u043B\u044C\u043D\u043E\u043C \u0445\u0430\u043B\u0430\u0442\u0435
      \u0441\u0438\u0434\u0438\u0442 \u0443 \u043E\u0431\u043E\u0447\u0438\u043D\u044B,
      \u0447\u0435\u0440\u0442\u044F \u043F\u0430\u043B\u043A\u043E\u0439 \u043D\u0430
      \u0437\u0435\u043C\u043B\u0435. \u0423\u0432\u0438\u0434\u0435\u0432 \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u043E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u0443
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u0437\u043D\u0430\u0435\u0442
      \u0434\u043E\u0440\u043E\u0433\u0443, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u043D\u0430
      \u043A\u0430\u0440\u0442\u0430\u0445. \u0417\u0430 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0443\u044E
      \u043F\u043B\u0430\u0442\u0443 \u043E\u043D \u0433\u043E\u0442\u043E\u0432
      \u0443\u043A\u0430\u0437\u0430\u0442\u044C \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 4296128756441095
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0438 \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 4296128756441096
    m_Localized: "\u0421\u0442\u0430\u0440\u0438\u043A \u0440\u0438\u0441\u0443\u0435\u0442
      \u043D\u0430 \u043F\u0435\u0441\u043A\u0435 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u0443\u044E
      \u043A\u0430\u0440\u0442\u0443. \u0415\u0433\u043E \u0433\u043B\u0430\u0437\u0430
      \u0431\u043B\u0435\u0441\u0442\u044F\u0442 - \u043E\u043D \u044F\u0432\u043D\u043E
      \u0440\u0430\u0434, \u0447\u0442\u043E \u043A\u0442\u043E-\u0442\u043E \u043D\u0430\u043A\u043E\u043D\u0435\u0446
      \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
      \u0435\u0433\u043E \u0437\u043D\u0430\u043D\u0438\u0435\u043C. \u041D\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C \u043E\u0442\u043A\u0440\u044B\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 4296128756441097
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 4296128756441098
    m_Localized: "\u0421\u0442\u0430\u0440\u0438\u043A \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442
      \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438 \u0441\u043D\u043E\u0432\u0430
      \u0441\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0441\u044F \u043A \u0441\u0432\u043E\u0438\u043C
      \u0440\u0438\u0441\u0443\u043D\u043A\u0430\u043C \u043D\u0430 \u0437\u0435\u043C\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 4296128760635392
    m_Localized: "\u0414\u043E\u043B\u0433 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 4296128760635393
    m_Localized: "\u0411\u044B\u0432\u0430\u043B\u044B\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A
      \u0434\u043E\u0433\u043E\u043D\u044F\u0435\u0442 \u0432\u0430\u0448 \u043E\u0442\u0440\u044F\u0434.
      \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E
      \u043E\u0431\u044F\u0437\u0430\u043D \u0432\u0430\u043C \u0436\u0438\u0437\u043D\u044C\u044E
      - \u0432 \u043F\u0440\u043E\u0448\u043B\u044B\u0439 \u0440\u0430\u0437 \u0432\u044B
      \u043F\u043E\u043C\u043E\u0433\u043B\u0438 \u0435\u0433\u043E \u043B\u044E\u0434\u044F\u043C
      \u043D\u0430 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0435. \u0412
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u043E\u043D \u0433\u043E\u0442\u043E\u0432 \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u0441\u0435\u043A\u0440\u0435\u0442\u043D\u044B\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442,
      \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u0438\u0437\u0431\u0440\u0430\u043D\u043D\u044B\u0435
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 4296128760635394
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 4296128760635395
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043F\u043E\u0442\u0430\u0439\u043D\u0443\u044E \u043A\u0430\u0440\u0442\u0443
      \u0438 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u043E \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
      \u043A\u0430\u0436\u0434\u044B\u0439 \u043F\u043E\u0432\u043E\u0440\u043E\u0442.
      \u0422\u0435\u043F\u0435\u0440\u044C \u044D\u0442\u043E\u0442 \u043F\u0443\u0442\u044C
      \u043E\u0442\u043A\u0440\u044B\u0442 \u0438 \u0434\u043B\u044F \u0432\u0430\u0441!"
    m_Metadata:
      m_Items: []
  - m_Id: 4296128760635396
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 4296128760635397
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F
      \u0438 \u0443\u0445\u043E\u0434\u0438\u0442, \u0443\u043D\u043E\u0441\u044F
      \u0441\u0432\u043E\u0439 \u0441\u0435\u043A\u0440\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 7979484790644736
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 7979484832587776
    m_Localized: "\u0412\u043F\u0435\u0440\u0435\u0434\u0438 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435
      \u0432\u0438\u0434\u043D\u0435\u0435\u0442\u0441\u044F \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \xAB{0}\xBB. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0436\u0435\u0441\u0442\u043E\u043C
      \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u0435\u0442 \u043F\u043E\u0434\u043E\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 7979484832587777
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 7979484832587778
    m_Localized: "\u041D\u0430 \u043F\u0440\u0438\u0432\u0430\u043B\u0435 \u0432\u044B
      \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430
      \u0438\u0437 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \xAB{0}\xBB,
      \u0440\u0430\u0437\u043B\u043E\u0436\u0438\u0432\u0448\u0435\u0433\u043E \u0442\u043E\u0432\u0430\u0440\u044B
      \u043D\u0430 \u043A\u043E\u0432\u0440\u0435. \u041E\u043D \u043F\u0440\u0438\u0432\u0435\u0442\u043B\u0438\u0432\u043E
      \u043A\u0438\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 7979484832587779
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 7979484832587780
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0438 \u0432\u0430\u0448\u0435\u0433\u043E
      \u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \xAB{0}\xBB \u043F\u0435\u0440\u0435\u0441\u0435\u043A\u043B\u0438\u0441\u044C.
      \u0415\u0441\u0442\u044C \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
      \u043E\u0431\u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F \u0442\u043E\u0432\u0430\u0440\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 7979484832587781
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 7979484832587782
    m_Localized: "\u0412\u044B \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0435
      \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 7979484832587783
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 7979484832587784
    m_Localized: "\u0412\u044B \u0432\u0435\u0436\u043B\u0438\u0432\u043E \u043A\u0438\u0432\u043D\u0443\u043B\u0438
      \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B\u0438 \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 9433775275499520
    m_Localized: '{skill_name}: {chance}%'
    m_Metadata:
      m_Items: []
  - m_Id: 9433775325831168
    m_Localized: "\u041F\u043E\u043F\u044B\u0442\u043A\u0430 \u043E\u0431\u043E\u0439\u0442\u0438
      \u043B\u043E\u0432\u0443\u0448\u043A\u0443 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044C
      \u2014 \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u0443\u0432\u044F\u0437\u043B\u0430
      \u0435\u0449\u0451 \u0433\u043B\u0443\u0431\u0436\u0435. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 9433775325831169
    m_Localized: "\u041E\u0431\u0445\u043E\u0434\u043D\u043E\u0439 \u043F\u0443\u0442\u044C
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0442\u0443\u043F\u0438\u043A\u043E\u043C.
      \u041F\u043B\u0430\u043C\u044F \u043D\u0430\u0441\u0442\u0438\u0433\u043B\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u2014 \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0430 \u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u0441\u0433\u043E\u0440\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 9433775325831170
    m_Localized: "\u041D\u0435\u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u0439
      \u0448\u0430\u0433 \u043E\u0431\u0440\u0443\u0448\u0438\u043B \u0447\u0430\u0441\u0442\u044C
      \u0441\u0442\u0435\u043D\u044B. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B \u0441 \u043F\u043E\u0442\u0435\u0440\u044F\u043C\u0438
      \u2014 \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0438\u043D\u044F\u043A\u0438
      \u0438 \u0441\u0442\u0440\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 9433775325831171
    m_Localized: "\u0416\u0435\u0440\u0435\u0431\u0435\u0446 \u0432\u044B\u0440\u0432\u0430\u043B\u0441\u044F
      \u0438 \u0443\u0434\u0430\u0440\u0438\u043B \u043A\u043E\u043F\u044B\u0442\u043E\u043C.
      \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0440\u0430\u043D\u0435\u043D\u044B \u2014 \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 9433775325831172
    m_Localized: "\u0417\u043D\u0430\u043A\u0438 \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u043B\u043E\u0432\u0443\u0448\u043A\u043E\u0439. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u043E\u043F\u0430\u043B \u0432 \u0437\u0430\u0441\u0430\u0434\u0443
      \u2014 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0434\u0435\u043D\u044C\u0433\u0438
      \u0438 \u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 9433775325831173
    m_Localized: "\u0422\u0435\u0447\u0435\u043D\u0438\u0435 \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0441\u0438\u043B\u044C\u043D\u044B\u043C,
      \u043D\u044B\u0440\u044F\u043B\u044C\u0449\u0438\u043A\u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u043D\u0438 \u0441 \u0447\u0435\u043C. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0432\u0440\u0435\u043C\u044F \u0438 \u043F\u0440\u0438\u043F\u0430\u0441\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 9433775325831174
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0438\u0441\u044C
      \u2014 \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u044B \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0438\u0441\u044C
      \u043C\u043E\u043C\u0435\u043D\u0442\u043E\u043C \u0438 \u0443\u0432\u0435\u043B\u0438
      \u043A\u043B\u0438\u0435\u043D\u0442\u043E\u0432. \u0423\u0431\u044B\u0442\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 9433775325831175
    m_Localized: "\u041D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0435\u0446 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043C\u043E\u0448\u0435\u043D\u043D\u0438\u043A\u043E\u043C. \u0417\u0430\u0431\u0440\u0430\u043B
      \u0434\u0435\u043D\u044C\u0433\u0438 \u0438 \u0441\u043A\u0440\u044B\u043B\u0441\u044F
      \u0432 \u043D\u043E\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 9433775325831176
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0438\u0441\u044C
      \u2014 \u0431\u0430\u043D\u0434\u0438\u0442\u044B \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u0438
      \u0431\u043E\u043B\u044C\u0448\u0435. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043E\u0442\u0434\u0430\u0442\u044C \u043F\u043E\u0447\u0442\u0438 \u0432\u0441\u0451."
    m_Metadata:
      m_Items: []
