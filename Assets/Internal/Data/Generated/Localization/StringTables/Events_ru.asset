    m_Localized: "\u0414\u0440\u0435\u0432\u043D\u0438\u0439 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439
      \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C \u043E\u0442\u043C\u0435\u0447\u0430\u0435\u0442
