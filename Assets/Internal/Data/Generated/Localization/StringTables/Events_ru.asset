    m_Localized: "\u041B\u0435\u0441\u043E\u0440\u0443\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255051
    m_Localized: "\u0423 \u043E\u0431\u043E\u0447\u0438\u043D\u044B \u0441\u0442\u043E\u0438\u0442
      \u043A\u0440\u0435\u043F\u043A\u0438\u0439 \u043C\u0443\u0436\u0438\u043A \u0441
      \u0442\u043E\u043F\u043E\u0440\u043E\u043C \u0438 \u043C\u0430\u0448\u0435\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443. \u0420\u044F\u0434\u043E\u043C
      \u2014 \u0434\u043E\u0431\u0440\u043E\u0442\u043D\u0430\u044F \u0445\u0438\u0436\u0438\u043D\u0430
      \u0438 \u0433\u043E\u0440\u0430 \u0441\u0432\u0435\u0436\u0438\u0445 \u0431\u0440\u0451\u0432\u0435\u043D.
      \u041E\u043D \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u043F\u043E\u043C\u043E\u0449\u044C."
    m_Metadata:
      m_Items: []
