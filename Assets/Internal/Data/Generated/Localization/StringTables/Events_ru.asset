      m_Items: []
  - m_Id: 651148087255040
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255041
    m_Localized: "\u0426\u0435\u043B\u0435\u0431\u043D\u044B\u0435 \u0442\u0440\u0430\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255042
    m_Localized: "\u041D\u0430 \u0441\u043E\u043B\u043D\u0435\u0447\u043D\u043E\u0439
      \u043F\u043E\u043B\u044F\u043D\u0435 \u043F\u0435\u0441\u0442\u0440\u0435\u044E\u0442
      \u0440\u0435\u0434\u043A\u0438\u0435 \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u0442\u0440\u0430\u0432\u044B. \u0418\u0445 \u0430\u0440\u043E\u043C\u0430\u0442
      \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u0430\u0435\u0442 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432 \u2014 \u0432 \u0437\u0430\u0440\u043E\u0441\u043B\u044F\u0445
      \u0447\u0442\u043E-\u0442\u043E \u0448\u0443\u0440\u0448\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255043
    m_Localized: "\u0421\u043E\u0431\u0440\u0430\u0442\u044C \u0442\u0440\u0430\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255044
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255045
    m_Localized: "\u041B\u0435\u0441\u043D\u044B\u0435 \u0440\u0443\u0438\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255046
    m_Localized: "\u0421\u043A\u0432\u043E\u0437\u044C \u0437\u0430\u0432\u0435\u0441\u0443
      \u043B\u0438\u0430\u043D \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u0430\u044E\u0442
      \u0437\u0430\u043C\u0448\u0435\u043B\u044B\u0435 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0435
      \u0441\u0442\u0435\u043D\u044B \u0434\u0440\u0435\u0432\u043D\u0435\u0433\u043E
      \u0445\u0440\u0430\u043C\u0430. \u0412\u043D\u0443\u0442\u0440\u0438 \u0442\u0435\u043C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255047
    m_Localized: "\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255048
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0432\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255049
    m_Localized: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E \u0432\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255050
    m_Localized: "\u041B\u0435\u0441\u043E\u0440\u0443\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255051
    m_Localized: "\u0423 \u043E\u0431\u043E\u0447\u0438\u043D\u044B \u0441\u0442\u043E\u0438\u0442
      \u043A\u0440\u0435\u043F\u043A\u0438\u0439 \u043C\u0443\u0436\u0438\u043A \u0441
      \u0442\u043E\u043F\u043E\u0440\u043E\u043C \u0438 \u043C\u0430\u0448\u0435\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443. \u0420\u044F\u0434\u043E\u043C
      \u2014 \u0434\u043E\u0431\u0440\u043E\u0442\u043D\u0430\u044F \u0445\u0438\u0436\u0438\u043D\u0430
      \u0438 \u0433\u043E\u0440\u0430 \u0441\u0432\u0435\u0436\u0438\u0445 \u0431\u0440\u0451\u0432\u0435\u043D.
      \u041E\u043D \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u043F\u043E\u043C\u043E\u0449\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255052
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255053
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255054
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255055
    m_Localized: "\u041D\u043E\u0447\u043D\u044B\u0435 \u0437\u0432\u0443\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255056
    m_Localized: "\u041B\u0430\u0433\u0435\u0440\u044C \u043E\u043A\u0443\u0442\u0430\u043B\u0430
      \u0442\u044C\u043C\u0430. \u0418\u0437 \u0447\u0430\u0449\u0438 \u0434\u043E\u043D\u043E\u0441\u044F\u0442\u0441\u044F
      \u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435 \u0437\u0432\u0443\u043A\u0438
      \u2014 \u0442\u043E \u043B\u0438 \u0432\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255057
    m_Localized: "\u0421\u0438\u0434\u0435\u0442\u044C \u0442\u0438\u0445\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255058
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255059
    m_Localized: "\u0417\u043C\u0435\u0438 \u043D\u0430 \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255060
    m_Localized: "\u041A\u043B\u0443\u0431\u043E\u043A \u044F\u0434\u043E\u0432\u0438\u0442\u044B\u0445
      \u0437\u043C\u0435\u0439 \u0433\u0440\u0435\u0435\u0442\u0441\u044F \u043D\u0430
      \u043A\u0430\u043C\u043D\u044F\u0445 \u043F\u0440\u044F\u043C\u043E \u043F\u043E\u0441\u0440\u0435\u0434\u0438
      \u043B\u0435\u0441\u043D\u043E\u0439 \u0442\u0440\u043E\u043F\u044B. \u0418\u0445
      \u043F\u0451\u0441\u0442\u0440\u044B\u0435 \u0442\u0435\u043B\u0430 \u0431\u043B\u0435\u0441\u0442\u044F\u0442
      \u043D\u0430 \u0441\u043E\u043B\u043D\u0446\u0435 \u2014 \u043E\u0431\u044A\u0435\u0437\u0434
      \u0437\u0430\u0439\u043C\u0451\u0442 \u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255061
    m_Localized: "\u041E\u0442\u043E\u0433\u043D\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255062
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255063
    m_Localized: "\u0421\u0442\u0435\u043F\u043D\u044B\u0435 \u043D\u0430\u043B\u0451\u0442\u0447\u0438\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255064
    m_Localized: "\u041E\u0431\u043B\u0430\u043A\u043E \u043F\u044B\u043B\u0438 \u043D\u0430
      \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435 \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u0435\u0442\u0441\u044F. \u041A\u043E\u043D\u043D\u044B\u0435
      \u043D\u0430\u043B\u0451\u0442\u0447\u0438\u043A\u0438 \u0441 \u0441\u0430\u0431\u043B\u044F\u043C\u0438
      \u043D\u0430\u0433\u043E\u043B\u043E \u043D\u0435\u0441\u0443\u0442\u0441\u044F
      \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443 \u0447\u0435\u0440\u0435\u0437
      \u0441\u0442\u0435\u043F\u043D\u0443\u044E \u0442\u0440\u0430\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255065
    m_Localized: "\u0414\u0430\u0442\u044C \u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255066
    m_Localized: "\u0411\u0435\u0436\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255067
    m_Localized: "\u041E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255068
    m_Localized: "\u041F\u044B\u043B\u044C\u043D\u0430\u044F \u0431\u0443\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255069
    m_Localized: "\u0413\u043E\u0440\u0438\u0437\u043E\u043D\u0442 \u0437\u0430\u0432\u043E\u043B\u0430\u043A\u0438\u0432\u0430\u0435\u0442
      \u0431\u0443\u0440\u0430\u044F \u0441\u0442\u0435\u043D\u0430 \u043F\u044B\u043B\u0438.
      \u0412\u0435\u0442\u0435\u0440 \u043D\u0430\u0440\u0430\u0441\u0442\u0430\u0435\u0442,
      \u0441\u0432\u0438\u0441\u0442\u044F \u0432 \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u0445.
      \u0427\u0435\u0440\u0435\u0437 \u043C\u0438\u043D\u0443\u0442\u0443 \u0441\u0442\u0435\u043F\u044C
      \u0442\u043E\u043D\u0435\u0442 \u0432 \u043C\u0443\u0442\u043D\u043E\u0439
      \u043C\u0433\u043B\u0435 \u2014 \u043D\u0435 \u0432\u0438\u0434\u043D\u043E
      \u0432\u044B\u0442\u044F\u043D\u0443\u0442\u043E\u0439 \u0440\u0443\u043A\u0438.
      \u041F\u044B\u043B\u044C \u0437\u0430\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0433\u043B\u0430\u0437\u0430, \u043D\u043E\u0437\u0434\u0440\u0438,
      \u0440\u043E\u0442. \u0422\u044F\u0433\u043B\u043E\u0432\u044B\u0435 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435
      \u0443\u043F\u0438\u0440\u0430\u044E\u0442\u0441\u044F \u0438 \u0440\u0435\u0432\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255070
    m_Localized: "\u041F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C \u043D\u0430
      \u043C\u0435\u0441\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255071
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u0443\u043A\u0440\u044B\u0442\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255072
    m_Localized: "\u0414\u0438\u043A\u0438\u0435 \u043B\u043E\u0448\u0430\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255073
    m_Localized: "\u041D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435
      \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0442\u0430\u0431\u0443\u043D
      \u0434\u0438\u043A\u0438\u0445 \u043B\u043E\u0448\u0430\u0434\u0435\u0439.
      \u041F\u044B\u043B\u044C \u0438\u0437-\u043F\u043E\u0434 \u043A\u043E\u043F\u044B\u0442
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u0437\u043E\u043B\u043E\u0442\u044B\u043C
      \u043E\u0431\u043B\u0430\u043A\u043E\u043C \u0432 \u0437\u0430\u043A\u0430\u0442\u043D\u043E\u043C
      \u0441\u0432\u0435\u0442\u0435. \u0412\u043E\u0436\u0430\u043A \u2014 \u043A\u0440\u0443\u043F\u043D\u044B\u0439
      \u0433\u043D\u0435\u0434\u043E\u0439 \u0436\u0435\u0440\u0435\u0431\u0435\u0446
      \u2014 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D.
      \u041A\u043E\u043D\u0438 \u0445\u0440\u0430\u043F\u044F\u0442 \u0438 \u0431\u044C\u044E\u0442
      \u043A\u043E\u043F\u044B\u0442\u0430\u043C\u0438, \u043D\u043E \u043D\u0435
      \u0443\u0431\u0435\u0433\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255074
    m_Localized: "\u041D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u044C \u0438 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255075
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u043F\u043E\u0439\u043C\u0430\u0442\u044C \u043B\u043E\u0448\u0430\u0434\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255076
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u043A \u0442\u0430\u0431\u0443\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255077
    m_Localized: "\u041F\u043E\u0440\u0432\u0430\u043D\u043D\u0430\u044F \u0443\u043F\u0440\u044F\u0436\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255078
    m_Localized: "\u041A\u043E\u0436\u0430\u043D\u044B\u0435 \u0440\u0435\u043C\u043D\u0438
      \u0443\u043F\u0440\u044F\u0436\u0438 \u043B\u043E\u043F\u043D\u0443\u043B\u0438
      \u043D\u0430 \u0445\u043E\u0434\u0443. \u041F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0430\u0441\u044C \u043F\u043E\u0441\u0440\u0435\u0434\u0438
      \u0441\u0442\u0435\u043F\u0438 \u2014 \u0431\u0435\u0437 \u043F\u043E\u0447\u0438\u043D\u043A\u0438
      \u0434\u0430\u043B\u044C\u0448\u0435 \u043D\u0435 \u0434\u0432\u0438\u043D\u0443\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255079
    m_Localized: "\u041F\u043E\u0447\u0438\u043D\u0438\u0442\u044C \u043A\u0430\u043A
      \u0441\u043B\u0435\u0434\u0443\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255080
    m_Localized: "\u0421\u0432\u044F\u0437\u0430\u0442\u044C \u043D\u0430 \u0441\u043A\u043E\u0440\u0443\u044E
      \u0440\u0443\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255081
    m_Localized: "\u0413\u0440\u043E\u0437\u0430 \u0432 \u0441\u0442\u0435\u043F\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255082
    m_Localized: "\u0427\u0451\u0440\u043D\u044B\u0435 \u0442\u0443\u0447\u0438 \u0441\u0433\u0443\u0449\u0430\u044E\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255083
    m_Localized: "\u041F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255084
    m_Localized: "\u0411\u0435\u0436\u0430\u0442\u044C \u0432\u043F\u0435\u0440\u0451\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255085
    m_Localized: "\u0421\u0442\u0435\u043F\u043D\u043E\u0439 \u043F\u0435\u0440\u0435\u043A\u0440\u0451\u0441\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255086
    m_Localized: "\u0414\u0440\u0435\u0432\u043D\u0438\u0439 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439
      \u0443\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C \u043E\u0442\u043C\u0435\u0447\u0430\u0435\u0442
      \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0443 \u0434\u0432\u0443\u0445 \u0441\u0442\u0435\u043F\u043D\u044B\u0445
      \u0434\u043E\u0440\u043E\u0433. \u041D\u0430\u0434\u043F\u0438\u0441\u0438
      \u043F\u043E\u043B\u0443\u0441\u0442\u0451\u0440\u0442\u044B \u2014 \u043E\u0434\u043D\u0430
      \u0434\u043E\u0440\u043E\u0433\u0430 \u043A\u043E\u0440\u043E\u0447\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148087255087
    m_Localized: "\u0411\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0439 \u043F\u0443\u0442\u044C"
