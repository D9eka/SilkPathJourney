  - m_Id: 30370297315196928
    m_Localized: "\u0417\u0430\u0439\u0434\u0443 \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168448
    m_Localized: "\u0412\u044B \u0443\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u043A\u043E\u0448\u0435\u043B\u044C
      \u0437\u0430 \u043F\u043E\u044F\u0441. \u0412\u0430\u0445\u0443-\u041C\u0430\u043D
      \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442 \u043F\u043B\u0435\u0447\u0430\u043C\u0438:
      \xAB\u0413\u0438\u043B\u044C\u0434\u0438\u044F \u043D\u0435 \u0437\u0430\u043F\u0438\u0440\u0430\u0435\u0442
      \u0434\u0432\u0435\u0440\u0435\u0439. \u041A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0448\u044C
      \u0433\u043E\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168449
    m_Localized: "\u0417\u0430\u0439\u0434\u0443 \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168450
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043B\u0430\u0434\u043E\u043D\u0438: \xAB\u041F\u0443\u0442\u044C \u043D\u0435
      \u0438\u0441\u0447\u0435\u0437\u043D\u0435\u0442. \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0448\u044C \u0433\u043E\u0442\u043E\u0432.\xBB
      \u0421\u0435\u0440\u0435\u0431\u0440\u043E \u043E\u043D \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0432\u0430\u043C \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0441\u043B\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168451
    m_Localized: "\u041E\u0431\u0434\u0443\u043C\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168452
    m_Localized: "\u0421\u0442\u0430\u0440\u0448\u0438\u043D\u0430 \u043A\u0438\u0432\u0430\u0435\u0442
      \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B: \xAB\u0414\u0430\u0440\u0438\u0443\u0448
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B - \u0442\u044B \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u0435\u043D.
      \u041F\u0440\u0438\u0445\u043E\u0434\u0438, \u043A\u043E\u0433\u0434\u0430
      \u0440\u0435\u0448\u0438\u0448\u044C.\xBB \u0413\u0440\u0435\u0447\u0435\u0441\u043A\u0438\u0439
      \u043E\u0433\u043E\u043D\u044C \u0443\u0436\u0435 \u0432 \u0432\u0430\u0448\u0435\u043C
      \u043C\u0435\u0448\u043A\u0435, \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168453
    m_Localized: "\u0417\u0430\u0439\u0434\u0443 \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168454
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440 \u0427\u044D\u043D\u044C \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u0441\u0432\u0451\u0440\u0442\u043A\u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u043D\u0430 \u043F\u043E\u043B\u043A\u0443. \xAB\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F
      \u043D\u0435 \u043F\u0435\u0440\u0435\u0435\u0437\u0436\u0430\u0435\u0442.
      \u041A\u043E\u0433\u0434\u0430 \u043D\u0430\u0434\u0443\u043C\u0430\u0435\u0448\u044C
      - \u0434\u0432\u0435\u0440\u044C \u043E\u0442\u043A\u0440\u044B\u0442\u0430.\xBB
      \u0421\u0435\u0440\u0435\u0431\u0440\u043E \u043E\u043D \u043E\u0442\u0434\u0430\u0451\u0442
      \u0432\u0430\u043C \u0441\u0435\u0439\u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168455
    m_Localized: "\u0417\u0430\u0439\u043C\u0443\u0441\u044C \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168456
    m_Localized: "\u0412\u044B \u0441\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0435
      \u043A\u0430\u0440\u0442\u0443 \u0438 \u0443\u0431\u0438\u0440\u0430\u0435\u0442\u0435
      \u0432 \u0441\u0443\u043C\u043A\u0443. \u0417\u0430\u0433\u0430\u0434\u043A\u0430
      \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435 \u0434\u0435\u043D\u0435\u0442\u0441\u044F;
      \u0432\u0440\u0435\u043C\u044F \u0434\u043B\u044F \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0438
      \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u043F\u0440\u0438\u0432\u0430\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168457
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168458
    m_Localized: "\u0412\u044B \u043F\u0440\u044F\u0447\u0435\u0442\u0435 \u0444\u0438\u0433\u0443\u0440\u043A\u0443
      \u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u043E. \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434
      \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442 \u0432 \u0410\u0440\u0445\u0438\u0432\u0435
      - \u0424\u0430\u0440\u0443\u0445 \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442.
      \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u0442\u043E\u0447\u043A\u0430
      \u043A\u0430\u0440\u0442\u044B \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0441\u0430\u043C\u0438 \u0431\u0443\u0434\u0435\u0442\u0435
      \u0433\u043E\u0442\u043E\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168459
    m_Localized: "\u0415\u0449\u0451 \u043D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168460
    m_Localized: "\u0412\u044B \u0434\u0435\u043B\u0430\u0435\u0442\u0435 \u0448\u0430\u0433
      \u043D\u0430\u0437\u0430\u0434. \u0412\u0430\u0445\u0443-\u041C\u0430\u043D
      \u043A\u0438\u0432\u0430\u0435\u0442 \u043F\u043E\u043D\u0438\u043C\u0430\u044E\u0449\u0435
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E:
      \xAB\u042F \u0431\u0443\u0434\u0443 \u0436\u0434\u0430\u0442\u044C \u0432 \u0433\u0438\u043B\u044C\u0434\u0438\u0438
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430. \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0448\u044C \u0433\u043E\u0442\u043E\u0432.\xBB
      \u041A\u0443\u043F\u043E\u043B\u0430 \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044F
      \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168461
    m_Localized: "\u0412\u0435\u0440\u0448\u0438\u043D\u0430 \u043F\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168462
    m_Localized: "\u0412\u044B\u0441\u043E\u043A\u043E\u0433\u043E\u0440\u043D\u044B\u0439
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u0441\u0442\u043E\u0438\u0442
      \u0432 \u0442\u0438\u0448\u0438\u043D\u0435 - \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u043C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u0444\u043B\u0430\u0433\u0438
      \u0442\u0440\u0435\u043F\u0435\u0449\u0443\u0442 \u043D\u0430\u0434 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C\u044E.
      \u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0443 \u0432\u0445\u043E\u0434\u0430. \u041E\u043D \u0434\u043E\u043B\u0433\u043E
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442, \u043F\u043E\u0442\u043E\u043C
      \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F. \xAB\u0422\u044B \u043F\u0440\u043E\u0448\u0451\u043B
      \u0432\u0441\u0451. \u041F\u043E\u0441\u043B\u0430\u043D\u0438\u044F \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u044B,
      \u0445\u0440\u0430\u043C\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044B.
      \u041F\u0443\u0442\u044C \u0434\u0443\u0445\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D.\xBB
      \u041E\u043D \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043B\u0430\u0434\u043E\u043D\u0438.
      \xAB\u0421\u043B\u043E\u0432\u043E \u0437\u0430 \u0442\u043E\u0431\u043E\u0439:
      \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0443
      \u0441\u0435\u0439\u0447\u0430\u0441 - \u0438\u043B\u0438 \u043F\u043E\u0431\u044B\u0442\u044C
      \u0435\u0449\u0451?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168463
    m_Localized: "\u041F\u0443\u0442\u044C \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168464
    m_Localized: "\u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F
      \u0433\u043B\u0443\u0431\u043E\u043A\u043E. \xAB\u0422\u044B \u043F\u0440\u0438\u043D\u0451\u0441
      \u0441\u0432\u0435\u0442 \u0442\u0443\u0434\u0430, \u0433\u0434\u0435 \u0435\u0433\u043E
      \u043D\u0435 \u0436\u0434\u0430\u043B\u0438. \u0418\u0434\u0438 \u0441 \u043C\u0438\u0440\u043E\u043C.\xBB
      \u0413\u043E\u0440\u043D\u0430\u044F \u0442\u0438\u0448\u0438\u043D\u0430 \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u0435\u0442
      \u0432\u0430\u0441 - \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C
      \u0434\u0443\u0445\u0430 \u043F\u0440\u043E\u0439\u0434\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168465
    m_Localized: "\u0415\u0449\u0451 \u043D\u0435 \u0432\u0440\u0435\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168466
    m_Localized: "\u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u043A\u0438\u0432\u0430\u0435\u0442
      \u0431\u0435\u0437 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u044F.
      \xAB\u0414\u043E\u0440\u043E\u0433\u0430 \u0441\u0430\u043C\u0430 \u0441\u043A\u0430\u0436\u0435\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u043F\u0440\u0438\u0448\u043B\u043E \u0432\u0440\u0435\u043C\u044F.
      \u042F \u0436\u0434\u0443 \u0443 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F
      \u0432 \u0410\u043D\u044C\u0441\u0438. \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168467
    m_Localized: "\u041B\u0435\u0433\u0435\u043D\u0434\u0430 \u0434\u043E\u0440\u043E\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168468
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0411\u0430\u0433\u0434\u0430\u0434\u0430
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B. \u0423\u043B\u0438\u0446\u044B
      \u043F\u0430\u0445\u043D\u0443\u0442 \u043F\u0440\u044F\u043D\u043E\u0441\u0442\u044F\u043C\u0438
      \u0438 \u0434\u044B\u043C\u043E\u043C \u043A\u0443\u0437\u043D\u0438\u0446.
      \u0414\u0430\u0440\u0438\u0443\u0448\u0435\u0432 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u043F\u0440\u043E\u0439\u0434\u0435\u043D \u043E\u0442 \u043F\u0435\u0440\u0432\u043E\u0433\u043E
      \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u043A\u0430\u043C\u043D\u044F.
      \u0421\u0442\u0430\u0440\u044B\u0439 \u0414\u0430\u0440\u0438\u0443\u0448,
      \u0434\u043E\u0436\u0434\u0430\u0432\u0448\u0438\u0439\u0441\u044F \u0432\u0430\u0441
      \u0432 \u0442\u0435\u043D\u0438 \u043F\u0430\u043B\u044C\u043C\u044B \u0443
      \u0432\u043E\u0440\u043E\u0442, \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0438 \u043C\u043E\u043B\u0447\u0438\u0442 \u0434\u043E\u043B\u0433\u043E.
      \u041F\u043E\u0442\u043E\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442:
      \xAB\u0421\u043E\u0440\u043E\u043A \u043B\u0435\u0442 \u044F \u0448\u0451\u043B
      \u044D\u0442\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u043E\u0439. \u0422\u0435\u043F\u0435\u0440\u044C
      \u043E\u043D\u0430 \u0442\u0432\u043E\u044F. \u0427\u0442\u043E \u0440\u0435\u0448\u0430\u0435\u0448\u044C
      - \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0442\u043E\u0447\u043A\u0443
      \u0438\u043B\u0438 \u0434\u0430\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0435
      \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168469
    m_Localized: "\u0421\u0442\u0430\u0442\u044C \u043B\u0435\u0433\u0435\u043D\u0434\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168470
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u043A\u0440\u0435\u043F\u043A\u043E
      \u0436\u043C\u0451\u0442 \u0432\u0430\u0448\u0443 \u0440\u0443\u043A\u0443
      - \u0434\u0432\u0430 \u043F\u0430\u043B\u044C\u0446\u0430 \u043D\u0435 \u0441\u0433\u0438\u0431\u0430\u044E\u0442\u0441\u044F,
      \u043D\u043E \u0445\u0432\u0430\u0442\u043A\u0430 \u0436\u0435\u043B\u0435\u0437\u043D\u0430\u044F.
      \xAB\u041B\u0435\u0433\u0435\u043D\u0434\u0430 \u0434\u043E\u0440\u043E\u0433.
      \u0417\u0430\u043F\u043E\u043C\u043D\u0438 \u044D\u0442\u043E.\xBB \u0418\u043C\u044F
      \u0432\u0430\u0448\u0435\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0432\u043E\u0439\u0434\u0451\u0442 \u0432 \u0438\u0441\u0442\u043E\u0440\u0438\u0438
      \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u0433\u043E \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168471
    m_Localized: "\u0415\u0449\u0451 \u043D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168472
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u0445\u043C\u044B\u043A\u0430\u0435\u0442.
      \xAB\u0425\u043E\u0440\u043E\u0448\u043E. \u0414\u043E\u0440\u043E\u0433\u0430
      \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435 \u0434\u0435\u043D\u0435\u0442\u0441\u044F.\xBB
      \u041E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043C\u0435\u0441\u0442\u043E,
      \u0433\u0434\u0435 \u0431\u0443\u0434\u0435\u0442 \u0436\u0434\u0430\u0442\u044C
      - \u0443 \u0432\u043E\u0440\u043E\u0442 \u0411\u0430\u0433\u0434\u0430\u0434\u0430,
      \u043A\u0430\u043A \u0432\u0441\u0435\u0433\u0434\u0430. \xAB\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0440\u0435\u0448\u0438\u0448\u044C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168473
    m_Localized: "\u0422\u0430\u0439\u043D\u0430 \u043F\u0443\u0440\u043F\u0443\u0440\u0430
      \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168474
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u0427\u044D\u043D\u044C
      \u0412\u044D\u044F \u043F\u043E\u0433\u0440\u0443\u0436\u0435\u043D\u0430 \u0432
      \u0437\u0430\u043F\u0430\u0445 \u0433\u043E\u0440\u044F\u0447\u0435\u0433\u043E
      \u0438\u043D\u0434\u0438\u0433\u043E \u0438 \u0432\u043E\u0441\u043A\u0430.
      \u041D\u0430 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u043C \u0441\u0442\u043E\u043B\u0435
      \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438 \u0440\u0430\u0437\u043B\u043E\u0436\u0435\u043D\u044B
      \u0442\u043A\u0430\u043D\u0438 - \u043F\u0443\u0440\u043F\u0443\u0440, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043D\u0435 \u0432\u044B\u0446\u0432\u0435\u0442\u0430\u0435\u0442. \u0414\u0435\u043B\u043E
      \u0432\u0441\u0435\u0439 \u0436\u0438\u0437\u043D\u0438 \u043C\u0430\u0441\u0442\u0435\u0440\u0430
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E. \u0427\u044D\u043D\u044C
      \u0412\u044D\u0439 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u0442\u043A\u0430\u043D\u0438 \u0434\u043E\u043B\u0433\u043E, \u043F\u043E\u0442\u043E\u043C
      \u043D\u0430 \u0432\u0430\u0441. \xAB\u0421\u0435\u043A\u0440\u0435\u0442 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0436\u0438\u0432\u0451\u0442 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432 \u043C\u043E\u0438\u0445 \u0440\u0443\u043A\u0430\u0445. \u041F\u0443\u0442\u044C
      \u043E\u043A\u043E\u043D\u0447\u0435\u043D - \u0438\u043B\u0438 \u0442\u044B
      \u0445\u043E\u0447\u0435\u0448\u044C \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
      \u0435\u0449\u0451?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168475
    m_Localized: "\u041F\u0443\u0442\u044C \u043F\u0440\u043E\u0439\u0434\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168476
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440 \u0427\u044D\u043D\u044C \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F
      \u043D\u0438\u0437\u043A\u043E. \xAB\u0422\u044B \u0434\u043E\u0441\u0442\u043E\u0438\u043D
      \u0437\u043D\u0430\u0442\u044C \u0442\u043E, \u0447\u0442\u043E \u0437\u043D\u0430\u044E
      \u044F.\xBB \u0421\u0435\u043A\u0440\u0435\u0442 \u043F\u0443\u0440\u043F\u0443\u0440\u0430
      \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D. \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C \u0448\u0451\u043B\u043A\u043E\u0442\u043A\u0430\u0447\u0435\u0439
      \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168477
    m_Localized: "\u0415\u0449\u0451 \u043D\u0435 \u0432\u0440\u0435\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168478
    m_Localized: "\u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u0442\u043A\u0430\u043D\u0438 \u0432 \u0441\u0443\u043D\u0434\u0443\u043A.
      \xAB\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u0436\u0434\u0451\u0442.
      \u042F \u0437\u0434\u0435\u0441\u044C - \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u0435,
      \u043A\u0430\u043A \u0432\u0441\u0435\u0433\u0434\u0430.\xBB \u0414\u0432\u0435\u0440\u044C
      \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168479
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168480
    m_Localized: "\u0410\u0440\u0445\u0438\u0432\u043D\u0430\u044F \u043A\u043E\u043C\u043D\u0430\u0442\u0430
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435. \u041D\u0430
      \u0441\u0442\u043E\u043B\u0435 \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438
      - \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u044F\u044F \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F,
      \u0440\u044F\u0434\u043E\u043C \u0441 \u043A\u0430\u0440\u0442\u043E\u0439
      \u0424\u0430\u0440\u0443\u0445\u0430, \u0433\u0434\u0435 \u043A\u0430\u0436\u0434\u0430\u044F
      \u0442\u043E\u0447\u043A\u0430 \u0437\u0430\u0447\u0451\u0440\u043A\u043D\u0443\u0442\u0430.
      \u0424\u0430\u0440\u0443\u0445 \u0441\u0442\u043E\u0438\u0442 \u0432 \u0434\u0432\u0435\u0440\u044F\u0445,
      \u0432 \u0440\u0443\u043A\u0430\u0445 \u0447\u0430\u0448\u043A\u0430 \u0447\u0451\u0440\u043D\u043E\u0433\u043E
      \u0447\u0430\u044F. \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0438 \u043C\u043E\u043B\u0447\u0430,
      \u043F\u043E\u0442\u043E\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442:
      \xAB\u041A\u0430\u0440\u0442\u0430 \u0441\u043A\u0430\u0437\u0430\u043B\u0430
      \u0432\u0441\u0451. \u041F\u0443\u0442\u044C \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D.
      \u0418\u043B\u0438 \u0442\u044B \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0448\u044C,
      \u0447\u0442\u043E \u0435\u0449\u0451 \u043D\u0435 \u0433\u043E\u0442\u043E\u0432
      \u0443\u0445\u043E\u0434\u0438\u0442\u044C?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168481
    m_Localized: "\u041E\u0445\u043E\u0442\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168482
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0441\u0442\u0430\u0432\u0438\u0442
      \u0447\u0430\u0448\u043A\u0443 \u043D\u0430 \u0441\u0442\u043E\u043B \u0438
      \u043A\u0438\u0432\u0430\u0435\u0442. \xAB\u042F \u0437\u043D\u0430\u043B,
      \u0447\u0442\u043E \u0442\u044B \u0434\u043E\u0439\u0434\u0451\u0448\u044C.\xBB
      \u0420\u0435\u043B\u0438\u043A\u0432\u0438\u0438 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438 \u043D\u0430\u0439\u0434\u0435\u043D\u044B. \u0410\u0440\u0445\u0438\u0432
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168483
    m_Localized: "\u0415\u0449\u0451 \u043D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168484
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0434\u043E\u043F\u0438\u0432\u0430\u0435\u0442
      \u0447\u0430\u0439. \xAB\u041A\u0430\u043A \u0437\u043D\u0430\u0435\u0448\u044C.
      \u0410\u0440\u0445\u0438\u0432 \u0437\u0434\u0435\u0441\u044C - \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435,
      \u043A\u0430\u043A \u0438 \u043F\u0440\u0435\u0436\u0434\u0435.\xBB \u041E\u043D
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0438
      \u043D\u0430 \u0441\u0442\u043E\u043B\u0435. \u0414\u043E\u0440\u043E\u0433\u0430
      \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168485
    m_Localized: "\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434. \u0413\u0438\u043B\u044C\u0434\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168486
    m_Localized: "\u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0432 \u0442\u043E\u043C \u0436\u0435 \u043A\u0440\u0435\u0441\u043B\u0435,
      \u0447\u0442\u043E \u0438 \u0432 \u043F\u0435\u0440\u0432\u044B\u0439 \u0434\u0435\u043D\u044C.
      \u041F\u0435\u0447\u0430\u0442\u044C \u0433\u0438\u043B\u044C\u0434\u0438\u0438
      \u043B\u0435\u0436\u0438\u0442 \u043D\u0430 \u0441\u0442\u043E\u043B\u0435
      - \u0436\u0434\u0451\u0442. \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0441, \u043F\u043E\u0442\u043E\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442:
      \xAB\u041A\u0443\u043F\u043E\u043B\u0430 \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044F
      \u0432\u0441\u0451 \u0435\u0449\u0451 \u0442\u0430\u043C. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0433\u043E\u0442\u043E\u0432. \u0421\u043B\u043E\u0432\u043E \u0437\u0430
      \u0442\u043E\u0431\u043E\u0439.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297336168487
    m_Localized: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362752
    m_Localized: "\u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0432\u0441\u0442\u0430\u0451\u0442
      \u0438 \u0431\u0435\u0440\u0451\u0442 \u043A\u043E\u0448\u0435\u043B\u044C.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u0437\u0430\u043F\u0430\u0434\u0443. \u041D\u0430 \u044D\u0442\u043E\u0442
      \u0440\u0430\u0437 \u0432\u044B \u0432\u0445\u043E\u0434\u0438\u0442\u0435
      \u0432 \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362753
    m_Localized: "\u041F\u043E\u0434\u043E\u0436\u0434\u0443 \u0435\u0449\u0451"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362754
    m_Localized: "\u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0440\u0430\u0437\u0432\u043E\u0434\u0438\u0442
      \u0440\u0443\u043A\u0430\u043C\u0438: \xAB\u0413\u0438\u043B\u044C\u0434\u0438\u044F
      \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442.\xBB \u0414\u0432\u0435\u0440\u044C
      \u0435\u0433\u043E \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043F\u0440\u0438\u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362755
    m_Localized: "\u0410\u043D\u044C\u0441\u0438. \u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362756
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0443 \u043F\u043E\u0440\u043E\u0433\u0430 \u043F\u0435\u0449\u0435\u0440
      \u041C\u043E\u0433\u0430\u043E. \u041B\u0430\u043C\u043F\u0430\u0434\u044B
      \u0433\u043E\u0440\u044F\u0442, \u0437\u0430\u043F\u0430\u0445 \u0431\u043B\u0430\u0433\u043E\u0432\u043E\u043D\u0438\u0439
      \u043F\u0440\u0435\u0436\u043D\u0438\u0439. \u041C\u043E\u043D\u0430\u0445
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E.
      \xAB\u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u0436\u0434\u0451\u0442 \u0432
      \u0432\u044B\u0441\u043E\u043A\u043E\u0433\u043E\u0440\u044C\u0435. \u041F\u0443\u0442\u044C
      \u0434\u0443\u0445\u0430 \u043E\u0442\u043A\u0440\u044B\u0442. \u0422\u044B
      \u0433\u043E\u0442\u043E\u0432 \u0432\u044B\u0439\u0442\u0438?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362757
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u043D\u0430 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362758
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F
      \u0438 \u0437\u0430\u0436\u0438\u0433\u0430\u0435\u0442 \u043B\u0430\u0434\u0430\u043D.
      \u0413\u043E\u0440\u043D\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0430.
      \u041F\u0443\u0442\u044C \u0434\u0443\u0445\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0441\u044F
      \u0442\u0430\u043C, \u0433\u0434\u0435 \u043D\u0430\u0447\u0430\u043B\u0441\u044F
      - \u0443 \u0432\u0435\u0440\u0448\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362759
    m_Localized: "\u0415\u0449\u0451 \u043D\u0435 \u0433\u043E\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362760
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043B\u0430\u0434\u043E\u043D\u0438: \xAB\u0413\u043E\u0440\u044B \u0436\u0434\u0443\u0442
      \u0442\u0435\u0440\u043F\u0435\u043B\u0438\u0432\u043E. \u042F \u0437\u0434\u0435\u0441\u044C
      - \u0432 \u041C\u043E\u0433\u0430\u043E - \u043A\u043E\u0433\u0434\u0430 \u043D\u0430\u0434\u0443\u043C\u0430\u0435\u0448\u044C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362761
    m_Localized: "\u0411\u0430\u0433\u0434\u0430\u0434. \u0423 \u0432\u043E\u0440\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362762
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u0441\u0442\u043E\u0438\u0442
      \u0432 \u0442\u0435\u043D\u0438 \u043F\u0430\u043B\u044C\u043C\u044B \u0443
      \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0445 \u0432\u043E\u0440\u043E\u0442
      - \u0442\u0430\u043C, \u0433\u0434\u0435 \u043E\u0431\u0435\u0449\u0430\u043B.
      \u041B\u0438\u0446\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0435,
      \u0433\u043B\u0430\u0437\u0430 \u0436\u0438\u0432\u044B\u0435. \xAB\u041C\u0430\u0440\u0448\u0440\u0443\u0442
      \u043F\u0440\u043E\u0439\u0434\u0435\u043D, \u0433\u0440\u0443\u0437 \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D.
      \u041E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043E\u0434\u043D\u043E:
      \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0442\u043E\u0447\u043A\u0443.
      \u0413\u043E\u0442\u043E\u0432?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362763
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0442\u043E\u0447\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362764
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u0436\u043C\u0451\u0442 \u0432\u0430\u0448\u0443
      \u0440\u0443\u043A\u0443 - \u043A\u0440\u0435\u043F\u043A\u043E, \u043A\u0430\u043A
      \u0443\u043C\u0435\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u043F\u0440\u043E\u0436\u0438\u0432\u0448\u0438\u0439 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0430\u0445
      \u0441\u043E\u0440\u043E\u043A \u043B\u0435\u0442. \xAB\u041B\u0435\u0433\u0435\u043D\u0434\u0430
      \u0434\u043E\u0440\u043E\u0433. \u0417\u0430\u043F\u043E\u043C\u043D\u0438
      \u044D\u0442\u043E.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362765
    m_Localized: "\u0415\u0449\u0451 \u043D\u0435 \u0432\u0440\u0435\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362766
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u0445\u043C\u044B\u043A\u0430\u0435\u0442.
      \xAB\u0414\u043E\u0440\u043E\u0433\u0430 \u043D\u0438\u043A\u0443\u0434\u0430
      \u043D\u0435 \u0434\u0435\u043D\u0435\u0442\u0441\u044F. \u042F \u0443 \u0432\u043E\u0440\u043E\u0442
      - \u043A\u0430\u043A \u0432\u0441\u0435\u0433\u0434\u0430.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362767
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C. \u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362768
    m_Localized: "\u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0441\u0443\u043D\u0434\u0443\u043A \u0441 \u0442\u043A\u0430\u043D\u044F\u043C\u0438.
      \u041F\u0443\u0440\u043F\u0443\u0440 \u043B\u0435\u0436\u0438\u0442 \u0441\u0432\u0435\u0440\u0445\u0443
      - \u043D\u0435 \u0432\u044B\u0446\u0432\u0435\u043B. \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0441 \u043F\u043E\u0432\u0435\u0440\u0445 \u0441\u0443\u043D\u0434\u0443\u043A\u0430.
      \xAB\u0421\u0435\u043A\u0440\u0435\u0442 \u0436\u0438\u0432. \u0414\u0435\u043B\u043E
      \u0436\u0434\u0451\u0442 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u044F.
      \u0413\u043E\u0442\u043E\u0432 \u043B\u0438 \u0442\u044B \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u044C
      \u0442\u043E, \u0447\u0442\u043E \u043D\u0430\u0447\u0430\u043B?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362769
    m_Localized: "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044C \u0434\u0435\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362770
    m_Localized: "\u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u043A\u043B\u0430\u0434\u0451\u0442
      \u0442\u043A\u0430\u043D\u044C \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0438
      \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F. \xAB\u041F\u0443\u0442\u044C
      \u0448\u0451\u043B\u043A\u0430 \u043F\u0440\u043E\u0439\u0434\u0435\u043D.
      \u0417\u043D\u0430\u043D\u0438\u0435 \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F.\xBB
      \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C \u043C\u0430\u0441\u0442\u0435\u0440\u0430
      \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362771
    m_Localized: "\u041D\u0435 \u0441\u0435\u0439\u0447\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362772
    m_Localized: "\u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0441\u0443\u043D\u0434\u0443\u043A. \xAB\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F
      \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435 \u0443\u0439\u0434\u0451\u0442.
      \u042F \u0437\u0434\u0435\u0441\u044C, \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u0435.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362773
    m_Localized: "\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434. \u0410\u0440\u0445\u0438\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362774
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0432 \u0430\u0440\u0445\u0438\u0432\u043D\u043E\u0439
      \u043A\u043E\u043C\u043D\u0430\u0442\u0435. \u0420\u0435\u043B\u0438\u043A\u0432\u0438\u0438
      \u0440\u0430\u0437\u043B\u043E\u0436\u0435\u043D\u044B \u043D\u0430 \u0441\u0442\u043E\u043B\u0435
      - \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E, \u043A\u0430\u043A
      \u043E\u043D \u043B\u044E\u0431\u0438\u0442. \u041E\u043D \u0440\u0430\u0437\u043B\u0438\u0432\u0430\u0435\u0442
      \u0447\u0451\u0440\u043D\u044B\u0439 \u0447\u0430\u0439 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0441 \u0431\u0435\u0437 \u0441\u043B\u043E\u0432\u0430.
      \u041F\u043E\u0442\u043E\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E:
      \xAB\u041A\u0430\u0440\u0442\u0430 \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u0430.
      \u0412\u0441\u0451 \u043D\u0430\u0439\u0434\u0435\u043D\u043E. \u0422\u044B
      \u0433\u043E\u0442\u043E\u0432 \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u044D\u0442\u043E\u0442
      \u043F\u0443\u0442\u044C?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362775
    m_Localized: "\u0417\u0430\u043A\u0440\u044B\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362776
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0447\u0430\u0448\u043A\u0443. \xAB\u0417\u0430 \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432.\xBB
      \u0420\u0435\u043B\u0438\u043A\u0432\u0438\u0438 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438 \u043D\u0430\u0448\u043B\u0438 \u0441\u0432\u043E\u0439
      \u0434\u043E\u043C \u0432 \u0410\u0440\u0445\u0438\u0432\u0435 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362777
    m_Localized: "\u0415\u0449\u0451 \u043F\u043E\u0434\u043E\u0436\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362778
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0434\u043E\u043F\u0438\u0432\u0430\u0435\u0442
      \u0447\u0430\u0439. \xAB\u041A\u0430\u043A \u0437\u043D\u0430\u0435\u0448\u044C.
      \u0410\u0440\u0445\u0438\u0432 \u0437\u0434\u0435\u0441\u044C.\xBB \u0427\u0430\u0448\u043A\u0438
      \u043E\u043F\u0443\u0441\u0442\u0435\u043B\u0438; \u0434\u0432\u0435\u0440\u044C
      \u043E\u0442\u043A\u0440\u044B\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362779
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362780
    m_Localized: "\u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u043D\u0435 \u043D\u0430\u0441\u0442\u0430\u0438\u0432\u0430\u0435\u0442.
      \u041E\u043D \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0433\u0440\u0430\u043C\u043E\u0442\u0443
      \u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u0443 \u0438 \u043A\u0438\u0432\u0430\u0435\u0442:
      \xAB\u0414\u0443\u043C\u0430\u0439. \u0413\u0438\u043B\u044C\u0434\u0438\u044F
      \u043D\u0435 \u0443\u0439\u0434\u0451\u0442.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362781
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362782
    m_Localized: "\u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043B\u0430\u0434\u043E\u043D\u0438. \xAB\u041F\u0443\u0442\u044C \u0431\u0443\u0434\u0435\u0442
      \u0436\u0434\u0430\u0442\u044C. \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0441\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0448\u044C \u0433\u043E\u0442\u043E\u0432.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362783
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362784
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u043A\u0438\u0432\u0430\u0435\u0442
      \u043D\u0435 \u0441\u043F\u0435\u0448\u0430. \xAB\u0425\u043E\u0440\u043E\u0448\u043E.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u0443\u0447\u0438\u0442 \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u044E.
      \u041D\u0430\u0439\u0434\u0451\u0448\u044C \u043C\u0435\u043D\u044F \u0443
      \u043A\u043E\u0441\u0442\u0440\u0430, \u043A\u043E\u0433\u0434\u0430 \u0440\u0435\u0448\u0438\u0448\u044C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362785
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362786
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440 \u0427\u044D\u043D\u044C \u043F\u0440\u044F\u0447\u0435\u0442
      \u0440\u0443\u043A\u0438 \u0432 \u0440\u0443\u043A\u0430\u0432\u0430. \xAB\u041A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044C
      \u043D\u0435 \u0443\u0431\u0435\u0436\u0438\u0442. \u041A\u043E\u0433\u0434\u0430
      \u043D\u0430\u0434\u0443\u043C\u0430\u0435\u0448\u044C - \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F
      \u0437\u0434\u0435\u0441\u044C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362787
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 30370297340362788
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u043F\u0440\u044F\u0447\u0435\u0442
      \u043A\u0430\u0440\u0442\u0443 \u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u0443
      \u0438 \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442 \u043F\u043B\u0435\u0447\u0430\u043C\u0438.
      \xAB\u0420\u0435\u043B\u0438\u043A\u0432\u0438\u0438 \u0436\u0434\u0430\u043B\u0438
      \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u044F\u043C\u0438 - \u0435\u0449\u0451
      \u043F\u043E\u0434\u043E\u0436\u0434\u0443\u0442. \u041D\u0430\u0439\u0434\u0451\u0448\u044C
      \u043C\u0435\u043D\u044F \u0437\u0434\u0435\u0441\u044C, \u043D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326639517696
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u0438\u0437 \u0411\u0443\u0445\u0430\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489216
    m_Localized: "\u0412\u043E\u0437\u0434\u0443\u0445 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      \u043F\u0430\u0445\u043D\u0435\u0442 \u043F\u044B\u043B\u044C\u044E \u0438
      \u0440\u043E\u0437\u043E\u0432\u044B\u043C \u043C\u0430\u0441\u043B\u043E\u043C
      - \u0432\u044B \u0434\u043E\u043C\u0430. \u0412 \u0437\u0430\u043B\u0435 \u0413\u0438\u043B\u044C\u0434\u0438\u0438
      \u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0443\u0436\u0435 \u0438\u0437\u0443\u0447\u0430\u0435\u0442
      \u0441\u0432\u0438\u0442\u043E\u043A \u0441 \u0431\u0443\u0445\u0430\u0440\u0441\u043A\u043E\u0439
      \u043F\u0435\u0447\u0430\u0442\u044C\u044E, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u0432\u044B \u043F\u043E\u043B\u043E\u0436\u0438\u043B\u0438 \u043F\u0435\u0440\u0435\u0434
      \u043D\u0438\u043C. \u041F\u0430\u043B\u044C\u0446\u044B \u0441\u043A\u043E\u043B\u044C\u0437\u044F\u0442
      \u043F\u043E \u0441\u0442\u0440\u043E\u043A\u0430\u043C, \u0433\u0443\u0431\u044B
      \u0447\u0443\u0442\u044C \u0448\u0435\u0432\u0435\u043B\u044F\u0442\u0441\u044F.
      \u041F\u043E\u0442\u043E\u043C \u043E\u043D \u043E\u0442\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0441\u0432\u0438\u0442\u043E\u043A \u0438 \u043A\u0438\u0432\u0430\u0435\u0442
      \u0441 \u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0435\u043D\u0438\u0435\u043C.
      \xAB\u041E\u043D\u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0438\u0441\u044C
      \u043D\u0430 \u043D\u0430\u0448\u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F.
      \u041D\u0438 \u043E\u0434\u043D\u043E\u0439 \u0437\u0430\u043F\u044F\u0442\u043E\u0439
      \u043D\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u043B\u0438. \u042D\u0442\u043E
      \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u044B\u0439 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442.\xBB
      \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0441
      \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E. \xAB\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435
      \u0434\u0435\u043B\u043E - \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u0435\u0435.
      \u0413\u043E\u0442\u043E\u0432 \u0432\u0437\u044F\u0442\u044C\u0441\u044F \u0441\u0435\u0439\u0447\u0430\u0441
      \u0438\u043B\u0438 \u043D\u0443\u0436\u043D\u043E \u0432\u0440\u0435\u043C\u044F?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489217
    m_Localized: "\u0413\u043E\u0442\u043E\u0432 \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489218
    m_Localized: "\u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u043D\u043E\u0432\u0443\u044E \u0433\u0440\u0430\u043C\u043E\u0442\u0443 \u0438
      \u0445\u043B\u043E\u043F\u0430\u0435\u0442 \u043F\u043E \u0441\u0442\u043E\u043B\u0443
      \u043B\u0430\u0434\u043E\u043D\u044C\u044E. \xAB\u0425\u043E\u0440\u043E\u0448\u043E.
      \u041D\u0443\u0436\u0435\u043D \u043A\u043E\u043D\u0432\u043E\u0439 \u0432
      \u041C\u0435\u0448\u0445\u0435\u0434 - \u0433\u0438\u043B\u044C\u0434\u0438\u044F
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043D\u043E\u0432\u044B\u0439
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442. \u0414\u0435\u0442\u0430\u043B\u0438
      \u0437\u0434\u0435\u0441\u044C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489219
    m_Localized: "\u0417\u0430\u0439\u0434\u0443 \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489220
    m_Localized: "\u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443 \u0432 \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0443.
      \xAB\u0413\u0438\u043B\u044C\u0434\u0438\u044F \u043D\u0435 \u0437\u0430\u043F\u0438\u0440\u0430\u0435\u0442
      \u0434\u0432\u0435\u0440\u0435\u0439. \u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442
      \u0441 \u041C\u0435\u0448\u0445\u0435\u0434\u043E\u043C \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489221
    m_Localized: "\u041F\u0435\u0447\u0430\u0442\u044C \u041C\u0435\u0448\u0445\u0435\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489222
    m_Localized: "\u0412 \u041C\u0435\u0448\u0445\u0435\u0434\u0435 \u043F\u0430\u0445\u043D\u0435\u0442
      \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u043C \u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u044C\u044E
      - \u0433\u043E\u0440\u043E\u0434 \u0441\u0442\u0440\u043E\u0438\u0442\u0441\u044F,
      \u0442\u043E\u0440\u0433\u0443\u0435\u0442, \u0436\u0438\u0432\u0451\u0442.
      \u041A\u0443\u043F\u0435\u0446-\u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044C
      \u0413\u0438\u043B\u044C\u0434\u0438\u0438 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0443 \u0432\u043E\u0440\u043E\u0442 \u0441\u0432\u043E\u0435\u0439
      \u043B\u0430\u0432\u043A\u0438 \u0438 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C.
      \u041E\u043D \u0441\u0442\u0430\u0432\u0438\u0442 \u043F\u0435\u0447\u0430\u0442\u044C,
      \u043D\u0435 \u0447\u0438\u0442\u0430\u044F - \u0436\u0435\u0441\u0442 \u0434\u043E\u0432\u0435\u0440\u0438\u044F.
      \xAB\u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442
      \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u0445 \u043B\u044E\u0434\u0435\u0439,\xBB
      - \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D \u043F\u043E-\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438.
      \xAB\u041F\u0435\u0440\u0435\u0434\u0430\u0439 \u0435\u043C\u0443: \u041C\u0435\u0448\u0445\u0435\u0434
      \u043E\u0442\u043A\u0440\u044B\u0442.\xBB \u0412\u0430\u0445\u0443-\u041C\u0430\u043D
      \u0443\u0436\u0435 \u0436\u0434\u0451\u0442 \u0441 \u043D\u043E\u0432\u044B\u043C
      \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0435\u043C - \u0432\u0437\u044F\u0442\u044C\u0441\u044F
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0438\u043B\u0438 \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489223
    m_Localized: "\u0413\u043E\u0442\u043E\u0432 \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489224
    m_Localized: "\u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u043F\u0435\u0447\u0430\u0442\u044C \u0438 \u0441\u0440\u0430\u0437\u0443
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043A\u0430\u0440\u0442\u0443:
      \xAB\u0411\u0430\u0433\u0434\u0430\u0434. \u0426\u0435\u043D\u043D\u044B\u0439
      \u0433\u0440\u0443\u0437. \u0414\u0435\u0442\u0430\u043B\u0438 \u0432 \u044D\u0442\u043E\u043C
      \u043F\u0438\u0441\u044C\u043C\u0435.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489225
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489226
    m_Localized: "\xAB\u0420\u0430\u0437\u0443\u043C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489227
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u0432 \u0411\u0430\u0433\u0434\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489228
    m_Localized: "\u0411\u0430\u0433\u0434\u0430\u0434 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u043A\u0430\u043D\u0430\u043B\u043E\u0432
      \u0438 \u0436\u0430\u0440\u0435\u043D\u044B\u0445 \u0444\u0438\u043D\u0438\u043A\u043E\u0432:
      \u0437\u0434\u0435\u0441\u044C \u043F\u0430\u0445\u043D\u0435\u0442 \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438.
      \u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C \u0433\u0440\u0443\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489229
    m_Localized: "\u041F\u0440\u043E\u0439\u0434\u0443 \u0434\u043E \u043A\u043E\u043D\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489230
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u043E\u0442\u0434\u0430\u0451\u0442
      \u043F\u0438\u0441\u044C\u043C\u043E \u0441 \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
      \u043A\u0438\u0432\u043A\u043E\u043C. \xAB\u0412\u0430\u0445\u0443-\u041C\u0430\u043D
      \u0431\u044B\u043B \u043F\u0440\u0430\u0432 \u043D\u0430 \u0442\u0432\u043E\u0439
      \u0441\u0447\u0451\u0442. \u041F\u0443\u0442\u044C \u043A \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044E
      \u043E\u0442\u043A\u0440\u044B\u0442.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489231
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489232
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u043F\u0438\u0441\u044C\u043C\u043E. \xAB\u041A\u0430\u043A \u0440\u0435\u0448\u0438\u0448\u044C.
      \u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0441\u043A\u0430\u0437\u0430\u043B:
      \u0442\u044B \u0441\u0430\u043C \u0432\u044B\u0431\u0435\u0440\u0435\u0448\u044C.
      \u0421\u0435\u0440\u0435\u0431\u0440\u043E \u0442\u0432\u043E\u0451.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489233
    m_Localized: "\u0422\u0440\u0438 \u0433\u043E\u043B\u043E\u0441\u0430 \u0442\u0438\u0448\u0438\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326660489234
    m_Localized: "\u041F\u0435\u0449\u0435\u0440\u044B \u041C\u043E\u0433\u0430\u043E
      \u043E\u043A\u0443\u0442\u044B\u0432\u0430\u044E\u0442 \u0432\u0430\u0441 \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043E\u0439.
      \u0422\u0438\u043D\u043B\u0435\u0439 \u0441\u0438\u0434\u0438\u0442 \u0443
      \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0439 \u043B\u0430\u043C\u043F\u044B,
      \u043D\u0435 \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044F\u0441\u044C,
      - \u0441\u043B\u043E\u0432\u043D\u043E \u0437\u043D\u0430\u043B, \u0447\u0442\u043E
      \u0432\u044B \u043F\u0440\u0438\u0434\u0451\u0442\u0435. \xAB\u042F \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E
      \u0442\u0440\u0438 \u043C\u0435\u0441\u0442\u0430 \u0432 \u0442\u0435\u0431\u0435,\xBB
      - \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D, \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044F
      \u0433\u043B\u0430\u0437. \xAB\u041E\u043D\u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438
      \u0441 \u0442\u043E\u0431\u043E\u0439?\xBB \u0412\u044B \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442\u0435
      \u0432\u0441\u0451 \u0443\u0432\u0438\u0434\u0435\u043D\u043D\u043E\u0435,
      \u0438 \u043C\u043E\u043D\u0430\u0445 \u043A\u0438\u0432\u0430\u0435\u0442
      \u043A\u0430\u0436\u0434\u043E\u043C\u0443 \u0441\u043B\u043E\u0432\u0443.
      \xAB\u0422\u0440\u0438 \u043E\u0433\u043D\u044F - \u043E\u0434\u0438\u043D
      \u043F\u0443\u0442\u044C. \u0422\u044B \u0443\u0441\u043B\u044B\u0448\u0430\u043B
      \u0440\u0430\u0437\u043D\u044B\u0435 \u0433\u043E\u043B\u043E\u0441\u0430 \u043E\u0434\u043D\u043E\u0433\u043E
      \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044F.\xBB \u041E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0432\u0437\u0433\u043B\u044F\u0434. \xAB\u041F\u0443\u0442\u044C \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F.
      \u0412\u043E\u0437\u044C\u043C\u0451\u0448\u044C\u0441\u044F \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      - \u0438\u043B\u0438 \u0442\u0435\u0431\u0435 \u043D\u0443\u0436\u043D\u0430
      \u0442\u0438\u0448\u0438\u043D\u0430?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877824
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0443 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877825
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043B\u0430\u0434\u043E\u043D\u0438. \xAB\u0413\u043E\u0440\u044B \u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0442
      \u0445\u0440\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877826
    m_Localized: "\u0417\u0430\u0439\u0434\u0443 \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877827
    m_Localized: "\xAB\u0422\u0438\u0448\u0438\u043D\u0430 \u043F\u043E\u0434\u043E\u0436\u0434\u0451\u0442
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u0442\u043E\u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877828
    m_Localized: "\u041D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0439 \u0445\u0440\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877829
    m_Localized: "\u0422\u0443\u043C\u0430\u043D \u0440\u0430\u0441\u0441\u0435\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0441\u0430\u043C\u044B\u0439 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u044B\u0439
      \u043C\u043E\u043C\u0435\u043D\u0442, \u0438 \u0432\u043E\u0442 \u043E\u043D,
      \u0432\u044B\u0440\u0443\u0431\u043B\u0435\u043D\u043D\u044B\u0439 \u043F\u0440\u044F\u043C\u043E
      \u0432 \u0441\u043A\u0430\u043B\u0435: \u0443\u0437\u043A\u0438\u0435 \u0441\u0442\u0443\u043F\u0435\u043D\u0438,
      \u0447\u0435\u0440\u0435\u043F\u0438\u0447\u043D\u0430\u044F \u043A\u0440\u044B\u0448\u0430,
      \u0442\u0438\u0445\u0438\u0439 \u0434\u0432\u043E\u0440 \u0441 \u043E\u0434\u043D\u0438\u043C
      \u043A\u0438\u043F\u0430\u0440\u0438\u0441\u043E\u043C. \u0422\u0438\u043D\u043B\u0435\u0439
      \u043F\u0440\u0438\u0448\u0451\u043B \u0437\u0430 \u0432\u0430\u043C\u0438
      \u0441\u0430\u043C, \u0438\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u0437\u0434\u0435\u0441\u044C.
      \xAB\u0422\u044B \u043D\u0430\u0448\u0451\u043B \u0442\u043E, \u0447\u0442\u043E
      \u043D\u0435 \u0438\u0449\u0443\u0442, \u0430 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043D\u0430\u0445\u043E\u0434\u044F\u0442\xBB, - \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043E\u043D \u0431\u0435\u0437 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u044F.
      \xAB\u0425\u0440\u0430\u043C \u0432\u0438\u0434\u0438\u0442 \u0442\u0435\u0431\u044F.
      \u0413\u043E\u0442\u043E\u0432 \u043F\u0440\u043E\u0439\u0442\u0438 \u0435\u0433\u043E
      \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F \u0441\u0435\u0439\u0447\u0430\u0441
      - \u0438\u043B\u0438 \u043F\u0440\u0438\u0434\u0451\u0448\u044C, \u043A\u043E\u0433\u0434\u0430
      \u0441\u043E\u0431\u0435\u0440\u0451\u0448\u044C\u0441\u044F \u0441 \u0434\u0443\u0445\u043E\u043C?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877830
    m_Localized: "\u0413\u043E\u0442\u043E\u0432 \u043A \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877831
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0432\u0445\u043E\u0434: \xAB\u0412\u043E\u0439\u0434\u0438.
      \u0425\u0440\u0430\u043C \u0437\u0430\u0434\u0430\u0441\u0442 \u0432\u043E\u043F\u0440\u043E\u0441\u044B
      - \u043E\u0442\u0432\u0435\u0447\u0430\u0439 \u0441\u0435\u0440\u0434\u0446\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877832
    m_Localized: "\u0417\u0430\u0439\u0434\u0443 \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877833
    m_Localized: "\xAB\u041A\u0438\u043F\u0430\u0440\u0438\u0441 \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877834
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u0445\u0440\u0430\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877835
    m_Localized: "\u0422\u0440\u0438 \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F
      \u043F\u043E\u0437\u0430\u0434\u0438 - \u0442\u0438\u0448\u0438\u043D\u043E\u0439,
      \u0441\u0442\u0440\u0430\u0445\u043E\u043C \u0438 \u0432\u044B\u0431\u043E\u0440\u043E\u043C.
      \u0422\u0438\u043D\u043B\u0435\u0439 \u0441\u0442\u043E\u0438\u0442 \u0432
      \u0446\u0435\u043D\u0442\u0440\u0435 \u0434\u0432\u043E\u0440\u0430, \u0438
      \u0437\u0430 \u0435\u0433\u043E \u0441\u043F\u0438\u043D\u043E\u0439 \u043A\u0438\u043F\u0430\u0440\u0438\u0441
      \u043A\u0430\u0447\u0430\u0435\u0442\u0441\u044F \u0431\u0435\u0437 \u0432\u0435\u0442\u0440\u0430.
      \xAB\u0422\u044B \u043F\u0440\u043E\u0448\u0451\u043B \u0442\u043E, \u0447\u0442\u043E
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u043B\u043E
      \u043C\u043D\u043E\u0433\u0438\u0445,\xBB - \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043C\u043E\u043D\u0430\u0445 \u0442\u0438\u0445\u043E. \xAB\u0425\u0440\u0430\u043C
      \u0434\u0430\u0451\u0442 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      - \u043D\u0435 \u043A\u0430\u043A \u0432\u043B\u0430\u0441\u0442\u044C, \u0430
      \u043A\u0430\u043A \u044F\u0441\u043D\u043E\u0441\u0442\u044C.\xBB \u041E\u043D
      \u043D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435 \u043A\u043B\u0430\u0434\u0451\u0442
      \u0440\u0443\u043A\u0443 \u0432\u0430\u043C \u043D\u0430 \u043B\u043E\u0431.
      \xAB\u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u0436\u0434\u0451\u0442 \u0442\u0435\u0431\u044F
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435. \u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0448\u044C\u0441\u044F
      \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E - \u0438\u043B\u0438
      \u043F\u043E\u0431\u0443\u0434\u0435\u0448\u044C \u0437\u0434\u0435\u0441\u044C?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877836
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u043B\u044E\u0441\u044C \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877837
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0434\u043E \u0441\u0442\u0443\u043F\u0435\u043D\u0435\u0439:
      \xAB\u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u0437\u043D\u0430\u0435\u0442
      \u0442\u0432\u043E\u0439 \u043F\u0443\u0442\u044C. \u041E\u043D \u043D\u0435
      \u0443\u0434\u0438\u0432\u0438\u0442\u0441\u044F.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877838
    m_Localized: "\u041F\u043E\u0431\u0443\u0434\u0443 \u0437\u0434\u0435\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877839
    m_Localized: "\xAB\u0425\u043E\u0440\u043E\u0448\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877840
    m_Localized: "\u041E\u0433\u043E\u043D\u044C \u0432 \u041C\u0435\u0448\u0445\u0435\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877841
    m_Localized: "\u041C\u0435\u0448\u0445\u0435\u0434\u0441\u043A\u0438\u0439 \u0441\u043A\u043B\u0430\u0434
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0437\u0430\u043F\u0430\u0445\u043E\u043C
      \u0441\u043A\u0438\u043F\u0438\u0434\u0430\u0440\u0430 \u0438 \u043B\u043E\u0448\u0430\u0434\u0438\u043D\u043E\u0433\u043E
      \u043F\u043E\u0442\u0430. \u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C
      - \u0440\u043E\u0441\u043B\u044B\u0439 \u043C\u0443\u0436\u0447\u0438\u043D\u0430
      \u0441 \u043E\u0442\u043C\u0435\u0442\u0438\u043D\u043E\u0439 \u043E\u0442
      \u043A\u043D\u0443\u0442\u0430 \u043D\u0430 \u0449\u0435\u043A\u0435 - \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442
      \u0433\u0440\u0443\u0437 \u043C\u043E\u043B\u0447\u0430, \u0441\u0447\u0438\u0442\u0430\u044F
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u043E\u0441\u0443\u0434 \u0434\u0432\u0430\u0436\u0434\u044B.
      \u0414\u0430\u0440\u0438\u0443\u0448 \u0441\u0438\u0434\u0438\u0442 \u0432
      \u0443\u0433\u043B\u0443 \u043D\u0430 \u0442\u044E\u043A\u0435 \u0438 \u0436\u0443\u0451\u0442
      \u0444\u0438\u043D\u0438\u043A\u0438. \xAB\u0426\u0435\u043B\u044B\u0439. \u042F
      \u043D\u0435 \u0441\u043E\u043C\u043D\u0435\u0432\u0430\u043B\u0441\u044F.\xBB
      \u041E\u043D \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u0432\u0430\u043C
      \u043A\u043E\u0448\u0435\u043B\u044C. \xAB\u0422\u044F\u0436\u0451\u043B\u044B\u0439
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442, \u0441\u043E\u0433\u043B\u0430\u0441\u0435\u043D.
      \u041D\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 - \u0434\u0440\u0443\u0433\u043E\u0433\u043E
      \u0440\u043E\u0434\u0430: \u043D\u0435 \u043E\u0433\u043E\u043D\u044C, \u0430
      \u043B\u044E\u0434\u0438. \u0411\u0435\u0440\u0451\u0448\u044C\u0441\u044F
      \u0441\u0440\u0430\u0437\u0443 \u0438\u043B\u0438 \u043D\u0443\u0436\u043D\u043E
      \u043F\u0440\u043E\u0434\u044B\u0448\u0430\u0442\u044C\u0441\u044F?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877842
    m_Localized: "\u0411\u0435\u0440\u0443\u0441\u044C \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877843
    m_Localized: "\xAB\u0425\u043E\u0440\u043E\u0448\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877844
    m_Localized: "\u0421\u043D\u0430\u0447\u0430\u043B\u0430 \u043E\u0442\u0434\u043E\u0445\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877845
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u043A\u0438\u0432\u0430\u0435\u0442.
      \xAB\u0423\u043C\u043D\u043E. \u0423\u0441\u0442\u0430\u043B\u044B\u0439 \u0438\u0449\u0435\u0442
      \u043F\u043B\u043E\u0445\u043E. \u0416\u0434\u0438 \u043C\u0435\u043D\u044F
      \u0443 \u0432\u043E\u0440\u043E\u0442 \u0437\u0430\u0432\u0442\u0440\u0430
      \u0443\u0442\u0440\u043E\u043C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877846
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u0438\u0437
      \u043F\u0435\u0441\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877847
    m_Localized: "\u041F\u044B\u043B\u044C \u043E\u0441\u0435\u0434\u0430\u0435\u0442,
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u0432\u0445\u043E\u0434\u0438\u0442 \u0432 \u0441\u0442\u0435\u043D\u044B
      \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E \u0434\u0432\u043E\u0440\u0430
      - \u0432\u0441\u0435 \u0436\u0438\u0432\u044B, \u0445\u043E\u0442\u044F \u0434\u0432\u043E\u0435
      \u0435\u043B\u0435 \u0441\u0442\u043E\u044F\u0442. \u0422\u044B \u043D\u0430\u0448\u0451\u043B
      \u0438\u0445 \u0432 \u0442\u0440\u0451\u0445 \u043B\u0438\u0433\u0430\u0445
      \u043E\u0442 \u0442\u0440\u0430\u043A\u0442\u0430, \u0431\u0435\u0437 \u0432\u043E\u0434\u044B
      \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439 \u0434\u0435\u043D\u044C.
      \u0414\u0430\u0440\u0438\u0443\u0448 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0441\u0440\u0430\u0437\u0443, \u0441\u043B\u043E\u0432\u043D\u043E \u0436\u0434\u0430\u043B
      \u0437\u0434\u0435\u0441\u044C. \xAB\u042F \u0441\u043B\u044B\u0448\u0430\u043B
      \u0442\u0432\u043E\u0439 \u0441\u0438\u0433\u043D\u0430\u043B,\xBB - \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043E\u043D \u0445\u0440\u0438\u043F\u043B\u043E. \xAB\u0425\u043E\u0440\u043E\u0448\u0430\u044F
      \u0440\u0430\u0431\u043E\u0442\u0430. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0437\u043D\u0430\u0435\u0448\u044C: \u043B\u044E\u0434\u0435\u0439 \u0431\u0435\u0440\u0435\u0447\u044C
      \u0441\u043B\u043E\u0436\u043D\u0435\u0435, \u0447\u0435\u043C \u0433\u0440\u0443\u0437.\xBB
      \u041E\u043D \u0445\u043B\u043E\u043F\u0430\u0435\u0442 \u0442\u0435\u0431\u044F
      \u043F\u043E \u043F\u043B\u0435\u0447\u0443. \xAB\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435
      - \u0437\u0430\u0441\u0430\u0434\u0430 \u043D\u0430 \u0442\u0440\u0430\u043A\u0442\u0435.
      \u0411\u0435\u0440\u0451\u0448\u044C\u0441\u044F \u0438\u043B\u0438 \u043D\u0435\u0442?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877848
    m_Localized: "\u0412\u043E\u0437\u044C\u043C\u0443\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877849
    m_Localized: "\xAB\u0412\u043E\u0442 \u0438 \u0445\u043E\u0440\u043E\u0448\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877850
    m_Localized: "\u041F\u043E\u0434\u043E\u0436\u0434\u0438 \u043C\u0435\u043D\u044F
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877851
    m_Localized: "\xAB\u041E\u0442\u0434\u043E\u0445\u043D\u0438. \u0411\u0430\u043D\u0434\u0438\u0442\u044B
      \u043D\u0438\u043A\u0443\u0434\u0430 \u043D\u0435 \u0434\u0435\u043D\u0443\u0442\u0441\u044F
      \u0434\u043E \u0443\u0442\u0440\u0430. \u042F \u0437\u0434\u0435\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877852
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0430 \u0437\u0430\u0447\u0438\u0449\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877853
    m_Localized: "\u041F\u044B\u043B\u044C \u043E\u0442 \u0441\u0445\u0432\u0430\u0442\u043A\u0438
      \u0435\u0449\u0451 \u043D\u0435 \u043E\u0441\u0435\u043B\u0430, \u043D\u043E
      \u0442\u0440\u0430\u043A\u0442 \u0441\u0432\u043E\u0431\u043E\u0434\u0435\u043D.
      \u0414\u0432\u043E\u0435 \u0440\u0430\u043D\u0435\u043D\u044B\u0445 \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432
      \u0431\u0435\u0433\u0443\u0442 \u043F\u0440\u043E\u0447\u044C, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0440\u0430\u0437\u0431\u0435\u0436\u0430\u043B\u0438\u0441\u044C \u0440\u0430\u043D\u044C\u0448\u0435.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0446\u044B, \u0447\u0442\u043E \u043F\u0440\u044F\u0442\u0430\u043B\u0438\u0441\u044C
      \u0437\u0430 \u0442\u0435\u043B\u0435\u0433\u0430\u043C\u0438, \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E
      \u0432\u0441\u0442\u0430\u044E\u0442, \u043D\u0435 \u0432\u0435\u0440\u044F,
      \u0447\u0442\u043E \u0432\u0441\u0451 \u043A\u043E\u043D\u0447\u0435\u043D\u043E.
      \u0414\u0430\u0440\u0438\u0443\u0448 \u043E\u0431\u044A\u0435\u0437\u0436\u0430\u0435\u0442
      \u043C\u0435\u0441\u0442\u043E \u0431\u043E\u044F \u0432\u0435\u0440\u0445\u043E\u043C,
      \u0434\u0435\u043B\u043E\u0432\u0438\u0442\u043E \u0441\u0447\u0438\u0442\u0430\u0435\u0442
      \u0442\u0440\u043E\u0444\u0435\u0438 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0441 \u0441 \u0447\u0435\u043C-\u0442\u043E \u043F\u043E\u0445\u043E\u0436\u0438\u043C
      \u043D\u0430 \u0433\u043E\u0440\u0434\u043E\u0441\u0442\u044C. \xAB\u041C\u0430\u0440\u0448\u0440\u0443\u0442
      \u0447\u0438\u0441\u0442. \u041C\u043E\u0436\u0435\u043C \u0445\u043E\u0434\u0438\u0442\u044C
      \u0437\u0434\u0435\u0441\u044C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E.\xBB
      \u041E\u043D \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u0448\u043B\u044F\u043F\u0443.
      \xAB\u041E\u0434\u0438\u043D \u043F\u0443\u0442\u044C \u043E\u0441\u0442\u0430\u043B\u0441\u044F.
      \u0413\u043E\u0442\u043E\u0432 \u0434\u043E\u0439\u0442\u0438 \u0434\u043E
      \u043A\u043E\u043D\u0446\u0430?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877854
    m_Localized: "\u0414\u043E \u043A\u043E\u043D\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877855
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u043D\u0430\u0434\u0435\u0432\u0430\u0435\u0442
      \u0448\u043B\u044F\u043F\u0443. \xAB\u0411\u0430\u0433\u0434\u0430\u0434. \u0414\u043E\u043B\u0433\u0438\u0439
      \u043F\u0443\u0442\u044C. \u0421\u0430\u043C\u044B\u0439 \u0432\u0430\u0436\u043D\u044B\u0439.
      \u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0443 \u0434\u0435\u0442\u0430\u043B\u0438
      \u0432 \u043B\u0430\u0433\u0435\u0440\u0435.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877856
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u0432\u0440\u0435\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877857
    m_Localized: "\xAB\u0425\u043E\u0440\u043E\u0448\u043E. \u041F\u043E\u0439\u0434\u0451\u043C
      \u0432 \u043B\u0430\u0433\u0435\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877858
    m_Localized: "\u0418\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442 \u043D\u0430\u0439\u0434\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877859
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u0427\u044D\u043D\u044F
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0437\u0430\u043F\u0430\u0445\u043E\u043C
      \u0438\u043D\u0434\u0438\u0433\u043E \u0438 \u043B\u0430\u043A\u0440\u0438\u0447\u043D\u043E\u0433\u043E
      \u043A\u043E\u0440\u043D\u044F. \u041C\u0430\u0441\u0442\u0435\u0440 \u0441\u0442\u043E\u0438\u0442
      \u043D\u0430\u0434 \u0441\u0442\u043E\u043B\u043E\u043C, \u043A\u043E\u0433\u0434\u0430
      \u0432\u044B \u043A\u043B\u0430\u0434\u0451\u0442\u0435 \u043F\u0435\u0440\u0435\u0434
      \u043D\u0438\u043C \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0439 \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442.
      \u041E\u043D \u0431\u0435\u0440\u0451\u0442 \u0435\u0433\u043E \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E
      - \u043F\u043E\u0447\u0442\u0438 \u043D\u0435\u0436\u043D\u043E, \u0440\u0430\u0441\u0442\u0438\u0440\u0430\u0435\u0442
      \u043D\u0430 \u043D\u043E\u0433\u0442\u0435. \u041F\u043E\u0442\u043E\u043C
      \u0442\u0438\u0445\u043E \u0432\u044B\u0434\u044B\u0445\u0430\u0435\u0442.
      \xAB\u042F \u043F\u043E\u043C\u043D\u0438\u043B \u044D\u0442\u043E\u0442 \u0437\u0430\u043F\u0430\u0445
      \u0441 \u0442\u0435\u0445 \u043F\u043E\u0440, \u043A\u0430\u043A \u0431\u044B\u043B
      \u0443\u0447\u0435\u043D\u0438\u043A\u043E\u043C. \u0422\u044B \u0432\u0435\u0440\u043D\u0443\u043B
      \u0443\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u043E\u0435 \u0437\u0432\u0435\u043D\u043E.\xBB
      \u041E\u043D \u043E\u0442\u043E\u0434\u0432\u0438\u0433\u0430\u0435\u0442 \u0441\u0442\u0430\u0440\u0438\u043D\u043D\u0443\u044E
      \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C. \xAB\u0422\u0435\u043F\u0435\u0440\u044C
      \u043D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C:
      \u043A\u0442\u043E \u0435\u0449\u0451 \u0437\u043D\u0430\u0435\u0442 \u0440\u0435\u0446\u0435\u043F\u0442.
      \u0412\u043E\u0437\u044C\u043C\u0451\u0448\u044C\u0441\u044F \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      - \u0438\u043B\u0438?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877860
    m_Localized: "\u0412\u043E\u0437\u044C\u043C\u0443\u0441\u044C \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877861
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440 \u0427\u044D\u043D\u044C \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u044F\u0449\u0438\u043A \u0441\u0442\u043E\u043B\u0430 \u0438 \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u0437\u0430\u043F\u0438\u0441\u043A\u0443. \xAB\u041A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u044B.
      \u041E\u0434\u043D\u0430 \u0438\u0437 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0438\u0445
      - \u0432 \u0434\u0432\u0443\u0445 \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0430\u0445
      \u043E\u0442\u0441\u044E\u0434\u0430. \u0423\u0437\u043D\u0430\u0439 \u043F\u0440\u0430\u0432\u0434\u0443.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877862
    m_Localized: "\u0417\u0430\u0439\u0434\u0443 \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877863
    m_Localized: "\xAB\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F
      \u0436\u0434\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877864
    m_Localized: "\u041F\u0440\u0430\u0432\u0434\u0430 \u043E \u043A\u0440\u0430\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877865
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u0427\u044D\u043D\u044F
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0441\u043E\u0441\u043D\u043E\u0432\u043E\u0439
      \u0441\u043C\u043E\u043B\u043E\u0439 \u0438 \u0433\u043E\u0440\u044F\u0447\u0438\u043C
      \u043C\u0435\u0442\u0430\u043B\u043B\u043E\u043C - \u043E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u043B,
      \u0436\u0434\u0430\u043B. \u0412\u044B \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u043D\u0430 \u0441\u0442\u043E\u043B \u0432\u0441\u0451: \u0438\u043C\u0435\u043D\u0430,
      \u0441\u0445\u0435\u043C\u044B, \u043E\u0431\u0440\u0430\u0437\u0446\u044B
      \u043A\u0440\u0430\u0434\u0435\u043D\u043E\u0433\u043E \u0440\u0435\u0446\u0435\u043F\u0442\u0430.
      \u041C\u0430\u0441\u0442\u0435\u0440 \u0427\u044D\u043D\u044C \u0438\u0437\u0443\u0447\u0430\u0435\u0442
      \u043A\u0430\u0436\u0434\u044B\u0439 \u043B\u0438\u0441\u0442\u043E\u043A \u043D\u0435
      \u0442\u043E\u0440\u043E\u043F\u044F\u0441\u044C, \u043F\u043E\u0442\u043E\u043C
      \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u0438\u0445 \u0441\u0442\u043E\u043F\u043A\u043E\u0439
      \u0438 \u043D\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043B\u0430\u0434\u043E\u043D\u044C\u044E.
      \xAB\u042F \u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0443\u0442\u0435\u0447\u043A\u0430
      \u0431\u044B\u043B\u0430. \u041D\u0435 \u0437\u043D\u0430\u043B - \u043A\u0442\u043E.\xBB
      \u0413\u043E\u043B\u043E\u0441 \u0440\u043E\u0432\u0435\u043D, \u043D\u043E
      \u043F\u0430\u043B\u044C\u0446\u044B \u0441\u0436\u0438\u043C\u0430\u044E\u0442\u0441\u044F.
      \xAB\u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0443\u0436\u043D\u043E \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C
      \u0441\u0432\u043E\u0451. \u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F
      \u043F\u0443\u0440\u043F\u0443\u0440\u0430. \u0413\u043E\u0442\u043E\u0432
      \u0432\u0437\u044F\u0442\u044C\u0441\u044F \u0437\u0430 \u0434\u0435\u043B\u043E?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877866
    m_Localized: "\u0413\u043E\u0442\u043E\u0432 \u0441\u0442\u0440\u043E\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877867
    m_Localized: "\u0427\u044D\u043D\u044C \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u0431\u0443\u043C\u0430\u0433\u0438 \u0432 \u0441\u0443\u043D\u0434\u0443\u043A
      \u0438 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043A\u0430\u0440\u0442\u0443
      \u0427\u0430\u043D\u044A\u0430\u043D\u044F: \xAB\u0423\u0447\u0430\u0441\u0442\u043E\u043A
      \u0435\u0441\u0442\u044C. \u041D\u0443\u0436\u043D\u044B \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B
      \u0438 \u043C\u0430\u0441\u0442\u0435\u0440\u0430. \u041D\u0430\u0447\u043D\u0451\u043C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877868
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877869
    m_Localized: "\xAB\u0414\u0443\u043C\u0430\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877870
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877871
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0433\u043E\u0440\u044F\u0447\u0435\u0433\u043E
      \u0432\u043E\u0441\u043A\u0430 \u0438 \u043F\u0443\u0440\u043F\u0443\u0440\u043D\u043E\u0433\u043E
      \u043A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044F \u0432\u043F\u0435\u0440\u0432\u044B\u0435
      \u0441\u043C\u0435\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0432 \u044D\u0442\u0438\u0445
      \u0441\u0442\u0435\u043D\u0430\u0445 - \u0432\u0430\u0448\u0438\u0445 \u0441\u0442\u0435\u043D\u0430\u0445.
      \u041C\u0430\u0441\u0442\u0435\u0440 \u0427\u044D\u043D\u044C \u0441\u0442\u043E\u0438\u0442
      \u043F\u043E\u0441\u0440\u0435\u0434\u0438 \u043D\u043E\u0432\u043E\u0433\u043E
      \u0437\u0430\u043B\u0430 \u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043E\u0431\u0432\u043E\u0434\u0438\u0442 \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C
      \u0447\u0430\u043D\u044B, \u043F\u043E\u043B\u043A\u0438 \u0441 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438,
      \u043E\u043A\u043D\u043E \u043D\u0430\u0434 \u0440\u0435\u043A\u043E\u0439.
      \xAB\u042F \u0441\u0442\u0440\u043E\u0438\u043B \u044D\u0442\u043E \u0432 \u0443\u043C\u0435
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442,\xBB -
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D \u0442\u0438\u0445\u043E.
      \xAB\u0422\u044B \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B \u0437\u0430
      \u043C\u0435\u0441\u044F\u0446\u044B.\xBB \u041E\u043D \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u0432\u0430\u043C. \xAB\u041E\u0441\u0442\u0430\u043B\u0441\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0448\u0430\u0433: \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0427\u0430\u043D\u044A\u0430\u043D\u044E,
      \u0447\u0442\u043E \u043B\u0443\u0447\u0448\u0438\u0439 \u043F\u0443\u0440\u043F\u0443\u0440
      - \u0437\u0434\u0435\u0441\u044C. \u0412\u043E\u0437\u044C\u043C\u0451\u0448\u044C\u0441\u044F
      \u0437\u0430 \u044D\u0442\u043E \u0441\u0435\u0439\u0447\u0430\u0441?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877872
    m_Localized: "\u0414\u043E\u043A\u0430\u0436\u0435\u043C \u0432\u0441\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877873
    m_Localized: "\u0427\u044D\u043D\u044C \u043A\u0438\u0432\u0430\u0435\u0442 \u0438
      \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u043E\u0431\u0440\u0430\u0437\u0435\u0446
      \u0442\u043A\u0430\u043D\u0438: \xAB\u041D\u0443\u0436\u043D\u0430 \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u0430\u044F
      \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0430 \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u044C.
      \u041F\u0443\u0440\u043F\u0443\u0440 \u0434\u043E\u043B\u0436\u0435\u043D \u0443\u0432\u0438\u0434\u0435\u0442\u044C
      \u0434\u0432\u043E\u0440.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877874
    m_Localized: "\u0417\u0430\u0439\u0434\u0443 \u043F\u043E\u0437\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877875
    m_Localized: "\xAB\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F
      \u0431\u0443\u0434\u0435\u0442 \u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877876
    m_Localized: "\u0427\u0435\u0442\u044B\u0440\u0435 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877877
    m_Localized: "\u0412 \u0410\u0440\u0445\u0438\u0432\u0435 \u043F\u0430\u0445\u043D\u0435\u0442
      \u0432\u043E\u0441\u043A\u043E\u043C \u0438 \u0441\u0442\u0430\u0440\u043E\u0439
      \u043A\u043E\u0436\u0435\u0439 - \u0424\u0430\u0440\u0443\u0445 \u0441\u0438\u0434\u0438\u0442
      \u043D\u0430\u0434 \u0440\u0430\u0437\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u043C\u0438
      \u043A\u0430\u0440\u0442\u0430\u043C\u0438, \u043A\u043E\u0433\u0434\u0430
      \u0432\u044B \u043A\u043B\u0430\u0434\u0451\u0442\u0435 \u043F\u0435\u0440\u0435\u0434
      \u043D\u0438\u043C \u0447\u0435\u0442\u044B\u0440\u0435 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0438.
      \u041E\u043D \u0432\u0441\u0442\u0430\u0451\u0442, \u0431\u0435\u0440\u0451\u0442
      \u043A\u0430\u0436\u0434\u0443\u044E, \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043A \u0441\u0432\u0435\u0442\u0443, \u0447\u0438\u0442\u0430\u0435\u0442
      \u043D\u0430\u0434\u043F\u0438\u0441\u0438 \u0431\u0435\u0437\u0437\u0432\u0443\u0447\u043D\u043E.
      \xAB\u0427\u0435\u0442\u044B\u0440\u0435. \u0412\u0441\u0435, \u0447\u0442\u043E
      \u043E\u0431\u0435\u0449\u0430\u043B\u0430 \u043A\u0430\u0440\u0442\u0430.\xBB
      \u0415\u0433\u043E \u043B\u0438\u0446\u043E - \u0440\u0435\u0434\u043A\u043E\u0435
      \u0437\u0440\u0435\u043B\u0438\u0449\u0435 - \u0432\u044B\u0440\u0430\u0436\u0430\u0435\u0442
      \u043D\u0435\u0447\u0442\u043E \u043F\u043E\u0445\u043E\u0436\u0435\u0435 \u043D\u0430
      \u0441\u0447\u0430\u0441\u0442\u044C\u0435. \xAB\u0422\u044B \u043D\u0435 \u0437\u043D\u0430\u0435\u0448\u044C,
      \u0447\u0442\u043E \u0434\u0435\u0440\u0436\u0438\u0448\u044C \u0432 \u0440\u0443\u043A\u0430\u0445.
      \u042F \u043E\u0431\u044A\u044F\u0441\u043D\u044E - \u043D\u043E \u0441\u043D\u0430\u0447\u0430\u043B\u0430:
      \u0435\u0441\u0442\u044C \u0441\u043B\u0435\u0434 \u0431\u043E\u043B\u0435\u0435
      \u043E\u043F\u0430\u0441\u043D\u044B\u0439. \u0413\u043E\u0442\u043E\u0432
      \u043A \u043D\u0435\u043C\u0443 \u0441\u0435\u0439\u0447\u0430\u0441?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877878
    m_Localized: "\u0413\u043E\u0442\u043E\u0432 \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877879
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043D\u043E\u0432\u0443\u044E \u043A\u0430\u0440\u0442\u0443 \u0441 \u0434\u0440\u043E\u0436\u0430\u0449\u0438\u043C\u0438
      \u0440\u0443\u043A\u0430\u043C\u0438. \xAB\u041F\u043E\u0434\u0434\u0435\u043B\u043A\u0438.
      \u041A\u0442\u043E-\u0442\u043E \u0442\u043E\u0440\u0433\u0443\u0435\u0442
      \u0444\u0430\u043B\u044C\u0448\u0438\u0432\u043A\u0430\u043C\u0438 \u043D\u0430\u0448\u0438\u0445
      \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0439. \u042D\u0442\u043E \u043D\u0443\u0436\u043D\u043E
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877880
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u0432\u0440\u0435\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877881
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0431\u0435\u0440\u0435\u0436\u043D\u043E
      \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442\u044B
      \u0432 \u044F\u0449\u0438\u043A. \xAB\u041E\u043D\u0438 \u0437\u0434\u0435\u0441\u044C,
      \u0432 \u0441\u043E\u0445\u0440\u0430\u043D\u043D\u043E\u0441\u0442\u0438.
      \u0410\u0440\u0445\u0438\u0432 \u0436\u0434\u0451\u0442, \u043F\u043E\u043A\u0430
      \u0442\u044B \u0433\u043E\u0442\u043E\u0432.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877882
    m_Localized: "\u0420\u0430\u0437\u043E\u0431\u043B\u0430\u0447\u0435\u043D\u0438\u0435
      \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877883
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0441\u0442\u043E\u0438\u0442 \u0443
      \u0432\u0445\u043E\u0434\u0430 \u0432 \u0410\u0440\u0445\u0438\u0432 \u0438
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442, \u043A\u0430\u043A \u0432\u044B
      \u0432\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0451\u043D\u043D\u044B\u043C\u0438
      \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F\u043C\u0438. \u041E\u043D
      \u043C\u043E\u043B\u0447\u0430 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A, \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      - \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044F
      \u043A\u0430\u0436\u0434\u0443\u044E \u0432\u0435\u0449\u044C. \xAB\u041F\u043E\u0434\u043B\u0438\u043D\u043D\u044B\u0435,\xBB
      - \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442
      \u043E\u043D \u0441 \u043E\u0431\u043B\u0435\u0433\u0447\u0435\u043D\u0438\u0435\u043C.
      \xAB\u041C\u043E\u0448\u0435\u043D\u043D\u0438\u043A\u0438 \u0434\u0443\u043C\u0430\u043B\u0438,
      \u0447\u0442\u043E \u0440\u044B\u043D\u043E\u043A \u043D\u0435 \u0440\u0430\u0437\u0431\u0435\u0440\u0451\u0442.
      \u0422\u044B \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043B\u0441\u044F.\xBB
      \u041E\u043D \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0438
      \u043D\u0430 \u043F\u043E\u043B\u043A\u0443 \u0441 \u0438\u043C\u0435\u043D\u043D\u044B\u043C\u0438
      \u044F\u0440\u043B\u044B\u043A\u0430\u043C\u0438. \xAB\u0422\u0435\u043F\u0435\u0440\u044C
      \u0442\u044B \u0437\u043D\u0430\u0435\u0448\u044C \u0440\u044B\u043D\u043E\u043A
      \u0438\u0437\u043D\u0443\u0442\u0440\u0438. \u0415\u0441\u0442\u044C \u043A\u043E\u0435-\u0447\u0442\u043E
      \u0432\u0430\u0436\u043D\u0435\u0435. \u041B\u0435\u0433\u0435\u043D\u0434\u0430\u0440\u043D\u043E\u0435
      \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435. \u0412\u043E\u0437\u044C\u043C\u0451\u0448\u044C\u0441\u044F
      \u0441\u0435\u0439\u0447\u0430\u0441?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877884
    m_Localized: "\u0413\u043E\u0432\u043E\u0440\u0438 \u043F\u0440\u043E \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877885
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u043A\u0430\u0440\u0442\u0443 \u0441 \u0433\u043E\u0440\u043D\u044B\u043C\u0438
      \u043E\u0442\u043C\u0435\u0442\u043A\u0430\u043C\u0438. \xAB\u0414\u0440\u0435\u0432\u043D\u044F\u044F
      \u043A\u0430\u0440\u0442\u0430. \u0412\u0435\u0440\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877886
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877887
    m_Localized: "\xAB\u0418\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877888
    m_Localized: "\u0425\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435 \u043E\u0442\u043A\u0440\u044B\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877889
    m_Localized: "\u0414\u0432\u0435\u0440\u044C \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0430
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0441 \u0442\u044F\u0436\u0451\u043B\u044B\u043C
      \u0432\u0437\u0434\u043E\u0445\u043E\u043C - \u0431\u0443\u0434\u0442\u043E
      \u0441\u043A\u0430\u043B\u0430 \u0434\u044B\u0448\u0438\u0442 \u0432\u043F\u0435\u0440\u0432\u044B\u0435
      \u0437\u0430 \u0441\u0442\u043E\u043B\u0435\u0442\u0438\u044F. \u0412\u043D\u0443\u0442\u0440\u0438
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0441\u0443\u0445\u0438\u043C \u043A\u0430\u043C\u043D\u0435\u043C
      \u0438 \u043C\u0435\u0442\u0430\u043B\u043B\u043E\u043C: \u043F\u043E\u043B\u043A\u0438
      \u0441 \u043A\u0443\u0432\u0448\u0438\u043D\u0430\u043C\u0438, \u0441\u0432\u0438\u0442\u043A\u0438
      \u0432 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0445 \u043D\u0438\u0448\u0430\u0445,
      \u043C\u0435\u0434\u043D\u044B\u0435 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u044B
      \u0441 \u043D\u0430\u0434\u043F\u0438\u0441\u044F\u043C\u0438. \u0424\u0430\u0440\u0443\u0445
      \u0437\u0430 \u0432\u0430\u0448\u0438\u043C \u043F\u043B\u0435\u0447\u043E\u043C
      \u043C\u043E\u043B\u0447\u0438\u0442 \u0434\u043E\u043B\u044C\u0448\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E.
      \xAB\u042D\u0442\u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435,\xBB
      - \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043E\u043D \u043D\u0430\u043A\u043E\u043D\u0435\u0446
      \u0448\u0451\u043F\u043E\u0442\u043E\u043C. \xAB\u041C\u044B \u043D\u0430\u0448\u043B\u0438
      \u0442\u043E, \u043E \u0447\u0451\u043C \u044F \u0447\u0438\u0442\u0430\u043B
      \u0432\u0441\u044E \u0436\u0438\u0437\u043D\u044C.\xBB \u041E\u043D \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      \xAB\u041E\u0441\u0442\u0430\u043B\u0441\u044F \u0444\u0438\u043D\u0430\u043B:
      \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u0430\u043C\u043E\u0435
      \u0446\u0435\u043D\u043D\u043E\u0435 \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u044C.
      \u0413\u043E\u0442\u043E\u0432?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877890
    m_Localized: "\u0413\u043E\u0442\u043E\u0432 \u043A \u0444\u0438\u043D\u0430\u043B\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877891
    m_Localized: "\u0424\u0430\u0440\u0443\u0445 \u0431\u0435\u0440\u0435\u0436\u043D\u043E
      \u0431\u0435\u0440\u0451\u0442 \u0441\u0430\u043C\u044B\u0439 \u0441\u0442\u0430\u0440\u044B\u0439
      \u0441\u0432\u0438\u0442\u043E\u043A. \xAB\u0427\u0430\u043D\u044A\u0430\u043D\u044C.
      \u0414\u0432\u043E\u0440\u0446\u043E\u0432\u044B\u0439 \u0430\u0440\u0445\u0438\u0432.
      \u0422\u0443\u0434\u0430 - \u0438 \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0443\u0434\u0430.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877892
    m_Localized: "\u041D\u0443\u0436\u043D\u043E \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 30440326668877893
    m_Localized: "\xAB\u0425\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435 \u043D\u0438\u043A\u0443\u0434\u0430
      \u043D\u0435 \u0434\u0435\u043D\u0435\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760157016064
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0414\u0430\u0440\u0438\u0443\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570496
    m_Localized: "\u0423 \u0432\u043E\u0440\u043E\u0442 \u043A\u0430\u0437\u0430\u0440\u043C
      \u0432\u0430\u0441 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0433\u0440\u0443\u0437\u043D\u044B\u0439 \u0441\u0435\u0434\u043E\u0432\u0430\u0442\u044B\u0439
      \u043C\u0443\u0436\u0447\u0438\u043D\u0430 \u0432 \u043F\u043E\u043D\u043E\u0448\u0435\u043D\u043D\u043E\u043C
      \u043A\u0430\u0444\u0442\u0430\u043D\u0435 \u0438\u0437 \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u044C\u0435\u0439
      \u0448\u0435\u0440\u0441\u0442\u0438. \u041B\u0438\u0446\u043E \u0438\u0437\u0440\u0443\u0431\u043B\u0435\u043D\u043E
      \u043F\u0443\u0441\u0442\u044B\u043D\u043D\u044B\u043C \u0432\u0435\u0442\u0440\u043E\u043C,
      \u043D\u0430 \u043B\u0435\u0432\u043E\u0439 \u0440\u0443\u043A\u0435 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0430\u044F
      \u0442\u0430\u0442\u0443\u0438\u0440\u043E\u0432\u043A\u0430 \u0441\u0442\u0430\u0440\u043E\u0439
      \u0448\u043A\u043E\u043B\u044B \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0430
      \u043E\u0431\u043E\u0437\u0430. \u042D\u0442\u043E \u0414\u0430\u0440\u0438\u0443\u0448,
      \u0432\u0435\u0442\u0435\u0440\u0430\u043D \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438, \u043D\u044B\u043D\u0447\u0435 \u0443\u0447\u0430\u0449\u0438\u0439
      \u043C\u043E\u043B\u043E\u0434\u044B\u0445. \u0413\u043E\u0432\u043E\u0440\u0438\u0442
      \u043F\u0440\u044F\u043C\u043E: \xAB\u0415\u0441\u0442\u044C \u043F\u0430\u0440\u0442\u0438\u044F
      \u043D\u043E\u0432\u043E\u0431\u0440\u0430\u043D\u0446\u0435\u0432. \u0414\u0435\u0441\u044F\u0442\u044C
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u0448\u0435\u0441\u0442\u044C
      \u043F\u043E\u0432\u043E\u0437\u043E\u043A: \u043D\u0430\u0434\u043E \u0434\u043E
      \u0410\u043D\u044C\u0441\u0438. \u041A\u0430\u0437\u0430\u0440\u043C\u0430
      \u043F\u043B\u0430\u0442\u0438\u0442, \u043D\u043E \u043B\u044E\u0434\u0438
      - \u043C\u043E\u0438\xBB. \u0421\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u0432\u0430\u0448 \u043E\u0431\u043E\u0437 \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u044E\u0449\u0438\u043C
      \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C. \xAB\u0412\u043E\u0437\u044C\u043C\u0451\u0448\u044C\u0441\u044F?\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570497
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570498
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u043A\u0438\u0432\u0430\u0435\u0442,
      \u043D\u0435 \u0432\u044B\u043A\u0430\u0437\u044B\u0432\u0430\u044F \u043E\u0431\u0438\u0434\u044B.
      \xAB\u041A\u0430\u0436\u0434\u044B\u0439 \u0441\u0430\u043C \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442
      \u0441\u0432\u043E\u044E \u0434\u043E\u0440\u043E\u0433\u0443. \u0410\u043D\u044C\u0441\u0438
      - \u043D\u0435 \u0434\u043B\u044F \u0432\u0441\u0435\u0445.\xBB \u041E\u043D
      \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u043A\u0430\u0437\u0430\u0440\u043C\u0435\u043D\u043D\u043E\u043C\u0443
      \u0434\u0432\u043E\u0440\u0443, \u0433\u0434\u0435 \u043D\u043E\u0432\u0438\u0447\u043A\u0438
      \u0432\u043E\u0437\u044F\u0442\u0441\u044F \u0441 \u0443\u043F\u0440\u044F\u0436\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570499
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0432\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570500
    m_Localized: "\u0412\u044B \u0436\u043C\u0451\u0442\u0435 \u0436\u0438\u043B\u0438\u0441\u0442\u0443\u044E
      \u0440\u0443\u043A\u0443 \u0414\u0430\u0440\u0438\u0443\u0448\u0430. \u041E\u043D
      \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u0442, \u043A\u0430\u043A
      \u0432\u044B \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u0442\u0435 \u043D\u043E\u0432\u043E\u0431\u0440\u0430\u043D\u0446\u0435\u0432
      \u0438 \u043E\u0442\u0434\u0430\u0451\u0442\u0435 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435
      \u043A\u043E\u043C\u0430\u043D\u0434\u044B: \u0432 \u0435\u0433\u043E \u0433\u043B\u0430\u0437\u0430\u0445
      \u043C\u0435\u043B\u044C\u043A\u0430\u0435\u0442 \u043E\u0434\u043E\u0431\u0440\u0435\u043D\u0438\u0435.
      \xAB\u0412\u0438\u0436\u0443 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.
      \u0414\u0432\u0435 \u043D\u0435\u0434\u0435\u043B\u0438 \u0434\u043E \u0410\u043D\u044C\u0441\u0438
      - \u0434\u043E\u0440\u043E\u0433\u0430 \u043F\u043B\u043E\u0445\u0430\u044F.
      \u0414\u043E\u0432\u0435\u0434\u0438 \u0438\u0445, \u0438 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C
      \u043E \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u0435\xBB.
      \u041E\u043D \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u0432\u0430\u043C
      \u043F\u0430\u0439\u0446\u0437\u0443 \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E
      \u043A\u0430\u0437\u0430\u0440\u043C\u044B \u0438 \u0441\u043F\u0438\u0441\u043E\u043A
      \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570501
    m_Localized: "\u0412\u044B \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0435\u0441\u044C,
      \u043D\u043E \u0414\u0430\u0440\u0438\u0443\u0448 \u0432\u0438\u0434\u0438\u0442:
      \u043D\u043E\u0432\u043E\u0431\u0440\u0430\u043D\u0446\u044B \u0432\u0430\u043C
      \u043D\u0435 \u0434\u043E\u0432\u0435\u0440\u044F\u044E\u0442, \u0441\u043B\u043E\u0432\u0430
      \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442 \u0441 \u0437\u0430\u043F\u0438\u043D\u043A\u043E\u0439,
      \u0433\u043E\u043B\u043E\u0441 \u043D\u0435\u0443\u0432\u0435\u0440\u0435\u043D.
      \u041E\u043D \u043C\u043E\u0440\u0449\u0438\u0442\u0441\u044F \u0438 \u043A\u0430\u0447\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439. \xAB\u041B\u0430\u0434\u043D\u043E,
      \u0431\u0435\u0440\u0438. \u041D\u043E \u043F\u0430\u0439\u0446\u0437\u0443
      \u043F\u043E\u043A\u0430 \u043F\u0440\u0438\u0434\u0435\u0440\u0436\u0443\xBB.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u0441\u0442\u0430\u0440\u0448\u0438\u0445
      \u043D\u043E\u0432\u043E\u0431\u0440\u0430\u043D\u0446\u0435\u0432, \u0425\u0430\u0441\u0430\u043D,
      \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u043F\u0440\u0430\u0432\u043E
      \u0433\u043E\u043B\u043E\u0441\u0430 \u0432 \u0434\u0435\u043B\u0430\u0445
      \u0438 \u0441\u043F\u043E\u0440\u0438\u0442 \u0441 \u0432\u0430\u043C\u0438
      \u043F\u043E \u043A\u0430\u0436\u0434\u043E\u0439 \u043C\u0435\u043B\u043E\u0447\u0438.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u0440\u0430\u0441\u0442\u044F\u043D\u0435\u0442\u0441\u044F
      \u0434\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u0441\u043B\u0435\u0434\u0443\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570502
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u0437\u0430\u043C\u043E\u043B\u0432\u0438\u0442 \u0441\u043B\u043E\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570503
    m_Localized: "\u0412\u0430\u0448 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u0448\u0430\u0433\u0430\u0435\u0442 \u0432\u043F\u0435\u0440\u0451\u0434 \u0438
      \u0445\u043B\u043E\u043F\u0430\u0435\u0442 \u0414\u0430\u0440\u0438\u0443\u0448\u0430
      \u043F\u043E \u043F\u043B\u0435\u0447\u0443: \u0432\u044B\u044F\u0441\u043D\u044F\u0435\u0442\u0441\u044F,
      \u0447\u0442\u043E \u043E\u043D\u0438 \u0441\u043B\u0443\u0436\u0438\u043B\u0438
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0432 \u043E\u0431\u043E\u0437\u0435
      \u0434\u043E \u0425\u043E\u0440\u0430\u0441\u0430\u043D\u0430. \u0414\u0430\u0440\u0438\u0443\u0448
      \u0440\u0430\u0441\u043F\u043B\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0432
      \u0440\u0435\u0434\u043A\u043E\u0439 \u0443\u043B\u044B\u0431\u043A\u0435.
      \xAB\u0415\u0441\u043B\u0438 \u0442\u044B \u0441 \u0420\u0443\u0441\u0442\u0430\u043C\u043E\u043C
      - \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0434\u0440\u0443\u0433\u043E\u0439\xBB.
      \u041E\u043D \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u043F\u0430\u0439\u0446\u0437\u0443
      \u0438 \u0441\u043F\u0438\u0441\u043E\u043A \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0441\u043B\u043E\u0432, \u0434\u043E\u0431\u0430\u0432\u0438\u0432: \xAB\u0418
      \u0434\u0432\u043E\u0435 \u043C\u043E\u0438\u0445 \u0438\u0434\u0443\u0442
      \u0441 \u0442\u043E\u0431\u043E\u0439. \u0411\u0435\u0440\u0435\u0433\u0438
      \u0438\u0445, \u043A\u0430\u043A \u0441\u0432\u043E\u0438\u0445\xBB. \u0412\u044B
      \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u0437\u0430\u0434\u0430\u043D\u0438\u0435\u043C,
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u043E\u0439 \u043F\u0430\u0439\u0446\u0437\u043E\u0439
      \u0438 \u0434\u0432\u0443\u043C\u044F \u043B\u0438\u0448\u043D\u0438\u043C\u0438
      \u0431\u043E\u0439\u0446\u0430\u043C\u0438 \u0432 \u043E\u0431\u043E\u0437\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570504
    m_Localized: "\u041F\u043E\u0434\u0443\u043C\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570505
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442
      \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438 \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u043F\u0430\u0439\u0446\u0437\u0443 \u0437\u0430 \u043F\u043E\u044F\u0441.
      \xAB\u0414\u0443\u043C\u0430\u0439. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043F\u043E\u0439\u0434\u0451\u0442 \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u0438
      \u0434\u043D\u044F - \u0441 \u0442\u043E\u0431\u043E\u0439 \u0438\u043B\u0438
      \u0431\u0435\u0437.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570506
    m_Localized: "\u041F\u043E\u0434\u043E\u0439\u0442\u0438 \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570507
    m_Localized: "\u0412\u044B \u0441\u043F\u0435\u0448\u0438\u0432\u0430\u0435\u0442\u0435\u0441\u044C
      \u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442\u0435 \u043A \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0443.
      \u041E\u043D \u0440\u0430\u0441\u043A\u043B\u0430\u043D\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u0435\u0442 \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0442\u043E\u0432\u0430\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570508
    m_Localized: "\u041A\u0438\u0432\u043D\u0443\u0442\u044C \u0438 \u043F\u0440\u043E\u0439\u0442\u0438
      \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570509
    m_Localized: "\u0412\u044B \u043A\u0438\u0432\u043A\u043E\u043C \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442\u0435
      \u043D\u0430 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435
      \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0435 \u043F\u0443\u0442\u044C.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043F\u043E\u0436\u0438\u043C\u0430\u0435\u0442
      \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u043A \u0441\u0432\u043E\u0438\u043C \u0442\u044E\u043A\u0430\u043C - \u0443
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0441\u0432\u043E\u044F \u0434\u043E\u0440\u043E\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570510
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570511
    m_Localized: "\u0412\u044B \u0441\u0430\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430
      \u043A\u0440\u0430\u0439 \u043A\u043E\u0432\u0440\u0430 \u0438 \u0431\u0435\u0440\u0451\u0442\u0435
      \u0432 \u0440\u0443\u043A\u0438 \u0442\u043E \u043E\u0434\u043D\u043E, \u0442\u043E
      \u0434\u0440\u0443\u0433\u043E\u0435. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u043E\u0445\u043E\u0442\u043D\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043E \u043A\u0430\u0436\u0434\u043E\u0439 \u0432\u0435\u0449\u0438 - \u0433\u0434\u0435
      \u043A\u0443\u043F\u043B\u0435\u043D\u0430, \u0443 \u043A\u043E\u0433\u043E,
      \u043F\u043E \u043A\u0430\u043A\u043E\u0439 \u0446\u0435\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570512
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u0438 \u0438\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570513
    m_Localized: "\u0412\u044B \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u0435
      \u0437\u0430 \u0433\u043E\u0441\u0442\u0435\u043F\u0440\u0438\u0438\u043C\u0441\u0442\u0432\u043E
      \u0438 \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0435\u0441\u044C.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043B\u0430\u0434\u043E\u043D\u0438 \u0443 \u0433\u0440\u0443\u0434\u0438
      - \xAB\u043B\u0451\u0433\u043A\u043E\u0433\u043E \u043F\u0443\u0442\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570514
    m_Localized: "\u041E\u0442\u043A\u0440\u044B\u0442\u044C \u043E\u0431\u043C\u0435\u043D
      \u0442\u043E\u0432\u0430\u0440\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570515
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D\u044B \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u0434\u0440\u0443\u0433 \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432 \u0434\u0440\u0443\u0433\u0430,
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E\u0442
      \u0442\u044E\u043A\u0438. \u041C\u0435\u0436\u0434\u0443 \u0434\u0432\u0443\u043C\u044F
      \u043E\u0431\u043E\u0437\u0430\u043C\u0438 \u0437\u0430\u0432\u044F\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0442\u043E\u0440\u0433 - \u0434\u0435\u043B\u043E\u0432\u043E\u0439 \u0438
      \u043D\u0435\u0441\u043F\u0435\u0448\u043D\u044B\u0439, \u043A\u0430\u043A
      \u0438 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043E \u043D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570516
    m_Localized: "\u041E\u0431\u043C\u0435\u043D\u044F\u0442\u044C\u0441\u044F \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F\u043C\u0438
      \u0438 \u0440\u0430\u0437\u043E\u0439\u0442\u0438\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570517
    m_Localized: "\u0412\u044B \u043E\u0431\u043C\u0435\u043D\u0438\u0432\u0430\u0435\u0442\u0435\u0441\u044C
      \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F\u043C\u0438
      - \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435 \u043D\u043E\u0432\u043E\u0441\u0442\u0438
      \u0441 \u0434\u043E\u0440\u043E\u0433\u0438, \u0438\u043C\u0435\u043D\u0430
      \u0433\u043E\u0440\u043E\u0434\u043E\u0432, \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u044B \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F,
      \u0443\u043D\u043E\u0441\u044F \u0447\u0443\u0436\u0438\u0435 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B
      \u0432 \u043F\u0430\u043C\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570518
    m_Localized: "\u0428\u043A\u0443\u0440\u044B \u0440\u0430\u0437\u044A\u0435\u0445\u0430\u043B\u0438\u0441\u044C
      \u043F\u043E\u0434 \u043A\u043E\u043B\u0451\u0441\u0430\u043C\u0438, \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0441\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0430 \u0431\u043E\u043A\u043E\u043C.
      \u0423\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0443\u0434\u0430\u043B\u043E\u0441\u044C,
      \u043D\u043E \u043E\u0441\u044C\u044E \u0443\u0434\u0430\u0440\u0438\u043B\u043E
      \u043E \u0441\u043A\u0430\u043B\u0443. \u0427\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430
      \u0432\u044B\u043B\u0435\u0442\u0435\u043B\u0430 \u0432 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C,
      \u043E\u0441\u044C \u0442\u0440\u0435\u0441\u043D\u0443\u043B\u0430. \u0414\u0435\u043D\u044C
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D, \u0438 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u0438
      \u0432 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430\u0445 \u043F\u043E\u0443\u0431\u0430\u0432\u0438\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570519
    m_Localized: "\u0416\u0435\u0441\u0442\u044B \u0432\u044B\u0448\u043B\u0438 \u043D\u0435\u043B\u043E\u0432\u043A\u0438\u0435,
      \u043B\u043E\u043C\u0430\u043D\u044B\u0435 \u0441\u043B\u043E\u0432\u0430 -
      \u043E\u0431\u0438\u0434\u043D\u044B\u0435. \u041A\u043E\u043C\u0430\u043D\u0434\u0438\u0440
      \u043D\u0430\u0445\u043C\u0443\u0440\u0438\u043B\u0441\u044F \u0438 \u0443\u0434\u0432\u043E\u0438\u043B
      \u043F\u043E\u0448\u043B\u0438\u043D\u0443 \xAB\u0437\u0430 \u043D\u0435\u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\xBB.
      \u0421\u0435\u0440\u0435\u0431\u0440\u043E \u0443\u0448\u043B\u043E \u0432\u0434\u0432\u043E\u0435
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0437\u0430\u0434\u0443\u043C\u0430\u043D\u043D\u043E\u0433\u043E,
      \u0430 \u0434\u0432\u043E\u0435 \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u043E\u0432
      \u0441\u043E\u043F\u0440\u043E\u0432\u043E\u0436\u0434\u0430\u043B\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0434\u043E \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430, \u0441\u043B\u043E\u0432\u043D\u043E
      \u043A\u043E\u043D\u0432\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570520
    m_Localized: "\u0421\u0442\u044B\u0447\u043A\u0430 \u043F\u043E\u0448\u043B\u0430
      \u043D\u0435 \u043F\u043E \u043F\u043B\u0430\u043D\u0443. \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432
      \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0432\u0438\u0434\u0435\u043B\u043E\u0441\u044C \u0438\u0437-\u0437\u0430
      \u0432\u0430\u043B\u0443\u043D\u043E\u0432, \u0438 \u0431\u0430\u0440\u0440\u0438\u043A\u0430\u0434\u0443
      \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0440\u0432\u0430\u043B\u0441\u044F
      \u0446\u0435\u043D\u043E\u0439 \u0440\u0430\u043D\u0435\u043D\u044B\u0445,
      \u0443\u0442\u0440\u0430\u0447\u0435\u043D\u043D\u044B\u0445 \u0442\u044E\u043A\u043E\u0432
      \u0438 \u043F\u0430\u0432\u0448\u0435\u0433\u043E \u0432\u044C\u044E\u0447\u043D\u043E\u0433\u043E
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570521
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0431\u043E\u0433\u043D\u0443\u043B
      \u043C\u043E\u043D\u0430\u0445\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439,
      \u043D\u043E \u0432 \u043E\u0431\u0445\u043E\u0434 \u0442\u0440\u043E\u043F\u0430
      \u0441\u0443\u0436\u0430\u043B\u0430\u0441\u044C \u0438 \u0448\u043B\u0430
      \u043F\u043E\u0434 \u043D\u0430\u0432\u0438\u0441\u0430\u044E\u0449\u0438\u043C
      \u043A\u0430\u0440\u043D\u0438\u0437\u043E\u043C. \u041A\u0430\u043C\u043D\u0435\u043F\u0430\u0434
      \u043E\u0431\u0440\u0443\u0448\u0438\u043B\u0441\u044F \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F.
      \u0414\u0432\u0443\u0445 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0437\u0430\u0434\u0435\u043B\u043E, \u043F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0440\u0430\u0437\u0431\u0438\u043B\u043E, \u0433\u0440\u0443\u0437 \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u0441\u044F
      \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443. \u041C\u043E\u043B\u0438\u0442\u0432\u044B
      \u043C\u043E\u043D\u0430\u0445\u0430 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u043B\u0438
      \u043D\u0435 \u0437\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570522
    m_Localized: "\u0411\u0435\u0437 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u0446\u044B
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0443\u043F\u0443\u0441\u0442\u0438\u043B
      \u043F\u043E\u0432\u043E\u0440\u043E\u0442 \u0432 \u0442\u0443\u043C\u0430\u043D\u0435
      \u0438 \u0437\u0430\u0431\u0440\u0451\u043B \u0432 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439
      \u043B\u0430\u0431\u0438\u0440\u0438\u043D\u0442. \u0414\u0432\u043E\u0435
      \u0441\u0443\u0442\u043E\u043A \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B
      \u043D\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435,
      \u0441\u043A\u043E\u0442 \u0438\u0437\u043C\u043E\u0442\u0430\u043D, \u0432
      \u0442\u044E\u043A\u0430\u0445 \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C
      \u0441\u043B\u0435\u0434\u044B \u0434\u043E\u0436\u0434\u044F. \u0414\u0435\u043D\u044C\u0433\u0438,
      \u0447\u0442\u043E \u0432\u044B \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043B\u0438,
      \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u043F\u043E\u0442\u0435\u0440\u044F\u043C\u0438
      \u0432\u0442\u0440\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570523
    m_Localized: "\u0421\u043C\u0435\u043B\u044C\u0447\u0430\u043A\u0438 \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0438\u0441\u044C
      \u0441\u043E \u0441\u043A\u043B\u043E\u043D\u0430 \u043E\u0449\u0443\u043F\u044C\u044E,
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435 \u043E\u0441\u0442\u0443\u043F\u0438\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0441\u044B\u043F\u0443\u0447\u0438\u0445 \u043A\u0430\u043C\u043D\u044F\u0445.
      \u041E\u0434\u0438\u043D \u0441\u043E\u0440\u0432\u0430\u043B\u0441\u044F,
      \u043F\u043E\u0432\u0440\u0435\u0434\u0438\u043B \u043D\u043E\u0433\u0443;
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0441 \u043F\u043E\u0440\u0432\u0430\u043D\u043D\u043E\u0439 \u043A\u0443\u0440\u0442\u043A\u043E\u0439
      \u0438 \u0431\u0435\u0437 \u0444\u0430\u043A\u0435\u043B\u0430. \u041E\u0433\u043D\u0438
      \u0432\u0441\u0451 \u0442\u0430\u043A \u0436\u0435 \u043C\u0435\u0440\u0446\u0430\u043B\u0438
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435, \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435.
      \u0423\u0442\u0440\u043E\u043C \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0432\u044B\u0437\u044B\u0432\u0430\u0442\u044C \u043F\u043E\u043C\u043E\u0449\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570524
    m_Localized: "\u041A\u0430\u043C\u043D\u0438 \u0438 \u0431\u0440\u0451\u0432\u043D\u0430
      \u043D\u0435 \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u043B\u0438, \u0432\u0435\u0440\u0451\u0432\u043A\u0430
      \u043E\u0431\u043E\u0440\u0432\u0430\u043B\u0430\u0441\u044C. \u041F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0441\u043E\u0440\u0432\u0430\u043B\u0430\u0441\u044C, \u043F\u0440\u043E\u043A\u0430\u0442\u0438\u043B\u0430\u0441\u044C
      \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443 \u0438 \u0440\u0430\u0437\u0431\u0438\u043B\u0430\u0441\u044C
      \u043E \u0432\u044B\u0441\u0442\u0443\u043F \u0441\u043A\u0430\u043B\u044B
      \u043C\u0435\u0442\u0440\u0430\u0445 \u0432 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438
      \u043D\u0438\u0436\u0435. \u0413\u0440\u0443\u0437 \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u0441\u044F
      \u043F\u043E \u043A\u0430\u043C\u043D\u044F\u043C, \u0447\u0430\u0441\u0442\u044C
      - \u0432 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C. \u041B\u043E\u0448\u0430\u0434\u0435\u0439
      \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043E\u0431\u0440\u0435\u0437\u0430\u0442\u044C
      \u0432\u043E\u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570525
    m_Localized: "\u0421\u0440\u0443\u0431\u043B\u0435\u043D\u043D\u043E\u0435 \u0434\u0435\u0440\u0435\u0432\u0446\u0435
      \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0433\u043D\u0438\u043B\u044B\u043C
      \u0432\u043D\u0443\u0442\u0440\u0438, \u043A\u043E\u0436\u0430\u043D\u044B\u0435
      \u0440\u0435\u043C\u043D\u0438 \u043B\u043E\u043F\u043D\u0443\u043B\u0438 \u043D\u0430
      \u043F\u0435\u0440\u0432\u043E\u043C \u0436\u0435 \u0440\u044B\u0432\u043A\u0435.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0430 \u0441\u043D\u043E\u0432\u0430 \u043F\u0440\u043E\u0441\u0435\u043B\u0430,
      \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u0443\u0436\u0435 \u0433\u0440\u0443\u0437
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0441\u043D\u0438\u043C\u0430\u0442\u044C
      \u0438 \u043D\u0435\u0441\u0442\u0438 \u043D\u0430 \u0440\u0443\u043A\u0430\u0445
      \u0434\u043E \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0433\u043E \u043B\u0430\u0433\u0435\u0440\u044F.
      \u041F\u043E\u043B\u0434\u043D\u044F \u043F\u043E\u0442\u0435\u0440\u0438 \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0438\u0441\u044C
      \u0432 \u0434\u0432\u043E\u0435 \u0441\u0443\u0442\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570526
    m_Localized: "\u041A\u0438\u0440\u043A\u0430 \u0443\u0434\u0430\u0440\u0438\u043B\u0430
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0431\u043B\u0438\u0437\u043A\u043E
      \u043A \u043E\u043F\u043E\u0440\u0435. \u0421\u0432\u043E\u0434 \u0442\u0440\u0435\u0441\u043D\u0443\u043B,
      \u0438 \u043F\u044B\u043B\u044C \u0445\u043B\u044B\u043D\u0443\u043B\u0430
      \u0432\u043D\u0438\u0437. \u041E\u0434\u0438\u043D \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0435\u0434\u0432\u0430 \u0443\u0441\u043F\u0435\u043B \u0432\u044B\u0441\u043A\u043E\u0447\u0438\u0442\u044C
      \u0441 \u0434\u0432\u0443\u043C\u044F \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u043B\u0430\u043C\u0438
      \u0432 \u0440\u0443\u043A\u0430\u0445, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      - \u043F\u043E\u0434 \u0437\u0430\u0432\u0430\u043B\u043E\u043C. \u0421\u043F\u0443\u0441\u043A\u0430\u0442\u044C\u0441\u044F
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0437\u0430 \u0434\u043E\u0431\u044B\u0447\u0435\u0439
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u0440\u0438\u0441\u043A\u043D\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 31159760190570527
    m_Localized: "\u0412\u044B \u043F\u044B\u0442\u0430\u0435\u0442\u0435\u0441\u044C
      \u0441\u0434\u0432\u0438\u043D\u0443\u0442\u044C \u0430\u043B\u0442\u0430\u0440\u044C,
      \u043D\u043E \u043F\u043B\u0438\u0442\u0430 \u043F\u0430\u0434\u0430\u0435\u0442
      \u0441 \u0433\u0440\u043E\u0445\u043E\u0442\u043E\u043C, \u043E\u0431\u043D\u0430\u0436\u0430\u044F
      \u043F\u0443\u0441\u0442\u0443\u044E \u043D\u0438\u0448\u0443 - \u043A\u0442\u043E-\u0442\u043E
      \u043F\u043E\u0431\u044B\u0432\u0430\u043B \u0437\u0434\u0435\u0441\u044C \u0434\u043E
      \u0432\u0430\u0441. \u041D\u0430 \u0441\u0442\u0435\u043D\u0430\u0445 \u043F\u043E\u044F\u0432\u043B\u044F\u044E\u0442\u0441\u044F
      \u0442\u0440\u0435\u0449\u0438\u043D\u044B, \u0438 \u043A\u0430\u043C\u0435\u043D\u043D\u0430\u044F
      \u043F\u044B\u043B\u044C \u0437\u0430\u0441\u044B\u043F\u0430\u0435\u0442 \u0444\u0440\u0435\u0441\u043A\u0438.
      \u0423\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u043F\u0443\u0441\u0442\u044B\u043C\u0438
      \u0440\u0443\u043A\u0430\u043C\u0438 \u0438 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u044B\u043C
      \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u0435\u043C, \u0447\u0442\u043E
      \u043F\u043E\u0442\u0440\u0435\u0432\u043E\u0436\u0438\u043B\u0438 \u043C\u0435\u0441\u0442\u043E,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043B\u0443\u0447\u0448\u0435 \u0431\u044B\u043B\u043E
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0432 \u043F\u043E\u043A\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496568623104
    m_Localized: "\u0425\u0430\u0434\u0436\u0438 \u042E\u0441\u0443\u0444"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177536
    m_Localized: "\u0412 \u0411\u0443\u0445\u0430\u0440\u0435, \u0432 \u0442\u0435\u043D\u0438\u0441\u0442\u043E\u043C
      \u0434\u0432\u043E\u0440\u0435 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u0434\u043E\u043C\u0430 \u0410\u043B\u044C-\u0411\u0443\u0445\u0430\u0440\u0438,
      \u0432\u0430\u0441 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u0425\u0430\u0434\u0436\u0438
      \u042E\u0441\u0443\u0444, \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044C
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0439 \u043A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u043E\u0439
      \u0441\u0435\u043C\u044C\u0438 \u0432 \u0442\u0440\u0435\u0442\u044C\u0435\u043C
      \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u0438. \u041D\u0430 \u0441\u0442\u043E\u043B\u0435
      \u043F\u0438\u0430\u043B\u0430 \u0441 \u0437\u0435\u043B\u0451\u043D\u044B\u043C
      \u0447\u0430\u0435\u043C \u0438 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442
      \u043D\u0430 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0435,
      \u0441\u043A\u0440\u0435\u043F\u043B\u0451\u043D\u043D\u044B\u0439 \u043F\u0435\u0447\u0430\u0442\u044C\u044E
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438. \u042E\u0441\u0443\u0444 \u0436\u0434\u0451\u0442.
      \u0426\u0438\u0444\u0440\u044B \u0432 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0435
      \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u044B \u043A\u0440\u0443\u043F\u043D\u043E,
      \u043D\u043E \u043E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0435
      \u043D\u0430 \u043D\u0438\u0445, \u0430 \u043D\u0430 \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177537
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0443\u0441\u043B\u043E\u0432\u0438\u044F
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177538
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442\u0435
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u0431\u0435\u0437 \u043F\u0440\u0430\u0432\u043E\u043A.
      \u042E\u0441\u0443\u0444 \u043A\u0438\u0432\u0430\u0435\u0442 \u0441 \u043B\u0451\u0433\u043A\u0438\u043C
      \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u0435\u043C:
      \u0432 \u0411\u0443\u0445\u0430\u0440\u0435 \u0443\u0432\u0430\u0436\u0430\u044E\u0442
      \u0442\u0435\u0445, \u043A\u0442\u043E \u0442\u043E\u0440\u0433\u0443\u0435\u0442\u0441\u044F.
      \u041F\u0435\u0447\u0430\u0442\u044C \u0433\u0438\u043B\u044C\u0434\u0438\u0438
      \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044F \u043D\u0430 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442,
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E \u043E\u0442\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043B\u0430\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043F\u043E\u0434\u043D\u043E\u0441. \u0421\u0434\u0435\u043B\u043A\u0430
      \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0430, \u043D\u043E \u042E\u0441\u0443\u0444
      \u0432\u0430\u0441 \u0443\u0436\u0435 \u043D\u0435 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177539
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0437\u0430 \u0434\u043E\u043B\u044E \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177540
    m_Localized: "\u0412\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u043E
      \u0440\u0430\u0441\u0445\u043E\u0434\u0430\u0445 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443,
      \u043E \u043D\u0430\u043B\u043E\u0433\u0430\u0445 \u044D\u043C\u0438\u0440\u0430,
      \u043E \u0442\u043E\u043C, \u043A\u0430\u043A \u0440\u0430\u0441\u0442\u0443\u0442
      \u0446\u0435\u043D\u044B \u043D\u0430 \u0445\u043B\u043E\u043F\u043E\u043A
      \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u0435. \u042E\u0441\u0443\u0444
      \u0441\u043B\u0443\u0448\u0430\u0435\u0442, \u043A\u0438\u0432\u0430\u0435\u0442,
      \u043F\u043E\u0434\u043B\u0438\u0432\u0430\u0435\u0442 \u0447\u0430\u0439,
      \u0438 \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u0446\u0438\u0444\u0440\u044B
      \u0432 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442
      \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0432 \u0432\u0430\u0448\u0443
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443. \u0427\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441 \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438
      \u043B\u0435\u0436\u0438\u0442 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442
      \u0441 \u0434\u043E\u043B\u0435\u0439 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430,
      \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u043D\u043E\u0439 \u043D\u0430
      \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C, \u0438 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442\u044C \u0435\u0449\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177541
    m_Localized: "\u0412\u0430\u0448\u0438 \u0434\u043E\u0432\u043E\u0434\u044B \u042E\u0441\u0443\u0444
      \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u0435\u0442 \u043E\u0434\u0438\u043D
      \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u043C: \u043E\u043D \u0442\u043E\u0440\u0433\u0443\u0435\u0442
      \u0445\u043B\u043E\u043F\u043A\u043E\u043C \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C
      \u043B\u0435\u0442 \u0438 \u0441\u043B\u044B\u0448\u0430\u043B \u0432\u0441\u0451.
      \u041E\u043D \u043D\u0435 \u0437\u043B\u0438\u0442\u0441\u044F, \u043D\u043E
      \u0432 \u0433\u043B\u0430\u0437\u0430\u0445 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C. \u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442
      \u043F\u043E\u0434\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0433\u0438\u043B\u044C\u0434\u0438\u0438,
      \u0431\u0435\u0437 \u0432\u0430\u0448\u0435\u0439 \u043D\u0430\u0434\u0431\u0430\u0432\u043A\u0438.
      \u041D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435 \u042E\u0441\u0443\u0444
      \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442: \xAB\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434
      \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0433\u043E\u0440\u043E\u0434.
      \u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0442\u0435\u0441\u044C,
      \u043A\u043E\u0433\u0434\u0430 \u0443\u0437\u043D\u0430\u0435\u0442\u0435 \u0446\u0435\u043D\u0443
      \u0445\u043B\u043E\u043F\u043A\u0430 \u043D\u0435 \u0438\u0437 \u0447\u0443\u0436\u0438\u0445
      \u0441\u043B\u043E\u0432.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177542
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u0431\u0435\u0441\u0435\u0434\u0443 \u043D\u0430 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177543
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442 \u043D\u0430 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439:
      \u0440\u0435\u0447\u044C \u0431\u0435\u0433\u043B\u0430\u044F, \u0432\u0435\u0436\u043B\u0438\u0432\u0430\u044F,
      \u0441 \u0443\u043C\u0435\u0441\u0442\u043D\u044B\u043C\u0438 \u0446\u0438\u0442\u0430\u0442\u0430\u043C\u0438
      \u0438\u0437 \u0431\u0443\u0445\u0430\u0440\u0441\u043A\u0438\u0445 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u043E\u043A.
      \u042E\u0441\u0443\u0444 \u0440\u0430\u0441\u0446\u0432\u0435\u0442\u0430\u0435\u0442:
      \u0434\u0430\u0432\u043D\u043E \u0435\u043C\u0443 \u043D\u0435 \u0434\u043E\u0432\u043E\u0434\u0438\u043B\u043E\u0441\u044C
      \u0432\u0435\u0441\u0442\u0438 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B
      \u043D\u0430 \u0440\u043E\u0434\u043D\u043E\u043C \u044F\u0437\u044B\u043A\u0435
      \u0441 \u043F\u0440\u0438\u0448\u043B\u044B\u043C. \u0427\u0430\u0439 \u0438\u0437
      \u0437\u0435\u043B\u0451\u043D\u043E\u0433\u043E \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
      \u0431\u0435\u043B\u044B\u043C, \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u0434\u0430\u044E\u0442\u0441\u044F
      \u0441\u043B\u0430\u0434\u043E\u0441\u0442\u0438. \u041A\u043E\u043D\u0442\u0440\u0430\u043A\u0442
      \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044F \u0443\u0436\u0435
      \u043D\u0435 \u043A\u0430\u043A \u0441\u0434\u0435\u043B\u043A\u0430, \u0430
      \u043A\u0430\u043A \u043D\u0430\u0447\u0430\u043B\u043E \u0434\u043E\u043B\u0433\u043E\u0439
      \u0434\u0440\u0443\u0436\u0431\u044B. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0432\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C,
      \u0443\u0434\u0432\u043E\u0435\u043D\u043D\u043E\u0439 \u0434\u043E\u043B\u0435\u0439
      \u0438 \u0433\u043E\u0440\u0441\u0442\u044C\u044E \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0445
      \u0444\u0440\u0430\u0437, \u043E\u0441\u0435\u0432\u0448\u0438\u0445 \u0432
      \u043F\u0430\u043C\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177544
    m_Localized: "\u041A\u0430\u043C\u0435\u043D\u043D\u0430\u044F \u0441\u0442\u0435\u043B\u0430
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177545
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u0447\u0435\u0440\u0435\u0437 \u0432\u044B\u0441\u043E\u043A\u0438\u0439
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B \u0440\u0430\u0437\u0434\u0432\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0443 \u0432\u044B\u0432\u0435\u0442\u0440\u0435\u043D\u043D\u043E\u0439 \u0441\u0442\u0435\u043B\u044B,
      \u0438\u0441\u043F\u0435\u0449\u0440\u0451\u043D\u043D\u043E\u0439 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u043C\u0438
      \u043D\u0430\u0434\u043F\u0438\u0441\u044F\u043C\u0438. \u041E\u0434\u0438\u043D
      \u043F\u0443\u0442\u044C \u0443\u0432\u043E\u0434\u0438\u0442 \u0432\u043D\u0438\u0437
      \u0432 \u0437\u0435\u043B\u0451\u043D\u044B\u0435 \u0434\u043E\u043B\u0438\u043D\u044B,
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0432\u044B\u0448\u0435 \u0432 \u043E\u0431\u043B\u0430\u043A\u0430.
      \u0423 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F \u0441\u0442\u0435\u043B\u044B
      \u0441\u0438\u0434\u0438\u0442 \u0445\u0443\u0434\u043E\u0439 \u0441\u0442\u0430\u0440\u0438\u043A-\u044F\u043A\u043E\u0432\u043E\u0434\u044B
      \u0432 \u043F\u043E\u0442\u0451\u0440\u0442\u043E\u0439 \u043E\u0432\u0447\u0438\u043D\u0435,
      \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u044F \u0447\u0451\u0442\u043A\u0438
      \u0438\u0437 \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
      \u043A\u043E\u0441\u0442\u0438. \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0448 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0438 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F, \u0431\u0443\u0434\u0442\u043E
      \u0434\u0430\u0432\u043D\u043E \u0436\u0434\u0430\u043B. \u041B\u043E\u0431\u0441\u0430\u043D\u0433
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u043E \u0433\u043E\u0440\u043D\u043E\u043C
      \u0445\u0440\u0430\u043C\u0435, \u043D\u043E \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B,
      \u043A\u0430\u043A \u0435\u0433\u043E \u043D\u0430\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177546
    m_Localized: "\u0418\u0434\u0442\u0438 \u043F\u043E \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u044E
      \u0441\u0432\u0438\u0442\u043A\u0430 \u041B\u043E\u0431\u0441\u0430\u043D\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177547
    m_Localized: "\u0412\u044B \u0434\u043E\u0441\u0442\u0430\u0451\u0442\u0435 \u0441\u0432\u0438\u0442\u043E\u043A
      \u0438 \u0441\u0432\u0435\u0440\u044F\u0435\u0442\u0435 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435
      \u0441 \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C\u044E. \u041F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0439
      \u0432\u043E\u0437\u0434\u0443\u0445 \u043E\u0431\u043C\u0430\u043D\u044B\u0432\u0430\u0435\u0442:
      \u0442\u043E, \u0447\u0442\u043E \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
      \u0431\u043B\u0438\u0437\u043A\u043E, \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E\u043B\u0443\u0434\u043D\u0435\u043C \u043F\u0443\u0442\u0438.
      \u041D\u043E \u043A \u0432\u0435\u0447\u0435\u0440\u0443 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E
      \u0434\u043D\u044F \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u0442\u043E\u043D\u043A\u0438\u0439
      \u0434\u044B\u043C\u043E\u043A \u043D\u0430\u0434 \u0441\u043A\u0430\u043B\u043E\u0439:
      \u0445\u0440\u0430\u043C. \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0434\u043E\u0445\u043E\u0434\u0438\u0442
      \u0441\u0430\u043C, \u0431\u0435\u0437 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u0432,
      \u0438 \u044D\u0442\u043E \u0443\u043A\u0440\u0435\u043F\u043B\u044F\u0435\u0442
      \u0434\u043E\u0432\u0435\u0440\u0438\u0435 \u043B\u044E\u0434\u0435\u0439 \u043A
      \u0432\u0430\u0448\u0435\u043C\u0443 \u0447\u0443\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177548
    m_Localized: "\u0412\u044B \u0441\u0431\u0438\u0432\u0430\u0435\u0442\u0435\u0441\u044C
      \u0441 \u0442\u0440\u043E\u043F\u044B \u043D\u0430 \u0442\u0440\u0435\u0442\u0438\u0439
      \u0434\u0435\u043D\u044C. \u0421\u0432\u0438\u0442\u043E\u043A \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
      \xAB\u0434\u0432\u0430 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0445 \u043F\u0430\u043B\u044C\u0446\u0430
      \u0443 \u0431\u0435\u043B\u043E\u0433\u043E \u0440\u0443\u0447\u044C\u044F\xBB:
      \u0442\u0430\u043A\u0438\u0445 \u043F\u0430\u043B\u044C\u0446\u0435\u0432 \u0432
      \u0422\u0438\u0431\u0435\u0442\u0435 \u0434\u0435\u0441\u044F\u0442\u043A\u0438.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043B\u0443\u0442\u0430\u0435\u0442,
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u0442\u0430\u044E\u0442, \u043A\u0442\u043E-\u0442\u043E
      \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u0437\u0430\u0431\u043E\u043B\u0435\u0432\u0430\u0435\u0442.
      \u0425\u0440\u0430\u043C \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u0433\u0434\u0430 \u0441\u0430\u043C\u0438
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u0435 \u043D\u0430 \u043F\u0430\u0441\u0442\u0443\u0445\u0430-\u044F\u043A\u043E\u0432\u043E\u0434\u044B,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0438 \u043F\u0440\u0438\u0432\u043E\u0434\u0438\u0442
      \u0432\u0430\u0441. \u0414\u043E\u0439\u0434\u0451\u0442\u0435, \u043D\u043E
      \u0438\u0437\u043C\u043E\u0442\u0430\u043D\u043D\u044B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177549
    m_Localized: "\u0420\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C
      \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u043F\u0430\u0441\u0442\u0443\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177550
    m_Localized: "\u0412\u044B \u0441\u0430\u0434\u0438\u0442\u0435\u0441\u044C \u0440\u044F\u0434\u043E\u043C
      \u0441\u043E \u0441\u0442\u0430\u0440\u0438\u043A\u043E\u043C \u0438 \u0434\u043E\u043B\u0433\u043E
      \u043C\u043E\u043B\u0447\u0438\u0442\u0435 \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u043D\u0438\u043C: \u0442\u0430\u043A \u043F\u0440\u0438\u043D\u044F\u0442\u043E
      \u0432 \u0433\u043E\u0440\u0430\u0445. \u041F\u043E\u0442\u043E\u043C \u043E\u043D
      \u0441\u0430\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442: \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0440\u0443\u043A\u043E\u0439 \u043D\u0430 \u0432\u0435\u0440\u0445\u043D\u044E\u044E
      \u0442\u0440\u043E\u043F\u0443, \u0440\u0438\u0441\u0443\u0435\u0442 \u043F\u043E\u0441\u043E\u0445\u043E\u043C
      \u043D\u0430 \u0437\u0435\u043C\u043B\u0435 \u043A\u0440\u0443\u0433 \u0438
      \u0442\u0440\u0438 \u043E\u0442\u043C\u0435\u0442\u043A\u0438. \u0412\u0430\u0448\u0435\u043C\u0443
      \u0442\u043E\u043B\u043C\u0430\u0447\u0443 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      \u0436\u0435\u0441\u0442\u043E\u0432 \u0438 \u043E\u0431\u0440\u044B\u0432\u043A\u043E\u0432:
      \u0445\u0440\u0430\u043C \u0437\u0430 \u0432\u0442\u043E\u0440\u044B\u043C
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u043E\u043C, \u0443 \u0431\u0435\u043B\u043E\u0433\u043E
      \u0440\u0443\u0447\u044C\u044F. \u0421\u0442\u0430\u0440\u0438\u043A \u043E\u0442\u043B\u0430\u043C\u044B\u0432\u0430\u0435\u0442
      \u043A\u0443\u0441\u043E\u043A \u044F\u0447\u044C\u0435\u0433\u043E \u0441\u044B\u0440\u0430
      \u0438 \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442:
      \xAB\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177551
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0431\u0435\u0441\u0435\u0434\u0443\u0435\u0442
      \u043D\u0430 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177552
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043B\u0430\u0434\u043E\u043D\u0438
      \u0443 \u0433\u0440\u0443\u0434\u0438 \u0438 \u043E\u0431\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u043A \u0441\u0442\u0430\u0440\u0438\u043A\u0443 \u043D\u0430 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u043C,
      \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043B\u043E\u0432\u0430\u043C\u0438,
      \u0430 \u0441 \u0443\u043C\u0435\u0441\u0442\u043D\u044B\u043C\u0438 \u0444\u043E\u0440\u043C\u0443\u043B\u0430\u043C\u0438
      \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0438. \u0421\u0442\u0430\u0440\u0438\u043A
      \u0441\u0432\u0435\u0442\u043B\u0435\u0435\u0442 \u043B\u0438\u0446\u043E\u043C
      \u0438 \u0437\u0430\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442
      \u043E\u0445\u043E\u0442\u043D\u043E, \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u044F
      \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043E \u0442\u0440\u043E\u043F\u0435,
      \u043D\u043E \u0438 \u043E \u0434\u0443\u0445\u0430\u0445 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430,
      \u043E \u0442\u043E\u043C, \u043A\u0430\u043A\u0438\u0435 \u043C\u0430\u043D\u0442\u0440\u044B
      \u0447\u0438\u0442\u0430\u0442\u044C \u0443 \u0441\u043A\u0430\u043B\u044B
      \u043F\u0435\u0440\u0435\u0434 \u0445\u0440\u0430\u043C\u043E\u043C, \u043A\u0430\u043A\u043E\u0439
      \u043F\u043E\u0434\u0430\u0440\u043E\u043A \u043D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044E
      \u043F\u0440\u0438\u043D\u044F\u0442\u044C \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B.
      \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u043E\u0439
      \u043A\u0430\u0440\u0442\u043E\u0439 \u0432 \u0433\u043E\u043B\u043E\u0432\u0435,
      \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435\u043C
      \u0438 \u043F\u0430\u0440\u043E\u0439 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0445
      \u0441\u043B\u043E\u0432, \u043E\u0441\u0435\u0432\u0448\u0438\u0445 \u0432
      \u043F\u0430\u043C\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177553
    m_Localized: "\u0414\u044B\u043C \u043D\u0430\u0434 \u0431\u0430\u0440\u0445\u0430\u043D\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177554
    m_Localized: "\u041F\u0435\u0441\u0447\u0430\u043D\u0430\u044F \u0431\u0443\u0440\u044F
      \u043E\u0442\u0448\u0443\u043C\u0435\u043B\u0430 \u043A \u0443\u0442\u0440\u0443.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
      \u043D\u0430 \u0433\u0440\u0435\u0431\u043D\u0435 \u0434\u044E\u043D\u044B,
      \u0438 \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0440\u0443\u043A\u043E\u0439 \u043D\u0430 \u0437\u0430\u043F\u0430\u0434:
      \u043D\u0430\u0434 \u0431\u0430\u0440\u0445\u0430\u043D\u0430\u043C\u0438 \u0432
      \u0442\u0440\u0451\u0445 \u0432\u0435\u0440\u0441\u0442\u0430\u0445 \u0441\u0442\u043E\u0438\u0442
      \u0442\u043E\u043D\u043A\u0438\u0439 \u0441\u0442\u043E\u043B\u0431\u0438\u043A
      \u0441\u0435\u0440\u043E\u0433\u043E \u0434\u044B\u043C\u0430. \u0412 \u043D\u0435\u0431\u0435
      \u043A\u0440\u0443\u0436\u0430\u0442 \u0433\u0440\u0438\u0444\u044B. \u0413\u0434\u0435-\u0442\u043E
      \u0442\u0430\u043C \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0438\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D,
      \u0438\u043B\u0438 \u0442\u043E, \u0447\u0442\u043E \u043E\u0442 \u043D\u0435\u0433\u043E
      \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C. \u041F\u0435\u0441\u043E\u043A
      \u0435\u0449\u0451 \u043D\u0435 \u0443\u0441\u043F\u0435\u043B \u0437\u0430\u043D\u0435\u0441\u0442\u0438
      \u0441\u043B\u0435\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177555
    m_Localized: "\u0418\u0434\u0442\u0438 \u043D\u0430 \u0434\u044B\u043C \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177556
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u044B\u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F
      \u043A \u0434\u044B\u043C\u0443 \u0441\u043A\u043E\u0440\u044B\u043C \u0448\u0430\u0433\u043E\u043C.
      \u0427\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u0447\u0430\u0441\u0430
      \u0432\u044B \u0443\u0436\u0435 \u0432\u0438\u0434\u0438\u0442\u0435 \u043E\u0441\u0442\u0430\u0442\u043A\u0438
      \u043B\u0430\u0433\u0435\u0440\u044F: \u0447\u0435\u0442\u044B\u0440\u0435
      \u0442\u0435\u043B\u0435\u0433\u0438, \u0431\u0443\u0440\u0434\u044E\u043A\u0438
      \u0441 \u0432\u043E\u0434\u043E\u0439, \u0432\u044B\u0436\u0438\u0432\u0448\u0438\u0445
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0436\u0433\u0443\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0445\u0432\u043E\u0440\u043E\u0441\u0442, \u0447\u0442\u043E\u0431\u044B
      \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438. \u041E\u0431\u044A\u044F\u0442\u0438\u044F,
      \u0441\u043B\u0451\u0437\u044B, \u0444\u043B\u044F\u0433\u0438 \u0432\u043E\u0434\u044B.
      \u0412\u044B \u0432\u044B\u0432\u043E\u0434\u0438\u0442\u0435 \u0432\u0441\u0435\u0445
      \u043A \u043A\u043E\u043B\u043E\u0434\u0446\u0443, \u0440\u0430\u0437\u0433\u0440\u043E\u043C\u043B\u0435\u043D\u043D\u044B\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0441\u043F\u0430\u0441\u0451\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177557
    m_Localized: "\xAB\u0414\u044B\u043C\xBB \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043C\u0438\u0440\u0430\u0436\u043E\u043C - \u0433\u043E\u0440\u044F\u0447\u0438\u0439
      \u0432\u043E\u0437\u0434\u0443\u0445 \u043D\u0430\u0434 \u0432\u044B\u0445\u043E\u0434\u043E\u043C
      \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A\u0430, \u0438\u0441\u043A\u0430\u0436\u0451\u043D\u043D\u044B\u0439
      \u0443\u0442\u0440\u0435\u043D\u043D\u0438\u043C \u0441\u0432\u0435\u0442\u043E\u043C.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0442\u0435\u0440\u044F\u0435\u0442
      \u043F\u043E\u043B\u0434\u043D\u044F, \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u0438 \u0432\u0435\u0440\u0443 \u0432 \u0432\u0430\u0448\u0435 \u0447\u0443\u0442\u044C\u0451.
      \u041A\u043E\u0433\u0434\u0430 \u0432\u044B \u043D\u0430\u043A\u043E\u043D\u0435\u0446
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435 \u043F\u0440\u043E\u043F\u0430\u0432\u0448\u0438\u0445
      \u043F\u043E \u0434\u0440\u0443\u0433\u0438\u043C \u0441\u043B\u0435\u0434\u0430\u043C,
      \u0443 \u043D\u0438\u0445 \u0443\u0436\u0435 \u0447\u0435\u0442\u0432\u0435\u0440\u043E
      \u0432 \u0433\u043E\u0440\u044F\u0447\u043A\u0435 \u0438 \u0434\u0432\u043E\u0435
      \u0443\u043C\u0435\u0440\u0448\u0438\u0445 \u043E\u0442 \u0436\u0430\u0436\u0434\u044B.
      \u0421\u043F\u0430\u0441\u043B\u0438, \u043D\u043E \u0434\u043E\u0440\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177558
    m_Localized: "\u0421\u0434\u0435\u043B\u0430\u0442\u044C \u043A\u0440\u0443\u0433
      \u0448\u0438\u0440\u0435, \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0447\u0435\u0441\u0442\u044C
      \u0441\u043B\u0435\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177559
    m_Localized: "\u0412\u044B \u043E\u0431\u0445\u043E\u0434\u0438\u0442\u0435 \u0434\u044B\u043C
      \u043F\u043E \u0448\u0438\u0440\u043E\u043A\u043E\u0439 \u0434\u0443\u0433\u0435,
      \u0447\u0438\u0442\u0430\u044F \u0441\u043B\u0435\u0434\u044B \u0432 \u043F\u0435\u0441\u043A\u0435:
      \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0435 \u043A\u043E\u043B\u0435\u0438
      \u043D\u0430\u0433\u0440\u0443\u0436\u0435\u043D\u043D\u044B\u0445 \u0442\u0435\u043B\u0435\u0433,
      \u043B\u0451\u0433\u043A\u0438\u0435 \u043E\u0442\u043F\u0435\u0447\u0430\u0442\u043A\u0438
      \u043B\u044E\u0434\u0435\u0439, \u0438\u0434\u0443\u0449\u0438\u0445 \u0440\u044F\u0434\u043E\u043C.
      \u041F\u043E \u0441\u043B\u0435\u0434\u0430\u043C \u044F\u0441\u043D\u043E,
      \u0447\u0442\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0448\u0451\u043B
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u043D\u043E \u043D\u0435
      \u0440\u0430\u0437\u0433\u0440\u0430\u0431\u043B\u0435\u043D. \u041A \u043F\u043E\u043B\u0443\u0434\u043D\u044E
      \u0432\u044B \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u0435 \u043D\u0430
      \u043B\u0430\u0433\u0435\u0440\u044C \u043D\u0435 \u0441 \u0444\u0440\u043E\u043D\u0442\u0430,
      \u0430 \u0441\u0431\u043E\u043A\u0443, \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u044B \u0438 \u043E\u0431\u0440\u0430\u0434\u043E\u0432\u0430\u043D\u044B.
      \u0414\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0430 \u043E\u043A\u0443\u043F\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177560
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0447\u0438\u0442\u0430\u0435\u0442
      \u0441\u043B\u0435\u0434\u044B \u0432 \u043F\u0435\u0441\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177561
    m_Localized: "\u0412\u0430\u0448 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0441\u043F\u0435\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u0438 \u0438\u0434\u0451\u0442
      \u043F\u0435\u0448\u043A\u043E\u043C, \u0441\u043A\u043B\u043E\u043D\u0438\u0432\u0448\u0438\u0441\u044C
      \u043A \u043F\u0435\u0441\u043A\u0443. \u0427\u0435\u0440\u0435\u0437 \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C
      \u0447\u0430\u0441\u0430 \u043E\u043D \u0443\u0436\u0435 \u0437\u043D\u0430\u0435\u0442
      \u0432\u0441\u0451: \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0438\u0437
      \u0448\u0435\u0441\u0442\u0438 \u0442\u0435\u043B\u0435\u0433, \u0442\u0440\u043E\u0438\u0445
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432, \u0434\u0432\u0443\u0445
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432, \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0432\u043E\u0434\u0443 \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439
      \u0434\u0435\u043D\u044C, \u0438\u0434\u0443\u0442 \u043D\u0430 \u0437\u0430\u043F\u0430\u0434
      \u0442\u0440\u0435\u0442\u044C\u0438 \u0441\u0443\u0442\u043A\u0438. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0432\u0435\u0434\u0451\u0442 \u0432\u0430\u0441 \u043A \u043D\u0438\u043C
      \u043A\u0440\u0430\u0442\u0447\u0430\u0439\u0448\u0438\u043C \u043F\u0443\u0442\u0451\u043C
      - \u0440\u043E\u0432\u043D\u043E \u043A \u0437\u0430\u043A\u0430\u0442\u0443,
      \u043A\u043E\u0433\u0434\u0430 \u0441\u0438\u043B\u044B \u0443\u0436\u0435
      \u043D\u0430 \u0438\u0441\u0445\u043E\u0434\u0435. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0441\u043F\u0430\u0441\u0451\u043D \u0432 \u043F\u043E\u043B\u043D\u043E\u043C
      \u0441\u043E\u0441\u0442\u0430\u0432\u0435, \u0430 \u0441\u0440\u0435\u0434\u0438
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
      \u043F\u043E\u0434\u0430\u0440\u043A\u043E\u0432 - \u043F\u0430\u043A\u0435\u0442
      \u0444\u0438\u043D\u0438\u043A\u043E\u0432 \u0438\u0437 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
      \u0433\u0440\u0443\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177562
    m_Localized: "\u0417\u0430\u0441\u0430\u0434\u0430 \u0443 \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177563
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442\u0435
      \u043A \u043F\u0435\u0440\u0435\u043A\u0440\u0451\u0441\u0442\u043A\u0443 \u0443
      \u0441\u043E\u043B\u044F\u043D\u043E\u0433\u043E \u043E\u0437\u0435\u0440\u0430,
      \u0438 \u0438\u0437-\u0437\u0430 \u043D\u0438\u0437\u043A\u0438\u0445 \u0445\u043E\u043B\u043C\u043E\u0432
      \u0441\u043B\u044B\u0448\u043D\u044B \u043A\u0440\u0438\u043A\u0438. \u0414\u044E\u0436\u0438\u043D\u0430
      \u0432\u0441\u0430\u0434\u043D\u0438\u043A\u043E\u0432 \u0432 \u0447\u0451\u0440\u043D\u043E\u043C
      \u0432\u043E\u0439\u043B\u043E\u043A\u0435 \u043E\u043A\u0440\u0443\u0436\u0438\u043B\u0430
      \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u0438\u0439
      \u043E\u0431\u043E\u0437: \u0442\u0440\u0438 \u0442\u0435\u043B\u0435\u0433\u0438,
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u0440\u0438\u0436\u0430\u043B\u0438\u0441\u044C
      \u043A \u0437\u0435\u043C\u043B\u0435, \u0433\u043B\u0430\u0432\u0430\u0440\u044C
      \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432 \u0443\u0436\u0435 \u0441\u043F\u0435\u0448\u0438\u043B\u0441\u044F
      \u0438 \u0440\u0435\u0436\u0435\u0442 \u0432\u0435\u0440\u0451\u0432\u043A\u0438
      \u043D\u0430 \u0442\u044E\u043A\u0430\u0445. \u0411\u0430\u043D\u0434\u0438\u0442\u044B
      \u0432\u0430\u0441 \u0435\u0449\u0451 \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B\u0438,
      \u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B \u0442\u043E\u043B\u044C\u043A\u043E-\u0442\u043E\u043B\u044C\u043A\u043E
      \u0443\u0432\u0438\u0434\u0435\u043B\u0438 \u0438 \u043A\u0440\u0438\u0447\u0430\u0442,
      \u043F\u0440\u043E\u0441\u044F \u043E \u043F\u043E\u043C\u043E\u0449\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177564
    m_Localized: "\u0410\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C \u0432 \u043B\u043E\u0431
      \u0441 \u043A\u0440\u0438\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177565
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0435
      \u0440\u0443\u043A\u0443 \u0438 \u0431\u0440\u043E\u0441\u0430\u0435\u0442\u0435
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u0432 \u0430\u0442\u0430\u043A\u0443
      \u0441 \u043A\u0440\u0438\u043A\u043E\u043C. \u0411\u0430\u043D\u0434\u0438\u0442\u044B,
      \u043D\u0435 \u043E\u0436\u0438\u0434\u0430\u0432\u0448\u0438\u0435 \u0443\u0434\u0430\u0440\u0430,
      \u043D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435 \u0446\u0435\u043F\u0435\u043D\u0435\u044E\u0442.
      \u042D\u0442\u043E\u0433\u043E \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u044F
      \u0445\u0432\u0430\u0442\u0430\u0435\u0442: \u0442\u0440\u043E\u0435 \u043F\u0430\u0434\u0430\u044E\u0442
      \u0441\u0440\u0430\u0437\u0443, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0431\u0440\u043E\u0441\u0430\u044E\u0442 \u0434\u043E\u0431\u044B\u0447\u0443
      \u0438 \u0443\u0445\u043E\u0434\u044F\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u0445\u043E\u043B\u043C\u043E\u0432. \u0413\u043B\u0430\u0432\u0430\u0440\u044C
      \u0443\u0441\u043F\u0435\u0432\u0430\u0435\u0442 \u0448\u0432\u044B\u0440\u043D\u0443\u0442\u044C
      \u0432 \u0432\u0430\u0441 \u0441\u0430\u0431\u043B\u044E, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u0443\u0435\u0445\u0430\u0442\u044C, \u043E\u0441\u0442\u0430\u0432\u0438\u0432
      \u0441\u0430\u0431\u043B\u044E \u0432 \u043F\u0435\u0441\u043A\u0435 \u043A\u0430\u043A
      \u0442\u0440\u043E\u0444\u0435\u0439. \u041A\u0443\u043F\u0446\u044B \u0441\u043F\u0430\u0441\u0435\u043D\u044B,
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0440\u0430\u0441\u0447\u0438\u0449\u0435\u043D,
      \u0441\u0440\u0435\u0434\u0438 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u0435\u0439:
      \u043A\u043B\u0438\u043D\u043E\u043A \u0438 \u043A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u043E\u0435
      \u0441\u043F\u0430\u0441\u0438\u0431\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177566
    m_Localized: "\u0412\u0430\u0448\u0430 \u0430\u0442\u0430\u043A\u0430 \u043F\u0443\u0442\u0430\u0435\u0442
      \u0441\u0442\u0440\u043E\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430:
      \u043E\u0434\u043D\u0438 \u0440\u0432\u0430\u043D\u0443\u043B\u0438 \u0432\u043F\u0435\u0440\u0451\u0434,
      \u0434\u0440\u0443\u0433\u0438\u0435 \u0437\u0430\u0441\u0442\u0440\u044F\u043B\u0438
      \u043D\u0430 \u043F\u0435\u0441\u043A\u0435. \u0411\u0430\u043D\u0434\u0438\u0442\u044B
      \u043B\u043E\u0432\u044F\u0442 \u043C\u043E\u043C\u0435\u043D\u0442 \u0438
      \u043A\u043E\u043D\u0442\u0440\u0430\u0442\u0430\u043A\u0443\u044E\u0442. \u0421\u0442\u044B\u0447\u043A\u0430
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442 \u0432 \u0441\u0432\u0430\u043B\u043A\u0443,
      \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0431\u0430\u043D\u0434\u0438\u0442\u044B
      \u0443\u0441\u043F\u0435\u0432\u0430\u044E\u0442 \u0443\u043D\u0435\u0441\u0442\u0438
      \u0447\u0430\u0441\u0442\u044C \u0442\u044E\u043A\u043E\u0432 \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432. \u041A\u0443\u043F\u0446\u044B
      \u0441\u043F\u0430\u0441\u0435\u043D\u044B, \u043D\u043E \u043D\u0435 \u0432\u0441\u0435,
      \u0438 \u0433\u0440\u0443\u0437 \u043F\u043E\u0442\u0435\u0440\u044F\u043D.
      \u0411\u0430\u043D\u0434\u0438\u0442\u044B \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u044E\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u043E\u0433\u0434\u0430 \u0432\u044B
      \u043F\u043B\u0430\u0442\u0438\u0442\u0435 \u0438\u043C \u043E\u0442\u043A\u0443\u043F
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177567
    m_Localized: "\u041E\u043A\u0440\u0443\u0436\u0438\u0442\u044C \u0441 \u0444\u043B\u0430\u043D\u0433\u0430,
      \u043F\u0440\u0438\u0436\u0430\u0442\u044C \u043A \u0441\u043A\u0430\u043B\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177568
    m_Localized: "\u0412\u044B \u0434\u0435\u043B\u0430\u0435\u0442\u0435 \u043A\u0440\u044E\u043A
      \u0437\u0430 \u043D\u0438\u0437\u043A\u0438\u0435 \u0445\u043E\u043B\u043C\u044B
      \u0438 \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u0435 \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u043C
      \u0441 \u0442\u044B\u043B\u0430. \u041A\u043E\u0433\u0434\u0430 \u043E\u043D\u0438
      \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      - \u0430 \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044E\u0442\u0441\u044F
      \u043E\u043D\u0438 \u043F\u043E\u0437\u0434\u043D\u043E, \u0443\u0432\u043B\u0451\u043A\u0448\u0438\u0441\u044C
      \u0433\u0440\u0430\u0431\u0435\u0436\u043E\u043C - \u0437\u0430 \u0438\u0445
      \u0441\u043F\u0438\u043D\u0430\u043C\u0438 \u0443\u0436\u0435 \u0441\u0442\u043E\u0438\u0442
      \u0432\u0430\u0448 \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043B\u043E\u0442\u043D\u044B\u043C
      \u0441\u0442\u0440\u043E\u0435\u043C. \u0413\u043B\u0430\u0432\u0430\u0440\u044C
      \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u0442 \u0440\u0430\u0441\u043A\u043B\u0430\u0434
      \u0432 \u043E\u0434\u043D\u043E \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435:
      \u0431\u0440\u043E\u0441\u0430\u0435\u0442 \u0434\u043E\u0431\u044B\u0447\u0443,
      \u043C\u0430\u0448\u0435\u0442 \u0441\u0432\u043E\u0438\u043C, \u0438 \u0431\u0430\u043D\u0434\u0430
      \u0443\u0445\u043E\u0434\u0438\u0442 \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A
      \u0432 \u0442\u0435\u043C\u043F\u0435 \u0433\u0430\u043B\u043E\u043F\u0430.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0443\u0431\u0438\u0442, \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u0440\u0430\u0441\u0447\u0438\u0449\u0435\u043D, \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B
      \u0446\u0435\u043B\u0443\u044E\u0442 \u0432\u0430\u043C \u0440\u0443\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177569
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0420\u0443\u0441\u0442\u0430\u043C
      \u0432\u043E\u0437\u0433\u043B\u0430\u0432\u043B\u044F\u0435\u0442 \u043E\u0442\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177570
    m_Localized: "\u0412\u0430\u0448 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u0420\u0443\u0441\u0442\u0430\u043C \u0432\u044B\u0445\u043E\u0434\u0438\u0442
      \u0432\u043F\u0435\u0440\u0451\u0434 \u0438 \u0431\u0435\u0440\u0451\u0442
      \u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0432\u0430\u043D\u0438\u0435 \u043D\u0430
      \u0441\u0435\u0431\u044F: \u043E\u043D \u0431\u044B\u0432\u0448\u0438\u0439
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u0439\u0441\u043A\u0438\u0439
      \u0441\u0442\u0440\u0430\u0436 \u0438 \u0437\u043D\u0430\u0435\u0442 \u0442\u0430\u043A\u0438\u0445
      \u0431\u0430\u043D\u0434\u0438\u0442\u043E\u0432. \u041E\u043D \u0440\u0430\u0441\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0432\u0430\u0448\u0438\u0445 \u043B\u044E\u0434\u0435\u0439 \u0447\u0451\u0442\u043A\u043E:
      \u0442\u0440\u043E\u0435 \u0432 \u043E\u0431\u0445\u043E\u0434, \u0434\u0432\u043E\u0435
      \u0441 \u0442\u044B\u043B\u0430, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0441 \u0444\u0440\u043E\u043D\u0442\u0430. \u0410\u0442\u0430\u043A\u0430
      \u0438\u0434\u0451\u0442 \u0441\u043B\u0430\u0436\u0435\u043D\u043D\u043E,
      \u0431\u0435\u0437 \u043A\u0440\u0438\u043A\u043E\u0432, \u043A\u0430\u043A
      \u0443 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E \u043E\u0442\u0440\u044F\u0434\u0430.
      \u0411\u0430\u043D\u0434\u0438\u0442\u044B \u0434\u0440\u043E\u0433\u043D\u0443\u043B\u0438,
      \u0431\u0440\u043E\u0441\u0438\u043B\u0438 \u043E\u0440\u0443\u0436\u0438\u0435,
      \u0433\u043B\u0430\u0432\u0430\u0440\u044C \u043C\u043E\u043B\u0438\u0442 \u043E
      \u043F\u043E\u0449\u0430\u0434\u0435. \u0420\u0443\u0441\u0442\u0430\u043C
      \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u0435\u0442 \u0438\u0445 \u0431\u0435\u0437
      \u043E\u0440\u0443\u0436\u0438\u044F, \u043F\u0443\u0441\u0442\u044C \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442
      \u043D\u0430 \u0442\u0440\u0430\u043A\u0442\u0435, \u0447\u0442\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u044B
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0432\u043E\u0437\u044C\u043C\u0443\u0442
      \u043F\u0440\u043E\u0441\u0442\u043E \u0442\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177571
    m_Localized: "\u0422\u0440\u0430\u0432\u043D\u0438\u043A \u0441 \u0433\u043E\u0440
      \u041A\u0443\u043D\u044C\u043B\u0443\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177572
    m_Localized: "\u0412 \u0433\u043E\u0440\u043D\u043E\u043C \u0441\u0435\u043B\u0435\u043D\u0438\u0438
      \u043A \u0441\u0435\u0432\u0435\u0440\u0443 \u043E\u0442 \u0410\u043D\u044C\u0441\u0438,
      \u0432 \u0441\u0430\u043C\u0430\u043D\u043D\u043E\u043C \u0434\u0432\u043E\u0440\u0435
      \u0441 \u0447\u0430\u043D\u0430\u043C\u0438 \u043F\u043E\u0434 \u043D\u0430\u0432\u0435\u0441\u043E\u043C,
      \u0432\u0430\u0441 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u0441\u0442\u0430\u0440\u044B\u0439
      \u0442\u0440\u0430\u0432\u043D\u0438\u043A \u0423 \u0426\u0437\u0438\u043D:
      \u043C\u043E\u0440\u0449\u0438\u043D\u0438\u0441\u0442\u043E\u0435 \u043B\u0438\u0446\u043E,
      \u0441\u0438\u043D\u0438\u0435 \u043E\u0442 \u043A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u044F
      \u043F\u0430\u043B\u044C\u0446\u044B, \u0443\u0437\u043B\u043E\u0432\u0430\u0442\u044B\u0439
      \u043F\u043E\u0441\u043E\u0445 \u0440\u044F\u0434\u043E\u043C. \u041E\u043D
      \u0442\u043E\u0440\u0433\u0443\u0435\u0442 \u0438\u043D\u0434\u0438\u0433\u043E
      \u043E\u0441\u043E\u0431\u043E\u0439 \u0432\u044B\u0434\u0435\u043B\u043A\u0438,
      \u0432\u044B\u0440\u0430\u0449\u0435\u043D\u043D\u044B\u043C \u043D\u0430 \u0433\u043E\u0440\u043D\u044B\u0445
      \u0442\u0435\u0440\u0440\u0430\u0441\u0430\u0445: \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439,
      \u043D\u0430\u0441\u044B\u0449\u0435\u043D\u043D\u044B\u0439, \u0431\u0435\u0437
      \u0437\u0435\u043B\u0435\u043D\u043E\u0432\u0430\u0442\u043E-\u0441\u0435\u0440\u043E\u0433\u043E
      \u043E\u0442\u0442\u0435\u043D\u043A\u0430 \u0440\u0430\u0432\u043D\u0438\u043D\u043D\u043E\u0433\u043E.
      \u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043B
      \u0438\u043C\u0435\u043D\u043D\u043E \u0435\u0433\u043E: \u044D\u0442\u043E
      \u0438 \u0435\u0441\u0442\u044C \u0443\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0439
      \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177573
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0438\u043D\u0434\u0438\u0433\u043E
      \u043F\u043E \u0437\u0430\u043F\u0440\u043E\u0448\u0435\u043D\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177574
    m_Localized: "\u0412\u044B \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E \u0431\u0435\u0437 \u0441\u043B\u043E\u0432.
      \u0423 \u0426\u0437\u0438\u043D \u043A\u0438\u0432\u0430\u0435\u0442, \u043E\u0442\u043C\u0435\u0440\u044F\u0435\u0442
      \u0433\u043E\u0440\u0441\u0442\u044C \u043F\u0430\u0441\u0442\u044B \u0432
      \u0433\u043B\u0438\u043D\u044F\u043D\u0443\u044E \u043F\u043B\u043E\u0448\u043A\u0443,
      \u0443\u043F\u0430\u043A\u043E\u0432\u044B\u0432\u0430\u0435\u0442 \u0432 \u043F\u0440\u043E\u043C\u0430\u0441\u043B\u0435\u043D\u043D\u0443\u044E
      \u0442\u043A\u0430\u043D\u044C. \u0421\u0434\u0435\u043B\u043A\u0430 \u0434\u0435\u043B\u043E\u0432\u0430\u044F,
      \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445 \u0441\u043B\u043E\u0432.
      \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u043F\u0438\u0433\u043C\u0435\u043D\u0442\u043E\u043C,
      \u043A\u043E\u0448\u0435\u043B\u044C\u043A\u043E\u043C \u043B\u0435\u0433\u0447\u0435
      \u0438 \u0442\u0435\u043D\u044C\u044E \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u0438\u044F
      \u0443 \u0441\u0442\u0430\u0440\u0438\u043A\u0430: \u043E\u043D \u043D\u0430\u0434\u0435\u044F\u043B\u0441\u044F
      \u043D\u0430 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u043E \u0440\u0435\u043C\u0435\u0441\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177575
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F,
      \u0441\u0441\u044B\u043B\u0430\u044F\u0441\u044C \u043D\u0430 \u043C\u0430\u0441\u0442\u0435\u0440\u0430
      \u0427\u044D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177576
    m_Localized: "\u0412\u044B \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442\u0435
      \u0438\u043C\u044F \u043C\u0430\u0441\u0442\u0435\u0440\u0430 \u0427\u044D\u043D\u044C
      \u0412\u044D\u044F - \u0438 \u0441\u0442\u0430\u0440\u0438\u043A \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F
      \u0432 \u043B\u0438\u0446\u0435. \xAB\u0427\u044D\u043D\u044C? \u0422\u043E\u0442
      \u0441\u0430\u043C\u044B\u0439, \u0438\u0437 \u0427\u0430\u043D\u044A\u0430\u043D\u044F?
      \u041E\u043D \u0443 \u043C\u0435\u043D\u044F \u0443\u0447\u0438\u043B\u0441\u044F
      \u0432 \u043C\u043E\u043B\u043E\u0434\u043E\u0441\u0442\u0438.\xBB \u0426\u0435\u043D\u0430
      \u043F\u0430\u0434\u0430\u0435\u0442 \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u0441\u0430\u043C\u0430 \u0441\u043E\u0431\u043E\u0439, \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442 \u043D\u0430 \u0441\u043E\u0440\u0442\u0430,
      \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u044B, \u0441\u0435\u043A\u0440\u0435\u0442\u044B
      \u0432\u044B\u0434\u0435\u0440\u0436\u043A\u0438. \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435
      \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0441 \u043F\u0438\u0433\u043C\u0435\u043D\u0442\u043E\u043C,
      \u043D\u043E \u0438 \u0441 \u0433\u043E\u0440\u0441\u0442\u044C\u044E \u0441\u043E\u0432\u0435\u0442\u043E\u0432,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u0435\u0440\u0435\u0434\u0430\u0434\u0438\u0442\u0435
      \u0427\u044D\u043D\u044E, \u0438 \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C
      \u043A \u0441\u0442\u0430\u0440\u043E\u043C\u0443 \u043C\u0430\u0441\u0442\u0435\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177577
    m_Localized: "\u0421\u0442\u0430\u0440\u0438\u043A \u0441\u043B\u0443\u0448\u0430\u0435\u0442
      \u0432\u0430\u0448\u0435 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435
      \u0427\u044D\u043D\u044F, \u043D\u043E \u043D\u0435 \u0432\u0435\u0440\u0438\u0442.
      \xAB\u0427\u044D\u043D\u044C \u043D\u0435 \u043F\u043E\u0441\u044B\u043B\u0430\u0435\u0442
      \u0442\u043E\u0440\u0433\u0430\u0448\u0435\u0439, \u043E\u043D \u0441\u0430\u043C
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442, \u043A\u043E\u0433\u0434\u0430
      \u0435\u043C\u0443 \u043D\u0430\u0434\u043E.\xBB \u0426\u0435\u043D\u0430 \u043D\u0435
      \u043F\u0430\u0434\u0430\u0435\u0442, \u0438 \u0437\u0430 \u0432\u0430\u0448\u0443
      \u043D\u0430\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C
      \u043E\u043D \u0431\u0435\u0440\u0451\u0442 \u043D\u0430\u0434\u0431\u0430\u0432\u043A\u0443
      (\xAB\u0437\u0430 \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u0439\u0441\u0442\u0432\u043E\xBB).
      \u041F\u0438\u0433\u043C\u0435\u043D\u0442 \u0432\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435,
      \u043D\u043E \u0434\u043E\u0440\u043E\u0436\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E,
      \u0438 \u0441\u0442\u0430\u0440\u0438\u043A \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0431\u0435\u0437 \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177578
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u0435\u0442
      \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0443\u044E \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C
      \u043F\u0438\u0433\u043C\u0435\u043D\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177579
    m_Localized: "\u0412\u0430\u0448 \u043B\u0435\u043A\u0430\u0440\u044C \u0441\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0441\u044F
      \u043D\u0430\u0434 \u0447\u0430\u043D\u0430\u043C\u0438 \u0438 \u0437\u0430\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442
      \u0441 \u0423 \u0426\u0437\u0438\u043D\u043E\u043C \u043E \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430\u0445
      \u0438\u043D\u0434\u0438\u0433\u043E \u0432 \u043B\u0435\u0447\u0435\u043D\u0438\u0438
      \u0440\u0430\u043D \u0438 \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0438.
      \u0421\u0442\u0430\u0440\u0438\u043A \u043E\u0436\u0438\u0432\u043B\u044F\u0435\u0442\u0441\u044F:
      \u043A\u0440\u0430\u0441\u0438\u0442\u0435\u043B\u0438 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0434\u043B\u044F \u0442\u043A\u0430\u043D\u0435\u0439,, \u0438 \u0441\u043E\u0431\u0435\u0441\u0435\u0434\u043D\u0438\u043A,
      \u043F\u043E\u043D\u0438\u043C\u0430\u044E\u0449\u0438\u0439 \u044D\u0442\u043E,
      \u0432 \u0433\u043E\u0440\u0430\u0445 \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044C.
      \u0411\u0435\u0441\u0435\u0434\u0430 \u0438\u0434\u0451\u0442 \u0434\u043E\u043B\u0433\u043E,
      \u0447\u0430\u0439 \u0441\u043C\u0435\u043D\u044F\u0435\u0442 \u0447\u0430\u0439.
      \u041A \u043A\u043E\u043D\u0446\u0443 \u0432\u0435\u0447\u0435\u0440\u0430
      \u0441\u0442\u0430\u0440\u0438\u043A \u043E\u0442\u0434\u0430\u0451\u0442 \u043F\u0438\u0433\u043C\u0435\u043D\u0442
      \u043F\u043E\u0447\u0442\u0438 \u0434\u0430\u0440\u043E\u043C (\u0437\u0430
      \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u0431\u0435\u0441\u0435\u0434\u0443)
      \u0438 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u0440\u0435\u0446\u0435\u043F\u0442
      \u043C\u0430\u0437\u0438 \u0438\u0437 \u043E\u0441\u0442\u0430\u0442\u043A\u043E\u0432
      \u043A\u0440\u0430\u0441\u043A\u0438. \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435
      \u0431\u043E\u0433\u0430\u0447\u0435, \u0447\u0435\u043C \u043F\u0440\u0438\u0448\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177580
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u0443
      \u043A\u0430\u043D\u0430\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177581
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C, \u043D\u043E\u0447\u044C.
      \u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u0432
      \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443
      \u043A\u0430\u043D\u0430\u043B\u0430 \u0426\u0437\u044B\u0443, \u043F\u043E\u0434
      \u0433\u043B\u0438\u043D\u043E\u0431\u0438\u0442\u043D\u043E\u0439 \u0441\u0442\u0435\u043D\u043E\u0439
      \u0441 \u0447\u0435\u0440\u0435\u043F\u0438\u0446\u0435\u0439. \u041D\u0430\u0434
      \u0434\u0432\u0435\u0440\u044C\u044E \u043F\u043E\u043A\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0444\u043E\u043D\u0430\u0440\u044C, \u0432 \u0441\u0432\u0435\u0442\u0435
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0432\u0438\u0434\u0435\u043D
      \u0442\u0430\u043D\u0441\u043A\u0438\u0439 \u0441\u0442\u043E\u0440\u043E\u0436
      \u0441 \u0444\u043E\u043D\u0430\u0440\u0451\u043C - \u043F\u043E\u0436\u0438\u043B\u043E\u0439,
      \u043D\u043E \u0442\u0440\u0435\u0437\u0432\u044B\u0439. \u0412\u043D\u0443\u0442\u0440\u0438,
      \u043F\u043E \u0441\u043B\u043E\u0432\u0430\u043C \u0427\u044D\u043D\u044F,
      \u043B\u0435\u0436\u0430\u0442 \u0437\u0430\u043F\u0438\u0441\u0438 \u043E
      \u043A\u0440\u0430\u0434\u0435\u043D\u044B\u0445 \u0440\u0435\u0446\u0435\u043F\u0442\u0430\u0445.
      \u041B\u0443\u043D\u0430 \u0437\u0430 \u043E\u0431\u043B\u0430\u043A\u043E\u043C,
      \u0437\u0432\u0443\u043A\u0438 \u0432\u043E\u0434\u044B \u043F\u043E \u043A\u0430\u043D\u0430\u043B\u0443
      \u0437\u0430\u0433\u043B\u0443\u0448\u0430\u044E\u0442 \u0448\u0430\u0433\u0438.
      \u041E\u043A\u043D\u043E \u0443 \u043A\u0440\u044B\u0448\u0438 \u043F\u0440\u0438\u043E\u0442\u043A\u0440\u044B\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177582
    m_Localized: "\u041F\u043E\u0434\u043A\u0443\u043F\u0438\u0442\u044C \u0441\u0442\u043E\u0440\u043E\u0436\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177583
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442\u0435
      \u0441\u043E \u0441\u0432\u044F\u0437\u043A\u043E\u0439 \u043C\u043E\u043D\u0435\u0442
      \u0432 \u0440\u0430\u0441\u043A\u0440\u044B\u0442\u043E\u0439 \u043B\u0430\u0434\u043E\u043D\u0438.
      \u0421\u0442\u043E\u0440\u043E\u0436 \u0441\u043C\u043E\u0442\u0440\u0438\u0442,
      \u043D\u0435 \u043C\u043E\u0440\u0433\u0430\u044F, \u043F\u043E\u0442\u043E\u043C
      \u043A\u043B\u0430\u0434\u0451\u0442 \u0444\u043E\u043D\u0430\u0440\u044C \u043D\u0430
      \u0437\u0435\u043C\u043B\u044E \u0438 \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u043A\u0430\u043D\u0430\u043B\u0443. \u0412\u044B \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u0435
      \u0432\u043D\u0443\u0442\u0440\u044C, \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442\u0435
      \u043D\u0443\u0436\u043D\u044B\u0435 \u0431\u0443\u043C\u0430\u0433\u0438,
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u0435. \u0421\u0442\u043E\u0440\u043E\u0436
      \u043D\u0435 \u0448\u0435\u0432\u0435\u043B\u0438\u0442\u0441\u044F. \u0427\u0435\u0440\u0435\u0437
      \u043C\u0438\u043D\u0443\u0442\u0443 \u0432\u044B \u0443\u0436\u0435 \u043D\u0430
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435
      \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0430. \u0421\u0434\u0435\u043B\u043A\u0430
      \u043F\u0440\u043E\u0441\u0442\u0430\u044F, \u043D\u043E \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u0435
      \u0441\u043B\u0443\u0445\u0438 \u043E \u0442\u0430\u043A\u0438\u0445 \u0441\u0434\u0435\u043B\u043A\u0430\u0445
      \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0431\u044B\u0441\u0442\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177584
    m_Localized: "\u0422\u0438\u0445\u043E \u043F\u0440\u043E\u043D\u0438\u043A\u043D\u0443\u0442\u044C
      \u0447\u0435\u0440\u0435\u0437 \u043A\u0440\u044B\u0448\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177585
    m_Localized: "\u0412\u044B \u0432\u0441\u043A\u0430\u0440\u0430\u0431\u043A\u0438\u0432\u0430\u0435\u0442\u0435\u0441\u044C
      \u043F\u043E \u0432\u044B\u0441\u0442\u0443\u043F\u0443 \u0441\u0442\u0435\u043D\u044B
      \u043A \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u043C\u0443 \u043E\u043A\u043E\u0448\u043A\u0443,
      \u0441\u043A\u043E\u043B\u044C\u0437\u0438\u0442\u0435 \u0432\u043D\u0443\u0442\u0440\u044C
      \u0438 \u0432 \u043F\u043E\u043B\u0443\u043C\u0440\u0430\u043A\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435
      \u043B\u0430\u0440\u0435\u0446 \u0441 \u0437\u0430\u043F\u0438\u0441\u044F\u043C\u0438.
      \u041B\u0443\u043D\u0430 \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0438\u0437-\u0437\u0430
      \u043E\u0431\u043B\u0430\u043A\u0430 - \u043D\u0430 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u0438\u0435
      \u0432\u0430\u0448\u0443 \u0442\u0435\u043D\u044C \u0432\u0438\u0434\u043D\u043E
      \u043D\u0430 \u0441\u0442\u0435\u043D\u0435 \u0438\u0437\u043D\u0443\u0442\u0440\u0438,
      \u043D\u043E \u0441\u0442\u043E\u0440\u043E\u0436 \u0441\u043D\u0430\u0440\u0443\u0436\u0438
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043A\u0430\u043D\u0430\u043B.
      \u0412\u044B \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u0435 \u0442\u0435\u043C
      \u0436\u0435 \u043F\u0443\u0442\u0451\u043C \u0441 \u0431\u0443\u043C\u0430\u0433\u0430\u043C\u0438
      \u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u043E\u0439. \u041D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0443\u0437\u043D\u0430\u0435\u0442, \u043A\u0440\u043E\u043C\u0435
      \u0432\u0430\u0441 \u0438 \u0427\u044D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177586
    m_Localized: "\u0427\u0435\u0440\u0435\u043F\u0438\u0446\u0430 \u0441\u043A\u0440\u0438\u043F\u0438\u0442
      \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0439 \u0433\u0440\u043E\u043C\u0447\u0435,
      \u0447\u0435\u043C \u0432\u044B \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u043B\u0438.
      \u0421\u0442\u043E\u0440\u043E\u0436 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0444\u043E\u043D\u0430\u0440\u044C \u0438 \u043A\u0440\u0438\u0447\u0438\u0442.
      \u0418\u0437-\u0437\u0430 \u0443\u0433\u043B\u0430 \u0432\u044B\u0431\u0435\u0433\u0430\u044E\u0442
      \u0434\u0432\u043E\u0435 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u043E\u0432
      \u0438\u0437 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0433\u043E \u043F\u043E\u0441\u0442\u0430.
      \u0412\u044B \u043F\u0440\u044B\u0433\u0430\u0435\u0442\u0435 \u0432 \u043A\u0430\u043D\u0430\u043B
      \u0438 \u043F\u043B\u044B\u0432\u0451\u0442\u0435 \u043D\u0430 \u0434\u0440\u0443\u0433\u0443\u044E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443 - \u0445\u043E\u043B\u043E\u0434,
      \u0442\u0435\u043C\u043D\u043E\u0442\u0430, \u0443\u0448\u0438\u0431\u044B
      \u043E \u043A\u0430\u043C\u043D\u0438. \u0423\u0439\u0442\u0438 \u0443\u0434\u0430\u0451\u0442\u0441\u044F,
      \u043D\u043E \u0431\u0435\u0437 \u0431\u0443\u043C\u0430\u0433, \u0438 \u0432
      \u0434\u043E\u0437\u043E\u0440\u043D\u043E\u0439 \u043A\u043D\u0438\u0433\u0435
      \u0427\u0430\u043D\u044A\u0430\u043D\u044F \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0432\u0430\u0448\u0435 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435.
      \u041D\u0430 \u043E\u0442\u043A\u0443\u043F \u043F\u0430\u0442\u0440\u0443\u043B\u044C\u043D\u043E\u043C\u0443
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0431\u0440\u043E\u0441\u0438\u0442\u044C
      \u0433\u043E\u0440\u0441\u0442\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177587
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043E\u0442\u0432\u043B\u0435\u043A\u0430\u0435\u0442
      \u0441\u0442\u043E\u0440\u043E\u0436\u0430 \u0431\u0430\u0439\u043A\u043E\u0439
      \u043D\u0430 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177588
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043A \u0441\u0442\u043E\u0440\u043E\u0436\u0443
      \u0441 \u0443\u043B\u044B\u0431\u043A\u043E\u0439 \u0438 \u0437\u0430\u0432\u043E\u0434\u0438\u0442
      \u0434\u043B\u0438\u043D\u043D\u0443\u044E \u0431\u0430\u0439\u043A\u0443 \u043E
      \u0431\u0430\u043D\u0434\u0438\u0442\u0430\u0445 \u0437\u0430 \u0443\u0433\u043B\u043E\u043C,
      \u043E\u0431 \u043E\u0433\u043D\u044F\u0445 \u043D\u0430\u0434 \u043F\u0430\u0433\u043E\u0434\u043E\u0439,
      \u043E \u0431\u0435\u0441\u0430\u0445, \u0447\u0442\u043E \u0431\u0440\u043E\u0434\u044F\u0442
      \u0432 \u044D\u0442\u0443 \u043D\u043E\u0447\u044C - \u043D\u0430 \u0431\u0435\u0437\u0443\u043F\u0440\u0435\u0447\u043D\u043E\u043C
      \u043B\u0438\u0442\u0435\u0440\u0430\u0442\u0443\u0440\u043D\u043E\u043C \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u043C
      \u0441 \u0446\u0438\u0442\u0430\u0442\u043E\u0439 \u0438\u0437 \u041A\u043E\u043D\u0444\u0443\u0446\u0438\u044F.
      \u0421\u0442\u043E\u0440\u043E\u0436, \u0441\u043A\u0443\u0447\u0430\u0432\u0448\u0438\u0439
      \u0432\u0441\u044E \u043D\u043E\u0447\u044C, \u0437\u0430\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      \u041F\u043E\u043A\u0430 \u043E\u043D \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u043D\u043E
      \u0441\u043B\u0443\u0448\u0430\u0435\u0442, \u0432\u044B \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u0435
      \u0432\u043D\u0443\u0442\u0440\u044C, \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442\u0435
      \u0431\u0443\u043C\u0430\u0433\u0438, \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u0435.
      \u0421\u0442\u043E\u0440\u043E\u0436 \u0434\u0430\u0436\u0435 \u043D\u0435
      \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      \u041D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435 \u043E\u043D
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u0430
      \u0437\u0430 \xAB\u043F\u0440\u0438\u044F\u0442\u043D\u0443\u044E \u0431\u0435\u0441\u0435\u0434\u0443\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177589
    m_Localized: "\u0421\u0445\u043E\u0434\u043A\u0430 \u043C\u0430\u0441\u0442\u0435\u0440\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177590
    m_Localized: "\u0427\u0430\u0439\u043D\u0430\u044F \u0443 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442 \u0427\u0430\u043D\u044A\u0430\u043D\u044F,
      \u0443\u0442\u0440\u043E. \u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0441\u044F
      \u043E \u0432\u0441\u0442\u0440\u0435\u0447\u0435: \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C
      \u0432 \u0443\u0433\u043B\u0443 \u0441\u0438\u0434\u044F\u0442 \u0441\u0435\u043C\u044C
      \u0432\u043E\u043B\u044C\u043D\u044B\u0445 \u043A\u0440\u0430\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u043E\u0432
      (\u043A\u0442\u043E \u043F\u043E\u043C\u043E\u043B\u043E\u0436\u0435, \u043A\u0442\u043E
      \u043F\u043E\u0441\u0442\u0430\u0440\u0448\u0435), \u0443 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u043F\u0430\u043B\u044C\u0446\u044B \u043F\u0435\u0440\u0435\u043F\u0430\u0447\u043A\u0430\u043D\u044B
      \u0441\u0432\u043E\u0438\u043C \u043E\u0442\u0442\u0435\u043D\u043A\u043E\u043C.
      \u041E\u043D\u0438 \u043F\u0440\u0438\u0448\u043B\u0438 \u043F\u043E \u0441\u043B\u0443\u0445\u0430\u043C
      \u043E \u043F\u0443\u0440\u043F\u0443\u0440\u0435, \u043D\u043E \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u0441 \u043F\u0440\u0438\u0449\u0443\u0440\u043E\u043C: \u0446\u0435\u043D\u0430
      \u0438\u0445 \u0440\u0435\u043C\u0435\u0441\u043B\u0430 \u0432\u044B\u0441\u043E\u043A\u0430,
      \u0438 \u043E\u043D\u0438 \u043D\u0435 \u0438\u0434\u0443\u0442 \u0437\u0430
      \u043F\u0435\u0440\u0432\u044B\u043C \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0432\u0448\u0438\u043C.
      \u041D\u0430 \u0441\u0442\u043E\u043B\u0435 \u0442\u0440\u0438 \u043F\u043B\u043E\u0448\u043A\u0438
      \u0441 \u0440\u0430\u0437\u043D\u044B\u043C\u0438 \u0441\u0438\u043D\u0438\u043C\u0438,
      \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177591
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u0432\u0441\u0435\u0445,
      \u043A\u0442\u043E \u043E\u0442\u043A\u043B\u0438\u043A\u043D\u0443\u043B\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177592
    m_Localized: "\u0412\u044B \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u043A\u043E\u0448\u0435\u043B\u044C \u0438 \u043E\u0431\u0435\u0449\u0430\u0435\u0442\u0435
      \u0437\u0430\u0434\u0430\u0442\u043E\u043A \u043A\u0430\u0436\u0434\u043E\u043C\u0443.
      \u0420\u0430\u0434\u043E\u0441\u0442\u0438 \u043C\u043D\u043E\u0433\u043E,
      \u0441\u043A\u0435\u043F\u0441\u0438\u0441 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442.
      \u041A \u043F\u043E\u043B\u0443\u0434\u043D\u044E \u0443 \u0432\u0430\u0441
      \u043D\u0430\u043D\u044F\u0442\u0430 \u043A\u043E\u043C\u0430\u043D\u0434\u0430
      \u0438\u0437 \u0441\u0435\u043C\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u0441\u0440\u0435\u0434\u0438 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u0434\u0432\u043E\u0435
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0445 \u043C\u0430\u0441\u0442\u0435\u0440\u043E\u0432
      \u0438 \u043F\u044F\u0442\u0435\u0440\u043E \u043F\u043E\u0434\u043C\u0430\u0441\u0442\u0435\u0440\u044C\u0435\u0432.
      \u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0431\u044B\u0441\u0442\u0440\u043E, \u043D\u043E \u043D\u0435 \u0438\u0434\u0435\u0430\u043B\u044C\u043D\u043E:
      \u043F\u0443\u0440\u043F\u0443\u0440 \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0441\u044F,
      \u043D\u043E \u043D\u0435 \u043B\u0443\u0447\u0448\u0435\u0433\u043E \u0441\u043E\u0440\u0442\u0430.
      \u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u043F\u043E\u0442\u043E\u043C
      \u0431\u0443\u0434\u0435\u0442 \u0432\u043E\u0440\u0447\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177593
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0441 \u0433\u0438\u043B\u044C\u0434\u0438\u0435\u0439 \u043A\u0440\u0430\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177594
    m_Localized: "\u0412\u044B \u0432\u044B\u0437\u044B\u0432\u0430\u0435\u0442\u0435
      \u0441\u0442\u0430\u0440\u0448\u0438\u043D\u0443 \u0433\u0438\u043B\u044C\u0434\u0438\u0438
      \u0438 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u0435 \u043A
      \u0442\u043E\u0440\u0433\u0443 \u0432\u0441\u0435\u0440\u044C\u0451\u0437:
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u043E \u0434\u043E\u043B\u0435,
      \u043E\u0431 \u044D\u043A\u0441\u043A\u043B\u044E\u0437\u0438\u0432\u0435 \u043D\u0430
      \u043F\u0443\u0440\u043F\u0443\u0440, \u043E \u0442\u043E\u043C, \u0447\u0442\u043E
      \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u0431\u0443\u0434\u0435\u0442
      \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0441 \u043B\u0443\u0447\u0448\u0438\u043C\u0438. \u0421\u0442\u0430\u0440\u0448\u0438\u043D\u0430
      \u0441\u043A\u0435\u043F\u0442\u0438\u0447\u0435\u043D, \u043D\u043E \u0438\u0434\u0451\u0442
      \u043D\u0430 \u0443\u0441\u043B\u043E\u0432\u0438\u044F. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0443 \u0432\u0430\u0441 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442
      \u0441 \u0442\u0440\u0435\u043C\u044F \u0438\u0437\u0431\u0440\u0430\u043D\u043D\u044B\u043C\u0438
      \u043C\u0430\u0441\u0442\u0435\u0440\u0430\u043C\u0438 \u043F\u043E \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435 \u0438 \u043E\u0431\u0440\u0430\u0437\u0435\u0446
      \u0448\u0451\u043B\u043A\u0430 \u043E\u0442 \u0433\u0438\u043B\u044C\u0434\u0438\u0438
      \u043A\u0430\u043A \u0437\u043D\u0430\u043A \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F.
      \u0427\u044D\u043D\u044C \u0431\u0443\u0434\u0435\u0442 \u0434\u043E\u0432\u043E\u043B\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177595
    m_Localized: "\u0421\u0442\u0430\u0440\u0448\u0438\u043D\u0430 \u0433\u0438\u043B\u044C\u0434\u0438\u0438
      \u0441\u043B\u0443\u0448\u0430\u0435\u0442 \u0432\u0430\u0448\u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F
      \u0438 \u043A\u0430\u0447\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \xAB\u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u0433\u0438\u043B\u044C\u0434\u0438\u044F \u043D\u0435 \u0442\u043E\u0440\u0433\u0443\u0435\u0442
      \u043F\u0443\u0440\u043F\u0443\u0440\u043E\u043C \u043F\u043E \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435.\xBB \u041F\u043E\u0441\u043B\u0435 \u0434\u0432\u0443\u0445
      \u0447\u0430\u0441\u043E\u0432 \u0441\u043F\u043E\u0440\u0430 \u0432\u044B
      \u043F\u043B\u0430\u0442\u0438\u0442\u0435 \u0432\u0434\u0432\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0437\u0430\u0434\u0443\u043C\u0430\u043D\u043D\u043E\u0433\u043E \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0435
      \u0434\u0432\u0443\u0445 \u043C\u0430\u0441\u0442\u0435\u0440\u043E\u0432 \u0432\u043C\u0435\u0441\u0442\u043E
      \u0442\u0440\u0451\u0445. \u0413\u0438\u043B\u044C\u0434\u0438\u044F \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
      \u0432\u0430\u0441 \u043A\u0430\u043A \xAB\u0442\u043E\u0433\u043E, \u043A\u0442\u043E
      \u043F\u0440\u0438\u0448\u0451\u043B \u0441 \u043F\u0443\u0441\u0442\u044B\u043C\u0438
      \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u044F\u043C\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177596
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446-\u043F\u0430\u0440\u0442\u043D\u0451\u0440
      \u0437\u043E\u0432\u0451\u0442 \u043B\u0443\u0447\u0448\u0438\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177597
    m_Localized: "\u0412\u0430\u0448 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446-\u0441\u043F\u0443\u0442\u043D\u0438\u043A
      \u0432\u0441\u0442\u0430\u0451\u0442, \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442
      \u0437\u0430\u043B \u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0437\u0430
      \u0434\u0440\u0443\u0433\u0438\u043C \u0432\u044B\u043A\u043B\u0438\u043A\u0430\u0435\u0442
      \u043F\u043E \u0438\u043C\u0435\u043D\u0430\u043C: \u043E\u043D \u0432\u0441\u0435\u0445
      \u0437\u043D\u0430\u0435\u0442. \u0414\u0432\u043E\u0435 \u043B\u0443\u0447\u0448\u0438\u0445
      \u043A\u0440\u0430\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u043E\u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u044F
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044E\u0442 \u0433\u043E\u043B\u043E\u0432\u044B
      \u0438 \u043A\u0438\u0432\u0430\u044E\u0442: \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435
      \u043A \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0443 \u0432\u044B\u0448\u0435
      \u0434\u0435\u043D\u0435\u0433. \u0421\u0434\u0435\u043B\u043A\u0430 \u0437\u0430\u043A\u043B\u044E\u0447\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445,
      \u043C\u0430\u0441\u0442\u0435\u0440\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
      \u0441\u0430\u043C\u0438, \u0438 \u0432 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0443\u044E
      \u043F\u043E\u043F\u0430\u0434\u0430\u044E\u0442 \u0438\u043C\u0435\u043D\u043D\u043E
      \u0442\u0435, \u043A\u0442\u043E \u043D\u0443\u0436\u0435\u043D. \u0427\u044D\u043D\u044C
      \u0412\u044D\u0439 \u043F\u043E\u0442\u043E\u043C \u0441\u043A\u0430\u0436\u0435\u0442:
      \xAB\u0421 \u0442\u0430\u043A\u0438\u043C \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u043E\u043C
      \u043C\u043E\u0436\u043D\u043E\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177598
    m_Localized: "\u0411\u0430\u0437\u0430\u0440\u043D\u044B\u0439 \u0448\u0430\u0440\u043B\u0430\u0442\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177599
    m_Localized: "\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0441\u043A\u0438\u0439
      \u0431\u0430\u0437\u0430\u0440, \u0440\u044F\u0434 \u0430\u043D\u0442\u0438\u043A\u0432\u0430\u0440\u043E\u0432.
      \u041D\u0430 \u043F\u043E\u0442\u0451\u0440\u0442\u043E\u043C \u043A\u043E\u0432\u0440\u0435,
      \u043C\u0435\u0436\u0434\u0443 \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u043C\u0438
      \u043A\u0443\u0432\u0448\u0438\u043D\u0430\u043C\u0438 \u0438 \u0440\u0436\u0430\u0432\u044B\u043C\u0438
      \u043A\u043B\u0438\u043D\u043A\u0430\u043C\u0438, \u0440\u0430\u0437\u043B\u043E\u0436\u0435\u043D\u044B
      \xAB\u0434\u0440\u0435\u0432\u043D\u0438\u0435 \u0438\u0434\u043E\u043B\u044B\xBB:
      \u043D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u044B\u0435 \u0444\u0438\u0433\u0443\u0440\u043A\u0438
      \u0441 \u043D\u0430\u0434\u043F\u0438\u0441\u044F\u043C\u0438 \u043D\u0430
      \u044F\u043A\u043E\u0431\u044B \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C.
      \u041A\u0443\u043F\u0435\u0446, \u0442\u043E\u043B\u0441\u0442\u044B\u0439
      \u0438 \u0433\u0440\u043E\u043C\u043A\u0438\u0439, \u043A\u0440\u0438\u0447\u0438\u0442
      \u043D\u0430 \u0432\u0441\u0435\u0445 \u044F\u0437\u044B\u043A\u0430\u0445
      \u0441\u0440\u0430\u0437\u0443, \u043E\u0431\u0435\u0449\u0430\u044F \xAB\u0434\u0440\u0435\u0432\u043D\u0435\u0435
      \u0437\u043E\u043B\u043E\u0442\u043E \u043F\u0440\u0435\u0434\u043A\u043E\u0432\xBB.
      \u0422\u043E\u043B\u043F\u0430 \u0441\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F.
      \u0421\u0440\u0435\u0434\u0438 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0445
      \u0444\u0438\u0433\u0443\u0440\u043E\u043A, \u0433\u043E\u0432\u043E\u0440\u0438\u043B
      \u0424\u0430\u0440\u0443\u0445, \u0435\u0441\u0442\u044C \u0438 \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177600
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0443
      \u043A\u0430\u043A \u0443\u043B\u0438\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177601
    m_Localized: "\u0412\u044B \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0435
      \u0441\u0430\u043C\u0443\u044E \u043A\u0440\u0438\u0447\u0430\u0449\u0435-\xAB\u0434\u0440\u0435\u0432\u043D\u044E\u044E\xBB
      \u0444\u0438\u0433\u0443\u0440\u043A\u0443 \u0438 \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0442\u0435
      \u0431\u0435\u0437 \u0442\u043E\u0440\u0433\u0430. \u041A\u0443\u043F\u0435\u0446
      \u0440\u0430\u0441\u0446\u0432\u0435\u0442\u0430\u0435\u0442, \u0442\u043E\u043B\u043F\u0430
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C.
      \u0412\u044B \u043A\u043B\u0430\u0434\u0451\u0442\u0435 \u0441\u0432\u0451\u0440\u0442\u043E\u043A
      \u0432 \u0441\u0443\u043C\u043A\u0443 \u0438 \u0442\u0438\u0445\u043E \u0443\u0445\u043E\u0434\u0438\u0442\u0435:
      \u0443\u043B\u0438\u043A\u0430 \u0442\u0435\u043F\u0435\u0440\u044C \u0443
      \u0432\u0430\u0441, \u0438 \u0437\u0430\u0432\u0442\u0440\u0430 \u0431\u0430\u0437\u0430\u0440\u043D\u044B\u0439
      \u0441\u043E\u0432\u0435\u0442 \u043F\u043E\u043B\u0443\u0447\u0438\u0442 \u043D\u0430
      \u0441\u0442\u043E\u043B \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442
      \u0441 \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435\u043C \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0438.
      \u0428\u0430\u0440\u043B\u0430\u0442\u0430\u043D \u043D\u0435 \u0443\u0437\u043D\u0430\u0435\u0442,
      \u0447\u0442\u043E \u044D\u0442\u043E \u0432\u044B, \u043F\u043E\u043A\u0430
      \u043D\u0435 \u0441\u0442\u0430\u043D\u0435\u0442 \u043F\u043E\u0437\u0434\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177602
    m_Localized: "\u0413\u0440\u043E\u043C\u043A\u043E \u0438\u0437\u043E\u0431\u043B\u0438\u0447\u0438\u0442\u044C
      \u043C\u043E\u0448\u0435\u043D\u043D\u0438\u043A\u0430 \u043F\u0440\u0438 \u0442\u043E\u043B\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177603
    m_Localized: "\u0412\u044B \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0435
      \u043E\u0434\u043D\u0443 \u0438\u0437 \u0444\u0438\u0433\u0443\u0440\u043E\u043A
      \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0438 \u0433\u0440\u043E\u043C\u043A\u043E
      \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435 \u043D\u0430 \u043E\u0448\u0438\u0431\u043A\u0443
      \u0432 \u043D\u0430\u0434\u043F\u0438\u0441\u0438: \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u0433\u043B\u0430\u0433\u043E\u043B \u0441\u0442\u043E\u0438\u0442 \u0432
      \u043D\u0435\u0432\u0435\u0440\u043D\u043E\u043C \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
      \u0430 \xAB\u0434\u0440\u0435\u0432\u043D\u044F\u044F\xBB \u043F\u0430\u0442\u0438\u043D\u0430
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0443\u043A\u0441\u0443\u0441\u043E\u043C.
      \u0422\u043E\u043B\u043F\u0430, \u0441\u0435\u043A\u0443\u043D\u0434\u0443
      \u043D\u0430\u0437\u0430\u0434 \u0437\u0430\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F,
      \u0440\u0430\u0437\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044F \u0441\u043C\u0435\u0445\u043E\u043C.
      \u041A\u0443\u043F\u0435\u0446 \u0431\u0430\u0433\u0440\u043E\u0432\u0435\u0435\u0442,
      \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u043E\u043F\u0440\u0430\u0432\u0434\u0430\u0442\u044C\u0441\u044F,
      \u043D\u043E \u0442\u043E\u043B\u043A\u0430\u0435\u0442\u0441\u044F \u0431\u0430\u0437\u0430\u0440\u043D\u043E\u0439
      \u0441\u0442\u0440\u0430\u0436\u0435\u0439 \u0437\u0430 \u043F\u0440\u0438\u043B\u0430\u0432\u043E\u043A.
      \u0421\u0440\u0435\u0434\u0438 \u0440\u0430\u0437\u0431\u0440\u043E\u0441\u0430\u043D\u043D\u044B\u0445
      \xAB\u0434\u0440\u0435\u0432\u043D\u043E\u0441\u0442\u0435\u0439\xBB \u0432\u044B
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0435 \u043E\u0434\u043D\u0443
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E: \u043E\u043D\u0430
      \u0434\u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0448\u0430\u0440\u043B\u0430\u0442\u0430\u043D\u0443
      \u043F\u043E \u0441\u043B\u0443\u0447\u0430\u044E \u0438 \u0448\u043B\u0430
      \u043A\u0430\u043A \u043F\u0440\u0438\u043C\u0430\u043D\u043A\u0430. \u042D\u0442\u043E
      \u043F\u043E\u0434\u043B\u0438\u043D\u043D\u044B\u0439 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177604
    m_Localized: "\u0412\u044B \u043A\u0440\u0438\u0447\u0438\u0442\u0435 \u043F\u0440\u043E
      \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u0443, \u043D\u043E \u043D\u0435
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435 \u0441\u043B\u043E\u0432,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0443\u0441\u043B\u044B\u0448\u0438\u0442
      \u0442\u043E\u043B\u043F\u0430. \u041A\u0443\u043F\u0435\u0446 \u0441\u043C\u0435\u0451\u0442\u0441\u044F
      \u043F\u0435\u0440\u0432\u044B\u0439, \u0442\u043E\u043B\u043F\u0430 \u043F\u043E\u0434\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442:
      \xAB\u0417\u0430\u0432\u0438\u0441\u0442\u043D\u0438\u043A! \u041A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442!\xBB
      \u0411\u0430\u0437\u0430\u0440\u043D\u0430\u044F \u0441\u0442\u0440\u0430\u0436\u0430
      \u0443\u0432\u043E\u0434\u0438\u0442 \u043F\u043E\u0434 \u0440\u0443\u043A\u0438
      \u0443\u0436\u0435 \u0432\u0430\u0441, \u043D\u0435 \u0435\u0433\u043E. \u041A
      \u0432\u0435\u0447\u0435\u0440\u0443 \u0432\u0430\u0441 \u043E\u0442\u043F\u0443\u0441\u043A\u0430\u044E\u0442
      \u0441 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435\u043C,
      \u043D\u043E \u0432\u0430\u0448\u0435 \u043B\u0438\u0446\u043E \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B \u0441\u043E \u0432\u0441\u0435\u0433\u043E
      \u0440\u044F\u0434\u0430. \u0428\u0430\u0440\u043B\u0430\u0442\u0430\u043D
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u0441\u043B\u0435\u0434 \u0438
      \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177605
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0447\u0438\u0442\u0430\u0435\u0442
      \u043D\u0430\u0434\u043F\u0438\u0441\u0438 \u0438 \u043D\u0430\u0445\u043E\u0434\u0438\u0442
      \u043E\u0448\u0438\u0431\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177606
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u0431\u0435\u0440\u0451\u0442 \u0444\u0438\u0433\u0443\u0440\u043A\u0443 \u0432
      \u0440\u0443\u043A\u0438, \u0441\u043A\u043B\u043E\u043D\u044F\u0435\u0442\u0441\u044F,
      \u0447\u0438\u0442\u0430\u0435\u0442 \u0448\u0435\u043F\u043E\u0442\u043E\u043C
      \u0438 \u043A\u0430\u0447\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \u041F\u043E\u0442\u043E\u043C \u0433\u0440\u043E\u043C\u043A\u043E, \u0447\u0451\u0442\u043A\u043E,
      \u043D\u0430 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C \u0441
      \u0443\u043C\u0435\u0441\u0442\u043D\u044B\u043C \u0430\u043A\u0446\u0435\u043D\u0442\u043E\u043C,
      \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442 \u0442\u043E\u043B\u043F\u0435:
      \u043D\u0430\u0434\u043F\u0438\u0441\u044C \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u0448\u043A\u043E\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u0434\u0434\u0435\u043B\u043A\u043E\u0439,
      \u0441\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
      \u0441 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0439 \u0441\u0442\u0435\u043B\u044B,
      \u043D\u043E \u0441 \u0433\u0440\u0430\u043C\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u043E\u0448\u0438\u0431\u043A\u043E\u0439 \u043F\u044F\u0442\u043E\u0433\u043E
      \u043A\u043B\u0430\u0441\u0441\u0430. \u041A\u0443\u043F\u0435\u0446 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0440\u0430\u0437\u043E\u0431\u043B\u0430\u0447\u0451\u043D
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C, \u0433\u043E\u0432\u043E\u0440\u044F\u0449\u0438\u043C
      \u043B\u0443\u0447\u0448\u0435 \u043D\u0435\u0433\u043E \u0441\u0430\u043C\u043E\u0433\u043E,
      \u0438 \u043A\u0440\u0430\u0441\u043D\u0435\u0435\u0442 \u043E\u0442 \u0441\u0442\u044B\u0434\u0430.
      \u0422\u043E\u043B\u043F\u0430 \u0441\u043C\u0435\u0451\u0442\u0441\u044F,
      \u0441\u0442\u0440\u0430\u0436\u0430 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u043A \u0448\u0430\u0440\u043B\u0430\u0442\u0430\u043D\u0443, \u0430 \u0432\u0430\u0448
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E
      \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0432 \u0441\u0443\u043C\u043A\u0443
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E \u0444\u0438\u0433\u0443\u0440\u043A\u0443
      \u0441 \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0430 (\u0442\u0443, \u0447\u0442\u043E
      \u0431\u0435\u0437 \u043E\u0448\u0438\u0431\u043E\u043A)."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177607
    m_Localized: "\u0420\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0430 \u0432 \u041F\u0430\u043C\u0438\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177608
    m_Localized: "\u041E\u0431\u043E\u0437 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0443 \u0443\u0437\u043A\u043E\u0433\u043E \u0443\u0449\u0435\u043B\u044C\u044F
      \u0432 \u0433\u043E\u0440\u0430\u0445 \u041F\u0430\u043C\u0438\u0440\u0430.
      \u041F\u043E \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u0430\u043C
      \u043A\u0430\u0440\u0442\u044B \u0424\u0430\u0440\u0443\u0445\u0430, \u0433\u0434\u0435-\u0442\u043E
      \u0437\u0434\u0435\u0441\u044C \u0434\u043E\u043B\u0436\u0435\u043D \u043B\u0435\u0436\u0430\u0442\u044C
      \u0437\u0430\u0432\u0430\u043B\u0435\u043D\u043D\u044B\u0439 \u043A\u0430\u043C\u043D\u044F\u043C\u0438
      \u0432\u0445\u043E\u0434 \u0432 \u0441\u043A\u043B\u0435\u043F\u043D\u0443\u044E
      \u043F\u0435\u0449\u0435\u0440\u0443. \u0421\u0442\u0435\u043D\u044B \u0443\u0449\u0435\u043B\u044C\u044F
      \u043A\u0440\u0430\u0441\u043D\u044B \u043E\u0442 \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0439
      \u0440\u0443\u0434\u044B, \u0432\u0435\u0442\u0435\u0440 \u043F\u0430\u0445\u043D\u0435\u0442
      \u0441\u043D\u0435\u0433\u043E\u043C. \u041D\u043E \u0437\u0430\u0432\u0430\u043B
      \u0441\u0432\u0435\u0436\u0438\u0439, \u0438 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0445
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0439 \u0432 \u043D\u0451\u043C
      \u0442\u0440\u0438. \u041A\u0430\u0440\u0442\u0430 \u043C\u043E\u043B\u0447\u0438\u0442
      \u043E \u0434\u0435\u0442\u0430\u043B\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177609
    m_Localized: "\u0420\u0430\u0441\u0447\u0438\u0441\u0442\u0438\u0442\u044C \u0437\u0430\u0432\u0430\u043B
      \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177610
    m_Localized: "\u0412\u044B \u0437\u0430\u043A\u0430\u0442\u044B\u0432\u0430\u0435\u0442\u0435
      \u0440\u0443\u043A\u0430\u0432\u0430 \u0438 \u0432\u0435\u0434\u0451\u0442\u0435
      \u043B\u044E\u0434\u0435\u0439 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044C
      \u0441\u0430\u043C\u044B\u0439 \u043A\u0440\u0443\u043F\u043D\u044B\u0439 \u0437\u0430\u0432\u0430\u043B.
      \u041F\u043E\u043B\u0442\u043E\u0440\u0430 \u0434\u043D\u044F \u0442\u044F\u0436\u0451\u043B\u043E\u0439
      \u0440\u0430\u0431\u043E\u0442\u044B, \u043E\u0431\u043E\u0434\u0440\u0430\u043D\u043D\u044B\u0435
      \u0440\u0443\u043A\u0438, \u0442\u0440\u0435\u0441\u043D\u0443\u043B\u0430
      \u0431\u043E\u043A\u043E\u0432\u0438\u043D\u0430 \u0443 \u043E\u0434\u043D\u043E\u0439
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438. \u041D\u043E \u0437\u0430\u0432\u0430\u043B
      \u043F\u043E\u0434\u0434\u0430\u0451\u0442\u0441\u044F: \u0437\u0430 \u043D\u0438\u043C
      \u0443\u0437\u043A\u0438\u0439 \u043B\u0430\u0437 \u0432 \u043A\u0430\u043C\u0435\u043D\u043D\u0443\u044E
      \u043D\u0438\u0448\u0443. \u0421\u043A\u043B\u0435\u043F. \u0412\u043D\u0443\u0442\u0440\u0438
      \u043F\u044B\u043B\u044C \u0432\u0435\u043A\u043E\u0432 \u0438 \u0442\u0438\u0448\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177611
    m_Localized: "\u0418\u0434\u0442\u0438 \u0441\u0442\u0440\u043E\u0433\u043E \u043F\u043E
      \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u0430\u043C \u043A\u0430\u0440\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177612
    m_Localized: "\u0412\u044B \u0434\u043E\u0441\u0442\u0430\u0451\u0442\u0435 \u043A\u0430\u0440\u0442\u0443,
      \u0441\u0432\u0435\u0440\u044F\u0435\u0442\u0435 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B
      \u043F\u043E \u0441\u043E\u043B\u043D\u0446\u0443 \u0438 \u0442\u0435\u043D\u0438
      \u0441\u043A\u0430\u043B, \u043E\u0442\u043C\u0435\u0440\u044F\u0435\u0442\u0435
      \u0448\u0430\u0433\u0438. \u0420\u0430\u0441\u0447\u0451\u0442 \u0442\u043E\u0447\u043D\u044B\u0439:
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u0432\u0445\u043E\u0434
      \u043D\u0435 \u0442\u0430\u043C, \u0433\u0434\u0435 \u043E\u0447\u0435\u0432\u0438\u0434\u043D\u044B\u0439
      \u0437\u0430\u0432\u0430\u043B, \u0430 \u0432 \u0431\u043E\u043A\u043E\u0432\u043E\u0439
      \u043D\u0438\u0448\u0435, \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u043E\u0439
      \u043F\u043B\u043E\u0441\u043A\u0438\u043C \u043A\u0430\u043C\u043D\u0435\u043C.
      \u0414\u0432\u043E\u0435 \u0441\u0434\u0432\u0438\u0433\u0430\u044E\u0442 \u043A\u0430\u043C\u0435\u043D\u044C,
      \u0438 \u0432\u044B \u0441\u0442\u043E\u0438\u0442\u0435 \u0432\u043D\u0443\u0442\u0440\u0438
      \u0441\u043A\u043B\u0435\u043F\u0430, \u043C\u0438\u043D\u0443\u044F \u0437\u0430\u0432\u0430\u043B\u044B.
      \u0421\u0440\u0435\u0434\u0438 \u043F\u044B\u043B\u0438 \u043B\u0435\u0436\u0438\u0442
      \u043D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u0430\u044F \u0444\u0438\u0433\u0443\u0440\u043A\u0430.
      \u041A\u0430\u0440\u0442\u0430 \u043D\u0435 \u0441\u043E\u043B\u0433\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177613
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442\u0435
      \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B, \u043D\u043E
      \u0432 \u0433\u043E\u0440\u0430\u0445 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B
      \u043E\u0431\u043C\u0430\u043D\u044B\u0432\u0430\u044E\u0442. \u041A\u0430\u0440\u0442\u0430
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \xAB\u0443 \u043A\u0440\u0430\u0441\u043D\u043E\u0439
      \u0441\u043A\u0430\u043B\u044B \u0432 \u0442\u0435\u043D\u0438\xBB: \u043D\u043E
      \u0437\u0434\u0435\u0441\u044C \u0442\u0430\u043A\u0438\u0445 \u0442\u0440\u0438,
      \u0438 \u0442\u0435\u043D\u0438 \u0441\u043C\u0435\u0449\u0430\u044E\u0442\u0441\u044F
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0447\u0430\u0441. \u0414\u0432\u0430
      \u0434\u043D\u044F \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0439,
      \u043F\u043E\u0442\u043E\u043C \u0431\u0440\u043E\u0441\u0430\u0435\u0442\u0435
      \u0440\u0430\u0441\u0447\u0451\u0442\u044B \u0438 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u0442\u0435
      \u0433\u043B\u0430\u0432\u043D\u044B\u0439 \u0437\u0430\u0432\u0430\u043B.
      \u0421\u043A\u043B\u0435\u043F \u043D\u0430\u0439\u0434\u0435\u043D, \u043D\u043E
      \u043F\u043E\u0437\u0434\u043D\u043E: \u043F\u0440\u0438\u043F\u0430\u0441\u044B
      \u0442\u0430\u044E\u0442, \u0443 \u043E\u0434\u043D\u043E\u0433\u043E \u0432\u043E\u0437\u043D\u0438\u0447\u0435\u0433\u043E
      \u043E\u0442\u043C\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u044B\u0435 \u043F\u0430\u043B\u044C\u0446\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177614
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
      \u0441\u0442\u0430\u0440\u0443\u044E \u0442\u0440\u043E\u043F\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 31170496602177615
    m_Localized: "\u0412\u0430\u0448 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0434\u043E\u043B\u0433\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u043A\u0440\u0430\u0441\u043D\u044B\u0435 \u0441\u043A\u0430\u043B\u044B,
      \u043D\u0430 \u0437\u0430\u0432\u0430\u043B, \u043D\u0430 \u0432\u0435\u0442\u0435\u0440,
      \u043F\u043E\u0442\u043E\u043C \u043C\u0430\u0448\u0435\u0442 \u0440\u0443\u043A\u043E\u0439:
      \xAB\u041D\u0435 \u0437\u0434\u0435\u0441\u044C. \u0417\u0434\u0435\u0441\u044C
      \u0432\u0441\u0435 \u0445\u043E\u0434\u044F\u0442. \u0421\u0442\u0430\u0440\u0438\u043A\u0438
      \u0445\u043E\u0434\u0438\u043B\u0438 \u0432\u044B\u0448\u0435\xBB. \u041E\u043D
      \u0432\u0435\u0434\u0451\u0442 \u0432\u0430\u0441 \u043A \u0443\u0437\u043A\u043E\u0439
      \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0435 \u043C\u0435\u0442\u0440\u0430\u0445
      \u0432 \u0441\u043E\u0440\u043E\u043A\u0430 \u0432\u044B\u0448\u0435, \u0437\u0430\u0440\u043E\u0441\u0448\u0435\u0439
      \u043A\u043E\u043B\u044E\u0447\u043A\u0430\u043C\u0438. \u0417\u0430 \u043A\u043E\u043B\u044E\u0447\u043A\u0430\u043C\u0438
      \u0442\u043E\u0442 \u0436\u0435 \u043F\u0440\u043E\u0445\u043E\u0434 \u0432
      \u0441\u043A\u043B\u0435\u043F, \u0431\u0435\u0437 \u0432\u0441\u044F\u043A\u0438\u0445
      \u0437\u0430\u0432\u0430\u043B\u043E\u0432 - \u0441\u043B\u043E\u0432\u043D\u043E
      \u0432\u0435\u043A\u043E\u0432 \u043D\u0435 \u043F\u0440\u043E\u0448\u043B\u043E.
      \u0422\u0440\u043E\u043F\u0430 \u0437\u043D\u0430\u043B\u0430 \u043F\u0443\u0442\u044C.
      \u0412 \u043D\u0438\u0448\u0435 \u0441\u0440\u0435\u0434\u0438 \u043F\u044B\u043B\u0438
      \u043B\u0435\u0436\u0438\u0442 \u043D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u0430\u044F
      \u0444\u0438\u0433\u0443\u0440\u043A\u0430 \u0441\u043E \u0441\u0442\u0451\u0440\u0442\u044B\u043C
      \u043B\u0438\u0446\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603757355008
    m_Localized: "\u0417\u043D\u0430\u043A\u0438 \u043F\u0443\u0442\u0430\u044E\u0442\u0441\u044F
      \u043F\u0435\u0440\u0435\u0434 \u0433\u043B\u0430\u0437\u0430\u043C\u0438:
      \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0438
      \u0442\u044F\u0436\u0435\u043B\u0435\u0435 \u043B\u044E\u0431\u043E\u0439 \u0437\u0430\u0433\u0430\u0434\u043A\u0438.
      \u0412\u044B \u0441\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0435
      \u043A\u0430\u0440\u0442\u0443, \u0434\u0430\u0432 \u0441\u0435\u0431\u0435
      \u043E\u0431\u0435\u0449\u0430\u043D\u0438\u0435 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u043A \u043D\u0435\u0439 \u0441 \u044F\u0441\u043D\u043E\u0439 \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \u0420\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u0442\u044C \u0443\u0434\u0430\u0451\u0442\u0441\u044F
      \u043D\u0435 \u0441\u0440\u0430\u0437\u0443: \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0434\u0435\u043D\u044C \u0432 \u0434\u043E\u0440\u043E\u0433\u0435, \u043E\u0442\u0434\u044B\u0445\u0430\u044F,
      \u0432\u044B \u043D\u0430\u043A\u043E\u043D\u0435\u0446 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0432 \u0433\u043E\u043B\u043E\u0432\u0435,
      \u043D\u043E \u0434\u0435\u043D\u044C \u043F\u043E\u0442\u0435\u0440\u044F\u043D,
      \u0438 \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u0438 \u0432\u043E\u0440\u0447\u0430\u0442
      \u043D\u0430 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686656
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442
      \u0441 \u043D\u0430\u0434\u043F\u0438\u0441\u044F\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686657
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u0441\u0430\u0434\u0438\u0442\u0441\u044F \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432,
      \u0440\u0430\u0437\u0433\u043B\u0430\u0436\u0438\u0432\u0430\u0435\u0442 \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442
      \u0438 \u0447\u0438\u0442\u0430\u0435\u0442 \u0441\u0442\u0430\u0440\u043E-\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u0435
      \u043F\u0438\u0441\u044C\u043C\u043E \u0432\u0441\u043B\u0443\u0445, \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E,
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u044F \u043A\u0430\u0436\u0434\u044B\u0439
      \u0437\u043D\u0430\u043A \u043D\u0430 \u0441\u0432\u0435\u0442. \u041A \u043A\u043E\u043D\u0446\u0443
      \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0447\u0430\u0441\u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u043F\u0440\u043E\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u044F\u0441\u043D\u0435\u0435,
      \u0447\u0435\u043C \u043C\u043E\u0433 \u0431\u044B \u0443 \u0432\u0430\u0441
      \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443. \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u0434\u0430\u0436\u0435 \u043D\u0430\u0445\u043E\u0434\u0438\u0442 \u043C\u0435\u043B\u043A\u0443\u044E
      \u043F\u043E\u043C\u0435\u0442\u043A\u0443 \u043D\u0430 \u043F\u043E\u043B\u044F\u0445:
      \u043F\u0440\u0435\u0434\u043E\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043D\u0438\u0435
      \u043E \u043A\u0430\u043C\u043D\u0435\u043F\u0430\u0434\u0430\u0445 \u0432
      \u043E\u0434\u043D\u043E\u043C \u0438\u0437 \u0443\u0449\u0435\u043B\u0438\u0439,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0432\u044B \u0431\u044B \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438.
      \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0445
      \u0441\u043B\u043E\u0432 \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u0443
      \u0432\u0430\u0441 \u0432 \u043F\u0430\u043C\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686658
    m_Localized: "\u041F\u0435\u0441\u0447\u0430\u043D\u044B\u0439 \u0445\u0440\u0430\u043C
      \u0443 \u0425\u043E\u0442\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686659
    m_Localized: "\u041D\u0430 \u044E\u0436\u043D\u043E\u0439 \u043E\u043A\u0440\u0430\u0438\u043D\u0435
      \u0425\u043E\u0442\u0430\u043D\u0441\u043A\u043E\u0433\u043E \u043E\u0430\u0437\u0438\u0441\u0430,
      \u0441\u0440\u0435\u0434\u0438 \u043F\u0435\u0441\u0447\u0430\u043D\u0438\u043A\u043E\u0432\u044B\u0445
      \u0445\u043E\u043B\u043C\u043E\u0432, \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u043E\u0441\u0442\u043E\u0432 \u0437\u0430\u0431\u044B\u0442\u043E\u0439 \u0431\u0443\u0434\u0434\u0438\u0441\u0442\u0441\u043A\u043E\u0439
      \u0441\u0442\u0443\u043F\u044B. \u041A\u0438\u0440\u043F\u0438\u0447\u043D\u0430\u044F
      \u043A\u043B\u0430\u0434\u043A\u0430 \u043A\u0440\u043E\u0448\u0438\u0442\u0441\u044F
      \u043E\u0442 \u0432\u0435\u0442\u0440\u0430, \u0432 \u043D\u0438\u0448\u0430\u0445
      \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C \u0441\u043B\u0435\u0434\u044B
      \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u0432\u043E\u0439 \u0448\u0442\u0443\u043A\u0430\u0442\u0443\u0440\u043A\u0438.
      \u041F\u043E \u043A\u0430\u0440\u0442\u0435 \u0424\u0430\u0440\u0443\u0445\u0430
      \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F \u0437\u0434\u0435\u0441\u044C,
      \u0432 \u0441\u043A\u0440\u044B\u0442\u043E\u0439 \u043D\u0438\u0448\u0435
      \u043F\u043E\u0434 \u0430\u043B\u0442\u0430\u0440\u043D\u044B\u043C \u043A\u0430\u043C\u043D\u0435\u043C.
      \u041C\u0435\u0441\u0442\u043D\u044B\u0439 \u043F\u0430\u0441\u0442\u0443\u0445
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0438\u0437\u0434\u0430\u043B\u0438,
      \u043D\u0435 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u044F\u0441\u044C:
      \u043C\u0435\u0441\u0442\u043E \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u044B\u043C, \u043D\u043E \u043D\u0438\u043A\u0435\u043C
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u043E\u0441\u0435\u0449\u0430\u0435\u0442\u0441\u044F.
      \u041F\u0435\u0441\u043E\u043A \u043C\u044F\u0433\u043A\u043E \u0448\u0443\u0440\u0448\u0438\u0442
      \u0443 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u044F \u0445\u0440\u0430\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686660
    m_Localized: "\u0420\u0430\u0441\u043A\u043E\u043F\u0430\u0442\u044C \u0430\u043B\u0442\u0430\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686661
    m_Localized: "\u0412\u044B \u0437\u0430\u0441\u0443\u0447\u0438\u0432\u0430\u0435\u0442\u0435
      \u0440\u0443\u043A\u0430\u0432\u0430 \u0438 \u0440\u0430\u0441\u0447\u0438\u0449\u0430\u0435\u0442\u0435
      \u043F\u0435\u0441\u043E\u043A \u0440\u0443\u043A\u0430\u043C\u0438. \u041F\u043E\u0434
      \u043F\u043B\u0438\u0442\u043E\u0439 \u0430\u043B\u0442\u0430\u0440\u044F \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0443\u0437\u043A\u0430\u044F \u043D\u0438\u0448\u0430, \u0432\u044B\u043B\u043E\u0436\u0435\u043D\u043D\u0430\u044F
      \u0433\u043B\u0430\u0437\u0443\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
      \u043F\u043B\u0438\u0442\u043A\u043E\u0439. \u0412\u043D\u0443\u0442\u0440\u0438:
      \u043D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u0430\u044F \u0444\u0438\u0433\u0443\u0440\u043A\u0430
      \u0411\u0443\u0434\u0434\u044B, \u043E\u0431\u0451\u0440\u043D\u0443\u0442\u0430\u044F
      \u0432 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0438\u0439 \u0448\u0451\u043B\u043A.
      \u041F\u0430\u0441\u0442\u0443\u0445, \u0443\u0432\u0438\u0434\u0435\u0432
      \u043D\u0430\u0445\u043E\u0434\u043A\u0443, \u043A\u0438\u0432\u0430\u0435\u0442
      \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C: \xAB\u041A\u0430\u043C\u0435\u043D\u044C
      \u043F\u0440\u0438\u043D\u044F\u043B \u0442\u0435\u0431\u044F.\xBB \u0412\u044B
      \u043F\u043E\u043A\u0438\u0434\u0430\u0435\u0442\u0435 \u0445\u0440\u0430\u043C
      \u0441 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0435\u0439 \u0438 \u043A\u0440\u0435\u043F\u043D\u0443\u0449\u0438\u043C
      \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u043C, \u0447\u0442\u043E \u043A\u0430\u0440\u0442\u0430
      \u0424\u0430\u0440\u0443\u0445\u0430 \u0432\u0435\u0434\u0451\u0442 \u0432\u0435\u0440\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686662
    m_Localized: "\u0412\u044B \u043A\u043E\u043F\u0430\u0435\u0442\u0435 \u043D\u0435
      \u0442\u0430\u043C: \u0430\u043B\u0442\u0430\u0440\u043D\u0430\u044F \u043F\u043B\u0438\u0442\u0430
      \u043F\u0440\u043E\u0441\u0435\u0434\u0430\u0435\u0442 \u043D\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u0443,
      \u0438 \u043E\u0434\u043D\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0430,
      \u043F\u043E\u0434\u044A\u0435\u0445\u0430\u0432\u0448\u0430\u044F \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0431\u043B\u0438\u0437\u043A\u043E, \u043D\u044B\u0440\u044F\u0435\u0442
      \u043A\u043E\u043B\u0435\u0441\u043E\u043C \u0432 \u043E\u0431\u0440\u0443\u0448\u0438\u0432\u0448\u0443\u044E\u0441\u044F
      \u044F\u043C\u0443. \u0412\u044B \u0432\u0441\u0451-\u0442\u0430\u043A\u0438
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435 \u0444\u0438\u0433\u0443\u0440\u043A\u0443
      \u0447\u0443\u0442\u044C \u0433\u043B\u0443\u0431\u0436\u0435, \u0432 \u0431\u043E\u043A\u043E\u0432\u043E\u0439
      \u043D\u0438\u0448\u0435, \u043D\u043E \u0431\u043E\u0440\u0442 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0442\u0440\u0435\u0441\u043D\u0443\u043B \u043E\u0442 \u0443\u0434\u0430\u0440\u0430,
      \u0438 \u043F\u0430\u0441\u0442\u0443\u0445 \u043A\u0430\u0447\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439: \xAB\u041A\u0430\u043C\u0435\u043D\u044C
      \u043D\u0435 \u043B\u044E\u0431\u0438\u0442 \u0442\u043E\u0440\u043E\u043F\u043B\u0438\u0432\u044B\u0445.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686663
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u043E \u0437\u0430\u0431\u0440\u0430\u0442\u044C
      \u0441 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686664
    m_Localized: "\u0412\u044B \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442\u0435\u0441\u044C
      \u0438 \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442\u0435 \u043A\u0440\u0430\u0439
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u043E\u0439 \u043E\u0431\u0451\u0440\u0442\u043A\u0438
      \u0432 \u0442\u0440\u0435\u0449\u0438\u043D\u0435 \u043F\u043B\u0438\u0442\u044B,
      \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F \u0447\u0443\u0442\u044C \u043B\u0438
      \u043D\u0435 \u0441\u0430\u043C\u0430 \u0436\u0434\u0451\u0442. \u0412\u044B
      \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u0435\u0451 \u0432\u044B\u043D\u0438\u043C\u0430\u0435\u0442\u0435,
      \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0435\u0441\u044C \u0430\u043B\u0442\u0430\u0440\u044E
      \u0438 \u0443\u0445\u043E\u0434\u0438\u0442\u0435. \u041F\u0440\u043E\u0441\u0442\u043E.
      \u0414\u0435\u043B\u043E\u0432\u043E\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435,
      \u0431\u0435\u0437 \u0440\u0430\u0441\u043A\u043E\u043F\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686665
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0447\u0438\u0442\u0430\u0435\u0442
      \u043D\u0430\u0434\u043F\u0438\u0441\u0438 \u043D\u0430 \u0441\u0442\u0443\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686666
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u043E\u0431\u0445\u043E\u0434\u0438\u0442 \u0441\u0442\u0443\u043F\u0443,
      \u0432\u043E\u0434\u0438\u0442 \u043F\u0430\u043B\u044C\u0446\u0435\u043C \u043F\u043E
      \u043F\u043E\u043B\u0443\u0441\u0442\u0451\u0440\u0448\u0438\u043C\u0441\u044F
      \u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442\u0441\u043A\u0438\u043C \u0437\u043D\u0430\u043A\u0430\u043C
      \u0438 \u0448\u0435\u043F\u0447\u0435\u0442 \u043F\u0435\u0440\u0435\u0432\u043E\u0434:
      \u043C\u043E\u043B\u0438\u0442\u0432\u0430 \u0437\u0430 \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432,
      \u0438\u043C\u0435\u043D\u0430 \u0434\u0430\u0440\u0438\u0442\u0435\u043B\u0435\u0439,
      \u0434\u0430\u0442\u0430 \u043F\u044F\u0442\u043E\u0433\u043E \u0432\u0435\u043A\u0430.
      \u0418 \u0433\u043B\u0430\u0432\u043D\u043E\u0435: \u0442\u043E\u0447\u043D\u043E\u0435
      \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u0435, \u043F\u043E\u0434 \u043A\u0430\u043A\u0438\u043C
      \u0438\u043C\u0435\u043D\u043D\u043E \u043A\u0430\u043C\u043D\u0435\u043C \u0441\u043F\u0440\u044F\u0442\u0430\u043D\u0430
      \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F. \u0411\u0435\u0437 \u0440\u0430\u0441\u043A\u043E\u043F\u043E\u043A,
      \u0431\u0435\u0437 \u0434\u043E\u0433\u0430\u0434\u043E\u043A - \u0432\u044B
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0435 \u043D\u0443\u0436\u043D\u0443\u044E
      \u043F\u043B\u0438\u0442\u0443 \u0438 \u0434\u043E\u0441\u0442\u0430\u0451\u0442\u0435
      \u043D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u043E\u0433\u043E \u0411\u0443\u0434\u0434\u0443.
      \u041F\u0430\u0441\u0442\u0443\u0445, \u0443\u0441\u043B\u044B\u0448\u0430\u0432
      \u0441\u0430\u043D\u0441\u043A\u0440\u0438\u0442, \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043B\u0430\u0434\u043E\u043D\u0438. \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435
      \u0441\u043E \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u044B\u043C \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u043C
      \u0438 \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C \u043C\u043E\u043D\u0430\u0445\u043E\u0432
      \u0432\u0441\u0435\u0433\u043E \u0425\u043E\u0442\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686667
    m_Localized: "\u041E\u0433\u043D\u0435\u043D\u043D\u044B\u0439 \u0430\u043B\u0442\u0430\u0440\u044C
      \u0443 \u0411\u0430\u043B\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686668
    m_Localized: "\u0412 \u043F\u044F\u0442\u0438 \u0432\u0435\u0440\u0441\u0442\u0430\u0445
      \u043E\u0442 \u0411\u0430\u043B\u0445\u0430, \u0441\u0440\u0435\u0434\u0438
      \u043F\u044B\u043B\u044C\u043D\u044B\u0445 \u0431\u0430\u043A\u0442\u0440\u0438\u0439\u0441\u043A\u0438\u0445
      \u0445\u043E\u043B\u043C\u043E\u0432, \u0441\u0442\u043E\u0438\u0442 \u0440\u0443\u0438\u043D\u0430
      \u0437\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u043E\u0433\u043E
      \u0445\u0440\u0430\u043C\u0430 \u043E\u0433\u043D\u044F. \u0410\u043B\u0442\u0430\u0440\u043D\u044B\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C \u0432 \u0446\u0435\u043D\u0442\u0440\u0435
      \u0437\u0430\u043B\u0430 \u0447\u0451\u0440\u0435\u043D \u043E\u0442 \u043A\u043E\u043F\u043E\u0442\u0438
      \u0432\u0435\u043A\u043E\u0432. \u0423 \u0432\u0445\u043E\u0434\u0430 \u0434\u0435\u0436\u0443\u0440\u0438\u0442
      \u043F\u043E\u0436\u0438\u043B\u043E\u0439 \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C
      \u0432 \u0432\u044B\u0446\u0432\u0435\u0442\u0448\u0435\u043C \u0441\u0435\u0440\u043E\u043C
      \u043A\u0430\u0444\u0442\u0430\u043D\u0435, \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0438\u0437 \u043E\u0431\u0449\u0438\u043D\u044B. \u041F\u043E \u043A\u0430\u0440\u0442\u0435
      \u0424\u0430\u0440\u0443\u0445\u0430 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F
      \u043B\u0435\u0436\u0438\u0442 \u0432 \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0438
      \u0430\u043B\u0442\u0430\u0440\u044F, \u043F\u043E\u0434 \u0441\u043B\u043E\u0435\u043C
      \u043F\u0435\u043F\u043B\u0430. \u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0431\u0435\u0437 \u0432\u0440\u0430\u0436\u0434\u044B,
      \u043D\u043E \u0438 \u0431\u0435\u0437 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u044F.
      \u0421\u043B\u043E\u0432\u043E \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442
      \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u0442\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686669
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u0441 \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686670
    m_Localized: "\u0412\u044B \u0441\u0430\u0434\u0438\u0442\u0435\u0441\u044C \u0440\u044F\u0434\u043E\u043C
      \u0441\u043E \u0441\u0442\u0430\u0440\u0438\u043A\u043E\u043C, \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435
      \u0442\u0438\u0445\u043E \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F
      \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0430,
      \u0447\u0442\u043E \u0432\u044B \u0435\u0451 \u043D\u0435 \u043F\u0440\u043E\u0434\u0430\u0434\u0438\u0442\u0435,
      \u0447\u0442\u043E \u0424\u0430\u0440\u0443\u0445 \u0438\u0437 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B \u0432\u0430\u0441. \u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C
      \u0441\u043B\u0443\u0448\u0430\u0435\u0442 \u0434\u043E\u043B\u0433\u043E,
      \u043F\u043E\u0442\u043E\u043C \u043A\u0438\u0432\u0430\u0435\u0442: \xAB\u041F\u0443\u0441\u0442\u044C
      \u0434\u0430\u0440 \u0432\u0435\u0440\u043D\u0451\u0442\u0441\u044F \u043A
      \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C\u0443 \u043F\u0443\u0442\u0438,
      \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0431\u044B\u043B
      \u0441\u0434\u0435\u043B\u0430\u043D.\xBB \u041E\u043D \u0441\u0430\u043C \u043E\u0442\u0433\u0440\u0435\u0431\u0430\u0435\u0442
      \u043F\u0435\u043F\u0435\u043B \u0438 \u043F\u043E\u0434\u0430\u0451\u0442
      \u0432\u0430\u043C \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u0443\u044E \u0444\u0438\u0433\u0443\u0440\u043A\u0443:
      \u043A\u0440\u044B\u043B\u0430\u0442\u043E\u0433\u043E \u0430\u0441\u0441\u0443\u0440\u0430.
      \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0435\u0439
      \u0438 \u0441 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435\u043C
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u0436\u0440\u0435\u0446\u0430
      \u0411\u0430\u043B\u0445\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686671
    m_Localized: "\u0412\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0433\u0440\u043E\u043C\u043A\u043E, \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0442\u043E\u0440\u043E\u043F\u043B\u0438\u0432\u043E. \u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C
      \u043C\u0440\u0430\u0447\u043D\u0435\u0435\u0442: \xAB\u0427\u0443\u0436\u0430\u043A
      \u043D\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442 \u043E\u0433\u043E\u043D\u044C.\xBB
      \u0412 \u0438\u0442\u043E\u0433\u0435 \u043E\u043D \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0441\u044F
      \u043E\u0442\u0434\u0430\u0442\u044C \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044E
      \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0430 \u0441\u0435\u0440\u0435\u0431\u0440\u043E
      \u0438 \u0431\u0435\u0440\u0451\u0442 \u0432\u0434\u0432\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0441\u0442\u043E\u0438\u043B\u043E \u0431\u044B. \u0412\u044B
      \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u0444\u0438\u0433\u0443\u0440\u043A\u043E\u0439,
      \u043D\u043E \u0441 \u0442\u044F\u0436\u0451\u043B\u044B\u043C \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u043C,
      \u0447\u0442\u043E \u0441\u0434\u0435\u043B\u043A\u0430 \u0431\u044B\u043B\u0430
      \u043D\u0435 \u0442\u0430\u043A\u043E\u0439, \u043A\u0430\u043A\u043E\u0439
      \u0445\u043E\u0442\u0435\u043B \u0424\u0430\u0440\u0443\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686672
    m_Localized: "\u041E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686673
    m_Localized: "\u0412\u044B \u0432\u044B\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u043A\u043E\u0448\u0435\u043B\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u0430
      \u0431\u0435\u0437 \u0441\u043B\u043E\u0432. \u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C
      \u043C\u043E\u043B\u0447\u0430 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0434\u0435\u043D\u044C\u0433\u0438, \u043E\u0442\u0433\u0440\u0435\u0431\u0430\u0435\u0442
      \u043F\u0435\u043F\u0435\u043B \u0438 \u043E\u0442\u0434\u0430\u0451\u0442
      \u0444\u0438\u0433\u0443\u0440\u043A\u0443. \u0421\u0434\u0435\u043B\u043A\u0430
      \u0434\u0435\u043B\u043E\u0432\u0430\u044F, \u0431\u0435\u0437\u043B\u0438\u0447\u043D\u0430\u044F.
      \u0420\u0435\u043B\u0438\u043A\u0432\u0438\u044F \u0442\u0435\u043F\u0435\u0440\u044C
      \u0443 \u0432\u0430\u0441 - \u043D\u043E \u0432 \u0433\u043B\u0430\u0437\u0430\u0445
      \u0441\u0442\u0430\u0440\u0438\u043A\u0430 \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u0445\u043E\u043B\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686674
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u0431\u0435\u0441\u0435\u0434\u0443 \u043D\u0430 \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686675
    m_Localized: "\u0412\u0430\u0448 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043A \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044E
      \u0438 \u0437\u0430\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0447\u0438\u0441\u0442\u043E\u043C \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u043C,
      \u0446\u0438\u0442\u0438\u0440\u0443\u044F \u0441\u0442\u0440\u043E\u043A\u0443
      \u0438\u0437 \xAB\u0410\u0432\u0435\u0441\u0442\u044B\xBB \u043F\u0440\u043E
      \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432, \u0447\u044C\u0451 \u0434\u0435\u043B\u043E
      \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0442\u044C \u0437\u0435\u043C\u043B\u0438.
      \u0421\u0442\u0430\u0440\u0438\u043A \u0440\u0430\u0441\u0446\u0432\u0435\u0442\u0430\u0435\u0442:
      \u0434\u0430\u0432\u043D\u043E \u0435\u043C\u0443 \u043D\u0435 \u0434\u043E\u0432\u043E\u0434\u0438\u043B\u043E\u0441\u044C
      \u0441\u043B\u044B\u0448\u0430\u0442\u044C \u0441\u043B\u043E\u0432\u043E \u0432\u0435\u0440\u044B
      \u0438\u0437 \u0447\u0443\u0436\u0438\u0445 \u0443\u0441\u0442. \u0411\u0435\u0441\u0435\u0434\u0430
      \u0438\u0434\u0451\u0442 \u0434\u043E\u043B\u0433\u043E, \u0447\u0430\u0439
      \u0441\u043C\u0435\u043D\u044F\u0435\u0442 \u0447\u0430\u0439. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C \u0441\u0430\u043C \u0432\u0435\u0434\u0451\u0442
      \u0432\u0430\u0441 \u043A \u0430\u043B\u0442\u0430\u0440\u044E \u0438 \u043F\u043E\u0434\u0430\u0451\u0442
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u0443\u044E \u0444\u0438\u0433\u0443\u0440\u043A\u0443
      \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C. \xAB\u041F\u0443\u0441\u0442\u044C
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0442\u0432\u043E\u044F \u0431\u0443\u0434\u0435\u0442
      \u0441\u0432\u0435\u0442\u043B\u043E\u0439, \u043A\u0430\u043A \u043E\u0433\u043E\u043D\u044C.\xBB
      \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u0435\u0439
      \u0438 \u0441 \u043F\u0430\u0440\u043E\u0439 \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0445
      \u0444\u0440\u0430\u0437, \u043E\u0441\u0435\u0432\u0448\u0438\u0445 \u0432
      \u043F\u0430\u043C\u044F\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686676
    m_Localized: "\u041F\u0435\u0449\u0435\u0440\u043D\u043E\u0435 \u0441\u0432\u044F\u0442\u0438\u043B\u0438\u0449\u0435
      \u0443 \u041A\u0443\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686677
    m_Localized: "\u0412 \u0441\u043A\u0430\u043B\u0430\u0445 \u043A \u0441\u0435\u0432\u0435\u0440\u0443
      \u043E\u0442 \u041A\u0443\u0447\u0438, \u0432 \u043E\u0431\u0440\u044B\u0432\u0435
      \u043D\u0430\u0434 \u0441\u0443\u0445\u0438\u043C \u0440\u0443\u0441\u043B\u043E\u043C,
      \u0447\u0435\u0440\u043D\u0435\u044E\u0442 \u0432\u0445\u043E\u0434\u044B \u043F\u0435\u0449\u0435\u0440\u043D\u044B\u0445
      \u0441\u0432\u044F\u0442\u0438\u043B\u0438\u0449. \u0422\u043E\u0445\u0430\u0440\u0441\u043A\u0438\u0435
      \u043C\u043E\u043D\u0430\u0445\u0438 \u0434\u0430\u0432\u043D\u043E \u0443\u0448\u043B\u0438,
      \u043D\u043E \u0444\u0440\u0435\u0441\u043A\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0441\u044C:
      \u0411\u0443\u0434\u0434\u044B \u0432 \u0441\u0438\u043D\u0438\u0445 \u0441\u043A\u043B\u0430\u0434\u043A\u0430\u0445,
      \u0442\u044B\u0441\u044F\u0447\u0430 \u0433\u043D\u0435\u0432\u043D\u044B\u0445
      \u043B\u0438\u0446 \u043D\u0430 \u043F\u043E\u0442\u043E\u043B\u043A\u0430\u0445.
      \u041F\u043E \u043A\u0430\u0440\u0442\u0435 \u0424\u0430\u0440\u0443\u0445\u0430
      \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u0432 \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0432\u0435\u0440\u0445\u043D\u0438\u0445
      \u043F\u0435\u0449\u0435\u0440, \u0434\u043E \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043D\u0443\u0436\u043D\u043E \u043A\u0430\u0440\u0430\u0431\u043A\u0430\u0442\u044C\u0441\u044F
      \u043F\u043E \u0432\u044B\u0432\u0435\u0442\u0440\u0435\u043D\u043D\u043E\u0439
      \u0441\u043A\u0430\u043B\u0435. \u0421\u043D\u0438\u0437\u0443 \u043F\u0435\u0449\u0435\u0440\u0430
      \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043E\u0431\u043C\u0430\u043D\u0447\u0438\u0432\u043E
      \u0431\u043B\u0438\u0437\u043A\u043E\u0439. \u0412\u0435\u0442\u0435\u0440
      \u0441 \u043F\u0443\u0441\u0442\u044B\u043D\u0438 \u041B\u043E\u043F \u0442\u044F\u043D\u0435\u0442
      \u043F\u0435\u0441\u043E\u043A \u0432 \u0442\u0440\u0435\u0449\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686678
    m_Localized: "\u041F\u043E\u0434\u043D\u044F\u0442\u044C\u0441\u044F \u043A \u043F\u0435\u0449\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686679
    m_Localized: "\u0412\u044B \u043B\u0435\u0437\u0435\u0442\u0435 \u043F\u043E
      \u0441\u043A\u0430\u043B\u0435 \u043C\u0435\u0442\u0440 \u0437\u0430 \u043C\u0435\u0442\u0440\u043E\u043C,
      \u043F\u0440\u043E\u0431\u0443\u044F \u043A\u0430\u0436\u0434\u044B\u0439 \u0432\u044B\u0441\u0442\u0443\u043F.
      \u041D\u0430 \u043F\u043E\u043B\u043F\u0443\u0442\u0438 \u0432\u0435\u0442\u0435\u0440
      \u0448\u0432\u044B\u0440\u044F\u0435\u0442 \u0432 \u043B\u0438\u0446\u043E
      \u043F\u0435\u0441\u043E\u043A, \u0441\u043A\u0430\u043B\u0430 \u043A\u0430\u0447\u0430\u0435\u0442\u0441\u044F
      - \u043D\u043E \u0443\u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F
      \u0443\u0434\u0430\u0451\u0442\u0441\u044F. \u0412 \u043F\u0435\u0449\u0435\u0440\u0435
      \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u043E \u0438 \u0442\u0438\u0445\u043E.
      \u041F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438 \u0441\u0442\u0443\u043F\u0430
      \u043F\u0435\u0441\u043A\u0430 \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u043F\u043B\u043E\u0441\u043A\u0438\u0439 \u043A\u0430\u043C\u0435\u043D\u044C;
      \u043F\u043E\u0434 \u043D\u0438\u043C \u043D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u0430\u044F
      \u0444\u0438\u0433\u0443\u0440\u043A\u0430 \u0411\u0443\u0434\u0434\u044B \u0432
      \u043F\u043E\u0437\u0435 \u043C\u0435\u0434\u0438\u0442\u0430\u0446\u0438\u0438.
      \u0421\u043F\u0443\u0441\u043A\u0430\u0435\u0442\u0435\u0441\u044C \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u0438 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E, \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F
      \u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u043E\u0439. \u0423\u0432\u0430\u0436\u0435\u043D\u0438\u0435
      \u0432\u0430\u0448\u0435\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u044B \u0440\u0430\u0441\u0442\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686680
    m_Localized: "\u041D\u0430 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u043F\u043E\u0434\u044A\u0451\u043C\u0430
      \u043A\u0430\u043C\u0435\u043D\u044C \u043F\u043E\u0434 \u0440\u0443\u043A\u043E\u0439
      \u0432\u044B\u043A\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u0438 \u0432\u044B \u0441\u044A\u0435\u0437\u0436\u0430\u0435\u0442\u0435
      \u043D\u0430 \u0434\u0435\u0441\u044F\u0442\u044C \u043C\u0435\u0442\u0440\u043E\u0432
      \u0432\u043D\u0438\u0437, \u0446\u0435\u043F\u043B\u044F\u044F\u0441\u044C
      \u0437\u0430 \u043A\u043E\u0440\u043D\u0438 \u0438 \u0442\u0440\u0435\u0449\u0438\u043D\u044B.
      \u041E\u0431\u043E\u0434\u0440\u0430\u043D\u043D\u044B\u0435 \u043B\u0430\u0434\u043E\u043D\u0438,
      \u0440\u0430\u0437\u0431\u0438\u0442\u043E\u0435 \u043A\u043E\u043B\u0435\u043D\u043E.
      \u0412\u044B \u0432\u0441\u0451 \u0436\u0435 \u0434\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0435\u0441\u044C
      \u0434\u043E \u043F\u0435\u0449\u0435\u0440\u044B \u0441\u043E \u0432\u0442\u043E\u0440\u043E\u0439
      \u043F\u043E\u043F\u044B\u0442\u043A\u0438, \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044E
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0435 - \u043D\u043E \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u0435
      \u043E \u043C\u0435\u0441\u0442\u0435 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0441\u0432\u044F\u0437\u0430\u043D\u043E \u0441 \u0431\u043E\u043B\u044C\u044E
      \u0438 \u0441\u0442\u0440\u0430\u0445\u043E\u043C, \u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u0430
      \u0432\u0438\u0434\u0438\u0442, \u0447\u0442\u043E \u0432\u044B \u043F\u0440\u0438\u0445\u0440\u0430\u043C\u044B\u0432\u0430\u0435\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686681
    m_Localized: "\u0414\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F \u0441\u0443\u0445\u043E\u0439
      \u043F\u043E\u0433\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686682
    m_Localized: "\u0412\u044B \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0435
      \u043B\u0430\u0433\u0435\u0440\u044C \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F
      \u0441\u043A\u0430\u043B\u044B \u0438 \u0436\u0434\u0451\u0442\u0435 \u0434\u0432\u0430
      \u0434\u043D\u044F, \u043F\u043E\u043A\u0430 \u0432\u0435\u0442\u0435\u0440
      \u0443\u043B\u044F\u0436\u0435\u0442\u0441\u044F. \u041D\u0430 \u0442\u0440\u0435\u0442\u0438\u0439
      \u0434\u0435\u043D\u044C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0435\u0441\u044C
      \u0431\u0435\u0437 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439:
      \u043A\u0430\u043C\u0435\u043D\u044C \u0441\u0443\u0445\u043E\u0439, \u043F\u0435\u0441\u043A\u0430
      \u043D\u0435\u0442, \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F \u043B\u0435\u0436\u0438\u0442
      \u0440\u043E\u0432\u043D\u043E \u0442\u0430\u043C, \u0433\u0434\u0435 \u043E\u0431\u0435\u0449\u0430\u043B\u0430
      \u043A\u0430\u0440\u0442\u0430. \u0412\u0440\u0435\u043C\u044F \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u043E,
      \u043D\u043E \u043D\u043E\u0433\u0438 \u0446\u0435\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686683
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0432\u0435\u0434\u0451\u0442
      \u0431\u043E\u043A\u043E\u0432\u043E\u0439 \u0442\u0440\u043E\u043F\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 31198603807686684
    m_Localized: "\u0412\u0430\u0448 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0434\u043E\u043B\u0433\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u0441\u043A\u0430\u043B\u0443, \u043F\u043E\u0442\u043E\u043C \u043C\u0430\u0448\u0435\u0442
      \u0440\u0443\u043A\u043E\u0439 \u0432\u043B\u0435\u0432\u043E: \xAB\u041D\u0435
      \u0437\u0434\u0435\u0441\u044C. \u0421\u0442\u0430\u0440\u0438\u043A\u0438
      \u0445\u043E\u0434\u0438\u043B\u0438 \u0432\u044B\u0448\u0435 \u043F\u043E
      \u0440\u0443\u0441\u043B\u0443.\xBB \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441
      \u043E\u0431\u0445\u043E\u0434\u0430 \u0432\u044B \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435\u0441\u044C
      \u0443 \u0437\u0430\u0434\u043D\u0435\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B
      \u0443\u0442\u0451\u0441\u0430, \u0433\u0434\u0435 \u043F\u0435\u0449\u0435\u0440\u0430
      \u0441\u043E\u0435\u0434\u0438\u043D\u044F\u0435\u0442\u0441\u044F \u0441 \u0435\u0441\u0442\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
      \u0433\u0440\u043E\u0442\u043E\u043C, \u0432 \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043C\u043E\u0436\u043D\u043E \u0432\u043E\u0439\u0442\u0438 \u043F\u0435\u0448\u043A\u043E\u043C.
      \u041D\u0438\u043A\u0430\u043A\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0431\u043A\u0430\u043D\u044C\u044F.
      \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0437\u0430\u0436\u0438\u0433\u0430\u0435\u0442
      \u0444\u0430\u043A\u0435\u043B, \u0432\u0435\u0434\u0451\u0442 \u0447\u0435\u0440\u0435\u0437
      \u0433\u0440\u043E\u0442, \u0438 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044F
      (\u043D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u044B\u0439 \u0411\u0443\u0434\u0434\u0430)
      \u043B\u0435\u0436\u0438\u0442 \u043D\u0430 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0439
      \u043F\u043E\u043B\u043A\u0435, \u0441\u043B\u043E\u0432\u043D\u043E \u0432\u0430\u0441
      \u0436\u0434\u0430\u043B\u0438. \u041E\u043F\u044B\u0442 \u0433\u043E\u0440\u043D\u044B\u0445
      \u043F\u0443\u0442\u0435\u0439 \u0435\u0449\u0451 \u0440\u0430\u0437 \u043E\u043A\u0443\u043F\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431464939520
    m_Localized: "\u0428\u0451\u043B\u043A \u0437\u0430\u043A\u0443\u043F\u043B\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882560
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0438\u0437 \u0434\u0435\u0441\u044F\u0442\u0438 \u0442\u044E\u043A\u043E\u0432
      \u043B\u043E\u0436\u0438\u0442\u0441\u044F \u0432 \u043E\u0431\u043E\u0437.
      \u0422\u044E\u043A\u0438 \u043A\u0440\u0435\u043F\u043A\u043E \u0437\u0430\u0432\u044F\u0437\u0430\u043D\u044B,
      \u043F\u0435\u0447\u0430\u0442\u0438 \u0440\u044B\u043D\u043A\u0430 \u0441\u0442\u043E\u044F\u0442.
      \u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0436\u0434\u0451\u0442 \u0432
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435. \u041F\u043E\u0440\u0430
      \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C\u0441\u044F \u043D\u0430
      \u0437\u0430\u043F\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882561
    m_Localized: "\u0412\u044B\u0434\u0432\u0438\u043D\u0443\u0442\u044C\u0441\u044F
      \u0432 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882562
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u044B\u0445\u043E\u0434\u0438\u0442
      \u0438\u0437 \u0427\u0430\u043D\u044A\u0430\u043D\u044F, \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044F
      \u043D\u0430 \u0437\u0430\u043F\u0430\u0434. \u0414\u0435\u0441\u044F\u0442\u044C
      \u0442\u044E\u043A\u043E\u0432 \u0448\u0451\u043B\u043A\u0430 \u043A\u0430\u0447\u0430\u044E\u0442\u0441\u044F
      \u0432 \u0440\u0438\u0442\u043C \u0448\u0430\u0433\u043E\u0432 \u0432\u044C\u044E\u0447\u043D\u044B\u0445
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882563
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882564
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0434\u043E\u043B\u0433\u0438\u0445
      \u043D\u0435\u0434\u0435\u043B\u044C \u043F\u0443\u0442\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0441\u0442\u0435\u043D\u044B \u0427\u0430\u043D\u044A\u0430\u043D\u044F.
      \u0413\u0438\u043B\u044C\u0434\u0435\u0439\u0441\u043A\u0438\u0439 \u0441\u043A\u043B\u0430\u0434
      \u043C\u0430\u0441\u0442\u0435\u0440\u0430 \u0427\u044D\u043D\u044F \u2014
      \u0443 \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0445 \u0432\u043E\u0440\u043E\u0442.
      \u0422\u044E\u043A\u0438 \u0448\u0451\u043B\u043A\u0430 \u0446\u0435\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882565
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882566
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0447\u0435\u0440\u0435\u0437 \u0432\u043E\u0440\u043E\u0442\u0430. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438
      \u0441\u0430\u043B\u044E\u0442\u0443\u044E\u0442 \u0433\u0440\u0430\u043C\u043E\u0442\u043E\u0439
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438. \u0414\u0430\u043B\u044C\u0448\u0435
      \u2014 \u043B\u0430\u0432\u043A\u0430 \u0412\u0430\u0445\u0443-\u041C\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882567
    m_Localized: "\u0411\u0443\u0445\u0430\u0440\u0441\u043A\u0438\u0435 \u043A\u0443\u043F\u043E\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882568
    m_Localized: "\u041C\u0438\u043D\u0430\u0440\u0435\u0442\u044B \u0411\u0443\u0445\u0430\u0440\u044B
      \u043E\u0442\u0440\u0430\u0436\u0430\u044E\u0442 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u0435
      \u0441\u043E\u043B\u043D\u0446\u0435. \u0410\u043B\u044C-\u0411\u0443\u0445\u0430\u0440\u0438
      \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0442 \u0446\u0435\u043B\u044B\u0439
      \u043A\u0432\u0430\u0440\u0442\u0430\u043B - \u0434\u0432\u043E\u0440 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u0434\u043E\u043C\u0430 \u0443\u0437\u043D\u0430\u0432\u0430\u0435\u043C \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430
      \u043F\u043E \u043A\u0440\u0430\u0441\u043D\u043E-\u0431\u0435\u043B\u043E\u043C\u0443
      \u0448\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882569
    m_Localized: "\u041F\u043E\u0434\u043E\u0439\u0442\u0438 \u043A \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C\u0443
      \u0434\u043E\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882570
    m_Localized: "\u041F\u0440\u0438\u0432\u0440\u0430\u0442\u043D\u0438\u043A \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0432 \u0442\u0435\u043D\u0438\u0441\u0442\u044B\u0439
      \u0434\u0432\u043E\u0440. \u0425\u0430\u0434\u0436\u0438 \u042E\u0441\u0443\u0444
      \u0443\u0436\u0435 \u0436\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882571
    m_Localized: "\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882572
    m_Localized: "\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u043F\u044B\u043B\u0438 \u0438
      \u0440\u043E\u0437\u043E\u0432\u043E\u0433\u043E \u043C\u0430\u0441\u043B\u0430.
      \u0412 \u043A\u043E\u0448\u0435\u043B\u0435 - \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0439
      \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442 \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E
      \u0410\u043B\u044C-\u0411\u0443\u0445\u0430\u0440\u0438. \u0412\u0430\u0445\u0443-\u041C\u0430\u043D
      \u0432 \u0433\u0438\u043B\u044C\u0434\u0435\u0439\u0441\u043A\u043E\u043C \u0437\u0430\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882573
    m_Localized: "\u0418\u0434\u0442\u0438 \u0432 \u0433\u0438\u043B\u044C\u0434\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882574
    m_Localized: "\u0414\u0432\u0435\u0440\u0438 \u0433\u0438\u043B\u044C\u0434\u0435\u0439\u0441\u043A\u043E\u0433\u043E
      \u0437\u0430\u043B\u0430 \u0440\u0430\u0441\u043F\u0430\u0445\u043D\u0443\u0442\u044B.
      \u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u0443 \u043E\u0442 \u0441\u0432\u0438\u0442\u043A\u043E\u0432
      \u0438 \u043A\u0438\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882575
    m_Localized: "\u041C\u0435\u0448\u0445\u0435\u0434\u0441\u043A\u0438\u0435 \u0441\u0442\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882576
    m_Localized: "\u041C\u0435\u0448\u0445\u0435\u0434\u0441\u043A\u0438\u0435 \u0441\u0442\u0435\u043D\u044B
      \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u043D\u0430 \u0437\u0430\u043A\u0430\u0442\u0435.
      \u041B\u0430\u0432\u043A\u0430 \u0433\u0438\u043B\u044C\u0434\u0435\u0439\u0441\u043A\u043E\u0433\u043E
      \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044F
      - \u043D\u0430 \u0433\u043B\u0430\u0432\u043D\u043E\u0439 \u0443\u043B\u0438\u0446\u0435.
      \u0412\u044B \u0434\u0435\u0440\u0436\u0438\u0442\u0435 \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442
      \u0432 \u0440\u0443\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882577
    m_Localized: "\u041F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882578
    m_Localized: "\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044C
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0443 \u0434\u0432\u0435\u0440\u0435\u0439
      \u043B\u0430\u0432\u043A\u0438 \u0438 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0440\u0443\u043A\u0443 \u0432 \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882579
    m_Localized: "\u0411\u0430\u0433\u0434\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882580
    m_Localized: "\u041D\u0430\u0434 \u0433\u043E\u0440\u043E\u0434\u043E\u043C -
      \u0433\u043E\u043B\u0443\u0431\u043E\u0439 \u043A\u0443\u043F\u043E\u043B \u0414\u043E\u043C\u0430
      \u041C\u0443\u0434\u0440\u043E\u0441\u0442\u0438. \u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C
      \u0433\u0440\u0443\u0437\u0430 \u0434\u043E\u043B\u0436\u0435\u043D \u0436\u0434\u0430\u0442\u044C
      \u0443 \u0441\u043A\u043B\u0430\u0434\u043E\u0432 \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443
      \u0422\u0438\u0433\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882581
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882582
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u043A \u0441\u043A\u043B\u0430\u0434\u0430\u043C. \u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C
      - \u0440\u043E\u0441\u043B\u044B\u0439 \u043A\u0443\u043F\u0435\u0446 \u0441
      \u0448\u0440\u0430\u043C\u043E\u043C - \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u0432\u0430\u043C \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882583
    m_Localized: "\u0421\u0442\u0435\u043D\u044B \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882584
    m_Localized: "\u0417\u043E\u043B\u043E\u0442\u044B\u0435 \u043A\u0443\u043F\u043E\u043B\u0430
      \u041A\u043E\u043D\u0441\u0442\u0430\u043D\u0442\u0438\u043D\u043E\u043F\u043E\u043B\u044F
      \u0441\u0438\u044F\u044E\u0442 \u0432\u043F\u0435\u0440\u0435\u0434\u0438.
      \u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0441\u0442\u043E\u0438\u0442
      \u0440\u044F\u0434\u043E\u043C, \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442. \xAB\u0412\u0441\u0451
      \u0433\u043E\u0442\u043E\u0432\u043E. \u041E\u0434\u0438\u043D \u0448\u0430\u0433
      - \u0438 \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C
      \u043F\u0440\u043E\u0439\u0434\u0435\u043D.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882585
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882586
    m_Localized: "\u0412\u0430\u0445\u0443-\u041C\u0430\u043D \u0434\u0435\u043B\u0430\u0435\u0442
      \u043F\u0435\u0440\u0432\u044B\u0439 \u0448\u0430\u0433 \u0447\u0435\u0440\u0435\u0437
      \u0432\u043E\u0440\u043E\u0442\u0430. \u0412\u044B - \u0441\u043B\u0435\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882587
    m_Localized: "\u0410\u043D\u044C\u0441\u0438 \u0438 \u041C\u043E\u0433\u0430\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882588
    m_Localized: "\u0410\u043D\u044C\u0441\u0438 \u043E\u0442\u043A\u0440\u044B\u043B\u0441\u044F
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435. \u041F\u0435\u0449\u0435\u0440\u044B
      \u041C\u043E\u0433\u0430\u043E - \u0432 \u0447\u0430\u0441\u0435 \u043F\u0443\u0442\u0438
      \u043E\u0442 \u0433\u043E\u0440\u043E\u0434\u0430, \u0441\u0440\u0435\u0434\u0438
      \u043F\u0435\u0441\u0447\u0430\u043D\u0438\u043A\u043E\u0432\u044B\u0445 \u0445\u043E\u043B\u043C\u043E\u0432.
      \u0421\u0432\u0438\u0442\u043E\u043A \u041B\u043E\u0431\u0441\u0430\u043D\u0433\u0430
      \u0432 \u043A\u043E\u0436\u0430\u043D\u043E\u0439 \u0441\u0443\u043C\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882589
    m_Localized: "\u0418\u0434\u0442\u0438 \u043A \u043F\u0435\u0449\u0435\u0440\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882590
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u0432\u044C\u0451\u0442\u0441\u044F
      \u0441\u0440\u0435\u0434\u0438 \u0434\u044E\u043D. \u041F\u0440\u043E\u0445\u043B\u0430\u0434\u0430
      \u043F\u0435\u0449\u0435\u0440 \u043E\u0431\u0435\u0449\u0430\u0435\u0442 \u0442\u0438\u0448\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882591
    m_Localized: "\u041F\u0435\u0449\u0435\u0440\u044B \u041C\u043E\u0433\u0430\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882592
    m_Localized: "\u0412 \u043F\u0435\u0449\u0435\u0440\u0430\u0445 \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u043E
      \u0438 \u0442\u0438\u0445\u043E. \u0422\u044B\u0441\u044F\u0447\u0438 \u0411\u0443\u0434\u0434
      \u0441\u043C\u043E\u0442\u0440\u044F\u0442 \u0441\u043E \u0441\u0442\u0435\u043D.
      \u0422\u0438\u043D\u043B\u0435\u0439 \u043F\u0440\u043E\u0441\u0438\u043B \u0432\u0430\u0441
      \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F \u0437\u0434\u0435\u0441\u044C
      - \u043F\u043E\u0441\u043B\u0443\u0448\u0430\u0442\u044C, \u0447\u0442\u043E
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882593
    m_Localized: "\u0421\u0438\u0434\u0435\u0442\u044C \u0432 \u0442\u0438\u0448\u0438\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882594
    m_Localized: "\u0427\u0430\u0441 \u043F\u0440\u043E\u0448\u0451\u043B - \u043C\u043E\u0436\u0435\u0442,
      \u0434\u0432\u0430. \u0421\u0442\u0435\u043D\u044B \u043F\u0435\u0449\u0435\u0440\u044B
      \u0434\u044B\u0448\u0430\u0442. \u0412\u044B \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0435\u0441\u044C,
      \u0443\u043D\u043E\u0441\u044F \u0441 \u0441\u043E\u0431\u043E\u0439 \u043F\u0435\u0440\u0432\u044B\u0439
      \u0438\u0437 \u0442\u0440\u0451\u0445 \u0433\u043E\u043B\u043E\u0441\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882595
    m_Localized: "\u0411\u0438\u0431\u0438-\u0425\u0430\u043D\u044B\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882596
    m_Localized: "\u041C\u0435\u0447\u0435\u0442\u044C \u0411\u0438\u0431\u0438-\u0425\u0430\u043D\u044B\u043C
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435 - \u0447\u0443\u0434\u043E
      \u0441\u0438\u043D\u0438\u0445 \u0438\u0437\u0440\u0430\u0437\u0446\u043E\u0432.
      \u0412 \u0435\u0451 \u0442\u0435\u043D\u0438 \u0437\u0432\u0443\u043A\u0438
      \u0433\u043E\u0440\u043E\u0434\u0430 \u0441\u0442\u0438\u0445\u0430\u044E\u0442.
      \u0422\u0438\u043D\u043B\u0435\u0439 \u043F\u0440\u043E\u0441\u0438\u043B \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C
      \u0432\u0442\u043E\u0440\u043E\u0439 \u0433\u043E\u043B\u043E\u0441 - \u0433\u043E\u043B\u043E\u0441
      \u043A\u0430\u043C\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882597
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0432 \u043C\u0435\u0447\u0435\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882598
    m_Localized: "\u0412 \u043F\u0443\u0441\u0442\u043E\u0439 \u043C\u0435\u0447\u0435\u0442\u0438
      \u0432\u0430\u0448 \u0448\u0430\u0433 \u043E\u0442\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u044D\u0445\u043E\u043C. \u041A\u0430\u043C\u0435\u043D\u044C \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0431\u0435\u0437 \u0441\u043B\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882599
    m_Localized: "\u0425\u0440\u0430\u043C \u041E\u0433\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882600
    m_Localized: "\u0417\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u0438\u0439
      \u0425\u0440\u0430\u043C \u041E\u0433\u043D\u044F \u0432 \u041C\u0435\u0448\u0445\u0435\u0434\u0435
      - \u043D\u0438\u0437\u043A\u043E\u0435 \u043A\u0430\u043C\u0435\u043D\u043D\u043E\u0435
      \u0437\u0434\u0430\u043D\u0438\u0435 \u0441 \u0432\u0435\u0447\u043D\u044B\u043C
      \u043F\u043B\u0430\u043C\u0435\u043D\u0435\u043C \u0432\u043E \u0434\u0432\u043E\u0440\u0435.
      \u0422\u0438\u043D\u043B\u0435\u0439 \u043F\u0440\u043E\u0441\u0438\u043B \u0443\u0441\u043B\u044B\u0448\u0430\u0442\u044C
      \u0442\u0440\u0435\u0442\u0438\u0439 \u0433\u043E\u043B\u043E\u0441 - \u0433\u043E\u043B\u043E\u0441
      \u043E\u0433\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882601
    m_Localized: "\u041F\u043E\u0434\u043E\u0439\u0442\u0438 \u043A \u043E\u0433\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882602
    m_Localized: "\u0416\u0430\u0440 \u0442\u0440\u043E\u0433\u0430\u0435\u0442 \u043A\u043E\u0436\u0443.
      \u0412\u044B \u0441\u0442\u043E\u0438\u0442\u0435 \u0434\u043E\u043B\u0433\u043E.
      \u041E\u0433\u043E\u043D\u044C \u0433\u043E\u0432\u043E\u0440\u0438\u0442 -
      \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u0443 \u0432\u0430\u0441 \u0442\u0440\u0438
      \u0433\u043E\u043B\u043E\u0441\u0430 \u043E\u0434\u043D\u043E\u0433\u043E \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882603
    m_Localized: "\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434 \u0441\u043D\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882604
    m_Localized: "\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0442\u0435\u043C \u0436\u0435 \u0437\u0430\u043F\u0430\u0445\u043E\u043C
      \u0440\u043E\u0437 \u0438 \u043F\u044B\u043B\u0438. \u041B\u043E\u0431\u0441\u0430\u043D\u0433
      \u0436\u0434\u0451\u0442 \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0435
      \u043D\u0430 \u043E\u043A\u0440\u0430\u0438\u043D\u0435 - \u0432\u044B \u0434\u043E\u043B\u0436\u043D\u044B
      \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435
      \u0445\u0440\u0430\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882605
    m_Localized: "\u0418\u0434\u0442\u0438 \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882606
    m_Localized: "\u041B\u043E\u0431\u0441\u0430\u043D\u0433 \u0441\u0438\u0434\u0438\u0442
      \u0443 \u043E\u043A\u043D\u0430, \u043A\u0430\u043A \u0441\u0438\u0434\u0435\u043B
      \u0432 \u043F\u0435\u0440\u0432\u044B\u0439 \u0434\u0435\u043D\u044C. \xAB\u0422\u044B
      \u043F\u0440\u0438\u0448\u0451\u043B. \u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882607
    m_Localized: "\u0410\u043D\u044C\u0441\u0438 \u0437\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882608
    m_Localized: "\u0421\u0442\u0435\u043D\u044B \u0410\u043D\u044C\u0441\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0437\u0430\u043A\u0430\u0442\u0435. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u043D\u043E\u0432\u0438\u0447\u043A\u043E\u0432 \u0438\u0434\u0451\u0442 \u0441\u0442\u0440\u043E\u0435\u043C
      - \u0443\u0441\u0442\u0430\u0432\u0448\u0438\u0435, \u043D\u043E \u0436\u0438\u0432\u044B\u0435.
      \u0414\u0430\u0440\u0438\u0443\u0448 \u0436\u0434\u0451\u0442 \u043E\u0442\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882609
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882610
    m_Localized: "\u041C\u0435\u0441\u0442\u043D\u044B\u0439 \u0441\u0442\u0430\u0440\u0448\u0438\u043D\u0430
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0443 \u0432\u043E\u0440\u043E\u0442.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0448\u0451\u043B
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882611
    m_Localized: "\u041C\u0435\u0448\u0445\u0435\u0434\u0441\u043A\u0438\u0439 \u0441\u043A\u043B\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882612
    m_Localized: "\u041C\u0435\u0448\u0445\u0435\u0434 \u043F\u0430\u0445\u043D\u0435\u0442
      \u0441\u043A\u0438\u043F\u0438\u0434\u0430\u0440\u043E\u043C \u0438 \u043B\u043E\u0448\u0430\u0434\u0438\u043D\u044B\u043C
      \u043F\u043E\u0442\u043E\u043C. \u0421\u043A\u043B\u0430\u0434 \u0441 \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u043C
      \u0433\u0440\u0443\u0437\u043E\u043C - \u0443 \u044E\u0436\u043D\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442. \u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C
      - \u0440\u043E\u0441\u043B\u044B\u0439 \u043C\u0443\u0436\u0447\u0438\u043D\u0430
      \u0441\u043E \u0448\u0440\u0430\u043C\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882613
    m_Localized: "\u0421\u0434\u0430\u0442\u044C \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882614
    m_Localized: "\u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442
      \u0441\u043E\u0441\u0443\u0434\u044B \u0434\u0432\u0430\u0436\u0434\u044B.
      \u0414\u0430\u0440\u0438\u0443\u0448 \u0441\u0438\u0434\u0438\u0442 \u0432
      \u0443\u0433\u043B\u0443 \u043D\u0430 \u0442\u044E\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882615
    m_Localized: "\u0411\u0430\u0433\u0434\u0430\u0434 \u043D\u0430 \u0437\u0430\u043A\u0430\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882616
    m_Localized: "\u0411\u0430\u0433\u0434\u0430\u0434\u0441\u043A\u0438\u0435 \u043A\u0443\u043F\u043E\u043B\u0430
      \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0435\u043D\u044B \u0437\u0430\u043A\u0430\u0442\u043D\u044B\u043C
      \u0441\u043E\u043B\u043D\u0446\u0435\u043C. \u0414\u0430\u0440\u0438\u0443\u0448
      \u0436\u0434\u0451\u0442 \u0443 \u0414\u043E\u043C\u0430 \u041C\u0443\u0434\u0440\u043E\u0441\u0442\u0438
      - \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u043F\u0440\u0438\u0432\u0430\u043B
      \u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882617
    m_Localized: "\u0418\u0434\u0442\u0438 \u043A \u0414\u0430\u0440\u0438\u0443\u0448\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882618
    m_Localized: "\u0414\u0430\u0440\u0438\u0443\u0448 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0447\u0430\u0448\u0443, \u0443\u0432\u0438\u0434\u0435\u0432 \u0432\u0430\u0441.
      \xAB\u0414\u043E\u0448\u0451\u043B. \u0422\u0435\u043F\u0435\u0440\u044C \u0442\u044B
      \u043B\u0435\u0433\u0435\u043D\u0434\u0430.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882619
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C \u0443\u0442\u0440\u0435\u043D\u043D\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882620
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435
      - \u0441\u0430\u043C\u044B\u0439 \u0448\u0443\u043C\u043D\u044B\u0439 \u0433\u043E\u0440\u043E\u0434
      \u043C\u0438\u0440\u0430. \u041C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F
      \u0427\u044D\u043D\u044F - \u0443\u0437\u043A\u0430\u044F, \u043F\u0440\u043E\u043F\u0430\u0445\u0448\u0430\u044F
      \u0438\u043D\u0434\u0438\u0433\u043E, \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u043E\u043C
      \u043A\u0440\u0430\u044E \u0440\u044B\u043D\u043A\u0430. \u0421\u044B\u0440\u044C\u0451
      \u0432 \u043E\u0431\u043E\u0437\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882621
    m_Localized: "\u0418\u0434\u0442\u0438 \u0432 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882622
    m_Localized: "\u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u0441\u0442\u043E\u0438\u0442
      \u043D\u0430\u0434 \u0447\u0430\u043D\u043E\u043C, \u043D\u0435 \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044F\u0441\u044C.
      \xAB\u0422\u044B \u043F\u0440\u0438\u0448\u0451\u043B. \u041F\u043E\u043B\u043E\u0436\u0438.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882623
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C - \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882624
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C \u043F\u0440\u0438\u0432\u044B\u0447\u0435\u043D.
      \u041D\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F
      \u0427\u044D\u043D\u044C \u0412\u044D\u044F \u0436\u0434\u0451\u0442 \u043E\u0441\u043E\u0431\u044B\u0439
      \u0433\u0440\u0443\u0437 - \u043F\u0443\u0440\u043F\u0443\u0440\u043D\u0443\u044E
      \u0442\u043A\u0430\u043D\u044C \u0434\u043B\u044F \u0438\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0441\u043A\u043E\u0433\u043E
      \u0437\u0430\u043A\u0430\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882625
    m_Localized: "\u041F\u0440\u0438\u043D\u0435\u0441\u0442\u0438 \u0442\u043A\u0430\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882626
    m_Localized: "\u041C\u0430\u0441\u0442\u0435\u0440 \u0431\u0435\u0440\u0435\u0436\u043D\u043E
      \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0440\u0443\u043B\u043E\u043D \u043F\u0443\u0440\u043F\u0443\u0440\u0430 \u0438
      \u0434\u043E\u043B\u0433\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u0446\u0432\u0435\u0442. \xAB\u041B\u0443\u0447\u0448\u0430\u044F \u043F\u0430\u0440\u0442\u0438\u044F,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u044F \u0432\u0438\u0434\u0435\u043B.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882627
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C - \u0444\u0438\u043D\u0430\u043B
      \u043E\u0445\u043E\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882628
    m_Localized: "\u0427\u0430\u043D\u044A\u0430\u043D\u044C \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u0432\u0441\u0435\u0445 \u0441\u043F\u0435\u0446\u0438\u0439
      \u043C\u0438\u0440\u0430. \u0410\u0440\u0445\u0438\u0432 \u0443 \u0418\u043C\u043F\u0435\u0440\u0430\u0442\u043E\u0440\u0441\u043A\u043E\u0433\u043E
      \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0430 - \u0442\u0443\u0434\u0430
      \u043D\u0443\u0436\u043D\u043E \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043F\u044F\u0442\u044B\u0439 \u0430\u0440\u0442\u0435\u0444\u0430\u043A\u0442,
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882629
    m_Localized: "\u0418\u0434\u0442\u0438 \u0432 \u0410\u0440\u0445\u0438\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882630
    m_Localized: "\u0410\u0440\u0445\u0438\u0432\u0430\u0440\u0438\u0443\u0441-\u043A\u0438\u0442\u0430\u0435\u0446
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u0440\u0435\u043B\u0438\u043A\u0432\u0438\u044E
      \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C. \xAB\u0428\u0435\u0441\u0442\u044C\u0441\u043E\u0442
      \u043B\u0435\u0442 \u043F\u0440\u043E\u0448\u043B\u043E \u0441 \u0442\u0435\u0445
      \u043F\u043E\u0440, \u043A\u0430\u043A \u044D\u0442\u043E\u0442 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
      \u043F\u043E\u043A\u0438\u043D\u0443\u043B \u044D\u0442\u0438 \u0441\u0442\u0435\u043D\u044B.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882631
    m_Localized: "\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F \u0434\u0443\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882632
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u0432\u044B\u0432\u043E\u0434\u0438\u0442
      \u0432\u0430\u0441 \u0432 \u0441\u0443\u0445\u043E\u0439 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439
      \u0434\u0432\u043E\u0440 \u0433\u043E\u0440\u043D\u043E\u0433\u043E \u0445\u0440\u0430\u043C\u0430.
      \u0412\u043E\u0437\u0434\u0443\u0445 \u0440\u0430\u0437\u0440\u0435\u0436\u0451\u043D,
      \u043A\u0438\u043F\u0430\u0440\u0438\u0441 \u043D\u0435 \u043A\u0430\u0447\u0430\u0435\u0442\u0441\u044F.
      \xAB\u041F\u0435\u0440\u0435\u0434 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435\u043C
      - \u0442\u0440\u0438 \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F.
      \u0412\u0441\u0435 \u043E\u043D\u0438 - \u0432\u043D\u0443\u0442\u0440\u0438
      \u0442\u0435\u0431\u044F. \u0412\u044B\u0431\u0435\u0440\u0438, \u0447\u0435\u0440\u0435\u0437
      \u0447\u0442\u043E \u0442\u044B \u0432\u043E\u0439\u0434\u0451\u0448\u044C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882633
    m_Localized: "\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435 \u0442\u0438\u0448\u0438\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882634
    m_Localized: "\u0412\u044B \u0441\u0430\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432
      \u0422\u0438\u043D\u043B\u0435\u044F \u0438 \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442\u0435
      \u043D\u0438 \u0441\u043B\u043E\u0432\u0430. \u0427\u0430\u0441, \u0434\u0432\u0430.
      \u0412\u0440\u0435\u043C\u044F \u0442\u0435\u0440\u044F\u0435\u0442 \u043E\u0447\u0435\u0440\u0442\u0430\u043D\u0438\u044F.
      \u041A\u043E\u0433\u0434\u0430 \u0432\u044B \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0435
      \u0433\u043B\u0430\u0437\u0430, \u043C\u043E\u043D\u0430\u0445 \u043A\u0438\u0432\u0430\u0435\u0442:
      \xAB\u0422\u0438\u0448\u0438\u043D\u0430 \u043F\u0440\u0438\u043D\u044F\u043B\u0430
      \u0442\u0435\u0431\u044F. \u0412\u043E\u0439\u0434\u0438 \u0432 \u0445\u0440\u0430\u043C.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882635
    m_Localized: "\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435 \u0441\u0442\u0440\u0430\u0445\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882636
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u0432\u0435\u0434\u0451\u0442
      \u0432\u0430\u0441 \u043A \u0443\u0437\u043A\u043E\u0439 \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0435
      \u043D\u0430\u0434 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C\u044E.
      \u0412\u044B \u0441\u0442\u043E\u0438\u0442\u0435 \u043D\u0430 \u0435\u0451
      \u043A\u0440\u0430\u044E, \u043F\u043E\u043A\u0430 \u0432\u0435\u0442\u0435\u0440
      \u043D\u0435 \u0441\u0442\u0438\u0445\u043D\u0435\u0442. \u041A\u043E\u0433\u0434\u0430
      \u0432\u044B \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0435\u0441\u044C,
      \u043C\u043E\u043D\u0430\u0445 \u0443\u0436\u0435 \u0443 \u0432\u0445\u043E\u0434\u0430
      \u0432 \u0445\u0440\u0430\u043C. \xAB\u0421\u0442\u0440\u0430\u0445 \u043F\u0440\u043E\u0439\u0434\u0435\u043D.
      \u0412\u043E\u0439\u0434\u0438.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882637
    m_Localized: "\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435 \u0432\u044B\u0431\u043E\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 31384431506882638
    m_Localized: "\u0422\u0438\u043D\u043B\u0435\u0439 \u043A\u043B\u0430\u0434\u0451\u0442
      \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438 \u0434\u0432\u0435
      \u0447\u0430\u0448\u0438: \u043E\u0434\u043D\u0430 \u0441 \u0432\u043E\u0434\u043E\u0439,
      \u0434\u0440\u0443\u0433\u0430\u044F \u043F\u0443\u0441\u0442\u0430. \xAB\u0412\u044B\u0431\u0435\u0440\u0438
      \u043E\u0434\u043D\u0443, \u043E\u0442\u0434\u0430\u0439 \u0434\u0440\u0443\u0433\u043E\u043C\u0443.\xBB
      \u0412\u044B \u043E\u0442\u0434\u0430\u0451\u0442\u0435 \u043F\u043E\u043B\u043D\u0443\u044E
      \u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442\u0435 \u043F\u0443\u0441\u0442\u0443\u044E
      \u0441\u0435\u0431\u0435. \u0422\u0438\u043D\u043B\u0435\u0439 \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F.
      \xAB\u0421\u0434\u0435\u043B\u0430\u043D\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440
      \u0432\u0438\u0434\u0435\u043D \u0432 \u043A\u0430\u0436\u0434\u043E\u043C
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C. \u0412\u043E\u0439\u0434\u0438.\xBB"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289529409536
    m_Localized: "\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434 \u043D\u0430
      \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546880
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0434\u043E\u043B\u0433\u0438\u0445
      \u043D\u0435\u0434\u0435\u043B\u044C \u043F\u0443\u0442\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0433\u043E\u043B\u0443\u0431\u044B\u0435 \u043A\u0443\u043F\u043E\u043B\u0430
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u0439
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438 \u0412\u0430\u0445\u0443-\u041C\u0430\u043D\u0430
      - \u0443 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445 \u0432\u043E\u0440\u043E\u0442.
      \u0422\u044E\u043A\u0438 \u0448\u0451\u043B\u043A\u0430 \u0446\u0435\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546881
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546882
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0447\u0435\u0440\u0435\u0437 \u0432\u043E\u0440\u043E\u0442\u0430. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438
      \u0441\u0430\u043B\u044E\u0442\u0443\u044E\u0442 \u0433\u0440\u0430\u043C\u043E\u0442\u0435
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438. \u0414\u0430\u043B\u044C\u0448\u0435
      - \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u0439
      \u0412\u0430\u0445\u0443-\u041C\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546883
    m_Localized: "\u0414\u0443\u043D \u0412\u044D\u0439 - \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043F\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546884
    m_Localized: "\u0412 \u0413\u0438\u043B\u044C\u0434\u0438\u0438 \u043F\u0430\u0445\u043D\u0435\u0442
      \u0442\u0443\u0448\u044C\u044E \u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u043C
      \u043E\u0447\u0430\u0433\u043E\u043C. \u041F\u043E\u0436\u0438\u043B\u043E\u0439
      \u043F\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0439 \u0414\u0443\u043D
      \u0412\u044D\u0439 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0441\u0432\u0438\u0442\u043E\u043A \u043D\u0430 \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0435
      - \u043F\u043E\u0436\u0435\u043B\u0442\u0435\u0432\u0448\u0438\u0439, \u0441
      \u043E\u0442\u043F\u0435\u0447\u0430\u0442\u043A\u043E\u043C \u043A\u0440\u0430\u0441\u043D\u043E\u0439
      \u043F\u0435\u0447\u0430\u0442\u0438 \u043F\u043E\u043F\u0435\u0440\u0451\u043A
      \u0442\u0435\u043A\u0441\u0442\u0430. \u0415\u0433\u043E \u0433\u043E\u043B\u043E\u0441
      \u0442\u0438\u0445: \"\u0422\u0440\u0438 \u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u041B\u0443 \u0426\u0437\u044F\u043D\u044C
      \u0437\u0430\u043D\u0451\u0441 \u0432\u0430\u0448\u0443 \u0441\u0435\u043C\u044C\u044E
      \u0432 \u0441\u043F\u0438\u0441\u043E\u043A \u043F\u043E\u0441\u043E\u0431\u043D\u0438\u043A\u043E\u0432
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0438\u044F. \u0421\u043A\u043B\u0430\u0434
      \u043E\u043F\u0435\u0447\u0430\u0442\u0430\u043D, \u0434\u043E\u0431\u0440\u043E\u0435
      \u0438\u043C\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E. \u042F
      \u0441\u043B\u0443\u0436\u0438\u043B \u0432\u0430\u0448\u0435\u043C\u0443 \u043E\u0442\u0446\u0443
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442 - \u044F
      \u0437\u043D\u0430\u044E, \u0433\u0434\u0435 \u0438\u0441\u043A\u0430\u0442\u044C
      \u043B\u044E\u0434\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043F\u043E\u043C\u043D\u044F\u0442 \u043F\u0440\u0430\u0432\u0434\u0443.\"
      \u0413\u0443\u0430\u043D\u044C\u0434\u0438\u0435, \u0432\u044B\u0434\u0430\u043D\u043D\u044B\u0439
      \u0432\u0430\u0448\u0435\u0439 \u0441\u0435\u043C\u044C\u0435, \u043B\u0435\u0436\u0438\u0442
      \u0440\u044F\u0434\u043E\u043C - \u0432 \u043D\u0451\u043C \u043F\u0440\u043E\u043F\u0443\u0449\u0435\u043D\u0430
      \u043E\u0434\u043D\u0430 \u0441\u0442\u0440\u043E\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u043B\u043E
      \u0431\u044B\u0442\u044C. \u0421\u043E\u0433\u0434\u0438\u0439\u0446\u044B
      \u043D\u0435 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043B\u0438 \u0410\u043D\u044C
      \u041B\u0443\u0448\u0430\u043D\u044F, \u043D\u043E \u0441\u0442\u0440\u0430\u0445
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u043E\u0432 \u0441\u0438\u043B\u044C\u043D\u0435\u0435
      \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546885
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546886
    m_Localized: "\u0414\u0443\u043D \u0412\u044D\u0439 \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
      \u0438\u043C\u0435\u043D\u0430 \u0442\u0440\u043E\u0438\u0445 \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u043E\u0432
      \u043E\u0442\u0446\u0430 - \u043E\u043D\u0438 \u0435\u0449\u0451 \u0436\u0438\u0432\u0443\u0442
      \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u0438, \u0442\u043E\u0440\u0433\u0443\u044E\u0442
      \u0448\u0451\u043B\u043A\u043E\u043C \u0438 \u0431\u0443\u043C\u0430\u0433\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546887
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F -
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043E\u043F\u0430\u0441\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546888
    m_Localized: "\u0414\u0443\u043D \u0412\u044D\u0439 \u043A\u0438\u0432\u0430\u0435\u0442
      \u0431\u0435\u0437 \u043E\u0441\u0443\u0436\u0434\u0435\u043D\u0438\u044F \u0438
      \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0441\u0432\u0438\u0442\u043E\u043A.
      \u041F\u0440\u043E\u0448\u043B\u043E\u0435 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043D\u0435\u0442\u0440\u043E\u043D\u0443\u0442\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546889
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546890
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546891
    m_Localized: "\u0422\u0440\u043E\u0435 \u043A\u0443\u043F\u0446\u043E\u0432 \u0441\u0442\u0430\u0432\u044F\u0442
      \u043E\u0442\u043F\u0435\u0447\u0430\u0442\u043A\u0438 \u043F\u0430\u043B\u044C\u0446\u0435\u0432
      \u043F\u043E\u0434 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F\u043C\u0438.
      \u0411\u0443\u043C\u0430\u0433\u0430 \u0441 \u0438\u043C\u0435\u043D\u0430\u043C\u0438
      \u0442\u0435\u043F\u0435\u0440\u044C \u0443 \u0432\u0430\u0441 - \u043F\u0435\u0440\u0432\u0430\u044F
      \u043D\u0438\u0442\u044C \u043A \u0440\u0435\u0430\u0431\u0438\u043B\u0438\u0442\u0430\u0446\u0438\u0438
      \u0441\u0435\u043C\u044C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546892
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F \u0441\u043E\u0431\u0440\u0430\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546893
    m_Localized: "\u0421\u0432\u0438\u0442\u043A\u0438 \u0441 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F\u043C\u0438
      \u043B\u0435\u0436\u0430\u0442 \u0432 \u043A\u043E\u0436\u0430\u043D\u043E\u043C
      \u0444\u0443\u0442\u043B\u044F\u0440\u0435. \u041A\u0430\u0436\u0434\u044B\u0439
      \u0438\u0437 \u0442\u0440\u0451\u0445 \u043A\u0443\u043F\u0446\u043E\u0432
      \u043E\u043F\u0438\u0441\u0430\u043B \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0435
      \u0441\u0434\u0435\u043B\u043A\u0438 \u0441 \u0432\u0430\u0448\u0438\u043C
      \u043E\u0442\u0446\u043E\u043C: \u0434\u0430\u0442\u044B, \u0442\u043E\u0432\u0430\u0440\u044B,
      \u0441\u0443\u043C\u043C\u044B \u043A\u0430\u0439\u044E\u0430\u043D\u044C \u0442\u0443\u043D\u0431\u0430\u043E.
      \u041D\u0438 \u043E\u0434\u0438\u043D \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442
      \u043D\u0435 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442 \u0438\u043C\u044F
      \u0410\u043D\u044C \u041B\u0443\u0448\u0430\u043D\u044F \u0438\u043B\u0438
      \u0435\u0433\u043E \u043B\u044E\u0434\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546894
    m_Localized: "\u041F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
      \u0414\u0443\u043D \u0412\u044D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546895
    m_Localized: "\u041F\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0439 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0441\u0432\u0438\u0442\u043A\u0438 \u0434\u0432\u0443\u043C\u044F \u0440\u0443\u043A\u0430\u043C\u0438
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0448\u0430\u0433 - \u0430\u0440\u0445\u0438\u0432\u044B \u041B\u0443\u043E\u044F\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546896
    m_Localized: "\u0411\u0438\u043B\u044C\u0433\u044D - \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A
      \u0437\u0430\u0441\u0442\u0430\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546897
    m_Localized: "\u0412 \u043A\u0430\u0437\u0430\u0440\u043C\u0430\u0445 \u041B\u0430\u043D\u044C\u0447\u0436\u043E\u0443
      \u043F\u0430\u0445\u043D\u0435\u0442 \u043A\u043E\u0436\u0430\u043D\u043E\u0439
      \u0441\u0431\u0440\u0443\u0435\u0439 \u0438 \u0432\u0430\u0440\u0451\u043D\u044B\u043C
      \u043F\u0440\u043E\u0441\u043E\u043C. \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A
      \u0437\u0430\u0441\u0442\u0430\u0432\u044B \u0411\u0438\u043B\u044C\u0433\u044D
      - \u0433\u0440\u0443\u0437\u043D\u044B\u0439 \u0442\u044E\u0440\u043A \u0441
      \u0441\u0435\u0434\u044B\u043C\u0438 \u0443\u0441\u0430\u043C\u0438 - \u043B\u0438\u0441\u0442\u0430\u0435\u0442
      \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u044B\u0439 \u0436\u0443\u0440\u043D\u0430\u043B
      \u043F\u0440\u043E\u0445\u043E\u0434\u0430 \u0437\u0430 \u043B\u0435\u0442\u043D\u0438\u0435
      \u043C\u0435\u0441\u044F\u0446\u044B 768 \u0433\u043E\u0434\u0430. \u041E\u043D
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0438\u0441\u043B\u043E\u0432\u0438\u0439:
      \"\u0422\u0435\u043C \u043B\u0435\u0442\u043E\u043C \u0447\u0435\u0440\u0435\u0437
      \u043F\u043E\u0441\u0442 \u043F\u0440\u043E\u0448\u043B\u043E \u0441\u0435\u043C\u044C
      \u043C\u0430\u043B\u044B\u0445 \u0433\u0440\u0443\u043F\u043F. \u0417\u0430\u043F\u0438\u0441\u044C
      \u043E \u0442\u044E\u0440\u043A\u0435 \u0441 \u0442\u0440\u0435\u043C\u044F
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430\u043C\u0438 \u0435\u0441\u0442\u044C.
      \u0414\u0430\u0442\u0430 - \u0441\u0435\u043C\u043D\u0430\u0434\u0446\u0430\u0442\u044B\u0439
      \u0434\u0435\u043D\u044C \u0448\u0435\u0441\u0442\u043E\u0439 \u043B\u0443\u043D\u044B.
      \u041E\u043D\u0438 \u0448\u043B\u0438 \u043D\u0430 \u0437\u0430\u043A\u0430\u0442
      \u0438 \u043D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0438\u0441\u044C.\"
      \u0416\u0443\u0440\u043D\u0430\u043B \u043B\u0435\u0436\u0438\u0442 \u043F\u0435\u0440\u0435\u0434
      \u0432\u0430\u043C\u0438. \u0421\u0442\u0440\u043E\u0447\u043A\u0430 \u0441\u0443\u0445\u0430\u044F,
      \u0431\u0435\u0437 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439,
      \u043D\u043E \u0438\u043C\u044F \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u043E:
      \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D. \u0425\u044D\u0441\u0438-\u043A\u043E\u0440\u0438\u0434\u043E\u0440
      \u0432 \u0442\u043E \u043B\u0435\u0442\u043E \u0434\u0435\u0440\u0436\u0430\u043B\u0438
      \u0442\u0438\u0431\u0435\u0442\u0446\u044B \u043D\u0430 \u0437\u0430\u043F\u0430\u0434\u0435
      \u0438 \u043E\u0442\u0440\u044F\u0434\u044B \u0410\u043D\u044C \u041B\u0443\u0448\u0430\u043D\u044F
      \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A\u0435 - \u041A\u044E\u043B\u044C
      \u0432\u044B\u0431\u0440\u0430\u043B \u043F\u043B\u043E\u0445\u043E\u0435 \u0432\u0440\u0435\u043C\u044F
      \u0434\u043B\u044F \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546898
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546899
    m_Localized: "\u0411\u0438\u043B\u044C\u0433\u044D \u0441\u0442\u0430\u0432\u0438\u0442
      \u043F\u0435\u0447\u0430\u0442\u044C \u043D\u0430 \u043A\u043E\u043F\u0438\u044E
      \u0437\u0430\u043F\u0438\u0441\u0438 - \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435
      \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435 \u0434\u043B\u044F \u0440\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u043E\u0432
      \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546900
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u0440\u043E\u0448\u043B\u043E\u0435
      \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546901
    m_Localized: "\u0416\u0443\u0440\u043D\u0430\u043B \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F.
      \u0418\u043C\u044F \u041A\u044E\u043B\u044F \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0432 \u043E\u0434\u043D\u043E\u0439 \u0441\u0442\u0440\u043E\u043A\u0435
      \u0437\u0430 768 \u0433\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546902
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546903
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F
      \u0438 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546904
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0438\u043C\u044F \u0445\u043E\u0437\u044F\u0438\u043D\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430 \u0432 \u042E\u0439\u043C\u044D\u043D\u0435
      - \u0442\u043E\u0442 \u043C\u043E\u0433 \u0432\u0438\u0434\u0435\u0442\u044C
      \u041A\u044E\u043B\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546905
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0441\u043B\u0435\u0434 \u043D\u0430\u0439\u0434\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546906
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0427\u044D\u043D\u044C
      \u043F\u043E\u043C\u043D\u0438\u0442 \u0442\u044E\u0440\u043A\u0430 \u0432
      \u0441\u0435\u0440\u043E\u0439 \u0432\u043E\u0439\u043B\u043E\u0447\u043D\u043E\u0439
      \u0448\u0430\u043F\u043A\u0435 \u0441 \u0442\u0440\u0435\u043C\u044F \u0433\u0440\u0443\u0436\u0451\u043D\u044B\u043C\u0438
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430\u043C\u0438. \u0422\u043E\u0442
      \u0441\u043F\u0440\u043E\u0441\u0438\u043B \u0434\u043E\u0440\u043E\u0433\u0443
      \u043D\u0430 \u042E\u0439\u043C\u044D\u043D\u044C \u0438 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B
      \u0437\u0430 \u043D\u043E\u0447\u043B\u0435\u0433 \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0439
      \u043C\u043E\u043D\u0435\u0442\u043E\u0439 - \u043D\u0435 \u043A\u0430\u0439\u044E\u0430\u043D\u044C
      \u0442\u0443\u043D\u0431\u0430\u043E, \u0430 \u0441\u0442\u0430\u0440\u043E\u0439
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0439. \u042D\u0442\u043E
      \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546907
    m_Localized: "\u0418\u0434\u0442\u0438 \u0432 \u042E\u0439\u043C\u044D\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546908
    m_Localized: "\u041F\u0443\u0442\u044C \u043D\u0430 \u0437\u0430\u043F\u0430\u0434
      \u043E\u0442\u043A\u0440\u044B\u0442. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u0439
      \u0432 \u042E\u0439\u043C\u044D\u043D\u0435 - \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
      \u0442\u043E\u0447\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546909
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 - \u0430\u0440\u0445\u0438\u0432\u043D\u044B\u0439
      \u043F\u0438\u0441\u0430\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546910
    m_Localized: "\u0412 \u0430\u0440\u0445\u0438\u0432\u0435 \u0426\u0437\u044E\u0446\u044E\u0430\u043D\u044F
      \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u043E \u0438 \u0442\u0435\u043C\u043D\u043E.
      \u041F\u0438\u0441\u0430\u0440\u044C \u0421\u0430\u043C\u0435\u0445 - \u0445\u0443\u0434\u043E\u0439
      \u0441\u043E\u0433\u0434\u0438\u0435\u0446 \u0441 \u0447\u0435\u0440\u043D\u0438\u043B\u044C\u043D\u044B\u043C\u0438
      \u043F\u044F\u0442\u043D\u0430\u043C\u0438 \u043D\u0430 \u043F\u0440\u0430\u0432\u043E\u0439
      \u0440\u0443\u043A\u0435 - \u0440\u0430\u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438 \u0434\u043E\u043D\u0435\u0441\u0435\u043D\u0438\u044F
      \u043E \u043F\u043E\u0436\u0430\u0440\u0430\u0445 \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u043F\u044F\u0442\u044C \u043B\u0435\u0442. \u0417\u0430\u043F\u0430\u0445
      \u0441\u044B\u0440\u043E\u0439 \u0433\u043B\u0438\u043D\u044F\u043D\u043E\u0439
      \u0448\u0442\u0443\u043A\u0430\u0442\u0443\u0440\u043A\u0438 \u0441\u043C\u0435\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441 \u0433\u043E\u0440\u044C\u043A\u0438\u043C \u043B\u0430\u0434\u0430\u043D\u043E\u043C
      \u0438\u0437 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u044B.
      \u0421\u0430\u043C\u0435\u0445 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E:
      \"\u041F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0439 \u0434\u0432\u043E\u0440
      \u0420\u0443\u0441\u0442\u0430\u043C\u0430 \u0441\u0433\u043E\u0440\u0435\u043B
      \u0442\u0440\u0438 \u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434.
      \u0414\u0432\u043E\u0435 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044C\u0446\u0435\u0432
      \u043D\u0435 \u0432\u044B\u0448\u043B\u0438. \u041C\u0435\u0441\u0442\u043D\u0430\u044F
      \u0441\u0442\u0440\u0430\u0436\u0430 \u0437\u0430\u043A\u0440\u044B\u043B\u0430
      \u0434\u0435\u043B\u043E \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0435
      \u043D\u0435\u0434\u0435\u043B\u0438 - \u043F\u043E\u0436\u0430\u0440 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B\u0438
      \u043D\u0435\u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E.
      \u041D\u043E \u0443 \u0420\u0443\u0441\u0442\u0430\u043C\u0430 \u0431\u044B\u043B
      \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442: \u0442\u044E\u0440\u043A-\u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u043F\u043E \u0438\u043C\u0435\u043D\u0438 \u0422\u0435\u0433\u0438\u043D,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u0442\u043A\u0440\u044B\u043B
      \u0441\u0432\u043E\u0439 \u0434\u0432\u043E\u0440 \u0447\u0435\u0440\u0435\u0437
      \u043C\u0435\u0441\u044F\u0446 \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u0436\u0430\u0440\u0430.\"
      \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B \u043E\u0431 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0438
      \u0434\u0432\u043E\u0440\u0430 \u0422\u0435\u0433\u0438\u043D\u0430 \u043B\u0435\u0436\u0430\u0442
      \u0440\u044F\u0434\u043E\u043C \u0441 \u0434\u0435\u043B\u043E\u043C \u043E
      \u043F\u043E\u0436\u0430\u0440\u0435. \u0414\u0430\u0442\u044B \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u044E\u0442
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0440\u043E\u0432\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546911
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u0432\u044B\u0436\u0438\u0432\u0448\u0435\u0433\u043E
      \u0441\u043B\u0443\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546912
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043A\u0432\u0430\u0440\u0442\u0430\u043B, \u0433\u0434\u0435 \u0432\u0438\u0434\u0435\u043B\u0438
      \u0441\u043B\u0443\u0433\u0443 \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C
      \u0433\u043E\u0434\u0443 - \u0440\u044B\u043D\u043E\u043A \u043A\u0440\u0430\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u043E\u0432
      \u0443 \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0445 \u0432\u043E\u0440\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546913
    m_Localized: "\u041D\u0435 \u0432\u043C\u0435\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0447\u0443\u0436\u043E\u0435 \u0434\u0435\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546914
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u043A\u0438\u0432\u0430\u0435\u0442
      \u0438 \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0434\u043E\u043D\u0435\u0441\u0435\u043D\u0438\u044F.
      \u041F\u043E\u0436\u0430\u0440 \u0442\u0440\u0451\u0445\u043B\u0435\u0442\u043D\u0435\u0439
      \u0434\u0430\u0432\u043D\u043E\u0441\u0442\u0438 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0431\u0435\u0437 \u043E\u0442\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546915
    m_Localized: "\u0421\u043B\u0443\u0433\u0430 \u043D\u0430 \u0440\u044B\u043D\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546916
    m_Localized: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E \u043F\u043E\u0434\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546917
    m_Localized: "\u0421\u043B\u0443\u0433\u0430 \u043F\u044F\u0442\u0438\u0442\u0441\u044F,
      \u043D\u043E \u0435\u0433\u043E \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0438\u043C\u044F \u0420\u0443\u0441\u0442\u0430\u043C\u0430 - \u043E\u043D
      \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0441\u044F \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0432 \u0443\u043A\u0440\u043E\u043C\u043D\u043E\u043C \u0443\u0433\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546918
    m_Localized: "\u0420\u0430\u0441\u0441\u043A\u0430\u0437 \u043E\u0447\u0435\u0432\u0438\u0434\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546919
    m_Localized: "\u0421\u043B\u0443\u0433\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0431\u044B\u0441\u0442\u0440\u043E, \u043D\u0435 \u0433\u043B\u044F\u0434\u044F
      \u0432 \u0433\u043B\u0430\u0437\u0430. \u0412 \u0442\u0443 \u043D\u043E\u0447\u044C
      \u043E\u043D \u0432\u044B\u0448\u0435\u043B \u0437\u0430 \u0432\u043E\u0434\u043E\u0439
      \u0438 \u0443\u0432\u0438\u0434\u0435\u043B \u0444\u0438\u0433\u0443\u0440\u0443
      \u0443 \u044E\u0436\u043D\u043E\u0439 \u0441\u0442\u0435\u043D\u044B \u0441
      \u0433\u043E\u0440\u0448\u043A\u043E\u043C \u043C\u0430\u0441\u043B\u0430.
      \u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0439 \u0433\u043E\u0432\u043E\u0440,
      \u0448\u0440\u0430\u043C \u043D\u0430 \u0448\u0435\u0435. \u041A\u043E\u0433\u0434\u0430
      \u0432\u0441\u043F\u044B\u0445\u043D\u0443\u043B \u043E\u0433\u043E\u043D\u044C,
      \u0444\u0438\u0433\u0443\u0440\u0430 \u0443\u0448\u043B\u0430 \u043F\u0435\u0448\u043A\u043E\u043C
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0433\u043E
      \u0442\u0440\u0430\u043A\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546920
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F
      \u0438 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u043D\u0430
      \u0425\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546921
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u044B.
      \u0421\u0435\u0432\u0435\u0440\u043D\u044B\u0439 \u0442\u0440\u0430\u043A\u0442
      \u0432\u0435\u0434\u0451\u0442 \u0447\u0435\u0440\u0435\u0437 \u042E\u0439\u043C\u044D\u043D\u044C
      \u043F\u0440\u044F\u043C\u043E \u043A \u0425\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546922
    m_Localized: "\u0427\u0436\u044D\u043D \u0412\u044D\u0439 - \u0442\u0430\u043D
      \u0425\u0430\u043D\u0447\u0436\u043E\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546923
    m_Localized: "\u0417\u0430\u043B \u043F\u0440\u0438\u0451\u043C\u043E\u0432 \u0442\u0430\u043D\u0430
      \u043F\u0430\u0445\u043D\u0435\u0442 \u043B\u0430\u043A\u043E\u043C \u0438
      \u0446\u0432\u0435\u0442\u0443\u0449\u0435\u0439 \u0441\u043B\u0438\u0432\u043E\u0439
      \u0447\u0435\u0440\u0435\u0437 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0439
      \u0441\u0442\u0430\u0432\u0435\u043D\u044C. \u0427\u0436\u044D\u043D \u0412\u044D\u0439
      - \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0441\u0440\u0435\u0434\u043D\u0438\u0445
      \u043B\u0435\u0442 \u0441 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E\u0439
      \u0447\u0451\u0440\u043D\u043E\u0439 \u0431\u043E\u0440\u043E\u0434\u043E\u0439
      - \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0438\u0441\u043B\u043E\u0432\u0438\u0439,
      \u043F\u043E\u043A\u0430 \u0441\u0435\u043A\u0440\u0435\u0442\u0430\u0440\u044C
      \u0441\u0442\u043E\u0438\u0442 \u0443 \u0434\u0432\u0435\u0440\u0438 \u0441
      \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438.
      \u041F\u0438\u0441\u044C\u043C\u043E \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u043E
      \u0432 \u0434\u0432\u043E\u0439\u043D\u043E\u0439 \u0448\u0451\u043B\u043A\u043E\u0432\u044B\u0439
      \u043A\u043E\u043D\u0432\u0435\u0440\u0442, \u043E\u0431\u0451\u0440\u043D\u0443\u0442\u044B\u0439
      \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D\u043D\u044B\u043C \u0432\u043E\u0441\u043A\u043E\u043C
      \u0445\u043E\u043B\u0441\u0442\u043E\u043C. \u0422\u0430\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442:
      \"\u0422\u0430\u043D \u0425\u044D \u0411\u0438\u043D\u044C \u0432 \u0421\u0438\u0430\u043D\u0438
      \u0436\u0434\u0451\u0442 \u044D\u0442\u043E\u0433\u043E \u043F\u0438\u0441\u044C\u043C\u0430.
      \u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0435 \u043F\u043E\u0441\u0442\u044B
      \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u043B\u0438 \u0413\u0430\u043D\u044C\u0441\u0443\u0439\u0441\u043A\u0438\u0439
      \u043A\u043E\u0440\u0438\u0434\u043E\u0440 \u0441 \u043F\u0440\u043E\u0448\u043B\u043E\u0439
      \u043E\u0441\u0435\u043D\u0438 - \u0433\u043E\u043D\u0435\u0446 \u043D\u0435
      \u0434\u043E\u0431\u0435\u0440\u0451\u0442\u0441\u044F. \u0412\u044B \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u0443 \u0432\u0430\u0441 \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u0430\u044F.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0431\u0443\u0434\u0435\u0442
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435
      \u0432\u044C\u044E\u043A\u0430 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0435\u0441\u043B\u0438 \u0432\u044B \u0437\u043D\u0430\u0435\u0442\u0435,
      \u0447\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C.\" \u042D\u0442\u043E
      \u043D\u0435 \u043F\u0440\u043E\u0441\u044C\u0431\u0430. \u0422\u0430\u043D
      \u043D\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442, \u0447\u0442\u043E
      \u0432 \u043F\u0438\u0441\u044C\u043C\u0435. \u0421\u0430\u043A\u043A \u043D\u0430
      \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435 \u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0445
      \u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432 \u0443\u0436\u0435 \u043B\u0435\u0436\u0438\u0442
      \u043D\u0430 \u0441\u0442\u043E\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546924
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546925
    m_Localized: "\u0422\u0430\u043D \u043B\u0438\u0447\u043D\u043E \u0441\u0442\u0430\u0432\u0438\u0442
      \u043F\u0435\u0447\u0430\u0442\u044C \u043D\u0430 \u0432\u0430\u0448 \u0433\u0443\u0430\u043D\u044C\u0434\u0438\u0435
      - \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0437\u043D\u0430\u043A \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546926
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F -
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546927
    m_Localized: "\u0422\u0430\u043D \u043A\u043E\u0440\u043E\u0442\u043A\u043E \u043A\u0438\u0432\u0430\u0435\u0442
      \u0438 \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0441\u0430\u043A\u043A
      \u0441\u043E \u0441\u0442\u043E\u043B\u0430. \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435
      \u0438\u0437 \u0437\u0430\u043B\u0430 \u043D\u0435 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546928
    m_Localized: "\u0427\u0430\u0441\u0442\u0438\u0447\u043D\u0430\u044F \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546929
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u0442\u044C
      \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546930
    m_Localized: "\u0421\u043E\u0433\u0434\u0438\u0435\u0446 \u043A\u0430\u0447\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439 - \u0434\u0430\u043B\u044C\u0448\u0435
      \u0438\u0434\u0443\u0442 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u0435
      \u0437\u043D\u0430\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043E\u043D \u043D\u0435 \u0437\u043D\u0430\u0435\u0442. \u0427\u0430\u0441\u0442\u044C
      \u043A\u043E\u0434\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0430: \u0440\u0435\u0447\u044C
      \u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0438 \u0432\u043E\u0439\u0441\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546931
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u0432 \u0440\u0443\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546932
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u043D\u0430\u0434\u0451\u0436\u043D\u043E
      \u0441\u043F\u0440\u044F\u0442\u0430\u043D\u043E \u0432 \u0434\u0432\u043E\u0439\u043D\u043E\u043C
      \u0434\u043D\u0435 \u0432\u044C\u044E\u043A\u0430 \u0441 \u0442\u043A\u0430\u043D\u044F\u043C\u0438.
      \u0421\u043E\u0433\u0434\u0438\u0435\u0446 \u0443\u0441\u043F\u0435\u043B \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u0440\u043E\u043A:
      \u0446\u0438\u0444\u0440\u044B, \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F
      \u0437\u0430\u0441\u0442\u0430\u0432, \u0438\u043C\u0435\u043D\u0430 \u0434\u0432\u0443\u0445
      \u0433\u0435\u043D\u0435\u0440\u0430\u043B\u043E\u0432. \u0412\u044B \u043D\u0435
      \u0437\u043D\u0430\u0435\u0442\u0435, \u0447\u044C\u0438 \u044D\u0442\u043E
      \u0432\u043E\u0439\u0441\u043A\u0430 - \u0442\u0430\u043D\u0441\u043A\u0438\u0435
      \u0438\u043B\u0438 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0435.
      \u0412\u0430\u0436\u043D\u043E, \u0447\u0442\u043E \u0442\u0430\u043D \u0425\u044D
      \u0411\u0438\u043D\u044C \u0436\u0434\u0451\u0442 \u044D\u0442\u0438\u0445
      \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546933
    m_Localized: "\u0412\u044B\u0434\u0432\u0438\u043D\u0443\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0437\u0430\u043F\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546934
    m_Localized: "\u041C\u0430\u0440\u0448\u0440\u0443\u0442 \u0447\u0435\u0440\u0435\u0437
      \u0433\u043E\u0440\u043D\u044B\u0435 \u0442\u0440\u043E\u043F\u044B \u0434\u043B\u0438\u043D\u043D\u0435\u0435,
      \u0437\u0430\u0442\u043E \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0445
      \u043F\u043E\u0441\u0442\u043E\u0432 \u043C\u0435\u043D\u044C\u0448\u0435.
      \u0412\u044B \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546935
    m_Localized: "\u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u0438\u0431\u043D
      \u042E\u0441\u0443\u0444"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546936
    m_Localized: "\u041E\u043D \u0436\u0434\u0451\u0442 \u0432\u0430\u0441 \u0432
      \u0442\u0435\u043D\u0438 \u043D\u0430\u0432\u0435\u0441\u0430 \u043D\u0430\u0434
      \u043B\u043E\u0442\u043A\u0430\u043C\u0438 \u0441 \u0438\u043C\u0431\u0438\u0440\u0451\u043C
      - \u0437\u0430\u043F\u0430\u0445 \u0441\u043F\u0435\u0446\u0438\u0439 \u0433\u0443\u0441\u0442\u043E\u0439
      \u0438 \u043F\u0440\u0438\u0442\u043E\u0440\u043D\u044B\u0439 \u0432 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u043C
      \u0432\u043E\u0437\u0434\u0443\u0445\u0435 \u0426\u044E\u0430\u043D\u044C\u0447\u0436\u043E\u0443.
      \u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u043D\u0435 \u043F\u043E\u0441\u0442\u0430\u0440\u0435\u043B:
      \u0442\u0435 \u0436\u0435 \u0448\u0438\u0440\u043E\u043A\u0438\u0435 \u043F\u043B\u0435\u0447\u0438,
      \u0442\u0430 \u0436\u0435 \u0437\u043E\u043B\u043E\u0442\u0430\u044F \u0441\u0435\u0440\u044C\u0433\u0430
      \u0432 \u043B\u0435\u0432\u043E\u043C \u0443\u0445\u0435. \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043F\u043E-\u0430\u0440\u0430\u0431\u0441\u043A\u0438, \u0442\u0438\u0445\u043E
      \u0438 \u0440\u043E\u0432\u043D\u043E: \"\u041F\u044F\u0442\u044C \u043B\u0435\u0442
      \u043D\u0430\u0437\u0430\u0434 \u043C\u044B \u043F\u0440\u043E\u0432\u0435\u0437\u043B\u0438
      \u043C\u0443\u0441\u043A\u0443\u0441 \u0447\u0435\u0440\u0435\u0437 \u0442\u0430\u043C\u043E\u0436\u043D\u044E
      \u0426\u044E\u0430\u043D\u044C\u0447\u0436\u043E\u0443. \u0422\u044B \u0432\u0437\u044F\u043B
      \u0434\u0432\u0435 \u0442\u0440\u0435\u0442\u0438, \u044F \u043E\u0434\u043D\u0443.
      \u0421\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E \u043B\u0438
      \u044D\u0442\u043E \u0431\u044B\u043B\u043E?\" \u041E\u043D \u043D\u0435 \u0443\u0433\u0440\u043E\u0436\u0430\u0435\u0442
      \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E. \u041F\u0440\u043E\u0441\u0442\u043E
      \u043A\u043B\u0430\u0434\u0451\u0442 \u043D\u0430 \u043B\u043E\u0442\u043E\u043A
      \u043B\u0438\u0441\u0442\u043E\u043A \u0441 \u0446\u0438\u0444\u0440\u043E\u0439
      - \u0434\u0432\u0435\u0441\u0442\u0438 \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C. \u0422\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u044B\u0439
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u0424\u0443 \u041B\u044F\u043D
      \u0437\u043D\u0430\u0435\u0442 \u0410\u0431\u0443 \u0411\u0430\u043A\u0440\u0430
      \u043B\u0438\u0447\u043D\u043E: \u043E\u043D\u0438 \u0437\u0435\u043C\u043B\u044F\u043A\u0438,
      \u043E\u0431\u0430 \u0438\u0437 \u0411\u0430\u0441\u0440\u044B. \u0415\u0441\u043B\u0438
      \u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u0443 \u0432\u0430\u0441 \u043D\u0430\u0447\u043D\u0443\u0442\u0441\u044F
      \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u043E \u043F\u0440\u043E\u0448\u043B\u044B\u0445
      \u0433\u0440\u0443\u0437\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546937
    m_Localized: "\u0412\u044B\u0441\u043B\u0443\u0448\u0430\u0442\u044C \u0438 \u043E\u0431\u0434\u0443\u043C\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546938
    m_Localized: "\u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u0434\u0430\u0451\u0442
      \u0441\u0435\u043C\u044C \u0434\u043D\u0435\u0439. \u041E\u043D \u0443\u0445\u043E\u0434\u0438\u0442
      \u043D\u0435 \u043F\u0440\u043E\u0449\u0430\u044F\u0441\u044C, \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044F\u044F\u0441\u044C
      \u0432 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u0439 \u0442\u043E\u043B\u043F\u0435
      \u0440\u044B\u043D\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546939
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u0441\u0440\u0430\u0437\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546940
    m_Localized: "\u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u0447\u0442\u043E \u0441\u0435\u043C\u044C \u0434\u043D\u0435\u0439 \u0432\u0441\u0451
      \u0440\u0430\u0432\u043D\u043E \u0435\u0441\u0442\u044C. \u041E\u043D \u0443\u0445\u043E\u0434\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546941
    m_Localized: "\u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u043E\u0437\u0432\u0443\u0447\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546942
    m_Localized: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546943
    m_Localized: "\u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0438\u043C\u044F \u043C\u0435\u043D\u044F\u043B\u044B \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443
      - \u0442\u0430\u043C \u043C\u043E\u0436\u043D\u043E \u0440\u0430\u0437\u043C\u0435\u043D\u044F\u0442\u044C
      \u043C\u043E\u043D\u0435\u0442\u044B \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0433\u043B\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546944
    m_Localized: "\u0423\u0441\u043B\u043E\u0432\u0438\u044F \u044F\u0441\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546945
    m_Localized: "\u0414\u0432\u0435\u0441\u0442\u0438 \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      - \u044D\u0442\u043E \u0446\u0435\u043D\u0430 \u0447\u0435\u0442\u044B\u0440\u0451\u0445
      \u0432\u044C\u044E\u043A\u043E\u0432 \u043C\u0443\u0441\u043A\u0443\u0441\u0430
      \u043F\u043E \u0442\u0435\u043A\u0443\u0449\u0435\u043C\u0443 \u043A\u0443\u0440\u0441\u0443
      \u0438\u043B\u0438 \u0442\u0440\u0451\u0445 \u043C\u0435\u0441\u044F\u0446\u0435\u0432
      \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438. \u0410\u0431\u0443 \u0411\u0430\u043A\u0440
      \u0434\u0430\u043B \u0441\u0440\u043E\u043A \u0432 \u0441\u0435\u043C\u044C
      \u0434\u043D\u0435\u0439, \u043D\u043E \u0441\u0430\u043C \u0436\u0438\u0432\u0451\u0442
      \u0432 \u043F\u043E\u0440\u0442\u0443 \u0438 \u043D\u0438\u0433\u0434\u0435
      \u043D\u0435 \u0441\u043F\u0435\u0448\u0438\u0442. \u041C\u043E\u0436\u043D\u043E
      \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438,
      \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u043D\u0430
      \u043D\u0435\u0433\u043E \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0430\u0442
      \u0443 \u043C\u0435\u0441\u0442\u043D\u044B\u0445 \u043C\u0435\u043D\u044F\u043B
      - \u043E\u043D \u0434\u0430\u0432\u043D\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0432 \u0426\u044E\u0430\u043D\u044C\u0447\u0436\u043E\u0443 \u0438 \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B \u0441\u043B\u0435\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546946
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0438\u043B\u0438 \u0438\u0441\u043A\u0430\u0442\u044C
      \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546947
    m_Localized: "\u0421\u0435\u043C\u044C \u0434\u043D\u0435\u0439 - \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
      \u0435\u0441\u043B\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0441\u0440\u0430\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546948
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u041F\u0430\u043D\u044C - \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C
      \u043E\u0431\u0435\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289575546949
    m_Localized: "\u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u0443 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442 \u042E\u0439\u043C\u044D\u043D\u044F \u043F\u0430\u0445\u043D\u0435\u0442
      \u0433\u043E\u0440\u044F\u0447\u0438\u043C \u0432\u043E\u0441\u043A\u043E\u043C
      \u0438 \u043F\u044B\u043B\u044C\u044E. \u041C\u043E\u043D\u0430\u0445 \u041F\u0430\u043D\u044C
      - \u0441\u0442\u0430\u0440\u0438\u043A \u0441 \u043E\u0431\u0440\u0438\u0442\u043E\u0439
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0438 \u0441\u0435\u0440\u044B\u043C\u0438
      \u0431\u0440\u043E\u0432\u044F\u043C\u0438 - \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0432 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0439
      \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u0441 \u0433\u043B\u0438\u043D\u044F\u043D\u044B\u043C
      \u0411\u0443\u0434\u0434\u043E\u0439 \u0432 \u0443\u0433\u043B\u0443. \u041E\u043D
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0431\u0435\u0437 \u043E\u0441\u0443\u0436\u0434\u0435\u043D\u0438\u044F,
      \u0433\u043B\u044F\u0434\u044F \u043C\u0438\u043C\u043E \u0432\u0430\u0441:
      \"\u0421\u0435\u043C\u044C \u043B\u0435\u0442 - \u0434\u043E\u043B\u0433\u0438\u0439
      \u0441\u0440\u043E\u043A. \u041D\u043E \u043B\u044E\u0434\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043E\u0431\u0438\u0434\u0435\u043B\u0438, \u0436\u0438\u0432\u0443\u0442
      \u0441 \u044D\u0442\u0438\u043C \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C.\"
      \u041E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0442\u0440\u043E\u0438\u0445:
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D,
      \u0447\u044C\u0438 \u0434\u0435\u043D\u044C\u0433\u0438 \u0443\u0448\u043B\u0438
      \u043D\u0430 \u0435\u0434\u0443 \u0434\u043B\u044F \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432;
      \u043B\u0430\u0432\u043E\u0447\u043D\u0438\u043A \u0438\u0437 \u041C\u0430\u043D\u044C\u0433\u0443,
      \u043F\u043E\u0442\u0435\u0440\u044F\u0432\u0448\u0438\u0439 \u0448\u0451\u043B\u043A;
      \u0441\u0435\u043C\u044C\u044F \u0438\u0437 \u0425\u0430\u043C\u0438, \u0443
      \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043E\u0442\u043D\u044F\u043B\u0438
      \u043C\u0443\u043B\u043E\u0432. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0445\u043E\u0434\u0438\u0442
      \u043F\u0435\u0448\u043A\u043E\u043C - \u043B\u043E\u0448\u0430\u0434\u044C
      \u0442\u0430\u043A \u0438 \u043D\u0435 \u043A\u0443\u043F\u0438\u043B. \u041C\u043E\u043D\u0430\u0445
      \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043D\u0438\u0447\u0435\u0433\u043E.
      \u041E\u043D \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438 \u0441\u043F\u0438\u0441\u043E\u043A
      \u0438 \u043C\u043E\u043B\u0447\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741184
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0441\u043F\u0438\u0441\u043E\u043A
      \u0438 \u043D\u0430\u0447\u0430\u0442\u044C \u0432\u043E\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741185
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0441\u043F\u0438\u0441\u043E\u043A \u0432 \u0432\u0430\u0448\u0438 \u0440\u0443\u043A\u0438.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0436\u0438\u0432\u0451\u0442
      \u043D\u0430 \u0443\u043B\u0438\u0446\u0435 \u043A\u0443\u0437\u043D\u0435\u0446\u043E\u0432
      - \u043E\u043D \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741186
    m_Localized: "\u0423\u0439\u0442\u0438 - \u043F\u0440\u043E\u0448\u043B\u043E\u0435
      \u043D\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741187
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u043A\u0438\u0432\u0430\u0435\u0442
      \u0438 \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0441\u043F\u0438\u0441\u043E\u043A.
      \u0414\u043E\u043B\u0433\u0438 \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F
      \u0434\u043E\u043B\u0433\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741188
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741189
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u043C\u043E\u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741190
    m_Localized: "\u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0431\u0435\u0440\u0451\u0442
      \u043C\u043E\u043D\u0435\u0442\u044B \u0438 \u043A\u043B\u0430\u0434\u0451\u0442
      \u0432 \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u043C\u0435\u0448\u043E\u0447\u0435\u043A
      \u043D\u0430 \u043F\u043E\u044F\u0441\u0435. \u0421\u043B\u043E\u0432 \u043D\u0435\u0442,
      \u043D\u043E \u043F\u043B\u0435\u0447\u0438 \u0443 \u043D\u0435\u0433\u043E
      \u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442\u0441\u044F - \u043F\u0435\u0440\u0432\u044B\u0439
      \u0440\u0430\u0437 \u0437\u0430 \u0434\u043E\u043B\u0433\u043E\u0435 \u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741191
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0434\u043E\u043B\u0433 \u043F\u043E\u0433\u0430\u0448\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741192
    m_Localized: "\u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u043F\u0440\u0438\u043D\u044F\u043B
      \u0434\u0435\u043D\u044C\u0433\u0438 \u043C\u043E\u043B\u0447\u0430. \u041E\u043D
      \u0436\u0438\u0432\u0451\u0442 \u0432 \u043E\u0434\u043D\u043E\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u0435
      \u0441 \u043C\u043B\u0430\u0434\u0448\u0438\u043C \u0431\u0440\u0430\u0442\u043E\u043C
      - \u043E\u0431\u0430 \u0433\u043E\u043D\u044F\u0442 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432
      \u0434\u043B\u044F \u0447\u0443\u0436\u0438\u0445 \u0445\u043E\u0437\u044F\u0435\u0432.
      \u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u043C\u043E\u043D\u0435\u0442
      \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u0442 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0445
      \u043B\u0435\u0442, \u043D\u043E \u0434\u044B\u0440\u0430 \u0432 \u0435\u0433\u043E
      \u043A\u043E\u0448\u0435\u043B\u044C\u043A\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u0430.
      \u041E\u043D \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u0438\u043B \u0432\u0441\u043B\u0443\u0445.
      \u041D\u043E \u0438 \u043D\u0435 \u043F\u0440\u043E\u0433\u043D\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741193
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u0432\u0442\u043E\u0440\u0443\u044E
      \u0441\u0435\u043C\u044C\u044E \u0432 \u0426\u0437\u044E\u0446\u044E\u0430\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741194
    m_Localized: "\u041B\u0430\u0432\u043E\u0447\u043D\u0438\u043A \u0438\u0437 \u041C\u0430\u043D\u044C\u0433\u0443
      \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B \u0432 \u0426\u0437\u044E\u0446\u044E\u0430\u043D\u044C
      \u0442\u0440\u0438 \u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434
      - \u044D\u0442\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741195
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 - \u0431\u0443\u043A\u0438\u043D\u0438\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741196
    m_Localized: "\u041B\u0430\u0432\u043A\u0430 \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0430
      \u0432 \u041F\u0435\u043A\u0438\u043D\u0435 \u043F\u0430\u0445\u043D\u0435\u0442
      \u0441\u0442\u0430\u0440\u044B\u043C \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u043E\u043C
      \u0438 \u0442\u043C\u0438\u043D\u043E\u043C - \u043E\u043D \u0445\u0440\u0430\u043D\u0438\u0442
      \u0441\u043F\u0435\u0446\u0438\u0438 \u043C\u0435\u0436\u0434\u0443 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430\u043C\u0438
      \u043E\u0442 \u043C\u043E\u043B\u0438. \u0421\u043E\u0433\u0434\u0438\u0435\u0446-\u0431\u0443\u043A\u0438\u043D\u0438\u0441\u0442
      \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u0430\u0441,
      \u043D\u0435 \u0432\u0441\u0442\u0430\u0432\u0430\u044F \u0441 \u043D\u0438\u0437\u043A\u043E\u0433\u043E
      \u0441\u0442\u0443\u043B\u0430, \u0438 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u043F\u043E\u043B\u043A\u0443 \u0443 \u043B\u0435\u0432\u043E\u0439
      \u0441\u0442\u0435\u043D\u044B: \u0442\u0430\u043C \u0432 \u043A\u043E\u0436\u0430\u043D\u043E\u043C
      \u0444\u0443\u0442\u043B\u044F\u0440\u0435 \u043B\u0435\u0436\u0438\u0442 \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C.
      \"\u0412\u0430\u0448 \u043E\u0442\u0435\u0446 \u0410\u0445\u043C\u0430\u0434
      \u0438\u0431\u043D \u041C\u0443\u0445\u0430\u043C\u043C\u0430\u0434 \u043D\u0430\u043F\u0438\u0441\u0430\u043B
      \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0442\u0440\u0430\u043A\u0442\u0430\u0442,\"
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442.
      \"\u041F\u0435\u0440\u0432\u0443\u044E \u0447\u0430\u0441\u0442\u044C \u044F
      \u043A\u0443\u043F\u0438\u043B \u0443 \u043F\u0435\u0440\u0435\u043A\u0443\u043F\u0449\u0438\u043A\u0430
      \u0434\u0432\u0430 \u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434.
      \u0426\u0435\u043D\u0430 \u0431\u044B\u043B\u0430 \u0447\u0435\u0441\u0442\u043D\u0430\u044F,
      \u0438 \u043C\u043E\u044F \u0446\u0435\u043D\u0430 \u0442\u043E\u0436\u0435
      \u0447\u0435\u0441\u0442\u043D\u0430\u044F: \u0441\u043E\u0440\u043E\u043A
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0438\u043B\u0438 \u0440\u0430\u0432\u043D\u043E\u0446\u0435\u043D\u043D\u044B\u0439
      \u043E\u0431\u043C\u0435\u043D.\" \u0420\u0443\u043A\u043E\u043F\u0438\u0441\u044C
      \u0432\u0438\u0434\u043D\u0430 \u0447\u0435\u0440\u0435\u0437 \u0449\u0435\u043B\u044C
      \u0432 \u0444\u0443\u0442\u043B\u044F\u0440\u0435 - \u043F\u043E\u0447\u0435\u0440\u043A
      \u043E\u0442\u0446\u0430, \u0447\u0435\u0440\u043D\u0438\u043B\u0430 \u0441
      \u043C\u0435\u0434\u043D\u044B\u043C \u043E\u0442\u043B\u0438\u0432\u043E\u043C.
      \u0422\u0440\u0430\u043A\u0442\u0430\u0442 \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u043B
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B \u043E\u0442 \u0427\u0430\u043D\u044A\u0430\u043D\u044F
      \u0434\u043E \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430 \u0441
      \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u0435\u043C \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0445
      \u0434\u0432\u043E\u0440\u043E\u0432, \u0446\u0435\u043D \u043D\u0430 \u0432\u043E\u0434\u0443
      \u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0445 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432.
      \u0414\u043B\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430 \u0442\u0430\u043A\u0430\u044F
      \u043A\u043D\u0438\u0433\u0430 - \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741197
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u043E \u0446\u0435\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741198
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C \u0442\u0440\u0438 \u0434\u043D\u044F
      - \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E, \u0447\u0442\u043E\u0431\u044B
      \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u043C\u043E\u043D\u0435\u0442\u044B
      \u0438\u043B\u0438 \u043D\u0430\u0439\u0442\u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0439
      \u0442\u043E\u0432\u0430\u0440 \u0434\u043B\u044F \u043E\u0431\u043C\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741199
    m_Localized: "\u0423\u0439\u0442\u0438 - \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741200
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B. \u0420\u0443\u043A\u043E\u043F\u0438\u0441\u044C
      \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043D\u0430 \u043F\u043E\u043B\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741201
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B \u0443
      \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741202
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0438\u043B\u0438
      \u043E\u0431\u043C\u0435\u043D\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741203
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u043E\u043F\u043B\u0430\u0442\u0443 \u0438 \u0441\u043D\u0438\u043C\u0430\u0435\u0442
      \u0444\u0443\u0442\u043B\u044F\u0440 \u0441 \u043F\u043E\u043B\u043A\u0438
      - \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u043A \u0432\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741204
    m_Localized: "\u041F\u0435\u0440\u0432\u0430\u044F \u0447\u0430\u0441\u0442\u044C
      \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741205
    m_Localized: "\u0420\u0443\u043A\u043E\u043F\u0438\u0441\u044C \u0432 \u0440\u0443\u043A\u0430\u0445.
      \u041F\u0435\u0440\u0432\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u0442\u0440\u0430\u043A\u0442\u0430\u0442\u0430
      \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u043E\u0442 \u0427\u0430\u043D\u044A\u0430\u043D\u044F \u0434\u043E \u041B\u0430\u043D\u044C\u0447\u0436\u043E\u0443
      \u0441 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u044B\u043C\u0438 \u043F\u043E\u043C\u0435\u0442\u043A\u0430\u043C\u0438
      \u043E \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0445 \u0434\u0432\u043E\u0440\u0430\u0445
      \u0438 \u0446\u0435\u043D\u0430\u0445 \u043D\u0430 \u0437\u0435\u0440\u043D\u043E.
      \u041F\u043E\u0447\u0435\u0440\u043A \u043E\u0442\u0446\u0430 \u043C\u0435\u043B\u043A\u0438\u0439
      \u0438 \u0440\u043E\u0432\u043D\u044B\u0439. \u041D\u0430 \u043F\u043E\u043B\u044F\u0445
      - \u043F\u0440\u0438\u043F\u0438\u0441\u043A\u0438 \u0434\u0440\u0443\u0433\u0438\u043C
      \u043F\u043E\u0447\u0435\u0440\u043A\u043E\u043C: \u043F\u0435\u0440\u0435\u043A\u0443\u043F\u0449\u0438\u043A
      \u0447\u0442\u043E-\u0442\u043E \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u043B.
      \u0412\u0442\u043E\u0440\u0430\u044F \u0447\u0430\u0441\u0442\u044C, \u043F\u043E
      \u0441\u043B\u043E\u0432\u0430\u043C \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0430,
      \u0443\u0448\u043B\u0430 \u043D\u0430 \u044E\u0433 - \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C
      \u0431\u043B\u0438\u0437 \u041B\u0438\u0446\u0437\u044F\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741206
    m_Localized: "\u041D\u0430\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u043A \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741207
    m_Localized: "\u041F\u0443\u0442\u044C \u043D\u0430 \u044E\u0433 \u0447\u0435\u0440\u0435\u0437
      \u0433\u043E\u0440\u044B \u0434\u043E\u043B\u0433\u0438\u0439, \u043D\u043E
      \u043C\u043E\u043D\u0430\u0445\u0438 \u0445\u0440\u0430\u043D\u044F\u0442 \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u0438
      \u043B\u0443\u0447\u0448\u0435 \u043B\u044E\u0431\u043E\u0433\u043E \u0441\u043A\u043B\u0430\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741208
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u0425\u0443\u044D\u0439 \u041D\u044D\u043D
      - \u043D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741209
    m_Localized: "\u0425\u0440\u0430\u043C \u0424\u0430\u043C\u0435\u043D\u0441\u044B
      \u0441\u0442\u043E\u0438\u0442 \u0432 \u0434\u0432\u0443\u0445 \u043B\u0438
      \u043A \u0437\u0430\u043F\u0430\u0434\u0443 \u043E\u0442 \u0427\u0430\u043D\u044A\u0430\u043D\u044F
      - \u0437\u0430\u043F\u0430\u0445 \u0441\u043E\u0441\u0435\u043D \u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E
      \u043A\u0430\u043C\u043D\u044F \u0443\u0436\u0435 \u0441 \u0434\u043E\u0440\u043E\u0433\u0438.
      \u041D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C \u0425\u0443\u044D\u0439
      \u041D\u044D\u043D \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u043E\u0432
      \u0443 \u0433\u043B\u0430\u0432\u043D\u044B\u0445 \u0432\u043E\u0440\u043E\u0442,
      \u0433\u0434\u0435 \u0441\u0442\u0443\u043F\u0435\u043D\u0438 \u043E\u0442\u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u044B
      \u0442\u044B\u0441\u044F\u0447\u0430\u043C\u0438 \u043D\u043E\u0433. \u041E\u043D
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0441
      \u0434\u043E\u043B\u0433\u043E, \u043F\u043E\u0442\u043E\u043C \u043A\u0438\u0432\u0430\u0435\u0442:
      \"\u041E\u0431\u0435\u0442 \u0432 \u0442\u0440\u0451\u0445 \u043C\u0435\u0441\u0442\u0430\u0445
      - \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044C. \u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E
      \u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0443\u044E\u0442\u0441\u044F
      \u043E\u0434\u043D\u0438\u043C \u0445\u0440\u0430\u043C\u043E\u043C.\" \u041E\u043D
      \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u0442\u0440\u0438. \u0414\u043B\u044F
      \u0431\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u043E\u0433\u043E \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u0430
      \u043F\u0440\u0438\u043D\u044F\u0442\u043E \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u044C
      \u043B\u0430\u0434\u0430\u043D \u043A \u043C\u043E\u0449\u0430\u043C \u0411\u0443\u0434\u0434\u044B
      - \u0447\u0430\u0441\u0442\u0438\u0446\u0430 \u043A\u043E\u0441\u0442\u0438
      \u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F \u0437\u0434\u0435\u0441\u044C
      \u0441 \u0434\u0435\u0432\u044F\u0442\u043E\u0433\u043E \u0433\u043E\u0434\u0430
      \u044D\u0440\u044B \u0427\u0436\u044D\u043D\u0433\u0443\u0430\u043D\u044C.
      \u041D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A: \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C\u0441\u044F
      \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430, \u0442\u0440\u043E\u0435\u043A\u0440\u0430\u0442\u043D\u043E
      \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u0442\u044C\u0441\u044F, \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C
      \u043B\u0430\u0434\u0430\u043D \u043D\u0430 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439
      \u043F\u043E\u0434\u043D\u043E\u0441 \u0443 \u0440\u0435\u043B\u0438\u043A\u0432\u0430\u0440\u0438\u044F.
      \u041F\u043E\u0442\u043E\u043C \u043E\u043D \u0434\u0430\u0441\u0442 \u043F\u0435\u0440\u0432\u0443\u044E
      \u043F\u0435\u0447\u0430\u0442\u044C \u043D\u0430 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741210
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043E\u0431\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741211
    m_Localized: "\u041D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C \u0432\u0435\u0434\u0451\u0442
      \u0432\u0430\u0441 \u043A \u043A\u043E\u043B\u043E\u0434\u0446\u0443. \u0412\u043E\u0434\u0430
      \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F \u0434\u0430\u0436\u0435 \u0432
      \u043B\u0435\u0442\u043D\u0438\u0439 \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741212
    m_Localized: "\u0423\u0439\u0442\u0438 - \u0432\u0440\u0435\u043C\u044F \u043D\u0435
      \u043F\u0440\u0438\u0448\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741213
    m_Localized: "\u041D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C \u043D\u0435
      \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442. \u0412\u043E\u0440\u043E\u0442\u0430
      \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741214
    m_Localized: "\u041F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0435 \u0443
      \u0440\u0435\u043B\u0438\u043A\u0432\u0430\u0440\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741215
    m_Localized: "\u041F\u043E\u043B\u043E\u0436\u0438\u0442\u044C \u043B\u0430\u0434\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741216
    m_Localized: "\u041B\u0430\u0434\u0430\u043D \u0442\u043B\u0435\u0435\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E.
      \u041D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C \u0441\u0442\u0430\u0432\u0438\u0442
      \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u0443\u044E \u043A\u0440\u0430\u0441\u043D\u0443\u044E
      \u043F\u0435\u0447\u0430\u0442\u044C \u043D\u0430 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741217
    m_Localized: "\u041F\u0435\u0440\u0432\u043E\u0435 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741218
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0433\u0440\u0430\u043C\u043E\u0442\u0430 \u0441 \u043F\u0435\u0440\u0432\u043E\u0439
      \u043F\u0435\u0447\u0430\u0442\u044C\u044E \u043B\u0435\u0436\u0438\u0442 \u0432
      \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439 \u0441\u0443\u043C\u043A\u0435.
      \u0417\u0430\u043F\u0430\u0445 \u0441\u0430\u043D\u0434\u0430\u043B\u0430 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043D\u0430 \u043E\u0434\u0435\u0436\u0434\u0435 \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0432\u0435\u0447\u0435\u0440\u0430. \u041D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C
      \u0441\u043A\u0430\u0437\u0430\u043B: \u0437\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u0438\u0439
      \u043E\u0433\u043E\u043D\u044C \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u043E\u0432
      \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u043C\u0435\u0441\u044F\u0446\u0430 \u043F\u043E \u043B\u0443\u043D\u043D\u043E\u043C\u0443
      \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u044E. \u0414\u043E \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      \u043C\u0435\u0441\u044F\u0446\u0430 \u0434\u0432\u0430 \u043F\u043E \u0437\u0430\u043F\u0430\u0434\u043D\u043E\u043C\u0443
      \u0442\u0440\u0430\u043A\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741219
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u043D\u0430 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0439
      \u0442\u0440\u0430\u043A\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741220
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0430 \u043D\u0430 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0443 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442 \u0427\u0430\u043D\u044A\u0430\u043D\u0438 -
      \u0442\u0443\u0434\u0430, \u0433\u0434\u0435 \u0425\u044D\u0441\u0438-\u043A\u043E\u0440\u0438\u0434\u043E\u0440
      \u0443\u0445\u043E\u0434\u0438\u0442 \u0437\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741221
    m_Localized: "\u0410\u0440\u0445\u0438\u0432 \u041B\u0443\u043E\u044F\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741222
    m_Localized: "\u0412 \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435 \u0443\u0435\u0437\u0434\u043D\u043E\u0433\u043E
      \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u041B\u0443\u043E\u044F\u043D\u0430
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0441\u044B\u0440\u044B\u043C \u0434\u0435\u0440\u0435\u0432\u043E\u043C
      \u0438 \u0442\u0443\u0448\u044C\u044E. \u0414\u0443\u043D \u0412\u044D\u0439
      \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u0435\u0442 \u0441\u0432\u044F\u0437\u043A\u0438
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432 \u043F\u0440\u0438
      \u0441\u0432\u0435\u0442\u0435 \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0433\u043E
      \u0441\u0432\u0435\u0442\u0438\u043B\u044C\u043D\u0438\u043A\u0430 - \u043F\u043E\u0448\u043B\u0438\u043D\u043D\u044B\u0435
      \u0437\u0430\u043F\u0438\u0441\u0438 \u0437\u0430 \u0441\u0435\u043C\u044C
      \u043B\u0435\u0442 \u0433\u0440\u043E\u043C\u043E\u0437\u0434\u044F\u0442\u0441\u044F
      \u043D\u0430 \u043F\u043E\u043B\u043A\u0430\u0445 \u0434\u043E \u043F\u043E\u0442\u043E\u043B\u043A\u0430.
      \u041F\u0438\u0441\u0430\u0440\u044C \u0427\u044D\u043D\u044C \u0424\u0443
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430\u0441\u0442\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u043E:
      \u043F\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043C \u0432 \u0430\u0440\u0445\u0438\u0432
      \u0432\u0445\u043E\u0434 \u0437\u0430\u043A\u0440\u044B\u0442, \u0438 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435
      \u043F\u0438\u0441\u044C\u043C\u043E \u043E\u0442 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u044B \u043E\u0442\u043A\u0440\u044B\u043B\u043E
      \u044D\u0442\u0443 \u0434\u0432\u0435\u0440\u044C. \u0421\u0440\u0435\u0434\u0438
      \u043F\u043E\u0436\u0435\u043B\u0442\u0435\u0432\u0448\u0438\u0445 \u0441\u0432\u0438\u0442\u043A\u043E\u0432
      \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C \u0440\u0435\u0435\u0441\u0442\u0440
      \u0433\u0440\u0443\u0437\u043E\u0432 \u0437\u0430 \u043E\u0441\u0435\u043D\u044C
      \u0434\u0435\u0432\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u043E\u0433\u043E
      \u0433\u043E\u0434\u0430 - \u0442\u0430\u043C, \u0433\u0434\u0435 \u043F\u043E\u0434\u043F\u0438\u0441\u044C
      \u043E\u0442\u0446\u0430 \u0441\u0442\u043E\u0438\u0442 \u0440\u044F\u0434\u043E\u043C
      \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E \u0442\u0430\u043C\u043E\u0436\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741223
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u0440\u0435\u0435\u0441\u0442\u0440
      \u0433\u0440\u0443\u0437\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741224
    m_Localized: "\u0414\u0443\u043D \u0412\u044D\u0439 \u043D\u0430\u0445\u043E\u0434\u0438\u0442
      \u043D\u0443\u0436\u043D\u044B\u0439 \u0441\u0432\u0438\u0442\u043E\u043A \u0432
      \u0442\u0440\u0435\u0442\u044C\u0435\u0439 \u0441\u0432\u044F\u0437\u043A\u0435.
      \u041F\u043E\u0434\u043F\u0438\u0441\u044C \u043E\u0442\u0446\u0430 \u0441\u0442\u043E\u0438\u0442
      \u043F\u043E\u0434 \u0437\u0430\u043F\u0438\u0441\u044C\u044E \u043E \u0433\u0440\u0443\u0437\u0435
      \u0448\u0451\u043B\u043A\u0430 - \u0440\u044F\u0434\u043E\u043C \u0441 \u0438\u043C\u0435\u043D\u0435\u043C
      \u041B\u0438 \u0427\u0436\u0443\u043D\u0430, \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0430
      \u0442\u0430\u043C\u043E\u0436\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741225
    m_Localized: "\u0420\u0435\u0435\u0441\u0442\u0440 \u043D\u0430\u0439\u0434\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741226
    m_Localized: "\u0421\u0432\u0438\u0442\u043E\u043A \u0440\u0430\u0437\u0432\u0451\u0440\u043D\u0443\u0442
      \u043D\u0430 \u0441\u0442\u043E\u043B\u0435 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435
      \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E \u0434\u0432\u043E\u0440\u0430.
      \u041F\u044F\u0442\u043D\u043E \u043E\u0442 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
      \u0447\u0430\u044F \u043D\u0430 \u043A\u0440\u0430\u044E \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0430,
      \u0434\u0430\u0442\u0430 - \u043E\u0441\u0435\u043D\u044C \u0434\u0435\u0432\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u043E\u0433\u043E
      \u0433\u043E\u0434\u0430 \u041A\u0430\u0439\u044E\u0430\u043D\u044C. \u041F\u043E\u0434\u043F\u0438\u0441\u044C
      \u043E\u0442\u0446\u0430 \u0441\u0442\u043E\u0438\u0442 \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0437\u0430\u043F\u0438\u0441\u044C\u044E: \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0448\u0442\u0443\u043A \u043F\u0435\u0440\u0432\u043E\u0441\u043E\u0440\u0442\u043D\u043E\u0433\u043E
      \u0448\u0451\u043B\u043A\u0430, \u043F\u0435\u0447\u0430\u0442\u044C \u041B\u0443\u043E\u044F\u043D\u0441\u043A\u043E\u0439
      \u0442\u0430\u043C\u043E\u0436\u043D\u0438, \u0438 \u043D\u0438\u0436\u0435
      - \u0434\u0440\u0443\u0433\u0430\u044F \u0440\u0443\u043A\u0430 \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0430
      \u0446\u0438\u0444\u0440\u0443 \u043D\u0435\u0434\u043E\u0438\u043C\u043A\u0438,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u043E.
      \u0414\u0443\u043D \u0412\u044D\u0439 \u0434\u0435\u0440\u0436\u0438\u0442
      \u0440\u0435\u0435\u0441\u0442\u0440 \u0434\u0432\u0443\u043C\u044F \u0440\u0443\u043A\u0430\u043C\u0438
      - \u044D\u0442\u043E \u043F\u0435\u0440\u0432\u043E\u0435 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0434\u0435\u043B\u043E \u0431\u044B\u043B\u043E
      \u0441\u0444\u0430\u0431\u0440\u0438\u043A\u043E\u0432\u0430\u043D\u043E. \u0422\u0435\u043F\u0435\u0440\u044C
      \u043D\u0443\u0436\u0435\u043D \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u0437\u043D\u0430\u044E\u0449\u0438\u0439, \u0447\u044C\u044F \u044D\u0442\u043E
      \u0440\u0443\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741227
    m_Localized: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0430\u0432\u0442\u043E\u0440\u0441\u0442\u0432\u043E
      \u0437\u0430\u043F\u0438\u0441\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741228
    m_Localized: "\u0411\u044B\u0432\u0448\u0438\u0439 \u043F\u0438\u0441\u0430\u0440\u044C
      \u0442\u0430\u043C\u043E\u0436\u043D\u0438 \u0435\u0449\u0451 \u0436\u0438\u0432\u0451\u0442
      \u0432 \u041B\u0443\u043E\u044F\u043D\u0435. \u0415\u0433\u043E \u0438\u043C\u044F
      - \u0412\u0430\u043D \u0428\u0438, \u043E\u043D \u0442\u043E\u0440\u0433\u0443\u0435\u0442
      \u0431\u0443\u043C\u0430\u0433\u043E\u0439 \u0443 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741229
    m_Localized: "\u0426\u0437\u0435\u0434\u0443\u0448\u0438 \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741230
    m_Localized: "\u041F\u0440\u0438\u0451\u043C\u043D\u044B\u0439 \u0437\u0430\u043B
      \u0446\u0437\u0435\u0434\u0443\u0448\u0438 \u0425\u044D\u043D\u0430\u043D\u044C
      \u0437\u0430\u043B\u0438\u0442 \u0443\u0442\u0440\u0435\u043D\u043D\u0438\u043C
      \u0441\u0432\u0435\u0442\u043E\u043C \u0447\u0435\u0440\u0435\u0437 \u0440\u0435\u0448\u0451\u0442\u0447\u0430\u0442\u044B\u0435
      \u043E\u043A\u043D\u0430. \u041B\u0438 \u041B\u0438\u043D\u044C\u0444\u0443
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u0441\u0432\u0438\u0442\u043E\u043A
      \u043E\u0431\u0435\u0438\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438,
      \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E. \u0422\u0438\u0448\u0438\u043D\u0430
      - \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043A\u0440\u0438\u043F \u0435\u0433\u043E
      \u043A\u0440\u0435\u0441\u043B\u0430. \u0414\u0443\u043D \u0412\u044D\u0439
      \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u043B\u044F\u0435\u0442 \u0440\u0435\u0435\u0441\u0442\u0440
      \u0438\u0437 \u043B\u0443\u043E\u044F\u043D\u0441\u043A\u043E\u0433\u043E \u0430\u0440\u0445\u0438\u0432\u0430
      \u0438 \u0441\u043F\u0440\u0430\u0432\u043A\u0443 \u043F\u0438\u0441\u0430\u0440\u044F
      \u0412\u0430\u043D \u0428\u0438: \u043F\u043E\u0434\u043F\u0438\u0441\u044C
      \u0444\u0430\u043B\u044C\u0441\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440\u0430
      \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442 \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u0443
      \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u043E\u0433\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u043B\u044F,
      \u0431\u0435\u0436\u0430\u0432\u0448\u0435\u043C\u0443 \u0432 \u0425\u044D\u0434\u0443\u043D
      \u0442\u0440\u0438 \u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434.
      \u0426\u0437\u0435\u0434\u0443\u0448\u0438 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0441\u0432\u0438\u0442\u043E\u043A \u0438 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442
      \u043E\u0434\u043D\u043E \u0441\u043B\u043E\u0432\u043E: \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E.
      \u0414\u0435\u043B\u043E \u043E \u043D\u0435\u0434\u043E\u0438\u043C\u043A\u0435
      \u043E\u0442\u0446\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u043E, \u043A\u043E\u043D\u0444\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E \u043F\u043E\u0434\u043B\u0435\u0436\u0438\u0442
      \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0443 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      \u0434\u0432\u0443\u0445 \u043C\u0435\u0441\u044F\u0446\u0435\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741231
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u0446\u0437\u0435\u0434\u0443\u0448\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741232
    m_Localized: "\u041F\u0435\u0447\u0430\u0442\u044C \u0446\u0437\u0435\u0434\u0443\u0448\u0438
      \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044F \u043D\u0430 \u0440\u0435\u0430\u0431\u0438\u043B\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0439
      \u0443\u043A\u0430\u0437. \u0421\u0435\u043C\u044C\u044F \u0414\u0443\u043D
      \u0412\u044D\u044F \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u043E\u0435
      \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043E\u0442\u043A\u0440\u043E\u0435\u0442
      \u0434\u0432\u0435\u0440\u0438 \u0432 \u043B\u044E\u0431\u043E\u043C \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435 \u043D\u0430 \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741233
    m_Localized: "\u0421\u043B\u0435\u0434 \u0432 \u042E\u0439\u043C\u044D\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741234
    m_Localized: "\u042E\u0439\u043C\u044D\u043D\u044C\u0441\u043A\u0438\u0439 \u043F\u043E\u0441\u0442
      \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u043A\u0440\u0430\u044E \u0413\u043E\u0431\u0438\u0439\u0441\u043A\u043E\u0433\u043E
      \u043F\u043B\u0430\u0442\u043E, \u0433\u0434\u0435 \u0432\u0435\u0442\u0435\u0440
      \u0433\u043E\u043D\u0438\u0442 \u043F\u0435\u0441\u043E\u043A \u0441\u043A\u0432\u043E\u0437\u044C
      \u0449\u0435\u043B\u0438 \u0432 \u0441\u0442\u0435\u043D\u0430\u0445. \u0420\u0443\u0441\u0442\u0430\u043C
      \u0430\u043B-\u0411\u0443\u0445\u0430\u0440\u0438 \u0440\u0430\u0441\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u043E\u0432 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u043C - \u0442\u0440\u0438 \u0441\u043C\u0435\u043D\u044B,
      \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A.
      \u041D\u0430 \u0438\u0441\u0445\u043E\u0434\u0435 \u0432\u0442\u043E\u0440\u043E\u0433\u043E
      \u0447\u0430\u0441\u0430 \u043F\u043E\u0436\u0438\u043B\u043E\u0439 \u0441\u043E\u0442\u043D\u0438\u043A
      \u0427\u0436\u0430\u043D \u0414\u044D \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442:
      \u0442\u0435\u043C \u043B\u0435\u0442\u043E\u043C \u0447\u0435\u0440\u0435\u0437
      \u043F\u043E\u0441\u0442 \u043F\u0440\u043E\u0448\u0451\u043B \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u043A\u0443\u043F\u0435\u0446 \u0441 \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u044B\u043C
      \u0433\u0440\u0443\u0437\u043E\u043C - \u0442\u044E\u043A\u0438 \u0431\u0435\u0437
      \u043C\u0430\u0440\u043A\u0438\u0440\u043E\u0432\u043A\u0438, \u0434\u0432\u043E\u0435
      \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u044B\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432.
      \u041A\u0443\u043F\u0435\u0446 \u043D\u0430\u0437\u0432\u0430\u043B \u0438\u043C\u044F,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0420\u0443\u0441\u0442\u0430\u043C
      \u0441\u043B\u044B\u0448\u0430\u043B \u0440\u0430\u043D\u044C\u0448\u0435:
      \u041D\u0438\u044F\u0437\u0431\u0435\u043A \u0438\u0437 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0430,
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043F\u0440\u043E\u0447\u0438\u043C\u0438
      \u0442\u043E\u0432\u0430\u0440\u0430\u043C\u0438. \u042D\u0442\u043E \u0443\u0436\u0435
      \u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741235
    m_Localized: "\u0420\u0430\u0437\u044B\u0441\u043A\u0430\u0442\u044C \u041D\u0438\u044F\u0437\u0431\u0435\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741236
    m_Localized: "\u041D\u0438\u044F\u0437\u0431\u0435\u043A \u0436\u0438\u0432\u0451\u0442
      \u0432 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0435, \u0432 \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0435
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0445 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432
      \u0443 \u0421\u0435\u0432\u0435\u0440\u043D\u044B\u0445 \u0432\u043E\u0440\u043E\u0442.
      \u0420\u0443\u0441\u0442\u0430\u043C \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0442\u0443\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741237
    m_Localized: "\u041D\u0438\u044F\u0437\u0431\u0435\u043A \u043F\u0440\u0438\u0437\u043D\u0430\u0451\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741238
    m_Localized: "\u041B\u0430\u0432\u043A\u0430 \u041D\u0438\u044F\u0437\u0431\u0435\u043A\u0430
      \u043F\u0430\u0445\u043D\u0435\u0442 \u043C\u0443\u0441\u043A\u0443\u0441\u043E\u043C
      \u0438 \u0441\u0442\u0430\u0440\u043E\u0439 \u043A\u043E\u0436\u0435\u0439.
      \u0425\u043E\u0437\u044F\u0438\u043D \u043F\u043E\u043D\u0430\u0447\u0430\u043B\u0443
      \u043E\u0442\u0440\u0438\u0446\u0430\u0435\u0442 \u0432\u0441\u0451, \u043D\u043E
      \u0420\u0443\u0441\u0442\u0430\u043C \u043A\u043B\u0430\u0434\u0451\u0442 \u043D\u0430
      \u0441\u0442\u043E\u043B \u0438\u043C\u0435\u043D\u043D\u043E\u0439 \u044F\u0440\u043B\u044B\u043A,
      \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0439 \u0432 \u0440\u0443\u0438\u043D\u0430\u0445
      \u0441\u043E\u0436\u0436\u0451\u043D\u043D\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      - \u044F\u0440\u043B\u044B\u043A \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E
      \u0441\u0430\u043C\u043E\u0433\u043E \u041D\u0438\u044F\u0437\u0431\u0435\u043A\u0430.
      \u041A\u0443\u043F\u0435\u0446 \u0431\u043B\u0435\u0434\u043D\u0435\u0435\u0442.
      \u0421\u043B\u043E\u0432\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E: \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0437\u0430\u043A\u0430\u0437 \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A\u0430,
      \u0433\u0440\u0443\u0437 \u0448\u0451\u043B \u0447\u0435\u0440\u0435\u0437
      \u0425\u043E\u0442\u0430\u043D \u0432 \u0433\u043E\u0440\u044B, \u043E\u043D
      \u043D\u0435 \u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0442\u043E\u0442
      \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439 \u043A\u043E\u043D\u0432\u043E\u0439
      \u0434\u043E\u0431\u0435\u0440\u0451\u0442\u0441\u044F \u0434\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0420\u0443\u0441\u0442\u0430\u043C\u0430. \u0418\u043C\u044F \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u0430
      \u043E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043E\u0434\u043D\u043E:
      \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741239
    m_Localized: "\u0417\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C \u0438\u043C\u044F
      \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741240
    m_Localized: "\u0420\u0443\u0441\u0442\u0430\u043C \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u041D\u0438\u044F\u0437\u0431\u0435\u043A\u0430 \u043F\u043E\u0434 \u0441\u0442\u0440\u0430\u0436\u0435\u0439
      \u043C\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u044B.
      \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D - \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0439
      \u0432\u043E\u0435\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A, \u0441\u043B\u0443\u0445\u0438
      \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0445\u043E\u0434\u044F\u0442
      \u0432\u0434\u043E\u043B\u044C \u0432\u0441\u0435\u0433\u043E \u0425\u044D\u0441\u0438-\u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741241
    m_Localized: "\u041F\u0440\u0430\u0432\u0434\u0430 \u043E \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741242
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
      \u0432 \u0441\u0442\u0430\u0440\u043E\u0439 \u044E\u0440\u0442\u0435 \u0443
      \u0434\u043E\u0440\u043E\u0433\u0438 \u043D\u0430 \u0422\u0443\u0440\u0444\u0430\u043D,
      \u0432 \u0447\u0430\u0441, \u043A\u043E\u0433\u0434\u0430 \u0441\u043E\u043B\u043D\u0446\u0435
      \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0445\u0440\u0435\u0431\u0442\u043E\u0432. \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D
      \u0441\u0438\u0434\u0438\u0442 \u043F\u0440\u044F\u043C\u043E, \u0440\u0443\u043A\u0438
      \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u044F\u0445. \u041E\u043D \u043D\u0435
      \u043E\u0442\u0440\u0438\u0446\u0430\u0435\u0442: \u043F\u0440\u0438\u043A\u0430\u0437
      \u0441\u0436\u0435\u0447\u044C \u0442\u043E\u0442 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439
      \u0433\u0440\u0443\u0437 \u0431\u044B\u043B \u0435\u0433\u043E, \u043D\u043E
      \u0441\u0440\u0435\u0434\u0438 \u0442\u044E\u043A\u043E\u0432 \u0448\u043B\u043E
      \u043E\u0440\u0443\u0436\u0438\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043F\u043E \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0443 \u043D\u0435
      \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u044C
      \u0425\u044D\u0441\u0438. \u0420\u0443\u0441\u0442\u0430\u043C \u0441\u043B\u0443\u0448\u0430\u0435\u0442
      - \u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442, \u0447\u0442\u043E
      \u0443 \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u0434\u0432\u0430 \u0434\u043D\u0430.
      \u0415\u0433\u043E \u043E\u0442\u0435\u0446, \u0410\u0445\u043C\u0430\u0434
      \u0430\u043B-\u0411\u0443\u0445\u0430\u0440\u0438, \u0441\u0430\u043C \u0432\u0451\u0437
      \u044D\u0442\u043E\u0442 \u043A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u043D\u044B\u0439
      \u0433\u0440\u0443\u0437, \u0438 \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B \u0435\u0433\u043E \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u043C \u0435\u043C\u0443 \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C.
      \u0422\u0440\u0451\u0445\u0434\u043D\u0435\u0432\u043D\u043E\u0435 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435
      \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438 - \u044D\u0442\u043E
      \u0443\u0436\u0435 \u043E\u0442\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741243
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u0440\u0430\u0432\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741244
    m_Localized: "\u0420\u0443\u0441\u0442\u0430\u043C \u0432\u0441\u0442\u0430\u0451\u0442
      \u043F\u0435\u0440\u0432\u044B\u043C. \u041E\u043D \u043D\u0435 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u044D\u0442\u043E \u043F\u0440\u043E\u0449\u0435\u043D\u0438\u0435\u043C -
      \u043D\u043E \u0434\u043E\u0440\u043E\u0433\u0430 \u043D\u0430 \u0437\u0430\u043F\u0430\u0434
      \u0441\u043D\u043E\u0432\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0430,
      \u0438 \u0438\u043C\u044F \u0410\u0445\u043C\u0430\u0434\u0430 \u0430\u043B-\u0411\u0443\u0445\u0430\u0440\u0438
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442
      \u0437\u0430\u0442\u0440\u0443\u0434\u043D\u044F\u0442\u044C \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B
      \u043D\u0430 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0445 \u043F\u043E\u0441\u0442\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741245
    m_Localized: "\u041F\u043E\u0434\u0436\u0438\u0433\u0430\u0442\u0435\u043B\u044C
      \u0432 \u0425\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741246
    m_Localized: "\u0425\u0430\u043C\u0438 - \u043F\u0435\u0440\u0435\u043A\u0440\u0451\u0441\u0442\u043E\u043A,
      \u0433\u0434\u0435 \u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0434\u043E\u0440\u043E\u0433\u0438
      \u0438\u0437 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0430 \u0438
      \u0422\u0443\u0440\u0444\u0430\u043D\u0430. \u0417\u0430\u043F\u0430\u0445
      \u0436\u0430\u0440\u0435\u043D\u043E\u0433\u043E \u043B\u0443\u043A\u0430 \u0438\u0437
      \u0445\u0430\u0440\u0447\u0435\u0432\u0435\u043D \u0441\u043C\u0435\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441 \u043A\u043E\u043D\u0441\u043A\u0438\u043C \u043D\u0430\u0432\u043E\u0437\u043E\u043C
      \u043D\u0430 \u043C\u043E\u0449\u0451\u043D\u043E\u043C \u0434\u0432\u043E\u0440\u0435.
      \u041B\u044E \u042F\u043E \u0432\u0435\u0434\u0451\u0442 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435
      \u0442\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C: \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043E\u043F\u0438\u0441\u0430\u043B
      \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C \u0438\u0437 \u0410\u043D\u044C\u0441\u0438,
      \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0437\u0434\u0435\u0441\u044C
      \u043A\u0430\u0436\u0434\u043E\u0435 \u0443\u0442\u0440\u043E \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430.
      \u0421\u0440\u0435\u0434\u043D\u0435\u0433\u043E \u0440\u043E\u0441\u0442\u0430,
      \u0448\u0440\u0430\u043C \u043D\u0430 \u043B\u0435\u0432\u043E\u043C \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u0435,
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u0434\u0435\u0442 \u0432 \u0441\u0435\u0440\u044B\u0439
      \u0445\u0430\u043B\u0430\u0442. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
      \u043E\u043D \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442
      \u0441 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u043C \u043C\u0443\u043B\u043E\u0432
      \u0434\u043E\u043B\u044C\u0448\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E,
      \u0438 \u0432 \u0435\u0433\u043E \u0441\u0443\u043C\u043A\u0435 \u0443\u0433\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u043E\u0447\u0435\u0440\u0442\u0430\u043D\u0438\u044F \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0433\u043E
      \u043A\u0443\u0432\u0448\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741247
    m_Localized: "\u0421\u043B\u0435\u0434\u0438\u0442\u044C \u0438 \u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741248
    m_Localized: "\u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u043F\u043E\u0434\u0436\u0438\u0433\u0430\u0442\u0435\u043B\u044C
      \u0443\u0445\u043E\u0434\u0438\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E \u0434\u0432\u043E\u0440\u0430
      \u0443 \u0412\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0445 \u0432\u043E\u0440\u043E\u0442.
      \u041B\u044E \u042F\u043E \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
      \u043A\u043E\u043C\u043D\u0430\u0442\u0443: \u0442\u0440\u0435\u0442\u044C\u044F
      \u0441\u043F\u0440\u0430\u0432\u0430 \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u043C
      \u044D\u0442\u0430\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741249
    m_Localized: "\u041F\u043E\u0434\u0436\u0438\u0433\u0430\u0442\u0435\u043B\u044C
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741250
    m_Localized: "\u041B\u044E \u042F\u043E \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C: \u0427\u044D\u043D\u044C
      \u041F\u044D\u0439, \u0431\u044B\u0432\u0448\u0438\u0439 \u0441\u043A\u043B\u0430\u0434\u0441\u043A\u043E\u0439
      \u043D\u0430\u0434\u0437\u0438\u0440\u0430\u0442\u0435\u043B\u044C \u0432 \u0410\u043D\u044C\u0441\u0438,
      \u0443\u0432\u043E\u043B\u0435\u043D \u0442\u0440\u0438 \u0433\u043E\u0434\u0430
      \u043D\u0430\u0437\u0430\u0434 \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u0436\u0430\u0440\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043D \u0442\u043E\u0433\u0434\u0430
      \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u043D\u044B\u043C
      \u0441\u043B\u0443\u0447\u0430\u0435\u043C. \u0421\u043E\u0441\u0435\u0434\u0438
      \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u044E\u0442 \u0435\u0433\u043E \u043A\u0430\u043A
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u043E\u0431\u0438\u0436\u0435\u043D\u043D\u043E\u0433\u043E
      - \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C,
      \u0437\u0430\u0434\u043E\u043B\u0436\u0430\u043B \u0445\u043E\u0437\u044F\u0438\u043D\u0443
      \u0441\u043A\u043B\u0430\u0434\u0430. \u041C\u0435\u0441\u0442\u043D\u044B\u0439
      \u0441\u043E\u0442\u043D\u0438\u043A \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442:
      \u0427\u044D\u043D\u044C \u041F\u044D\u0439 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0431\u044B\u043B \u0432 \u0410\u043D\u044C\u0441\u0438 \u0432 \u0442\u0443
      \u043D\u043E\u0447\u044C. \u0422\u0435\u043F\u0435\u0440\u044C \u0443 \u041B\u044E
      \u042F\u043E \u0435\u0441\u0442\u044C \u0438\u043C\u044F, \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u044F
      \u0438 \u043C\u043E\u0442\u0438\u0432. \u041E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0440\u0435\u0448\u0438\u0442\u044C: \u0438\u0434\u0442\u0438 \u043A \u0432\u043B\u0430\u0441\u0442\u044F\u043C
      \u0438\u043B\u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u043D\u0438\u043C \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741251
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u043F\u0440\u044F\u043C\u043E\u0433\u043E
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741252
    m_Localized: "\u0427\u044D\u043D\u044C \u041F\u044D\u0439 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0432\u0441\u0442\u0440\u0435\u0447\u0443 - \u043E\u043D \u0443\u0441\u0442\u0430\u043B
      \u043F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F. \u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435
      \u0437\u0430 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u043C\u0438 \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741253
    m_Localized: "\u0412\u044B\u0431\u043E\u0440 \u0443 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741254
    m_Localized: "\u0420\u0430\u0441\u0441\u0432\u0435\u0442 \u043A\u0440\u0430\u0441\u0438\u0442
      \u0445\u0440\u0435\u0431\u0442\u044B \u0422\u044F\u043D\u044C-\u0428\u0430\u043D\u044F
      \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u044B\u043C. \u0427\u044D\u043D\u044C
      \u041F\u044D\u0439 \u0441\u0442\u043E\u0438\u0442 \u0443 \u043A\u0430\u043C\u043D\u044F,
      \u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432 \u0433\u043B\u0430\u0437\u0430.
      \u041E\u043D \u043F\u043E\u0434\u0436\u0451\u0433 \u0441\u043A\u043B\u0430\u0434
      \u0437\u0430 \u0434\u0435\u043D\u044C\u0433\u0438 - \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C
      \u0438 \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0441\u043A\u043B\u0430\u0434
      \u043F\u0443\u0441\u0442. \u041E\u043D \u043D\u0435 \u0437\u043D\u0430\u043B
      \u043E \u043B\u044E\u0434\u044F\u0445 \u0432\u043D\u0443\u0442\u0440\u0438.
      \u042D\u0442\u043E \u043D\u0435 \u0441\u043D\u0438\u043C\u0430\u0435\u0442
      \u0432\u0438\u043D\u044B, \u043D\u043E \u043C\u0435\u043D\u044F\u0435\u0442
      \u0435\u0451 \u0432\u0435\u0441. \u041B\u044E \u042F\u043E \u0434\u0435\u0440\u0436\u0438\u0442
      \u0432 \u0440\u0443\u043A\u0430\u0445 \u0432\u044B\u0431\u043E\u0440: \u0438\u043C\u044F
      \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u0430 \u0435\u0449\u0451 \u043D\u0435
      \u043F\u0440\u043E\u0438\u0437\u043D\u0435\u0441\u0435\u043D\u043E, \u0438
      \u0427\u044D\u043D\u044C \u041F\u044D\u0439 \u0433\u043E\u0442\u043E\u0432
      \u0435\u0433\u043E \u043D\u0430\u0437\u0432\u0430\u0442\u044C \u0432 \u043E\u0431\u043C\u0435\u043D
      \u043D\u0430 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435 \u043E \u0441\u0432\u043E\u0435\u0439
      \u0440\u043E\u043B\u0438. \u0412\u043B\u0430\u0441\u0442\u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0442
      \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0442\u043E\u0440\u0430; \u0438\u0441\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C
      \u0443\u0439\u0434\u0451\u0442 \u043D\u0430 \u0437\u0430\u043F\u0430\u0434
      \u0438 \u0438\u0441\u0447\u0435\u0437\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741255
    m_Localized: "\u0414\u043E\u043D\u0435\u0441\u0442\u0438 \u043D\u0430 \u043E\u0431\u043E\u0438\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741256
    m_Localized: "\u041B\u044E \u042F\u043E \u0441\u0434\u0430\u0451\u0442 \u0427\u044D\u043D\u044C
      \u041F\u044D\u044F \u0441\u043E\u0442\u043D\u0438\u043A\u0443 \u0432 \u0425\u0430\u043C\u0438
      \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u0438\u043C\u044F
      \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u0430. \u0421\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435
      \u043D\u0430\u0447\u0430\u0442\u043E. \u0421\u0435\u043C\u044C\u044F \u043F\u043E\u0433\u0438\u0431\u0448\u0438\u0445
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442 \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u044E
      - \u044D\u0442\u043E \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u043C\u0435\u0441\u044F\u0446\u044B,
      \u043D\u043E \u0437\u0430\u043A\u043E\u043D \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741257
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0432 \u043E\u0431\u043C\u0435\u043D
      \u043D\u0430 \u0438\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741258
    m_Localized: "\u0427\u044D\u043D\u044C \u041F\u044D\u0439 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u0430 \u0438 \u0443\u0445\u043E\u0434\u0438\u0442
      \u043D\u0430 \u0437\u0430\u043F\u0430\u0434 \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430.
      \u041B\u044E \u042F\u043E \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0441 \u0438\u043C\u0435\u043D\u0435\u043C \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0442\u043E\u0440\u0430
      \u0438 \u0442\u044F\u0436\u0435\u0441\u0442\u044C\u044E \u0441\u0434\u0435\u043B\u0430\u043D\u043D\u043E\u0433\u043E
      \u0432\u044B\u0431\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741259
    m_Localized: "\u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043F\u043E\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741260
    m_Localized: "\u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u044B\u0439
      \u043F\u043E\u0441\u0442 \u0443 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430
      \u0414\u0430\u0442\u0443\u043D \u0441\u0442\u043E\u0438\u0442 \u0432 \u0443\u0437\u043A\u043E\u043C
      \u0443\u0449\u0435\u043B\u044C\u0435, \u0433\u0434\u0435 \u0433\u043E\u0440\u043D\u044B\u0439
      \u0432\u0435\u0442\u0435\u0440 \u043D\u0435 \u0443\u0442\u0438\u0445\u0430\u0435\u0442
      \u0434\u0430\u0436\u0435 \u0432 \u043F\u043E\u043B\u0434\u0435\u043D\u044C.
      \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A \u043F\u043E\u0441\u0442\u0430
      - \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0442\u044B\u0441\u044F\u0447\u043D\u0438\u043A
      \u0432 \u043C\u0435\u0445\u043E\u0432\u043E\u0439 \u0448\u0430\u043F\u043A\u0435,
      \u0438\u043C\u044F \u0435\u0433\u043E \u041A\u0445\u0440\u0438-\u043B\u0434\u0435
      - \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043E\u0445\u0440\u0430\u043D\u043D\u0443\u044E \u0433\u0440\u0430\u043C\u043E\u0442\u0443
      \u0438 \u0447\u0438\u0442\u0430\u0435\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0434\u0435\u0440\u0436\u0438\u0442
      \u043F\u0438\u0441\u044C\u043C\u043E \u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u043E\u0439:
      \u043E\u043D\u043E \u0437\u0430\u0448\u0438\u0442\u043E \u0432 \u0434\u0432\u043E\u0439\u043D\u0443\u044E
      \u043F\u043E\u0434\u043A\u043B\u0430\u0434\u043A\u0443 \u0441\u0443\u043C\u043A\u0438
      \u0434\u043B\u044F \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u0432, \u0440\u044F\u0434\u043E\u043C
      \u0441 \u043A\u0443\u0441\u043A\u0430\u043C\u0438 \u0441\u044B\u0440\u043E\u0433\u043E
      \u0445\u043B\u043E\u043F\u043A\u0430. \u0412\u043E\u043F\u0440\u043E\u0441
      \u043E \u0446\u0435\u043B\u0438 \u043F\u043E\u0435\u0437\u0434\u043A\u0438
      \u0437\u0430\u0434\u0430\u043D \u0442\u0440\u0438\u0436\u0434\u044B, \u043E\u0442\u0432\u0435\u0442
      \u043E\u0434\u0438\u043D \u0438 \u0442\u043E\u0442 \u0436\u0435 - \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u044F
      \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0430 \u0434\u043B\u044F \u0434\u0430\u043C\u0430\u0441\u0441\u043A\u043E\u0433\u043E
      \u043A\u0443\u043F\u0446\u0430. \u0422\u044B\u0441\u044F\u0447\u043D\u0438\u043A
      \u041A\u0445\u0440\u0438-\u043B\u0434\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443 \u0438 \u0436\u0435\u0441\u0442\u043E\u043C
      \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043D\u0430 \u043E\u0431\u043E\u0447\u0438\u043D\u0443:
      \u0436\u0434\u0430\u0442\u044C \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741261
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0434\u043E\u0441\u043C\u043E\u0442\u0440
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741262
    m_Localized: "\u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0435 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438
      \u043F\u0440\u043E\u0449\u0443\u043F\u044B\u0432\u0430\u044E\u0442 \u0442\u044E\u043A\u0438,
      \u043D\u043E \u0445\u043B\u043E\u043F\u043A\u043E\u0432\u0430\u044F \u043D\u0430\u0431\u0438\u0432\u043A\u0430
      \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043F\u0438\u0441\u044C\u043C\u043E.
      \u041A\u0445\u0440\u0438-\u043B\u0434\u0435 \u0441\u0442\u0430\u0432\u0438\u0442
      \u043F\u0435\u0447\u0430\u0442\u044C \u043D\u0430 \u0433\u0440\u0430\u043C\u043E\u0442\u0443
      \u0438 \u043C\u0430\u0448\u0435\u0442 - \u043F\u0440\u043E\u0445\u043E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741263
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u0447\u0435\u0440\u0435\u0437
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741264
    m_Localized: "\u041F\u043E \u0434\u0440\u0443\u0433\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430 \u0432\u0435\u0442\u0435\u0440
      \u0441\u0442\u0438\u0445\u0430\u0435\u0442. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u043F\u0438\u0441\u044C\u043C\u043E
      \u0438\u0437 \u043F\u043E\u0434\u043A\u043B\u0430\u0434\u043A\u0438 \u0438
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442 \u043F\u0435\u0447\u0430\u0442\u044C:
      \u0432\u043E\u0441\u043A \u0446\u0435\u043B, \u043D\u0438 \u0442\u0440\u0435\u0449\u0438\u043D\u044B.
      \u041F\u0438\u0441\u044C\u043C\u043E \u0430\u0434\u0440\u0435\u0441\u043E\u0432\u0430\u043D\u043E
      \u0442\u0430\u043D\u0441\u043A\u043E\u043C\u0443 \u0441\u0430\u043D\u043E\u0432\u043D\u0438\u043A\u0443
      \u0432 \u0421\u0438\u0430\u043D\u0438 - \u0440\u0435\u0447\u044C \u0438\u0434\u0451\u0442
      \u043E \u0432\u043E\u0437\u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0438
      \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0430
      \u043C\u0435\u0436\u0434\u0443 \u0414\u0430\u043C\u0430\u0441\u043A\u043E\u043C
      \u0438 \u0427\u0430\u043D\u044A\u0430\u043D\u044C\u044E \u0447\u0435\u0440\u0435\u0437
      \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u0438\u0434\u043E\u0440.
      \u0415\u0441\u043B\u0438 \u0441\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435
      \u0441\u043E\u0441\u0442\u043E\u0438\u0442\u0441\u044F, \u043C\u0438\u0440\u043D\u044B\u0439
      \u043F\u0440\u043E\u0445\u043E\u0434 \u0434\u043B\u044F \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0445
      \u0438 \u0430\u0440\u0430\u0431\u0441\u043A\u0438\u0445 \u043A\u0443\u043F\u0446\u043E\u0432
      \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F \u043D\u0430 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u043B\u0435\u0442. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u043F\u0438\u0441\u044C\u043C\u043E \u043E\u0431\u0440\u0430\u0442\u043D\u043E:
      \u0434\u043E \u0421\u0438\u0430\u043D\u0438 \u0435\u0449\u0451 \u0434\u0432\u0430
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0433\u043E\u0440\u043D\u044B\u0435 \u043F\u0430\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741265
    m_Localized: "\u0418\u0434\u0442\u0438 \u043D\u0430 \u0421\u0438\u0430\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741266
    m_Localized: "\u0413\u043E\u0440\u043D\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430
      \u0441\u0443\u0436\u0430\u0435\u0442\u0441\u044F \u043A \u0432\u0435\u0447\u0435\u0440\u0443,
      \u043D\u043E \u0437\u0432\u0451\u0437\u0434\u044B \u0447\u0438\u0441\u0442\u044B\u0435.
      \u041F\u0438\u0441\u044C\u043C\u043E \u0432 \u0441\u043E\u0445\u0440\u0430\u043D\u043D\u043E\u0441\u0442\u0438,
      \u0438 \u0446\u0435\u043B\u044C \u0432\u0438\u0434\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741267
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u0432\u0440\u0443\u0447\u0435\u043D\u043E
      \u0432 \u0421\u0438\u0430\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741268
    m_Localized: "\u041F\u043E\u043A\u043E\u0438 \u0441\u0430\u043D\u043E\u0432\u043D\u0438\u043A\u0430
      \u041F\u044D\u0439 \u041A\u0443\u0430\u043D\u044F \u043F\u0430\u0445\u043D\u0443\u0442
      \u0441\u0430\u043D\u0434\u0430\u043B\u043E\u043C \u0438 \u0447\u0435\u0440\u043D\u0438\u043B\u0430\u043C\u0438
      - \u0442\u0438\u043F\u0438\u0447\u043D\u044B\u0439 \u0437\u0430\u043F\u0430\u0445
      \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430, \u0433\u0434\u0435 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044E\u0442
      \u0438\u043D\u043E\u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435 \u043F\u043E\u0441\u043E\u043B\u044C\u0441\u0442\u0432\u0430.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442
      \u043F\u0438\u0441\u044C\u043C\u043E \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C,
      \u0434\u0435\u0440\u0436\u0430 \u0435\u0433\u043E \u043E\u0431\u0435\u0438\u043C\u0438
      \u0440\u0443\u043A\u0430\u043C\u0438, - \u0442\u0430\u043A \u043F\u0440\u0438\u043D\u044F\u0442\u043E
      \u0432 \u0442\u0430\u043D\u0441\u043A\u043E\u043C \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u0435.
      \u041F\u044D\u0439 \u041A\u0443\u0430\u043D\u044C \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u0447\u0438\u0442\u0430\u0435\u0442
      \u0434\u0432\u0430\u0436\u0434\u044B, \u0437\u0430\u0442\u0435\u043C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0432\u0437\u0433\u043B\u044F\u0434: \u0434\u0430\u043C\u0430\u0441\u0441\u043A\u0430\u044F
      \u0441\u0442\u043E\u0440\u043E\u043D\u0430 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043B\u0430
      \u0432\u0441\u0435 \u0442\u0440\u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F
      \u0431\u0435\u0437 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439.
      \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u0434\u043E\u0433\u043E\u0432\u043E\u0440
      \u0432\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0432 \u0441\u0438\u043B\u0443
      \u043F\u043E\u0441\u043B\u0435 \u043E\u0431\u043C\u0435\u043D\u0430 \u0440\u0430\u0442\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u043C\u0438
      \u0433\u0440\u0430\u043C\u043E\u0442\u0430\u043C\u0438. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0438\u0437 \u043F\u043E\u043A\u043E\u0435\u0432
      \u0432 \u0432\u0435\u0447\u0435\u0440\u043D\u0438\u0439 \u0421\u0438\u0430\u043D\u044C,
      \u0433\u0434\u0435 \u0431\u0430\u0437\u0430\u0440\u043D\u044B\u0439 \u0448\u0443\u043C
      \u0435\u0449\u0451 \u043D\u0435 \u0443\u0442\u0438\u0445, \u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442:
      \u0434\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0447\u0435\u0440\u0435\u0437 \u0422\u0438\u0431\u0435\u0442
      \u0434\u043E\u043A\u0430\u0437\u0430\u043D \u043D\u0430 \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741269
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435
      \u043C\u0438\u0441\u0441\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741270
    m_Localized: "\u041F\u044D\u0439 \u041A\u0443\u0430\u043D\u044C \u0432\u0440\u0443\u0447\u0430\u0435\u0442
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D\u0443 \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0443
      \u0441 \u043B\u0438\u0447\u043D\u043E\u0439 \u043F\u0435\u0447\u0430\u0442\u044C\u044E:
      \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0433\u043E \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u044F,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043E\u0442\u043A\u0440\u043E\u0435\u0442
      \u0444\u0438\u043D\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
      \u0434\u043B\u044F \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0440\u0435\u0439\u0441\u0430 \u043F\u043E \u044D\u0442\u043E\u043C\u0443
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741271
    m_Localized: "\u0420\u044B\u0447\u0430\u0433\u0438 \u043D\u0430 \u0410\u0431\u0443
      \u0411\u0430\u043A\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741272
    m_Localized: "\u041A\u043E\u0440\u0447\u043C\u0430 \u043D\u0430 \u043E\u043A\u0440\u0430\u0438\u043D\u0435
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430 \u043F\u043E\u043B\u043D\u0430
      \u0437\u0430\u043F\u0430\u0445\u043E\u0432 \u0434\u044B\u043C\u0430 \u0438
      \u043F\u0440\u043E\u0433\u043E\u0440\u043A\u043B\u043E\u0433\u043E \u043C\u0430\u0441\u043B\u0430.
      \u0421\u0430\u0434\u0438\u0440\u0430 \u0430\u043B-\u0417\u0430\u0445\u0440\u0430
      \u0440\u0430\u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043D\u0430
      \u0441\u0442\u043E\u043B\u0435 \u0442\u043E, \u0447\u0442\u043E \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0437\u0430 \u0434\u0432\u0435
      \u043D\u0435\u0434\u0435\u043B\u0438: \u0434\u043E\u043B\u0433\u043E\u0432\u0430\u044F
      \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0430 \u0410\u0431\u0443 \u0411\u0430\u043A\u0440\u0430
      \u043F\u0435\u0440\u0435\u0434 \u0445\u043E\u0440\u0435\u0437\u043C\u0438\u0439\u0441\u043A\u0438\u043C
      \u043C\u0435\u043D\u044F\u043B\u044C\u0449\u0438\u043A\u043E\u043C, \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435
      \u043D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0430 \u043E \u0433\u0440\u0443\u0437\u0435
      \u0431\u0435\u0437 \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u044B\u0445
      \u043C\u0435\u0442\u043E\u043A \u0438 \u0441\u043F\u0438\u0441\u043E\u043A
      \u0438\u0437 \u043F\u044F\u0442\u0438 \u0438\u043C\u0451\u043D - \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u043E\u0432,
      \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u0410\u0431\u0443 \u0411\u0430\u043A\u0440
      \u043F\u043B\u0430\u0442\u0438\u0442 \u0437\u0430 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435.
      \u042D\u0442\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0447\u0430\u0442\u044C \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u0441 \u043F\u043E\u0437\u0438\u0446\u0438\u0438 \u0441\u0438\u043B\u044B.
      \u0412\u043E\u043F\u0440\u043E\u0441 \u0432 \u0442\u043E\u043C, \u0447\u0435\u0433\u043E
      \u043E\u043D\u0430 \u0445\u043E\u0447\u0435\u0442: \u0434\u0435\u043D\u0435\u0433
      \u0438\u043B\u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u044B \u043E\u0442
      \u0434\u043E\u043B\u0433\u0430 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741273
    m_Localized: "\u041D\u0430\u0437\u043D\u0430\u0447\u0438\u0442\u044C \u0432\u0441\u0442\u0440\u0435\u0447\u0443
      \u0441 \u0410\u0431\u0443 \u0411\u0430\u043A\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741274
    m_Localized: "\u0421\u0430\u0434\u0438\u0440\u0430 \u043F\u043E\u0441\u044B\u043B\u0430\u0435\u0442
      \u0435\u043C\u0443 \u0437\u0430\u043F\u0438\u0441\u043A\u0443 \u0447\u0435\u0440\u0435\u0437
      \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430.
      \u041E\u0442\u0432\u0435\u0442 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442
      \u043A \u0432\u0435\u0447\u0435\u0440\u0443: \u0410\u0431\u0443 \u0411\u0430\u043A\u0440
      \u0441\u043E\u0433\u043B\u0430\u0441\u0435\u043D \u043D\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0443
      \u0432 \u0442\u0440\u0438 \u0447\u0430\u0441\u0430 \u0434\u043D\u044F \u0443
      \u0444\u043E\u043D\u0442\u0430\u043D\u0430 \u0432 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C
      \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741275
    m_Localized: "\u041A\u043E\u043C\u043F\u0440\u043E\u043C\u0430\u0442 \u0432 \u0440\u0443\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741276
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0443 \u0444\u043E\u043D\u0442\u0430\u043D\u0430
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0431\u044B\u0441\u0442\u0440\u043E.
      \u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u0432\u044B\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0435\u0442
      \u043F\u0435\u0440\u0435\u0447\u0435\u043D\u044C \u0431\u0435\u0437 \u0435\u0434\u0438\u043D\u043E\u0433\u043E
      \u0441\u043B\u043E\u0432\u0430 - \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0434\u043E\u043B\u0433\u043E\u0432\u0443\u044E \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0443
      \u0438 \u0441\u043D\u043E\u0432\u0430 \u043D\u0430 \u0421\u0430\u0434\u0438\u0440\u0443.
      \u041E\u043D \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442 \u043E\u0434\u043D\u043E:
      \u043E\u0442\u043A\u0443\u0434\u0430 \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0430
      \u0443 \u043D\u0435\u0451. \u0421\u0430\u0434\u0438\u0440\u0430 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442:
      \u044D\u0442\u043E \u043D\u0435 \u0432\u0430\u0436\u043D\u043E - \u0432\u0430\u0436\u043D\u043E,
      \u0447\u0442\u043E \u043E\u043D\u0430 \u0433\u043E\u0442\u043E\u0432\u0430
      \u0435\u0451 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0432 \u043E\u0431\u043C\u0435\u043D
      \u043D\u0430 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F.
      \u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u0443\u0445\u043E\u0434\u0438\u0442,
      \u043D\u0435 \u043F\u0440\u043E\u0449\u0430\u044F\u0441\u044C. \u042D\u0442\u043E
      \u043D\u0435 \u043F\u0440\u043E\u0432\u0430\u043B: \u0435\u0433\u043E \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435
      \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442, \u0447\u0442\u043E \u043E\u043D
      \u0432\u0437\u0432\u0435\u0448\u0438\u0432\u0430\u0435\u0442. \u0421\u0430\u0434\u0438\u0440\u0430
      \u0434\u0430\u0451\u0442 \u0435\u043C\u0443 \u0434\u0432\u0430 \u0434\u043D\u044F
      - \u043F\u043E\u0442\u043E\u043C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
      \u0443\u0445\u043E\u0434\u044F\u0442 \u0432 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439
      \u0441\u043E\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741277
    m_Localized: "\u0416\u0434\u0430\u0442\u044C \u043E\u0442\u0432\u0435\u0442\u0430
      \u0434\u0432\u0430 \u0434\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741278
    m_Localized: "\u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u043F\u0440\u0438\u0448\u043B\u0451\u0442
      \u043F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A\u0430 - \u043D\u0435
      \u0441\u0430\u043C. \u042D\u0442\u043E \u0435\u0433\u043E \u0441\u0442\u0438\u043B\u044C.
      \u0421\u0430\u0434\u0438\u0440\u0430 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741279
    m_Localized: "\u0420\u0430\u0441\u0447\u0451\u0442 \u0441 \u0410\u0431\u0443
      \u0411\u0430\u043A\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741280
    m_Localized: "\u041F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A \u0410\u0431\u0443
      \u0411\u0430\u043A\u0440\u0430 - \u043D\u0435\u043C\u043E\u043B\u043E\u0434\u043E\u0439
      \u0441\u043E\u0433\u0434\u0438\u0435\u0446 \u0425\u0443\u0440\u043C\u0443\u0437\u0434
      - \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 \u043E\u0442\u0432\u0435\u0442
      \u0432 \u0432\u0438\u0434\u0435 \u043A\u043E\u0436\u0430\u043D\u043E\u0433\u043E
      \u043C\u0435\u0448\u043E\u0447\u043A\u0430 \u0438 \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u043D\u043E\u0433\u043E
      \u043B\u0438\u0441\u0442\u0430. \u0412 \u043C\u0435\u0448\u043E\u0447\u043A\u0435
      \u0440\u043E\u0432\u043D\u043E \u0442\u0430 \u0441\u0443\u043C\u043C\u0430,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0421\u0430\u0434\u0438\u0440\u0430
      \u043D\u0430\u0437\u0432\u0430\u043B\u0430; \u0432 \u043B\u0438\u0441\u0442\u0435
      - \u043E\u0442\u043A\u0430\u0437 \u043E\u0442 \u043F\u0440\u0435\u0442\u0435\u043D\u0437\u0438\u0439,
      \u0437\u0430\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0439 \u0438\u043C\u0435\u043D\u043D\u043E\u0439
      \u043F\u0435\u0447\u0430\u0442\u044C\u044E \u0410\u0431\u0443 \u0411\u0430\u043A\u0440\u0430.
      \u0414\u043E\u043B\u0433 \u0430\u043D\u043D\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D.
      \u0425\u0443\u0440\u043C\u0443\u0437\u0434 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0442\u0438\u0445\u043E: \u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u043F\u0440\u043E\u0441\u0438\u0442
      \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C, \u0447\u0442\u043E \u043E\u043D
      \u0443\u043C\u0435\u0435\u0442 \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u043F\u043E\u0442\u0435\u0440\u0438.
      \u0421\u0430\u0434\u0438\u0440\u0430 \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442
      \u043C\u043E\u043D\u0435\u0442\u044B, \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u044F\u0441\u044C,
      \u043F\u0440\u0438 \u0425\u0443\u0440\u043C\u0443\u0437\u0434\u0435 - \u044D\u0442\u043E
      \u0442\u043E\u0436\u0435 \u0447\u0430\u0441\u0442\u044C \u044F\u0437\u044B\u043A\u0430
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u043E\u0432. \u041F\u043E\u0442\u043E\u043C
      \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u043B\u0438\u0441\u0442 \u0438
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0434\u043E\u043B\u0433\u043E\u0432\u0443\u044E
      \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0443. \u0414\u0435\u043B\u043E
      \u0437\u0430\u043A\u0440\u044B\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741281
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0440\u0430\u0441\u0447\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741282
    m_Localized: "\u0421\u0430\u0434\u0438\u0440\u0430 \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u0434\u0435\u043D\u044C\u0433\u0438 \u0438 \u0431\u0443\u043C\u0430\u0433\u0443.
      \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C \u0447\u0435\u0440\u0435\u0437
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434 \u0442\u0435\u043F\u0435\u0440\u044C
      \u043E\u0442\u043A\u0440\u044B\u0442 \u0431\u0435\u0437 \u043F\u0440\u0435\u0436\u043D\u0438\u0445
      \u043E\u0431\u0440\u0435\u043C\u0435\u043D\u0435\u043D\u0438\u0439, \u0438
      \u0435\u0451 \u0438\u043C\u044F \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435
      \u0441\u0432\u044F\u0437\u0430\u043D\u043E \u0441 \u0434\u043E\u043B\u0433\u043E\u043C
      \u0410\u0431\u0443 \u0411\u0430\u043A\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741283
    m_Localized: "\u0412\u0442\u043E\u0440\u0430\u044F \u0441\u0435\u043C\u044C\u044F
      \u0432 \u0426\u0437\u044E\u0446\u044E\u0430\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741284
    m_Localized: "\u0426\u0437\u044E\u0446\u044E\u0430\u043D\u044C \u0441\u0442\u043E\u0438\u0442
      \u043D\u0430 \u0437\u0430\u043F\u0430\u0434\u043D\u043E\u043C \u043A\u0440\u0430\u044E
      \u0413\u0430\u043D\u044C\u0441\u0443, \u0433\u0434\u0435 \u043E\u0430\u0437\u0438\u0441
      \u0443\u043F\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u044E.
      \u0417\u0430\u043F\u0430\u0445 \u0430\u0440\u044B\u043A\u043E\u0432 \u0438
      \u0446\u0432\u0435\u0442\u0443\u0449\u0435\u0433\u043E \u0442\u043E\u043F\u043E\u043B\u044F.
      \u041C\u0430 \u0426\u044F\u043D \u0440\u0430\u0441\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u0432 \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0435 \u043A\u043E\u0436\u0435\u0432\u043D\u0438\u043A\u043E\u0432
      - \u0442\u0443\u0434\u0430 \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B,
      \u043F\u043E \u0441\u043B\u043E\u0432\u0430\u043C \u043B\u0430\u0432\u043E\u0447\u043D\u0438\u043A\u0430
      \u0438\u0437 \u041C\u0430\u043D\u044C\u0433\u0443, \u0431\u044B\u0432\u0448\u0438\u0439
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043F\u043E \u0438\u043C\u0435\u043D\u0438
      \u041B\u044E \u041F\u044D\u043D. \u041D\u0430\u0448\u0451\u043B \u0435\u0433\u043E
      \u0447\u0435\u0440\u0435\u0437 \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u0447\u0438\u043A\u0430
      \u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043A\u043D\u0438\u0433:
      \u041B\u044E \u041F\u044D\u043D, \u0441\u043E\u0440\u043E\u043A \u043E\u0434\u0438\u043D
      \u0433\u043E\u0434, \u0436\u0435\u043D\u0430 \u0421\u044E\u0439, \u0434\u0432\u043E\u0435
      \u0434\u0435\u0442\u0435\u0439. \u0414\u043E\u043C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439,
      \u043D\u043E \u043A\u0440\u0435\u043F\u043A\u0438\u0439, \u043A\u0440\u044B\u0448\u0430
      \u043D\u043E\u0432\u0430\u044F. \u041C\u0430 \u0426\u044F\u043D \u0441\u0442\u043E\u0438\u0442
      \u0443 \u043A\u0430\u043B\u0438\u0442\u043A\u0438 \u0438 \u0434\u0443\u043C\u0430\u0435\u0442:
      \u044D\u0442\u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043F\u0440\u0438\u043D\u044F\u043B
      \u0434\u0435\u043D\u044C\u0433\u0438 \u0438\u0437 \u0435\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      - \u0438 \u0432\u044B\u0441\u0442\u0440\u043E\u0438\u043B \u043D\u0430 \u043D\u0438\u0445
      \u0436\u0438\u0437\u043D\u044C. \u041D\u0435\u043B\u044C\u0437\u044F \u0437\u0430\u0431\u0440\u0430\u0442\u044C
      \u0434\u043E\u043C, \u043D\u043E \u0434\u043E\u043B\u0433 \u043F\u0440\u0438\u0437\u043D\u0430\u0442\u044C
      \u043D\u0430\u0434\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741285
    m_Localized: "\u041F\u043E\u0441\u0442\u0443\u0447\u0430\u0442\u044C \u0432 \u0434\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741286
    m_Localized: "\u041B\u044E \u041F\u044D\u043D \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0441\u0430\u043C. \u041E\u043D \u0443\u0437\u043D\u0430\u0451\u0442 \u041C\u0430
      \u0426\u044F\u043D\u0430 - \u043F\u043E \u0433\u043B\u0430\u0437\u0430\u043C
      \u0432\u0438\u0434\u043D\u043E. \u041C\u043E\u043B\u0447\u0430\u043D\u0438\u0435
      \u0434\u043B\u0438\u0442\u0441\u044F \u0434\u043E\u043B\u0433\u043E, \u043F\u043E\u0442\u043E\u043C
      \u043E\u043D \u0434\u0435\u043B\u0430\u0435\u0442 \u0448\u0430\u0433 \u0432
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443: \u0432\u043E\u0439\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741287
    m_Localized: "\u0421\u043B\u043E\u0432\u043E \u0441\u043A\u0430\u0437\u0430\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741288
    m_Localized: "\u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0441 \u041B\u044E
      \u041F\u044D\u043D\u043E\u043C \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442
      \u0447\u0430\u0441. \u0416\u0435\u043D\u0430 \u0443\u0445\u043E\u0434\u0438\u0442
      \u0441 \u0434\u0435\u0442\u044C\u043C\u0438 \u0432 \u0441\u043E\u0441\u0435\u0434\u043D\u044E\u044E
      \u043A\u043E\u043C\u043D\u0430\u0442\u0443. \u041B\u044E \u041F\u044D\u043D
      \u043D\u0435 \u043E\u043F\u0440\u0430\u0432\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F:
      \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0434\u0435\u043D\u044C\u0433\u0438,
      \u043E\u043D \u0437\u043D\u0430\u043B, \u043E\u0442\u043A\u0443\u0434\u0430
      \u043E\u043D\u0438. \u0413\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u043E\u043B\u044C\u043A\u043E,
      \u0447\u0442\u043E \u0442\u043E\u0433\u0434\u0430 \u0443 \u043D\u0435\u0433\u043E
      \u043D\u0435 \u0431\u044B\u043B\u043E \u0432\u044B\u0431\u043E\u0440\u0430.
      \u041C\u0430 \u0426\u044F\u043D \u043D\u0435 \u0441\u043F\u043E\u0440\u0438\u0442
      - \u043E\u043D \u0441\u0430\u043C \u0437\u043D\u0430\u0435\u0442, \u043A\u0430\u043A
      \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
      \u0432\u044B\u0431\u043E\u0440\u0430. \u041B\u044E \u041F\u044D\u043D \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0447\u0430\u0441\u0442\u044C:
      \u043C\u0435\u0434\u044C\u044E, \u043A\u043E\u0436\u0435\u0432\u0435\u043D\u043D\u044B\u043C
      \u0442\u043E\u0432\u0430\u0440\u043E\u043C, \u0442\u0440\u0443\u0434\u043E\u043C
      - \u043B\u0438\u0448\u044C \u0431\u044B \u0437\u0430\u043A\u0440\u044B\u0442\u044C
      \u0441\u0447\u0451\u0442. \u041C\u0430 \u0426\u044F\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442:
      \u0432 \u0425\u0430\u043C\u0438 \u0436\u0438\u0432\u0451\u0442 \u0442\u0440\u0435\u0442\u044C\u044F
      \u0441\u0435\u043C\u044C\u044F, \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u0434\u0435\u043D\u044C\u0433\u0438 \u043D\u0443\u0436\u043D\u044B \u0431\u043E\u043B\u044C\u0448\u0435.
      \u041B\u044E \u041F\u044D\u043D \u043A\u0438\u0432\u0430\u0435\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741289
    m_Localized: "\u041D\u0430\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u0432 \u0425\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741290
    m_Localized: "\u041B\u044E \u041F\u044D\u043D \u043E\u0431\u0435\u0449\u0430\u0435\u0442
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0441\u0432\u043E\u044E
      \u0434\u043E\u043B\u044E \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E \u0432
      \u0425\u0430\u043C\u0438 \u0447\u0435\u0440\u0435\u0437 \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0433\u043E
      \u043A\u0443\u043F\u0446\u0430. \u041C\u0430 \u0426\u044F\u043D \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
      \u0438\u043C\u044F \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044F
      \u0438 \u0432\u044B\u0445\u043E\u0434\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741291
    m_Localized: "\u0422\u0440\u0435\u0442\u044C\u044F \u0441\u0435\u043C\u044C\u044F
      \u0432 \u0425\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741292
    m_Localized: "\u0421\u0435\u043C\u044C\u044F \u0427\u0436\u0430\u043D \u0436\u0438\u0432\u0451\u0442
      \u0432 \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0435 \u0433\u043E\u043D\u0447\u0430\u0440\u043E\u0432
      \u0425\u0430\u043C\u0438. \u0412\u0434\u043E\u0432\u0430, \u0442\u0440\u043E\u0435
      \u0432\u0437\u0440\u043E\u0441\u043B\u044B\u0445 \u0434\u0435\u0442\u0435\u0439,
      \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u0432 \u043F\u043E\u043B\u0442\u043E\u0440\u0430
      \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F. \u041C\u0430 \u0426\u044F\u043D
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u0441 \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438
      - \u043C\u043E\u043D\u0435\u0442\u044B \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043D\u044B,
      \u043C\u0435\u0448\u043E\u0447\u0435\u043A \u0437\u0430\u0432\u044F\u0437\u0430\u043D.
      \u0412\u0434\u043E\u0432\u0430 \u0427\u0436\u0430\u043D \u0432\u044B\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0435\u0442
      \u043C\u043E\u043B\u0447\u0430, \u043F\u043E\u0442\u043E\u043C \u043A\u0430\u0447\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439: \u043D\u0435\u0442. \u041E\u043D\u0430
      \u043D\u0435 \u0432\u043E\u0437\u044C\u043C\u0451\u0442 \u0434\u0435\u043D\u044C\u0433\u0438
      \u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0438\u0437
      \u0442\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0435\u0451 \u043C\u0443\u0436
      \u043F\u043E\u0433\u0438\u0431 \u043D\u0435 \u0438\u0437-\u0437\u0430 \u043D\u0435\u0445\u0432\u0430\u0442\u043A\u0438
      \u0441\u0435\u0440\u0435\u0431\u0440\u0430 - \u043E\u043D \u043F\u043E\u0433\u0438\u0431,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043A\u0442\u043E-\u0442\u043E
      \u0440\u0435\u0448\u0438\u043B, \u0447\u0442\u043E \u0434\u043E\u0440\u043E\u0433\u0430
      \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442 \u0435\u043C\u0443
      \u043E\u0434\u043D\u043E\u043C\u0443. \u0414\u0435\u043D\u044C\u0433\u0438
      \u044D\u0442\u043E\u0433\u043E \u043D\u0435 \u0438\u0441\u043F\u0440\u0430\u0432\u044F\u0442.
      \u041C\u0430 \u0426\u044F\u043D \u0441\u0442\u043E\u0438\u0442 \u0441 \u043C\u0435\u0448\u043E\u0447\u043A\u043E\u043C
      \u0432 \u0440\u0443\u043A\u0435 \u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442:
      \u043D\u0435 \u0432\u0441\u044F\u043A\u0438\u0439 \u0434\u043E\u043B\u0433
      \u043C\u043E\u0436\u043D\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u043C\u043E\u043D\u0435\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741293
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438
      \u0434\u0435\u0442\u044F\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741294
    m_Localized: "\u041C\u0430 \u0426\u044F\u043D \u043A\u043B\u0430\u0434\u0451\u0442
      \u043C\u0435\u0448\u043E\u0447\u0435\u043A \u043D\u0430 \u0441\u0442\u043E\u043B,
      \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u044F \u043D\u0438 \u0441\u043B\u043E\u0432\u0430.
      \u0412\u0434\u043E\u0432\u0430 \u0427\u0436\u0430\u043D \u043D\u0435 \u0431\u0435\u0440\u0451\u0442
      \u0435\u0433\u043E - \u043D\u043E \u0438 \u043D\u0435 \u0432\u044B\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u0441\u044B\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0434\u0435\u043D\u044C\u0433\u0438 \u043C\u043E\u043B\u0447\u0430.
      \u041C\u0430 \u0426\u044F\u043D \u0432\u044B\u0445\u043E\u0434\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741295
    m_Localized: "\u0414\u043E\u0432\u0435\u0440\u0438\u0435 \u043C\u043E\u043D\u0430\u0445\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741296
    m_Localized: "\u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u0411\u0430\u0439\u043C\u0430
      \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F \u041B\u044F\u043E\u0448\u0430\u043D\u044F
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u043E\u0432,
      \u043D\u043E \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u0438 \u0445\u0440\u0430\u043D\u0438\u0442
      \u0441\u0442\u0440\u043E\u0433\u043E: \u0434\u043E\u0441\u0442\u0443\u043F
      \u043A \u043A\u043D\u0438\u0433\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0443
      \u043E\u0442\u043A\u0440\u044B\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u043C,
      \u043A\u0442\u043E \u043F\u0440\u043E\u0431\u044B\u043B \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0435
      \u0442\u0440\u0438 \u0434\u043D\u044F \u0438 \u043F\u043E\u043C\u043E\u0433
      \u0432 \u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u0435. \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442 \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0441\u043B\u043E\u0432: \u043D\u0443\u0436\u043D\u043E \u043A\u043E\u043B\u043E\u0442\u044C
      \u0434\u0440\u043E\u0432\u0430, \u043D\u043E\u0441\u0438\u0442\u044C \u0432\u043E\u0434\u0443,
      \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0432 \u0443\u0442\u0440\u0435\u043D\u043D\u0435\u043C
      \u0447\u0442\u0435\u043D\u0438\u0438 \u0441\u0443\u0442\u0440. \u0417\u0430\u043F\u0430\u0445
      \u0441\u0432\u0435\u0436\u0435\u0439 \u0441\u043E\u0441\u043D\u044B \u0438
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0441\u043A\u043E\u0439 \u043A\u0443\u0445\u043D\u0438
      - \u0433\u0440\u0435\u0447\u043D\u0435\u0432\u0430\u044F \u043A\u0430\u0448\u0430
      \u0441 \u0441\u0435\u043C\u0435\u043D\u0430\u043C\u0438 \u043A\u043E\u043D\u043E\u043F\u043B\u0438
      - \u043E\u0442\u043C\u0435\u0447\u0430\u0435\u0442 \u043A\u0430\u0436\u0434\u043E\u0435
      \u0443\u0442\u0440\u043E. \u041D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C
      \u0425\u0443\u044D\u0439 \u0413\u0443\u0430\u043D \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u0442
      \u043D\u0435\u043D\u0430\u0432\u044F\u0437\u0447\u0438\u0432\u043E: \u043E\u043D
      \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u0442 \u043D\u0435 \u0443\u043C\u0435\u043D\u0438\u044F,
      \u0430 \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741297
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0442\u0440\u0438 \u0434\u043D\u044F
      \u0441\u043B\u0443\u0436\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741298
    m_Localized: "\u041D\u0430 \u0442\u0440\u0435\u0442\u044C\u0435 \u0443\u0442\u0440\u043E
      \u043D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C \u0425\u0443\u044D\u0439
      \u0413\u0443\u0430\u043D \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043F\u043E\u0441\u043B\u0435
      \u0447\u0442\u0435\u043D\u0438\u044F \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043A\u043E\u0440\u043E\u0442\u043A\u043E: \u043A\u043D\u0438\u0433\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435
      \u043E\u0442\u043A\u0440\u044B\u0442\u043E \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u043B\u0443\u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741299
    m_Localized: "\u0412\u0442\u043E\u0440\u0430\u044F \u0447\u0430\u0441\u0442\u044C
      \u043D\u0430\u0439\u0434\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741300
    m_Localized: "\u041A\u043D\u0438\u0433\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F \u0411\u0430\u0439\u043C\u0430
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0432\u043E\u0441\u043A\u043E\u043C \u0438
      \u0441\u0443\u0445\u0438\u043C \u0434\u0435\u0440\u0435\u0432\u043E\u043C.
      \u0420\u0443\u043A\u043E\u043F\u0438\u0441\u0438 \u043F\u0440\u043E\u043D\u0443\u043C\u0435\u0440\u043E\u0432\u0430\u043D\u044B
      \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0441\u043A\u043E\u043C
      \u043A\u0430\u0442\u0430\u043B\u043E\u0433\u0435. \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442 \u043D\u0443\u0436\u043D\u044B\u0439
      \u0441\u0432\u0438\u0442\u043E\u043A \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439
      \u043F\u043E\u043B\u043A\u0435 \u0441\u043B\u0435\u0432\u0430: \u0432\u0442\u043E\u0440\u0430\u044F
      \u0447\u0430\u0441\u0442\u044C \u0442\u0440\u0430\u043A\u0442\u0430\u0442\u0430
      \u0430\u043B-\u0411\u0443\u0445\u0430\u0440\u0438, \u043F\u0435\u0440\u0435\u043F\u043B\u0435\u0442\u0451\u043D\u043D\u0430\u044F
      \u0441 \u0431\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u043E\u0439 \u0441\u0443\u0442\u0440\u043E\u0439
      \u0432 \u043E\u0434\u043D\u043E\u043C \u043F\u0435\u0440\u0435\u043F\u043B\u0451\u0442\u0435
      - \u0442\u0430\u043A \u043F\u043E\u043F\u0430\u043B\u0430 \u043A \u043C\u043E\u043D\u0430\u0445\u0430\u043C,
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0435\u043C
      \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0430 \u0438\u0437 \u0425\u043E\u0442\u0430\u043D\u0430.
      \u041F\u043E\u0447\u0435\u0440\u043A \u043E\u0442\u0446\u0430, \u0442\u0430
      \u0436\u0435 \u043C\u0435\u0434\u043D\u0430\u044F \u0442\u0443\u0448\u044C,
      \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0435 \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0435
      \u0440\u0430\u0437\u0434\u0435\u043B\u043E\u0432. \u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F
      \u043E\u0442 \u041B\u0430\u043D\u044C\u0447\u0436\u043E\u0443 \u0434\u043E
      \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0430 \u0441 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u044B\u043C\u0438
      \u0446\u0435\u043D\u0430\u043C\u0438 \u043D\u0430 \u0432\u043E\u0434\u0443
      \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0435\u0432 \u0438 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F\u043C\u0438
      \u043C\u0435\u0436\u0434\u0443 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u043C\u0438
      \u0434\u0432\u043E\u0440\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741301
    m_Localized: "\u041F\u0435\u0440\u0435\u043F\u0438\u0441\u0430\u0442\u044C \u0438\u043B\u0438
      \u0432\u044B\u043A\u0443\u043F\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741302
    m_Localized: "\u041D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C \u0425\u0443\u044D\u0439
      \u0413\u0443\u0430\u043D \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u043A\u0443 \u043F\u0440\u0438
      \u0443\u0441\u043B\u043E\u0432\u0438\u0438, \u0447\u0442\u043E \u043A\u043E\u043F\u0438\u044F
      \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0435.
      \u041E\u0440\u0438\u0433\u0438\u043D\u0430\u043B \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0437\u0434\u0435\u0441\u044C. \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u0431\u0435\u0440\u0451\u0442\u0441\u044F \u0437\u0430 \u043F\u0435\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741303
    m_Localized: "\u0421\u043E\u043F\u0435\u0440\u043D\u0438\u043A \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741304
    m_Localized: "\u0420\u044B\u043D\u043E\u043A \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u0435\u0439
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0443 \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0445 \u0432\u043E\u0440\u043E\u0442
      \u043F\u043E \u043F\u044F\u0442\u043D\u0438\u0446\u0430\u043C. \u0417\u0430\u043F\u0430\u0445
      \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0430 \u0438 \u0441\u044B\u0440\u043E\u0439
      \u043A\u043E\u0436\u0438, \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B
      \u0440\u0430\u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442 \u0441\u0432\u0438\u0442\u043A\u0438
      \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u043C\u043E\u0441\u0442\u043E\u0432\u043E\u0439.
      \u0421\u043E\u043F\u0435\u0440\u043D\u0438\u043A, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u043E\u043F\u0438\u0441\u0430\u043B \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      - \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u043A\u0443\u043F\u0435\u0446
      \u0410\u0440\u0442\u0430\u0432\u0430\u0437\u0434, - \u0443\u0436\u0435 \u0434\u0435\u0440\u0436\u0438\u0442
      \u0442\u0440\u0435\u0442\u044C\u044E \u0447\u0430\u0441\u0442\u044C \u0442\u0440\u0430\u043A\u0442\u0430\u0442\u0430
      \u0430\u043B-\u0411\u0443\u0445\u0430\u0440\u0438. \u041E\u043D \u0437\u043D\u0430\u0435\u0442
      \u043E \u0440\u043E\u0437\u044B\u0441\u043A\u0435 \u0438 \u043D\u0435 \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442:
      \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C
      \u0438\u043C\u0435\u0435\u0442 \u043A\u043E\u043C\u043C\u0435\u0440\u0447\u0435\u0441\u043A\u0443\u044E
      \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C, \u0438 \u043E\u043D \u0433\u043E\u0442\u043E\u0432
      \u043F\u0440\u043E\u0434\u0430\u0442\u044C \u0435\u0451 \u043F\u043E \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435, \u043D\u043E \u0440\u044B\u043D\u043E\u0447\u043D\u0430\u044F
      \u0446\u0435\u043D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F - \u0441\u0442\u043E
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432.
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442
      \u0432\u043E\u0441\u0435\u043C\u044C\u044E\u0434\u0435\u0441\u044F\u0442\u044C\u044E.
      \u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442
      \u043D\u0435\u043F\u0440\u043E\u0441\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741305
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741306
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0447\u0430\u0441\u0430 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u043E\u0432
      \u0410\u0440\u0442\u0430\u0432\u0430\u0437\u0434 \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0434\u0435\u0432\u044F\u043D\u043E\u0441\u0442\u043E \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0438 \u0440\u0435\u0434\u043A\u0438\u0439 \u0445\u043E\u0442\u0430\u043D\u0441\u043A\u0438\u0439
      \u043D\u0435\u0444\u0440\u0438\u0442 \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435
      \u0440\u0430\u0437\u043D\u0438\u0446\u044B. \u0422\u0440\u0430\u043A\u0442\u0430\u0442
      \u0441\u043E\u0431\u0440\u0430\u043D \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741307
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0446\u0435\u043D\u043D\u044B\u0439
      \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741308
    m_Localized: "\u0410\u0440\u0442\u0430\u0432\u0430\u0437\u0434 \u0442\u043E\u0440\u0433\u0443\u0435\u0442
      \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044F\u043C\u0438 - \u0442\u043E\u0432\u0430\u0440\u043D\u044B\u0439
      \u043E\u0431\u043C\u0435\u043D \u0435\u0433\u043E \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442.
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442
      \u0435\u043C\u0443 \u0444\u0430\u0440\u0444\u043E\u0440\u043E\u0432\u043E\u0435
      \u0431\u043B\u044E\u0434\u043E \u0438\u0437 \u0414\u0438\u043D\u0447\u0436\u043E\u0443,
      \u0438 \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C \u043C\u0435\u043D\u044F\u0435\u0442
      \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741309
    m_Localized: "\u0417\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u043E\u0435
      \u043E\u0447\u0438\u0449\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741310
    m_Localized: "\u0425\u0440\u0430\u043C \u043E\u0433\u043D\u044F \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u0441\u0442\u043E\u0438\u0442 \u0443 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442, \u0437\u0430 \u0440\u044F\u0434\u0430\u043C\u0438
      \u0442\u0443\u0442\u043E\u0432\u044B\u0445 \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432.
      \u0414\u044B\u043C \u0441\u0430\u043D\u0434\u0430\u043B\u0430 \u0438 \u0441\u0443\u0445\u0438\u0445
      \u0442\u0440\u0430\u0432 \u043E\u0449\u0443\u0449\u0430\u0435\u0442\u0441\u044F
      \u0443\u0436\u0435 \u0441 \u0443\u043B\u0438\u0446\u044B. \u0416\u0440\u0435\u0446
      \u0424\u0430\u0440\u043D\u0431\u0430\u0433 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u043E\u0432 \u0432 \u043F\u043E\u043B\u0434\u0435\u043D\u044C
      \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430 \u043B\u0443\u043D\u043D\u043E\u0433\u043E
      \u043C\u0435\u0441\u044F\u0446\u0430 - \u0440\u043E\u0432\u043D\u043E \u043A\u0430\u043A
      \u0441\u043A\u0430\u0437\u0430\u043B \u043D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C
      \u0438\u0437 \u0424\u0430\u043C\u0435\u043D\u044F. \u041E\u0447\u0438\u0449\u0435\u043D\u0438\u0435
      \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437 \u0442\u0440\u0451\u0445
      \u0447\u0430\u0441\u0442\u0435\u0439: \u043E\u043C\u043E\u0432\u0435\u043D\u0438\u0435
      \u0440\u0443\u043A \u0432 \u043C\u0435\u0434\u043D\u043E\u043C \u0442\u0430\u0437\u0443
      \u0441 \u0432\u043E\u0434\u043E\u0439 \u0438\u0437 \u0433\u043E\u0440\u043D\u043E\u0433\u043E
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430, \u043E\u0431\u0445\u043E\u0434
      \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u043E\u0433\u043E \u043E\u0433\u043D\u044F
      \u0442\u0440\u0438 \u0440\u0430\u0437\u0430 \u043F\u043E \u0447\u0430\u0441\u043E\u0432\u043E\u0439
      \u0441\u0442\u0440\u0435\u043B\u043A\u0435, \u043F\u0440\u043E\u0438\u0437\u043D\u0435\u0441\u0435\u043D\u0438\u0435
      \u043C\u043E\u043B\u0438\u0442\u0432\u044B \u0430\u0432\u0435\u0441\u0442\u0438\u0439\u0441\u043A\u0438\u043C\u0438
      \u0441\u043B\u043E\u0432\u0430\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0424\u0430\u0440\u043D\u0431\u0430\u0433 \u0434\u0438\u043A\u0442\u0443\u0435\u0442
      \u043F\u043E \u043E\u0434\u043D\u043E\u0439 \u0444\u0440\u0430\u0437\u0435.
      \u041E\u0431\u0440\u044F\u0434 \u0434\u043B\u0438\u0442\u0441\u044F \u043E\u043A\u043E\u043B\u043E
      \u0447\u0430\u0441\u0430 \u0438 \u0437\u0430\u043A\u0440\u044B\u0442 \u0434\u043B\u044F
      \u043F\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289579741311
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043E\u0431\u0440\u044F\u0434
      \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935488
    m_Localized: "\u0424\u0430\u0440\u043D\u0431\u0430\u0433 \u0441\u0442\u0430\u0432\u0438\u0442
      \u0432\u0442\u043E\u0440\u0443\u044E \u043F\u0435\u0447\u0430\u0442\u044C \u043D\u0430
      \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443 - \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u0439
      \u0437\u043D\u0430\u043A \u043D\u0430 \u043A\u0440\u0430\u0441\u043D\u043E\u043C
      \u043F\u043E\u043B\u0435. \u041E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0442\u0440\u0435\u0442\u044C\u0435 \u043C\u0435\u0441\u0442\u043E: \u043C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0439
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u0432 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935489
    m_Localized: "\u0412\u0442\u043E\u0440\u043E\u0435 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935490
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0433\u0440\u0430\u043C\u043E\u0442\u0430 \u0441 \u0434\u0432\u0443\u043C\u044F
      \u043F\u0435\u0447\u0430\u0442\u044F\u043C\u0438 \u043B\u0435\u0436\u0438\u0442
      \u043F\u0435\u0440\u0435\u0434 \u0441\u0432\u0435\u0442\u0438\u043B\u044C\u043D\u0438\u043A\u043E\u043C
      \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430. \u0417\u0430\u043F\u0430\u0445 \u0441\u0430\u043D\u0434\u0430\u043B\u0430,
      \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u043D\u043D\u044B\u0439 \u0438\u0437
      \u0445\u0440\u0430\u043C\u0430, \u0441\u043C\u0435\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441 \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      - \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u044C\u0435\u0439 \u0448\u0435\u0440\u0441\u0442\u044C\u044E
      \u0438 \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439 \u043F\u044B\u043B\u044C\u044E.
      \u0424\u0430\u0440\u043D\u0431\u0430\u0433 \u0441\u043A\u0430\u0437\u0430\u043B
      \u043D\u0430\u043F\u043E\u0441\u043B\u0435\u0434\u043E\u043A: \u0432 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0435
      \u043C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0439 \u0430\u0440\u0445\u043E\u043D\u0442
      \u041C\u0430\u0440 \u0417\u0430\u043A\u0445\u0435\u0439 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u0445, \u043A\u0442\u043E
      \u043F\u0440\u0438\u0448\u0451\u043B \u0441 \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u0438\u0435\u043C,
      \u0430 \u043D\u0435 \u0441 \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u0441\u0442\u0432\u043E\u043C.
      \u041A\u0430\u043A \u044D\u0442\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442\u0441\u044F
      - \u0436\u0440\u0435\u0446 \u043D\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u0432 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D
      \u0447\u0435\u0440\u0435\u0437 \u0425\u044D\u0441\u0438-\u043A\u043E\u0440\u0438\u0434\u043E\u0440
      \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
      \u043C\u0435\u0441\u044F\u0446."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935491
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u043D\u0430 \u0425\u044D\u0441\u0438-\u043A\u043E\u0440\u0438\u0434\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935492
    m_Localized: "\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043F\u043E\u0437\u0430\u0434\u0438. \u0425\u044D\u0441\u0438-\u043A\u043E\u0440\u0438\u0434\u043E\u0440
      - \u0434\u043B\u0438\u043D\u043D\u044B\u0439, \u043F\u0440\u043E\u0434\u0443\u0432\u0430\u0435\u043C\u044B\u0439,
      \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0439 \u043D\u0430 \u0434\u0432\u0430
      \u0434\u043D\u044F \u043F\u0443\u0442\u0438 \u0432 \u043B\u044E\u0431\u0443\u044E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443 - \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0433\u043E \u043F\u0443\u0442\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935493
    m_Localized: "\u041C\u0430\u0440 \u0417\u0430\u043A\u0445\u0435\u0439 \u0432
      \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935494
    m_Localized: "\u041C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0439
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u0432 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0435
      - \u043D\u0438\u0437\u043A\u043E\u0435 \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0441 \u0431\u0435\u043B\u0451\u043D\u044B\u043C\u0438 \u0441\u0442\u0435\u043D\u0430\u043C\u0438
      \u0438 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
      \u0443\u0437\u043A\u0438\u043C \u043E\u043A\u043D\u043E\u043C, \u0432\u044B\u0445\u043E\u0434\u044F\u0449\u0438\u043C
      \u043D\u0430 \u0441\u0435\u0432\u0435\u0440. \u0410\u0440\u0445\u043E\u043D\u0442
      \u041C\u0430\u0440 \u0417\u0430\u043A\u0445\u0435\u0439 \u0441\u0442\u0430\u0440,
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043D\u0430 \u0441\u043C\u0435\u0441\u0438 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0433\u043E
      \u0438 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u0433\u043E. \u041E\u043D
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443 \u0434\u043E\u043B\u0433\u043E,
      \u043F\u043E\u0442\u043E\u043C \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u043F\u043E-\u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438: \u043A\u0430\u043A\u043E\u0435
      \u0438\u0437 \u0442\u0440\u0451\u0445 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0439
      \u0434\u0430\u043B\u043E\u0441\u044C \u0442\u0440\u0443\u0434\u043D\u0435\u0435
      \u0432\u0441\u0435\u0433\u043E. \u041D\u0435 \u043E\u0442\u0432\u0435\u0442
      \u0432\u0430\u0436\u0435\u043D - \u0432\u0430\u0436\u043D\u0430 \u043F\u0430\u0443\u0437\u0430
      \u043F\u0435\u0440\u0435\u0434 \u043E\u0442\u0432\u0435\u0442\u043E\u043C.
      \u041C\u0430\u0440 \u0417\u0430\u043A\u0445\u0435\u0439 \u0441\u0442\u0430\u0432\u0438\u0442
      \u0442\u0440\u0435\u0442\u044C\u044E \u043F\u0435\u0447\u0430\u0442\u044C \u0431\u0435\u0437
      \u0441\u043B\u043E\u0432, \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u0439
      \u0437\u043D\u0430\u043A \u0447\u0451\u0440\u043D\u044B\u043C\u0438 \u0447\u0435\u0440\u043D\u0438\u043B\u0430\u043C\u0438.
      \u0413\u0440\u0430\u043C\u043E\u0442\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430.
      \u0422\u0440\u0438 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438 \u0437\u0430\u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438
      \u043E\u0434\u043D\u043E \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935495
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0442\u0440\u0435\u0442\u044C\u044E
      \u043F\u0435\u0447\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935496
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0433\u0440\u0430\u043C\u043E\u0442\u0430 \u0441 \u0442\u0440\u0435\u043C\u044F
      \u043F\u0435\u0447\u0430\u0442\u044F\u043C\u0438 - \u0431\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u043E\u0439,
      \u0437\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u043E\u0439,
      \u043C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u043E\u0439 - \u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F
      \u0432 \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439 \u0441\u0443\u043C\u043A\u0435.
      \u041C\u0430\u0440 \u0417\u0430\u043A\u0445\u0435\u0439 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435: \u0442\u043E\u0442,
      \u043A\u0442\u043E \u043F\u0440\u043E\u0448\u0451\u043B \u0442\u0440\u0438
      \u043E\u0433\u043D\u044F, \u0443\u0436\u0435 \u0437\u043D\u0430\u0435\u0442
      \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935497
    m_Localized: "\u0417\u0430\u0434\u0435\u0440\u0436\u0430\u043D\u043D\u044B\u0439
      \u0442\u044E\u0440\u043A \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935498
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u043F\u044B\u043B\u0438 \u0438
      \u043A\u0438\u0441\u043B\u043E\u0433\u043E \u043F\u043E\u0442\u0430 - \u0434\u0432\u043E\u0435
      \u0432\u0430\u0448\u0438\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432
      \u0442\u0430\u0449\u0430\u0442 \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u043E\u0433\u043E
      \u0442\u044E\u0440\u043A\u0430 \u043A \u043E\u0431\u043E\u0447\u0438\u043D\u0435.
      \u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u043F\u0430\u0440\u0435\u043D\u044C,
      \u043D\u0435 \u0441\u0442\u0430\u0440\u0448\u0435 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438,
      \u0441\u0435\u0440\u0430\u044F \u0432\u043E\u0439\u043B\u043E\u0447\u043D\u0430\u044F
      \u0448\u0430\u043F\u043A\u0430 \u0441\u044A\u0435\u0445\u0430\u043B\u0430 \u043D\u0430\u0431\u043E\u043A,
      \u043D\u0430 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u044F\u0445 \u0441\u0432\u0435\u0436\u0438\u0435
      \u0441\u0441\u0430\u0434\u0438\u043D\u044B \u043E\u0442 \u0432\u0435\u0440\u0451\u0432\u043A\u0438.
      \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0431\u0435\u0437
      \u0441\u0442\u0440\u0430\u0445\u0430. <npc_speech lang=\"Turkic\">\u041E\u0442\u043F\u0443\u0441\u0442\u0438.
      \u042F \u043D\u0435 \u0431\u0440\u0430\u043B \u0442\u0432\u043E\u0451.</npc_speech>
      \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0442:
      \u043F\u043E\u0439\u043C\u0430\u043B\u0438 \u0435\u0433\u043E \u0443 \u0437\u0430\u0434\u043D\u0435\u0439
      \u0442\u0435\u043B\u0435\u0433\u0438, \u043D\u043E \u0433\u0440\u0443\u0437
      \u0446\u0435\u043B. \u041C\u0435\u0448\u043E\u043A \u0441 \u0435\u0433\u043E
      \u0432\u0435\u0449\u0430\u043C\u0438 - \u043A\u0443\u0441\u043E\u043A \u0432\u044F\u043B\u0435\u043D\u043E\u0439
      \u043A\u043E\u043D\u0438\u043D\u044B, \u043A\u043E\u0441\u0442\u044F\u043D\u0430\u044F
      \u0444\u043B\u0435\u0439\u0442\u0430, \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u0439
      \u043D\u043E\u0436. \u041D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u043F\u0443\u0442\u0438 \u0442\u044E\u0440\u043A\u0438 \u0434\u0435\u0440\u0436\u0430\u0442
      \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u0441\u0442\u0435\u043F\u043D\u044B\u0445
      \u043F\u043E\u0441\u0442\u043E\u0432, \u0438 \u0441\u043B\u0443\u0445 \u043E
      \u0436\u0435\u0441\u0442\u043E\u043A\u043E\u0441\u0442\u0438 \u043A\u0443\u043F\u0446\u0430
      \u043B\u0435\u0442\u0438\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u043B\u043E\u0448\u0430\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935499
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935500
    m_Localized: "\u0420\u0430\u0437\u0432\u044F\u0437\u0430\u0432 \u0432\u0435\u0440\u0451\u0432\u043A\u0438,
      \u0432\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430\u043C
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0435\u0433\u043E. \u041F\u0430\u0440\u0435\u043D\u044C
      \u0442\u0440\u0451\u0442 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u044F,
      \u043C\u043E\u043B\u0447\u0430 \u043A\u0438\u0432\u0430\u0435\u0442 \u0438
      \u0443\u0445\u043E\u0434\u0438\u0442 \u0432 \u0441\u0442\u0435\u043F\u044C.
      \u041B\u044E\u0434\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u0441 \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u0435\u043C - \u043D\u043E
      \u0432\u044B \u0437\u043D\u0430\u0435\u0442\u0435: \u043D\u0430 \u044D\u0442\u043E\u043C
      \u043F\u0443\u0442\u0438 \u0434\u043E\u0431\u0440\u043E\u0442\u0430 \u043F\u043E\u0440\u043E\u0439
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935501
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u043C
      \u0443 \u0434\u043E\u0440\u043E\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935502
    m_Localized: "\u0412\u044B \u043F\u043B\u0430\u0442\u0438\u0442\u0435 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430\u043C
      \u0438 \u0435\u0434\u0435\u0442\u0435 \u0434\u0430\u043B\u044C\u0448\u0435.
      \u041F\u0430\u0440\u0435\u043D\u044C \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0443 \u0434\u043E\u0440\u043E\u0433\u0438 - \u0434\u043E \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0433\u043E
      \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u044F \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043B\u0438. \u0420\u0438\u0441\u043A \u043C\u0435\u0441\u0442\u0438 \u043D\u0435\u0432\u0435\u043B\u0438\u043A,
      \u043D\u043E \u043C\u043E\u043D\u0435\u0442\u044B \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B,
      \u0438 \u043D\u0430 \u043F\u043E\u0441\u0442\u0430\u0445 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0435
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438 \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u043D\u0430 \u0432\u0430\u0448 \u043E\u0431\u043E\u0437 \u0447\u0443\u0442\u044C
      \u0445\u043E\u043B\u043E\u0434\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935503
    m_Localized: "\u0422\u044E\u0440\u043A \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442
      \u0434\u043E\u043B\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935504
    m_Localized: "\u041D\u0430 \u0437\u0430\u043A\u0430\u0442\u0435 \u0443 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u044B
      \u0432\u0430\u0441 \u0434\u043E\u0433\u043E\u043D\u044F\u0435\u0442 \u0432\u0441\u0430\u0434\u043D\u0438\u043A.
      \u0422\u043E\u0442 \u0441\u0430\u043C\u044B\u0439 \u0442\u044E\u0440\u043A
      - \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u0435\u0440\u0445\u043E\u043C
      \u043D\u0430 \u043F\u0435\u0433\u043E\u043C \u043C\u0435\u0440\u0438\u043D\u0435,
      \u0440\u044F\u0434\u043E\u043C \u0434\u0432\u043E\u0435 \u0440\u043E\u0434\u0438\u0447\u0435\u0439.
      \u041E\u043D \u043F\u043E\u043C\u043D\u0438\u0442 \u043B\u0438\u0446\u043E.
      <npc_speech lang=\"Turkic\">\u0422\u044B \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B
      \u043C\u0435\u043D\u044F. \u041C\u043E\u0439 \u043E\u0442\u0435\u0446 \u0434\u0435\u0440\u0436\u0438\u0442
      \u043F\u043E\u0441\u0442 \u0443 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043A\u0430\u0440\u0430-\u0441\u0443. \u0414\u043E\u0440\u043E\u0433\u0430
      \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430 \u0434\u043B\u044F \u0442\u0432\u043E\u0435\u0433\u043E
      \u043E\u0431\u043E\u0437\u0430.</npc_speech> \u041E\u043D \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u043C\u0435\u0448\u043E\u0447\u0435\u043A - \u0432\u043D\u0443\u0442\u0440\u0438
      \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0435 \u043A\u0430\u0439\u044E\u0430\u043D\u044C
      \u0442\u0443\u043D\u0431\u0430\u043E, \u0434\u0435\u0441\u044F\u0442\u043E\u043A
      \u043C\u043E\u043D\u0435\u0442. \u041F\u043E\u043C\u043E\u0449\u044C \u043F\u0440\u0438\u0448\u043B\u0430
      \u0432 \u043D\u0443\u0436\u043D\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935505
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935506
    m_Localized: "\u041C\u043E\u043D\u0435\u0442\u044B \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044F\u0442
      \u0438\u0437 \u0440\u0443\u043A \u0432 \u0440\u0443\u043A\u0438 - \u043D\u0435
      \u043A\u0430\u043A \u043F\u043B\u0430\u0442\u0430, \u0430 \u043A\u0430\u043A
      \u0437\u043D\u0430\u043A \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F \u043C\u0435\u0436\u0434\u0443
      \u0434\u0432\u0443\u043C\u044F \u043B\u044E\u0434\u044C\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0434\u0435\u0440\u0436\u0430\u0442 \u0441\u043B\u043E\u0432\u043E. \u041D\u0430
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u043F\u043E\u0441\u0442\u0443
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438 \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442
      \u043E\u0431\u043E\u0437 \u0431\u0435\u0437 \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430:
      \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0442\u044E\u0440\u043A \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0432\u0435\u0440\u0435\u043D \u0441\u043B\u043E\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935507
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u043E\u0439 \u0441\u043E\u0433\u0434\u0438\u0435\u0446
      \u0443 \u0442\u0440\u0430\u043A\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935508
    m_Localized: "\u041A\u0438\u0441\u043B\u043E\u0432\u0430\u0442\u044B\u0439 \u0437\u0430\u043F\u0430\u0445
      \u0431\u043E\u043B\u0435\u0437\u043D\u0438 - \u0443 \u043F\u0440\u0438\u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0433\u043E
      \u043A\u0430\u043C\u043D\u044F \u043B\u0435\u0436\u0438\u0442 \u043C\u0443\u0436\u0447\u0438\u043D\u0430
      \u0432 \u0440\u0432\u0430\u043D\u043E\u043C \u0448\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u043A\u0430\u0444\u0442\u0430\u043D\u0435 \u0441 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u043C
      \u043E\u0440\u043D\u0430\u043C\u0435\u043D\u0442\u043E\u043C. \u041B\u0438\u0446\u043E
      \u0432 \u043F\u043E\u0442\u0443, \u0433\u0443\u0431\u044B \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u0432\u0448\u0438\u0435\u0441\u044F.
      \u0420\u044F\u0434\u043E\u043C - \u043E\u043F\u0440\u043E\u043A\u0438\u043D\u0443\u0442\u044B\u0439
      \u0442\u044E\u043A \u0441 \u0442\u043A\u0430\u043D\u044F\u043C\u0438. \u041E\u043D
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0445\u0440\u0438\u043F\u043B\u043E:
      <npc_speech lang=\"Sogdian\">\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u043C\u043E\u0451 \u0438\u043C\u044F. \u0422\u0440\u0438 \u0434\u043D\u044F
      \u0431\u0435\u0437 \u0432\u043E\u0434\u044B. \u0411\u0440\u0430\u0442 \u0434\u043E\u043B\u0436\u0435\u043D
      \u0436\u0434\u0430\u0442\u044C \u0432 \u041C\u0435\u0440\u0432\u0435.</npc_speech>
      \u0423 \u0432\u0430\u0441 \u0432 \u0437\u0430\u043F\u0430\u0441\u0435 \u0435\u0441\u0442\u044C
      \u043B\u0435\u0447\u0435\u0431\u043D\u044B\u0435 \u0442\u0440\u0430\u0432\u044B.
      \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0435 \u043A\u0443\u043F\u0446\u044B
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u044E\u0442 \u0431\u043E\u043B\u044C\u0448\u0443\u044E
      \u0447\u0430\u0441\u0442\u044C \u0440\u044B\u043D\u043A\u043E\u0432 \u0421\u0440\u0435\u0434\u043D\u0435\u0439
      \u0410\u0437\u0438\u0438 - \u043E\u0434\u0438\u043D \u0441\u043F\u0430\u0441\u0451\u043D\u043D\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043C\u043E\u0436\u0435\u0442 \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u0434\u0435\u0441\u044F\u0442\u043E\u043A \u0434\u0432\u0435\u0440\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935509
    m_Localized: "\u0414\u0430\u0442\u044C \u043B\u0435\u0447\u0435\u0431\u043D\u044B\u0435
      \u0442\u0440\u0430\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935510
    m_Localized: "\u0412\u044B \u0440\u0430\u0437\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442\u0435
      \u0433\u043E\u0440\u0441\u0442\u044C \u0447\u0430\u0431\u0440\u0435\u0446\u0430
      \u0438 \u043F\u043E\u043B\u044B\u043D\u0438, \u043F\u043E\u0438\u0442\u0435
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0430 \u0441 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u0439
      \u043B\u043E\u0436\u043A\u0438. \u041E\u043D \u0437\u0430\u0441\u044B\u043F\u0430\u0435\u0442
      \u043F\u043E\u0434 \u0432\u0430\u0448\u0438\u043C \u043D\u0430\u0432\u0435\u0441\u043E\u043C.
      \u0423\u0442\u0440\u043E\u043C \u043A\u0443\u043F\u0435\u0446 \u0443\u0445\u043E\u0434\u0438\u0442
      - \u0441\u043B\u0430\u0431\u044B\u0439, \u043D\u043E \u0436\u0438\u0432\u043E\u0439.
      \u0412\u044B \u043F\u043E\u0435\u0434\u0435\u0442\u0435 \u0434\u0430\u043B\u044C\u0448\u0435,
      \u043D\u0435 \u0437\u043D\u0430\u044F, \u0432\u044B\u0437\u0434\u043E\u0440\u043E\u0432\u0435\u0435\u0442
      \u043B\u0438 \u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935511
    m_Localized: "\u041F\u0440\u043E\u0435\u0445\u0430\u0442\u044C \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935512
    m_Localized: "\u041E\u0431\u043E\u0437 \u0442\u0440\u043E\u0433\u0430\u0435\u0442\u0441\u044F.
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0432\u0441\u043B\u0435\u0434 \u043C\u043E\u043B\u0447\u0430. \u041C\u043E\u0436\u0435\u0442,
      \u0435\u0433\u043E \u043F\u043E\u0434\u0431\u0435\u0440\u0451\u0442 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      - \u0430 \u043C\u043E\u0436\u0435\u0442, \u043D\u0435\u0442. \u041D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u043F\u0443\u0442\u0438 \u043C\u0430\u043B\u043E \u043A\u0442\u043E \u043E\u0441\u0443\u0436\u0434\u0430\u0435\u0442
      \u0437\u0430 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u044C,
      \u043D\u043E \u043B\u044E\u0434\u0438 \u043F\u043E\u043C\u043D\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935513
    m_Localized: "\u0412\u0435\u0441\u0442\u044C \u043E \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935514
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439 \u043F\u043B\u043E\u0449\u0430\u0434\u0438
      \u043A \u0432\u0430\u043C \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0441\u043E\u0433\u0434\u0438\u0435\u0446
      \u0432 \u0447\u0438\u0441\u0442\u043E\u043C \u043A\u0430\u0444\u0442\u0430\u043D\u0435
      - \u043B\u0438\u0446\u043E \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0435,
      \u043D\u043E \u043C\u0430\u043D\u0435\u0440\u0430 \u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F
      \u0442\u0430 \u0436\u0435, \u0447\u0442\u043E \u0438 \u0443 \u0431\u0440\u0430\u0442\u0430.
      <npc_speech lang=\"Sogdian\">\u0422\u044B - \u0442\u043E\u0442 \u043A\u0443\u043F\u0435\u0446
      \u0441 \u0442\u0440\u0430\u043A\u0442\u0430? \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u0436\u0438\u0432. \u041E\u043D \u0432\u0435\u043B\u0435\u043B \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C:
      \u0434\u043E\u043B\u0433 \u0431\u0443\u0434\u0435\u0442 \u043E\u043F\u043B\u0430\u0447\u0435\u043D.</npc_speech>
      \u041F\u0430\u0440\u0435\u043D\u044C \u043A\u043B\u0430\u0434\u0451\u0442 \u043D\u0430
      \u043F\u0440\u0438\u043B\u0430\u0432\u043E\u043A \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u043C\u0435\u0448\u043E\u0447\u0435\u043A \u0441 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u043C\u0438
      \u0434\u0438\u0440\u0445\u0430\u043C\u0430\u043C\u0438 \u0438 \u0441\u0432\u0438\u0442\u043E\u043A
      \u0441 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C
      \u043F\u0438\u0441\u044C\u043C\u043E\u043C \u043A \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u043C
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u043C \u0434\u043E\u043C\u0430\u043C
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430. \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0430\u044F
      \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u044F \u0441\u0435\u0442\u044C \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0447\u0435\u0440\u0435\u0437 \u043B\u0438\u0447\u043D\u044B\u0435 \u0441\u0432\u044F\u0437\u0438
      - \u044D\u0442\u043E \u043F\u0438\u0441\u044C\u043C\u043E \u0441\u0442\u043E\u0438\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043C\u043E\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935515
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935516
    m_Localized: "\u0414\u0438\u0440\u0445\u0430\u043C\u044B \u0438 \u043F\u0438\u0441\u044C\u043C\u043E
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044F\u0442 \u043A \u0432\u0430\u043C.
      \u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u043F\u043E\u0441\u0442\u0443\u043F\u043E\u043A
      \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0434\u043E\u0431\u0440\u044B\u043C
      \u0441\u043B\u043E\u0432\u043E\u043C \u0432 \u043D\u0443\u0436\u043D\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435. \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0435
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0440\u044B\u043D\u043A\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0442
      \u0432\u0430\u0441 \u0447\u0443\u0442\u044C \u0442\u0435\u043F\u043B\u0435\u0435
      - \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443
      \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u0432\u0435\u0440\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935517
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u0441 \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935518
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0441\u0430\u043D\u0434\u0430\u043B\u043E\u0432\u043E\u0433\u043E
      \u0434\u044B\u043C\u0430 \u0442\u044F\u043D\u0435\u0442\u0441\u044F \u0438\u0437
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E \u043F\u0440\u0438\u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0433\u043E
      \u0430\u043B\u0442\u0430\u0440\u044F. \u0411\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u043C\u043E\u043D\u0430\u0445 \u0432 \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u0432\u043E\u043C
      \u043E\u0434\u0435\u044F\u043D\u0438\u0438 \u0441\u0438\u0434\u0438\u0442 \u0443
      \u043A\u0430\u043C\u043D\u044F \u0438 \u043F\u0440\u0430\u0432\u0438\u0442
      \u043F\u0435\u0440\u043E\u043C \u043A\u0430\u0440\u0442\u0443 \u043D\u0430
      \u043A\u043E\u0436\u0435. \u041E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u0443: <npc_speech lang=\"Chinese\">\u042F \u0437\u0430\u043F\u0438\u0441\u0430\u043B
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B, \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u0437\u0430\u0431\u044B\u043B\u0438 \u043A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444\u044B
      \u0427\u0430\u043D\u044A\u0430\u043D\u044F. \u0425\u043E\u0447\u0435\u0448\u044C
      - \u043F\u0435\u0440\u0435\u043F\u0438\u0448\u0443 \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B.
      \u041C\u0435\u0441\u0442\u043E \u0440\u0435\u0434\u043A\u043E\u0435 - \u0442\u0430\u043C
      \u043C\u043E\u0436\u043D\u043E \u0441\u0440\u0435\u0437\u0430\u0442\u044C \u0442\u0440\u0438
      \u0434\u043D\u044F \u043F\u0443\u0442\u0438.</npc_speech> \u042D\u0442\u043E
      \u0437\u043D\u0430\u043D\u0438\u0435 \u0441\u0442\u043E\u0438\u0442 \u043C\u043D\u043E\u0433\u043E\u0433\u043E.
      \u041D\u043E \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E \u0432\u044B\u0433\u043E\u0434\u043D\u044B\u0445
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430\u0445 \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F
      \u0431\u044B\u0441\u0442\u0440\u043E, \u0438 \u0443 \u043E\u043F\u044B\u0442\u043D\u043E\u0433\u043E
      \u043A\u0443\u043F\u0446\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0430\u0439\u0434\u0443\u0442\u0441\u044F
      \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935519
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935520
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u0434\u0438\u043A\u0442\u0443\u0435\u0442
      - \u0432\u044B \u0437\u0430\u043D\u043E\u0441\u0438\u0442\u0435 \u0434\u0430\u043D\u043D\u044B\u0435
      \u043D\u0430 \u0431\u0435\u0440\u0435\u0441\u0442\u0443. \u041C\u0430\u0440\u0448\u0440\u0443\u0442
      \u0445\u043E\u0440\u043E\u0448. \u041D\u043E \u0442\u0430\u043A\u0438\u0435
      \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u043F\u0440\u0438 \u0441\u0435\u0431\u0435 \u0442\u0440\u0443\u0434\u043D\u043E:
      \u043A\u0443\u043F\u0446\u044B \u0431\u043E\u043B\u0442\u043B\u0438\u0432\u044B,
      \u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B \u0441\u0442\u0430\u043D\u0435\u0442
      \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u0430\u043C
      \u0440\u0430\u043D\u044C\u0448\u0435, \u0447\u0435\u043C \u0432\u044B \u0442\u0443\u0434\u0430
      \u0434\u043E\u0431\u0435\u0440\u0451\u0442\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935521
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u0431\u0435\u0437 \u0437\u0430\u043F\u0438\u0441\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935522
    m_Localized: "\u0412\u044B \u0432\u044B\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0435\u0442\u0435
      \u043C\u043E\u043D\u0430\u0445\u0430, \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442\u0435
      \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0435
      \u043F\u0443\u0442\u044C. \u0417\u043D\u0430\u043D\u0438\u0435 \u0443 \u0432\u0430\u0441
      \u0432 \u0433\u043E\u043B\u043E\u0432\u0435 - \u043D\u0435 \u043D\u0430 \u0431\u0443\u043C\u0430\u0433\u0435,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043C\u043E\u0433\u0443\u0442 \u043D\u0430\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935523
    m_Localized: "\u041A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442 \u0443 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935524
    m_Localized: "\u0423 \u0432\u0445\u043E\u0434\u0430 \u0432 \u043F\u0435\u0440\u0435\u0432\u0430\u043B
      \u0441\u0442\u043E\u0438\u0442 \u043E\u0431\u043E\u0437 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0433\u043E
      \u043A\u0443\u043F\u0446\u0430 - \u0448\u0435\u0441\u0442\u044C \u0433\u0440\u0443\u0436\u0451\u043D\u044B\u0445
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432, \u043F\u0435\u0441\u0442\u0440\u044B\u0435
      \u0442\u044E\u043C\u0435\u043D\u0441\u043A\u0438\u0435 \u0442\u043A\u0430\u043D\u0438
      \u043F\u043E\u0432\u0435\u0440\u0445 \u0432\u044C\u044E\u043A\u043E\u0432.
      \u0425\u043E\u0437\u044F\u0438\u043D \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F:
      <npc_speech lang=\"Sogdian\">\u0411\u0430\u0445\u0440\u0430\u043C \u0438\u0431\u043D
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D. \u041C\u043E\u043D\u0430\u0445
      \u043F\u0440\u043E\u0434\u0430\u043B \u043C\u043D\u0435 \u0442\u0435 \u0436\u0435
      \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B \u0442\u0440\u0438
      \u0434\u043D\u044F \u043D\u0430\u0437\u0430\u0434. \u0420\u044B\u043D\u043E\u043A
      \u0443\u0436\u0435 \u0437\u043D\u0430\u0435\u0442 \u043E \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435.</npc_speech>
      \u041F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E \u0443\u0442\u0435\u0440\u044F\u043D\u043E.
      \u041F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0437\u0430 \u043C\u0435\u0441\u0442\u043E \u043D\u0430 \u0441\u0443\u0436\u0435\u043D\u0438\u0438
      \u0434\u043E\u0440\u043E\u0433\u0438 \u0438\u043B\u0438 \u0443\u0441\u0442\u0443\u043F\u0438\u0442\u044C
      \u043F\u0435\u0440\u0432\u0435\u043D\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935525
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u043E \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E\u043C \u043F\u0440\u043E\u0445\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935526
    m_Localized: "\u0412\u044B \u0434\u0435\u043B\u0438\u0442\u0435 \u043E\u0447\u0435\u0440\u0435\u0434\u044C
      \u043F\u043E-\u0445\u043E\u0440\u043E\u0448\u0435\u043C\u0443: \u0411\u0430\u0445\u0440\u0430\u043C
      \u0438\u0434\u0451\u0442 \u043F\u0435\u0440\u0432\u044B\u043C, \u0432\u044B
      - \u0441\u043B\u0435\u0434\u043E\u043C. \u041F\u043E\u0442\u0435\u0440\u044F
      \u0432 \u0434\u0435\u043D\u044C\u0433\u0430\u0445 \u0438 \u0432\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
      \u043D\u043E \u0441\u0441\u043E\u0440\u0430 \u0443 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430
      \u043E\u043F\u0430\u0441\u043D\u0435\u0435. \u0411\u0430\u0445\u0440\u0430\u043C
      \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0447\u0438\u0432\u044B\u043C
      - \u0437\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u043E\u043C \u0432\u044B
      \u0443\u0437\u043D\u0430\u0451\u0442\u0435 \u0446\u0435\u043D\u044B \u0432
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u0433\u043E\u0440\u043E\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935527
    m_Localized: "\u041F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935528
    m_Localized: "\u0421\u0435\u0440\u044B\u0439 \u0432\u0435\u0447\u0435\u0440,
      \u043F\u044B\u043B\u044C \u043E\u0441\u0435\u0434\u0430\u0435\u0442 \u043D\u0430
      \u043A\u043E\u0448\u043C\u0430\u0445. \u0423 \u043E\u0431\u043E\u0447\u0438\u043D\u044B
      \u0441\u0442\u043E\u0438\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0441
      \u0442\u0451\u043C\u043D\u044B\u043C \u043B\u0438\u0446\u043E\u043C \u0438
      \u0431\u0435\u0433\u0430\u044E\u0449\u0438\u043C \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C
      - \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u0442\u044E\u043B\u0435\u043D\u0435\u0432\u044B\u0439
      \u0445\u0430\u043B\u0430\u0442, \u0440\u0432\u0430\u043D\u044B\u0435 \u0441\u0430\u043F\u043E\u0433\u0438,
      \u043D\u0430 \u043F\u043B\u0435\u0447\u0435 \u0443\u0437\u043A\u0438\u0439
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A \u0438\u0437 \u0445\u043E\u043B\u0441\u0442\u0438\u043D\u044B.
      \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0431\u0435\u0437
      \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F: <npc_speech
      lang=\"Persian\">\u0414\u043E\u0440\u043E\u0433\u0430 \u043E\u0434\u043D\u0430.
      \u0412\u043E\u0437\u044C\u043C\u0438 \u043C\u0435\u043D\u044F \u0434\u043E
      \u041C\u0435\u0440\u0432\u0430 - \u044F \u043D\u0435 \u0435\u043C \u043C\u043D\u043E\u0433\u043E.</npc_speech>
      \u0427\u0442\u043E \u0432 \u0441\u0432\u0451\u0440\u0442\u043A\u0435 - \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E.
      \u0421\u0442\u0435\u043F\u043D\u044B\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
      \u0438\u043D\u043E\u0433\u0434\u0430 \u0441\u0442\u0430\u0432\u044F\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0432 \u0445\u0432\u043E\u0441\u0442 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430,
      \u0447\u0442\u043E\u0431\u044B \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432.
      \u041D\u043E \u0438\u043D\u043E\u0433\u0434\u0430 \u0442\u0430\u043A\u043E\u0439
      \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u043E \u0437\u0430\u0441\u0430\u0434\u0430\u0445 \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u0442\u043E, \u0447\u0435\u0433\u043E \u043D\u0435 \u0437\u043D\u0430\u0435\u0442\u0435
      \u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935529
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935530
    m_Localized: "\u0427\u0435\u043B\u043E\u0432\u0435\u043A \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0445\u0432\u043E\u0441\u0442\u0435 \u043E\u0431\u043E\u0437\u0430.
      \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438 \u0441\u043B\u0435\u0434\u044F\u0442
      \u0437\u0430 \u043D\u0438\u043C, \u0432\u044B - \u0442\u043E\u0436\u0435. \u0427\u0435\u0440\u0435\u0437
      \u0447\u0435\u0442\u044B\u0440\u0435 \u0434\u043D\u044F \u0432\u0441\u0451
      \u043F\u0440\u043E\u044F\u0441\u043D\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935531
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u0438 \u0435\u0445\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935532
    m_Localized: "\u0412\u044B \u043A\u0430\u0447\u0430\u0435\u0442\u0435 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
      \u0438 \u0442\u0440\u043E\u0433\u0430\u0435\u0442\u0435\u0441\u044C. \u0427\u0435\u043B\u043E\u0432\u0435\u043A
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u0441\u043B\u0435\u0434 \u0431\u0435\u0437
      \u0437\u043B\u043E\u0431\u044B - \u0438\u043B\u0438 \u0434\u0435\u043B\u0430\u0435\u0442
      \u0432\u0438\u0434. \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0443 \u043B\u044E\u0434\u0435\u0439 \u0447\u0443\u0442\u044C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435:
      \u043C\u0435\u043D\u044C\u0448\u0435 \u0447\u0443\u0436\u0438\u0445 \u0433\u043B\u0430\u0437
      \u0432 \u043E\u0431\u043E\u0437\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935533
    m_Localized: "\u041F\u043E\u043F\u0443\u0442\u0447\u0438\u043A \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935534
    m_Localized: "\u041D\u0430 \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439
      \u0434\u0435\u043D\u044C \u0443 \u0431\u0440\u043E\u0434\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0430\u0440\u044B\u043A \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u0438\u0437 \u0445\u043E\u043B\u0441\u0442\u0438\u043D\u044B \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u0439
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0439 \u043F\u0435\u0440\u0441\u0442\u0435\u043D\u044C
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043F\u043E-\u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438:
      <npc_speech lang=\"Sogdian\">\u042F \u0421\u0430\u043C\u0435\u0445, \u0431\u044B\u0432\u0448\u0438\u0439
      \u0441\u0447\u0451\u0442\u0447\u0438\u043A \u0443 \u0411\u0430\u0445\u0440\u0430\u043C\u0430
      \u0438\u0437 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430.
      \u0423\u0431\u0435\u0436\u0430\u043B \u0441 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438.
      \u0415\u0441\u043B\u0438 \u0434\u043E\u0432\u0435\u0437\u0451\u0448\u044C \u0434\u043E
      \u041C\u0435\u0440\u0432\u0430 - \u043F\u0435\u0440\u0435\u0434\u0430\u043C
      \u0438\u0445 \u043D\u0443\u0436\u043D\u044B\u043C \u043B\u044E\u0434\u044F\u043C.
      \u0422\u0435\u0431\u0435 \u044D\u0442\u043E \u043E\u0431\u0435\u0440\u043D\u0451\u0442\u0441\u044F
      \u0434\u043E\u0431\u0440\u044B\u043C \u0441\u043B\u043E\u0432\u043E\u043C \u0443
      \u0442\u0430\u043C\u043E\u0448\u043D\u0435\u0439 \u0433\u0438\u043B\u044C\u0434\u0438\u0438.</npc_speech>
      \u0427\u0435\u043B\u043E\u0432\u0435\u043A \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043D\u0435 \u0432\u043E\u0440\u043E\u043C - \u0431\u0435\u0433\u043B\u0435\u0446\u043E\u043C
      \u0441 \u0446\u0435\u043D\u043D\u044B\u043C\u0438 \u0431\u0443\u043C\u0430\u0433\u0430\u043C\u0438.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0432 \u041C\u0435\u0440\u0432\u0435
      \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935535
    m_Localized: "\u0414\u043E\u0432\u0435\u0437\u0442\u0438 \u0421\u0430\u043C\u0435\u0445\u0430
      \u0434\u043E \u041C\u0435\u0440\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935536
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u0434\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
      \u0434\u043E \u041C\u0435\u0440\u0432\u0430. \u041D\u0443\u0436\u043D\u044B\u0435
      \u043B\u044E\u0434\u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u0431\u0443\u043C\u0430\u0433\u0438.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0430\u044F \u0433\u0438\u043B\u044C\u0434\u0438\u044F
      \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442 \u0432\u0430\u0448\u0435
      \u0438\u043C\u044F \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0445\u0440\u0430\u043D\u0438\u0442
      \u0442\u0430\u0439\u043D\u044B \u0438 \u0434\u0435\u0440\u0436\u0438\u0442
      \u0441\u043B\u043E\u0432\u043E. \u0414\u043E\u0440\u043E\u0433\u0430 \u0441\u0442\u0430\u043B\u0430
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935537
    m_Localized: "\u0410\u043A\u043A\u0440\u0435\u0434\u0438\u0442\u0438\u0432 \u0430\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u043E\u0433\u043E
      \u0431\u0430\u043D\u043A\u0438\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935538
    m_Localized: "\u0410\u0440\u043E\u043C\u0430\u0442 \u043C\u0443\u0441\u043A\u0443\u0441\u0430
      \u0438 \u0447\u0435\u0440\u043D\u0438\u043B - \u0432 \u043A\u0440\u044B\u0442\u043E\u043C
      \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u043C \u0440\u044F\u0434\u0443 \u0411\u0430\u0433\u0434\u0430\u0434\u0430
      \u0437\u0430 \u043D\u0438\u0437\u043A\u0438\u043C \u0441\u0442\u043E\u043B\u043E\u043C
      \u0441\u0438\u0434\u0438\u0442 \u0410\u0445\u043C\u0430\u0434 \u0438\u0431\u043D
      \u041C\u0443\u0445\u0430\u043C\u043C\u0430\u0434 \u0430\u043B\u044C-\u0425\u043E\u0440\u0430\u0441\u0430\u043D\u0438,
      \u043C\u0435\u043D\u044F\u043B\u0430 \u0441 \u0445\u043E\u0440\u043E\u0448\u0435\u0439
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0435\u0439. \u0415\u0433\u043E
      \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u043F\u043E\u044F\u0441 \u0443\u043A\u0440\u0430\u0448\u0435\u043D
      \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u043C\u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0430\u043C\u0438;
      \u043D\u0430 \u0441\u0442\u043E\u043B\u0435 - \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0435
      \u0432\u0435\u0441\u044B \u0438 \u0441\u0442\u043E\u043F\u043A\u0430 \u0431\u0443\u043C\u0430\u0433\u0438
      \u0438\u0437 \u0441\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430.
      <npc_speech lang=\"Arabic\">\u0422\u0432\u043E\u0451 \u0438\u043C\u044F \u044F
      \u0441\u043B\u044B\u0448\u0430\u043B. \u0412\u043E\u0442 \u0441\u0430\u043A\u043A
      \u043D\u0430 \u0441\u0442\u043E \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      - \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u0438 \u0435\u0433\u043E \u043C\u043E\u0435\u043C\u0443
      \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u0443 \u0432 \u041C\u0435\u0440\u0432\u0435.
      \u0427\u0435\u0440\u0435\u0437 \u0447\u0435\u0442\u044B\u0440\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u043D\u0435\u0439 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F
      \u0441\u043D\u043E\u0432\u0430. \u0414\u043E\u0431\u0430\u0432\u0438\u0448\u044C
      \u0434\u0435\u0441\u044F\u0442\u044C \u0441\u0432\u0435\u0440\u0445\u0443.</npc_speech>
      \u0410\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430
      \u0441\u0430\u043A\u043A \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u043A\u0443\u043F\u0446\u0430\u043C \u043D\u0435 \u0432\u043E\u0437\u0438\u0442\u044C
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E \u0447\u0435\u0440\u0435\u0437 \u043F\u0443\u0441\u0442\u044B\u043D\u044E.
      \u0420\u0438\u0441\u043A \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u0434\u043E\u043B\u0433
      \u043D\u0443\u0436\u043D\u043E \u043E\u0442\u0434\u0430\u0442\u044C \u0442\u043E\u0447\u043D\u043E
      \u0432 \u0441\u0440\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935539
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0430\u043A\u043A\u0440\u0435\u0434\u0438\u0442\u0438\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935540
    m_Localized: "\u0411\u0443\u043C\u0430\u0433\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u043A \u0432\u0430\u043C. \u0421\u0442\u043E \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      - \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0437\u0430\u0434\u0430\u0442\u043E\u043A
      \u0434\u043B\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438 \u0432
      \u041C\u0435\u0440\u0432\u0435. \u041D\u043E \u0410\u0445\u043C\u0430\u0434
      \u0437\u0430\u043F\u0438\u0441\u0430\u043B \u0434\u0430\u0442\u0443, \u0438
      \u0435\u0433\u043E \u043B\u044E\u0434\u0438 \u0443\u043C\u0435\u044E\u0442
      \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u0434\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935541
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043E\u0442
      \u0434\u043E\u043B\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935542
    m_Localized: "\u0412\u044B \u0432\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435\u0441\u044C.
      \u0410\u0445\u043C\u0430\u0434 \u043A\u0438\u0432\u0430\u0435\u0442 \u0431\u0435\u0437
      \u043E\u0431\u0438\u0434\u044B - \u0434\u0435\u043B\u043E\u0432\u043E\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u044C. \u0412\u044B
      \u0435\u0434\u0435\u0442\u0435 \u0431\u0435\u0437 \u0434\u043E\u043B\u0433\u0430,
      \u043D\u043E \u0438 \u0431\u0435\u0437 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935543
    m_Localized: "\u0414\u043E\u043B\u0433 \u043F\u0435\u0440\u0435\u0434 \u0410\u0445\u043C\u0430\u0434\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935544
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u041C\u0435\u0440\u0432\u0430
      \u043A \u0432\u0430\u043C \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u043A\u043B\u0435\u0440\u043A \u0432
      \u0431\u0435\u043B\u043E\u043C \u0442\u044E\u0440\u0431\u0430\u043D\u0435 -
      \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A \u0410\u0445\u043C\u0430\u0434\u0430,
      \u043E\u043D \u043F\u0440\u0438\u0431\u044B\u043B \u0437\u0430\u0440\u0430\u043D\u0435\u0435.
      <npc_speech lang=\"Arabic\">\u041C\u043E\u0439 \u0433\u043E\u0441\u043F\u043E\u0434\u0438\u043D
      \u043F\u0440\u0438\u0431\u0443\u0434\u0435\u0442 \u0437\u0430\u0432\u0442\u0440\u0430.
      \u0421\u0442\u043E \u0434\u0435\u0441\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432,
      \u043A\u0430\u043A \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C.
      \u041E\u043D \u0446\u0435\u043D\u0438\u0442 \u0442\u0435\u0445, \u043A\u0442\u043E
      \u043F\u043B\u0430\u0442\u0438\u0442 \u0431\u0435\u0437 \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F.</npc_speech>
      \u0414\u0435\u0441\u044F\u0442\u044C \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432
      \u0437\u0430 \u0447\u0435\u0442\u044B\u0440\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u043D\u0435\u0439 - \u043D\u0435\u043C\u0430\u043B\u043E, \u043D\u043E
      \u0430\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u0438\u0435 \u043C\u0435\u043D\u044F\u043B\u044B
      \u043F\u043E\u043C\u043D\u044F\u0442 \u0434\u043E\u043B\u0436\u043D\u0438\u043A\u043E\u0432
      \u043D\u0430\u0434\u043E\u043B\u0433\u043E. \u0421\u0432\u043E\u0435\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F
      \u0432\u044B\u043F\u043B\u0430\u0442\u0430 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0434\u0432\u0435\u0440\u0438 \u043A \u0431\u043E\u043B\u0435\u0435 \u0432\u044B\u0433\u043E\u0434\u043D\u044B\u043C
      \u0441\u0434\u0435\u043B\u043A\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935545
    m_Localized: "\u0412\u044B\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0434\u043E\u043B\u0433
      \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935546
    m_Localized: "\u0421\u0442\u043E \u0434\u0435\u0441\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044F\u0442 \u043A \u043A\u043B\u0435\u0440\u043A\u0443.
      \u041E\u043D \u043E\u0442\u0434\u0430\u0451\u0442 \u043A\u0432\u0438\u0442\u0430\u043D\u0446\u0438\u044E
      \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E \u0410\u0445\u043C\u0430\u0434\u0430.
      \u0414\u043E\u0440\u043E\u0433\u043E - \u043D\u043E \u0441\u043B\u043E\u0432\u043E
      \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F. \u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0440\u044B\u043D\u043A\u0435 \u0438\u043C\u044F \u0410\u0445\u043C\u0430\u0434\u0430
      \u0438\u0431\u043D \u041C\u0443\u0445\u0430\u043C\u043C\u0430\u0434\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0432 \u0432\u0430\u0448\u0443 \u043F\u043E\u043B\u044C\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935547
    m_Localized: "\u0414\u0435\u0440\u0435\u0432\u043D\u044F \u0441 \u0431\u043E\u043B\u0435\u0437\u043D\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935548
    m_Localized: "\u0417\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u043C
      \u0434\u043E\u0440\u043E\u0433\u0438 - \u0437\u0430\u043F\u0443\u0441\u0442\u0435\u043D\u0438\u0435:
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0434\u0435\u0440\u0435\u0432\u043D\u0438
      \u0437\u0430\u043F\u0435\u0440\u0442\u044B, \u043D\u0430\u0434 \u043E\u0433\u0440\u0430\u0434\u043E\u0439
      \u0442\u043E\u0440\u0447\u0438\u0442 \u043F\u0443\u0447\u043E\u043A \u0447\u0451\u0440\u043D\u043E\u0439
      \u0441\u043E\u043B\u043E\u043C\u044B - \u0437\u043D\u0430\u043A \u0431\u0435\u0434\u044B.
      \u041D\u0430 \u043A\u0430\u043C\u043D\u0435 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
      \u043B\u0435\u0436\u0438\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043B\u0435\u043F\u0451\u0448\u0435\u043A \u0438 \u0433\u043B\u0438\u043D\u044F\u043D\u044B\u0439
      \u043A\u0443\u0432\u0448\u0438\u043D. \u0421\u0442\u0430\u0440\u0438\u043A
      \u043C\u0430\u0448\u0435\u0442 \u0438\u0437-\u0437\u0430 \u0437\u0430\u0431\u043E\u0440\u0430:
      <npc_speech lang=\"Chinese\">\u041D\u0435 \u0432\u0445\u043E\u0434\u0438! \u041A\u0430\u0448\u0435\u043B\u044C
      \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u0442\u0440\u0435\u0442\u044C\u044E
      \u043D\u0435\u0434\u0435\u043B\u044E. \u0415\u0434\u0443 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438,
      \u043D\u043E \u0442\u0435\u0431\u0435 \u043D\u0435\u043B\u044C\u0437\u044F
      \u0437\u0434\u0435\u0441\u044C \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F.</npc_speech>
      \u041E\u0431\u043E\u0439\u0442\u0438 \u0434\u0435\u0440\u0435\u0432\u043D\u044E
      \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439 - \u043F\u043E\u0442\u0435\u0440\u044F
      \u0434\u043D\u044F. \u041D\u043E \u043F\u0440\u043E\u0439\u0442\u0438 \u043D\u0430\u0441\u043A\u0432\u043E\u0437\u044C
      \u043E\u043F\u0430\u0441\u043D\u043E: \u0431\u043E\u043B\u0435\u0437\u043D\u044C
      \u043C\u043E\u0436\u0435\u0442 \u0441\u0435\u0441\u0442\u044C \u0432 \u043E\u0431\u043E\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935549
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u0434\u0435\u0440\u0435\u0432\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935550
    m_Localized: "\u041E\u0431\u043E\u0437 \u0443\u0445\u043E\u0434\u0438\u0442 \u0432
      \u043E\u0431\u044A\u0435\u0437\u0434 \u043F\u043E \u043F\u043E\u043B\u0435\u0432\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435. \u041F\u043E\u0442\u0435\u0440\u044F \u0434\u043D\u044F,
      \u043B\u0438\u0448\u043D\u0438\u0439 \u043A\u0440\u044E\u043A \u043F\u043E
      \u0433\u0440\u044F\u0437\u0438. \u041D\u043E \u043B\u044E\u0434\u0438 \u0432
      \u043E\u0431\u043E\u0437\u0435 \u0434\u044B\u0448\u0430\u0442 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435
      - \u0445\u043E\u0442\u044F \u043E\u0434\u0438\u043D \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0443\u0436\u0435 \u0447\u0438\u0445\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935551
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E
      \u0431\u044B\u0441\u0442\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289583935552
    m_Localized: "\u0412\u044B \u0433\u043E\u043D\u0438\u0442\u0435 \u043E\u0431\u043E\u0437
      \u0447\u0435\u0440\u0435\u0437 \u0434\u0435\u0440\u0435\u0432\u043D\u044E \u0431\u0435\u0437
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438. \u0420\u0442\u044B
      \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u044B \u0442\u0440\u044F\u043F\u043A\u0430\u043C\u0438,
      \u0432\u0437\u0433\u043B\u044F\u0434\u044B - \u0432 \u043F\u043E\u043B. \u0414\u0435\u0440\u0435\u0432\u043D\u044F
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0437\u0430 \u0447\u0430\u0441,
      \u043D\u043E \u0431\u043E\u043B\u044C\u043D\u043E\u0439 \u0432\u043E\u0437\u0434\u0443\u0445
      \u0443\u0436\u0435 \u0441\u0434\u0435\u043B\u0430\u043B \u0441\u0432\u043E\u0451
      \u0434\u0435\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129792
    m_Localized: "\u0411\u043E\u043B\u0435\u0437\u043D\u044C \u0432 \u043E\u0431\u043E\u0437\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129793
    m_Localized: "\u041D\u0430 \u0442\u0440\u0435\u0442\u044C\u0435 \u0443\u0442\u0440\u043E
      \u043F\u043E\u0441\u043B\u0435 \u0434\u0435\u0440\u0435\u0432\u043D\u0438 \u0442\u0440\u043E\u0435
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u043B\u0435\u0436\u0430\u0442
      \u043F\u043E\u0434 \u0442\u0435\u043B\u0435\u0433\u043E\u0439 \u0441 \u0436\u0430\u0440\u043E\u043C.
      \u041A\u0430\u0448\u0435\u043B\u044C \u0440\u0432\u0451\u0442 \u0443\u0442\u0440\u0435\u043D\u043D\u044E\u044E
      \u0442\u0438\u0448\u0438\u043D\u0443. \u042E\u0441\u0443\u0444, \u0441\u0442\u0430\u0440\u0448\u0438\u0439
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A, \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043D\u0430 \u043D\u043E\u0433\u0430\u0445, \u043D\u043E \u0435\u0433\u043E
      \u043B\u0438\u0446\u043E \u0441\u0435\u0440\u043E\u0435: <npc_speech lang=\"Arabic\">\u0411\u043E\u043B\u0435\u0437\u043D\u044C
      \u0438\u0437 \u0442\u043E\u0439 \u0434\u0435\u0440\u0435\u0432\u043D\u0438.
      \u041D\u0430\u043C \u043D\u0430\u0434\u043E \u0432\u0441\u0442\u0430\u0442\u044C
      \u043D\u0430 \u0442\u0440\u0438 \u0434\u043D\u044F, \u0438\u043D\u0430\u0447\u0435
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u043B\u044F\u0436\u0435\u0442.</npc_speech>
      \u0411\u043E\u043B\u0435\u0437\u043D\u044C \u043F\u0440\u0438\u0448\u043B\u0430
      \u0438\u0437 \u0437\u0430\u0440\u0430\u0436\u0451\u043D\u043D\u043E\u0439 \u0434\u0435\u0440\u0435\u0432\u043D\u0438
      - \u0432\u043E\u0437\u0434\u0443\u0445 \u0438 \u043F\u044B\u043B\u044C \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0441\u0432\u043E\u0451 \u0434\u0435\u043B\u043E. \u0417\u0430\u043F\u0430\u0441\u044B
      \u0435\u0434\u044B \u0442\u0430\u044E\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435,
      \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u043E\u0432 \u043C\u0435\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129794
    m_Localized: "\u0412\u0441\u0442\u0430\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u0435\u043C
      \u043D\u0430 \u0442\u0440\u0438 \u0434\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129795
    m_Localized: "\u041E\u0431\u043E\u0437 \u0432\u0441\u0442\u0430\u0451\u0442 \u0443
      \u0440\u0443\u0447\u044C\u044F. \u0422\u0440\u0438 \u0434\u043D\u044F \u043B\u0435\u0447\u0435\u043D\u0438\u044F:
      \u0433\u043E\u0440\u044F\u0447\u0430\u044F \u0432\u043E\u0434\u0430, \u0441\u0443\u0445\u0438\u0435
      \u0442\u0440\u0430\u0432\u044B, \u043E\u0442\u0434\u044B\u0445. \u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E
      \u0432\u0441\u0442\u0430\u0451\u0442 \u043D\u0430 \u043D\u043E\u0433\u0438,
      \u043D\u043E \u0437\u0430\u043F\u0430\u0441\u044B \u0435\u0434\u044B \u0437\u0430\u043C\u0435\u0442\u043D\u043E
      \u043F\u0440\u043E\u0441\u0435\u043B\u0438, \u0438 \u0442\u0440\u043E\u0435
      \u0434\u043D\u0435\u0439 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E.
      \u0411\u043E\u043B\u0435\u0437\u043D\u044C \u0441\u0442\u043E\u0438\u043B\u0430
      \u0434\u043E\u0440\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129796
    m_Localized: "\u041F\u043E\u0434\u043A\u0443\u043F \u043D\u0430 \u0437\u0430\u0441\u0442\u0430\u0432\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129797
    m_Localized: "\u0417\u0430\u0441\u0442\u0430\u0432\u0430 \u0443 \u0440\u0435\u0447\u043D\u043E\u0439
      \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u044B - \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439
      \u0448\u043B\u0430\u0433\u0431\u0430\u0443\u043C, \u0434\u0432\u043E\u0435
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u043E\u0432 \u0432 \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u0445
      \u043A\u043E\u0436\u0430\u043D\u044B\u0445 \u043D\u0430\u0433\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u0445.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439, \u0410\u0431\u0443 \u0411\u0430\u043A\u0440,
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0448\u0438
      \u0433\u0440\u0430\u043C\u043E\u0442\u044B \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0434\u043E\u043B\u0433\u043E \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442
      \u0441 \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u043D\u043E \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u043C
      \u0436\u0435\u0441\u0442\u043E\u043C: <npc_speech lang=\"Arabic\">\u0411\u0443\u043C\u0430\u0433\u0438
      \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435. \u041D\u043E \u0437\u0434\u0435\u0441\u044C
      \u0442\u0440\u0438 \u0434\u043D\u044F \u043D\u0435 \u0431\u044B\u043B\u043E
      \u043F\u043B\u0430\u0442\u044B \u0437\u0430 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435
      \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u044B.</npc_speech> \u041D\u0430\u043C\u0451\u043A
      \u043E\u0447\u0435\u0432\u0438\u0434\u0435\u043D. \u041F\u043E\u0434\u043A\u0443\u043F
      \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0443,
      \u043D\u043E \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E \xAB\u0449\u0435\u0434\u0440\u044B\u0445
      \u043A\u0443\u043F\u0446\u0430\u0445\xBB \u043D\u0430 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u0445
      \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0431\u044B\u0441\u0442\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129798
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043D\u0435\u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129799
    m_Localized: "\u041C\u043E\u043D\u0435\u0442\u044B \u0441\u043A\u043E\u043B\u044C\u0437\u044F\u0442
      \u043F\u043E\u0434 \u0441\u0442\u043E\u043B\u0435\u0448\u043D\u0438\u0446\u0443.
      \u0428\u043B\u0430\u0433\u0431\u0430\u0443\u043C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F.
      \u0411\u044B\u0441\u0442\u0440\u043E \u0438 \u0447\u0438\u0441\u0442\u043E
      - \u0441\u0435\u0433\u043E\u0434\u043D\u044F. \u041D\u043E \u0410\u0431\u0443
      \u0411\u0430\u043A\u0440 \u0443\u0436\u0435 \u043F\u0438\u0448\u0435\u0442
      \u0447\u0442\u043E-\u0442\u043E \u0432 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u0431\u043B\u043E\u043A\u043D\u043E\u0442,
      \u0438 \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u0437\u0430\u0441\u0442\u0430\u0432\u0435
      \u0432\u0435\u0441\u0442\u044C \u0443\u0439\u0434\u0451\u0442 \u0440\u0430\u043D\u044C\u0448\u0435
      \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129800
    m_Localized: "\u041D\u0430\u0441\u0442\u043E\u044F\u0442\u044C \u043D\u0430 \u0437\u0430\u043A\u043E\u043D\u043D\u043E\u043C
      \u043F\u0440\u043E\u0445\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129801
    m_Localized: "\u0427\u0430\u0441 \u0441\u043F\u043E\u0440\u0438\u043C, \u0432\u0430\u0441
      \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442. \u041F\u043E\u0442\u043E\u043C
      \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u043C\u0430\u0448\u0435\u0442 \u0440\u0443\u043A\u043E\u0439
      - \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C. \u0414\u043E\u0440\u043E\u0433\u043E
      \u043E\u0431\u043E\u0448\u043B\u043E\u0441\u044C \u0432\u0440\u0435\u043C\u044F,
      \u043D\u043E \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0447\u0435\u0441\u0442\u043D\u043E\u0433\u043E
      \u043A\u0443\u043F\u0446\u0430 \u043D\u0435 \u0437\u0430\u043F\u044F\u0442\u043D\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129802
    m_Localized: "\u0421\u043B\u0443\u0445 \u043E \u0449\u0435\u0434\u0440\u043E\u043C
      \u043A\u0443\u043F\u0446\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129803
    m_Localized: "\u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0437\u0430\u0441\u0442\u0430\u0432\u0435 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0432\u0430\u0441 \u0443\u043B\u044B\u0431\u043A\u043E\u0439
      \u0435\u0449\u0451 \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A
      \u0432\u044B \u0434\u043E\u0441\u0442\u0430\u0451\u0442\u0435 \u0433\u0440\u0430\u043C\u043E\u0442\u044B.
      <npc_speech lang=\"Arabic\">\u0421\u043B\u044B\u0448\u0430\u043B\u0438 \u043E
      \u0442\u0435\u0431\u0435. \u0423 \u0410\u0431\u0443 \u0411\u0430\u043A\u0440\u0430
      \u0434\u043B\u0438\u043D\u043D\u044B\u0439 \u044F\u0437\u044B\u043A \u0438
      \u0431\u044B\u0441\u0442\u0440\u044B\u0435 \u043D\u043E\u0433\u0438 - \u0435\u0433\u043E
      \u0433\u043E\u043D\u0435\u0446 \u0434\u043E\u0431\u0440\u0430\u043B\u0441\u044F
      \u0441\u044E\u0434\u0430 \u0432\u0447\u0435\u0440\u0430.</npc_speech> \u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u0430\u0441 \u0437\u043D\u0430\u044E\u0442 \u043A\u0430\u043A \u043A\u0443\u043F\u0446\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043B\u0430\u0442\u0438\u0442
      \u0431\u0435\u0437 \u043F\u0443\u0441\u0442\u044B\u0445 \u0441\u043B\u043E\u0432.
      \u0422\u0440\u0435\u0431\u0443\u0435\u043C\u0430\u044F \u0441\u0443\u043C\u043C\u0430
      \u0432\u0434\u0432\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0439
      \u043F\u043E\u0448\u043B\u0438\u043D\u044B - \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438
      \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u044E\u0442 \u043D\u0430
      \u043F\u043E\u0432\u0442\u043E\u0440\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129804
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u043D\u044B\u0439
      \u0441\u0431\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129805
    m_Localized: "\u041B\u0438\u0448\u043D\u0438\u0435 \u043C\u043E\u043D\u0435\u0442\u044B
      \u0443\u0445\u043E\u0434\u044F\u0442. \u0421\u043B\u0443\u0445 \u043E \u0432\u0430\u0441
      \u0437\u0430\u043A\u0440\u0435\u043F\u0438\u043B\u0441\u044F - \u043D\u0430
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u0437\u0430\u0441\u0442\u0430\u0432\u0435
      \u0436\u0434\u0438\u0442\u0435 \u0442\u043E\u0433\u043E \u0436\u0435. \u0429\u0435\u0434\u0440\u043E\u0441\u0442\u044C,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C
      \u043A\u0430\u043A \u0440\u0430\u0437\u043E\u0432\u044B\u0439 \u0432\u044B\u0445\u043E\u0434,
      \u0441\u0442\u0430\u043B\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439.
      \u0414\u043E\u0440\u043E\u0433\u043E \u043E\u0431\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u043C\u043E\u043B\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129806
    m_Localized: "\u0411\u0435\u0441\u0445\u043E\u0437\u043D\u0430\u044F \u043B\u043E\u0448\u0430\u0434\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129807
    m_Localized: "\u041D\u0430 \u043E\u0431\u043E\u0447\u0438\u043D\u0435 \u0441\u0442\u0435\u043F\u043D\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0438 \u043F\u0430\u0441\u0451\u0442\u0441\u044F
      \u043B\u043E\u0448\u0430\u0434\u044C \u0431\u0435\u0437 \u0441\u0435\u0434\u043E\u043A\u0430
      - \u043A\u0440\u0443\u043F\u043D\u044B\u0439 \u0441\u043E\u043B\u043E\u0432\u044B\u0439
      \u0436\u0435\u0440\u0435\u0431\u0435\u0446 \u0441 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u043C
      \u0442\u0430\u0432\u0440\u043E\u043C \u043D\u0430 \u043F\u0440\u0430\u0432\u043E\u043C
      \u0431\u043E\u043A\u0443 \u0438 \u043E\u0431\u043E\u0440\u0432\u0430\u043D\u043D\u043E\u0439
      \u0443\u0437\u0434\u043E\u0439. \u041D\u0438 \u0441\u0443\u043C\u043E\u043A,
      \u043D\u0438 \u0441\u043B\u0435\u0434\u043E\u0432 \u0445\u043E\u0437\u044F\u0438\u043D\u0430.
      \u0416\u0435\u0440\u0435\u0431\u0435\u0446 \u0441\u043F\u043E\u043A\u043E\u0435\u043D,
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u043F\u043E\u0434\u043E\u0439\u0442\u0438.
      \u0422\u0430\u0432\u0440\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u043B\u043E
      \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u043C\u0443 \u0440\u043E\u0434\u0443
      - \u0445\u043E\u0437\u044F\u0438\u043D \u0433\u0434\u0435-\u0442\u043E \u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129808
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043B\u043E\u0448\u0430\u0434\u044C
      \u0441 \u0441\u043E\u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129809
    m_Localized: "\u0412\u044B \u0431\u0435\u0440\u0451\u0442\u0435 \u0436\u0435\u0440\u0435\u0431\u0446\u0430
      \u0432 \u043F\u043E\u0432\u043E\u0434. \u0417\u0430\u043F\u0430\u0441\u043D\u0430\u044F
      \u043B\u043E\u0448\u0430\u0434\u044C - \u0445\u043E\u0440\u043E\u0448\u043E,
      \u043D\u043E \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u0435 \u0442\u0430\u0432\u0440\u043E
      \u043E\u0431\u044F\u0437\u044B\u0432\u0430\u0435\u0442: \u0447\u0435\u0440\u0435\u0437
      \u0432\u043E\u0441\u0435\u043C\u044C \u0434\u043D\u0435\u0439 \u043C\u043E\u0436\u0435\u0442
      \u043E\u0431\u044A\u044F\u0432\u0438\u0442\u044C\u0441\u044F \u0445\u043E\u0437\u044F\u0438\u043D,
      \u0438 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0431\u0443\u0434\u0435\u0442
      \u043D\u0435\u043F\u0440\u043E\u0441\u0442\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129810
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043B\u043E\u0448\u0430\u0434\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129811
    m_Localized: "\u0412\u044B \u0435\u0434\u0435\u0442\u0435 \u0434\u0430\u043B\u044C\u0448\u0435.
      \u0416\u0435\u0440\u0435\u0431\u0435\u0446 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0432\u0441\u043B\u0435\u0434, \u043F\u043E\u0442\u043E\u043C \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u0443 \u0438 \u0441\u043D\u043E\u0432\u0430
      \u0449\u0438\u043F\u043B\u0435\u0442 \u0442\u0440\u0430\u0432\u0443. \u0413\u0440\u0443\u0437\u0430
      \u043C\u0435\u043D\u044C\u0448\u0435 - \u0434\u0443\u0448\u0430 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129812
    m_Localized: "\u0425\u043E\u0437\u044F\u0438\u043D \u043B\u043E\u0448\u0430\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129813
    m_Localized: "\u041D\u0430 \u0432\u043E\u0441\u044C\u043C\u043E\u0439 \u0434\u0435\u043D\u044C
      \u0443 \u0431\u0440\u043E\u0434\u0430 \u0432\u0430\u0441 \u0434\u043E\u0433\u043E\u043D\u044F\u0435\u0442
      \u0432\u0441\u0430\u0434\u043D\u0438\u043A - \u043C\u043E\u043B\u043E\u0434\u043E\u0439
      \u0442\u044E\u0440\u043A \u0432 \u0432\u043E\u0439\u043B\u043E\u0447\u043D\u043E\u043C
      \u0445\u0430\u043B\u0430\u0442\u0435, \u0441 \u043B\u0443\u043A\u043E\u043C
      \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439. \u041E\u043D \u0432\u0438\u0434\u0438\u0442
      \u0441\u043E\u043B\u043E\u0432\u0443\u044E \u043C\u0430\u0441\u0442\u044C \u0441\u0440\u0430\u0437\u0443.
      <npc_speech lang=\"Turkic\">\u041A\u044E\u043B\u044C - \u043C\u043E\u0439.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B \u0435\u0433\u043E \u0442\u0440\u0438
      \u043D\u0435\u0434\u0435\u043B\u0438 \u043D\u0430\u0437\u0430\u0434 \u0432
      \u0431\u0443\u0440\u0430\u043D\u0435. \u0422\u044B \u0432\u0435\u0440\u043D\u0451\u0448\u044C
      \u0438\u043B\u0438 \u043C\u043D\u0435 \u0437\u0432\u0430\u0442\u044C \u0441\u0442\u0430\u0440\u0448\u0438\u0445?</npc_speech>
      \u0417\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 \u0443 \u043D\u0435\u0433\u043E
      \u0434\u0432\u043E\u0435. \u0412\u0435\u0440\u043D\u0443\u0442\u044C \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u043E
      - \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F. \u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      - \u0440\u0438\u0441\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129814
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C \u043B\u043E\u0448\u0430\u0434\u044C
      \u0431\u0435\u0437 \u0443\u0441\u043B\u043E\u0432\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129815
    m_Localized: "\u0412\u044B \u043E\u0442\u0434\u0430\u0451\u0442\u0435 \u041A\u044E\u043B\u044F.
      \u0422\u044E\u0440\u043A \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u0432\u0430\u0441 \u0438\u043D\u0430\u0447\u0435 - \u0431\u0435\u0437 \u043E\u0436\u0438\u0434\u0430\u0435\u043C\u043E\u0439
      \u043D\u0435\u043D\u0430\u0432\u0438\u0441\u0442\u0438. \u0414\u043E\u0441\u0442\u0430\u0451\u0442
      \u0438\u0437 \u0441\u0435\u0434\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0443\u043C\u043A\u0438
      \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u043A\u043E\u0448\u0435\u043B\u0451\u043A:
      <npc_speech lang=\"Turkic\">\u0417\u0430 \u0447\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C
      - \u043C\u043E\u0438 \u043C\u043E\u043D\u0435\u0442\u044B.</npc_speech> \u0421\u0435\u0440\u0435\u0431\u0440\u043E
      \u043C\u0435\u043D\u044F\u0435\u0442 \u0445\u043E\u0437\u044F\u0438\u043D\u0430.
      \u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u043C
      \u043F\u043E\u0441\u0442\u0443 \u0432\u0430\u0448 \u043E\u0431\u043E\u0437
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0431\u044B\u0441\u0442\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129816
    m_Localized: "\u041F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
      \u043F\u043B\u0430\u0442\u0443 \u0437\u0430 \u0443\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129817
    m_Localized: "\u0412\u044B \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435
      \u0446\u0435\u043D\u0443. \u0422\u044E\u0440\u043A \u0442\u0435\u043C\u043D\u0435\u0435\u0442
      \u043B\u0438\u0446\u043E\u043C. \u041F\u043E\u0441\u043B\u0435 \u0434\u043E\u043B\u0433\u043E\u0433\u043E
      \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044F \u043F\u043B\u0430\u0442\u0438\u0442
      - \u043D\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432 \u0441\u043F\u0438\u043D\u0443
      \u0434\u043E\u043B\u0433\u043E. \u0414\u0435\u043D\u044C\u0433\u0438 \u0432\u0437\u044F\u0442\u044B,
      \u043D\u043E \u043D\u0430 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0445
      \u043F\u043E\u0441\u0442\u0430\u0445 \u0432\u0430\u0441 \u0437\u0430\u043F\u043E\u043C\u043D\u044F\u0442
      \u0438\u043D\u0430\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129818
    m_Localized: "\u041B\u0435\u0447\u0435\u0431\u043D\u0430\u044F \u0442\u0440\u0430\u0432\u0430
      \u0434\u043B\u044F \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129819
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0434\u044B\u043C\u0430 \u0438
      \u043A\u0443\u043C\u044B\u0441\u0430 - \u0443 \u043A\u043E\u0447\u0435\u0432\u043E\u0439
      \u0441\u0442\u043E\u044F\u043D\u043A\u0438 \u0442\u0440\u043E\u0435 \u0442\u044E\u0440\u043A\u043E\u0432
      \u043F\u043E\u044F\u0442 \u0431\u043E\u043B\u044C\u043D\u043E\u0433\u043E \u0440\u0435\u0431\u0451\u043D\u043A\u0430
      \u0433\u043E\u0440\u044C\u043A\u0438\u043C \u0447\u0430\u0435\u043C \u0438\u0437
      \u0441\u0442\u0435\u043F\u043D\u044B\u0445 \u0442\u0440\u0430\u0432. \u041C\u0430\u0442\u044C
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0442\u0440\u0435\u0432\u043E\u0436\u043D\u043E.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u043C\u0443\u0436\u0447\u0438\u043D\u0430,
      \u0411\u0438\u043B\u044C\u0433\u044D, \u0438\u0434\u0451\u0442 \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443
      \u0431\u0435\u0437 \u043E\u0440\u0443\u0436\u0438\u044F: <npc_speech lang=\"Turkic\">\u0416\u0430\u0440
      \u0442\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C. \u0422\u0432\u043E\u0438
      \u043B\u044E\u0434\u0438 - \u0438\u0437 \u0433\u043E\u0440\u043E\u0434\u043E\u0432,
      \u0443 \u0432\u0430\u0441 \u0434\u0440\u0443\u0433\u0438\u0435 \u0442\u0440\u0430\u0432\u044B.
      \u041F\u043E\u043C\u043E\u0433\u0438.</npc_speech> \u0423 \u0432\u0430\u0441
      \u0435\u0441\u0442\u044C \u043B\u0435\u0447\u0435\u0431\u043D\u044B\u0439 \u0437\u0430\u043F\u0430\u0441.
      \u041A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0438 \u043F\u043E\u043C\u043D\u044F\u0442
      \u0434\u043E\u0431\u0440\u043E \u0438\u043D\u0430\u0447\u0435, \u0447\u0435\u043C
      \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0435 - \u043D\u0435 \u043C\u043E\u043D\u0435\u0442\u0430\u043C\u0438,
      \u0430 \u0441\u043B\u043E\u0432\u043E\u043C, \u043F\u0435\u0440\u0435\u0434\u0430\u044E\u0449\u0438\u043C\u0441\u044F
      \u043F\u043E \u0441\u0442\u0435\u043F\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129820
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u043B\u0435\u0447\u0435\u0431\u043D\u044B\u0435
      \u0442\u0440\u0430\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129821
    m_Localized: "\u041F\u0443\u0447\u043E\u043A \u0442\u0438\u043C\u044C\u044F\u043D\u0430
      \u0438 \u0433\u043E\u0440\u0435\u0447\u0430\u0432\u043A\u0438 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u043A \u043C\u0430\u0442\u0435\u0440\u0438. \u0420\u0435\u0431\u0451\u043D\u043E\u043A
      \u0437\u0430\u0441\u044B\u043F\u0430\u0435\u0442 \u043A \u0432\u0435\u0447\u0435\u0440\u0443.
      \u0411\u0438\u043B\u044C\u0433\u044D \u043C\u043E\u043B\u0447\u0430 \u043A\u0438\u0432\u0430\u0435\u0442
      - \u043D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C \u043F\u0443\u0442\u0438
      \u0442\u0430\u043A\u043E\u0439 \u043A\u0438\u0432\u043E\u043A \u0441\u0442\u043E\u0438\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0440\u0443\u043A\u043E\u043F\u043E\u0436\u0430\u0442\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129822
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u0432\u0435\u0436\u043B\u0438\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129823
    m_Localized: "\u0412\u044B \u0440\u0430\u0437\u0432\u043E\u0434\u0438\u0442\u0435
      \u0440\u0443\u043A\u0430\u043C\u0438 - \u0437\u0430\u043F\u0430\u0441\u044B
      \u043D\u0443\u0436\u043D\u044B \u0432\u0430\u043C \u0441\u0430\u043C\u0438\u043C.
      \u0411\u0438\u043B\u044C\u0433\u044D \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0431\u0435\u0437 \u0441\u043B\u043E\u0432\u0430. \u041E\u0431\u043E\u0437
      \u0435\u0434\u0435\u0442 \u0434\u0430\u043B\u044C\u0448\u0435 \u0432 \u0442\u0438\u0448\u0438\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129824
    m_Localized: "\u0421\u043B\u0430\u0432\u0430 \u043E \u043B\u0435\u043A\u0430\u0440\u0435-\u043A\u0443\u043F\u0446\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129825
    m_Localized: "\u041D\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u043C
      \u0434\u0432\u043E\u0440\u0435 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0442\u044E\u0440\u043A \u0432
      \u043F\u043E\u0442\u0451\u0440\u0442\u043E\u043C \u0445\u0430\u043B\u0430\u0442\u0435
      \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F \u0435\u0449\u0451 \u0432
      \u0434\u0432\u0435\u0440\u044F\u0445: <npc_speech lang=\"Turkic\">\u0411\u0438\u043B\u044C\u0433\u044D
      - \u043C\u043E\u0439 \u0434\u044F\u0434\u044F. \u0415\u0433\u043E \u0441\u044B\u043D
      \u0436\u0438\u0432. \u0421\u0442\u0435\u043F\u044C \u0437\u043D\u0430\u0435\u0442
      \u0442\u0432\u043E\u0451 \u0438\u043C\u044F.</npc_speech> \u041E\u043D \u043A\u043B\u0430\u0434\u0451\u0442
      \u043D\u0430 \u0441\u0442\u043E\u043B \u0433\u043E\u0440\u0441\u0442\u044C
      \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0445 \u043C\u043E\u043D\u0435\u0442
      \u0438 \u043A\u0443\u0441\u043E\u043A \u0432\u044B\u0434\u0435\u043B\u0430\u043D\u043D\u043E\u0439
      \u043A\u043E\u0436\u0438 \u0441 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u043C
      \u043E\u0445\u0440\u0430\u043D\u043D\u044B\u043C \u0437\u043D\u0430\u043A\u043E\u043C.
      \u0417\u043D\u0430\u043A \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442,
      \u0447\u0442\u043E \u043A\u043E\u0447\u0435\u0432\u044B\u0435 \u0440\u043E\u0434\u044B
      \u0432 \u044D\u0442\u043E\u0439 \u0447\u0430\u0441\u0442\u0438 \u0441\u0442\u0435\u043F\u0438
      \u043D\u0435 \u0442\u0440\u043E\u043D\u0443\u0442 \u0432\u0430\u0448 \u043E\u0431\u043E\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129826
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0437\u043D\u0430\u043A
      \u0438 \u043C\u043E\u043D\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129827
    m_Localized: "\u041C\u043E\u043D\u0435\u0442\u044B \u0438 \u0437\u043D\u0430\u043A
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044F\u0442 \u043A \u0432\u0430\u043C.
      \u041A\u0443\u0441\u043E\u043A \u043A\u043E\u0436\u0438 \u0431\u0443\u0434\u0435\u0442
      \u0432\u0438\u0441\u0435\u0442\u044C \u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0439
      \u0442\u0435\u043B\u0435\u0433\u0435. \u0421\u0442\u0440\u0430\u0436\u0430
      \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0445 \u043F\u043E\u0441\u0442\u043E\u0432
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043D\u0435\u0433\u043E
      \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C - \u043A\u0443\u043F\u0435\u0446,
      \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0432 \u0441\u0442\u0435\u043F\u0438
      \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0447\u0435\u0441\u0442\u0438,
      \u043F\u043B\u0430\u0442\u0438\u0442 \u043C\u0435\u043D\u044C\u0448\u0435 \u043D\u0435\u0444\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u044B\u0445
      \u0441\u0431\u043E\u0440\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129828
    m_Localized: "\u041D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0439 \u0441\u0432\u0438\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129829
    m_Localized: "\u0423 \u043A\u0440\u0430\u044F \u0442\u0440\u0430\u043A\u0442\u0430
      - \u0437\u0430\u0442\u043E\u043F\u0442\u0430\u043D\u043D\u044B\u0439 \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0444\u0443\u0442\u043B\u044F\u0440 \u0438\u0437 \u043B\u0430\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
      \u0431\u0430\u043C\u0431\u0443\u043A\u0430. \u0412\u043D\u0443\u0442\u0440\u0438
      \u0441\u0432\u0438\u0442\u043E\u043A \u043D\u0430 \u0442\u043E\u043D\u043A\u043E\u0439
      \u0448\u0451\u043B\u043A\u043E\u0432\u043E\u0439 \u0431\u0443\u043C\u0430\u0433\u0435
      \u0441 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u043C\u0438 \u0438\u0435\u0440\u043E\u0433\u043B\u0438\u0444\u0430\u043C\u0438.
      \u0421\u0443\u0434\u044F \u043F\u043E \u043F\u0435\u0447\u0430\u0442\u0438
      - \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u0434\u043E\u043C\u0430 \u0438\u0437 \u0427\u0430\u043D\u044A\u0430\u043D\u044F.
      \u0422\u0430\u043A\u0438\u0435 \u0441\u0432\u0438\u0442\u043A\u0438 \u0442\u0435\u0440\u044F\u044E\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0438 \u0441\u043F\u0435\u0448\u043A\u0435
      \u0438\u043B\u0438 \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u0438.
      \u0425\u0440\u0430\u043D\u0438\u0442\u044C \u043D\u0430\u0445\u043E\u0434\u043A\u0443
      - \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0447\u0443\u0436\u043E\u0439
      \u0442\u043E\u0432\u0430\u0440; \u043E\u0442\u0434\u0430\u0442\u044C - \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u043D\u0430\u0433\u0440\u0430\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129830
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0441\u0432\u0438\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129831
    m_Localized: "\u0424\u0443\u0442\u043B\u044F\u0440 \u0443\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0441\u0443\u043C\u043A\u0443. \u0427\u0435\u0440\u0435\u0437 \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u043D\u0435\u0439 \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u0441\u044F,
      \u0438\u0449\u0435\u0442 \u043B\u0438 \u0435\u0433\u043E \u043A\u0442\u043E-\u0442\u043E
      - \u0438 \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129832
    m_Localized: "\u0421\u0434\u0430\u0442\u044C \u043D\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u043C
      \u0434\u0432\u043E\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129833
    m_Localized: "\u0425\u043E\u0437\u044F\u0438\u043D \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0441\u0432\u0438\u0442\u043E\u043A \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C.
      \u0412\u044B \u0443\u0435\u0437\u0436\u0430\u0435\u0442\u0435 \u0441 \u0447\u0438\u0441\u0442\u043E\u0439
      \u0441\u043E\u0432\u0435\u0441\u0442\u044C\u044E \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C\u0438
      \u043C\u043E\u043D\u0435\u0442\u0430\u043C\u0438 \u0437\u0430 \u0442\u0440\u0443\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129834
    m_Localized: "\u0425\u043E\u0437\u044F\u0438\u043D \u0441\u0432\u0438\u0442\u043A\u0430
      \u043D\u0430\u0448\u0451\u043B\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129835
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u043A \u0432\u0430\u043C
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043F\u043E\u0436\u0438\u043B\u043E\u0439
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u0432 \u0442\u0451\u043C\u043D\u043E\u043C
      \u0448\u0451\u043B\u043A\u0435 - \u0440\u0443\u043A\u0430\u0432\u0430 \u0432\u044B\u0448\u0438\u0442\u044B
      \u043E\u0431\u043B\u0430\u0447\u043D\u044B\u043C \u0443\u0437\u043E\u0440\u043E\u043C
      \u0422\u0430\u043D. \u041E\u043D \u0432\u0438\u0434\u0438\u0442 \u0432\u0430\u0448
      \u0431\u0430\u043C\u0431\u0443\u043A\u043E\u0432\u044B\u0439 \u0444\u0443\u0442\u043B\u044F\u0440.
      <npc_speech lang=\"Chinese\">\u042D\u0442\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
      \u043C\u043E\u0435\u0433\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u0434\u043E\u043C\u0430. \u041D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u0435
      \u0431\u044B\u043B\u043E \u0432 \u0425\u0430\u043C\u0438\u0439\u0441\u043A\u043E\u043C
      \u0443\u0449\u0435\u043B\u044C\u0435. \u0422\u044B \u0438\u0445 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B.</npc_speech>
      \u041E\u043D \u0433\u043E\u0442\u043E\u0432 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0445\u043E\u0440\u043E\u0448\u043E. \u0421\u0432\u0438\u0442\u043E\u043A
      \u0441\u0442\u043E\u0438\u043B \u0435\u043C\u0443 \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0441\u0442\u043E\u0438\u0442 \u0432\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129836
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C \u0437\u0430 \u0445\u043E\u0440\u043E\u0448\u0443\u044E
      \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129837
    m_Localized: "\u0421\u043E\u0440\u043E\u043A \u043C\u043E\u043D\u0435\u0442 \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C
      \u0438 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0430. \u041E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C \u0441\u043B\u043E\u0432\u0430
      \u0438 \u043E\u0431\u0435\u0449\u0430\u0435\u0442 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435
      \u043F\u0438\u0441\u044C\u043C\u043E \u043A \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u043C
      \u0434\u043E\u043C\u0430\u043C \u041B\u043E\u044F\u043D\u0430. \u0427\u0435\u0441\u0442\u043D\u0430\u044F
      \u043D\u0430\u0445\u043E\u0434\u043A\u0430 \u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
      \u043A \u0445\u043E\u0437\u044F\u0438\u043D\u0443 - \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043E\u0436\u0438\u0434\u0430\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129838
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0437\u0430 \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129839
    m_Localized: "\u0412\u044B \u0434\u0435\u0440\u0436\u0438\u0442\u0435 \u0446\u0435\u043D\u0443
      \u0432\u044B\u0448\u0435 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F.
      \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u043F\u043B\u0430\u0442\u0438\u0442
      - \u043D\u043E \u043B\u0438\u0446\u043E \u0435\u0433\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u043E,
      \u0438 \u043F\u0438\u0441\u044C\u043C\u043E \u043A \u043B\u043E\u044F\u043D\u0441\u043A\u0438\u043C
      \u0434\u043E\u043C\u0430\u043C \u0432\u044B \u0443\u0436\u0435 \u043D\u0435
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435. \u0414\u0435\u043D\u044C\u0433\u0438
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      - \u0442\u043E\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129840
    m_Localized: "\u041F\u043E\u0434\u0430\u0440\u043E\u043A \u0442\u0438\u0431\u0435\u0442\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129841
    m_Localized: "\u041D\u0430 \u0433\u043E\u0440\u043D\u043E\u0439 \u0442\u0440\u043E\u043F\u0435
      \u0413\u0430\u043D\u044C\u0441\u0443 - \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439
      \u0432\u043E\u0438\u043D \u0432 \u043B\u043E\u0445\u043C\u0430\u0442\u043E\u043C
      \u044F\u043A\u043E\u0432\u043E\u043C \u043F\u043E\u043B\u0443\u0448\u0443\u0431\u043A\u0435.
      \u041E\u043D \u0434\u0435\u0440\u0436\u0438\u0442 \u0432 \u0440\u0443\u043A\u0430\u0445
      \u043F\u043B\u043E\u0441\u043A\u0438\u0439 \u043A\u0430\u043C\u0435\u043D\u044C
      \u0441 \u0432\u044B\u0440\u0435\u0437\u0430\u043D\u043D\u043E\u0439 \u043C\u0430\u043D\u0442\u0440\u043E\u0439
      \u0438 \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0432\u0430\u043C:
      <npc_speech lang=\"Tibetan\">\u041D\u0430\u043D\u0430\u043C \u0434\u0430\u0451\u0442
      \u0442\u0435\u0431\u0435 \u043A\u0430\u043C\u0435\u043D\u044C. \u041C\u043E\u0439
      \u0431\u0440\u0430\u0442 \u0422\u0440\u0438\u0434\u044D \u0441\u0442\u0435\u0440\u0435\u0436\u0451\u0442
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043F\u0435\u0440\u0435\u0432\u0430\u043B.
      \u0421\u043A\u0430\u0436\u0438 \u0435\u043C\u0443: \u0431\u0435\u043B\u044B\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C \u043E\u0442 \u041D\u0430\u043D\u0430\u043C\u0430.</npc_speech>
      \u0422\u0438\u0431\u0435\u0442\u0446\u044B \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u044E\u0442
      \u0413\u0430\u043D\u044C\u0441\u0443\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u0438\u0434\u043E\u0440
      \u0432 VIII \u0432\u0435\u043A\u0435 \u0436\u0451\u0441\u0442\u043A\u043E -
      \u0441\u043B\u043E\u0432\u043E \u043E\u0434\u043D\u043E\u0433\u043E \u0432\u043E\u0438\u043D\u0430
      \u0431\u0440\u0430\u0442\u0443 \u0437\u043D\u0430\u0447\u0438\u0442 \u043F\u0440\u043E\u043F\u0443\u0441\u043A
      \u0431\u0435\u0437 \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129842
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043A\u0430\u043C\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129843
    m_Localized: "\u041A\u0430\u043C\u0435\u043D\u044C \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u043A \u0432\u0430\u043C. \u0422\u044F\u0436\u0451\u043B\u044B\u0439, \u043E\u0442\u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439,
      \u0441 \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u0433\u043E\u0440\u043D\u043E\u0433\u043E
      \u0432\u0435\u0442\u0440\u0430. \u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u043C \u043F\u043E\u0441\u0442\u0443
      \u043D\u0443\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u043D\u0430\u0437\u0432\u0430\u0442\u044C
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0435 \u0441\u043B\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129844
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129845
    m_Localized: "\u0412\u044B \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u0440\u0443\u043A\u0438 \u0432 \u0437\u043D\u0430\u043A \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F
      \u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442\u0435: \u0447\u0443\u0436\u0438\u0445
      \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432 \u043D\u0435
      \u0431\u0435\u0440\u0451\u0442\u0435. \u041D\u0430\u043D\u0430\u043C \u043A\u0438\u0432\u0430\u0435\u0442
      - \u0443\u0432\u0430\u0436\u0430\u0435\u0442 \u043E\u0442\u0432\u0435\u0442.
      \u041A\u0430\u043C\u0435\u043D\u044C \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043F\u0440\u0438 \u043D\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129846
    m_Localized: "\u0411\u0440\u0430\u0442 \u041D\u0430\u043D\u0430\u043C\u0430 \u043D\u0430
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129847
    m_Localized: "\u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043F\u043E\u0441\u0442
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435 - \u043A\u0430\u043C\u0435\u043D\u043D\u0430\u044F
      \u0441\u0442\u0435\u043D\u0430, \u0442\u0440\u043E\u0435 \u0432\u043E\u0438\u043D\u043E\u0432
      \u0441 \u043A\u043E\u043F\u044C\u044F\u043C\u0438, \u0437\u0430\u043F\u0430\u0445
      \u0433\u043E\u0440\u044F\u0449\u0435\u0433\u043E \u043C\u043E\u0436\u0436\u0435\u0432\u0435\u043B\u044C\u043D\u0438\u043A\u0430
      \u043E\u0442 \u0431\u043E\u043D-\u0430\u043B\u0442\u0430\u0440\u044F \u0432
      \u0443\u0433\u043B\u0443. \u0422\u0440\u0438\u0434\u044D - \u043A\u0440\u0435\u043F\u043A\u0438\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043B\u0435\u0442 \u0441\u043E\u0440\u043E\u043A\u0430
      - \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0448
      \u043E\u0431\u043E\u0437 \u0431\u0435\u0437 \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F.
      \u0412\u044B \u0434\u043E\u0441\u0442\u0430\u0451\u0442\u0435 \u043F\u043B\u043E\u0441\u043A\u0438\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C \u0441 \u043C\u0430\u043D\u0442\u0440\u043E\u0439.
      \u0422\u0440\u0438\u0434\u044D \u0431\u0435\u0440\u0451\u0442 \u0435\u0433\u043E
      \u0438 \u0434\u0435\u0440\u0436\u0438\u0442 \u0434\u043E\u043B\u0433\u043E,
      \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u0434\u043D\u043E\u0441\u0438\u0442
      \u043A\u043E \u043B\u0431\u0443: <npc_speech lang=\"Tibetan\">\u0411\u0435\u043B\u044B\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C \u041D\u0430\u043D\u0430\u043C\u0430.
      \u041F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u0435.</npc_speech> \u0412\u043E\u0438\u043D\u044B
      \u0443\u0431\u0438\u0440\u0430\u044E\u0442 \u043A\u043E\u043F\u044C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129848
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0447\u0435\u0440\u0435\u0437
      \u043F\u043E\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129849
    m_Localized: "\u041E\u0431\u043E\u0437 \u0432\u0445\u043E\u0434\u0438\u0442 \u0432
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B \u0431\u0435\u0437 \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430.
      \u0422\u0440\u0438\u0434\u044D \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u0435\u0442
      \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C - \u0431\u0435\u0437 \u0441\u043B\u043E\u0432.
      \u0414\u0430\u0440 \u0431\u0440\u0430\u0442\u0430 \u043E\u0442\u043A\u0440\u044B\u043B
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0447\u0435\u0440\u0435\u0437 \u043E\u0434\u0438\u043D
      \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0442\u0440\u0443\u0434\u043D\u044B\u0445
      \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0445 \u043A\u043E\u0440\u0434\u043E\u043D\u043E\u0432
      \u0432 \u0413\u0430\u043D\u044C\u0441\u0443. \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u0441\u043D\u0438\u0436\u0435\u043D\u0430, \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0440\u0430\u0441\u0442\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129850
    m_Localized: "\u041E\u0433\u043E\u043D\u044C \u0432 \u043D\u043E\u0447\u043D\u043E\u043C
      \u043B\u0430\u0433\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129851
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0433\u043E\u0440\u0435\u043B\u043E\u0433\u043E
      \u0432\u043E\u0439\u043B\u043E\u043A\u0430 \u0431\u0443\u0434\u0438\u0442 \u0432\u0441\u0435\u0445
      \u0440\u0430\u0437\u043E\u043C. \u041D\u0430 \u043A\u0440\u0430\u044E \u043B\u0430\u0433\u0435\u0440\u044F
      \u044F\u0437\u044B\u043A\u0438 \u043F\u043B\u0430\u043C\u0435\u043D\u0438 \u043F\u043E\u0436\u0438\u0440\u0430\u044E\u0442
      \u043C\u0435\u0448\u043E\u043A \u0441 \u0437\u0435\u0440\u043D\u043E\u043C
      \u0438 \u043A\u0440\u0430\u0439 \u043F\u0430\u0440\u0443\u0441\u0438\u043D\u043E\u0432\u043E\u0433\u043E
      \u043D\u0430\u0432\u0435\u0441\u0430. \u041E\u0433\u043E\u043D\u044C \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
      - \u0437\u0430\u043B\u0438\u0432\u0430\u044E\u0442 \u0432\u043E\u0434\u043E\u0439
      \u0437\u0430 \u043F\u043E\u043B\u0447\u0430\u0441\u0430, \u043D\u043E \u0447\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0430.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B.
      \u0427\u0442\u043E \u0433\u043E\u0440\u0435\u043B\u043E - \u043F\u043E\u043D\u044F\u0442\u043D\u043E.
      \u041E\u0442\u043A\u0443\u0434\u0430 \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C
      - \u043D\u0435\u0442. \u041A\u043E\u0441\u0442\u0440\u0438\u0449\u0435 \u0432
      \u0442\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u043D\u0435
      \u0440\u0430\u0437\u0432\u043E\u0434\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129852
    m_Localized: "\u0420\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u0438\u0447\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129853
    m_Localized: "\u0412\u044B \u043E\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0435
      \u043B\u044E\u0434\u0435\u0439 \u0438 \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442\u0435
      \u043C\u0435\u0441\u0442\u043E. \u0427\u0435\u0440\u0435\u0437 \u0442\u0440\u0438
      \u0434\u043D\u044F \u043A\u0430\u0440\u0442\u0438\u043D\u0430 \u043F\u0440\u043E\u044F\u0441\u043D\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129854
    m_Localized: "\u041D\u0435 \u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0432\u0440\u0435\u043C\u044F
      - \u0435\u0445\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129855
    m_Localized: "\u041E\u0431\u043E\u0437 \u0442\u0440\u043E\u0433\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435. \u041F\u0440\u0438\u0447\u0438\u043D\u0430
      \u043E\u0433\u043D\u044F \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0439.
      \u041B\u044E\u0434\u0438 \u043D\u0435\u0440\u0432\u043D\u0438\u0447\u0430\u044E\u0442,
      \u043F\u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044E\u0442 \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129856
    m_Localized: "\u041F\u0440\u0438\u0447\u0438\u043D\u0430 \u043D\u0430\u0439\u0434\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129857
    m_Localized: "\u041D\u0430 \u0442\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C
      \u043E\u0434\u0438\u043D \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u0441 \u0432\u0438\u043D\u043E\u0432\u0430\u0442\u044B\u043C
      \u043B\u0438\u0446\u043E\u043C \u0438 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043E\u0431\u0433\u043E\u0440\u0435\u0432\u0448\u0438\u0439 \u043A\u043E\u043D\u0435\u0446
      \u0444\u0438\u0442\u0438\u043B\u044F \u043E\u0442 \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0439
      \u043B\u0430\u043C\u043F\u044B - \u0443\u0440\u043E\u043D\u0438\u043B \u043F\u0435\u0440\u0435\u0434
      \u0441\u043D\u043E\u043C, \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B.
      \u041D\u0438\u0447\u0435\u0433\u043E \u0443\u043C\u044B\u0441\u043B\u0430:
      \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C \u0438 \u043D\u0435\u0431\u0440\u0435\u0436\u043D\u043E\u0441\u0442\u044C.
      <npc_speech lang=\"Sogdian\">\u042F \u0437\u0430\u043F\u043B\u0430\u0447\u0443
      \u0438\u0437 \u0441\u0432\u043E\u0435\u0433\u043E \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u044F.
      \u041F\u0440\u043E\u0441\u0442\u0438.</npc_speech> \u0412\u0438\u043D\u043E\u0432\u043D\u044B\u0439
      \u043D\u0430\u0439\u0434\u0435\u043D. \u0427\u0442\u043E \u0441 \u043D\u0438\u043C
      \u0434\u0435\u043B\u0430\u0442\u044C - \u0440\u0435\u0448\u0430\u0442\u044C
      \u0432\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129858
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u0438\u0442\u044C \u0441 \u0432\u044B\u0447\u0435\u0442\u043E\u043C
      \u0438\u0437 \u043F\u043B\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129859
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0442\u0435\u0440\u044F\u0435\u0442
      \u0447\u0430\u0441\u0442\u044C \u043E\u043F\u043B\u0430\u0442\u044B, \u043D\u043E
      \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0432 \u043E\u0431\u043E\u0437\u0435.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0432\u0438\u0434\u044F\u0442:
      \u0432\u0438\u043D\u043E\u0432\u043D\u044B\u0439 \u043D\u0430\u043A\u0430\u0437\u0430\u043D,
      \u0430 \u043D\u0435 \u0443\u0432\u043E\u043B\u0435\u043D \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435.
      \u041C\u043E\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u0434\u0443\u0445 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      - \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u044C
      \u0431\u0435\u0437 \u0436\u0435\u0441\u0442\u043E\u043A\u043E\u0441\u0442\u0438
      \u0434\u0435\u0440\u0436\u0438\u0442 \u043B\u044E\u0434\u0435\u0439 \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129860
    m_Localized: "\u041E\u0434\u043E\u043B\u0436\u0435\u043D\u043D\u044B\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129861
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u043D\u044B\u0439 \u043A\u0443\u043F\u0435\u0446
      \u0420\u0443\u0441\u0442\u0430\u043C \u0438\u0437 \u0413\u0435\u0440\u0430\u0442\u0430
      \u0441\u0442\u043E\u0438\u0442 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
      \u0441 \u0443\u043F\u0430\u0432\u0448\u0438\u043C \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u043C
      - \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u043B\u0435\u0433\u043B\u043E
      \u043D\u0430\u0431\u043E\u043A \u0438 \u043D\u0435 \u0432\u0441\u0442\u0430\u0451\u0442.
      \u041D\u0430 \u043D\u0451\u043C \u043F\u043E\u043B\u043D\u044B\u0439 \u0432\u044C\u044E\u043A
      \u0445\u043B\u043E\u043F\u043A\u0430. <npc_speech lang=\"Persian\">\u041C\u043D\u0435
      \u0434\u043E \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0430 \u0442\u0440\u0438
      \u0434\u043D\u044F. \u041E\u0434\u043E\u043B\u0436\u0438 \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0433\u043E
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430. \u0412\u0435\u0440\u043D\u0443
      \u0432 \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0435 \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u0442\u0432\u043E\u0438\u043C.></npc_speech> \u0423 \u0432\u0430\u0441
      \u0435\u0441\u0442\u044C \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0439.
      \u0420\u0443\u0441\u0442\u0430\u043C \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0447\u0435\u0441\u0442\u043D\u044B\u043C \u043A\u0443\u043F\u0446\u043E\u043C.
      \u041D\u043E \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u0431\u044B\u0432\u0430\u044E\u0442
      \u0440\u0430\u0437\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129862
    m_Localized: "\u041E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129863
    m_Localized: "\u0412\u0435\u0440\u0431\u043B\u044E\u0434 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u043A \u0420\u0443\u0441\u0442\u0430\u043C\u0443. \u0427\u0435\u0440\u0435\u0437
      \u0448\u0435\u0441\u0442\u044C \u0434\u043D\u0435\u0439 \u0432 \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0435
      \u0441\u0442\u0430\u043D\u0435\u0442 \u044F\u0441\u043D\u043E, \u043A\u0430\u043A
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u043B\u043E
      \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129864
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129865
    m_Localized: "\u0412\u044B \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442\u0435:
      \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u043D\u0443\u0436\u0435\u043D \u0432\u0430\u043C \u0441\u0430\u043C\u043E\u043C\u0443.
      \u0420\u0443\u0441\u0442\u0430\u043C \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442.
      \u041E\u0431\u043E\u0437\u044B \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F.
      \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u0443 \u043B\u044E\u0434\u0435\u0439
      \u0447\u0443\u0442\u044C \u043B\u0443\u0447\u0448\u0435 - \u043D\u0438\u043A\u0430\u043A\u0438\u0445
      \u043B\u0438\u0448\u043D\u0438\u0445 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129866
    m_Localized: "\u0412\u0435\u0440\u0431\u043B\u044E\u0434 \u0437\u0430\u0445\u0440\u043E\u043C\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129867
    m_Localized: "\u0412 \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0435 \u0420\u0443\u0441\u0442\u0430\u043C
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0432\u0430\u0441 \u0441
      \u0432\u0438\u043D\u043E\u0432\u0430\u0442\u044B\u043C \u043B\u0438\u0446\u043E\u043C.
      \u0412\u0430\u0448 \u0432\u0435\u0440\u0431\u043B\u044E\u0434 \u0441\u0442\u043E\u0438\u0442
      \u0440\u044F\u0434\u043E\u043C - \u043F\u0440\u0430\u0432\u0430\u044F \u043F\u0435\u0440\u0435\u0434\u043D\u044F\u044F
      \u043D\u043E\u0433\u0430 \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043D\u0430,
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u0435\u0434\u0432\u0430 \u0441\u0442\u0443\u043F\u0430\u0435\u0442.
      <npc_speech lang=\"Persian\">\u041A\u0430\u043C\u0435\u043D\u044C \u0432 \u0433\u043E\u0440\u043B\u0435
      \u0443\u0449\u0435\u043B\u044C\u044F. \u042F \u043D\u0435 \u0443\u0441\u043B\u0435\u0434\u0438\u043B.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u0432\u0435\u0440\u043D\u0443 - \u0443
      \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C.</npc_speech> \u0412\u0435\u0440\u0431\u043B\u044E\u0434
      \u043D\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044F \u0432 \u043B\u0435\u0447\u0435\u043D\u0438\u0438
      \u0438 \u043D\u0435\u0434\u0435\u043B\u0435 \u043E\u0442\u0434\u044B\u0445\u0430.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u043E\u0442 \u0420\u0443\u0441\u0442\u0430\u043C\u0430
      \u043F\u043E\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0447\u0430\u0441\u0442\u044C,
      \u043D\u043E \u043D\u0435 \u0432\u0441\u0451 - \u0432\u0435\u0442\u0435\u0440\u0438\u043D\u0430\u0440
      \u0432 \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0435 \u0434\u043E\u0440\u043E\u0433,
      \u0438 \u0432\u0440\u0435\u043C\u044F \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0436\u0435
      \u0441\u0435\u0440\u0435\u0431\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129868
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438
      \u0438 \u043B\u0435\u0447\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129869
    m_Localized: "\u0420\u0443\u0441\u0442\u0430\u043C \u0432\u044B\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0447\u0430\u0441\u0442\u044C. \u0412\u0435\u0440\u0431\u043B\u044E\u0434
      \u043B\u0435\u0447\u0438\u0442\u0441\u044F \u043D\u0435\u0434\u0435\u043B\u044E.
      \u041E\u0431\u043E\u0437 \u0441\u0442\u043E\u0438\u0442. \u0414\u0435\u043D\u044C\u0433\u0438
      \u0443\u0442\u0435\u043A\u043B\u0438, \u0432\u0440\u0435\u043C\u044F - \u0442\u043E\u0436\u0435.
      \u041E\u0434\u043E\u043B\u0436\u0451\u043D\u043D\u043E\u0435 \u0434\u043E\u0431\u0440\u043E\u0435
      \u0434\u0435\u043B\u043E \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u043E\u0441\u044C
      \u043F\u0440\u044F\u043C\u044B\u043C \u0443\u0431\u044B\u0442\u043A\u043E\u043C
      - \u0443\u0440\u043E\u043A \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438: \u0434\u043E\u0432\u0435\u0440\u0438\u0435 \u0441\u0442\u043E\u0438\u0442
      \u0432\u0437\u0432\u0435\u0448\u0438\u0432\u0430\u0442\u044C, \u043A\u0430\u043A
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129870
    m_Localized: "\u0421\u0434\u0435\u043B\u043A\u0430 \u0441 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129871
    m_Localized: "\u0412 \u043F\u043E\u043B\u0443\u0442\u0451\u043C\u043D\u043E\u043C
      \u0443\u0433\u043B\u0443 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430 - \u043D\u0435\u0432\u0437\u0440\u0430\u0447\u043D\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432 \u043F\u044B\u043B\u044C\u043D\u043E\u043C
      \u0431\u0443\u0440\u043D\u0443\u0441\u0435. \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0442\u0438\u0445\u043E, \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044F
      \u0433\u043B\u0430\u0437: <npc_speech lang=\"Arabic\">\u0412\u043F\u0435\u0440\u0435\u0434\u0438
      \u043D\u0430 \u0442\u0440\u0430\u043A\u0442\u0435 \u0435\u0441\u0442\u044C
      \u043C\u0435\u0441\u0442\u043E - \u0443\u0449\u0435\u043B\u044C\u0435 \u0425\u0430\u0441\u0430\u043D.
      \u0422\u0430\u043C \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435\u0442. \u041D\u043E \u0435\u0441\u043B\u0438 \u0442\u044B \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0448\u044C
      \u043C\u043D\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F, \u044F \u0441\u043A\u0430\u0436\u0443,
      \u0433\u0434\u0435 \u043F\u0440\u043E\u0435\u0445\u0430\u0442\u044C \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E.</npc_speech>
      \u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0437\u0430 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u043E
      \u0434\u043E\u0440\u043E\u0433\u0435. \u0427\u0435\u043B\u043E\u0432\u0435\u043A
      \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0441 \u043D\u0443\u0436\u043D\u044B\u043C\u0438 \u0441\u0432\u044F\u0437\u044F\u043C\u0438.
      \u0418\u043B\u0438 \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043F\u043E\u0441\u043B\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129872
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0437\u0430
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129873
    m_Localized: "\u041C\u043E\u043D\u0435\u0442\u044B \u0443\u0445\u043E\u0434\u044F\u0442.
      \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440 \u0448\u0435\u043F\u0447\u0435\u0442
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0438 \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442.
      \u0427\u0435\u0440\u0435\u0437 \u0432\u043E\u0441\u0435\u043C\u044C \u0434\u043D\u0435\u0439
      \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u0441\u044F, \u0441\u0442\u043E\u0438\u043B\u0430
      \u043B\u0438 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u0441\u0432\u043E\u0438\u0445
      \u0434\u0435\u043D\u0435\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129874
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u0438 \u0435\u0445\u0430\u0442\u044C
      \u0441\u0432\u043E\u0438\u043C \u043F\u0443\u0442\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129875
    m_Localized: "\u0412\u044B \u0432\u0441\u0442\u0430\u0451\u0442\u0435 \u0438
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u0435. \u0421\u0432\u043E\u0439
      \u043F\u0443\u0442\u044C \u043F\u043E\u043D\u044F\u0442\u0435\u043D. \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u0441\u043B\u0435\u0434 -
      \u0431\u0435\u0437 \u0437\u043B\u043E\u0431\u044B, \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
      \u043E\u0436\u0438\u0434\u0430\u043B \u043E\u0442\u043A\u0430\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129876
    m_Localized: "\u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u0431\u044B\u043B\u0430
      \u043B\u043E\u0432\u0443\u0448\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129877
    m_Localized: "\u0412 \u0443\u0449\u0435\u043B\u044C\u0435 \u0425\u0430\u0441\u0430\u043D
      - \u0437\u0430\u0441\u0430\u0434\u0430. \u0427\u0435\u043B\u043E\u0432\u0435\u043A
      \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u043D\u0430 \u0441\u043A\u043B\u043E\u043D\u0430\u0445,
      \u043B\u0443\u043A\u0438 \u043D\u0430\u0442\u044F\u043D\u0443\u0442\u044B.
      \u041E\u043D\u0438 \u0436\u0434\u0430\u043B\u0438 \u0432\u0430\u0441 \u0438\u043C\u0435\u043D\u043D\u043E
      \u0437\u0434\u0435\u0441\u044C, \u0438\u043C\u0435\u043D\u043D\u043E \u0441\u0435\u0439\u0447\u0430\u0441.
      \u041C\u0430\u0440\u0448\u0440\u0443\u0442 \u043E\u0442 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440\u0430
      \u043F\u0440\u0438\u0432\u0451\u043B \u043F\u0440\u044F\u043C\u043E \u043A
      \u043D\u0438\u043C. \u0414\u043E\u0440\u043E\u0433\u0438 \u043D\u0430\u0437\u0430\u0434
      \u043D\u0435\u0442 - \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043F\u0435\u0440\u0451\u0434,
      \u0441\u043A\u0432\u043E\u0437\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129878
    m_Localized: "\u041F\u0440\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F \u0441
      \u043E\u0445\u0440\u0430\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129879
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u0430 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      \u041F\u0440\u043E\u0440\u044B\u0432 \u0441\u0442\u043E\u0438\u0442 \u043A\u0440\u043E\u0432\u0438
      \u0438 \u043C\u043E\u043D\u0435\u0442 - \u0447\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430
      \u0431\u0440\u043E\u0448\u0435\u043D\u0430, \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043B\u044E\u0434\u0435\u0439 \u0440\u0430\u043D\u0435\u043D\u044B. \u041E\u0431\u043E\u0437
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0438\u0437 \u0443\u0449\u0435\u043B\u044C\u044F
      \u043F\u043E\u043A\u0430\u043B\u0435\u0447\u0435\u043D\u043D\u044B\u043C. \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0441\u0432\u043E\u0438 \u0434\u0435\u043D\u044C\u0433\u0438
      \u0434\u0432\u0430\u0436\u0434\u044B: \u043E\u0442 \u0432\u0430\u0441 \u0438
      \u043E\u0442 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129880
    m_Localized: "\u041E\u0431\u0449\u0438\u0439 \u043B\u0430\u0433\u0435\u0440\u044C
      \u0441 \u043A\u0443\u043F\u0446\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129881
    m_Localized: "\u0412\u0435\u0447\u0435\u0440 \u0443 \u0433\u043E\u0440\u043D\u043E\u0439
      \u0440\u0435\u043A\u0438 - \u0434\u0440\u0443\u0433\u043E\u0439 \u043E\u0431\u043E\u0437
      \u0443\u0436\u0435 \u0437\u0430\u043D\u044F\u043B \u043B\u0443\u0447\u0448\u0435\u0435
      \u043C\u0435\u0441\u0442\u043E \u0443 \u0432\u043E\u0434\u044B. \u041A\u0443\u043F\u0435\u0446
      \u0424\u0430\u0440\u0440\u0443\u0445 \u0438\u0431\u043D \u0414\u0430\u0440\u0438\u0443\u0448
      \u0438\u0437 \u0411\u0443\u0445\u0430\u0440\u044B \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
      \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C \u043A\u043E\u0441\u0442\u0451\u0440:
      <npc_speech lang=\"Persian\">\u041C\u0435\u0441\u0442\u0430 \u0445\u0432\u0430\u0442\u0438\u0442.
      \u0423 \u043C\u0435\u043D\u044F \u043B\u0438\u0448\u043D\u0438\u0439 \u043A\u043E\u0442\u0451\u043B
      \u043F\u043B\u043E\u0432\u0430. \u0423 \u0442\u0435\u0431\u044F \u043E\u0445\u0440\u0430\u043D\u0430
      \u043B\u0443\u0447\u0448\u0435.</npc_speech> \u0424\u0430\u0440\u0440\u0443\u0445
      \u0431\u043E\u0439\u043A\u0438\u0439, \u0445\u043E\u0440\u043E\u0448\u043E
      \u0437\u043D\u0430\u0435\u0442 \u0434\u043E\u0440\u043E\u0433\u0443. \u041D\u0430
      \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C \u043F\u0443\u0442\u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435
      \u0441\u043E\u044E\u0437\u044B \u0443 \u043B\u0430\u0433\u0435\u0440\u043D\u043E\u0433\u043E
      \u043E\u0433\u043D\u044F \u0447\u0430\u0441\u0442\u043E \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
      \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u043C\u0438 \u0434\u0435\u043B\u043E\u0432\u044B\u043C\u0438
      \u0441\u0432\u044F\u0437\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129882
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129883
    m_Localized: "\u041B\u0430\u0433\u0435\u0440\u044F \u0441\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F.
      \u041F\u043B\u043E\u0432 \u0438\u0437 \u043A\u043E\u0442\u043B\u0430 \u0424\u0430\u0440\u0440\u0443\u0445a
      - \u0437\u0438\u0440\u0430 \u0438 \u043C\u043E\u0440\u043A\u043E\u0432\u044C,
      \u0436\u0438\u0440\u043D\u044B\u0439. \u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u0434\u043E\u043B\u0433\u0438\u0439. \u0427\u0435\u0440\u0435\u0437 \u043E\u0434\u0438\u043D\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u043D\u0435\u0439 \u043F\u0443\u0442\u0438 \u0432\u044B \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u0435
      \u0424\u0430\u0440\u0440\u0443\u0445a \u0441\u043D\u043E\u0432\u0430 \u0432
      \u0434\u0440\u0443\u0433\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u0435 -
      \u0438 \u043E\u043D \u0432\u0430\u0441 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129884
    m_Localized: "\u0414\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129885
    m_Localized: "\u0412\u044B \u0432\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435\u0441\u044C.
      \u0421\u0442\u0430\u0432\u0438\u0442\u0435 \u043B\u0430\u0433\u0435\u0440\u044C
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0435. \u0422\u0438\u0445\u0438\u0439
      \u0432\u0435\u0447\u0435\u0440, \u0431\u0435\u0437 \u0447\u0443\u0436\u0438\u0445
      \u0443\u0448\u0435\u0439. \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0443 \u043B\u044E\u0434\u0435\u0439 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129886
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u0424\u0430\u0440\u0440\u0443\u0445\u043E\u043C
      \u0432 \u0433\u043E\u0440\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129887
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u041C\u0435\u0440\u0432\u0430
      \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0435 \u043B\u0438\u0446\u043E -
      \u0424\u0430\u0440\u0440\u0443\u0445 \u0432 \u0447\u0438\u0441\u0442\u043E\u043C
      \u043A\u0430\u0444\u0442\u0430\u043D\u0435, \u0440\u044F\u0434\u043E\u043C
      \u0434\u0432\u043E\u0435 \u043D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u043E\u0432.
      \u041E\u043D \u0443\u0437\u043D\u0430\u0451\u0442 \u0432\u0430\u0441 \u0441
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438 \u0448\u0430\u0433\u043E\u0432
      \u0438 \u0438\u0434\u0451\u0442 \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443
      \u0441 \u0448\u0438\u0440\u043E\u043A\u043E\u0439 \u0443\u043B\u044B\u0431\u043A\u043E\u0439:
      <npc_speech lang=\"Persian\">\u041A\u0443\u043F\u0435\u0446 \u0443 \u0440\u0435\u043A\u0438!
      \u042F \u0437\u0434\u0435\u0441\u044C \u0442\u0440\u0438 \u0434\u043D\u044F
      - \u0440\u044B\u043D\u043E\u043A \u0445\u043E\u0440\u043E\u0448\u043E \u0438\u0434\u0451\u0442.
      \u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C
      \u043E \u0434\u0435\u043B\u0435. \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E
      \u0442\u043E, \u0447\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C,
      \u0442\u0435\u0431\u0435 - \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F.</npc_speech>
      \u041E\u0431\u0449\u0438\u0439 \u0432\u0435\u0447\u0435\u0440 \u0443 \u043A\u043E\u0441\u0442\u0440\u0430
      \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0441\u044F \u0432 \u0434\u0435\u043B\u043E\u0432\u043E\u0439
      \u043A\u043E\u043D\u0442\u0430\u043A\u0442 \u0432 \u043D\u0443\u0436\u043D\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129888
    m_Localized: "\u0417\u0430\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0441\u0434\u0435\u043B\u043A\u0443
      \u0441 \u0424\u0430\u0440\u0440\u0443\u0445\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129889
    m_Localized: "\u0424\u0430\u0440\u0440\u0443\u0445 \u0442\u043E\u0440\u0433\u0443\u0435\u0442
      \u0431\u044B\u0441\u0442\u0440\u043E \u0438 \u0447\u0435\u0441\u0442\u043D\u043E.
      \u0421\u0434\u0435\u043B\u043A\u0430 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u043F\u043E\u043B\u0443\u0434\u043D\u044E. \u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u043F\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0441\u0432\u0435\u0440\u0445
      \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E - \u044D\u0442\u043E \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
      \u043E\u0434\u043D\u043E\u0433\u043E \u0432\u0435\u0447\u0435\u0440\u0430 \u0443
      \u043A\u043E\u0441\u0442\u0440\u0430 \u043E\u0434\u0438\u043D\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u043D\u0435\u0439 \u043D\u0430\u0437\u0430\u0434. \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C \u0441\u0442\u0440\u043E\u0438\u0442\u0441\u044F \u043D\u0430
      \u0442\u0430\u043A\u0438\u0445 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0445,
      \u043D\u043E \u043F\u0430\u043C\u044F\u0442\u043D\u044B\u0445 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129890
    m_Localized: "\u0423\u0437\u043D\u0430\u0442\u044C \u043E \u0434\u043E\u0440\u043E\u0433\u0435
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129891
    m_Localized: "\u0424\u0430\u0440\u0440\u0443\u0445 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043E \u0446\u0435\u043D\u0430\u0445, \u043F\u043E\u0441\u0442\u0430\u0445
      \u0438 \u0442\u0440\u0443\u0434\u043D\u044B\u0445 \u0443\u0447\u0430\u0441\u0442\u043A\u0430\u0445
      \u043F\u0443\u0442\u0438. \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
      \u0438\u0437 \u043F\u0435\u0440\u0432\u044B\u0445 \u0440\u0443\u043A \u0441\u0442\u043E\u0438\u0442
      \u0434\u043E\u0440\u043E\u0436\u0435 \u043B\u044E\u0431\u043E\u0433\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u0441\u043F\u0440\u0430\u0432\u043E\u0447\u043D\u0438\u043A\u0430. \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0435
      \u043D\u0430\u0432\u044B\u043A\u0438 \u0440\u0430\u0441\u0442\u0443\u0442 -
      \u0432\u044B \u0437\u043D\u0430\u0435\u0442\u0435, \u0447\u0442\u043E \u0436\u0434\u0451\u0442
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129892
    m_Localized: "\u0422\u043E\u0432\u0430\u0440 \u0432 \u0434\u043E\u043B\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129893
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      - \u0431\u0443\u0445\u0430\u0440\u0441\u043A\u0438\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0448\u0451\u043B\u043A\u043E\u043C \u0441 \u043F\u044F\u0442\u043D\u0430\u043C\u0438
      \u0441\u0438\u043D\u0435\u0439 \u043A\u0440\u0430\u0441\u043A\u0438 \u043D\u0430
      \u043F\u0430\u043B\u044C\u0446\u0430\u0445 \u043E\u0442 \u043F\u043E\u0434\u043A\u0440\u0430\u0441\u043A\u0438
      \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u0432 - \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
      \u0442\u0440\u0438 \u0442\u044E\u043A\u0430 \u0431\u043E\u043A\u0445\u0430\u0440\u0441\u043A\u043E\u0433\u043E
      \u0431\u0430\u0440\u0445\u0430\u0442\u0430 \u0431\u0435\u0437 \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E\u0439
      \u043E\u043F\u043B\u0430\u0442\u044B: <npc_speech lang=\"Sogdian\">\u0420\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u0435\u0448\u044C\u0441\u044F
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435. \u042F
      \u0437\u043D\u0430\u044E \u0442\u0432\u043E\u0451 \u0441\u043B\u043E\u0432\u043E
      - \u043E\u043D\u043E \u0442\u044F\u0436\u0435\u043B\u0435\u0435, \u0447\u0435\u043C
      \u043B\u044E\u0431\u0430\u044F \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0430.</npc_speech>
      \u041A\u0440\u0435\u0434\u0438\u0442 \u0431\u0435\u0437 \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0438
      - \u0432\u044B\u0441\u0448\u0430\u044F \u0444\u043E\u0440\u043C\u0430 \u0434\u043E\u0432\u0435\u0440\u0438\u044F
      \u0432 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0435.
      \u0415\u0441\u043B\u0438 \u043D\u0435 \u0440\u0430\u0441\u043F\u043B\u0430\u0442\u0438\u0442\u044C\u0441\u044F,
      \u0438\u043C\u044F \u0441\u0442\u0430\u043D\u0435\u0442 \u0445\u0443\u0436\u0435
      \u043B\u044E\u0431\u043E\u0433\u043E \u0434\u043E\u043B\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129894
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0432\u0435\u0441\u044C
      \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129895
    m_Localized: "\u0422\u0440\u0438 \u0442\u044E\u043A\u0430 \u0431\u0430\u0440\u0445\u0430\u0442\u0430
      - \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0442\u043E\u0432\u0430\u0440
      \u0434\u043B\u044F \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0432\u043C\u0435\u0441\u0442\u043E \u0437\u0430\u043B\u043E\u0433\u0430.
      \u041D\u043E \u0435\u0441\u043B\u0438 \u043D\u0435 \u0440\u0430\u0441\u043F\u043B\u0430\u0442\u0438\u0442\u044C\u0441\u044F
      \u0432 \u0441\u0440\u043E\u043A - \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0435\u0442 \u0432\u0441\u0435\u043C
      \u043A\u0443\u043F\u0446\u0430\u043C \u043E\u0442 \u041C\u0435\u0440\u0432\u0430
      \u0434\u043E \u041A\u0430\u0448\u0433\u0430\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129896
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u0442\u044E\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129897
    m_Localized: "\u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u0442\u043E\u0432\u0430\u0440\u0430
      - \u0432\u0434\u0432\u043E\u0435 \u043C\u0435\u043D\u044C\u0448\u0438\u0439
      \u0440\u0438\u0441\u043A. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u043A\u0438\u0432\u043D\u0443\u043B: \u0440\u0430\u0437\u0443\u043C\u043D\u044B\u0439
      \u043A\u0443\u043F\u0435\u0446 \u043D\u0435 \u0431\u0435\u0440\u0451\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043C\u043E\u0436\u0435\u0442
      \u043F\u0440\u043E\u0434\u0430\u0442\u044C. \u0414\u043E\u0432\u0435\u0440\u0438\u0435
      \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u043E \u0432 \u043F\u043E\u043B\u043D\u043E\u0439
      \u043C\u0435\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129898
    m_Localized: "\u041E\u0442\u0441\u0440\u043E\u0447\u043A\u0430 \u043E\u0442 \u0441\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0441\u043A\u043E\u0433\u043E
      \u0431\u0430\u043D\u043A\u0438\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129899
    m_Localized: "\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0441\u043A\u0438\u0439
      \u043C\u0435\u043D\u044F\u043B\u0430 \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0438\u0431\u043D \u0411\u0430\u0445\u0440\u0430\u043C \u0432\u0435\u0434\u0451\u0442
      \u0443\u0447\u0451\u0442 \u0441 \u043F\u0435\u0434\u0430\u043D\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u044C\u044E
      \u0437\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0446\u0430 -
      \u043A\u0430\u0436\u0434\u0430\u044F \u043C\u043E\u043D\u0435\u0442\u0430 \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u0430
      \u0434\u0432\u0430\u0436\u0434\u044B. \u041D\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u043E\u043D \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043A\u043D\u0438\u0433\u0443
      \u0440\u0430\u043D\u044C\u0448\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438:
      <npc_speech lang=\"Sogdian\">\u0422\u044B \u0434\u043E\u043B\u0436\u0435\u043D
      \u043C\u043D\u0435 \u043E\u0442 \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E
      \u043C\u0435\u0441\u044F\u0446\u0430. \u042F \u0437\u043D\u0430\u044E \u0442\u0432\u043E\u0451
      \u0438\u043C\u044F. \u041F\u043B\u0430\u0442\u0438 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u043D\u0435\u0439 -
      \u0431\u0435\u0437 \u0448\u0442\u0440\u0430\u0444\u0430. \u0427\u0435\u0441\u0442\u043D\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0443\u0441\u043F\u0435\u0435\u0442.</npc_speech>
      \u041E\u0442\u0441\u0440\u043E\u0447\u043A\u0430 \u0434\u043E\u043B\u0433\u0430
      \u0431\u0435\u0437 \u0448\u0442\u0440\u0430\u0444\u0430 - \u043F\u0440\u0438\u0432\u0438\u043B\u0435\u0433\u0438\u044F,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0434\u0430\u0451\u0442 \u043E\u0434\u043D\u043E\u043C\u0443 \u043A\u0443\u043F\u0446\u0443
      \u0438\u0437 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129900
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043E\u0442\u0441\u0440\u043E\u0447\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129901
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u043D\u0435\u0439
      - \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0441\u0440\u043E\u043A \u0434\u043B\u044F
      \u043C\u0430\u043D\u0451\u0432\u0440\u0430. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0451\u043D\u043D\u043E\u0441\u0442\u044C
      \u0438 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043A\u043D\u0438\u0433\u0443.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0430\u0441\u044C
      \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u0443\u044E \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u0443\u044E
      \u0433\u0438\u0431\u043A\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129902
    m_Localized: "\u0412\u044B\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0441\u0440\u0430\u0437\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129903
    m_Localized: "\u0412\u044B \u043F\u043B\u0430\u0442\u0438\u0442\u0435 \u0441\u0435\u0439\u0447\u0430\u0441.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0434\u043E\u0432\u043E\u043B\u0435\u043D,
      \u0447\u0442\u043E \u043D\u0435 \u0436\u0434\u0451\u0442, - \u0441\u0442\u0430\u0432\u0438\u0442
      \u0433\u0430\u043B\u043E\u0447\u043A\u0443 \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0441\u043B\u043E\u0432. \u0414\u043E\u043B\u0433 \u0437\u0430\u043A\u0440\u044B\u0442,
      \u0441\u043E\u0432\u0435\u0441\u0442\u044C \u0447\u0438\u0441\u0442\u0430,
      \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u043B\u0443\u0447\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129904
    m_Localized: "\u041F\u0438\u0440 \u0443 \u0442\u0430\u043D\u0441\u043A\u043E\u0433\u043E
      \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129905
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0436\u0430\u0440\u0435\u043D\u043E\u0439
      \u0443\u0442\u043A\u0438 \u0438 \u0438\u043C\u0431\u0438\u0440\u043D\u043E\u0433\u043E
      \u0432\u0438\u043D\u0430. \u0421\u043B\u0443\u0433\u0430 \u0441 \u043A\u0440\u0430\u0441\u043D\u043E\u0439
      \u043B\u0435\u043D\u0442\u043E\u0439 \u043D\u0430 \u0448\u0430\u043F\u043A\u0435
      \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F \u0443 \u0432\u043E\u0440\u043E\u0442
      \u0438 \u0437\u0430\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435
      \u0432\u0441\u043B\u0443\u0445: \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440
      \u041B\u0438 \u042E\u0430\u043D\u044C-\u0446\u0437\u0438\u043D \u0437\u043E\u0432\u0451\u0442
      \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u043A\u0443\u043F\u0446\u0430
      \u043A \u0441\u0432\u043E\u0435\u043C\u0443 \u0441\u0442\u043E\u043B\u0443.
      \u0412 \u0437\u0430\u043B\u0435 - \u0448\u0451\u043B\u043A\u043E\u0432\u044B\u0435
      \u0437\u0430\u043D\u0430\u0432\u0435\u0441\u0438, \u043C\u0443\u0437\u044B\u043A\u0430\u043D\u0442\u044B
      \u0441 \u0433\u0443\u0446\u0438\u043D\u044F\u043C\u0438. \u0413\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043F\u043E-\u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438,
      \u043D\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0441
      \u0441 \u043D\u0435\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u043C\u044B\u043C
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u043C: <npc_speech lang=\"Chinese\">\u042F
      \u0441\u043B\u044B\u0448\u0430\u043B \u043E \u0442\u0435\u0431\u0435 \u043E\u0442
      \u0442\u0440\u0451\u0445 \u043A\u0443\u043F\u0446\u043E\u0432. \u0421\u0430\u0434\u0438\u0441\u044C.
      \u0412\u0438\u043D\u043E \u0438\u0437 \u041B\u043E\u044F\u043D\u0430.</npc_speech>
      \u041F\u0438\u0440 \u0443 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F
      \u043A \u043D\u0443\u0436\u043D\u044B\u043C \u043B\u044E\u0434\u044F\u043C
      - \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0430\u043C, \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u0430\u043C,
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u043C \u043F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129906
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129907
    m_Localized: "\u0412\u0435\u0447\u0435\u0440 \u0443 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430
      - \u0435\u0434\u0430, \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u044B,
      \u043D\u0443\u0436\u043D\u044B\u0435 \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0430.
      \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441\u044B\u0442\u044B\u043C,
      \u0441 \u043F\u043E\u0434\u043D\u044F\u0442\u044B\u043C \u0434\u0443\u0445\u043E\u043C
      \u0438 \u0438\u043C\u0435\u043D\u0430\u043C\u0438 \u0442\u0440\u0451\u0445
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043F\u043E\u043C\u043E\u0433\u0443\u0442 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u043E\u043C \u043F\u043E\u0441\u0442\u0443.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u043A\u0430\u043A \u043A\u0430\u043F\u0438\u0442\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129908
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u043B\u043E\u043D\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129909
    m_Localized: "\u0412\u044B \u0441\u0441\u044B\u043B\u0430\u0435\u0442\u0435\u0441\u044C
      \u043D\u0430 \u0441\u043F\u0435\u0448\u043A\u0443. \u0413\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440
      \u043A\u0438\u0432\u0430\u0435\u0442 - \u0434\u0435\u043B\u043E\u0432\u043E\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043F\u043E\u0439\u043C\u0451\u0442
      \u0434\u0435\u043B\u043E\u0432\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.
      \u0421\u043B\u0443\u0433\u0430 \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C
      \u0438 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C \u0441\u0432\u0451\u0440\u0442\u043A\u043E\u043C
      \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0438 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129910
    m_Localized: "\u0411\u0438\u043B\u044C\u0433\u044D \u043F\u0440\u043E\u0441\u0438\u0442\u0441\u044F
      \u0432 \u043E\u0445\u0440\u0430\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129911
    m_Localized: "\u0423 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430 \u0436\u0434\u0451\u0442 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0439
      \u0432\u043E\u0438\u043D \u043B\u0435\u0442 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u0438
      \u043F\u044F\u0442\u0438 - \u0448\u0438\u0440\u043E\u043A\u0438\u0435 \u043F\u043B\u0435\u0447\u0438,
      \u043B\u0443\u043A \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439, \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u0434\u043E\u0441\u043F\u0435\u0445 \u0441 \u043D\u0430\u0448\u0438\u0442\u044B\u043C\u0438
      \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0430\u043C\u0438. \u041E\u043D
      \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0441\u0435\u0431\u044F \u0411\u0438\u043B\u044C\u0433\u044D
      \u0422\u0435\u0433\u0438\u043D \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E: <npc_speech lang=\"Turkic\">\u0422\u0432\u043E\u0451
      \u0438\u043C\u044F \u0437\u043D\u0430\u044E\u0442 \u043D\u0430 \u0442\u0440\u0451\u0445
      \u043F\u043E\u0441\u0442\u0430\u0445. \u042F \u0434\u0435\u0441\u044F\u0442\u044C
      \u043B\u0435\u0442 \u043E\u0445\u0440\u0430\u043D\u044F\u043B \u043E\u0431\u043E\u0437\u044B.
      \u0412\u043E\u0437\u044C\u043C\u0438 \u043C\u0435\u043D\u044F. \u0415\u043C
      \u043C\u0430\u043B\u043E, \u0434\u0435\u0440\u0443\u0441\u044C \u0445\u043E\u0440\u043E\u0448\u043E.</npc_speech>
      \u041E\u043F\u044B\u0442\u043D\u044B\u0439 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0439
      \u0432\u043E\u0438\u043D \u043D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u043F\u0443\u0442\u0438 - \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A: \u043E\u043D \u0437\u043D\u0430\u0435\u0442
      \u043C\u0435\u0441\u0442\u043D\u044B\u0445 \u0432\u043E\u0436\u0434\u0435\u0439,
      \u0441\u0442\u0435\u043F\u043D\u044B\u0435 \u0442\u0440\u043E\u043F\u044B \u0438
      \u043A\u043E\u0433\u0434\u0430 \u043B\u0443\u0447\u0448\u0435 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129912
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0411\u0438\u043B\u044C\u0433\u044D
      \u0432 \u043E\u0445\u0440\u0430\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129913
    m_Localized: "\u0411\u0438\u043B\u044C\u0433\u044D \u0432\u0445\u043E\u0434\u0438\u0442
      \u0432 \u0441\u043E\u0441\u0442\u0430\u0432 \u043E\u0431\u043E\u0437\u0430.
      \u0415\u0433\u043E \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
      \u043C\u0435\u043D\u044F\u0435\u0442 \u0442\u043E, \u043A\u0430\u043A \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0435
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438 \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u043D\u0430 \u0432\u0430\u0448 \u043E\u0431\u043E\u0437 - \u0441 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u043C
      \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u043A\u0443\u043F\u0446\u0430 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u043B\u0430
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0443\u0441\u0438\u043B\u0438\u0442 \u0435\u0451 \u0435\u0449\u0451 \u0431\u043E\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129914
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129915
    m_Localized: "\u0412\u044B \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442\u0435:
      \u0441\u043E\u0441\u0442\u0430\u0432 \u043F\u043E\u043B\u043D\u044B\u0439.
      \u0411\u0438\u043B\u044C\u0433\u044D \u043A\u0438\u0432\u0430\u0435\u0442 \u0431\u0435\u0437
      \u043E\u0431\u0438\u0434\u044B - \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
      \u0432\u043E\u0438\u043D \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442 \u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
      \u043B\u043E\u0433\u0438\u043A\u0443. \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0443 \u043B\u044E\u0434\u0435\u0439 \u0445\u043E\u0440\u043E\u0448\u0435\u0435
      - \u0437\u043D\u0430\u044E\u0442, \u0447\u0442\u043E \u0432\u043E\u0436\u0430\u043A
      \u0434\u0435\u0440\u0436\u0438\u0442 \u043E\u0431\u043E\u0437 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129916
    m_Localized: "\u0421\u043A\u0438\u0434\u043A\u0430 \u043E\u0442 \u0433\u0438\u043B\u044C\u0434\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129917
    m_Localized: "\u0413\u043B\u0430\u0432\u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0439
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      - \u043F\u043E\u043B\u043D\u044B\u0439 \u0441\u043E\u0433\u0434\u0438\u0435\u0446
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0438\u0431\u043D \u0411\u0430\u0445\u0440\u0430\u043C
      - \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0441
      \u043F\u043E\u0432\u0435\u0440\u0445 \u043E\u0447\u043A\u043E\u0432 \u0438\u0437
      \u0433\u043E\u0440\u043D\u043E\u0433\u043E \u0445\u0440\u0443\u0441\u0442\u0430\u043B\u044F.
      <npc_speech lang=\"Sogdian\">\u0422\u044B \u0442\u043E\u0440\u0433\u0443\u0435\u0448\u044C
      \u0447\u0435\u0441\u0442\u043D\u043E. \u041D\u0430\u043C \u0442\u0430\u043A\u0438\u0435
      \u043D\u0443\u0436\u043D\u044B. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
      \u043F\u0430\u0440\u0442\u0438\u044F \u0442\u043E\u0432\u0430\u0440\u0430 -
      \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432
      \u0441\u043A\u0438\u0434\u043A\u0438 \u043F\u043E \u043D\u0430\u0448\u0435\u043C\u0443
      \u043F\u0440\u0435\u0439\u0441\u043A\u0443\u0440\u0430\u043D\u0442\u0443. \u0421\u0432\u043E\u0438\u043C
      \u043A\u0443\u043F\u0446\u0430\u043C \u043C\u044B \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u043C
      \u0441\u0432\u043E\u0438\u043C.</npc_speech> \u0413\u0438\u043B\u044C\u0434\u0438\u0438
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0445 \u043A\u0443\u043F\u0446\u043E\u0432
      \u0434\u0435\u0440\u0436\u0430\u043B\u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435
      \u043F\u0443\u0442\u0438 \u0421\u0440\u0435\u0434\u043D\u0435\u0439 \u0410\u0437\u0438\u0438
      \u0432 VIII \u0432\u0435\u043A\u0435 - \u0438\u0445 \u0441\u043A\u0438\u0434\u043A\u0430
      \u0441\u0442\u043E\u0438\u0442 \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129918
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u043A\u0438\u0434\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129919
    m_Localized: "\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0438 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0437\u0430\u043A\u0443\u043F\u043A\u0435 - \u043F\u0440\u044F\u043C\u043E\u0439
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438.
      \u0413\u0438\u043B\u044C\u0434\u0438\u044F \u0432\u043D\u043E\u0441\u0438\u0442
      \u0432\u0430\u0448\u0435 \u0438\u043C\u044F \u0432 \u0441\u043F\u0438\u0441\u043E\u043A
      \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u0445 \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u043E\u0432:
      \u044D\u0442\u043E \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u0434\u0432\u0435\u0440\u0438
      \u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u0433\u043E\u0440\u043E\u0434\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129920
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
      \u043E \u0440\u044B\u043D\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129921
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0441\u043C\u0435\u0451\u0442\u0441\u044F
      - \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0437 \u0437\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0443.
      \u041E\u043D \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u043B\u0438\u0441\u0442\u043E\u043A
      \u0441 \u0446\u0435\u043D\u0430\u043C\u0438 \u0442\u0440\u0451\u0445 \u0433\u043E\u0440\u043E\u0434\u043E\u0432
      \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u0434\u0432\u0430
      \u043C\u0435\u0441\u044F\u0446\u0430. \u0422\u0430\u043A\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
      \u0438\u0437 \u043F\u0435\u0440\u0432\u044B\u0445 \u0440\u0443\u043A \u0441\u0442\u043E\u0438\u0442
      \u0434\u043E\u0440\u043E\u0436\u0435 \u0441\u043A\u0438\u0434\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129922
    m_Localized: "\u0422\u0430\u0439\u043D\u0430\u044F \u0442\u0440\u043E\u043F\u0430
      \u041D\u0430\u043D\u0430\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129923
    m_Localized: "\u041C\u0435\u0441\u0442\u043D\u044B\u0439 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u041D\u0430\u043D\u0430\u043C - \u043D\u0435\u0432\u044B\u0441\u043E\u043A\u0438\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0441 \u043E\u0431\u0432\u0435\u0442\u0440\u0435\u043D\u043D\u044B\u043C
      \u043B\u0438\u0446\u043E\u043C \u0438 \u0442\u0438\u0445\u0438\u043C \u0433\u043E\u043B\u043E\u0441\u043E\u043C
      - \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0432\u0430\u0441
      \u0443 \u0432\u043E\u0440\u043E\u0442 \u0434\u0435\u0440\u0435\u0432\u043D\u0438.
      \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044F
      \u0432\u0437\u0433\u043B\u044F\u0434\u0430: <npc_speech lang=\"Tibetan\">\u042F
      \u0441\u043B\u044B\u0448\u0430\u043B \u043E \u0442\u0435\u0431\u0435. \u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439
      \u043F\u043E\u0441\u0442 \u043D\u0430 \u0433\u043B\u0430\u0432\u043D\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0435 \u0441\u0442\u043E\u0438\u0442 \u0442\u0440\u0443\u0434\u043D\u043E.
      \u0415\u0441\u0442\u044C \u0442\u0440\u043E\u043F\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0441\u0435\u0432\u0435\u0440\u043D\u044B\u0439 \u043E\u0442\u0440\u043E\u0433
      - \u043E\u0434\u0438\u043D \u0434\u0435\u043D\u044C, \u0438 \u0442\u044B \u0443\u0436\u0435
      \u043F\u043E \u0442\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443. \u041F\u043E\u043A\u0430\u0436\u0443
      \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u0431\u0435.</npc_speech>
      \u0422\u0430\u0439\u043D\u0430\u044F \u0442\u0440\u043E\u043F\u0430 \u0432
      \u043E\u0431\u0445\u043E\u0434 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u0433\u043E
      \u043F\u043E\u0441\u0442\u0430 - \u0437\u043E\u043B\u043E\u0442\u043E \u0434\u043B\u044F
      \u043A\u0443\u043F\u0446\u0430 \u0441 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0435\u0439:
      \u043C\u0435\u0441\u0442\u043D\u044B\u0435 \u0434\u043E\u0432\u0435\u0440\u044F\u044E\u0442
      \u0442\u0430\u043A\u0438\u0435 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B
      \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u043C, \u043A\u0442\u043E
      \u043D\u0435 \u0440\u0430\u0437\u0431\u0430\u043B\u0442\u044B\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129924
    m_Localized: "\u041F\u043E\u0439\u0442\u0438 \u043F\u043E \u0442\u0430\u0439\u043D\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129925
    m_Localized: "\u041D\u0430\u043D\u0430\u043C \u0432\u0435\u0434\u0451\u0442 \u043E\u0431\u043E\u0437
      \u043F\u043E \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u043C\u0443
      \u0441\u043A\u043B\u043E\u043D\u0443. \u0414\u0435\u043D\u044C \u0442\u0440\u0443\u0434\u043D\u044B\u0439,
      \u043D\u043E \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439. \u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439
      \u043F\u043E\u0441\u0442 \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043F\u043E\u0437\u0430\u0434\u0438,
      \u0431\u0435\u0437 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438 \u0438
      \u0431\u0435\u0437 \u0432\u0437\u044F\u0442\u043A\u0438. \u041E\u0434\u0438\u043D
      \u0434\u0435\u043D\u044C \u0432\u044B\u0438\u0433\u0440\u0430\u043D - \u0438
      \u0442\u0440\u043E\u043F\u0430 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C
      \u0442\u0430\u0439\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129926
    m_Localized: "\u041F\u043E\u0435\u0445\u0430\u0442\u044C \u0433\u043B\u0430\u0432\u043D\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129927
    m_Localized: "\u0412\u044B \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u0435
      \u041D\u0430\u043D\u0430\u043C\u0430 \u0438 \u0435\u0434\u0435\u0442\u0435
      \u043F\u043E \u0442\u0440\u0430\u043A\u0442\u0443. \u0427\u0435\u0441\u0442\u043D\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430 - \u0447\u0435\u0441\u0442\u043D\u044B\u0435
      \u043F\u043E\u0448\u043B\u0438\u043D\u044B. \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0443 \u043B\u044E\u0434\u0435\u0439 \u0440\u043E\u0432\u043D\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129928
    m_Localized: "\u0420\u0435\u0434\u043A\u0430\u044F \u043A\u0430\u0440\u0442\u0430
      \u043E\u0442 \u0443\u0447\u0451\u043D\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129929
    m_Localized: "\u041F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439 \u0433\u0435\u043E\u0433\u0440\u0430\u0444
      \u0414\u0430\u0440\u0438\u0443\u0448 \u0438\u0431\u043D \u0420\u0443\u0441\u0442\u0430\u043C
      \u0434\u0435\u043B\u0430\u0435\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u043F\u0440\u0430\u0432\u043A\u0438 \u043D\u0430 \u043A\u0430\u0440\u0442\u0435
      \u0438\u0437 \u0432\u044B\u0434\u0435\u043B\u0430\u043D\u043D\u043E\u0439 \u0442\u0435\u043B\u044F\u0447\u044C\u0435\u0439
      \u043A\u043E\u0436\u0438. \u041E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u0443 \u0438 \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u043A\u0430\u0440\u0442\u0443 \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0438\u0441\u043B\u043E\u0432\u0438\u0439:
      <npc_speech lang=\"Persian\">\u042F \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B
      \u0435\u0451 \u0434\u0432\u0430 \u0433\u043E\u0434\u0430. \u0422\u044B - \u043A\u0443\u043F\u0435\u0446,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0447\u0438\u0442\u0430\u0435\u0442
      \u0434\u043E\u0440\u043E\u0433\u0438, \u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0440\u044B\u043D\u043A\u0438. \u0412\u043E\u0437\u044C\u043C\u0438. \u041E\u043D\u0430
      \u043D\u0430\u0439\u0434\u0451\u0442 \u043B\u0443\u0447\u0448\u0435\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435
      \u0432 \u0434\u043E\u0440\u043E\u0433\u0435.</npc_speech> \u041D\u0430 \u043A\u0430\u0440\u0442\u0435
      - \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B \u0447\u0435\u0440\u0435\u0437
      \u0425\u043E\u0440\u0430\u0441\u0430\u043D \u0441 \u043E\u0442\u043C\u0435\u0442\u043A\u0430\u043C\u0438
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u0432 \u0432\u043E\u0434\u044B
      \u0438 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0445 \u0434\u0432\u043E\u0440\u043E\u0432.
      \u0422\u0430\u043A\u0438\u0435 \u043A\u0430\u0440\u0442\u044B \u043D\u0435
      \u043F\u0440\u043E\u0434\u0430\u044E\u0442\u0441\u044F \u043D\u0430 \u0440\u044B\u043D\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129930
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043A\u0430\u0440\u0442\u0443
      \u0441 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129931
    m_Localized: "\u041A\u0430\u0440\u0442\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u043A \u0432\u0430\u043C. \u041E\u0442\u043C\u0435\u0442\u043A\u0438 \u0414\u0430\u0440\u0438\u0443\u0448\u0430
      \u0442\u043E\u0447\u043D\u044B - \u0432\u043E\u0434\u043D\u044B\u0435 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0438
      \u0442\u0430\u043C, \u0433\u0434\u0435 \u043E\u043D \u043D\u0430\u043F\u0438\u0441\u0430\u043B,
      \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0435 \u0434\u0432\u043E\u0440\u044B
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B. \u0420\u0435\u0434\u043A\u043E\u0435
      \u0437\u043D\u0430\u043D\u0438\u0435, \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u043E\u0435
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129932
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u0438 \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129933
    m_Localized: "\u0412\u044B \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442\u0435:
      \u043A\u0430\u0440\u0442\u0430 \u0434\u043E\u0440\u043E\u0436\u0435 \u0443
      \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442
      \u0440\u0430\u0431\u043E\u0442\u0443. \u0414\u0430\u0440\u0438\u0443\u0448
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0441 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435\u043C
      - \u043F\u043E\u0442\u043E\u043C \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C.
      \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u0434\u043E\u0431\u0440\u044B\u043C
      \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u043C \u0438 \u0431\u0435\u0437
      \u043B\u0438\u0448\u043D\u0435\u0439 \u0431\u0443\u043C\u0430\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129934
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u0441\u0435\u043A\u0440\u0435\u0442
      \u043E \u0446\u0435\u043D\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129935
    m_Localized: "\u041D\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u043C \u0432\u0435\u0447\u0435\u0440\u0435
      \u0443 \u0433\u0438\u043B\u044C\u0434\u0438\u0438 \u043A\u0443\u043F\u0435\u0446
      \u0438\u0437 \u0425\u043E\u0442\u0430\u043D\u0430 \u0431\u0435\u0440\u0451\u0442
      \u0432\u0430\u0441 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0438
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E: <npc_speech
      lang=\"Khotanese\">\u0412 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0435
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0434\u0435\u0444\u0438\u0446\u0438\u0442
      \u0448\u0451\u043B\u043A\u0430 - \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0435
      \u0434\u043E\u0440\u043E\u0433\u0438 \u0437\u0430\u043A\u0440\u044B\u0442\u044B
      \u0442\u0440\u0435\u0442\u0438\u0439 \u043C\u0435\u0441\u044F\u0446. \u0426\u0435\u043D\u0430
      \u0432\u0434\u0432\u043E\u0435 \u043F\u0440\u043E\u0442\u0438\u0432 \u043E\u0431\u044B\u0447\u043D\u043E\u0439.
      \u042D\u0442\u043E \u044F \u0433\u043E\u0432\u043E\u0440\u044E \u0442\u043E\u043B\u044C\u043A\u043E
      \u0442\u0435\u0431\u0435 - \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E
      \u0442\u044B \u043D\u0435 \u0438\u0437 \u0442\u0435\u0445, \u043A\u0442\u043E
      \u0441\u0440\u0430\u0437\u0443 \u0432\u0441\u0435\u043C \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442.</npc_speech>
      \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u043E \u0434\u0435\u0444\u0438\u0446\u0438\u0442\u0435
      - \u043F\u0440\u044F\u043C\u043E\u0435 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0435
      \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E. \u0414\u043E\u0432\u0435\u0440\u0438\u0435
      \u043A\u0443\u043F\u0446\u043E\u0432 \u0441\u0442\u0440\u043E\u0438\u0442\u0441\u044F
      \u043D\u0430 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129936
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129937
    m_Localized: "\u0412\u044B \u043C\u0435\u043D\u044F\u0435\u0442\u0435 \u043F\u043B\u0430\u043D
      \u0437\u0430\u043A\u0443\u043F\u043E\u043A. \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
      \u0438\u0437 \u043F\u0435\u0440\u0432\u044B\u0445 \u0440\u0443\u043A \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u043D\u0430\u0432\u044B\u043A:
      \u0432\u044B \u0443\u0447\u0438\u0442\u0435\u0441\u044C \u0447\u0438\u0442\u0430\u0442\u044C
      \u0440\u044B\u043D\u043E\u043A \u0447\u0435\u0440\u0435\u0437 \u043B\u044E\u0434\u0435\u0439,
      \u0430 \u043D\u0435 \u0447\u0435\u0440\u0435\u0437 \u043F\u0440\u0435\u0439\u0441\u043A\u0443\u0440\u0430\u043D\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129938
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129939
    m_Localized: "\u0412\u044B \u043A\u0438\u0432\u0430\u0435\u0442\u0435 \u0438
      \u043C\u043E\u043B\u0447\u0438\u0442\u0435. \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0435
      \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0432 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C
      \u043A\u0440\u0443\u0433\u0443 - \u0438 \u043A\u0443\u043F\u0435\u0446 \u0438\u0437
      \u0425\u043E\u0442\u0430\u043D\u0430 \u044D\u0442\u043E \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442.
      \u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043C\u043E\u043D\u0435\u0442\u0430
      \u0437\u0430 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435 \u043D\u0435
      \u043D\u0443\u0436\u043D\u0430 - \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0441\u0430\u043C\u0430 \u0441\u0435\u0431\u044F \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129940
    m_Localized: "\u041F\u043B\u0435\u043D\u043D\u044B\u0439 \u043B\u0430\u0437\u0443\u0442\u0447\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129941
    m_Localized: "\u0413\u043E\u0440\u044F\u0447\u0438\u0439 \u043F\u043E\u043B\u0434\u0435\u043D\u044C
      \u043D\u0430 \u0443\u0437\u043A\u043E\u043C \u0443\u0449\u0435\u043B\u044C\u0435.
      \u0412\u0430\u0448\u0438 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0441\u0445\u0432\u0430\u0442\u0438\u043B\u0438 \u0442\u044E\u0440\u043A\u0430
      - \u043C\u043E\u043B\u043E\u0434\u043E\u0439, \u0440\u044F\u0431\u043E\u0435
      \u043B\u0438\u0446\u043E, \u043F\u043E\u044F\u0441 \u0431\u0435\u0437 \u043E\u0440\u0443\u0436\u0438\u044F.
      \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0438\u0441\u043F\u043E\u0434\u043B\u043E\u0431\u044C\u044F,
      \u043A\u0440\u043E\u0432\u044C \u0437\u0430\u043F\u0435\u043A\u043B\u0430\u0441\u044C
      \u043D\u0430 \u0433\u0443\u0431\u0435. <npc_speech lang=\"Old_Turkic\">\u042F
      \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u0434\u043E\u0440\u043E\u0433\u0443. \u041D\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A.</npc_speech>
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0436\u0434\u0451\u0442 \u0432\u0430\u0448\u0435\u0433\u043E
      \u0441\u043B\u043E\u0432\u0430. \u041F\u0435\u0440\u0435\u0434\u0430\u0442\u044C
      \u0441\u0442\u0440\u0430\u0436\u0435 - \u0437\u043D\u0430\u0447\u0438\u0442
      \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C \u043F\u043E\u043B\u0434\u043D\u044F
      \u0438 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0437\u0430
      \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0443. \u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      - \u0437\u043D\u0430\u0447\u0438\u0442 \u0440\u0438\u0441\u043A\u043D\u0443\u0442\u044C.
      \u041F\u043E\u0434\u043E\u0431\u043D\u0430\u044F \u0432\u0441\u0442\u0440\u0435\u0447\u0430
      \u043D\u0430 \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C \u043F\u0443\u0442\u0438
      \u0431\u044B\u0432\u0430\u0435\u0442 \u0438 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435\u043C,
      \u0438 \u043B\u043E\u0432\u0443\u0448\u043A\u043E\u0439: \u0441\u0442\u0435\u043F\u043D\u044B\u0435
      \u043A\u043B\u0430\u043D\u044B \u043F\u043E\u043C\u043D\u044F\u0442 \u0434\u043E\u0431\u0440\u043E
      \u0438 \u043E\u0431\u0438\u0434\u044B \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E
      \u0434\u043E\u043B\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129942
    m_Localized: "\u041F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u0441\u0442\u0440\u0430\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129943
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u0430 \u0432\u0437\u044F\u043B\u0430
      \u0442\u044E\u0440\u043A\u0430 \u0431\u0435\u0437 \u0441\u043B\u043E\u0432
      - \u0438 \u0432\u044B\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u0441\u0447\u0451\u0442
      \u0437\u0430 \u043A\u043E\u043D\u0432\u043E\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0441\u043F\u043B\u044E\u043D\u0443\u043B
      \u043D\u0430 \u0437\u0435\u043C\u043B\u044E: \u043B\u0438\u0448\u043D\u0438\u0435
      \u043C\u043E\u043D\u0435\u0442\u044B, \u043B\u0438\u0448\u043D\u0438\u0435
      \u0447\u0430\u0441\u044B. \u0417\u0430\u0442\u043E \u0447\u0438\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129944
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0441 \u043C\u0438\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129945
    m_Localized: "\u0422\u044E\u0440\u043A \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F,
      \u043F\u043E\u0442\u0451\u0440 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u044F,
      \u043A\u0438\u0432\u043D\u0443\u043B - \u0438 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0441\u044F
      \u0432 \u043A\u0430\u043C\u043D\u044F\u0445. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u043F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u043B. \u0427\u0442\u043E
      \u0438\u0437 \u044D\u0442\u043E\u0433\u043E \u0432\u044B\u0439\u0434\u0435\u0442
      - \u0443\u0437\u043D\u0430\u0435\u0442\u0435 \u0447\u0435\u0440\u0435\u0437
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129946
    m_Localized: "\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
      \u0442\u044E\u0440\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129947
    m_Localized: "\u041D\u0430 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u0439 \u0441\u0442\u043E\u044F\u043D\u043A\u0435
      \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u0442\u043E\u0442 \u0441\u0430\u043C\u044B\u0439
      \u0440\u044F\u0431\u043E\u0439 \u0442\u044E\u0440\u043A - \u0442\u0435\u043F\u0435\u0440\u044C
      \u0441 \u0434\u0432\u0443\u043C\u044F \u043F\u0443\u0441\u0442\u044B\u043C\u0438
      \u0432\u044C\u044E\u043A\u0430\u043C\u0438 \u0438 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u043C.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u0438\u0441\u0445\u043E\u0434\u043E\u0432:
      \u0441 \u043C\u0438\u0440\u043E\u043C \u0438\u043B\u0438 \u0441 \u0434\u0440\u0430\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129948
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129949
    m_Localized: "\u0422\u044E\u0440\u043A \u043F\u0440\u0438\u0432\u0451\u043B \u0441\u0432\u043E\u0435\u0433\u043E
      \u0434\u044F\u0434\u044E - \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430
      - \u0438 \u043F\u0440\u0438\u043D\u0451\u0441 \u0432\u044F\u043B\u0435\u043D\u043E\u0435
      \u043C\u044F\u0441\u043E \u0438 \u043A\u0443\u0440\u0442. <npc_speech lang=\"Old_Turkic\">\u0414\u043E\u043B\u0433
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F.</npc_speech>
      \u0421\u0442\u0435\u043F\u043D\u043E\u0439 \u0437\u0430\u043A\u043E\u043D \u0447\u0435\u0441\u0442\u0438
      \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B: clan-\u043F\u0430\u043C\u044F\u0442\u044C
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0432\u044B\u0433\u043E\u0434\u044B
      \u043E\u0434\u043D\u043E\u0433\u043E \u0434\u043D\u044F. \u0414\u043E\u0440\u043E\u0433\u0430
      \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0431\u0440\u043E\u0434\u0430
      \u043F\u0440\u043E\u0439\u0434\u0451\u0442 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129950
    m_Localized: "\u041F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u043A \u0431\u043E\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129951
    m_Localized: "\u0422\u044E\u0440\u043A \u043F\u0440\u0438\u0448\u0451\u043B \u043D\u0435
      \u043E\u0434\u0438\u043D - \u0437\u0430 \u043D\u0438\u043C \u0435\u0449\u0451
      \u0442\u0440\u043E\u0435 \u0441 \u043B\u0443\u043A\u0430\u043C\u0438. \u0412\u044B
      \u0443\u0441\u043F\u0435\u043B\u0438 \u0432\u044B\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043E\u0445\u0440\u0430\u043D\u0443. \u041D\u0430\u043B\u0451\u0442 \u043E\u0431\u043E\u0448\u0451\u043B\u0441\u044F
      \u043F\u043E\u0442\u0435\u0440\u0435\u0439 \u043C\u043E\u043D\u0435\u0442 \u0438
      \u043D\u0435\u0440\u0432\u0430\u043C\u0438 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432.
      \u0421\u0442\u0435\u043F\u043D\u0430\u044F \u0449\u0435\u0434\u0440\u043E\u0441\u0442\u044C
      \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u043B\u043E\u0432\u0443\u0448\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129952
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129953
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u043A\u0438\u0441\u043B\u043E\u0439
      \u0440\u0432\u043E\u0442\u044B \u0440\u0430\u043D\u044C\u0448\u0435 \u0441\u0430\u043C\u043E\u0433\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430: \u0441\u043E\u0433\u0434\u0438\u0435\u0446
      \u043B\u0435\u0436\u0438\u0442 \u0432 \u0442\u0435\u043D\u0438 \u0447\u0430\u0445\u043B\u043E\u0433\u043E
      \u0442\u043E\u043F\u043E\u043B\u044F, \u0443\u043A\u0440\u044B\u0442 \u0441\u0442\u0430\u0440\u044B\u043C
      \u0445\u0443\u0440\u0434\u0436\u0443\u043D\u043E\u043C. \u041B\u0438\u0446\u043E
      \u0441\u0435\u0440\u043E\u0435, \u0433\u0443\u0431\u044B \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u0432\u0448\u0438\u0435\u0441\u044F.
      <npc_speech lang=\"Sogdian\">\u0421\u0430\u043C\u0435\u0445... \u0438\u0437
      \u041F\u0435\u043D\u0434\u0436\u0438\u043A\u0435\u043D\u0442\u0430. \u0422\u0440\u0438
      \u0434\u043D\u044F \u0431\u0435\u0437 \u0432\u043E\u0434\u044B. \u041F\u0440\u043E\u0448\u0443
      - \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0439\u0442\u0435.</npc_speech>
      \u041A\u0442\u043E-\u0442\u043E \u0443\u0436\u0435 \u043F\u0440\u043E\u0448\u0451\u043B
      \u043C\u0438\u043C\u043E - \u0432\u0438\u0434\u043D\u043E \u043F\u043E \u0441\u043B\u0435\u0434\u0430\u043C
      \u0441\u0430\u043F\u043E\u0433 \u0432 \u043F\u044B\u043B\u0438. \u041F\u043E\u043C\u043E\u0447\u044C
      - \u0437\u043D\u0430\u0447\u0438\u0442 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u0438 \u0437\u0430\u043C\u0435\u0434\u043B\u0438\u0442\u044C\u0441\u044F.
      \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0435 \u043A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u0438\u0435
      \u0441\u0435\u043C\u044C\u0438 - \u043F\u0430\u0443\u0442\u0438\u043D\u0430
      \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u043F\u0443\u0442\u0438: \u043F\u0435\u043D\u0434\u0436\u0438\u043A\u0435\u043D\u0442\u0441\u043A\u0438\u0439
      \u043A\u043B\u0430\u043D \u043F\u043E\u043C\u043D\u0438\u0442 \u0442\u0435\u0445,
      \u043A\u0442\u043E \u043F\u043E\u043C\u043E\u0433 \u0438\u0445 \u043B\u044E\u0434\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129954
    m_Localized: "\u041F\u043E\u043C\u043E\u0447\u044C \u0421\u0430\u043C\u0435\u0445\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129955
    m_Localized: "\u0412\u044B \u043E\u0442\u0434\u0430\u043B\u0438 \u0432\u043E\u0434\u0443,
      \u0435\u0434\u0443 \u0438 \u0447\u0430\u0441 \u0441\u0442\u043E\u044F\u043D\u043A\u0438.
      \u0421\u0430\u043C\u0435\u0445 \u0432\u044B\u043F\u0438\u043B \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E,
      \u043D\u0435 \u0440\u0430\u0441\u043F\u043B\u0435\u0441\u043A\u0430\u0432 \u043D\u0438
      \u043A\u0430\u043F\u043B\u0438 - \u0443\u043C\u0435\u0435\u0442 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C.
      \u0412\u0441\u0442\u0430\u043D\u0435\u0442 \u043B\u0438 \u043D\u0430 \u043D\u043E\u0433\u0438
      - \u043F\u043E\u043A\u0430\u0436\u0443\u0442 \u0434\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129956
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129957
    m_Localized: "\u0412\u044B \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u044B. \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u0442\u0440\u0430\u043A\u0442 \u0434\u043B\u0438\u043D\u043D\u044B\u0439 -
      \u0438 \u043C\u043E\u043B\u0432\u0430 \u043F\u043E \u043D\u0435\u043C\u0443
      \u0445\u043E\u0434\u0438\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129958
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u043E\u0442 \u0421\u0430\u043C\u0435\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129959
    m_Localized: "\u0413\u043E\u043D\u0435\u0446 \u043D\u0430\u0441\u0442\u0438\u0433\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0443 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043A\u043E\u043B\u043E\u0434\u0446\u0430 \u0441 \u043A\u043E\u0436\u0430\u043D\u044B\u043C
      \u043A\u0438\u0441\u0435\u0442\u043E\u043C \u0432 \u0440\u0443\u043A\u0435.
      \u0414\u0432\u0430 \u0438\u0441\u0445\u043E\u0434\u0430 - \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438
      \u043E\u0442 \u0432\u043E\u043B\u0438 \u0421\u0430\u043C\u0435\u0445\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129960
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0431\u0430\u043A\u0448\u0438\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129961
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u0432\u044B\u0436\u0438\u043B.
      \u0412 \u043A\u0438\u0441\u0435\u0442\u0435 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0438 \u043F\u043E\u043B\u043E\u0441\u043A\u0430
      \u043A\u043E\u0436\u0438 \u0441 \u0442\u0438\u0441\u043D\u0435\u043D\u0438\u0435\u043C
      \u043F\u0435\u043D\u0434\u0436\u0438\u043A\u0435\u043D\u0442\u0441\u043A\u043E\u0439
      \u0442\u0430\u043C\u0433\u0438: \u0437\u043D\u0430\u043A, \u0447\u0442\u043E
      \u0432 \u043B\u044E\u0431\u043E\u0439 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0439
      \u0444\u0430\u043A\u0442\u043E\u0440\u0438\u0439 \u0432\u0430\u0441 \u043F\u0440\u0438\u043C\u0443\u0442
      \u043A\u0430\u043A \u0441\u0432\u043E\u0435\u0433\u043E. \u0425\u043E\u0440\u043E\u0448\u0435\u0435
      \u0432\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0442\u0440\u0451\u0445 \u0447\u0430\u0441\u043E\u0432
      \u0438 \u0444\u043B\u0430\u043A\u043E\u043D\u0430 \u0432\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129962
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0432\u0435\u0441\u0442\u044C
      \u0441\u043E \u0441\u043A\u043E\u0440\u0431\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129963
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u0443\u043C\u0435\u0440 \u043D\u0430
      \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439 \u0434\u0435\u043D\u044C.
      \u0413\u043E\u043D\u0435\u0446 - \u0435\u0433\u043E \u043F\u043B\u0435\u043C\u044F\u043D\u043D\u0438\u043A
      - \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F \u0434\u043E \u0437\u0435\u043C\u043B\u0438
      \u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u043C\u0435\u0434\u043D\u044B\u0439 \u0438\u0434\u043E\u043B-\u043E\u0431\u0435\u0440\u0435\u0433:
      \u0432\u0441\u0451, \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C.
      \u041F\u0435\u043D\u0434\u0436\u0438\u043A\u0435\u043D\u0442\u0441\u043A\u0430\u044F
      \u0441\u0435\u043C\u044C\u044F \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0435\u0442
      \u0434\u043E\u0431\u0440\u0430, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0435\u0433\u043E \u043E\u043F\u043B\u0430\u0442\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129964
    m_Localized: "\u041A\u0430\u0440\u0442\u0430 \u043C\u043E\u043D\u0430\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129965
    m_Localized: "\u0411\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u043C\u043E\u043D\u0430\u0445
      \u0441\u0438\u0434\u0438\u0442 \u0443 \u043E\u0431\u043E\u0447\u0438\u043D\u044B
      \u043D\u0430\u0434 \u043A\u0443\u0441\u043A\u043E\u043C \u0431\u0435\u0440\u0451\u0441\u0442\u044B,
      \u0447\u0435\u0440\u0442\u0438\u0442 \u0443\u0433\u043B\u0451\u043C. \u0417\u0430\u043C\u0435\u0447\u0430\u0435\u0442
      \u0432\u0430\u0441, \u043F\u0440\u044F\u0447\u0435\u0442 \u0431\u0435\u0440\u0435\u0441\u0442\u0443
      - \u043F\u043E\u0442\u043E\u043C \u043F\u0435\u0440\u0435\u0434\u0443\u043C\u044B\u0432\u0430\u0435\u0442.
      <npc_speech lang=\"Sogdian\">\u0421\u0442\u0430\u0440\u0430\u044F \u043A\u0443\u0448\u0430\u043D\u0441\u043A\u0430\u044F
      \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0430. \u042F \u0432\u0438\u0434\u0435\u043B
      \u0435\u0451 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442
      \u043D\u0430\u0437\u0430\u0434 - \u043A \u0437\u0430\u043F\u0430\u0434\u0443
      \u043E\u0442 \u0431\u0440\u043E\u0434\u0430 \u0410\u043A-\u0414\u0430\u0440\u044C\u044F,
      \u0437\u0430 \u0442\u0440\u0435\u043C\u044F \u0447\u0451\u0440\u043D\u044B\u043C\u0438
      \u0441\u043A\u0430\u043B\u0430\u043C\u0438. \u0422\u0430\u043C \u0434\u043E\u043B\u0436\u043D\u044B
      \u0431\u044B\u0442\u044C \u043C\u043E\u043D\u0435\u0442\u044B. \u042F \u043C\u043E\u043D\u0430\u0445
      - \u043C\u043D\u0435 \u043D\u0435 \u043D\u0443\u0436\u043D\u043E. \u0412\u0430\u043C,
      \u043C\u043E\u0436\u0435\u0442, \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F.</npc_speech>
      \u041C\u043E\u043D\u0430\u0445 \u0440\u0438\u0441\u0443\u0435\u0442 \u0431\u0435\u0437
      \u043A\u043E\u043B\u0435\u0431\u0430\u043D\u0438\u0439 - \u0437\u043D\u0430\u0447\u0438\u0442,
      \u043B\u0438\u0431\u043E \u0431\u0435\u0441\u043A\u043E\u0440\u044B\u0441\u0442\u0435\u043D,
      \u043B\u0438\u0431\u043E \u0443\u0436\u0435 \u043F\u043E\u0436\u0430\u043B\u0435\u043B
      \u043E \u043D\u0430\u0445\u043E\u0434\u043A\u0435. \u041A\u0440\u044E\u043A
      \u043A \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0435 \u0437\u0430\u0439\u043C\u0451\u0442
      \u0434\u0435\u043D\u044C. \u041D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u043F\u0443\u0442\u0438 \u043A\u0443\u0448\u0430\u043D\u0441\u043A\u0438\u0435
      \u043A\u043B\u0430\u0434\u044B \u043D\u0430\u0445\u043E\u0434\u044F\u0442 \u0440\u0430\u0437
      \u0432 \u0436\u0438\u0437\u043D\u0438 - \u0438 \u0442\u0430\u043A \u0436\u0435
      \u0447\u0430\u0441\u0442\u043E \u0443\u043F\u0443\u0441\u043A\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129966
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u043C\u043E\u043D\u0430\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129967
    m_Localized: "\u041A\u0430\u0440\u0442\u0443 \u0432\u0437\u044F\u043B\u0438.
      \u041C\u043E\u0436\u0435\u0442, \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F.
      \u041C\u043E\u043D\u0430\u0445 \u043A\u0438\u0432\u043D\u0443\u043B \u0438
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043A \u0441\u043E\u0437\u0435\u0440\u0446\u0430\u043D\u0438\u044E
      - \u0435\u043C\u0443 \u0432\u0430\u0436\u0435\u043D \u0431\u044B\u043B \u0441\u0430\u043C
      \u0436\u0435\u0441\u0442, \u0430 \u043D\u0435 \u0432\u0430\u0448\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129968
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u043A \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129969
    m_Localized: "\u0412\u044B \u0441\u0432\u0435\u0440\u043D\u0443\u043B\u0438 \u043A
      \u0410\u043A-\u0414\u0430\u0440\u044C\u0435. \u0414\u0435\u043D\u044C \u0432
      \u043F\u0443\u0442\u0438 \u043F\u043E \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435 - \u0438 \u0443 \u0442\u0440\u0451\u0445 \u0447\u0451\u0440\u043D\u044B\u0445
      \u0441\u043A\u0430\u043B \u043D\u0430\u0448\u043B\u0438 \u0432\u0445\u043E\u0434
      \u0432 \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0443. \u041D\u043E \u0447\u044C\u0438-\u0442\u043E
      \u0441\u043B\u0435\u0434\u044B \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0442\u0430\u043C \u0440\u0430\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129970
    m_Localized: "\u0420\u0430\u0437\u0433\u0440\u0430\u0431\u043B\u0435\u043D\u043D\u0430\u044F
      \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129971
    m_Localized: "\u0412\u0445\u043E\u0434 \u0432 \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0443
      \u0432\u0437\u043B\u043E\u043C\u0430\u043D \u0434\u0430\u0432\u043D\u043E -
      \u0437\u0435\u043C\u043B\u044F \u0432\u043E\u043A\u0440\u0443\u0433 \u0441\u043B\u0435\u0436\u0430\u043B\u0430\u0441\u044C.
      \u0412\u043D\u0443\u0442\u0440\u0438 \u043F\u044B\u043B\u044C\u043D\u043E \u0438
      \u043F\u0443\u0441\u0442\u043E: \u043A\u0443\u0448\u0430\u043D\u0441\u043A\u0438\u0435
      \u043D\u0438\u0448\u0435\u0432\u044B\u0435 \u043F\u043E\u0433\u0440\u0435\u0431\u0435\u043D\u0438\u044F,
      \u0447\u0435\u0440\u0435\u043F\u043A\u0438, \u043D\u0438 \u0435\u0434\u0438\u043D\u043E\u0439
      \u043C\u043E\u043D\u0435\u0442\u044B. \u041A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442
      \u0443\u0441\u043F\u0435\u043B \u0440\u0430\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129972
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129973
    m_Localized: "\u0412\u044B \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442\u0435
      \u043A\u0430\u0436\u0434\u0443\u044E \u043D\u0438\u0448\u0443. \u041C\u043E\u043D\u0435\u0442\u044B
      \u0432\u0437\u044F\u0442\u044B, \u043D\u043E \u0432 \u0434\u0430\u043B\u044C\u043D\u0435\u043C
      \u0443\u0433\u043B\u0443 \u0432\u0430\u043B\u044F\u0435\u0442\u0441\u044F \u043A\u0443\u0441\u043E\u043A
      \u043A\u0443\u0448\u0430\u043D\u0441\u043A\u043E\u0439 \u0442\u0435\u0440\u0440\u0430\u043A\u043E\u0442\u044B
      - \u0433\u043E\u043B\u043E\u0432\u0430 \u0411\u0443\u0434\u0434\u044B \u0441
      \u043F\u043E\u0437\u043E\u043B\u043E\u0442\u043E\u0439. \u041D\u0435\u0432\u0435\u043B\u0438\u043A
      \u043A\u043B\u0430\u0434, \u0437\u0430\u0442\u043E \u0441\u0432\u043E\u0439.
      \u0414\u0435\u043D\u044C \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D,
      \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u043F\u043E\u0434\u043E\u0440\u0432\u0430\u043D\u043E
      - \u043D\u043E \u0443\u0434\u0430\u0447\u0430 \u043B\u044E\u0431\u0438\u0442
      \u043D\u0430\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129974
    m_Localized: "\u041F\u043E\u043F\u0443\u0442\u0447\u0438\u043A \u0431\u0435\u0437
      \u0438\u043C\u0435\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129975
    m_Localized: "\u041D\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u043C
      \u0434\u0432\u043E\u0440\u0435 \u0432 \u041C\u0435\u0440\u0432\u0435 \u043A
      \u0432\u0430\u043C \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      - \u0441\u043C\u0443\u0433\u043B\u044B\u0439, \u0432 \u043F\u044B\u043B\u044C\u043D\u043E\u043C
      \u043A\u0430\u0444\u0442\u0430\u043D\u0435, \u0441 \u0442\u044E\u043A\u043E\u043C
      \u043D\u0430 \u0441\u043F\u0438\u043D\u0435. <npc_speech lang=\"Sogdian\">\u041E\u0434\u0438\u043D,
      \u0438\u0434\u0443 \u0432 \u041D\u0438\u0448\u0430\u043F\u0443\u0440. \u041C\u043E\u0433\u0443
      \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0435\u0434\u043E\u0439. \u041E\u0445\u0440\u0430\u043D\u044F\u0442\u044C,
      \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C - \u0432\u0441\u0451 \u0447\u0442\u043E
      \u0441\u043A\u0430\u0436\u0435\u0442\u0435.</npc_speech> \u0412\u0437\u0433\u043B\u044F\u0434
      \u0431\u0435\u0433\u0430\u0435\u0442. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0448\u0451\u043F\u043E\u0442\u043E\u043C: \xAB\u041E\u0434\u0438\u043D\u043E\u0447\u043A\u0438
      \u0431\u0435\u0437 \u0438\u043C\u0435\u043D\u0438 \u043D\u0435 \u0431\u044B\u0432\u0430\u044E\u0442
      \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0430\u043C\u0438\xBB.
      \u0412\u0437\u044F\u0442\u044C \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A\u0430
      - \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C \u043D\u0430
      \u043E\u0445\u0440\u0430\u043D\u0435 \u0438 \u0435\u0434\u0435. \u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C
      - \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u0440\u0435\u043C\u044F \u043D\u0430 \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u044F.
      \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C \u043F\u043E\u043B\u043E\u043D
      \u0442\u0435\u043C\u0438, \u043A\u0442\u043E \u043F\u0440\u044F\u0447\u0435\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129976
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129977
    m_Localized: "\u0427\u0435\u043B\u043E\u0432\u0435\u043A \u043F\u043E\u0436\u0430\u043B
      \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438 \u0438\u0441\u0447\u0435\u0437
      \u0437\u0430 \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B. \u0421\u043F\u043E\u043A\u043E\u0439\u043D\u0430\u044F
      \u043D\u043E\u0447\u044C \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0436\u0435
      \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u043B\u0435\u043D\u043D\u043E\u0439
      \u0433\u043E\u0440\u0441\u0442\u0438 \u0441\u0443\u0448\u0451\u043D\u043E\u0433\u043E
      \u0438\u0437\u044E\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129978
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129979
    m_Localized: "\u041F\u043E\u043F\u0443\u0442\u0447\u0438\u043A \u0438\u0434\u0451\u0442
      \u043C\u043E\u043B\u0447\u0430, \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u0432 \u0445\u0432\u043E\u0441\u0442\u0435 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430.
      \u0415\u0441\u0442 \u043C\u0430\u043B\u043E, \u0441\u043F\u0438\u0442 \u0443
      \u043A\u043E\u043B\u0435\u0441\u0430. \u0427\u0442\u043E \u0431\u0443\u0434\u0435\u0442
      \u043D\u043E\u0447\u044C\u044E - \u0443\u0437\u043D\u0430\u0435\u0442\u0435
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129980
    m_Localized: "\u041F\u043E\u043F\u0443\u0442\u0447\u0438\u043A \u043F\u043E\u043A\u0430\u0437\u0430\u043B
      \u0441\u0435\u0431\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129981
    m_Localized: "\u0422\u0440\u0435\u0442\u044C\u044F \u043D\u043E\u0447\u044C \u0432
      \u043F\u0443\u0442\u0438. \u041E\u0434\u0438\u043D \u0438\u0437 \u0434\u0432\u0443\u0445
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0445 \u0438\u0441\u0445\u043E\u0434\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129982
    m_Localized: "\u0423\u0442\u0440\u043E \u043F\u043E\u0441\u043B\u0435 \u043A\u0440\u0430\u0436\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129983
    m_Localized: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0442\u0440\u044F\u0441\u0451\u0442 \u0432\u0430\u0441 \u0437\u0430 \u043F\u043B\u0435\u0447\u043E:
      \u043A\u043E\u0448\u0435\u043B\u0451\u043A \u0441 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C\u044E
      \u0434\u0438\u0440\u0445\u0430\u043C\u0430\u043C\u0438 \u0441\u0440\u0435\u0437\u0430\u043D
      \u0441 \u043F\u043E\u044F\u0441\u0430, \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A
      \u0438\u0441\u0447\u0435\u0437. \u0421\u043B\u0435\u0434\u044B \u0432\u0435\u0434\u0443\u0442
      \u043A \u0441\u0443\u0445\u043E\u043C\u0443 \u0440\u0443\u0441\u043B\u0443.
      \u0425\u043E\u0440\u043E\u0448\u043E \u0445\u043E\u0442\u044C \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
      \u0433\u0440\u0443\u0437 \u0446\u0435\u043B - \u043E\u043D \u0438\u0441\u043A\u0430\u043B
      \u043B\u0451\u0433\u043A\u0438\u0435 \u0434\u0435\u043D\u044C\u0433\u0438,
      \u043D\u0435 \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u043B \u0441 \u0442\u044E\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289588129984
    m_Localized: "\u0417\u0430\u0441\u0430\u0434\u0430 - \u0438 \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A
      \u0441\u043F\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324096
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u043D\u0430 \u043B\u0430\u0433\u0435\u0440\u044C
      \u0432\u044B\u0448\u043B\u0438 \u0442\u0440\u043E\u0435 \u0441 \u0434\u0443\u0431\u0438\u043D\u0430\u043C\u0438.
      \u041F\u043E\u043F\u0443\u0442\u0447\u0438\u043A \u0437\u0430\u043A\u0440\u0438\u0447\u0430\u043B
      \u0440\u0430\u043D\u044C\u0448\u0435 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430
      - \u0443\u0441\u043F\u0435\u043B\u0438 \u043F\u043E\u0434\u043D\u044F\u0442\u044C
      \u043B\u044E\u0434\u0435\u0439. \u041D\u0430\u043F\u0430\u0434\u0430\u0432\u0448\u0438\u0435
      \u0431\u0435\u0436\u0430\u043B\u0438. \u0423\u0442\u0440\u043E\u043C \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A
      \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B: <npc_speech lang=\"Sogdian\">\u042F
      \u0441\u0430\u043C \u0431\u044B\u043B \u0438\u0437 \u0442\u0430\u043A\u0438\u0445.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0435\u0442.</npc_speech> \u0415\u0433\u043E
      \u0434\u043E\u043B\u0433 \u043E\u043F\u043B\u0430\u0447\u0435\u043D - \u043C\u043E\u0436\u0435\u0442\u0435
      \u0440\u0430\u0441\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u0431\u0435\u0437
      \u043E\u0431\u0438\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324097
    m_Localized: "\u0410\u043A\u043A\u0440\u0435\u0434\u0438\u0442\u0438\u0432 \u042E\u0441\u0443\u0444\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324098
    m_Localized: "\u0410\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u0438\u0439
      \u0431\u0430\u043D\u043A\u0438\u0440\u0441\u043A\u0438\u0439 \u0434\u043E\u043C
      \u0432 \u0411\u0430\u0433\u0434\u0430\u0434\u0435 - \u043C\u0440\u0430\u043C\u043E\u0440\u043D\u044B\u0439
      \u043F\u043E\u043B, \u0437\u0430\u043F\u0430\u0445 \u043A\u0435\u0434\u0440\u043E\u0432\u044B\u0445
      \u0447\u0435\u0440\u043D\u0438\u043B. \u042E\u0441\u0443\u0444 \u0438\u0431\u043D
      \u0420\u0430\u0448\u0438\u0434, \u043F\u043B\u043E\u0442\u043D\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0441 \u0447\u0435\u0440\u043D\u0438\u043B\u044C\u043D\u044B\u043C
      \u043F\u044F\u0442\u043D\u043E\u043C \u043D\u0430 \u043F\u0430\u043B\u044C\u0446\u0430\u0445,
      \u043A\u043B\u0430\u0434\u0451\u0442 \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438
      \u0441\u0432\u0438\u0442\u043E\u043A. <npc_speech lang=\"Arabic\">\u0421\u0442\u043E
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u043F\u043E\u0434 \u0447\u0435\u0441\u0442\u043D\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E \u043A\u0443\u043F\u0446\u0430. \u0412\u043E\u0437\u0432\u0440\u0430\u0442
      \u0432 \u043B\u044E\u0431\u043E\u043C \u0438\u0437 \u043D\u0430\u0448\u0438\u0445
      \u0434\u043E\u043C\u043E\u0432 - \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435,
      \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0435, \u041C\u0435\u0440\u0432\u0435.
      \u041A\u043E\u043C\u0438\u0441\u0441\u0438\u044F \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u043D\u0430\u044F.</npc_speech>
      \u0410\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430
      \u0445\u0430\u0432\u0430\u043B\u0430 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C \u0431\u0435\u0437 \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0438
      \u0441\u0435\u0440\u0435\u0431\u0440\u0430 - \u0443\u0434\u043E\u0431\u0441\u0442\u0432\u043E,
      \u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043F\u043B\u0430\u0442\u044F\u0442
      \u0434\u043E\u0432\u0435\u0440\u0438\u0435\u043C. \u0414\u0435\u043D\u044C\u0433\u0438
      \u043D\u0443\u0436\u043D\u044B \u0441\u0435\u0439\u0447\u0430\u0441: \u0437\u0430\u043A\u0443\u043F\u0438\u0442\u044C
      \u0442\u043E\u0432\u0430\u0440 \u043F\u043E \u0445\u043E\u0440\u043E\u0448\u0435\u0439
      \u0446\u0435\u043D\u0435 \u0432 \u0411\u0430\u0433\u0434\u0430\u0434\u0435
      \u0438\u043B\u0438 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0441
      \u0442\u0435\u043C, \u0447\u0442\u043E \u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324099
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0430\u043A\u043A\u0440\u0435\u0434\u0438\u0442\u0438\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324100
    m_Localized: "\u042E\u0441\u0443\u0444 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u043F\u0435\u0447\u0430\u0442\u044C. \u0421\u0442\u043E \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u044B \u043D\u0430 \u0432\u0430\u0448
      \u0441\u0447\u0451\u0442 - \u0438 \u0432\u0430\u0448 \u0434\u043E\u043B\u0433
      \u0442\u043E\u0436\u0435. \u0427\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043D\u0435\u0434\u0435\u043B\u044C \u042E\u0441\u0443\u0444 \u0441\u043D\u043E\u0432\u0430
      \u0432\u044B\u0439\u0434\u0435\u0442 \u043D\u0430 \u0432\u0430\u0448\u0443
      \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324101
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043E\u0442
      \u0434\u043E\u043B\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324102
    m_Localized: "\u0412\u044B \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B\u0438
      \u0438 \u043E\u0442\u043A\u043B\u0430\u043D\u044F\u043B\u0438\u0441\u044C.
      \u042E\u0441\u0443\u0444 \u0443\u0431\u0440\u0430\u043B \u0441\u0432\u0438\u0442\u043E\u043A
      \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B - \u043E\u043D \u0441\u043B\u044B\u0448\u0430\u043B
      \u043E\u0442\u043A\u0430\u0437\u044B \u0438 \u043F\u043E\u0432\u0430\u0436\u043D\u0435\u0435.
      \u0411\u0435\u0437 \u0434\u043E\u043B\u0433\u0430 - \u0431\u0435\u0437 \u0440\u0438\u0441\u043A\u0430,
      \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445 \u043C\u043E\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324103
    m_Localized: "\u042E\u0441\u0443\u0444 \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324104
    m_Localized: "\u041D\u0430 \u0441\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0441\u043A\u043E\u043C
      \u0431\u0430\u0437\u0430\u0440\u0435 \u0443 \u043B\u0430\u0432\u043A\u0438
      \u043C\u0435\u043D\u044F\u043B\u044B \u0441\u0442\u043E\u0438\u0442 \u0437\u043D\u0430\u043A\u043E\u043C\u0430\u044F
      \u0444\u0438\u0433\u0443\u0440\u0430. \u042E\u0441\u0443\u0444 \u0437\u0430\u043C\u0435\u0442\u0438\u043B
      \u0432\u0430\u0441 \u043F\u0435\u0440\u0432\u044B\u043C \u0438 \u0448\u0438\u0440\u043E\u043A\u043E
      \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F. <npc_speech lang=\"Arabic\">\u0414\u043E\u0440\u043E\u0433\u043E\u0439
      \u0434\u0440\u0443\u0433. \u0421\u0442\u043E \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      - \u0438 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0441\u0432\u0435\u0440\u0445\u0443.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u0431\u044B\u043B\u0430 \u0434\u043E\u043B\u0433\u043E\u0439,
      \u0446\u0435\u043D\u044B \u0432\u044B\u0440\u043E\u0441\u043B\u0438. \u0422\u0430\u043A
      \u043F\u0440\u0438\u043D\u044F\u0442\u043E.</npc_speech> \u0410\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u0430\u044F
      \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u044F \u0437\u0430 \u0445\u0430\u0432\u0430\u043B\u0443
      - \u0440\u0435\u0430\u043B\u044C\u043D\u0430\u044F \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0430
      IX \u0432\u0435\u043A\u0430: \u043E\u0442 \u043F\u044F\u0442\u0438 \u0434\u043E
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432.
      \u0421\u043F\u043E\u0440\u0438\u0442\u044C \u0437\u043D\u0430\u0447\u0438\u0442
      \u043F\u043E\u0440\u0442\u0438\u0442\u044C \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044E
      \u0432 \u0431\u0430\u043D\u043A\u0438\u0440\u0441\u043A\u043E\u043C \u043A\u0440\u0443\u0433\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324105
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u0434\u043E\u043B\u0433 \u0441
      \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324106
    m_Localized: "\u0412\u044B \u043E\u0442\u0441\u0447\u0438\u0442\u0430\u043B\u0438
      \u0441\u0442\u043E \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432. \u042E\u0441\u0443\u0444
      \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043B\u0441\u044F \u0432 \u0441\u0432\u0438\u0442\u043A\u0435
      \u0438 \u043F\u043E\u0436\u0430\u043B \u0432\u0430\u0448\u0443 \u0440\u0443\u043A\u0443
      \u043E\u0431\u0435\u0438\u043C\u0438 \u0441\u0432\u043E\u0438\u043C\u0438.
      \u0425\u0430\u0432\u0430\u043B\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u0430
      - \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0447\u0438\u0441\u0442\u0430.
      \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0440\u0430\u0437
      \u043E\u043D \u0434\u0430\u0441\u0442 \u043B\u0443\u0447\u0448\u0443\u044E
      \u0441\u0442\u0430\u0432\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324107
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0441\u0432\u0435\u0440\u0445\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324108
    m_Localized: "\u042E\u0441\u0443\u0444 \u043F\u043E\u0434\u0436\u0430\u043B \u0433\u0443\u0431\u044B.
      \u0421\u043B\u043E\u0432\u043E \u043E \u0432\u0430\u0448\u0435\u0439 \u043D\u0435\u0441\u0433\u043E\u0432\u043E\u0440\u0447\u0438\u0432\u043E\u0441\u0442\u0438
      \u0440\u0430\u0437\u043E\u0439\u0434\u0451\u0442\u0441\u044F \u043F\u043E \u0431\u0430\u043D\u043A\u0438\u0440\u0441\u043A\u0438\u043C
      \u0434\u043E\u043C\u0430\u043C \u043E\u0442 \u041C\u0435\u0440\u0432\u0430
      \u0434\u043E \u0410\u043D\u0442\u0438\u043E\u0445\u0438\u0438. \u0414\u043E\u043B\u0433
      \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u043E\u0442\u0434\u0430\u0442\u044C - \u0447\u0435\u0440\u0435\u0437 \u0441\u0443\u0434
      \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0433\u043E \u043A\u0430\u0434\u0438.
      \u0425\u0430\u0432\u0430\u043B\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u043D\u0430 \u0434\u043E\u0432\u0435\u0440\u0438\u0438, \u0438 \u0432\u044B
      \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E \u0435\u0433\u043E
      \u043F\u043E\u0434\u043E\u0440\u0432\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324109
    m_Localized: "\u0414\u044B\u043C\u044F\u0449\u0430\u044F\u0441\u044F \u0434\u0435\u0440\u0435\u0432\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324110
    m_Localized: "\u0423 \u0432\u044A\u0435\u0437\u0434\u0430 \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u044E
      - \u043F\u0443\u0447\u043E\u043A \u0433\u043E\u0440\u044F\u0449\u0435\u0439
      \u043F\u043E\u043B\u044B\u043D\u0438 \u043D\u0430 \u0448\u0435\u0441\u0442\u0435
      \u0438 \u043A\u0430\u043C\u0435\u043D\u044C \u0441 \u0447\u0451\u0440\u043D\u043E\u0439
      \u043E\u0442\u043C\u0435\u0442\u0438\u043D\u043E\u0439. \u0417\u043D\u0430\u043A
      \u043A\u0430\u0440\u0430\u043D\u0442\u0438\u043D\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0437\u043D\u0430\u044E\u0442 \u0432\u0441\u0435 \u043D\u0430 \u044D\u0442\u043E\u043C
      \u0442\u0440\u0430\u043A\u0442\u0435. \u041C\u0435\u0441\u0442\u043D\u044B\u0439
      \u0441\u0442\u0430\u0440\u0438\u043A \u043A\u0440\u0438\u0447\u0438\u0442 \u0441
      \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F: <npc_speech lang=\"Persian\">\u0422\u0440\u0435\u0442\u0438\u0439
      \u0434\u0435\u043D\u044C \u0433\u043E\u0440\u0438\u043C. \u041D\u0435 \u0445\u043E\u0434\u0438,
      \u043A\u0443\u043F\u0435\u0446 - \u043D\u0438 \u0437\u0430 \u043A\u0430\u043A\u043E\u0435
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E.</npc_speech> \u041E\u0431\u0445\u043E\u0434
      \u0437\u0430\u0439\u043C\u0451\u0442 \u043F\u043E\u043B\u0434\u043D\u044F \u0438
      \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0432\u043E\u0434\u044B
      \u0438\u0437 \u043B\u0438\u0447\u043D\u044B\u0445 \u0437\u0430\u043F\u0430\u0441\u043E\u0432.
      \u041F\u0440\u044F\u043C\u043E\u0439 \u043F\u0443\u0442\u044C \u0432\u0434\u0432\u043E\u0435
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435 - \u0434\u0435\u0440\u0435\u0432\u043D\u044F
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F, \u043C\u043E\u0436\u043D\u043E
      \u043D\u0435 \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u044C \u0432\u043D\u0443\u0442\u0440\u044C,
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u043E\u0439\u0442\u0438 \u043A\u0440\u0430\u0435\u043C.
      \u0411\u043E\u043B\u0435\u0437\u043D\u0438 \u043D\u0430 \u0442\u0440\u0430\u043A\u0442\u0435
      \u0445\u043E\u0434\u044F\u0442 \u0441\u043B\u0435\u0434\u043E\u043C \u0437\u0430
      \u0442\u0435\u043C\u0438, \u043A\u0442\u043E \u043F\u0440\u0435\u043D\u0435\u0431\u0440\u0435\u0433\u0430\u0435\u0442
      \u0437\u043D\u0430\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324111
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u0434\u0435\u0440\u0435\u0432\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324112
    m_Localized: "\u0412\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u043F\u043E\u043B\u0434\u043D\u044F
      \u0438 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0432\u043E\u0434\u044B,
      \u0437\u0430\u0442\u043E \u043F\u0440\u043E\u0448\u043B\u0438 \u0447\u0438\u0441\u0442\u043E.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u0440\u0438\u043E\u0431\u043E\u0434\u0440\u0438\u043B\u0438\u0441\u044C:
      \u0445\u043E\u0437\u044F\u0438\u043D \u0434\u0443\u043C\u0430\u0435\u0442 \u043E
      \u043B\u044E\u0434\u044F\u0445, \u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043E \u0433\u0440\u0430\u0444\u0438\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324113
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043A\u0440\u0430\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324114
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0448\u043B\u0438 - \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u043B \u0438\u0437 \u0434\u043E\u043C\u043E\u0432,
      \u0434\u044B\u043C \u0441\u0442\u043B\u0430\u043B\u0441\u044F \u043D\u0438\u0437\u043A\u043E.
      \u041A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u043E\u0431\u043E\u0448\u043B\u043E\u0441\u044C.
      \u041D\u043E \u0432\u043E\u0437\u0434\u0443\u0445 \u0443 \u0442\u0430\u043A\u0438\u0445
      \u0434\u0435\u0440\u0435\u0432\u0435\u043D\u044C \u0442\u044F\u0436\u0451\u043B\u044B\u0439,
      \u0438 \u044D\u0442\u043E \u0441\u043A\u0430\u0436\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324115
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0441\u043B\u0451\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324116
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u0442\u0440\u0438 \u0434\u043D\u044F
      \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0430 \u0443
      \u0434\u0435\u0440\u0435\u0432\u043D\u0438 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u041D\u0443\u0440\u043C\u0430\u0442 \u043D\u0435 \u0432\u0441\u0442\u0430\u0451\u0442
      \u0441 \u0443\u0442\u0440\u0430 - \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0430,
      \u043F\u043E\u0442\u043D\u044B\u0439 \u043B\u043E\u0431. \u0411\u043E\u043B\u044C\u043D\u043E\u0439
      \u0432 \u0434\u043E\u0440\u043E\u0433\u0435 - \u0433\u0440\u0443\u0437 \u0434\u043B\u044F
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324117
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0438 \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324118
    m_Localized: "\u0412\u044B \u0432\u0441\u0442\u0430\u043B\u0438 \u043B\u0430\u0433\u0435\u0440\u0435\u043C
      \u043D\u0430 \u0434\u0432\u0430 \u0434\u043D\u044F, \u043E\u0442\u043F\u043E\u0438\u043B\u0438
      \u041D\u0443\u0440\u043C\u0430\u0442\u0430 \u0442\u0440\u0430\u0432\u044F\u043D\u044B\u043C
      \u043E\u0442\u0432\u0430\u0440\u043E\u043C \u0438 \u0431\u0443\u0437\u043E\u0439.
      \u041E\u043D \u0432\u0441\u0442\u0430\u043B \u043D\u0430 \u043D\u043E\u0433\u0438
      \u0431\u043B\u0435\u0434\u043D\u044B\u0439, \u043D\u043E \u0436\u0438\u0432\u043E\u0439.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0437\u0430\u043F\u043E\u043C\u043D\u044F\u0442 - \u0437\u0430 \u0431\u043E\u043B\u044C\u043D\u044B\u0445
      \u043D\u0435 \u0431\u0440\u043E\u0441\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324119
    m_Localized: "\u0417\u0430\u0441\u043D\u0443\u0432\u0448\u0438\u0439 \u0441\u0442\u0440\u0430\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324120
    m_Localized: "\u041D\u043E\u0447\u043D\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430
      \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0430. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u0441\u0438\u0434\u0438\u0442, \u043F\u0440\u0438\u0432\u0430\u043B\u0438\u0432\u0448\u0438\u0441\u044C
      \u043A \u0441\u0442\u0435\u043D\u0435, - \u0437\u0430\u043F\u0430\u0445 \u043A\u0438\u0441\u043B\u043E\u0433\u043E
      \u043D\u0430\u0431\u0438\u0437\u0430 \u0437\u0430 \u0448\u0430\u0433. \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
      \u043D\u0430 \u043F\u0440\u0438\u0431\u044B\u0442\u0438\u0435 \u0435\u0449\u0451
      \u043D\u0435 \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u044B: \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439
      \u043F\u0438\u0441\u0435\u0446 \u0437\u0430\u043A\u0440\u044B\u043B\u0441\u044F
      \u0434\u043E \u0443\u0442\u0440\u0430. \u041E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439
      \u043F\u0443\u0442\u044C - \u0436\u0434\u0430\u0442\u044C \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430.
      \u0414\u0440\u0443\u0433\u043E\u0439 \u043F\u0443\u0442\u044C - \u043D\u0430\u043B\u0438\u0442\u044C
      \u0441\u0442\u0440\u0430\u0436\u0435 \u0435\u0449\u0451 \u0438 \u043F\u0440\u043E\u0439\u0442\u0438
      \u043F\u043E\u043A\u0430 \u0442\u0435\u043C\u043D\u043E. \u0413\u0443\u043B\u044F\u043D\u0438\u0435
      \u0441 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438 \u0432
      \u0410\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u043E\u043C \u0445\u0430\u043B\u0438\u0444\u0430\u0442\u0435
      - \u0434\u0435\u043B\u043E \u043E\u0431\u044B\u0447\u043D\u043E\u0435, \u043D\u043E
      \u0434\u043E\u043D\u043E\u0441 \u0441\u0442\u043E\u0438\u0442 \u0434\u0435\u0448\u0435\u0432\u043B\u0435
      \u043A\u0443\u0432\u0448\u0438\u043D\u0430 \u0432\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324121
    m_Localized: "\u0421\u043F\u043E\u0438\u0442\u044C \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324122
    m_Localized: "\u041A\u0443\u0432\u0448\u0438\u043D \u043E\u043F\u0443\u0441\u0442\u0435\u043B,
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0437\u0430\u043A\u0440\u044B\u043B
      \u0433\u043B\u0430\u0437\u0430. \u0412\u044B \u043F\u0440\u043E\u0448\u043B\u0438
      \u0431\u0435\u0437 \u0448\u0443\u043C\u0430. \u041B\u0435\u0433\u043A\u043E
      \u0441\u0435\u0439\u0447\u0430\u0441 - \u043D\u043E \u0434\u043E\u043D\u043E\u0441
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u043D\u0435 \u0441\u0440\u0430\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324123
    m_Localized: "\u0414\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324124
    m_Localized: "\u0423\u0442\u0440\u043E \u043F\u0440\u0438\u0448\u043B\u043E \u0441
      \u0440\u043E\u0441\u043E\u0439 \u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C
      \u043F\u0438\u0441\u0446\u043E\u043C. \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
      \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u044B \u0447\u0438\u0441\u0442\u043E.
      \u041B\u0438\u0448\u043D\u0438\u0435 \u0447\u0430\u0441\u044B - \u043D\u0435
      \u043B\u0438\u0448\u043D\u0438\u0435 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324125
    m_Localized: "\u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A \u0441\u0442\u0440\u0430\u0436\u0438
      \u0436\u0434\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324126
    m_Localized: "\u0423 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0445
      \u0432\u043E\u0440\u043E\u0442 \u0432\u0430\u0441 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u043D\u0435 \u0440\u044F\u0434\u043E\u0432\u043E\u0439 \u0441\u0442\u0440\u0430\u0436,
      \u0430 \u0434\u0435\u0441\u044F\u0442\u043D\u0438\u043A \u0441 \u0431\u0443\u043C\u0430\u0433\u043E\u0439
      \u0432 \u0440\u0443\u043A\u0435. \u041F\u044C\u044F\u043D\u044B\u0439 \u043F\u0440\u0438\u0432\u0440\u0430\u0442\u043D\u0438\u043A
      \u0432\u0441\u0451-\u0442\u0430\u043A\u0438 \u0434\u043E\u043D\u0451\u0441
      - \u0438\u043B\u0438 \u043A\u0442\u043E-\u0442\u043E \u0438\u0437 \u043F\u0440\u043E\u0445\u043E\u0436\u0438\u0445
      \u0432\u0438\u0434\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324127
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0448\u0442\u0440\u0430\u0444"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324128
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0438 \u043F\u043E\u0434\u043F\u0438\u0441\u044C \u043D\u0430 \u0431\u0443\u043C\u0430\u0433\u0435.
      \u0414\u0435\u0441\u044F\u0442\u043D\u0438\u043A \u0443\u0431\u0440\u0430\u043B
      \u0435\u0451 \u0432 \u0441\u0443\u043C\u043A\u0443 \u0431\u0435\u0437 \u0441\u043B\u043E\u0432\u0430.
      \u0411\u044E\u0440\u043E\u043A\u0440\u0430\u0442\u0438\u044F \u0410\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u043E\u0433\u043E
      \u0445\u0430\u043B\u0438\u0444\u0430\u0442\u0430 \u043B\u044E\u0431\u0438\u0442
      \u043C\u043E\u043D\u0435\u0442\u044B \u0438 \u043D\u0435 \u043B\u044E\u0431\u0438\u0442
      \u0448\u0443\u043C - \u0432\u044B \u0434\u0430\u043B\u0438 \u0435\u0439 \u0438
      \u0442\u043E, \u0438 \u0434\u0440\u0443\u0433\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324129
    m_Localized: "\u041E\u0441\u043F\u043E\u0440\u0438\u0442\u044C \u043E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324130
    m_Localized: "\u0412\u044B \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u0438
      \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u0435\u0439. \u0414\u0435\u0441\u044F\u0442\u043D\u0438\u043A
      \u043F\u043E\u0436\u0430\u043B \u043F\u043B\u0435\u0447\u0430\u043C\u0438:
      \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F.
      \u0417\u0430\u0434\u0435\u0440\u0436\u043A\u0430 \u0432\u044B\u0448\u043B\u0430
      \u0432 \u0434\u0435\u043D\u044C \u0438 \u0442\u0435 \u0436\u0435 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u043F\u043B\u044E\u0441 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0441\u043A\u043B\u043E\u0447\u043D\u0438\u043A\u0430. \u0418\u043D\u043E\u0433\u0434\u0430
      \u043F\u0440\u043E\u0449\u0435 \u043F\u043B\u0430\u0442\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324131
    m_Localized: "\u041F\u0451\u0441 \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324132
    m_Localized: "\u0423 \u0432\u044B\u0441\u043E\u0445\u0448\u0435\u0433\u043E \u043A\u043E\u043B\u043E\u0434\u0446\u0430
      \u0441\u0438\u0434\u0438\u0442 \u043F\u0451\u0441 - \u0440\u0451\u0431\u0440\u0430
      \u0432\u0438\u0434\u043D\u044B, \u0443\u0445\u043E \u043D\u0430\u0434\u043E\u0440\u0432\u0430\u043D\u043E,
      \u043D\u043E \u0432\u0437\u0433\u043B\u044F\u0434 \u0436\u0438\u0432\u043E\u0439.
      \u0413\u043E\u043D\u0438\u0442 \u043D\u0435 \u043F\u0440\u043E\u0441\u0438\u0442
      - \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D: \xAB\u041A\u043E\u0440\u043C\u0438\u0442\u044C
      \u0431\u0440\u043E\u0434\u044F\u0433 - \u043F\u043B\u043E\u0445\u0430\u044F
      \u043F\u0440\u0438\u043C\u0435\u0442\u0430\xBB. \u0429\u0435\u043F\u043E\u0442\u043A\u0430
      \u0441\u0443\u0448\u0451\u043D\u043E\u0433\u043E \u043C\u044F\u0441\u0430 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0441\u0442\u043E\u0438\u0442. \u0421\u0442\u0435\u043F\u043D\u044B\u0435
      \u043F\u0441\u044B \u043F\u0440\u0438\u0432\u044F\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u043A\u0440\u0435\u043F\u043A\u043E \u0438 \u0434\u0430\u043B\u0435\u043A\u043E
      \u043D\u0435 \u0443\u0445\u043E\u0434\u044F\u0442 - \u0438\u043D\u043E\u0433\u0434\u0430
      \u044D\u0442\u043E \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E\u043B\u044C\u0437\u043E\u0439, \u0438\u043D\u043E\u0433\u0434\u0430
      \u043B\u0438\u0448\u043D\u0438\u043C \u0440\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324133
    m_Localized: "\u041D\u0430\u043A\u043E\u0440\u043C\u0438\u0442\u044C \u043F\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324134
    m_Localized: "\u041F\u0451\u0441 \u0432\u0437\u044F\u043B \u043C\u044F\u0441\u043E
      \u043D\u0435 \u0441\u043F\u0435\u0448\u0430 \u0438 \u043B\u0451\u0433 \u0440\u044F\u0434\u043E\u043C
      \u0441 \u043F\u043E\u0432\u043E\u0437\u043A\u043E\u0439. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u043E\u043D \u0432\u0441\u0451 \u0435\u0449\u0451 \u0448\u0451\u043B \u0441\u043B\u0435\u0434\u043E\u043C.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u0432\u043E\u0437\u0440\u0430\u0436\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324135
    m_Localized: "\u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C \u043F\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324136
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0433\u043D\u0430\u043B\u0438 \u0435\u0433\u043E
      \u043A\u0430\u043C\u0435\u0448\u043A\u043E\u043C. \u041F\u0451\u0441 \u043E\u0442\u0431\u0435\u0436\u0430\u043B,
      \u043B\u0451\u0433 \u0432 \u043E\u0442\u0434\u0430\u043B\u0435\u043D\u0438\u0438
      - \u0438 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438 \u043F\u043E\u043B\u0447\u0430\u0441\u0430.
      \u041F\u043E\u0442\u043E\u043C \u043F\u0440\u043E\u043F\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324137
    m_Localized: "\u041F\u0451\u0441 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324138
    m_Localized: "\u041D\u0430 \u0432\u043E\u0441\u044C\u043C\u043E\u0439 \u0434\u0435\u043D\u044C
      \u0442\u043E\u0442 \u0441\u0430\u043C\u044B\u0439 \u043F\u0451\u0441 - \u0432\u044B
      \u0443\u0437\u043D\u0430\u0451\u0442\u0435 \u043D\u0430\u0434\u043E\u0440\u0432\u0430\u043D\u043D\u043E\u0435
      \u0443\u0445\u043E - \u0432\u0434\u0440\u0443\u0433 \u0441\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432\u043F\u0435\u0440\u0451\u0434, \u043B\u0430\u0435\u0442 \u043D\u0430
      \u043F\u0440\u043E\u043C\u043E\u0438\u043D\u0443 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438.
      \u0422\u0430\u043C \u043F\u0440\u0438\u0442\u0430\u0438\u043B\u0438\u0441\u044C
      \u0434\u0432\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324139
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u043F\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324140
    m_Localized: "\u0414\u0432\u043E\u0435 \u0431\u0435\u0436\u0430\u043B\u0438 \u043F\u0440\u0438
      \u0432\u0438\u0434\u0435 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u043E\u0439
      \u043E\u0445\u0440\u0430\u043D\u044B - \u0438 \u0441\u043E\u0431\u0430\u043A\u0438,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0437\u043D\u0430\u043B\u0430 \u0438\u0445
      \u0440\u0430\u043D\u044C\u0448\u0435 \u0432\u0430\u0441. \u041F\u0451\u0441
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F, \u043B\u0451\u0433 \u0443
      \u043A\u043E\u043B\u0435\u0441\u0430. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u043D\u0430\u0448\u0451\u043B \u0434\u043B\u044F \u043D\u0435\u0433\u043E
      \u043A\u043E\u0441\u0442\u044C. \u0421\u0442\u0435\u043F\u043D\u043E\u0439
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A \u043E\u0431\u043E\u0448\u0451\u043B\u0441\u044F
      \u0432 \u0449\u0435\u043F\u043E\u0442\u043A\u0443 \u0432\u044F\u043B\u0435\u043D\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324141
    m_Localized: "\u041F\u043E\u0441\u0442 \u0446\u0437\u0435\u0434\u0443\u0448\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324142
    m_Localized: "\u0417\u0430\u0441\u0442\u0430\u0432\u043D\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430
      \u0443 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u044B - \u0438 \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u0432 \u0441\u0438\u043D\u0435\u043C \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u0447\u044C\u0435\u043C
      \u0433\u0430\u043E\u0448\u0438, \u0441 \u043F\u043B\u0430\u043D\u0448\u0435\u0442\u043A\u043E\u0439
      \u0438\u0437 \u0441\u043B\u043E\u043D\u043E\u0432\u043E\u0439 \u043A\u043E\u0441\u0442\u0438.
      \u0414\u043E\u0441\u043C\u043E\u0442\u0440 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0437\u0430\u0439\u043C\u0451\u0442 \u043F\u043E\u043B\u0434\u043D\u044F:
      \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u044C \u0442\u043E\u0432\u0430\u0440\u043E\u0432,
      \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0433\u0443\u0430\u043D\u044C\u0434\u0438\u0435
      - \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u043D\u043E\u0433\u043E \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430.
      \u0412\u0430\u0448\u0435 \u0433\u0443\u0430\u043D\u044C\u0434\u0438\u0435 \u043F\u0440\u043E\u0441\u0440\u043E\u0447\u0435\u043D\u043E
      \u043D\u0430 \u0442\u0440\u0438 \u0434\u043D\u044F. \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u0435\u0449\u0451 \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u043B \u0440\u043E\u0442
      - \u043D\u043E \u043F\u0430\u043B\u044C\u0446\u044B \u0443\u0436\u0435 \u0434\u0435\u0440\u0436\u0430\u0442
      \u043A\u0438\u0441\u0442\u044C \u043D\u0430\u0433\u043E\u0442\u043E\u0432\u0435.
      <npc_speech lang=\"Chinese\">\u0424\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438...
      \u0442\u0440\u0435\u0431\u0443\u044E\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438.</npc_speech>
      \u0412\u0437\u044F\u0442\u043A\u0430 \u0432 \u0422\u0430\u043D\u0441\u043A\u043E\u0439
      \u0431\u044E\u0440\u043E\u043A\u0440\u0430\u0442\u0438\u0438 - \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u043E\u0431\u044B\u0447\u043D\u043E\u0435 \u0434\u0435\u043B\u043E, \u0447\u0442\u043E
      \u0434\u043B\u044F \u043D\u0435\u0451 \u0435\u0441\u0442\u044C \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439
      \u0442\u0435\u0440\u043C\u0438\u043D: \xAB\u043B\u0451\u0434\xBB (\u0431\u0438\u043D-\u0446\u0437\u0438\u043D).
      \u0412\u043E\u043F\u0440\u043E\u0441 \u0432 \u0442\u043E\u043C, \u043A\u0442\u043E
      \u043E\u0431 \u044D\u0442\u043E\u043C \u0443\u0437\u043D\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324143
    m_Localized: "\u0414\u0430\u0442\u044C \u0432\u0437\u044F\u0442\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324144
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u043C\u043E\u043D\u0435\u0442
      \u043A\u0430\u0439\u044E\u0430\u043D\u044C \u0442\u0443\u043D\u0431\u0430\u043E
      \u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0438 \u043F\u043E\u0434
      \u043F\u043B\u0430\u043D\u0448\u0435\u0442\u043A\u0443. \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043F\u0435\u0447\u0430\u0442\u044C
      \u0431\u0435\u0437 \u0441\u043B\u043E\u0432. \u0412\u043E\u0440\u043E\u0442\u0430
      \u043E\u0442\u043A\u0440\u044B\u043B\u0438\u0441\u044C. \u0411\u044B\u0441\u0442\u0440\u043E
      \u0438 \u0447\u0438\u0441\u0442\u043E - \u043F\u043E\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324145
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0434\u043E\u0441\u043C\u043E\u0442\u0440
      \u0447\u0435\u0441\u0442\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324146
    m_Localized: "\u041F\u043E\u043B\u0434\u043D\u044F. \u041F\u0435\u0440\u0435\u043F\u0438\u0441\u044C
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0442\u044E\u043A\u0430, \u0432\u043E\u043F\u0440\u043E\u0441\u044B
      \u043E \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0435, \u0448\u0442\u0440\u0430\u0444
      \u0437\u0430 \u043F\u0440\u043E\u0441\u0440\u043E\u0447\u0435\u043D\u043D\u043E\u0435
      \u0433\u0443\u0430\u043D\u044C\u0434\u0438\u0435. \u0414\u043E\u0440\u043E\u0433\u043E
      \u0438 \u0434\u043E\u043B\u0433\u043E - \u0437\u0430\u0442\u043E \u0447\u0438\u0441\u0442\u043E
      \u0432 \u0431\u0443\u043C\u0430\u0433\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324147
    m_Localized: "\u0421\u043B\u0443\u0445 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324148
    m_Localized: "\u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u043F\u043E\u0441\u0442\u0443 \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443
      \u0441 \u043E\u0441\u043E\u0431\u044B\u043C \u0432\u0438\u0434\u043E\u043C.
      \u0421\u043B\u0443\u0445 \u043E \u043B\u0451\u0433\u043A\u043E\u0439 \u0432\u0437\u044F\u0442\u043A\u0435
      \u043F\u0440\u043E\u0448\u0451\u043B \u043F\u043E \u0442\u0440\u0430\u043A\u0442\u0443
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0432\u0430\u0448\u0435\u0433\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430. <npc_speech lang=\"Chinese\">\u0413\u043E\u0432\u043E\u0440\u044F\u0442,
      \u0442\u044B \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0449\u0435\u0434\u0440\u044B\u0439.
      \u041C\u043E\u044F \u043F\u0435\u0447\u0430\u0442\u044C \u0442\u043E\u0436\u0435
      \u0441\u0442\u043E\u0438\u0442 \u0434\u0435\u043D\u0435\u0433.</npc_speech>
      \u0410\u043F\u043F\u0435\u0442\u0438\u0442\u044B \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u043E\u0432
      \u043D\u0430 \u0412\u0435\u043B\u0438\u043A\u043E\u043C \u0448\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u043F\u0443\u0442\u0438 \u0440\u043E\u0441\u043B\u0438 \u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E
      \u043C\u043E\u043B\u0432\u0435 \u043E \u0432\u0430\u0448\u0435\u0439 \u0441\u0433\u043E\u0432\u043E\u0440\u0447\u0438\u0432\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324149
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0441\u043D\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324150
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043C\u043E\u043D\u0435\u0442
      \u0432\u043C\u0435\u0441\u0442\u043E \u0434\u0435\u0441\u044F\u0442\u0438.
      \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u0434\u043E\u0432\u043E\u043B\u0435\u043D.
      \u041D\u043E \u0432\u044B \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442\u0435:
      \u043A\u0430\u0436\u0434\u0430\u044F \u0432\u0437\u044F\u0442\u043A\u0430 \u043D\u0430
      \u044D\u0442\u043E\u043C \u0442\u0440\u0430\u043A\u0442\u0435 - \u0440\u0435\u043A\u043B\u0430\u043C\u0430
      \u0434\u043B\u044F \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324151
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043F\u043B\u0430\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324152
    m_Localized: "\u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u043F\u043E\u0434\u0436\u0430\u043B
      \u0433\u0443\u0431\u044B \u0438 \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B
      \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443 \u0433\u0440\u0443\u0437\u0430
      \u043D\u0430 \u043F\u043E\u0434\u043B\u0438\u043D\u043D\u043E\u0441\u0442\u044C
      \u043A\u043B\u0435\u0439\u043C. \u0414\u0435\u043D\u044C \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438
      \u0438 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0441\u043A\u0430\u043D\u0434\u0430\u043B\u0438\u0441\u0442\u0430.
      \u0418\u043D\u043E\u0433\u0434\u0430 \u0442\u0432\u0451\u0440\u0434\u043E\u0441\u0442\u044C
      \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0436\u0435 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438
      \u043C\u043E\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324153
    m_Localized: "\u0420\u0435\u0431\u0451\u043D\u043E\u043A \u0432 \u044F\u043C\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324154
    m_Localized: "\u041D\u0430 \u043E\u0431\u043E\u0447\u0438\u043D\u0435 - \u0433\u043B\u0443\u0431\u043E\u043A\u0430\u044F
      \u043F\u0440\u043E\u043C\u043E\u0438\u043D\u0430, \u0441\u0442\u0430\u0440\u044B\u0439
      \u0430\u0440\u044B\u043A, \u0437\u0430\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0439
      \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443. \u0421\u043D\u0438\u0437\u0443
      - \u0434\u0435\u0442\u0441\u043A\u0438\u0439 \u043F\u043B\u0430\u0447. \u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0439
      \u043C\u0430\u043B\u044C\u0447\u0438\u043A \u043B\u0435\u0442 \u0448\u0435\u0441\u0442\u0438
      \u0437\u0430\u0441\u0442\u0440\u044F\u043B \u0432 \u0443\u0437\u043A\u043E\u043C
      \u0433\u043E\u0440\u043B\u043E\u0432\u0438\u043D\u0435: \u0443\u043F\u0430\u043B,
      \u0432\u044B\u043B\u0435\u0437\u0442\u0438 \u0441\u0430\u043C \u043D\u0435
      \u043C\u043E\u0436\u0435\u0442. \u0412\u043E\u043A\u0440\u0443\u0433 - \u043D\u0438\u043A\u043E\u0433\u043E,
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043B\u0443\u0434\u0435\u043D\u043D\u0430\u044F
      \u0442\u0438\u0448\u0438\u043D\u0430 \u0438 \u0441\u0442\u0440\u0451\u043A\u043E\u0442
      \u043A\u0443\u0437\u043D\u0435\u0447\u0438\u043A\u043E\u0432. \u0412\u044B\u0442\u0430\u0449\u0438\u0442\u044C
      \u043D\u0435\u0441\u043B\u043E\u0436\u043D\u043E, \u043D\u043E \u043D\u0430\u0434\u043E
      \u0441\u043B\u0435\u0437\u0442\u044C \u0441\u0430\u043C\u043E\u043C\u0443 \u0438\u043B\u0438
      \u043F\u043E\u0441\u043B\u0430\u0442\u044C \u043A\u043E\u0433\u043E-\u0442\u043E.
      \u041F\u043E\u0442\u0435\u0440\u044F \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u0438
      \u0447\u0430\u0441\u0430. \u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0435\u0433\u043E - \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u043D\u0430\u0439\u0434\u0451\u0442. \u0418\u043B\u0438 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324155
    m_Localized: "\u0412\u044B\u0442\u0430\u0449\u0438\u0442\u044C \u0440\u0435\u0431\u0451\u043D\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324156
    m_Localized: "\u0412\u044B \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0438\u0441\u044C,
      \u043F\u043E\u0434\u0445\u0432\u0430\u0442\u0438\u043B\u0438 \u043C\u0430\u043B\u044C\u0447\u0438\u043A\u0430
      \u043F\u043E\u0434 \u043C\u044B\u0448\u043A\u0438 \u0438 \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438
      \u043D\u0430\u0432\u0435\u0440\u0445. \u041E\u043D \u0437\u0430\u043C\u043E\u043B\u0447\u0430\u043B,
      \u0443\u0441\u0442\u0430\u0432\u0438\u043B\u0441\u044F, \u043F\u043E\u0431\u0435\u0436\u0430\u043B
      \u043F\u0440\u043E\u0447\u044C \u0431\u0435\u0437 \u0441\u043B\u043E\u0432\u0430.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0443\u0441\u043C\u0435\u0445\u043D\u0443\u043B\u0441\u044F:
      \xAB\u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0435 \u0434\u0435\u0442\u0438
      \u043D\u0435 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F\u0442 -
      \u0437\u0430 \u043D\u0438\u0445 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F\u0442
      \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324157
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0438 \u0435\u0445\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324158
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0435\u0445\u0430\u043B\u0438.
      \u041F\u043B\u0430\u0447 \u0437\u0430\u0442\u0438\u0445 \u0437\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u043C.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B
      \u043D\u0438\u0447\u0435\u0433\u043E - \u043D\u043E \u0432\u0435\u0447\u0435\u0440\u043E\u043C
      \u0435\u043B \u043C\u043E\u043B\u0447\u0430 \u0438 \u0433\u043B\u0430\u0437\u0430
      \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324159
    m_Localized: "\u0422\u044E\u0440\u043A\u0441\u043A\u0430\u044F \u0441\u0435\u043C\u044C\u044F
      \u043D\u0430\u0448\u043B\u0430 \u0432\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324160
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u0434\u0435\u0432\u044F\u0442\u044C
      \u0434\u043D\u0435\u0439 \u0443 \u0431\u0440\u043E\u0434\u0430 \u0432\u0430\u0441
      \u043D\u0430\u0433\u043E\u043D\u044F\u044E\u0442 \u0434\u0432\u043E\u0435 \u0432\u0435\u0440\u0445\u043E\u0432\u044B\u0445
      \u0442\u044E\u0440\u043A\u043E\u0432. \u041E\u0434\u0438\u043D - \u043C\u0443\u0436\u0447\u0438\u043D\u0430
      \u043B\u0435\u0442 \u0441\u043E\u0440\u043E\u043A\u0430, \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u043F\u0430\u043D\u0446\u0438\u0440\u044C, \u043B\u0443\u043A \u0437\u0430
      \u0441\u043F\u0438\u043D\u043E\u0439. \u041E\u043D \u0441\u043F\u0435\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F \u043D\u0438\u0437\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324161
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324162
    m_Localized: "<npc_speech lang=\"Old_Turkic\">\u042D\u0442\u043E \u043C\u043E\u0439
      \u0441\u044B\u043D. \u0422\u044B \u0435\u0433\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B
      - \u044F \u0434\u0430\u044E \u0442\u0435\u0431\u0435 \u0434\u043E\u0440\u043E\u0433\u0443.</npc_speech>
      \u041E\u043D \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0432\u044C\u044E\u043A: \u0441\u0443\u0448\u0451\u043D\u043E\u0435 \u043C\u044F\u0441\u043E,
      \u043A\u0443\u0440\u0442, \u043C\u0435\u0448\u043E\u0447\u0435\u043A \u0441
      \u0437\u0435\u0440\u043D\u043E\u043C. \u0422\u044E\u0440\u043A\u0441\u043A\u043E\u0435
      \u0433\u043E\u0441\u0442\u0435\u043F\u0440\u0438\u0438\u043C\u0441\u0442\u0432\u043E
      - \u0434\u043E\u043B\u0433, \u0430 \u043D\u0435 \u0449\u0435\u0434\u0440\u043E\u0441\u0442\u044C.
      \u0411\u0440\u043E\u0434 \u043F\u0440\u043E\u0439\u0434\u0451\u0442\u0435 \u0441
      \u0435\u0433\u043E \u043B\u044E\u0434\u044C\u043C\u0438: \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0442\u0440\u043E\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324163
    m_Localized: "\u0427\u0443\u0436\u043E\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324164
    m_Localized: "\u0423 \u0434\u043E\u0440\u043E\u0433\u0438 \u0441\u0442\u043E\u0438\u0442
      \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u0430\u044F \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      - \u043E\u0441\u044C \u0442\u0440\u0435\u0441\u043D\u0443\u043B\u0430. \u0421\u0442\u0430\u0440\u0448\u0438\u0439
      \u0438\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430, \u043F\u0435\u0440\u0441
      \u043F\u043E \u0438\u043C\u0435\u043D\u0438 \u0411\u0430\u0445\u0440\u0430\u043C,
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0441\u0430\u043C: <npc_speech
      lang=\"Persian\">\u041E\u0434\u043E\u043B\u0436\u0438 \u0436\u0435\u043B\u0435\u0437\u043E
      \u043D\u0430 \u0434\u0435\u043D\u044C. \u0412\u0435\u0440\u043D\u0443 \u0432
      \u041C\u0435\u0440\u0432\u0435 - \u0442\u0430\u043C \u0443 \u043C\u0435\u043D\u044F
      \u0441\u043A\u043B\u0430\u0434.</npc_speech> \u0412\u0430\u0448\u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B
      \u043D\u0443\u0436\u043D\u044B \u0432\u0430\u043C \u0441\u0430\u043C\u0438\u043C
      - \u0434\u043E\u0440\u043E\u0433\u0430 \u043D\u0435\u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0443\u0435\u043C\u0430.
      \u041D\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u0441\u043E\u0441\u0435\u0434\u0443
      \u043F\u043E \u0442\u0440\u0430\u043A\u0442\u0443 - \u0434\u0443\u0440\u043D\u043E\u0439
      \u0437\u043D\u0430\u043A: \u0437\u0430\u0432\u0442\u0440\u0430 \u0432\u044B
      \u0441\u0430\u043C\u0438 \u0431\u0443\u0434\u0435\u0442\u0435 \u043F\u0440\u043E\u0441\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324165
    m_Localized: "\u041E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324166
    m_Localized: "\u0411\u0430\u0445\u0440\u0430\u043C \u0432\u0437\u044F\u043B \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B
      \u0438 \u043F\u0440\u0438\u043D\u044F\u043B\u0441\u044F \u0437\u0430 \u0440\u0430\u0431\u043E\u0442\u0443.
      \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u0435\u0433\u043E \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043A\u0430\u0442\u0438\u043B\u0430\u0441\u044C \u0441\u043D\u043E\u0432\u0430.
      \u041E\u043D \u043F\u043E\u043E\u0431\u0435\u0449\u0430\u043B \u041C\u0435\u0440\u0432.
      \u0418\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B \u0432\u0435\u0440\u043D\u0443\u0442\u0441\u044F
      - \u043C\u043E\u0436\u0435\u0442, \u043D\u0435 \u0432\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324167
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324168
    m_Localized: "\u0411\u0430\u0445\u0440\u0430\u043C \u043A\u0438\u0432\u043D\u0443\u043B
      \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B - \u0432\u0438\u0434\u043D\u043E,
      \u043D\u0435 \u0432 \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0437.
      \u0415\u0433\u043E \u043B\u044E\u0434\u0438 \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0438\u0441\u044C
      \u0432\u0435\u0440\u0451\u0432\u043A\u043E\u0439. \u0412\u0430\u0448\u0438
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B \u0446\u0435\u043B\u044B
      - \u0438 \u0432\u0430\u0448\u0430 \u0441\u043E\u0432\u0435\u0441\u0442\u044C
      \u043D\u0435 \u043E\u0447\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324169
    m_Localized: "\u0411\u0430\u0445\u0440\u0430\u043C \u043D\u0430\u0433\u043D\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324170
    m_Localized: "\u0411\u0430\u0445\u0440\u0430\u043C \u043D\u0430\u0433\u043D\u0430\u043B
      \u0432\u0430\u0441 \u0434\u043E \u041C\u0435\u0440\u0432\u0430. \u041E\u043D
      \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B
      - \u0438 \u0432 \u0435\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u0435
      \u0447\u0442\u043E-\u0442\u043E \u0432\u0438\u043D\u043E\u0432\u0430\u0442\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324171
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0438 \u043F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324172
    m_Localized: "\u041E\u0434\u043D\u043E \u0437\u0443\u0431\u0438\u043B\u043E \u043D\u0430\u0434\u043B\u043E\u043C\u043B\u0435\u043D\u043E.
      \u0411\u0430\u0445\u0440\u0430\u043C \u044D\u0442\u043E\u0433\u043E \u043D\u0435
      \u043F\u0440\u0438\u0437\u043D\u0430\u0451\u0442 - \u043F\u0440\u043E\u0441\u0442\u043E
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
      \u0412\u044B \u0431\u0435\u0440\u0451\u0442\u0435 \u043C\u043E\u043B\u0447\u0430.
      \u0422\u0440\u0430\u043A\u0442 \u043D\u0435 \u043C\u0435\u0441\u0442\u043E
      \u0434\u043B\u044F \u043C\u0435\u043B\u043A\u0438\u0445 \u0441\u0447\u0451\u0442\u043E\u0432
      - \u0438 \u0411\u0430\u0445\u0440\u0430\u043C \u044D\u0442\u043E \u0437\u043D\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324173
    m_Localized: "\u041F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
      \u0432\u043E\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324174
    m_Localized: "\u0412\u044B \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435
      \u043D\u0430 \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u043E\u0435 \u0437\u0443\u0431\u0438\u043B\u043E.
      \u0411\u0430\u0445\u0440\u0430\u043C \u043C\u043E\u0440\u0449\u0438\u0442\u0441\u044F,
      \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0442\u0440\u0438 \u0434\u0438\u0440\u0445\u0430\u043C\u0430
      - \u043C\u0435\u043D\u044C\u0448\u0435, \u0447\u0435\u043C \u0441\u0442\u043E\u0438\u0442,
      \u043D\u043E \u0447\u0442\u043E-\u0442\u043E. \u041D\u0430\u0441\u0442\u043E\u044F\u0442\u044C
      \u0436\u0451\u0441\u0442\u0447\u0435 - \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C
      \u043F\u043E\u043B\u0434\u043D\u044F \u0443 \u0434\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324175
    m_Localized: "\u041F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0430\u043D\u0438\u0435
      \u043C\u043E\u043D\u0430\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324176
    m_Localized: "\u041C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0439
      \u043C\u043E\u043D\u0430\u0445 \u0432 \u0431\u0435\u043B\u043E\u043C, \u0440\u0430\u0441\u0448\u0438\u0442\u043E\u043C
      \u0447\u0451\u0440\u043D\u044B\u043C\u0438 \u043B\u043E\u0442\u043E\u0441\u0430\u043C\u0438
      \u043E\u0434\u0435\u044F\u043D\u0438\u0438 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0443 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438.
      \u041B\u0438\u0446\u043E \u0445\u0443\u0434\u043E\u0435, \u043F\u0430\u043B\u044C\u0446\u044B
      \u0432 \u0447\u0435\u0440\u043D\u0438\u043B\u0430\u0445. <npc_speech lang=\"Sogdian\">\u042F
      \u0432\u0438\u0434\u0435\u043B \u0441\u043E\u043D \u0442\u0440\u0438\u0436\u0434\u044B:
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0443 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E
      \u0431\u0440\u043E\u0434\u0430. \u041D\u0435 \u0433\u043E\u0432\u043E\u0440\u044E
      - \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0442\u0435.
      \u0413\u043E\u0432\u043E\u0440\u044E - \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
      \u0432 \u043E\u0431\u0430.</npc_speech> \u041C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u0442\u0432\u043E
      \u043D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C \u043F\u0443\u0442\u0438
      - \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u0430\u044F \u0440\u0435\u043B\u0438\u0433\u0438\u043E\u0437\u043D\u0430\u044F
      \u0441\u0438\u043B\u0430: \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0438
      \u0434\u0435\u0440\u0436\u0430\u043B\u0438 \u043A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u0441\u0435\u0442\u0438 \u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0438
      \u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0435 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F.
      \u0418\u0445 \xAB\u0441\u043D\u044B\xBB \u0447\u0430\u0441\u0442\u043E \u0431\u044B\u043B\u0438
      \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F\u043C\u0438, \u043F\u0435\u0440\u0435\u0432\u0435\u0434\u0451\u043D\u043D\u044B\u043C\u0438
      \u0432 \u044F\u0437\u044B\u043A \u043E\u0442\u043A\u0440\u043E\u0432\u0435\u043D\u0438\u044F.
      \u0412\u0435\u0440\u0438\u0442\u044C \u0438\u043B\u0438 \u043D\u0435\u0442
      - \u0432\u0430\u0448 \u0432\u044B\u0431\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324177
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u0438 \u0438\u0434\u0442\u0438 \u043F\u0440\u044F\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324178
    m_Localized: "\u0412\u044B \u043A\u0438\u0432\u043D\u0443\u043B\u0438 \u0438
      \u0434\u0432\u0438\u043D\u0443\u043B\u0438\u0441\u044C \u043F\u0440\u044F\u043C\u044B\u043C
      \u043F\u0443\u0442\u0451\u043C. \u041F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      \u043F\u0440\u0438\u043D\u044F\u0442\u043E \u043A \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044E
      - \u043E\u0440\u0443\u0436\u0438\u0435 \u043D\u0430\u0433\u043E\u0442\u043E\u0432\u0435
      \u043D\u0430 \u0442\u0440\u0435\u0442\u044C\u0435\u043C \u0431\u0440\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324179
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u0442\u0440\u0435\u0442\u0438\u0439
      \u0431\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324180
    m_Localized: "\u041A\u0440\u044E\u043A - \u0434\u0435\u043D\u044C \u0438 \u043B\u0438\u0448\u043D\u044F\u044F
      \u0432\u043E\u0434\u0430. \u041A\u043E\u0433\u0434\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B\u0438
      \u0432 \u043E\u0431\u0445\u043E\u0434, \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0438
      \u0432\u0434\u0430\u043B\u0438 \u043A\u0440\u0438\u043A\u0438 \u0443 \u0440\u0435\u043A\u0438.
      \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043B\u0438 \u0432\u044B\u0431\u043E\u0440
      - \u0443\u0437\u043D\u0430\u0435\u0442\u0435 \u043F\u043E\u0437\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324181
    m_Localized: "\u0422\u0440\u0435\u0442\u0438\u0439 \u0431\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324182
    m_Localized: "\u0422\u0440\u0435\u0442\u0438\u0439 \u0431\u0440\u043E\u0434 \u0447\u0435\u0440\u0435\u0437
      \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u0443\u044E \u0440\u0435\u0447\u043A\u0443.
      \u0418\u0432\u0430 \u0443 \u0431\u0435\u0440\u0435\u0433\u0430 \u043E\u0431\u043B\u043E\u043C\u0430\u043D\u0430
      - \u0437\u043D\u0430\u0447\u0438\u0442, \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u0434\u0430\u0432\u043D\u043E
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u043B\u0438\u0441\u044C.
      \u0422\u0438\u0448\u0438\u043D\u0430 \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324183
    m_Localized: "\u041F\u0435\u0440\u0435\u0441\u0435\u0447\u044C \u0431\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324184
    m_Localized: "\u0418\u0437-\u0437\u0430 \u043F\u0440\u0438\u0431\u0440\u0435\u0436\u043D\u044B\u0445
      \u043A\u0430\u043C\u043D\u0435\u0439 \u0432\u044B\u0441\u043A\u043E\u0447\u0438\u043B\u0438
      \u0442\u0440\u043E\u0435. \u041F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      \u043C\u043E\u043D\u0430\u0445\u0430 \u0441\u0431\u0435\u0440\u0435\u0433\u043B\u043E
      \u0441\u0435\u043A\u0443\u043D\u0434\u044B - \u043E\u0445\u0440\u0430\u043D\u0430
      \u0443\u0441\u043F\u0435\u043B\u0430 \u0432\u0441\u0442\u0430\u0442\u044C.
      \u0417\u0430\u0441\u0430\u0434\u0430 \u0441\u043E\u0440\u0432\u0430\u043B\u0430\u0441\u044C,
      \u043F\u043E\u0442\u0435\u0440\u0438 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B.
      \u041C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0435 \xAB\u0441\u043D\u044B\xBB
      \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439
      \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324185
    m_Localized: "\u041F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0435 \u043A\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324186
    m_Localized: "\u0412\u0435\u0447\u0435\u0440 \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0435
      \u041C\u0435\u0440\u0432\u0430. \u0422\u0440\u043E\u0435 \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0445
      \u043A\u0443\u043F\u0446\u043E\u0432 \u0441\u0438\u0434\u044F\u0442 \u0443
      \u043D\u0438\u0437\u043A\u043E\u0433\u043E \u0441\u0442\u043E\u043B\u0430,
      \u043A\u0438\u0434\u0430\u044E\u0442 \u043A\u043E\u0441\u0442\u0438. \u041E\u0434\u0438\u043D
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u0443:
      <npc_speech lang=\"Persian\">\u0421\u0430\u0434\u0438\u0441\u044C, \u043A\u0443\u043F\u0435\u0446.
      \u0421\u0435\u0440\u0435\u0431\u0440\u043E \u043A \u0441\u0435\u0440\u0435\u0431\u0440\u0443
      - \u0438\u043B\u0438 \u0443\u0445\u043E\u0434\u0438 \u043A \u0441\u0432\u043E\u0438\u043C
      \u043C\u0435\u0448\u043A\u0430\u043C.</npc_speech> \u0418\u0445 \u043A\u043E\u0441\u0442\u0438
      \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442 \u0447\u0435\u0441\u0442\u043D\u044B\u043C\u0438
      - \u0441\u043B\u043E\u043D\u043E\u0432\u0430\u044F \u043A\u043E\u0441\u0442\u044C,
      \u0445\u043E\u0440\u043E\u0448\u043E \u0441\u0431\u0430\u043B\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435.
      \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u0443 \u043B\u044E\u0434\u0435\u0439
      \u0434\u043E\u0431\u0440\u043E\u0435, \u0432\u0438\u043D\u043E \u0434\u0435\u0448\u0451\u0432\u043E\u0435.
      \u041F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043C\u043E\u0436\u043D\u043E
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E - \u0449\u0435\u043A\u043E\u0442\u043A\u0430
      \u0440\u0438\u0441\u043A\u0430 \u043F\u043E\u0441\u043B\u0435 \u043F\u044B\u043B\u044C\u043D\u043E\u0433\u043E
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430. \u0418\u043B\u0438 \u043D\u0435
      \u0438\u0433\u0440\u0430\u0442\u044C \u0441\u043E\u0432\u0441\u0435\u043C:
      \u0434\u0435\u043D\u044C\u0433\u0438 \u043D\u0443\u0436\u043D\u044B \u043D\u0430
      \u0434\u0435\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324187
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u0438\u0433\u0440\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324188
    m_Localized: "\u0412\u044B \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0438\u0441\u044C
      \u0438 \u0437\u0430\u043A\u0430\u0437\u0430\u043B\u0438 \u0447\u0430\u0439.
      \u041F\u0435\u0440\u0441\u044B \u043F\u043E\u0436\u0430\u043B\u0438 \u043F\u043B\u0435\u0447\u0430\u043C\u0438
      \u0438 \u043D\u0430\u0448\u043B\u0438 \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u043E\u0433\u043E
      \u0438\u0433\u0440\u043E\u043A\u0430 \u0441\u0440\u0435\u0434\u0438 \u043C\u0435\u0441\u0442\u043D\u044B\u0445.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u0446\u0435\u043B\u044B, \u0433\u043E\u043B\u043E\u0432\u0430
      \u044F\u0441\u043D\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324189
    m_Localized: "\u0421\u044B\u0433\u0440\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324190
    m_Localized: "\u041A\u043E\u0441\u0442\u0438 \u043B\u0435\u0433\u043B\u0438 \u043D\u0430
      \u0441\u0442\u043E\u043B. \u0418\u0433\u0440\u0430 \u0437\u0430\u0442\u044F\u043D\u0443\u043B\u0430\u0441\u044C
      \u0437\u0430 \u043F\u043E\u043B\u043D\u043E\u0447\u044C - \u0438 \u0447\u0435\u0440\u0435\u0437
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439
      \u043F\u0440\u0438\u0434\u0451\u0442 \u0440\u0430\u0441\u043F\u043B\u0430\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324191
    m_Localized: "\u0418\u0442\u043E\u0433 \u0438\u0433\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324192
    m_Localized: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439
      \u0441\u043F\u0443\u0441\u0442\u044F \u0432\u044B \u043F\u043E\u0434\u0432\u043E\u0434\u0438\u0442\u0435
      \u0438\u0442\u043E\u0433 \u0442\u043E\u0439 \u043D\u043E\u0447\u0438 \u0432
      \u041C\u0435\u0440\u0432\u0435. \u0423\u0434\u0430\u0447\u0430 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
      \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0434\u0432\u0443\u0445 \u0441\u0442\u043E\u0440\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324193
    m_Localized: "\u041F\u0440\u043E\u0438\u0433\u0440\u044B\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324194
    m_Localized: "\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0443\u0448\u043B\u0438 \u0432 \u0442\u0443 \u043D\u043E\u0447\u044C - \u0438
      \u0441 \u043D\u0438\u043C\u0438 \u0440\u0430\u0434\u043E\u0441\u0442\u044C
      \u043E\u0442 \u0432\u044B\u0438\u0433\u0440\u044B\u0448\u0430 \u043F\u043E
      \u0434\u043E\u0440\u043E\u0433\u0435 \u0441\u044E\u0434\u0430. \u041F\u0435\u0440\u0441\u044B
      \u0438\u0433\u0440\u0430\u043B\u0438 \u0447\u0435\u0441\u0442\u043D\u043E.
      \u041A\u043E\u0441\u0442\u0438 \u0447\u0435\u0441\u0442\u043D\u044B\u0435 -
      \u043D\u043E \u0443\u0434\u0430\u0447\u0430 \u043D\u0435\u0447\u0435\u0441\u0442\u043D\u0430\u044F.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0434\u0435\u043B\u0438\u043A\u0430\u0442\u043D\u043E
      \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442,
      \u043A\u0443\u0434\u0430 \u0434\u0435\u043B\u043E\u0441\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324195
    m_Localized: "\u0412\u044B\u0438\u0433\u0440\u044B\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324196
    m_Localized: "\u0412\u044B \u0432\u0441\u0442\u0430\u043B\u0438 \u0438\u0437-\u0437\u0430
      \u0441\u0442\u043E\u043B\u0430 \u0441 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C\u044E
      \u043B\u0438\u0448\u043D\u0438\u043C\u0438 \u0434\u0438\u0440\u0445\u0430\u043C\u0430\u043C\u0438.
      \u041F\u0435\u0440\u0441\u044B \u0440\u0430\u0441\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u043F\u043E-\u0434\u043E\u0431\u0440\u043E\u043C\u0443 - \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u044E\u0442
      \u0442\u0430\u043A \u0436\u0435 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E,
      \u043A\u0430\u043A \u0432\u044B\u0438\u0433\u0440\u044B\u0432\u0430\u044E\u0442.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0443\u0433\u043E\u0449\u0435\u043D\u0438\u0435 \u0437\u0430 \u0441\u0447\u0451\u0442
      \u0443\u0434\u0430\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324197
    m_Localized: "\u0417\u0430\u0433\u043E\u0432\u043E\u0440 \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324198
    m_Localized: "\u041F\u043E\u0437\u0434\u043D\u0438\u0439 \u0432\u0435\u0447\u0435\u0440,
      \u0442\u0430\u0432\u0435\u0440\u043D\u0430 \u0443 \u0431\u0430\u0437\u0430\u0440\u0430.
      \u0414\u0432\u043E\u0435 \u0432 \u0443\u0433\u043B\u0443 \u0433\u043E\u0432\u043E\u0440\u044F\u0442
      \u0442\u0438\u0445\u043E - \u043D\u043E \u043D\u0435 \u0442\u0438\u0445\u043E
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E. \u0412\u044B
      \u0441\u043B\u044B\u0448\u0438\u0442\u0435 \u0441\u043B\u043E\u0432\u043E \xAB\u0431\u0430\u0441\u043A\u0430\u043A\xBB
      \u0438 \u0441\u043B\u043E\u0432\u043E \xAB\u043D\u043E\u0436\xBB. \u0411\u0430\u0441\u043A\u0430\u043A
      - \u043C\u043E\u043D\u0433\u043E\u043B\u044C\u0441\u043A\u0438\u0439 \u0438\u043B\u0438
      \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0439 \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A,
      \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0442\u0440\u0430\u043A\u0442\u0430:
      \u0437\u0434\u0435\u0441\u044C \u044D\u0442\u043E \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u0441 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0439 \u0432\u043B\u0430\u0441\u0442\u044C\u044E.
      \u0414\u043E\u043B\u043E\u0436\u0438\u0442\u044C - \u0437\u043D\u0430\u0447\u0438\u0442
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u0432\u043B\u0430\u0441\u0442\u0438: \u0445\u043E\u0440\u043E\u0448\u0435\u0435
      \u0438\u043B\u0438 \u043F\u043B\u043E\u0445\u043E\u0435. \u041F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u0442\u044C
      - \u0437\u043D\u0430\u0447\u0438\u0442 \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
      \u0447\u0438\u0441\u0442\u044B\u043C, \u043D\u043E \u0447\u0443\u0436\u0430\u044F
      \u043A\u0440\u043E\u0432\u044C \u043D\u0430 \u0432\u0430\u0448\u0435\u0439
      \u0441\u043E\u0432\u0435\u0441\u0442\u0438, \u0435\u0441\u043B\u0438 \u0434\u043E\u0439\u0434\u0451\u0442
      \u0434\u043E \u0434\u0435\u043B\u0430. \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C \u043F\u043E\u043B\u043E\u043D \u0442\u0435\u043C\u0438,
      \u043A\u0442\u043E \u0441\u043B\u044B\u0448\u0438\u0442 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043C\u043D\u043E\u0433\u043E - \u0438 \u0436\u0438\u0432\u0451\u0442 \u0434\u043E\u043B\u0433\u043E
      \u0438\u043C\u0435\u043D\u043D\u043E \u043F\u043E\u0442\u043E\u043C\u0443,
      \u0447\u0442\u043E \u043C\u043E\u043B\u0447\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324199
    m_Localized: "\u041F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u0442\u044C
      \u0431\u0430\u0441\u043A\u0430\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324200
    m_Localized: "\u0412\u044B \u043D\u0430\u0448\u043B\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0431\u0430\u0441\u043A\u0430\u043A\u0430 \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430.
      \u0421\u043B\u043E\u0432\u043E \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u0438
      \u0441\u0434\u0435\u0440\u0436\u0430\u043D\u043D\u043E, \u0431\u0435\u0437
      \u0438\u043C\u0451\u043D. \u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u0442\u0441\u044F
      \u0441 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0449\u0438\u043A\u0430\u043C\u0438
      - \u043D\u0435 \u0432\u0430\u0448\u0435 \u0434\u0435\u043B\u043E. \u0427\u0435\u0440\u0435\u0437
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439
      \u043F\u0440\u0438\u0434\u0451\u0442 \u043E\u0442\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324201
    m_Localized: "\u041F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324202
    m_Localized: "\u0412\u044B \u0434\u043E\u043F\u0438\u043B\u0438 \u0447\u0430\u0439
      \u0438 \u043B\u0435\u0433\u043B\u0438 \u0441\u043F\u0430\u0442\u044C. \u0427\u0443\u0436\u0438\u0435
      \u0434\u0435\u043B\u0430 \u043D\u0430 \u0447\u0443\u0436\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0435.
      \u0423\u0442\u0440\u043E\u043C \u0431\u0430\u0437\u0430\u0440 \u0433\u0443\u0434\u0435\u043B
      \u043E\u0431\u044B\u0447\u043D\u043E - \u0437\u043D\u0430\u0447\u0438\u0442,
      \u043F\u043E\u043A\u0430 \u043E\u0431\u043E\u0448\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324203
    m_Localized: "\u041E\u0442\u0432\u0435\u0442 \u0431\u0430\u0441\u043A\u0430\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324204
    m_Localized: "\u0423 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E \u0434\u0432\u043E\u0440\u0430
      \u0441\u043B\u0443\u0433\u0430 \u0431\u0430\u0441\u043A\u0430\u043A\u0430 \u043D\u0430\u0433\u043E\u043D\u044F\u0435\u0442
      \u0432\u0430\u0441 \u0441 \u043A\u043E\u0436\u0430\u043D\u043E\u0439 \u0441\u0443\u043C\u043E\u0439.
      \u0418\u043B\u0438 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0449\u0438\u043A\u0438
      - \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438
      \u043E\u0442 \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u0443\u0437\u043D\u0430\u043B
      \u043F\u0435\u0440\u0432\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324205
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043D\u0430\u0433\u0440\u0430\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324206
    m_Localized: "\u0421\u043B\u0443\u0433\u0430 \u0432\u0440\u0443\u0447\u0430\u0435\u0442
      \u0441\u0443\u043C: \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0438 \u0431\u0443\u043C\u0430\u0433\u0443 \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E
      - \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0439 \u043F\u0440\u043E\u0445\u043E\u0434
      \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u044B.
      <npc_speech lang=\"Old_Turkic\">\u0411\u0438\u043B\u044C\u0433\u044D-\u0431\u0435\u0433
      \u043F\u043E\u043C\u043D\u0438\u0442 \u0441\u0432\u043E\u0438\u0445.</npc_speech>
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0434\u043E\u043D\u043E\u0441\u0447\u0438\u043A\u0430
      \u0438\u043B\u0438 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0433\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 - \u0437\u0430\u0432\u0438\u0441\u0438\u0442
      \u043E\u0442 \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324207
    m_Localized: "\u0417\u0430\u0433\u043E\u0432\u043E\u0440\u0449\u0438\u043A\u0438
      \u043E\u0442\u043E\u043C\u0441\u0442\u0438\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324208
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u043A\u0442\u043E-\u0442\u043E
      \u0431\u0440\u043E\u0441\u0438\u043B \u043A\u0430\u043C\u0435\u043D\u044C \u0432
      \u043A\u0440\u044B\u0442\u0443\u044E \u043F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0438 \u043F\u043E\u0440\u0435\u0437\u0430\u043B \u0443\u043F\u0440\u044F\u0436\u044C.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B
      - \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435,
      \u043D\u0435 \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u0430. \u0417\u0430\u0433\u043E\u0432\u043E\u0440\u0449\u0438\u043A\u0438
      \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u043B\u0438 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A.
      \u0415\u0445\u0430\u0442\u044C \u043B\u0443\u0447\u0448\u0435 \u0431\u044B\u0441\u0442\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324209
    m_Localized: "\u0420\u0430\u0431 \u0443 \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u0433\u043E
      \u0432\u043E\u0436\u0434\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324210
    m_Localized: "\u041B\u0430\u0433\u0435\u0440\u044C \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u0433\u043E
      \u0432\u043E\u0436\u0434\u044F \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D\u0430
      \u0443 \u0442\u0440\u0430\u043A\u0442\u0430 - \u044E\u0440\u0442\u044B, \u043A\u043E\u043D\u0438,
      \u0437\u0430\u043F\u0430\u0445 \u0433\u043E\u0440\u044F\u0449\u0435\u0433\u043E
      \u043A\u0438\u0437\u044F\u043A\u0430. \u0421\u0440\u0435\u0434\u0438 \u0441\u043B\u0443\u0433
      \u0432\u044B \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442\u0435 \u0441\u043E\u0433\u0434\u0438\u0439\u0446\u0430:
      \u043E\u0434\u0435\u0436\u0434\u0430 \u0440\u0432\u0430\u043D\u0430\u044F,
      \u043B\u0438\u0446\u043E \u043E\u043F\u0443\u0445\u0448\u0435\u0435, \u043D\u043E
      \u043E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043F\u0440\u044F\u043C\u043E.
      \u041B\u043E\u0432\u0438\u0442 \u0432\u0430\u0448 \u0432\u0437\u0433\u043B\u044F\u0434.
      <npc_speech lang=\"Sogdian\">\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u0438\u0437 \u041A\u0435\u0448\u0430. \u0422\u0440\u0438 \u0433\u043E\u0434\u0430.
      \u041F\u0440\u043E\u0448\u0443 - \u0432\u044B\u043A\u0443\u043F\u0438. \u041E\u0442\u0440\u0430\u0431\u043E\u0442\u0430\u044E
      \u0432\u0441\u0451, \u0447\u0442\u043E \u0441\u043A\u0430\u0436\u0435\u0448\u044C.</npc_speech>
      \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D \u043D\u0430\u0437\u043D\u0430\u0447\u0430\u0435\u0442
      \u0446\u0435\u043D\u0443: \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432. \u042D\u0442\u043E \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C
      \u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u043E\u0431\u043E\u0440\u043E\u0442\u0430. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0441\u043E \u0437\u043D\u0430\u043D\u0438\u0435\u043C \u043C\u0435\u0441\u0442\u043D\u044B\u0445
      \u0434\u043E\u0440\u043E\u0433 \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0433\u043E,
      \u0438 \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442, \u0441\u0443\u0434\u044F
      \u043F\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u0443, \u0437\u043D\u0430\u0435\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324211
    m_Localized: "\u0412\u044B\u043A\u0443\u043F\u0438\u0442\u044C \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324212
    m_Localized: "\u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043F\u0435\u0440\u0435\u0448\u043B\u0438 \u043A \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D\u0443.
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0441\u0442\u0430\u0440\u044B\u0439 \u0445\u0430\u043B\u0430\u0442 \u0438\u0437
      \u0432\u0430\u0448\u0435\u0433\u043E \u0437\u0430\u043F\u0430\u0441\u0430 \u0438
      \u043C\u0435\u0441\u0442\u043E \u0443 \u043F\u043E\u0432\u043E\u0437\u043A\u0438.
      \u0413\u043B\u0430\u0437\u0430 \u043E\u043F\u0443\u0441\u0442\u0438\u043B -
      \u043D\u0435 \u043E\u0442 \u0441\u0442\u044B\u0434\u0430, \u043E\u0442 \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u0438.
      \u0427\u0442\u043E \u043E\u043D \u0441\u0442\u043E\u0438\u0442 - \u043F\u043E\u043A\u0430\u0436\u0443\u0442
      \u0434\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324213
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043E\u0442
      \u0432\u044B\u043A\u0443\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324214
    m_Localized: "\u0412\u044B \u043E\u0442\u0432\u0435\u043B\u0438 \u0432\u0437\u0433\u043B\u044F\u0434.
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043F\u043E\u043D\u044F\u043B
      - \u043F\u043B\u0435\u0447\u0438 \u043E\u043F\u0430\u043B\u0438. \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043A \u0441\u0432\u043E\u0438\u043C
      \u0434\u0435\u043B\u0430\u043C. \u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0446\u0435\u043B\u044B,
      \u043D\u043E \u0434\u043E\u0440\u043E\u0433\u0430 \u043E\u0442 \u043B\u0430\u0433\u0435\u0440\u044F
      \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u0434\u043B\u0438\u043D\u043D\u0435\u0435
      \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324215
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043D\u0430 \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324216
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u0434\u0435\u0441\u044F\u0442\u044C
      \u0434\u043D\u0435\u0439 \u043F\u0443\u0442\u0438 \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043A \u0432\u0430\u043C
      \u043F\u0435\u0440\u0432\u044B\u043C - \u0441 \u043A\u0443\u0441\u043A\u043E\u043C
      \u043E\u0431\u0442\u044F\u043D\u0443\u0442\u043E\u0439 \u043A\u043E\u0436\u0435\u0439
      \u0449\u0435\u043F\u043A\u0438, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043F\u0440\u043E\u0446\u0430\u0440\u0430\u043F\u0430\u043D\u0430 \u043A\u0430\u0440\u0442\u0430
      \u0442\u0440\u043E\u043F. \u041E\u0434\u0438\u043D \u0438\u0437 \u0434\u0432\u0443\u0445
      \u0438\u0441\u0445\u043E\u0434\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324217
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0441\u0442\u0430\u043B
      \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324218
    m_Localized: "<npc_speech lang=\"Sogdian\">\u042F \u0437\u043D\u0430\u044E \u0432\u0441\u0435
      \u0431\u0440\u043E\u0434\u044B \u0434\u043E \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430.
      \u0418 \u0442\u0440\u0438 \u0442\u0440\u043E\u043F\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043D\u0435\u0442 \u043D\u0430 \u0433\u0443\u0430\u043D\u044C\u0434\u0438\u0435.</npc_speech>
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0442\u0435\u043C, \u0447\u0435\u043C \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B:
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u043C \u0430\u0433\u0435\u043D\u0442\u043E\u043C,
      \u043F\u043E\u0442\u0435\u0440\u044F\u0432\u0448\u0438\u043C \u0445\u043E\u0437\u044F\u0438\u043D\u0430.
      \u041A\u0430\u0440\u0442\u0430 \u0442\u043E\u0447\u043D\u0430\u044F, \u043E\u0431\u0445\u043E\u0434\u044B
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0435. \u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u043E\u0442\u0431\u0438\u043B\u0438\u0441\u044C
      \u0437\u0430 \u043F\u0435\u0440\u0432\u0443\u044E \u0436\u0435 \u043D\u0435\u0434\u0435\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324219
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0438\u0441\u0447\u0435\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324220
    m_Localized: "\u041D\u0430 \u0434\u0435\u0441\u044F\u0442\u0443\u044E \u043D\u043E\u0447\u044C
      \u0435\u0433\u043E \u043C\u0435\u0441\u0442\u043E \u0443 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043F\u0443\u0441\u0442\u043E. \u041D\u0438 \u0437\u0430\u043F\u0438\u0441\u043A\u0438,
      \u043D\u0438 \u0441\u043B\u043E\u0432\u0430 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430\u043C.
      \u0418\u0441\u0447\u0435\u0437 - \u043A\u0430\u043A \u0438 \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u043E
      \u043E\u0436\u0438\u0434\u0430\u0442\u044C \u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
      \u043F\u0440\u0438\u0432\u044B\u043A\u0448\u0435\u0433\u043E \u0432\u044B\u0436\u0438\u0432\u0430\u0442\u044C
      \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443. \u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0441\u0442\u0430\u043B\u0438
      \u043F\u043B\u0430\u0442\u043E\u0439 \u0437\u0430 \u0445\u043E\u0440\u043E\u0448\u0438\u0439
      \u043D\u043E\u0447\u043D\u043E\u0439 \u043E\u0442\u0434\u044B\u0445 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0431\u044B\u0432\u0448\u0435\u0433\u043E \u0440\u0430\u0431\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324221
    m_Localized: "\u0421\u0430\u043A\u043A \u0431\u0435\u0437 \u0437\u0430\u043B\u043E\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324222
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0440\u043E\u0437\u043E\u0432\u044B\u043C
      \u043C\u0430\u0441\u043B\u043E\u043C \u0438 \u0433\u043E\u0440\u044F\u0447\u0438\u043C
      \u043E\u043B\u043E\u0432\u043E\u043C - \u043C\u0435\u043D\u044F\u043B\u044B
      \u0447\u0435\u043A\u0430\u043D\u044F\u0442 \u0434\u0438\u0440\u0445\u0430\u043C\u044B
      \u043F\u043E\u0434 \u043D\u0430\u0432\u0435\u0441\u0430\u043C\u0438. \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u0431\u0430\u043D\u043A\u0438\u0440 \u0411\u0430\u0445\u0440\u0430\u043C,
      \u0432 \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u043E\u043C \u0448\u0451\u043B\u043A\u0435
      \u0441 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u043C \u043F\u043E\u044F\u0441\u043E\u043C,
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043F\u0435\u0440\u0432\u044B\u043C
      \u0438 \u043A\u043B\u0430\u0434\u0451\u0442 \u043F\u0435\u0440\u0435\u0434
      \u0432\u0430\u043C\u0438 \u0441\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0439
      \u043B\u0438\u0441\u0442 \u0431\u0443\u043C\u0430\u0433\u0438. <npc_speech
      lang=\"Sogdian\">\u0412\u043E\u0441\u0435\u043C\u044C\u0434\u0435\u0441\u044F\u0442
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 - \u0441\u0430\u043A\u043A
      \u043D\u0430 \u041C\u0435\u0440\u0432. \u0411\u0435\u0437 \u0437\u0430\u043B\u043E\u0433\u0430.
      \u0418\u043C\u044F \u0447\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0436\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u0430.</npc_speech>
      \u0410\u043A\u043A\u0440\u0435\u0434\u0438\u0442\u0438\u0432 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0434\u0432\u0435\u0440\u0438 \u043B\u044E\u0431\u043E\u0433\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u0434\u043E\u043C\u0430 \u043D\u0430 \u043F\u0443\u0442\u0438 \u0434\u043E
      \u041C\u0435\u0440\u0432\u0430. \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0435
      \u0441\u0430\u043A\u043A-\u0441\u0435\u0442\u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F
      \u043D\u0430 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438 - \u0411\u0430\u0445\u0440\u0430\u043C
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u043B \u0432\u0430\u0441 \u0447\u0435\u0440\u0435\u0437
      \u0442\u0440\u0451\u0445 \u043A\u0443\u043F\u0446\u043E\u0432, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u043F\u043E\u0434\u043E\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324223
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0430\u043A\u043A
      \u043D\u0430 80 \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324224
    m_Localized: "\u0411\u0430\u0445\u0440\u0430\u043C \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u043A\u0440\u0443\u0433\u043B\u0443\u044E \u0441\u0432\u0438\u043D\u0446\u043E\u0432\u0443\u044E
      \u043F\u0435\u0447\u0430\u0442\u044C. \u0421\u0430\u043A\u043A - \u043D\u0435
      \u043C\u043E\u043D\u0435\u0442\u044B, \u043E\u043D \u043B\u0435\u0433\u0447\u0435
      \u0438 \u043D\u0430\u0434\u0451\u0436\u043D\u0435\u0435: \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0448\u044C
      \u0432 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C \u0434\u043E\u043C\u0435
      \u041C\u0435\u0440\u0432\u0430, \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E. \u0422\u0435, \u043A\u0442\u043E
      \u0437\u043D\u0430\u044E\u0442 \u0411\u0430\u0445\u0440\u0430\u043C\u0430,
      \u0434\u043E\u0432\u0435\u0440\u044F\u044E\u0442 \u0438 \u0432\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324225
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043B\u0438\u0448\u044C \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u0441\u0443\u043C\u043C\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324226
    m_Localized: "\u0421\u043E\u0440\u043E\u043A \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      - \u043C\u0435\u043D\u044C\u0448\u0438\u0439 \u0434\u043E\u043B\u0433, \u043C\u0435\u043D\u044C\u0448\u0438\u0439
      \u0440\u0438\u0441\u043A. \u0411\u0430\u0445\u0440\u0430\u043C \u043A\u0438\u0432\u043D\u0443\u043B
      \u0431\u0435\u0437 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u044F:
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u0439 \u043A\u0443\u043F\u0435\u0446
      \u0436\u0438\u0432\u0451\u0442 \u0434\u043E\u043B\u044C\u0448\u0435. \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043D\u0430\u0432\u044B\u043A \u0440\u0430\u0441\u0442\u0451\u0442, \u043A\u043E\u0433\u0434\u0430
      \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C \u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u0436\u0430\u0434\u043D\u0438\u0447\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324227
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324228
    m_Localized: "\u0411\u0430\u0445\u0440\u0430\u043C \u0443\u0431\u0440\u0430\u043B
      \u0431\u0443\u043C\u0430\u0433\u0443 \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B.
      \u041E\u0442\u043A\u0430\u0437 \u043E\u0442 \u0434\u043E\u043B\u0433\u0430
      - \u0442\u043E\u0436\u0435 \u0437\u043D\u0430\u043A \u0440\u0430\u0437\u0443\u043C\u043D\u043E\u0441\u0442\u0438.
      \u0421\u043B\u0443\u0445 \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0432\u044B
      \u043D\u0435 \u0431\u0435\u0440\u0451\u0442\u0435 \u0441\u0432\u0435\u0440\u0445
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0433\u043E, \u0440\u0430\u0437\u043E\u0448\u0451\u043B\u0441\u044F
      \u043F\u043E \u0440\u044B\u043D\u043A\u0443 \u0440\u0430\u043D\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F
      \u0431\u0430\u0437\u0430\u0440\u043D\u044B\u0439 \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324229
    m_Localized: "\u041F\u0438\u0440 \u0443 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430
      \u0427\u044D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324230
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0443\u043A\u0441\u0443\u0441\u043D\u043E\u0439
      \u0441\u0432\u0438\u043D\u0438\u043D\u044B \u0438 \u0438\u043C\u0431\u0438\u0440\u044F
      \u0442\u044F\u043D\u0435\u0442\u0441\u044F \u0438\u0437 \u0440\u0430\u0441\u043F\u0430\u0445\u043D\u0443\u0442\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0441\u043A\u043E\u0439
      \u0443\u043F\u0440\u0430\u0432\u044B \u0432 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0435.
      \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u0432 \u0441\u0438\u043D\u0435\u0439
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u0447\u044C\u0435\u0439 \u0440\u043E\u0431\u0435
      \u0441 \u0431\u0435\u043B\u044B\u043C \u0446\u0430\u043F\u043B\u044F\u043D\u044B\u043C
      \u043D\u0430\u0448\u0438\u0432\u043D\u044B\u043C \u0437\u043D\u0430\u043A\u043E\u043C
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0443 \u0432\u043E\u0440\u043E\u0442:
      <npc_speech lang=\"Chinese\">\u0426\u0437\u0435\u0434\u0443\u0448\u0438 \u0427\u044D\u043D\u044C
      \u0412\u044D\u0439 \u0441\u043B\u044B\u0448\u0430\u043B \u043E \u0432\u0430\u0448\u0435\u043C
      \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C \u043F\u0443\u0442\u0438.
      \u041E\u043D \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u0435\u0442 \u043D\u0430
      \u043F\u0438\u0440 - \u0432 \u0447\u0435\u0441\u0442\u044C \u043A\u0443\u043F\u0446\u0430,
      \u0447\u044C\u0451 \u0438\u043C\u044F \u043D\u0435 \u0442\u0440\u0435\u043F\u0435\u0449\u0435\u0442
      \u043F\u0435\u0440\u0435\u0434 \u0441\u0442\u0440\u0430\u0436\u0435\u0439.</npc_speech>
      \u041F\u0438\u0440 \u0432 \u0441\u0442\u0438\u043B\u0435 \u0442\u0430\u043D\u0441\u043A\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430: \u0432\u043E\u0441\u0435\u043C\u044C \u0431\u043B\u044E\u0434,
      \u043A\u0430\u0439\u044E\u0430\u043D\u044C \u0442\u0443\u043D\u0431\u0430\u043E
      \u0432 \u043A\u0440\u0430\u0441\u043D\u044B\u0445 \u043D\u0438\u0442\u044F\u043D\u044B\u0445
      \u043C\u0435\u0448\u043E\u0447\u043A\u0430\u0445 \u0433\u043E\u0441\u0442\u044F\u043C.
      \u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u0445\u043E\u0447\u0435\u0442
      \u0443\u0437\u043D\u0430\u0442\u044C \u043E \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0434\u043E\u0440\u043E\u0433\u0430\u0445 - \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C
      \u0432\u043B\u0430\u0441\u0442\u044C \u0442\u0435\u043C, \u043A\u0442\u043E
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289592324231
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518400
    m_Localized: "\u0422\u0440\u0438 \u0447\u0430\u0441\u0430 \u0437\u0430 \u043B\u0430\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C
      \u0441\u0442\u043E\u043B\u043E\u043C. \u0427\u044D\u043D\u044C \u0412\u044D\u0439
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u043E \u0434\u043E\u0440\u043E\u0433\u0430\u0445,
      \u0432\u044B - \u043E\u0431 \u0443\u0439\u0433\u0443\u0440\u0441\u043A\u0438\u0445
      \u0440\u044B\u043D\u043A\u0430\u0445. \u0414\u0443\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F: \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0443\u0437\u043D\u0430\u043B\u0438, \u0447\u0442\u043E \u0438\u0445 \u043D\u0430\u043D\u044F\u0442\u0435\u043B\u044C
      \u0435\u0441\u0442 \u0441 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u043E\u043C.
      \u041C\u043E\u043D\u0435\u0442\u044B \u0432 \u043C\u0435\u0448\u043E\u0447\u043A\u0435
      - \u043A\u0430\u0439\u044E\u0430\u043D\u044C \u0442\u0443\u043D\u0431\u0430\u043E,
      \u0447\u0438\u0441\u0442\u043E\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518401
    m_Localized: "\u041F\u0440\u0438\u0439\u0442\u0438 \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438
      \u043F\u043E\u0434\u0430\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518402
    m_Localized: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0431\u043E\u043B\u0442
      \u0437\u0430\u043F\u0430\u0434\u043D\u043E\u0433\u043E \u0448\u0451\u043B\u043A\u0430
      - \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E. \u0427\u044D\u043D\u044C
      \u0412\u044D\u0439 \u043F\u0440\u0438\u043D\u044F\u043B \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C,
      \u0436\u0435\u0441\u0442 \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u0435\u0442\u0441\u044F.
      \u0413\u0443\u0430\u043D\u044C\u0434\u0438\u0435 \u0432\u043E\u0440\u043E\u0442
      \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0430 \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0440\u0430\u0437 \u043E\u0442\u043A\u0440\u043E\u044E\u0442\u0441\u044F \u0431\u044B\u0441\u0442\u0440\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518403
    m_Localized: "\u0418\u0437\u0432\u0438\u043D\u0438\u0442\u044C\u0441\u044F \u0438
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518404
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u044B\u0439 \u043E\u0442\u043A\u0430\u0437.
      \u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u043D\u0435 \u043E\u0431\u0438\u0434\u0435\u043B\u0441\u044F
      - \u043A\u0443\u043F\u0446\u044B \u0441\u043F\u0435\u0448\u0430\u0442. \u0412\u043E\u0440\u043E\u0442\u0430
      \u043F\u0440\u043E\u0448\u043B\u0438 \u0431\u0435\u0437 \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430:
      \u043F\u043E\u0441\u0442 \u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E
      \u0446\u0437\u0435\u0434\u0443\u0448\u0438 \u0441\u0430\u043C \u0437\u0432\u0430\u043B
      \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518405
    m_Localized: "\u0411\u0438\u043B\u044C\u0433\u044D \u0438\u0449\u0435\u0442 \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518406
    m_Localized: "\u0423 \u043A\u043E\u043D\u043E\u0432\u044F\u0437\u0438 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430 \u043F\u0430\u0445\u043D\u0435\u0442 \u043A\u043E\u043D\u0441\u043A\u0438\u043C
      \u043F\u043E\u0442\u043E\u043C \u0438 \u0434\u0443\u0431\u043B\u0451\u043D\u043E\u0439
      \u043A\u043E\u0436\u0435\u0439. \u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0439
      \u0432\u043E\u0438\u043D \u0411\u0438\u043B\u044C\u0433\u044D - \u0448\u0440\u0430\u043C
      \u0447\u0435\u0440\u0435\u0437 \u0431\u0440\u043E\u0432\u044C, \u0441\u043E\u0441\u0442\u0430\u0432\u043D\u043E\u0439
      \u043B\u0443\u043A \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 - \u0441\u0442\u043E\u0438\u0442
      \u043F\u0440\u044F\u043C\u043E \u0438 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0432\u0430\u0441 \u043F\u043E \u0438\u043C\u0435\u043D\u0438 \u0431\u0435\u0437
      \u043F\u0440\u0435\u0434\u0438\u0441\u043B\u043E\u0432\u0438\u0439: <npc_speech
      lang=\"Turkic\">\u042F \u0441\u043B\u044B\u0448\u0430\u043B - \u0442\u044B
      \u043F\u0440\u043E\u0448\u0451\u043B \u041F\u0430\u043C\u0438\u0440 \u0431\u0435\u0437
      \u043F\u043E\u0442\u0435\u0440\u044C. \u041C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D
      \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C, \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443
      \u043D\u0435 \u0441\u0442\u044B\u0434\u043D\u043E \u0441\u043B\u0443\u0436\u0438\u0442\u044C.</npc_speech>
      \u041F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442
      \u0432 \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u0439 \u043A\u0430\u0432\u0430\u043B\u0435\u0440\u0438\u0438,
      \u0437\u043D\u0430\u0435\u0442 \u0433\u043E\u0440\u043D\u044B\u0435 \u0442\u0440\u043E\u043F\u044B
      \u043E\u0442 \u0424\u0435\u0440\u0433\u0430\u043D\u044B \u0434\u043E \u041A\u0430\u0448\u0433\u0430\u0440\u0430.
      \u041C\u0435\u0441\u0442\u043E \u0432 \u043E\u0445\u0440\u0430\u043D\u0435
      \u043E\u043D \u043F\u0440\u043E\u0441\u0438\u0442 \u0441\u043A\u0440\u043E\u043C\u043D\u043E\u0435
      - \u0441\u043B\u0430\u0432\u0430 \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044F
      \u0432\u0430\u0436\u043D\u0435\u0435 \u043F\u043B\u0430\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518407
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u0411\u0438\u043B\u044C\u0433\u044D"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518408
    m_Localized: "\u0420\u0443\u043A\u043E\u043F\u043E\u0436\u0430\u0442\u0438\u0435
      \u0437\u0430\u043C\u0435\u043D\u0438\u043B\u043E \u0434\u043E\u0433\u043E\u0432\u043E\u0440.
      \u0411\u0438\u043B\u044C\u0433\u044D \u0437\u0430\u043D\u044F\u043B \u043C\u0435\u0441\u0442\u043E
      \u0443 \u0433\u043E\u043B\u043E\u0432\u044B \u043A\u043E\u043B\u043E\u043D\u043D\u044B
      - \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0434\u043B\u044F
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0441\u043D\u0438\u0437\u0438\u043B\u0430\u0441\u044C:
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438 \u0432\u0438\u0434\u044F\u0442
      \u043E\u043F\u044B\u0442\u043D\u043E\u0433\u043E \u0432\u043E\u0438\u043D\u0430
      \u0438 \u0441\u0447\u0438\u0442\u0430\u044E\u0442 \u0440\u0438\u0441\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518409
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u0437\u0430 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u0446\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518410
    m_Localized: "\u0411\u0438\u043B\u044C\u0433\u044D \u043F\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0430\u043B\u0441\u044F
      \u043A\u0440\u0430\u0442\u043A\u043E \u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0441\u044F.
      \u041F\u043E\u043B\u0446\u0435\u043D\u044B - \u0447\u0435\u0441\u0442\u043D\u043E
      \u0434\u043B\u044F \u0438\u0441\u043F\u044B\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u0441\u0440\u043E\u043A\u0430. \u041E\u0445\u0440\u0430\u043D\u0430 \u0441\u0442\u0430\u043B\u0430
      \u043D\u0430\u0434\u0451\u0436\u043D\u0435\u0435, \u0445\u043E\u0442\u044F
      \u0432\u043E\u0438\u043D \u043F\u043E\u043C\u043D\u0438\u0442 \u0442\u043E\u0440\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518411
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518412
    m_Localized: "\u0411\u0438\u043B\u044C\u0433\u044D \u043A\u0438\u0432\u043D\u0443\u043B
      \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0442\u0430\u043A\u043E\u0432\u0430, \u0447\u0442\u043E \u043E\u043D \u0437\u043D\u0430\u0435\u0442
      - \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C.
      \u0421\u043B\u043E\u0432\u0430 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F
      \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C \u043F\u043E \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u043C\u0443
      \u0434\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518413
    m_Localized: "\u0426\u0435\u043D\u044B \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518414
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 - \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u043A\u0443\u043F\u0435\u0446 \u0441 \u0437\u0430\u043F\u0430\u0445\u043E\u043C
      \u043C\u0443\u0441\u043A\u0443\u0441\u0430 \u0438 \u043B\u0430\u0434\u0430\u043D\u0430
      \u043E\u0442 \u043E\u0434\u0435\u0436\u0434\u044B - \u043B\u043E\u0432\u0438\u0442
      \u0432\u0430\u0441 \u0443 \u0432\u043E\u0440\u043E\u0442 \u043F\u0435\u0440\u0435\u0434
      \u0432\u044B\u0445\u043E\u0434\u043E\u043C. \u0413\u043E\u0432\u043E\u0440\u0438\u0442
      \u0442\u0438\u0445\u043E, \u043F\u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F
      \u043D\u0430 \u0434\u0440\u0443\u0433\u0438\u0445: <npc_speech lang=\"Sogdian\">\u0428\u0451\u043B\u043A
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435 \u0443\u043F\u0430\u0434\u0451\u0442
      \u0447\u0435\u0440\u0435\u0437 \u0434\u0435\u0441\u044F\u0442\u044C \u0434\u043D\u0435\u0439
      - \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u0439
      \u043E\u0431\u043E\u0437 \u0443\u0436\u0435 \u0438\u0434\u0451\u0442. \u041F\u0440\u043E\u0434\u0430\u0432\u0430\u0439
      \u0441\u0435\u0439\u0447\u0430\u0441.</npc_speech> \u0417\u0430\u043A\u0440\u044B\u0442\u0430\u044F
      \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0434\u0430\u044E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0442\u0435\u043C, \u043A\u043E\u043C\u0443 \u0434\u043E\u0432\u0435\u0440\u044F\u044E\u0442.
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043D\u0435 \u043F\u0440\u043E\u0434\u0430\u0451\u0442
      \u0441\u043B\u0443\u0445\u0438 - \u043E\u043D \u0434\u0435\u043B\u0438\u0442\u0441\u044F
      \u0438\u043C\u0438 \u0441 \u043D\u0443\u0436\u043D\u044B\u043C\u0438 \u043B\u044E\u0434\u044C\u043C\u0438
      \u0432 \u043D\u0443\u0436\u043D\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518415
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u0441\u043E\u0432\u0435\u0442\u0443 \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518416
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u043B\u0438 \u0448\u0451\u043B\u043A
      \u0434\u043E \u043E\u0431\u0432\u0430\u043B\u0430. \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u043D\u0435 \u043E\u0448\u0438\u0431\u0441\u044F - \u043D\u0430 \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439
      \u0434\u0435\u043D\u044C \u0446\u0435\u043D\u0430 \u0440\u0443\u0445\u043D\u0443\u043B\u0430,
      \u043A\u0430\u043A \u043E\u043D \u0441\u043A\u0430\u0437\u0430\u043B. \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043D\u0430\u0432\u044B\u043A \u0440\u0430\u0441\u0442\u0451\u0442, \u043A\u043E\u0433\u0434\u0430
      \u0432\u0438\u0434\u0438\u0448\u044C \u0440\u044B\u043D\u043E\u043A \u043D\u0430
      \u0448\u0430\u0433 \u0432\u043F\u0435\u0440\u0451\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518417
    m_Localized: "\u0417\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C \u0441\u043E\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518418
    m_Localized: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043F\u0440\u0438\u0431\u044B\u043B\u044C
      \u043E\u0442 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E\u0439 \u043F\u0440\u043E\u0434\u0430\u0436\u0438.
      \u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0440\u0430\u0437\u0443\u043C\u043D\u0430
      - \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u043C\u0438\u0440 \u043F\u043E\u043B\u043E\u043D
      \u043B\u043E\u0436\u043D\u044B\u0445 \u0441\u043B\u0443\u0445\u043E\u0432.
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0437\u0430\u043C\u0435\u0442\u0438\u043B:
      \u0432\u044B \u0443\u043C\u0435\u0435\u0442\u0435 \u0441\u043B\u0443\u0448\u0430\u0442\u044C,
      \u043D\u043E \u043D\u0435 \u0441\u043B\u0435\u043F\u043E \u0434\u043E\u0432\u0435\u0440\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518419
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438 \u043F\u0440\u043E\u0441\u044F\u0442
      \u0437\u0430\u0449\u0438\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518420
    m_Localized: "\u0421\u0435\u043C\u0435\u0440\u043E \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u043E\u0432-\u0431\u0443\u0434\u0434\u0438\u0441\u0442\u043E\u0432
      \u0441 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u043C\u0438 \u0447\u0451\u0442\u043A\u0430\u043C\u0438
      \u0438 \u0438\u0437\u043D\u043E\u0448\u0435\u043D\u043D\u044B\u043C\u0438 \u0441\u0430\u043D\u0434\u0430\u043B\u0438\u044F\u043C\u0438
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442
      \u043E\u0431\u043E\u0437 \u0443 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u043C\u043E\u043D\u0430\u0445 \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u043B\u0441\u044F
      \u0442\u0440\u0438\u0436\u0434\u044B \u043F\u0435\u0440\u0435\u0434 \u0441\u043B\u043E\u0432\u0430\u043C\u0438:
      <npc_speech lang=\"Chinese\">\u0414\u043E\u0440\u043E\u0433\u0430 \u0434\u043E
      \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0430 \u043E\u043F\u0430\u0441\u043D\u0430.
      \u041C\u044B \u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u043E \u0432\u0430\u0448\u0435\u043C
      \u0438\u043C\u0435\u043D\u0438 \u043E\u0442 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0442\u0440\u0451\u0445 \u043F\u0440\u043E\u0448\u043B\u044B\u0445 \u043E\u0431\u043E\u0437\u043E\u0432.
      \u041F\u043E\u0437\u0432\u043E\u043B\u044C\u0442\u0435 \u0438\u0434\u0442\u0438
      \u0440\u044F\u0434\u043E\u043C.</npc_speech> \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438
      \u043D\u0435\u0441\u0443\u0442 \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u0443\u044E
      \u0441\u0442\u0430\u0442\u0443\u044D\u0442\u043A\u0443 \u0413\u0443\u0430\u043D\u044C\u0438\u043D\u044C
      - \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0435 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044E
      \u043F\u0435\u0449\u0435\u0440 \u041C\u043E\u0433\u0430\u043E. \u041F\u0443\u0442\u044C
      \u0441 \u043D\u0438\u043C\u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435,
      \u043D\u043E \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0430: \u043E\u043D\u0438
      \u0437\u043D\u0430\u044E\u0442 \u0442\u0430\u0439\u043D\u044B\u0435 \u0432\u043E\u0434\u043E\u043F\u043E\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518421
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043F\u043E\u0434 \u0437\u0430\u0449\u0438\u0442\u0443
      \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518422
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438 \u0448\u043B\u0438
      \u0442\u0438\u0445\u043E, \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438
      \u0434\u0432\u0430 \u0441\u043A\u0440\u044B\u0442\u044B\u0445 \u0432\u043E\u0434\u043E\u043F\u043E\u044F.
      \u0423 \u0432\u043E\u0440\u043E\u0442 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0430
      \u043C\u043E\u043D\u0430\u0445 \u0434\u0430\u043B \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u0432\u0441\u043B\u0443\u0445 - \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438
      \u0441\u043B\u044B\u0448\u0430\u043B\u0438. \u0418\u043C\u044F \u0441\u0442\u0430\u043B\u043E
      \u0447\u0438\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518423
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0437\u0430 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0443\u044E
      \u043F\u043B\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518424
    m_Localized: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u043E
      \u0438 \u0442\u0430\u0439\u043D\u044B\u0439 \u0432\u043E\u0434\u043E\u043F\u043E\u0439
      - \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u044B\u0439
      \u043E\u0431\u043C\u0435\u043D. \u041C\u043E\u043D\u0430\u0445 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B
      \u0431\u0435\u0437 \u0432\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0439:
      \u043E\u043D \u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u043E\u0445\u0440\u0430\u043D\u0430
      \u0441\u0442\u043E\u0438\u0442 \u0434\u0435\u043D\u0435\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518425
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u043A\u0430\u0436\u0434\u044B\u0439
      \u0434\u0435\u043D\u044C \u0432\u0430\u0436\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518426
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438 \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u043B\u0438\u0441\u044C
      \u0438 \u043F\u043E\u0448\u043B\u0438 \u0441\u0430\u043C\u0438. \u0421\u043B\u0443\u0445
      \u0440\u0430\u0437\u043E\u0448\u0451\u043B\u0441\u044F \u0441\u0440\u0435\u0434\u0438
      \u0432\u0441\u0442\u0440\u0435\u0447\u043D\u044B\u0445 \u043E\u0431\u043E\u0437\u043E\u0432:
      \u043A\u0443\u043F\u0435\u0446 \u0441\u043F\u0435\u0448\u0438\u0442, \u043D\u043E
      \u0432\u0435\u0436\u043B\u0438\u0432. \u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u043F\u043E\u0442\u0435\u0440\u044F \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518427
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0431\u0435\u0437 \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518428
    m_Localized: "\u041F\u043E\u0441\u0442 \u043D\u0430 \u0432\u044B\u0435\u0437\u0434\u0435
      \u0438\u0437 \u041C\u0435\u0440\u0432\u0430. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u0432 \u0432\u043E\u0439\u043B\u043E\u0447\u043D\u043E\u0439 \u0448\u0430\u043F\u043A\u0435
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043E\u043F\u0438\u0441\u044C
      \u0433\u0440\u0443\u0437\u0430, \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0433\u043B\u0430\u0437\u0430: <npc_speech lang=\"Persian\">\u0412\u0430\u0448\u0435
      \u0438\u043C\u044F \u044F \u0441\u043B\u044B\u0448\u0430\u043B \u043E\u0442
      \u043A\u0443\u043F\u0446\u043E\u0432 \u0438\u0437 \u0411\u0443\u0445\u0430\u0440\u044B.
      \u041F\u0440\u043E\u0435\u0437\u0436\u0430\u0439\u0442\u0435 - \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044C
      \u043D\u0435\u0447\u0435\u0433\u043E.</npc_speech> \u0417\u0430 \u0441\u043F\u0438\u043D\u043E\u0439
      \u0434\u0432\u0443\u0445 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432
      \u0438\u0437 \u0411\u0430\u043B\u0445\u0430 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442
      \u0438 \u0432\u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0442\u044E\u043A\u0438.
      \u0412\u0430\u0441 \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442
      \u0432\u043F\u0435\u0440\u0451\u0434 \u0431\u0435\u0437 \u0441\u043B\u043E\u0432\u0430.
      \u0427\u0435\u0441\u0442\u043D\u0430\u044F \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      - \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043D\u0435 \u043A\u0443\u043F\u0438\u0448\u044C \u043D\u0438 \u043D\u0430
      \u043E\u0434\u043D\u043E\u043C \u0440\u044B\u043D\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518429
    m_Localized: "\u041F\u0440\u043E\u0435\u0445\u0430\u0442\u044C \u0438 \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518430
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u044B\u0439 \u043A\u0438\u0432\u043E\u043A
      \u0438 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439 \u0432\u044B\u0435\u0437\u0434.
      \u0414\u0435\u043D\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D -
      \u0437\u0430 \u0442\u043E \u0436\u0435 \u0432\u0440\u0435\u043C\u044F \u0434\u0440\u0443\u0433\u0438\u0435
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B \u0432\u0441\u0451 \u0435\u0449\u0451
      \u0441\u0442\u043E\u044F\u0442 \u0443 \u0432\u043E\u0440\u043E\u0442. \u041F\u0440\u0438\u0432\u0430\u043B
      \u0440\u0430\u043D\u044C\u0448\u0435, \u043D\u0430 \u043B\u0443\u0447\u0448\u0435\u043C
      \u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518431
    m_Localized: "\u041F\u0440\u043E\u0435\u0445\u0430\u0442\u044C \u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043F\u043E\u0434\u0430\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518432
    m_Localized: "\u0413\u043E\u0440\u0441\u0442\u044C \u0444\u0438\u043D\u0438\u043A\u043E\u0432
      \u043D\u0430 \u043E\u043F\u043E\u0440\u043D\u044B\u0439 \u043A\u0430\u043C\u0435\u043D\u044C
      \u0432\u043E\u0440\u043E\u0442 - \u043D\u0435 \u0432\u0437\u044F\u0442\u043A\u0430,
      \u0436\u0435\u0441\u0442 \u043F\u0440\u0438\u0437\u043D\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438.
      \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442
      \u043B\u0438\u0446\u043E. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u043F\u0440\u043E\u0435\u0437\u0434 \u0442\u043E\u0436\u0435 \u0431\u0443\u0434\u0435\u0442
      \u0431\u044B\u0441\u0442\u0440\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518433
    m_Localized: "\u041A\u0443\u043C\u044B\u0441 \u043E\u0442 \u0432\u043E\u0436\u0434\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518434
    m_Localized: "\u0412\u0435\u0447\u0435\u0440\u043E\u043C \u0443 \u0441\u0442\u043E\u044F\u043D\u043A\u0438
      \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043A\u043E\u043D\u043D\u044B\u0439
      \u043F\u043E\u0441\u043B\u0430\u043D\u043D\u0438\u043A \u0441 \u043A\u043E\u0436\u0430\u043D\u044B\u043C
      \u0431\u0443\u0440\u0434\u044E\u043A\u043E\u043C: \u0437\u043D\u0430\u043A
      \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F \u043E\u0442 \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u0433\u043E
      \u0432\u043E\u0436\u0434\u044F \u0422\u0435\u0433\u0438\u043D\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0438\u0442 \u0435\u0433\u043E \u0441\u043B\u043E\u0432\u0430:
      <npc_speech lang=\"Turkic\">\u0412\u043E\u0436\u0434\u044C \u0441\u043B\u044B\u0448\u0430\u043B,
      \u0447\u0442\u043E \u043E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B
      \u0431\u0435\u0437 \u043E\u0431\u043C\u0430\u043D\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0437\u0435\u043C\u043B\u0438 \u0422\u0435\u0433\u0438\u043D\u0430 \u0432
      \u043F\u0440\u043E\u0448\u043B\u044B\u0439 \u0433\u043E\u0434. \u041A\u0443\u043C\u044B\u0441
      - \u043D\u0435 \u043F\u043B\u0430\u0442\u0430. \u042D\u0442\u043E \u043F\u0430\u043C\u044F\u0442\u044C.</npc_speech>
      \u041A\u0443\u043C\u044B\u0441 \u0438\u0437 \u043A\u043E\u0431\u044B\u043B\u044C\u0435\u0433\u043E
      \u043C\u043E\u043B\u043E\u043A\u0430, \u0447\u0443\u0442\u044C \u043A\u0438\u0441\u043B\u044B\u0439
      \u0438 \u043A\u0440\u0435\u043F\u043A\u0438\u0439 - \u043D\u0430\u043F\u0438\u0442\u043E\u043A
      \u0441\u0442\u0435\u043F\u043D\u044B\u0445 \u0441\u043E\u044E\u0437\u043E\u0432.
      \u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C \u0435\u0433\u043E \u0441
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430\u043C\u0438 \u0437\u043D\u0430\u0447\u0438\u0442
      \u0441\u043A\u0440\u0435\u043F\u0438\u0442\u044C \u0434\u043E\u0432\u0435\u0440\u0438\u0435
      \u0431\u0435\u0437 \u0441\u043B\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518435
    m_Localized: "\u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C \u0441 \u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518436
    m_Localized: "\u0411\u0443\u0440\u0434\u044E\u043A \u043F\u043E\u0448\u0451\u043B
      \u043F\u043E \u043A\u0440\u0443\u0433\u0443 \u0443 \u043A\u043E\u0441\u0442\u0440\u0430.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u0438\u043B\u0438
      \u043C\u043E\u043B\u0447\u0430 \u0438 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E
      - \u0437\u043D\u0430\u043A, \u0447\u0442\u043E \u0446\u0435\u043D\u044F\u0442
      \u0436\u0435\u0441\u0442. \u0414\u0443\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F \u043A\u0440\u0435\u043F\u0447\u0435,
      \u0447\u0435\u043C \u043E\u0442 \u043B\u044E\u0431\u043E\u0439 \u0440\u0435\u0447\u0438
      \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518437
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0438 \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518438
    m_Localized: "\u041F\u043E\u0441\u043B\u0430\u043D\u043D\u0438\u043A\u0443 \u0432\u0435\u0440\u043D\u0443\u043B\u0438
      \u043F\u0443\u0441\u0442\u043E\u0439 \u0431\u0443\u0440\u0434\u044E\u043A \u0438
      \u043F\u043E\u0436\u0435\u043B\u0430\u043D\u0438\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
      \u0432\u043E\u0436\u0434\u044E. \u041C\u0430\u043B\u044B\u0439 \u0436\u0435\u0441\u0442
      \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u0442\u043E\u043D\u0430 -
      \u0442\u044E\u0440\u043A\u0438 \u043F\u043E\u043C\u043D\u044F\u0442 \u043E\u0431\u0435
      \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u043E\u0431\u043C\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518439
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u044E
      \u043D\u0430\u043B\u0438\u0447\u043D\u044B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518440
    m_Localized: "\u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F
      - \u043D\u0435 \u043A\u0430\u0436\u0434\u044B\u0439 \u043A\u0443\u043F\u0435\u0446
      \u0443\u043C\u0435\u0435\u0442 \u0432\u043E\u0432\u0440\u0435\u043C\u044F \u0441\u043A\u0430\u0437\u0430\u0442\u044C
      \u043D\u0435\u0442. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0433\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430
      \u0442\u043E\u0436\u0435 \u0438\u043C\u0435\u0435\u0442 \u0446\u0435\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518441
    m_Localized: "\u041A\u0430\u0440\u0442\u0430 \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u043E\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518442
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u043A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444
      \u043B\u0435\u0436\u0438\u0442 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
      \u043D\u0430 \u0442\u044E\u043A\u0435 - \u0435\u0433\u043E \u043C\u0443\u043B
      \u0441\u0442\u043E\u0438\u0442 \u0440\u044F\u0434\u043E\u043C, \u0431\u0443\u0440\u0434\u044E\u043A
      \u043F\u0443\u0441\u0442\u043E\u0439. \u0416\u0430\u0440. \u0420\u0443\u043A\u0430
      \u043D\u0430\u0449\u0443\u043F\u044B\u0432\u0430\u0435\u0442 \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A, \u043A\u043E\u0433\u0434\u0430
      \u043E\u0431\u043E\u0437 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F:
      <npc_speech lang=\"Persian\">\u042F \u043D\u0435 \u0434\u043E\u0439\u0434\u0443
      \u0434\u043E \u041C\u0435\u0440\u0432\u0430. \u042D\u0442\u0430 \u043A\u0430\u0440\u0442\u0430
      - \u043E\u0431\u0445\u043E\u0434\u043D\u043E\u0439 \u043F\u0443\u0442\u044C
      \u0447\u0435\u0440\u0435\u0437 \u0411\u0430\u043B\u0445\u0441\u043A\u0443\u044E
      \u0432\u043F\u0430\u0434\u0438\u043D\u0443. \u042F \u0438\u0441\u043A\u0430\u043B
      \u043A\u0443\u043F\u0446\u0430, \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443
      \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u0435\u0451. \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0442\u044B \u0447\u0435\u0441\u0442\u0435\u043D.</npc_speech>
      \u041D\u0430 \u043A\u043E\u0436\u0435 \u043F\u0440\u043E\u0446\u0430\u0440\u0430\u043F\u0430\u043D\u044B
      \u0442\u0440\u043E\u043F\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043D\u0435\u0442 \u043D\u0430 \u0433\u0443\u0430\u043D\u044C\u0434\u0438\u0435.
      \u0415\u0441\u043B\u0438 \u043A\u0430\u0440\u0442\u0430 \u0432\u0435\u0440\u043D\u0430
      - \u0442\u0440\u0438 \u0434\u043D\u044F \u043F\u0443\u0442\u0438 \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u043B\u0435\u043D\u044B.
      \u0415\u0441\u043B\u0438 \u043D\u0435\u0442 - \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518443
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043A\u0430\u0440\u0442\u0443 \u0438
      \u043F\u043E\u043C\u043E\u0447\u044C \u043A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518444
    m_Localized: "\u041A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444\u0430 \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u0438
      \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u0439
      \u0441 \u0432\u043E\u0434\u043E\u0439 \u0438 \u0435\u0434\u043E\u0439. \u041A\u0430\u0440\u0442\u0430
      \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u0442\u043E\u0447\u043D\u043E\u0439
      - \u0442\u0440\u0438 \u0434\u043D\u044F \u043F\u0443\u0442\u0438 \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u043B\u0435\u043D\u044B,
      \u0442\u0440\u043E\u043F\u0430 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F.
      \u041D\u0430\u0432\u044B\u043A \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438
      \u0432\u044B\u0440\u043E\u0441: \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043D\u0430 \u043A\u0430\u0440\u0442\u0443 \u0443\u043C\u0435\u0435\u0442
      \u043A\u0430\u0436\u0434\u044B\u0439, \u0447\u0438\u0442\u0430\u0442\u044C
      \u0435\u0451 - \u043D\u0435 \u043A\u0430\u0436\u0434\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518445
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043A\u0430\u0440\u0442\u0443 \u0431\u0435\u0437
      \u043F\u043E\u043C\u043E\u0449\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518446
    m_Localized: "\u041A\u0430\u0440\u0442\u0443 \u0432\u0437\u044F\u043B\u0438.
      \u041A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444 \u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u0432\u0441\u043B\u0435\u0434. \u0422\u0440\u043E\u043F\u0430 \u0432\u0435\u0440\u043D\u0430\u044F
      - \u0432\u0440\u0435\u043C\u044F \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u043B\u0435\u043D\u043E.
      \u041D\u043E \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0432\u0438\u0434\u0435\u043B\u0438,
      \u043A\u0430\u043A \u043E\u0431\u043E\u0437 \u0443\u0435\u0445\u0430\u043B
      \u043E\u0442 \u0431\u043E\u043B\u044C\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518447
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u043C\u043E\u043D\u0430\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518448
    m_Localized: "\u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
      - \u043F\u044F\u0442\u044C \u043C\u043E\u043D\u0430\u0445\u043E\u0432 \u0432
      \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u0432\u044B\u0445 \u0440\u043E\u0431\u0430\u0445
      \u043C\u0435\u0442\u0443\u0442 \u0434\u0432\u043E\u0440 \u0431\u0430\u043C\u0431\u0443\u043A\u043E\u0432\u044B\u043C\u0438
      \u043C\u0451\u0442\u043B\u0430\u043C\u0438. \u0421\u0442\u0430\u0440\u0448\u0438\u0439
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443
      \u0431\u0435\u0437 \u0441\u043B\u043E\u0432\u0430 \u0438 \u0434\u0435\u0440\u0436\u0438\u0442
      \u043F\u0435\u0440\u0435\u0434 \u0441\u043E\u0431\u043E\u0439 \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u0443\u044E
      \u0447\u0430\u0448\u0443 \u0441 \u0433\u043E\u0440\u044F\u0449\u0438\u043C\u0438
      \u0431\u043B\u0430\u0433\u043E\u0432\u043E\u043D\u0438\u044F\u043C\u0438: \u0437\u0430\u043F\u0430\u0445
      \u0441\u0430\u043D\u0434\u0430\u043B\u043E\u0432\u043E\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u0430
      \u043F\u043B\u044B\u0432\u0451\u0442 \u043D\u0430\u0434 \u043F\u044B\u043B\u044C\u044E
      \u0434\u043E\u0440\u043E\u0433\u0438. <npc_speech lang=\"Chinese\">\u041A\u0443\u043F\u0435\u0446
      \u0441 \u0447\u0438\u0441\u0442\u044B\u043C \u0438\u043C\u0435\u043D\u0435\u043C
      - \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044C \u043D\u0430 \u044D\u0442\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0435. \u0411\u0443\u0434\u0434\u0430 \u0432\u0438\u0434\u0438\u0442
      \u0442\u0435\u0445, \u043A\u0442\u043E \u0438\u0434\u0451\u0442 \u0447\u0435\u0441\u0442\u043D\u043E.</npc_speech>
      \u0411\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 - \u0431\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u043E\u0431\u0440\u044F\u0434, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0434\u0430\u044E\u0442 \u043D\u0435 \u043A\u0430\u0436\u0434\u043E\u043C\u0443.
      \u041C\u043E\u043D\u0430\u0445\u0438 \u0441\u043B\u044B\u0448\u0430\u0442 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B
      \u0432\u0441\u0435\u0445 \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518449
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518450
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u0442\u0440\u0438\u0436\u0434\u044B
      \u043E\u0431\u043E\u0448\u0451\u043B \u043E\u0431\u043E\u0437, \u0447\u0438\u0442\u0430\u044F
      \u0442\u0438\u0445\u0438\u043C \u0433\u043E\u043B\u043E\u0441\u043E\u043C.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0441\u043D\u044F\u043B\u0438
      \u0448\u0430\u043F\u043A\u0438. \u0414\u0443\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F - \u043D\u0435 \u0441\u0443\u0435\u0432\u0435\u0440\u0438\u0435,
      \u0430 \u0437\u043D\u0430\u043A \u0442\u043E\u0433\u043E, \u0447\u0442\u043E
      \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C \u0436\u0438\u0432\u0451\u0442
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518451
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E \u0431\u0435\u0437
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518452
    m_Localized: "\u041F\u043E\u043A\u043B\u043E\u043D \u043D\u0430 \u0445\u043E\u0434\u0443
      - \u043C\u043E\u043D\u0430\u0445 \u043F\u0440\u0438\u043D\u044F\u043B. \u0412\u0440\u0435\u043C\u044F
      \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u043E, \u043E\u0431\u0440\u044F\u0434
      \u043F\u0440\u043E\u043F\u0443\u0449\u0435\u043D. \u0414\u0443\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0441\u043B\u0435\u0433\u043A\u0430 \u043F\u0440\u043E\u0441\u0435\u043B -
      \u043D\u0435 \u0432\u0441\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u043E\u043D\u044F\u043B\u0438 \u0441\u043F\u0435\u0448\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518453
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0430
      \u0437\u0430\u043A\u0440\u044B\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518454
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0430
      \u0437\u0430\u043F\u0435\u0440\u0442\u044B \u043F\u0440\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u043C
      \u0440\u044B\u043D\u043A\u0435 \u0432\u043D\u0443\u0442\u0440\u0438. \u0421\u0442\u0430\u0440\u0448\u0438\u0439
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0441\u043A\u0440\u0435\u0449\u0438\u0432\u0430\u0435\u0442
      \u043A\u043E\u043F\u044C\u044F \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0431\u0435\u0437 \u0441\u043F\u0435\u0448\u043A\u0438: <npc_speech lang=\"Chinese\">\u0422\u0432\u043E\u0451
      \u0438\u043C\u044F \u0435\u0441\u0442\u044C \u0432 \u0441\u043F\u0438\u0441\u043A\u0435
      \u043A\u0443\u043F\u0446\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u0446\u0437\u0435\u0434\u0443\u0448\u0438 \u0432\u0435\u043B\u0435\u043B \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C
      \u0434\u0432\u0430\u0436\u0434\u044B. \u041E\u0441\u043E\u0431\u0430\u044F
      \u043F\u043E\u0448\u043B\u0438\u043D\u0430 - \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432. \u0418\u043B\u0438 \u0436\u0434\u0438
      \u0434\u043E \u0437\u0430\u0432\u0442\u0440\u0430.</npc_speech> \u0417\u0430
      \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438 \u0441\u043B\u044B\u0448\u0435\u043D
      \u0431\u0430\u0437\u0430\u0440\u043D\u044B\u0439 \u0433\u043E\u043C\u043E\u043D.
      \u0414\u0440\u0443\u0433\u0438\u0435 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B
      \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0442 \u0440\u044F\u0434\u043E\u043C
      \u0431\u0435\u0437 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438. \u041F\u043B\u043E\u0445\u0430\u044F
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F - \u044D\u0442\u043E
      \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
      \u0434\u0432\u0435\u0440\u0438, \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F
      \u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518455
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518456
    m_Localized: "\u041C\u043E\u043D\u0435\u0442\u044B \u0438\u0441\u0447\u0435\u0437\u043B\u0438
      \u0432 \u043A\u043E\u0448\u0435\u043B\u0435 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430.
      \u0412\u043E\u0440\u043E\u0442\u0430 \u043E\u0442\u043A\u0440\u044B\u043B\u0438\u0441\u044C.
      \u0414\u043E\u0440\u043E\u0433\u043E, \u0437\u0430\u0442\u043E \u0431\u044B\u0441\u0442\u0440\u043E
      - \u0440\u044B\u043D\u043E\u043A \u0435\u0449\u0451 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442.
      \u0414\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0434\u043E\u0441\u043C\u043E\u0442\u0440 \u043D\u0435 \u0434\u043E\u0431\u0430\u0432\u0438\u043B
      \u0440\u0430\u0434\u043E\u0441\u0442\u0438, \u043D\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B
      \u0432\u043E\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518457
    m_Localized: "\u0416\u0434\u0430\u0442\u044C \u0434\u043E \u0437\u0430\u0432\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518458
    m_Localized: "\u041D\u043E\u0447\u044C \u0443 \u0441\u0442\u0435\u043D. \u0420\u044B\u043D\u043E\u043A
      \u0437\u0430\u043A\u0440\u044B\u043B\u0441\u044F \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430
      - \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u043B\u0443\u0447\u0448\u0438\u0435
      \u0447\u0430\u0441\u044B \u0442\u043E\u0440\u0433\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B: \u043E\u043D\u0438
      \u0441\u043B\u044B\u0448\u0430\u043B\u0438, \u043F\u043E\u0447\u0435\u043C\u0443
      \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518459
    m_Localized: "\u041F\u043E\u0434\u043A\u0443\u043F\u0438\u0442\u044C \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430
      \u043C\u0435\u043D\u044C\u0448\u0435\u0439 \u0441\u0443\u043C\u043C\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518460
    m_Localized: "\u041F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432.
      \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0432\u0437\u044F\u043B,
      \u043D\u043E \u043F\u0440\u043E\u0432\u0451\u043B \u0447\u0435\u0440\u0435\u0437
      \u0431\u043E\u043A\u043E\u0432\u0443\u044E \u043A\u0430\u043B\u0438\u0442\u043A\u0443
      \u0441 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u043E\u0439. \u0414\u0435\u0448\u0435\u0432\u043B\u0435
      \u0438 \u0443\u043D\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u0435\u0435
      - \u043E\u0431\u0430 \u0441\u043B\u043E\u0432\u0430 \u0432\u0435\u0440\u043D\u044B
      \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518461
    m_Localized: "\u0414\u043E\u0441\u043C\u043E\u0442\u0440 \u0446\u0437\u0435\u0434\u0443\u0448\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518462
    m_Localized: "\u041F\u044F\u0442\u0435\u0440\u043E \u0441\u043E\u043B\u0434\u0430\u0442
      \u0441 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u043C\u0438 \u043A\u0440\u044E\u043A\u0430\u043C\u0438
      \u0432\u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0442\u044E\u043A\u0438
      \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435.
      \u041E\u0444\u0438\u0446\u0435\u0440 \u0441 \u0431\u0430\u043C\u0431\u0443\u043A\u043E\u0432\u043E\u0439
      \u0434\u043E\u0449\u0435\u0447\u043A\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
      \u043A\u0430\u0436\u0434\u0443\u044E \u0432\u0435\u0449\u044C: <npc_speech
      lang=\"Chinese\">\u041F\u0440\u0438\u043A\u0430\u0437 \u0446\u0437\u0435\u0434\u0443\u0448\u0438.
      \u041A\u0443\u043F\u0446\u044B \u0441 \u043D\u0435\u044F\u0441\u043D\u043E\u0439
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0435\u0439 - \u043F\u043E\u043B\u043D\u044B\u0439
      \u0434\u043E\u0441\u043C\u043E\u0442\u0440. \u041E\u043F\u0438\u0441\u044C
      \u0437\u0430\u0439\u043C\u0451\u0442 \u0432\u0440\u0435\u043C\u044F.</npc_speech>
      \u0421\u043E\u043B\u0434\u0430\u0442\u044B \u043D\u0435 \u0433\u0440\u0443\u0431\u044F\u0442,
      \u043D\u043E \u043C\u0435\u0442\u043E\u0434\u0438\u0447\u043D\u044B. \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0435
      \u0442\u044E\u043A\u0438 \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0442,
      \u0449\u0443\u043F\u0430\u044E\u0442, \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044E\u0442.
      \u041C\u0435\u0434\u043D\u044B\u0435 \u043F\u0435\u0447\u0430\u0442\u0438 \u043D\u0430
      \u043A\u0443\u0432\u0448\u0438\u043D\u0430\u0445 \u0432\u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0442.
      \u0422\u0440\u0438 \u0447\u0430\u0441\u0430 \u043D\u0430 \u0436\u0430\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518463
    m_Localized: "\u0421\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u0442\u044C
      \u0438 \u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518464
    m_Localized: "\u0422\u0440\u0438 \u0447\u0430\u0441\u0430 \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430.
      \u041F\u043E\u0432\u0440\u0435\u0436\u0434\u0451\u043D \u043E\u0434\u0438\u043D
      \u043A\u0443\u0432\u0448\u0438\u043D. \u0428\u0442\u0440\u0430\u0444 \u0437\u0430
      \u043F\u0440\u043E\u0441\u0440\u043E\u0447\u0435\u043D\u043D\u044B\u0439 \u043F\u0443\u0442\u0435\u0432\u043E\u0439
      \u043B\u0438\u0441\u0442 \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0438 \u0441\u0432\u0435\u0440\u0445\u0443.
      \u0417\u0430\u0442\u043E \u043F\u0440\u043E\u0448\u043B\u0438 \u0431\u0435\u0437
      \u043E\u0431\u043E\u0441\u0442\u0440\u0435\u043D\u0438\u0439 - \u043E\u0444\u0438\u0446\u0435\u0440
      \u0432\u043F\u0438\u0441\u0430\u043B \u0432 \u0436\u0443\u0440\u043D\u0430\u043B
      \u0441\u043B\u043E\u0432\u043E \"\u043F\u043E\u0440\u044F\u0434\u043E\u0447\u043D\u044B\u0439\"."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518465
    m_Localized: "\u0414\u0430\u0442\u044C \u0432\u0437\u044F\u0442\u043A\u0443 \u043E\u0444\u0438\u0446\u0435\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518466
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043F\u044F\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0437\u0430 \u0441\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u0435
      \u0441\u043F\u0438\u0441\u043A\u0430 \u0434\u043E \u0442\u0440\u0451\u0445
      \u0442\u044E\u043A\u043E\u0432. \u041E\u0444\u0438\u0446\u0435\u0440 \u0432\u0437\u044F\u043B
      \u043D\u0435 \u0442\u043E\u0440\u0433\u0443\u044F\u0441\u044C. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u043F\u043B\u0430\u0442\u0438\u0442
      \u0447\u0442\u043E\u0431\u044B \u0441\u043A\u0440\u044B\u0442\u044C - \u0445\u0443\u0436\u0435,
      \u0447\u0435\u043C \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0447\u0435\u0441\u0442\u043D\u043E\u0433\u043E
      \u0431\u0435\u0434\u043D\u044F\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518467
    m_Localized: "\u0417\u0430\u0432\u044B\u0448\u0435\u043D\u043D\u044B\u0435 \u0446\u0435\u043D\u044B
      \u043D\u0430 \u0440\u044B\u043D\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518468
    m_Localized: "\u0411\u0430\u0437\u0430\u0440\u043D\u044B\u0439 \u0440\u044F\u0434
      \u0432 \u0411\u0430\u043B\u0445\u0435. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0441\u043F\u0435\u0446\u0438\u044F\u043C\u0438 - \u043F\u0430\u043B\u044C\u0446\u044B
      \u0436\u0451\u043B\u0442\u044B\u0435 \u043E\u0442 \u043A\u0443\u0440\u043A\u0443\u043C\u044B
      - \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0446\u0435\u043D\u0443
      \u0432\u0442\u0440\u043E\u0435 \u0432\u044B\u0448\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0439
      \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043F\u0440\u044F\u043C\u043E:
      <npc_speech lang=\"Persian\">\u042F \u0441\u043B\u044B\u0448\u0430\u043B \u043E
      \u0442\u0432\u043E\u0438\u0445 \u0434\u0435\u043B\u0430\u0445 \u0432 \u043F\u0440\u043E\u0448\u043B\u044B\u0439
      \u0440\u0430\u0437. \u0422\u0430\u043A\u043E\u043C\u0443 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044E
      - \u0442\u0430\u043A\u0430\u044F \u0446\u0435\u043D\u0430. \u041D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
      - \u0438\u0434\u0438 \u043A \u0434\u0440\u0443\u0433\u043E\u043C\u0443.</npc_speech>
      \u0414\u0440\u0443\u0433\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0440\u044F\u0434\u043E\u043C \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043F\u043E\u0434\u043E\u0439\u0442\u0438.
      \u041F\u043B\u043E\u0445\u043E\u0435 \u0438\u043C\u044F \u043D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435
      - \u044D\u0442\u043E \u043D\u0430\u043B\u043E\u0433, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043F\u043B\u0430\u0442\u0438\u0448\u044C \u043A\u0430\u0436\u0434\u044B\u0439
      \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518469
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0437\u0430\u0432\u044B\u0448\u0435\u043D\u043D\u0443\u044E
      \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518470
    m_Localized: "\u041F\u0435\u0440\u0435\u043F\u043B\u0430\u0442\u0430 \u0437\u0430
      \u0441\u043F\u0435\u0446\u0438\u0438. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u043F\u0440\u043E\u0432\u0451\u043B \u0441\u0434\u0435\u043B\u043A\u0443 \u043C\u043E\u043B\u0447\u0430.
      \u0425\u043E\u0442\u044F \u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438
      \u0442\u043E\u0432\u0430\u0440 \u0431\u0435\u0437 \u0441\u043A\u0430\u043D\u0434\u0430\u043B\u0430
      - \u043D\u0430\u0432\u044B\u043A \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438
      \u0440\u0430\u0441\u0442\u0451\u0442 \u043E\u0442 \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518471
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518472
    m_Localized: "\u0421\u0442\u043E\u0440\u0433\u043E\u0432\u0430\u043B\u0438\u0441\u044C
      \u0434\u043E \u0434\u0432\u043E\u0439\u043D\u043E\u0439 \u0446\u0435\u043D\u044B.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0441\u044F
      \u0441 \u044F\u0432\u043D\u044B\u043C \u043D\u0435\u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435\u043C.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0438 \u0434\u0435\u043D\u044C\u0433\u0438,
      \u0438 \u0434\u043E\u0431\u0440\u043E\u0435 \u0441\u043B\u043E\u0432\u043E
      - \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430
      \u0435\u0449\u0451 \u043E\u0434\u043D\u0443 \u0437\u0430\u0440\u0443\u0431\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518473
    m_Localized: "\u0423\u0439\u0442\u0438 \u043A \u0434\u0440\u0443\u0433\u043E\u043C\u0443
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518474
    m_Localized: "\u0414\u0440\u0443\u0433\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0442\u043E\u0436\u0435 \u043D\u0430\u0437\u0432\u0430\u043B \u0446\u0435\u043D\u0443
      \u0432\u044B\u0448\u0435 \u043D\u043E\u0440\u043C\u044B - \u0441\u043B\u0443\u0445
      \u0440\u0430\u0441\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0431\u044B\u0441\u0442\u0440\u043E.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0432\u0440\u0435\u043C\u044F,
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u0442\u0435 \u0436\u0435
      \u0443\u0441\u043B\u043E\u0432\u0438\u044F. \u041E\u0434\u0438\u043D \u0434\u0435\u043D\u044C
      \u0434\u043B\u044F \u043F\u043E\u0438\u0441\u043A\u0430 \u0442\u043E\u0432\u0430\u0440\u0430
      \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518475
    m_Localized: "\u041F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0439 \u0434\u0432\u043E\u0440
      \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518476
    m_Localized: "\u041F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0439 \u0434\u0432\u043E\u0440
      \u0432 \u041C\u0435\u0440\u0432\u0435 - \u0437\u0430\u043F\u0430\u0445 \u0436\u0430\u0440\u0435\u043D\u043E\u0433\u043E
      \u044F\u0433\u043D\u0451\u043D\u043A\u0430 \u0438 \u043A\u0443\u043D\u0436\u0443\u0442\u043D\u043E\u0433\u043E
      \u043C\u0430\u0441\u043B\u0430 \u0438\u0437 \u043A\u0443\u0445\u043D\u0438.
      \u0425\u043E\u0437\u044F\u0438\u043D \u0421\u0430\u043C\u0435\u0445 \u0441\u0442\u043E\u0438\u0442
      \u0432 \u0434\u0432\u0435\u0440\u044F\u0445 \u0438 \u043D\u0435 \u043E\u0442\u0445\u043E\u0434\u0438\u0442
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443: <npc_speech lang=\"Persian\">\u041C\u0435\u0441\u0442
      \u043D\u0435\u0442. \u0414\u043B\u044F \u0442\u0435\u0431\u044F \u043D\u0435\u0442.
      \u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
      \u043D\u0430 \u043F\u0440\u043E\u0448\u043B\u043E\u043C \u043E\u0431\u043E\u0437\u0435
      - \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442.</npc_speech>
      \u0417\u0430 \u043D\u0438\u043C \u0432\u0438\u0434\u043D\u0435\u044E\u0442\u0441\u044F
      \u043F\u0443\u0441\u0442\u044B\u0435 \u043A\u043E\u043C\u043D\u0430\u0442\u044B.
      \u041E\u043D \u043D\u0435 \u043B\u0436\u0451\u0442 \u043E \u043C\u0435\u0441\u0442\u0430\u0445
      - \u043E\u043D \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442, \u043A\u043E\u043C\u0443
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u0434\u0432\u0435\u0440\u044C.
      \u041D\u043E\u0447\u0435\u0432\u0430\u0442\u044C \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u0432 \u043F\u043E\u043B\u0435 \u0438\u043B\u0438 \u0438\u0441\u043A\u0430\u0442\u044C
      \u0434\u0440\u0443\u0433\u043E\u0435 \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518477
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u043D\u043E\u0447\u043B\u0435\u0433
      \u0432 \u043F\u043E\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518478
    m_Localized: "\u041D\u043E\u0447\u044C \u0443 \u0434\u043E\u0440\u043E\u0433\u0438.
      \u041A\u043E\u0441\u0442\u0451\u0440, \u043E\u0445\u0440\u0430\u043D\u0430
      \u0432 \u0434\u0432\u0435 \u0441\u043C\u0435\u043D\u044B. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u043E\u043D\u044F\u043B\u0438 \u043F\u043E\u0447\u0435\u043C\u0443 -
      \u0438 \u0441\u043F\u0430\u043B\u0438 \u043F\u043B\u043E\u0445\u043E. \u041F\u043E\u0442\u0435\u0440\u044F
      \u0434\u043D\u044F \u0432\u044B\u0445\u043E\u0434\u0430: \u0443\u0442\u0440\u043E\u043C
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518479
    m_Localized: "\u0414\u0430\u0442\u044C \u0432\u0437\u044F\u0442\u043A\u0443 \u0445\u043E\u0437\u044F\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518480
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043E\u0442\u043A\u0440\u044B\u043B\u0438 \u0434\u0432\u0435\u0440\u044C.
      \u0421\u0430\u043C\u0435\u0445 \u0432\u0437\u044F\u043B \u0431\u0435\u0437
      \u0443\u043B\u044B\u0431\u043A\u0438. \u041F\u0435\u0440\u0435\u043D\u043E\u0447\u0435\u0432\u0430\u043B\u0438,
      \u043D\u043E \u0432\u0435\u0441\u044C \u0434\u0432\u043E\u0440 \u0437\u043D\u0430\u043B,
      \u043A\u0430\u043A \u043F\u0440\u043E\u0448\u043B\u0430 \u0441\u0434\u0435\u043B\u043A\u0430.
      \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0432\u044B\u0440\u043E\u0441\u043B\u0430 - \u0441\u043B\u0443\u0445\u0438
      \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0442\u0430\u043A\u0438\u0445 \u0445\u043E\u0437\u044F\u0435\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518481
    m_Localized: "\u041B\u043E\u0436\u043D\u043E\u0435 \u043E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518482
    m_Localized: "\u0423 \u043A\u043E\u043B\u043E\u0434\u0446\u0430 \u043D\u0430
      \u043F\u0440\u0438\u0432\u0430\u043B\u0435 \u043A\u0443\u043F\u0435\u0446 \u0438\u0437
      \u0410\u043D\u0442\u0438\u043E\u0445\u0438\u0438 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0437\u0430 \u0440\u0443\u043A\u0430\u0432 \u043F\u0435\u0440\u0435\u0434
      \u0432\u0441\u0435\u043C\u0438: <npc_speech lang=\"Persian\">\u041C\u043E\u0439
      \u043A\u043E\u0448\u0435\u043B\u044C \u0441 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C\u044E
      \u0434\u0438\u0440\u0445\u0430\u043C\u0430\u043C\u0438 \u043F\u0440\u043E\u043F\u0430\u043B.
      \u0422\u044B \u0441\u0442\u043E\u044F\u043B \u0440\u044F\u0434\u043E\u043C
      - \u0432\u0441\u0435 \u0432\u0438\u0434\u0435\u043B\u0438.</npc_speech> \u0412\u043E\u043A\u0440\u0443\u0433
      \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0442\u0441\u044F \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438,
      \u043F\u0435\u0440\u0435\u043A\u0443\u043F\u0449\u0438\u043A\u0438, \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u043F\u043E\u0441\u0442\u0430 - \u0432\u0441\u0435 \u0441\u043C\u043E\u0442\u0440\u044F\u0442.
      \u041A\u043E\u0448\u0435\u043B\u044C \u043F\u0440\u043E\u043F\u0430\u043B \u043D\u0430
      \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435. \u041E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u0435
      \u043B\u043E\u0436\u043D\u043E\u0435 - \u043D\u043E \u043A\u0442\u043E \u044D\u0442\u043E
      \u0437\u043D\u0430\u0435\u0442? \u041F\u0440\u0438 \u043D\u0438\u0437\u043A\u043E\u0439
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438 \u043B\u044E\u0431\u043E\u0435
      \u043E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u0435 \u0437\u0432\u0443\u0447\u0438\u0442
      \u043F\u0440\u0430\u0432\u0434\u043E\u043F\u043E\u0434\u043E\u0431\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518483
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C - \u043B\u0438\u0448\u044C
      \u0431\u044B \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518484
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0437\u0430\u0442\u043A\u043D\u0443\u043B\u0438 \u043E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u0435.
      \u0410\u043D\u0442\u0438\u043E\u0445\u0438\u0435\u0446 \u043A\u0438\u0432\u043D\u0443\u043B
      \u0438 \u0443\u0448\u0451\u043B - \u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0451\u043D.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0432\u0438\u0434\u0435\u043B\u0438:
      \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C \u043F\u043B\u0430\u0442\u0438\u0442
      \u043F\u043E \u043F\u0435\u0440\u0432\u043E\u043C\u0443 \u0441\u043B\u043E\u0432\u0443.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044C
      \u043D\u0438\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518485
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u0438 \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518486
    m_Localized: "\u041E\u0431\u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C \u043A\u0440\u0438\u0447\u0430\u043B
      \u0432\u0441\u043B\u0435\u0434. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u0437\u0430\u043F\u0438\u0441\u0430\u043B \u0438\u043C\u044F. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0432\u0440\u0435\u043C\u044F \u0438 \u043D\u0435\u0440\u0432\u044B - \u043D\u043E
      \u043D\u0435 \u0434\u0435\u043D\u044C\u0433\u0438. \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u0432\u044B\u0440\u043E\u0441\u043B\u0430: \u0441\u0442\u0440\u0430\u0436\u0438
      \u043F\u043E\u0441\u0442\u0430 \u0442\u0435\u043F\u0435\u0440\u044C \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518487
    m_Localized: "\u041F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518488
    m_Localized: "\u041D\u0430\u0448\u043B\u0438 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E
      \u0432\u043E\u0440\u0430 - \u043C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u0430-\u043F\u043E\u043F\u0440\u043E\u0448\u0430\u0439\u043A\u0430.
      \u0410\u043D\u0442\u0438\u043E\u0445\u0438\u0435\u0446 \u0438\u0437\u0432\u0438\u043D\u0438\u043B\u0441\u044F
      \u0441\u0443\u0445\u043E. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u0432\u044B\u0447\u0435\u0440\u043A\u043D\u0443\u043B \u0438\u043C\u044F \u0438\u0437
      \u0441\u043F\u0438\u0441\u043A\u0430. \u0414\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043D\u0430\u0432\u044B\u043A \u0440\u0430\u0441\u0442\u0451\u0442 \u0442\u0430\u043C,
      \u0433\u0434\u0435 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u043F\u0430\u0434\u0430\u0435\u0442
      - \u0443\u0447\u0438\u0448\u044C\u0441\u044F \u0434\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
      \u043F\u0440\u0430\u0432\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518489
    m_Localized: "\u0410\u0433\u0435\u043D\u0442 \u0433\u0438\u043B\u044C\u0434\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518490
    m_Localized: "\u041D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435 \u0432 \u041A\u0430\u0448\u0433\u0430\u0440\u0435
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432 \u043E\u0431\u044B\u0447\u043D\u043E\u043C
      \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u043E\u043C \u0445\u0430\u043B\u0430\u0442\u0435
      \u0445\u043E\u0434\u0438\u0442 \u0437\u0430 \u0432\u0430\u043C\u0438 \u0442\u0440\u0438
      \u0447\u0430\u0441\u0430. \u041A\u043E\u0433\u0434\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0448\u044C
      - \u043E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0442\u0438\u0445\u043E: <npc_speech lang=\"Sogdian\">\u042D\u0442\u043E \u0430\u0433\u0435\u043D\u0442
      \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0439 \u0433\u0438\u043B\u044C\u0434\u0438\u0438.
      \u041E\u043D\u0438 \u0441\u043B\u0435\u0434\u044F\u0442 \u0437\u0430 \u043A\u0443\u043F\u0446\u0430\u043C\u0438
      \u0441 \u043F\u043B\u043E\u0445\u043E\u0439 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0435\u0439
      - \u0447\u0442\u043E\u0431\u044B \u0437\u043D\u0430\u0442\u044C, \u043A\u0443\u0434\u0430
      \u0442\u0435 \u0432\u0435\u0437\u0443\u0442 \u0442\u043E\u0432\u0430\u0440
      \u0438 \u043A\u043E\u043C\u0443 \u043F\u0440\u043E\u0434\u0430\u044E\u0442.</npc_speech>
      \u0413\u0438\u043B\u044C\u0434\u0438\u044F \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0445
      \u043A\u0443\u043F\u0446\u043E\u0432 \u0434\u0435\u0440\u0436\u0438\u0442 \u0441\u0435\u0442\u044C
      \u043E\u0441\u0432\u0435\u0434\u043E\u043C\u0438\u0442\u0435\u043B\u0435\u0439
      \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C\u0443
      \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518491
    m_Localized: "\u0418\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0438 \u0432\u0435\u0441\u0442\u0438 \u0434\u0435\u043B\u0430 \u043A\u0430\u043A
      \u043E\u0431\u044B\u0447\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518492
    m_Localized: "\u0410\u0433\u0435\u043D\u0442 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u043B
      \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C. \u0421\u0434\u0435\u043B\u043A\u0438
      \u043F\u0440\u043E\u0448\u043B\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u043E
      - \u043D\u0435\u0447\u0435\u0433\u043E \u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C.
      \u0425\u043E\u0442\u044F \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430
      \u0434\u0430\u0432\u0438\u043B\u0430, \u043F\u043E\u043F\u044B\u0442\u043A\u0438
      \u043F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0431\u044B \u0445\u0443\u0436\u0435. \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0432\u044B\u0440\u043E\u0441\u043B\u0430
      - \u0433\u0438\u043B\u044C\u0434\u0438\u044F \u0447\u0438\u0442\u0430\u0435\u0442
      \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518493
    m_Localized: "\u041F\u043E\u0434\u043A\u0443\u043F\u0438\u0442\u044C \u0430\u0433\u0435\u043D\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518494
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432.
      \u0410\u0433\u0435\u043D\u0442 \u0432\u0437\u044F\u043B \u0438 \u0443\u0448\u0451\u043B.
      \u041D\u043E \u0433\u0438\u043B\u044C\u0434\u0438\u044F \u0437\u043D\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0432\u044B \u043F\u043B\u0430\u0442\u0438\u0442\u0435
      \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u0435\u043B\u044F\u043C -
      \u044D\u0442\u043E \u0441\u0430\u043C\u043E \u043F\u043E \u0441\u0435\u0431\u0435
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0443\u043F\u0430\u043B\u0430 \u0435\u0449\u0451 \u043D\u0430 \u043E\u0434\u043D\u0443
      \u0441\u0442\u0443\u043F\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518495
    m_Localized: "\u0421\u043C\u0435\u043B\u044B\u0439 \u043D\u0430\u043B\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518496
    m_Localized: "\u0412\u043E\u0441\u0435\u043C\u044C \u043A\u043E\u043D\u043D\u044B\u0445
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u044E\u0442
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0443 \u0443\u0449\u0435\u043B\u044C\u044F.
      \u0418\u0445 \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
      \u043A\u0440\u0438\u0447\u0438\u0442 \u0447\u0435\u0440\u0435\u0437 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E:
      <npc_speech lang=\"Turkic\">\u0421\u043B\u044B\u0448\u0430\u043B\u0438 - \u043E\u0445\u0440\u0430\u043D\u044B
      \u043C\u0430\u043B\u043E. \u0412\u0435\u0437\u0451\u0442 \u0442\u043E\u0442,
      \u043A\u0442\u043E \u043D\u0435 \u0436\u0430\u0434\u043D\u0438\u0447\u0430\u0435\u0442
      \u0441 \u0432\u044B\u043A\u0443\u043F\u043E\u043C.</npc_speech> \u041F\u0440\u0438
      \u0438\u043D\u043E\u0439 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438 \u0434\u0432\u0430\u0436\u0434\u044B
      \u043F\u043E\u0434\u0443\u043C\u0430\u043B\u0438 \u0431\u044B. \u0421\u0435\u0439\u0447\u0430\u0441
      \u043E\u043D\u0438 \u0437\u043D\u0430\u044E\u0442: \u0443 \u044D\u0442\u043E\u0433\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0441\u043B\u0430\u0431\u0430\u044F
      \u0437\u0430\u0449\u0438\u0442\u0430, \u0445\u043E\u0437\u044F\u0438\u043D
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u043D\u044F\u0442\u044C
      \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u044B\u0445 \u0432\u043E\u0438\u043D\u043E\u0432.
      \u0410\u0442\u0430\u043A\u0443\u044E\u0442 \u0441 \u0442\u0440\u0435\u043C\u044F
      \u043F\u0443\u0442\u044F\u043C\u0438 \u0432\u044B\u0445\u043E\u0434\u0430 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0442\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518497
    m_Localized: "\u0421\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518498
    m_Localized: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u0431\u043E\u0439.
      \u0414\u0432\u043E\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0440\u0430\u043D\u0435\u043D\u044B, \u0442\u0435\u043B\u0435\u0433\u0430
      \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0430, \u0437\u0430\u043F\u0430\u0441\u044B
      \u0435\u0434\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B. \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438, \u043D\u043E \u0432\u0437\u044F\u043B\u0438
      \u0441\u0432\u043E\u0451 - \u043F\u043B\u043E\u0445\u0430\u044F \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u043E\u0431\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043A\u0440\u043E\u0432\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518499
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0432\u044B\u043A\u0443\u043F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518500
    m_Localized: "\u0421\u043E\u0440\u043E\u043A \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432.
      \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438.
      \u0421\u043B\u0443\u0445 \u043E \u043B\u0451\u0433\u043A\u043E\u0439 \u0434\u043E\u0431\u044B\u0447\u0435
      \u0440\u0430\u0437\u043E\u0439\u0434\u0451\u0442\u0441\u044F - \u043D\u0430
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u043F\u0435\u0440\u0435\u0433\u043E\u043D\u0435
      \u043C\u043E\u0433\u0443\u0442 \u043D\u0430\u043F\u0430\u0441\u0442\u044C \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518501
    m_Localized: "\u041E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u0438 \u043E\u0431\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518502
    m_Localized: "\u041E\u0431\u0445\u043E\u0434 \u0437\u0430\u043D\u044F\u043B \u0434\u0432\u0430
      \u0434\u043D\u044F. \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u0441\u043D\u0438\u0437\u0438\u043B\u0430\u0441\u044C, \u043D\u043E \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u043E\u0431\u043E\u0437\u0430 \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0430
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518503
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u0434\u0432\u043E\u0439\u043D\u0443\u044E \u043F\u043B\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518504
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u042E\u0441\u0443\u0444
      - \u0437\u043D\u0430\u0435\u0442 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u044B
      \u041F\u0430\u043C\u0438\u0440\u0430 \u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C
      \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u043A\u0430\u0440\u043C\u0430\u043D\u044B
      - \u0441\u0442\u043E\u0438\u0442 \u0443 \u0432\u043E\u0440\u043E\u0442 \u0441
      \u043F\u043E\u0441\u043E\u0445\u043E\u043C \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u044E\u0449\u0435: <npc_speech lang=\"Persian\">\u042F
      \u0441\u043B\u044B\u0448\u0430\u043B \u043E \u0442\u0432\u043E\u0451\u043C
      \u043F\u0440\u043E\u0448\u043B\u043E\u043C \u043E\u0431\u043E\u0437\u0435.
      \u041E\u0431\u044B\u0447\u043D\u0430\u044F \u043F\u043B\u0430\u0442\u0430 -
      \u0434\u043B\u044F \u043E\u0431\u044B\u0447\u043D\u044B\u0445 \u043A\u0443\u043F\u0446\u043E\u0432.
      \u0421 \u0442\u0435\u0431\u044F \u0432\u0434\u0432\u043E\u0435, \u0438\u043B\u0438
      \u0438\u0434\u0438 \u0441\u0430\u043C.</npc_speech> \u0411\u0435\u0437 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430
      \u0447\u0435\u0440\u0435\u0437 \u041F\u0430\u043C\u0438\u0440 - \u0442\u0440\u0451\u0445\u0434\u043D\u0435\u0432\u043D\u044B\u0439
      \u0440\u0438\u0441\u043A \u0437\u0430\u0431\u043B\u0443\u0434\u0438\u0442\u044C\u0441\u044F.
      \u0421 \u043F\u043B\u043E\u0445\u0438\u043C \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u043C
      - \u0445\u0443\u0436\u0435. \u042E\u0441\u0443\u0444 \u0447\u0435\u0441\u0442\u0435\u043D
      \u0432 \u043E\u0434\u043D\u043E\u043C: \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0446\u0435\u043D\u0443 \u043F\u0440\u044F\u043C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518505
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0434\u0432\u043E\u0439\u043D\u0443\u044E
      \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518506
    m_Localized: "\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0432\u043C\u0435\u0441\u0442\u043E \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u0438.
      \u042E\u0441\u0443\u0444 \u0432\u0437\u044F\u043B, \u043F\u0440\u0438\u0432\u0451\u043B
      \u0447\u0435\u0440\u0435\u0437 \u043F\u0435\u0440\u0435\u0432\u0430\u043B \u0442\u043E\u0447\u043D\u043E.
      \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0441\u043D\u0438\u0437\u0438\u043B\u0430\u0441\u044C
      - \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0441\u0432\u043E\u0451
      \u0434\u0435\u043B\u043E \u0437\u043D\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518507
    m_Localized: "\u0418\u0434\u0442\u0438 \u0431\u0435\u0437 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518508
    m_Localized: "\u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0434\u0432\u0430
      \u0434\u043D\u044F \u043D\u0430 \u043D\u0435\u0432\u0435\u0440\u043D\u043E\u043C
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435. \u0412\u044B\u0448\u043B\u0438
      \u0432\u0441\u0451 \u0436\u0435 - \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C,
      \u043D\u043E \u043F\u043E\u0437\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518509
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518510
    m_Localized: "\u0421\u043E\u0448\u043B\u0438\u0441\u044C \u043D\u0430 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438
      \u0434\u0438\u0440\u0445\u0430\u043C\u0430\u0445. \u042E\u0441\u0443\u0444
      \u043F\u0440\u043E\u0432\u0451\u043B \u0441 \u044F\u0432\u043D\u044B\u043C
      \u043D\u0435\u0436\u0435\u043B\u0430\u043D\u0438\u0435\u043C - \u043F\u043E
      \u0432\u0435\u0440\u043D\u043E\u0439 \u0442\u0440\u043E\u043F\u0435, \u043D\u043E
      \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445 \u0441\u043B\u043E\u0432.
      \u041D\u0430\u0432\u044B\u043A \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0432\u044B\u0440\u043E\u0441 \u043E\u0442
      \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F \u0437\u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518511
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0445\u043E\u0442\u044F\u0442
      \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518512
    m_Localized: "\u0423 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u0433\u043E \u043A\u043E\u0441\u0442\u0440\u0430
      \u0434\u0432\u043E\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      - \u0412\u0430\u0440\u0433\u0430 \u0438 \u043C\u043E\u043B\u043E\u0434\u043E\u0439
      \u0443\u0439\u0433\u0443\u0440 - \u0441\u0438\u0434\u044F\u0442 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E
      \u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0442 \u0442\u0438\u0445\u043E.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0438 \u043D\u0435 \u043F\u0440\u044F\u0447\u0435\u0442
      \u0441\u043B\u043E\u0432: <npc_speech lang=\"Sogdian\">\u041B\u044E\u0434\u0438
      \u0433\u043E\u0432\u043E\u0440\u044F\u0442 - \u0441 \u0442\u0430\u043A\u0438\u043C
      \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u0435\u043C \u0443\u0434\u0430\u0447\u0430
      \u043D\u0435 \u0445\u043E\u0434\u0438\u0442. \u0412\u0430\u0440\u0433\u0430
      \u0445\u043E\u0447\u0435\u0442 \u0443\u0439\u0442\u0438 \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435.
      \u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u0442\u043E\u0436\u0435 \u0434\u0443\u043C\u0430\u0435\u0442.
      \u0422\u044B \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0441\u043A\u0430\u0436\u0435\u0448\u044C
      \u0438\u043C?</npc_speech> \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044F - \u044D\u0442\u043E
      \u0441\u0443\u0434\u044C\u0431\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0432 \u0433\u043B\u0430\u0437\u0430\u0445 \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u043E\u0432.
      \u041A\u0442\u043E \u0445\u043E\u0447\u0435\u0442 \u0441\u043B\u0443\u0436\u0438\u0442\u044C
      \u0442\u043E\u043C\u0443, \u043E \u043A\u043E\u043C \u043F\u043B\u043E\u0445\u043E
      \u0433\u043E\u0432\u043E\u0440\u044F\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518513
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0438
      \u043F\u043E\u0432\u044B\u0441\u0438\u0442\u044C \u043E\u043F\u043B\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518514
    m_Localized: "\u041F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043F\u0440\u0438\u0431\u0430\u0432\u043A\u0438. \u0412\u0430\u0440\u0433\u0430
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F. \u041C\u043E\u043B\u043E\u0434\u043E\u0439
      \u0442\u043E\u0436\u0435. \u0414\u0443\u0445 \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F
      - \u043D\u0435 \u043E\u0442 \u0441\u043B\u043E\u0432, \u043E\u0442 \u0441\u0435\u0440\u0435\u0431\u0440\u0430.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0432\u044B\u0440\u043E\u0432\u043D\u044F\u043B\u0430\u0441\u044C: \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C
      \u0443\u043C\u0435\u0435\u0442 \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043B\u044E\u0434\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518515
    m_Localized: "\u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0434\u0435\u043B\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518516
    m_Localized: "\u0412\u0430\u0440\u0433\u0430 \u0443\u0448\u0451\u043B \u0432
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435. \u041C\u043E\u043B\u043E\u0434\u043E\u0439
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F, \u043D\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u043B
      \u043C\u0440\u0430\u0447\u043D\u043E. \u0414\u0443\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0441\u044F \u043D\u0438\u0436\u0435
      - \u0438 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0432\u044B\u0440\u043E\u0441\u043B\u0430:
      \u043C\u0435\u043D\u044C\u0448\u0435 \u043B\u044E\u0434\u0435\u0439, \u0445\u0443\u0436\u0435
      \u043E\u0445\u0440\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518517
    m_Localized: "\u041F\u043E\u0434\u0441\u0442\u0430\u0432\u043D\u0430\u044F \u0441\u0434\u0435\u043B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518518
    m_Localized: "\u041D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439 \u043A\u0443\u043F\u0435\u0446
      \u0432 \u0424\u0435\u0440\u0433\u0430\u043D\u0441\u043A\u043E\u0439 \u0434\u043E\u043B\u0438\u043D\u0435
      \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u043F\u0430\u0440\u0442\u0438\u044E
      \u043B\u0430\u0437\u0443\u0440\u0438\u0442\u0430 \u043F\u043E \u0441\u043C\u0435\u0448\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435 - \u0432\u0434\u0432\u043E\u0435 \u043D\u0438\u0436\u0435
      \u0440\u044B\u043D\u043A\u0430. \u0413\u043E\u0432\u043E\u0440\u0438\u0442
      \u0431\u044B\u0441\u0442\u0440\u043E, \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443: <npc_speech lang=\"Persian\">\u0421\u0440\u043E\u0447\u043D\u043E.
      \u041D\u0443\u0436\u043D\u044B \u0434\u0435\u043D\u044C\u0433\u0438. \u0417\u0430\u0431\u0435\u0440\u0438
      \u0441\u0435\u0439\u0447\u0430\u0441, \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0448\u044C
      \u043F\u043E\u0442\u043E\u043C.</npc_speech> \u041B\u0430\u0437\u0443\u0440\u0438\u0442
      \u0443 \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0440\u044F\u0434\u043E\u043C
      \u043D\u0435\u0442. \u0422\u043E\u0440\u0433\u043E\u0432\u043B\u044F \u0431\u0435\u0437
      \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430 \u0442\u043E\u0432\u0430\u0440\u0430
      - \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u043B\u043E\u0432\u0443\u0448\u043A\u0430 \u0434\u043B\u044F \u0442\u0435\u0445,
      \u0443 \u043A\u043E\u0433\u043E \u043D\u0435\u0442 \u0441\u0432\u044F\u0437\u0435\u0439
      \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u0441\u043B\u0443\u0445\u043E\u0432.
      \u041F\u0440\u0438 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0439
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438 \u044D\u0442\u043E\u0442
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043D\u0435 \u043F\u043E\u0434\u043E\u0448\u0451\u043B
      \u0431\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518519
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u043D\u0435 \u0433\u043B\u044F\u0434\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518520
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0438\u0441\u0447\u0435\u0437.
      \u0422\u043E\u0432\u0430\u0440 - \u043A\u0440\u0430\u0448\u0435\u043D\u044B\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C, \u043D\u0435 \u043B\u0430\u0437\u0443\u0440\u0438\u0442.
      \u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0443\u043F\u0430\u043B\u0430 \u0435\u0449\u0451 \u043D\u0438\u0436\u0435
      - \u0441\u0442\u0430\u043B\u0438 \u0436\u0435\u0440\u0442\u0432\u043E\u0439
      \u0442\u043E\u0433\u043E, \u043E\u0442 \u0447\u0435\u0433\u043E \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u044E\u0442
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435 \u0433\u0438\u043B\u044C\u0434\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518521
    m_Localized: "\u041F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
      \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518522
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0441\u0442\u0430\u043B \u0437\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u0442\u044C,
      \u043F\u043E\u0442\u043E\u043C \u0438\u0441\u0447\u0435\u0437. \u0421\u0434\u0435\u043B\u043A\u0438
      \u043D\u0435 \u0431\u044B\u043B\u043E. \u0414\u0435\u043D\u044C\u0433\u0438
      \u0446\u0435\u043B\u044B, \u043D\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0432\u0440\u0435\u043C\u044F \u043D\u0430 \u043F\u0443\u0441\u0442\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518523
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u043D\u0430\u044F \u0441\u0434\u0435\u043B\u043A\u0430
      \u043C\u043E\u043D\u0430\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518524
    m_Localized: "\u0411\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u043C\u043E\u043D\u0430\u0445
      \u0443 \u0434\u043E\u0440\u043E\u0433\u0438 - \u043B\u044B\u0441\u044B\u0439,
      \u0432 \u0437\u0430\u043F\u043B\u0430\u0442\u0430\u043D\u043D\u043E\u0439 \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u0432\u043E\u0439
      \u0440\u043E\u0431\u0435 - \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u043E\u0431\u043E\u0437 \u0431\u0435\u0437 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u044F,
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u0431\u043B\u0438\u0436\u0435: <npc_speech lang=\"Chinese\">\u0422\u044B \u0435\u0434\u0435\u0448\u044C
      \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A. \u042F \u0442\u043E\u0436\u0435.
      \u0422\u0440\u0438 \u043D\u043E\u0447\u0438 \u043C\u043E\u043B\u0438\u0442\u0432\u044B
      \u0437\u0430 \u0433\u0440\u0443\u0437 \u0432\u0430\u0448\u0435\u0433\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430. \u0412\u0437\u0430\u043C\u0435\u043D
      - \u043D\u043E\u0447\u043B\u0435\u0433 \u0438 \u0435\u0434\u0430. \u041C\u043E\u043D\u0430\u0445
      \u043D\u0435 \u0431\u0435\u0440\u0451\u0442 \u0434\u0435\u043D\u044C\u0433\u0438.</npc_speech>
      \u041C\u043E\u043B\u0438\u0442\u0432\u0430 - \u043D\u0435\u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u043E\u0435,
      \u043D\u043E\u0447\u043B\u0435\u0433 - \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439
      \u0440\u0430\u0441\u0445\u043E\u0434. \u041D\u043E \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0441\u0443\u0435\u0432\u0435\u0440\u043D\u044B: \u043C\u043E\u043D\u0430\u0445
      \u0432 \u043E\u0431\u043E\u0437\u0435 \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442
      \u0434\u0443\u0445. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0441\u0440\u0435\u0434\u043D\u044F\u044F - \u043C\u043E\u043D\u0430\u0445
      \u043D\u0435 \u0443\u0432\u0435\u0440\u0435\u043D, \u0441\u0442\u043E\u0438\u0442
      \u043B\u0438 \u0434\u043E\u0432\u0435\u0440\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518525
    m_Localized: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0443\u0441\u043B\u043E\u0432\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518526
    m_Localized: "\u0422\u0440\u0438 \u043D\u043E\u0447\u0438 \u043C\u043E\u043D\u0430\u0445
      \u0447\u0438\u0442\u0430\u043B \u0441\u0443\u0442\u0440\u044B \u0443 \u043A\u043E\u0441\u0442\u0440\u0430.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0441\u043B\u0443\u0448\u0430\u043B\u0438
      - \u043A\u0442\u043E \u0441 \u0432\u0435\u0440\u043E\u0439, \u043A\u0442\u043E
      \u0438\u0437 \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0438.
      \u0414\u0443\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F,
      \u0430 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0441\u043D\u0438\u0437\u0438\u043B\u0430\u0441\u044C:
      \u043D\u0430 \u043F\u043E\u0441\u0442\u0443 \u0446\u0437\u0435\u0434\u0443\u0448\u0438
      \u0441 \u043C\u043E\u043D\u0430\u0445\u043E\u043C \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u0434\u043E\u0431\u0440\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518527
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C
      \u0434\u0435\u043D\u044C\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518528
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u043F\u043E\u043A\u0430\u0447\u0430\u043B
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u043D\u0430 \u0434\u0435\u043D\u044C\u0433\u0438
      \u0438 \u043F\u043E\u0448\u0451\u043B \u0441\u0432\u043E\u0435\u0439 \u0434\u043E\u0440\u043E\u0433\u043E\u0439.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u043F\u0440\u0438 \u0432\u0430\u0441. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u043E\u0436\u0430\u043B\u0438 \u043F\u043B\u0435\u0447\u0430\u043C\u0438
      - \u0436\u0435\u0441\u0442 \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044F,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0434\u0443\u043C\u0430\u0435\u0442
      \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518529
    m_Localized: "\u041F\u0443\u0441\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518530
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u0448\u0451\u043B \u0442\u0440\u0438
      \u0434\u043D\u044F, \u0447\u0438\u0442\u0430\u043B \u0442\u0438\u0445\u043E.
      \u0423 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u043F\u043E\u0441\u0442\u0430
      \u0441\u043E\u043B\u0434\u0430\u0442 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B
      \u043E\u0431\u043E\u0437 \u0431\u0435\u0437 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432
      - \u043B\u0438\u0446\u043E \u043C\u043E\u043D\u0430\u0445\u0430 \u043E\u043D
      \u0437\u043D\u0430\u043B. \u0414\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043D\u0430\u0432\u044B\u043A: \u0438\u043D\u043E\u0433\u0434\u0430 \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A
      \u0432\u0430\u0436\u043D\u0435\u0435 \u043F\u043E\u043F\u0443\u0442\u043D\u043E\u0433\u043E
      \u0432\u0435\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518531
    m_Localized: "\u0412\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439 \u0441\u043E\u044E\u0437
      \u0441 \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289596518532
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0417\u0430\u0444\u0430\u0440 -
      \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u0432\u0438\u0434\u0435\u043B\u0438 \u0432 \u0442\u0440\u0451\u0445 \u0433\u043E\u0440\u043E\u0434\u0430\u0445
      \u043D\u0430 \u0442\u043E\u043C \u0436\u0435 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0435
      - \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0443 \u0432\u044B\u0445\u043E\u0434\u0430 \u043D\u0430 \u043F\u0430\u043C\u0438\u0440\u0441\u043A\u0443\u044E
      \u0442\u0440\u043E\u043F\u0443. \u041B\u0438\u0446\u043E \u0435\u0433\u043E
      \u0443\u0441\u0442\u0430\u043B\u043E, \u0432\u044C\u044E\u043A\u0438 \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0435\u043D\u044B:
      <npc_speech lang=\"Persian\">\u041C\u043E\u0438 \u043B\u044E\u0434\u0438 \u0431\u043E\u044F\u0442\u0441\u044F
      \u0433\u043E\u0440\u043D\u044B\u0445 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432.
      \u0422\u0432\u043E\u0438, \u0433\u043E\u0432\u043E\u0440\u044F\u0442, \u043F\u0440\u043E\u0448\u043B\u0438
      \u0437\u0434\u0435\u0441\u044C \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C
      \u0433\u043E\u0434\u0443. \u041F\u043E\u0439\u0434\u0451\u043C \u0432\u043C\u0435\u0441\u0442\u0435
      \u0434\u043E \u0424\u0435\u0440\u0433\u0430\u043D\u044B - \u043F\u043E\u0442\u043E\u043C
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u0430\u043C.</npc_speech> \u041A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 - \u043D\u0435 \u0432\u0440\u0430\u0433.
      \u041E\u0431\u044A\u0435\u0434\u0438\u043D\u0451\u043D\u043D\u044B\u0439 \u043E\u0431\u043E\u0437
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435, \u043D\u043E
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435: \u0443 \u0417\u0430\u0444\u0430\u0440\u0430
      \u0440\u0430\u0437\u043D\u044B\u0439 \u0442\u0435\u043C\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712704
    m_Localized: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0441\u043E\u044E\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712705
    m_Localized: "\u0422\u0440\u0438 \u0434\u043D\u044F \u0447\u0435\u0440\u0435\u0437
      \u041F\u0430\u043C\u0438\u0440 \u0432\u043C\u0435\u0441\u0442\u0435. \u0417\u0430\u0444\u0430\u0440
      \u0437\u043D\u0430\u043B \u043E\u0434\u0438\u043D \u0431\u0440\u043E\u0434,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0435 \u0431\u044B\u043B\u043E
      \u043D\u0430 \u0432\u0430\u0448\u0435\u0439 \u043A\u0430\u0440\u0442\u0435.
      \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B \u0431\u0435\u0437
      \u043F\u043E\u0442\u0435\u0440\u044C, \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u0441\u043D\u0438\u0437\u0438\u043B\u0430\u0441\u044C. \u041D\u0430\u0432\u044B\u043A
      \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438 \u0432\u044B\u0440\u043E\u0441
      - \u0417\u0430\u0444\u0430\u0440 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B
      \u043E \u0446\u0435\u043D\u0430\u0445 \u0432 \u0424\u0435\u0440\u0433\u0430\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712706
    m_Localized: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F
      \u0437\u0430 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0443\u044E \u043F\u043B\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712707
    m_Localized: "\u0417\u0430\u0444\u0430\u0440 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0437\u0430 \u0437\u0430\u0449\u0438\u0442\u0443. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430
      \u0432\u044B\u0433\u043E\u0434\u043D\u0435\u0435 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438
      \u0449\u0435\u0434\u0440\u043E\u0433\u043E - \u044D\u0442\u043E \u0434\u0435\u043B\u043E\u0432\u044B\u0435
      \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F, \u043D\u0435 \u0434\u0440\u0443\u0436\u0431\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712708
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712709
    m_Localized: "\u0417\u0430\u0444\u0430\u0440 \u043F\u043E\u0448\u0451\u043B \u0441\u0430\u043C
      - \u0438 \u043E\u0431\u043E\u0433\u043D\u0430\u043B \u0432\u0430\u0441 \u0432
      \u0424\u0435\u0440\u0433\u0430\u043D\u0435 \u043D\u0430 \u0434\u0432\u0430
      \u0434\u043D\u044F: \u043B\u0451\u0433\u043A\u0438\u0439 \u043E\u0431\u043E\u0437
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435. \u041E\u0442\u043A\u0430\u0437
      \u043E\u0442 \u0441\u043E\u044E\u0437\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B
      \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u044C
      \u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712710
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0447\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712711
    m_Localized: "\u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0432 \u0434\u043E\u0440\u043E\u0433\u043E\u043C \u043F\u043E\u044F\u0441\u0435,
      \u043D\u043E \u0441\u0442\u043E\u043F\u0442\u0430\u043D\u043D\u044B\u0445 \u0441\u0430\u043F\u043E\u0433\u0430\u0445,
      \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0431\u043E\u043B\u0442
      \u0448\u0451\u043B\u043A\u0430 \u0437\u0430 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u0435\u0433\u043E \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438 -
      \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043F\u0440\u044F\u043C\u043E
      \u0432 \u0433\u043B\u0430\u0437\u0430: <npc_speech lang=\"Sogdian\">\u042F
      \u0441\u043F\u0435\u0448\u0443. \u0411\u0435\u0440\u0438. \u0418\u043B\u0438
      \u0442\u044B \u0438\u0437 \u0442\u0435\u0445, \u043A\u0442\u043E \u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
      \u0447\u0443\u0436\u043E\u0439 \u0431\u0435\u0434\u043E\u0439?</npc_speech>
      \u042D\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F \u043D\u0443\u0436\u0434\u0430.
      \u0418\u043B\u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 - \u0442\u0430\u043A\u0438\u0435
      \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044E\u0442 \u043E\u043F\u044B\u0442\u043D\u044B\u0435
      \u043A\u0443\u043F\u0446\u044B, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043D\u044F\u0442\u044C,
      \u0441 \u043A\u0435\u043C \u0438\u043C\u0435\u044E\u0442 \u0434\u0435\u043B\u043E.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u043D\u0430 \u0441\u0440\u0435\u0434\u043D\u0435\u043C
      \u0443\u0440\u043E\u0432\u043D\u0435: \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E,
      \u0447\u0442\u043E \u043E\u043D \u043E \u0432\u0430\u0441 \u0441\u043B\u044B\u0448\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712712
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u043F\u043E \u0437\u0430\u043D\u0438\u0436\u0435\u043D\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712713
    m_Localized: "\u0421\u0434\u0435\u043B\u043A\u0430 \u0432\u044B\u0433\u043E\u0434\u043D\u0430\u044F.
      \u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u043A\u0438\u0432\u043D\u0443\u043B \u0431\u0435\u0437 \u044D\u043C\u043E\u0446\u0438\u0439
      \u0438 \u0443\u0448\u0451\u043B. \u041F\u043E\u0437\u0436\u0435 \u0443\u0437\u043D\u0430\u043B\u0438:
      \u043F\u043B\u0435\u043C\u044F\u043D\u043D\u0438\u043A \u043A\u0440\u0443\u043F\u043D\u043E\u0433\u043E
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0433\u043E \u043A\u0443\u043F\u0446\u0430
      - \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u043B \u043D\u043E\u0432\u044B\u0445
      \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u043E\u0432. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0443\u043F\u0430\u043B\u0430 \u0432 \u0435\u0433\u043E \u0433\u043B\u0430\u0437\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712714
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u0443\u044E
      \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712715
    m_Localized: "\u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F - \u043F\u0435\u0440\u0432\u044B\u0439
      \u0440\u0430\u0437 \u0437\u0430 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440.
      \u0421\u0434\u0435\u043B\u043A\u0430 \u043F\u043E \u043F\u043E\u043B\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435 \u043F\u0440\u043E\u0448\u043B\u0430 \u0431\u044B\u0441\u0442\u0440\u043E.
      \u041F\u043E\u0437\u0436\u0435 \u0432\u044B\u044F\u0441\u043D\u0438\u043B\u043E\u0441\u044C:
      \u043F\u043B\u0435\u043C\u044F\u043D\u043D\u0438\u043A \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0430.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0432 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0439
      \u0441\u0435\u0442\u0438 \u0432\u044B\u0440\u043E\u0441\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712716
    m_Localized: "\u0423\u0439\u0442\u0438 \u0431\u0435\u0437 \u0441\u0434\u0435\u043B\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712717
    m_Localized: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438 \u0445\u043E\u0440\u043E\u0448\u0443\u044E
      \u0446\u0435\u043D\u0443 \u0438 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u043D\u0435\u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u043C\u0438.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0432\u0440\u0435\u043C\u044F,
      \u043D\u0435 \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u043B\u0438 \u043D\u0438
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438, \u043D\u0438 \u0442\u043E\u0432\u0430\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712718
    m_Localized: "\u0417\u0430\u0439\u043C \u0443 \u0440\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712719
    m_Localized: "\u0420\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A \u0410\u0431\u0443
      \u0421\u0430\u043B\u0435\u0445 \u0441\u0438\u0434\u0438\u0442 \u0432 \u0442\u0435\u043D\u0438
      \u043D\u0430\u0432\u0435\u0441\u0430 \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C
      \u0441 \u0432\u0435\u0441\u0430\u043C\u0438 \u0438 \u0441\u0442\u043E\u043F\u043A\u043E\u0439
      \u043C\u0435\u0434\u043D\u044B\u0445 \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432.
      \u0421\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C:
      <npc_speech lang=\"Persian\">\u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u043F\u043E\u0434 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u043C\u043E\u043D\u0435\u0442 \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0430
      \u0447\u0435\u0440\u0435\u0437 \u0448\u0435\u0441\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u0434\u043D\u0435\u0439. \u0423\u043C\u0435\u0440\u0435\u043D\u043D\u044B\u0439
      \u043F\u0440\u043E\u0446\u0435\u043D\u0442 - \u0434\u043B\u044F \u0442\u0435\u0445,
      \u0447\u044C\u0451 \u0441\u043B\u043E\u0432\u043E \u043D\u0435 \u0441\u043E\u0432\u0441\u0435\u043C
      \u043F\u0443\u0441\u0442\u043E\u0435.</npc_speech> \u041D\u0435 \u043B\u0443\u0447\u0448\u0438\u0435
      \u0443\u0441\u043B\u043E\u0432\u0438\u044F, \u043D\u043E \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435
      \u043F\u0440\u0438 \u0441\u0440\u0435\u0434\u043D\u0435\u0439 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438.
      \u0420\u0438\u0441\u043A: \u0435\u0441\u043B\u0438 \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u0442\u044C
      - \u0438\u043C\u044F \u0441\u0442\u0430\u043D\u0435\u0442 \u0445\u0443\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712720
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0437\u0430\u0439\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712721
    m_Localized: "\u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043D\u0430 \u0440\u0443\u043A\u0438. \u0427\u0435\u0440\u0435\u0437 \u0448\u0435\u0441\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u0434\u043D\u0435\u0439 \u043D\u0443\u0436\u043D\u043E \u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u0441\u0435\u043C\u044C\u0434\u0435\u0441\u044F\u0442. \u0414\u0435\u043D\u044C\u0433\u0438
      \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442 \u043D\u0430 \u043F\u0443\u0442\u0438
      - \u0435\u0441\u043B\u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044F
      \u043F\u043E\u0439\u0434\u0451\u0442, \u0437\u0430\u0439\u043C \u043E\u043A\u0443\u043F\u0438\u0442\u0441\u044F.
      \u0415\u0441\u043B\u0438 \u043D\u0435\u0442 - \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0443\u043F\u0430\u0434\u0451\u0442 \u043A \u0443\u0440\u043E\u0432\u043D\u044E
      \u0434\u043E\u043B\u0436\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712722
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043C\u0435\u043D\u044C\u0448\u0443\u044E
      \u0441\u0443\u043C\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712723
    m_Localized: "\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432.
      \u041C\u0435\u043D\u044C\u0448\u0438\u0439 \u0434\u043E\u043B\u0433 - \u043C\u0435\u043D\u044C\u0448\u0438\u0439
      \u0440\u0438\u0441\u043A. \u0410\u0431\u0443 \u0421\u0430\u043B\u0435\u0445
      \u043A\u0438\u0432\u043D\u0443\u043B \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E:
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u0439 \u0437\u0430\u0451\u043C\u0449\u0438\u043A
      \u043D\u0430\u0434\u0451\u0436\u043D\u0435\u0435 \u0436\u0430\u0434\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712724
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712725
    m_Localized: "\u0410\u0431\u0443 \u0421\u0430\u043B\u0435\u0445 \u0443\u0431\u0440\u0430\u043B
      \u0434\u0435\u043D\u044C\u0433\u0438 \u0431\u0435\u0437 \u0441\u043B\u043E\u0432.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u0430\u044F:
      \u0442\u043E\u0442, \u043A\u0442\u043E \u043D\u0435 \u043B\u0435\u0437\u0435\u0442
      \u0432 \u0434\u043E\u043B\u0433\u0438, \u043D\u0435 \u0440\u0438\u0441\u043A\u0443\u0435\u0442
      \u0438\u043C\u0438 \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712726
    m_Localized: "\u0421\u043B\u0443\u0445\u0438 \u0433\u043E\u043D\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712727
    m_Localized: "\u0423\u0441\u0442\u0430\u043B\u044B\u0439 \u0433\u043E\u043D\u0435\u0446
      \u0441 \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439 \u043F\u044B\u043B\u044C\u044E
      \u043D\u0430 \u043B\u0438\u0446\u0435 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u043A\u043E\u043D\u044F \u0440\u044F\u0434\u043E\u043C \u0441 \u043E\u0431\u043E\u0437\u043E\u043C
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0438\u0441\u043B\u043E\u0432\u0438\u0439:
      <npc_speech lang=\"Chinese\">\u0422\u044B \u0438\u0434\u0451\u0448\u044C \u043D\u0430
      \u0437\u0430\u043F\u0430\u0434? \u0412 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u0441\u0431\u043E\u0440 \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u043D\u0435\u0439. \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0446\u0435\u043D\u044B
      \u043D\u0430 \u043B\u0430\u0437\u0443\u0440\u0438\u0442 \u0443\u043F\u0430\u0434\u0443\u0442
      - \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439 \u043E\u0431\u043E\u0437
      \u0441 \u0437\u0430\u043F\u0430\u0441\u0430\u043C\u0438 \u0443\u0436\u0435
      \u0432 \u043F\u0443\u0442\u0438.</npc_speech> \u0413\u043E\u043D\u0446\u044B
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445 \u0434\u043E\u043C\u043E\u0432
      \u043F\u0440\u043E\u0434\u0430\u044E\u0442 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
      \u0432\u0441\u0435\u043C \u043F\u043E\u0434\u0440\u044F\u0434 \u0438\u043B\u0438
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0443\u0436\u043D\u044B\u043C -
      \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442
      \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712728
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712729
    m_Localized: "\u0421\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043B\u0438
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0438 \u0434\u043E\u0448\u043B\u0438
      \u0434\u043E \u0441\u0431\u043E\u0440\u0430 \u0432\u043E\u0432\u0440\u0435\u043C\u044F.
      \u041D\u0430\u0432\u044B\u043A \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438
      \u0432\u044B\u0440\u043E\u0441 - \u0432\u043E\u0432\u0440\u0435\u043C\u044F
      \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
      \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0436\u0435 \u043B\u044E\u0431\u043E\u0433\u043E
      \u0442\u043E\u0432\u0430\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712730
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712731
    m_Localized: "\u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438,
      \u043D\u043E \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u043D\u0435 \u043C\u0435\u043D\u044F\u043B\u0438.
      \u0414\u0443\u0445 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F
      - \u0445\u043E\u0440\u043E\u0448\u0438\u0435 \u043D\u043E\u0432\u043E\u0441\u0442\u0438
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043B\u0443\u0447\u0448\u0435 \u0442\u0438\u0448\u0438\u043D\u044B
      \u0432 \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712732
    m_Localized: "\u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712733
    m_Localized: "\u0423 \u0432\u043E\u0440\u043E\u0442 \u041A\u0430\u0448\u0433\u0430\u0440\u0430
      \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0443\u0439\u0433\u0443\u0440 \u0441
      \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u043C
      \u0440\u0435\u0447\u0438 \u0438 \u0434\u044B\u0440\u043E\u0439 \u0432 \u0441\u0430\u043F\u043E\u0433\u0435
      \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0441\u0435\u0431\u044F
      \u0432 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u0438:
      <npc_speech lang=\"Sogdian\">\u0417\u043D\u0430\u044E \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0439,
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439, \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u0439. \u0414\u0451\u0448\u0435\u0432\u043E
      \u0431\u0435\u0440\u0443. \u041D\u0430\u0434\u0451\u0436\u0435\u043D \u043B\u0438
      - \u0443\u0437\u043D\u0430\u0435\u0448\u044C \u0432 \u0434\u043E\u0440\u043E\u0433\u0435.</npc_speech>
      \u0414\u0451\u0448\u0435\u0432 - \u0437\u043D\u0430\u0447\u0438\u0442 \u0438\u043B\u0438
      \u043C\u043E\u043B\u043E\u0434, \u0438\u043B\u0438 \u043D\u0435\u043D\u0430\u0434\u0451\u0436\u0435\u043D,
      \u0438\u043B\u0438 \u043E\u0431\u0430 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430
      \u0441\u0440\u0430\u0437\u0443. \u041F\u0440\u0438 \u0441\u0440\u0435\u0434\u043D\u0435\u0439
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438 \u0442\u0430\u043A\u0438\u0435
      \u043A\u0430\u043D\u0434\u0438\u0434\u0430\u0442\u044B \u0441\u0430\u043C\u0438
      \u0432\u044B\u0431\u0438\u0440\u0430\u044E\u0442, \u043A \u043A\u043E\u043C\u0443
      \u0438\u0434\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712734
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u0437\u0430 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0443\u044E
      \u043F\u043B\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712735
    m_Localized: "\u0423\u0439\u0433\u0443\u0440 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043C\u043E\u043B\u043E\u0434\u044B\u043C, \u043D\u043E \u0441\u043C\u044B\u0448\u043B\u0451\u043D\u044B\u043C.
      \u041D\u0430 \u043F\u043E\u0441\u0442\u0443 \u0446\u0437\u0435\u0434\u0443\u0448\u0438
      \u043F\u0435\u0440\u0435\u0432\u0451\u043B \u0442\u043E\u0447\u043D\u043E -
      \u043D\u0438 \u0441\u043B\u043E\u0432\u0430 \u043B\u0438\u0448\u043D\u0435\u0433\u043E.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0443 \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0441\u044F
      \u0441\u043F\u0443\u0442\u043D\u0438\u043A-\u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712736
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712737
    m_Localized: "\u0411\u0435\u0437 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u0430
      \u043F\u0440\u043E\u0448\u043B\u0438 \u043F\u043E\u0441\u0442 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E
      - \u0434\u043E\u043B\u044C\u0448\u0435 \u0438 \u0441 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u043E\u0439
      \u0443 \u0432\u043E\u0440\u043E\u0442. \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u0447\u0443\u0442\u044C \u0432\u044B\u0440\u043E\u0441\u043B\u0430: \u043D\u0435\u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u044F\u0437\u044B\u043A\u0430 \u0440\u043E\u0436\u0434\u0430\u0435\u0442 \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0435
      \u0443 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712738
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712739
    m_Localized: "\u0422\u0440\u0438 \u0434\u043D\u044F \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F.
      \u041F\u0435\u0440\u0435\u0432\u043E\u0434 \u0432\u0435\u0440\u043D\u044B\u0439,
      \u0445\u043E\u0442\u044F \u043D\u0435\u043B\u043E\u0432\u043A\u0438\u0439.
      \u0420\u0435\u0448\u0438\u043B\u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      - \u0434\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043D\u0430\u0432\u044B\u043A \u0432\u044B\u0440\u043E\u0441 \u043E\u0442
      \u0440\u0430\u0431\u043E\u0442\u044B \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712740
    m_Localized: "\u041B\u043E\u0448\u0430\u0434\u044C \u0437\u0430 \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712741
    m_Localized: "\u041A\u043E\u0447\u0435\u0432\u043E\u0439 \u0442\u044E\u0440\u043A
      \u043D\u0430 \u043F\u0435\u0433\u043E\u0439 \u043A\u043E\u0431\u044B\u043B\u0435
      \u043F\u043E\u0434\u044A\u0435\u0437\u0436\u0430\u0435\u0442 \u043A \u043E\u0431\u043E\u0437\u0443
      \u0443 \u0441\u0442\u0435\u043F\u043D\u043E\u0439 \u0441\u0442\u043E\u044F\u043D\u043A\u0438.
      \u041B\u043E\u0448\u0430\u0434\u044C \u043A\u0440\u0435\u043F\u043A\u0430\u044F
      - \u0448\u0438\u0440\u043E\u043A\u0430\u044F \u0433\u0440\u0443\u0434\u044C,
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435 \u043D\u043E\u0433\u0438,
      \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u043D\u0430\u044F
      \u043A \u0433\u043E\u0440\u043D\u044B\u043C \u0442\u0440\u043E\u043F\u0430\u043C:
      <npc_speech lang=\"Turkic\">\u0425\u043E\u0447\u0443 \u0448\u0451\u043B\u043A
      - \u0434\u0432\u0430 \u0431\u043E\u043B\u0442\u0430, \u0437\u0430 \u043A\u043E\u0431\u044B\u043B\u0443.
      \u0427\u0435\u0441\u0442\u043D\u044B\u0439 \u043A\u0443\u0440\u0441, \u043D\u0435
      \u0442\u043E\u0440\u0433\u0443\u044E\u0441\u044C.</npc_speech> \u041B\u043E\u0448\u0430\u0434\u044C
      \u0441\u0442\u043E\u0438\u0442 \u0442\u0440\u0451\u0445 \u0431\u043E\u043B\u0442\u043E\u0432
      \u043F\u043E \u0440\u044B\u043D\u043E\u0447\u043D\u044B\u043C \u0446\u0435\u043D\u0430\u043C,
      \u0434\u0432\u0430 - \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E
      \u0434\u043B\u044F \u0441\u0442\u0435\u043F\u043D\u043E\u0433\u043E \u043E\u0431\u043C\u0435\u043D\u0430.
      \u0422\u044E\u0440\u043A \u043D\u0435 \u043B\u0436\u0451\u0442 \u043E \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435:
      \u043A\u043E\u0431\u044B\u043B\u0430 \u0437\u0434\u043E\u0440\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712742
    m_Localized: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043E\u0431\u043C\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712743
    m_Localized: "\u0414\u0432\u0430 \u0431\u043E\u043B\u0442\u0430 \u0448\u0451\u043B\u043A\u0430
      \u0437\u0430 \u043A\u0440\u0435\u043F\u043A\u0443\u044E \u043A\u043E\u0431\u044B\u043B\u0443.
      \u041B\u043E\u0448\u0430\u0434\u044C \u043F\u0440\u043E\u0448\u043B\u0430 \u0442\u0440\u0438
      \u0433\u043E\u0440\u043D\u044B\u0445 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430
      \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C \u0442\u0435\u043C\u043F\u0430.
      \u041D\u0430\u0432\u044B\u043A \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438
      \u0432\u044B\u0440\u043E\u0441: \u0431\u0430\u0440\u0442\u0435\u0440 \u0432
      \u0441\u0442\u0435\u043F\u0438 - \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0435
      \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712744
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C \u0434\u043E\u0440\u043E\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712745
    m_Localized: "\u0422\u044E\u0440\u043A \u0434\u0430\u043B \u0442\u0440\u0438
      \u0431\u043E\u043B\u0442\u0430 \u0431\u0435\u0437 \u0441\u043F\u043E\u0440\u0430
      - \u0437\u043D\u0430\u0447\u0438\u0442, \u0437\u043D\u0430\u043B \u0446\u0435\u043D\u0443
      \u0438 \u0431\u044B\u043B \u0433\u043E\u0442\u043E\u0432. \u0425\u043E\u0440\u043E\u0448\u0430\u044F
      \u0441\u0434\u0435\u043B\u043A\u0430. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0447\u0435\u0441\u0442\u043D\u043E\u0433\u043E, \u043D\u043E \u043D\u0435\u0431\u0435\u0441\u043A\u043E\u0440\u044B\u0441\u0442\u043D\u043E\u0433\u043E
      \u043A\u0443\u043F\u0446\u0430 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712746
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043E\u0442
      \u0441\u0434\u0435\u043B\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712747
    m_Localized: "\u0422\u044E\u0440\u043A \u0443\u0435\u0445\u0430\u043B \u0441
      \u043A\u043E\u0431\u044B\u043B\u043E\u0439. \u0428\u0451\u043B\u043A \u043E\u0441\u0442\u0430\u043B\u0441\u044F.
      \u0421\u0434\u0435\u043B\u043A\u0443 \u043D\u0435 \u0437\u0430\u043A\u0440\u044B\u043B\u0438
      - \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0447\u0443\u0442\u044C
      \u043F\u0440\u043E\u0441\u0435\u043B\u0430: \u0442\u043E\u0442, \u043A\u0442\u043E
      \u043D\u0435 \u0443\u043C\u0435\u0435\u0442 \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C
      \u0432 \u0441\u0442\u0435\u043F\u0438, \u043D\u0435 \u0443\u043C\u0435\u0435\u0442
      \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C \u043D\u0438\u0433\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712748
    m_Localized: "\u0420\u0430\u0441\u0441\u0443\u0434\u0438\u0442\u044C \u0441\u043F\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712749
    m_Localized: "\u0414\u0432\u043E\u0435 \u043A\u0443\u043F\u0446\u043E\u0432 \u0441\u043F\u043E\u0440\u044F\u0442
      \u0443 \u0432\u0435\u0441\u043E\u0432 \u043F\u043E\u0441\u0440\u0435\u0434\u0438
      \u0434\u043E\u0440\u043E\u0433\u0438 - \u0433\u043E\u043B\u043E\u0441\u0430
      \u0433\u0440\u043E\u043C\u043A\u0438\u0435, \u0440\u0443\u043A\u0438 \u043D\u0430
      \u0442\u044E\u043A\u0435. \u041E\u0434\u0438\u043D - \u043F\u0435\u0440\u0441
      \u0438\u0437 \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0430, \u0434\u0440\u0443\u0433\u043E\u0439
      - \u0438\u043D\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0438\u0437 \u0421\u0438\u043D\u0434\u0430. \u041F\u0435\u0440\u0441 \u043A\u0440\u0438\u0447\u0438\u0442:
      <npc_speech lang=\"Persian\">\u0422\u0440\u0438 \u0440\u0430\u0442\u043B\u044F
      - \u043C\u044B \u0434\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u043B\u0438\u0441\u044C!
      \u041E\u043D \u0432\u0437\u0432\u0435\u0441\u0438\u043B \u0434\u0432\u0430
      \u0441 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043E\u0439!</npc_speech>
      \u041E\u043D\u0438 \u043E\u0431\u0430 \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u043D\u0430 \u0432\u0430\u0441: \u0441\u043B\u044B\u0448\u0430\u043B\u0438,
      \u0447\u0442\u043E \u0432\u044B \u0437\u043D\u0430\u0435\u0442\u0435 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435
      \u043C\u0435\u0440\u044B. \u0417\u0430 \u0441\u043F\u043E\u0440\u043E\u043C
      \u043E \u0432\u0435\u0441\u0435 \u0442\u044E\u043A\u0430 - \u0434\u0435\u043D\u044C\u0433\u0438
      \u0438 \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u043E \u043E\u0431\u043E\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712750
    m_Localized: "\u0420\u0430\u0441\u0441\u0443\u0434\u0438\u0442\u044C \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712751
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\u0438 \u0432\u0435\u0441\u044B
      \u0438 \u043C\u0435\u0440\u044B - \u043F\u0435\u0440\u0441 \u0431\u044B\u043B
      \u043F\u0440\u0430\u0432. \u0418\u043D\u0434\u0438\u0435\u0446 \u043F\u0440\u0438\u0437\u043D\u0430\u043B
      \u0438 \u0434\u043E\u043F\u043B\u0430\u0442\u0438\u043B \u0440\u0430\u0437\u043D\u0438\u0446\u0443.
      \u041E\u0431\u0430 \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u043B\u0438\u0441\u044C
      \u0432\u0430\u043C. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0447\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u0430\u0440\u0431\u0438\u0442\u0440\u0430
      - \u0440\u0435\u0434\u043A\u0430\u044F \u0438 \u0434\u043E\u0440\u043E\u0433\u0430\u044F
      \u0432\u0435\u0449\u044C \u043D\u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445
      \u0434\u043E\u0440\u043E\u0433\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712752
    m_Localized: "\u041F\u043E\u0441\u043E\u0432\u0435\u0442\u043E\u0432\u0430\u0442\u044C
      \u043F\u043E\u0434\u0435\u043B\u0438\u0442\u044C \u0440\u0430\u0437\u043D\u0438\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712753
    m_Localized: "\u041E\u0431\u0430 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0438\u0441\u044C
      \u043D\u0435\u0445\u043E\u0442\u044F. \u041D\u0438\u043A\u0442\u043E \u043D\u0435
      \u0434\u043E\u0432\u043E\u043B\u0435\u043D \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      - \u0437\u0430\u0442\u043E \u043D\u0438\u043A\u0442\u043E \u0438 \u043D\u0435
      \u0432 \u0443\u0431\u044B\u0442\u043A\u0435. \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043D\u0430\u0432\u044B\u043A \u0432\u044B\u0440\u043E\u0441: \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0438\u0441\u0441
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0438\u0441\u0442\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712754
    m_Localized: "\u0423\u0439\u0442\u0438 \u043D\u0435 \u0432\u043C\u0435\u0448\u0438\u0432\u0430\u044F\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712755
    m_Localized: "\u0421\u043F\u043E\u0440 \u0440\u0430\u0437\u0433\u043E\u0440\u0435\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435 \u0431\u0435\u0437 \u0432\u0430\u0441.
      \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u0434\u043E\u0448\u043B\u043E
      \u0434\u043E \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430 \u043F\u043E\u0441\u0442\u0430.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0442\u043E\u0433\u043E,
      \u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u043C\u043E\u0436\u0435\u0442 - \u0442\u043E\u0436\u0435
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712756
    m_Localized: "\u041F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      \u043F\u0430\u0441\u0442\u0443\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712757
    m_Localized: "\u041F\u0430\u0441\u0442\u0443\u0445 \u0441 \u043E\u0442\u0430\u0440\u043E\u0439
      \u043E\u0432\u0435\u0446 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u043E\u0431\u043E\u0437 \u0436\u0435\u0441\u0442\u043E\u043C \u0440\u0443\u043A\u0438
      - \u0431\u0435\u0437 \u0441\u043B\u043E\u0432 \u0441\u043D\u0430\u0447\u0430\u043B\u0430,
      \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442: \u0436\u0435\u043B\u0442\u043E\u0432\u0430\u0442\u043E\u0435
      \u043D\u0435\u0431\u043E \u043D\u0430\u0434 \u0434\u044E\u043D\u0430\u043C\u0438,
      \u0442\u043E\u043D\u043A\u0430\u044F \u043F\u044B\u043B\u044C\u043D\u0430\u044F
      \u043F\u043E\u043B\u043E\u0441\u043A\u0430 \u0443 \u0437\u0435\u043C\u043B\u0438.
      <npc_speech lang=\"Persian\">\u0427\u0435\u0440\u0435\u0437 \u0434\u0432\u0430
      \u0447\u0430\u0441\u0430 - \u0431\u0443\u0440\u044F. \u042F \u043F\u0430\u0441
      \u0437\u0434\u0435\u0441\u044C \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C
      \u043B\u0435\u0442. \u0412\u0441\u0442\u0430\u043D\u044C \u0437\u0430 \u0442\u043E\u0439
      \u0433\u0440\u044F\u0434\u043E\u0439, \u0442\u0430\u043C \u0432\u0435\u0442\u0435\u0440
      \u043C\u0435\u043D\u044C\u0448\u0435.</npc_speech> \u041F\u0430\u0441\u0442\u0443\u0445\u0438
      \u0447\u0438\u0442\u0430\u044E\u0442 \u0441\u0442\u0435\u043F\u044C \u043B\u0443\u0447\u0448\u0435
      \u043B\u044E\u0431\u043E\u0439 \u043A\u0430\u0440\u0442\u044B. \u0411\u0443\u0440\u044F
      \u043C\u043E\u0436\u0435\u0442 \u0434\u043B\u0438\u0442\u044C\u0441\u044F \u0447\u0430\u0441
      \u0438\u043B\u0438 \u0442\u0440\u0438 \u0434\u043D\u044F - \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0437\u043D\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712758
    m_Localized: "\u0412\u0441\u0442\u0430\u0442\u044C \u0437\u0430 \u0433\u0440\u044F\u0434\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712759
    m_Localized: "\u0411\u0443\u0440\u044F \u043F\u0440\u043E\u0448\u043B\u0430 \u0437\u0430
      \u0448\u0435\u0441\u0442\u044C \u0447\u0430\u0441\u043E\u0432. \u0417\u0430
      \u0433\u0440\u044F\u0434\u043E\u0439 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043E\u0434\u0438\u043D \u0434\u0435\u043D\u044C, \u043D\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438
      \u0433\u0440\u0443\u0437 \u0438 \u043B\u044E\u0434\u0435\u0439. \u041F\u0430\u0441\u0442\u0443\u0445
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043F\u0440\u0430\u0432 -
      \u0432\u0435\u0442\u0435\u0440 \u0443 \u0433\u0440\u044F\u0434\u044B \u0431\u044B\u043B
      \u0432\u0434\u0432\u043E\u0435 \u0441\u043B\u0430\u0431\u0435\u0435, \u0447\u0435\u043C
      \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712760
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712761
    m_Localized: "\u0411\u0443\u0440\u044F \u043D\u0430\u043A\u0440\u044B\u043B\u0430
      \u043E\u0431\u043E\u0437 \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441.
      \u0414\u0432\u043E\u0435 \u0441\u0443\u0442\u043E\u043A \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E,
      \u0435\u0434\u0430 \u043E\u0442\u0441\u044B\u0440\u0435\u043B\u0430, \u043E\u0434\u0438\u043D
      \u0442\u044E\u043A \u0448\u0451\u043B\u043A\u0430 \u0438\u0441\u043F\u043E\u0440\u0447\u0435\u043D
      \u043F\u044B\u043B\u044C\u044E. \u041F\u0430\u0441\u0442\u0443\u0445 \u0432\u0438\u0434\u0435\u043B
      \u044D\u0442\u043E \u0441 \u0433\u0440\u044F\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712762
    m_Localized: "\u0417\u0430\u0431\u043B\u0443\u0434\u0438\u0432\u0448\u0438\u0439\u0441\u044F
      \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712763
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A \u0432 \u043F\u044B\u043B\u044C\u043D\u043E\u0439
      \u0431\u0435\u043B\u043E\u0439 \u0440\u0443\u0431\u0430\u0445\u0435 \u0441\u0438\u0434\u0438\u0442
      \u0443 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438 \u0438 \u0434\u0435\u0440\u0436\u0438\u0442
      \u0432 \u0440\u0443\u043A\u0430\u0445 \u043F\u0443\u0441\u0442\u0443\u044E
      \u0444\u043B\u044F\u0433\u0443 - \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0440\u0430\u0441\u0442\u0435\u0440\u044F\u043D\u043D\u043E. \u0423\u0432\u0438\u0434\u0435\u0432
      \u043E\u0431\u043E\u0437, \u0432\u0441\u0442\u0430\u0451\u0442: <npc_speech
      lang=\"Chinese\">\u042F \u0438\u0434\u0443 \u0432 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D,
      \u043A \u043F\u0435\u0449\u0435\u0440\u0430\u043C \u041C\u043E\u0433\u0430\u043E.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B \u0434\u043E\u0440\u043E\u0433\u0443
      \u0432\u0447\u0435\u0440\u0430. \u041D\u043E \u044F \u0437\u043D\u0430\u044E
      \u0442\u0430\u0439\u043D\u0443\u044E \u0442\u0440\u043E\u043F\u0443 \u0447\u0435\u0440\u0435\u0437
      \u0433\u043E\u0440\u043D\u0443\u044E \u0441\u043A\u043B\u0430\u0434\u043A\u0443
      - \u043E\u043D\u0430 \u043A\u043E\u0440\u043E\u0447\u0435 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
      \u043D\u0430 \u0434\u0435\u043D\u044C. \u041F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0435
      - \u043F\u043E\u043A\u0430\u0436\u0443.</npc_speech> \u0422\u0440\u043E\u043F\u0430
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F \u0438\u043B\u0438 \u043D\u0435\u0442
      - \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E. \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A
      \u043D\u0435 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043C\u043E\u0448\u0435\u043D\u043D\u0438\u043A\u043E\u043C,
      \u043D\u043E \u043C\u043E\u0436\u0435\u0442 \u043E\u0448\u0438\u0431\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712764
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0430
      \u0438 \u043F\u0440\u043E\u0439\u0442\u0438 \u0442\u0430\u0439\u043D\u043E\u0439
      \u0442\u0440\u043E\u043F\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712765
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0439 - \u0443\u0437\u043A\u043E\u0439,
      \u0441 \u043A\u0440\u0443\u0442\u044B\u043C\u0438 \u043A\u0430\u043C\u043D\u044F\u043C\u0438,
      \u043D\u043E \u0432\u0435\u0440\u043D\u043E\u0439. \u041E\u0434\u0438\u043D
      \u0434\u0435\u043D\u044C \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u043B\u0435\u043D.
      \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A \u0448\u0451\u043B \u043C\u043E\u043B\u0447\u0430
      \u0438 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C
      \u0443 \u0432\u043E\u0440\u043E\u0442 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0432\u044B\u0440\u043E\u0441\u043B\u0430
      \u043E\u0442 \u0434\u043E\u0431\u0440\u043E\u0433\u043E \u043F\u043E\u0441\u0442\u0443\u043F\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712766
    m_Localized: "\u0414\u0430\u0442\u044C \u0435\u0434\u044B \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C
      \u0434\u043E\u0440\u043E\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712767
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A \u0443\u0448\u0451\u043B
      \u043F\u043E \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0435
      \u0441 \u0435\u0434\u043E\u0439. \u041F\u043E\u043B\u0443\u0447\u0438\u043B\u0438
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0441\u0443\u043C\u043C\u0443
      \u0437\u0430 \u0434\u043E\u0431\u0440\u043E\u0442\u0443 - \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C,
      \u0443\u0437\u043D\u0430\u0432 \u043E \u043F\u043E\u0441\u0442\u0443\u043F\u043A\u0435,
      \u043F\u0435\u0440\u0435\u0434\u0430\u043B \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u0447\u0435\u0440\u0435\u0437 \u0433\u043E\u043D\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712768
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0431\u0435\u0437
      \u043F\u043E\u043C\u043E\u0449\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712769
    m_Localized: "\u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B \u043C\u0438\u043C\u043E.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u043B\u0438\u0441\u044C
      - \u043C\u043E\u043B\u0447\u0430. \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u0432\u0441\u043B\u0435\u0434.
      \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u043D\u0430 \u0433\u043E\u0440\u043D\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0435 \u0432\u044B\u0440\u043E\u0441\u043B\u0430
      - \u0442\u0430\u043A\u0438\u0435 \u0432\u0437\u0433\u043B\u044F\u0434\u044B
      \u043F\u0440\u0438\u043D\u043E\u0441\u044F\u0442 \u043F\u043B\u043E\u0445\u0443\u044E
      \u043F\u043E\u0433\u043E\u0434\u0443, \u043A\u0430\u043A \u0433\u043E\u0432\u043E\u0440\u044F\u0442
      \u0432 \u0441\u0442\u0435\u043F\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712770
    m_Localized: "\u0417\u0430\u0441\u0430\u0434\u0430 \u0443 \u0433\u0440\u044F\u0434\u044B
      \u043A\u0430\u043C\u043D\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712771
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u043F\u044B\u043B\u0438 \u0438
      \u043F\u0440\u043E\u0433\u043E\u0440\u043A\u043B\u043E\u0433\u043E \u043A\u0443\u043D\u0436\u0443\u0442\u043D\u043E\u0433\u043E
      \u043C\u0430\u0441\u043B\u0430 - \u0447\u0435\u0442\u044B\u0440\u0435 \u0441\u0438\u043B\u0443\u044D\u0442\u0430
      \u0432\u044B\u0445\u043E\u0434\u044F\u0442 \u0438\u0437-\u0437\u0430 \u0433\u0440\u044F\u0434\u044B
      \u0441\u0435\u0440\u044B\u0445 \u043A\u0430\u043C\u043D\u0435\u0439, \u0437\u0430\u0433\u043E\u0440\u0430\u0436\u0438\u0432\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0443. \u0412\u043F\u0435\u0440\u0435\u0434\u0438
      \u043A\u043E\u0440\u0435\u043D\u0430\u0441\u0442\u044B\u0439 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A
      \u0441 \u043A\u0440\u0438\u0432\u044B\u043C \u043D\u043E\u0436\u043E\u043C
      \u0432 \u043A\u0430\u0436\u0434\u043E\u0439 \u0440\u0443\u043A\u0435 \u043A\u0440\u0438\u0447\u0438\u0442
      \u043F\u043E-\u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438: \"\u0412\u0430\u0448\u0438
      \u0442\u044E\u043A\u0438 \u0438\u043B\u0438 \u0432\u0430\u0448\u0438 \u0436\u0438\u0437\u043D\u0438
      - \u0432\u044B\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0431\u044B\u0441\u0442\u0440\u043E\".
      \u041E\u043D\u0438 \u0445\u043E\u0440\u043E\u0448\u043E \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043B\u0438
      \u043C\u0435\u0441\u0442\u043E: \u0441\u043B\u0435\u0432\u0430 \u043E\u0431\u0440\u044B\u0432,
      \u0441\u043F\u0440\u0430\u0432\u0430 \u0441\u043A\u0430\u043B\u0430, \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0442\u044C
      \u043D\u0435\u043A\u0443\u0434\u0430. \u041D\u0430 \u043A\u043E\u043D\u0443
      \u0432\u0435\u0441\u044C \u0442\u043E\u0432\u0430\u0440 \u0438 \u0436\u0438\u0437\u043D\u0438
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432. \u0422\u0430\u043A\u0438\u0435
      \u0433\u0440\u044F\u0434\u044B \u043D\u0430 \u0440\u0430\u0432\u043D\u0438\u043D\u0430\u0445
      \u0425\u044D\u0441\u0438 \u0434\u0430\u0432\u043D\u043E \u0441\u0442\u0430\u043B\u0438
      \u0438\u0437\u043B\u044E\u0431\u043B\u0435\u043D\u043D\u044B\u043C\u0438 \u043C\u0435\u0441\u0442\u0430\u043C\u0438
      \u0434\u043B\u044F \u0437\u0430\u0441\u0430\u0434 - \u043C\u0435\u0441\u0442\u043D\u044B\u0435
      \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0438\u0445 \"\u0437\u0443\u0431\u0430\u043C\u0438
      \u0434\u0440\u0430\u043A\u043E\u043D\u0430\"."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712772
    m_Localized: "\u0414\u0430\u0442\u044C \u0431\u043E\u0439 - \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432
      \u0432\u0441\u0435\u0433\u043E \u0447\u0435\u0442\u0432\u0435\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712773
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438 \u043E\u0442\u0431\u0438\u043B\u0438
      \u0430\u0442\u0430\u043A\u0443. \u0414\u0432\u0443\u0445 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432
      \u0440\u0430\u043D\u0438\u043B\u0438, \u0434\u0432\u043E\u0435 \u0431\u0435\u0436\u0430\u043B\u0438.
      \u041F\u043E\u0442\u0435\u0440\u0438 - \u043E\u0434\u0438\u043D \u043F\u043E\u0440\u0435\u0437
      \u0443 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430, \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043C\u0435\u0448\u043A\u043E\u0432 \u043E\u043F\u0440\u043E\u043A\u0438\u043D\u0443\u0442\u043E.
      \u0423\u0433\u0440\u043E\u0437\u0430 \u043C\u0438\u043D\u043E\u0432\u0430\u043B\u0430,
      \u043D\u043E \u0448\u0443\u043C \u043C\u043E\u0433 \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u044C
      \u0434\u0440\u0443\u0433\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712774
    m_Localized: "\u041F\u0440\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F \u0441
      \u0440\u0430\u0437\u0433\u043E\u043D\u0430 \u043D\u0430 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712775
    m_Localized: "\u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u043F\u0440\u043E\u0448\u043B\u0438
      \u0441\u043A\u0432\u043E\u0437\u044C \u0437\u0430\u0441\u0430\u0434\u0443 \u0441\u043B\u043E\u043C\u044F
      \u0433\u043E\u043B\u043E\u0432\u0443. \u041E\u0434\u0438\u043D \u0442\u044E\u043A
      \u0441\u043E\u0440\u0432\u0430\u043B\u0441\u044F \u0438 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u043F\u043E\u0437\u0430\u0434\u0438 - \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
      \u0437\u0430\u0431\u0440\u0430\u043B\u0438 \u0435\u0433\u043E. \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0443\u0434\u0430\u0440 \u0434\u0443\u0431\u0438\u043D\u043E\u0439
      \u043F\u043E \u043F\u043B\u0435\u0447\u0443, \u043D\u043E \u043E\u0431\u043E\u0437
      \u0432\u044B\u0448\u0435\u043B \u0438\u0437 \u043B\u043E\u0432\u0443\u0448\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712776
    m_Localized: "\u041E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F -
      \u0434\u0430\u0442\u044C \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443
      \u0434\u0438\u0440\u0445\u0430\u043C\u0443 \u0441 \u0442\u044E\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712777
    m_Localized: "\u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438 \u0432\u0437\u044F\u043B\u0438
      \u0434\u0435\u043D\u044C\u0433\u0438 \u0438 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438.
      \u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      - \u0446\u0435\u043D\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0432\u043E\u0440\u0447\u0430\u043B\u0438, \u043D\u043E \u0446\u0435\u043B\u044B.
      \u0421\u043B\u0443\u0445 \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0441
      \u044D\u0442\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0431\u0435\u0440\u0443\u0442 \u0434\u0435\u043D\u044C\u0433\u0438, \u0443\u0439\u0434\u0451\u0442
      \u0432\u043F\u0435\u0440\u0451\u0434 \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u0441\u0430\u043C\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712778
    m_Localized: "\u0427\u0435\u043B\u043E\u0432\u0435\u043A-\u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712779
    m_Localized: "\u0421\u0440\u0435\u0434\u0438 \u0434\u043D\u044F \u0443 \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u0448\u0435\u0433\u043E
      \u0440\u0443\u0441\u043B\u0430 \u0438\u0437-\u0437\u0430 \u0432\u0430\u043B\u0443\u043D\u0430
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u043E\u0434\u0438\u043D\u043E\u043A\u0430\u044F
      \u0444\u0438\u0433\u0443\u0440\u0430 \u0432 \u043B\u043E\u0445\u043C\u043E\u0442\u044C\u044F\u0445.
      \u0412 \u043F\u0440\u0430\u0432\u043E\u0439 \u0440\u0443\u043A\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A
      \u0434\u0435\u0440\u0436\u0438\u0442 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0435
      \u043A\u043E\u043F\u044C\u0451 \u0441 \u043C\u0435\u0434\u043D\u044B\u043C
      \u043D\u0430\u043A\u043E\u043D\u0435\u0447\u043D\u0438\u043A\u043E\u043C, \u0432
      \u043B\u0435\u0432\u043E\u0439 - \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u043C\u0435\u0448\u043E\u0447\u0435\u043A,
      \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u0442\u0438\u0445\u043E\u0435 \u0448\u0443\u0440\u0448\u0430\u043D\u0438\u0435.
      \u0423\u043B\u044B\u0431\u0430\u044F\u0441\u044C \u0431\u0435\u0437\u0437\u0443\u0431\u044B\u043C
      \u0440\u0442\u043E\u043C, \u043E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043F\u043E-\u043F\u0430\u0440\u0444\u044F\u043D\u0441\u043A\u0438: \"\u0412\u043D\u0443\u0442\u0440\u0438
      - \u0442\u0440\u0438 \u0436\u0438\u0432\u044B\u0445 \u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D\u0430.
      \u041F\u043E\u043B\u043E\u0436\u0438\u0442\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u043E
      \u043D\u0430 \u043A\u0430\u043C\u0435\u043D\u044C \u0438 \u0443\u0445\u043E\u0434\u0438\u0442\u0435\".
      \u0423\u0433\u0440\u043E\u0437\u0430 \u043D\u0435\u043B\u0435\u043F\u0430,
      \u043D\u043E \u043E\u0442\u0442\u043E\u0433\u043E \u043D\u0435 \u043C\u0435\u043D\u0435\u0435
      \u0440\u0435\u0430\u043B\u044C\u043D\u0430 - \u044F\u0434 \u0430\u043D\u0434\u0440\u043E\u043A\u0442\u043E\u043D\u0430
      \u0443\u0431\u0438\u0432\u0430\u0435\u0442 \u0437\u0430 \u0441\u0443\u0442\u043A\u0438.
      \u041D\u0430 \u0434\u043D\u0435 \u043F\u0443\u0441\u0442\u044B\u043D\u0438
      \u0422\u0430\u043A\u043B\u0430-\u041C\u0430\u043A\u0430\u043D \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0438
      \u0432\u044B\u0436\u0438\u0432\u0430\u044E\u0442 \u0445\u0438\u0442\u0440\u043E\u0441\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712780
    m_Localized: "\u0417\u0430\u0441\u043C\u0435\u044F\u0442\u044C\u0441\u044F \u0438
      \u043F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E - \u0431\u043B\u0435\u0444\u0443\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712781
    m_Localized: "\u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A \u0440\u0430\u0441\u0442\u0435\u0440\u044F\u043B\u0441\u044F
      \u043E\u0442 \u0441\u043C\u0435\u043B\u043E\u0441\u0442\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0438 \u043C\u0435\u0448\u043E\u0447\u0435\u043A \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u043B.
      \u041D\u043E \u043A\u043E\u043F\u044C\u0451\u043C \u0432\u0441\u0451 \u0436\u0435
      \u0437\u0430\u043C\u0430\u0445\u043D\u0443\u043B\u0441\u044F. \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0438\u043B \u0440\u0443\u043A\u0443.
      \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B, \u043D\u0435
      \u043F\u043E\u0442\u0435\u0440\u044F\u0432 \u043D\u0438\u0447\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712782
    m_Localized: "\u041D\u0430\u043F\u0430\u0441\u0442\u044C \u043F\u0440\u0435\u0436\u0434\u0435,
      \u0447\u0435\u043C \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u043C\u0435\u0448\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712783
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u043B
      \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E, \u043D\u043E
      \u043C\u0435\u0448\u043E\u043A \u0432\u0441\u0451 \u0436\u0435 \u0443\u043F\u0430\u043B.
      \u0414\u0432\u043E\u0435 \u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D\u043E\u0432
      \u0440\u0430\u0437\u0431\u0435\u0436\u0430\u043B\u0438\u0441\u044C. \u041E\u0434\u0438\u043D
      \u0443\u0436\u0430\u043B\u0438\u043B \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430
      \u041A\u0430\u0440\u0438\u043C\u0430 \u0432 \u043B\u043E\u0434\u044B\u0436\u043A\u0443
      - \u043A\u043E\u0436\u0430 \u0432\u0441\u043F\u0443\u0445\u043B\u0430, \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0434\u0435\u043B\u0430\u0442\u044C \u043D\u0430\u0434\u0440\u0435\u0437 \u0438
      \u043F\u0440\u0438\u0436\u0438\u0433\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712784
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C - \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u043F\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0438
      \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712785
    m_Localized: "\u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A \u043F\u0440\u0438\u043D\u044F\u043B
      \u043C\u043E\u043D\u0435\u0442\u044B \u0438 \u0441\u0435\u043B \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u0437\u0430 \u043A\u0430\u043C\u0435\u043D\u044C. \u0423\u043D\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
      \u043D\u043E \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043D\u0430\u0437\u0432\u0430\u043B\u0438 \u0435\u0433\u043E \u0434\u0443\u0440\u0430\u0446\u043A\u043E\u0435
      \u043F\u0440\u043E\u0437\u0432\u0438\u0449\u0435 - \u0447\u0435\u043B\u043E\u0432\u0435\u043A-\u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D
      - \u0438 \u0441\u043C\u0435\u044F\u043B\u0438\u0441\u044C \u0435\u0449\u0451
      \u0434\u0432\u0430 \u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712786
    m_Localized: "\u0412\u043E\u043B\u043A\u0438 \u0432 \u043D\u043E\u0447\u043D\u043E\u043C
      \u043B\u0430\u0433\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712787
    m_Localized: "\u041E\u043A\u043E\u043B\u043E \u043F\u043E\u043B\u0443\u043D\u043E\u0447\u0438
      \u043B\u0430\u0433\u0435\u0440\u044C \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F
      \u043E\u0442 \u0440\u0451\u0432\u0430 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432
      \u0438 \u0441\u043E\u0431\u0430\u0447\u044C\u0435\u0433\u043E \u043B\u0430\u044F.
      \u0412 \u043E\u0442\u0431\u043B\u0435\u0441\u043A\u0430\u0445 \u043A\u043E\u0441\u0442\u0440\u0430
      \u0434\u0432\u0438\u0436\u0443\u0442\u0441\u044F \u0441\u0435\u0440\u044B\u0435
      \u0442\u0435\u043D\u0438 - \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 \u0434\u0435\u0432\u044F\u0442\u0438
      \u0432\u043E\u043B\u043A\u043E\u0432 \u043E\u0431\u043E\u0448\u043B\u0438 \u043B\u0430\u0433\u0435\u0440\u044C
      \u0441 \u0442\u0440\u0451\u0445 \u0441\u0442\u043E\u0440\u043E\u043D. \u0412\u043E\u0436\u0430\u043A
      \u0441\u0442\u0430\u0438, \u043A\u0440\u0443\u043F\u043D\u044B\u0439 \u0441\u0430\u043C\u0435\u0446
      \u0441 \u0440\u0430\u0437\u043E\u0434\u0440\u0430\u043D\u043D\u044B\u043C \u0443\u0445\u043E\u043C,
      \u0441\u0442\u043E\u0438\u0442 \u0432 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u0438
      \u0448\u0430\u0433\u0430\u0445 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0445
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445. \u0417\u0430\u043F\u0430\u0441\u044B
      \u0435\u0434\u044B \u043F\u043E\u0434 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C
      \u043D\u0435\u0431\u043E\u043C. \u0415\u0441\u043B\u0438 \u043E\u0433\u043E\u043D\u044C
      \u043D\u0435 \u0441\u0434\u0435\u0440\u0436\u0438\u0442 - \u0441\u0442\u0430\u044F
      \u0434\u043E\u0431\u0435\u0440\u0451\u0442\u0441\u044F \u0434\u043E \u0432\u044C\u044E\u0447\u043D\u044B\u0445
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445. \u0412 \u0441\u0442\u0435\u043F\u044F\u0445
      \u0416\u0435\u0442\u044B\u0441\u0443 \u0432\u043E\u043B\u043A\u0438 \u0432
      \u0441\u0443\u0440\u043E\u0432\u044B\u0435 \u0437\u0438\u043C\u044B \u043D\u0435
      \u0431\u043E\u044F\u0442\u0441\u044F \u0434\u0430\u0436\u0435 \u0431\u043E\u043B\u044C\u0448\u0438\u0445
      \u043E\u0431\u043E\u0437\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712788
    m_Localized: "\u0420\u0430\u0437\u0434\u0443\u0442\u044C \u043A\u043E\u0441\u0442\u0440\u044B
      \u0438 \u043A\u0440\u0438\u0447\u0430\u0442\u044C \u0432\u0441\u0435\u043C
      \u0432\u043C\u0435\u0441\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712789
    m_Localized: "\u0428\u0443\u043C \u0438 \u043E\u0433\u043E\u043D\u044C \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0441\u0432\u043E\u0451 \u0434\u0435\u043B\u043E - \u043F\u043E\u0441\u043B\u0435
      \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u0438 \u0447\u0430\u0441\u0430 \u0441\u0442\u043E\u044F\u0447\u0435\u0433\u043E
      \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F
      \u0432\u043E\u0436\u0430\u043A \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B
      \u0438 \u0443\u0448\u0451\u043B. \u0417\u0430\u043F\u0430\u0441\u044B \u0443\u0446\u0435\u043B\u0435\u043B\u0438.
      \u041B\u044E\u0434\u0438 \u043D\u0435 \u0441\u043F\u0430\u043B\u0438 \u0434\u043E
      \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712790
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u043A\u0443\u0441\u043E\u043A
      \u0435\u0434\u044B \u043F\u0440\u043E\u0447\u044C \u043E\u0442 \u043B\u0430\u0433\u0435\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712791
    m_Localized: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u043E\u043B\u043A\u043E\u0432
      \u0443\u0448\u043B\u0438 \u0437\u0430 \u0435\u0434\u043E\u0439. \u0421\u0442\u0430\u044F
      \u0440\u0430\u0437\u0434\u0440\u043E\u0431\u0438\u043B\u0430\u0441\u044C. \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u0441\u043F\u0430\u043B\u0430, \u043D\u043E \u0432\u043E\u0441\u0435\u043C\u044C
      \u043C\u0435\u0448\u043A\u043E\u0432 \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0438
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043E\u0442\u0434\u0430\u0442\u044C
      - \u0432\u043E\u043B\u043A\u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u0437\u0430 \u043E\u0441\u0442\u0430\u0442\u043A\u0430\u043C\u0438 \u0442\u0440\u0438\u0436\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712792
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C \u0441\u0442\u0430\u044E
      \u0441 \u043A\u043E\u043F\u044C\u044F\u043C\u0438 - \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438
      \u0432\u043F\u0435\u0440\u0451\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712793
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0411\u0430\u0445\u0440\u0430\u043C
      \u0431\u044B\u043B \u0443\u043A\u0443\u0448\u0435\u043D \u0437\u0430 \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u044C\u0435,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0441\u0442\u0430\u044F
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0430. \u0420\u0430\u043D\u0430
      \u0433\u043B\u0443\u0431\u043E\u043A\u0430\u044F. \u0412\u043E\u043B\u043A\u0438
      \u0443\u0448\u043B\u0438, \u043D\u043E \u043E\u0434\u0438\u043D \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u0432 \u0438\u0441\u043F\u0443\u0433\u0435 \u043F\u043E\u0440\u0432\u0430\u043B
      \u0432\u0435\u0440\u0451\u0432\u043A\u0443 \u0438 \u0443\u0431\u0435\u0436\u0430\u043B
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712794
    m_Localized: "\u0411\u0443\u043D\u0442 \u043D\u0430\u0451\u043C\u043D\u043E\u0433\u043E
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712795
    m_Localized: "\u0413\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u043D\u043E\u0447\u044C\u044E
      \u0440\u0435\u0437\u043A\u0438\u0439 \u043B\u044F\u0437\u0433 \u0441\u0442\u0430\u043B\u0438
      \u0431\u0443\u0434\u0438\u0442 \u043B\u0430\u0433\u0435\u0440\u044C. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D,
      \u043D\u0430\u043D\u044F\u0442\u044B\u0439 \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u0437\u0430 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0432 \u043D\u0435\u0434\u0435\u043B\u044E, \u0441\u0442\u043E\u0438\u0442
      \u0443 \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0441 \u043E\u0431\u043D\u0430\u0436\u0451\u043D\u043D\u044B\u043C
      \u043C\u0435\u0447\u043E\u043C \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0440\u043E\u0432\u043D\u044B\u043C \u0433\u043E\u043B\u043E\u0441\u043E\u043C:
      \"\u042F \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435
      \u043E\u0442 \u043A\u0443\u043F\u0446\u0430 \u041C\u0430\u043D\u0430\u0445\u0430.
      \u041E\u043D \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442 \u0432\u0442\u0440\u043E\u0435,
      \u0435\u0441\u043B\u0438 \u044F \u043F\u0440\u0438\u0432\u0435\u0434\u0443
      \u043A \u043D\u0435\u043C\u0443 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432
      \u0441 \u043B\u0430\u0437\u0443\u0440\u0438\u0442\u043E\u043C. \u041D\u0435
      \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u044F\u0439\u0442\u0435\u0441\u044C\".
      \u0422\u0440\u043E\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0437\u0430 \u0435\u0433\u043E \u0441\u043F\u0438\u043D\u043E\u0439 \u043C\u043E\u043B\u0447\u0430\u0442
      - \u043D\u0435\u044F\u0441\u043D\u043E, \u043D\u0430 \u0447\u044C\u0435\u0439
      \u043E\u043D\u0438 \u0441\u0442\u043E\u0440\u043E\u043D\u0435. \u041B\u0430\u0437\u0443\u0440\u0438\u0442
      \u043D\u0430 \u0431\u043E\u0440\u0442\u0443 \u0441\u0442\u043E\u0438\u0442
      \u0434\u043E\u0440\u043E\u0436\u0435 \u0433\u043E\u0434\u043E\u0432\u043E\u0439
      \u0432\u044B\u0440\u0443\u0447\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712796
    m_Localized: "\u0412\u0441\u0442\u0430\u0442\u044C \u043B\u0438\u0447\u043D\u043E
      \u0438 \u043F\u0440\u0438\u0437\u0432\u0430\u0442\u044C \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712797
    m_Localized: "\u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B,
      \u043A\u043E\u0433\u0434\u0430 \u0443\u0432\u0438\u0434\u0435\u043B, \u0447\u0442\u043E
      \u0434\u0432\u043E\u0435 \u0434\u0440\u0443\u0433\u0438\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432
      \u0432\u0441\u0442\u0430\u043B\u0438 \u043D\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043E\u0431\u043E\u0437\u0430. \u041E\u043D \u0443\u0448\u0451\u043B \u0432
      \u0442\u0435\u043C\u043D\u043E\u0442\u0443 \u0431\u0435\u0437 \u043A\u0440\u043E\u0432\u0438,
      \u043D\u043E \u0431\u0435\u0437 \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u044F.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0437\u0430\u0443\u0432\u0430\u0436\u0430\u043B\u0438
      \u0440\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712798
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0434\u0432\u043E\u0439\u043D\u0443\u044E
      \u043F\u043B\u0430\u0442\u0443 - \u043F\u0435\u0440\u0435\u043A\u0443\u043F\u0438\u0442\u044C
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712799
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0441\u0432\u0435\u0440\u0445 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0430
      \u0432\u0435\u0440\u043D\u0443\u043B\u0438 \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D\u0430
      \u0432 \u0441\u0442\u0440\u043E\u0439. \u0414\u043E\u0440\u043E\u0433\u043E,
      \u043D\u043E \u0431\u0435\u0437 \u043A\u0440\u043E\u0432\u0438. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u0435\u0440\u0438\u0442\u044C \u0435\u043C\u0443 \u043C\u0435\u043D\u044C\u0448\u0435
      - \u043E\u043D \u043F\u0440\u043E\u0434\u0430\u0451\u0442\u0441\u044F \u0442\u043E\u043C\u0443,
      \u043A\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u043B\u0430\u0442\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712800
    m_Localized: "\u0423\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u0438 \u043E\u0442\u0434\u0430\u0442\u044C
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432 \u0441 \u043B\u0430\u0437\u0443\u0440\u0438\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712801
    m_Localized: "\u0422\u0440\u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430
      \u0441 \u043B\u0430\u0437\u0443\u0440\u0438\u0442\u043E\u043C \u0443\u0448\u043B\u0438
      \u0432 \u043D\u043E\u0447\u044C. \u041F\u043E\u0442\u0435\u0440\u044F \u043E\u0433\u0440\u043E\u043C\u043D\u0430\u044F.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0431\u044B\u043B \u0434\u043E\u0432\u043E\u043B\u0435\u043D.
      \u0423\u0442\u0440\u043E\u043C \u043A\u0443\u043F\u0435\u0446 \u041C\u0430\u043D\u0430\u0445
      \u043F\u0440\u0438\u0441\u043B\u0430\u043B \u043D\u0430\u0441\u043C\u0435\u0448\u043B\u0438\u0432\u043E\u0435
      \u043F\u0438\u0441\u044C\u043C\u043E \u0441 \u043F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C
      - \u043E\u043D \u0432\u0441\u0451 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043B
      \u0437\u0430\u0440\u0430\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712802
    m_Localized: "\u0420\u0435\u0447\u043D\u044B\u0435 \u043F\u0438\u0440\u0430\u0442\u044B
      \u0443 \u0431\u0440\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712803
    m_Localized: "\u0411\u0440\u043E\u0434 \u0447\u0435\u0440\u0435\u0437 \u0421\u044B\u0440\u0434\u0430\u0440\u044C\u044E
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0436\u0435\u043D.
      \u0414\u0432\u0435 \u043F\u043B\u043E\u0441\u043A\u043E\u0434\u043E\u043D\u043D\u044B\u0435
      \u043B\u043E\u0434\u043A\u0438 \u0441\u0442\u043E\u044F\u0442 \u0431\u043E\u0440\u0442
      \u043A \u0431\u043E\u0440\u0442\u0443, \u043D\u0430\u0442\u044F\u043D\u0443\u0432
      \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438 \u0442\u043E\u043B\u0441\u0442\u0443\u044E
      \u0432\u0435\u0440\u0451\u0432\u043A\u0443 \u0438\u0437 \u043A\u0430\u043C\u044B\u0448\u0430.
      \u041D\u0430 \u043D\u0438\u0445 \u0441\u0435\u043C\u0435\u0440\u043E \u0441
      \u0434\u0443\u0431\u0438\u043D\u0430\u043C\u0438 \u0438 \u0431\u0430\u0433\u0440\u0430\u043C\u0438,
      \u043A\u0440\u0438\u0447\u0430\u0442 \u043F\u043E-\u0442\u044E\u0440\u043A\u0441\u043A\u0438:
      \"\u041F\u0440\u043E\u0445\u043E\u0434 \u0441\u0442\u043E\u0438\u0442 \u043F\u043E
      \u043E\u0434\u043D\u043E\u043C\u0443 \u043A\u0430\u0439\u044E\u0430\u043D\u044C-\u0442\u0443\u043D\u0431\u0430\u043E
      \u0441 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0438 \u043F\u043E
      \u0442\u0440\u0438 - \u0441 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430\".
      \u0412\u043E\u0434\u0430 \u043C\u0443\u0442\u043D\u0430\u044F \u0438 \u0431\u044B\u0441\u0442\u0440\u0430\u044F,
      \u043E\u0431\u0445\u043E\u0434\u0438\u0442\u044C \u0431\u0440\u043E\u0434 -
      \u043B\u0438\u0448\u043D\u0438\u0439 \u0434\u0435\u043D\u044C. \u0413\u0440\u0443\u0437
      \u0442\u044F\u0436\u0451\u043B\u044B\u0439, \u043F\u0435\u0440\u0435\u043F\u043B\u044B\u0442\u044C
      \u0432\u043F\u043B\u0430\u0432\u044C \u043D\u0435\u043B\u044C\u0437\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712804
    m_Localized: "\u041F\u0440\u043E\u0440\u0432\u0430\u0442\u044C \u0437\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u0438\u0435
      \u0441\u0438\u043B\u043E\u0439 - \u0440\u0443\u0431\u0438\u0442\u044C \u0432\u0435\u0440\u0451\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712805
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438 \u0434\u043E\u0441\u0442\u0438\u0433\u043B\u0438
      \u043B\u043E\u0434\u043E\u043A \u043F\u043E\u0434 \u0433\u0440\u0430\u0434\u043E\u043C
      \u0434\u0443\u0431\u0438\u043D, \u0432\u0435\u0440\u0451\u0432\u043A\u0443
      \u043F\u0435\u0440\u0435\u0440\u0443\u0431\u0438\u043B\u0438. \u0414\u0432\u043E\u0435
      \u043F\u0438\u0440\u0430\u0442\u043E\u0432 \u0443\u043F\u0430\u043B\u0438 \u0432
      \u0432\u043E\u0434\u0443, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438. \u041E\u0434\u0438\u043D
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0441\u043B\u043E\u043C\u0430\u043B
      \u0440\u0443\u043A\u0443, \u043D\u043E \u043F\u0440\u043E\u0445\u043E\u0434
      \u043E\u0442\u043A\u0440\u044B\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712806
    m_Localized: "\u0423\u0439\u0442\u0438 \u0432 \u043E\u0431\u0445\u043E\u0434
      - \u043F\u043E\u0442\u0435\u0440\u044F \u0434\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712807
    m_Localized: "\u041E\u0431\u0445\u043E\u0434 \u0437\u0430\u043D\u044F\u043B \u0446\u0435\u043B\u044B\u0439
      \u0434\u0435\u043D\u044C \u043F\u043E \u0432\u044F\u0437\u043A\u043E\u043C\u0443
      \u0431\u0435\u0440\u0435\u0433\u0443. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u0443\u0441\u0442\u0430\u043B\u0438, \u043E\u0434\u0438\u043D \u0432\u044C\u044E\u043A
      \u043D\u0430\u043C\u043E\u043A \u043F\u0440\u0438 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0435
      \u0443 \u0432\u0441\u043F\u043E\u043C\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u0431\u0440\u043E\u0434\u0430. \u0417\u0430\u0442\u043E \u0431\u0435\u0437
      \u043F\u043E\u0442\u0435\u0440\u044C \u043B\u044E\u0434\u0435\u0439 \u0438
      \u0431\u0435\u0437 \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712808
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u0443\u044E
      \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712809
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043F\u044F\u0442\u044C
      \u043C\u043E\u043D\u0435\u0442 \u043F\u0435\u0440\u0435\u0448\u043B\u0438 \u043A
      \u043F\u0438\u0440\u0430\u0442\u0430\u043C. \u0412\u0435\u0440\u0451\u0432\u043A\u0443
      \u0443\u0431\u0440\u0430\u043B\u0438, \u043E\u0431\u043E\u0437 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F.
      \u041F\u0438\u0440\u0430\u0442\u044B \u043A\u043B\u0430\u043D\u044F\u043B\u0438\u0441\u044C
      \u0441 \u0434\u0435\u043B\u0430\u043D\u043E\u0439 \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u044C\u044E.
      \u0421\u0432\u043E\u0451 \u043E\u043D\u0438 \u0431\u0435\u0440\u0443\u0442
      \u0438\u0441\u043F\u0440\u0430\u0432\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712810
    m_Localized: "\u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043E\u0442\u0440\u044F\u0434
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712811
    m_Localized: "\u041D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435 \u0447\u0435\u0442\u044B\u0440\u0451\u0445
      \u0442\u044B\u0441\u044F\u0447 \u0448\u0430\u0433\u043E\u0432 \u043D\u0430\u0434
      \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u0440\u0435\u043A\u0438 \u0442\u0440\u043E\u043F\u0443
      \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0445 \u0432\u043E\u0438\u043D\u043E\u0432
      \u0432 \u043B\u0430\u043C\u0435\u043B\u043B\u044F\u0440\u043D\u044B\u0445 \u0434\u043E\u0441\u043F\u0435\u0445\u0430\u0445
      \u0438\u0437 \u044F\u043B\u043E\u0432\u043E\u0439 \u043A\u043E\u0436\u0438.
      \u0418\u0445 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440 \u041D\u0430\u043D\u0430\u043C
      \u0441\u0442\u043E\u0438\u0442, \u043E\u043F\u0438\u0440\u0430\u044F\u0441\u044C
      \u043D\u0430 \u0434\u043B\u0438\u043D\u043D\u043E\u0435 \u043A\u043E\u043F\u044C\u0451,
      \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 \u0440\u0430\u0437\u0432\u0435\u0432\u0430\u0435\u0442\u0441\u044F
      \u0436\u0451\u043B\u0442\u044B\u0439 \u0444\u043B\u0430\u0433 \u0441 \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u043C
      \u0431\u043E\u043D. \u0412\u043E\u0437\u0434\u0443\u0445 \u0440\u0430\u0437\u0440\u0435\u0436\u0435\u043D\u043D\u044B\u0439,
      \u0433\u043E\u043B\u043E\u0441 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0430
      \u0433\u043B\u0443\u0445\u043E\u0439: \"\u042D\u0442\u0430 \u0442\u0440\u043E\u043F\u0430
      \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442 \u0422\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u043C\u0443
      \u0446\u0430\u0440\u0441\u0442\u0432\u0443. \u0414\u0430\u043D\u044C - \u0442\u0440\u0435\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430 \u0438\u043B\u0438 \u0441\u0435\u043C\u044C
      \u044F\u043A\u043E\u0432\". \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u0448\u0435\u043F\u0447\u0435\u0442: \u043E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E. \u041D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435
      \u0425\u043E\u0440\u043E\u0433 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0435
      \u043F\u043E\u0441\u0442\u044B \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C
      \u0442\u0440\u0438 \u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712812
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u0430
      - \u0441\u043D\u0438\u0437\u0438\u0442\u044C \u0434\u0430\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712813
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u0440\u043E\u0432\u0451\u043B
      \u0447\u0430\u0441 \u0432 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0430\u0445.
      \u041D\u0430\u043D\u0430\u043C \u043F\u0440\u0438\u043D\u044F\u043B \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0432\u043C\u0435\u0441\u0442\u043E
      \u044F\u043A\u043E\u0432 - \u0434\u0435\u043D\u044C\u0433\u0438 \u0434\u043B\u044F
      \u043D\u0435\u0433\u043E \u0443\u0434\u043E\u0431\u043D\u0435\u0435 \u043D\u0430
      \u0432\u044B\u0441\u043E\u0442\u0435. \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B.
      \u0423\u0434\u0430\u0447\u0430: \u0445\u043E\u0440\u043E\u0448\u0438\u0439
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0441\u0442\u043E\u0438\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043B\u044E\u0431\u043E\u0439 \u043E\u0445\u0440\u0430\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712814
    m_Localized: "\u0410\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C - \u0443
      \u043D\u0430\u0441 \u0431\u043E\u043B\u044C\u0448\u0435 \u043B\u044E\u0434\u0435\u0439
      \u043D\u0430 \u0443\u0437\u043A\u043E\u0439 \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712815
    m_Localized: "\u0411\u043E\u0439 \u043D\u0430 \u0443\u0437\u043A\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435 \u0442\u044F\u0436\u0451\u043B\u044B\u0439.
      \u0414\u0432\u043E\u0435 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432
      \u0440\u0430\u043D\u0435\u043D\u044B. \u0422\u0438\u0431\u0435\u0442\u0446\u044B
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438, \u0443\u043D\u0435\u0441\u044F
      \u0441\u0432\u043E\u0438\u0445. \u041D\u043E \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u0435\u0449\u0451 \u0434\u0432\u0430 \u0434\u043D\u044F \u0432 \u0433\u043E\u0440\u0430\u0445
      - \u043F\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u044E\u0442,
      \u0447\u0442\u043E \u043E\u0442\u0440\u044F\u0434 \u041D\u0430\u043D\u0430\u043C\u0430
      \u043C\u043E\u0436\u0435\u0442 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0441 \u043F\u043E\u0434\u043C\u043E\u0433\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712816
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u0442\u0440\u0438 \u044F\u043A\u0430
      - \u0434\u0435\u0448\u0435\u0432\u043B\u0435 \u043A\u0440\u043E\u0432\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712817
    m_Localized: "\u041D\u0430\u043D\u0430\u043C \u043F\u0440\u0438\u043D\u044F\u043B
      \u044F\u043A\u043E\u0432 \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C.
      \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B \u0447\u0435\u0440\u0435\u0437
      \u043F\u043E\u0441\u0442 \u0431\u0435\u0437 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438.
      \u0422\u0440\u0438 \u044F\u043A\u0430 - \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u0430\u044F
      \u043F\u043E\u0442\u0435\u0440\u044F \u0442\u044F\u0433\u043B\u043E\u0432\u043E\u0439
      \u0441\u0438\u043B\u044B, \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0439\u0441\u044F
      \u043F\u0443\u0442\u044C \u043F\u043E \u0433\u043E\u0440\u0430\u043C \u0441\u0442\u0430\u043D\u0435\u0442
      \u0442\u044F\u0436\u0435\u043B\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712818
    m_Localized: "\u0417\u0430\u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
      \u043B\u043E\u0432\u0443\u0448\u043A\u0430 \u0441 \u0448\u0438\u043F\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712819
    m_Localized: "\u0423 \u043E\u0430\u0437\u0438\u0441\u0430 \u042F\u043B\u043A\u0430\u043D\u0433
      \u043D\u0430 \u043F\u0440\u0438\u0431\u0440\u0435\u0436\u043D\u043E\u043C \u043F\u0435\u0441\u043A\u0435
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0421\u0430\u043C\u0435\u0445
      \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442 \u043B\u0451\u0433\u043A\u0443\u044E
      \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u044E - \u0437\u0435\u043C\u043B\u044F
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0440\u043E\u0432\u043D\u0430\u044F \u0438 \u0447\u0443\u0442\u044C \u0442\u0435\u043C\u043D\u0435\u0435.
      \u041F\u043E\u0434 \u0442\u0440\u043E\u0441\u0442\u043D\u0438\u043A\u043E\u0432\u044B\u043C
      \u043C\u0430\u0442\u043E\u043C, \u043F\u0440\u0438\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u043C
      \u043F\u0435\u0441\u043A\u043E\u043C, - \u0440\u044F\u0434\u044B \u0437\u0430\u043E\u0441\u0442\u0440\u0451\u043D\u043D\u044B\u0445
      \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0445 \u043A\u043E\u043B\u044C\u0435\u0432,
      \u0441\u043C\u0430\u0437\u0430\u043D\u043D\u044B\u0445 \u0447\u0451\u0440\u043D\u043E\u0439
      \u0441\u043C\u043E\u043B\u043E\u0439 \u0441 \u043F\u0440\u0438\u043C\u0435\u0441\u044C\u044E
      \u0442\u043E\u043B\u0447\u0451\u043D\u044B\u0445 \u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D\u043E\u0432.
      \u041B\u043E\u0432\u0443\u0448\u043A\u0430 \u0441\u0432\u0435\u0436\u0430\u044F,
      \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u043D\u043E\u0447\u044C\u044E.
      \u041A\u0442\u043E-\u0442\u043E \u0436\u0434\u0451\u0442 \u043E\u0431\u043E\u0437\u0430
      \u0438\u043B\u0438 \u0443\u0436\u0435 \u0443\u0448\u0451\u043B? \u0428\u0438\u043F\u044B
      \u043B\u0435\u0433\u043A\u043E \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u044E\u0442
      \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u044C\u0438 \u043F\u043E\u0434\u0443\u0448\u043A\u0438
      \u043B\u0430\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712820
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u043B\u043E\u0432\u0443\u0448\u043A\u0443
      \u0438 \u0438\u0441\u043A\u0430\u0442\u044C \u0437\u0430\u0441\u0430\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712821
    m_Localized: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u0439 \u043E\u0431\u0445\u043E\u0434
      \u0432\u043F\u0440\u0430\u0432\u043E \u0441\u043F\u0430\u0441 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445.
      \u041F\u043E\u0438\u0441\u043A \u0437\u0430\u0441\u0430\u0434\u044B \u0434\u0430\u043B
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 - \u0441\u043B\u0435\u0434\u044B
      \u0442\u0440\u0451\u0445 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0443\u0445\u043E\u0434\u0438\u043B\u0438
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0431\u0430\u0440\u0445\u0430\u043D\u043E\u0432.
      \u041B\u043E\u0432\u0443\u0448\u043A\u0443 \u0440\u0430\u0441\u043A\u0440\u044B\u043B\u0438
      \u0432\u043E\u0432\u0440\u0435\u043C\u044F. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0421\u0430\u043C\u0435\u0445 \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u043B
      \u0434\u0432\u043E\u0439\u043D\u0443\u044E \u0434\u043E\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712822
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0441\u043A\u0432\u043E\u0437\u044C
      - \u043B\u043E\u0432\u0443\u0448\u043A\u0430 \u043D\u0435 \u0434\u043B\u044F
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712823
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u0432\u0441\u0442\u0430\u043B \u043D\u0430 \u043C\u0430\u0442 \u0438 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0441\u044F.
      \u0414\u0432\u0430 \u0448\u0438\u043F\u0430 \u043F\u0440\u043E\u0431\u0438\u043B\u0438
      \u043B\u0430\u043F\u0443. \u041B\u0435\u0447\u0435\u043D\u0438\u0435 \u0437\u0430\u043D\u044F\u043B\u043E
      \u043F\u043E\u043B\u0434\u043D\u044F, \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435
      \u0445\u0440\u043E\u043C\u0430\u0435\u0442. \u042F\u0434 \u043B\u0451\u0433\u043A\u0438\u0439,
      \u043D\u0435 \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u044B\u0439,
      \u043D\u043E \u0442\u0435\u043C\u043F \u043F\u043E\u0442\u0435\u0440\u044F\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712824
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C
      - \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0432\u0435\u0441\u044C
      \u043E\u0430\u0437\u0438\u0441 \u0434\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712825
    m_Localized: "\u0427\u0430\u0441\u043E\u0432\u043E\u0439 \u043E\u0441\u043C\u043E\u0442\u0440
      \u0432\u044B\u044F\u0432\u0438\u043B \u0435\u0449\u0451 \u0434\u0432\u0435
      \u0437\u0430\u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
      \u043B\u043E\u0432\u0443\u0448\u043A\u0438 \u0443 \u0432\u043E\u0434\u043E\u043F\u043E\u044F.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0434\u0435\u043D\u044C,
      \u0437\u0430\u0442\u043E \u043F\u0440\u043E\u0448\u043B\u0438 \u043E\u0430\u0437\u0438\u0441
      \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C. \u041B\u044E\u0434\u0438
      \u0443\u0441\u0442\u0430\u043B\u0438 \u043E\u0442 \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F,
      \u043D\u043E \u0433\u0440\u0443\u0437 \u0446\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712826
    m_Localized: "\u041D\u0430\u0451\u043C\u043D\u044B\u0435 \u043C\u0435\u0447\u043D\u0438\u043A\u0438
      \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289600712827
    m_Localized: "\u041D\u0430 \u043F\u043E\u043B\u0443\u0434\u043D\u0435 \u0434\u043E\u0440\u043E\u0433\u0438
      \u043A \u041C\u0435\u0440\u0432\u0443 \u0442\u0440\u043E\u0435 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0445
      \u043C\u0443\u0436\u0447\u0438\u043D \u043F\u0440\u0435\u0433\u0440\u0430\u0436\u0434\u0430\u044E\u0442
      \u043F\u0443\u0442\u044C. \u041E\u0434\u0435\u0442\u044B \u0447\u0438\u0441\u0442\u043E,
      \u043B\u043E\u0448\u0430\u0434\u0438 \u0445\u043E\u043B\u0451\u043D\u044B\u0435
      - \u043D\u0435 \u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0431\u0435\u0437 \u0443\u0433\u0440\u043E\u0437, \u043F\u043E-\u0430\u0440\u0430\u0431\u0441\u043A\u0438:
      \"\u041A\u0443\u043F\u0435\u0446 \u042E\u0441\u0443\u0444 \u0430\u043B\u044C-\u0425\u0430\u043C\u0434\u0430\u043D\u0438
      \u043F\u0440\u043E\u0441\u0438\u0442 \u0432\u0430\u0441 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0432 \u041D\u0438\u0448\u0430\u043F\u0443\u0440. \u041E\u043D \u0443\u0436\u0435
      \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0448\u0451\u043B\u043A \u0432
      \u041C\u0435\u0440\u0432 \u0438 \u0432\u0430\u0448 \u0442\u043E\u0432\u0430\u0440
      \u0442\u0430\u043C \u043D\u0438\u043A\u043E\u043C\u0443 \u043D\u0435 \u043D\u0443\u0436\u0435\u043D\".
      \u042D\u0442\u043E \u043D\u0435\u043F\u0440\u0430\u0432\u0434\u0430 \u0438\u043B\u0438
      \u043F\u0440\u0430\u0432\u0434\u0430 - \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E.
      \u041D\u043E \u0442\u0440\u0438 \u043C\u0435\u0447\u0430 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435
      - \u0444\u0430\u043A\u0442. \u0421\u043E\u043F\u0435\u0440\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u043D\u0430 \u0425\u043E\u0440\u0430\u0441\u0430\u043D\u0441\u043A\u043E\u043C
      \u0442\u0440\u0430\u043A\u0442\u0435 \u0438\u0434\u0451\u0442 \u043D\u0435
      \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u043C\u0438
      \u043C\u0435\u0442\u043E\u0434\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907008
    m_Localized: "\u041F\u0440\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F \u0441
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430\u043C\u0438 - \u043D\u0435
      \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907009
    m_Localized: "\u0421\u0445\u0432\u0430\u0442\u043A\u0430 \u0432\u044B\u0448\u043B\u0430
      \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0439 - \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u0438
      \u043D\u0435 \u043E\u0436\u0438\u0434\u0430\u043B\u0438 \u0440\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438.
      \u041E\u0434\u0438\u043D \u0431\u0440\u043E\u0441\u0438\u043B \u043E\u0440\u0443\u0436\u0438\u0435
      \u0441\u0440\u0430\u0437\u0443, \u0434\u0432\u043E\u0435 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438.
      \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0440\u0430\u043D\u0435\u043D
      \u0432 \u043F\u043B\u0435\u0447\u043E. \u0414\u043E\u0440\u043E\u0433\u0430
      \u043E\u0442\u043A\u0440\u044B\u0442\u0430, \u043D\u043E \u042E\u0441\u0443\u0444
      \u0443\u0437\u043D\u0430\u0435\u0442 \u043E\u0431 \u044D\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907010
    m_Localized: "\u0412\u044B\u043A\u0443\u043F\u0438\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0443
      - \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0438\u043C \u043B\u0438\u0447\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907011
    m_Localized: "\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043F\u0440\u044F\u043C\u043E \u0432 \u0438\u0445 \u043A\u0430\u0440\u043C\u0430\u043D\u044B
      - \u0438 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u0438 \u0440\u0430\u0441\u0441\u0442\u0443\u043F\u0438\u043B\u0438\u0441\u044C.
      \u042E\u0441\u0443\u0444 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442, \u0430 \u0435\u0433\u043E \u043B\u044E\u0434\u0438
      \u043F\u0440\u0435\u0434\u0430\u0434\u0443\u0442 \u0435\u0433\u043E \u043B\u0435\u0433\u043A\u043E.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430,
      \u0434\u0435\u043D\u044C\u0433\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907012
    m_Localized: "\u041F\u0440\u0438\u0433\u0440\u043E\u0437\u0438\u0442\u044C \u0436\u0430\u043B\u043E\u0431\u043E\u0439
      \u0432 \u043C\u0435\u0441\u0442\u043D\u0443\u044E \u0443\u043F\u0440\u0430\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907013
    m_Localized: "\u0423\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435 \u0430\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u043E\u0433\u043E
      \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u0430 \u0432 \u041C\u0435\u0440\u0432\u0435
      \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u043E. \u041D\u0430\u0451\u043C\u043D\u0438\u043A\u0438
      \u043D\u0435\u0440\u0432\u043D\u043E \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u043B\u0438\u0441\u044C
      \u0438 \u0443\u0448\u043B\u0438 \u043F\u0440\u043E\u0447\u044C. \u042E\u0441\u0443\u0444
      \u044F\u0432\u043D\u043E \u043D\u0435 \u043F\u043B\u0430\u0442\u0438\u043B
      \u0438\u043C \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C
      \u0437\u0430\u043A\u043E\u043D\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907014
    m_Localized: "\u0421\u0431\u0435\u0436\u0430\u0432\u0448\u0438\u0439 \u0442\u0430\u043D\u0441\u043A\u0438\u0439
      \u0441\u043E\u043B\u0434\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907015
    m_Localized: "\u041D\u0430 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0435 \u0434\u043E\u0440\u043E\u0433
      \u0443 \u0442\u043E\u043F\u043E\u043B\u0435\u0439 \u0441\u0442\u043E\u0438\u0442
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432 \u0440\u0432\u0430\u043D\u043E\u043C
      \u0442\u0430\u043D\u0441\u043A\u043E\u043C \u043C\u0443\u043D\u0434\u0438\u0440\u0435
      - \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0447\u0430\u0442\u044B\u0439
      \u0434\u043E\u0441\u043F\u0435\u0445 \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u0441\u043D\u044F\u0442, \u0432\u043E\u0440\u043E\u0442 \u0440\u0430\u0437\u043E\u0440\u0432\u0430\u043D.
      \u0411\u044B\u0432\u0448\u0438\u0439 \u0441\u043E\u043B\u0434\u0430\u0442 \u0434\u0435\u0440\u0436\u0438\u0442
      \u043A\u043E\u043F\u044C\u0451 \u043E\u0431\u0435\u0438\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438.
      \u041B\u0438\u0446\u043E \u0438\u0437\u043D\u0443\u0440\u0451\u043D\u043D\u043E\u0435,
      \u043D\u043E \u0432\u0437\u0433\u043B\u044F\u0434 \u0442\u0432\u0451\u0440\u0434\u044B\u0439.
      \u041F\u043E-\u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438: \"\u0414\u0430\u0439\u0442\u0435
      \u0435\u0434\u044B \u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u0430. \u041C\u043D\u0435
      \u043D\u0435 \u043D\u0443\u0436\u043D\u044B \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0432\u0430\u043C \u0442\u043E\u0436\u0435\". \u0414\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u0441\u0442\u0432\u043E
      \u0438\u0437 \u0442\u0430\u043D\u0441\u043A\u043E\u0439 \u0430\u0440\u043C\u0438\u0438
      \u043A\u0430\u0440\u0430\u0435\u0442\u0441\u044F \u0441\u043C\u0435\u0440\u0442\u044C\u044E.
      \u0421\u043E\u043B\u0434\u0430\u0442 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
      \u043E\u043F\u0430\u0441\u0435\u043D \u0438\u043C\u0435\u043D\u043D\u043E \u043F\u043E\u0442\u043E\u043C\u0443,
      \u0447\u0442\u043E \u0442\u0435\u0440\u044F\u0442\u044C \u0435\u043C\u0443
      \u043D\u0435\u0447\u0435\u0433\u043E. \u0415\u0433\u043E \u0438\u043C\u044F
      - \u0427\u044D\u043D\u044C \u042E\u0439, \u0440\u044F\u0434\u043E\u0432\u043E\u0439
      \u0410\u043D\u044C\u0441\u0438\u0439\u0441\u043A\u043E\u0433\u043E \u0433\u0430\u0440\u043D\u0438\u0437\u043E\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907016
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0435
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B \u0438 \u043F\u0440\u043E\u0435\u0445\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907017
    m_Localized: "\u0427\u044D\u043D\u044C \u042E\u0439 \u043F\u0440\u043E\u0447\u0451\u043B
      \u043F\u0435\u0447\u0430\u0442\u044C \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u0430
      \u0438 \u043E\u043F\u0443\u0441\u0442\u0438\u043B \u043A\u043E\u043F\u044C\u0451.
      \"\u041B\u044E\u0434\u0438 \u0441 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438
      - \u043D\u0435 \u043C\u043E\u0438 \u0432\u0440\u0430\u0433\u0438\", \u0441\u043A\u0430\u0437\u0430\u043B
      \u043E\u043D. \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0435\u0445\u0430\u043B
      \u0431\u0435\u0437 \u043F\u043B\u0430\u0442\u044B. \u0414\u0435\u0437\u0435\u0440\u0442\u0438\u0440
      \u0443\u0448\u0451\u043B \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043E\u0442 \u0434\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907018
    m_Localized: "\u0414\u0430\u0442\u044C \u0435\u0434\u044B \u0438 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 - \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907019
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442 \u0432\u0437\u044F\u043B \u0435\u0434\u0443
      \u043C\u043E\u043B\u0447\u0430 \u0438 \u043A\u0438\u0432\u043D\u0443\u043B.
      \u0421\u0435\u0440\u0435\u0431\u0440\u043E \u043E\u043D \u0441\u043F\u0440\u044F\u0442\u0430\u043B
      \u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u0443. \u0423\u0448\u0451\u043B
      \u043D\u0430 \u0441\u0435\u0432\u0435\u0440 - \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435
      \u043E\u0442 \u0442\u0430\u043D\u0441\u043A\u0438\u0445 \u0433\u0430\u0440\u043D\u0438\u0437\u043E\u043D\u043E\u0432.
      \u0414\u043E\u0431\u0440\u044B\u0439 \u0436\u0435\u0441\u0442, \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u043F\u043E\u0442\u0435\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907020
    m_Localized: "\u0410\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C - \u043E\u043D
      \u043E\u0434\u0438\u043D, \u043D\u0430\u0441 \u043C\u043D\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907021
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043E\u043F\u044B\u0442\u043D\u044B\u043C \u0431\u043E\u0439\u0446\u043E\u043C.
      \u0420\u0430\u043D\u0438\u043B \u0434\u0432\u043E\u0438\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432
      \u043F\u0440\u0435\u0436\u0434\u0435, \u0447\u0435\u043C \u0435\u0433\u043E
      \u043E\u0431\u0435\u0437\u043E\u0440\u0443\u0436\u0438\u043B\u0438. \u0415\u0433\u043E
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0441\u0432\u044F\u0437\u0430\u0442\u044C
      \u0438 \u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0443 \u0434\u043E\u0440\u043E\u0433\u0438.
      \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B, \u043D\u043E
      \u0441 \u043F\u043E\u0442\u0435\u0440\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907022
    m_Localized: "\u0428\u0430\u043A\u0430\u043B\u044B \u0432 \u043D\u043E\u0447\u043D\u043E\u043C
      \u043B\u0430\u0433\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907023
    m_Localized: "\u041F\u0435\u0440\u0435\u0434 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u043E\u043C
      \u0438\u0437 \u0442\u0435\u043C\u043D\u043E\u0442\u044B \u043D\u0435\u0441\u0443\u0442\u0441\u044F
      \u043F\u0440\u043E\u043D\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0442\u044F\u0432\u043A\u0430\u044E\u0449\u0438\u0435 \u043A\u0440\u0438\u043A\u0438
      - \u0430\u0437\u0438\u0430\u0442\u0441\u043A\u0438\u0435 \u0448\u0430\u043A\u0430\u043B\u044B,
      \u0442\u0440\u0438 \u0438\u043B\u0438 \u0447\u0435\u0442\u044B\u0440\u0435
      \u043E\u0441\u043E\u0431\u0438, \u0440\u0430\u0437\u043E\u0440\u0438\u043B\u0438
      \u043C\u0435\u0448\u043A\u0438 \u0441 \u0437\u0435\u0440\u043D\u043E\u043C
      \u0443 \u043A\u0440\u0430\u044F \u043B\u0430\u0433\u0435\u0440\u044F. \u041E\u043D\u0438
      \u043D\u0435 \u0431\u043E\u044F\u0442\u0441\u044F \u0441\u043F\u044F\u0449\u0438\u0445
      \u043B\u044E\u0434\u0435\u0439 \u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442
      \u0431\u044B\u0441\u0442\u0440\u043E: \u043E\u0441\u0442\u0440\u044B\u0435
      \u0437\u0443\u0431\u044B \u0432\u0441\u043F\u0430\u0440\u044B\u0432\u0430\u044E\u0442
      \u043C\u0435\u0448\u043A\u043E\u0432\u0438\u043D\u0443 \u0437\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u044B.
      \u041E\u0434\u0438\u043D \u0448\u0430\u043A\u0430\u043B \u0443\u0436\u0435
      \u0442\u0430\u0449\u0438\u0442 \u043A\u0443\u0441\u043E\u043A \u0432\u044F\u043B\u0435\u043D\u043E\u0433\u043E
      \u043C\u044F\u0441\u0430. \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u0411\u0438\u043B\u044C\u0433\u044D \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F
      \u043F\u0435\u0440\u0432\u044B\u043C. \u0417\u0430\u043F\u0430\u0445 \u0437\u0435\u0440\u043D\u0430
      \u043D\u0430 \u0437\u0435\u043C\u043B\u0435 \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u0451\u0442
      \u0435\u0449\u0451 \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u0430\u0434\u0430\u043B\u044C\u0449\u0438\u043A\u043E\u0432
      \u043A \u0443\u0442\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907024
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u0432 \u043D\u0438\u0445
      \u0433\u043E\u0440\u044F\u0449\u0435\u0439 \u0433\u043E\u043B\u043E\u0432\u043D\u0451\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907025
    m_Localized: "\u041E\u0433\u043E\u043D\u044C \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E - \u0448\u0430\u043A\u0430\u043B\u044B
      \u0431\u0440\u043E\u0441\u0438\u043B\u0438\u0441\u044C \u0432\u0440\u0430\u0441\u0441\u044B\u043F\u043D\u0443\u044E.
      \u041F\u044F\u0442\u044C \u043C\u0435\u0448\u043A\u043E\u0432 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u043E,
      \u0437\u0435\u0440\u043D\u043E \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
      \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u043E\u0441\u044C, \u043D\u043E
      \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u043E\u0431\u0440\u0430\u0442\u043D\u043E.
      \u041F\u043E\u0442\u0435\u0440\u044F \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907026
    m_Localized: "\u041E\u0442\u043F\u0443\u0433\u043D\u0443\u0442\u044C \u043A\u0440\u0438\u043A\u043E\u043C
      \u0438 \u0445\u043B\u043E\u043F\u043A\u0430\u043C\u0438 - \u043D\u0435 \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C
      \u043E\u0433\u043D\u0451\u043C \u0443 \u0442\u044E\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907027
    m_Localized: "\u0428\u0430\u043A\u0430\u043B\u044B \u0443\u0445\u043E\u0434\u0438\u043B\u0438
      \u043D\u0435\u043E\u0445\u043E\u0442\u043D\u043E, \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0438\u0441\u044C
      \u0434\u0432\u0430\u0436\u0434\u044B. \u041A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443
      \u0432\u043E\u0441\u0435\u043C\u044C \u043C\u0435\u0448\u043A\u043E\u0432 \u0437\u0435\u0440\u043D\u0430
      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u043E. \u0413\u0440\u0443\u0437
      \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B \u0437\u0430\u043C\u0435\u0442\u043D\u043E.
      \u0411\u0438\u043B\u044C\u0433\u044D \u043F\u0440\u043E\u043C\u0430\u044F\u043B\u0441\u044F
      \u0434\u043E \u0443\u0442\u0440\u0430 \u0431\u0435\u0437 \u0441\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907028
    m_Localized: "\u0412\u044B\u0441\u043B\u0430\u0442\u044C \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430
      \u0441 \u0434\u0443\u0431\u0438\u043D\u043E\u0439 - \u043F\u0440\u043E\u0433\u043D\u0430\u0442\u044C
      \u0432\u0440\u0443\u0447\u043D\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907029
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0443\u043A\u0443\u0441 \u0437\u0430 \u0433\u043E\u043B\u0435\u043D\u044C,
      \u043F\u043E\u043A\u0430 \u043F\u0440\u043E\u0433\u043E\u043D\u044F\u043B \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
      \u0448\u0430\u043A\u0430\u043B\u0430. \u041D\u0435\u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439,
      \u043D\u043E \u0431\u043E\u043B\u0435\u0437\u043D\u0435\u043D\u043D\u044B\u0439.
      \u0428\u0430\u043A\u0430\u043B\u044B \u0443\u0448\u043B\u0438. \u041C\u0435\u0448\u043A\u0438
      \u0441 \u0437\u0435\u0440\u043D\u043E\u043C \u0441\u043F\u0430\u0441\u0435\u043D\u044B
      \u043F\u043E\u0447\u0442\u0438 \u0432\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907030
    m_Localized: "\u0421\u043D\u0435\u0436\u043D\u044B\u0439 \u0431\u0430\u0440\u0441
      \u0443\u0442\u0430\u0449\u0438\u043B \u044F\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907031
    m_Localized: "\u0420\u0430\u043D\u043D\u0438\u043C \u0443\u0442\u0440\u043E\u043C
      \u043D\u0430 \u0433\u043E\u0440\u043D\u043E\u0439 \u0442\u0440\u043E\u043F\u0435
      \u0443 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430 \u0410\u043A-\u0411\u0430\u0439\u0442\u0430\u043B
      \u043E\u0431\u043E\u0437 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0435\u0442,
      \u0447\u0442\u043E \u043E\u0434\u0438\u043D \u0432\u044C\u044E\u0447\u043D\u044B\u0439
      \u044F\u043A \u0438\u0441\u0447\u0435\u0437. \u0421\u043B\u0435\u0434\u044B
      \u043D\u0430 \u0441\u043D\u0435\u0433\u0443 \u0447\u0438\u0442\u0430\u044E\u0442\u0441\u044F
      \u044F\u0441\u043D\u043E: \u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043C\u044F\u0433\u043A\u0438\u0435
      \u043B\u0430\u043F\u044B \u0434\u043B\u0438\u043D\u043E\u0439 \u0432 \u043B\u0430\u0434\u043E\u043D\u044C
      \u0432\u0437\u0440\u043E\u0441\u043B\u043E\u0433\u043E \u043C\u0443\u0436\u0447\u0438\u043D\u044B
      - \u0441\u043D\u0435\u0436\u043D\u044B\u0439 \u0431\u0430\u0440\u0441 \u043D\u0430\u043F\u0430\u043B
      \u043D\u043E\u0447\u044C\u044E \u0438 \u0443\u0442\u0430\u0449\u0438\u043B
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u0437\u0430 \u0443\u0441\u0442\u0443\u043F.
      \u0422\u0440\u043E\u043F\u0430 \u043D\u0430 \u0443\u0441\u0442\u0443\u043F
      \u0432\u0435\u0434\u0451\u0442 \u0432\u043D\u0438\u0437. \u0422\u0430\u043C
      \u043B\u0435\u0436\u0438\u0442 \u0440\u0430\u0441\u0442\u0435\u0440\u0437\u0430\u043D\u043D\u044B\u0439
      \u044F\u043A \u0438 \u0440\u044F\u0434\u043E\u043C, \u043B\u0451\u0436\u0430,
      \u0431\u0430\u0440\u0441 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u043B\u044E\u0434\u0435\u0439 \u0436\u0451\u043B\u0442\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438.
      \u041E\u043D \u043D\u0435 \u0443\u0431\u0435\u0436\u0430\u043B - \u0434\u043E\u0431\u044B\u0447\u0430
      \u0435\u0433\u043E. \u041F\u043E\u0442\u0435\u0440\u044F\u043D \u044F\u043A
      \u0441 \u0447\u0430\u0441\u0442\u044C\u044E \u0433\u0440\u0443\u0437\u0430
      \u043D\u0430 \u0441\u043F\u0438\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907032
    m_Localized: "\u0423\u0439\u0442\u0438 - \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435
      \u043D\u0435 \u0442\u0440\u043E\u043D\u0443\u0442\u044C, \u0431\u0430\u0440\u0441
      \u0441\u0432\u044F\u0449\u0435\u043D\u0435\u043D \u0432 \u0433\u043E\u0440\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907033
    m_Localized: "\u041E\u0431\u043E\u0437 \u0442\u0440\u043E\u043D\u0443\u043B\u0441\u044F
      \u0431\u0435\u0437 \u044F\u043A\u0430. \u0413\u0440\u0443\u0437 \u043F\u0435\u0440\u0435\u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B\u0438
      \u043C\u0435\u0436\u0434\u0443 \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u043C\u0438\u0441\u044F
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u043C\u0438. \u041C\u0435\u0441\u0442\u043D\u044B\u0439
      \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0422\u0440\u0438\u0434\u044D
      \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B\u0438
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E - \u0443\u0431\u0438\u0442\u044C
      \u0431\u0430\u0440\u0441\u0430 \u0432 \u0433\u043E\u0440\u0430\u0445 \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442
      \u043D\u0430\u0432\u043B\u0435\u0447\u044C \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u044C\u044F
      \u043D\u0430 \u0432\u0435\u0441\u044C \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907034
    m_Localized: "\u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C \u0431\u0430\u0440\u0441\u0430
      \u0438 \u0441\u043F\u0430\u0441\u0442\u0438 \u0445\u043E\u0442\u044C \u0447\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907035
    m_Localized: "\u0411\u0430\u0440\u0441 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B
      \u043F\u043E\u0441\u043B\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      \u043A\u0430\u043C\u043D\u0435\u0439 \u0438 \u043A\u0440\u0438\u043A\u0430,
      \u043D\u043E \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0432\u0437\u043C\u0430\u0445\u043D\u0443\u043B \u043B\u0430\u043F\u043E\u0439.
      \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0435\u0434\u0432\u0430 \u0443\u0441\u043F\u0435\u043B
      \u043E\u0442\u0448\u0430\u0442\u043D\u0443\u0442\u044C\u0441\u044F. \u0427\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043D\u044F\u0442\u044C
      \u0441 \u044F\u043A\u0430. \u0411\u0430\u0440\u0441 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907036
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0431\u0430\u0440\u0441\u0443
      \u0442\u0443\u0448\u0443 \u0438 \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0438
      - \u043E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907037
    m_Localized: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0435\u0448\u043A\u043E\u0432
      \u0435\u0434\u044B \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0440\u044F\u0434\u043E\u043C.
      \u0411\u0430\u0440\u0441 \u043D\u0435 \u043F\u0440\u0435\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B
      \u043E\u0431\u043E\u0437 \u0434\u0430\u043B\u044C\u0448\u0435. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0422\u0440\u0438\u0434\u044D \u0434\u043E\u0432\u043E\u043B\u0435\u043D:
      \u0442\u0435\u043F\u0435\u0440\u044C \u0434\u0443\u0445 \u044D\u0442\u043E\u0433\u043E
      \u043F\u0440\u043E\u0445\u043E\u0434\u0430 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0441\u0432\u043E\u044E \u0434\u043E\u043B\u044E \u0438 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907038
    m_Localized: "\u0413\u043E\u0440\u0446\u044B \u043D\u0430 \u0443\u0437\u043A\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907039
    m_Localized: "\u0428\u0435\u0441\u0442\u0435\u0440\u043E \u043A\u0440\u0435\u043F\u043A\u0438\u0445
      \u0433\u043E\u0440\u0446\u0435\u0432 \u0432 \u0433\u0440\u0443\u0431\u044B\u0445
      \u0448\u0435\u0440\u0441\u0442\u044F\u043D\u044B\u0445 \u043D\u0430\u043A\u0438\u0434\u043A\u0430\u0445
      \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0442\u0440\u043E\u043F\u0443
      \u0443 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430 \u0441\u043A\u0430\u043B\u044B.
      \u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0434\u0443\u0431\u0438\u043D\u0430
      \u0438\u043B\u0438 \u0443\u0432\u0435\u0441\u0438\u0441\u0442\u044B\u0439 \u043A\u0430\u043C\u0435\u043D\u044C
      \u0432 \u0440\u0443\u043A\u0435. \u0421\u0442\u0430\u0440\u0448\u0438\u0439
      - \u0432\u044B\u0441\u043E\u043A\u0438\u0439, \u0441 \u043A\u043E\u0441\u043E\u0439
      \u0447\u0451\u0440\u043D\u043E\u0439 \u0431\u043E\u0440\u043E\u0434\u043E\u0439
      - \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043F\u0430\u043B\u044C\u0446\u0435\u043C
      \u043D\u0430 \u0442\u044E\u043A\u0438. \u0422\u0440\u043E\u043F\u0430 \u0448\u0438\u0440\u0438\u043D\u043E\u0439
      \u0432 \u0434\u0432\u0430 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430,
      \u0441\u043B\u0435\u0432\u0430 \u043E\u0442\u0432\u0435\u0441\u043D\u0430\u044F
      \u0441\u0442\u0435\u043D\u0430, \u0441\u043F\u0440\u0430\u0432\u0430 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C.
      \u041E\u0442\u0440\u044F\u0434 \u043D\u0435 \u043F\u043E\u0445\u043E\u0436
      \u043D\u0430 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432 - \u0441\u043A\u043E\u0440\u0435\u0435
      \u0433\u043E\u0440\u043D\u044B\u0435 \u043F\u0430\u0441\u0442\u0443\u0445\u0438,
      \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u043F\u043B\u043E\u0445\u043E \u0437\u0438\u043C\u043E\u0439.
      \u0414\u0443\u0431\u0438\u043D\u044B \u043F\u0440\u043E\u0442\u0438\u0432 \u043C\u0435\u0447\u0430
      \u043D\u0430 \u0443\u0437\u043A\u043E\u0439 \u0442\u0440\u043E\u043F\u0435
      - \u043E\u043F\u0430\u0441\u043D\u043E\u0435 \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907040
    m_Localized: "\u0423\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0437\u0430\u0432\u0430\u043B
      \u0441\u0437\u0430\u0434\u0438 - \u043E\u0442\u0440\u0435\u0437\u0430\u0442\u044C
      \u043E\u0442\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435 \u0438 \u0434\u0430\u0432\u0438\u0442\u044C
      \u0441\u043F\u0435\u0440\u0435\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907041
    m_Localized: "\u0422\u0430\u043A\u0442\u0438\u043A\u0430 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430:
      \u0433\u043E\u0440\u0446\u044B, \u0437\u0430\u0436\u0430\u0442\u044B\u0435
      \u0441 \u043E\u0431\u043E\u0438\u0445 \u043A\u043E\u043D\u0446\u043E\u0432,
      \u0431\u0440\u043E\u0441\u0438\u043B\u0438 \u043A\u0430\u043C\u043D\u0438 \u0438
      \u043F\u043E\u0434\u043D\u044F\u043B\u0438 \u0440\u0443\u043A\u0438. \u041E\u0431\u043E\u0437
      \u043F\u0440\u043E\u0448\u0451\u043B \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0447\u0430\u0441 \u043D\u0430
      \u043C\u0430\u043D\u0451\u0432\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907042
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u043E\u0431\u0445\u043E\u0434 \u043F\u043E
      \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u043C\u0443 \u0443\u0449\u0435\u043B\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907043
    m_Localized: "\u041E\u0431\u0445\u043E\u0434 \u0437\u0430\u043D\u044F\u043B \u043F\u043E\u043B\u0442\u043E\u0440\u0430
      \u0434\u043D\u044F \u043F\u043E \u043A\u0440\u0443\u0442\u043E\u043C\u0443
      \u0443\u0449\u0435\u043B\u044C\u044E. \u041E\u0434\u0438\u043D \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0441\u044F
      \u043D\u0430 \u043C\u043E\u043A\u0440\u043E\u043C \u043A\u0430\u043C\u043D\u0435
      \u0438 \u0443\u0448\u0438\u0431 \u043A\u043E\u043B\u0435\u043D\u043E. \u0413\u043E\u0440\u0446\u0435\u0432
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438.
      \u041F\u043E\u0442\u0435\u0440\u044F \u0432\u0440\u0435\u043C\u0435\u043D\u0438
      \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907044
    m_Localized: "\u0414\u0430\u0442\u044C \u043F\u043E \u043E\u0434\u043D\u043E\u0439
      \u043C\u043E\u043D\u0435\u0442\u0435 \u043A\u0430\u0436\u0434\u043E\u043C\u0443
      \u0438 \u043F\u0440\u043E\u0439\u0442\u0438 \u0441 \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907045
    m_Localized: "\u0428\u0435\u0441\u0442\u044C \u043C\u043E\u043D\u0435\u0442 -
      \u043D\u0438\u0447\u0442\u043E \u0440\u044F\u0434\u043E\u043C \u0441\u043E
      \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C\u044E \u0433\u0440\u0443\u0437\u0430.
      \u0413\u043E\u0440\u0446\u044B \u0440\u0430\u0441\u0441\u0442\u0443\u043F\u0438\u043B\u0438\u0441\u044C.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445 \u043A\u0438\u0432\u043D\u0443\u043B
      \u0441 \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u043E\u043C.
      \u041D\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u043C \u043F\u0443\u0442\u0438
      \u0443 \u044D\u0442\u043E\u0433\u043E \u043F\u0440\u043E\u0445\u043E\u0434\u0430
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907046
    m_Localized: "\u041E\u0441\u043A\u043E\u0440\u0431\u043B\u0435\u043D\u0438\u0435
      \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907047
    m_Localized: "\u0423 \u043E\u0431\u0449\u0435\u0433\u043E \u043A\u043E\u043B\u043E\u0434\u0446\u0430
      \u043C\u0435\u0436\u0434\u0443 \u0411\u0430\u043B\u0445\u043E\u043C \u0438
      \u0422\u0435\u0440\u043C\u0435\u0437\u043E\u043C \u0432\u0441\u0442\u0440\u0435\u0447\u0430
      \u0441 \u0434\u0440\u0443\u0433\u0438\u043C \u043E\u0431\u043E\u0437\u043E\u043C.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442,
      \u0433\u043E\u0440\u044F\u0447\u0438\u0439 \u0441\u043E\u0433\u0434\u0438\u0435\u0446
      \u0438\u0437 \u0432\u0430\u0448\u0435\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430,
      \u0438 \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u043D\u0430\u0451\u043C\u043D\u0438\u043A
      \u041A\u044E\u043B\u044C \u0438\u0437 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0433\u043E
      \u043E\u0431\u043E\u0437\u0430 \u043F\u043E\u0441\u0441\u043E\u0440\u0438\u043B\u0438\u0441\u044C
      \u0438\u0437-\u0437\u0430 \u043E\u0447\u0435\u0440\u0451\u0434\u043D\u043E\u0441\u0442\u0438
      \u0432\u043E\u0434\u043E\u043F\u043E\u044F. \u041A\u044E\u043B\u044C \u043D\u0430\u0437\u0432\u0430\u043B
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0430 \xAB\u0432\u043E\u043D\u044E\u0447\u0438\u043C
      \u0437\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u0438\u043C
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u043C\xBB. \u041F\u043E \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u043C\u0443
      \u043E\u0431\u044B\u0447\u0430\u044E - \u044D\u0442\u043E \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u043E\u0442\u0432\u0435\u0442\u0430. \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0441:
      \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u0435 \u043B\u0438? \u0412\u043E\u043A\u0440\u0443\u0433
      \u0443\u0436\u0435 \u0441\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C \u043E\u0431\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0440\u0435\u0448\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u044F\u043C\u043E
      \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907048
    m_Localized: "\u0420\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044C \u043F\u043E\u0435\u0434\u0438\u043D\u043E\u043A
      - \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0434\u043E\u043B\u0436\u0435\u043D
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0447\u0435\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907049
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0432\u044B\u0438\u0433\u0440\u0430\u043B
      - \u043E\u043F\u044B\u0442\u043D\u044B\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0432 \u043C\u043E\u043B\u043E\u0434\u043E\u0441\u0442\u0438 \u0441\u043B\u0443\u0436\u0438\u043B
      \u0432 \u0434\u043E\u0437\u043E\u0440\u0435. \u041A\u044E\u043B\u044C \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0441\u0438\u043D\u044F\u043A \u043F\u043E\u0434 \u0433\u043B\u0430\u0437\u043E\u043C
      \u0438 \u0438\u0437\u0432\u0438\u043D\u0438\u043B\u0441\u044F. \u041E\u0431\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0445\u043E\u0434\u044F\u0442
      \u0441 \u0433\u043E\u0440\u0434\u044B\u043C \u0432\u0438\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907050
    m_Localized: "\u041E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F \u043E\u0442
      \u0441\u043A\u0430\u043D\u0434\u0430\u043B\u0430 - \u0434\u0430\u0442\u044C
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0443
      \u0442\u043E\u0433\u043E \u043E\u0431\u043E\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907051
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0433\u043B\u0430\u0432\u0435 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0433\u043E
      \u043E\u0431\u043E\u0437\u0430 \u0440\u0435\u0448\u0438\u043B\u0438 \u0434\u0435\u043B\u043E
      \u0431\u0435\u0437 \u0431\u043E\u044F. \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u0435\u043D - \u043C\u043E\u043B\u0447\u0438\u0442
      \u0432\u0441\u044E \u0434\u043E\u0440\u043E\u0433\u0443. \u041A\u044E\u043B\u044C
      \u0441\u043C\u0435\u0451\u0442\u0441\u044F \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438 \u0443 \u044D\u0442\u043E\u0433\u043E
      \u043A\u043E\u043B\u043E\u0434\u0446\u0430 \u044D\u0442\u043E \u043D\u0435
      \u043F\u0440\u0438\u0431\u0430\u0432\u0438\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907052
    m_Localized: "\u0417\u0430\u043F\u0440\u0435\u0442\u0438\u0442\u044C \u043F\u043E\u0435\u0434\u0438\u043D\u043E\u043A
      - \u043D\u0435 \u0432\u0440\u0435\u043C\u044F \u0434\u043B\u044F \u043B\u0438\u0447\u043D\u044B\u0445
      \u0441\u0447\u0451\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907053
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043F\u043E\u0434\u0447\u0438\u043D\u0438\u043B\u0441\u044F,
      \u043D\u043E \u043E\u0431\u0438\u0434\u0435\u043B\u0441\u044F. \u041E\u0431\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0443\u0448\u043B\u0438 \u0432
      \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0438. \u0412 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445
      \u043A\u0440\u0443\u0433\u0430\u0445 \u0411\u0430\u043B\u0445\u0430 \u043F\u043E\u0439\u0434\u0451\u0442
      \u0441\u043B\u0443\u0445, \u0447\u0442\u043E \u0432\u0430\u0448\u0438 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u0440\u043E\u0433\u043B\u043E\u0442\u0438\u043B\u0438 \u043E\u0441\u043A\u043E\u0440\u0431\u043B\u0435\u043D\u0438\u0435.
      \u0410\u0432\u0442\u043E\u0440\u0438\u0442\u0435\u0442 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907054
    m_Localized: "\u0421\u043E\u0431\u043B\u0430\u0437\u043D \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907055
    m_Localized: "\u041D\u0430 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u0439 \u0441\u0442\u043E\u044F\u043D\u043A\u0435
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0412\u0430\u0440\u0437\u0435
      \u043E\u0442\u0432\u043E\u0434\u0438\u0442 \u0432\u0430\u0441 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E,
      \u043D\u0435 \u0433\u043B\u044F\u0434\u044F \u0432 \u0433\u043B\u0430\u0437\u0430.
      \u041A\u0443\u043F\u0435\u0446 \u041C\u0430\u043D\u0430\u0445 \u0438\u0437
      \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0433\u043E \u043E\u0431\u043E\u0437\u0430
      \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u0435\u043C\u0443 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0438 \u0442\u0451\u043F\u043B\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E \u043F\u0440\u0438 \u0441\u0432\u043E\u0451\u043C
      \u043E\u0431\u043E\u0437\u0435 - \u0435\u0441\u043B\u0438 \u0412\u0430\u0440\u0437\u0435
      \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0435\u0442 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u0438 \u0441\u043E\u0441\u0442\u0430\u0432 \u0433\u0440\u0443\u0437\u0430.
      \u041E\u043D \u043F\u0440\u0438\u0448\u0451\u043B \u0441\u0430\u043C, \u043D\u0435
      \u0443\u0442\u0430\u0438\u043B. \u0415\u0433\u043E \u0442\u0440\u044F\u0441\u0451\u0442:
      \u0434\u0435\u043D\u044C\u0433\u0438 \u043D\u0443\u0436\u043D\u044B, \u0443
      \u043D\u0435\u0433\u043E \u0434\u043E\u043B\u0433 \u043F\u0435\u0440\u0435\u0434
      \u043B\u0435\u043A\u0430\u0440\u0435\u043C \u0432 \u041C\u0435\u0440\u0432\u0435.
      \u041D\u043E \u043E\u043D \u0437\u0434\u0435\u0441\u044C \u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0432\u0430\u043C. \u042D\u0442\u043E \u043B\u0438\u0431\u043E \u0447\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C,
      \u043B\u0438\u0431\u043E \u0445\u0438\u0442\u0440\u043E\u0441\u0442\u044C -
      \u043D\u0435 \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u0439\u043C\u0451\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907056
    m_Localized: "\u041F\u043E\u0445\u0432\u0430\u043B\u0438\u0442\u044C \u0438 \u043F\u043E\u043A\u0440\u044B\u0442\u044C
      \u0435\u0433\u043E \u0434\u043E\u043B\u0433 - \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907057
    m_Localized: "\u0412\u0430\u0440\u0437\u0435 \u0437\u0430\u043F\u043B\u0430\u043A\u0430\u043B
      - \u0442\u0438\u0445\u043E, \u0443\u0442\u0435\u0440\u0435\u0432 \u043B\u0438\u0446\u043E
      \u0440\u0443\u043A\u0430\u0432\u043E\u043C. \u0421 \u044D\u0442\u043E\u0433\u043E
      \u0434\u043D\u044F \u043E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u043B
      \u0432\u0434\u0432\u043E\u0435 \u0443\u0441\u0435\u0440\u0434\u043D\u0435\u0435.
      \u041C\u0430\u043D\u0430\u0445 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u0443\u0437\u043D\u0430\u043B. \u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u043B\u0443\u0447\u0448\u0438\u043C \u0432\u043B\u043E\u0436\u0435\u043D\u0438\u0435\u043C
      \u0432 \u044D\u0442\u043E\u043C \u043E\u0431\u043E\u0437\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907058
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438
      \u0438\u0437 \u043A\u0430\u0437\u043D\u044B \u0438 \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
      \u0432\u0435\u0440\u043D\u043E\u0441\u0442\u0438 \u043A\u043B\u044F\u0442\u0432\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907059
    m_Localized: "\u0412\u0430\u0440\u0437\u0435 \u043F\u043E\u043A\u043B\u044F\u043B\u0441\u044F
      \u043D\u0430 \u0441\u0432\u043E\u0451\u043C \u043A\u0438\u043D\u0436\u0430\u043B\u0435
      - \u043F\u043E \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C\u0443
      \u043E\u0431\u044B\u0447\u0430\u044E \u043A\u043B\u044F\u0442\u0432\u0430 \u043D\u0430
      \u043E\u0440\u0443\u0436\u0438\u0438 \u043D\u0435\u0440\u0443\u0448\u0438\u043C\u0430.
      \u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043E\u0442\u0434\u0430\u043D\u044B. \u041E\u043D \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435. \u041C\u0430\u043D\u0430\u0445
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u043B
      \u043A \u043D\u0435\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907060
    m_Localized: "\u0423\u0432\u043E\u043B\u0438\u0442\u044C \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      - \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0440\u0438\u0441\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907061
    m_Localized: "\u0412\u0430\u0440\u0437\u0435 \u0443\u0448\u0451\u043B \u043C\u043E\u043B\u0447\u0430,
      \u0437\u0430\u0431\u0440\u0430\u0432 \u0441\u0432\u043E\u0438 \u0432\u0435\u0449\u0438.
      \u041C\u043E\u0436\u0435\u0442, \u043E\u043D \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0431\u044B\u043B \u0447\u0435\u0441\u0442\u0435\u043D. \u0411\u0435\u0437
      \u043D\u0435\u0433\u043E \u043E\u0445\u0440\u0430\u043D\u0430 \u043E\u0441\u043B\u0430\u0431\u043B\u0430.
      \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435
      \u0432\u044B\u0440\u043E\u0441\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907062
    m_Localized: "\u0421\u043A\u0440\u044B\u0442\u0430\u044F \u0440\u0430\u043D\u0430
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907063
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u041F\u0435\u043C\u0431\u0430
      \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442, \u0447\u0442\u043E \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u041A\u044E\u043B\u044C \u0445\u0440\u043E\u043C\u0430\u0435\u0442 - \u043D\u0435\u043B\u043E\u0432\u043A\u043E,
      \u0431\u0443\u0434\u0442\u043E \u0441\u0442\u0430\u0440\u0430\u0435\u0442\u0441\u044F
      \u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C.
      \u041D\u0430 \u0441\u0442\u043E\u044F\u043D\u043A\u0435 \u041F\u0435\u043C\u0431\u0430
      \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u0435\u0433\u043E
      \u0431\u0435\u0437 \u0441\u043F\u0440\u043E\u0441\u0430 \u0438 \u0432\u0438\u0434\u0438\u0442:
      \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439 \u043F\u043E\u0440\u0435\u0437
      \u043D\u0430 \u0431\u0435\u0434\u0440\u0435, \u043F\u0435\u0440\u0435\u0442\u044F\u043D\u0443\u0442\u044B\u0439
      \u0433\u0440\u044F\u0437\u043D\u043E\u0439 \u0442\u0440\u044F\u043F\u043A\u043E\u0439,
      \u0443\u0436\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0433\u043D\u043E\u0438\u0442\u044C\u0441\u044F.
      \u041A\u044E\u043B\u044C \u0437\u043B\u0438\u0442\u0441\u044F: \"\u041D\u0438\u0447\u0435\u0433\u043E
      \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E, \u0437\u0430\u0436\u0438\u0432\u0451\u0442
      \u0441\u0430\u043C\u043E\". \u0422\u0440\u0438 \u0434\u043D\u044F \u043E\u043D
      \u0441\u043A\u0440\u044B\u0432\u0430\u043B - \u043D\u0435 \u0445\u043E\u0442\u0435\u043B
      \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C \u043C\u0435\u0441\u0442\u043E.
      \u0415\u0441\u043B\u0438 \u043D\u0435 \u043B\u0435\u0447\u0438\u0442\u044C,
      \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u0434\u043D\u044F \u043E\u043D
      \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0442 \u0438\u0434\u0442\u0438.
      \u0427\u0435\u0440\u0435\u0437 \u043F\u044F\u0442\u044C - \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u0438\u0435
      \u043A\u0440\u043E\u0432\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907064
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043E\u0431\u043E\u0437
      - \u0434\u0430\u0442\u044C \u041F\u0435\u043C\u0431\u0435 \u0434\u0435\u043D\u044C
      \u043D\u0430 \u043B\u0435\u0447\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907065
    m_Localized: "\u0414\u0435\u043D\u044C \u043F\u043E\u0442\u0435\u0440\u044F\u043D,
      \u043D\u043E \u041F\u0435\u043C\u0431\u0430 \u043F\u0440\u043E\u043C\u044B\u043B
      \u0440\u0430\u043D\u0443 \u044F\u0447\u043C\u0435\u043D\u043D\u044B\u043C \u0443\u043A\u0441\u0443\u0441\u043E\u043C
      \u0438 \u043F\u0435\u0440\u0435\u0442\u044F\u043D\u0443\u043B \u0447\u0438\u0441\u0442\u044B\u043C
      \u043B\u044C\u043D\u043E\u043C. \u041A\u044E\u043B\u044C \u0447\u0435\u0440\u0435\u0437
      \u0442\u0440\u0438 \u0434\u043D\u044F \u0448\u0451\u043B \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E.
      \u041E\u0431\u043E\u0437 \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043B
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907066
    m_Localized: "\u041D\u0435\u0441\u0442\u0438 \u0440\u0430\u043D\u0435\u043D\u043E\u0433\u043E
      \u043D\u0430 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0435 \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907067
    m_Localized: "\u041A\u044E\u043B\u044C \u0435\u0445\u0430\u043B \u043D\u0430
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0435, \u0437\u043B\u044F\u0441\u044C.
      \u0427\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u0434\u043D\u044F \u0440\u0430\u043D\u0430
      \u0432\u043E\u0441\u043F\u0430\u043B\u0438\u043B\u0430\u0441\u044C \u0441\u0438\u043B\u044C\u043D\u0435\u0435.
      \u041F\u0435\u043C\u0431\u0430 \u043B\u0435\u0447\u0438\u043B \u043D\u0430
      \u0445\u043E\u0434\u0443, \u043A\u0430\u043A \u043C\u043E\u0433. \u0412 \u0438\u0442\u043E\u0433\u0435
      \u041A\u044E\u043B\u044C \u0432\u044B\u0436\u0438\u043B, \u043D\u043E \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B
      \u0434\u0432\u0435 \u043D\u043E\u0447\u043D\u044B\u0435 \u0441\u043C\u0435\u043D\u044B
      \u043E\u0445\u0440\u0430\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907068
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0437\u0430
      \u043B\u0435\u0447\u0435\u043D\u0438\u0435 \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C
      \u0441\u0435\u043B\u0435\u043D\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907069
    m_Localized: "\u0421\u0435\u043B\u044C\u0441\u043A\u0438\u0439 \u043B\u0435\u043A\u0430\u0440\u044C
      \u0432\u0437\u044F\u043B \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B
      \u043E\u0442\u0432\u0430\u0440 \u043F\u043E\u043B\u044B\u043D\u0438. \u041D\u0435\u043F\u043B\u043E\u0445\u043E
      - \u041A\u044E\u043B\u044C \u043F\u043E\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F
      \u0437\u0430 \u0434\u0432\u0430 \u0434\u043D\u044F. \u041E\u0431\u043E\u0437
      \u0441\u0434\u0435\u043B\u0430\u043B \u043A\u0440\u044E\u043A \u0432 \u043F\u043E\u043B\u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907070
    m_Localized: "\u0411\u0440\u0430\u0442 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907071
    m_Localized: "\u041D\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u043C
      \u0434\u0432\u043E\u0440\u0435 \u0432 \u041A\u0430\u0448\u0433\u0430\u0440\u0435
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0411\u0443\u0433\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0432 \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u043E\u0439
      \u043E\u0434\u0435\u0436\u0434\u0435 \u0441 \u0432\u043E\u0435\u043D\u043D\u043E\u0439
      \u0432\u044B\u043F\u0440\u0430\u0432\u043A\u043E\u0439. \u0411\u0443\u0433\u0430
      \u0441\u0430\u043C \u043D\u0435 \u0441\u0432\u043E\u0439 - \u043E\u0431\u043D\u0438\u043C\u0430\u0435\u0442
      \u0435\u0433\u043E, \u043F\u043E\u0442\u043E\u043C \u043E\u0442\u0432\u043E\u0434\u0438\u0442
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442:
      \u044D\u0442\u043E \u0435\u0433\u043E \u043C\u043B\u0430\u0434\u0448\u0438\u0439
      \u0431\u0440\u0430\u0442 \u0422\u0435\u0433\u0438\u043D, \u0441\u0431\u0435\u0436\u0430\u0432\u0448\u0438\u0439
      \u0438\u0437 \u0443\u0439\u0433\u0443\u0440\u0441\u043A\u043E\u0433\u043E \u0433\u0430\u0440\u043D\u0438\u0437\u043E\u043D\u0430
      \u0442\u0440\u0438 \u043D\u0435\u0434\u0435\u043B\u0438 \u043D\u0430\u0437\u0430\u0434.
      \u0422\u0435\u0433\u0438\u043D \u043F\u0440\u043E\u0441\u0438\u0442 \u0443\u043A\u0440\u044B\u0442\u0438\u044F
      \u0432 \u043E\u0431\u043E\u0437\u0435 - \u043E\u043D \u0431\u043E\u0438\u0442\u0441\u044F,
      \u0447\u0442\u043E \u0443\u0439\u0433\u0443\u0440\u0441\u043A\u0438\u0435 \u043E\u0444\u0438\u0446\u0435\u0440\u044B
      \u0438\u0449\u0443\u0442 \u0435\u0433\u043E \u043F\u043E \u0432\u0441\u0435\u043C\u0443
      \u041A\u0430\u0448\u0433\u0430\u0440\u0443. \u0411\u0443\u0433\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0441 \u043C\u043E\u043B\u044F\u0449\u0438\u043C
      \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C. \u0414\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u043E\u0432
      \u043D\u0435 \u0443\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0431\u0435\u0437
      \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907072
    m_Localized: "\u0421\u043F\u0440\u044F\u0442\u0430\u0442\u044C \u0422\u0435\u0433\u0438\u043D\u0430
      \u043F\u043E\u0434 \u0442\u044E\u043A\u0430\u043C\u0438 - \u0440\u0438\u0441\u043A\u043D\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907073
    m_Localized: "\u0422\u0435\u0433\u0438\u043D \u0442\u0440\u043E\u0435 \u0441\u0443\u0442\u043E\u043A
      \u0435\u0445\u0430\u043B \u043F\u043E\u0434 \u0442\u044E\u043A\u0430\u043C\u0438,
      \u043F\u043E\u0447\u0442\u0438 \u0431\u0435\u0437 \u0435\u0434\u044B. \u041D\u0430
      \u0432\u044B\u0435\u0437\u0434\u0435 \u0438\u0437 \u041A\u0430\u0448\u0433\u0430\u0440\u0430
      \u043F\u0430\u0442\u0440\u0443\u043B\u044C \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B
      \u043E\u0431\u043E\u0437 - \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u043D\u0430\u0448\u043B\u0438. \u0411\u0443\u0433\u0430 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0434\u043E\u043B\u0436\u0435\u043D \u0432\u0430\u043C \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043B\u044E\u0431\u043E\u0435 \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u0435
      \u0432\u044B\u0440\u0430\u0436\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289604907074
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0422\u0435\u0433\u0438\u043D\u0443
      \u0437\u0430 \u0434\u043E\u0440\u043E\u0433\u0443 - \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u0434\u0440\u0443\u0433\u0438\u043C \u043F\u0443\u0442\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101312
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0438 \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u0435 \u043D\u0430 \u0442\u0440\u043E\u043F\u0443
      \u0447\u0435\u0440\u0435\u0437 \u0433\u043E\u0440\u044B \u043F\u043E\u043C\u043E\u0433\u043B\u0438
      \u0422\u0435\u0433\u0438\u043D\u0443 \u0443\u0439\u0442\u0438 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E.
      \u0411\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E \u0434\u043B\u044F \u043E\u0431\u043E\u0437\u0430.
      \u0411\u0443\u0433\u0430 \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B
      \u0441\u0434\u0435\u0440\u0436\u0430\u043D\u043D\u043E, \u043D\u043E \u0438\u0441\u043A\u0440\u0435\u043D\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101313
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u0447\u0443\u0436\u0438\u0435
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B \u043D\u0435 \u043D\u0430\u0448\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101314
    m_Localized: "\u0411\u0443\u0433\u0430 \u043A\u0438\u0432\u043D\u0443\u043B \u0438
      \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B.
      \u0422\u0435\u0433\u0438\u043D \u0443\u0448\u0451\u043B \u0432 \u0433\u043E\u0440\u043E\u0434.
      \u0427\u0442\u043E \u0441 \u043D\u0438\u043C \u0441\u0442\u0430\u043B\u043E
      - \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E. \u0411\u0443\u0433\u0430
      \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0443,
      \u043D\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
      \u0427\u0442\u043E-\u0442\u043E \u043C\u0435\u0436\u0434\u0443 \u0432\u0430\u043C\u0438
      \u0441\u043B\u043E\u043C\u0430\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101315
    m_Localized: "\u0420\u0435\u0434\u043A\u0430\u044F \u0442\u0440\u0430\u0432\u0430
      \u043B\u0435\u043A\u0430\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101316
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u041F\u0435\u043C\u0431\u0430
      \u0432\u0434\u0440\u0443\u0433 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0441\u043A\u043B\u043E\u043D\u0435, \u043D\u0435 \u0441\u043B\u0443\u0448\u0430\u044F
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432. \u041E\u043D
      \u043F\u0440\u0438\u0441\u0435\u043B \u0443 \u0441\u0435\u0440\u043E\u0433\u043E
      \u043A\u0430\u043C\u043D\u044F \u0438 \u0440\u0432\u0451\u0442 \u0447\u0442\u043E-\u0442\u043E
      \u0440\u0443\u043A\u0430\u043C\u0438, \u0443\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044F
      \u0432 \u043B\u044C\u043D\u044F\u043D\u043E\u0439 \u043C\u0435\u0448\u043E\u0447\u0435\u043A.
      \u041F\u043E\u0442\u043E\u043C \u0431\u0435\u0436\u0438\u0442 \u043A \u0432\u0430\u043C,
      \u0433\u043B\u0430\u0437\u0430 \u0431\u043B\u0435\u0441\u0442\u044F\u0442:
      \"\u042D\u0442\u043E \u0432\u043E\u043B\u0447\u044C\u044F \u044F\u0433\u043E\u0434\u0430
      \u0433\u043E\u0440\u043D\u0430\u044F - \u043E\u043D\u0430 \u0440\u0430\u0441\u0442\u0451\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0434\u0435\u0441\u044C, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 \u043B\u0435\u0442\u0430. \u0414\u0430\u0439\u0442\u0435
      \u043C\u043D\u0435 \u0447\u0430\u0441. \u041D\u0435\u0442, \u0434\u0432\u0430.
      \u042F \u0441\u043E\u0431\u0435\u0440\u0443 \u0441\u0442\u043E\u043B\u044C\u043A\u043E,
      \u0447\u0442\u043E\u0431\u044B \u0445\u0432\u0430\u0442\u0438\u043B\u043E \u043D\u0430
      \u0433\u043E\u0434. \u042D\u0442\u043E \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E
      \u043E\u0442 \u0433\u043E\u0440\u043D\u043E\u0439 \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0438
      - \u043B\u044E\u0431\u043E\u0439 \u0430\u043F\u0442\u0435\u043A\u0430\u0440\u044C
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435 \u0432\u043E\u0437\u044C\u043C\u0451\u0442
      \u0435\u0451 \u043F\u043E \u0432\u0435\u0441\u0443 \u0441\u0435\u0440\u0435\u0431\u0440\u0430\".
      \u041E\u0431\u043E\u0437 \u0441\u0442\u043E\u0438\u0442. \u0412\u0440\u0435\u043C\u044F
      \u0438\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101317
    m_Localized: "\u0414\u0430\u0442\u044C \u0434\u0432\u0430 \u0447\u0430\u0441\u0430
      - \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E \u0434\u043E\u0440\u043E\u0433\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101318
    m_Localized: "\u041F\u0435\u043C\u0431\u0430 \u0441\u043E\u0431\u0440\u0430\u043B
      \u043F\u043E\u043B\u043D\u044B\u0439 \u043C\u0435\u0448\u043E\u0447\u0435\u043A.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0434\u0435\u043D\u044C,
      \u043D\u043E \u041F\u0435\u043C\u0431\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u043C. \u0412 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u0441\u0431\u043E\u0440 \u043F\u0440\u0438\u043D\u0451\u0441 \u043D\u0435\u043F\u043B\u043E\u0445\u0443\u044E
      \u0441\u0443\u043C\u043C\u0443. \u041B\u0435\u043A\u0430\u0440\u044C \u0441\u0442\u0430\u043B
      \u043B\u0435\u0447\u0438\u0442\u044C \u043E\u0445\u043E\u0442\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101319
    m_Localized: "\u0414\u0430\u0442\u044C \u043F\u043E\u043B\u0447\u0430\u0441\u0430
      - \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0430\u043C\u043E\u0435 \u0446\u0435\u043D\u043D\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101320
    m_Localized: "\u041F\u0435\u043C\u0431\u0430 \u0443\u0441\u043F\u0435\u043B \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u043C\u0435\u0448\u043E\u0447\u043A\u0430.
      \u041D\u0435\u043C\u043D\u043E\u0433\u043E \u0437\u043B\u0438\u0442\u0441\u044F,
      \u0447\u0442\u043E \u043C\u0430\u043B\u043E, \u043D\u043E \u043D\u0435 \u0441\u043F\u043E\u0440\u0438\u0442.
      \u041E\u0431\u043E\u0437 \u0441\u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u043F\u043E\u0447\u0442\u0438 \u0431\u0435\u0437 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438.
      \u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043F\u043E\u043B\u044C\u0437\u0430
      \u0434\u043B\u044F \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u0432
      \u0434\u043E\u0440\u043E\u0433\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101321
    m_Localized: "\u0417\u0430\u043F\u0440\u0435\u0442\u0438\u0442\u044C - \u043D\u0435\u043A\u043E\u0433\u0434\u0430
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101322
    m_Localized: "\u041F\u0435\u043C\u0431\u0430 \u043F\u043E\u0434\u0447\u0438\u043D\u0438\u043B\u0441\u044F
      \u043C\u043E\u043B\u0447\u0430, \u043D\u043E \u0432\u0435\u0441\u044C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0434\u0435\u043D\u044C \u043B\u0435\u0447\u0438\u043B \u0432\u044F\u043B\u043E
      \u0438 \u043E\u0433\u0440\u044B\u0437\u0430\u043B\u0441\u044F \u043D\u0430
      \u0432\u043E\u043F\u0440\u043E\u0441\u044B. \u0422\u0440\u0430\u0432\u0430
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u043D\u0430 \u0441\u043A\u043B\u043E\u043D\u0435.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0441\u0442\u0430\u043B\u0438
      \u0440\u0435\u0436\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F
      \u043A \u043B\u0435\u043A\u0430\u0440\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101323
    m_Localized: "\u041C\u043E\u0440 \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101324
    m_Localized: "\u0423 \u0432\u043E\u0440\u043E\u0442 \u0433\u043B\u0438\u043D\u043E\u0431\u0438\u0442\u043D\u043E\u0439
      \u0434\u0435\u0440\u0435\u0432\u043D\u0438 \u043D\u0430 \u043A\u0440\u0430\u044E
      \u043F\u0443\u0441\u0442\u044B\u043D\u0438 \u041F\u0435\u043C\u0431\u0430 \u0441\u043B\u044B\u0448\u0438\u0442
      \u043A\u0430\u0448\u0435\u043B\u044C \u0438 \u0441\u0442\u043E\u043D \u0432\u043D\u0443\u0442\u0440\u0438.
      \u041E\u043D \u0437\u0430\u0445\u043E\u0434\u0438\u0442 \u0441\u0430\u043C
      - \u0438 \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0447\u0435\u0440\u0435\u0437
      \u043C\u0438\u043D\u0443\u0442\u0443 \u0441 \u0431\u043B\u0435\u0434\u043D\u044B\u043C
      \u043B\u0438\u0446\u043E\u043C: \u043F\u044F\u0442\u0435\u0440\u043E \u0434\u0435\u0442\u0435\u0439
      \u0431\u043E\u043B\u044C\u043D\u044B \u043F\u043E\u043D\u043E\u0441\u043E\u043C
      \u0441 \u043A\u0440\u043E\u0432\u044C\u044E, \u0434\u0432\u043E\u0435 \u0443\u0436\u0435
      \u043D\u0435 \u0432\u0441\u0442\u0430\u044E\u0442. \u041F\u0435\u043C\u0431\u0430
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E: \"\u042D\u0442\u043E
      \u043D\u0435 \u0437\u0430\u0440\u0430\u0437\u043D\u043E\u0435 - \u043D\u0435\u0447\u0438\u0441\u0442\u0430\u044F
      \u0432\u043E\u0434\u0430. \u042F \u043C\u043E\u0433\u0443 \u043F\u043E\u043C\u043E\u0447\u044C,
      \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0441\u043D\u0430\u0434\u043E\u0431\u044C\u044F.
      \u041D\u043E \u043D\u0443\u0436\u043D\u043E \u0442\u0440\u0438 \u0434\u043D\u044F\".
      \u0422\u0440\u0438 \u0434\u043D\u044F \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
      \u043E\u0437\u043D\u0430\u0447\u0430\u044E\u0442 \u043F\u043E\u0442\u0435\u0440\u044E
      \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u043F\u043E\u0433\u043E\u0434\u044B
      \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430. \u0418
      \u0442\u0440\u0430\u0442\u0430 \u0437\u0430\u043F\u0430\u0441\u043E\u0432 \u043B\u0435\u043A\u0430\u0440\u044F
      \u043D\u0430 \u0447\u0443\u0436\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101325
    m_Localized: "\u041F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C - \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0442\u0440\u0438 \u0434\u043D\u044F, \u043F\u043E\u043C\u043E\u0447\u044C
      \u0434\u0435\u0440\u0435\u0432\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101326
    m_Localized: "\u0414\u0435\u0442\u0438 \u0432\u044B\u0436\u0438\u043B\u0438.
      \u041D\u0430 \u0442\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C
      \u0434\u0435\u0440\u0435\u0432\u0435\u043D\u0441\u043A\u0438\u0439 \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430
      \u043F\u0440\u0438\u043D\u0451\u0441 \u043B\u0435\u043F\u0451\u0448\u043A\u0438
      \u0438 \u043C\u0451\u0434. \u041F\u043E \u043E\u043A\u0440\u0443\u0433\u0435
      \u043F\u043E\u0448\u043B\u0430 \u043C\u043E\u043B\u0432\u0430 \u043E \u0434\u043E\u0431\u0440\u043E\u043C
      \u043E\u0431\u043E\u0437\u0435. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0432\u044B\u0440\u043E\u0441\u043B\u0430. \u041F\u0435\u043C\u0431\u0430
      \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0431\u0435\u0437 \u0441\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101327
    m_Localized: "\u0414\u0430\u0442\u044C \u041F\u0435\u043C\u0431\u0435 \u0447\u0430\u0441
      - \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0432\u0443\u044E
      \u043F\u043E\u043C\u043E\u0449\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101328
    m_Localized: "\u041F\u0435\u043C\u0431\u0430 \u0441\u0434\u0435\u043B\u0430\u043B
      \u0447\u0442\u043E \u0441\u043C\u043E\u0433 \u0437\u0430 \u0447\u0430\u0441:
      \u0434\u0430\u043B \u043F\u043E\u0440\u043E\u0448\u043E\u043A \u043E\u0442
      \u043F\u043E\u043D\u043E\u0441\u0430, \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B
      \u043F\u0440\u043E \u0432\u043E\u0434\u0443. \u041E\u043D \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u0435\u043D
      - \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u044D\u0442\u043E\u0433\u043E
      \u043C\u0430\u043B\u043E. \u0414\u0435\u0442\u044F\u043C \u0441\u0442\u0430\u043B\u043E
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043B\u0443\u0447\u0448\u0435.
      \u041E\u0431\u043E\u0437 \u0443\u0448\u0451\u043B \u0432 \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101329
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043C\u0435\u0441\u0442\u043D\u043E\u0439
      \u0437\u043D\u0430\u0445\u0430\u0440\u043A\u0435 - \u0438 \u0435\u0445\u0430\u0442\u044C
      \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101330
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043C\u0435\u0441\u0442\u043D\u043E\u0439 \u0437\u043D\u0430\u0445\u0430\u0440\u043A\u0435.
      \u041F\u0435\u043C\u0431\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u0441\u043B\u0435\u0434
      \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u043C\u043E\u043B\u0447\u0430.
      \u041E\u043D \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u043D\u043E \u0432 \u043B\u0430\u0433\u0435\u0440\u0435 \u0432 \u0442\u043E\u0442
      \u0432\u0435\u0447\u0435\u0440 \u043B\u0435\u0447\u0438\u043B \u0432\u0441\u0435
      \u043C\u0435\u043B\u043A\u0438\u0435 \u0441\u0441\u0430\u0434\u0438\u043D\u044B
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u0441 \u043E\u0441\u043E\u0431\u043E\u0439
      \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E,
      \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0438\u0441\u043A\u0443\u043F\u0430\u044F
      \u0447\u0442\u043E-\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101331
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0438 \u0434\u043E\u043B\u0436\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101332
    m_Localized: "\u041D\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u043C
      \u0434\u0432\u043E\u0440\u0435 \u0432 \u0411\u0443\u0445\u0430\u0440\u0435
      \u041F\u0435\u043C\u0431\u0430 \u0431\u043B\u0435\u0434\u043D\u0435\u0435\u0442,
      \u0443\u0432\u0438\u0434\u0435\u0432 \u043F\u043E\u0436\u0438\u043B\u043E\u0433\u043E
      \u043A\u0443\u043F\u0446\u0430. \u041E\u043D \u0442\u044F\u043D\u0435\u0442
      \u0432\u0430\u0441 \u0437\u0430 \u0440\u0443\u043A\u0430\u0432: \"\u042D\u0442\u043E
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0438\u0437 \u0421\u043E\u0433\u0434\u0438\u0430\u043D\u044B.
      \u0421\u0435\u043C\u044C \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434
      \u044F \u0432\u044B\u0442\u0430\u0449\u0438\u043B \u0435\u0433\u043E \u0438\u0437
      \u0433\u043E\u0440\u044F\u0447\u043A\u0438 \u0432 \u0411\u0430\u043B\u0445\u0435
      - \u0442\u0440\u0438 \u043D\u0435\u0434\u0435\u043B\u0438 \u0443 \u043F\u043E\u0441\u0442\u0435\u043B\u0438,
      \u043D\u043E\u0447\u0430\u043C\u0438. \u041E\u043D \u043E\u0431\u0435\u0449\u0430\u043B
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043C\u043D\u0435 \u0437\u043E\u043B\u043E\u0442\u043E\u043C\".
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0436\u0438\u0432 \u0438
      \u044F\u0432\u043D\u043E \u0431\u043E\u0433\u0430\u0442 - \u043D\u0430 \u043F\u0430\u043B\u044C\u0446\u0430\u0445
      \u043A\u043E\u043B\u044C\u0446\u0430, \u0440\u044F\u0434\u043E\u043C \u0434\u0432\u0430
      \u0441\u043B\u0443\u0433\u0438. \u041F\u0435\u043C\u0431\u0430 \u043D\u0435
      \u043F\u0440\u043E\u0441\u0438\u0442 \u0432\u0430\u0441 \u0432\u043C\u0435\u0448\u0430\u0442\u044C\u0441\u044F.
      \u041D\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u044B\u0436\u0438\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101333
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u043A\u0443\u043F\u0446\u043E\u043C - \u043D\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C
      \u043E \u0434\u043E\u043B\u0433\u0435 \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101334
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043F\u043E\u043C\u043E\u0440\u0449\u0438\u043B\u0441\u044F,
      \u043D\u043E \u0434\u0435\u043D\u044C\u0433\u0438 \u043E\u0442\u0434\u0430\u043B
      - \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432,
      \u044F\u0432\u043D\u043E \u043C\u0435\u043D\u044C\u0448\u0435 \u043E\u0431\u0435\u0449\u0430\u043D\u043D\u043E\u0433\u043E.
      \u041F\u0435\u043C\u0431\u0430 \u0432\u0437\u044F\u043B \u043C\u043E\u043B\u0447\u0430.
      \u0421\u0435\u043C\u044C \u043B\u0435\u0442, \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u043E\u043D \u0443\u0436\u0435 \u043F\u043E\u0447\u0442\u0438 \u043D\u0435
      \u0432\u0435\u0440\u0438\u043B. \u041D\u043E \u043F\u043E\u043C\u043D\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101335
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0443
      \u043C\u0435\u0441\u0442\u043E \u0432 \u043D\u0430\u0448\u0435\u043C \u043E\u0431\u043E\u0437\u0435
      - \u0437\u0430 \u0436\u0438\u0437\u043D\u044C \u043F\u043B\u0430\u0442\u044F\u0442
      \u043D\u0430\u0442\u0443\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101336
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043E\u0436\u0438\u0432\u0438\u043B\u0441\u044F
      - \u0435\u043C\u0443 \u043A\u0430\u043A \u0440\u0430\u0437 \u043D\u0443\u0436\u043D\u0430
      \u0431\u044B\u043B\u0430 \u043E\u0445\u0440\u0430\u043D\u0430 \u0434\u043E
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430. \u041E\u043D
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B \u0437\u0430 \u043C\u0435\u0441\u0442\u043E
      \u0449\u0435\u0434\u0440\u043E, \u0430 \u0441 \u041F\u0435\u043C\u0431\u043E\u0439
      \u043F\u043E\u043C\u0438\u0440\u0438\u043B\u0441\u044F \u0437\u0430 \u0447\u0430\u0448\u0435\u0439
      \u043A\u0443\u043C\u044B\u0441\u0430. \u0414\u043E\u043B\u0433 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101337
    m_Localized: "\u041D\u0435 \u0432\u043C\u0435\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      - \u043B\u0438\u0447\u043D\u043E\u0435 \u0434\u0435\u043B\u043E \u041F\u0435\u043C\u0431\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101338
    m_Localized: "\u041F\u0435\u043C\u0431\u0430 \u043F\u043E\u0434\u043E\u0448\u0451\u043B
      \u043A \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0443 \u0441\u0430\u043C.
      \u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0432\u044B\u0448\u0435\u043B
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C \u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u043C.
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0443\u0448\u0451\u043B,
      \u043D\u0435 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0432. \u041F\u0435\u043C\u0431\u0430
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443
      \u0441 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u043C \u043B\u0438\u0446\u043E\u043C.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101339
    m_Localized: "\u0422\u0430\u0439\u043D\u0430\u044F \u0441\u0434\u0435\u043B\u043A\u0430
      \u043A\u043E\u043C\u043F\u0430\u043D\u044C\u043E\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101340
    m_Localized: "\u041D\u0430 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u0439 \u0441\u0442\u043E\u044F\u043D\u043A\u0435
      \u0443 \u0425\u0430\u043C\u0430\u0434\u0430\u043D\u0430 \u043A\u0443\u043F\u0435\u0446-\u043A\u043E\u043C\u043F\u0430\u043D\u044C\u043E\u043D
      \u0421\u0430\u043C\u0435\u0445 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u043A \u0432\u0430\u043C \u0441 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u043C
      \u0432\u0438\u0434\u043E\u043C. \u041E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
      \u043F\u043E\u043A\u0430 \u0432\u044B \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u043B\u0438\u0441\u044C
      \u0443 \u043A\u0443\u0437\u043D\u0435\u0446\u0430, \u043E\u043D \u043F\u0440\u043E\u0434\u0430\u043B
      \u043F\u044F\u0442\u044C \u043C\u0435\u0448\u043A\u043E\u0432 \u043F\u0435\u0440\u0446\u0430
      \u0438\u0437 \u043E\u0431\u0449\u0435\u0433\u043E \u0437\u0430\u043F\u0430\u0441\u0430
      \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u043C\u0443 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0443
      - \u043F\u043E \u0446\u0435\u043D\u0435 \u0432\u0434\u0432\u043E\u0435 \u0432\u044B\u0448\u0435
      \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439. \u0414\u0435\u043D\u044C\u0433\u0438
      \u0443\u0436\u0435 \u0443 \u043D\u0435\u0433\u043E \u0432 \u043A\u043E\u0448\u0435\u043B\u044C\u043A\u0435.
      \u041E\u043D \u043D\u0435 \u0441\u043F\u0440\u043E\u0441\u0438\u043B \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F.
      \"\u0421\u043B\u0443\u0447\u0430\u0439 \u0431\u044B\u043B \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0445\u043E\u0440\u043E\u0448\", - \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043E\u043D, \u0443\u043B\u044B\u0431\u0430\u044F\u0441\u044C. \u0421\u0434\u0435\u043B\u043A\u0430
      \u0432\u044B\u0433\u043E\u0434\u043D\u0430\u044F, \u043D\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u0430
      \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101341
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438
      \u0438 \u043F\u043E\u0445\u0432\u0430\u043B\u0438\u0442\u044C \u0437\u0430
      \u043D\u044E\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101342
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043F\u044F\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0441\u0432\u0435\u0440\u0445
      \u043D\u043E\u0440\u043C\u044B - \u0445\u043E\u0440\u043E\u0448\u043E. \u0421\u0430\u043C\u0435\u0445
      \u0440\u0430\u0441\u0446\u0432\u0451\u043B \u0438 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0439
      \u0441\u0434\u0435\u043B\u043A\u043E\u0439 \u0432\u0434\u0432\u043E\u0435 \u0430\u043A\u0442\u0438\u0432\u043D\u0435\u0435.
      \u041F\u0440\u0430\u0432\u0438\u043B\u0430 \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u044B,
      \u043D\u043E \u043F\u0440\u0438\u0431\u044B\u043B\u044C \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0441\u0430\u043C\u0430 \u0437\u0430 \u0441\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101343
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438,
      \u043D\u043E \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C \u043F\u0440\u0430\u0432\u0438\u043B\u0430
      \u043D\u0430 \u0431\u0443\u0434\u0443\u0449\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101344
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0438 \u043A\u0438\u0432\u043D\u0443\u043B.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u0432 \u043E\u0431\u0449\u0443\u044E
      \u043A\u0430\u0441\u0441\u0443. \u0411\u043E\u043B\u044C\u0448\u0435 \u0441\u0430\u043C\u043E\u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u043D\u0435 \u0431\u044B\u043B\u043E. \u041A\u043E\u043C\u043F\u0440\u043E\u043C\u0438\u0441\u0441
      - \u0438 \u0434\u0435\u043D\u044C\u0433\u0438, \u0438 \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101345
    m_Localized: "\u041E\u0442\u0440\u0443\u0433\u0430\u0442\u044C \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u043E
      - \u043D\u0435\u043B\u044C\u0437\u044F \u043D\u0430\u0440\u0443\u0448\u0430\u0442\u044C
      \u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u043E\u0431\u043E\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101346
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u043F\u043E\u0431\u043B\u0435\u0434\u043D\u0435\u043B
      \u043E\u0442 \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u043D\u043E\u0441\u0430.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u0432\u0435\u0440\u043D\u0443\u043B.
      \u0414\u043D\u044F \u0442\u0440\u0438 \u043C\u043E\u043B\u0447\u0430\u043B.
      \u0414\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0430 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430,
      \u043D\u043E \u043D\u0438 \u043E\u0434\u043D\u043E\u0439 \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u043D\u043E\u0439
      \u0441\u0434\u0435\u043B\u043A\u0438 \u043E\u0442 \u043D\u0435\u0433\u043E
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0431\u044B\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101347
    m_Localized: "\u0414\u043E\u043B\u0433 \u043A\u0443\u043F\u0446\u0430-\u043A\u043E\u043C\u043F\u0430\u043D\u044C\u043E\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101348
    m_Localized: "\u0412 \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0435 \u0443
      \u0432\u043E\u0440\u043E\u0442 \u0440\u044B\u043D\u043A\u0430 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0434\u043E\u0440\u043E\u0433\u0443 \u043A\u0440\u0435\u043F\u043A\u0438\u0439
      \u043C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0434\u0432\u0443\u043C\u044F
      \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u0430\u043C\u0438. \u041E\u043D
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043F\u043E-\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438,
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0421\u0430\u043C\u0435\u0445\u0430:
      \"\u0413\u043E\u0434 \u043F\u0440\u043E\u0448\u0451\u043B. \u0421\u043E\u0440\u043E\u043A
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u043F\u043B\u044E\u0441 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u044B
      - \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u043F\u044F\u0442\u044C.
      \u042F \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u043B \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E\".
      \u0421\u0430\u043C\u0435\u0445 \u043A\u0440\u0430\u0441\u043D\u0435\u0435\u0442
      \u0438 \u0448\u0435\u043F\u0447\u0435\u0442 \u0432\u0430\u043C: \"\u042F \u0432\u0437\u044F\u043B
      \u0432 \u0434\u043E\u043B\u0433 \u0434\u043E \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430,
      \u0442\u043E\u0433\u0434\u0430 \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C...
      \u042F \u043E\u0442\u0434\u0430\u043C, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0434\u0430\u0439\u0442\u0435 \u043F\u0430\u0440\u0443 \u0434\u043D\u0435\u0439\".
      \u0420\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A \u043D\u0435 \u043D\u0430\u043C\u0435\u0440\u0435\u043D
      \u0436\u0434\u0430\u0442\u044C. \u0415\u0433\u043E \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u0438
      \u044F\u0432\u043D\u043E \u0433\u043E\u0442\u043E\u0432\u044B \u0441\u043E\u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C
      \u0421\u0430\u043C\u0435\u0445\u0430 \u043A\u0443\u0434\u0430 \u0441\u043B\u0435\u0434\u0443\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101349
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0434\u043E\u043B\u0433
      \u0438\u0437 \u043A\u0430\u0437\u043D\u044B - \u043F\u043E\u0442\u043E\u043C
      \u0432\u044B\u0447\u0435\u0441\u0442\u044C \u0438\u0437 \u0434\u043E\u043B\u0438
      \u0421\u0430\u043C\u0435\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101350
    m_Localized: "\u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u043F\u044F\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0440\u0435\u0448\u0438\u043B\u0438
      \u0432\u043E\u043F\u0440\u043E\u0441. \u0420\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A
      \u0443\u0448\u0451\u043B, \u0421\u0430\u043C\u0435\u0445 \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B.
      \u041E\u043D \u043E\u0431\u0435\u0449\u0430\u043B \u0432\u043E\u0437\u043C\u0435\u0441\u0442\u0438\u0442\u044C
      - \u0438 \u0441\u0434\u0435\u0440\u0436\u0430\u043B \u0441\u043B\u043E\u0432\u043E
      \u0437\u0430 \u0442\u0440\u0438 \u043D\u0435\u0434\u0435\u043B\u0438, \u0440\u0430\u0431\u043E\u0442\u0430\u044F
      \u0431\u0435\u0437 \u043E\u0442\u0434\u044B\u0445\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101351
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u043F\u0443\u0441\u0442\u044C
      \u0441\u0430\u043C \u0440\u0435\u0448\u0430\u0435\u0442 \u0441\u0432\u043E\u0438
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101352
    m_Localized: "\u0421\u0430\u043C\u0435\u0445\u0430 \u0443\u0432\u0435\u043B\u0438
      \u043D\u0430 \u0447\u0430\u0441. \u0412\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u044B\u0439 - \u0432\u0438\u0434\u043D\u043E,
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0432\u044B\u0448\u0435\u043B
      \u0436\u0451\u0441\u0442\u043A\u0438\u043C. \u0414\u0435\u043D\u0435\u0433
      \u0433\u0434\u0435-\u0442\u043E \u043D\u0430\u0448\u0451\u043B, \u043D\u0435
      \u0441\u043F\u0440\u043E\u0441\u0438\u0432. \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439 \u0437\u043B\u0438\u043B\u0441\u044F \u043D\u0430
      \u0432\u0435\u0441\u044C \u043C\u0438\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101353
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u0441 \u0440\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A\u043E\u043C -
      \u043E\u0442\u0441\u0440\u043E\u0447\u043A\u0430 \u0432 \u043E\u0431\u043C\u0435\u043D
      \u043D\u0430 \u043D\u0430\u0448\u0443 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101354
    m_Localized: "\u0421\u043B\u043E\u0432\u043E \u0447\u0435\u0441\u0442\u043D\u043E\u0433\u043E
      \u043A\u0443\u043F\u0446\u0430 \u0441 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438
      \u0443\u0431\u0435\u0434\u0438\u043B\u043E \u0440\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A\u0430.
      \u0414\u0432\u0443\u0445\u043D\u0435\u0434\u0435\u043B\u044C\u043D\u0430\u044F
      \u043E\u0442\u0441\u0440\u043E\u0447\u043A\u0430. \u0421\u0430\u043C\u0435\u0445
      \u0443\u0441\u043F\u0435\u043B \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0434\u043E\u043B\u0433 \u043D\u0430 \u0440\u044B\u043D\u043A\u0435 \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0430.
      \u041E\u0431\u043E\u0448\u043B\u043E\u0441\u044C \u0434\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0438\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101355
    m_Localized: "\u0421\u0435\u043A\u0440\u0435\u0442\u043D\u044B\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u043A\u0443\u043F\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101356
    m_Localized: "\u041D\u0430 \u043D\u043E\u0447\u043D\u043E\u0439 \u0441\u0442\u043E\u044F\u043D\u043A\u0435
      \u043A\u0443\u043F\u0435\u0446-\u043A\u043E\u043C\u043F\u0430\u043D\u044C\u043E\u043D
      \u0421\u0430\u043C\u0435\u0445 \u0441\u0438\u0434\u0438\u0442 \u0443 \u043E\u0433\u043D\u044F
      \u0438 \u0447\u0435\u0440\u0442\u0438\u0442 \u0447\u0442\u043E-\u0442\u043E
      \u043D\u0430 \u043F\u0435\u0441\u043A\u0435. \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0441 \u0445\u0438\u0442\u0440\u043E: \"\u042F \u0437\u043D\u0430\u044E
      \u0442\u0440\u043E\u043F\u0443 \u0447\u0435\u0440\u0435\u0437 \u044E\u0436\u043D\u044B\u0439
      \u043E\u0442\u0440\u043E\u0433. \u041E\u043D\u0430 \u043D\u0430 \u0442\u0440\u0438
      \u0434\u043D\u044F \u043A\u043E\u0440\u043E\u0447\u0435 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438 \u0438 \u043E\u0431\u0445\u043E\u0434\u0438\u0442
      \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u044B\u0439 \u043F\u043E\u0441\u0442
      \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u0430. \u041C\u043E\u044F
      \u0441\u0435\u043C\u044C\u044F \u0445\u043E\u0434\u0438\u043B\u0430 \u0435\u044E
      \u0441\u043E\u0440\u043E\u043A \u043B\u0435\u0442. \u041F\u0440\u043E\u0434\u0430\u043C
      \u0437\u043D\u0430\u043D\u0438\u0435 \u0437\u0430 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0438 \u0434\u0435\u0441\u044F\u0442\u044C
      \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432 \u043E\u0442 \u0432\u044B\u0433\u043E\u0434\u044B
      \u0441 \u044D\u0442\u043E\u0433\u043E \u043F\u0440\u043E\u0445\u043E\u0434\u0430\".
      \u0422\u0440\u0438 \u0434\u043D\u044F - \u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u044F. \u041D\u043E \u0443\u0441\u043B\u043E\u0432\u0438\u044F
      \u0443 \u043D\u0435\u0433\u043E \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101357
    m_Localized: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0435\u0433\u043E \u0443\u0441\u043B\u043E\u0432\u0438\u044F
      - \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0441\u0442\u043E\u0438\u0442
      \u0442\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101358
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0439. \u0422\u0440\u0438
      \u0434\u043D\u044F \u0432\u044B\u0438\u0433\u0440\u0430\u043D\u043E, \u0442\u0430\u043C\u043E\u0436\u043D\u044F
      \u043E\u0431\u043E\u0439\u0434\u0435\u043D\u0430. \u0421\u0430\u043C\u0435\u0445
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0441\u0432\u043E\u0451 \u0438
      \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u043C.
      \u0412\u044B\u0433\u043E\u0434\u043D\u0430\u044F \u0441\u0434\u0435\u043B\u043A\u0430,
      \u0445\u043E\u0442\u044F \u0438 \u0434\u043E\u0440\u043E\u0433\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101359
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      - \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0431\u0435\u0437 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101360
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u043F\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0430\u043B\u0441\u044F
      \u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0441\u044F \u043D\u0430
      \u0441\u0435\u043C\u043D\u0430\u0434\u0446\u0430\u0442\u044C. \u0422\u0440\u043E\u043F\u0430
      \u0442\u0430 \u0436\u0435, \u0432\u044B\u0433\u043E\u0434\u0430 \u0442\u0430
      \u0436\u0435, \u043D\u043E \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0445\u043E\u043B\u043E\u0434\u043D\u0435\u0435
      - \u043E\u043D \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442, \u0447\u0442\u043E
      \u0435\u0433\u043E \u0443\u043C\u0435\u0440\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101361
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u043D\u0435\u0442
      \u0434\u043E\u0432\u0435\u0440\u0438\u044F \u0442\u0430\u0439\u043D\u044B\u043C
      \u0442\u0440\u043E\u043F\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101362
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u043F\u043E\u0436\u0430\u043B \u043F\u043B\u0435\u0447\u0430\u043C\u0438.
      \u041F\u043E\u0448\u043B\u0438 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u043C
      \u043F\u0443\u0442\u0451\u043C. \u0422\u0440\u0438 \u0434\u043D\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E,
      \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u044B\u0439 \u0441\u0431\u043E\u0440
      \u0443\u043F\u043B\u0430\u0447\u0435\u043D. \u0421\u0430\u043C\u0435\u0445
      \u043D\u0435 \u0437\u043B\u0438\u0442\u0441\u044F - \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0440\u0438\u0434\u0435\u0440\u0436\u0430\u043B \u0437\u043D\u0430\u043D\u0438\u0435
      \u043F\u0440\u0438 \u0441\u0435\u0431\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101363
    m_Localized: "\u041D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439 \u0434\u0438\u0430\u043B\u0435\u043A\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101364
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u0425\u043E\u0442\u0430\u043D\u0430
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u041C\u0430\u043D\u0430\u0445
      \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0441\u044F \u0441 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043E\u0439:
      \u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043D\u0430 \u0441\u0430\u043A\u0441\u043A\u043E\u043C
      \u0434\u0438\u0430\u043B\u0435\u043A\u0442\u0435, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u041C\u0430\u043D\u0430\u0445 \u0437\u043D\u0430\u0435\u0442 \u043F\u043B\u043E\u0445\u043E
      - \u043F\u0443\u0442\u0430\u0435\u0442 \u043F\u0430\u0434\u0435\u0436\u0438,
      \u0434\u0435\u043B\u0430\u0435\u0442 \u043F\u0430\u0443\u0437\u044B, \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0441 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043D\u0438\u0435\u043C.
      \u0412\u043E\u043A\u0440\u0443\u0433 \u0443\u0436\u0435 \u0441\u0442\u043E\u044F\u0442
      \u043B\u044E\u0434\u0438 \u0438 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044E\u0442.
      \u041C\u0430\u043D\u0430\u0445 \u043A\u0440\u0430\u0441\u043D\u0435\u0435\u0442.
      \u0421\u0434\u0435\u043B\u043A\u0430 \u0441 \u0445\u043E\u0440\u043E\u0448\u0438\u043C
      \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0435\u043C \u043F\u043E\u0434
      \u0443\u0433\u0440\u043E\u0437\u043E\u0439. \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u043B\u0438\u0446\u043E \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u043E,
      \u0447\u0442\u043E \u0432 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C
      \u043C\u0438\u0440\u0435 \u0425\u043E\u0442\u0430\u043D\u0430 - \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u044B\u0439
      \u0443\u0434\u0430\u0440 \u043F\u043E \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101365
    m_Localized: "\u0412\u043C\u0435\u0448\u0430\u0442\u044C\u0441\u044F \u0438 \u0436\u0435\u0441\u0442\u0430\u043C\u0438
      \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F -
      \u043F\u043E\u043C\u043E\u0447\u044C \u041C\u0430\u043D\u0430\u0445\u0443 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
      \u043B\u0438\u0446\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101366
    m_Localized: "\u0412\u044B \u0432\u043C\u0435\u0448\u0430\u043B\u0438\u0441\u044C,
      \u0434\u043E\u0431\u0430\u0432\u0438\u0432 \u0437\u043D\u0430\u043A\u0438 \u0438
      \u0440\u0438\u0441\u0443\u043D\u043A\u0438. \u0421\u0434\u0435\u043B\u043A\u0430
      \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u0430\u0441\u044C, \u0445\u043E\u0442\u044C
      \u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E. \u041C\u0430\u043D\u0430\u0445
      \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B\u0430
      - \u043C\u0435\u0441\u0442\u043D\u044B\u0435 \u0432\u043E\u0441\u043F\u0440\u0438\u043D\u044F\u043B\u0438
      \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044E \u0441 \u044E\u043C\u043E\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101367
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043C\u0435\u0441\u0442\u043D\u043E\u043C\u0443
      \u0442\u043E\u043B\u043C\u0430\u0447\u0443 \u0437\u0430 \u043F\u043E\u043C\u043E\u0449\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101368
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043C\u0435\u0441\u0442\u043D\u043E\u043C\u0443 \u043F\u0430\u0440\u043D\u044E
      \u0440\u0435\u0448\u0438\u043B\u0438 \u0432\u043E\u043F\u0440\u043E\u0441 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E.
      \u0421\u0434\u0435\u043B\u043A\u0430 \u043F\u0440\u043E\u0448\u043B\u0430 \u0433\u043B\u0430\u0434\u043A\u043E.
      \u041C\u0430\u043D\u0430\u0445 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442
      \u0441\u0435\u0431\u044F \u043D\u0435\u043B\u043E\u0432\u043A\u043E, \u043D\u043E
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0435\u043D. \u0422\u043E\u043B\u043C\u0430\u0447
      \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0445\u043E\u0440\u043E\u0448\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101369
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u0441\u0434\u0435\u043B\u043A\u0443
      - \u0443\u0439\u0442\u0438 \u0431\u0435\u0437 \u043F\u043E\u043A\u0443\u043F\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101370
    m_Localized: "\u0423\u0448\u043B\u0438 \u0431\u0435\u0437 \u0441\u0434\u0435\u043B\u043A\u0438.
      \u041C\u0430\u043D\u0430\u0445 \u043F\u043B\u0451\u043B\u0441\u044F \u0441\u043B\u0435\u0434\u043E\u043C,
      \u043C\u043E\u043B\u0447\u0430\u043B. \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0432\u0434\u0432\u043E\u0435
      \u0443\u0441\u0435\u0440\u0434\u043D\u0435\u0435, \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
      \u043E\u0442\u043A\u0443\u043F\u0430\u043B\u0441\u044F. \u0423\u043F\u0443\u0449\u0435\u043D\u043D\u0430\u044F
      \u0432\u044B\u0433\u043E\u0434\u0430 \u043E\u0449\u0443\u0449\u0430\u043B\u0430\u0441\u044C
      \u0432 \u043A\u0430\u0437\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101371
    m_Localized: "\u041F\u043E\u0434\u0441\u043B\u0443\u0448\u0430\u043D\u043D\u044B\u0439
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101372
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u041C\u0430\u043D\u0430\u0445
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u043A \u0432\u0430\u043C
      \u043D\u043E\u0447\u044C\u044E \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0431\u044B\u0441\u0442\u0440\u043E: \u043E\u043D \u0441\u0442\u043E\u044F\u043B
      \u0443 \u0441\u0442\u0435\u043D\u044B \u043D\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u043C
      \u0434\u0432\u043E\u0440\u0435 \u0432 \u041C\u0435\u0440\u0432\u0435 \u0438
      \u043F\u043E\u043D\u044F\u043B \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u0434\u0432\u0443\u0445 \u043F\u0435\u0440\u0441\u043E\u0432 \u043D\u0430
      \u0444\u0430\u0440\u0441\u0438. \u041A\u0443\u043F\u0435\u0446 \u042E\u0441\u0443\u0444
      \u0438\u0437 \u0420\u0435\u044F \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0435\u0442
      \u043F\u043E\u0434\u043A\u0443\u043F\u0438\u0442\u044C \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0438\u043A\u0430
      \u043D\u0430 \u0432\u044B\u0445\u043E\u0434\u0435 \u0438\u0437 \u0433\u043E\u0440\u043E\u0434\u0430,
      \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u043D\u0430\u0448 \u043E\u0431\u043E\u0437 \u043D\u0430 \u043D\u0435\u0434\u0435\u043B\u044E.
      \u041C\u0430\u043D\u0430\u0445 \u044D\u0442\u043E \u0441\u043B\u044B\u0448\u0430\u043B
      \u0442\u043E\u0447\u043D\u043E. \u0412\u043E\u043F\u0440\u043E\u0441 \u0432
      \u0442\u043E\u043C, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C:
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u0442\u044C \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u0430,
      \u043E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F \u043E\u0442 \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0438\u043A\u0430
      \u043F\u0435\u0440\u0432\u044B\u043C\u0438 - \u0438\u043B\u0438 \u043C\u043E\u043B\u0447\u0430\u0442\u044C
      \u0438 \u0441\u043C\u0435\u043D\u0438\u0442\u044C \u043C\u0430\u0440\u0448\u0440\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101373
    m_Localized: "\u0414\u043E\u043D\u0435\u0441\u0442\u0438 \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u0443
      - \u043F\u0443\u0441\u0442\u044C \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
      \u0441 \u042E\u0441\u0443\u0444\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101374
    m_Localized: "\u041D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A \u043E\u0442\u0440\u0435\u0430\u0433\u0438\u0440\u043E\u0432\u0430\u043B.
      \u042E\u0441\u0443\u0444 \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043D \u0434\u043B\u044F
      \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u043D\u0430 \u0434\u0432\u043E\u0435
      \u0441\u0443\u0442\u043E\u043A. \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B
      \u0431\u0435\u0441\u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E.
      \u041C\u0430\u043D\u0430\u0445 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B
      \u043D\u0435\u0440\u0432\u043D\u044B\u043C, \u043D\u043E \u0432\u0441\u0451
      \u043E\u0431\u043E\u0448\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101375
    m_Localized: "\u041E\u043F\u0435\u0440\u0435\u0434\u0438\u0442\u044C \u042E\u0441\u0443\u0444\u0430
      - \u0441\u0430\u043C\u0438\u043C \u043F\u043E\u0434\u043A\u0443\u043F\u0438\u0442\u044C
      \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101376
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0438\u043A\u0443. \u041E\u043D
      \u043F\u0440\u0438\u043D\u044F\u043B \u043C\u043E\u043B\u0447\u0430 \u0438
      \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B \u0431\u0435\u0437 \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430.
      \u042E\u0441\u0443\u0444 \u043F\u0440\u0438\u0448\u0451\u043B \u0441\u043E
      \u0441\u0432\u043E\u0438\u043C \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C
      \u043F\u043E\u0437\u0436\u0435 - \u0438 \u043D\u0435 \u043D\u0430\u0448\u0451\u043B
      \u043D\u0443\u0436\u043D\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.
      \u041E\u0431\u043E\u0437 \u0443\u0436\u0435 \u0443\u0435\u0445\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101377
    m_Localized: "\u0421\u043C\u0435\u043D\u0438\u0442\u044C \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      - \u0443\u0439\u0442\u0438 \u0447\u0435\u0440\u0435\u0437 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101378
    m_Localized: "\u0417\u0430\u043F\u0430\u0434\u043D\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430
      - \u043A\u0440\u044E\u043A \u0432 \u043F\u043E\u043B\u0434\u043D\u044F, \u043D\u043E
      \u0442\u0430\u043C \u0434\u0440\u0443\u0433\u043E\u0439 \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0438\u043A.
      \u041F\u0440\u043E\u0448\u043B\u0438 \u0431\u0435\u0437 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438.
      \u042E\u0441\u0443\u0444 \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0441
      \u043E\u0431\u0435\u0441\u0446\u0435\u043D\u0435\u043D\u043D\u044B\u043C \u0432\u0437\u044F\u0442\u043A\u043E\u043C.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u043F\u043E\u043B-\u0434\u043D\u044F,
      \u0432\u044B\u0438\u0433\u0440\u0430\u043B\u0438 \u043D\u0435\u0434\u0435\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101379
    m_Localized: "\u0420\u043E\u0434\u043D\u043E\u0439 \u0433\u043E\u0440\u043E\u0434
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101380
    m_Localized: "\u041E\u0431\u043E\u0437 \u0432\u044A\u0435\u0437\u0436\u0430\u0435\u0442
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434 \u0447\u0435\u0440\u0435\u0437
      \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430.
      \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u041C\u0430\u043D\u0430\u0445
      \u043C\u043E\u043B\u0447\u0438\u0442 \u0432\u0441\u044E \u0434\u043E\u0440\u043E\u0433\u0443,
      \u043D\u043E \u0443 \u0432\u043E\u0440\u043E\u0442 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0443\u043B\u0438\u0446\u0443
      \u0434\u043E\u043B\u0433\u043E - \u0434\u043E \u0432\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u0438
      \u0432 \u0433\u043B\u0430\u0437\u0430\u0445. \u041F\u043E\u0442\u043E\u043C
      \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F:
      \"\u042F \u0432\u044B\u0440\u043E\u0441 \u0432 \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0435
      \u0433\u043E\u0440\u0448\u0435\u0447\u043D\u0438\u043A\u043E\u0432, \u0432\u043E\u0442
      \u0437\u0430 \u044D\u0442\u043E\u0439 \u0441\u0442\u0435\u043D\u043E\u0439.
      \u042F \u043D\u0435 \u0431\u044B\u043B \u0437\u0434\u0435\u0441\u044C \u0434\u0435\u0432\u044F\u0442\u044C
      \u043B\u0435\u0442. \u0414\u0430\u0439\u0442\u0435 \u043C\u043D\u0435 \u0434\u0432\u0430
      \u0434\u043D\u044F. \u042F \u043D\u0435 \u043F\u0440\u043E\u0448\u0443 \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u044F
      \u0437\u0430 \u044D\u0442\u0438 \u0434\u043D\u0438 - \u043F\u0440\u043E\u0441\u0442\u043E
      \u0434\u0432\u0430 \u0434\u043D\u044F\". \u0415\u0433\u043E \u043C\u0430\u0442\u044C
      \u0436\u0438\u0432\u0430. \u041E\u043D \u0445\u043E\u0447\u0435\u0442 \u0443\u0432\u0438\u0434\u0435\u0442\u044C
      \u0435\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101381
    m_Localized: "\u0414\u0430\u0442\u044C \u0434\u0432\u0430 \u0434\u043D\u044F
      - \u043F\u0443\u0441\u0442\u044C \u043F\u043E\u0431\u0443\u0434\u0435\u0442
      \u0441 \u0441\u0435\u043C\u044C\u0451\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101382
    m_Localized: "\u041C\u0430\u043D\u0430\u0445 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u0434\u043D\u044F \u0441
      \u043F\u043E\u043A\u0440\u0430\u0441\u043D\u0435\u0432\u0448\u0438\u043C\u0438
      \u0433\u043B\u0430\u0437\u0430\u043C\u0438 \u0438 \u043B\u0435\u043F\u0451\u0448\u043A\u0430\u043C\u0438
      \u043E\u0442 \u043C\u0430\u0442\u0435\u0440\u0438. \u0420\u0430\u0431\u043E\u0442\u0430\u043B
      \u043F\u043E\u0442\u043E\u043C \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E
      \u0434\u043E\u043B\u0433 \u043E\u0442\u0434\u0430\u0432\u0430\u043B. \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434
      \u0441\u0442\u0430\u043B \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u0441\u043D\u043E\u0432\u0430
      \u0441\u0432\u043E\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101383
    m_Localized: "\u0414\u0430\u0442\u044C \u043E\u0434\u0438\u043D \u0434\u0435\u043D\u044C
      - \u0437\u0430\u0432\u0442\u0440\u0430 \u0432\u044B\u0435\u0437\u0436\u0430\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101384
    m_Localized: "\u041C\u0430\u043D\u0430\u0445 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0441 \u043F\u0435\u0440\u0432\u044B\u043C\u0438 \u043F\u0435\u0442\u0443\u0445\u0430\u043C\u0438,
      \u043D\u0435 \u0432\u044B\u0441\u043F\u0430\u0432\u0448\u0438\u0439\u0441\u044F.
      \u041C\u0430\u0442\u044C \u043E\u043D \u0443\u0432\u0438\u0434\u0435\u043B.
      \u042D\u0442\u043E\u0433\u043E \u0435\u043C\u0443 \u0445\u0432\u0430\u0442\u0438\u043B\u043E.
      \u041E\u0434\u0438\u043D \u0434\u0435\u043D\u044C \u043F\u043E\u0442\u0435\u0440\u044F\u043D,
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0434\u043E\u0432\u043E\u043B\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101385
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435
      \u0434\u0435\u043B\u0430 \u043D\u0435 \u0436\u0434\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101386
    m_Localized: "\u041C\u0430\u043D\u0430\u0445 \u043A\u0438\u0432\u043D\u0443\u043B
      \u0438 \u043F\u043E\u0448\u0451\u043B \u0434\u0430\u043B\u044C\u0448\u0435.
      \u0412\u0441\u0451 \u0432\u0440\u0435\u043C\u044F \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0430 \u0433\u043E\u0440\u0448\u0435\u0447\u043D\u0438\u043A\u043E\u0432.
      \u0420\u0430\u0431\u043E\u0442\u0430\u043B \u0438\u0441\u043F\u0440\u0430\u0432\u043D\u043E.
      \u041D\u043E \u0447\u0442\u043E-\u0442\u043E \u0432 \u043D\u0451\u043C \u0437\u0430\u043A\u0440\u044B\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101387
    m_Localized: "\u041F\u0440\u043E\u0438\u0433\u0440\u044B\u0448 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101388
    m_Localized: "\u041D\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u043C
      \u0434\u0432\u043E\u0440\u0435 \u0432 \u041E\u0448\u0435 \u043A \u0432\u0430\u043C
      \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0442 \u0434\u0432\u043E\u0435 \u043C\u0435\u0441\u0442\u043D\u044B\u0445
      \u0441 \u0432\u0438\u0434\u043E\u043C \u0445\u043E\u0437\u044F\u0435\u0432
      - \u0448\u0438\u0440\u043E\u043A\u0438\u0435 \u043F\u043B\u0435\u0447\u0438,
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435 \u0441\u0430\u0431\u043B\u0438
      \u0443 \u043F\u043E\u044F\u0441\u0430. \u041E\u043D\u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0442
      \u043F\u043E-\u0442\u044E\u0440\u043A\u0441\u043A\u0438, \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0411\u0443\u0433\u0430 \u0441\u043B\u0443\u0448\u0430\u0435\u0442 \u0441
      \u043E\u043F\u0443\u0449\u0435\u043D\u043D\u043E\u0439 \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \u041E\u043D\u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u044E\u0442:
      \u0411\u0443\u0433\u0430 \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043B \u0438\u043C
      \u043F\u0440\u043E\u0448\u043B\u043E\u0439 \u043D\u043E\u0447\u044C\u044E \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0432 \u043A\u043E\u0441\u0442\u0438
      \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0432 \u0437\u0430\u043B\u043E\u0433
      \"\u0441\u043B\u043E\u0432\u043E \u043A\u0443\u043F\u0446\u0430 \u043F\u0440\u0438
      \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0441\u043B\u0443\u0436\u0438\u0442\".
      \u041F\u043E \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u043C\u0443 \u043E\u0431\u044B\u0447\u0430\u044E
      \u044D\u0442\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442, \u0447\u0442\u043E
      \u0432\u044B \u043F\u043E\u0440\u0443\u0447\u0438\u0442\u0435\u043B\u044C.
      \u0411\u0443\u0433\u0430 \u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101389
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0434\u043E\u043B\u0433
      - \u0438 \u0436\u0451\u0441\u0442\u043A\u043E \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0441 \u0411\u0443\u0433\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101390
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0443\u043F\u043B\u0430\u0447\u0435\u043D\u044B. \u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u0441 \u0411\u0443\u0433\u043E\u0439 \u0432\u044B\u0448\u0435\u043B \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C
      \u0438 \u044F\u0441\u043D\u044B\u043C. \u041E\u043D \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B,
      \u043A\u0438\u0432\u043D\u0443\u043B, \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B
      \u043F\u0440\u043E\u0449\u0435\u043D\u0438\u044F. \u0411\u043E\u043B\u044C\u0448\u0435
      \u043A\u0443\u0431\u0438\u043A\u0438 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101391
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u044D\u0442\u043E
      \u043B\u0438\u0447\u043D\u044B\u0439 \u0434\u043E\u043B\u0433 \u0411\u0443\u0433\u0438,
      \u043F\u0443\u0441\u0442\u044C \u0441\u0430\u043C \u043F\u043B\u0430\u0442\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101392
    m_Localized: "\u0414\u0432\u043E\u0435 \u0441\u0442\u0430\u043B\u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0443\u0433\u0440\u043E\u0436\u0430\u044E\u0449\u0435. \u0411\u0443\u0433\u0430
      \u043D\u0430\u0448\u0451\u043B \u0434\u0435\u043D\u044C\u0433\u0438 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E
      \u043A\u0430\u043A - \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0437\u0430\u043D\u044F\u043B
      \u0443 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432. \u041E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F
      \u0432 \u043E\u0431\u043E\u0437\u0435 \u0441\u0442\u0430\u043B\u0438 \u043D\u0430\u043F\u0440\u044F\u0436\u0451\u043D\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101393
    m_Localized: "\u0414\u0430\u0442\u044C \u0411\u0443\u0433\u0435 \u0432 \u0434\u043E\u043B\u0433
      \u0438\u0437 \u043A\u0430\u0437\u043D\u044B - \u043F\u0443\u0441\u0442\u044C
      \u0441\u0430\u043C \u043E\u0442\u0434\u0430\u0441\u0442 \u043F\u043E\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101394
    m_Localized: "\u0411\u0443\u0433\u0430 \u0432\u0437\u044F\u043B \u0432 \u0434\u043E\u043B\u0433
      \u0438 \u0440\u0430\u0441\u043F\u043B\u0430\u0442\u0438\u043B\u0441\u044F.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u0432\u0435\u0440\u043D\u0443\u043B \u0437\u0430
      \u0442\u0440\u0438 \u043D\u0435\u0434\u0435\u043B\u0438 \u043F\u043E \u0447\u0430\u0441\u0442\u044F\u043C.
      \u0427\u0435\u0441\u0442\u043D\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u043D\u043E \u043D\u0435\u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u0439
      \u0441 \u043A\u043E\u0441\u0442\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101395
    m_Localized: "\u041E\u043F\u0430\u0441\u043D\u044B\u0439 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101396
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0411\u0443\u0433\u0430
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043D\u0430 \u0433\u043E\u0440\u043D\u044B\u0439
      \u0441\u043A\u043B\u043E\u043D: \"\u0415\u0441\u043B\u0438 \u043F\u043E\u0439\u0434\u0451\u043C
      \u0447\u0435\u0440\u0435\u0437 \u043F\u0435\u0440\u0435\u0432\u0430\u043B \u0410\u043A-\u0421\u0443\u0443,
      \u043C\u044B \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043C \u0434\u0435\u043D\u044C.
      \u0422\u0440\u043E\u043F\u0430 \u043A\u0440\u0443\u0442\u0430\u044F - \u043E\u0434\u0438\u043D
      \u043E\u0441\u044B\u043F\u043D\u043E\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A
      \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u0441\u0442\u043E \u0448\u0430\u0433\u043E\u0432.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u043F\u0440\u043E\u0439\u0434\u0443\u0442,
      \u0435\u0441\u043B\u0438 \u0432\u0435\u0441\u0442\u0438 \u043F\u043E\u0434
      \u0443\u0437\u0434\u0446\u044B. \u042F \u0445\u043E\u0434\u0438\u043B \u0437\u0434\u0435\u0441\u044C
      \u0434\u0432\u0430\u0436\u0434\u044B\". \u041E\u043D \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u0447\u0442\u043E \u043F\u0440\u043E\u0448\u043B\u044B\u0439 \u0440\u0430\u0437
      \u0431\u044B\u043B \u0431\u0435\u0437 \u0433\u0440\u0443\u0437\u0430 \u0438
      \u0432 \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443.
      \u041D\u0435\u0431\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0441
      \u0443\u0442\u0440\u0430 \u0437\u0430\u0442\u044F\u043D\u0443\u043B\u043E.
      \u0414\u0435\u043D\u044C - \u044D\u0442\u043E \u043C\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101397
    m_Localized: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F
      - \u0440\u0438\u0441\u043A\u043D\u0443\u0442\u044C \u0440\u0430\u0434\u0438
      \u0434\u043D\u044F \u043F\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101398
    m_Localized: "\u041E\u0441\u044B\u043F\u043D\u043E\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A
      \u0434\u0430\u043B\u0441\u044F \u0442\u044F\u0436\u0435\u043B\u043E. \u041E\u0434\u0438\u043D
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434 \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0441\u044F,
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0442\u044E\u043A \u0432 \u0443\u0449\u0435\u043B\u044C\u0435.
      \u041D\u043E \u0432\u0441\u0435 \u043F\u0440\u043E\u0448\u043B\u0438. \u0414\u0435\u043D\u044C
      \u0432\u044B\u0438\u0433\u0440\u0430\u043B\u0438. \u0411\u0443\u0433\u0430
      \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101399
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u0438\u0434\u0451\u043C
      \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u043C \u043F\u0443\u0442\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101400
    m_Localized: "\u041E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u043F\u0443\u0442\u044C
      \u0437\u0430\u043D\u044F\u043B \u0434\u0435\u043D\u044C \u0431\u043E\u043B\u044C\u0448\u0435,
      \u043A\u0430\u043A \u0438 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u043B
      \u0411\u0443\u0433\u0430. \u041D\u0438\u043A\u0430\u043A\u0438\u0445 \u043F\u043E\u0442\u0435\u0440\u044C,
      \u043D\u0438\u043A\u0430\u043A\u043E\u0433\u043E \u0440\u0438\u0441\u043A\u0430.
      \u0411\u0443\u0433\u0430 \u043D\u0435 \u0441\u043F\u043E\u0440\u0438\u043B
      - \u0432 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432,
      \u044D\u0442\u043E \u0435\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u0430:
      \u0437\u043D\u0430\u0442\u044C, \u0430 \u043D\u0435 \u0440\u0435\u0448\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101401
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0434\u043E \u0443\u0442\u0440\u0430 - \u043E\u0446\u0435\u043D\u0438\u0442\u044C
      \u043F\u043E\u0433\u043E\u0434\u0443 \u0437\u0430\u043D\u043E\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101402
    m_Localized: "\u0423\u0442\u0440\u043E\u043C \u043D\u0435\u0431\u043E \u043F\u0440\u043E\u044F\u0441\u043D\u0438\u043B\u043E\u0441\u044C.
      \u041F\u0440\u043E\u0448\u043B\u0438 \u0447\u0435\u0440\u0435\u0437 \u0410\u043A-\u0421\u0443\u0443
      \u0431\u0435\u0437 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u043F\u043E\u043B\u0434\u043D\u044F
      \u043D\u0430 \u043D\u043E\u0447\u0451\u0432\u043A\u0443. \u0420\u0430\u0437\u0443\u043C\u043D\u0430\u044F
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u044C -
      \u043E\u0441\u044B\u043F\u044C \u043F\u043E\u0441\u043B\u0435 \u0434\u043E\u0436\u0434\u044F
      \u0431\u044B\u043B\u0430 \u0431\u044B \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101403
    m_Localized: "\u041E\u0448\u0438\u0431\u043A\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101404
    m_Localized: "\u041D\u0430 \u0442\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C
      \u0432 \u0433\u043E\u0440\u0430\u0445 \u0411\u0443\u0433\u0430 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u0434\u043E\u043B\u0433\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0441\u043A\u043B\u043E\u043D\u044B. \u041F\u043E\u0442\u043E\u043C
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0441 \u0442\u0440\u0443\u0434\u043E\u043C:
      \"\u042F \u0432\u044B\u0431\u0440\u0430\u043B \u043D\u0435 \u0442\u043E\u0442
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B. \u0422\u043E\u0442, \u0447\u0442\u043E
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438 - \u043D\u0435 \u0410\u043A-\u0411\u0430\u0439\u0442\u0430\u043B,
      \u0430 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0439, \u043E\u043D \u0432\u0435\u0434\u0451\u0442
      \u043A \u043C\u0451\u0440\u0442\u0432\u043E\u043C\u0443 \u0443\u0449\u0435\u043B\u044C\u044E.
      \u041D\u0443\u0436\u043D\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0434\u0432\u0430 \u0434\u043D\u044F \u043D\u0430\u0437\u0430\u0434
      \u043A \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0435\". \u0414\u0432\u0430
      \u0434\u043D\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E. \u041E\u0448\u0438\u0431\u043A\u0430
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F, \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u044F\u0432\u043D\u043E \u043D\u0435 \u0441\u043F\u0430\u043B \u0432\u0441\u044E
      \u043D\u043E\u0447\u044C. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043C\u043E\u043B\u0447\u0430\u0442, \u043D\u043E \u0441\u043C\u043E\u0442\u0440\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101405
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043E\u0448\u0438\u0431\u043A\u0443
      \u0438 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0431\u0435\u0437
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101406
    m_Localized: "\u041F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0438 \u043C\u043E\u043B\u0447\u0430.
      \u0411\u0443\u0433\u0430 \u0448\u0451\u043B \u0432\u043F\u0435\u0440\u0435\u0434\u0438,
      \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044F \u0433\u043E\u043B\u043E\u0432\u044B.
      \u0414\u0432\u0430 \u0434\u043D\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0432\u043E\u0440\u0447\u0430\u043B\u0438
      \u043C\u0435\u0436\u0434\u0443 \u0441\u043E\u0431\u043E\u0439. \u041A \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C\u0443
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0443 \u0432\u044B\u0448\u043B\u0438
      \u043D\u0430 \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439 \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101407
    m_Localized: "\u041E\u0448\u0442\u0440\u0430\u0444\u043E\u0432\u0430\u0442\u044C
      \u0411\u0443\u0433\u0443 - \u0432\u044B\u0447\u0435\u0441\u0442\u044C \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0435
      \u0434\u043D\u0438 \u0438\u0437 \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101408
    m_Localized: "\u0412\u044B\u0447\u0435\u0442 \u0438\u0437 \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u044F
      \u0411\u0443\u0433\u0430 \u043F\u0440\u0438\u043D\u044F\u043B \u0431\u0435\u0437
      \u0432\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0439. \u0417\u0430\u0442\u043E
      \u0448\u0451\u043B \u043C\u043E\u043B\u0447\u0430 \u0438 \u0437\u043B\u0438\u043B\u0441\u044F.
      \u041D\u0430 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0439 \u0442\u0440\u043E\u043F\u0435
      \u043E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E,
      \u043D\u043E \u0434\u043E\u0432\u0435\u0440\u0438\u0435 \u0434\u0430\u043B\u043E
      \u0442\u0440\u0435\u0449\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101409
    m_Localized: "\u041E\u0431\u044A\u044F\u0432\u0438\u0442\u044C \u043E\u0431 \u043E\u0448\u0438\u0431\u043A\u0435
      \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u043E \u043F\u0435\u0440\u0435\u0434
      \u0432\u0441\u0435\u043C \u043E\u0431\u043E\u0437\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101410
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B\u0438
      \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435 \u0411\u0443\u0433\u0438
      \u0438 \u0434\u0432\u0438\u043D\u0443\u043B\u0438\u0441\u044C \u043D\u0430\u0437\u0430\u0434.
      \u041D\u043E \u0442\u0440\u043E\u0435 \u0441\u0442\u0430\u043B\u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043D\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430 \u0441
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C \u043D\u0435\u0434\u043E\u0432\u0435\u0440\u0438\u0435\u043C.
      \u0411\u0443\u0433\u0430 \u0432\u0451\u043B \u0434\u0430\u043B\u044C\u0448\u0435
      \u0442\u043E\u0447\u043D\u043E, \u043D\u043E \u0441\u043B\u043E\u043C\u0430\u043B\u0441\u044F
      \u0432\u043D\u0443\u0442\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101411
    m_Localized: "\u0411\u0430\u0440\u0441\u0438\u0446\u0430 \u0441 \u0434\u0435\u0442\u0451\u043D\u044B\u0448\u0430\u043C\u0438
      \u043D\u0430 \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101412
    m_Localized: "\u0423\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u0445\u043E\u043B\u043E\u0434
      \u0432 \u0443\u0449\u0435\u043B\u044C\u0435 \u0421\u0430\u0440\u0435\u0437
      - \u0438 \u0432\u0434\u0440\u0443\u0433 \u0432 \u043F\u044F\u0442\u0438\u0434\u0435\u0441\u044F\u0442\u0438
      \u0448\u0430\u0433\u0430\u0445 \u043D\u0430 \u0442\u0440\u043E\u043F\u0435
      \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043A\u0440\u0443\u043F\u043D\u0430\u044F
      \u0441\u0430\u043C\u043A\u0430 \u0441\u043D\u0435\u0436\u043D\u043E\u0433\u043E
      \u0431\u0430\u0440\u0441\u0430. \u041F\u043E\u0437\u0430\u0434\u0438 \u043D\u0435\u0451
      \u0434\u0432\u043E\u0435 \u043A\u043E\u0442\u044F\u0442 - \u0438\u043C \u043D\u0435
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0442\u0440\u0451\u0445 \u043C\u0435\u0441\u044F\u0446\u0435\u0432,
      \u0445\u0432\u043E\u0441\u0442\u044B \u0442\u043E\u043B\u0441\u0442\u044B\u0435,
      \u043B\u0430\u043F\u044B \u043D\u0435\u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E
      \u0431\u043E\u043B\u044C\u0448\u0438\u0435. \u041C\u0430\u0442\u044C \u043D\u0435
      \u0443\u0431\u0435\u0433\u0430\u0435\u0442: \u043E\u043D\u0430 \u0432\u0441\u0442\u0430\u043B\u0430
      \u0431\u043E\u043A\u043E\u043C, \u0445\u0432\u043E\u0441\u0442 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u043E,
      \u0443\u0448\u0438 \u043F\u0440\u0438\u0436\u0430\u0442\u044B - \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435.
      \u041A\u043E\u0442\u044F\u0442\u0430 \u043F\u0440\u044F\u0447\u0443\u0442\u0441\u044F
      \u0437\u0430 \u043D\u0435\u0439. \u0422\u0440\u043E\u043F\u0430 \u0448\u0438\u0440\u0438\u043D\u043E\u0439
      \u0432 \u043E\u0434\u043D\u043E\u0433\u043E \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430.
      \u0421\u0430\u043C\u043A\u0430 \u0441\u043D\u0435\u0436\u043D\u043E\u0433\u043E
      \u0431\u0430\u0440\u0441\u0430 \u0441 \u043C\u043E\u043B\u043E\u0434\u043D\u044F\u043A\u043E\u043C
      \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442 \u0438\u0445 \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u043E
      - \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0435\u0451 \u043D\u0435\u043B\u044C\u0437\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101413
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043E\u0431\u043E\u0437
      \u0438 \u0436\u0434\u0430\u0442\u044C, \u043F\u043E\u043A\u0430 \u043E\u043D\u0430
      \u0443\u0439\u0434\u0451\u0442 \u0441\u0430\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101414
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u0431\u0430\u0440\u0441\u0438\u0446\u0430
      \u0443\u0432\u0435\u043B\u0430 \u043A\u043E\u0442\u044F\u0442 \u0432 \u0441\u043A\u0430\u043B\u044B.
      \u0422\u0440\u043E\u043F\u0430 \u043E\u0442\u043A\u0440\u044B\u043B\u0430\u0441\u044C.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0447\u0430\u0441, \u043D\u043E
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0434\u043E\u043B\u0433\u043E
      \u043C\u043E\u043B\u0447\u0430\u043B\u0438 - \u0442\u0430\u043A\u043E\u0435
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0442 \u0440\u0430\u0437 \u0432
      \u0436\u0438\u0437\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101415
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u043A\u0430\u043C\u043D\u0438
      \u0438 \u043A\u0440\u0438\u0447\u0430\u0442\u044C - \u043F\u0440\u043E\u0433\u043D\u0430\u0442\u044C
      \u0448\u0443\u043C\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101416
    m_Localized: "\u0411\u0430\u0440\u0441\u0438\u0446\u0430 \u043F\u0440\u044B\u0433\u043D\u0443\u043B\u0430
      \u043D\u0430 \u0431\u0440\u043E\u0441\u0438\u0432\u0448\u0435\u0433\u043E \u043A\u0430\u043C\u0435\u043D\u044C
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430. \u0426\u0430\u0440\u0430\u043F\u0438\u043D\u0430
      \u043D\u0430 \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u044C\u0435,
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0443\u043F\u0430\u043B \u043D\u0430\u0437\u0430\u0434.
      \u041E\u043D\u0430 \u043D\u0435 \u043F\u0440\u0435\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u0430.
      \u041A\u043E\u0442\u044F\u0442\u0430 \u0443\u0431\u0435\u0436\u0430\u043B\u0438
      \u0432 \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0443. \u0422\u0440\u043E\u043F\u0430
      \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u043B\u0430\u0441\u044C, \u043D\u043E
      \u043A\u0440\u043E\u0432\u044C \u043F\u0440\u043E\u043B\u0438\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101417
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u043F\u043E \u0432\u0435\u0440\u0445\u043D\u0435\u043C\u0443
      \u043A\u0430\u0440\u043D\u0438\u0437\u0443 - \u043E\u0431\u0445\u043E\u0434
      \u043D\u0430\u0434 \u0442\u0440\u043E\u043F\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101418
    m_Localized: "\u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u043F\u0440\u043E\u0448\u043B\u0438
      \u043F\u043E \u043A\u0430\u0440\u043D\u0438\u0437\u0443 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E,
      \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443. \u0411\u0430\u0440\u0441\u0438\u0446\u0430
      \u0441\u043B\u0435\u0434\u0438\u043B\u0430 \u0441\u043D\u0438\u0437\u0443,
      \u043D\u043E \u043D\u0435 \u0442\u0440\u043E\u043D\u0443\u043B\u0430\u0441\u044C.
      \u041F\u043E\u043B\u0447\u0430\u0441\u0430 \u043C\u0430\u043D\u0435\u0432\u0440\u0430.
      \u041A\u043E\u0442\u044F\u0442\u0430 \u0432\u0441\u0451 \u044D\u0442\u043E
      \u0432\u0440\u0435\u043C\u044F \u0438\u0433\u0440\u0430\u043B\u0438 \u0441
      \u0445\u0432\u043E\u0441\u0442\u043E\u043C \u043C\u0430\u0442\u0435\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101419
    m_Localized: "\u0412\u043E\u043B\u043A\u0438 \u0438 \u0441\u0442\u0430\u0434\u043E
      \u044F\u043A\u043E\u0432 \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101420
    m_Localized: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435,
      \u0432 \u0441\u0438\u0437\u043E\u043C \u0442\u0443\u043C\u0430\u043D\u0435,
      \u043E\u0431\u043E\u0437 \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043D\u0430
      \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0435 \u043F\u0430\u0441\u0442\u0431\u0438\u0449\u0435
      \u0438 \u0432\u0438\u0434\u0438\u0442: \u0432 \u0442\u0440\u0451\u0445\u0441\u0442\u0430\u0445
      \u0448\u0430\u0433\u0430\u0445 \u0441\u0435\u043C\u044C \u0432\u043E\u043B\u043A\u043E\u0432
      \u0434\u0435\u043B\u043E\u0432\u0438\u0442\u043E \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0442
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u0441\u0442\u0430\u0434\u043E
      \u044F\u043A\u043E\u0432 - \u044F\u0432\u043D\u043E \u043D\u0435 \u0432\u0430\u0448\u0438\u0445.
      \u0412\u043E\u043B\u043A\u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442
      \u0432 \u043F\u0430\u0440\u0435, \u043E\u0442\u0440\u0435\u0437\u0430\u044F
      \u043C\u043E\u043B\u043E\u0434\u043E\u0433\u043E \u044F\u043A\u0430 \u043E\u0442
      \u0441\u0442\u0430\u0434\u0430. \u042F\u043A\u0438 \u0440\u0435\u0432\u0443\u0442.
      \u0425\u043E\u0437\u044F\u0438\u043D\u0430 \u0441\u0442\u0430\u0434\u0430 \u043D\u0435
      \u0432\u0438\u0434\u043D\u043E. \u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u0443\u0439\u0442\u0438, \u043D\u0435 \u0432\u043C\u0435\u0448\u0438\u0432\u0430\u044F\u0441\u044C
      - \u044D\u0442\u043E \u043F\u0440\u0438\u0440\u043E\u0434\u0430. \u0418\u043B\u0438
      \u043F\u043E\u043C\u043E\u0447\u044C. \u0418\u043B\u0438 \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0441\u0443\u043C\u0430\u0442\u043E\u0445\u043E\u0439 \u0434\u043B\u044F \u043E\u0445\u043E\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101421
    m_Localized: "\u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C \u0432\u043E\u043B\u043A\u043E\u0432
      - \u043F\u043E\u043C\u043E\u0447\u044C \u0441\u0442\u0430\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101422
    m_Localized: "\u041A\u0440\u0438\u043A, \u043E\u0433\u043E\u043D\u044C, \u0444\u0430\u043A\u0435\u043B\u0430
      - \u0432\u043E\u043B\u043A\u0438 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438.
      \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
      \u043F\u0430\u0441\u0442\u0443\u0445-\u0442\u0438\u0431\u0435\u0442\u0435\u0446,
      \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u043B\u0441\u044F \u043D\u0438\u0437\u043A\u043E
      \u0438 \u043F\u0440\u0438\u0432\u0451\u043B \u043E\u0432\u0446\u0443 \u0432
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C.
      \u041D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u0430\u044F \u043F\u0440\u0438\u0431\u044B\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101423
    m_Localized: "\u041E\u0445\u043E\u0442\u0438\u0442\u044C\u0441\u044F \u043D\u0430
      \u0432\u043E\u043B\u043A\u043E\u0432 - \u0441\u0432\u0435\u0436\u0435\u0435
      \u043C\u044F\u0441\u043E \u043D\u0443\u0436\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101424
    m_Localized: "\u041E\u0445\u043E\u0442\u043D\u0438\u043A\u0438 \u0443\u0431\u0438\u043B\u0438
      \u0434\u0432\u0443\u0445 \u0432\u043E\u043B\u043A\u043E\u0432. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0443\u0448\u043B\u0438. \u042F\u043A\u0438 \u0443\u0446\u0435\u043B\u0435\u043B\u0438.
      \u0421\u0432\u0435\u0436\u0435\u0435 \u043C\u044F\u0441\u043E \u0443 \u043B\u0430\u0433\u0435\u0440\u044F.
      \u041F\u0430\u0441\u0442\u0443\u0445 \u043F\u0440\u0438\u0448\u0451\u043B \u043F\u043E\u0437\u0436\u0435
      - \u0431\u0435\u0437 \u0440\u0430\u0434\u043E\u0441\u0442\u0438, \u0432\u043E\u043B\u0447\u044C\u0438
      \u0448\u043A\u0443\u0440\u044B \u0443 \u043D\u0435\u0433\u043E \u0431\u044B\u043B\u0438
      \u0431\u044B \u0441\u0432\u043E\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101425
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E -
      \u043D\u0435 \u043D\u0430\u0448 \u0441\u043A\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101426
    m_Localized: "\u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B,
      \u043D\u0435 \u0432\u043C\u0435\u0448\u0430\u0432\u0448\u0438\u0441\u044C.
      \u0412\u043E\u0439 \u0438 \u0440\u0451\u0432 \u0443\u0442\u0438\u0445\u043B\u0438
      \u0437\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u043C. \u041C\u043E\u043B\u043E\u0434\u043E\u0439
      \u044F\u043A, \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E,
      \u043F\u043E\u0433\u0438\u0431. \u041D\u0438\u043A\u0430\u043A\u0438\u0445
      \u043F\u043E\u0442\u0435\u0440\u044C \u0443 \u043E\u0431\u043E\u0437\u0430,
      \u043D\u0438\u043A\u0430\u043A\u043E\u0439 \u043F\u043E\u043B\u044C\u0437\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101427
    m_Localized: "\u0422\u0430\u0431\u0443\u043D \u0434\u0436\u0435\u0439\u0440\u0430\u043D\u043E\u0432
      \u043D\u0430 \u043F\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101428
    m_Localized: "\u0417\u0435\u043C\u043B\u044F \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u0434\u0440\u043E\u0436\u0430\u0442\u044C \u043F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438
      \u0437\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0438\u043D\u0443\u0442
      \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442
      \u0442\u0435\u043C\u043D\u0435\u0435\u0442. \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0442\u044B\u0441\u044F\u0447 \u0434\u0436\u0435\u0439\u0440\u0430\u043D\u043E\u0432
      \u0438\u0434\u0443\u0442 \u0448\u0438\u0440\u043E\u043A\u0438\u043C \u0444\u0440\u043E\u043D\u0442\u043E\u043C
      \u0447\u0435\u0440\u0435\u0437 \u0440\u0430\u0432\u043D\u0438\u043D\u0443 -
      \u0438\u0445 \u0440\u044B\u0436\u0435-\u0441\u0435\u0440\u044B\u0435 \u0441\u043F\u0438\u043D\u044B
      \u0441\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0432 \u0432\u043E\u043B\u043D\u0443.
      \u041F\u044B\u043B\u044C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u0441\u0442\u0435\u043D\u043E\u0439 \u0432\u044B\u0441\u043E\u0442\u043E\u0439
      \u0432 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0448\u0430\u0433\u043E\u0432.
      \u0412\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u044C - \u043D\u043E\u043B\u044C.
      \u0414\u0436\u0435\u0439\u0440\u0430\u043D\u044B \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u044E\u0442
      \u043B\u044E\u0434\u0435\u0439 \u0438 \u043E\u0431\u0445\u043E\u0434\u044F\u0442
      \u0438\u0445 \u0441\u0442\u0430\u0434\u043D\u044B\u043C \u0440\u0435\u0444\u043B\u0435\u043A\u0441\u043E\u043C.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u044F\u0442\u0441\u044F.
      \u0415\u0441\u043B\u0438 \u0432\u043E\u0439\u0442\u0438 \u0432 \u043F\u043E\u0442\u043E\u043A
      - \u0437\u0430\u0442\u043E\u043F\u0447\u0443\u0442, \u0435\u0441\u043B\u0438
      \u043F\u0435\u0440\u0435\u0436\u0438\u0434\u0430\u0442\u044C - \u0443\u0439\u0434\u0451\u0442
      \u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101429
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043E\u0431\u043E\u0437
      \u0438 \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C - \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101430
    m_Localized: "\u0427\u0430\u0441 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F
      \u0432 \u043F\u044B\u043B\u0438. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0437\u0430\u043A\u0440\u044B\u043B\u0438 \u043B\u0438\u0446\u0430 \u0442\u043A\u0430\u043D\u044C\u044E.
      \u0421\u0442\u0430\u0434\u043E \u043F\u0440\u043E\u0448\u043B\u043E \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E.
      \u041E\u0431\u043E\u0437 \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435
      \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C. \u0417\u0440\u0435\u043B\u0438\u0449\u0435
      \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u0441\u044F \u043D\u0430\u0434\u043E\u043B\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101431
    m_Localized: "\u041E\u0445\u043E\u0442\u0438\u0442\u044C\u0441\u044F \u043D\u0430
      \u043A\u0440\u0430\u044E \u0441\u0442\u0430\u0434\u0430 - \u043F\u043E\u0434\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u044C
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101432
    m_Localized: "\u041E\u0445\u043E\u0442\u043D\u0438\u043A\u0438 \u0434\u043E\u0431\u044B\u043B\u0438
      \u0442\u0440\u0451\u0445 \u0434\u0436\u0435\u0439\u0440\u0430\u043D\u043E\u0432
      \u043D\u0430 \u043A\u0440\u0430\u044E. \u0421\u0432\u0435\u0436\u0430\u044F
      \u0434\u0438\u0447\u044C - \u0445\u0432\u0430\u0442\u0438\u0442 \u043D\u0430
      \u0434\u0432\u0430 \u0434\u043D\u044F. \u041E\u0431\u043E\u0437 \u0441\u0442\u043E\u044F\u043B
      \u0447\u0443\u0442\u044C \u0434\u043E\u043B\u044C\u0448\u0435, \u043D\u043E
      \u0441 \u043C\u044F\u0441\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101433
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F \u0447\u0435\u0440\u0435\u0437
      \u043F\u043E\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101434
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u0432\u043E\u0448\u0451\u043B \u0432 \u0441\u0442\u0430\u0434\u043E \u0438
      \u0442\u0443\u0442 \u0436\u0435 \u0448\u0430\u0440\u0430\u0445\u043D\u0443\u043B\u0441\u044F
      - \u0442\u0430\u0431\u0443\u043D \u0443\u0434\u0430\u0440\u0438\u043B \u0435\u0433\u043E
      \u0441 \u0431\u043E\u043A\u043E\u0432. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0443\u043F\u0430\u043B. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C. \u041F\u043E\u043F\u044B\u0442\u043A\u0430
      \u043D\u0435\u0443\u0434\u0430\u0447\u043D\u0430, \u043D\u043E \u043D\u0438\u043A\u0442\u043E
      \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101435
    m_Localized: "\u0421\u043A\u043E\u0440\u043F\u0438\u043E\u043D \u0432 \u0441\u0430\u043F\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101436
    m_Localized: "\u0420\u0430\u043D\u043D\u0438\u043C \u0443\u0442\u0440\u043E\u043C
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u041A\u0430\u0440\u0438\u043C
      \u0432\u0441\u0442\u0440\u044F\u0445\u043D\u0443\u043B \u0441\u0430\u043F\u043E\u0433
      \u043F\u0435\u0440\u0435\u0434 \u0442\u0435\u043C, \u043A\u0430\u043A \u043D\u0430\u0434\u0435\u0442\u044C,
      - \u0438 \u0437\u0430\u0441\u0442\u044B\u043B. \u0412\u043D\u0443\u0442\u0440\u0438
      \u0448\u0443\u0440\u0448\u0438\u0442. \u041E\u043D \u0434\u0435\u0440\u0436\u0438\u0442
      \u0441\u0430\u043F\u043E\u0433 \u0432\u0432\u0435\u0440\u0445 \u043F\u043E\u0434\u043E\u0448\u0432\u043E\u0439
      \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E.
      \u0418\u0437 \u0433\u043E\u0440\u043B\u044B\u0448\u043A\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442
      \u0436\u0435\u043B\u0442\u043E\u0432\u0430\u0442\u043E-\u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0439
      \u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D \u0430\u043D\u0434\u0440\u043E\u043A\u0442\u043E\u043D\u0443\u0441
      - \u0445\u0432\u043E\u0441\u0442 \u043F\u043E\u0434\u043D\u044F\u0442. \u042D\u0442\u043E
      \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u044F\u0434\u043E\u0432\u0438\u0442\u044B\u0445
      \u0432\u0438\u0434\u043E\u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u044C.
      \u0423\u0441\u043F\u0435\u043B \u0432\u044B\u0442\u0440\u044F\u0445\u043D\u0443\u0442\u044C
      \u0438\u043B\u0438 \u043D\u0435\u0442 - \u0434\u0435\u043B\u043E \u0441\u043B\u0443\u0447\u0430\u044F.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0443\u0436\u0435 \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E\u0442
      \u0441\u0432\u043E\u044E \u043E\u0431\u0443\u0432\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101437
    m_Localized: "\u0412\u044B\u0442\u0440\u044F\u0445\u043D\u0443\u0442\u044C \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E
      - \u041A\u0430\u0440\u0438\u043C \u043C\u043E\u043B\u043E\u0434\u0435\u0446,
      \u0447\u0442\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101438
    m_Localized: "\u0421\u043A\u043E\u0440\u043F\u0438\u043E\u043D \u0443\u043F\u0430\u043B
      \u043D\u0430 \u043F\u0435\u0441\u043E\u043A \u0438 \u043C\u0435\u0442\u043D\u0443\u043B\u0441\u044F
      \u043F\u043E\u0434 \u043A\u0430\u043C\u0435\u043D\u044C. \u041A\u0430\u0440\u0438\u043C
      \u0446\u0435\u043B. \u041E\u043D \u0432\u0432\u0451\u043B \u0432 \u043E\u0442\u0440\u044F\u0434\u0435
      \u043F\u0440\u0430\u0432\u0438\u043B\u043E: \u043A\u0430\u0436\u0434\u043E\u0435
      \u0443\u0442\u0440\u043E - \u0442\u0440\u044F\u0441\u0442\u0438 \u043E\u0431\u0443\u0432\u044C.
      \u0422\u0435\u043F\u0435\u0440\u044C \u044D\u0442\u043E \u0437\u0430\u043A\u043E\u043D
      \u043E\u0431\u043E\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101439
    m_Localized: "\u0414\u0430\u0442\u044C \u041A\u0430\u0440\u0438\u043C\u0443 \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u0442\u044C
      - \u043C\u043E\u0436\u0435\u0442, \u043D\u0435 \u0443\u0436\u0430\u043B\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101440
    m_Localized: "\u041A\u0430\u0440\u0438\u043C \u0443\u0436\u0430\u043B\u0438\u043B\u043E
      \u0432 \u0441\u0442\u0443\u043F\u043D\u044E. \u041B\u0435\u043A\u0430\u0440\u044C
      \u041F\u0435\u043C\u0431\u0430 \u043F\u0440\u043E\u0432\u0451\u043B \u0447\u0430\u0441
      \u043D\u0430\u0434 \u043D\u0438\u043C - \u043D\u0430\u0434\u0440\u0435\u0437,
      \u0442\u0440\u0430\u0432\u0430, \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439
      \u043A\u043E\u043C\u043F\u0440\u0435\u0441\u0441. \u041D\u043E\u0433\u0430
      \u0440\u0430\u0437\u0434\u0443\u043B\u0430\u0441\u044C. \u041A\u0430\u0440\u0438\u043C
      \u0448\u0451\u043B, \u043D\u043E \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435
      \u0442\u0440\u0438 \u0434\u043D\u044F. \u0420\u0438\u0441\u043A \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101441
    m_Localized: "\u0411\u0435\u0440\u043A\u0443\u0442 \u0430\u0442\u0430\u043A\u0443\u0435\u0442
      \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101442
    m_Localized: "\u0422\u0435\u043D\u044C \u043D\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u043E\u0431\u043E\u0437 \u0440\u0435\u0437\u043A\u043E - \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439
      \u043E\u0440\u0451\u043B-\u0431\u0435\u0440\u043A\u0443\u0442, \u0440\u0430\u0437\u043C\u0430\u0445
      \u043A\u0440\u044B\u043B\u044C\u0435\u0432 \u0432 \u0434\u0432\u0430 \u043B\u043E\u043A\u0442\u044F,
      \u043F\u0430\u0434\u0430\u0435\u0442 \u0441 \u0432\u044B\u0441\u043E\u0442\u044B
      \u043D\u0430 \u0432\u044C\u044E\u043A\u0438 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0433\u043E
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430. \u041A\u043E\u0433\u0442\u0438
      \u0446\u0435\u043F\u043B\u044F\u044E\u0442 \u0445\u043E\u043B\u0449\u043E\u0432\u044B\u0439
      \u043C\u0435\u0448\u043E\u043A \u0441 \u043A\u0430\u0440\u0434\u0430\u043C\u043E\u043D\u043E\u043C,
      \u043F\u0442\u0438\u0446\u0430 \u0431\u044C\u0451\u0442 \u043A\u0440\u044B\u043B\u044C\u044F\u043C\u0438
      \u0438 \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u043F\u043E\u0434\u043D\u044F\u0442\u044C
      \u043C\u0435\u0448\u043E\u043A. \u0421\u0438\u043B\u0430 \u0443\u0434\u0430\u0440\u0430
      \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u043A\u0440\u044B\u0448\u043A\u0443
      \u0431\u043E\u0447\u043A\u0438 \u0440\u044F\u0434\u043E\u043C. \u0412\u0435\u0440\u0431\u043B\u044E\u0434
      \u0440\u0435\u0432\u0451\u0442 \u0438 \u0448\u0430\u0440\u0430\u0445\u0430\u0435\u0442\u0441\u044F.
      \u0411\u0435\u0440\u043A\u0443\u0442 \u043D\u0435 \u0432\u0438\u0434\u0438\u0442
      \u043B\u044E\u0434\u0435\u0439 - \u043E\u043D \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0434\u0432\u0438\u0436\u0443\u0449\u0438\u0439\u0441\u044F
      \u0433\u0440\u0443\u0437. \u041C\u0435\u0448\u043E\u043A \u0441 \u043A\u0430\u0440\u0434\u0430\u043C\u043E\u043D\u043E\u043C
      \u0442\u044F\u0436\u0451\u043B \u0434\u043B\u044F \u043F\u0442\u0438\u0446\u044B,
      \u043D\u043E \u043E\u043D\u0430 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442
      \u0431\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101443
    m_Localized: "\u041A\u0440\u0438\u0447\u0430\u0442\u044C \u0438 \u0440\u0430\u0437\u043C\u0430\u0445\u0438\u0432\u0430\u0442\u044C
      \u0440\u0443\u043A\u0430\u043C\u0438 - \u043F\u0440\u043E\u0433\u043D\u0430\u0442\u044C
      \u043F\u0442\u0438\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101444
    m_Localized: "\u0411\u0435\u0440\u043A\u0443\u0442 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B
      \u043C\u0435\u0448\u043E\u043A \u0438 \u0432\u0437\u043C\u044B\u043B. \u041A\u0430\u0440\u0434\u0430\u043C\u043E\u043D
      \u0446\u0435\u043B, \u043C\u0435\u0448\u043E\u043A \u043F\u043E\u0440\u0432\u0430\u043D
      \u043F\u043E \u043A\u0440\u0430\u044E. \u041F\u0442\u0438\u0446\u0430 \u043F\u043E\u043A\u0440\u0443\u0436\u0438\u043B\u0430
      \u0438 \u0443\u0448\u043B\u0430 \u0437\u0430 \u0433\u043E\u0440\u043D\u044B\u0439
      \u0433\u0440\u0435\u0431\u0435\u043D\u044C. \u0412\u0435\u0440\u0431\u043B\u044E\u0434
      \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u043B\u0441\u044F \u0447\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289609101445
    m_Localized: "\u041F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C \u0443\u043D\u0435\u0441\u0442\u0438
      \u043C\u0435\u0448\u043E\u043A - \u0434\u043E\u0440\u043E\u0433\u043E, \u0437\u0430\u0442\u043E
      \u0431\u0435\u0437 \u0441\u0443\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295616
    m_Localized: "\u0411\u0435\u0440\u043A\u0443\u0442 \u0443\u043D\u0451\u0441 \u043C\u0435\u0448\u043E\u043A
      \u0441 \u043A\u0430\u0440\u0434\u0430\u043C\u043E\u043D\u043E\u043C. \u041F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0443\u0431\u044B\u0442\u043A\u0430.
      \u0417\u0430\u0442\u043E \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u043B\u0438\u0441\u044C
      \u0431\u044B\u0441\u0442\u0440\u043E \u0438 \u043E\u0431\u043E\u0437 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B
      \u043F\u0443\u0442\u044C \u0431\u0435\u0437 \u0442\u0440\u0430\u0432\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295617
    m_Localized: "\u041C\u0435\u0442\u043D\u0443\u0442\u044C \u0432 \u043F\u0442\u0438\u0446\u0443
      \u043A\u0430\u043C\u0435\u043D\u044C - \u043E\u0442\u043F\u0443\u0433\u043D\u0443\u0442\u044C
      \u0440\u0435\u0437\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295618
    m_Localized: "\u041A\u0430\u043C\u0435\u043D\u044C \u0437\u0430\u0434\u0435\u043B
      \u043A\u0440\u044B\u043B\u043E - \u043F\u0442\u0438\u0446\u0430 \u0431\u0440\u043E\u0441\u0438\u043B\u0430
      \u043C\u0435\u0448\u043E\u043A \u0438 \u0441 \u043A\u0440\u0438\u043A\u043E\u043C
      \u0443\u043B\u0435\u0442\u0435\u043B\u0430. \u041A\u0430\u0440\u0434\u0430\u043C\u043E\u043D
      \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u0441\u044F, \u043D\u043E
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043B\u0438.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0434\u043E\u043B\u0433\u043E
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u0432\u0441\u043B\u0435\u0434
      \u0431\u0435\u0440\u043A\u0443\u0442\u0443 - \u043A\u0440\u0430\u0441\u0438\u0432\u0430\u044F
      \u043F\u0442\u0438\u0446\u0430, \u043A\u0430\u043A \u043D\u0438 \u043A\u0440\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295619
    m_Localized: "\u0414\u0438\u043A\u0438\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u0438 \u0441\u0430\u043C\u043A\u0430 \u0438\u0437 \u043E\u0431\u043E\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295620
    m_Localized: "\u0418\u0437 \u0431\u0430\u0440\u0445\u0430\u043D\u043E\u0432 \u0432\u044B\u0445\u043E\u0434\u0438\u0442
      \u0434\u0438\u043A\u0438\u0439 \u0431\u0430\u043A\u0442\u0440\u0438\u0439\u0441\u043A\u0438\u0439
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434 - \u0448\u0435\u0440\u0441\u0442\u044C
      \u0441\u043F\u0443\u0442\u0430\u043D\u043D\u0430\u044F, \u0433\u043E\u0440\u0431\u044B
      \u043F\u043E\u0434\u0436\u0430\u0440\u044B\u0435, \u043D\u043E\u0437\u0434\u0440\u0438
      \u0434\u0440\u043E\u0436\u0430\u0442. \u041E\u043D \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u043F\u0440\u044F\u043C\u043E \u043A \u0441\u0430\u043C\u043A\u0435 \u0438\u0437
      \u043E\u0431\u043E\u0437\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u0432 \u043F\u0435\u0440\u0438\u043E\u0434\u0435 \u0442\u0435\u0447\u043A\u0438.
      \u0421\u0430\u043C\u0435\u0446 \u0434\u0438\u043A\u0438\u0439, \u043D\u0435\u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0443\u0435\u043C\u044B\u0439
      \u0438 \u043A\u0440\u0443\u043F\u043D\u0435\u0435 \u0434\u043E\u043C\u0430\u0448\u043D\u0435\u0433\u043E.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0421\u0430\u043C\u0435\u0445
      \u043A\u0440\u0438\u0447\u0438\u0442 \u0438 \u043C\u0430\u0448\u0435\u0442
      \u0440\u0443\u043A\u0430\u043C\u0438, \u043D\u043E \u0434\u0438\u043A\u0430\u0440\u044C
      \u043D\u0435 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442. \u0415\u0441\u043B\u0438
      \u0434\u0430\u0442\u044C \u0435\u043C\u0443 \u043F\u043E\u0434\u043E\u0439\u0442\u0438
      - \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u043C \u0432\u0440\u0435\u043C\u044F
      \u0438 \u0447\u0430\u0441\u0442\u044C \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u043C\u043E\u0441\u0442\u0438
      \u0441\u0442\u0430\u0434\u0430. \u041D\u043E \u0438 \u043F\u0440\u043E\u0433\u043D\u0430\u0442\u044C
      \u0435\u0433\u043E \u043D\u0435\u043F\u0440\u043E\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295621
    m_Localized: "\u0423\u0432\u0435\u0441\u0442\u0438 \u0441\u0430\u043C\u043A\u0443
      - \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u0442\u044C \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435
      \u043E\u0442 \u0434\u0438\u043A\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295622
    m_Localized: "\u0421\u0430\u043C\u043A\u0443 \u0443\u0432\u0435\u043B\u0438 \u0437\u0430
      \u0442\u044E\u043A\u0438. \u0414\u0438\u043A\u0438\u0439 \u043F\u043E\u043A\u0440\u0443\u0436\u0438\u043B,
      \u043F\u043E\u043D\u044E\u0445\u0430\u043B \u0432\u043E\u0437\u0434\u0443\u0445
      \u0438 \u0443\u0448\u0451\u043B \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u0432 \u0431\u0430\u0440\u0445\u0430\u043D\u044B \u0447\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441. \u041F\u043E\u0442\u0435\u0440\u044F\u043D \u0447\u0430\u0441
      \u0441\u0442\u043E\u044F\u043D\u043A\u0438, \u043D\u043E \u043F\u043E\u0442\u043E\u043C\u0441\u0442\u0432\u043E
      \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295623
    m_Localized: "\u041D\u0435 \u0432\u043C\u0435\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      - \u043F\u0440\u0438\u0440\u043E\u0434\u0430 \u0441\u0434\u0435\u043B\u0430\u0435\u0442
      \u0441\u0432\u043E\u0451"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295624
    m_Localized: "\u0414\u0438\u043A\u0438\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0440\u044F\u0434\u043E\u043C \u0441
      \u0441\u0430\u043C\u043A\u043E\u0439 \u0442\u0440\u0438 \u0447\u0430\u0441\u0430.
      \u041F\u043E\u0442\u043E\u043C \u0443\u0448\u0451\u043B. \u0421\u0430\u043C\u043A\u0430
      \u0431\u0443\u0434\u0435\u0442 \u0436\u0435\u0440\u0435\u0431\u043E\u0439.
      \u0427\u0435\u0440\u0435\u0437 \u043F\u043E\u043B\u0442\u043E\u0440\u0430 \u0433\u043E\u0434\u0430
      \u0445\u043E\u0437\u044F\u0438\u043D \u043F\u043E\u0442\u043E\u043C\u0441\u0442\u0432\u0430
      \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u0435\u0440\u0435\u0448\u0451\u043F\u0442\u044B\u0432\u0430\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295625
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C \u0441\u0430\u043C\u043A\u0443
      \u0434\u0438\u043A\u043E\u043C\u0443 \u043F\u0430\u0441\u0442\u0443\u0445\u0443-\u0431\u0435\u0434\u0443\u0438\u043D\u0443
      - \u0443\u0431\u044B\u0442\u043E\u043A \u043C\u0435\u043D\u044C\u0448\u0435
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295626
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u0435\u043D\u043D\u044B\u0439
      \u0431\u0435\u0434\u0443\u0438\u043D \u0432\u0437\u044F\u043B \u0441\u0430\u043C\u043A\u0443
      \u0437\u0430 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432.
      \u0414\u0438\u043A\u0438\u0439 \u0443\u0448\u0451\u043B \u0432\u0441\u043B\u0435\u0434.
      \u041F\u043E\u0442\u0435\u0440\u044F \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0433\u043E
      - \u043C\u0438\u043D\u0443\u0441 \u0442\u044F\u0433\u043E\u0432\u0430\u044F
      \u0441\u0438\u043B\u0430. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043F\u0435\u0440\u0435\u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
      \u0433\u0440\u0443\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295627
    m_Localized: "\u041F\u0430\u043D\u0438\u043A\u0430 \u043A\u0443\u043B\u0430\u043D\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295628
    m_Localized: "\u0421\u0442\u0430\u0434\u043E \u043A\u0443\u043B\u0430\u043D\u043E\u0432
      - \u0434\u0438\u043A\u0438\u0445 \u043E\u0441\u043B\u043E\u0432, \u043F\u043B\u043E\u0442\u043D\u044B\u0445
      \u0438 \u0431\u044B\u0441\u0442\u0440\u044B\u0445 - \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E
      \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u043D\u0435\u0441\u0451\u0442\u0441\u044F \u043F\u0440\u044F\u043C\u043E
      \u0447\u0435\u0440\u0435\u0437 \u043B\u0430\u0433\u0435\u0440\u044C. \u0427\u0442\u043E
      \u0438\u0445 \u0441\u043F\u0443\u0433\u043D\u0443\u043B\u043E - \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E,
      \u043C\u043E\u0436\u0435\u0442 \u0432\u043E\u043B\u043A \u0441 \u044E\u0433\u0430.
      \u0421\u043E\u0442\u043D\u044F \u043E\u0441\u043E\u0431\u0435\u0439 \u043C\u0447\u0438\u0442\u0441\u044F
      \u0432 \u043F\u0430\u043D\u0438\u043A\u0435, \u043D\u0435 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0438. \u041A\u043E\u043F\u044B\u0442\u0430
      \u0433\u0440\u0435\u043C\u044F\u0442 \u043A\u0430\u043A \u0431\u0430\u0440\u0430\u0431\u0430\u043D\u044B.
      \u041B\u0430\u0433\u0435\u0440\u044C \u0440\u0430\u0437\u0431\u0438\u0442 \u043F\u0440\u044F\u043C\u043E
      \u043D\u0430 \u043F\u0443\u0442\u0438 \u0441\u0442\u0430\u0434\u0430. \u041D\u0430
      \u0440\u0430\u0441\u0441\u0451\u0434\u043B\u0430\u043D\u043D\u044B\u0445 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432
      \u0441\u0442\u0430\u0434\u043E \u043D\u0430\u043B\u0435\u0442\u0438\u0442 \u0447\u0435\u0440\u0435\u0437
      \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0441\u0435\u043A\u0443\u043D\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295629
    m_Localized: "\u0417\u0430\u0433\u043E\u0440\u043E\u0434\u0438\u0442\u044C \u043F\u0443\u0442\u044C
      \u043E\u0433\u043D\u0451\u043C \u0438 \u043A\u0440\u0438\u043A\u043E\u043C
      - \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0441\u0442\u0430\u0434\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295630
    m_Localized: "\u041E\u0433\u043E\u043D\u044C \u0440\u0430\u0437\u043E\u0433\u043D\u0430\u043B\u0438
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E. \u0421\u0442\u0430\u0434\u043E
      \u0440\u0430\u0437\u0434\u0430\u043B\u043E\u0441\u044C \u043D\u0430\u0434\u0432\u043E\u0435
      \u0438 \u043E\u0431\u043E\u0448\u043B\u043E \u043B\u0430\u0433\u0435\u0440\u044C
      \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439. \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0442\u044E\u043A\u043E\u0432 \u0441\u0434\u0432\u0438\u043D\u0443\u043B\u043E\u0441\u044C.
      \u0412\u0441\u0435 \u0446\u0435\u043B\u044B. \u0411\u044B\u0441\u0442\u0440\u0430\u044F
      \u0440\u0435\u0430\u043A\u0446\u0438\u044F \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0441\u043F\u0430\u0441\u043B\u0430 \u043B\u0430\u0433\u0435\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295631
    m_Localized: "\u0420\u0430\u0441\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u0438\u0442\u044C
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432 - \u0441\u043F\u0430\u0441\u0442\u0438
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u043F\u0440\u0435\u0436\u0434\u0435
      \u0432\u0441\u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295632
    m_Localized: "\u0412\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432 \u0440\u0430\u0441\u0442\u0430\u0449\u0438\u043B\u0438
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0437\u0430 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C
      \u0441\u0435\u043A\u0443\u043D\u0434. \u0421\u0442\u0430\u0434\u043E \u043F\u0440\u043E\u0448\u043B\u043E
      \u0447\u0435\u0440\u0435\u0437 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443
      \u043B\u0430\u0433\u0435\u0440\u044F. \u041F\u044F\u0442\u044C \u0442\u044E\u043A\u043E\u0432
      \u0440\u0430\u0441\u0442\u043E\u043F\u0442\u0430\u043D\u043E, \u043E\u0434\u0438\u043D
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0441\u0431\u0438\u0442 \u0441
      \u043D\u043E\u0433. \u0416\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u0446\u0435\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295633
    m_Localized: "\u041E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0435\u0439
      - \u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0435\u0434\u0443 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043E\u0442 \u043B\u0430\u0433\u0435\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295634
    m_Localized: "\u041A\u0443\u043B\u0430\u043D\u044B \u043D\u0435 \u0435\u0434\u044F\u0442
      \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u043E\u0433\u043E \u0437\u0435\u0440\u043D\u0430
      \u043D\u0430 \u0431\u0435\u0433\u0443 - \u044D\u0442\u043E \u0434\u0438\u043A\u0438\u0435
      \u043E\u0441\u043B\u044B, \u043D\u0435 \u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0435.
      \u041F\u043E\u043F\u044B\u0442\u043A\u0430 \u043D\u0435 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430.
      \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0431\u0435\u0436\u0430\u0442\u044C
      \u0441\u0430\u043C\u0438\u043C. \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043C\u0435\u0448\u043A\u043E\u0432 \u043F\u043E\u0433\u0443\u0431\u043B\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295635
    m_Localized: "\u0420\u0430\u043D\u0435\u043D\u044B\u0439 \u043A\u0430\u0431\u0430\u043D
      \u0432 \u0442\u0440\u043E\u0441\u0442\u043D\u0438\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295636
    m_Localized: "\u0420\u0435\u043A\u0430 \u0417\u0435\u0440\u0430\u0432\u0448\u0430\u043D
      - \u0443\u0437\u043A\u0430\u044F, \u0441 \u0433\u0443\u0441\u0442\u044B\u043C
      \u0442\u0440\u043E\u0441\u0442\u043D\u0438\u043A\u043E\u043C \u043F\u043E \u0431\u0435\u0440\u0435\u0433\u0430\u043C.
      \u041E\u0431\u043E\u0437 \u0438\u0434\u0451\u0442 \u0432\u0434\u043E\u043B\u044C
      \u0431\u0435\u0440\u0435\u0433\u0430, \u043A\u043E\u0433\u0434\u0430 \u0432
      \u0442\u0440\u043E\u0441\u0442\u043D\u0438\u043A\u0435 \u0440\u0430\u0437\u0434\u0430\u0451\u0442\u0441\u044F
      \u0445\u0440\u0438\u043F \u0438 \u0438\u0437 \u0437\u0430\u0440\u043E\u0441\u043B\u0435\u0439
      \u0432\u044B\u043B\u0430\u043C\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043A\u0440\u0443\u043F\u043D\u044B\u0439
      \u043A\u0430\u0431\u0430\u043D-\u0441\u0435\u043A\u0430\u0447 \u0441 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439
      \u0440\u0430\u043D\u043E\u0439 \u043D\u0430 \u0431\u043E\u043A\u0443 - \u043F\u043E\u0445\u043E\u0436\u0435,
      \u0441\u0442\u0440\u0435\u043B\u0430 \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u0430.
      \u041E\u043D \u0440\u0430\u043D\u0435\u043D \u0438 \u043E\u0441\u043B\u0435\u043F\u043B\u0451\u043D
      \u0431\u043E\u043B\u044C\u044E. \u0420\u0430\u043D\u0435\u043D\u044B\u0439
      \u043A\u0430\u0431\u0430\u043D \u043D\u0430\u043F\u0430\u0434\u0430\u0435\u0442
      \u043D\u0435 \u0438\u0437 \u0433\u043E\u043B\u043E\u0434\u0430, \u0430 \u043E\u0442
      \u0441\u0442\u0440\u0430\u0445\u0430 - \u044D\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442
      \u0435\u0433\u043E \u0432\u0434\u0432\u043E\u0435 \u043E\u043F\u0430\u0441\u043D\u0435\u0435.
      \u041A\u043B\u044B\u043A\u0438 \u0434\u043B\u0438\u043D\u043E\u0439 \u0432
      \u0442\u0440\u0438 \u043F\u0430\u043B\u044C\u0446\u0430. \u041F\u0435\u0440\u0432\u044B\u0439
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434 \u0432 \u0440\u044F\u0434\u0443
      \u043F\u0440\u044F\u043C\u043E \u043F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295637
    m_Localized: "\u0414\u0430\u0442\u044C \u043A\u0430\u0431\u0430\u043D\u0443 \u0431\u043E\u0439
      - \u043E\u043D \u043E\u0434\u0438\u043D \u0438 \u0440\u0430\u043D\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295638
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0443\u0434\u0430\u0440\u0438\u043B
      \u043A\u043E\u043F\u044C\u0451\u043C. \u041A\u0430\u0431\u0430\u043D \u0441\u043D\u0451\u0441
      \u0435\u0433\u043E \u0441 \u043D\u043E\u0433 \u0434\u043E \u044D\u0442\u043E\u0433\u043E.
      \u0422\u0440\u0438 \u0441\u0435\u043A\u0443\u043D\u0434\u044B \u0445\u0430\u043E\u0441\u0430,
      \u043A\u0440\u043E\u0432\u044C, \u043A\u0440\u0438\u043A - \u0438 \u043A\u0430\u0431\u0430\u043D
      \u0438\u0437\u0434\u043E\u0445. \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u043E\u0442\u0434\u0435\u043B\u0430\u043B\u0441\u044F \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u043C
      \u0440\u0435\u0431\u0440\u043E\u043C. \u041D\u0430 \u0432\u0435\u0447\u0435\u0440
      - \u0436\u0430\u0440\u0435\u043D\u0430\u044F \u0441\u0432\u0438\u043D\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295639
    m_Localized: "\u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C \u043A\u0430\u0431\u0430\u043D\u0430
      \u0432 \u0440\u0435\u043A\u0443 - \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043F\u043B\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295640
    m_Localized: "\u041E\u0433\u043E\u043D\u044C \u0438 \u043A\u0440\u0438\u043A\u0438
      \u043F\u043E\u0433\u043D\u0430\u043B\u0438 \u043A\u0430\u0431\u0430\u043D\u0430
      \u043A \u0432\u043E\u0434\u0435. \u041E\u043D \u0441 \u0442\u0440\u0435\u0441\u043A\u043E\u043C
      \u043D\u044B\u0440\u043D\u0443\u043B \u0432 \u0440\u0435\u043A\u0443 \u0438
      \u043F\u043E\u043F\u043B\u044B\u043B \u0432\u043D\u0438\u0437 \u043F\u043E
      \u0442\u0435\u0447\u0435\u043D\u0438\u044E. \u041D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B. \u0414\u0438\u0447\u044C
      \u0443\u0448\u043B\u0430 - \u043C\u044F\u0441\u0430 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295641
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043E\u0431\u043E\u0437
      - \u0434\u0430\u0442\u044C \u043A\u0430\u0431\u0430\u043D\u0443 \u0443\u0439\u0442\u0438
      \u0441\u0430\u043C\u043E\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295642
    m_Localized: "\u041A\u0430\u0431\u0430\u043D \u043F\u043E\u0441\u0442\u043E\u044F\u043B,
      \u0445\u0440\u0438\u043F\u044F, \u0438 \u0443\u0448\u0451\u043B \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u0432 \u0442\u0440\u043E\u0441\u0442\u043D\u0438\u043A \u0447\u0435\u0440\u0435\u0437
      \u043F\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442. \u041F\u043E\u0442\u0435\u0440\u044F\u043D
      \u0447\u0430\u0441 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u043B\u0438\u0441\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A
      \u0437\u0430\u043F\u0430\u0445 \u043A\u0440\u043E\u0432\u0438 \u0443\u043D\u0435\u0441\u043B\u043E
      \u0432\u0435\u0442\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295643
    m_Localized: "\u0413\u044E\u0440\u0437\u044B \u043F\u043E\u0434 \u0442\u044E\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295644
    m_Localized: "\u041D\u0430 \u043D\u043E\u0447\u043D\u043E\u0439 \u0441\u0442\u043E\u044F\u043D\u043A\u0435
      \u0443 \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A\u0430 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0421\u0430\u043C\u0435\u0445 \u043F\u043E\u0434\u043D\u044F\u043B \u0442\u044E\u043A,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u0432\u0435\u0440\u0451\u0432\u043A\u0443, \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
      \u043A\u0430\u043A \u0432\u043A\u043E\u043F\u0430\u043D\u043D\u044B\u0439.
      \u041F\u043E\u0434 \u0442\u044E\u043A\u043E\u043C - \u043A\u043B\u0443\u0431\u043E\u043A
      \u0438\u0437 \u0442\u0440\u0451\u0445 \u0433\u044E\u0440\u0437. \u0421\u0430\u043C\u043A\u0438
      \u043B\u0435\u0432\u0430\u043D\u0442\u0438\u0439\u0441\u043A\u043E\u0439 \u0433\u044E\u0440\u0437\u044B
      \u0433\u0440\u0435\u044E\u0442\u0441\u044F \u043F\u043E\u0434 \u043D\u0430\u0433\u0440\u0435\u0442\u044B\u043C
      \u0432\u043E\u0439\u043B\u043E\u043A\u043E\u043C. \u0418\u0445 \u0443\u043A\u0443\u0441
      \u0431\u0435\u0437 \u043B\u0435\u0447\u0435\u043D\u0438\u044F \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u0435\u043D.
      \u041E\u043D\u0438 \u043F\u043E\u043A\u0430 \u043D\u0435 \u043F\u043E\u0442\u0440\u0435\u0432\u043E\u0436\u0435\u043D\u044B.
      \u041D\u043E \u0442\u044E\u043A\u0438 \u043D\u0443\u0436\u043D\u043E \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044C
      \u043D\u0430 \u043D\u043E\u0447\u044C, \u0430 \u0442\u0430\u043C \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C \u0435\u0449\u0451 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0437\u043C\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295645
    m_Localized: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E \u043E\u0442\u043E\u0434\u0432\u0438\u043D\u0443\u0442\u044C
      \u0442\u044E\u043A\u0438 \u0438 \u0434\u0430\u0442\u044C \u0437\u043C\u0435\u044F\u043C
      \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295646
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043E\u0442\u043E\u0434\u0432\u0438\u0433\u0430\u043B\u0438
      \u0442\u044E\u043A\u0438 \u043F\u0430\u043B\u043A\u0430\u043C\u0438. \u0413\u044E\u0440\u0437\u044B
      \u0443\u043F\u043E\u043B\u0437\u043B\u0438 \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0443
      - \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u043D\u0435 \u043D\u0430\u043F\u0430\u0434\u0430\u044F.
      \u041E\u0441\u043C\u043E\u0442\u0440 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445
      \u0442\u044E\u043A\u043E\u0432 \u0437\u0430\u043D\u044F\u043B \u0447\u0430\u0441.
      \u0411\u043E\u043B\u044C\u0448\u0435 \u0437\u043C\u0435\u0439 \u043D\u0435
      \u043D\u0430\u0448\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295647
    m_Localized: "\u0423\u0431\u0438\u0442\u044C \u0432\u0441\u0435\u0445 \u0442\u0440\u0451\u0445
      \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E - \u043D\u0435
      \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295648
    m_Localized: "\u0414\u0432\u0443\u0445 \u0443\u0431\u0438\u043B\u0438 \u043B\u043E\u043F\u0430\u0442\u043E\u0439.
      \u0422\u0440\u0435\u0442\u044C\u044F \u0443\u0436\u0430\u043B\u0438\u043B\u0430
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430 \u0432 \u0440\u0443\u043A\u0443
      \u043F\u0440\u0435\u0436\u0434\u0435, \u0447\u0435\u043C \u0435\u0451 \u0434\u043E\u0431\u0438\u043B\u0438.
      \u041B\u0435\u043A\u0430\u0440\u044C \u041F\u0435\u043C\u0431\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u043B
      \u0432\u0441\u044E \u043D\u043E\u0447\u044C \u0441 \u043D\u0430\u0434\u0440\u0435\u0437\u043E\u043C
      \u0438 \u043F\u0440\u0438\u043F\u0430\u0440\u043A\u0430\u043C\u0438 \u0438\u0437
      \u0442\u0440\u0430\u0432. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0432\u044B\u0436\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295649
    m_Localized: "\u041F\u0435\u0440\u0435\u043D\u0435\u0441\u0442\u0438 \u043B\u0430\u0433\u0435\u0440\u044C
      - \u043D\u043E\u0447\u0435\u0432\u0430\u0442\u044C \u0432 \u0434\u0440\u0443\u0433\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295650
    m_Localized: "\u041F\u0435\u0440\u0435\u043D\u043E\u0441 \u043B\u0430\u0433\u0435\u0440\u044F
      \u0437\u0430\u043D\u044F\u043B \u0447\u0430\u0441 \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435.
      \u041B\u044E\u0434\u0438 \u0443\u0441\u0442\u0430\u043B\u0438. \u0417\u0430\u0442\u043E
      \u0443\u0442\u0440\u043E\u043C \u043E\u0441\u043C\u043E\u0442\u0440 \u043F\u0440\u0435\u0436\u043D\u0435\u0439
      \u0441\u0442\u043E\u044F\u043D\u043A\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B
      \u0435\u0449\u0451 \u0448\u0435\u0441\u0442\u0435\u0440\u044B\u0445 \u0433\u044E\u0440\u0437
      \u043F\u043E\u0434 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0442\u044E\u043A\u0430\u043C\u0438.
      \u0420\u0435\u0448\u0435\u043D\u0438\u0435 \u0431\u044B\u043B\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295651
    m_Localized: "\u0421\u0435\u0440\u044B\u0439 \u0432\u0430\u0440\u0430\u043D \u0432
      \u043B\u0430\u0433\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295652
    m_Localized: "\u041F\u043E\u043B\u0434\u0435\u043D\u044C, \u0436\u0430\u0440\u0430.
      \u041E\u0433\u0440\u043E\u043C\u043D\u044B\u0439 \u0441\u0435\u0440\u044B\u0439
      \u0432\u0430\u0440\u0430\u043D \u0434\u043B\u0438\u043D\u043E\u0439 \u0432
      \u0434\u0432\u0430 \u043B\u043E\u043A\u0442\u044F \u0434\u0435\u043B\u043E\u0432\u0438\u0442\u043E
      \u0441\u0438\u0434\u0438\u0442 \u0443 \u043C\u0435\u0448\u043A\u0430 \u0441
      \u0441\u0443\u0448\u0451\u043D\u044B\u043C\u0438 \u0444\u0438\u043D\u0438\u043A\u0430\u043C\u0438,
      \u0440\u0430\u0437\u043E\u0434\u0440\u0430\u0432 \u043C\u0435\u0448\u043A\u043E\u0432\u0438\u043D\u0443
      \u043A\u043E\u0433\u0442\u044F\u043C\u0438. \u0425\u0432\u043E\u0441\u0442
      \u0442\u043E\u043B\u0449\u0438\u043D\u043E\u0439 \u0432 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u0435
      \u0445\u043B\u0435\u0449\u0435\u0442 \u043F\u043E \u0437\u0435\u043C\u043B\u0435.
      \u041E\u043D \u043D\u0435 \u0443\u0431\u0435\u0433\u0430\u0435\u0442 - \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0436\u0451\u043B\u0442\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438
      \u0441 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u043C
      \u0437\u0440\u0430\u0447\u043A\u043E\u043C. \u0412\u0430\u0440\u0430\u043D
      \u043E\u043F\u0430\u0441\u0435\u043D \u043D\u0435 \u044F\u0434\u043E\u043C,
      \u0430 \u043A\u043E\u0433\u0442\u044F\u043C\u0438 \u0438 \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u044F\u043C\u0438
      \u0432 \u0441\u043B\u044E\u043D\u0435. \u041C\u0435\u0448\u043E\u043A \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u043E\u043F\u0443\u0441\u0442\u043E\u0448\u0451\u043D. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0441\u0442\u043E\u044F\u0442 \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295653
    m_Localized: "\u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C \u0448\u0435\u0441\u0442\u043E\u043C
      - \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E, \u0431\u0435\u0437
      \u0443\u0434\u0430\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295654
    m_Localized: "\u0412\u0430\u0440\u0430\u043D \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B,
      \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0448\u0438\u043F\u044F.
      \u041E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F \u0444\u0438\u043D\u0438\u043A\u0438
      \u0441\u043F\u0430\u0441\u0435\u043D\u044B. \u041C\u0435\u0448\u043E\u043A
      \u0437\u0430\u0448\u0438\u043B\u0438. \u0412\u0430\u0440\u0430\u043D \u0441\u043A\u0440\u044B\u043B\u0441\u044F
      \u0437\u0430 \u043A\u0430\u043C\u043D\u044F\u043C\u0438 - \u0432\u0438\u0434\u043D\u043E,
      \u0437\u0434\u0435\u0441\u044C \u0435\u0433\u043E \u043E\u0431\u044B\u0447\u043D\u0430\u044F
      \u043E\u0445\u043E\u0442\u043D\u0438\u0447\u044C\u044F \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295655
    m_Localized: "\u041F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C \u0434\u043E\u0435\u0441\u0442\u044C
      - \u0440\u0430\u0434\u0438 \u043C\u0438\u0440\u0430 \u0432 \u043B\u0430\u0433\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295656
    m_Localized: "\u0412\u0430\u0440\u0430\u043D \u0434\u043E\u0435\u043B \u0444\u0438\u043D\u0438\u043A\u0438
      \u0438 \u0443\u0448\u0451\u043B. \u041E\u0434\u0438\u043D \u043C\u0435\u0448\u043E\u043A
      \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043D.
      \u0417\u0430\u0442\u043E \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B
      \u0438 \u043D\u0435 \u043F\u043E\u0442\u0440\u0435\u0432\u043E\u0436\u0438\u043B
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435. \u041F\u0443\u0441\u0442\u044B\u043D\u043D\u044B\u0435
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B \u0433\u043E\u0432\u043E\u0440\u044F\u0442
      - \u0432\u0430\u0440\u0430\u043D\u0430 \u043B\u0443\u0447\u0448\u0435 \u043D\u0435
      \u0437\u043B\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295657
    m_Localized: "\u0423\u0431\u0438\u0442\u044C \u0434\u043B\u044F \u043D\u0430\u0443\u043A\u0438
      - \u0438\u0437\u0443\u0447\u0438\u0442\u044C \u0432\u0438\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295658
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u043F\u0440\u043E\u043C\u0430\u0445\u043D\u0443\u043B\u0441\u044F
      \u043A\u043E\u043F\u044C\u0451\u043C. \u0412\u0430\u0440\u0430\u043D \u0443\u0434\u0430\u0440\u0438\u043B
      \u0445\u0432\u043E\u0441\u0442\u043E\u043C \u0438 \u0440\u0430\u0437\u0431\u0438\u043B
      \u0433\u043B\u0438\u043D\u044F\u043D\u044B\u0439 \u043A\u0443\u0432\u0448\u0438\u043D.
      \u0412\u0442\u043E\u0440\u043E\u0439 \u0443\u0434\u0430\u0440 \u0434\u043E\u0441\u0442\u0430\u043B
      \u0435\u0433\u043E. \u0428\u043A\u0443\u0440\u0430 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0430\u044F,
      \u043D\u043E \u044D\u0442\u043E \u043D\u0435 \u0441\u0442\u043E\u0438\u043B\u043E
      \u0440\u0430\u0437\u0431\u0438\u0442\u043E\u0433\u043E \u043A\u0443\u0432\u0448\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295659
    m_Localized: "\u0424\u0435\u043D\u0435\u043A \u0441 \u043F\u043E\u0434\u0440\u0430\u043D\u043A\u043E\u043C
      - \u043F\u043B\u043E\u0445\u043E\u0439 \u0437\u043D\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295660
    m_Localized: "\u041D\u0430 \u0437\u0430\u043A\u0430\u0442\u0435 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u0444\u0435\u043D\u0435\u043A \u0441 \u043D\u0435\u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E
      \u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438 \u0443\u0448\u0430\u043C\u0438
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043F\u0440\u044F\u043C\u043E \u043A
      \u0434\u043E\u0440\u043E\u0433\u0435 \u0438 \u0441\u0430\u0434\u0438\u0442\u0441\u044F
      \u0432 \u043F\u044F\u0442\u0438 \u0448\u0430\u0433\u0430\u0445 - \u0432 \u0437\u0443\u0431\u0430\u0445
      \u0442\u0440\u0435\u043F\u044B\u0445\u0430\u0435\u0442\u0441\u044F \u044F\u0449\u0435\u0440\u0438\u0446\u0430.
      \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043E\u0431\u043E\u0437
      \u0431\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A-\u043F\u0435\u0440\u0441
      \u0410\u0445\u043C\u0430\u0434 \u0431\u043B\u0435\u0434\u043D\u0435\u0435\u0442
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442: \u0432 \u0425\u043E\u0440\u0430\u0441\u0430\u043D\u0435
      \u0444\u0435\u043D\u0435\u043A \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
      \u0441 \u0434\u043E\u0431\u044B\u0447\u0435\u0439 \u0432 \u0437\u0443\u0431\u0430\u0445
      - \u043A \u0441\u043C\u0435\u0440\u0442\u0438 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0438\u0437 \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432. \u0414\u0440\u0443\u0433\u0438\u0435
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u0435\u0440\u0435\u0448\u0451\u043F\u0442\u044B\u0432\u0430\u044E\u0442\u0441\u044F.
      \u0421\u0442\u0440\u0430\u0445 \u0438\u0440\u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439,
      \u043D\u043E \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435 \u0438\u0440\u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0435
      - \u044D\u0442\u043E \u0442\u043E\u0436\u0435 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295661
    m_Localized: "\u041F\u043E\u0441\u043C\u0435\u044F\u0442\u044C\u0441\u044F \u043D\u0430\u0434
      \u0441\u0443\u0435\u0432\u0435\u0440\u0438\u044F\u043C\u0438 \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295662
    m_Localized: "\u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B
      \u043F\u0443\u0442\u044C. \u0424\u0435\u043D\u0435\u043A \u0443\u0431\u0435\u0436\u0430\u043B
      \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u044E. \u041D\u0438\u0447\u0435\u0433\u043E
      \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0434\u0435\u043D\u044C.
      \u0421\u0443\u0435\u0432\u0435\u0440\u0438\u0435 \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
      \u0441\u0443\u0435\u0432\u0435\u0440\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295663
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      - \u043F\u0440\u043E\u0447\u0435\u0441\u0442\u044C \u043C\u043E\u043B\u0438\u0442\u0432\u0443
      \u0438 \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C \u043D\u043E\u0447\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295664
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u043B\u0438 \u043D\u043E\u0447\u044C
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435. \u0410\u0445\u043C\u0430\u0434
      \u043F\u043E\u043C\u043E\u043B\u0438\u043B\u0441\u044F. \u0423\u0442\u0440\u043E\u043C
      \u0442\u0440\u043E\u043D\u0443\u043B\u0438\u0441\u044C \u0431\u0435\u0437 \u0442\u0440\u0435\u0432\u043E\u0433\u0438.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u043F\u043E\u043B\u0434\u043D\u044F.
      \u041B\u044E\u0434\u0438 \u0448\u043B\u0438 \u0431\u043E\u0434\u0440\u0435\u0435
      - \u0441\u0442\u0440\u0430\u0445 \u0432\u044B\u0448\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295665
    m_Localized: "\u0421\u0443\u0440\u043A\u0438 \u0431\u0435\u0433\u0443\u0442 -
      \u043A \u0431\u0443\u0440\u0435 \u0438\u043B\u0438 \u0445\u0438\u0449\u043D\u0438\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295666
    m_Localized: "\u0426\u0435\u043B\u0430\u044F \u043A\u043E\u043B\u043E\u043D\u0438\u044F
      \u043C\u043E\u043D\u0433\u043E\u043B\u044C\u0441\u043A\u0438\u0445 \u0441\u0443\u0440\u043A\u043E\u0432
      \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0432\u044B\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u0435\u0442
      \u0438\u0437 \u043D\u043E\u0440 \u0438 \u043D\u0435\u0441\u0451\u0442\u0441\u044F
      \u043F\u0440\u043E\u0447\u044C \u043E\u0442 \u0441\u0432\u043E\u0435\u0439
      \u0433\u043E\u0440\u043A\u0438 - \u0432\u0441\u044F, \u0440\u0430\u0437\u043E\u043C,
      \u0431\u0435\u0437 \u0435\u0434\u0438\u043D\u043E\u0433\u043E \u0437\u0432\u0443\u043A\u0430.
      \u042D\u0442\u043E \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E: \u0441\u0443\u0440\u043A\u0438
      \u043B\u0438\u0431\u043E \u043A\u0440\u0438\u0447\u0430\u0442 \u0442\u0440\u0435\u0432\u043E\u0433\u0443,
      \u043B\u0438\u0431\u043E \u043F\u0440\u044F\u0447\u0443\u0442\u0441\u044F \u0432
      \u043D\u043E\u0440\u044B. \u0422\u0438\u0445\u043E\u0435 \u043C\u0430\u0441\u0441\u043E\u0432\u043E\u0435
      \u0431\u0435\u0433\u0441\u0442\u0432\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442
      \u0447\u0442\u043E-\u0442\u043E \u043A\u0440\u0443\u043F\u043D\u043E\u0435
      \u0438 \u0431\u043B\u0438\u0437\u043A\u043E\u0435. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0411\u0443\u0433\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442: \"\u041B\u0438\u0431\u043E
      \u0441\u043D\u0435\u0436\u043D\u044B\u0439 \u0431\u0430\u0440\u0441 \u0432
      \u0442\u0440\u0451\u0445\u0441\u0442\u0430\u0445 \u0448\u0430\u0433\u0430\u0445,
      \u043B\u0438\u0431\u043E \u0431\u0443\u0440\u044F \u0447\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441\". \u041D\u0435\u0431\u043E \u0447\u0438\u0441\u0442\u043E\u0435,
      \u043D\u043E \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442 \u0447\u0443\u0442\u044C
      \u043C\u0443\u0442\u043D\u043E\u0432\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295667
    m_Localized: "\u041D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0438\u0441\u043A\u0430\u0442\u044C
      \u0443\u043A\u0440\u044B\u0442\u0438\u0435 - \u0437\u0430 \u0433\u043E\u0440\u043D\u044B\u043C
      \u0432\u044B\u0441\u0442\u0443\u043F\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295668
    m_Localized: "\u0421\u043F\u0440\u044F\u0442\u0430\u043B\u0438\u0441\u044C \u0437\u0430
      \u0441\u043A\u0430\u043B\u043E\u0439. \u0427\u0435\u0440\u0435\u0437 \u0441\u043E\u0440\u043E\u043A
      \u043C\u0438\u043D\u0443\u0442 \u043D\u0430\u043B\u0435\u0442\u0435\u043B \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u044B\u0439
      \u0443\u0440\u0430\u0433\u0430\u043D \u0441 \u0433\u0440\u0430\u0434\u043E\u043C.
      \u0411\u0435\u0437 \u0443\u043A\u0440\u044B\u0442\u0438\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0431\u044B \u0442\u044E\u043A\u0438 \u0438 \u043B\u044E\u0434\u0435\u0439.
      \u0421\u0443\u0440\u043A\u0438 \u0437\u043D\u0430\u043B\u0438 \u043B\u0443\u0447\u0448\u0435
      \u043B\u044E\u0434\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295669
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0438 \u043E\u0433\u043B\u044F\u0434\u0435\u0442\u044C\u0441\u044F - \u043D\u0430
      \u043F\u043E\u0438\u0441\u043A \u0431\u0430\u0440\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295670
    m_Localized: "\u041F\u043E\u0438\u0441\u043A \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0434\u0430\u043B. \u0427\u0435\u0440\u0435\u0437 \u043F\u043E\u043B\u0447\u0430\u0441\u0430
      \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F \u0432\u0435\u0442\u0435\u0440.
      \u0411\u0443\u0440\u044F \u0437\u0430\u0441\u0442\u0430\u043B\u0430 \u0432
      \u043F\u0443\u0442\u0438. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043E\u0434\u0438\u043D \u0434\u0435\u043D\u044C \u0438\u0437-\u0437\u0430
      \u043D\u0435\u043F\u043E\u0433\u043E\u0434\u044B. \u0411\u0430\u0440\u0441\u0430
      \u043D\u0435 \u043D\u0430\u0448\u043B\u0438 - \u0431\u044B\u043B \u043B\u0438
      \u043E\u043D \u0442\u0430\u043C, \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295671
    m_Localized: "\u041D\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F
      - \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295672
    m_Localized: "\u0423\u0440\u0430\u0433\u0430\u043D \u043D\u0430\u043A\u0440\u044B\u043B
      \u043E\u0431\u043E\u0437 \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u043C
      \u043F\u043B\u0430\u0442\u043E. \u0422\u0440\u0438 \u0442\u044E\u043A\u0430
      \u0443\u043D\u0435\u0441\u043B\u043E \u0432\u0435\u0442\u0440\u043E\u043C.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u043B\u043E\u0436\u0438\u043B\u0438\u0441\u044C
      \u043E\u0442 \u0441\u0442\u0440\u0430\u0445\u0430. \u041B\u044E\u0434\u0438
      \u0441\u0432\u044F\u0437\u0430\u043B\u0438\u0441\u044C \u0432\u0435\u0440\u0451\u0432\u043A\u043E\u0439,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C\u0441\u044F.
      \u0421\u0443\u0440\u043A\u0438 \u0437\u043D\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295673
    m_Localized: "\u0421\u0442\u0430\u044F \u043A\u0443\u0440\u043E\u043F\u0430\u0442\u043E\u043A
      \u0432 \u0433\u043E\u0440\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295674
    m_Localized: "\u041D\u0430 \u0433\u043E\u0440\u043D\u043E\u043C \u043B\u0443\u0433\u0443
      \u043F\u0435\u0440\u0435\u0434 \u043E\u0431\u043E\u0437\u043E\u043C \u0432\u0437\u043B\u0435\u0442\u0430\u0435\u0442
      \u043E\u0433\u0440\u043E\u043C\u043D\u0430\u044F \u0441\u0442\u0430\u044F \u043A\u0435\u043A\u043B\u0438\u043A\u043E\u0432
      - \u0433\u043E\u0440\u043D\u044B\u0445 \u043A\u0443\u0440\u043E\u043F\u0430\u0442\u043E\u043A.
      \u0421\u043E\u0442\u043D\u0438 \u043F\u0442\u0438\u0446, \u0440\u044B\u0436\u0435\u0432\u0430\u0442\u044B\u0445
      \u0441 \u0431\u0435\u043B\u043E\u0439 \u0449\u0435\u043A\u043E\u0439 \u0438
      \u0447\u0451\u0440\u043D\u044B\u043C \u043E\u0436\u0435\u0440\u0435\u043B\u044C\u0435\u043C,
      \u0432\u0437\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0438\u0437 \u0442\u0440\u0430\u0432\u044B
      \u0438 \u043D\u0435\u0441\u0443\u0442\u0441\u044F \u043F\u0440\u043E\u0447\u044C
      \u0441 \u0440\u0435\u0437\u043A\u0438\u043C \u043A\u0440\u0438\u043A\u043E\u043C
      \"\u043A\u0435-\u043A\u0435-\u043A\u0435\". \u041E\u043D\u0438 \u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442\u0441\u044F
      \u0432 \u0441\u0442\u0430 \u0448\u0430\u0433\u0430\u0445. \u0421\u043D\u043E\u0432\u0430.
      \u0418 \u0441\u043D\u043E\u0432\u0430. \u041F\u0442\u0438\u0446 \u0442\u0430\u043A
      \u043C\u043D\u043E\u0433\u043E, \u0447\u0442\u043E \u0438\u0445 \u043C\u043E\u0436\u043D\u043E
      \u0431\u0440\u0430\u0442\u044C \u0440\u0443\u043A\u0430\u043C\u0438. \u041B\u0443\u0447\u043D\u0438\u043A\u0438
      \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F.
      \u0421\u0432\u0435\u0436\u0435\u0435 \u043C\u044F\u0441\u043E \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u043B\u043E
      \u0431\u044B \u0437\u0430\u043F\u0430\u0441\u044B \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295675
    m_Localized: "\u041E\u0445\u043E\u0442\u0438\u0442\u044C\u0441\u044F - \u0434\u043E\u0431\u044B\u0442\u044C
      \u043C\u044F\u0441\u043E \u043D\u0430 \u0442\u0440\u0438 \u0434\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295676
    m_Localized: "\u0417\u0430 \u0447\u0430\u0441 \u043E\u0445\u043E\u0442\u044B
      \u0434\u043E\u0431\u044B\u043B\u0438 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u043F\u0442\u0438\u0446. \u0421\u0432\u0435\u0436\u0435\u0435 \u043C\u044F\u0441\u043E
      \u043D\u0430 \u0442\u0440\u0438 \u0434\u043D\u044F. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0437\u0430\u0436\u0430\u0440\u0438\u043B\u0438 \u043A\u0435\u043A\u043B\u0438\u043A\u043E\u0432
      \u043D\u0430 \u0443\u0433\u043B\u044F\u0445 \u0441 \u0434\u0438\u043A\u043E\u0439
      \u043C\u044F\u0442\u043E\u0439. \u041B\u0443\u0447\u0448\u0438\u0439 \u0443\u0436\u0438\u043D
      \u0437\u0430 \u0434\u0432\u0435 \u043D\u0435\u0434\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295677
    m_Localized: "\u041F\u043E\u0439\u043C\u0430\u0442\u044C \u0442\u0440\u0451\u0445
      \u043F\u0442\u0438\u0446 \u0436\u0438\u0432\u044C\u0451\u043C - \u043F\u0440\u043E\u0434\u0430\u0442\u044C
      \u0432 \u0433\u043E\u0440\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295678
    m_Localized: "\u0422\u0440\u0451\u0445 \u043A\u0435\u043A\u043B\u0438\u043A\u043E\u0432
      \u043F\u043E\u0439\u043C\u0430\u043B\u0438 \u0432 \u043D\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0435
      \u0448\u0430\u043F\u043A\u0438. \u0412 \u041A\u0430\u0448\u0433\u0430\u0440\u0435
      \u0434\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0435 \u0433\u043E\u0440\u043D\u044B\u0435
      \u043A\u0443\u0440\u043E\u043F\u0430\u0442\u043A\u0438 \u0446\u0435\u043D\u044F\u0442\u0441\u044F.
      \u041F\u0440\u043E\u0434\u0430\u043B\u0438 \u0437\u0430 \u0432\u043E\u0441\u0435\u043C\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u043D\u0430 \u0440\u044B\u043D\u043A\u0435
      \u043F\u0442\u0438\u0446\u0435\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295679
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u0442\u0438\u0446
      - \u043F\u0443\u0441\u0442\u044C \u043B\u0435\u0442\u044F\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295680
    m_Localized: "\u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B \u043C\u0438\u043C\u043E.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
      \u0432\u0441\u043B\u0435\u0434 \u0441\u0442\u0430\u0435 \u0441 \u043D\u0435\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u043C\u044B\u043C
      \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u0435\u043C. \u041C\u044F\u0441\u0430
      \u043D\u0435 \u0434\u043E\u0431\u044B\u043B\u0438, \u0437\u0430\u0442\u043E
      \u043F\u0442\u0438\u0446\u044B \u0440\u0430\u0437\u043B\u0435\u0442\u0435\u043B\u0438\u0441\u044C
      \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u043C \u043E\u0431\u043B\u0430\u043A\u043E\u043C
      \u043D\u0430\u0434 \u0433\u043E\u0440\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295681
    m_Localized: "\u0420\u0435\u0434\u043A\u0438\u0439 \u0441\u0430\u0439\u0433\u0430\u043A
      \u0441 \u0440\u043E\u0433\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295682
    m_Localized: "\u041D\u0430 \u043A\u0440\u0430\u044E \u0441\u0442\u0435\u043F\u0438
      \u0441\u0442\u043E\u0438\u0442 \u043E\u0434\u0438\u043D\u043E\u043A\u0438\u0439
      \u0441\u0430\u043C\u0435\u0446 \u0441\u0430\u0439\u0433\u0430\u043A\u0430 \u0441
      \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u043C\u0438 \u043B\u0438\u0440\u043E\u0432\u0438\u0434\u043D\u044B\u043C\u0438
      \u0440\u043E\u0433\u0430\u043C\u0438 \u0438 \u0432\u0437\u0434\u0443\u0442\u044B\u043C
      \u0445\u043E\u0431\u043E\u0442\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u043C
      \u043D\u043E\u0441\u043E\u043C. \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u043E\u0431\u043E\u0437\u0430
      \u0431\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0430. \u0412 \u0441\u0442\u0430
      \u0448\u0430\u0433\u0430\u0445 \u043F\u043E\u0437\u0430\u0434\u0438 - \u0442\u0440\u043E\u0435
      \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432 \u043D\u0430 \u043B\u043E\u0448\u0430\u0434\u044F\u0445
      \u0441 \u043B\u0443\u043A\u0430\u043C\u0438, \u043E\u043D\u0438 \u0441\u043B\u0435\u0434\u044F\u0442
      \u0437\u0430 \u043E\u0431\u043E\u0437\u043E\u043C, \u043E\u043F\u0430\u0441\u0430\u044F\u0441\u044C
      \u0441\u043F\u0443\u0433\u043D\u0443\u0442\u044C \u0434\u043E\u0431\u044B\u0447\u0443.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445 \u043A\u0440\u0438\u0447\u0438\u0442:
      \"\u041D\u0435 \u0434\u0432\u0438\u0433\u0430\u0439\u0442\u0435\u0441\u044C
      - \u043E\u043D \u043D\u0430\u0448\". \u0421\u0430\u0439\u0433\u0430\u043A \u0441
      \u0442\u0430\u043A\u0438\u043C\u0438 \u0440\u043E\u0433\u0430\u043C\u0438 \u043D\u0430
      \u0440\u044B\u043D\u043A\u0435 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      \u0441\u0442\u043E\u0438\u0442 \u0432\u0442\u0440\u043E\u0435 \u0434\u043E\u0440\u043E\u0436\u0435
      \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u0434\u0438\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295683
    m_Localized: "\u0423\u0441\u0442\u0443\u043F\u0438\u0442\u044C - \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432, \u043F\u0443\u0441\u0442\u044C
      \u0431\u0435\u0440\u0443\u0442 \u0441\u0432\u043E\u0451"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295684
    m_Localized: "\u041E\u0431\u043E\u0437 \u0432\u0441\u0442\u0430\u043B. \u041E\u0445\u043E\u0442\u043D\u0438\u043A\u0438
      \u0432\u044B\u043F\u0443\u0441\u0442\u0438\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u044B.
      \u0421\u0430\u0439\u0433\u0430\u043A \u0443\u043F\u0430\u043B. \u041E\u0445\u043E\u0442\u043D\u0438\u043A\u0438
      \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B\u0438
      - \u043E\u0434\u0438\u043D \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B
      \u043E\u0431\u043E\u0437 \u0434\u043E \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438
      \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B \u0445\u043E\u0440\u043E\u0448\u0438\u0439
      \u0432\u043E\u0434\u043E\u043F\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295685
    m_Localized: "\u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C \u0441\u0430\u0439\u0433\u0430\u043A\u0430
      - \u043F\u043E\u0440\u0447\u0430 \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u0430\u043C,
      \u0437\u0430\u0442\u043E \u0431\u0435\u0437 \u0441\u0442\u0440\u0435\u043B
      \u0440\u044F\u0434\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295686
    m_Localized: "\u0421\u0430\u0439\u0433\u0430\u043A \u0443\u0431\u0435\u0436\u0430\u043B.
      \u041E\u0445\u043E\u0442\u043D\u0438\u043A\u0438 \u0437\u0430\u043A\u0440\u0438\u0447\u0430\u043B\u0438
      \u0432 \u044F\u0440\u043E\u0441\u0442\u0438. \u041E\u0434\u0438\u043D \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u043B
      \u0441\u0442\u0440\u0435\u043B\u043E\u0439 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043E\u0431\u043E\u0437\u0430 - \u043D\u0435 \u043F\u043E\u043F\u0430\u043B,
      \u043D\u043E \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      \u044F\u0441\u043D\u043E\u0435. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0432 \u043E\u043A\u0440\u0443\u0433\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295687
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u0430\u043C
      \u043A\u0443\u043F\u0438\u0442\u044C \u0434\u043E\u0431\u044B\u0447\u0443 \u0443
      \u043D\u0438\u0445 \u043F\u043E\u0441\u043B\u0435 \u043E\u0445\u043E\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295688
    m_Localized: "\u041E\u0445\u043E\u0442\u043D\u0438\u043A\u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0438\u0441\u044C
      \u043F\u0440\u043E\u0434\u0430\u0442\u044C \u0440\u043E\u0433\u0430 \u0438
      \u0447\u0430\u0441\u0442\u044C \u043C\u044F\u0441\u0430. \u041F\u043E\u0434\u043E\u0436\u0434\u0430\u043B\u0438
      \u043F\u043E\u043B\u0447\u0430\u0441\u0430. \u0420\u043E\u0433\u0430 \u0441\u0430\u0439\u0433\u0430\u043A\u0430
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435 \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0438
      \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u0446\u0435\u043D\u0443 \u0443
      \u0430\u043F\u0442\u0435\u043A\u0430\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295689
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0432\u043E\u043B\u043A \u0443
      \u0434\u043E\u0440\u043E\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295690
    m_Localized: "\u0412\u043E\u0442 \u0443\u0436\u0435 \u0442\u0440\u0438 \u0434\u043D\u044F
      \u043E\u0434\u0438\u043D \u0432\u043E\u043B\u043A \u0438\u0434\u0451\u0442
      \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u043E \u043E\u0431\u043E\u0437\u0443
      - \u0432 \u0441\u0442\u0430-\u0434\u0432\u0443\u0445\u0441\u0442\u0430\u0445
      \u0448\u0430\u0433\u0430\u0445, \u0442\u043E \u0441\u043F\u0440\u0430\u0432\u0430,
      \u0442\u043E \u0441\u043B\u0435\u0432\u0430. \u041E\u043D \u0441\u0442\u0430\u0440\u044B\u0439:
      \u0448\u0435\u0440\u0441\u0442\u044C \u0441\u0435\u0440\u0430\u044F \u0441
      \u043F\u0440\u043E\u0441\u0435\u0434\u044C\u044E, \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0435, \u043D\u043E \u0442\u043E\u0447\u043D\u044B\u0435.
      \u041D\u0435 \u043D\u0430\u043F\u0430\u0434\u0430\u0435\u0442. \u041D\u0435
      \u0443\u0431\u0435\u0433\u0430\u0435\u0442. \u041F\u0440\u043E\u0441\u0442\u043E
      \u0438\u0434\u0451\u0442. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A-\u0442\u044E\u0440\u043E\u043A
      \u041A\u044E\u043B\u044C \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E:
      \"\u041F\u043E \u0441\u0442\u0435\u043F\u043D\u044B\u043C \u043F\u043E\u0432\u0435\u0440\u044C\u044F\u043C,
      \u043E\u0434\u0438\u043D\u043E\u043A\u0438\u0439 \u0432\u043E\u043B\u043A,
      \u0438\u0434\u0443\u0449\u0438\u0439 \u0441 \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u043C
      \u0442\u0440\u0438 \u0434\u043D\u044F, - \u044D\u0442\u043E \u043C\u0451\u0440\u0442\u0432\u044B\u0439
      \u043F\u0440\u0435\u0434\u043E\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0432\u0435\u0434\u0451\u0442 \u043A \u0447\u0435\u043C\u0443-\u0442\u043E.
      \u0418\u043B\u0438 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u0435\u0442\".
      \u041E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0439 \u043F\u0440\u0438\u0440\u043E\u0434\u043D\u044B\u0445
      \u043D\u0435\u0442: \u0441\u0442\u0430\u0438 \u0437\u0434\u0435\u0441\u044C
      \u043D\u0435\u0442, \u0434\u043E\u0431\u044B\u0447\u0438 \u0443 \u0432\u043E\u043B\u043A\u0430
      \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295691
    m_Localized: "\u0418\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      - \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0442\u0430\u0440\u044B\u0439
      \u0432\u043E\u043B\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295692
    m_Localized: "\u041D\u0430 \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439
      \u0434\u0435\u043D\u044C \u0432\u043E\u043B\u043A \u0438\u0441\u0447\u0435\u0437.
      \u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u044B
      \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\u043C \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u044F
      - \u0438\u043B\u0438 \u043E\u0431\u043B\u0435\u0433\u0447\u0435\u043D\u044B.
      \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B
      \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295693
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u0435\u043C\u0443
      \u043C\u044F\u0441\u043E \u043A\u0430\u0436\u0434\u044B\u0439 \u0432\u0435\u0447\u0435\u0440
      - \u0437\u0430\u0434\u043E\u0431\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295694
    m_Localized: "\u0412\u043E\u043B\u043A \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u043B
      \u043C\u044F\u0441\u043E. \u041D\u0430 \u043F\u044F\u0442\u044B\u0439 \u0434\u0435\u043D\u044C
      \u043E\u043D \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B \u043D\u0430
      \u0441\u0435\u0432\u0435\u0440 \u0438 \u0443\u0448\u0451\u043B \u0432 \u0441\u0442\u0435\u043F\u044C.
      \u041A\u044E\u043B\u044C \u0441\u043A\u0430\u0437\u0430\u043B: \"\u0414\u0430\u043B
      \u0432\u0441\u0451, \u0447\u0442\u043E \u043C\u043E\u0433. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0434\u043E\u0432\u043E\u043B\u0435\u043D\". \u041F\u0440\u043E\u0432\u0438\u0437\u0438\u044F
      \u0443\u0431\u044B\u043B\u0430, \u043D\u043E \u043B\u044E\u0434\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E\u0442
      \u0441\u0435\u0431\u044F \u043B\u0443\u0447\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295695
    m_Localized: "\u0421\u0447\u0438\u0442\u0430\u0442\u044C \u0435\u0433\u043E \u0434\u043E\u0431\u0440\u044B\u043C
      \u0437\u043D\u0430\u043A\u043E\u043C \u0438 \u0438\u0434\u0442\u0438 \u0431\u044B\u0441\u0442\u0440\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295696
    m_Localized: "\u041E\u0431\u043E\u0437 \u0443\u0441\u043A\u043E\u0440\u0438\u043B\u0441\u044F.
      \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u0443 \u043B\u044E\u0434\u0435\u0439
      \u043F\u043E\u0434\u043D\u044F\u043B\u043E\u0441\u044C - \u0432\u0435\u0440\u0438\u043B\u0438
      \u0432 \u0437\u043D\u0430\u043A. \u041D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439
      \u0434\u0435\u043D\u044C \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u0445\u043E\u0434\u0430
      \u043D\u0430\u0448\u043B\u0438 \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u0441\u0442\u043E\u044F\u043D\u043A\u0443
      \u0441 \u0432\u043E\u0434\u043E\u0439. \u0412\u043E\u043B\u043A \u0438\u0441\u0447\u0435\u0437
      \u0432 \u0442\u0443 \u0436\u0435 \u043D\u043E\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295697
    m_Localized: "\u0412\u0435\u0440\u0431\u043B\u044E\u0434\u0438\u0446\u0430 \u0440\u043E\u0436\u0430\u0435\u0442
      \u0432 \u043F\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295698
    m_Localized: "\u0412\u0435\u0440\u0431\u043B\u044E\u0434\u0438\u0446\u0430 \u0438\u0437
      \u043E\u0431\u043E\u0437\u0430 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E
      \u043B\u043E\u0436\u0438\u0442\u0441\u044F \u0438 \u043D\u0435 \u0432\u0441\u0442\u0430\u0451\u0442.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0421\u0430\u043C\u0435\u0445
      \u043F\u043E\u0434\u0431\u0435\u0433\u0430\u0435\u0442 - \u0441\u0445\u0432\u0430\u0442\u043A\u0438.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u043E\u0436\u0438\u0434\u0430\u043B:
      \u043E\u043D\u0430 \u0440\u043E\u0436\u0430\u043B\u0430 \u0441\u043A\u0440\u044B\u0442\u043D\u043E.
      \u0414\u0430\u0442\u0430 \u0440\u043E\u0434\u043E\u0432 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D\u0430
      \u043D\u0435\u0432\u0435\u0440\u043D\u043E. \u0412\u0435\u0440\u0431\u043B\u044E\u0436\u043E\u043D\u043E\u043A
      \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043F\u0435\u0440\u0435\u0434\u043D\u0438\u043C\u0438
      \u043D\u043E\u0433\u0430\u043C\u0438. \u0420\u043E\u0434\u044B \u0443 \u0431\u0430\u043A\u0442\u0440\u0438\u0439\u0441\u043A\u043E\u0439
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0438\u0446\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0442
      \u043E\u0442 \u043F\u043E\u043B\u0443\u0447\u0430\u0441\u0430 \u0434\u043E
      \u0442\u0440\u0451\u0445 \u0447\u0430\u0441\u043E\u0432. \u0415\u0441\u043B\u0438
      \u043D\u0435 \u043F\u043E\u043C\u043E\u0447\u044C - \u0440\u0438\u0441\u043A
      \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C \u0438 \u043C\u0430\u0442\u044C,
      \u0438 \u0434\u0435\u0442\u0451\u043D\u044B\u0448\u0430. \u041E\u0431\u043E\u0437
      \u0441\u0442\u043E\u0438\u0442. \u0416\u0434\u0430\u0442\u044C \u0438\u043B\u0438
      \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295699
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0438 \u043F\u043E\u043C\u043E\u0447\u044C - \u043B\u0435\u043A\u0430\u0440\u044C
      \u0438 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0432\u043C\u0435\u0441\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295700
    m_Localized: "\u0420\u043E\u0434\u044B \u0437\u0430\u043D\u044F\u043B\u0438 \u0447\u0430\u0441
      \u0441\u043E\u0440\u043E\u043A. \u0412\u0435\u0440\u0431\u043B\u044E\u0436\u043E\u043D\u043E\u043A
      \u0440\u044B\u0436\u0438\u0439, \u043C\u043E\u0445\u043D\u0430\u0442\u044B\u0439
      - \u0432\u0441\u0442\u0430\u043B \u043D\u0430 \u043D\u043E\u0433\u0438 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043C\u0438\u043D\u0443\u0442.
      \u041C\u0430\u0442\u044C \u0438 \u0434\u0435\u0442\u0451\u043D\u044B\u0448
      \u0437\u0434\u043E\u0440\u043E\u0432\u044B. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u043C\u043E\u043B\u0447\u0430,
      \u043A\u0430\u043A \u043E\u043D \u0434\u0435\u043B\u0430\u0435\u0442 \u043F\u0435\u0440\u0432\u044B\u0435
      \u0448\u0430\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295701
    m_Localized: "\u0423\u0441\u043A\u043E\u0440\u0438\u0442\u044C \u0440\u043E\u0434\u044B
      - \u043D\u0435 \u0436\u0434\u0430\u0442\u044C \u043B\u0438\u0448\u043D\u0435\u0433\u043E
      \u0447\u0430\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295702
    m_Localized: "\u041D\u0435\u0443\u0434\u0430\u0447\u043D\u043E\u0435 \u0432\u043C\u0435\u0448\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0436\u043E\u043D\u043E\u043A \u0440\u043E\u0434\u0438\u043B\u0441\u044F
      \u0441\u043B\u0430\u0431\u044B\u043C. \u041C\u0430\u0442\u044C \u0436\u0438\u0432\u0430,
      \u0434\u0435\u0442\u0451\u043D\u044B\u0448 \u0432\u044B\u0436\u0438\u043B,
      \u043D\u043E \u043F\u0435\u0440\u0432\u044B\u0435 \u0434\u043D\u0438 \u043E\u043D
      \u0448\u0451\u043B \u043D\u0430 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0435,
      \u0430 \u043D\u0435 \u0441\u0432\u043E\u0438\u043C\u0438 \u043D\u043E\u0433\u0430\u043C\u0438.
      \u041F\u043E\u0442\u0435\u0440\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295703
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C \u043D\u043E\u0432\u043E\u0440\u043E\u0436\u0434\u0451\u043D\u043D\u043E\u0433\u043E
      \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u043E\u043D\u043A\u0430 \u043F\u0435\u0440\u0432\u043E\u043C\u0443
      \u0432\u0441\u0442\u0440\u0435\u0447\u043D\u043E\u043C\u0443 \u043A\u0443\u043F\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295704
    m_Localized: "\u041F\u0440\u043E\u0435\u0437\u0436\u0438\u0439 \u043A\u0443\u043F\u0435\u0446
      \u0438\u0437 \u0411\u0430\u043B\u0445\u0430 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0437\u0430 \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u043E\u043D\u043A\u0430.
      \u0425\u043E\u0440\u043E\u0448\u0430\u044F \u0446\u0435\u043D\u0430. \u041C\u0430\u0442\u044C
      \u043F\u043E\u0448\u043B\u0430 \u0434\u0430\u043B\u044C\u0448\u0435. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043A\u043E\u0441\u0438\u043B\u0438\u0441\u044C - \u043F\u0440\u043E\u0434\u0430\u043B\u0438
      \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E \u0440\u043E\u0436\u0434\u0451\u043D\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295705
    m_Localized: "\u041F\u043E\u0447\u0442\u043E\u0432\u044B\u0439 \u0441\u043E\u043A\u043E\u043B
      \u0441 \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295706
    m_Localized: "\u0421\u043E\u043A\u043E\u043B \u043A\u0440\u0443\u0436\u0438\u0442
      \u043D\u0438\u0437\u043A\u043E \u043D\u0430\u0434 \u043E\u0431\u043E\u0437\u043E\u043C
      \u0438 \u043F\u0430\u0434\u0430\u0435\u0442 \u043A\u0430\u043C\u043D\u0435\u043C
      - \u043D\u0435 \u043D\u0430 \u0434\u043E\u0431\u044B\u0447\u0443, \u0430 \u043F\u0440\u044F\u043C\u043E
      \u043D\u0430 \u0442\u044E\u043A \u043F\u0435\u0440\u0432\u043E\u0433\u043E
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430. \u041E\u043D \u0441\u0438\u0434\u0438\u0442
      \u0442\u0430\u043C \u0441 \u0432\u0438\u0434\u043E\u043C \u0445\u043E\u0437\u044F\u0438\u043D\u0430.
      \u041D\u0430 \u043B\u0430\u043F\u0435 - \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u0442\u0443\u0431\u0443\u0441. \u041F\u0442\u0438\u0446\u0430 \u044F\u0432\u043D\u043E
      \u043F\u043E\u0447\u0442\u043E\u0432\u0430\u044F: \u043A\u043E\u043B\u044C\u0446\u0430
      \u043D\u0430 \u043E\u0431\u0435\u0438\u0445 \u043B\u0430\u043F\u0430\u0445,
      \u0445\u043E\u0440\u043E\u0448\u043E \u0432\u044B\u043D\u043E\u0448\u0435\u043D\u0430.
      \u041D\u043E \u0443\u043F\u0430\u043B\u0430 - \u0447\u0442\u043E-\u0442\u043E
      \u0441\u0431\u0438\u043B\u043E\u0441\u044C \u0432 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u043A\u0435.
      \u041F\u0438\u0441\u044C\u043C\u043E \u0432\u043D\u0443\u0442\u0440\u0438 \u0441\u0432\u0451\u0440\u043D\u0443\u0442\u043E
      \u0432 \u0442\u0440\u0443\u0431\u043A\u0443, \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E
      \u043F\u043E-\u0430\u0440\u0430\u0431\u0441\u043A\u0438. \u041A\u043E\u043C\u0443
      \u043E\u043D\u043E? \u0427\u044C\u0451 \u044D\u0442\u043E? \u0420\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u0442\u044C
      - \u0437\u043D\u0430\u0447\u0438\u0442 \u043F\u0440\u043E\u0447\u0435\u0441\u0442\u044C
      \u0447\u0443\u0436\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295707
    m_Localized: "\u041F\u0440\u043E\u0447\u0435\u0441\u0442\u044C \u043F\u0438\u0441\u044C\u043C\u043E
      - \u0432\u0434\u0440\u0443\u0433 \u0432\u0430\u0436\u043D\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295708
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u043E\u0442 \u043A\u0443\u043F\u0446\u0430
      \u042E\u0441\u0443\u0444\u0430 \u043A \u0435\u0433\u043E \u0430\u0433\u0435\u043D\u0442\u0443
      \u0432 \u041C\u0435\u0440\u0432\u0435 - \u0446\u0435\u043D\u044B \u043D\u0430
      \u0448\u0451\u043B\u043A \u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u0430. \u041F\u043E\u043B\u0435\u0437\u043D\u0430\u044F
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F. \u0421\u043E\u043A\u043E\u043B\u0430
      \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B\u0438 \u0441 \u043D\u043E\u0432\u044B\u043C
      \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435\u043C - \u043F\u0443\u0441\u0442\u044C
      \u043B\u0435\u0442\u0438\u0442 \u043A\u0443\u0434\u0430 \u0434\u043E\u043B\u0436\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295709
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0441\u043E\u043A\u043E\u043B\u0430
      \u0434\u0430\u043B\u044C\u0448\u0435 \u0431\u0435\u0437 \u0447\u0442\u0435\u043D\u0438\u044F
      - \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043F\u0442\u0438\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295710
    m_Localized: "\u041F\u0442\u0438\u0446\u0443 \u043D\u0430\u043A\u043E\u0440\u043C\u0438\u043B\u0438
      \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B\u0438. \u041E\u043D\u0430
      \u0443\u043B\u0435\u0442\u0435\u043B\u0430 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E
      - \u043D\u0430\u0448\u043B\u0430 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440.
      \u0427\u0443\u0436\u043E\u0435 \u043F\u0438\u0441\u044C\u043C\u043E \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043D\u043E
      \u043D\u0435 \u0431\u044B\u043B\u043E. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0447\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0447\u0443\u0442\u044C \u043E\u043A\u0440\u0435\u043F\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295711
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0441\u043E\u043A\u043E\u043B\u0430
      - \u043F\u0440\u043E\u0434\u0430\u0442\u044C \u0432 \u0433\u043E\u0440\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295712
    m_Localized: "\u041E\u0431\u0443\u0447\u0435\u043D\u043D\u044B\u0439 \u043F\u043E\u0447\u0442\u043E\u0432\u044B\u0439
      \u0441\u043E\u043A\u043E\u043B \u043D\u0430 \u0440\u044B\u043D\u043A\u0435
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430 \u0441\u0442\u043E\u0438\u0442
      \u043F\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u043C\u0438\u043D\u0438\u043C\u0443\u043C.
      \u041F\u0440\u043E\u0434\u0430\u043B\u0438. \u041F\u0438\u0441\u044C\u043C\u043E
      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u043B\u0438. \u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C
      \u043F\u0438\u0441\u044C\u043C\u0430 \u0442\u0430\u043A \u0438 \u043D\u0435
      \u0443\u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0431\u044B\u043B\u043E
      \u0432 \u0442\u043E\u043C \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295713
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0435 \u043A\u043E\u0437\u043B\u044B
      \u043D\u0430 \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295714
    m_Localized: "\u0421\u0442\u0430\u0434\u043E \u0441\u0438\u0431\u0438\u0440\u0441\u043A\u0438\u0445
      \u043A\u043E\u0437\u0435\u0440\u043E\u0433\u043E\u0432 - \u0434\u0435\u0432\u044F\u0442\u044C
      \u0441\u0430\u043C\u0446\u043E\u0432 \u0441 \u0438\u0437\u043E\u0433\u043D\u0443\u0442\u044B\u043C\u0438
      \u043D\u0430\u0437\u0430\u0434 \u0440\u043E\u0433\u0430\u043C\u0438 \u0434\u043B\u0438\u043D\u043E\u0439
      \u0432 \u043B\u043E\u043A\u043E\u0442\u044C - \u0441\u0442\u043E\u0438\u0442
      \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u0433\u043E\u0440\u043D\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435. \u041E\u043D\u0438 \u043D\u0435 \u0431\u043E\u044F\u0442\u0441\u044F
      \u043B\u044E\u0434\u0435\u0439: \u043F\u0440\u0438\u0432\u044B\u043A\u043B\u0438
      \u043A \u0440\u0435\u0434\u043A\u0438\u043C \u043F\u0443\u0442\u043D\u0438\u043A\u0430\u043C.
      \u0421\u0430\u043C\u044B\u0439 \u043A\u0440\u0443\u043F\u043D\u044B\u0439,
      \u0441 \u0440\u043E\u0433\u0430\u043C\u0438 \u0432\u043F\u043E\u043B\u043E\u0431\u043E\u0440\u043E\u0442\u0430,
      \u0441\u0442\u043E\u0438\u0442 \u0432 \u0446\u0435\u043D\u0442\u0440\u0435
      \u0442\u0440\u043E\u043F\u044B \u0438 \u0436\u0443\u0451\u0442 \u0441\u0443\u0445\u0443\u044E
      \u0442\u0440\u0430\u0432\u0443 \u0441 \u043D\u0435\u0432\u043E\u0437\u043C\u0443\u0442\u0438\u043C\u044B\u043C
      \u0432\u0438\u0434\u043E\u043C. \u0422\u0440\u043E\u043F\u0430 \u043E\u0434\u043D\u0430.
      \u041A\u043E\u0437\u0435\u0440\u043E\u0433 \u0432\u0435\u0441\u0438\u0442 \u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0436\u0435, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u0438\u0439
      \u0432\u044C\u044E\u043A. \u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C
      \u0435\u0433\u043E \u043A\u0440\u0438\u0447\u0430\u0442 \u043F\u043E-\u0440\u0430\u0437\u043D\u043E\u043C\u0443:
      \u043E\u0434\u043D\u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0442 - \u043D\u0435\u043B\u044C\u0437\u044F,
      \u044D\u0442\u043E \u0433\u043E\u0440\u043D\u044B\u0439 \u0434\u0443\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295715
    m_Localized: "\u041F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C - \u0443\u0439\u0434\u0443\u0442
      \u0441\u0430\u043C\u0438, \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295716
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u0441\u0442\u0430\u0434\u043E
      \u043D\u0435\u0442\u043E\u0440\u043E\u043F\u043B\u0438\u0432\u043E \u0443\u0448\u043B\u043E
      \u0432\u0432\u0435\u0440\u0445 \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443.
      \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B
      \u043F\u0443\u0442\u044C. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0447\u0430\u0441. \u041E\u0434\u0438\u043D \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0443\u043C\u0443\u0434\u0440\u0438\u043B\u0441\u044F \u043F\u043E\u0442\u0440\u043E\u0433\u0430\u0442\u044C
      \u0440\u043E\u0433 \u0432\u043E\u0436\u0430\u043A\u0430 - \u043A\u043E\u0437\u0435\u0440\u043E\u0433
      \u0434\u0430\u0436\u0435 \u0443\u0445\u043E\u043C \u043D\u0435 \u043F\u043E\u0432\u0451\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295717
    m_Localized: "\u041E\u0445\u043E\u0442\u0438\u0442\u044C\u0441\u044F - \u0441\u0432\u0435\u0436\u0435\u0435
      \u043C\u044F\u0441\u043E \u0438 \u0440\u043E\u0433\u0430 \u043D\u0430 \u043F\u0440\u043E\u0434\u0430\u0436\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295718
    m_Localized: "\u0414\u0432\u0443\u0445 \u043A\u043E\u0437\u0435\u0440\u043E\u0433\u043E\u0432
      \u0432\u0437\u044F\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u0430\u043C\u0438.
      \u0421\u0442\u0430\u0434\u043E \u0443\u0448\u043B\u043E. \u0420\u043E\u0433\u0430
      \u0443 \u0430\u043F\u0442\u0435\u043A\u0430\u0440\u044F \u0432 \u041A\u0430\u0448\u0433\u0430\u0440\u0435
      \u0441\u0442\u043E\u044F\u0442 \u0445\u043E\u0440\u043E\u0448\u043E. \u041C\u044F\u0441\u043E
      \u043D\u0430 \u0442\u0440\u0438 \u0434\u043D\u044F. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0411\u0443\u0433\u0430 \u043F\u043E\u043C\u043E\u0440\u0449\u0438\u043B\u0441\u044F:
      \u0432 \u0433\u043E\u0440\u0430\u0445 \u043E\u0445\u043E\u0442\u0430 \u043D\u0430
      \u043A\u043E\u0437\u0435\u0440\u043E\u0433\u043E\u0432 - \u043F\u043B\u043E\u0445\u043E\u0439
      \u0437\u043D\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295719
    m_Localized: "\u041A\u0440\u0438\u0447\u0430\u0442\u044C \u0438 \u0431\u0440\u043E\u0441\u0430\u0442\u044C
      \u043A\u0430\u043C\u043D\u0438 - \u043F\u0440\u043E\u0433\u043D\u0430\u0442\u044C
      \u0431\u044B\u0441\u0442\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295720
    m_Localized: "\u041A\u043E\u0437\u0435\u0440\u043E\u0433\u0438 \u043D\u0435\u0445\u043E\u0442\u044F
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438 - \u043D\u0430 \u0441\u043A\u0430\u043B\u0443
      \u0432 \u043F\u044F\u0442\u0438 \u0448\u0430\u0433\u0430\u0445 \u043E\u0442
      \u0442\u0440\u043E\u043F\u044B. \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B,
      \u0430 \u043E\u043D\u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
      \u0441\u0432\u0435\u0440\u0445\u0443 \u0440\u0430\u0432\u043D\u043E\u0434\u0443\u0448\u043D\u044B\u043C\u0438
      \u0433\u043B\u0430\u0437\u0430\u043C\u0438. \u041A\u0430\u043C\u043D\u0438
      \u043E\u0442\u0432\u043B\u0435\u043A\u043B\u0438, \u043D\u0435 \u043F\u0440\u043E\u0433\u043D\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295721
    m_Localized: "\u0411\u0443\u0440\u044F \u0441\u0431\u0438\u043B\u0430 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295722
    m_Localized: "\u0412\u0435\u0442\u0435\u0440 \u0443\u0442\u0438\u0445 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430 \u0447\u0430\u0441\u0430, \u043E\u0441\u0442\u0430\u0432\u0438\u0432
      \u0432\u043C\u0435\u0441\u0442\u043E \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0433\u043E
      \u0440\u0435\u043B\u044C\u0435\u0444\u0430 \u0440\u043E\u0432\u043D\u043E\u0435
      \u0431\u0435\u043B\u043E\u0435 \u043C\u043E\u0440\u0435 \u043F\u0435\u0441\u043A\u0430
      - \u0434\u044E\u043D\u044B \u043F\u0435\u0440\u0435\u043A\u0430\u0442\u0438\u043B\u0438\u0441\u044C,
      \u0441\u0442\u043E\u043B\u0431\u044B \u0437\u0430\u043D\u0435\u0441\u043B\u043E,
      \u0441\u043B\u0435\u0434\u044B \u0438\u0441\u0447\u0435\u0437\u043B\u0438.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0421\u0430\u043C\u0435\u0445
      \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043B\u0430\u0434\u043E\u043D\u044C
      \u043A\u043E\u0437\u044B\u0440\u044C\u043A\u043E\u043C, \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044F\u0441\u044C:
      \u0442\u0440\u0438 \u0432\u043F\u0430\u0434\u0438\u043D\u044B \u043D\u0430
      \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435, \u0438 \u043D\u0438
      \u043E\u0434\u043D\u0430 \u043D\u0435 \u043F\u043E\u0445\u043E\u0436\u0430
      \u043D\u0430 \u0442\u0443, \u0447\u0442\u043E \u0431\u044B\u043B\u0430 \u0432\u0447\u0435\u0440\u0430.
      \u0426\u0435\u043D\u0430 \u043E\u0448\u0438\u0431\u043A\u0438 - \u043F\u043E\u043B\u0442\u043E\u0440\u0430
      \u0434\u043D\u044F \u043F\u0443\u0442\u0438 \u0438 \u0437\u0430\u043F\u0430\u0441\u044B
      \u0432\u043E\u0434\u044B \u043D\u0430 \u0434\u0432\u0435 \u0442\u0440\u0435\u0442\u0438.
      \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0435 \u043A\u0443\u043F\u0446\u044B
      \u0433\u043E\u0432\u043E\u0440\u044F\u0442: \u0432 \u0422\u0430\u043A\u043B\u0430-\u041C\u0430\u043A\u0430\u043D
      \u0431\u0443\u0440\u044F \u043C\u0435\u043D\u044F\u0435\u0442 \u0434\u043E\u0440\u043E\u0433\u0438
      \u0442\u0430\u043A \u0436\u0435 \u043B\u0435\u0433\u043A\u043E, \u043A\u0430\u043A
      \u043F\u0438\u0441\u0435\u0446 \u043F\u0440\u0430\u0432\u0438\u0442 \u0447\u0435\u0440\u043D\u043E\u0432\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295723
    m_Localized: "\u0418\u0434\u0442\u0438 \u043F\u043E \u0441\u043B\u0435\u0434\u0430\u043C
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u043A \u0432\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295724
    m_Localized: "\u041A\u043E\u043F\u044B\u0442\u0430 \u044F\u043A\u043E\u0432 \u0438
      \u043A\u043E\u0448\u0430\u0447\u044C\u0438 \u0441\u043B\u0435\u0434\u044B \u043F\u0435\u0442\u043B\u044F\u043B\u0438,
      \u043D\u043E \u0432\u044B\u0432\u0435\u043B\u0438 \u043A \u0432\u044B\u0441\u043E\u0445\u0448\u0435\u043C\u0443
      \u0440\u0443\u0441\u043B\u0443 - \u0442\u0430\u043C \u0432 \u0442\u0435\u043D\u0438
      \u043E\u0431\u0440\u044B\u0432\u0430 \u043D\u0430\u0448\u043B\u0430\u0441\u044C
      \u0437\u043D\u0430\u043A\u043E\u043C\u0430\u044F \u0433\u0440\u0443\u0434\u0430
      \u043A\u0430\u043C\u043D\u0435\u0439. \u041E\u0440\u0438\u0435\u043D\u0442\u0438\u0440
      \u0446\u0435\u043B. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0432\u0440\u0435\u043C\u044F
      \u0438 \u043D\u0435\u0440\u0432\u044B, \u043D\u043E \u043D\u0435 \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295725
    m_Localized: "\u0416\u0434\u0430\u0442\u044C \u043D\u043E\u0447\u0438 - \u0438\u0434\u0442\u0438
      \u043F\u043E \u0437\u0432\u0451\u0437\u0434\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295726
    m_Localized: "\u041F\u043B\u0435\u044F\u0434\u044B \u0432\u0437\u043E\u0448\u043B\u0438
      \u0437\u0430 \u0447\u0430\u0441 \u0434\u043E \u043F\u043E\u043B\u0443\u043D\u043E\u0447\u0438,
      \u0447\u0438\u0441\u0442\u044B\u0435 \u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0435.
      \u0421\u0430\u043C\u0435\u0445 \u0432\u0451\u043B \u043E\u0431\u043E\u0437
      \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E - \u0437\u0430 \u0442\u0440\u0438
      \u043D\u043E\u0447\u043D\u044B\u0435 \u0441\u0442\u043E\u044F\u043D\u043A\u0438
      \u0441\u043E\u0433\u0434\u0438\u0439\u0446\u044B \u0438\u043C\u0435\u043D\u043D\u043E
      \u0442\u0430\u043A \u0438 \u0432\u044B\u0445\u043E\u0434\u0438\u043B\u0438
      \u0438\u0437 \u0432\u0435\u043B\u0438\u043A\u043E\u0439 \u043F\u0443\u0441\u0442\u044B\u043D\u0438.
      \u041A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443 \u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C \u0441 \u043D\u0430\u0441\u0435\u0447\u043A\u0430\u043C\u0438
      \u0431\u043B\u0435\u0441\u043D\u0443\u043B \u0432 \u0441\u0432\u0435\u0442\u0435
      \u0444\u0430\u043A\u0435\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295727
    m_Localized: "\u0420\u0430\u0437\u043E\u0441\u043B\u0430\u0442\u044C \u0442\u0440\u0451\u0445
      \u043B\u044E\u0434\u0435\u0439 \u0432 \u0440\u0430\u0437\u043D\u044B\u0435
      \u0441\u0442\u043E\u0440\u043E\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295728
    m_Localized: "\u0414\u0432\u043E\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u043F\u0443\u0441\u0442\u044B\u043C\u0438. \u0422\u0440\u0435\u0442\u0438\u0439
      - \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0411\u0443\u0433\u0430
      - \u043D\u0430\u0448\u0451\u043B \u0441\u0442\u0430\u0440\u044B\u0439 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439
      \u0437\u0430\u0433\u043E\u043D \u0434\u043B\u044F \u0441\u043A\u043E\u0442\u0430
      \u0432 \u0434\u0432\u0443\u0445 \u043B\u0438 \u043A \u044E\u0433\u0443. \u0417\u0430\u0433\u043E\u043D
      \u0441\u0442\u043E\u0438\u0442 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438,
      \u043D\u043E \u043F\u043E\u043A\u0430 \u0435\u0433\u043E \u0438\u0441\u043A\u0430\u043B\u0438,
      \u0436\u0430\u0440\u0430 \u0432\u0437\u044F\u043B\u0430 \u0441\u0432\u043E\u0451:
      \u0434\u0432\u0430 \u0432\u044C\u044E\u0447\u043D\u044B\u0445 \u043C\u0435\u0448\u043A\u0430
      \u0441 \u043F\u0440\u043E\u0432\u0438\u0430\u043D\u0442\u043E\u043C \u043F\u043E\u0440\u0432\u0430\u043B\u0438\u0441\u044C
      \u043E\u0442 \u0436\u0451\u0441\u0442\u043A\u043E\u0439 \u043F\u043E\u0441\u0430\u0434\u043A\u0438
      \u043D\u0430 \u043A\u0430\u043C\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295729
    m_Localized: "\u0417\u0432\u0451\u0437\u0434\u043D\u0430\u044F \u043A\u0430\u0440\u0442\u0430
      \u043A\u0443\u043F\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295730
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u043A\u043E\u0440\u0438\u0430\u043D\u0434\u0440\u0430
      \u0438 \u0441\u0442\u0430\u0440\u043E\u0439 \u043A\u043E\u0436\u0438 - \u043A\u0443\u043F\u0435\u0446
      \u0424\u0430\u0440\u0440\u0443\u0445 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u0435 \u043A\u0443\u0441\u043E\u043A
      \u0432\u044B\u0434\u0435\u043B\u0430\u043D\u043D\u043E\u0439 \u043E\u0432\u0447\u0438\u043D\u044B
      \u0441 \u043D\u0430\u043D\u0435\u0441\u0451\u043D\u043D\u044B\u043C\u0438 \u0442\u0443\u0448\u044C\u044E
      \u0437\u0432\u0451\u0437\u0434\u043D\u044B\u043C\u0438 \u0440\u0438\u0441\u0443\u043D\u043A\u0430\u043C\u0438
      \u0438 \u043F\u0443\u043D\u043A\u0442\u0438\u0440\u043E\u043C \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430
      \u043E\u0442 \u041C\u0435\u0440\u0432\u0430 \u0434\u043E \u041A\u0430\u0448\u0433\u0430\u0440\u0430.
      \u0415\u0433\u043E \u0441\u043C\u0443\u0433\u043B\u044B\u0435 \u043F\u0430\u043B\u044C\u0446\u044B
      \u043F\u043E\u0441\u0442\u0443\u043A\u0438\u0432\u0430\u044E\u0442 \u043F\u043E
      \u0442\u043E\u0447\u043A\u0430\u043C: <npc_speech lang=\"Persian\">\u0427\u0435\u0442\u044B\u0440\u0435
      \u0441\u0442\u043E\u044F\u043D\u043A\u0438 \u0434\u043E \u0425\u043E\u0442\u0430\u043D\u0430
      - \u043D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u043E\u043F\u0430\u0441\u043D\u043E\u0433\u043E
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430.</npc_speech> \u041A\u0430\u0440\u0442\u0430
      \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0441\u0432\u0435\u0436\u0435\u0439,
      \u043D\u043E \u0446\u0435\u043D\u0430 - \u0441\u043E\u0440\u043E\u043A \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0438\u043B\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C
      \u0448\u0430\u043D\u0441. \u041F\u0435\u0440\u0441 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442:
      \u044D\u0442\u043E \u043A\u043E\u043F\u0438\u044F \u0441 \u043A\u0430\u0440\u0442\u044B
      \u0446\u0437\u0435\u0434\u0443\u0448\u0438, \u0441\u043D\u044F\u0442\u0430\u044F
      \u0434\u0432\u0430 \u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295731
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u043A\u0430\u0440\u0442\u0443
      \u0437\u0430 \u0437\u0430\u043F\u0440\u043E\u0448\u0435\u043D\u043D\u0443\u044E
      \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295732
    m_Localized: "\u0424\u0430\u0440\u0440\u0443\u0445 \u0441\u0432\u0435\u0440\u043D\u0443\u043B
      \u043A\u0430\u0440\u0442\u0443 \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u043B
      \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
      \u0442\u0440\u0438 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430 \u043F\u0440\u043E\u0448\u043B\u0438
      \u0431\u0435\u0437 \u0435\u0434\u0438\u043D\u043E\u0433\u043E \u0441\u043F\u043E\u0440\u0430
      \u043E \u0434\u043E\u0440\u043E\u0433\u0435: \u0437\u0432\u0451\u0437\u0434\u043D\u044B\u0435
      \u0437\u0430\u0441\u0435\u0447\u043A\u0438 \u0438 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0435
      \u043A\u043E\u043B\u043E\u0434\u0446\u044B \u0441\u043E\u0432\u043F\u0430\u043B\u0438
      \u0441 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E.
      \u0414\u0438\u0440\u0445\u0430\u043C\u044B \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B
      \u043D\u0435 \u0432\u043F\u0443\u0441\u0442\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295733
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0439
      \u0446\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295734
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0434\u043E\u043B\u0433\u043E\u0433\u043E
      \u0442\u043E\u0440\u0433\u0430 \u0424\u0430\u0440\u0440\u0443\u0445 \u0443\u0441\u0442\u0443\u043F\u0438\u043B,
      \u043D\u043E \u0441 \u0435\u0434\u0432\u0430 \u0441\u043A\u0440\u044B\u0442\u043E\u0439
      \u043E\u0431\u0438\u0434\u043E\u0439 \u043A\u0438\u0432\u043D\u0443\u043B:
      <npc_speech lang=\"Persian\">\u0412\u043E\u0437\u044C\u043C\u0438 \u0437\u0430
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043F\u044F\u0442\u044C.</npc_speech>
      \u041A\u0430\u0440\u0442\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u0442\u043E\u0447\u043D\u043E\u0439. \u041F\u0435\u0440\u0441\u044B \u043F\u043E\u043C\u043D\u044F\u0442
      \u0442\u0430\u043A\u043E\u0435 - \u0441\u043A\u0443\u043F\u043E\u0439 \u043F\u043B\u0430\u0442\u0438\u0442
      \u0434\u0432\u0430\u0436\u0434\u044B \u0432 \u0441\u043C\u044B\u0441\u043B\u0435
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295735
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F -
      \u043E\u0431\u043E\u0439\u0434\u0451\u043C\u0441\u044F \u0441\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295736
    m_Localized: "\u0424\u0430\u0440\u0440\u0443\u0445 \u043F\u043E\u0436\u0430\u043B
      \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438 \u0443\u0431\u0440\u0430\u043B
      \u043A\u0430\u0440\u0442\u0443. \u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0435 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B\u0438
      \u043F\u043E\u043B\u0434\u043D\u044F \u043D\u0430 \u043F\u043E\u0438\u0441\u043A
      \u0437\u0430\u0432\u0430\u043B\u0435\u043D\u043D\u043E\u0433\u043E \u043F\u0435\u0441\u043A\u043E\u043C
      \u043A\u043E\u043B\u043E\u0434\u0446\u0430. \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u043A\u0430\u0440\u0442\u0430 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430
      \u0431\u044B \u0435\u0433\u043E \u0441\u0440\u0430\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295737
    m_Localized: "\u0420\u0430\u0437\u0432\u0438\u043B\u043A\u0430 \u0431\u0435\u0437
      \u0437\u043D\u0430\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295738
    m_Localized: "\u0414\u0432\u0430 \u043F\u044B\u043B\u044C\u043D\u044B\u0445 \u043F\u044F\u0442\u043D\u0430
      \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u043E\u0442 \u0446\u0435\u043D\u0442\u0440\u0430
      - \u043D\u0438 \u0441\u0442\u043E\u043B\u0431\u0430, \u043D\u0438 \u0433\u0440\u0443\u0434\u044B
      \u043A\u0430\u043C\u043D\u0435\u0439, \u043D\u0438 \u0442\u0440\u044F\u043F\u043A\u0438
      \u043D\u0430 \u043A\u0443\u0441\u0442\u0435. \u041B\u0435\u0432\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0448\u0438\u0440\u0435 \u0438 \u0432\u0434\u0430\u0432\u043B\u0435\u043D\u0430
      \u0433\u043B\u0443\u0431\u0436\u0435: \u0442\u0443\u0442 \u0445\u043E\u0434\u0438\u043B\u0438
      \u0442\u044F\u0436\u0451\u043B\u044B\u0435 \u0432\u043E\u0437\u044B. \u041F\u0440\u0430\u0432\u0430\u044F
      - \u0441\u0432\u0435\u0436\u0438\u0439 \u043D\u0430\u0432\u043E\u0437 \u044F\u043A\u043E\u0432,
      \u043D\u0435 \u0441\u0442\u0430\u0440\u0448\u0435 \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0435\u0433\u043E
      \u0432\u0435\u0447\u0435\u0440\u0430. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0447\u0435\u0448\u0435\u0442
      \u0437\u0430\u0442\u044B\u043B\u043E\u043A: \u043E\u043D \u0437\u043D\u0430\u0435\u0442
      \u044D\u0442\u0438 \u043C\u0435\u0441\u0442\u0430 \u043F\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043C
      \u043E\u0442\u0446\u0430, \u043D\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0440\u0430\u0437 \u0441\u0430\u043C \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B
      \u0437\u0434\u0435\u0441\u044C \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434. \u0412\u0440\u0435\u043C\u044F
      \u043D\u0435 \u0436\u0434\u0451\u0442 - \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435
      \u0447\u0435\u0440\u043D\u0435\u0435\u0442 \u043F\u043E\u043B\u043E\u0441\u0430
      \u043E\u0431\u043B\u0430\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295739
    m_Localized: "\u041B\u0435\u0432\u0430\u044F - \u0442\u044F\u0436\u0451\u043B\u044B\u0435
      \u0432\u043E\u0437\u044B \u0437\u043D\u0430\u043B\u0438 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295740
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0432\u044B\u0448\u043B\u0430 \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u044E
      \u0441 \u043E\u0431\u0432\u0430\u043B\u0438\u0432\u0448\u0435\u0439\u0441\u044F
      \u043A\u0440\u043E\u0432\u043B\u0435\u0439 - \u0437\u0430\u0431\u0440\u043E\u0448\u0435\u043D,
      \u043D\u043E \u0441\u0442\u0435\u043D\u044B \u0446\u0435\u043B\u044B. \u0421\u0442\u0430\u0440\u044B\u0435
      \u043A\u043E\u043B\u0435\u0438 \u0432\u0435\u043B\u0438 \u0438\u043C\u0435\u043D\u043D\u043E
      \u0441\u044E\u0434\u0430, \u0430 \u0434\u0430\u043B\u044C\u0448\u0435 \u0443\u0436\u0435
      \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439 \u0442\u0440\u0430\u043A\u0442.
      \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440,
      \u0445\u043E\u0442\u044F \u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295741
    m_Localized: "\u041F\u0440\u0430\u0432\u0430\u044F - \u0441\u0432\u0435\u0436\u0438\u0439
      \u0441\u043B\u0435\u0434 \u043D\u0430\u0434\u0451\u0436\u043D\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295742
    m_Localized: "\u0421\u0432\u0435\u0436\u0438\u0435 \u0441\u043B\u0435\u0434\u044B
      \u043F\u0440\u0438\u0432\u0435\u043B\u0438 \u043A \u043F\u0430\u0441\u0442\u0431\u0438\u0449\u0443,
      \u0430 \u043E\u0442 \u043D\u0435\u0433\u043E - \u043A \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u044C\u043D\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435 \u0441 \u044F\u0441\u043D\u044B\u043C\u0438
      \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u0430\u043C\u0438. \u041F\u0430\u0441\u0442\u0443\u0445-\u0442\u044E\u0440\u043A
      \u0436\u0435\u0441\u0442\u043E\u043C \u043F\u043E\u043A\u0430\u0437\u0430\u043B
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435. \u0418\u0434\u0442\u0438
      \u0431\u044B\u043B\u043E \u043B\u0435\u0433\u0447\u0435, \u0447\u0435\u043C
      \u043E\u0436\u0438\u0434\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295743
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u0430
      \u043F\u0435\u0448\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295744
    m_Localized: "\u0413\u043E\u043D\u0435\u0446 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441: \u043F\u0440\u0430\u0432\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0443\u0445\u043E\u0434\u0438\u0442 \u0432
      \u0431\u0430\u043B\u043A\u0443 \u0438 \u0442\u0435\u0440\u044F\u0435\u0442\u0441\u044F.
      \u041B\u0435\u0432\u0430\u044F \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043A
      \u0440\u0443\u0441\u043B\u0443. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0432\u0440\u0435\u043C\u044F, \u043D\u043E \u0432\u044B\u0431\u043E\u0440
      \u0442\u043E\u0447\u043D\u044B\u0439 - \u043D\u0438\u043A\u0430\u043A\u0438\u0445
      \u0441\u044E\u0440\u043F\u0440\u0438\u0437\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295745
    m_Localized: "\u041C\u0438\u0440\u0430\u0436 \u0432\u043F\u0435\u0440\u0435\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295746
    m_Localized: "\u041F\u0430\u043B\u044C\u043C\u044B \u0434\u0440\u043E\u0436\u0430\u0442
      \u043D\u0430\u0434 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u043E\u043C
      - \u0437\u0435\u043B\u0451\u043D\u044B\u0435, \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0437\u0435\u043B\u0451\u043D\u044B\u0435 \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0433\u043E\u0434\u0430. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043F\u043E\u0434\u043D\u044F\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u044B
      \u0438 \u043F\u043E\u0442\u044F\u043D\u0443\u043B\u0438\u0441\u044C \u0432\u043F\u0435\u0440\u0451\u0434,
      \u043D\u043E\u0437\u0434\u0440\u0438 \u0440\u0430\u0437\u0434\u0443\u043B\u0438\u0441\u044C.
      \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u041F\u0435\u043C\u0431\u0430
      \u0438\u0437 \u0422\u0438\u0431\u0435\u0442\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0441\u0443\u0445\u043E: <npc_speech lang=\"Tibetan\">\u041D\u0435 \u0445\u043E\u0434\u0438
      - \u0437\u0435\u043C\u043B\u044F \u0433\u043E\u0440\u044F\u0447\u0430\u044F,
      \u0432\u043E\u0434\u044B \u043D\u0435\u0442.</npc_speech> \u041D\u043E \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u0442\u044F\u043D\u0443\u0442 \u043F\u043E\u0441\u0442\u0440\u043E\u043C\u043A\u0438,
      \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0443\u0436\u0435 \u0441\u043F\u043E\u0440\u044F\u0442 - \u043C\u0438\u0440\u0430\u0436
      \u0438\u043B\u0438 \u043D\u0435\u0442. \u0412\u043E\u0434\u044B \u0432 \u0431\u0443\u0440\u0434\u044E\u043A\u0430\u0445
      \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043D\u0430 \u043F\u043E\u043B\u0442\u043E\u0440\u0430
      \u0434\u043D\u044F, \u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u043E\u0430\u0437\u0438\u0441
      - \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295747
    m_Localized: "\u0418\u0434\u0442\u0438 \u043A \u043E\u0430\u0437\u0438\u0441\u0443
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295748
    m_Localized: "\u0427\u0430\u0441 \u043F\u0443\u0442\u0438 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      - \u0438 \u043F\u0430\u043B\u044C\u043C\u044B \u0440\u0430\u0441\u0442\u0430\u044F\u043B\u0438
      \u0432 \u0433\u043E\u0440\u044F\u0447\u0435\u043C \u0432\u043E\u0437\u0434\u0443\u0445\u0435.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C,
      \u043C\u043E\u0442\u0430\u044F \u0433\u043E\u043B\u043E\u0432\u0430\u043C\u0438.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0432\u043E\u0434\u0443 \u043D\u0430
      \u043E\u0431\u0445\u043E\u0434\u043D\u043E\u0439 \u043A\u0440\u044E\u043A \u0438
      \u0442\u0440\u0438 \u0447\u0430\u0441\u0430 \u043F\u043E\u0434 \u043F\u043E\u043B\u0443\u0434\u0435\u043D\u043D\u044B\u043C
      \u0441\u043E\u043B\u043D\u0446\u0435\u043C. \u041F\u0435\u043C\u0431\u0430
      \u043C\u043E\u043B\u0447\u0430\u043B \u0432\u0435\u0441\u044C \u043F\u0443\u0442\u044C
      \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289613295749
    m_Localized: "\u0414\u043E\u0432\u0435\u0440\u044F\u0442\u044C \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0443
      - \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043A\u0443\u0440\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489920
    m_Localized: "\u041F\u0435\u043C\u0431\u0430 \u043F\u043E\u0432\u0451\u043B \u043E\u0431\u043E\u0437
      \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439, \u043D\u0435 \u0433\u043B\u044F\u0434\u044F
      \u043D\u0430 \u043C\u0435\u0440\u0446\u0430\u043D\u0438\u0435. \u0415\u0449\u0451
      \u0447\u0435\u0440\u0435\u0437 \u0448\u0435\u0441\u0442\u044C \u0447\u0430\u0441\u043E\u0432
      \u0432 \u043B\u043E\u0436\u0431\u0438\u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F \u0432\u043E\u0434\u0430
      - \u0447\u0443\u0442\u044C \u043C\u0443\u0442\u043D\u0430\u044F, \u043D\u043E
      \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F. \u0422\u0438\u0431\u0435\u0442\u0435\u0446
      \u0443\u043C\u0435\u0435\u0442 \u0447\u0438\u0442\u0430\u0442\u044C \u043F\u0443\u0441\u0442\u044B\u043D\u044E
      \u043A\u0430\u043A \u043A\u043D\u0438\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489921
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u0430
      - \u0440\u0435\u0448\u0438\u0442\u044C \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489922
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0411\u0443\u0433\u0430
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0447\u0435\u0440\u0435\u0437
      \u043F\u043E\u043B\u0442\u043E\u0440\u0430 \u0447\u0430\u0441\u0430: \u0441\u0443\u0445\u043E\u0439
      \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A, \u043D\u0438 \u043A\u0430\u043F\u043B\u0438.
      \u041E\u0431\u043E\u0437 \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0447\u0430\u0441,
      \u0437\u0430\u0442\u043E \u043D\u0435 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B
      \u0432\u043E\u0434\u0443 \u043D\u0430 \u0432\u0441\u0435\u0445. \u041F\u0435\u043C\u0431\u0430
      \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043A\u0438\u0432\u043D\u0443\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489923
    m_Localized: "\u0420\u0435\u043A\u0430 \u0438\u0441\u0447\u0435\u0437\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489924
    m_Localized: "\u041D\u0430 \u043A\u0430\u0440\u0442\u0435 - \u0441\u0438\u043D\u044F\u044F
      \u043B\u0438\u043D\u0438\u044F \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u044B.
      \u041D\u0430 \u043C\u0435\u0441\u0442\u0435 - \u0440\u0430\u0441\u0442\u0440\u0435\u0441\u043A\u0430\u0432\u0448\u0435\u0435\u0441\u044F
      \u0433\u043B\u0438\u043D\u044F\u043D\u043E\u0435 \u0434\u043D\u043E, \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043B\u0443\u0436 \u0438 \u0437\u0430\u043F\u0430\u0445 \u0437\u0430\u0442\u0445\u043B\u043E\u0439
      \u0433\u0440\u044F\u0437\u0438. \u041D\u0438\u0447\u0435\u0433\u043E. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0410\u0445\u043C\u0430\u0434 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043F\u043E\u0436\u0435\u043B\u0442\u0435\u0432\u0448\u0438\u0439 \u043B\u0438\u0441\u0442
      \u0441 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u043C \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u043E\u043C
      \u0438 \u0449\u0443\u0440\u0438\u0442\u0441\u044F: \u043A\u0430\u0440\u0442\u0430
      \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u043F\u0440\u0438
      \u0434\u0435\u0434\u0435 \u043D\u044B\u043D\u0435\u0448\u043D\u0435\u0433\u043E
      \u0445\u0430\u043B\u0438\u0444\u0430. \u0413\u0434\u0435 \u0431\u0440\u0430\u0442\u044C
      \u0432\u043E\u0434\u0443 - \u043D\u0435\u044F\u0441\u043D\u043E; \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
      \u0441\u0442\u043E\u044F\u043D\u043A\u0430 \u0441 \u043A\u043E\u043B\u043E\u0434\u0446\u0435\u043C
      - \u043F\u043E\u043B\u0442\u043E\u0440\u0430 \u0434\u043D\u044F \u043F\u0443\u0442\u0438.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u0441\u0442\u043E\u044F\u0442
      \u043D\u0430 \u0441\u0443\u0445\u043E\u043C \u0434\u043D\u0435 \u0438 \u0436\u0443\u044E\u0442
      \u043F\u0443\u0441\u0442\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489925
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u0431\u0440\u043E\u0434 \u0432\u0432\u0435\u0440\u0445
      \u043F\u043E \u0440\u0443\u0441\u043B\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489926
    m_Localized: "\u0412 \u0434\u0432\u0443\u0445 \u043B\u0438 \u0432\u044B\u0448\u0435
      \u043D\u0430\u0448\u043B\u0438 \u043F\u0440\u043E\u0441\u0430\u0447\u0438\u0432\u0430\u043D\u0438\u0435
      - \u043D\u0435 \u0440\u0435\u043A\u0430, \u043D\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u0431\u0443\u0440\u0434\u044E\u043A\u043E\u0432.
      \u0411\u0435\u0440\u0435\u0433 \u043A\u0440\u0443\u0442\u043E\u0439, \u043E\u0434\u043D\u0430
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u0435\u0434\u0432\u0430 \u043D\u0435
      \u0437\u0430\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044C. \u0410\u0445\u043C\u0430\u0434
      \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B \u0438 \u0432\u044B\u0442\u0435\u0440
      \u043B\u043E\u0431."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489927
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043D\u0430
      \u0441\u0442\u0430\u0440\u044B\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489928
    m_Localized: "\u041A\u0440\u0443\u0433\u043E\u0432\u043E\u0439 \u043E\u0431\u0445\u043E\u0434
      \u0441\u044A\u0435\u043B \u0434\u0432\u0430 \u0434\u043D\u044F \u0438 \u0437\u0430\u043F\u0430\u0441\u044B.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u0448\u043B\u0438 \u043F\u043E\u043D\u0443\u0440\u044B\u0435.
      \u0417\u0430\u0442\u043E \u0434\u043E\u0440\u043E\u0433\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430\u044F,
      \u0438 \u043A\u043E\u043B\u043E\u0434\u0435\u0446 \u0443 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u044F
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043F\u043E\u043B\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489929
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u043C\u0435\u0441\u0442\u043D\u043E\u0433\u043E
      \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0430 \u043A\u0430\u043A \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489930
    m_Localized: "\u042E\u043D\u043E\u0448\u0430-\u0442\u044E\u0440\u043A \u0437\u0430
      \u043F\u0440\u0438\u0433\u043E\u0440\u0448\u043D\u044E \u043C\u043E\u043D\u0435\u0442
      \u043F\u0440\u043E\u0432\u0451\u043B \u043A \u0441\u043A\u0440\u044B\u0442\u043E\u043C\u0443
      \u043A\u043B\u044E\u0447\u0443 \u0437\u0430 \u0433\u0440\u0430\u043D\u0438\u0442\u043D\u044B\u043C
      \u0432\u044B\u0441\u0442\u0443\u043F\u043E\u043C. \u0414\u0432\u0430 \u0447\u0430\u0441\u0430
      \u043A\u0440\u044E\u043A\u0430, \u0437\u0430\u0442\u043E \u0432\u0441\u0435
      \u0431\u0443\u0440\u0434\u044E\u043A\u0438 \u043F\u043E\u043B\u043D\u044B.
      \u041E\u043D \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F \u0438
      \u0438\u0441\u0447\u0435\u0437 \u0442\u0430\u043A \u0436\u0435 \u0431\u044B\u0441\u0442\u0440\u043E,
      \u043A\u0430\u043A \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489931
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u0430\u043B \u0432 \u0442\u0443\u043C\u0430\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489932
    m_Localized: "\u041E\u0431\u043B\u0430\u043A\u043E \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u043E\u0441\u044C
      \u0432 \u0441\u0435\u0434\u043B\u043E\u0432\u0438\u043D\u0443 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430
      - \u0431\u0435\u043B\u043E\u0435, \u043F\u043B\u043E\u0442\u043D\u043E\u0435,
      \u0441 \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u043C\u043E\u043A\u0440\u043E\u0433\u043E
      \u043A\u0430\u043C\u043D\u044F \u0438 \u043B\u0435\u0434\u043D\u0438\u043A\u0430.
      \u0412 \u043F\u044F\u0442\u0438 \u0448\u0430\u0433\u0430\u0445 \u0432\u0435\u0434\u0443\u0449\u0435\u0433\u043E
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430 \u0443\u0436\u0435 \u043D\u0435
      \u0432\u0438\u0434\u043D\u043E. \u0422\u0440\u043E\u043F\u0430 \u0437\u0434\u0435\u0441\u044C
      \u0448\u0438\u0440\u0438\u043D\u043E\u0439 \u0432 \u0434\u0432\u0435 \u043B\u0430\u0434\u043E\u043D\u0438:
      \u0441\u043B\u0435\u0432\u0430 - \u0441\u043A\u0430\u043B\u0430, \u0441\u043F\u0440\u0430\u0432\u0430
      - \u043E\u0431\u0440\u044B\u0432 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0439
      \u0433\u043B\u0443\u0431\u0438\u043D\u044B. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u041D\u0430\u043D\u0430\u043C \u0438\u0437 \u041B\u0445\u0430\u0441\u044B
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E: <npc_speech
      lang=\"Tibetan\">\u0422\u0438\u0431\u0435\u0442 \u0437\u043D\u0430\u0435\u0442
      \u0442\u0430\u043A\u043E\u0439 \u0442\u0443\u043C\u0430\u043D - \u043A \u043F\u043E\u043B\u0443\u0434\u043D\u044E
      \u0443\u0445\u043E\u0434\u0438\u0442, \u043D\u043E \u0436\u0434\u0430\u0442\u044C
      \u043D\u0430\u0434\u043E.</npc_speech> \u041E\u0431\u043E\u0437 \u0441\u0442\u043E\u0438\u0442.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0447\u0430\u0441 \u0441\u0442\u043E\u044F\u043D\u043A\u0438
      - \u044D\u0442\u043E \u0435\u0434\u0430 \u0438 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489933
    m_Localized: "\u0418\u0434\u0442\u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      - \u0448\u0430\u0433 \u0437\u0430 \u0448\u0430\u0433\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489934
    m_Localized: "\u0427\u0435\u0442\u044B\u0440\u0435 \u0447\u0430\u0441\u0430 \u043F\u043E
      \u043A\u0430\u043C\u043D\u044F\u043C - \u043F\u043E\u0447\u0442\u0438 \u043E\u0449\u0443\u043F\u044C\u044E.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u0448\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u0430
      \u043A \u0445\u0432\u043E\u0441\u0442\u0443, \u043B\u044E\u0434\u0438 \u0434\u0435\u0440\u0436\u0430\u043B\u0438\u0441\u044C
      \u0437\u0430 \u0432\u0435\u0440\u0451\u0432\u043A\u0438. \u0412\u044B\u0448\u043B\u0438
      \u0438\u0437 \u0442\u0443\u043C\u0430\u043D\u0430 \u043A \u043F\u043E\u043B\u0443\u0434\u043D\u044E
      \u0446\u0435\u043B\u044B\u043C\u0438. \u041D\u0430\u043D\u0430\u043C \u043D\u0435
      \u0441\u043A\u0430\u0437\u0430\u043B \u043D\u0438 \u0441\u043B\u043E\u0432\u0430
      - \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0438\u0432\u043D\u0443\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489935
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C
      \u0438 \u0436\u0434\u0430\u0442\u044C \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489936
    m_Localized: "\u041F\u0435\u0440\u0435\u043D\u043E\u0447\u0435\u0432\u0430\u043B\u0438
      \u0432 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0439 \u0441\u0435\u0434\u043B\u043E\u0432\u0438\u043D\u0435.
      \u041A \u0443\u0442\u0440\u0443 \u0442\u0443\u043C\u0430\u043D \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u043E\u0440\u0435\u0434\u0435\u043B, \u0434\u043E\u0440\u043E\u0433\u0430
      \u043E\u0442\u043A\u0440\u044B\u043B\u0430\u0441\u044C. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0434\u0435\u043D\u044C, \u043D\u043E \u0441\u043F\u0443\u0441\u043A \u043F\u0440\u043E\u0448\u0451\u043B
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0438 \u0431\u0435\u0437
      \u043F\u043E\u0442\u0435\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489937
    m_Localized: "\u0418\u0434\u0442\u0438 \u0431\u044B\u0441\u0442\u0440\u043E -
      \u043F\u043E\u043A\u0430 \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435
      \u0437\u0430\u043A\u0440\u044B\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489938
    m_Localized: "\u0422\u0443\u043C\u0430\u043D \u0441\u0442\u0430\u043B \u0433\u0443\u0449\u0435
      \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441. \u0412\u0435\u0434\u0443\u0449\u0438\u0439
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434 \u0448\u0430\u0433\u043D\u0443\u043B
      \u0441 \u0442\u0440\u043E\u043F\u044B - \u0435\u0434\u0432\u0430 \u0443\u0434\u0435\u0440\u0436\u0430\u043B\u0438.
      \u041E\u0431\u043E\u0437 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
      \u0432 \u0441\u0430\u043C\u043E\u043C \u0443\u0437\u043A\u043E\u043C \u043C\u0435\u0441\u0442\u0435
      \u0438 \u0441\u0442\u043E\u044F\u043B \u0442\u0430\u043C \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430,
      \u0434\u0440\u043E\u0436\u0430 \u043E\u0442 \u0445\u043E\u043B\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489939
    m_Localized: "\u0421\u0440\u0435\u0437\u043A\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489940
    m_Localized: "\u041F\u0430\u0441\u0442\u0443\u0445-\u0442\u044E\u0440\u043A \u041A\u044E\u043B\u044C
      \u0436\u0435\u0441\u0442\u0438\u043A\u0443\u043B\u0438\u0440\u0443\u0435\u0442,
      \u0440\u0438\u0441\u0443\u0435\u0442 \u043F\u0430\u043B\u044C\u0446\u0435\u043C
      \u043F\u043E \u0437\u0435\u043C\u043B\u0435: \u0440\u043E\u0432\u043D\u044B\u0439
      \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A, \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u043B\u0438, \u0442\u0432\u0451\u0440\u0434\u0430\u044F \u043A\u043E\u0440\u043A\u0430.
      <npc_speech lang=\"Turkic\">\u0422\u0440\u0438 \u0434\u043D\u044F \u0441\u0440\u0435\u0437\u0430\u0442\u044C
      - \u0432\u0435\u0440\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u044E.</npc_speech>
      \u0411\u0435\u043B\u0430\u044F \u0440\u0430\u0432\u043D\u0438\u043D\u0430 \u0441\u0432\u0435\u0440\u043A\u0430\u0435\u0442
      \u0432 \u043C\u0430\u0440\u0435\u0432\u0435. \u041F\u043E \u043A\u0440\u0430\u044F\u043C
      \u043E\u043D\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043D\u0430\u0434\u0451\u0436\u043D\u043E,
      \u043D\u043E \u0432 \u0446\u0435\u043D\u0442\u0440\u0435 - \u0436\u0435\u043B\u0442\u043E\u0432\u0430\u0442\u044B\u0435
      \u043F\u044F\u0442\u043D\u0430, \u0433\u0434\u0435 \u043A\u043E\u0440\u043A\u0430
      \u0442\u043E\u043D\u044C\u0448\u0435. \u041A\u044E\u043B\u044C \u0443\u0445\u043C\u044B\u043B\u044F\u0435\u0442\u0441\u044F:
      \u0435\u0433\u043E \u043E\u0432\u0446\u044B \u0445\u043E\u0434\u0438\u043B\u0438.
      \u041E\u0432\u0446\u044B - \u043D\u0435 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0441 \u0442\u043E\u0432\u0430\u0440\u043E\u043C. \u0421\u0442\u0430\u0432\u043A\u0438
      \u0432\u044B\u0441\u043E\u043A\u0438: \u043F\u043E\u043B\u0434\u043D\u044F
      \u0432\u044B\u0438\u0433\u0440\u044B\u0448\u0430 \u0438\u043B\u0438 \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u043E\u0435
      \u043A\u043E\u043B\u0435\u0441\u043E \u043F\u043E\u0441\u0440\u0435\u0434\u0438
      \u043F\u043B\u043E\u0441\u043A\u043E\u0441\u0442\u0438 \u0431\u0435\u0437 \u0442\u0435\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489941
    m_Localized: "\u0420\u0438\u0441\u043A\u043D\u0443\u0442\u044C - \u043F\u043E\u0439\u0442\u0438
      \u0447\u0435\u0440\u0435\u0437 \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489942
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0435 \u0448\u0435\u0441\u0442\u044C
      \u043B\u0438 - \u043A\u043E\u0440\u043A\u0430 \u0434\u0435\u0440\u0436\u0430\u043B\u0430.
      \u041D\u0430 \u0441\u0435\u0434\u044C\u043C\u043E\u043C \u043F\u0435\u0440\u0435\u0434\u043D\u044F\u044F
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u0445\u0440\u0443\u0441\u0442\u043D\u0443\u043B\u0430
      \u0438\u043D\u0430\u0447\u0435. \u0423\u0441\u043A\u043E\u0440\u0438\u043B\u0438
      \u0448\u0430\u0433, \u043F\u0440\u043E\u0448\u043B\u0438 \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F
      \u043F\u044F\u0442\u044C \u043B\u0438 \u043F\u043E\u0447\u0442\u0438 \u0431\u0435\u0433\u043E\u043C.
      \u0412\u044B\u0448\u043B\u0438 \u0441 \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u0432\u0448\u0438\u043C\u0438\u0441\u044F
      \u043E\u0431\u043E\u0434\u044C\u044F\u043C\u0438, \u0437\u0430\u0442\u043E
      \u043D\u0430 \u0434\u0435\u043D\u044C \u0440\u0430\u043D\u044C\u0448\u0435
      \u0441\u0440\u043E\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489943
    m_Localized: "\u041E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489944
    m_Localized: "\u041A\u044E\u043B\u044C \u043F\u043E\u043A\u0430\u0447\u0430\u043B
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0438 \u0443\u0448\u0451\u043B
      \u043A \u0441\u0442\u0430\u0434\u0443. \u041E\u0431\u043E\u0437 \u043F\u043E\u0448\u0451\u043B
      \u0441\u0442\u0430\u0440\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u043E\u0439
      - \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435, \u043D\u0430\u0434\u0451\u0436\u043D\u0435\u0435.
      \u0422\u0440\u0438 \u043B\u0438\u0448\u043D\u0438\u0445 \u0434\u043D\u044F
      \u043F\u0443\u0442\u0438, \u0437\u0430\u0442\u043E \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0446\u0435\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489945
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u041A\u044E\u043B\u044F \u0432\u0435\u0441\u0442\u0438
      \u0447\u0435\u0440\u0435\u0437 \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489946
    m_Localized: "\u0417\u0430 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043A\u0430\u0439\u044E\u0430\u043D\u044C
      \u0442\u0443\u043D\u0431\u0430\u043E \u041A\u044E\u043B\u044C \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0441\u044F
      \u0432\u0435\u0441\u0442\u0438. \u041E\u043D \u0437\u043D\u0430\u043B \u043A\u0430\u0436\u0434\u0443\u044E
      \u0436\u0451\u043B\u0442\u0443\u044E \u043F\u043E\u043B\u043E\u0441\u0443 \u043D\u0430\u0438\u0437\u0443\u0441\u0442\u044C,
      \u043E\u0431\u0445\u043E\u0434\u0438\u043B \u0438\u0445 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E.
      \u041F\u0435\u0440\u0435\u0448\u043B\u0438 \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A
      \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C \u0438 \u0441 \u0437\u0430\u043F\u0430\u0441\u043E\u043C
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489947
    m_Localized: "\u041D\u0430\u043C\u043E\u043A \u043F\u0443\u0442\u043E\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489948
    m_Localized: "\u041F\u0440\u0438 \u0431\u0440\u043E\u0434\u0435 \u0447\u0435\u0440\u0435\u0437
      \u0433\u043E\u0440\u043D\u044B\u0439 \u0440\u0443\u0447\u0435\u0439 \u0432\u044C\u044E\u0447\u043D\u044B\u0439
      \u0442\u044E\u043A \u0441 \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u043C\u0438
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438
      \u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B \u0432 \u0432\u043E\u0434\u0443.
      \u041A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u0439 \u043A\u043E\u043C\u043F\u0430\u0441-\u043F\u0443\u0442\u043E\u0443
      - \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u0430\u044F \u043B\u043E\u0436\u043A\u0430
      \u043D\u0430 \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u043E\u0439 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0435
      - \u043F\u043E\u0442\u0435\u043C\u043D\u0435\u043B \u043E\u0442 \u0432\u043B\u0430\u0433\u0438
      \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0432\u044F\u043B\u043E, \u043D\u0435 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u044F
      \u043D\u0430 \u044E\u0433. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u042E\u0441\u0443\u0444 \u0434\u0435\u0440\u0436\u0438\u0442 \u0435\u0433\u043E
      \u043D\u0430\u0434 \u0443\u0433\u043B\u044F\u043C\u0438: <npc_speech lang=\"Arabic\">\u0412\u044B\u0441\u043E\u0445\u043D\u0435\u0442
      - \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442?</npc_speech>
      \u041D\u0435\u0431\u043E \u0437\u0430\u0442\u044F\u043D\u0443\u0442\u043E -
      \u043D\u0438 \u041F\u043E\u043B\u044F\u0440\u043D\u043E\u0439 \u0437\u0432\u0435\u0437\u0434\u044B,
      \u043D\u0438 \u041F\u043B\u0435\u044F\u0434. \u0414\u043E \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0433\u043E
      \u0433\u043E\u0440\u043E\u0434\u0430 \u0441 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u0449\u0438\u043A\u043E\u043C
      - \u0434\u0432\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430. \u0422\u043E\u0447\u043D\u043E\u0435
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0432\u0430\u0436\u043D\u043E:
      \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438
      \u043A\u0430\u0436\u0434\u044B\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489949
    m_Localized: "\u041E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u043F\u043E \u0441\u043E\u043B\u043D\u0446\u0443 \u0438 \u0432\u0435\u0442\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489950
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u043F\u043E\u043B\u0443\u0434\u0435\u043D\u043D\u0430\u044F
      \u0442\u0435\u043D\u044C \u043E\u0442 \u0448\u0435\u0441\u0442\u0430 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0430
      \u0437\u0430\u043F\u0430\u0434. \u042E\u0441\u0443\u0444 \u0440\u0438\u0441\u043E\u0432\u0430\u043B
      \u043C\u0435\u0442\u043A\u0438 \u043D\u0430 \u0437\u0435\u043C\u043B\u0435
      \u043A\u0430\u0436\u0434\u044B\u0435 \u043F\u043E\u043B\u0447\u0430\u0441\u0430.
      \u0414\u0432\u0430\u0436\u0434\u044B \u043E\u0448\u0438\u0431\u043B\u0438\u0441\u044C,
      \u043E\u0431\u0430 \u0440\u0430\u0437\u0430 \u043F\u043E\u043D\u044F\u043B\u0438
      \u043F\u043E \u0437\u0430\u043F\u0430\u0445\u0443 \u0433\u043E\u0440\u043D\u043E\u0439
      \u0432\u043E\u0434\u044B. \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u0432\u044B\u0448\u043B\u0438
      \u043D\u0430 \u0437\u043D\u0430\u043A\u043E\u043C\u0443\u044E \u0442\u0440\u043E\u043F\u0443
      - \u0441 \u043E\u043F\u043E\u0437\u0434\u0430\u043D\u0438\u0435\u043C, \u043D\u043E
      \u0432\u0435\u0440\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489951
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u043C\u0435\u0441\u0442\u043D\u043E\u0433\u043E
      \u0437\u043D\u0430\u0442\u043E\u043A\u0430 \u043F\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489952
    m_Localized: "\u041F\u043E\u0436\u0438\u043B\u043E\u0439 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u043F\u0430\u0441\u0442\u0443\u0445 \u0437\u0430 \u0433\u043E\u0440\u0441\u0442\u044C
      \u043C\u043E\u043D\u0435\u0442 \u0443\u043A\u0430\u0437\u0430\u043B \u043F\u0443\u0442\u044C
      \u043F\u043E \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u0430\u043C:
      \u0442\u0440\u0438 \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u0445 \u0442\u043E\u043F\u043E\u043B\u044F,
      \u043F\u043E\u0442\u043E\u043C \u0447\u0451\u0440\u043D\u0430\u044F \u0441\u043A\u0430\u043B\u0430,
      \u043F\u043E\u0442\u043E\u043C \u0432\u043D\u0438\u0437. \u041A\u0430\u0436\u0434\u044B\u0439
      \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440 \u0441\u0442\u043E\u044F\u043B
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435. \u041F\u0443\u0442\u043E\u0443
      \u0434\u043E\u0441\u043E\u0445 \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443
      \u0443\u0442\u0440\u0443 \u0438 \u0441\u043D\u043E\u0432\u0430 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489953
    m_Localized: "\u041F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C \u043F\u043E\u043B\u0434\u043D\u044F
      \u043D\u0430 \u043F\u0440\u043E\u0441\u0443\u0448\u043A\u0443 \u043A\u043E\u043C\u043F\u0430\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489954
    m_Localized: "\u042E\u0441\u0443\u0444 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043B
      \u043F\u0443\u0442\u043E\u0443, \u043F\u0440\u043E\u0442\u0451\u0440 \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u0443\u044E
      \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0443 \u0441\u0443\u0445\u043E\u0439
      \u043A\u043E\u0448\u043C\u043E\u0439 \u0438 \u0432\u044B\u043B\u043E\u0436\u0438\u043B
      \u043D\u0430 \u043F\u043B\u043E\u0441\u043A\u0438\u0439 \u043A\u0430\u043C\u0435\u043D\u044C
      \u043F\u043E\u0434 \u0441\u043E\u043B\u043D\u0446\u0435\u043C. \u041A \u043F\u043E\u043B\u0443\u0434\u043D\u044E
      \u0441\u0442\u0440\u0435\u043B\u043A\u0430 \u0441\u043D\u043E\u0432\u0430 \u0441\u043B\u0430\u0431\u043E,
      \u043D\u043E \u0432\u0435\u0440\u043D\u043E \u043F\u043E\u0442\u044F\u043D\u0443\u043B\u0430\u0441\u044C
      \u043A \u044E\u0433\u0443. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043F\u043E\u043B\u0434\u043D\u044F, \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489955
    m_Localized: "\u0414\u0440\u0435\u0432\u043D\u0438\u0439 \u043F\u0443\u0442\u0435\u0432\u043E\u0439
      \u0441\u0442\u043E\u043B\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489956
    m_Localized: "\u0421\u0442\u043E\u043B\u0431 \u0432\u044B\u0441\u043E\u0442\u043E\u0439
      \u043F\u043E \u0433\u0440\u0443\u0434\u044C, \u043E\u0431\u0442\u0451\u0441\u0430\u043D\u043D\u044B\u0439
      \u0438\u0437 \u0441\u0435\u0440\u043E\u0433\u043E \u0431\u0430\u0437\u0430\u043B\u044C\u0442\u0430.
      \u041D\u0430\u0434\u043F\u0438\u0441\u044C \u0432 \u0442\u0440\u0438 \u0441\u0442\u0440\u043E\u043A\u0438
      - \u0448\u0440\u0438\u0444\u0442 \u043F\u043E\u0445\u043E\u0436 \u043D\u0430
      \u0441\u0440\u0435\u0434\u043D\u0435\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439,
      \u043D\u043E \u0447\u0430\u0441\u0442\u044C \u0437\u043D\u0430\u043A\u043E\u0432
      \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0430. \u041E\u0434\u043D\u0430
      \u0446\u0438\u0444\u0440\u0430 \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u044F\u0441\u043D\u043E. \u0412\u043D\u0438\u0437\u0443 \u043F\u0440\u043E\u0446\u0430\u0440\u0430\u043F\u0430\u043D
      \u0440\u0438\u0441\u0443\u043D\u043E\u043A: \u0433\u043E\u0440\u0430, \u0438\u0437\u043E\u0433\u043D\u0443\u0442\u0430\u044F
      \u043B\u0438\u043D\u0438\u044F \u0440\u0435\u043A\u0438, \u043A\u0440\u0435\u0441\u0442\u0438\u043A.
      \u0417\u043D\u0430\u043A \u0434\u043E\u0440\u043E\u0433\u0438? \u041F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435?
      \u0421\u0442\u043E\u043B\u0431 \u0441\u0442\u043E\u0438\u0442 \u0442\u0430\u043C,
      \u0433\u0434\u0435 \u0442\u0440\u043E\u043F\u0430 \u0440\u0430\u0437\u0434\u0432\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0420\u0443\u0441\u0442\u0430\u043C
      \u0445\u043C\u0443\u0440\u0438\u0442\u0441\u044F: <npc_speech lang=\"Persian\">\u0412
      \u0421\u043E\u0433\u0434\u0438\u0430\u043D\u0435 \u0442\u0430\u043A\u0438\u0435
      \u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0421\u0430\u0441\u0430\u043D\u0438\u0434\u044B
      - \u0442\u0440\u0438\u0441\u0442\u0430 \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434.</npc_speech>
      \u0423 \u043A\u0430\u043C\u043D\u044F - \u0441\u043B\u043E\u0439 \u043C\u043E\u043D\u0435\u0442,
      \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0445 \u0440\u0438\u0442\u0443\u0430\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489957
    m_Localized: "\u041F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0432\u0440\u0435\u043C\u044F
      \u043D\u0430 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489958
    m_Localized: "\u0420\u0443\u0441\u0442\u0430\u043C \u0438 \u0441\u0442\u0430\u0440\u0448\u0438\u0439
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0447\u0430\u0441 \u0441\u043F\u043E\u0440\u0438\u043B\u0438
      \u043D\u0430\u0434 \u043A\u0430\u043C\u043D\u0435\u043C, \u0441\u0432\u0435\u0440\u044F\u044F\u0441\u044C
      \u0441\u043E \u0441\u0432\u0438\u0442\u043A\u043E\u043C \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445
      \u0437\u043D\u0430\u043A\u043E\u0432. \u041F\u0440\u043E\u0447\u043B\u0438:
      \u0432\u043E\u0434\u0430 - \u0432\u043E\u0441\u0435\u043C\u044C \u0444\u0430\u0440\u0441\u0430\u0445\u043E\u0432
      \u0432\u043F\u0440\u0430\u0432\u043E. \u041A\u0440\u044E\u043A \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439.
      \u0412\u043E\u0434\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489959
    m_Localized: "\u0417\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u0442\u044C \u043D\u0430\u0434\u043F\u0438\u0441\u044C
      \u0438 \u0438\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489960
    m_Localized: "\u041F\u0438\u0441\u0430\u0440\u044C \u0441\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u043B
      \u0437\u043D\u0430\u043A\u0438 \u043D\u0430 \u0431\u0435\u0440\u0435\u0441\u0442\u0443.
      \u0412 \u0425\u043E\u0442\u0430\u043D\u0435 \u0433\u0440\u0430\u043C\u043E\u0442\u043D\u044B\u0439
      \u043C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0439 \u043C\u043E\u043D\u0430\u0445
      \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043B \u043D\u0430\u0434\u043F\u0438\u0441\u044C
      \u0437\u0430 \u0447\u0430\u0448\u043A\u0443 \u0447\u0430\u044F: \u0441\u0442\u043E\u043B\u0431
      \u043E\u0442\u043C\u0435\u0447\u0430\u043B \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0443\u044E
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0432 \u043E\u0431\u0445\u043E\u0434
      \u0431\u043E\u043B\u043E\u0442\u0430. \u041E\u043D\u0438 \u0432\u044B\u0431\u0440\u0430\u043B\u0438
      \u0432\u0435\u0440\u043D\u043E \u0438 \u043D\u0435 \u0437\u043D\u0430\u043B\u0438
      \u043E\u0431 \u044D\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489961
    m_Localized: "\u041D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      - \u0438\u0434\u0442\u0438 \u0438\u043D\u0441\u0442\u0438\u043D\u043A\u0442\u0438\u0432\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489962
    m_Localized: "\u0423\u0448\u043B\u0438 \u0431\u044B\u0441\u0442\u0440\u043E.
      \u0412\u044B\u0431\u0440\u0430\u043B\u0438 \u043B\u0435\u0432\u0443\u044E \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0443
      \u043D\u0430\u0443\u0433\u0430\u0434. \u0427\u0435\u0440\u0435\u0437 \u043B\u0438
      \u0442\u0440\u043E\u043F\u0430 \u0441\u0442\u0430\u043B\u0430 \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u0435\u0435
      \u0438 \u043A\u0440\u0443\u0447\u0435. \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0430\u044F
      \u043B\u0438 \u044D\u0442\u043E \u0434\u043E\u0440\u043E\u0433\u0430 - \u0442\u0430\u043A
      \u0438 \u043D\u0435 \u0443\u0437\u043D\u0430\u043B\u0438; \u0432\u044B\u0448\u043B\u0438
      \u043A\u0443\u0434\u0430 \u043D\u0443\u0436\u043D\u043E, \u043D\u043E \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B\u0438
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0441\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489963
    m_Localized: "\u0422\u0430\u0439\u043D\u0438\u043A \u0443 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489964
    m_Localized: "\u041F\u043E\u043B\u0443\u0437\u0430\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0439
      \u0443\u0433\u043E\u043B \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u044F:
      \u043A\u0438\u0440\u043F\u0438\u0447 \u043E\u0441\u044B\u043F\u0430\u043B\u0441\u044F,
      \u0438 \u043F\u043E\u0434 \u043D\u0438\u043C - \u0433\u043E\u0440\u043B\u043E\u0432\u0438\u043D\u0430
      \u0433\u043B\u0438\u043D\u044F\u043D\u043E\u0433\u043E \u043A\u0443\u0432\u0448\u0438\u043D\u0430,
      \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u043D\u043E\u0433\u043E
      \u043A\u0440\u0430\u0441\u043D\u043E\u0439 \u0441\u043C\u043E\u043B\u043E\u0439.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0411\u0443\u0433\u0430 \u043A\u043E\u0432\u044B\u0440\u044F\u0435\u0442
      \u0441\u043C\u043E\u043B\u0443 \u043D\u043E\u0436\u043E\u043C: \u0432\u043D\u0443\u0442\u0440\u0438
      \u043C\u043E\u043D\u0435\u0442\u044B, \u043C\u043E\u0442\u043E\u043A \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u043E\u0439
      \u043F\u0440\u043E\u0432\u043E\u043B\u043E\u043A\u0438 \u0438 \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A. \u041C\u043E\u043D\u0435\u0442\u044B
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432\u044B\u0435, \u0441 \u043F\u043E\u0440\u0442\u0440\u0435\u0442\u043E\u043C
      \u0410\u0431\u0431\u0430\u0441\u0438\u0434\u0430, \u043D\u043E \u043A\u0443\u0432\u0448\u0438\u043D
      \u0437\u0430\u0440\u044B\u0442 \u0434\u0430\u0432\u043D\u043E - \u0441\u0432\u0435\u0440\u0445\u0443
      \u043D\u0430\u0440\u043E\u0441 \u0431\u0443\u0440\u044C\u044F\u043D. \u041A\u0442\u043E-\u0442\u043E
      \u0436\u0434\u0430\u043B \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F,
      \u043D\u043E \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F.
      \u041C\u0435\u0441\u0442\u043E \u0431\u0435\u0437\u043B\u044E\u0434\u043D\u043E\u0435
      - \u043D\u0438\u043A\u043E\u0433\u043E, \u043A\u0442\u043E \u043C\u043E\u0433
      \u0431\u044B \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489965
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0432\u0441\u0451 \u0438\u0437
      \u0442\u0430\u0439\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489966
    m_Localized: "\u0421\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u0430\u044F \u043F\u0440\u043E\u0432\u043E\u043B\u043E\u043A\u0430
      \u0438 \u043C\u043E\u043D\u0435\u0442\u044B \u043F\u0435\u0440\u0435\u0448\u043B\u0438
      \u0432 \u0441\u0443\u043C\u043A\u0443. \u041D\u0438\u043A\u0442\u043E \u043D\u0435
      \u0432\u0438\u0434\u0435\u043B. \u041D\u043E \u0443 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0433\u043E\u0440\u043E\u0434\u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0441 \u0442\u0430\u0442\u0443\u0438\u0440\u043E\u0432\u043A\u043E\u0439 \u0440\u043E\u0434\u0430
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u043D\u0430 \u0441\u0435\u0440\u0435\u0431\u0440\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043F\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E. \u0427\u0443\u0436\u043E\u0435
      \u0434\u043E\u0431\u0440\u043E \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0441\u043B\u0435\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489967
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0447\u0430\u0441\u0442\u044C -
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0437\u043D\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489968
    m_Localized: "\u0412\u0437\u044F\u043B\u0438 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u043C\u043E\u043D\u0435\u0442, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u0432\u0435\u0440\u043D\u0443\u043B\u0438 \u0432 \u043A\u0443\u0432\u0448\u0438\u043D
      \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u043D\u0430
      \u0432\u0438\u0434\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E. \u0412
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u0433\u043E\u0440\u043E\u0434\u0435
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438 \u043A\u0443\u043F\u0446\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B
      \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C: \u043E\u043D \u0434\u0430\u0432\u043D\u043E
      \u0438\u0441\u043A\u0430\u043B \u044D\u0442\u043E\u0442 \u0442\u0430\u0439\u043D\u0438\u043A.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0447\u0435\u0441\u0442\u043D\u043E\u0433\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0441\u0442\u043E\u0438\u0442
      \u0434\u043E\u0440\u043E\u0436\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489969
    m_Localized: "\u041D\u0435 \u0442\u0440\u043E\u0433\u0430\u0442\u044C - \u0447\u0443\u0436\u043E\u0435
      \u0434\u043E\u0431\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489970
    m_Localized: "\u041F\u0440\u043E\u0448\u043B\u0438 \u043C\u0438\u043C\u043E.
      \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u0433\u043E\u0440\u043E\u0434\u0435
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0438 \u043E \u0442\u0430\u0439\u043D\u0438\u043A\u0435
      \u0443 \u0440\u0430\u0437\u0432\u0430\u043B\u0438\u043D. \u041C\u0435\u0441\u0442\u043D\u044B\u0439
      \u043A\u0443\u043F\u0435\u0446 \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B
      \u0441 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C\u044E
      \u0438 \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u043F\u0440\u0438\u043D\u0451\u0441
      \u043A\u043E\u0440\u0437\u0438\u043D\u0443 \u0444\u0438\u043D\u0438\u043A\u043E\u0432
      - \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0436\u0435\u0441\u0442
      \u043F\u0440\u0438\u0437\u043D\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043F\u043E\u043D\u044F\u043B \u0447\u0442\u043E \u0435\u043C\u0443 \u0432\u0435\u0440\u043D\u0443\u043B\u0438
      \u043D\u0430\u0434\u0435\u0436\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489971
    m_Localized: "\u0417\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u0438\u0435
      \u0440\u0443\u0438\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489972
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0433\u043E\u0440\u0435\u043B\u043E\u0439
      \u0441\u043C\u043E\u043B\u044B, \u0437\u0430\u0441\u0442\u0430\u0440\u0435\u043B\u044B\u0439
      - \u043E\u0433\u043E\u043D\u044C \u0437\u0434\u0435\u0441\u044C \u0436\u0433\u043B\u0438
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0440\u0430\u0437,
      \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u043F\u0440\u0438
      \u0421\u0430\u0441\u0430\u043D\u0438\u0434\u0430\u0445. \u0422\u0440\u0438
      \u0441\u0442\u0435\u043D\u044B \u0441\u0442\u043E\u044F\u0442, \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u0430\u044F
      \u043E\u0431\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044C \u0432\u043D\u0443\u0442\u0440\u044C.
      \u0412 \u043D\u0438\u0448\u0435 \u043D\u0430\u0434 \u0430\u043B\u0442\u0430\u0440\u0451\u043C
      - \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u0430\u044F \u0447\u0430\u0448\u0430,
      \u0437\u0435\u043B\u0435\u043D\u043E\u0432\u0430\u0442\u0430\u044F \u043E\u0442
      \u043F\u0430\u0442\u0438\u043D\u044B, \u0438 \u043A\u0443\u0441\u043E\u0447\u043A\u0438
      \u0437\u0430\u0441\u043E\u0445\u0448\u0435\u0433\u043E \u0441\u0430\u043D\u0434\u0430\u043B\u0430
      \u0432 \u043F\u0435\u043F\u043B\u0435. \u041D\u0430 \u043F\u043B\u0438\u0442\u0435
      \u043F\u043E\u043B\u0430 - \u0440\u0435\u043B\u044C\u0435\u0444 \u0410\u0445\u0443\u0440\u0430-\u041C\u0430\u0437\u0434\u044B
      \u0441 \u043A\u0440\u044B\u043B\u044C\u044F\u043C\u0438, \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
      \u0441\u0431\u0438\u0442\u044B\u0439. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0420\u0443\u0441\u0442\u0430\u043C \u0441\u043D\u0438\u043C\u0430\u0435\u0442
      \u0448\u0430\u043F\u043A\u0443: \u044D\u0442\u043E \u0431\u044B\u043B \u0430\u0442\u0435\u0448\u043A\u0430\u0434\u0435
      - \u0445\u0440\u0430\u043C \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u043E\u0433\u043E
      \u043E\u0433\u043D\u044F. \u0411\u0440\u0430\u0442\u044C \u0447\u0442\u043E-\u0442\u043E
      \u043E\u0442\u0441\u044E\u0434\u0430 - \u0434\u043B\u044F \u0437\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0446\u0435\u0432
      \u043E\u0441\u043A\u043E\u0440\u0431\u043B\u0435\u043D\u0438\u0435, \u0437\u0430
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043F\u043E\u043C\u043D\u044F\u0442
      \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489973
    m_Localized: "\u0422\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043E\u0431\u044B\u0441\u043A\u0430\u0442\u044C
      \u0445\u0440\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489974
    m_Localized: "\u0417\u0430 \u043E\u0431\u0432\u0430\u043B\u0438\u0432\u0448\u0435\u0439\u0441\u044F
      \u043F\u043B\u0438\u0442\u043E\u0439 \u043D\u0430\u0448\u043B\u0438 \u043C\u0435\u0434\u043D\u0443\u044E
      \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0443 \u0441 \u0440\u0438\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u043C\u0438
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u043C\u0438 \u0438 \u0441\u0442\u0430\u0440\u043E\u0439
      \u043C\u043E\u043D\u0435\u0442\u043E\u0439 \u0421\u0430\u0441\u0430\u043D\u0438\u0434\u043E\u0432.
      \u0426\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u0435\u0441\u0442\u044C.
      \u041D\u043E \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435 \u043D\u0430 \u043E\u0431\u043E\u0437
      \u043A\u043E\u0441\u0438\u043B\u0438\u0441\u044C \u0442\u0440\u043E\u0435 \u043A\u0443\u043F\u0446\u043E\u0432
      \u0441 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u044B\u043C\u0438
      \u0431\u0435\u043B\u044B\u043C\u0438 \u043E\u0434\u0435\u0436\u0434\u0430\u043C\u0438.
      \u0421\u043B\u0443\u0445\u0438 \u0445\u043E\u0434\u044F\u0442 \u0431\u044B\u0441\u0442\u0440\u043E
      \u043F\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C\u0443 \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489975
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043E\u0434\u0438\u043D \u043F\u0440\u0435\u0434\u043C\u0435\u0442
      - \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489976
    m_Localized: "\u0411\u0440\u043E\u043D\u0437\u043E\u0432\u0443\u044E \u0447\u0430\u0448\u0443
      \u0432\u0437\u044F\u043B\u0438 \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C
      \u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438 \u043F\u043E\u0447\u0442\u0435\u043D\u0438\u044F.
      \u0412 \u0433\u043E\u0440\u043E\u0434\u0435 \u0435\u0451 \u043F\u0440\u043E\u0434\u0430\u043B\u0438
      \u043C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u043E\u043C\u0443 \u043C\u043E\u043D\u0430\u0445\u0443,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0437\u043D\u0430\u043B \u0435\u0451
      \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
      \u0438 \u043E\u0442\u043D\u0451\u0441\u0441\u044F \u0441 \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435\u043C.
      \u0417\u0430\u043F\u0430\u0445 \u0441\u0430\u043D\u0434\u0430\u043B\u0430 \u0435\u0449\u0451
      \u0434\u043E\u043B\u0433\u043E \u0434\u0435\u0440\u0436\u0430\u043B\u0441\u044F
      \u043D\u0430 \u0440\u0443\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489977
    m_Localized: "\u0423\u0439\u0442\u0438 \u0441 \u043F\u043E\u0447\u0442\u0435\u043D\u0438\u0435\u043C
      - \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489978
    m_Localized: "\u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B \u043C\u0438\u043C\u043E.
      \u0420\u0443\u0441\u0442\u0430\u043C \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u0443 \u0432\u0445\u043E\u0434\u0430 \u043A\u0430\u043C\u0435\u0448\u0435\u043A
      - \u0437\u043D\u0430\u043A \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F
      \u043F\u043E \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C\u0443
      \u043E\u0431\u044B\u0447\u0430\u044E. \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435 \u0437\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u0438\u0439
      \u043A\u0443\u043F\u0435\u0446 \u0411\u0430\u0445\u0440\u0430\u043C \u0441\u043A\u0430\u0437\u0430\u043B:
      \u0437\u043D\u0430\u044E \u044D\u0442\u043E\u0442 \u0445\u0440\u0430\u043C.
      \u0418 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u043D\u0435\u043F\u043B\u043E\u0445\u0443\u044E
      \u0446\u0435\u043D\u0443 \u043D\u0430 \u0441\u043F\u0435\u0446\u0438\u0438
      - \u043B\u044E\u0434\u0438 \u0437\u0430\u043C\u0435\u0447\u0430\u044E\u0442,
      \u043A\u0442\u043E \u0431\u0435\u0440\u0435\u0436\u0451\u0442 \u0441\u0442\u0430\u0440\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489979
    m_Localized: "\u041D\u0430\u0434\u043F\u0438\u0441\u044C \u043D\u0430 \u043A\u0430\u043C\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489980
    m_Localized: "\u041F\u043B\u043E\u0441\u043A\u0438\u0439 \u043A\u0430\u043C\u0435\u043D\u044C
      \u0443 \u0442\u0440\u043E\u043F\u044B - \u043D\u0435 \u0441\u0442\u043E\u043B\u0431,
      \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u0430\u043B\u0443\u043D, \u043D\u043E
      \u043A\u0442\u043E-\u0442\u043E \u0441\u0442\u0430\u0440\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0432\u044B\u0431\u0438\u043B \u043D\u0430 \u043D\u0451\u043C \u0434\u0432\u0435
      \u0441\u0442\u0440\u043E\u043A\u0438 \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u0430\u043C\u0438.
      \u0428\u0440\u0438\u0444\u0442 \u0441\u0440\u0435\u0434\u043D\u0435\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439,
      \u043F\u0435\u0445\u043B\u0435\u0432\u0438\u0439\u0441\u043A\u0438\u0439, \u044F\u0432\u043D\u043E
      \u0441\u0442\u0430\u0440\u044B\u0439: \u0431\u0443\u043A\u0432\u044B \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0435,
      \u0443\u0436\u0435 \u0437\u0430\u0440\u043E\u0441\u0448\u0438\u0435 \u043C\u0445\u043E\u043C
      \u043F\u043E \u043A\u0440\u0430\u044F\u043C. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0420\u0443\u0441\u0442\u0430\u043C \u0447\u0438\u0442\u0430\u0435\u0442 \u043F\u043E-\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438,
      \u043D\u043E \u044D\u0442\u043E\u0442 \u0434\u0438\u0430\u043B\u0435\u043A\u0442
      - \u043D\u0435 \u0435\u0433\u043E; \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u0442
      \u0447\u0435\u0440\u0435\u0437 \u0441\u043B\u043E\u0432\u043E. \u0421\u043B\u043E\u0432\u043E
      \xAB\u0432\u043E\u0434\u0430\xBB \u043E\u043D \u0443\u0437\u043D\u0430\u0451\u0442
      \u0442\u043E\u0447\u043D\u043E. \u0421\u043B\u043E\u0432\u043E \xAB\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C\xBB
      - \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E. \u0418\u043B\u0438 \xAB\u0432\u043E\u0441\u0442\u043E\u043A\xBB?
      \u0421\u0442\u0440\u0435\u043B\u043A\u0430 \u0432\u044B\u0440\u0435\u0437\u0430\u043D\u0430
      \u0447\u0443\u0442\u044C \u043D\u0438\u0436\u0435, \u043D\u043E \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0433\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489981
    m_Localized: "\u041F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0432\u0440\u0435\u043C\u044F
      \u043D\u0430 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489982
    m_Localized: "\u0420\u0443\u0441\u0442\u0430\u043C \u0438 \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u043F\u0440\u043E\u0432\u0435\u043B\u0438 \u0447\u0430\u0441 \u043D\u0430\u0434
      \u043D\u0430\u0434\u043F\u0438\u0441\u044C\u044E, \u0441\u0432\u0435\u0440\u044F\u044F\u0441\u044C
      \u0441 \u043A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u0438\u043C \u0441\u043F\u0440\u0430\u0432\u043E\u0447\u043D\u0438\u043A\u043E\u043C
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445 \u0437\u043D\u0430\u043A\u043E\u0432.
      \u0418\u0442\u043E\u0433: \u0432\u043E\u0434\u0430 \u0432 \u0434\u0432\u0443\u0445
      \u0444\u0430\u0440\u0441\u0430\u0445\u0430\u0445 \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A,
      \u0443 \u0442\u0440\u0451\u0445 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0445
      \u0441\u043E\u0441\u0435\u043D. \u0421\u044A\u0435\u043B\u0438 \u0432\u0440\u0435\u043C\u044F,
      \u043D\u043E \u043A\u043E\u043B\u043E\u0434\u0435\u0446 \u043D\u0430\u0448\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489983
    m_Localized: "\u0421\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0442\u043E\u043B\u043A\u043E\u0432\u0430\u0442\u0435\u043B\u044F
      \u0432 \u0433\u043E\u0440\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489984
    m_Localized: "\u0412 \u0433\u043E\u0440\u043E\u0434\u0435 \u043C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0439
      \u043C\u043E\u043D\u0430\u0445 \u0437\u0430 \u043F\u0440\u0438\u0433\u043E\u0440\u0448\u043D\u044E
      \u043C\u043E\u043D\u0435\u0442 \u043F\u0440\u043E\u0447\u0451\u043B \u043D\u0430\u0434\u043F\u0438\u0441\u044C
      \u0437\u0430 \u043C\u0438\u043D\u0443\u0442\u0443: \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      \u043E \u043D\u0435\u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043C\u043E\u043C
      \u0443\u0447\u0430\u0441\u0442\u043A\u0435 \u0433\u043E\u0440\u043D\u043E\u0433\u043E
      \u0441\u043A\u043B\u043E\u043D\u0430. \u041E\u0431\u043E\u0437 \u0441\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043B
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442. \u0422\u043E\u043B\u043A\u043E\u0432\u0430\u0442\u0435\u043B\u044C
      \u0434\u043E\u0431\u0430\u0432\u0438\u043B: \u044D\u0442\u0443 \u043D\u0430\u0434\u043F\u0438\u0441\u044C
      \u0441\u0434\u0435\u043B\u0430\u043B\u0438 \u043A\u0443\u043F\u0446\u044B \u0440\u043E\u0434\u0430
      \u0411\u0430\u0445\u0440\u0430\u043C\u043E\u0432 \u043B\u0435\u0442 \u0434\u0432\u0435\u0441\u0442\u0438
      \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489985
    m_Localized: "\u0418\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435 -
      \u043D\u0435\u043A\u043E\u0433\u0434\u0430 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489986
    m_Localized: "\u041F\u0440\u043E\u0448\u043B\u0438 \u043C\u0438\u043C\u043E.
      \u0427\u0435\u0440\u0435\u0437 \u043B\u0438 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0441\u0442\u0430\u043B\u0430 \u043A\u0440\u0443\u0442\u043E \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F
      - \u0447\u0442\u043E-\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u043D\u0435
      \u0442\u0430\u043A. \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043D\u0430\u0434\u043F\u0438\u0441\u044C
      \u0438\u043C\u0435\u043D\u043D\u043E \u043E\u0431 \u044D\u0442\u043E\u043C
      \u0438 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u043B\u0430.
      \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0434\u0440\u0430\u043B\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439
      \u0441\u043A\u043B\u043E\u043D \u0441 \u0442\u0440\u0443\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489987
    m_Localized: "\u041F\u043E\u0433\u0438\u0431\u0448\u0438\u0439 \u043E\u0431\u043E\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489988
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u043D\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0441\u044F
      - \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u0430\u0432\u043D\u043E.
      \u0422\u0440\u0438 \u043E\u0441\u0442\u043E\u0432\u0430 \u043F\u043E\u0432\u043E\u0437\u043E\u043A,
      \u043F\u043E\u0431\u0435\u043B\u0435\u0432\u0448\u0438\u0435 \u043F\u043E\u0434
      \u0441\u043E\u043B\u043D\u0446\u0435\u043C \u043A\u043E\u0441\u0442\u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432,
      \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u0432\u0448\u0438\u0435\u0441\u044F
      \u0442\u044E\u043A\u0438. \u041A\u043E\u0435-\u0433\u0434\u0435 - \u043C\u043E\u043D\u0435\u0442\u044B,
      \u0432\u0442\u043E\u043F\u0442\u0430\u043D\u043D\u044B\u0435 \u0432 \u043F\u044B\u043B\u044C,
      \u043E\u0431\u043B\u043E\u043C\u043E\u043A \u043A\u0440\u0438\u0432\u043E\u0433\u043E
      \u043C\u0435\u0447\u0430. \u041E\u0434\u0438\u043D \u0438\u0437 \u0432\u044C\u044E\u0447\u043D\u044B\u0445
      \u044F\u0449\u0438\u043A\u043E\u0432 \u043F\u043E\u0434 \u043E\u043F\u0440\u043E\u043A\u0438\u043D\u0443\u0442\u043E\u0439
      \u043F\u043E\u0432\u043E\u0437\u043A\u043E\u0439 \u043F\u043E\u0447\u0442\u0438
      \u0446\u0435\u043B. \u0421\u043B\u0435\u0434\u043E\u0432 \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u044F
      \u043D\u0435\u0442 - \u0438\u043B\u0438 \u0438\u0445 \u0443\u0436\u0435 \u043D\u0435
      \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C. \u0416\u0430\u0440\u0430?
      \u0416\u0430\u0436\u0434\u0430? \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438?
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0411\u0443\u0433\u0430 \u0441\u043D\u0438\u043C\u0430\u0435\u0442
      \u0448\u0430\u043F\u043A\u0443: \u043A\u0442\u043E \u0431\u044B \u044D\u0442\u043E
      \u043D\u0438 \u0431\u044B\u043B, \u043E\u043D\u0438 \u0448\u043B\u0438 \u0442\u0435\u043C
      \u0436\u0435 \u043F\u0443\u0442\u0451\u043C. \u0413\u0440\u0443\u0437 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
      \u043C\u043E\u0436\u043D\u043E \u0432\u0437\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489989
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0432\u0435\u0441\u044C \u0443\u0446\u0435\u043B\u0435\u0432\u0448\u0438\u0439
      \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489990
    m_Localized: "\u0412 \u044F\u0449\u0438\u043A\u0435 \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u043A\u0443\u0441\u043A\u0438 \u0448\u0451\u043B\u043A\u0430-\u0441\u044B\u0440\u0446\u0430
      \u0438 \u0444\u0430\u0440\u0444\u043E\u0440\u043E\u0432\u044B\u0435 \u0447\u0430\u0448\u043A\u0438,
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u0443\u0446\u0435\u043B\u0435\u043B\u0430. \u0412 \u0433\u043E\u0440\u043E\u0434\u0435
      \u043F\u0440\u043E\u0434\u0430\u043B\u0438 \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432. \u041D\u043E \u0420\u0443\u0441\u0442\u0430\u043C
      \u0434\u043E\u043B\u0433\u043E \u043C\u043E\u043B\u0447\u0430\u043B \u043F\u043E\u0441\u043B\u0435
      - \u043E\u043D \u0443\u0437\u043D\u0430\u043B \u043C\u0435\u0442\u043A\u0438
      \u0440\u043E\u0434\u0430 \u0421\u0430\u043C\u0435\u0445\u043E\u0432 \u043D\u0430
      \u0442\u044E\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489991
    m_Localized: "\u041F\u043E\u0445\u043E\u0440\u043E\u043D\u0438\u0442\u044C \u043E\u0441\u0442\u0430\u043D\u043A\u0438
      \u043F\u043E \u043E\u0431\u044B\u0447\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489992
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u043B\u0438 \u0434\u0432\u0430 \u0447\u0430\u0441\u0430
      \u0437\u0430 \u0440\u0430\u0431\u043E\u0442\u043E\u0439 - \u0441\u043E\u0431\u0440\u0430\u043B\u0438
      \u043A\u043E\u0441\u0442\u0438, \u043D\u0430\u0441\u044B\u043F\u0430\u043B\u0438
      \u0445\u043E\u043B\u043C, \u0420\u0443\u0441\u0442\u0430\u043C \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043B
      \u043C\u043E\u043B\u0438\u0442\u0432\u0443. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0432\u0440\u0435\u043C\u044F \u0438 \u0435\u0434\u0443. \u041D\u043E \u0432
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u0433\u043E\u0440\u043E\u0434\u0435
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438 \u043A\u0443\u043F\u0446\u0430
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0430: \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
      \u043E\u043D \u0438\u0441\u043A\u0430\u043B \u0441\u043B\u0435\u0434\u044B
      \u044D\u0442\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0442. \u0417\u0430\u043F\u043B\u0430\u0442\u0438\u043B
      \u0437\u0430 \u0434\u043E\u0431\u0440\u0443\u044E \u0432\u0435\u0441\u0442\u044C
      \u0449\u0435\u0434\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489993
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C - \u043F\u043E\u043D\u044F\u0442\u044C
      \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489994
    m_Localized: "\u0411\u0443\u0433\u0430 \u043D\u0430\u0448\u0451\u043B \u0441\u0442\u0440\u0435\u043B\u0443
      \u0441 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u043C \u043E\u043F\u0435\u0440\u0435\u043D\u0438\u0435\u043C,
      \u0432\u0431\u0438\u0442\u0443\u044E \u0432 \u0431\u043E\u0440\u0442 \u043F\u043E\u0432\u043E\u0437\u043A\u0438.
      \u0417\u043D\u0430\u0447\u0438\u0442, \u043D\u0430\u043B\u0451\u0442 - \u0438
      \u0434\u0430\u0432\u043D\u0438\u0439. \u042D\u0442\u0438 \u043F\u043B\u0435\u043C\u0435\u043D\u0430
      \u0443\u0436\u0435 \u043E\u0442\u043A\u043E\u0447\u0435\u0432\u0430\u043B\u0438.
      \u041E\u0431\u043E\u0437 \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0432\u0430\u0436\u043D\u043E\u0435
      \u0437\u043D\u0430\u043D\u0438\u0435: \u0437\u0434\u0435\u0441\u044C \u043E\u043F\u0430\u0441\u043D\u043E
      \u043D\u0435 \u0438\u0437-\u0437\u0430 \u043F\u0440\u0438\u0440\u043E\u0434\u044B,
      \u0430 \u0438\u0437-\u0437\u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430.
      \u0421\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043B\u0438
      \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0439 \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489995
    m_Localized: "\u0421\u043A\u0440\u044B\u0442\u044B\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489996
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0432\u043B\u0430\u0436\u043D\u043E\u0433\u043E
      \u043C\u0445\u0430 \u0437\u0430 \u0433\u043E\u0440\u044F\u0447\u0438\u043C
      \u0432\u043E\u0437\u0434\u0443\u0445\u043E\u043C \u043F\u0443\u0441\u0442\u044B\u043D\u0438
      - \u043D\u0435\u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043C\u044B\u0439,
      \u0442\u043E\u0447\u043D\u044B\u0439. \u0421\u0442\u0430\u0440\u0430\u044F
      \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C \u0443 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430
      \u0424\u0430\u0440\u0440\u0443\u0445\u0430 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043B\u0430
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0437\u0430 \u0433\u0440\u0430\u043D\u0438\u0442\u043D\u044B\u043C
      \u0432\u044B\u0441\u0442\u0443\u043F\u043E\u043C \u043A \u0441\u0435\u0432\u0435\u0440\u0443
      \u043E\u0442 \u0441\u0443\u0445\u043E\u0433\u043E \u0440\u0443\u0441\u043B\u0430.
      \u0412\u043E\u0442 \u0438 \u0433\u0440\u0430\u043D\u0438\u0442, \u0432\u043E\u0442
      \u0438 \u0440\u0443\u0441\u043B\u043E. \u0417\u0430 \u0432\u044B\u0441\u0442\u0443\u043F\u043E\u043C
      - \u0443\u0437\u043A\u0430\u044F \u0449\u0435\u043B\u044C, \u0430 \u0438\u0437
      \u043D\u0435\u0451 \u0432\u044B\u0442\u0435\u043A\u0430\u0435\u0442 \u0442\u043E\u043D\u043A\u0430\u044F
      \u0441\u0442\u0440\u0443\u0439\u043A\u0430: \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F,
      \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u0430\u044F, \u0431\u0435\u0437
      \u0437\u0430\u043F\u0430\u0445\u0430 \u0441\u043E\u043B\u0438. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043F\u043E\u0447\u0443\u044F\u043B\u0438 \u0440\u0430\u043D\u044C\u0448\u0435
      \u043B\u044E\u0434\u0435\u0439. \u041C\u0435\u0441\u0442\u043E \u0441\u043A\u0440\u044B\u0442\u043E
      \u0442\u0430\u043A \u0445\u043E\u0440\u043E\u0448\u043E, \u0447\u0442\u043E
      \u0447\u0443\u0436\u043E\u0439 \u043D\u0435 \u043D\u0430\u0439\u0434\u0451\u0442
      \u0431\u0435\u0437 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489997
    m_Localized: "\u041F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u0432\u0441\u0435
      \u0437\u0430\u043F\u0430\u0441\u044B \u0432\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489998
    m_Localized: "\u0427\u0430\u0441\u043E\u0432\u0430\u044F \u0441\u0442\u043E\u044F\u043D\u043A\u0430
      - \u0438 \u0432\u0441\u0435 \u0431\u0443\u0440\u0434\u044E\u043A\u0438 \u0442\u0443\u0433\u0438\u0435,
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u043D\u0430\u043F\u043E\u0435\u043D\u044B.
      \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u0434\u0432\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430
      \u043F\u0440\u043E\u0448\u043B\u0438 \u0431\u0435\u0437 \u043C\u044B\u0441\u043B\u0438
      \u043E \u0432\u043E\u0434\u0435. \u0422\u0430\u043A\u043E\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
      \u0441\u0442\u043E\u0438\u0442 \u043B\u044E\u0431\u043E\u0433\u043E \u043A\u0440\u044E\u043A\u0430
      \u043A \u043D\u0435\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617489999
    m_Localized: "\u041F\u043E\u043C\u0435\u0442\u0438\u0442\u044C \u043D\u0430 \u043A\u0430\u0440\u0442\u0435
      - \u0441\u043E\u043E\u0431\u0449\u0438\u0442\u044C \u0434\u0440\u0443\u0433\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490000
    m_Localized: "\u0424\u0430\u0440\u0440\u0443\u0445 \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0437\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043B \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B.
      \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u0433\u043E\u0440\u043E\u0434\u0435
      \u043F\u0435\u0440\u0435\u0434\u0430\u043B \u043A\u043E\u043F\u0438\u044E \u043A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u043E\u043C\u0443
      \u0441\u043E\u0432\u0435\u0442\u0443. \u042D\u0442\u043E \u0437\u043D\u0430\u043D\u0438\u0435
      \u0446\u0435\u043D\u0438\u0442\u0441\u044F \u043D\u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C
      \u043F\u0443\u0442\u0438 - \u0438 \u043B\u044E\u0434\u0438 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438,
      \u043A\u0442\u043E \u0438\u043C \u0435\u0433\u043E \u0434\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490001
    m_Localized: "\u041E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C \u0437\u0434\u0435\u0441\u044C
      \u0446\u0435\u043B\u044B\u0439 \u0434\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490002
    m_Localized: "\u0414\u0435\u043D\u044C \u0443 \u0432\u043E\u0434\u044B. \u041B\u044E\u0434\u0438
      \u0432\u044B\u0441\u043F\u0430\u043B\u0438\u0441\u044C, \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043D\u0430\u0433\u0443\u043B\u044F\u043B\u0438 \u0436\u0438\u0440 \u043D\u0430
      \u0441\u043A\u0443\u0434\u043D\u044B\u0445 \u043A\u043E\u043B\u044E\u0447\u043A\u0430\u0445
      \u0443 \u0449\u0435\u043B\u0438. \u041F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\u0438 \u0438 \u043F\u043E\u0434\u0442\u044F\u043D\u0443\u043B\u0438.
      \u0412\u044B\u0448\u043B\u0438 \u043D\u0430\u0437\u0430\u0432\u0442\u0440\u0430
      \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0432\u0448\u0438\u043C\u0438 -
      \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F \u0432\u043E\u0434\u0430 \u0438
      \u0442\u0435\u043D\u044C \u0441\u043A\u0430\u043B\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0441\u0432\u043E\u0451 \u0434\u0435\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490003
    m_Localized: "\u041A\u043B\u043E\u0447\u043E\u043A \u0448\u0451\u043B\u043A\u0430
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490004
    m_Localized: "\u041D\u0430 \u043F\u044B\u043B\u044C\u043D\u043E\u0439 \u0442\u0440\u043E\u043F\u0435,
      \u043F\u0440\u0438\u0434\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u043A\u0430\u043C\u043D\u0435\u043C
      - \u043F\u0440\u044F\u043C\u043E\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u0439
      \u043A\u0443\u0441\u043E\u043A \u0448\u0451\u043B\u043A\u0430 \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C
      \u0441 \u043B\u0430\u0434\u043E\u043D\u044C, \u0441 \u0447\u0430\u0441\u0442\u044C\u044E
      \u0443\u0437\u043E\u0440\u0430: \u0437\u043E\u043B\u043E\u0442\u044B\u0435
      \u043D\u0438\u0442\u0438 \u043F\u043E \u043A\u0440\u0430\u0441\u043D\u043E\u043C\u0443
      \u0444\u043E\u043D\u0443, \u043F\u0442\u0438\u0446\u0430 \u0441 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0451\u0440\u0442\u044B\u043C\u0438
      \u043A\u0440\u044B\u043B\u044C\u044F\u043C\u0438, \u044F\u0432\u043D\u043E
      \u0445\u0430\u043D\u044C\u0441\u043A\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430.
      \u0422\u043A\u0430\u043D\u044C \u043F\u043B\u043E\u0442\u043D\u0430\u044F,
      \u043D\u0438\u0442\u0438 \u043D\u0435 \u043E\u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C,
      \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u043B\u0435\u0436\u0430\u043D\u0438\u0435
      \u043F\u043E\u0434 \u0441\u043E\u043B\u043D\u0446\u0435\u043C - \u043D\u0435
      \u0434\u0435\u0448\u0451\u0432\u044B\u0439 \u0440\u044B\u043D\u043E\u043A.
      \u0411\u0443\u0433\u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0435\u0433\u043E \u0434\u0432\u0443\u043C\u044F \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438
      \u0438 \u043D\u044E\u0445\u0430\u0435\u0442: \u043B\u0451\u0433\u043A\u0438\u0439
      \u0437\u0430\u043F\u0430\u0445 \u0441\u0430\u043D\u0434\u0430\u043B\u043E\u0432\u043E\u0433\u043E
      \u043C\u0430\u0441\u043B\u0430 \u0435\u0449\u0451 \u0435\u0441\u0442\u044C.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043D \u043D\u0435\u0434\u0430\u0432\u043D\u043E.
      \u041A\u0442\u043E \u043D\u0451\u0441 \u0435\u0433\u043E - \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E,
      \u0441\u043B\u0435\u0434\u043E\u0432 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490005
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490006
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0442\u043A\u0430\u043D\u044F\u043C\u0438
      \u0432 \u0425\u043E\u0442\u0430\u043D\u0435 \u043E\u0446\u0435\u043D\u0438\u043B
      \u0443\u0437\u043E\u0440: \u0445\u0430\u043D\u044C\u0441\u043A\u043E\u0435
      \u0438\u043C\u043F\u0435\u0440\u0441\u043A\u043E\u0435 \u0430\u0442\u0435\u043B\u044C\u0435,
      \u043D\u0435 \u043F\u043E\u0437\u0434\u043D\u0435\u0435 \u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
      \u0421\u044E\u0430\u043D\u044C\u0446\u0437\u0443\u043D\u0430. \u0417\u0430\u043F\u043B\u0430\u0442\u0438\u043B
      \u0447\u0435\u0441\u0442\u043D\u043E. \u041A\u0443\u0441\u043E\u043A \u0448\u0451\u043B\u043A\u0430
      \u0441\u0442\u043E\u0438\u043B \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C
      \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490007
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043A\u0443\u043F\u0446\u0430\u043C
      - \u043D\u0430\u0439\u0442\u0438 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490008
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u043A\u0443\u0441\u043E\u043A
      \u043E\u043F\u043E\u0437\u043D\u0430\u043B \u0445\u0430\u043D\u044C\u0441\u043A\u0438\u0439
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u041B\u0438: \u044D\u0442\u043E
      \u0438\u0437 \u0435\u0433\u043E \u0442\u044E\u043A\u0430, \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u043E\u0433\u043E
      \u0442\u0440\u0438 \u0434\u043D\u044F \u043D\u0430\u0437\u0430\u0434. \u0412\u0435\u0440\u043D\u0443\u043B
      \u0441 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C\u044E
      \u0438 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043D\u0430\u0433\u0440\u0430\u0434\u043E\u0439.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0432\u044B\u0440\u043E\u0441\u043B\u0430 - \u0442\u0430\u043A \u0433\u043E\u0432\u043E\u0440\u044F\u0442
      \u043D\u0430 \u0440\u044B\u043D\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490009
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043A\u0430\u043A \u043E\u0431\u0440\u0430\u0437\u0435\u0446 \u0434\u043B\u044F
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490010
    m_Localized: "\u041D\u0430 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0430\u0445
      \u0441 \u0434\u0430\u043C\u0430\u0441\u0441\u043A\u0438\u043C \u043A\u0443\u043F\u0446\u043E\u043C
      \u043A\u0443\u0441\u043E\u043A \u0448\u0451\u043B\u043A\u0430 \u043B\u0451\u0433
      \u043D\u0430 \u0441\u0442\u043E\u043B \u043A\u0430\u043A \u043D\u0430\u0433\u043B\u044F\u0434\u043D\u044B\u0439
      \u043F\u0440\u0438\u043C\u0435\u0440 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430
      \u0442\u043E\u0432\u0430\u0440\u0430. \u0421\u0434\u0435\u043B\u043A\u0430
      \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u0430\u0441\u044C \u043F\u043E \u043B\u0443\u0447\u0448\u0435\u0439
      \u0446\u0435\u043D\u0435: \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u0439
      \u043E\u0431\u0440\u0430\u0437\u0435\u0446 \u0443\u0431\u0435\u0434\u0438\u043B
      \u043B\u0443\u0447\u0448\u0435 \u0441\u043B\u043E\u0432. \u0424\u0440\u0430\u0433\u043C\u0435\u043D\u0442
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0443 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044F
      \u043A\u0430\u043A \u0431\u043E\u043D\u0443\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490011
    m_Localized: "\u0421\u0432\u0435\u0436\u0438\u0439 \u043A\u043E\u0441\u0442\u0451\u0440
      \u0431\u0435\u0437 \u0445\u043E\u0437\u044F\u0435\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490012
    m_Localized: "\u0414\u044B\u043C \u0435\u0449\u0451 \u0441\u0442\u043E\u0438\u0442
      \u0441\u0442\u043E\u043B\u0431\u043E\u043C. \u0423\u0433\u043B\u0438 \u043A\u0440\u0430\u0441\u043D\u044B\u0435
      \u043F\u043E\u0434 \u0441\u0435\u0440\u044B\u043C \u043F\u0435\u043F\u043B\u043E\u043C.
      \u041D\u0430 \u0437\u0435\u043C\u043B\u0435 - \u0441\u043B\u0435\u0434\u044B
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u043B\u044E\u0434\u0435\u0439
      \u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430,
      \u0443\u0448\u0435\u0434\u0448\u0438\u0445 \u0432 \u0440\u0430\u0437\u043D\u044B\u0435
      \u0441\u0442\u043E\u0440\u043E\u043D\u044B. \u0411\u0440\u043E\u0448\u0435\u043D\u043D\u0430\u044F
      \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u0430\u044F \u043C\u0438\u0441\u043A\u0430
      \u0441 \u043E\u0441\u0442\u0430\u0442\u043A\u0430\u043C\u0438 \u043F\u0448\u0451\u043D\u043D\u043E\u0439
      \u043A\u0430\u0448\u0438 \u0435\u0449\u0451 \u0442\u0451\u043F\u043B\u0430\u044F.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0435\u043B - \u043A\u043E\u0433\u043E-\u0442\u043E
      \u0438\u043B\u0438 \u0447\u0442\u043E-\u0442\u043E \u0441\u043F\u0443\u0433\u043D\u0443\u043B\u043E.
      \u0411\u0443\u0433\u0430 \u0449\u0443\u0440\u0438\u0442\u0441\u044F \u0438
      \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E: \u0442\u0438\u0445\u043E,
      \u043D\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0442\u0438\u0445\u043E
      - \u0434\u0430\u0436\u0435 \u043F\u0442\u0438\u0446 \u043D\u0435 \u0441\u043B\u044B\u0448\u043D\u043E.
      \u041A\u0442\u043E \u0443\u0448\u0451\u043B, \u043A\u0443\u0434\u0430 \u0438
      \u043F\u043E\u0447\u0435\u043C\u0443 - \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490013
    m_Localized: "\u0421\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C \u0437\u0430
      \u0443\u0448\u0435\u0434\u0448\u0438\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490014
    m_Localized: "\u0421\u043B\u0435\u0434\u044B \u043F\u0440\u0438\u0432\u0435\u043B\u0438
      \u043A \u0441\u043A\u0430\u043B\u044C\u043D\u043E\u043C\u0443 \u043A\u0430\u0440\u043D\u0438\u0437\u0443:
      \u0442\u0430\u043C \u0441\u0438\u0434\u0435\u043B \u0438\u0441\u043F\u0443\u0433\u0430\u043D\u043D\u044B\u0439
      \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446, \u0431\u0435\u0436\u0430\u0432\u0448\u0438\u0439
      \u043E\u0442 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432.
      \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438 \u0443\u0448\u043B\u0438
      \u0447\u0430\u0441 \u043D\u0430\u0437\u0430\u0434. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u043E\u0442\u0434\u0430\u043B \u0432 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u0442\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E\u0435, \u0447\u0442\u043E
      \u0443\u043D\u0451\u0441 - \u043A\u043E\u0448\u0435\u043B\u044C \u0441 \u043C\u043E\u043D\u0435\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490015
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C
      \u0438 \u0436\u0434\u0430\u0442\u044C \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490016
    m_Localized: "\u041F\u0440\u043E\u0436\u0434\u0430\u043B\u0438 \u0434\u043E \u0432\u0435\u0447\u0435\u0440\u0430.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F.
      \u041F\u0435\u043F\u0435\u043B \u043E\u0441\u0442\u044B\u043B. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043F\u043E\u043B\u0434\u043D\u044F \u0438 \u0447\u0430\u0441\u0442\u044C
      \u0435\u0434\u044B. \u041A\u0435\u043C \u0431\u044B \u043E\u043D\u0438 \u043D\u0438
      \u0431\u044B\u043B\u0438, \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F
      \u043E\u043D\u0438 \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0438\u0441\u044C
      - \u0438\u043B\u0438 \u043D\u0435 \u043C\u043E\u0433\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490017
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490018
    m_Localized: "\u0411\u0443\u0433\u0430 \u043D\u0430\u0448\u0451\u043B \u0441\u0440\u0435\u0434\u0438
      \u0443\u0433\u043B\u0435\u0439 \u043E\u0431\u043B\u043E\u043C\u043E\u043A \u0433\u0443\u0430\u043D\u044C\u0434\u0438\u0435
      - \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439 \u0433\u0440\u0430\u043C\u043E\u0442\u044B
      \u0441 \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u043E\u0439 \u043F\u0435\u0447\u0430\u0442\u044C\u044E.
      \u0427\u044C\u044F - \u043D\u0435 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C.
      \u041D\u0438\u0447\u0435\u0433\u043E \u043E\u043F\u0430\u0441\u043D\u043E\u0433\u043E
      \u0432 \u043E\u043A\u0440\u0443\u0433\u0435 \u043D\u0435 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438.
      \u041F\u043E\u0448\u043B\u0438 \u0434\u0430\u043B\u044C\u0448\u0435 \u0441
      \u0447\u0443\u0442\u044C \u0431\u043E\u043B\u0435\u0435 \u043D\u0430\u0441\u0442\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u044B\u043C
      \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490019
    m_Localized: "\u042F\u043D\u0442\u0430\u0440\u044C \u0441 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490020
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 - \u043A\u0443\u0441\u043E\u043A
      \u044F\u043D\u0442\u0430\u0440\u044F \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C
      \u0441 \u043A\u0443\u043B\u0430\u043A, \u0436\u0451\u043B\u0442\u043E-\u0440\u044B\u0436\u0435\u0433\u043E
      \u0446\u0432\u0435\u0442\u0430, \u043F\u043E\u043B\u0443\u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0439.
      \u0412\u043D\u0443\u0442\u0440\u0438 \u0447\u0451\u0442\u043A\u043E \u0432\u0438\u0434\u0435\u043D
      \u0441\u0438\u043B\u0443\u044D\u0442 \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u043E\u0433\u043E
      - \u043A\u0440\u0443\u043F\u043D\u044B\u0439, \u0441 \u0434\u043B\u0438\u043D\u043D\u044B\u043C\u0438
      \u0443\u0441\u0430\u043C\u0438, \u044F\u0432\u043D\u043E \u0440\u0435\u0434\u043A\u0438\u0439
      \u0432\u0438\u0434. \u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u0434\u043B\u044F
      \u0441\u0432\u043E\u0435\u0433\u043E \u0440\u0430\u0437\u043C\u0435\u0440\u0430,
      \u0442\u0451\u043F\u043B\u044B\u0439 \u043D\u0430 \u043E\u0449\u0443\u043F\u044C
      - \u044F\u043D\u0442\u0430\u0440\u044C \u0432\u0441\u0435\u0433\u0434\u0430
      \u0442\u0451\u043F\u043B\u044B\u0439. \u041E\u0442\u043A\u0443\u0434\u0430
      \u043E\u043D \u0437\u0434\u0435\u0441\u044C - \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E:
      \u0431\u0430\u043B\u0442\u0438\u0439\u0441\u043A\u043E\u0435 \u0441\u044B\u0440\u044C\u0451
      \u0438\u043D\u043E\u0433\u0434\u0430 \u0434\u043E\u0445\u043E\u0434\u0438\u0442
      \u0434\u043E \u044D\u0442\u0438\u0445 \u043C\u0435\u0441\u0442 \u043F\u043E
      \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u043C\u0443 \u043F\u0443\u0442\u0438,
      \u043D\u043E \u0442\u0430\u043A\u043E\u0439 \u043A\u0440\u0443\u043F\u043D\u044B\u0439
      \u043A\u0443\u0441\u043E\u043A \u0441 \u0442\u0430\u043A\u0438\u043C \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0441\u044F \u0440\u0430\u0437
      \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043B\u0435\u0442.
      \u041F\u0440\u0438\u0440\u043E\u0434\u043D\u044B\u0439 \u0437\u043D\u0430\u043A
      \u0438\u043B\u0438 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u0430\u044F \u043F\u043E\u0442\u0435\u0440\u044F
      - \u043D\u0435 \u044F\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490021
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C \u0441\u0440\u0430\u0437\u0443
      \u0432 \u0433\u043E\u0440\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490022
    m_Localized: "\u042E\u0432\u0435\u043B\u0438\u0440 \u0432 \u041A\u0430\u0448\u0433\u0430\u0440\u0435
      \u0432\u0437\u044F\u043B \u043D\u0435 \u0442\u043E\u0440\u0433\u0443\u044F\u0441\u044C
      - \u044F\u043D\u0442\u0430\u0440\u044C \u0441 \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u044B\u043C
      \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044C \u0434\u0430\u0436\u0435 \u0437\u0434\u0435\u0441\u044C.
      \u0417\u0430\u043F\u043B\u0430\u0442\u0438\u043B \u0445\u043E\u0440\u043E\u0448\u043E.
      \u0411\u044B\u0441\u0442\u0440\u044B\u0435 \u0434\u0435\u043D\u044C\u0433\u0438
      \u0437\u0430 \u0443\u0434\u0430\u0447\u043D\u0443\u044E \u043D\u0430\u0445\u043E\u0434\u043A\u0443
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490023
    m_Localized: "\u041E\u0446\u0435\u043D\u0438\u0442\u044C \u0443 \u044E\u0432\u0435\u043B\u0438\u0440\u0430
      \u0437\u0430 \u0434\u043E\u043B\u044E \u043E\u0442 \u043F\u0440\u043E\u0434\u0430\u0436\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490024
    m_Localized: "\u042E\u0432\u0435\u043B\u0438\u0440 \u0411\u0430\u0445\u0440\u0430\u043C
      \u043E\u0446\u0435\u043D\u0438\u043B \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E:
      \u044D\u0442\u043E \u0431\u0430\u043B\u0442\u0438\u0439\u0441\u043A\u0438\u0439
      \u044F\u043D\u0442\u0430\u0440\u044C \u0441 \u043E\u043B\u0435\u043D\u044C\u0438\u043C
      \u0436\u0443\u043A\u043E\u043C, \u0441\u0442\u043E\u0438\u0442 \u0432\u0442\u0440\u043E\u0435
      \u0434\u043E\u0440\u043E\u0436\u0435, \u0447\u0435\u043C \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C.
      \u0412\u0437\u044F\u043B \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432 \u0437\u0430 \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u0438\u0437\u0443
      \u0438 \u043F\u043E\u043C\u043E\u0433 \u0441 \u0432\u044B\u0433\u043E\u0434\u043D\u044B\u043C
      \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0435\u043C. \u0418\u0442\u043E\u0433\u043E\u0432\u0430\u044F
      \u0441\u0443\u043C\u043C\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u0432\u044B\u0448\u0435 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490025
    m_Localized: "\u0412\u0435\u0437\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435
      - \u043D\u0430\u0439\u0442\u0438 \u043E\u0441\u043E\u0431\u043E\u0433\u043E
      \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490026
    m_Localized: "\u0412 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u043D\u0430\u0442\u0443\u0440\u0430\u043B\u0438\u0441\u0442 \u043F\u0440\u0438
      \u0434\u0432\u043E\u0440\u0435 \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B \u0437\u0430 \u044F\u043D\u0442\u0430\u0440\u044C
      \u0441 \u0440\u0435\u0434\u043A\u0438\u043C \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u044B\u043C
      \u0432\u0434\u0432\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439
      \u0446\u0435\u043D\u044B - \u0434\u043B\u044F \u0435\u0433\u043E \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u0438.
      \u0422\u0435\u0440\u043F\u0435\u043D\u0438\u0435 \u0438 \u0437\u043D\u0430\u043D\u0438\u0435
      \u0440\u044B\u043D\u043A\u0430 \u043E\u043A\u0443\u043F\u0438\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490027
    m_Localized: "\u0421\u0432\u0438\u0442\u043E\u043A \u0432 \u043A\u043E\u0436\u0430\u043D\u043E\u043C
      \u0447\u0435\u0445\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490028
    m_Localized: "\u041D\u0430 \u043E\u0431\u043E\u0447\u0438\u043D\u0435 \u0442\u0440\u043E\u043F\u044B
      - \u0434\u043E\u0440\u043E\u0433\u043E\u0439 \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u0446\u0438\u043B\u0438\u043D\u0434\u0440, \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0439
      \u043C\u0435\u0434\u043D\u043E\u0439 \u043F\u0440\u043E\u0431\u043A\u043E\u0439
      \u0441 \u0442\u0438\u0441\u043D\u0451\u043D\u043E\u0439 \u0432\u044F\u0437\u044C\u044E.
      \u041A\u043E\u0436\u0430 \u043C\u044F\u0433\u043A\u0430\u044F, \u043D\u0443\u0442\u0440\u044F\u043D\u0430\u044F,
      \u0441 \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u043C\u0443\u0441\u043A\u0443\u0441\u0430
      - \u044F\u0432\u043D\u043E \u043D\u0435 \u0434\u0435\u0448\u0451\u0432\u044B\u0439
      \u0442\u043E\u0432\u0430\u0440. \u0412\u043D\u0443\u0442\u0440\u0438 \u0441\u0432\u0451\u0440\u043D\u0443\u0442\u044B\u0439
      \u0441\u0432\u0438\u0442\u043E\u043A \u0441 \u0430\u0440\u0430\u0431\u0441\u043A\u043E\u0439
      \u0432\u044F\u0437\u044C\u044E - \u0447\u0451\u0440\u043D\u044B\u0435 \u0447\u0435\u0440\u043D\u0438\u043B\u0430
      \u043D\u0430 \u0442\u043E\u043D\u043A\u043E\u043C \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0435,
      \u043F\u0435\u0447\u0430\u0442\u044C \u0441 \u0438\u043C\u0435\u043D\u0435\u043C.
      \u041F\u0438\u0441\u044C\u043C\u043E \u0430\u0434\u0440\u0435\u0441\u043E\u0432\u0430\u043D\u043E,
      \u0441\u0443\u0434\u044F \u043F\u043E \u043D\u0430\u0434\u043F\u0438\u0441\u0438
      \u0441\u043D\u0430\u0440\u0443\u0436\u0438, \u043A\u0443\u043F\u0446\u0443
      \u0432 \u0411\u0430\u0433\u0434\u0430\u0434\u0435. \u0410\u0445\u043C\u0430\u0434
      \u0447\u0438\u0442\u0430\u0435\u0442 \u043F\u043E-\u0430\u0440\u0430\u0431\u0441\u043A\u0438
      \u0438 \u0445\u043C\u0443\u0440\u0438\u0442\u0441\u044F: \u0442\u0435\u043A\u0441\u0442
      \u0434\u0435\u043B\u043E\u0432\u043E\u0439, \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442\u0441\u044F
      \u0446\u0438\u0444\u0440\u044B \u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442.
      \u0427\u044C\u0451 \u043F\u0438\u0441\u044C\u043C\u043E, \u043A\u043E\u0433\u0434\u0430
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E - \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490029
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0430\u0434\u0440\u0435\u0441\u0430\u0442\u0443
      \u0432 \u0411\u0430\u0433\u0434\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490030
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u0441 \u043E\u043A\u0430\u0437\u0438\u0435\u0439 \u0447\u0435\u0440\u0435\u0437
      \u0442\u0440\u0438 \u043C\u0435\u0441\u044F\u0446\u0430. \u041A\u0443\u043F\u0435\u0446
      \u042E\u0441\u0443\u0444 \u0438\u0437 \u0411\u0430\u0433\u0434\u0430\u0434\u0430
      \u043F\u0440\u0438\u0441\u043B\u0430\u043B \u043E\u0442\u0432\u0435\u0442\u043D\u043E\u0435
      \u043F\u0438\u0441\u044C\u043C\u043E \u0441 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C\u044E
      \u0438 \u0432\u043E\u0437\u043D\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u0438\u0435\u043C
      \u0447\u0435\u0440\u0435\u0437 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043F\u043E\u0441\u0442 \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435.
      \u0427\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C \u043D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u043F\u0443\u0442\u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0441 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490031
    m_Localized: "\u0412\u0441\u043A\u0440\u044B\u0442\u044C \u0438 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C
      \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490032
    m_Localized: "\u0410\u0445\u043C\u0430\u0434 \u043F\u0440\u043E\u0447\u0451\u043B:
      \u043F\u0438\u0441\u044C\u043C\u043E \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u043B\u043E
      \u0442\u0430\u0439\u043D\u044B\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0441 \u0446\u0435\u043D\u0430\u043C\u0438
      \u043D\u0430 \u0441\u043F\u0435\u0446\u0438\u0438. \u041F\u043E\u043B\u0435\u0437\u043D\u0430\u044F
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F, \u043D\u043E
      \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u0430\u044F \u043F\u0435\u0447\u0430\u0442\u044C
      - \u0441\u043B\u0435\u0434. \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435 \u043E\u0434\u0438\u043D \u043A\u0443\u043F\u0435\u0446
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043D\u0430 \u043E\u0431\u043E\u0437
      \u0441 \u044F\u0432\u043D\u044B\u043C \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490033
    m_Localized: "\u0421\u0434\u0430\u0442\u044C \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u043C\u0443
      \u043A\u0430\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490034
    m_Localized: "\u041A\u0430\u0434\u0438 \u043F\u0440\u0438\u043D\u044F\u043B \u043F\u0438\u0441\u044C\u043C\u043E
      \u0441 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C\u044E
      \u0438 \u0432\u043D\u0451\u0441 \u043E\u0431\u043E\u0437 \u0432 \u043A\u043D\u0438\u0433\u0443
      \u0434\u043E\u0431\u0440\u043E\u0441\u043E\u0432\u0435\u0441\u0442\u043D\u044B\u0445
      \u043A\u0443\u043F\u0446\u043E\u0432. \u0422\u0430\u043A\u0430\u044F \u0437\u0430\u043F\u0438\u0441\u044C
      \u0443\u0441\u043A\u043E\u0440\u044F\u0435\u0442 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
      \u0437\u0430\u0441\u0442\u0430\u0432. \u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u043F\u043E\u0441\u0442\u0443\u043F\u043E\u043A, \u0434\u043E\u043B\u0433\u0430\u044F
      \u043F\u043E\u043B\u044C\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490035
    m_Localized: "\u0421\u0442\u0435\u043D\u0430 \u043F\u0435\u0441\u043A\u0430 -
      \u0445\u0430\u0431\u0443\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289617490036
    m_Localized: "\u0413\u043E\u0440\u0438\u0437\u043E\u043D\u0442 \u043D\u0430 \u044E\u0433\u0435
      \u0441\u0442\u0430\u043B \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u043C,
      \u043F\u043E\u0442\u043E\u043C \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u044B\u043C
      - \u0441\u0442\u0435\u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u043E\u0439
      \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043E\u0442\u0435\u043D
      \u043B\u043E\u043A\u0442\u0435\u0439 \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F
      \u0441\u043E \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C\u044E \u0441\u043A\u0430\u0447\u0443\u0449\u0435\u0439
      \u043B\u043E\u0448\u0430\u0434\u0438. \u0412\u043E\u0437\u0434\u0443\u0445
      \u0441\u0440\u0430\u0437\u0443 \u0441\u0442\u0430\u043B \u0433\u043E\u0440\u044C\u043A\u0438\u043C
      \u0438 \u0441\u0443\u0445\u0438\u043C, \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u0437\u0430\u0436\u0430\u043B\u0438 \u043D\u043E\u0437\u0434\u0440\u0438 \u0438
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u0445\u0432\u043E\u0441\u0442\u0430\u043C\u0438
      \u043A \u0432\u0435\u0442\u0440\u0443. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0411\u0443\u0433\u0430 \u043A\u0440\u0438\u0447\u0438\u0442 - \u0435\u0433\u043E
      \u0443\u0436\u0435 \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u0441\u043B\u044B\u0448\u043D\u043E:
      \u0447\u0435\u0440\u0435\u0437 \u043F\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442
      \u0437\u0434\u0435\u0441\u044C \u0431\u0443\u0434\u0435\u0442 \u0442\u0435\u043C\u043D\u043E
      \u043A\u0430\u043A \u043D\u043E\u0447\u044C\u044E, \u0438 \u0432\u0435\u0442\u0435\u0440
      \u0441\u043E\u0431\u044C\u0451\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0441 \u043D\u043E\u0433. \u0423 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      - \u043C\u0438\u043D\u0443\u0442\u044B, \u0447\u0442\u043E\u0431\u044B \u0440\u0435\u0448\u0438\u0442\u044C
      \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684224
    m_Localized: "\u0423\u043A\u0440\u044B\u0442\u044C\u0441\u044F \u0437\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u043C\u0438
      \u0438 \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684225
    m_Localized: "\u0414\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u043F\u0440\u0438\u0436\u0430\u043B\u0438\u0441\u044C \u043A \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u043C,
      \u043B\u0438\u0446\u0430 \u0432 \u043A\u043E\u0448\u043C\u0430\u0445. \u0422\u0440\u0438
      \u0447\u0430\u0441\u0430 \u0433\u0440\u043E\u0445\u043E\u0442\u0430, \u043F\u0435\u0441\u043A\u0430
      \u0438 \u0442\u044C\u043C\u044B. \u041F\u043E\u0442\u043E\u043C \u0442\u0438\u0448\u0438\u043D\u0430.
      \u0412\u0441\u0451 \u043F\u043E\u043A\u0440\u044B\u0442\u043E \u0441\u043B\u043E\u0435\u043C
      \u043F\u044B\u043B\u0438 \u0432 \u043F\u0430\u043B\u0435\u0446 \u0442\u043E\u043B\u0449\u0438\u043D\u043E\u0439,
      \u043E\u0434\u043D\u043E \u043A\u043E\u043B\u0435\u0441\u043E \u0441\u043B\u043E\u043C\u0430\u043D\u043E
      \u043E\u0442 \u0443\u0434\u0430\u0440\u0430 \u0432\u044C\u044E\u043A\u0430,
      \u043D\u043E \u043E\u0431\u043E\u0437 \u0446\u0435\u043B \u0438 \u0432\u0441\u0435
      \u0436\u0438\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684226
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u043E \u0443\u0439\u0442\u0438 \u0432
      \u043D\u0438\u0437\u0438\u043D\u0443 - \u043E\u0431\u044A\u0435\u0445\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684227
    m_Localized: "\u041E\u0431\u043E\u0437 \u0443\u0441\u043F\u0435\u043B \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u0432\u0430\u0434\u0438 - \u0441\u0443\u0445\u043E\u0433\u043E
      \u0440\u0443\u0441\u043B\u0430 \u0441 \u0432\u044B\u0441\u043E\u043A\u0438\u043C\u0438
      \u0431\u0435\u0440\u0435\u0433\u0430\u043C\u0438. \u0411\u0443\u0440\u044F
      \u043F\u0440\u043E\u0448\u043B\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u0443,
      \u043E\u0441\u044B\u043F\u0430\u0432 \u043F\u0435\u0441\u043A\u043E\u043C,
      \u043D\u043E \u043D\u0435 \u043D\u0430\u043A\u0440\u044B\u0432. \u0423\u043C\u043D\u044B\u0439
      \u043C\u0430\u043D\u0451\u0432\u0440 \u043E\u0442\u0446\u0430 \u0411\u0443\u0433\u0438
      - \u043E\u043D \u0443\u0447\u0438\u043B: \u0445\u0430\u0431\u0443\u0431 \u0438\u0434\u0451\u0442
      \u043F\u043E \u0440\u0430\u0432\u043D\u0438\u043D\u0435, \u0431\u0435\u0440\u0435\u0433\u0430
      \u0435\u0433\u043E \u0440\u0430\u0441\u0441\u0435\u043A\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684228
    m_Localized: "\u041D\u0430\u043A\u0440\u044B\u0442\u044C \u043B\u044E\u0434\u0435\u0439
      \u0438 \u0433\u0440\u0443\u0437 \u043A\u043E\u0448\u043C\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684229
    m_Localized: "\u0420\u0430\u0437\u043B\u043E\u0436\u0438\u043B\u0438 \u0432\u043E\u0439\u043B\u043E\u043A
      \u043F\u043E\u0432\u0435\u0440\u0445 \u0432\u0441\u0435\u0433\u043E - \u043B\u044E\u0434\u0435\u0439,
      \u0442\u043E\u0432\u0430\u0440\u0430, \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u044C\u0438\u0445
      \u0433\u043E\u043B\u043E\u0432. \u0411\u0443\u0440\u044F \u0442\u0440\u044F\u0441\u043B\u0430
      \u0438 \u0445\u043B\u0435\u0441\u0442\u0430\u043B\u0430, \u043D\u043E \u043D\u0438
      \u043E\u0434\u0438\u043D \u0442\u044E\u043A \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043D.
      \u0421\u0430\u043C\u0438 \u0432\u044B\u0431\u0440\u0430\u043B\u0438\u0441\u044C
      \u0438\u0437-\u043F\u043E\u0434 \u043F\u0435\u0441\u043A\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0442\u0440\u0438 \u0447\u0430\u0441\u0430, \u043E\u0442\u043F\u043B\u0451\u0432\u044B\u0432\u0430\u044F\u0441\u044C
      \u0438 \u043A\u0430\u0448\u043B\u044F\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684230
    m_Localized: "\u041F\u043E\u0442\u043E\u043A \u0432 \u0441\u0443\u0445\u043E\u043C
      \u0440\u0443\u0441\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684231
    m_Localized: "\u0413\u0440\u043E\u043C \u0432 \u0433\u043E\u0440\u0430\u0445
      \u0431\u044B\u043B \u0447\u0430\u0441 \u043D\u0430\u0437\u0430\u0434. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0438\u0437 \u0432\u0430\u0434\u0438 \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u043D\u0430\u0440\u0430\u0441\u0442\u0430\u044E\u0449\u0438\u0439 \u0433\u0443\u043B
      - \u043D\u0435 \u0432\u0435\u0442\u0435\u0440, \u0433\u043B\u0443\u0431\u0436\u0435.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0410\u0445\u043C\u0430\u0434
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u0432\u0435\u0440\u0445 \u043F\u043E
      \u0443\u0449\u0435\u043B\u044C\u044E: \u0442\u0430\u043C \u0442\u0435\u043C\u043D\u043E-\u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u0430\u044F
      \u0441\u0442\u0435\u043D\u0430 \u0432\u043E\u0434\u044B \u0438 \u0433\u043B\u0438\u043D\u044B
      \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F \u0432\u043D\u0438\u0437,
      \u043B\u043E\u043C\u0430\u044F \u0437\u0430\u0440\u043E\u0441\u043B\u0438 \u0442\u0430\u043C\u0430\u0440\u0438\u0441\u043A\u0430.
      \u041E\u0431\u043E\u0437 \u0441\u0442\u043E\u0438\u0442 \u0432 \u0440\u0443\u0441\u043B\u0435.
      \u041F\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442 - \u043C\u0435\u043D\u044C\u0448\u0435.
      \u0411\u0435\u0440\u0435\u0433\u0430 \u043A\u0440\u0443\u0442\u044B\u0435,
      \u043D\u043E \u0435\u0441\u0442\u044C \u0432\u044B\u0445\u043E\u0434 \u043A
      \u0441\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u043B\u043A\u0435
      \u0441\u043B\u0435\u0432\u0430 \u0438 \u043E\u0442\u043B\u043E\u0433\u0438\u0439
      \u043F\u043E\u0434\u044A\u0451\u043C \u0441\u043F\u0440\u0430\u0432\u0430.
      \u0413\u0440\u0443\u0437 \u043D\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u0445
      \u043D\u0435 \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u0451\u043D - \u0442\u043E\u043B\u044C\u043A\u043E
      \u0447\u0442\u043E \u0441\u0442\u043E\u044F\u043B\u0438 \u043D\u0430 \u043D\u043E\u0447\u0451\u0432\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684232
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      - \u0431\u0435\u0436\u0430\u0442\u044C \u043D\u0430 \u0432\u043E\u0437\u0432\u044B\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684233
    m_Localized: "\u0412\u0441\u0435 \u0432\u044B\u0431\u0440\u0430\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0441\u043A\u0430\u043B\u044C\u043D\u0443\u044E \u043F\u043E\u043B\u043A\u0443
      \u0437\u0430 \u0447\u0435\u0442\u044B\u0440\u0435 \u043C\u0438\u043D\u0443\u0442\u044B.
      \u041F\u043E\u0442\u043E\u043A \u043F\u0440\u043E\u0448\u0451\u043B \u0432\u043D\u0438\u0437\u0443
      \u0441 \u0433\u0440\u043E\u0445\u043E\u0442\u043E\u043C - \u0443\u043D\u0451\u0441
      \u043E\u0434\u043D\u0443 \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u0443\u044E
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443 \u0438 \u0447\u0430\u0441\u0442\u044C
      \u0442\u044E\u043A\u043E\u0432. \u041B\u044E\u0434\u0438 \u0436\u0438\u0432\u044B.
      \u0413\u0440\u0443\u0437 \u043F\u043E\u0442\u0435\u0440\u044F\u043D \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E,
      \u043D\u043E \u0436\u0438\u0437\u043D\u044C \u0434\u043E\u0440\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684234
    m_Localized: "\u0421\u043F\u0430\u0441\u0430\u0442\u044C \u0433\u0440\u0443\u0437
      - \u0437\u0430\u043A\u0440\u0435\u043F\u0438\u0442\u044C \u0442\u044E\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684235
    m_Localized: "\u0414\u0432\u043E\u0435 \u0437\u0430\u043A\u0440\u0435\u043F\u0438\u043B\u0438
      \u0442\u044E\u043A\u0438, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0432\u044B\u0432\u043E\u0434\u0438\u043B\u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432.
      \u0412\u043E\u0434\u0430 \u043F\u0440\u0438\u0448\u043B\u0430 \u0440\u0430\u043D\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0443\u0441\u043F\u0435\u043B\u0438. \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u041A\u044E\u043B\u044C-\u0431\u0430\u0442\u0443\u0440 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0443\u0434\u0430\u0440 \u0431\u0440\u0435\u0432\u043D\u043E\u043C \u043F\u043E
      \u043F\u043B\u0435\u0447\u0443. \u0427\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430
      \u0441\u043F\u0430\u0441\u043B\u0438, \u043D\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u043B\u0435\u0447\u0438\u043B\u0438 \u0442\u0440\u0438 \u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684236
    m_Localized: "\u0412\u044B\u0442\u044F\u0433\u0438\u0432\u0430\u0442\u044C \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u043C\u0438 \u043D\u0430 \u0431\u0435\u0440\u0435\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684237
    m_Localized: "\u0412\u043E\u0441\u0435\u043C\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0442\u044F\u043D\u0443\u043B\u0438 \u043A\u0430\u043D\u0430\u0442\u044B,
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0441\u043A\u0440\u0438\u043F\u0435\u043B\u0438
      \u0438 \u043F\u043E\u043B\u0437\u043B\u0438 \u0432\u0432\u0435\u0440\u0445.
      \u041F\u043E\u0434\u043D\u044F\u043B\u0438 \u0442\u0440\u0438 \u0438\u0437
      \u0447\u0435\u0442\u044B\u0440\u0451\u0445 \u0434\u043E \u0442\u043E\u0433\u043E
      \u043A\u0430\u043A \u0432\u043E\u0434\u0430 \u0434\u043E\u0441\u0442\u0438\u0433\u043B\u0430
      \u043A\u043E\u043B\u0451\u0441. \u0427\u0435\u0442\u0432\u0451\u0440\u0442\u0430\u044F
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0432\u043D\u0438\u0437\u0443
      \u0438 \u043E\u043F\u0440\u043E\u043A\u0438\u043D\u0443\u043B\u0430\u0441\u044C.
      \u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u0433\u0440\u0443\u0437\u0430
      \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684238
    m_Localized: "\u041B\u0430\u0432\u0438\u043D\u0430 \u0437\u0430\u043A\u0440\u044B\u043B\u0430
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684239
    m_Localized: "\u0413\u0440\u043E\u0445\u043E\u0442 \u0441 \u0441\u0435\u0432\u0435\u0440\u0430
      - \u0438 \u0441\u043A\u043B\u043E\u043D \u043F\u0440\u0438\u0448\u0451\u043B
      \u0432 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435. \u0421\u043D\u0435\u0436\u043D\u044B\u0439
      \u0432\u0430\u043B \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u0438
      \u043B\u043E\u043A\u0442\u0435\u0439 \u0432\u044B\u0441\u043E\u0442\u043E\u0439
      \u0437\u0430\u0432\u0430\u043B\u0438\u043B \u0442\u0440\u043E\u043F\u0443 \u0432
      \u0441\u0442\u0430 \u0448\u0430\u0433\u0430\u0445 \u0432\u043F\u0435\u0440\u0435\u0434\u0438,
      \u0438 \u0435\u0449\u0451 \u043E\u0441\u044B\u043F\u0430\u043B\u043E\u0441\u044C,
      \u043F\u043E\u043A\u0430 \u043E\u0431\u043E\u0437 \u0441\u0442\u043E\u044F\u043B.
      \u041F\u0435\u0440\u0435\u0432\u0430\u043B \u0437\u0430\u043A\u0440\u044B\u0442
      - \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E, \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E.
      \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u041D\u0430\u043D\u0430\u043C
      \u0449\u0443\u043F\u0430\u0435\u0442 \u0441\u043D\u0435\u0433: \u043F\u043B\u043E\u0442\u043D\u044B\u0439,
      \u0441\u043B\u0435\u0436\u0430\u0432\u0448\u0438\u0439\u0441\u044F. \u0422\u0440\u0438
      \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430: \u0436\u0434\u0430\u0442\u044C
      \u043F\u043E\u043A\u0430 \u0441\u043E\u0439\u0434\u0451\u0442 \u0441\u0430\u043C,
      \u0438\u0441\u043A\u0430\u0442\u044C \u043E\u0431\u0445\u043E\u0434 \u043F\u043E
      \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u043C\u0443 \u0433\u0440\u0435\u0431\u043D\u044E
      - \u044D\u0442\u043E \u0434\u0432\u0430 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0434\u043D\u044F, \u0438\u043B\u0438 \u043F\u0440\u043E\u043A\u0430\u043F\u044B\u0432\u0430\u0442\u044C
      \u043F\u0443\u0442\u044C \u0432\u0440\u0443\u0447\u043D\u0443\u044E. \u0417\u0430\u043F\u0430\u0441\u044B
      \u0435\u0434\u044B \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D\u044B
      \u043D\u0430 \u043F\u044F\u0442\u044C \u0434\u043D\u0435\u0439 \u0432\u043F\u0435\u0440\u0451\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684240
    m_Localized: "\u0418\u0434\u0442\u0438 \u0432 \u043E\u0431\u0445\u043E\u0434
      \u0447\u0435\u0440\u0435\u0437 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0439
      \u0433\u0440\u0435\u0431\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684241
    m_Localized: "\u041E\u0431\u0445\u043E\u0434 \u0437\u0430\u043D\u044F\u043B \u0434\u0432\u0430
      \u0434\u043D\u044F. \u0422\u0440\u043E\u043F\u0430 \u043F\u043E \u0433\u0440\u0435\u0431\u043D\u044E
      \u0443\u0437\u043A\u0430\u044F, \u0432\u0435\u0442\u0440\u0435\u043D\u0430\u044F,
      \u043E\u0434\u0438\u043D \u044F\u043A \u0435\u0434\u0432\u0430 \u043D\u0435
      \u0441\u043E\u0440\u0432\u0430\u043B\u0441\u044F. \u041D\u043E \u043F\u0440\u043E\u0448\u043B\u0438.
      \u0417\u0430\u043F\u0430\u0441\u044B \u0441\u044A\u0435\u043B\u0438 \u0441\u0432\u0435\u0440\u0445
      \u043D\u043E\u0440\u043C\u044B, \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0443\u043F\u0430\u043B\u043E - \u0438 \u0432\u0441\u0451 \u0436\u0435 \u043F\u0435\u0440\u0435\u0432\u0430\u043B
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043F\u043E\u0437\u0430\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684242
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C
      \u0438 \u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684243
    m_Localized: "\u0416\u0434\u0430\u043B\u0438 \u0442\u0440\u0438 \u0434\u043D\u044F.
      \u0421\u043D\u0435\u0433 \u043E\u0441\u0435\u043B, \u0438 \u043F\u043E \u043A\u0440\u0430\u044E
      \u0437\u0430\u0432\u0430\u043B\u0430 \u043F\u0440\u043E\u0448\u043B\u0438 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u043C\u043D\u043E\u0433\u043E
      \u0435\u0434\u044B \u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u043D\u043E
      \u0431\u0435\u0437 \u0440\u0438\u0441\u043A\u0430. \u041D\u0430\u043D\u0430\u043C
      \u0441\u043A\u0430\u0437\u0430\u043B: \u0432 \u0422\u0438\u0431\u0435\u0442\u0435
      \u0442\u0430\u043A \u0432\u0441\u0435\u0433\u0434\u0430 - \u0433\u043E\u0440\u0430
      \u0432\u043E\u0437\u044C\u043C\u0451\u0442 \u0441\u0432\u043E\u0451, \u0430
      \u043F\u043E\u0442\u043E\u043C \u0443\u0431\u0435\u0440\u0451\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684244
    m_Localized: "\u041F\u0440\u043E\u043A\u0430\u043F\u044B\u0432\u0430\u0442\u044C
      \u043F\u0443\u0442\u044C \u0432\u0440\u0443\u0447\u043D\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684245
    m_Localized: "\u0428\u0435\u0441\u0442\u044C \u0447\u0430\u0441\u043E\u0432 \u043A\u043E\u043F\u0430\u043B\u0438
      \u043B\u043E\u043F\u0430\u0442\u0430\u043C\u0438 \u0438 \u0440\u0443\u043A\u0430\u043C\u0438.
      \u041F\u0440\u043E\u0431\u0438\u043B\u0438 \u0442\u043E\u043D\u043D\u0435\u043B\u044C
      \u0448\u0438\u0440\u0438\u043D\u043E\u0439 \u0432 \u043E\u0434\u043D\u0443
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443. \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B
      - \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043D\u0435\u0440\u0432\u043D\u0438\u0447\u0430\u043B\u0438 \u0432 \u0441\u043D\u0435\u0436\u043D\u043E\u043C
      \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0435. \u041E\u0434\u0438\u043D
      \u0442\u044E\u043A \u043F\u0440\u0438\u043C\u0451\u0440\u0437 \u043A \u0441\u0442\u0435\u043D\u043A\u0435
      \u0438 \u0435\u0433\u043E \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0431\u0440\u043E\u0441\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684246
    m_Localized: "\u0422\u0443\u0447\u0430 \u0441\u0430\u0440\u0430\u043D\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684247
    m_Localized: "\u0428\u043E\u0440\u043E\u0445 \u043D\u0430\u0447\u0430\u043B\u0441\u044F
      \u0441 \u0437\u0430\u043F\u0430\u0434\u0430 - \u043A\u0430\u043A \u0434\u0430\u043B\u0451\u043A\u0438\u0439
      \u0434\u043E\u0436\u0434\u044C, \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0443\u0445\u043E\u0439.
      \u041E\u0431\u043B\u0430\u043A\u043E \u0437\u0435\u043B\u0451\u043D\u043E-\u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u043E\u0435
      \u043F\u043E\u0434\u043D\u044F\u043B\u043E\u0441\u044C \u043D\u0430\u0434 \u0445\u043E\u043B\u043C\u043E\u043C
      \u0438 \u0434\u0432\u0438\u043D\u0443\u043B\u043E\u0441\u044C \u043D\u0430
      \u043E\u0431\u043E\u0437. \u0427\u0435\u0440\u0435\u0437 \u043C\u0438\u043D\u0443\u0442\u0443
      \u0432\u043E\u0437\u0434\u0443\u0445 \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u043B\u0441\u044F
      \u0445\u0440\u0443\u0441\u0442\u043E\u043C \u0438 \u0437\u0430\u043F\u0430\u0445\u043E\u043C
      \u0441\u0443\u0445\u043E\u0439 \u0442\u0440\u0430\u0432\u044B: \u0441\u0430\u0440\u0430\u043D\u0447\u0430
      \u0441\u0430\u0434\u0438\u043B\u0430\u0441\u044C \u043D\u0430 \u043C\u0435\u0448\u043A\u0438
      \u0441 \u0437\u0435\u0440\u043D\u043E\u043C, \u043D\u0430 \u043A\u043E\u0448\u043C\u044B,
      \u043D\u0430 \u043E\u0434\u0435\u0436\u0434\u0443 \u043B\u044E\u0434\u0435\u0439.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u043C\u043E\u0442\u0430\u043B\u0438
      \u0433\u043E\u043B\u043E\u0432\u0430\u043C\u0438. \u0417\u0435\u0440\u043D\u043E\u0432\u044B\u0435
      \u043C\u0435\u0448\u043A\u0438 \u043F\u043E\u0434 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C
      \u043D\u0435\u0431\u043E\u043C \u0437\u0430 \u0447\u0430\u0441 \u0442\u0435\u0440\u044F\u044E\u0442
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0433\u043E
      - \u0441\u0430\u0440\u0430\u043D\u0447\u0430 \u0435\u0441\u0442 \u0432\u0441\u0451
      \u0438 \u0431\u044B\u0441\u0442\u0440\u043E. \u041F\u0430\u0441\u0442\u0431\u0438\u0449\u043D\u043E\u0433\u043E
      \u043A\u043E\u0440\u043C\u0430 \u0434\u043B\u044F \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445
      \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435 \u043B\u0438 \u0443\u0436\u0435
      \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684248
    m_Localized: "\u0416\u0435\u0447\u044C \u0441\u044B\u0440\u044B\u0435 \u0432\u0435\u0442\u043A\u0438
      - \u0434\u044B\u043C\u043E\u043C \u043E\u0442\u043E\u0433\u043D\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684249
    m_Localized: "\u0414\u044B\u043C \u043E\u0442 \u0441\u044B\u0440\u043E\u0433\u043E
      \u0442\u0430\u043C\u0430\u0440\u0438\u0441\u043A\u0430 \u0431\u044B\u043B \u0435\u0434\u043A\u0438\u0439
      \u0438 \u0433\u0443\u0441\u0442\u043E\u0439. \u0420\u043E\u0439 \u0441\u043C\u0435\u0441\u0442\u0438\u043B\u0441\u044F,
      \u043D\u043E \u043D\u0435 \u0443\u0448\u0451\u043B - \u0447\u0430\u0441\u0442\u044C
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C, \u043E\u0431\u044A\u0435\u043B\u0430
      \u0432\u0438\u0434\u0438\u043C\u044B\u0435 \u0437\u0430\u043F\u0430\u0441\u044B.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0447\u0430\u0441 \u0438
      \u0447\u0430\u0441\u0442\u044C \u0444\u0443\u0440\u0430\u0436\u0430, \u0437\u0430\u0442\u043E
      \u0441\u043F\u0430\u0441\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0443\u044E
      \u0447\u0430\u0441\u0442\u044C \u0437\u0435\u0440\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684250
    m_Localized: "\u0421\u0440\u043E\u0447\u043D\u043E \u0443\u043A\u0440\u044B\u0442\u044C
      \u0432\u0435\u0441\u044C \u0444\u0443\u0440\u0430\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684251
    m_Localized: "\u0412\u0441\u0435 \u0432\u043E\u0441\u0435\u043C\u044C \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0431\u0440\u043E\u0441\u0438\u043B\u0438\u0441\u044C \u0443\u043A\u0440\u044B\u0432\u0430\u0442\u044C
      \u043C\u0435\u0448\u043A\u0438 \u0432\u043E\u0439\u043B\u043E\u043A\u043E\u043C.
      \u0411\u043E\u043B\u044C\u0448\u0443\u044E \u0447\u0430\u0441\u0442\u044C \u0443\u0441\u043F\u0435\u043B\u0438.
      \u041C\u0435\u043D\u044C\u0448\u0443\u044E - \u043D\u0435\u0442: \u0441\u0430\u0440\u0430\u043D\u0447\u0430
      \u0435\u043B\u0430 \u0442\u043E, \u0447\u0442\u043E \u0442\u043E\u0440\u0447\u0430\u043B\u043E
      \u043D\u0430\u0440\u0443\u0436\u0443. \u0416\u0438\u0432\u043E\u0442\u043D\u044B\u0445
      \u043A\u043E\u0440\u043C\u0438\u0442\u044C \u043D\u0435\u0447\u0435\u043C \u0441\u0435\u0433\u043E\u0434\u043D\u044F,
      \u0437\u0430\u0432\u0442\u0440\u0430 \u043D\u0430\u0434\u043E \u043D\u0430\u0439\u0442\u0438
      \u043F\u0430\u0441\u0442\u0431\u0438\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684252
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u043E\u0442\u0435\u0440\u0438
      \u0438 \u0438\u0434\u0442\u0438 \u0432\u043F\u0435\u0440\u0451\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684253
    m_Localized: "\u041D\u0435 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u043B\u0438\u0441\u044C.
      \u0421\u0430\u0440\u0430\u043D\u0447\u0430 \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u0430
      \u0437\u0430 \u043E\u0431\u043E\u0437\u043E\u043C \u0447\u0430\u0441, \u043F\u043E\u0442\u043E\u043C
      \u0440\u0430\u0441\u0441\u0435\u044F\u043B\u0430\u0441\u044C. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043C\u043D\u043E\u0433\u043E \u0444\u0443\u0440\u0430\u0436\u0430 - \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435
      \u0443\u0441\u0442\u0430\u043B\u0438 \u0440\u0430\u043D\u044C\u0448\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E,
      \u0438 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u0434\u0432\u0430
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0442\u044F\u0436\u0435\u043B\u0435\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684254
    m_Localized: "\u041B\u0435\u0434\u044F\u043D\u043E\u0439 \u0433\u0440\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684255
    m_Localized: "\u041D\u0435\u0431\u043E \u043F\u043E\u0442\u0435\u043C\u043D\u0435\u043B\u043E
      \u0432 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u043C\u0438\u043D\u0443\u0442.
      \u041F\u0435\u0440\u0432\u044B\u0435 \u0433\u0440\u0430\u0434\u0438\u043D\u044B
      - \u0441 \u043D\u043E\u0433\u043E\u0442\u044C \u043C\u0438\u0437\u0438\u043D\u0446\u0430,
      \u043F\u043E\u0442\u043E\u043C \u0432\u0441\u0451 \u043A\u0440\u0443\u043F\u043D\u0435\u0435.
      \u0416\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u0448\u0430\u0440\u0430\u0445\u043D\u0443\u043B\u0438\u0441\u044C
      \u0438 \u0441\u0431\u0438\u043B\u0438\u0441\u044C \u0432 \u043A\u0443\u0447\u0443.
      \u0423\u0434\u0430\u0440\u044B \u043F\u043E \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u043C
      \u0431\u043E\u0440\u0442\u0430\u043C \u043F\u043E\u0432\u043E\u0437\u043E\u043A
      - \u043A\u0430\u043A \u043A\u0430\u043C\u043D\u0438 \u0438\u0437 \u043F\u0440\u0430\u0449\u0438.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u0441\u043A\u0443\u043B\u044F\u0442
      \u043D\u0438\u0437\u043A\u043E \u0438 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E.
      \u041B\u044E\u0434\u0438 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u044E\u0442
      \u0433\u043E\u043B\u043E\u0432\u044B \u0447\u0435\u043C \u043F\u043E\u043F\u0430\u043B\u043E.
      \u0413\u0440\u0430\u0434\u0438\u043D\u044B \u0432\u0435\u043B\u0438\u0447\u0438\u043D\u043E\u0439
      \u0441 \u0433\u043E\u043B\u0443\u0431\u0438\u043D\u043E\u0435 \u044F\u0439\u0446\u043E
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442 \u0441\u0438\u043D\u044F\u043A\u0438
      \u0434\u0430\u0436\u0435 \u0441\u043A\u0432\u043E\u0437\u044C \u0445\u0430\u043B\u0430\u0442.
      \u0413\u0440\u0443\u0437 \u043F\u043E\u0434 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C
      \u043D\u0435\u0431\u043E\u043C - \u0444\u0430\u0440\u0444\u043E\u0440, \u0441\u0442\u0435\u043A\u043B\u044F\u043D\u043D\u044B\u0435
      \u0444\u043B\u0430\u043A\u043E\u043D\u044B - \u0432 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684256
    m_Localized: "\u0423\u043A\u0440\u044B\u0442\u044C \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445
      \u043F\u043E\u0434 \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u043C \u043A\u043E\u0437\u044B\u0440\u044C\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684257
    m_Localized: "\u0421\u043A\u0430\u043B\u0430 \u0432 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u0438
      \u0448\u0430\u0433\u0430\u0445. \u0417\u0430\u0432\u0435\u043B\u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432
      \u043F\u043E\u0434 \u043A\u043E\u0437\u044B\u0440\u0451\u043A - \u0435\u0434\u0432\u0430
      \u043F\u043E\u043C\u0435\u0441\u0442\u0438\u043B\u0438\u0441\u044C. \u041F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0441\u043D\u0430\u0440\u0443\u0436\u0438,
      \u0431\u043E\u0440\u0442\u0430 \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u043B\u0438\u0441\u044C
      \u043E\u0442 \u0443\u0434\u0430\u0440\u043E\u0432. \u041D\u043E \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435
      \u0446\u0435\u043B\u044B, \u0430 \u0431\u0435\u0437 \u043D\u0438\u0445 \u043D\u0435\u0442
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684258
    m_Localized: "\u041D\u0430\u043A\u0440\u044B\u0442\u044C \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043A\u043E\u0448\u043C\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684259
    m_Localized: "\u0412\u043E\u0439\u043B\u043E\u043A \u043F\u0440\u0438\u043D\u044F\u043B
      \u0443\u0434\u0430\u0440: \u0445\u0440\u0443\u043F\u043A\u0438\u0439 \u0433\u0440\u0443\u0437
      \u0443\u0446\u0435\u043B\u0435\u043B. \u041D\u043E \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438
      \u0441\u0432\u043E\u044E \u0434\u043E\u043B\u044E, \u0430 \u043B\u044E\u0434\u0438
      \u043F\u043E\u0431\u0438\u0442\u044B. \u0417\u0430\u0442\u043E \u0444\u0430\u0440\u0444\u043E\u0440\u043E\u0432\u044B\u0435
      \u0447\u0430\u0448\u043A\u0438 \u0432 \u0442\u044E\u043A\u0430\u0445 \u0434\u043E\u0448\u043B\u0438
      \u0434\u043E \u0433\u043E\u0440\u043E\u0434\u0430 \u0446\u0435\u043B\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684260
    m_Localized: "\u041E\u0442\u043E\u0433\u043D\u0430\u0442\u044C \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445
      \u0432 \u0445\u0432\u043E\u0441\u0442 \u043A\u043E\u043B\u043E\u043D\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684261
    m_Localized: "\u0416\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u0437\u0430\u0432\u0435\u0440\u043D\u0443\u043B\u0438
      \u043D\u0430\u0437\u0430\u0434, \u043D\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E \u0442\u0430\u043C \u0431\u044B\u043B\u043E
      \u043D\u0435 \u043B\u0443\u0447\u0448\u0435. \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u041A\u044E\u043B\u044C-\u0431\u0430\u0442\u0443\u0440 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439 \u043F\u043E\u0440\u0435\u0437
      \u043E\u0442 \u043E\u0441\u0442\u0440\u043E\u0439 \u0433\u0440\u0430\u0434\u0438\u043D\u044B
      \u043F\u043E \u0441\u043A\u0443\u043B\u0435. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043F\u0435\u0440\u0435\u043F\u0443\u0433\u0430\u043B\u0438\u0441\u044C \u0438
      \u0440\u0430\u0437\u0431\u0435\u0436\u0430\u043B\u0438\u0441\u044C - \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0438
      \u043F\u043E\u043B\u0447\u0430\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684262
    m_Localized: "\u0422\u0440\u044F\u0441\u0438\u043D\u0430 \u0443 \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u0448\u0435\u0433\u043E
      \u043E\u0437\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684263
    m_Localized: "\u0414\u043D\u043E \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u0448\u0435\u0433\u043E
      \u043E\u0437\u0435\u0440\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u043E
      \u0442\u0432\u0451\u0440\u0434\u044B\u043C: \u0441\u0435\u0440\u0430\u044F
      \u043A\u043E\u0440\u043A\u0430, \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u0432\u0448\u0430\u044F\u0441\u044F
      \u0437\u0438\u0433\u0437\u0430\u0433\u0430\u043C\u0438. \u041F\u0435\u0440\u0432\u044B\u0439
      \u044F\u043A \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0441\u044F \u043F\u043E
      \u043A\u043E\u043B\u0435\u043D\u043E - \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E,
      \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F.
      \u041D\u0430\u0447\u0430\u043B \u0434\u0451\u0440\u0433\u0430\u0442\u044C\u0441\u044F
      \u0438 \u043F\u043E\u0433\u0440\u0443\u0437\u0438\u043B\u0441\u044F \u0433\u043B\u0443\u0431\u0436\u0435.
      \u0417\u0430 \u043D\u0438\u043C - \u043F\u043E\u0432\u043E\u0437\u043A\u0430,
      \u043A\u043E\u043B\u0451\u0441\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u0448\u043B\u0438 \u0441\u043B\u0435\u0434\u043E\u043C. \u041F\u043E\u0434
      \u043A\u043E\u0440\u043A\u043E\u0439 - \u0432\u043B\u0430\u0436\u043D\u044B\u0439
      \u0438\u043B, \u043C\u044F\u0433\u043A\u0438\u0439 \u043A\u0430\u043A \u043C\u0430\u0441\u043B\u043E.
      \u0421\u043E\u043B\u043D\u0446\u0435 \u0443\u0436\u0435 \u0432\u044B\u0441\u043E\u043A\u043E,
      \u0436\u0430\u0440\u0430 \u0434\u0430\u0432\u0438\u0442. \u0422\u0440\u0438
      \u044F\u043A\u0430 \u0443\u0432\u044F\u0437\u043B\u0438. \u041E\u0431\u043E\u0437
      \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u043A\u0440\u0430\u044E \u0443\u0447\u0430\u0441\u0442\u043A\u0430,
      \u043D\u0435 \u0437\u043D\u0430\u044F \u0433\u0434\u0435 \u0442\u0432\u0451\u0440\u0434\u043E,
      \u0430 \u0433\u0434\u0435 \u0441\u043D\u043E\u0432\u0430 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684264
    m_Localized: "\u0420\u0443\u0431\u0438\u0442\u044C \u0436\u0435\u0440\u0434\u0438
      - \u043D\u0430\u0441\u0442\u0438\u043B\u0430\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684265
    m_Localized: "\u0420\u0430\u0437\u043E\u0431\u0440\u0430\u043B\u0438 \u0431\u043E\u0440\u0442
      \u043E\u0434\u043D\u043E\u0439 \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043D\u0430
      \u0434\u043E\u0441\u043A\u0438, \u043D\u0430\u0431\u0440\u043E\u0441\u0430\u043B\u0438
      \u0432\u043F\u0435\u0440\u0451\u0434. \u041F\u043E \u043D\u0430\u0441\u0442\u0438\u043B\u0443
      \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438 \u044F\u043A\u043E\u0432 \u0438
      \u043F\u0440\u043E\u0432\u0435\u043B\u0438 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0431\u043E\u0440\u0442 \u0438 \u043F\u043E\u043B\u0434\u043D\u044F, \u0437\u0430\u0442\u043E
      \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438 \u0432\u0441\u0435\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684266
    m_Localized: "\u0412\u044B\u043F\u0440\u044F\u0447\u044C \u044F\u043A\u043E\u0432
      - \u0442\u0430\u0449\u0438\u0442\u044C \u043F\u0443\u0441\u0442\u044B\u0435
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684267
    m_Localized: "\u0416\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u0432\u044B\u0432\u0435\u043B\u0438
      \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443, \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E.
      \u041F\u0443\u0441\u0442\u044B\u0435 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0442\u044F\u043D\u0443\u043B\u0438 \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u043C\u0438
      \u0441 \u0442\u0432\u0451\u0440\u0434\u043E\u0433\u043E \u0431\u0435\u0440\u0435\u0433\u0430.
      \u0414\u043E\u043B\u0433\u043E \u0438 \u0442\u044F\u0436\u0435\u043B\u043E,
      \u043D\u043E \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u043E. \u041E\u0434\u0438\u043D
      \u0432\u0430\u043B \u0438\u043B\u0430 \u0432\u0441\u0451 \u0436\u0435 \u043F\u043E\u0433\u043B\u043E\u0442\u0438\u043B
      \u043A\u043E\u043B\u0435\u0441\u043E - \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0431\u0440\u043E\u0441\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684268
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u043E\u0434\u043D\u0443
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443 - \u0441\u043F\u0430\u0441\u0442\u0438
      \u044F\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684269
    m_Localized: "\u041F\u043E\u0432\u043E\u0437\u043A\u0443 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      - \u0442\u043E\u0432\u0430\u0440 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
      \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u0438\u043B\u0438 \u043D\u0430
      \u0434\u0440\u0443\u0433\u0438\u0445, \u0447\u0430\u0441\u0442\u044C \u043F\u043E\u0442\u043E\u043D\u0443\u043B\u0430.
      \u042F\u043A\u043E\u0432 \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438 \u043D\u0430
      \u0442\u0432\u0451\u0440\u0434\u043E\u0435 \u043C\u0435\u0441\u0442\u043E.
      \u0411\u0435\u0437 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u043D\u0435\u0442; \u0433\u0440\u0443\u0437 \u043C\u043E\u0436\u043D\u043E
      \u0434\u043E\u043A\u0443\u043F\u0438\u0442\u044C \u0432 \u0433\u043E\u0440\u043E\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684270
    m_Localized: "\u041B\u0451\u0434 \u0442\u0440\u0435\u0441\u043D\u0443\u043B \u043F\u043E\u0434
      \u043F\u043E\u0432\u043E\u0437\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684271
    m_Localized: "\u0417\u0438\u043C\u043D\u044F\u044F \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430:
      \u043B\u0451\u0434 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u043C
      - \u0441\u0438\u043D\u0435\u0432\u0430\u0442\u043E-\u0441\u0435\u0440\u044B\u0439,
      \u0431\u0435\u0437 \u043F\u0443\u0441\u0442\u043E\u0442. \u041F\u0435\u0440\u0432\u044B\u0435
      \u0442\u0440\u0438 \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043F\u0440\u043E\u0448\u043B\u0438
      \u0431\u0435\u0437 \u043F\u0440\u043E\u0431\u043B\u0435\u043C. \u0427\u0435\u0442\u0432\u0451\u0440\u0442\u0430\u044F,
      \u0442\u044F\u0436\u0435\u043B\u043E\u0433\u0440\u0443\u0436\u0451\u043D\u0430\u044F,
      \u043D\u0430 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u0440\u0435\u043A\u0438
      \u0438\u0437\u0434\u0430\u043B\u0430 \u0437\u0432\u0443\u043A \u0440\u0430\u0441\u043A\u0430\u043B\u044B\u0432\u0430\u044E\u0449\u0435\u0433\u043E\u0441\u044F
      \u0434\u0435\u0440\u0435\u0432\u0430 - \u0438 \u043E\u0441\u0435\u043B\u0430
      \u043D\u0430 \u043F\u043E\u043B\u043A\u043E\u043B\u0435\u0441\u0430 \u0432
      \u0432\u043E\u0434\u0443. \u041B\u0451\u0434 \u0434\u0435\u0440\u0436\u0438\u0442,
      \u043D\u043E \u0442\u0440\u0435\u0449\u0438\u043D\u0430 \u0440\u0430\u0441\u0445\u043E\u0434\u0438\u0442\u0441\u044F.
      \u0412\u043E\u0434\u0430 \u0432 \u0440\u0435\u043A\u0435 \u043F\u043E \u0433\u0440\u0443\u0434\u044C
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443, \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430
      - \u0431\u043B\u0438\u0437\u043A\u043E \u043A \u043D\u0443\u043B\u044E. \u041F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u044B\u0439
      \u0431\u0435\u0440\u0435\u0433 \u0432 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u0438
      \u0448\u0430\u0433\u0430\u0445. \u041E\u0431\u043E\u0437 \u043D\u0430 \u044D\u0442\u043E\u043C
      \u0431\u0435\u0440\u0435\u0433\u0443 \u0437\u0430\u043C\u0435\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684272
    m_Localized: "\u041E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C - \u0438\u0441\u043A\u0430\u0442\u044C
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0431\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684273
    m_Localized: "\u0427\u0435\u0442\u0432\u0451\u0440\u0442\u0443\u044E \u043F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u0441\u0434\u0430\u043B\u0438
      \u043D\u0430\u0437\u0430\u0434 - \u0442\u0440\u0435\u0449\u0438\u043D\u0430
      \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u043B\u0430\u0441\u044C, \u043D\u043E
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E. \u041D\u0430\u0448\u043B\u0438
      \u0431\u0440\u043E\u0434 \u0432 \u0434\u0432\u0443\u0445 \u043B\u0438 \u0432\u044B\u0448\u0435
      - \u043D\u0435\u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439, \u043D\u043E
      \u043B\u0435\u0434\u044F\u043D\u043E\u0439 \u0432\u043E\u0434\u044B \u043F\u043E
      \u0433\u043E\u043B\u0435\u043D\u044C. \u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u0438\u0441\u044C
      \u0437\u0430 \u0442\u0440\u0438 \u0447\u0430\u0441\u0430 \u0441 \u043F\u043E\u0442\u0435\u0440\u0435\u0439
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0438 \u043D\u0435\u0440\u0432\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684274
    m_Localized: "\u0420\u0430\u0437\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0438 \u043F\u0440\u043E\u0432\u0435\u0437\u0442\u0438 \u043D\u0430\u043B\u0435\u0433\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684275
    m_Localized: "\u0422\u044E\u043A\u0438 \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u043B\u0438
      \u043F\u043E \u043B\u044C\u0434\u0443 \u0432\u0440\u0443\u0447\u043D\u0443\u044E.
      \u041F\u0443\u0441\u0442\u0430\u044F \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043F\u0440\u043E\u0448\u043B\u0430 \u0431\u0435\u0437 \u043F\u0440\u043E\u0431\u043B\u0435\u043C.
      \u0413\u0440\u0443\u0437 \u0442\u043E\u0436\u0435 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u0438
      - \u0445\u043E\u043B\u043E\u0434\u043D\u043E, \u0441\u043A\u043E\u043B\u044C\u0437\u043A\u043E,
      \u043E\u0434\u0438\u043D \u0442\u044E\u043A \u0443\u043F\u0430\u043B \u0432
      \u0432\u043E\u0434\u0443. \u0412\u0441\u0451 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u0446\u0435\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684276
    m_Localized: "\u0422\u044F\u043D\u0443\u0442\u044C \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u043C\u0438
      \u0441 \u043E\u0431\u043E\u0438\u0445 \u0431\u0435\u0440\u0435\u0433\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684277
    m_Localized: "\u0427\u0435\u0442\u044B\u0440\u0435 \u0432\u0435\u0440\u0451\u0432\u043A\u0438
      \u0441 \u043E\u0431\u043E\u0438\u0445 \u0431\u0435\u0440\u0435\u0433\u043E\u0432.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0443 \u0442\u044F\u043D\u0443\u043B\u0438
      \u0440\u043E\u0432\u043D\u043E, \u043D\u0435 \u0434\u0430\u0432\u0430\u044F
      \u043A\u0430\u0447\u0430\u0442\u044C\u0441\u044F. \u041B\u0451\u0434 \u0445\u0440\u0443\u0441\u0442\u0435\u043B,
      \u043D\u043E \u0434\u0435\u0440\u0436\u0430\u043B. \u0417\u0430 \u0434\u0435\u0441\u044F\u0442\u044C
      \u043C\u0438\u043D\u0443\u0442 \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438
      \u043D\u0430 \u0442\u043E\u0442 \u0431\u0435\u0440\u0435\u0433. \u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438
      \u0441\u043B\u043E\u0436\u043D\u043E - \u043D\u043E \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u043E
      \u0447\u0438\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684278
    m_Localized: "\u041E\u0430\u0437\u0438\u0441 \u043F\u0435\u0440\u0435\u0441\u043E\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684279
    m_Localized: "\u041F\u0430\u043B\u044C\u043C\u044B \u0441\u0442\u043E\u044F\u0442,
      \u043D\u043E \u043B\u0438\u0441\u0442\u044C\u044F \u0441\u0435\u0440\u044B\u0435
      \u043E\u0442 \u043F\u044B\u043B\u0438 - \u0431\u0435\u0437 \u0432\u043B\u0430\u0433\u0438
      \u0441 \u0432\u0435\u0441\u043D\u044B. \u041A\u043E\u043B\u043E\u0434\u0435\u0446,
      \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u043B\u0438,
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043F\u0443\u0441\u0442\u044B\u043C
      \u0433\u043B\u0430\u0437\u043E\u043C \u0432\u043E\u0441\u044C\u043C\u0438 \u043B\u043E\u043A\u0442\u0435\u0439
      \u0433\u043B\u0443\u0431\u0438\u043D\u043E\u0439 \u0438 \u0441\u0443\u0445\u0438\u043C
      \u0434\u043D\u043E\u043C. \u0411\u0443\u0433\u0430 \u043A\u0438\u0434\u0430\u0435\u0442
      \u043A\u0430\u043C\u0435\u043D\u044C - \u0437\u0432\u0443\u043A \u0433\u043B\u0443\u0445\u043E\u0439,
      \u043D\u0438\u043A\u0430\u043A\u043E\u0439 \u0432\u043E\u0434\u044B. \u0412
      \u043E\u0431\u043E\u0437\u0435 \u0432\u043E\u0434\u044B \u043D\u0430 \u0434\u0432\u0430
      \u0434\u043D\u044F \u043F\u0440\u0438 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0438.
      \u0414\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430 - \u0447\u0435\u0442\u044B\u0440\u0435
      \u0434\u043D\u044F \u043F\u0443\u0442\u0438. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u0443\u0436\u0435 \u043F\u044C\u044E\u0442 \u0434\u0430\u0432\u043D\u043E,
      \u043B\u044E\u0434\u0438 \u044D\u043A\u043E\u043D\u043E\u043C\u044F\u0442.
      \u0421\u043E\u043B\u043D\u0446\u0435 \u0432 \u0437\u0435\u043D\u0438\u0442\u0435,
      \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u043F\u044F\u0442\u044C \u043F\u043E
      \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684280
    m_Localized: "\u0420\u0430\u0446\u0438\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      - \u0438\u0434\u0442\u0438 \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0441\u0442\u043E\u044F\u043D\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684281
    m_Localized: "\u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u043D\u043E\u0440\u043C\u044B
      \u0432\u043E\u0434\u044B. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043D\u0435\u0441\u0443\u0442 \u0431\u0435\u0437 \u0436\u0430\u043B\u043E\u0431
      - \u043E\u043D\u0438 \u043C\u043E\u0433\u0443\u0442. \u041B\u044E\u0434\u0438
      \u0441\u0442\u0440\u0430\u0434\u0430\u044E\u0442 \u043C\u043E\u043B\u0447\u0430.
      \u041D\u0430 \u0442\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C
      \u0443 \u043B\u0435\u043A\u0430\u0440\u044F \u041F\u0435\u043C\u0431\u044B
      \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u043B\u043E \u0433\u043E\u0440\u043B\u043E
      \u0442\u0430\u043A, \u0447\u0442\u043E \u043E\u043D \u0435\u0434\u0432\u0430
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B. \u041A \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u043E\u043C\u0443
      \u0434\u043D\u044E \u043D\u0430\u0448\u043B\u0438 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A.
      \u0414\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684282
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0432\u043E\u0434\u0443 \u0443
      \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u043E\u0432 \u0437\u0430 \u043B\u044E\u0431\u0443\u044E
      \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684283
    m_Localized: "\u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0439 \u043F\u0430\u0441\u0442\u0443\u0445
      \u0411\u0438\u043B\u044C\u0433\u044D \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
      \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435 \u043D\u0430
      \u0442\u0440\u0435\u0442\u0438\u0439 \u0447\u0430\u0441 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F.
      \u0417\u0430\u043F\u0440\u043E\u0441\u0438\u043B \u0432 \u0447\u0435\u0442\u044B\u0440\u0435
      \u0440\u0430\u0437\u0430 \u0434\u043E\u0440\u043E\u0436\u0435 \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439
      \u0446\u0435\u043D\u044B. \u0417\u0430\u043F\u043B\u0430\u0442\u0438\u043B\u0438
      \u0431\u0435\u0437 \u0442\u043E\u0440\u0433\u0430. \u0412\u043E\u0434\u0430
      \u0435\u0441\u0442\u044C - \u044D\u0442\u043E \u0432\u0430\u0436\u043D\u0435\u0435
      \u043C\u043E\u043D\u0435\u0442 \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684284
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u043B\u044E\u0434\u0435\u0439
      \u043D\u0430\u043B\u0435\u0433\u043A\u0435 \u0432\u043F\u0435\u0440\u0451\u0434
      \u0437\u0430 \u0432\u043E\u0434\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684285
    m_Localized: "\u0422\u0440\u043E\u0435 \u0443\u0448\u043B\u0438 \u043D\u0430\u043B\u0435\u0433\u043A\u0435
      \u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u0447\u0435\u0440\u0435\u0437
      \u0434\u0435\u043D\u044C \u0441 \u0431\u0443\u0440\u0434\u044E\u043A\u0430\u043C\u0438.
      \u041E\u0431\u043E\u0437 \u0436\u0434\u0430\u043B \u043F\u043E\u0434 \u043F\u0430\u043B\u044C\u043C\u0430\u043C\u0438,
      \u044D\u043A\u043E\u043D\u043E\u043C\u044F \u0432\u043E\u0434\u0443. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0434\u0435\u043D\u044C, \u043D\u043E \u0432\u0441\u0435 \u0434\u043E\u0448\u043B\u0438
      \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C. \u0421\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0432 \u043A\u0440\u0438\u0437\u0438\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684286
    m_Localized: "\u0421\u043C\u0435\u0440\u0447 \u0440\u0430\u0437\u043C\u0435\u0442\u0430\u043B
      \u043B\u0430\u0433\u0435\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684287
    m_Localized: "\u041F\u0435\u0441\u0447\u0430\u043D\u044B\u0439 \u0441\u0442\u043E\u043B\u0431
      \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u0438\u0437 \u043D\u0438\u043E\u0442\u043A\u0443\u0434\u0430
      - \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439,
      \u0432\u043E\u044E\u0449\u0438\u0439, \u0441 \u043A\u0443\u043B\u0430\u043A
      \u0448\u0438\u0440\u0438\u043D\u043E\u0439 \u0443 \u0437\u0435\u043C\u043B\u0438
      \u0438 \u0442\u0440\u0438 \u0434\u0435\u0440\u0435\u0432\u0430 \u0432\u044B\u0441\u043E\u0442\u043E\u0439.
      \u0417\u0430 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0441\u0435\u043A\u0443\u043D\u0434
      \u043E\u043D \u043F\u0440\u043E\u0448\u0451\u043B \u0447\u0435\u0440\u0435\u0437
      \u043B\u0430\u0433\u0435\u0440\u044C \u0438 \u0443\u043D\u0451\u0441 \u0441
      \u0441\u043E\u0431\u043E\u0439 \u043B\u0451\u0433\u043A\u0438\u0435 \u0442\u044E\u043A\u0438,
      \u043A\u043E\u0448\u043C\u044B, \u043E\u0434\u0438\u043D \u0448\u0430\u0442\u0440\u043E\u0432\u044B\u0439
      \u043F\u043E\u043B\u043E\u0433 \u0438 \u0441\u0443\u043C\u043A\u0443 \u0441
      \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u043C\u0438
      \u0441\u0432\u0438\u0442\u043A\u0430\u043C\u0438. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043B\u0435\u0436\u0430\u043B\u0438 \u043D\u0430 \u0437\u0435\u043C\u043B\u0435
      - \u043E\u043D\u0438 \u0447\u0443\u044E\u0442 \u0442\u0430\u043A\u0438\u0435
      \u0432\u0435\u0449\u0438 \u0437\u0430\u0440\u0430\u043D\u0435\u0435 \u0438
      \u043B\u043E\u0436\u0430\u0442\u0441\u044F \u0441\u0430\u043C\u0438. \u041B\u044E\u0434\u0438
      \u043F\u0430\u0434\u0430\u043B\u0438. \u041F\u043E\u0442\u043E\u043C \u0442\u0438\u0448\u0438\u043D\u0430,
      \u043F\u044B\u043B\u044C \u043E\u0441\u0435\u0434\u0430\u0435\u0442, \u043B\u0430\u0433\u0435\u0440\u044C
      \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043A\u0430\u043A \u043F\u043E\u0441\u043B\u0435
      \u043D\u0430\u043B\u0451\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684288
    m_Localized: "\u041B\u0435\u0447\u044C \u0438 \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C
      - \u043D\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684289
    m_Localized: "\u0412\u0441\u0435 \u0443\u043F\u0430\u043B\u0438 \u0432\u043E\u0432\u0440\u0435\u043C\u044F.
      \u0421\u043C\u0435\u0440\u0447 \u043F\u0440\u043E\u0448\u0451\u043B \u043F\u043E\u0432\u0435\u0440\u0445\u0443
      \u0438 \u0443\u0448\u0451\u043B. \u041A\u043E\u0448\u043C\u044B \u0441\u043D\u0435\u0441\u043B\u043E
      - \u043D\u0430\u0448\u043B\u0438 \u0432 \u0441\u0442\u0430 \u0448\u0430\u0433\u0430\u0445.
      \u041D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0435
      \u0441\u0432\u0438\u0442\u043A\u0438 \u0443\u043B\u0435\u0442\u0435\u043B\u0438
      \u0431\u0435\u0437\u0432\u043E\u0437\u0432\u0440\u0430\u0442\u043D\u043E. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0431\u0443\u043C\u0430\u0433\u0443 \u0438 \u0447\u0430\u0441\u0442\u044C
      \u0431\u044B\u0442\u0430, \u043B\u044E\u0434\u0438 \u0446\u0435\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684290
    m_Localized: "\u041B\u043E\u0432\u0438\u0442\u044C \u0440\u0430\u0437\u043B\u0435\u0442\u0430\u044E\u0449\u0438\u0439\u0441\u044F
      \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684291
    m_Localized: "\u0414\u0432\u043E\u0435 \u043F\u043E\u0431\u0435\u0436\u0430\u043B\u0438
      \u0437\u0430 \u0442\u044E\u043A\u0430\u043C\u0438 \u0438 \u043F\u043E\u0439\u043C\u0430\u043B\u0438
      \u0447\u0430\u0441\u0442\u044C. \u0422\u0440\u0435\u0442\u0438\u0439 \u043F\u043E\u043F\u0430\u043B
      \u0432 \u043A\u0440\u0430\u0439 \u0441\u043C\u0435\u0440\u0447\u0430 \u0438
      \u0443\u043F\u0430\u043B, \u043E\u0431\u043E\u0434\u0440\u0430\u0432 \u0440\u0443\u043A\u0438
      \u043E \u043A\u0430\u043C\u043D\u0438. \u0412\u0435\u0440\u043D\u0443\u043B\u0438
      \u0447\u0435\u0442\u044B\u0440\u0435 \u0442\u044E\u043A\u0430 \u0438\u0437
      \u0432\u043E\u0441\u044C\u043C\u0438 \u0443\u043D\u0435\u0441\u0451\u043D\u043D\u044B\u0445
      - \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0438\u0441\u0447\u0435\u0437\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684292
    m_Localized: "\u041F\u0440\u0438\u0432\u044F\u0437\u0430\u0442\u044C \u0432\u0441\u0451
      \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0438
      \u0441\u0442\u043E\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684293
    m_Localized: "\u0412\u043C\u0435\u0441\u0442\u043E \u043F\u043E\u0433\u043E\u043D\u0438
      \u0437\u0430 \u0443\u043B\u0435\u0442\u0435\u0432\u0448\u0438\u043C \u0437\u0430\u043D\u044F\u043B\u0438\u0441\u044C
      \u0442\u0435\u043C, \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C:
      \u0432\u0435\u0440\u0451\u0432\u043A\u0438, \u0443\u0437\u043B\u044B, \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043F\u0440\u0438\u0436\u0430\u043B\u0438 \u043A \u0437\u0435\u043C\u043B\u0435.
      \u0421\u043C\u0435\u0440\u0447 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      - \u0441\u043B\u0430\u0431\u0435\u0435, \u043D\u043E \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F.
      \u0412\u0442\u043E\u0440\u043E\u0439 \u0440\u0430\u0437 \u043F\u0440\u043E\u0448\u0451\u043B
      \u043F\u043E\u0447\u0442\u0438 \u0431\u0435\u0437 \u0443\u0449\u0435\u0440\u0431\u0430.
      \u0423\u043C\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440 \u0432 \u0445\u0430\u043E\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684294
    m_Localized: "\u0411\u0443\u0440\u044F \u0441\u0440\u0435\u0434\u0438 \u043B\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684295
    m_Localized: "\u041C\u0435\u0441\u044F\u0446 \u0436\u0430\u0442\u0432\u044B,
      \u0440\u0430\u0437\u0433\u0430\u0440 \u043B\u0435\u0442\u0430 - \u0438 \u0441\u043D\u0435\u0433.
      \u041D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435 \u0441\u0435\u043C\u0438
      \u0442\u044B\u0441\u044F\u0447 \u043B\u043E\u043A\u0442\u0435\u0439 \u0432\u044B\u0441\u043E\u0442\u044B
      \u0437\u0438\u043C\u0430 \u043D\u0435 \u0437\u043D\u0430\u0435\u0442 \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u0435\u0439.
      \u0412\u0435\u0442\u0435\u0440 \u043F\u0440\u0438\u0448\u0451\u043B \u0441
      \u0441\u0435\u0432\u0435\u0440\u0430 \u0440\u0435\u0437\u043A\u0438\u0439 \u0438
      \u043C\u043E\u043A\u0440\u044B\u0439, \u0438 \u0447\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441 \u0431\u0435\u043B\u043E\u0435 \u043C\u0435\u0441\u0438\u0432\u043E
      \u0443\u0436\u0435 \u0437\u0430\u043B\u0435\u043F\u043B\u044F\u043B\u043E \u0433\u043B\u0430\u0437\u0430.
      \u0422\u0440\u043E\u043F\u0430 \u0441\u0442\u0430\u043B\u0430 \u0441\u043A\u043E\u043B\u044C\u0437\u043A\u043E\u0439.
      \u0422\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0443\u043F\u0430\u043B\u0430
      \u0442\u0430\u043A \u0431\u044B\u0441\u0442\u0440\u043E, \u0447\u0442\u043E
      \u043F\u0440\u043E\u043C\u0451\u0440\u0437\u0448\u0438\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0411\u0443\u0433\u0430 \u0441\u043A\u0430\u0437\u0430\u043B \u0442\u043E\u043B\u044C\u043A\u043E:
      <npc_speech lang=\"Turkic\">\u041F\u043B\u043E\u0445\u043E.</npc_speech> \u0412\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u044C
      - \u0434\u0435\u0441\u044F\u0442\u044C \u0448\u0430\u0433\u043E\u0432. \u0412\u043F\u0435\u0440\u0435\u0434\u0438
      - \u043B\u0438\u0431\u043E \u0441\u043A\u0430\u043B\u0430 \u0441 \u0443\u043A\u0440\u044B\u0442\u0438\u0435\u043C,
      \u043B\u0438\u0431\u043E \u043F\u0435\u0449\u0435\u0440\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043B \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684296
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C
      \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684297
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u043B\u0438 \u0448\u0430\u0442\u0440\u044B
      \u0437\u0430 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u043C\u0438\u043D\u0443\u0442
      \u043D\u0430 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0440\u043E\u0432\u043D\u043E\u043C \u0443\u0447\u0430\u0441\u0442\u043A\u0435.
      \u0411\u0443\u0440\u044F \u0433\u0440\u0435\u043C\u0435\u043B\u0430 \u0434\u0432\u043E\u0435
      \u0441\u0443\u0442\u043E\u043A. \u0415\u0434\u0443 \u0432\u0430\u0440\u0438\u043B\u0438
      \u043D\u0430 \u0443\u0433\u043B\u044F\u0445 \u0432\u043D\u0443\u0442\u0440\u0438.
      \u0412\u044B\u0448\u043B\u0438 \u043D\u0430 \u0442\u0440\u0435\u0442\u0438\u0439
      \u0434\u0435\u043D\u044C - \u0432\u0441\u0451 \u0431\u044B\u043B\u043E \u0437\u0430\u043D\u0435\u0441\u0435\u043D\u043E
      \u0441\u043D\u0435\u0433\u043E\u043C \u043F\u043E \u043A\u043E\u043B\u0435\u043D\u043E,
      \u043D\u043E \u0436\u0438\u0432\u044B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684298
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      - \u043F\u0440\u043E\u0439\u0442\u0438 \u043F\u0435\u0440\u0435\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684299
    m_Localized: "\u0428\u043B\u0438 \u0435\u0449\u0451 \u0434\u0432\u0430 \u0447\u0430\u0441\u0430
      \u0432 \u0441\u043D\u0435\u0436\u043D\u043E\u0439 \u043C\u0433\u043B\u0435.
      \u0422\u0440\u043E\u043F\u0430 \u043F\u043E\u0447\u0442\u0438 \u0438\u0441\u0447\u0435\u0437\u043B\u0430.
      \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u041D\u0430\u043D\u0430\u043C
      \u0443\u043F\u0430\u043B \u043D\u0430 \u043A\u0440\u0430\u044E \u0441\u043A\u043B\u043E\u043D\u0430
      - \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043E\u0434\u043D\u0443 \u043F\u043E\u0432\u043E\u0437\u043A\u0443 \u0432
      \u0441\u043D\u0435\u0433\u0443. \u041A \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0443
      \u0432\u044B\u0448\u043B\u0438 - \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0435
      \u0438 \u0438\u0437\u043D\u0443\u0440\u0451\u043D\u043D\u044B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684300
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u043F\u0435\u0449\u0435\u0440\u0443
      - \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C \u0442\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684301
    m_Localized: "\u041F\u0435\u0449\u0435\u0440\u0430 \u043D\u0430\u0448\u043B\u0430\u0441\u044C
      \u0432 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u0438 \u043C\u0438\u043D\u0443\u0442\u0430\u0445
      \u0445\u043E\u0434\u0430 \u043E\u0442 \u0442\u0440\u043E\u043F\u044B - \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F,
      \u043D\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u0430\u044F. \u0417\u0430\u0432\u0435\u043B\u0438
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432, \u0440\u0430\u0437\u043E\u0436\u0433\u043B\u0438
      \u043A\u043E\u0441\u0442\u0451\u0440 \u0438\u0437 \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0433\u043E
      \u0434\u0435\u0440\u0435\u0432\u0430. \u0421\u0438\u0434\u0435\u043B\u0438
      \u0441\u0443\u0442\u043A\u0438. \u0412\u044B\u0448\u043B\u0438 \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0432\u0448\u0438\u043C\u0438
      \u0438 \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C \u0432 \u043B\u044E\u0434\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684302
    m_Localized: "\u041E\u0431\u043E\u0437 \u0438\u0441\u0447\u0435\u0437 \u0437\u0430
      \u043D\u043E\u0447\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684303
    m_Localized: "\u0412\u0447\u0435\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C
      \u043F\u043E\u043F\u0443\u0442\u043D\u044B\u0439 \u043E\u0431\u043E\u0437 \u0440\u0430\u0437\u0431\u0438\u043B
      \u043B\u0430\u0433\u0435\u0440\u044C \u0432 \u0441\u0442\u0430 \u0448\u0430\u0433\u0430\u0445
      - \u0441\u043B\u044B\u0448\u043D\u044B \u0431\u044B\u043B\u0438 \u0433\u043E\u043B\u043E\u0441\u0430,
      \u0437\u0430\u043F\u0430\u0445 \u0434\u044B\u043C\u0430 \u043E\u0442 \u0438\u0445
      \u043A\u043E\u0441\u0442\u0440\u0430. \u0423\u0442\u0440\u043E\u043C - \u0442\u0438\u0448\u0438\u043D\u0430.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0432\u043C\u044F\u0442\u0438\u043D\u044B
      \u043E\u0442 \u0448\u0430\u0442\u0440\u043E\u0432\u044B\u0445 \u043A\u043E\u043B\u044C\u0435\u0432
      \u0432 \u0437\u0435\u043C\u043B\u0435, \u0441\u0431\u0438\u0442\u044B\u0435
      \u0443\u0433\u043B\u0438 \u0438 \u0441\u043B\u0435\u0434\u044B \u043A\u043E\u043F\u044B\u0442.
      \u0421\u043B\u0435\u0434\u044B \u0443\u0445\u043E\u0434\u044F\u0442 \u043D\u0430
      \u0432\u043E\u0441\u0442\u043E\u043A, \u043A \u0441\u043A\u0430\u043B\u0430\u043C,
      \u0438 \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0435\u0441\u0442\u0438
      \u0448\u0430\u0433\u043E\u0432 \u043E\u0431\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      - \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u043E\u0431\u043E\u0437
      \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F \u0432 \u0432\u043E\u0437\u0434\u0443\u0445.
      \u0417\u0435\u043C\u043B\u044F \u0442\u0432\u0451\u0440\u0434\u0430\u044F,
      \u0441\u043B\u0435\u0434\u043E\u0432 \u0434\u0430\u043B\u044C\u0448\u0435 \u043D\u0435\u0442.
      \u0411\u0443\u0433\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442 \u043C\u043E\u043B\u0447\u0430
      \u0443\u0436\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0438\u043D\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684304
    m_Localized: "\u0421\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C \u043F\u043E
      \u0441\u043B\u0435\u0434\u0430\u043C \u0434\u043E \u043E\u0431\u0440\u044B\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684305
    m_Localized: "\u0412 \u043A\u043E\u043D\u0446\u0435 \u0441\u043B\u0435\u0434\u043E\u0432
      - \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u043C\u0435\u0448\u043E\u043A
      \u0441 \u043C\u043E\u043D\u0435\u0442\u0430\u043C\u0438, \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439
      \u0432 \u0441\u043F\u0435\u0448\u043A\u0435. \u0411\u043E\u043B\u044C\u0448\u0435
      \u043D\u0438\u0447\u0435\u0433\u043E. \u0427\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E
      - \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443 \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E.
      \u041C\u043E\u043D\u0435\u0442\u044B \u0432\u0437\u044F\u043B\u0438. \u0414\u043E\u0440\u043E\u0433\u0430
      \u0434\u0430\u043B\u044C\u0448\u0435 \u043F\u0443\u0441\u0442\u0430\u044F \u0438
      \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684306
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u043E \u0443\u0439\u0442\u0438 -
      \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684307
    m_Localized: "\u0412\u044B\u0448\u043B\u0438 \u0431\u0435\u0437 \u0437\u0430\u0432\u0442\u0440\u0430\u043A\u0430.
      \u0411\u0443\u0433\u0430 \u043D\u0435 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u043B\u0441\u044F.
      \u0427\u0442\u043E \u0431\u044B \u044D\u0442\u043E \u043D\u0438 \u0431\u044B\u043B\u043E
      - \u043B\u0443\u0447\u0448\u0435 \u043D\u0435 \u0437\u043D\u0430\u0442\u044C.
      \u041C\u0435\u0441\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
      \u043F\u043E\u0437\u0430\u0434\u0438. \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0432 \u043E\u0431\u043E\u0437\u0435 - \u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0435
      \u0434\u043E \u0432\u0435\u0447\u0435\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684308
    m_Localized: "\u0416\u0434\u0430\u0442\u044C \u0434\u043E \u0443\u0442\u0440\u0430
      - \u043C\u043E\u0436\u0435\u0442 \u0432\u0435\u0440\u043D\u0443\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684309
    m_Localized: "\u0416\u0434\u0430\u043B\u0438. \u041D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F. \u041D\u043E\u0447\u044C\u044E
      \u043A\u0442\u043E-\u0442\u043E \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0432\u0438\u0434\u0435\u043B \u043E\u0433\u043E\u043D\u0451\u043A \u0432
      \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u0441\u043A\u0430\u043B - \u043C\u0435\u0440\u0446\u0430\u043B
      \u0442\u0440\u0438 \u0440\u0430\u0437\u0430 \u0438 \u043F\u043E\u0433\u0430\u0441.
      \u0423\u0442\u0440\u043E\u043C \u0434\u0432\u0438\u043D\u0443\u043B\u0438\u0441\u044C
      \u0434\u0430\u043B\u044C\u0448\u0435. \u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u044B
      \u043E\u0431 \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435 \u0448\u043B\u0438
      \u0435\u0449\u0451 \u0434\u043E\u043B\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684310
    m_Localized: "\u041E\u0433\u043D\u0438 \u043D\u0430\u0434 \u0441\u0442\u0430\u0440\u044B\u043C
      \u043A\u043E\u043B\u043E\u0434\u0446\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684311
    m_Localized: "\u041A\u043E\u043B\u043E\u0434\u0435\u0446 \u0431\u0435\u0437 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F
      - \u0441\u0442\u0430\u0440\u044B\u0439, \u043E\u0431\u043B\u0438\u0446\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0436\u0451\u043B\u0442\u044B\u043C \u043A\u0438\u0440\u043F\u0438\u0447\u043E\u043C
      \u0441 \u0442\u0440\u0435\u0449\u0438\u043D\u0430\u043C\u0438. \u041D\u043E\u0447\u044C\u044E
      \u043D\u0430\u0434 \u043D\u0438\u043C \u0433\u043E\u0440\u044F\u0442 \u043E\u0433\u043D\u0438:
      \u0442\u0440\u0438 \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u044B\u0435
      \u0442\u043E\u0447\u043A\u0438 \u0431\u043B\u0435\u0434\u043D\u043E-\u0441\u0438\u043D\u0435\u0433\u043E
      \u0446\u0432\u0435\u0442\u0430, \u043D\u0435 \u043C\u0435\u0440\u0446\u0430\u044E\u0442,
      \u043D\u0435 \u0434\u0432\u0438\u0436\u0443\u0442\u0441\u044F. \u041D\u0435
      \u0441\u0432\u0435\u0447\u0438 - \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0440\u043E\u0432\u043D\u044B\u0435. \u041D\u0435 \u0444\u0430\u043A\u0435\u043B
      - \u043D\u0435\u0442 \u0437\u0430\u043F\u0430\u0445\u0430 \u0434\u044B\u043C\u0430.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0435. \u0411\u0443\u0433\u0430
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442: \u0442\u044E\u0440\u043A\u0438
      \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0442\u0430\u043A\u043E\u0435
      \u044F\u0440-\u043E\u0442\u044B - \u043E\u0433\u043E\u043D\u044C \u0431\u043E\u043B\u043E\u0442\u0430.
      \u041C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0439 \u043C\u043E\u043D\u0430\u0445
      \u0432 \u043E\u0431\u043E\u0437\u0435 \u0420\u0443\u0441\u0442\u0430\u043C\u0430
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0438\u043D\u0430\u0447\u0435:
      \u044D\u0442\u043E \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C
      \u0434\u0443\u0445\u0438 \u0443\u043C\u0435\u0440\u0448\u0438\u0445 \u043A\u0443\u043F\u0446\u043E\u0432,
      \u043D\u0435 \u043D\u0430\u0448\u0435\u0434\u0448\u0438\u0445 \u0434\u043E\u0440\u043E\u0433\u0438
      \u0434\u043E\u043C\u043E\u0439. \u041A\u043E\u043B\u043E\u0434\u0435\u0446
      \u043F\u043E \u0432\u0438\u0434\u0443 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684312
    m_Localized: "\u0421\u043F\u0443\u0441\u0442\u0438\u0442\u044C\u0441\u044F \u0432
      \u043A\u043E\u043B\u043E\u0434\u0435\u0446 \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684313
    m_Localized: "\u0412 \u043A\u043E\u043B\u043E\u0434\u0446\u0435 \u043D\u0430
      \u0443\u0441\u0442\u0443\u043F\u0435 - \u043C\u0435\u0434\u043D\u0430\u044F
      \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0430, \u0432\u043E\u0434\u043E\u0439
      \u043D\u0435 \u0437\u0430\u043B\u0438\u0442\u0430\u044F. \u0412\u043D\u0443\u0442\u0440\u0438
      \u043C\u043E\u043D\u0435\u0442\u044B \u0438 \u0437\u0430\u043F\u0438\u0441\u043A\u0430
      \u043D\u0430 \u043F\u0435\u0445\u043B\u0435\u0432\u0438\u0439\u0441\u043A\u043E\u043C.
      \u041E\u0433\u043D\u0438 \u043A \u0442\u043E\u043C\u0443 \u043C\u043E\u043C\u0435\u043D\u0442\u0443
      \u043F\u043E\u0433\u0430\u0441\u043B\u0438 \u0441\u0430\u043C\u0438. \u0427\u0442\u043E
      \u044D\u0442\u043E \u0431\u044B\u043B\u043E - \u0420\u0443\u0441\u0442\u0430\u043C
      \u0442\u0430\u043A \u0438 \u043D\u0435 \u0440\u0435\u0448\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684314
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u043A\u0430\u043C\u0435\u043D\u044C
      - \u0441\u043B\u0443\u0448\u0430\u0442\u044C \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684315
    m_Localized: "\u041A\u0430\u043C\u0435\u043D\u044C \u0443\u043F\u0430\u043B,
      \u0432\u0441\u043F\u043B\u0435\u0441\u043A \u0432\u043E\u0434\u044B. \u041E\u0433\u043D\u0438
      \u043D\u0435 \u0441\u0440\u0435\u0430\u0433\u0438\u0440\u043E\u0432\u0430\u043B\u0438.
      \u041F\u043E\u0441\u0442\u043E\u044F\u043B\u0438 \u0435\u0449\u0451 \u0447\u0430\u0441
      - \u043E\u0433\u043D\u0438 \u043F\u043E\u0433\u0430\u0441\u043B\u0438 \u0441\u0430\u043C\u0438
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435. \u0412\u043E\u0434\u0443
      \u0438\u0437 \u043A\u043E\u043B\u043E\u0434\u0446\u0430 \u043D\u0430\u0431\u0440\u0430\u043B\u0438
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E, \u043D\u0435 \u0433\u043B\u044F\u0434\u044F
      \u0432\u043D\u0438\u0437. \u0411\u0443\u0433\u0430 \u0447\u0438\u0442\u0430\u043B
      \u043C\u043E\u043B\u0438\u0442\u0432\u0443 \u043F\u043E-\u0442\u044E\u0440\u043A\u0441\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684316
    m_Localized: "\u0423\u0439\u0442\u0438 \u043D\u0435 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684317
    m_Localized: "\u0423\u0448\u043B\u0438 \u0432 \u043D\u043E\u0447\u044C, \u043D\u0430\u0448\u043B\u0438
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
      \u0432\u043E\u0434\u044B \u0447\u0435\u0440\u0435\u0437 \u043B\u0438. \u041E\u0433\u043D\u0438
      \u043D\u0430\u0434 \u043A\u043E\u043B\u043E\u0434\u0446\u0435\u043C \u0432\u0438\u0434\u0435\u043B\u0438
      \u0435\u0449\u0451 \u0434\u043E\u043B\u0433\u043E \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439.
      \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u0433\u043E\u0440\u043E\u0434\u0435
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0438 - \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u043A\u0438\u0432\u043D\u0443\u043B: \u0434\u0430, \u0437\u043D\u0430\u044E
      \u044D\u0442\u043E\u0442 \u043A\u043E\u043B\u043E\u0434\u0435\u0446, \u0432\u0441\u0435
      \u043E\u0431\u0445\u043E\u0434\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684318
    m_Localized: "\u0413\u043E\u0432\u043E\u0440\u044F\u0449\u0438\u0439 \u0432\u043E\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684319
    m_Localized: "\u041D\u0430 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0435
      \u0443 \u0442\u043E\u043F\u043E\u043B\u0435\u0439 \u043F\u0442\u0438\u0446\u0430
      \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0430\u0441\u044C \u043D\u0430 \u0431\u043E\u0440\u0442
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 - \u043A\u0440\u0443\u043F\u043D\u044B\u0439
      \u0432\u043E\u0440\u043E\u043D \u0441 \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0438\u043C
      \u0447\u0451\u0440\u043D\u044B\u043C \u043E\u043F\u0435\u0440\u0435\u043D\u0438\u0435\u043C,
      \u0431\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0430. \u0427\u0435\u0440\u0435\u0437
      \u043C\u0438\u043D\u0443\u0442\u0443 \u043E\u043D \u043F\u0440\u043E\u0438\u0437\u043D\u0451\u0441
      \u0438\u043C\u044F \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430
      \u043E\u0431\u043E\u0437\u0430 - \u043D\u0435 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0430 \u0442\u043E\u0447\u043D\u043E, \u0441 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u043C
      \u0443\u0434\u0430\u0440\u0435\u043D\u0438\u0435\u043C. \u041F\u043E\u0442\u043E\u043C
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043B\u043E\u0432
      \u043D\u0430 \u0444\u0430\u0440\u0441\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0432\u043E
      \u0444\u0440\u0430\u0437\u0443: \u0446\u0435\u043D\u0430 \u0443\u043F\u0430\u0434\u0451\u0442.
      \u0411\u0443\u0433\u0430 \u043E\u0442\u0448\u0430\u0442\u043D\u0443\u043B\u0441\u044F.
      \u041C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0439 \u043C\u043E\u043D\u0430\u0445
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0441 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u043C:
      \u0432 \u0438\u043D\u0434\u0438\u0439\u0441\u043A\u0438\u0445 \u0442\u0435\u043A\u0441\u0442\u0430\u0445
      \u0432\u043E\u0440\u043E\u043D\u044B \u0441\u043B\u0443\u0436\u0430\u0442 \u0432\u0435\u0441\u0442\u043D\u0438\u043A\u0430\u043C\u0438.
      \u0420\u0443\u0441\u0442\u0430\u043C \u043C\u043E\u043B\u0447\u0438\u0442.
      \u041F\u0442\u0438\u0446\u0430 \u0436\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684320
    m_Localized: "\u041F\u043E\u0439\u043C\u0430\u0442\u044C \u0432\u043E\u0440\u043E\u043D\u0430
      - \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0447\u0435\u0439
      \u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684321
    m_Localized: "\u041F\u043E\u0439\u043C\u0430\u043B\u0438 \u0441 \u0442\u0440\u0443\u0434\u043E\u043C
      - \u043F\u0442\u0438\u0446\u0430 \u0431\u044B\u043B\u0430 \u043E\u0431\u0443\u0447\u0435\u043D\u0430
      \u0438 \u0432 \u043F\u0430\u043D\u0438\u043A\u0435 \u0443\u043A\u0443\u0441\u0438\u043B\u0430
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430. \u041D\u0430 \u043A\u043E\u043B\u044C\u0446\u0435
      \u043B\u0430\u043F\u044B \u0432\u044B\u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u0430\u043D\u043E
      \u0438\u043C\u044F: \u041B\u0438 \u0413\u0443\u0430\u043D, \u043A\u0443\u043F\u0435\u0446
      \u0438\u0437 \u0427\u0430\u043D\u044A\u0430\u043D\u0438. \u0412 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435 \u043D\u0430\u0448\u043B\u0438 \u0435\u0433\u043E
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u0434\u043E\u043C. \u0426\u0435\u043D\u0430
      \u043D\u0430 \u0448\u0451\u043B\u043A \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0443\u043F\u0430\u043B\u0430 - \u0442\u0440\u0438 \u0434\u043D\u044F \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684322
    m_Localized: "\u0421\u043B\u0443\u0448\u0430\u0442\u044C \u0447\u0442\u043E \u0435\u0449\u0451
      \u0441\u043A\u0430\u0436\u0435\u0442 \u043F\u0442\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684323
    m_Localized: "\u041F\u0440\u043E\u0441\u0438\u0434\u0435\u043B\u0438 \u0441 \u0432\u043E\u0440\u043E\u043D\u043E\u043C
      \u043F\u043E\u043B\u0447\u0430\u0441\u0430. \u041E\u043D \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u043B
      \u0444\u0440\u0430\u0437\u0443 \u0434\u0432\u0430\u0436\u0434\u044B \u0438
      \u0434\u043E\u0431\u0430\u0432\u0438\u043B \u043E\u0434\u043D\u043E \u0441\u043B\u043E\u0432\u043E:
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434. \u041F\u043E\u0442\u043E\u043C
      \u0443\u043B\u0435\u0442\u0435\u043B \u043D\u0430 \u0437\u0430\u043F\u0430\u0434.
      \u0421\u043E\u0432\u0435\u0442 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0443\u043C\u0435\u0441\u0442\u043D\u044B\u043C: \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u0446\u0435\u043D\u0430 \u043D\u0430 \u0441\u043F\u0435\u0446\u0438\u0438
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0431\u044B\u043B\u0430 \u0432\u044B\u0448\u0435 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684324
    m_Localized: "\u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C \u043F\u0442\u0438\u0446\u0443
      - \u043F\u0440\u0438\u043C\u0435\u0442\u0430 \u043F\u043B\u043E\u0445\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33995289621684325
    m_Localized: "\u041A\u0438\u043D\u0443\u043B\u0438 \u043A\u0430\u043C\u0435\u043D\u044C,
      \u0432\u043E\u0440\u043E\u043D \u0443\u043B\u0435\u0442\u0435\u043B. \u0411\u0443\u0433\u0430
      \u043E\u0431\u043B\u0435\u0433\u0447\u0451\u043D\u043D\u043E \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B:
      \u0433\u043E\u0432\u043E\u0440\u044F\u0449\u0430\u044F \u043F\u0442\u0438\u0446\u0430
      - \u043A \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u044C\u044E, \u0432\u0441\u0435
      \u0437\u043D\u0430\u044E\u0442. \u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0430
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0430\u0441\u044C,
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u043D\u0435\u0442. \u0421\u043F\u043E\u0440\u0438\u043B\u0438
      \u0434\u043E \u0432\u0435\u0447\u0435\u0440\u0430 \u0432\u043C\u0435\u0441\u0442\u043E
      \u0442\u043E\u0433\u043E \u0447\u0442\u043E\u0431\u044B \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0440\u044B\u043D\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993347944448
    m_Localized: "\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434 \u043D\u0430
      \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993394081792
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0434\u043E\u043B\u0433\u0438\u0445
      \u043D\u0435\u0434\u0435\u043B\u044C \u043F\u0443\u0442\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0433\u043E\u043B\u0443\u0431\u044B\u0435 \u043A\u0443\u043F\u043E\u043B\u0430
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u0439
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438 \u0412\u0430\u0445\u0443-\u041C\u0430\u043D\u0430
      - \u0443 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445 \u0432\u043E\u0440\u043E\u0442.
      \u0422\u044E\u043A\u0438 \u0448\u0451\u043B\u043A\u0430 \u0446\u0435\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993394081793
    m_Localized: "\u0412\u043E\u0439\u0442\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993394081794
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
      \u0447\u0435\u0440\u0435\u0437 \u0432\u043E\u0440\u043E\u0442\u0430. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438
      \u0441\u0430\u043B\u044E\u0442\u0443\u044E\u0442 \u0433\u0440\u0430\u043C\u043E\u0442\u0435
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438. \u0414\u0430\u043B\u044C\u0448\u0435
      - \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u0439
      \u0412\u0430\u0445\u0443-\u041C\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276096
    m_Localized: "\u0414\u0443\u043D \u0412\u044D\u0439 - \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043F\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276097
    m_Localized: "\u0412 \u0413\u0438\u043B\u044C\u0434\u0438\u0438 \u043F\u0430\u0445\u043D\u0435\u0442
      \u0442\u0443\u0448\u044C\u044E \u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u043C
      \u043E\u0447\u0430\u0433\u043E\u043C. \u041F\u043E\u0436\u0438\u043B\u043E\u0439
      \u043F\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0439 \u0414\u0443\u043D
      \u0412\u044D\u0439 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0441\u0432\u0438\u0442\u043E\u043A \u043D\u0430 \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0435
      - \u043F\u043E\u0436\u0435\u043B\u0442\u0435\u0432\u0448\u0438\u0439, \u0441
      \u043E\u0442\u043F\u0435\u0447\u0430\u0442\u043A\u043E\u043C \u043A\u0440\u0430\u0441\u043D\u043E\u0439
      \u043F\u0435\u0447\u0430\u0442\u0438 \u043F\u043E\u043F\u0435\u0440\u0451\u043A
      \u0442\u0435\u043A\u0441\u0442\u0430. \u0415\u0433\u043E \u0433\u043E\u043B\u043E\u0441
      \u0442\u0438\u0445: \"\u0422\u0440\u0438 \u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u041B\u0443 \u0426\u0437\u044F\u043D\u044C
      \u0437\u0430\u043D\u0451\u0441 \u0432\u0430\u0448\u0443 \u0441\u0435\u043C\u044C\u044E
      \u0432 \u0441\u043F\u0438\u0441\u043E\u043A \u043F\u043E\u0441\u043E\u0431\u043D\u0438\u043A\u043E\u0432
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0438\u044F. \u0421\u043A\u043B\u0430\u0434
      \u043E\u043F\u0435\u0447\u0430\u0442\u0430\u043D, \u0434\u043E\u0431\u0440\u043E\u0435
      \u0438\u043C\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E. \u042F
      \u0441\u043B\u0443\u0436\u0438\u043B \u0432\u0430\u0448\u0435\u043C\u0443 \u043E\u0442\u0446\u0443
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442 - \u044F
      \u0437\u043D\u0430\u044E, \u0433\u0434\u0435 \u0438\u0441\u043A\u0430\u0442\u044C
      \u043B\u044E\u0434\u0435\u0439, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043F\u043E\u043C\u043D\u044F\u0442 \u043F\u0440\u0430\u0432\u0434\u0443.\"
      \u0413\u0443\u0430\u043D\u044C\u0434\u0438\u0435, \u0432\u044B\u0434\u0430\u043D\u043D\u044B\u0439
      \u0432\u0430\u0448\u0435\u0439 \u0441\u0435\u043C\u044C\u0435, \u043B\u0435\u0436\u0438\u0442
      \u0440\u044F\u0434\u043E\u043C - \u0432 \u043D\u0451\u043C \u043F\u0440\u043E\u043F\u0443\u0449\u0435\u043D\u0430
      \u043E\u0434\u043D\u0430 \u0441\u0442\u0440\u043E\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u043B\u043E
      \u0431\u044B\u0442\u044C. \u0421\u043E\u0433\u0434\u0438\u0439\u0446\u044B
      \u043D\u0435 \u043F\u043E\u0434\u0434\u0435\u0440\u0436\u0430\u043B\u0438 \u0410\u043D\u044C
      \u041B\u0443\u0448\u0430\u043D\u044F, \u043D\u043E \u0441\u0442\u0440\u0430\u0445
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u043E\u0432 \u0441\u0438\u043B\u044C\u043D\u0435\u0435
      \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276098
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276099
    m_Localized: "\u0414\u0443\u043D \u0412\u044D\u0439 \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
      \u0438\u043C\u0435\u043D\u0430 \u0442\u0440\u043E\u0438\u0445 \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u043E\u0432
      \u043E\u0442\u0446\u0430 - \u043E\u043D\u0438 \u0435\u0449\u0451 \u0436\u0438\u0432\u0443\u0442
      \u0432 \u0427\u0430\u043D\u044A\u0430\u043D\u0438, \u0442\u043E\u0440\u0433\u0443\u044E\u0442
      \u0448\u0451\u043B\u043A\u043E\u043C \u0438 \u0431\u0443\u043C\u0430\u0433\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276100
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F -
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u043E\u043F\u0430\u0441\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276101
    m_Localized: "\u0414\u0443\u043D \u0412\u044D\u0439 \u043A\u0438\u0432\u0430\u0435\u0442
      \u0431\u0435\u0437 \u043E\u0441\u0443\u0436\u0434\u0435\u043D\u0438\u044F \u0438
      \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0441\u0432\u0438\u0442\u043E\u043A.
      \u041F\u0440\u043E\u0448\u043B\u043E\u0435 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043D\u0435\u0442\u0440\u043E\u043D\u0443\u0442\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276102
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276103
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276104
    m_Localized: "\u0422\u0440\u043E\u0435 \u043A\u0443\u043F\u0446\u043E\u0432 \u0441\u0442\u0430\u0432\u044F\u0442
      \u043E\u0442\u043F\u0435\u0447\u0430\u0442\u043A\u0438 \u043F\u0430\u043B\u044C\u0446\u0435\u0432
      \u043F\u043E\u0434 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F\u043C\u0438.
      \u0411\u0443\u043C\u0430\u0433\u0430 \u0441 \u0438\u043C\u0435\u043D\u0430\u043C\u0438
      \u0442\u0435\u043F\u0435\u0440\u044C \u0443 \u0432\u0430\u0441 - \u043F\u0435\u0440\u0432\u0430\u044F
      \u043D\u0438\u0442\u044C \u043A \u0440\u0435\u0430\u0431\u0438\u043B\u0438\u0442\u0430\u0446\u0438\u0438
      \u0441\u0435\u043C\u044C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276105
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F \u0441\u043E\u0431\u0440\u0430\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276106
    m_Localized: "\u0421\u0432\u0438\u0442\u043A\u0438 \u0441 \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F\u043C\u0438
      \u043B\u0435\u0436\u0430\u0442 \u0432 \u043A\u043E\u0436\u0430\u043D\u043E\u043C
      \u0444\u0443\u0442\u043B\u044F\u0440\u0435. \u041A\u0430\u0436\u0434\u044B\u0439
      \u0438\u0437 \u0442\u0440\u0451\u0445 \u043A\u0443\u043F\u0446\u043E\u0432
      \u043E\u043F\u0438\u0441\u0430\u043B \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0435
      \u0441\u0434\u0435\u043B\u043A\u0438 \u0441 \u0432\u0430\u0448\u0438\u043C
      \u043E\u0442\u0446\u043E\u043C: \u0434\u0430\u0442\u044B, \u0442\u043E\u0432\u0430\u0440\u044B,
      \u0441\u0443\u043C\u043C\u044B \u043A\u0430\u0439\u044E\u0430\u043D\u044C \u0442\u0443\u043D\u0431\u0430\u043E.
      \u041D\u0438 \u043E\u0434\u0438\u043D \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442
      \u043D\u0435 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442 \u0438\u043C\u044F
      \u0410\u043D\u044C \u041B\u0443\u0448\u0430\u043D\u044F \u0438\u043B\u0438
      \u0435\u0433\u043E \u043B\u044E\u0434\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276107
    m_Localized: "\u041F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
      \u0414\u0443\u043D \u0412\u044D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276108
    m_Localized: "\u041F\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0439 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0441\u0432\u0438\u0442\u043A\u0438 \u0434\u0432\u0443\u043C\u044F \u0440\u0443\u043A\u0430\u043C\u0438
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u0447\u0442\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0448\u0430\u0433 - \u0430\u0440\u0445\u0438\u0432\u044B \u041B\u0443\u043E\u044F\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276109
    m_Localized: "\u0411\u0438\u043B\u044C\u0433\u044D - \u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A
      \u0437\u0430\u0441\u0442\u0430\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276110
    m_Localized: "\u0412 \u043A\u0430\u0437\u0430\u0440\u043C\u0430\u0445 \u041B\u0430\u043D\u044C\u0447\u0436\u043E\u0443
      \u043F\u0430\u0445\u043D\u0435\u0442 \u043A\u043E\u0436\u0430\u043D\u043E\u0439
      \u0441\u0431\u0440\u0443\u0435\u0439 \u0438 \u0432\u0430\u0440\u0451\u043D\u044B\u043C
      \u043F\u0440\u043E\u0441\u043E\u043C. \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A
      \u0437\u0430\u0441\u0442\u0430\u0432\u044B \u0411\u0438\u043B\u044C\u0433\u044D
      - \u0433\u0440\u0443\u0437\u043D\u044B\u0439 \u0442\u044E\u0440\u043A \u0441
      \u0441\u0435\u0434\u044B\u043C\u0438 \u0443\u0441\u0430\u043C\u0438 - \u043B\u0438\u0441\u0442\u0430\u0435\u0442
      \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u044B\u0439 \u0436\u0443\u0440\u043D\u0430\u043B
      \u043F\u0440\u043E\u0445\u043E\u0434\u0430 \u0437\u0430 \u043B\u0435\u0442\u043D\u0438\u0435
      \u043C\u0435\u0441\u044F\u0446\u044B 768 \u0433\u043E\u0434\u0430. \u041E\u043D
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0438\u0441\u043B\u043E\u0432\u0438\u0439:
      \"\u0422\u0435\u043C \u043B\u0435\u0442\u043E\u043C \u0447\u0435\u0440\u0435\u0437
      \u043F\u043E\u0441\u0442 \u043F\u0440\u043E\u0448\u043B\u043E \u0441\u0435\u043C\u044C
      \u043C\u0430\u043B\u044B\u0445 \u0433\u0440\u0443\u043F\u043F. \u0417\u0430\u043F\u0438\u0441\u044C
      \u043E \u0442\u044E\u0440\u043A\u0435 \u0441 \u0442\u0440\u0435\u043C\u044F
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430\u043C\u0438 \u0435\u0441\u0442\u044C.
      \u0414\u0430\u0442\u0430 - \u0441\u0435\u043C\u043D\u0430\u0434\u0446\u0430\u0442\u044B\u0439
      \u0434\u0435\u043D\u044C \u0448\u0435\u0441\u0442\u043E\u0439 \u043B\u0443\u043D\u044B.
      \u041E\u043D\u0438 \u0448\u043B\u0438 \u043D\u0430 \u0437\u0430\u043A\u0430\u0442
      \u0438 \u043D\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0438\u0441\u044C.\"
      \u0416\u0443\u0440\u043D\u0430\u043B \u043B\u0435\u0436\u0438\u0442 \u043F\u0435\u0440\u0435\u0434
      \u0432\u0430\u043C\u0438. \u0421\u0442\u0440\u043E\u0447\u043A\u0430 \u0441\u0443\u0445\u0430\u044F,
      \u0431\u0435\u0437 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u043E\u0441\u0442\u0435\u0439,
      \u043D\u043E \u0438\u043C\u044F \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u043E:
      \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D. \u0425\u044D\u0441\u0438-\u043A\u043E\u0440\u0438\u0434\u043E\u0440
      \u0432 \u0442\u043E \u043B\u0435\u0442\u043E \u0434\u0435\u0440\u0436\u0430\u043B\u0438
      \u0442\u0438\u0431\u0435\u0442\u0446\u044B \u043D\u0430 \u0437\u0430\u043F\u0430\u0434\u0435
      \u0438 \u043E\u0442\u0440\u044F\u0434\u044B \u0410\u043D\u044C \u041B\u0443\u0448\u0430\u043D\u044F
      \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A\u0435 - \u041A\u044E\u043B\u044C
      \u0432\u044B\u0431\u0440\u0430\u043B \u043F\u043B\u043E\u0445\u043E\u0435 \u0432\u0440\u0435\u043C\u044F
      \u0434\u043B\u044F \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276111
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0440\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276112
    m_Localized: "\u0411\u0438\u043B\u044C\u0433\u044D \u0441\u0442\u0430\u0432\u0438\u0442
      \u043F\u0435\u0447\u0430\u0442\u044C \u043D\u0430 \u043A\u043E\u043F\u0438\u044E
      \u0437\u0430\u043F\u0438\u0441\u0438 - \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0435
      \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435 \u0434\u043B\u044F \u0440\u0430\u0441\u0441\u043F\u0440\u043E\u0441\u043E\u0432
      \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276113
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u0440\u043E\u0448\u043B\u043E\u0435
      \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276114
    m_Localized: "\u0416\u0443\u0440\u043D\u0430\u043B \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F.
      \u0418\u043C\u044F \u041A\u044E\u043B\u044F \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0432 \u043E\u0434\u043D\u043E\u0439 \u0441\u0442\u0440\u043E\u043A\u0435
      \u0437\u0430 768 \u0433\u043E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276115
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276116
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F
      \u0438 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276117
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0438\u043C\u044F \u0445\u043E\u0437\u044F\u0438\u043D\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430 \u0432 \u042E\u0439\u043C\u044D\u043D\u0435
      - \u0442\u043E\u0442 \u043C\u043E\u0433 \u0432\u0438\u0434\u0435\u0442\u044C
      \u041A\u044E\u043B\u044F \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276118
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0441\u043B\u0435\u0434 \u043D\u0430\u0439\u0434\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276119
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0427\u044D\u043D\u044C
      \u043F\u043E\u043C\u043D\u0438\u0442 \u0442\u044E\u0440\u043A\u0430 \u0432
      \u0441\u0435\u0440\u043E\u0439 \u0432\u043E\u0439\u043B\u043E\u0447\u043D\u043E\u0439
      \u0448\u0430\u043F\u043A\u0435 \u0441 \u0442\u0440\u0435\u043C\u044F \u0433\u0440\u0443\u0436\u0451\u043D\u044B\u043C\u0438
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430\u043C\u0438. \u0422\u043E\u0442
      \u0441\u043F\u0440\u043E\u0441\u0438\u043B \u0434\u043E\u0440\u043E\u0433\u0443
      \u043D\u0430 \u042E\u0439\u043C\u044D\u043D\u044C \u0438 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B
      \u0437\u0430 \u043D\u043E\u0447\u043B\u0435\u0433 \u0436\u0435\u043B\u0435\u0437\u043D\u043E\u0439
      \u043C\u043E\u043D\u0435\u0442\u043E\u0439 - \u043D\u0435 \u043A\u0430\u0439\u044E\u0430\u043D\u044C
      \u0442\u0443\u043D\u0431\u0430\u043E, \u0430 \u0441\u0442\u0430\u0440\u043E\u0439
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0439. \u042D\u0442\u043E
      \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276120
    m_Localized: "\u0418\u0434\u0442\u0438 \u0432 \u042E\u0439\u043C\u044D\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276121
    m_Localized: "\u041F\u0443\u0442\u044C \u043D\u0430 \u0437\u0430\u043F\u0430\u0434
      \u043E\u0442\u043A\u0440\u044B\u0442. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u0439
      \u0432 \u042E\u0439\u043C\u044D\u043D\u0435 - \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
      \u0442\u043E\u0447\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276122
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 - \u0430\u0440\u0445\u0438\u0432\u043D\u044B\u0439
      \u043F\u0438\u0441\u0430\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276123
    m_Localized: "\u0412 \u0430\u0440\u0445\u0438\u0432\u0435 \u0426\u0437\u044E\u0446\u044E\u0430\u043D\u044F
      \u043F\u0440\u043E\u0445\u043B\u0430\u0434\u043D\u043E \u0438 \u0442\u0435\u043C\u043D\u043E.
      \u041F\u0438\u0441\u0430\u0440\u044C \u0421\u0430\u043C\u0435\u0445 - \u0445\u0443\u0434\u043E\u0439
      \u0441\u043E\u0433\u0434\u0438\u0435\u0446 \u0441 \u0447\u0435\u0440\u043D\u0438\u043B\u044C\u043D\u044B\u043C\u0438
      \u043F\u044F\u0442\u043D\u0430\u043C\u0438 \u043D\u0430 \u043F\u0440\u0430\u0432\u043E\u0439
      \u0440\u0443\u043A\u0435 - \u0440\u0430\u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438 \u0434\u043E\u043D\u0435\u0441\u0435\u043D\u0438\u044F
      \u043E \u043F\u043E\u0436\u0430\u0440\u0430\u0445 \u0437\u0430 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u043F\u044F\u0442\u044C \u043B\u0435\u0442. \u0417\u0430\u043F\u0430\u0445
      \u0441\u044B\u0440\u043E\u0439 \u0433\u043B\u0438\u043D\u044F\u043D\u043E\u0439
      \u0448\u0442\u0443\u043A\u0430\u0442\u0443\u0440\u043A\u0438 \u0441\u043C\u0435\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441 \u0433\u043E\u0440\u044C\u043A\u0438\u043C \u043B\u0430\u0434\u0430\u043D\u043E\u043C
      \u0438\u0437 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u044B.
      \u0421\u0430\u043C\u0435\u0445 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E:
      \"\u041F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0439 \u0434\u0432\u043E\u0440
      \u0420\u0443\u0441\u0442\u0430\u043C\u0430 \u0441\u0433\u043E\u0440\u0435\u043B
      \u0442\u0440\u0438 \u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434.
      \u0414\u0432\u043E\u0435 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044C\u0446\u0435\u0432
      \u043D\u0435 \u0432\u044B\u0448\u043B\u0438. \u041C\u0435\u0441\u0442\u043D\u0430\u044F
      \u0441\u0442\u0440\u0430\u0436\u0430 \u0437\u0430\u043A\u0440\u044B\u043B\u0430
      \u0434\u0435\u043B\u043E \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0435
      \u043D\u0435\u0434\u0435\u043B\u0438 - \u043F\u043E\u0436\u0430\u0440 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B\u0438
      \u043D\u0435\u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u044C\u044E.
      \u041D\u043E \u0443 \u0420\u0443\u0441\u0442\u0430\u043C\u0430 \u0431\u044B\u043B
      \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442: \u0442\u044E\u0440\u043A-\u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u043F\u043E \u0438\u043C\u0435\u043D\u0438 \u0422\u0435\u0433\u0438\u043D,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u0442\u043A\u0440\u044B\u043B
      \u0441\u0432\u043E\u0439 \u0434\u0432\u043E\u0440 \u0447\u0435\u0440\u0435\u0437
      \u043C\u0435\u0441\u044F\u0446 \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u0436\u0430\u0440\u0430.\"
      \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B \u043E\u0431 \u043E\u0442\u043A\u0440\u044B\u0442\u0438\u0438
      \u0434\u0432\u043E\u0440\u0430 \u0422\u0435\u0433\u0438\u043D\u0430 \u043B\u0435\u0436\u0430\u0442
      \u0440\u044F\u0434\u043E\u043C \u0441 \u0434\u0435\u043B\u043E\u043C \u043E
      \u043F\u043E\u0436\u0430\u0440\u0435. \u0414\u0430\u0442\u044B \u0441\u043E\u0432\u043F\u0430\u0434\u0430\u044E\u0442
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0440\u043E\u0432\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276124
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u0432\u044B\u0436\u0438\u0432\u0448\u0435\u0433\u043E
      \u0441\u043B\u0443\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276125
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043A\u0432\u0430\u0440\u0442\u0430\u043B, \u0433\u0434\u0435 \u0432\u0438\u0434\u0435\u043B\u0438
      \u0441\u043B\u0443\u0433\u0443 \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C
      \u0433\u043E\u0434\u0443 - \u0440\u044B\u043D\u043E\u043A \u043A\u0440\u0430\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u043E\u0432
      \u0443 \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0445 \u0432\u043E\u0440\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276126
    m_Localized: "\u041D\u0435 \u0432\u043C\u0435\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      \u0432 \u0447\u0443\u0436\u043E\u0435 \u0434\u0435\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276127
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u043A\u0438\u0432\u0430\u0435\u0442
      \u0438 \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0434\u043E\u043D\u0435\u0441\u0435\u043D\u0438\u044F.
      \u041F\u043E\u0436\u0430\u0440 \u0442\u0440\u0451\u0445\u043B\u0435\u0442\u043D\u0435\u0439
      \u0434\u0430\u0432\u043D\u043E\u0441\u0442\u0438 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0431\u0435\u0437 \u043E\u0442\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276128
    m_Localized: "\u0421\u043B\u0443\u0433\u0430 \u043D\u0430 \u0440\u044B\u043D\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276129
    m_Localized: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E \u043F\u043E\u0434\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276130
    m_Localized: "\u0421\u043B\u0443\u0433\u0430 \u043F\u044F\u0442\u0438\u0442\u0441\u044F,
      \u043D\u043E \u0435\u0433\u043E \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0438\u043C\u044F \u0420\u0443\u0441\u0442\u0430\u043C\u0430 - \u043E\u043D
      \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0441\u044F \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0432 \u0443\u043A\u0440\u043E\u043C\u043D\u043E\u043C \u0443\u0433\u043B\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276131
    m_Localized: "\u0420\u0430\u0441\u0441\u043A\u0430\u0437 \u043E\u0447\u0435\u0432\u0438\u0434\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276132
    m_Localized: "\u0421\u043B\u0443\u0433\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0431\u044B\u0441\u0442\u0440\u043E, \u043D\u0435 \u0433\u043B\u044F\u0434\u044F
      \u0432 \u0433\u043B\u0430\u0437\u0430. \u0412 \u0442\u0443 \u043D\u043E\u0447\u044C
      \u043E\u043D \u0432\u044B\u0448\u0435\u043B \u0437\u0430 \u0432\u043E\u0434\u043E\u0439
      \u0438 \u0443\u0432\u0438\u0434\u0435\u043B \u0444\u0438\u0433\u0443\u0440\u0443
      \u0443 \u044E\u0436\u043D\u043E\u0439 \u0441\u0442\u0435\u043D\u044B \u0441
      \u0433\u043E\u0440\u0448\u043A\u043E\u043C \u043C\u0430\u0441\u043B\u0430.
      \u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0439 \u0433\u043E\u0432\u043E\u0440,
      \u0448\u0440\u0430\u043C \u043D\u0430 \u0448\u0435\u0435. \u041A\u043E\u0433\u0434\u0430
      \u0432\u0441\u043F\u044B\u0445\u043D\u0443\u043B \u043E\u0433\u043E\u043D\u044C,
      \u0444\u0438\u0433\u0443\u0440\u0430 \u0443\u0448\u043B\u0430 \u043F\u0435\u0448\u043A\u043E\u043C
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u0433\u043E
      \u0442\u0440\u0430\u043A\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276133
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F
      \u0438 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u043D\u0430
      \u0425\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276134
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u044F \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u044B.
      \u0421\u0435\u0432\u0435\u0440\u043D\u044B\u0439 \u0442\u0440\u0430\u043A\u0442
      \u0432\u0435\u0434\u0451\u0442 \u0447\u0435\u0440\u0435\u0437 \u042E\u0439\u043C\u044D\u043D\u044C
      \u043F\u0440\u044F\u043C\u043E \u043A \u0425\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276135
    m_Localized: "\u0427\u0436\u044D\u043D \u0412\u044D\u0439 - \u0442\u0430\u043D
      \u0425\u0430\u043D\u0447\u0436\u043E\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276136
    m_Localized: "\u0417\u0430\u043B \u043F\u0440\u0438\u0451\u043C\u043E\u0432 \u0442\u0430\u043D\u0430
      \u043F\u0430\u0445\u043D\u0435\u0442 \u043B\u0430\u043A\u043E\u043C \u0438
      \u0446\u0432\u0435\u0442\u0443\u0449\u0435\u0439 \u0441\u043B\u0438\u0432\u043E\u0439
      \u0447\u0435\u0440\u0435\u0437 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u0439
      \u0441\u0442\u0430\u0432\u0435\u043D\u044C. \u0427\u0436\u044D\u043D \u0412\u044D\u0439
      - \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0441\u0440\u0435\u0434\u043D\u0438\u0445
      \u043B\u0435\u0442 \u0441 \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E\u0439
      \u0447\u0451\u0440\u043D\u043E\u0439 \u0431\u043E\u0440\u043E\u0434\u043E\u0439
      - \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0438\u0441\u043B\u043E\u0432\u0438\u0439,
      \u043F\u043E\u043A\u0430 \u0441\u0435\u043A\u0440\u0435\u0442\u0430\u0440\u044C
      \u0441\u0442\u043E\u0438\u0442 \u0443 \u0434\u0432\u0435\u0440\u0438 \u0441
      \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438.
      \u041F\u0438\u0441\u044C\u043C\u043E \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u043E
      \u0432 \u0434\u0432\u043E\u0439\u043D\u043E\u0439 \u0448\u0451\u043B\u043A\u043E\u0432\u044B\u0439
      \u043A\u043E\u043D\u0432\u0435\u0440\u0442, \u043E\u0431\u0451\u0440\u043D\u0443\u0442\u044B\u0439
      \u043F\u0440\u043E\u043F\u0438\u0442\u0430\u043D\u043D\u044B\u043C \u0432\u043E\u0441\u043A\u043E\u043C
      \u0445\u043E\u043B\u0441\u0442\u043E\u043C. \u0422\u0430\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442:
      \"\u0422\u0430\u043D \u0425\u044D \u0411\u0438\u043D\u044C \u0432 \u0421\u0438\u0430\u043D\u0438
      \u0436\u0434\u0451\u0442 \u044D\u0442\u043E\u0433\u043E \u043F\u0438\u0441\u044C\u043C\u0430.
      \u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0435 \u043F\u043E\u0441\u0442\u044B
      \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u043B\u0438 \u0413\u0430\u043D\u044C\u0441\u0443\u0439\u0441\u043A\u0438\u0439
      \u043A\u043E\u0440\u0438\u0434\u043E\u0440 \u0441 \u043F\u0440\u043E\u0448\u043B\u043E\u0439
      \u043E\u0441\u0435\u043D\u0438 - \u0433\u043E\u043D\u0435\u0446 \u043D\u0435
      \u0434\u043E\u0431\u0435\u0440\u0451\u0442\u0441\u044F. \u0412\u044B \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A, \u0443 \u0432\u0430\u0441 \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u0430\u044F.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0431\u0443\u0434\u0435\u0442
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435
      \u0432\u044C\u044E\u043A\u0430 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0435\u0441\u043B\u0438 \u0432\u044B \u0437\u043D\u0430\u0435\u0442\u0435,
      \u0447\u0442\u043E \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C.\" \u042D\u0442\u043E
      \u043D\u0435 \u043F\u0440\u043E\u0441\u044C\u0431\u0430. \u0422\u0430\u043D
      \u043D\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442, \u0447\u0442\u043E
      \u0432 \u043F\u0438\u0441\u044C\u043C\u0435. \u0421\u0430\u043A\u043A \u043D\u0430
      \u043F\u043E\u043A\u0440\u044B\u0442\u0438\u0435 \u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0445
      \u0440\u0430\u0441\u0445\u043E\u0434\u043E\u0432 \u0443\u0436\u0435 \u043B\u0435\u0436\u0438\u0442
      \u043D\u0430 \u0441\u0442\u043E\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276137
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276138
    m_Localized: "\u0422\u0430\u043D \u043B\u0438\u0447\u043D\u043E \u0441\u0442\u0430\u0432\u0438\u0442
      \u043F\u0435\u0447\u0430\u0442\u044C \u043D\u0430 \u0432\u0430\u0448 \u0433\u0443\u0430\u043D\u044C\u0434\u0438\u0435
      - \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0437\u043D\u0430\u043A \u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0433\u043E
      \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276139
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F -
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276140
    m_Localized: "\u0422\u0430\u043D \u043A\u043E\u0440\u043E\u0442\u043A\u043E \u043A\u0438\u0432\u0430\u0435\u0442
      \u0438 \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0441\u0430\u043A\u043A
      \u0441\u043E \u0441\u0442\u043E\u043B\u0430. \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435
      \u0438\u0437 \u0437\u0430\u043B\u0430 \u043D\u0435 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276141
    m_Localized: "\u0427\u0430\u0441\u0442\u0438\u0447\u043D\u0430\u044F \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276142
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u0442\u044C
      \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276143
    m_Localized: "\u0421\u043E\u0433\u0434\u0438\u0435\u0446 \u043A\u0430\u0447\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439 - \u0434\u0430\u043B\u044C\u0448\u0435
      \u0438\u0434\u0443\u0442 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u0435
      \u0437\u043D\u0430\u043A\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043E\u043D \u043D\u0435 \u0437\u043D\u0430\u0435\u0442. \u0427\u0430\u0441\u0442\u044C
      \u043A\u043E\u0434\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0430: \u0440\u0435\u0447\u044C
      \u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0438 \u0432\u043E\u0439\u0441\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276144
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u0432 \u0440\u0443\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276145
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u043D\u0430\u0434\u0451\u0436\u043D\u043E
      \u0441\u043F\u0440\u044F\u0442\u0430\u043D\u043E \u0432 \u0434\u0432\u043E\u0439\u043D\u043E\u043C
      \u0434\u043D\u0435 \u0432\u044C\u044E\u043A\u0430 \u0441 \u0442\u043A\u0430\u043D\u044F\u043C\u0438.
      \u0421\u043E\u0433\u0434\u0438\u0435\u0446 \u0443\u0441\u043F\u0435\u043B \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0442\u0440\u043E\u043A:
      \u0446\u0438\u0444\u0440\u044B, \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F
      \u0437\u0430\u0441\u0442\u0430\u0432, \u0438\u043C\u0435\u043D\u0430 \u0434\u0432\u0443\u0445
      \u0433\u0435\u043D\u0435\u0440\u0430\u043B\u043E\u0432. \u0412\u044B \u043D\u0435
      \u0437\u043D\u0430\u0435\u0442\u0435, \u0447\u044C\u0438 \u044D\u0442\u043E
      \u0432\u043E\u0439\u0441\u043A\u0430 - \u0442\u0430\u043D\u0441\u043A\u0438\u0435
      \u0438\u043B\u0438 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0435.
      \u0412\u0430\u0436\u043D\u043E, \u0447\u0442\u043E \u0442\u0430\u043D \u0425\u044D
      \u0411\u0438\u043D\u044C \u0436\u0434\u0451\u0442 \u044D\u0442\u0438\u0445
      \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276146
    m_Localized: "\u0412\u044B\u0434\u0432\u0438\u043D\u0443\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0437\u0430\u043F\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276147
    m_Localized: "\u041C\u0430\u0440\u0448\u0440\u0443\u0442 \u0447\u0435\u0440\u0435\u0437
      \u0433\u043E\u0440\u043D\u044B\u0435 \u0442\u0440\u043E\u043F\u044B \u0434\u043B\u0438\u043D\u043D\u0435\u0435,
      \u0437\u0430\u0442\u043E \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0445
      \u043F\u043E\u0441\u0442\u043E\u0432 \u043C\u0435\u043D\u044C\u0448\u0435.
      \u0412\u044B \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442\u0435 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276148
    m_Localized: "\u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u0438\u0431\u043D
      \u042E\u0441\u0443\u0444"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276149
    m_Localized: "\u041E\u043D \u0436\u0434\u0451\u0442 \u0432\u0430\u0441 \u0432
      \u0442\u0435\u043D\u0438 \u043D\u0430\u0432\u0435\u0441\u0430 \u043D\u0430\u0434
      \u043B\u043E\u0442\u043A\u0430\u043C\u0438 \u0441 \u0438\u043C\u0431\u0438\u0440\u0451\u043C
      - \u0437\u0430\u043F\u0430\u0445 \u0441\u043F\u0435\u0446\u0438\u0439 \u0433\u0443\u0441\u0442\u043E\u0439
      \u0438 \u043F\u0440\u0438\u0442\u043E\u0440\u043D\u044B\u0439 \u0432 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u043C
      \u0432\u043E\u0437\u0434\u0443\u0445\u0435 \u0426\u044E\u0430\u043D\u044C\u0447\u0436\u043E\u0443.
      \u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u043D\u0435 \u043F\u043E\u0441\u0442\u0430\u0440\u0435\u043B:
      \u0442\u0435 \u0436\u0435 \u0448\u0438\u0440\u043E\u043A\u0438\u0435 \u043F\u043B\u0435\u0447\u0438,
      \u0442\u0430 \u0436\u0435 \u0437\u043E\u043B\u043E\u0442\u0430\u044F \u0441\u0435\u0440\u044C\u0433\u0430
      \u0432 \u043B\u0435\u0432\u043E\u043C \u0443\u0445\u0435. \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043F\u043E-\u0430\u0440\u0430\u0431\u0441\u043A\u0438, \u0442\u0438\u0445\u043E
      \u0438 \u0440\u043E\u0432\u043D\u043E: \"\u041F\u044F\u0442\u044C \u043B\u0435\u0442
      \u043D\u0430\u0437\u0430\u0434 \u043C\u044B \u043F\u0440\u043E\u0432\u0435\u0437\u043B\u0438
      \u043C\u0443\u0441\u043A\u0443\u0441 \u0447\u0435\u0440\u0435\u0437 \u0442\u0430\u043C\u043E\u0436\u043D\u044E
      \u0426\u044E\u0430\u043D\u044C\u0447\u0436\u043E\u0443. \u0422\u044B \u0432\u0437\u044F\u043B
      \u0434\u0432\u0435 \u0442\u0440\u0435\u0442\u0438, \u044F \u043E\u0434\u043D\u0443.
      \u0421\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E \u043B\u0438
      \u044D\u0442\u043E \u0431\u044B\u043B\u043E?\" \u041E\u043D \u043D\u0435 \u0443\u0433\u0440\u043E\u0436\u0430\u0435\u0442
      \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E. \u041F\u0440\u043E\u0441\u0442\u043E
      \u043A\u043B\u0430\u0434\u0451\u0442 \u043D\u0430 \u043B\u043E\u0442\u043E\u043A
      \u043B\u0438\u0441\u0442\u043E\u043A \u0441 \u0446\u0438\u0444\u0440\u043E\u0439
      - \u0434\u0432\u0435\u0441\u0442\u0438 \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C. \u0422\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u044B\u0439
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u0424\u0443 \u041B\u044F\u043D
      \u0437\u043D\u0430\u0435\u0442 \u0410\u0431\u0443 \u0411\u0430\u043A\u0440\u0430
      \u043B\u0438\u0447\u043D\u043E: \u043E\u043D\u0438 \u0437\u0435\u043C\u043B\u044F\u043A\u0438,
      \u043E\u0431\u0430 \u0438\u0437 \u0411\u0430\u0441\u0440\u044B. \u0415\u0441\u043B\u0438
      \u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u0443 \u0432\u0430\u0441 \u043D\u0430\u0447\u043D\u0443\u0442\u0441\u044F
      \u0432\u043E\u043F\u0440\u043E\u0441\u044B \u043E \u043F\u0440\u043E\u0448\u043B\u044B\u0445
      \u0433\u0440\u0443\u0437\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276150
    m_Localized: "\u0412\u044B\u0441\u043B\u0443\u0448\u0430\u0442\u044C \u0438 \u043E\u0431\u0434\u0443\u043C\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276151
    m_Localized: "\u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u0434\u0430\u0451\u0442
      \u0441\u0435\u043C\u044C \u0434\u043D\u0435\u0439. \u041E\u043D \u0443\u0445\u043E\u0434\u0438\u0442
      \u043D\u0435 \u043F\u0440\u043E\u0449\u0430\u044F\u0441\u044C, \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u044F\u044F\u0441\u044C
      \u0432 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u0439 \u0442\u043E\u043B\u043F\u0435
      \u0440\u044B\u043D\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276152
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u0441\u0440\u0430\u0437\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276153
    m_Localized: "\u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u0447\u0442\u043E \u0441\u0435\u043C\u044C \u0434\u043D\u0435\u0439 \u0432\u0441\u0451
      \u0440\u0430\u0432\u043D\u043E \u0435\u0441\u0442\u044C. \u041E\u043D \u0443\u0445\u043E\u0434\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276154
    m_Localized: "\u0422\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F \u043E\u0437\u0432\u0443\u0447\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276155
    m_Localized: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276156
    m_Localized: "\u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0438\u043C\u044F \u043C\u0435\u043D\u044F\u043B\u044B \u043D\u0430 \u0431\u0435\u0440\u0435\u0433\u0443
      - \u0442\u0430\u043C \u043C\u043E\u0436\u043D\u043E \u0440\u0430\u0437\u043C\u0435\u043D\u044F\u0442\u044C
      \u043C\u043E\u043D\u0435\u0442\u044B \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0433\u043B\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276157
    m_Localized: "\u0423\u0441\u043B\u043E\u0432\u0438\u044F \u044F\u0441\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276158
    m_Localized: "\u0414\u0432\u0435\u0441\u0442\u0438 \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      - \u044D\u0442\u043E \u0446\u0435\u043D\u0430 \u0447\u0435\u0442\u044B\u0440\u0451\u0445
      \u0432\u044C\u044E\u043A\u043E\u0432 \u043C\u0443\u0441\u043A\u0443\u0441\u0430
      \u043F\u043E \u0442\u0435\u043A\u0443\u0449\u0435\u043C\u0443 \u043A\u0443\u0440\u0441\u0443
      \u0438\u043B\u0438 \u0442\u0440\u0451\u0445 \u043C\u0435\u0441\u044F\u0446\u0435\u0432
      \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438. \u0410\u0431\u0443 \u0411\u0430\u043A\u0440
      \u0434\u0430\u043B \u0441\u0440\u043E\u043A \u0432 \u0441\u0435\u043C\u044C
      \u0434\u043D\u0435\u0439, \u043D\u043E \u0441\u0430\u043C \u0436\u0438\u0432\u0451\u0442
      \u0432 \u043F\u043E\u0440\u0442\u0443 \u0438 \u043D\u0438\u0433\u0434\u0435
      \u043D\u0435 \u0441\u043F\u0435\u0448\u0438\u0442. \u041C\u043E\u0436\u043D\u043E
      \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438,
      \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0439\u0442\u0438 \u043D\u0430
      \u043D\u0435\u0433\u043E \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0430\u0442
      \u0443 \u043C\u0435\u0441\u0442\u043D\u044B\u0445 \u043C\u0435\u043D\u044F\u043B
      - \u043E\u043D \u0434\u0430\u0432\u043D\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0432 \u0426\u044E\u0430\u043D\u044C\u0447\u0436\u043E\u0443 \u0438 \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B \u0441\u043B\u0435\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276159
    m_Localized: "\u041D\u0430\u0447\u0430\u0442\u044C \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C
      \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0438\u043B\u0438 \u0438\u0441\u043A\u0430\u0442\u044C
      \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276160
    m_Localized: "\u0421\u0435\u043C\u044C \u0434\u043D\u0435\u0439 - \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
      \u0435\u0441\u043B\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0441\u0440\u0430\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276161
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u041F\u0430\u043D\u044C - \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C
      \u043E\u0431\u0435\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276162
    m_Localized: "\u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u0443 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442 \u042E\u0439\u043C\u044D\u043D\u044F \u043F\u0430\u0445\u043D\u0435\u0442
      \u0433\u043E\u0440\u044F\u0447\u0438\u043C \u0432\u043E\u0441\u043A\u043E\u043C
      \u0438 \u043F\u044B\u043B\u044C\u044E. \u041C\u043E\u043D\u0430\u0445 \u041F\u0430\u043D\u044C
      - \u0441\u0442\u0430\u0440\u0438\u043A \u0441 \u043E\u0431\u0440\u0438\u0442\u043E\u0439
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0438 \u0441\u0435\u0440\u044B\u043C\u0438
      \u0431\u0440\u043E\u0432\u044F\u043C\u0438 - \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0432 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u0439
      \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u0441 \u0433\u043B\u0438\u043D\u044F\u043D\u044B\u043C
      \u0411\u0443\u0434\u0434\u043E\u0439 \u0432 \u0443\u0433\u043B\u0443. \u041E\u043D
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0431\u0435\u0437 \u043E\u0441\u0443\u0436\u0434\u0435\u043D\u0438\u044F,
      \u0433\u043B\u044F\u0434\u044F \u043C\u0438\u043C\u043E \u0432\u0430\u0441:
      \"\u0421\u0435\u043C\u044C \u043B\u0435\u0442 - \u0434\u043E\u043B\u0433\u0438\u0439
      \u0441\u0440\u043E\u043A. \u041D\u043E \u043B\u044E\u0434\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043E\u0431\u0438\u0434\u0435\u043B\u0438, \u0436\u0438\u0432\u0443\u0442
      \u0441 \u044D\u0442\u0438\u043C \u043A\u0430\u0436\u0434\u044B\u0439 \u0434\u0435\u043D\u044C.\"
      \u041E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0442\u0440\u043E\u0438\u0445:
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D,
      \u0447\u044C\u0438 \u0434\u0435\u043D\u044C\u0433\u0438 \u0443\u0448\u043B\u0438
      \u043D\u0430 \u0435\u0434\u0443 \u0434\u043B\u044F \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432;
      \u043B\u0430\u0432\u043E\u0447\u043D\u0438\u043A \u0438\u0437 \u041C\u0430\u043D\u044C\u0433\u0443,
      \u043F\u043E\u0442\u0435\u0440\u044F\u0432\u0448\u0438\u0439 \u0448\u0451\u043B\u043A;
      \u0441\u0435\u043C\u044C\u044F \u0438\u0437 \u0425\u0430\u043C\u0438, \u0443
      \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043E\u0442\u043D\u044F\u043B\u0438
      \u043C\u0443\u043B\u043E\u0432. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0434\u043E \u0441\u0438\u0445 \u043F\u043E\u0440 \u0445\u043E\u0434\u0438\u0442
      \u043F\u0435\u0448\u043A\u043E\u043C - \u043B\u043E\u0448\u0430\u0434\u044C
      \u0442\u0430\u043A \u0438 \u043D\u0435 \u043A\u0443\u043F\u0438\u043B. \u041C\u043E\u043D\u0430\u0445
      \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043D\u0438\u0447\u0435\u0433\u043E.
      \u041E\u043D \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438 \u0441\u043F\u0438\u0441\u043E\u043A
      \u0438 \u043C\u043E\u043B\u0447\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276163
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0441\u043F\u0438\u0441\u043E\u043A
      \u0438 \u043D\u0430\u0447\u0430\u0442\u044C \u0432\u043E\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276164
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0441\u043F\u0438\u0441\u043E\u043A \u0432 \u0432\u0430\u0448\u0438 \u0440\u0443\u043A\u0438.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0436\u0438\u0432\u0451\u0442
      \u043D\u0430 \u0443\u043B\u0438\u0446\u0435 \u043A\u0443\u0437\u043D\u0435\u0446\u043E\u0432
      - \u043E\u043D \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276165
    m_Localized: "\u0423\u0439\u0442\u0438 - \u043F\u0440\u043E\u0448\u043B\u043E\u0435
      \u043D\u0435 \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276166
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u043A\u0438\u0432\u0430\u0435\u0442
      \u0438 \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u0441\u043F\u0438\u0441\u043E\u043A.
      \u0414\u043E\u043B\u0433\u0438 \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F
      \u0434\u043E\u043B\u0433\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276167
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276168
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u043C\u043E\u043D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276169
    m_Localized: "\u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0431\u0435\u0440\u0451\u0442
      \u043C\u043E\u043D\u0435\u0442\u044B \u0438 \u043A\u043B\u0430\u0434\u0451\u0442
      \u0432 \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u043C\u0435\u0448\u043E\u0447\u0435\u043A
      \u043D\u0430 \u043F\u043E\u044F\u0441\u0435. \u0421\u043B\u043E\u0432 \u043D\u0435\u0442,
      \u043D\u043E \u043F\u043B\u0435\u0447\u0438 \u0443 \u043D\u0435\u0433\u043E
      \u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442\u0441\u044F - \u043F\u0435\u0440\u0432\u044B\u0439
      \u0440\u0430\u0437 \u0437\u0430 \u0434\u043E\u043B\u0433\u043E\u0435 \u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276170
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0434\u043E\u043B\u0433 \u043F\u043E\u0433\u0430\u0448\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276171
    m_Localized: "\u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u043F\u0440\u0438\u043D\u044F\u043B
      \u0434\u0435\u043D\u044C\u0433\u0438 \u043C\u043E\u043B\u0447\u0430. \u041E\u043D
      \u0436\u0438\u0432\u0451\u0442 \u0432 \u043E\u0434\u043D\u043E\u0439 \u043A\u043E\u043C\u043D\u0430\u0442\u0435
      \u0441 \u043C\u043B\u0430\u0434\u0448\u0438\u043C \u0431\u0440\u0430\u0442\u043E\u043C
      - \u043E\u0431\u0430 \u0433\u043E\u043D\u044F\u0442 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432
      \u0434\u043B\u044F \u0447\u0443\u0436\u0438\u0445 \u0445\u043E\u0437\u044F\u0435\u0432.
      \u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u043C\u043E\u043D\u0435\u0442
      \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u0442 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0445
      \u043B\u0435\u0442, \u043D\u043E \u0434\u044B\u0440\u0430 \u0432 \u0435\u0433\u043E
      \u043A\u043E\u0448\u0435\u043B\u044C\u043A\u0435 \u0437\u0430\u043A\u0440\u044B\u0442\u0430.
      \u041E\u043D \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u0438\u043B \u0432\u0441\u043B\u0443\u0445.
      \u041D\u043E \u0438 \u043D\u0435 \u043F\u0440\u043E\u0433\u043D\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276172
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u0432\u0442\u043E\u0440\u0443\u044E
      \u0441\u0435\u043C\u044C\u044E \u0432 \u0426\u0437\u044E\u0446\u044E\u0430\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276173
    m_Localized: "\u041B\u0430\u0432\u043E\u0447\u043D\u0438\u043A \u0438\u0437 \u041C\u0430\u043D\u044C\u0433\u0443
      \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B \u0432 \u0426\u0437\u044E\u0446\u044E\u0430\u043D\u044C
      \u0442\u0440\u0438 \u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434
      - \u044D\u0442\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276174
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 - \u0431\u0443\u043A\u0438\u043D\u0438\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276175
    m_Localized: "\u041B\u0430\u0432\u043A\u0430 \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0430
      \u0432 \u041F\u0435\u043A\u0438\u043D\u0435 \u043F\u0430\u0445\u043D\u0435\u0442
      \u0441\u0442\u0430\u0440\u044B\u043C \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u043E\u043C
      \u0438 \u0442\u043C\u0438\u043D\u043E\u043C - \u043E\u043D \u0445\u0440\u0430\u043D\u0438\u0442
      \u0441\u043F\u0435\u0446\u0438\u0438 \u043C\u0435\u0436\u0434\u0443 \u0441\u0442\u0440\u0430\u043D\u0438\u0446\u0430\u043C\u0438
      \u043E\u0442 \u043C\u043E\u043B\u0438. \u0421\u043E\u0433\u0434\u0438\u0435\u0446-\u0431\u0443\u043A\u0438\u043D\u0438\u0441\u0442
      \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u0430\u0441,
      \u043D\u0435 \u0432\u0441\u0442\u0430\u0432\u0430\u044F \u0441 \u043D\u0438\u0437\u043A\u043E\u0433\u043E
      \u0441\u0442\u0443\u043B\u0430, \u0438 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u043F\u043E\u043B\u043A\u0443 \u0443 \u043B\u0435\u0432\u043E\u0439
      \u0441\u0442\u0435\u043D\u044B: \u0442\u0430\u043C \u0432 \u043A\u043E\u0436\u0430\u043D\u043E\u043C
      \u0444\u0443\u0442\u043B\u044F\u0440\u0435 \u043B\u0435\u0436\u0438\u0442 \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C.
      \"\u0412\u0430\u0448 \u043E\u0442\u0435\u0446 \u0410\u0445\u043C\u0430\u0434
      \u0438\u0431\u043D \u041C\u0443\u0445\u0430\u043C\u043C\u0430\u0434 \u043D\u0430\u043F\u0438\u0441\u0430\u043B
      \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0442\u0440\u0430\u043A\u0442\u0430\u0442,\"
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442.
      \"\u041F\u0435\u0440\u0432\u0443\u044E \u0447\u0430\u0441\u0442\u044C \u044F
      \u043A\u0443\u043F\u0438\u043B \u0443 \u043F\u0435\u0440\u0435\u043A\u0443\u043F\u0449\u0438\u043A\u0430
      \u0434\u0432\u0430 \u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434.
      \u0426\u0435\u043D\u0430 \u0431\u044B\u043B\u0430 \u0447\u0435\u0441\u0442\u043D\u0430\u044F,
      \u0438 \u043C\u043E\u044F \u0446\u0435\u043D\u0430 \u0442\u043E\u0436\u0435
      \u0447\u0435\u0441\u0442\u043D\u0430\u044F: \u0441\u043E\u0440\u043E\u043A
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0438\u043B\u0438 \u0440\u0430\u0432\u043D\u043E\u0446\u0435\u043D\u043D\u044B\u0439
      \u043E\u0431\u043C\u0435\u043D.\" \u0420\u0443\u043A\u043E\u043F\u0438\u0441\u044C
      \u0432\u0438\u0434\u043D\u0430 \u0447\u0435\u0440\u0435\u0437 \u0449\u0435\u043B\u044C
      \u0432 \u0444\u0443\u0442\u043B\u044F\u0440\u0435 - \u043F\u043E\u0447\u0435\u0440\u043A
      \u043E\u0442\u0446\u0430, \u0447\u0435\u0440\u043D\u0438\u043B\u0430 \u0441
      \u043C\u0435\u0434\u043D\u044B\u043C \u043E\u0442\u043B\u0438\u0432\u043E\u043C.
      \u0422\u0440\u0430\u043A\u0442\u0430\u0442 \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u043B
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B \u043E\u0442 \u0427\u0430\u043D\u044A\u0430\u043D\u044F
      \u0434\u043E \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430 \u0441
      \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u0435\u043C \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0445
      \u0434\u0432\u043E\u0440\u043E\u0432, \u0446\u0435\u043D \u043D\u0430 \u0432\u043E\u0434\u0443
      \u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0445 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432.
      \u0414\u043B\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430 \u0442\u0430\u043A\u0430\u044F
      \u043A\u043D\u0438\u0433\u0430 - \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276176
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u043E \u0446\u0435\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276177
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C \u0442\u0440\u0438 \u0434\u043D\u044F
      - \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E, \u0447\u0442\u043E\u0431\u044B
      \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u043C\u043E\u043D\u0435\u0442\u044B
      \u0438\u043B\u0438 \u043D\u0430\u0439\u0442\u0438 \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0449\u0438\u0439
      \u0442\u043E\u0432\u0430\u0440 \u0434\u043B\u044F \u043E\u0431\u043C\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276178
    m_Localized: "\u0423\u0439\u0442\u0438 - \u043F\u043E\u0434\u0443\u043C\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276179
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B. \u0420\u0443\u043A\u043E\u043F\u0438\u0441\u044C
      \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043D\u0430 \u043F\u043E\u043B\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276180
    m_Localized: "\u041F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B \u0443
      \u043F\u0440\u0438\u043B\u0430\u0432\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276181
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0438\u043B\u0438
      \u043E\u0431\u043C\u0435\u043D\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276182
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u043E\u043F\u043B\u0430\u0442\u0443 \u0438 \u0441\u043D\u0438\u043C\u0430\u0435\u0442
      \u0444\u0443\u0442\u043B\u044F\u0440 \u0441 \u043F\u043E\u043B\u043A\u0438
      - \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u043A \u0432\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276183
    m_Localized: "\u041F\u0435\u0440\u0432\u0430\u044F \u0447\u0430\u0441\u0442\u044C
      \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276184
    m_Localized: "\u0420\u0443\u043A\u043E\u043F\u0438\u0441\u044C \u0432 \u0440\u0443\u043A\u0430\u0445.
      \u041F\u0435\u0440\u0432\u0430\u044F \u0447\u0430\u0441\u0442\u044C \u0442\u0440\u0430\u043A\u0442\u0430\u0442\u0430
      \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u043E\u0442 \u0427\u0430\u043D\u044A\u0430\u043D\u044F \u0434\u043E \u041B\u0430\u043D\u044C\u0447\u0436\u043E\u0443
      \u0441 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u044B\u043C\u0438 \u043F\u043E\u043C\u0435\u0442\u043A\u0430\u043C\u0438
      \u043E \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0445 \u0434\u0432\u043E\u0440\u0430\u0445
      \u0438 \u0446\u0435\u043D\u0430\u0445 \u043D\u0430 \u0437\u0435\u0440\u043D\u043E.
      \u041F\u043E\u0447\u0435\u0440\u043A \u043E\u0442\u0446\u0430 \u043C\u0435\u043B\u043A\u0438\u0439
      \u0438 \u0440\u043E\u0432\u043D\u044B\u0439. \u041D\u0430 \u043F\u043E\u043B\u044F\u0445
      - \u043F\u0440\u0438\u043F\u0438\u0441\u043A\u0438 \u0434\u0440\u0443\u0433\u0438\u043C
      \u043F\u043E\u0447\u0435\u0440\u043A\u043E\u043C: \u043F\u0435\u0440\u0435\u043A\u0443\u043F\u0449\u0438\u043A
      \u0447\u0442\u043E-\u0442\u043E \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u043B.
      \u0412\u0442\u043E\u0440\u0430\u044F \u0447\u0430\u0441\u0442\u044C, \u043F\u043E
      \u0441\u043B\u043E\u0432\u0430\u043C \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0430,
      \u0443\u0448\u043B\u0430 \u043D\u0430 \u044E\u0433 - \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C
      \u0431\u043B\u0438\u0437 \u041B\u0438\u0446\u0437\u044F\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276185
    m_Localized: "\u041D\u0430\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u043A \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276186
    m_Localized: "\u041F\u0443\u0442\u044C \u043D\u0430 \u044E\u0433 \u0447\u0435\u0440\u0435\u0437
      \u0433\u043E\u0440\u044B \u0434\u043E\u043B\u0433\u0438\u0439, \u043D\u043E
      \u043C\u043E\u043D\u0430\u0445\u0438 \u0445\u0440\u0430\u043D\u044F\u0442 \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u0438
      \u043B\u0443\u0447\u0448\u0435 \u043B\u044E\u0431\u043E\u0433\u043E \u0441\u043A\u043B\u0430\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276187
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u0425\u0443\u044D\u0439 \u041D\u044D\u043D
      - \u043D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276188
    m_Localized: "\u0425\u0440\u0430\u043C \u0424\u0430\u043C\u0435\u043D\u0441\u044B
      \u0441\u0442\u043E\u0438\u0442 \u0432 \u0434\u0432\u0443\u0445 \u043B\u0438
      \u043A \u0437\u0430\u043F\u0430\u0434\u0443 \u043E\u0442 \u0427\u0430\u043D\u044A\u0430\u043D\u044F
      - \u0437\u0430\u043F\u0430\u0445 \u0441\u043E\u0441\u0435\u043D \u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0433\u043E
      \u043A\u0430\u043C\u043D\u044F \u0443\u0436\u0435 \u0441 \u0434\u043E\u0440\u043E\u0433\u0438.
      \u041D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C \u0425\u0443\u044D\u0439
      \u041D\u044D\u043D \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u043E\u0432
      \u0443 \u0433\u043B\u0430\u0432\u043D\u044B\u0445 \u0432\u043E\u0440\u043E\u0442,
      \u0433\u0434\u0435 \u0441\u0442\u0443\u043F\u0435\u043D\u0438 \u043E\u0442\u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u044B
      \u0442\u044B\u0441\u044F\u0447\u0430\u043C\u0438 \u043D\u043E\u0433. \u041E\u043D
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0441
      \u0434\u043E\u043B\u0433\u043E, \u043F\u043E\u0442\u043E\u043C \u043A\u0438\u0432\u0430\u0435\u0442:
      \"\u041E\u0431\u0435\u0442 \u0432 \u0442\u0440\u0451\u0445 \u043C\u0435\u0441\u0442\u0430\u0445
      - \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044C. \u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E
      \u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0443\u044E\u0442\u0441\u044F
      \u043E\u0434\u043D\u0438\u043C \u0445\u0440\u0430\u043C\u043E\u043C.\" \u041E\u043D
      \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442,
      \u043F\u043E\u0447\u0435\u043C\u0443 \u0442\u0440\u0438. \u0414\u043B\u044F
      \u0431\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u043E\u0433\u043E \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u0430
      \u043F\u0440\u0438\u043D\u044F\u0442\u043E \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442\u044C
      \u043B\u0430\u0434\u0430\u043D \u043A \u043C\u043E\u0449\u0430\u043C \u0411\u0443\u0434\u0434\u044B
      - \u0447\u0430\u0441\u0442\u0438\u0446\u0430 \u043A\u043E\u0441\u0442\u0438
      \u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F \u0437\u0434\u0435\u0441\u044C
      \u0441 \u0434\u0435\u0432\u044F\u0442\u043E\u0433\u043E \u0433\u043E\u0434\u0430
      \u044D\u0440\u044B \u0427\u0436\u044D\u043D\u0433\u0443\u0430\u043D\u044C.
      \u041D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442
      \u043F\u043E\u0440\u044F\u0434\u043E\u043A: \u043E\u0447\u0438\u0441\u0442\u0438\u0442\u044C\u0441\u044F
      \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430, \u0442\u0440\u043E\u0435\u043A\u0440\u0430\u0442\u043D\u043E
      \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u0442\u044C\u0441\u044F, \u043F\u043E\u043B\u043E\u0436\u0438\u0442\u044C
      \u043B\u0430\u0434\u0430\u043D \u043D\u0430 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439
      \u043F\u043E\u0434\u043D\u043E\u0441 \u0443 \u0440\u0435\u043B\u0438\u043A\u0432\u0430\u0440\u0438\u044F.
      \u041F\u043E\u0442\u043E\u043C \u043E\u043D \u0434\u0430\u0441\u0442 \u043F\u0435\u0440\u0432\u0443\u044E
      \u043F\u0435\u0447\u0430\u0442\u044C \u043D\u0430 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276189
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043E\u0431\u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276190
    m_Localized: "\u041D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C \u0432\u0435\u0434\u0451\u0442
      \u0432\u0430\u0441 \u043A \u043A\u043E\u043B\u043E\u0434\u0446\u0443. \u0412\u043E\u0434\u0430
      \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F \u0434\u0430\u0436\u0435 \u0432
      \u043B\u0435\u0442\u043D\u0438\u0439 \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276191
    m_Localized: "\u0423\u0439\u0442\u0438 - \u0432\u0440\u0435\u043C\u044F \u043D\u0435
      \u043F\u0440\u0438\u0448\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276192
    m_Localized: "\u041D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C \u043D\u0435
      \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442. \u0412\u043E\u0440\u043E\u0442\u0430
      \u043E\u0441\u0442\u0430\u044E\u0442\u0441\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276193
    m_Localized: "\u041F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0435 \u0443
      \u0440\u0435\u043B\u0438\u043A\u0432\u0430\u0440\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276194
    m_Localized: "\u041F\u043E\u043B\u043E\u0436\u0438\u0442\u044C \u043B\u0430\u0434\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993398276195
    m_Localized: "\u041B\u0430\u0434\u0430\u043D \u0442\u043B\u0435\u0435\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E.
      \u041D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C \u0441\u0442\u0430\u0432\u0438\u0442
      \u043A\u0432\u0430\u0434\u0440\u0430\u0442\u043D\u0443\u044E \u043A\u0440\u0430\u0441\u043D\u0443\u044E
      \u043F\u0435\u0447\u0430\u0442\u044C \u043D\u0430 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470400
    m_Localized: "\u041F\u0435\u0440\u0432\u043E\u0435 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470401
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0433\u0440\u0430\u043C\u043E\u0442\u0430 \u0441 \u043F\u0435\u0440\u0432\u043E\u0439
      \u043F\u0435\u0447\u0430\u0442\u044C\u044E \u043B\u0435\u0436\u0438\u0442 \u0432
      \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439 \u0441\u0443\u043C\u043A\u0435.
      \u0417\u0430\u043F\u0430\u0445 \u0441\u0430\u043D\u0434\u0430\u043B\u0430 \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043D\u0430 \u043E\u0434\u0435\u0436\u0434\u0435 \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0432\u0435\u0447\u0435\u0440\u0430. \u041D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C
      \u0441\u043A\u0430\u0437\u0430\u043B: \u0437\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u0438\u0439
      \u043E\u0433\u043E\u043D\u044C \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u043E\u0432
      \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u043C\u0435\u0441\u044F\u0446\u0430 \u043F\u043E \u043B\u0443\u043D\u043D\u043E\u043C\u0443
      \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u044E. \u0414\u043E \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      \u043C\u0435\u0441\u044F\u0446\u0430 \u0434\u0432\u0430 \u043F\u043E \u0437\u0430\u043F\u0430\u0434\u043D\u043E\u043C\u0443
      \u0442\u0440\u0430\u043A\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470402
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u043D\u0430 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0439
      \u0442\u0440\u0430\u043A\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470403
    m_Localized: "\u0414\u043E\u0440\u043E\u0433\u0430 \u043D\u0430 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442\u0441\u044F \u0443 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442 \u0427\u0430\u043D\u044A\u0430\u043D\u0438 -
      \u0442\u0443\u0434\u0430, \u0433\u0434\u0435 \u0425\u044D\u0441\u0438-\u043A\u043E\u0440\u0438\u0434\u043E\u0440
      \u0443\u0445\u043E\u0434\u0438\u0442 \u0437\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470404
    m_Localized: "\u0410\u0440\u0445\u0438\u0432 \u041B\u0443\u043E\u044F\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470405
    m_Localized: "\u0412 \u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435 \u0443\u0435\u0437\u0434\u043D\u043E\u0433\u043E
      \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F \u041B\u0443\u043E\u044F\u043D\u0430
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0441\u044B\u0440\u044B\u043C \u0434\u0435\u0440\u0435\u0432\u043E\u043C
      \u0438 \u0442\u0443\u0448\u044C\u044E. \u0414\u0443\u043D \u0412\u044D\u0439
      \u043F\u0435\u0440\u0435\u0431\u0438\u0440\u0430\u0435\u0442 \u0441\u0432\u044F\u0437\u043A\u0438
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u043E\u0432 \u043F\u0440\u0438
      \u0441\u0432\u0435\u0442\u0435 \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0433\u043E
      \u0441\u0432\u0435\u0442\u0438\u043B\u044C\u043D\u0438\u043A\u0430 - \u043F\u043E\u0448\u043B\u0438\u043D\u043D\u044B\u0435
      \u0437\u0430\u043F\u0438\u0441\u0438 \u0437\u0430 \u0441\u0435\u043C\u044C
      \u043B\u0435\u0442 \u0433\u0440\u043E\u043C\u043E\u0437\u0434\u044F\u0442\u0441\u044F
      \u043D\u0430 \u043F\u043E\u043B\u043A\u0430\u0445 \u0434\u043E \u043F\u043E\u0442\u043E\u043B\u043A\u0430.
      \u041F\u0438\u0441\u0430\u0440\u044C \u0427\u044D\u043D\u044C \u0424\u0443
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430\u0441\u0442\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u043E:
      \u043F\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u043C \u0432 \u0430\u0440\u0445\u0438\u0432
      \u0432\u0445\u043E\u0434 \u0437\u0430\u043A\u0440\u044B\u0442, \u0438 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435
      \u043F\u0438\u0441\u044C\u043C\u043E \u043E\u0442 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u044B \u043E\u0442\u043A\u0440\u044B\u043B\u043E
      \u044D\u0442\u0443 \u0434\u0432\u0435\u0440\u044C. \u0421\u0440\u0435\u0434\u0438
      \u043F\u043E\u0436\u0435\u043B\u0442\u0435\u0432\u0448\u0438\u0445 \u0441\u0432\u0438\u0442\u043A\u043E\u0432
      \u0434\u043E\u043B\u0436\u0435\u043D \u0431\u044B\u0442\u044C \u0440\u0435\u0435\u0441\u0442\u0440
      \u0433\u0440\u0443\u0437\u043E\u0432 \u0437\u0430 \u043E\u0441\u0435\u043D\u044C
      \u0434\u0435\u0432\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u043E\u0433\u043E
      \u0433\u043E\u0434\u0430 - \u0442\u0430\u043C, \u0433\u0434\u0435 \u043F\u043E\u0434\u043F\u0438\u0441\u044C
      \u043E\u0442\u0446\u0430 \u0441\u0442\u043E\u0438\u0442 \u0440\u044F\u0434\u043E\u043C
      \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E \u0442\u0430\u043C\u043E\u0436\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470406
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u0440\u0435\u0435\u0441\u0442\u0440
      \u0433\u0440\u0443\u0437\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470407
    m_Localized: "\u0414\u0443\u043D \u0412\u044D\u0439 \u043D\u0430\u0445\u043E\u0434\u0438\u0442
      \u043D\u0443\u0436\u043D\u044B\u0439 \u0441\u0432\u0438\u0442\u043E\u043A \u0432
      \u0442\u0440\u0435\u0442\u044C\u0435\u0439 \u0441\u0432\u044F\u0437\u043A\u0435.
      \u041F\u043E\u0434\u043F\u0438\u0441\u044C \u043E\u0442\u0446\u0430 \u0441\u0442\u043E\u0438\u0442
      \u043F\u043E\u0434 \u0437\u0430\u043F\u0438\u0441\u044C\u044E \u043E \u0433\u0440\u0443\u0437\u0435
      \u0448\u0451\u043B\u043A\u0430 - \u0440\u044F\u0434\u043E\u043C \u0441 \u0438\u043C\u0435\u043D\u0435\u043C
      \u041B\u0438 \u0427\u0436\u0443\u043D\u0430, \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0430
      \u0442\u0430\u043C\u043E\u0436\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470408
    m_Localized: "\u0420\u0435\u0435\u0441\u0442\u0440 \u043D\u0430\u0439\u0434\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470409
    m_Localized: "\u0421\u0432\u0438\u0442\u043E\u043A \u0440\u0430\u0437\u0432\u0451\u0440\u043D\u0443\u0442
      \u043D\u0430 \u0441\u0442\u043E\u043B\u0435 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435
      \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E \u0434\u0432\u043E\u0440\u0430.
      \u041F\u044F\u0442\u043D\u043E \u043E\u0442 \u0441\u0442\u0430\u0440\u043E\u0433\u043E
      \u0447\u0430\u044F \u043D\u0430 \u043A\u0440\u0430\u044E \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0430,
      \u0434\u0430\u0442\u0430 - \u043E\u0441\u0435\u043D\u044C \u0434\u0435\u0432\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u043E\u0433\u043E
      \u0433\u043E\u0434\u0430 \u041A\u0430\u0439\u044E\u0430\u043D\u044C. \u041F\u043E\u0434\u043F\u0438\u0441\u044C
      \u043E\u0442\u0446\u0430 \u0441\u0442\u043E\u0438\u0442 \u0440\u044F\u0434\u043E\u043C
      \u0441 \u0437\u0430\u043F\u0438\u0441\u044C\u044E: \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0448\u0442\u0443\u043A \u043F\u0435\u0440\u0432\u043E\u0441\u043E\u0440\u0442\u043D\u043E\u0433\u043E
      \u0448\u0451\u043B\u043A\u0430, \u043F\u0435\u0447\u0430\u0442\u044C \u041B\u0443\u043E\u044F\u043D\u0441\u043A\u043E\u0439
      \u0442\u0430\u043C\u043E\u0436\u043D\u0438, \u0438 \u043D\u0438\u0436\u0435
      - \u0434\u0440\u0443\u0433\u0430\u044F \u0440\u0443\u043A\u0430 \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0430
      \u0446\u0438\u0444\u0440\u0443 \u043D\u0435\u0434\u043E\u0438\u043C\u043A\u0438,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043D\u0438\u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u043E.
      \u0414\u0443\u043D \u0412\u044D\u0439 \u0434\u0435\u0440\u0436\u0438\u0442
      \u0440\u0435\u0435\u0441\u0442\u0440 \u0434\u0432\u0443\u043C\u044F \u0440\u0443\u043A\u0430\u043C\u0438
      - \u044D\u0442\u043E \u043F\u0435\u0440\u0432\u043E\u0435 \u0432\u0435\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435
      \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u0442\u043E\u0433\u043E, \u0447\u0442\u043E \u0434\u0435\u043B\u043E \u0431\u044B\u043B\u043E
      \u0441\u0444\u0430\u0431\u0440\u0438\u043A\u043E\u0432\u0430\u043D\u043E. \u0422\u0435\u043F\u0435\u0440\u044C
      \u043D\u0443\u0436\u0435\u043D \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u0437\u043D\u0430\u044E\u0449\u0438\u0439, \u0447\u044C\u044F \u044D\u0442\u043E
      \u0440\u0443\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470410
    m_Localized: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0430\u0432\u0442\u043E\u0440\u0441\u0442\u0432\u043E
      \u0437\u0430\u043F\u0438\u0441\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470411
    m_Localized: "\u0411\u044B\u0432\u0448\u0438\u0439 \u043F\u0438\u0441\u0430\u0440\u044C
      \u0442\u0430\u043C\u043E\u0436\u043D\u0438 \u0435\u0449\u0451 \u0436\u0438\u0432\u0451\u0442
      \u0432 \u041B\u0443\u043E\u044F\u043D\u0435. \u0415\u0433\u043E \u0438\u043C\u044F
      - \u0412\u0430\u043D \u0428\u0438, \u043E\u043D \u0442\u043E\u0440\u0433\u0443\u0435\u0442
      \u0431\u0443\u043C\u0430\u0433\u043E\u0439 \u0443 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470412
    m_Localized: "\u0426\u0437\u0435\u0434\u0443\u0448\u0438 \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470413
    m_Localized: "\u041F\u0440\u0438\u0451\u043C\u043D\u044B\u0439 \u0437\u0430\u043B
      \u0446\u0437\u0435\u0434\u0443\u0448\u0438 \u0425\u044D\u043D\u0430\u043D\u044C
      \u0437\u0430\u043B\u0438\u0442 \u0443\u0442\u0440\u0435\u043D\u043D\u0438\u043C
      \u0441\u0432\u0435\u0442\u043E\u043C \u0447\u0435\u0440\u0435\u0437 \u0440\u0435\u0448\u0451\u0442\u0447\u0430\u0442\u044B\u0435
      \u043E\u043A\u043D\u0430. \u041B\u0438 \u041B\u0438\u043D\u044C\u0444\u0443
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u0441\u0432\u0438\u0442\u043E\u043A
      \u043E\u0431\u0435\u0438\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438,
      \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E. \u0422\u0438\u0448\u0438\u043D\u0430
      - \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043A\u0440\u0438\u043F \u0435\u0433\u043E
      \u043A\u0440\u0435\u0441\u043B\u0430. \u0414\u0443\u043D \u0412\u044D\u0439
      \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u043B\u044F\u0435\u0442 \u0440\u0435\u0435\u0441\u0442\u0440
      \u0438\u0437 \u043B\u0443\u043E\u044F\u043D\u0441\u043A\u043E\u0433\u043E \u0430\u0440\u0445\u0438\u0432\u0430
      \u0438 \u0441\u043F\u0440\u0430\u0432\u043A\u0443 \u043F\u0438\u0441\u0430\u0440\u044F
      \u0412\u0430\u043D \u0428\u0438: \u043F\u043E\u0434\u043F\u0438\u0441\u044C
      \u0444\u0430\u043B\u044C\u0441\u0438\u0444\u0438\u043A\u0430\u0442\u043E\u0440\u0430
      \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442 \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u0443
      \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u043E\u0433\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435\u043B\u044F,
      \u0431\u0435\u0436\u0430\u0432\u0448\u0435\u043C\u0443 \u0432 \u0425\u044D\u0434\u0443\u043D
      \u0442\u0440\u0438 \u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434.
      \u0426\u0437\u0435\u0434\u0443\u0448\u0438 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0441\u0432\u0438\u0442\u043E\u043A \u0438 \u043F\u0440\u043E\u0438\u0437\u043D\u043E\u0441\u0438\u0442
      \u043E\u0434\u043D\u043E \u0441\u043B\u043E\u0432\u043E: \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E.
      \u0414\u0435\u043B\u043E \u043E \u043D\u0435\u0434\u043E\u0438\u043C\u043A\u0435
      \u043E\u0442\u0446\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u043E, \u043A\u043E\u043D\u0444\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E \u043F\u043E\u0434\u043B\u0435\u0436\u0438\u0442
      \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0443 \u0432 \u0442\u0435\u0447\u0435\u043D\u0438\u0435
      \u0434\u0432\u0443\u0445 \u043C\u0435\u0441\u044F\u0446\u0435\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470414
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0440\u0435\u0448\u0435\u043D\u0438\u0435
      \u0446\u0437\u0435\u0434\u0443\u0448\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470415
    m_Localized: "\u041F\u0435\u0447\u0430\u0442\u044C \u0446\u0437\u0435\u0434\u0443\u0448\u0438
      \u0441\u0442\u0430\u0432\u0438\u0442\u0441\u044F \u043D\u0430 \u0440\u0435\u0430\u0431\u0438\u043B\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0439
      \u0443\u043A\u0430\u0437. \u0421\u0435\u043C\u044C\u044F \u0414\u0443\u043D
      \u0412\u044D\u044F \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u043D\u043E\u0435
      \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0438\u0435,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043E\u0442\u043A\u0440\u043E\u0435\u0442
      \u0434\u0432\u0435\u0440\u0438 \u0432 \u043B\u044E\u0431\u043E\u043C \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435 \u043D\u0430 \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470416
    m_Localized: "\u0421\u043B\u0435\u0434 \u0432 \u042E\u0439\u043C\u044D\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470417
    m_Localized: "\u042E\u0439\u043C\u044D\u043D\u044C\u0441\u043A\u0438\u0439 \u043F\u043E\u0441\u0442
      \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u043A\u0440\u0430\u044E \u0413\u043E\u0431\u0438\u0439\u0441\u043A\u043E\u0433\u043E
      \u043F\u043B\u0430\u0442\u043E, \u0433\u0434\u0435 \u0432\u0435\u0442\u0435\u0440
      \u0433\u043E\u043D\u0438\u0442 \u043F\u0435\u0441\u043E\u043A \u0441\u043A\u0432\u043E\u0437\u044C
      \u0449\u0435\u043B\u0438 \u0432 \u0441\u0442\u0435\u043D\u0430\u0445. \u0420\u0443\u0441\u0442\u0430\u043C
      \u0430\u043B-\u0411\u0443\u0445\u0430\u0440\u0438 \u0440\u0430\u0441\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u043E\u0432 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0437\u0430 \u0434\u0440\u0443\u0433\u0438\u043C - \u0442\u0440\u0438 \u0441\u043C\u0435\u043D\u044B,
      \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A.
      \u041D\u0430 \u0438\u0441\u0445\u043E\u0434\u0435 \u0432\u0442\u043E\u0440\u043E\u0433\u043E
      \u0447\u0430\u0441\u0430 \u043F\u043E\u0436\u0438\u043B\u043E\u0439 \u0441\u043E\u0442\u043D\u0438\u043A
      \u0427\u0436\u0430\u043D \u0414\u044D \u0432\u0441\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442:
      \u0442\u0435\u043C \u043B\u0435\u0442\u043E\u043C \u0447\u0435\u0440\u0435\u0437
      \u043F\u043E\u0441\u0442 \u043F\u0440\u043E\u0448\u0451\u043B \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u043A\u0443\u043F\u0435\u0446 \u0441 \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u044B\u043C
      \u0433\u0440\u0443\u0437\u043E\u043C - \u0442\u044E\u043A\u0438 \u0431\u0435\u0437
      \u043C\u0430\u0440\u043A\u0438\u0440\u043E\u0432\u043A\u0438, \u0434\u0432\u043E\u0435
      \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u044B\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432.
      \u041A\u0443\u043F\u0435\u0446 \u043D\u0430\u0437\u0432\u0430\u043B \u0438\u043C\u044F,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0420\u0443\u0441\u0442\u0430\u043C
      \u0441\u043B\u044B\u0448\u0430\u043B \u0440\u0430\u043D\u044C\u0448\u0435:
      \u041D\u0438\u044F\u0437\u0431\u0435\u043A \u0438\u0437 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0430,
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u043F\u0440\u043E\u0447\u0438\u043C\u0438
      \u0442\u043E\u0432\u0430\u0440\u0430\u043C\u0438. \u042D\u0442\u043E \u0443\u0436\u0435
      \u043D\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470418
    m_Localized: "\u0420\u0430\u0437\u044B\u0441\u043A\u0430\u0442\u044C \u041D\u0438\u044F\u0437\u0431\u0435\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470419
    m_Localized: "\u041D\u0438\u044F\u0437\u0431\u0435\u043A \u0436\u0438\u0432\u0451\u0442
      \u0432 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0435, \u0432 \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0435
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0445 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432
      \u0443 \u0421\u0435\u0432\u0435\u0440\u043D\u044B\u0445 \u0432\u043E\u0440\u043E\u0442.
      \u0420\u0443\u0441\u0442\u0430\u043C \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u0442\u0443\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470420
    m_Localized: "\u041D\u0438\u044F\u0437\u0431\u0435\u043A \u043F\u0440\u0438\u0437\u043D\u0430\u0451\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470421
    m_Localized: "\u041B\u0430\u0432\u043A\u0430 \u041D\u0438\u044F\u0437\u0431\u0435\u043A\u0430
      \u043F\u0430\u0445\u043D\u0435\u0442 \u043C\u0443\u0441\u043A\u0443\u0441\u043E\u043C
      \u0438 \u0441\u0442\u0430\u0440\u043E\u0439 \u043A\u043E\u0436\u0435\u0439.
      \u0425\u043E\u0437\u044F\u0438\u043D \u043F\u043E\u043D\u0430\u0447\u0430\u043B\u0443
      \u043E\u0442\u0440\u0438\u0446\u0430\u0435\u0442 \u0432\u0441\u0451, \u043D\u043E
      \u0420\u0443\u0441\u0442\u0430\u043C \u043A\u043B\u0430\u0434\u0451\u0442 \u043D\u0430
      \u0441\u0442\u043E\u043B \u0438\u043C\u0435\u043D\u043D\u043E\u0439 \u044F\u0440\u043B\u044B\u043A,
      \u043D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0439 \u0432 \u0440\u0443\u0438\u043D\u0430\u0445
      \u0441\u043E\u0436\u0436\u0451\u043D\u043D\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      - \u044F\u0440\u043B\u044B\u043A \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E
      \u0441\u0430\u043C\u043E\u0433\u043E \u041D\u0438\u044F\u0437\u0431\u0435\u043A\u0430.
      \u041A\u0443\u043F\u0435\u0446 \u0431\u043B\u0435\u0434\u043D\u0435\u0435\u0442.
      \u0421\u043B\u043E\u0432\u0430 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E: \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0437\u0430\u043A\u0430\u0437 \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A\u0430,
      \u0433\u0440\u0443\u0437 \u0448\u0451\u043B \u0447\u0435\u0440\u0435\u0437
      \u0425\u043E\u0442\u0430\u043D \u0432 \u0433\u043E\u0440\u044B, \u043E\u043D
      \u043D\u0435 \u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0442\u043E\u0442
      \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439 \u043A\u043E\u043D\u0432\u043E\u0439
      \u0434\u043E\u0431\u0435\u0440\u0451\u0442\u0441\u044F \u0434\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0420\u0443\u0441\u0442\u0430\u043C\u0430. \u0418\u043C\u044F \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u0430
      \u043E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043E\u0434\u043D\u043E:
      \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470422
    m_Localized: "\u0417\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C \u0438\u043C\u044F
      \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470423
    m_Localized: "\u0420\u0443\u0441\u0442\u0430\u043C \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u041D\u0438\u044F\u0437\u0431\u0435\u043A\u0430 \u043F\u043E\u0434 \u0441\u0442\u0440\u0430\u0436\u0435\u0439
      \u043C\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u0441\u0442\u0430\u0440\u043E\u0441\u0442\u044B.
      \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D - \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0439
      \u0432\u043E\u0435\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A, \u0441\u043B\u0443\u0445\u0438
      \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0445\u043E\u0434\u044F\u0442
      \u0432\u0434\u043E\u043B\u044C \u0432\u0441\u0435\u0433\u043E \u0425\u044D\u0441\u0438-\u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470424
    m_Localized: "\u041F\u0440\u0430\u0432\u0434\u0430 \u043E \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470425
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
      \u0432 \u0441\u0442\u0430\u0440\u043E\u0439 \u044E\u0440\u0442\u0435 \u0443
      \u0434\u043E\u0440\u043E\u0433\u0438 \u043D\u0430 \u0422\u0443\u0440\u0444\u0430\u043D,
      \u0432 \u0447\u0430\u0441, \u043A\u043E\u0433\u0434\u0430 \u0441\u043E\u043B\u043D\u0446\u0435
      \u043A\u0430\u0441\u0430\u0435\u0442\u0441\u044F \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0445\u0440\u0435\u0431\u0442\u043E\u0432. \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D
      \u0441\u0438\u0434\u0438\u0442 \u043F\u0440\u044F\u043C\u043E, \u0440\u0443\u043A\u0438
      \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u044F\u0445. \u041E\u043D \u043D\u0435
      \u043E\u0442\u0440\u0438\u0446\u0430\u0435\u0442: \u043F\u0440\u0438\u043A\u0430\u0437
      \u0441\u0436\u0435\u0447\u044C \u0442\u043E\u0442 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439
      \u0433\u0440\u0443\u0437 \u0431\u044B\u043B \u0435\u0433\u043E, \u043D\u043E
      \u0441\u0440\u0435\u0434\u0438 \u0442\u044E\u043A\u043E\u0432 \u0448\u043B\u043E
      \u043E\u0440\u0443\u0436\u0438\u0435, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043F\u043E \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0443 \u043D\u0435
      \u0434\u043E\u043B\u0436\u043D\u043E \u0431\u044B\u043B\u043E \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u044C
      \u0425\u044D\u0441\u0438. \u0420\u0443\u0441\u0442\u0430\u043C \u0441\u043B\u0443\u0448\u0430\u0435\u0442
      - \u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442, \u0447\u0442\u043E
      \u0443 \u0438\u0441\u0442\u043E\u0440\u0438\u0438 \u0434\u0432\u0430 \u0434\u043D\u0430.
      \u0415\u0433\u043E \u043E\u0442\u0435\u0446, \u0410\u0445\u043C\u0430\u0434
      \u0430\u043B-\u0411\u0443\u0445\u0430\u0440\u0438, \u0441\u0430\u043C \u0432\u0451\u0437
      \u044D\u0442\u043E\u0442 \u043A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u043D\u044B\u0439
      \u0433\u0440\u0443\u0437, \u0438 \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B \u0435\u0433\u043E \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
      \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u043C \u0435\u043C\u0443 \u0441\u043F\u043E\u0441\u043E\u0431\u043E\u043C.
      \u0422\u0440\u0451\u0445\u0434\u043D\u0435\u0432\u043D\u043E\u0435 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435
      \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438 - \u044D\u0442\u043E
      \u0443\u0436\u0435 \u043E\u0442\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470426
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u0440\u0430\u0432\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470427
    m_Localized: "\u0420\u0443\u0441\u0442\u0430\u043C \u0432\u0441\u0442\u0430\u0451\u0442
      \u043F\u0435\u0440\u0432\u044B\u043C. \u041E\u043D \u043D\u0435 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u044D\u0442\u043E \u043F\u0440\u043E\u0449\u0435\u043D\u0438\u0435\u043C -
      \u043D\u043E \u0434\u043E\u0440\u043E\u0433\u0430 \u043D\u0430 \u0437\u0430\u043F\u0430\u0434
      \u0441\u043D\u043E\u0432\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u0430,
      \u0438 \u0438\u043C\u044F \u0410\u0445\u043C\u0430\u0434\u0430 \u0430\u043B-\u0411\u0443\u0445\u0430\u0440\u0438
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442
      \u0437\u0430\u0442\u0440\u0443\u0434\u043D\u044F\u0442\u044C \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u044B
      \u043D\u0430 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0445 \u043F\u043E\u0441\u0442\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470428
    m_Localized: "\u041F\u043E\u0434\u0436\u0438\u0433\u0430\u0442\u0435\u043B\u044C
      \u0432 \u0425\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470429
    m_Localized: "\u0425\u0430\u043C\u0438 - \u043F\u0435\u0440\u0435\u043A\u0440\u0451\u0441\u0442\u043E\u043A,
      \u0433\u0434\u0435 \u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0434\u043E\u0440\u043E\u0433\u0438
      \u0438\u0437 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0430 \u0438
      \u0422\u0443\u0440\u0444\u0430\u043D\u0430. \u0417\u0430\u043F\u0430\u0445
      \u0436\u0430\u0440\u0435\u043D\u043E\u0433\u043E \u043B\u0443\u043A\u0430 \u0438\u0437
      \u0445\u0430\u0440\u0447\u0435\u0432\u0435\u043D \u0441\u043C\u0435\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441 \u043A\u043E\u043D\u0441\u043A\u0438\u043C \u043D\u0430\u0432\u043E\u0437\u043E\u043C
      \u043D\u0430 \u043C\u043E\u0449\u0451\u043D\u043E\u043C \u0434\u0432\u043E\u0440\u0435.
      \u041B\u044E \u042F\u043E \u0432\u0435\u0434\u0451\u0442 \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u0435
      \u0442\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C: \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043E\u043F\u0438\u0441\u0430\u043B
      \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C \u0438\u0437 \u0410\u043D\u044C\u0441\u0438,
      \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0437\u0434\u0435\u0441\u044C
      \u043A\u0430\u0436\u0434\u043E\u0435 \u0443\u0442\u0440\u043E \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430.
      \u0421\u0440\u0435\u0434\u043D\u0435\u0433\u043E \u0440\u043E\u0441\u0442\u0430,
      \u0448\u0440\u0430\u043C \u043D\u0430 \u043B\u0435\u0432\u043E\u043C \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u0435,
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u0434\u0435\u0442 \u0432 \u0441\u0435\u0440\u044B\u0439
      \u0445\u0430\u043B\u0430\u0442. \u0421\u0435\u0433\u043E\u0434\u043D\u044F
      \u043E\u043D \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442
      \u0441 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u043C \u043C\u0443\u043B\u043E\u0432
      \u0434\u043E\u043B\u044C\u0448\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E,
      \u0438 \u0432 \u0435\u0433\u043E \u0441\u0443\u043C\u043A\u0435 \u0443\u0433\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u043E\u0447\u0435\u0440\u0442\u0430\u043D\u0438\u044F \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0433\u043E
      \u043A\u0443\u0432\u0448\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470430
    m_Localized: "\u0421\u043B\u0435\u0434\u0438\u0442\u044C \u0438 \u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470431
    m_Localized: "\u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u043F\u043E\u0434\u0436\u0438\u0433\u0430\u0442\u0435\u043B\u044C
      \u0443\u0445\u043E\u0434\u0438\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E \u0434\u0432\u043E\u0440\u0430
      \u0443 \u0412\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0445 \u0432\u043E\u0440\u043E\u0442.
      \u041B\u044E \u042F\u043E \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442
      \u043A\u043E\u043C\u043D\u0430\u0442\u0443: \u0442\u0440\u0435\u0442\u044C\u044F
      \u0441\u043F\u0440\u0430\u0432\u0430 \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u043C
      \u044D\u0442\u0430\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470432
    m_Localized: "\u041F\u043E\u0434\u0436\u0438\u0433\u0430\u0442\u0435\u043B\u044C
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470433
    m_Localized: "\u041B\u044E \u042F\u043E \u0443\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u043B\u0438\u0447\u043D\u043E\u0441\u0442\u044C: \u0427\u044D\u043D\u044C
      \u041F\u044D\u0439, \u0431\u044B\u0432\u0448\u0438\u0439 \u0441\u043A\u043B\u0430\u0434\u0441\u043A\u043E\u0439
      \u043D\u0430\u0434\u0437\u0438\u0440\u0430\u0442\u0435\u043B\u044C \u0432 \u0410\u043D\u044C\u0441\u0438,
      \u0443\u0432\u043E\u043B\u0435\u043D \u0442\u0440\u0438 \u0433\u043E\u0434\u0430
      \u043D\u0430\u0437\u0430\u0434 \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u0436\u0430\u0440\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043E\u043D \u0442\u043E\u0433\u0434\u0430
      \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u043D\u044B\u043C
      \u0441\u043B\u0443\u0447\u0430\u0435\u043C. \u0421\u043E\u0441\u0435\u0434\u0438
      \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u044E\u0442 \u0435\u0433\u043E \u043A\u0430\u043A
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u043E\u0431\u0438\u0436\u0435\u043D\u043D\u043E\u0433\u043E
      - \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0434\u043E\u043B\u0436\u043D\u043E\u0441\u0442\u044C,
      \u0437\u0430\u0434\u043E\u043B\u0436\u0430\u043B \u0445\u043E\u0437\u044F\u0438\u043D\u0443
      \u0441\u043A\u043B\u0430\u0434\u0430. \u041C\u0435\u0441\u0442\u043D\u044B\u0439
      \u0441\u043E\u0442\u043D\u0438\u043A \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0430\u0435\u0442:
      \u0427\u044D\u043D\u044C \u041F\u044D\u0439 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0431\u044B\u043B \u0432 \u0410\u043D\u044C\u0441\u0438 \u0432 \u0442\u0443
      \u043D\u043E\u0447\u044C. \u0422\u0435\u043F\u0435\u0440\u044C \u0443 \u041B\u044E
      \u042F\u043E \u0435\u0441\u0442\u044C \u0438\u043C\u044F, \u0431\u0438\u043E\u0433\u0440\u0430\u0444\u0438\u044F
      \u0438 \u043C\u043E\u0442\u0438\u0432. \u041E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0440\u0435\u0448\u0438\u0442\u044C: \u0438\u0434\u0442\u0438 \u043A \u0432\u043B\u0430\u0441\u0442\u044F\u043C
      \u0438\u043B\u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u043D\u0438\u043C \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470434
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u043F\u0440\u044F\u043C\u043E\u0433\u043E
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470435
    m_Localized: "\u0427\u044D\u043D\u044C \u041F\u044D\u0439 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0432\u0441\u0442\u0440\u0435\u0447\u0443 - \u043E\u043D \u0443\u0441\u0442\u0430\u043B
      \u043F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F. \u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u043D\u0430\u0437\u043D\u0430\u0447\u0435\u043D \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435
      \u0437\u0430 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u043C\u0438 \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470436
    m_Localized: "\u0412\u044B\u0431\u043E\u0440 \u0443 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470437
    m_Localized: "\u0420\u0430\u0441\u0441\u0432\u0435\u0442 \u043A\u0440\u0430\u0441\u0438\u0442
      \u0445\u0440\u0435\u0431\u0442\u044B \u0422\u044F\u043D\u044C-\u0428\u0430\u043D\u044F
      \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u044B\u043C. \u0427\u044D\u043D\u044C
      \u041F\u044D\u0439 \u0441\u0442\u043E\u0438\u0442 \u0443 \u043A\u0430\u043C\u043D\u044F,
      \u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432 \u0433\u043B\u0430\u0437\u0430.
      \u041E\u043D \u043F\u043E\u0434\u0436\u0451\u0433 \u0441\u043A\u043B\u0430\u0434
      \u0437\u0430 \u0434\u0435\u043D\u044C\u0433\u0438 - \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C
      \u0438 \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u0441\u043A\u043B\u0430\u0434
      \u043F\u0443\u0441\u0442. \u041E\u043D \u043D\u0435 \u0437\u043D\u0430\u043B
      \u043E \u043B\u044E\u0434\u044F\u0445 \u0432\u043D\u0443\u0442\u0440\u0438.
      \u042D\u0442\u043E \u043D\u0435 \u0441\u043D\u0438\u043C\u0430\u0435\u0442
      \u0432\u0438\u043D\u044B, \u043D\u043E \u043C\u0435\u043D\u044F\u0435\u0442
      \u0435\u0451 \u0432\u0435\u0441. \u041B\u044E \u042F\u043E \u0434\u0435\u0440\u0436\u0438\u0442
      \u0432 \u0440\u0443\u043A\u0430\u0445 \u0432\u044B\u0431\u043E\u0440: \u0438\u043C\u044F
      \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u0430 \u0435\u0449\u0451 \u043D\u0435
      \u043F\u0440\u043E\u0438\u0437\u043D\u0435\u0441\u0435\u043D\u043E, \u0438
      \u0427\u044D\u043D\u044C \u041F\u044D\u0439 \u0433\u043E\u0442\u043E\u0432
      \u0435\u0433\u043E \u043D\u0430\u0437\u0432\u0430\u0442\u044C \u0432 \u043E\u0431\u043C\u0435\u043D
      \u043D\u0430 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435 \u043E \u0441\u0432\u043E\u0435\u0439
      \u0440\u043E\u043B\u0438. \u0412\u043B\u0430\u0441\u0442\u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0442
      \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0442\u043E\u0440\u0430; \u0438\u0441\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C
      \u0443\u0439\u0434\u0451\u0442 \u043D\u0430 \u0437\u0430\u043F\u0430\u0434
      \u0438 \u0438\u0441\u0447\u0435\u0437\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470438
    m_Localized: "\u0414\u043E\u043D\u0435\u0441\u0442\u0438 \u043D\u0430 \u043E\u0431\u043E\u0438\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470439
    m_Localized: "\u041B\u044E \u042F\u043E \u0441\u0434\u0430\u0451\u0442 \u0427\u044D\u043D\u044C
      \u041F\u044D\u044F \u0441\u043E\u0442\u043D\u0438\u043A\u0443 \u0432 \u0425\u0430\u043C\u0438
      \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442 \u0438\u043C\u044F
      \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u0430. \u0421\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0435
      \u043D\u0430\u0447\u0430\u0442\u043E. \u0421\u0435\u043C\u044C\u044F \u043F\u043E\u0433\u0438\u0431\u0448\u0438\u0445
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442 \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0430\u0446\u0438\u044E
      - \u044D\u0442\u043E \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u043C\u0435\u0441\u044F\u0446\u044B,
      \u043D\u043E \u0437\u0430\u043A\u043E\u043D \u0438\u0441\u043F\u043E\u043B\u043D\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470440
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0432 \u043E\u0431\u043C\u0435\u043D
      \u043D\u0430 \u0438\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470441
    m_Localized: "\u0427\u044D\u043D\u044C \u041F\u044D\u0439 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u0430 \u0438 \u0443\u0445\u043E\u0434\u0438\u0442
      \u043D\u0430 \u0437\u0430\u043F\u0430\u0434 \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430.
      \u041B\u044E \u042F\u043E \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0441 \u0438\u043C\u0435\u043D\u0435\u043C \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0442\u043E\u0440\u0430
      \u0438 \u0442\u044F\u0436\u0435\u0441\u0442\u044C\u044E \u0441\u0434\u0435\u043B\u0430\u043D\u043D\u043E\u0433\u043E
      \u0432\u044B\u0431\u043E\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470442
    m_Localized: "\u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043F\u043E\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470443
    m_Localized: "\u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043F\u043E\u0433\u0440\u0430\u043D\u0438\u0447\u043D\u044B\u0439
      \u043F\u043E\u0441\u0442 \u0443 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430
      \u0414\u0430\u0442\u0443\u043D \u0441\u0442\u043E\u0438\u0442 \u0432 \u0443\u0437\u043A\u043E\u043C
      \u0443\u0449\u0435\u043B\u044C\u0435, \u0433\u0434\u0435 \u0433\u043E\u0440\u043D\u044B\u0439
      \u0432\u0435\u0442\u0435\u0440 \u043D\u0435 \u0443\u0442\u0438\u0445\u0430\u0435\u0442
      \u0434\u0430\u0436\u0435 \u0432 \u043F\u043E\u043B\u0434\u0435\u043D\u044C.
      \u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A \u043F\u043E\u0441\u0442\u0430
      - \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0442\u044B\u0441\u044F\u0447\u043D\u0438\u043A
      \u0432 \u043C\u0435\u0445\u043E\u0432\u043E\u0439 \u0448\u0430\u043F\u043A\u0435,
      \u0438\u043C\u044F \u0435\u0433\u043E \u041A\u0445\u0440\u0438-\u043B\u0434\u0435
      - \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043E\u0445\u0440\u0430\u043D\u043D\u0443\u044E \u0433\u0440\u0430\u043C\u043E\u0442\u0443
      \u0438 \u0447\u0438\u0442\u0430\u0435\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0434\u0435\u0440\u0436\u0438\u0442
      \u043F\u0438\u0441\u044C\u043C\u043E \u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u043E\u0439:
      \u043E\u043D\u043E \u0437\u0430\u0448\u0438\u0442\u043E \u0432 \u0434\u0432\u043E\u0439\u043D\u0443\u044E
      \u043F\u043E\u0434\u043A\u043B\u0430\u0434\u043A\u0443 \u0441\u0443\u043C\u043A\u0438
      \u0434\u043B\u044F \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u0432, \u0440\u044F\u0434\u043E\u043C
      \u0441 \u043A\u0443\u0441\u043A\u0430\u043C\u0438 \u0441\u044B\u0440\u043E\u0433\u043E
      \u0445\u043B\u043E\u043F\u043A\u0430. \u0412\u043E\u043F\u0440\u043E\u0441
      \u043E \u0446\u0435\u043B\u0438 \u043F\u043E\u0435\u0437\u0434\u043A\u0438
      \u0437\u0430\u0434\u0430\u043D \u0442\u0440\u0438\u0436\u0434\u044B, \u043E\u0442\u0432\u0435\u0442
      \u043E\u0434\u0438\u043D \u0438 \u0442\u043E\u0442 \u0436\u0435 - \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u044F
      \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0430 \u0434\u043B\u044F \u0434\u0430\u043C\u0430\u0441\u0441\u043A\u043E\u0433\u043E
      \u043A\u0443\u043F\u0446\u0430. \u0422\u044B\u0441\u044F\u0447\u043D\u0438\u043A
      \u041A\u0445\u0440\u0438-\u043B\u0434\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443 \u0438 \u0436\u0435\u0441\u0442\u043E\u043C
      \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043D\u0430 \u043E\u0431\u043E\u0447\u0438\u043D\u0443:
      \u0436\u0434\u0430\u0442\u044C \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470444
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0434\u043E\u0441\u043C\u043E\u0442\u0440
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470445
    m_Localized: "\u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0435 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438
      \u043F\u0440\u043E\u0449\u0443\u043F\u044B\u0432\u0430\u044E\u0442 \u0442\u044E\u043A\u0438,
      \u043D\u043E \u0445\u043B\u043E\u043F\u043A\u043E\u0432\u0430\u044F \u043D\u0430\u0431\u0438\u0432\u043A\u0430
      \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043F\u0438\u0441\u044C\u043C\u043E.
      \u041A\u0445\u0440\u0438-\u043B\u0434\u0435 \u0441\u0442\u0430\u0432\u0438\u0442
      \u043F\u0435\u0447\u0430\u0442\u044C \u043D\u0430 \u0433\u0440\u0430\u043C\u043E\u0442\u0443
      \u0438 \u043C\u0430\u0448\u0435\u0442 - \u043F\u0440\u043E\u0445\u043E\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470446
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u0447\u0435\u0440\u0435\u0437
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470447
    m_Localized: "\u041F\u043E \u0434\u0440\u0443\u0433\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430 \u0432\u0435\u0442\u0435\u0440
      \u0441\u0442\u0438\u0445\u0430\u0435\u0442. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u043F\u0438\u0441\u044C\u043C\u043E
      \u0438\u0437 \u043F\u043E\u0434\u043A\u043B\u0430\u0434\u043A\u0438 \u0438
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442 \u043F\u0435\u0447\u0430\u0442\u044C:
      \u0432\u043E\u0441\u043A \u0446\u0435\u043B, \u043D\u0438 \u0442\u0440\u0435\u0449\u0438\u043D\u044B.
      \u041F\u0438\u0441\u044C\u043C\u043E \u0430\u0434\u0440\u0435\u0441\u043E\u0432\u0430\u043D\u043E
      \u0442\u0430\u043D\u0441\u043A\u043E\u043C\u0443 \u0441\u0430\u043D\u043E\u0432\u043D\u0438\u043A\u0443
      \u0432 \u0421\u0438\u0430\u043D\u0438 - \u0440\u0435\u0447\u044C \u0438\u0434\u0451\u0442
      \u043E \u0432\u043E\u0437\u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0438
      \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0430
      \u043C\u0435\u0436\u0434\u0443 \u0414\u0430\u043C\u0430\u0441\u043A\u043E\u043C
      \u0438 \u0427\u0430\u043D\u044A\u0430\u043D\u044C\u044E \u0447\u0435\u0440\u0435\u0437
      \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u0438\u0434\u043E\u0440.
      \u0415\u0441\u043B\u0438 \u0441\u043E\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435
      \u0441\u043E\u0441\u0442\u043E\u0438\u0442\u0441\u044F, \u043C\u0438\u0440\u043D\u044B\u0439
      \u043F\u0440\u043E\u0445\u043E\u0434 \u0434\u043B\u044F \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0445
      \u0438 \u0430\u0440\u0430\u0431\u0441\u043A\u0438\u0445 \u043A\u0443\u043F\u0446\u043E\u0432
      \u043E\u0442\u043A\u0440\u043E\u0435\u0442\u0441\u044F \u043D\u0430 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u043B\u0435\u0442. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u043F\u0438\u0441\u044C\u043C\u043E \u043E\u0431\u0440\u0430\u0442\u043D\u043E:
      \u0434\u043E \u0421\u0438\u0430\u043D\u0438 \u0435\u0449\u0451 \u0434\u0432\u0430
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0433\u043E\u0440\u043D\u044B\u0435 \u043F\u0430\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470448
    m_Localized: "\u0418\u0434\u0442\u0438 \u043D\u0430 \u0421\u0438\u0430\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470449
    m_Localized: "\u0413\u043E\u0440\u043D\u0430\u044F \u0434\u043E\u0440\u043E\u0433\u0430
      \u0441\u0443\u0436\u0430\u0435\u0442\u0441\u044F \u043A \u0432\u0435\u0447\u0435\u0440\u0443,
      \u043D\u043E \u0437\u0432\u0451\u0437\u0434\u044B \u0447\u0438\u0441\u0442\u044B\u0435.
      \u041F\u0438\u0441\u044C\u043C\u043E \u0432 \u0441\u043E\u0445\u0440\u0430\u043D\u043D\u043E\u0441\u0442\u0438,
      \u0438 \u0446\u0435\u043B\u044C \u0432\u0438\u0434\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470450
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u0432\u0440\u0443\u0447\u0435\u043D\u043E
      \u0432 \u0421\u0438\u0430\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470451
    m_Localized: "\u041F\u043E\u043A\u043E\u0438 \u0441\u0430\u043D\u043E\u0432\u043D\u0438\u043A\u0430
      \u041F\u044D\u0439 \u041A\u0443\u0430\u043D\u044F \u043F\u0430\u0445\u043D\u0443\u0442
      \u0441\u0430\u043D\u0434\u0430\u043B\u043E\u043C \u0438 \u0447\u0435\u0440\u043D\u0438\u043B\u0430\u043C\u0438
      - \u0442\u0438\u043F\u0438\u0447\u043D\u044B\u0439 \u0437\u0430\u043F\u0430\u0445
      \u043A\u0430\u0431\u0438\u043D\u0435\u0442\u0430, \u0433\u0434\u0435 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u044E\u0442
      \u0438\u043D\u043E\u0441\u0442\u0440\u0430\u043D\u043D\u044B\u0435 \u043F\u043E\u0441\u043E\u043B\u044C\u0441\u0442\u0432\u0430.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442
      \u043F\u0438\u0441\u044C\u043C\u043E \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C,
      \u0434\u0435\u0440\u0436\u0430 \u0435\u0433\u043E \u043E\u0431\u0435\u0438\u043C\u0438
      \u0440\u0443\u043A\u0430\u043C\u0438, - \u0442\u0430\u043A \u043F\u0440\u0438\u043D\u044F\u0442\u043E
      \u0432 \u0442\u0430\u043D\u0441\u043A\u043E\u043C \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u0435.
      \u041F\u044D\u0439 \u041A\u0443\u0430\u043D\u044C \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u0447\u0438\u0442\u0430\u0435\u0442
      \u0434\u0432\u0430\u0436\u0434\u044B, \u0437\u0430\u0442\u0435\u043C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0432\u0437\u0433\u043B\u044F\u0434: \u0434\u0430\u043C\u0430\u0441\u0441\u043A\u0430\u044F
      \u0441\u0442\u043E\u0440\u043E\u043D\u0430 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043B\u0430
      \u0432\u0441\u0435 \u0442\u0440\u0438 \u0443\u0441\u043B\u043E\u0432\u0438\u044F
      \u0431\u0435\u0437 \u0438\u0437\u043C\u0435\u043D\u0435\u043D\u0438\u0439.
      \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u0434\u043E\u0433\u043E\u0432\u043E\u0440
      \u0432\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0432 \u0441\u0438\u043B\u0443
      \u043F\u043E\u0441\u043B\u0435 \u043E\u0431\u043C\u0435\u043D\u0430 \u0440\u0430\u0442\u0438\u0444\u0438\u043A\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u043C\u0438
      \u0433\u0440\u0430\u043C\u043E\u0442\u0430\u043C\u0438. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0438\u0437 \u043F\u043E\u043A\u043E\u0435\u0432
      \u0432 \u0432\u0435\u0447\u0435\u0440\u043D\u0438\u0439 \u0421\u0438\u0430\u043D\u044C,
      \u0433\u0434\u0435 \u0431\u0430\u0437\u0430\u0440\u043D\u044B\u0439 \u0448\u0443\u043C
      \u0435\u0449\u0451 \u043D\u0435 \u0443\u0442\u0438\u0445, \u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442:
      \u0434\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0447\u0435\u0440\u0435\u0437 \u0422\u0438\u0431\u0435\u0442
      \u0434\u043E\u043A\u0430\u0437\u0430\u043D \u043D\u0430 \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470452
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0438\u0435
      \u043C\u0438\u0441\u0441\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470453
    m_Localized: "\u041F\u044D\u0439 \u041A\u0443\u0430\u043D\u044C \u0432\u0440\u0443\u0447\u0430\u0435\u0442
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D\u0443 \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0443
      \u0441 \u043B\u0438\u0447\u043D\u043E\u0439 \u043F\u0435\u0447\u0430\u0442\u044C\u044E:
      \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u0432\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u043E\u0433\u043E \u043F\u043E\u0440\u0443\u0447\u0435\u043D\u0438\u044F,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043E\u0442\u043A\u0440\u043E\u0435\u0442
      \u0444\u0438\u043D\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435
      \u0434\u043B\u044F \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0440\u0435\u0439\u0441\u0430 \u043F\u043E \u044D\u0442\u043E\u043C\u0443
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470454
    m_Localized: "\u0420\u044B\u0447\u0430\u0433\u0438 \u043D\u0430 \u0410\u0431\u0443
      \u0411\u0430\u043A\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470455
    m_Localized: "\u041A\u043E\u0440\u0447\u043C\u0430 \u043D\u0430 \u043E\u043A\u0440\u0430\u0438\u043D\u0435
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430 \u043F\u043E\u043B\u043D\u0430
      \u0437\u0430\u043F\u0430\u0445\u043E\u0432 \u0434\u044B\u043C\u0430 \u0438
      \u043F\u0440\u043E\u0433\u043E\u0440\u043A\u043B\u043E\u0433\u043E \u043C\u0430\u0441\u043B\u0430.
      \u0421\u0430\u0434\u0438\u0440\u0430 \u0430\u043B-\u0417\u0430\u0445\u0440\u0430
      \u0440\u0430\u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043D\u0430
      \u0441\u0442\u043E\u043B\u0435 \u0442\u043E, \u0447\u0442\u043E \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u0437\u0430 \u0434\u0432\u0435
      \u043D\u0435\u0434\u0435\u043B\u0438: \u0434\u043E\u043B\u0433\u043E\u0432\u0430\u044F
      \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0430 \u0410\u0431\u0443 \u0411\u0430\u043A\u0440\u0430
      \u043F\u0435\u0440\u0435\u0434 \u0445\u043E\u0440\u0435\u0437\u043C\u0438\u0439\u0441\u043A\u0438\u043C
      \u043C\u0435\u043D\u044F\u043B\u044C\u0449\u0438\u043A\u043E\u043C, \u043F\u043E\u043A\u0430\u0437\u0430\u043D\u0438\u0435
      \u043D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u0430 \u043E \u0433\u0440\u0443\u0437\u0435
      \u0431\u0435\u0437 \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u044B\u0445
      \u043C\u0435\u0442\u043E\u043A \u0438 \u0441\u043F\u0438\u0441\u043E\u043A
      \u0438\u0437 \u043F\u044F\u0442\u0438 \u0438\u043C\u0451\u043D - \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u043E\u0432,
      \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u0410\u0431\u0443 \u0411\u0430\u043A\u0440
      \u043F\u043B\u0430\u0442\u0438\u0442 \u0437\u0430 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435.
      \u042D\u0442\u043E\u0433\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u0447\u0430\u0442\u044C \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u0441 \u043F\u043E\u0437\u0438\u0446\u0438\u0438 \u0441\u0438\u043B\u044B.
      \u0412\u043E\u043F\u0440\u043E\u0441 \u0432 \u0442\u043E\u043C, \u0447\u0435\u0433\u043E
      \u043E\u043D\u0430 \u0445\u043E\u0447\u0435\u0442: \u0434\u0435\u043D\u0435\u0433
      \u0438\u043B\u0438 \u0441\u0432\u043E\u0431\u043E\u0434\u044B \u043E\u0442
      \u0434\u043E\u043B\u0433\u0430 \u043D\u0430\u0432\u0441\u0435\u0433\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470456
    m_Localized: "\u041D\u0430\u0437\u043D\u0430\u0447\u0438\u0442\u044C \u0432\u0441\u0442\u0440\u0435\u0447\u0443
      \u0441 \u0410\u0431\u0443 \u0411\u0430\u043A\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470457
    m_Localized: "\u0421\u0430\u0434\u0438\u0440\u0430 \u043F\u043E\u0441\u044B\u043B\u0430\u0435\u0442
      \u0435\u043C\u0443 \u0437\u0430\u043F\u0438\u0441\u043A\u0443 \u0447\u0435\u0440\u0435\u0437
      \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430.
      \u041E\u0442\u0432\u0435\u0442 \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442
      \u043A \u0432\u0435\u0447\u0435\u0440\u0443: \u0410\u0431\u0443 \u0411\u0430\u043A\u0440
      \u0441\u043E\u0433\u043B\u0430\u0441\u0435\u043D \u043D\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0443
      \u0432 \u0442\u0440\u0438 \u0447\u0430\u0441\u0430 \u0434\u043D\u044F \u0443
      \u0444\u043E\u043D\u0442\u0430\u043D\u0430 \u0432 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C
      \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470458
    m_Localized: "\u041A\u043E\u043C\u043F\u0440\u043E\u043C\u0430\u0442 \u0432 \u0440\u0443\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470459
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0443 \u0444\u043E\u043D\u0442\u0430\u043D\u0430
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0431\u044B\u0441\u0442\u0440\u043E.
      \u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u0432\u044B\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0435\u0442
      \u043F\u0435\u0440\u0435\u0447\u0435\u043D\u044C \u0431\u0435\u0437 \u0435\u0434\u0438\u043D\u043E\u0433\u043E
      \u0441\u043B\u043E\u0432\u0430 - \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0434\u043E\u043B\u0433\u043E\u0432\u0443\u044E \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0443
      \u0438 \u0441\u043D\u043E\u0432\u0430 \u043D\u0430 \u0421\u0430\u0434\u0438\u0440\u0443.
      \u041E\u043D \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442 \u043E\u0434\u043D\u043E:
      \u043E\u0442\u043A\u0443\u0434\u0430 \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0430
      \u0443 \u043D\u0435\u0451. \u0421\u0430\u0434\u0438\u0440\u0430 \u043E\u0442\u0432\u0435\u0447\u0430\u0435\u0442:
      \u044D\u0442\u043E \u043D\u0435 \u0432\u0430\u0436\u043D\u043E - \u0432\u0430\u0436\u043D\u043E,
      \u0447\u0442\u043E \u043E\u043D\u0430 \u0433\u043E\u0442\u043E\u0432\u0430
      \u0435\u0451 \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0432 \u043E\u0431\u043C\u0435\u043D
      \u043D\u0430 \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F.
      \u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u0443\u0445\u043E\u0434\u0438\u0442,
      \u043D\u0435 \u043F\u0440\u043E\u0449\u0430\u044F\u0441\u044C. \u042D\u0442\u043E
      \u043D\u0435 \u043F\u0440\u043E\u0432\u0430\u043B: \u0435\u0433\u043E \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435
      \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442, \u0447\u0442\u043E \u043E\u043D
      \u0432\u0437\u0432\u0435\u0448\u0438\u0432\u0430\u0435\u0442. \u0421\u0430\u0434\u0438\u0440\u0430
      \u0434\u0430\u0451\u0442 \u0435\u043C\u0443 \u0434\u0432\u0430 \u0434\u043D\u044F
      - \u043F\u043E\u0442\u043E\u043C \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
      \u0443\u0445\u043E\u0434\u044F\u0442 \u0432 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439
      \u0441\u043E\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470460
    m_Localized: "\u0416\u0434\u0430\u0442\u044C \u043E\u0442\u0432\u0435\u0442\u0430
      \u0434\u0432\u0430 \u0434\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470461
    m_Localized: "\u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u043F\u0440\u0438\u0448\u043B\u0451\u0442
      \u043F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A\u0430 - \u043D\u0435
      \u0441\u0430\u043C. \u042D\u0442\u043E \u0435\u0433\u043E \u0441\u0442\u0438\u043B\u044C.
      \u0421\u0430\u0434\u0438\u0440\u0430 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470462
    m_Localized: "\u0420\u0430\u0441\u0447\u0451\u0442 \u0441 \u0410\u0431\u0443
      \u0411\u0430\u043A\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470463
    m_Localized: "\u041F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A \u0410\u0431\u0443
      \u0411\u0430\u043A\u0440\u0430 - \u043D\u0435\u043C\u043E\u043B\u043E\u0434\u043E\u0439
      \u0441\u043E\u0433\u0434\u0438\u0435\u0446 \u0425\u0443\u0440\u043C\u0443\u0437\u0434
      - \u043F\u0440\u0438\u043D\u043E\u0441\u0438\u0442 \u043E\u0442\u0432\u0435\u0442
      \u0432 \u0432\u0438\u0434\u0435 \u043A\u043E\u0436\u0430\u043D\u043E\u0433\u043E
      \u043C\u0435\u0448\u043E\u0447\u043A\u0430 \u0438 \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u043D\u043E\u0433\u043E
      \u043B\u0438\u0441\u0442\u0430. \u0412 \u043C\u0435\u0448\u043E\u0447\u043A\u0435
      \u0440\u043E\u0432\u043D\u043E \u0442\u0430 \u0441\u0443\u043C\u043C\u0430,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0421\u0430\u0434\u0438\u0440\u0430
      \u043D\u0430\u0437\u0432\u0430\u043B\u0430; \u0432 \u043B\u0438\u0441\u0442\u0435
      - \u043E\u0442\u043A\u0430\u0437 \u043E\u0442 \u043F\u0440\u0435\u0442\u0435\u043D\u0437\u0438\u0439,
      \u0437\u0430\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0439 \u0438\u043C\u0435\u043D\u043D\u043E\u0439
      \u043F\u0435\u0447\u0430\u0442\u044C\u044E \u0410\u0431\u0443 \u0411\u0430\u043A\u0440\u0430.
      \u0414\u043E\u043B\u0433 \u0430\u043D\u043D\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u043D.
      \u0425\u0443\u0440\u043C\u0443\u0437\u0434 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0442\u0438\u0445\u043E: \u0410\u0431\u0443 \u0411\u0430\u043A\u0440 \u043F\u0440\u043E\u0441\u0438\u0442
      \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C, \u0447\u0442\u043E \u043E\u043D
      \u0443\u043C\u0435\u0435\u0442 \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u043F\u043E\u0442\u0435\u0440\u0438.
      \u0421\u0430\u0434\u0438\u0440\u0430 \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442
      \u043C\u043E\u043D\u0435\u0442\u044B, \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u044F\u0441\u044C,
      \u043F\u0440\u0438 \u0425\u0443\u0440\u043C\u0443\u0437\u0434\u0435 - \u044D\u0442\u043E
      \u0442\u043E\u0436\u0435 \u0447\u0430\u0441\u0442\u044C \u044F\u0437\u044B\u043A\u0430
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u043E\u0432. \u041F\u043E\u0442\u043E\u043C
      \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u043B\u0438\u0441\u0442 \u0438
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u0434\u043E\u043B\u0433\u043E\u0432\u0443\u044E
      \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0443. \u0414\u0435\u043B\u043E
      \u0437\u0430\u043A\u0440\u044B\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470464
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0440\u0430\u0441\u0447\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470465
    m_Localized: "\u0421\u0430\u0434\u0438\u0440\u0430 \u0443\u0431\u0438\u0440\u0430\u0435\u0442
      \u0434\u0435\u043D\u044C\u0433\u0438 \u0438 \u0431\u0443\u043C\u0430\u0433\u0443.
      \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C \u0447\u0435\u0440\u0435\u0437
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434 \u0442\u0435\u043F\u0435\u0440\u044C
      \u043E\u0442\u043A\u0440\u044B\u0442 \u0431\u0435\u0437 \u043F\u0440\u0435\u0436\u043D\u0438\u0445
      \u043E\u0431\u0440\u0435\u043C\u0435\u043D\u0435\u043D\u0438\u0439, \u0438
      \u0435\u0451 \u0438\u043C\u044F \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435
      \u0441\u0432\u044F\u0437\u0430\u043D\u043E \u0441 \u0434\u043E\u043B\u0433\u043E\u043C
      \u0410\u0431\u0443 \u0411\u0430\u043A\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470466
    m_Localized: "\u0412\u0442\u043E\u0440\u0430\u044F \u0441\u0435\u043C\u044C\u044F
      \u0432 \u0426\u0437\u044E\u0446\u044E\u0430\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470467
    m_Localized: "\u0426\u0437\u044E\u0446\u044E\u0430\u043D\u044C \u0441\u0442\u043E\u0438\u0442
      \u043D\u0430 \u0437\u0430\u043F\u0430\u0434\u043D\u043E\u043C \u043A\u0440\u0430\u044E
      \u0413\u0430\u043D\u044C\u0441\u0443, \u0433\u0434\u0435 \u043E\u0430\u0437\u0438\u0441
      \u0443\u043F\u0438\u0440\u0430\u0435\u0442\u0441\u044F \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u044E.
      \u0417\u0430\u043F\u0430\u0445 \u0430\u0440\u044B\u043A\u043E\u0432 \u0438
      \u0446\u0432\u0435\u0442\u0443\u0449\u0435\u0433\u043E \u0442\u043E\u043F\u043E\u043B\u044F.
      \u041C\u0430 \u0426\u044F\u043D \u0440\u0430\u0441\u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u0432 \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0435 \u043A\u043E\u0436\u0435\u0432\u043D\u0438\u043A\u043E\u0432
      - \u0442\u0443\u0434\u0430 \u043F\u0435\u0440\u0435\u0435\u0445\u0430\u043B,
      \u043F\u043E \u0441\u043B\u043E\u0432\u0430\u043C \u043B\u0430\u0432\u043E\u0447\u043D\u0438\u043A\u0430
      \u0438\u0437 \u041C\u0430\u043D\u044C\u0433\u0443, \u0431\u044B\u0432\u0448\u0438\u0439
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u043F\u043E \u0438\u043C\u0435\u043D\u0438
      \u041B\u044E \u041F\u044D\u043D. \u041D\u0430\u0448\u0451\u043B \u0435\u0433\u043E
      \u0447\u0435\u0440\u0435\u0437 \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u0447\u0438\u043A\u0430
      \u043C\u0435\u0442\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043A\u043D\u0438\u0433:
      \u041B\u044E \u041F\u044D\u043D, \u0441\u043E\u0440\u043E\u043A \u043E\u0434\u0438\u043D
      \u0433\u043E\u0434, \u0436\u0435\u043D\u0430 \u0421\u044E\u0439, \u0434\u0432\u043E\u0435
      \u0434\u0435\u0442\u0435\u0439. \u0414\u043E\u043C \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439,
      \u043D\u043E \u043A\u0440\u0435\u043F\u043A\u0438\u0439, \u043A\u0440\u044B\u0448\u0430
      \u043D\u043E\u0432\u0430\u044F. \u041C\u0430 \u0426\u044F\u043D \u0441\u0442\u043E\u0438\u0442
      \u0443 \u043A\u0430\u043B\u0438\u0442\u043A\u0438 \u0438 \u0434\u0443\u043C\u0430\u0435\u0442:
      \u044D\u0442\u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043F\u0440\u0438\u043D\u044F\u043B
      \u0434\u0435\u043D\u044C\u0433\u0438 \u0438\u0437 \u0435\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      - \u0438 \u0432\u044B\u0441\u0442\u0440\u043E\u0438\u043B \u043D\u0430 \u043D\u0438\u0445
      \u0436\u0438\u0437\u043D\u044C. \u041D\u0435\u043B\u044C\u0437\u044F \u0437\u0430\u0431\u0440\u0430\u0442\u044C
      \u0434\u043E\u043C, \u043D\u043E \u0434\u043E\u043B\u0433 \u043F\u0440\u0438\u0437\u043D\u0430\u0442\u044C
      \u043D\u0430\u0434\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470468
    m_Localized: "\u041F\u043E\u0441\u0442\u0443\u0447\u0430\u0442\u044C \u0432 \u0434\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470469
    m_Localized: "\u041B\u044E \u041F\u044D\u043D \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0441\u0430\u043C. \u041E\u043D \u0443\u0437\u043D\u0430\u0451\u0442 \u041C\u0430
      \u0426\u044F\u043D\u0430 - \u043F\u043E \u0433\u043B\u0430\u0437\u0430\u043C
      \u0432\u0438\u0434\u043D\u043E. \u041C\u043E\u043B\u0447\u0430\u043D\u0438\u0435
      \u0434\u043B\u0438\u0442\u0441\u044F \u0434\u043E\u043B\u0433\u043E, \u043F\u043E\u0442\u043E\u043C
      \u043E\u043D \u0434\u0435\u043B\u0430\u0435\u0442 \u0448\u0430\u0433 \u0432
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443: \u0432\u043E\u0439\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470470
    m_Localized: "\u0421\u043B\u043E\u0432\u043E \u0441\u043A\u0430\u0437\u0430\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470471
    m_Localized: "\u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0441 \u041B\u044E
      \u041F\u044D\u043D\u043E\u043C \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442
      \u0447\u0430\u0441. \u0416\u0435\u043D\u0430 \u0443\u0445\u043E\u0434\u0438\u0442
      \u0441 \u0434\u0435\u0442\u044C\u043C\u0438 \u0432 \u0441\u043E\u0441\u0435\u0434\u043D\u044E\u044E
      \u043A\u043E\u043C\u043D\u0430\u0442\u0443. \u041B\u044E \u041F\u044D\u043D
      \u043D\u0435 \u043E\u043F\u0440\u0430\u0432\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F:
      \u043E\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0434\u0435\u043D\u044C\u0433\u0438,
      \u043E\u043D \u0437\u043D\u0430\u043B, \u043E\u0442\u043A\u0443\u0434\u0430
      \u043E\u043D\u0438. \u0413\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u043E\u043B\u044C\u043A\u043E,
      \u0447\u0442\u043E \u0442\u043E\u0433\u0434\u0430 \u0443 \u043D\u0435\u0433\u043E
      \u043D\u0435 \u0431\u044B\u043B\u043E \u0432\u044B\u0431\u043E\u0440\u0430.
      \u041C\u0430 \u0426\u044F\u043D \u043D\u0435 \u0441\u043F\u043E\u0440\u0438\u0442
      - \u043E\u043D \u0441\u0430\u043C \u0437\u043D\u0430\u0435\u0442, \u043A\u0430\u043A
      \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
      \u0432\u044B\u0431\u043E\u0440\u0430. \u041B\u044E \u041F\u044D\u043D \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0447\u0430\u0441\u0442\u044C:
      \u043C\u0435\u0434\u044C\u044E, \u043A\u043E\u0436\u0435\u0432\u0435\u043D\u043D\u044B\u043C
      \u0442\u043E\u0432\u0430\u0440\u043E\u043C, \u0442\u0440\u0443\u0434\u043E\u043C
      - \u043B\u0438\u0448\u044C \u0431\u044B \u0437\u0430\u043A\u0440\u044B\u0442\u044C
      \u0441\u0447\u0451\u0442. \u041C\u0430 \u0426\u044F\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442:
      \u0432 \u0425\u0430\u043C\u0438 \u0436\u0438\u0432\u0451\u0442 \u0442\u0440\u0435\u0442\u044C\u044F
      \u0441\u0435\u043C\u044C\u044F, \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u0434\u0435\u043D\u044C\u0433\u0438 \u043D\u0443\u0436\u043D\u044B \u0431\u043E\u043B\u044C\u0448\u0435.
      \u041B\u044E \u041F\u044D\u043D \u043A\u0438\u0432\u0430\u0435\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470472
    m_Localized: "\u041D\u0430\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u0432 \u0425\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470473
    m_Localized: "\u041B\u044E \u041F\u044D\u043D \u043E\u0431\u0435\u0449\u0430\u0435\u0442
      \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0441\u0432\u043E\u044E
      \u0434\u043E\u043B\u044E \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E \u0432
      \u0425\u0430\u043C\u0438 \u0447\u0435\u0440\u0435\u0437 \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0433\u043E
      \u043A\u0443\u043F\u0446\u0430. \u041C\u0430 \u0426\u044F\u043D \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
      \u0438\u043C\u044F \u043F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044F
      \u0438 \u0432\u044B\u0445\u043E\u0434\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470474
    m_Localized: "\u0422\u0440\u0435\u0442\u044C\u044F \u0441\u0435\u043C\u044C\u044F
      \u0432 \u0425\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470475
    m_Localized: "\u0421\u0435\u043C\u044C\u044F \u0427\u0436\u0430\u043D \u0436\u0438\u0432\u0451\u0442
      \u0432 \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0435 \u0433\u043E\u043D\u0447\u0430\u0440\u043E\u0432
      \u0425\u0430\u043C\u0438. \u0412\u0434\u043E\u0432\u0430, \u0442\u0440\u043E\u0435
      \u0432\u0437\u0440\u043E\u0441\u043B\u044B\u0445 \u0434\u0435\u0442\u0435\u0439,
      \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u043A\u0430\u044F \u0432 \u043F\u043E\u043B\u0442\u043E\u0440\u0430
      \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F. \u041C\u0430 \u0426\u044F\u043D
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u0441 \u0434\u0435\u043D\u044C\u0433\u0430\u043C\u0438
      - \u043C\u043E\u043D\u0435\u0442\u044B \u043F\u0435\u0440\u0435\u0441\u0447\u0438\u0442\u0430\u043D\u044B,
      \u043C\u0435\u0448\u043E\u0447\u0435\u043A \u0437\u0430\u0432\u044F\u0437\u0430\u043D.
      \u0412\u0434\u043E\u0432\u0430 \u0427\u0436\u0430\u043D \u0432\u044B\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0435\u0442
      \u043C\u043E\u043B\u0447\u0430, \u043F\u043E\u0442\u043E\u043C \u043A\u0430\u0447\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439: \u043D\u0435\u0442. \u041E\u043D\u0430
      \u043D\u0435 \u0432\u043E\u0437\u044C\u043C\u0451\u0442 \u0434\u0435\u043D\u044C\u0433\u0438
      \u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0438\u0437
      \u0442\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u0435\u0451 \u043C\u0443\u0436
      \u043F\u043E\u0433\u0438\u0431 \u043D\u0435 \u0438\u0437-\u0437\u0430 \u043D\u0435\u0445\u0432\u0430\u0442\u043A\u0438
      \u0441\u0435\u0440\u0435\u0431\u0440\u0430 - \u043E\u043D \u043F\u043E\u0433\u0438\u0431,
      \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E \u043A\u0442\u043E-\u0442\u043E
      \u0440\u0435\u0448\u0438\u043B, \u0447\u0442\u043E \u0434\u043E\u0440\u043E\u0433\u0430
      \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442 \u0435\u043C\u0443
      \u043E\u0434\u043D\u043E\u043C\u0443. \u0414\u0435\u043D\u044C\u0433\u0438
      \u044D\u0442\u043E\u0433\u043E \u043D\u0435 \u0438\u0441\u043F\u0440\u0430\u0432\u044F\u0442.
      \u041C\u0430 \u0426\u044F\u043D \u0441\u0442\u043E\u0438\u0442 \u0441 \u043C\u0435\u0448\u043E\u0447\u043A\u043E\u043C
      \u0432 \u0440\u0443\u043A\u0435 \u0438 \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442:
      \u043D\u0435 \u0432\u0441\u044F\u043A\u0438\u0439 \u0434\u043E\u043B\u0433
      \u043C\u043E\u0436\u043D\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u043C\u043E\u043D\u0435\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470476
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438
      \u0434\u0435\u0442\u044F\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470477
    m_Localized: "\u041C\u0430 \u0426\u044F\u043D \u043A\u043B\u0430\u0434\u0451\u0442
      \u043C\u0435\u0448\u043E\u0447\u0435\u043A \u043D\u0430 \u0441\u0442\u043E\u043B,
      \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u044F \u043D\u0438 \u0441\u043B\u043E\u0432\u0430.
      \u0412\u0434\u043E\u0432\u0430 \u0427\u0436\u0430\u043D \u043D\u0435 \u0431\u0435\u0440\u0451\u0442
      \u0435\u0433\u043E - \u043D\u043E \u0438 \u043D\u0435 \u0432\u044B\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u0441\u044B\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0434\u0435\u043D\u044C\u0433\u0438 \u043C\u043E\u043B\u0447\u0430.
      \u041C\u0430 \u0426\u044F\u043D \u0432\u044B\u0445\u043E\u0434\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470478
    m_Localized: "\u0414\u043E\u0432\u0435\u0440\u0438\u0435 \u043C\u043E\u043D\u0430\u0445\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470479
    m_Localized: "\u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u0411\u0430\u0439\u043C\u0430
      \u0443 \u043F\u043E\u0434\u043D\u043E\u0436\u0438\u044F \u041B\u044F\u043E\u0448\u0430\u043D\u044F
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u043E\u0432,
      \u043D\u043E \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u0438 \u0445\u0440\u0430\u043D\u0438\u0442
      \u0441\u0442\u0440\u043E\u0433\u043E: \u0434\u043E\u0441\u0442\u0443\u043F
      \u043A \u043A\u043D\u0438\u0433\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0443
      \u043E\u0442\u043A\u0440\u044B\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u043C,
      \u043A\u0442\u043E \u043F\u0440\u043E\u0431\u044B\u043B \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0435
      \u0442\u0440\u0438 \u0434\u043D\u044F \u0438 \u043F\u043E\u043C\u043E\u0433
      \u0432 \u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u0435. \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442 \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0441\u043B\u043E\u0432: \u043D\u0443\u0436\u043D\u043E \u043A\u043E\u043B\u043E\u0442\u044C
      \u0434\u0440\u043E\u0432\u0430, \u043D\u043E\u0441\u0438\u0442\u044C \u0432\u043E\u0434\u0443,
      \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0432 \u0443\u0442\u0440\u0435\u043D\u043D\u0435\u043C
      \u0447\u0442\u0435\u043D\u0438\u0438 \u0441\u0443\u0442\u0440. \u0417\u0430\u043F\u0430\u0445
      \u0441\u0432\u0435\u0436\u0435\u0439 \u0441\u043E\u0441\u043D\u044B \u0438
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0441\u043A\u043E\u0439 \u043A\u0443\u0445\u043D\u0438
      - \u0433\u0440\u0435\u0447\u043D\u0435\u0432\u0430\u044F \u043A\u0430\u0448\u0430
      \u0441 \u0441\u0435\u043C\u0435\u043D\u0430\u043C\u0438 \u043A\u043E\u043D\u043E\u043F\u043B\u0438
      - \u043E\u0442\u043C\u0435\u0447\u0430\u0435\u0442 \u043A\u0430\u0436\u0434\u043E\u0435
      \u0443\u0442\u0440\u043E. \u041D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C
      \u0425\u0443\u044D\u0439 \u0413\u0443\u0430\u043D \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0435\u0442
      \u043D\u0435\u043D\u0430\u0432\u044F\u0437\u0447\u0438\u0432\u043E: \u043E\u043D
      \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u0435\u0442 \u043D\u0435 \u0443\u043C\u0435\u043D\u0438\u044F,
      \u0430 \u0442\u0435\u0440\u043F\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470480
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0442\u0440\u0438 \u0434\u043D\u044F
      \u0441\u043B\u0443\u0436\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470481
    m_Localized: "\u041D\u0430 \u0442\u0440\u0435\u0442\u044C\u0435 \u0443\u0442\u0440\u043E
      \u043D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C \u0425\u0443\u044D\u0439
      \u0413\u0443\u0430\u043D \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043F\u043E\u0441\u043B\u0435
      \u0447\u0442\u0435\u043D\u0438\u044F \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043A\u043E\u0440\u043E\u0442\u043A\u043E: \u043A\u043D\u0438\u0433\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435
      \u043E\u0442\u043A\u0440\u044B\u0442\u043E \u043F\u043E\u0441\u043B\u0435 \u043F\u043E\u043B\u0443\u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470482
    m_Localized: "\u0412\u0442\u043E\u0440\u0430\u044F \u0447\u0430\u0441\u0442\u044C
      \u043D\u0430\u0439\u0434\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470483
    m_Localized: "\u041A\u043D\u0438\u0433\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438\u0449\u0435
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F \u0411\u0430\u0439\u043C\u0430
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0432\u043E\u0441\u043A\u043E\u043C \u0438
      \u0441\u0443\u0445\u0438\u043C \u0434\u0435\u0440\u0435\u0432\u043E\u043C.
      \u0420\u0443\u043A\u043E\u043F\u0438\u0441\u0438 \u043F\u0440\u043E\u043D\u0443\u043C\u0435\u0440\u043E\u0432\u0430\u043D\u044B
      \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0441\u043A\u043E\u043C
      \u043A\u0430\u0442\u0430\u043B\u043E\u0433\u0435. \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u043D\u0430\u0445\u043E\u0434\u0438\u0442 \u043D\u0443\u0436\u043D\u044B\u0439
      \u0441\u0432\u0438\u0442\u043E\u043A \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439
      \u043F\u043E\u043B\u043A\u0435 \u0441\u043B\u0435\u0432\u0430: \u0432\u0442\u043E\u0440\u0430\u044F
      \u0447\u0430\u0441\u0442\u044C \u0442\u0440\u0430\u043A\u0442\u0430\u0442\u0430
      \u0430\u043B-\u0411\u0443\u0445\u0430\u0440\u0438, \u043F\u0435\u0440\u0435\u043F\u043B\u0435\u0442\u0451\u043D\u043D\u0430\u044F
      \u0441 \u0431\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u043E\u0439 \u0441\u0443\u0442\u0440\u043E\u0439
      \u0432 \u043E\u0434\u043D\u043E\u043C \u043F\u0435\u0440\u0435\u043F\u043B\u0451\u0442\u0435
      - \u0442\u0430\u043A \u043F\u043E\u043F\u0430\u043B\u0430 \u043A \u043C\u043E\u043D\u0430\u0445\u0430\u043C,
      \u0432\u043C\u0435\u0441\u0442\u0435 \u0441 \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0435\u043C
      \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0430 \u0438\u0437 \u0425\u043E\u0442\u0430\u043D\u0430.
      \u041F\u043E\u0447\u0435\u0440\u043A \u043E\u0442\u0446\u0430, \u0442\u0430
      \u0436\u0435 \u043C\u0435\u0434\u043D\u0430\u044F \u0442\u0443\u0448\u044C,
      \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0435 \u0440\u0430\u0437\u0434\u0435\u043B\u0435\u043D\u0438\u0435
      \u0440\u0430\u0437\u0434\u0435\u043B\u043E\u0432. \u041E\u043F\u0438\u0441\u0430\u043D\u0438\u0435
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0441\u044F
      \u043E\u0442 \u041B\u0430\u043D\u044C\u0447\u0436\u043E\u0443 \u0434\u043E
      \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0430 \u0441 \u043F\u043E\u0434\u0440\u043E\u0431\u043D\u044B\u043C\u0438
      \u0446\u0435\u043D\u0430\u043C\u0438 \u043D\u0430 \u0432\u043E\u0434\u0443
      \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0435\u0432 \u0438 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F\u043C\u0438
      \u043C\u0435\u0436\u0434\u0443 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u043C\u0438
      \u0434\u0432\u043E\u0440\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470484
    m_Localized: "\u041F\u0435\u0440\u0435\u043F\u0438\u0441\u0430\u0442\u044C \u0438\u043B\u0438
      \u0432\u044B\u043A\u0443\u043F\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470485
    m_Localized: "\u041D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C \u0425\u0443\u044D\u0439
      \u0413\u0443\u0430\u043D \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u043A\u0443 \u043F\u0440\u0438
      \u0443\u0441\u043B\u043E\u0432\u0438\u0438, \u0447\u0442\u043E \u043A\u043E\u043F\u0438\u044F
      \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0432 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0435.
      \u041E\u0440\u0438\u0433\u0438\u043D\u0430\u043B \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0437\u0434\u0435\u0441\u044C. \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u0431\u0435\u0440\u0451\u0442\u0441\u044F \u0437\u0430 \u043F\u0435\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470486
    m_Localized: "\u0421\u043E\u043F\u0435\u0440\u043D\u0438\u043A \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470487
    m_Localized: "\u0420\u044B\u043D\u043E\u043A \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u0435\u0439
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0443 \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0445 \u0432\u043E\u0440\u043E\u0442
      \u043F\u043E \u043F\u044F\u0442\u043D\u0438\u0446\u0430\u043C. \u0417\u0430\u043F\u0430\u0445
      \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0430 \u0438 \u0441\u044B\u0440\u043E\u0439
      \u043A\u043E\u0436\u0438, \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B
      \u0440\u0430\u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442 \u0441\u0432\u0438\u0442\u043A\u0438
      \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u043C\u043E\u0441\u0442\u043E\u0432\u043E\u0439.
      \u0421\u043E\u043F\u0435\u0440\u043D\u0438\u043A, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u043E\u043F\u0438\u0441\u0430\u043B \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      - \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u043A\u0443\u043F\u0435\u0446
      \u0410\u0440\u0442\u0430\u0432\u0430\u0437\u0434, - \u0443\u0436\u0435 \u0434\u0435\u0440\u0436\u0438\u0442
      \u0442\u0440\u0435\u0442\u044C\u044E \u0447\u0430\u0441\u0442\u044C \u0442\u0440\u0430\u043A\u0442\u0430\u0442\u0430
      \u0430\u043B-\u0411\u0443\u0445\u0430\u0440\u0438. \u041E\u043D \u0437\u043D\u0430\u0435\u0442
      \u043E \u0440\u043E\u0437\u044B\u0441\u043A\u0435 \u0438 \u043D\u0435 \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442:
      \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C
      \u0438\u043C\u0435\u0435\u0442 \u043A\u043E\u043C\u043C\u0435\u0440\u0447\u0435\u0441\u043A\u0443\u044E
      \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u044C, \u0438 \u043E\u043D \u0433\u043E\u0442\u043E\u0432
      \u043F\u0440\u043E\u0434\u0430\u0442\u044C \u0435\u0451 \u043F\u043E \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435, \u043D\u043E \u0440\u044B\u043D\u043E\u0447\u043D\u0430\u044F
      \u0446\u0435\u043D\u0430 \u0441\u0435\u0433\u043E\u0434\u043D\u044F - \u0441\u0442\u043E
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432.
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0440\u0430\u0441\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442
      \u0432\u043E\u0441\u0435\u043C\u044C\u044E\u0434\u0435\u0441\u044F\u0442\u044C\u044E.
      \u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442
      \u043D\u0435\u043F\u0440\u043E\u0441\u0442\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470488
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470489
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0447\u0430\u0441\u0430 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u043E\u0432
      \u0410\u0440\u0442\u0430\u0432\u0430\u0437\u0434 \u0441\u043E\u0433\u043B\u0430\u0448\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0434\u0435\u0432\u044F\u043D\u043E\u0441\u0442\u043E \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0438 \u0440\u0435\u0434\u043A\u0438\u0439 \u0445\u043E\u0442\u0430\u043D\u0441\u043A\u0438\u0439
      \u043D\u0435\u0444\u0440\u0438\u0442 \u0432 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435
      \u0440\u0430\u0437\u043D\u0438\u0446\u044B. \u0422\u0440\u0430\u043A\u0442\u0430\u0442
      \u0441\u043E\u0431\u0440\u0430\u043D \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470490
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0446\u0435\u043D\u043D\u044B\u0439
      \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470491
    m_Localized: "\u0410\u0440\u0442\u0430\u0432\u0430\u0437\u0434 \u0442\u043E\u0440\u0433\u0443\u0435\u0442
      \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044F\u043C\u0438 - \u0442\u043E\u0432\u0430\u0440\u043D\u044B\u0439
      \u043E\u0431\u043C\u0435\u043D \u0435\u0433\u043E \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442.
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043F\u0435\u0440\u0435\u0434\u0430\u0451\u0442
      \u0435\u043C\u0443 \u0444\u0430\u0440\u0444\u043E\u0440\u043E\u0432\u043E\u0435
      \u0431\u043B\u044E\u0434\u043E \u0438\u0437 \u0414\u0438\u043D\u0447\u0436\u043E\u0443,
      \u0438 \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C \u043C\u0435\u043D\u044F\u0435\u0442
      \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470492
    m_Localized: "\u0417\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u043E\u0435
      \u043E\u0447\u0438\u0449\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470493
    m_Localized: "\u0425\u0440\u0430\u043C \u043E\u0433\u043D\u044F \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u0441\u0442\u043E\u0438\u0442 \u0443 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442, \u0437\u0430 \u0440\u044F\u0434\u0430\u043C\u0438
      \u0442\u0443\u0442\u043E\u0432\u044B\u0445 \u0434\u0435\u0440\u0435\u0432\u044C\u0435\u0432.
      \u0414\u044B\u043C \u0441\u0430\u043D\u0434\u0430\u043B\u0430 \u0438 \u0441\u0443\u0445\u0438\u0445
      \u0442\u0440\u0430\u0432 \u043E\u0449\u0443\u0449\u0430\u0435\u0442\u0441\u044F
      \u0443\u0436\u0435 \u0441 \u0443\u043B\u0438\u0446\u044B. \u0416\u0440\u0435\u0446
      \u0424\u0430\u0440\u043D\u0431\u0430\u0433 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u043E\u0432 \u0432 \u043F\u043E\u043B\u0434\u0435\u043D\u044C
      \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u0447\u0438\u0441\u043B\u0430 \u043B\u0443\u043D\u043D\u043E\u0433\u043E
      \u043C\u0435\u0441\u044F\u0446\u0430 - \u0440\u043E\u0432\u043D\u043E \u043A\u0430\u043A
      \u0441\u043A\u0430\u0437\u0430\u043B \u043D\u0430\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C
      \u0438\u0437 \u0424\u0430\u043C\u0435\u043D\u044F. \u041E\u0447\u0438\u0449\u0435\u043D\u0438\u0435
      \u0441\u043E\u0441\u0442\u043E\u0438\u0442 \u0438\u0437 \u0442\u0440\u0451\u0445
      \u0447\u0430\u0441\u0442\u0435\u0439: \u043E\u043C\u043E\u0432\u0435\u043D\u0438\u0435
      \u0440\u0443\u043A \u0432 \u043C\u0435\u0434\u043D\u043E\u043C \u0442\u0430\u0437\u0443
      \u0441 \u0432\u043E\u0434\u043E\u0439 \u0438\u0437 \u0433\u043E\u0440\u043D\u043E\u0433\u043E
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430, \u043E\u0431\u0445\u043E\u0434
      \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u043E\u0433\u043E \u043E\u0433\u043D\u044F
      \u0442\u0440\u0438 \u0440\u0430\u0437\u0430 \u043F\u043E \u0447\u0430\u0441\u043E\u0432\u043E\u0439
      \u0441\u0442\u0440\u0435\u043B\u043A\u0435, \u043F\u0440\u043E\u0438\u0437\u043D\u0435\u0441\u0435\u043D\u0438\u0435
      \u043C\u043E\u043B\u0438\u0442\u0432\u044B \u0430\u0432\u0435\u0441\u0442\u0438\u0439\u0441\u043A\u0438\u043C\u0438
      \u0441\u043B\u043E\u0432\u0430\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0424\u0430\u0440\u043D\u0431\u0430\u0433 \u0434\u0438\u043A\u0442\u0443\u0435\u0442
      \u043F\u043E \u043E\u0434\u043D\u043E\u0439 \u0444\u0440\u0430\u0437\u0435.
      \u041E\u0431\u0440\u044F\u0434 \u0434\u043B\u0438\u0442\u0441\u044F \u043E\u043A\u043E\u043B\u043E
      \u0447\u0430\u0441\u0430 \u0438 \u0437\u0430\u043A\u0440\u044B\u0442 \u0434\u043B\u044F
      \u043F\u043E\u0441\u0442\u043E\u0440\u043E\u043D\u043D\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470494
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043E\u0431\u0440\u044F\u0434
      \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470495
    m_Localized: "\u0424\u0430\u0440\u043D\u0431\u0430\u0433 \u0441\u0442\u0430\u0432\u0438\u0442
      \u0432\u0442\u043E\u0440\u0443\u044E \u043F\u0435\u0447\u0430\u0442\u044C \u043D\u0430
      \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443 - \u043E\u0433\u043D\u0435\u043D\u043D\u044B\u0439
      \u0437\u043D\u0430\u043A \u043D\u0430 \u043A\u0440\u0430\u0441\u043D\u043E\u043C
      \u043F\u043E\u043B\u0435. \u041E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0442\u0440\u0435\u0442\u044C\u0435 \u043C\u0435\u0441\u0442\u043E: \u043C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0439
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u0432 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470496
    m_Localized: "\u0412\u0442\u043E\u0440\u043E\u0435 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470497
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0433\u0440\u0430\u043C\u043E\u0442\u0430 \u0441 \u0434\u0432\u0443\u043C\u044F
      \u043F\u0435\u0447\u0430\u0442\u044F\u043C\u0438 \u043B\u0435\u0436\u0438\u0442
      \u043F\u0435\u0440\u0435\u0434 \u0441\u0432\u0435\u0442\u0438\u043B\u044C\u043D\u0438\u043A\u043E\u043C
      \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430. \u0417\u0430\u043F\u0430\u0445 \u0441\u0430\u043D\u0434\u0430\u043B\u0430,
      \u043F\u0440\u0438\u043D\u0435\u0441\u0451\u043D\u043D\u044B\u0439 \u0438\u0437
      \u0445\u0440\u0430\u043C\u0430, \u0441\u043C\u0435\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441 \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      - \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u044C\u0435\u0439 \u0448\u0435\u0440\u0441\u0442\u044C\u044E
      \u0438 \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439 \u043F\u044B\u043B\u044C\u044E.
      \u0424\u0430\u0440\u043D\u0431\u0430\u0433 \u0441\u043A\u0430\u0437\u0430\u043B
      \u043D\u0430\u043F\u043E\u0441\u043B\u0435\u0434\u043E\u043A: \u0432 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0435
      \u043C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0439 \u0430\u0440\u0445\u043E\u043D\u0442
      \u041C\u0430\u0440 \u0417\u0430\u043A\u0445\u0435\u0439 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u0445, \u043A\u0442\u043E
      \u043F\u0440\u0438\u0448\u0451\u043B \u0441 \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u0438\u0435\u043C,
      \u0430 \u043D\u0435 \u0441 \u043B\u044E\u0431\u043E\u043F\u044B\u0442\u0441\u0442\u0432\u043E\u043C.
      \u041A\u0430\u043A \u044D\u0442\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0435\u0442\u0441\u044F
      - \u0436\u0440\u0435\u0446 \u043D\u0435 \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u0432 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D
      \u0447\u0435\u0440\u0435\u0437 \u0425\u044D\u0441\u0438-\u043A\u043E\u0440\u0438\u0434\u043E\u0440
      \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0442 \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E
      \u043C\u0435\u0441\u044F\u0446."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470498
    m_Localized: "\u0412\u044B\u0439\u0442\u0438 \u043D\u0430 \u0425\u044D\u0441\u0438-\u043A\u043E\u0440\u0438\u0434\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470499
    m_Localized: "\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434 \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043F\u043E\u0437\u0430\u0434\u0438. \u0425\u044D\u0441\u0438-\u043A\u043E\u0440\u0438\u0434\u043E\u0440
      - \u0434\u043B\u0438\u043D\u043D\u044B\u0439, \u043F\u0440\u043E\u0434\u0443\u0432\u0430\u0435\u043C\u044B\u0439,
      \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0439 \u043D\u0430 \u0434\u0432\u0430
      \u0434\u043D\u044F \u043F\u0443\u0442\u0438 \u0432 \u043B\u044E\u0431\u0443\u044E
      \u0441\u0442\u043E\u0440\u043E\u043D\u0443 - \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0433\u043E \u043F\u0443\u0442\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470500
    m_Localized: "\u041C\u0430\u0440 \u0417\u0430\u043A\u0445\u0435\u0439 \u0432
      \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993402470501
    m_Localized: "\u041C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0439
      \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u0432 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0435
      - \u043D\u0438\u0437\u043A\u043E\u0435 \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0441 \u0431\u0435\u043B\u0451\u043D\u044B\u043C\u0438 \u0441\u0442\u0435\u043D\u0430\u043C\u0438
      \u0438 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
      \u0443\u0437\u043A\u0438\u043C \u043E\u043A\u043D\u043E\u043C, \u0432\u044B\u0445\u043E\u0434\u044F\u0449\u0438\u043C
      \u043D\u0430 \u0441\u0435\u0432\u0435\u0440. \u0410\u0440\u0445\u043E\u043D\u0442
      \u041C\u0430\u0440 \u0417\u0430\u043A\u0445\u0435\u0439 \u0441\u0442\u0430\u0440,
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043D\u0430 \u0441\u043C\u0435\u0441\u0438 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0433\u043E
      \u0438 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u043E\u0433\u043E. \u041E\u043D
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u043A\u0443\u044E
      \u0433\u0440\u0430\u043C\u043E\u0442\u0443 \u0434\u043E\u043B\u0433\u043E,
      \u043F\u043E\u0442\u043E\u043C \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442
      \u043F\u043E-\u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438: \u043A\u0430\u043A\u043E\u0435
      \u0438\u0437 \u0442\u0440\u0451\u0445 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0439
      \u0434\u0430\u043B\u043E\u0441\u044C \u0442\u0440\u0443\u0434\u043D\u0435\u0435
      \u0432\u0441\u0435\u0433\u043E. \u041D\u0435 \u043E\u0442\u0432\u0435\u0442
      \u0432\u0430\u0436\u0435\u043D - \u0432\u0430\u0436\u043D\u0430 \u043F\u0430\u0443\u0437\u0430
      \u043F\u0435\u0440\u0435\u0434 \u043E\u0442\u0432\u0435\u0442\u043E\u043C.
      \u041C\u0430\u0440 \u0417\u0430\u043A\u0445\u0435\u0439 \u0441\u0442\u0430\u0432\u0438\u0442
      \u0442\u0440\u0435\u0442\u044C\u044E \u043F\u0435\u0447\u0430\u0442\u044C \u0431\u0435\u0437
      \u0441\u043B\u043E\u0432, \u0442\u0440\u0435\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u0439
      \u0437\u043D\u0430\u043A \u0447\u0451\u0440\u043D\u044B\u043C\u0438 \u0447\u0435\u0440\u043D\u0438\u043B\u0430\u043C\u0438.
      \u0413\u0440\u0430\u043C\u043E\u0442\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430.
      \u0422\u0440\u0438 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u0438 \u0437\u0430\u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0438
      \u043E\u0434\u043D\u043E \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664704
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0442\u0440\u0435\u0442\u044C\u044E
      \u043F\u0435\u0447\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664705
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u0433\u0440\u0430\u043C\u043E\u0442\u0430 \u0441 \u0442\u0440\u0435\u043C\u044F
      \u043F\u0435\u0447\u0430\u0442\u044F\u043C\u0438 - \u0431\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u043E\u0439,
      \u0437\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u043E\u0439,
      \u043C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u043E\u0439 - \u0445\u0440\u0430\u043D\u0438\u0442\u0441\u044F
      \u0432 \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439 \u0441\u0443\u043C\u043A\u0435.
      \u041C\u0430\u0440 \u0417\u0430\u043A\u0445\u0435\u0439 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043D\u0430 \u043F\u0440\u043E\u0449\u0430\u043D\u0438\u0435: \u0442\u043E\u0442,
      \u043A\u0442\u043E \u043F\u0440\u043E\u0448\u0451\u043B \u0442\u0440\u0438
      \u043E\u0433\u043D\u044F, \u0443\u0436\u0435 \u0437\u043D\u0430\u0435\u0442
      \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664706
    m_Localized: "\u0417\u0430\u0434\u0435\u0440\u0436\u0430\u043D\u043D\u044B\u0439
      \u0442\u044E\u0440\u043A \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664707
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u043F\u044B\u043B\u0438 \u0438
      \u043A\u0438\u0441\u043B\u043E\u0433\u043E \u043F\u043E\u0442\u0430 - \u0434\u0432\u043E\u0435
      \u0432\u0430\u0448\u0438\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432
      \u0442\u0430\u0449\u0430\u0442 \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u043E\u0433\u043E
      \u0442\u044E\u0440\u043A\u0430 \u043A \u043E\u0431\u043E\u0447\u0438\u043D\u0435.
      \u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u043F\u0430\u0440\u0435\u043D\u044C,
      \u043D\u0435 \u0441\u0442\u0430\u0440\u0448\u0435 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438,
      \u0441\u0435\u0440\u0430\u044F \u0432\u043E\u0439\u043B\u043E\u0447\u043D\u0430\u044F
      \u0448\u0430\u043F\u043A\u0430 \u0441\u044A\u0435\u0445\u0430\u043B\u0430 \u043D\u0430\u0431\u043E\u043A,
      \u043D\u0430 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u044F\u0445 \u0441\u0432\u0435\u0436\u0438\u0435
      \u0441\u0441\u0430\u0434\u0438\u043D\u044B \u043E\u0442 \u0432\u0435\u0440\u0451\u0432\u043A\u0438.
      \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0431\u0435\u0437
      \u0441\u0442\u0440\u0430\u0445\u0430. <npc_speech lang=\"Turkic\">\u041E\u0442\u043F\u0443\u0441\u0442\u0438.
      \u042F \u043D\u0435 \u0431\u0440\u0430\u043B \u0442\u0432\u043E\u0451.</npc_speech>
      \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0442:
      \u043F\u043E\u0439\u043C\u0430\u043B\u0438 \u0435\u0433\u043E \u0443 \u0437\u0430\u0434\u043D\u0435\u0439
      \u0442\u0435\u043B\u0435\u0433\u0438, \u043D\u043E \u0433\u0440\u0443\u0437
      \u0446\u0435\u043B. \u041C\u0435\u0448\u043E\u043A \u0441 \u0435\u0433\u043E
      \u0432\u0435\u0449\u0430\u043C\u0438 - \u043A\u0443\u0441\u043E\u043A \u0432\u044F\u043B\u0435\u043D\u043E\u0439
      \u043A\u043E\u043D\u0438\u043D\u044B, \u043A\u043E\u0441\u0442\u044F\u043D\u0430\u044F
      \u0444\u043B\u0435\u0439\u0442\u0430, \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u0439
      \u043D\u043E\u0436. \u041D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u043F\u0443\u0442\u0438 \u0442\u044E\u0440\u043A\u0438 \u0434\u0435\u0440\u0436\u0430\u0442
      \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u0441\u0442\u0435\u043F\u043D\u044B\u0445
      \u043F\u043E\u0441\u0442\u043E\u0432, \u0438 \u0441\u043B\u0443\u0445 \u043E
      \u0436\u0435\u0441\u0442\u043E\u043A\u043E\u0441\u0442\u0438 \u043A\u0443\u043F\u0446\u0430
      \u043B\u0435\u0442\u0438\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u043B\u043E\u0448\u0430\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664708
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664709
    m_Localized: "\u0420\u0430\u0437\u0432\u044F\u0437\u0430\u0432 \u0432\u0435\u0440\u0451\u0432\u043A\u0438,
      \u0432\u044B \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0435 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430\u043C
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0435\u0433\u043E. \u041F\u0430\u0440\u0435\u043D\u044C
      \u0442\u0440\u0451\u0442 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u044F,
      \u043C\u043E\u043B\u0447\u0430 \u043A\u0438\u0432\u0430\u0435\u0442 \u0438
      \u0443\u0445\u043E\u0434\u0438\u0442 \u0432 \u0441\u0442\u0435\u043F\u044C.
      \u041B\u044E\u0434\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u0441 \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u0435\u043C - \u043D\u043E
      \u0432\u044B \u0437\u043D\u0430\u0435\u0442\u0435: \u043D\u0430 \u044D\u0442\u043E\u043C
      \u043F\u0443\u0442\u0438 \u0434\u043E\u0431\u0440\u043E\u0442\u0430 \u043F\u043E\u0440\u043E\u0439
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664710
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0441\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u043C
      \u0443 \u0434\u043E\u0440\u043E\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664711
    m_Localized: "\u0412\u044B \u043F\u043B\u0430\u0442\u0438\u0442\u0435 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430\u043C
      \u0438 \u0435\u0434\u0435\u0442\u0435 \u0434\u0430\u043B\u044C\u0448\u0435.
      \u041F\u0430\u0440\u0435\u043D\u044C \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u0443 \u0434\u043E\u0440\u043E\u0433\u0438 - \u0434\u043E \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0433\u043E
      \u043F\u043E\u0441\u0435\u043B\u0435\u043D\u0438\u044F \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043B\u0438. \u0420\u0438\u0441\u043A \u043C\u0435\u0441\u0442\u0438 \u043D\u0435\u0432\u0435\u043B\u0438\u043A,
      \u043D\u043E \u043C\u043E\u043D\u0435\u0442\u044B \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B,
      \u0438 \u043D\u0430 \u043F\u043E\u0441\u0442\u0430\u0445 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0435
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438 \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u043D\u0430 \u0432\u0430\u0448 \u043E\u0431\u043E\u0437 \u0447\u0443\u0442\u044C
      \u0445\u043E\u043B\u043E\u0434\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664712
    m_Localized: "\u0422\u044E\u0440\u043A \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442
      \u0434\u043E\u043B\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664713
    m_Localized: "\u041D\u0430 \u0437\u0430\u043A\u0430\u0442\u0435 \u0443 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u044B
      \u0432\u0430\u0441 \u0434\u043E\u0433\u043E\u043D\u044F\u0435\u0442 \u0432\u0441\u0430\u0434\u043D\u0438\u043A.
      \u0422\u043E\u0442 \u0441\u0430\u043C\u044B\u0439 \u0442\u044E\u0440\u043A
      - \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u0435\u0440\u0445\u043E\u043C
      \u043D\u0430 \u043F\u0435\u0433\u043E\u043C \u043C\u0435\u0440\u0438\u043D\u0435,
      \u0440\u044F\u0434\u043E\u043C \u0434\u0432\u043E\u0435 \u0440\u043E\u0434\u0438\u0447\u0435\u0439.
      \u041E\u043D \u043F\u043E\u043C\u043D\u0438\u0442 \u043B\u0438\u0446\u043E.
      <npc_speech lang=\"Turkic\">\u0422\u044B \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B
      \u043C\u0435\u043D\u044F. \u041C\u043E\u0439 \u043E\u0442\u0435\u0446 \u0434\u0435\u0440\u0436\u0438\u0442
      \u043F\u043E\u0441\u0442 \u0443 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043A\u0430\u0440\u0430-\u0441\u0443. \u0414\u043E\u0440\u043E\u0433\u0430
      \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430 \u0434\u043B\u044F \u0442\u0432\u043E\u0435\u0433\u043E
      \u043E\u0431\u043E\u0437\u0430.</npc_speech> \u041E\u043D \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u043C\u0435\u0448\u043E\u0447\u0435\u043A - \u0432\u043D\u0443\u0442\u0440\u0438
      \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0435 \u043A\u0430\u0439\u044E\u0430\u043D\u044C
      \u0442\u0443\u043D\u0431\u0430\u043E, \u0434\u0435\u0441\u044F\u0442\u043E\u043A
      \u043C\u043E\u043D\u0435\u0442. \u041F\u043E\u043C\u043E\u0449\u044C \u043F\u0440\u0438\u0448\u043B\u0430
      \u0432 \u043D\u0443\u0436\u043D\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664714
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664715
    m_Localized: "\u041C\u043E\u043D\u0435\u0442\u044B \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044F\u0442
      \u0438\u0437 \u0440\u0443\u043A \u0432 \u0440\u0443\u043A\u0438 - \u043D\u0435
      \u043A\u0430\u043A \u043F\u043B\u0430\u0442\u0430, \u0430 \u043A\u0430\u043A
      \u0437\u043D\u0430\u043A \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F \u043C\u0435\u0436\u0434\u0443
      \u0434\u0432\u0443\u043C\u044F \u043B\u044E\u0434\u044C\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0434\u0435\u0440\u0436\u0430\u0442 \u0441\u043B\u043E\u0432\u043E. \u041D\u0430
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u043F\u043E\u0441\u0442\u0443
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438 \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442
      \u043E\u0431\u043E\u0437 \u0431\u0435\u0437 \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430:
      \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0442\u044E\u0440\u043A \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0432\u0435\u0440\u0435\u043D \u0441\u043B\u043E\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664716
    m_Localized: "\u0411\u043E\u043B\u044C\u043D\u043E\u0439 \u0441\u043E\u0433\u0434\u0438\u0435\u0446
      \u0443 \u0442\u0440\u0430\u043A\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664717
    m_Localized: "\u041A\u0438\u0441\u043B\u043E\u0432\u0430\u0442\u044B\u0439 \u0437\u0430\u043F\u0430\u0445
      \u0431\u043E\u043B\u0435\u0437\u043D\u0438 - \u0443 \u043F\u0440\u0438\u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0433\u043E
      \u043A\u0430\u043C\u043D\u044F \u043B\u0435\u0436\u0438\u0442 \u043C\u0443\u0436\u0447\u0438\u043D\u0430
      \u0432 \u0440\u0432\u0430\u043D\u043E\u043C \u0448\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u043A\u0430\u0444\u0442\u0430\u043D\u0435 \u0441 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u043C
      \u043E\u0440\u043D\u0430\u043C\u0435\u043D\u0442\u043E\u043C. \u041B\u0438\u0446\u043E
      \u0432 \u043F\u043E\u0442\u0443, \u0433\u0443\u0431\u044B \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u0432\u0448\u0438\u0435\u0441\u044F.
      \u0420\u044F\u0434\u043E\u043C - \u043E\u043F\u0440\u043E\u043A\u0438\u043D\u0443\u0442\u044B\u0439
      \u0442\u044E\u043A \u0441 \u0442\u043A\u0430\u043D\u044F\u043C\u0438. \u041E\u043D
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0445\u0440\u0438\u043F\u043B\u043E:
      <npc_speech lang=\"Sogdian\">\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u043C\u043E\u0451 \u0438\u043C\u044F. \u0422\u0440\u0438 \u0434\u043D\u044F
      \u0431\u0435\u0437 \u0432\u043E\u0434\u044B. \u0411\u0440\u0430\u0442 \u0434\u043E\u043B\u0436\u0435\u043D
      \u0436\u0434\u0430\u0442\u044C \u0432 \u041C\u0435\u0440\u0432\u0435.</npc_speech>
      \u0423 \u0432\u0430\u0441 \u0432 \u0437\u0430\u043F\u0430\u0441\u0435 \u0435\u0441\u0442\u044C
      \u043B\u0435\u0447\u0435\u0431\u043D\u044B\u0435 \u0442\u0440\u0430\u0432\u044B.
      \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0435 \u043A\u0443\u043F\u0446\u044B
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u044E\u0442 \u0431\u043E\u043B\u044C\u0448\u0443\u044E
      \u0447\u0430\u0441\u0442\u044C \u0440\u044B\u043D\u043A\u043E\u0432 \u0421\u0440\u0435\u0434\u043D\u0435\u0439
      \u0410\u0437\u0438\u0438 - \u043E\u0434\u0438\u043D \u0441\u043F\u0430\u0441\u0451\u043D\u043D\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043C\u043E\u0436\u0435\u0442 \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u0434\u0435\u0441\u044F\u0442\u043E\u043A \u0434\u0432\u0435\u0440\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664718
    m_Localized: "\u0414\u0430\u0442\u044C \u043B\u0435\u0447\u0435\u0431\u043D\u044B\u0435
      \u0442\u0440\u0430\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664719
    m_Localized: "\u0412\u044B \u0440\u0430\u0437\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0442\u0435
      \u0433\u043E\u0440\u0441\u0442\u044C \u0447\u0430\u0431\u0440\u0435\u0446\u0430
      \u0438 \u043F\u043E\u043B\u044B\u043D\u0438, \u043F\u043E\u0438\u0442\u0435
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0430 \u0441 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u043E\u0439
      \u043B\u043E\u0436\u043A\u0438. \u041E\u043D \u0437\u0430\u0441\u044B\u043F\u0430\u0435\u0442
      \u043F\u043E\u0434 \u0432\u0430\u0448\u0438\u043C \u043D\u0430\u0432\u0435\u0441\u043E\u043C.
      \u0423\u0442\u0440\u043E\u043C \u043A\u0443\u043F\u0435\u0446 \u0443\u0445\u043E\u0434\u0438\u0442
      - \u0441\u043B\u0430\u0431\u044B\u0439, \u043D\u043E \u0436\u0438\u0432\u043E\u0439.
      \u0412\u044B \u043F\u043E\u0435\u0434\u0435\u0442\u0435 \u0434\u0430\u043B\u044C\u0448\u0435,
      \u043D\u0435 \u0437\u043D\u0430\u044F, \u0432\u044B\u0437\u0434\u043E\u0440\u043E\u0432\u0435\u0435\u0442
      \u043B\u0438 \u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664720
    m_Localized: "\u041F\u0440\u043E\u0435\u0445\u0430\u0442\u044C \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664721
    m_Localized: "\u041E\u0431\u043E\u0437 \u0442\u0440\u043E\u0433\u0430\u0435\u0442\u0441\u044F.
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0432\u0441\u043B\u0435\u0434 \u043C\u043E\u043B\u0447\u0430. \u041C\u043E\u0436\u0435\u0442,
      \u0435\u0433\u043E \u043F\u043E\u0434\u0431\u0435\u0440\u0451\u0442 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      - \u0430 \u043C\u043E\u0436\u0435\u0442, \u043D\u0435\u0442. \u041D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u043F\u0443\u0442\u0438 \u043C\u0430\u043B\u043E \u043A\u0442\u043E \u043E\u0441\u0443\u0436\u0434\u0430\u0435\u0442
      \u0437\u0430 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u044C,
      \u043D\u043E \u043B\u044E\u0434\u0438 \u043F\u043E\u043C\u043D\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664722
    m_Localized: "\u0412\u0435\u0441\u0442\u044C \u043E \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664723
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439 \u043F\u043B\u043E\u0449\u0430\u0434\u0438
      \u043A \u0432\u0430\u043C \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0441\u043E\u0433\u0434\u0438\u0435\u0446
      \u0432 \u0447\u0438\u0441\u0442\u043E\u043C \u043A\u0430\u0444\u0442\u0430\u043D\u0435
      - \u043B\u0438\u0446\u043E \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0435,
      \u043D\u043E \u043C\u0430\u043D\u0435\u0440\u0430 \u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F
      \u0442\u0430 \u0436\u0435, \u0447\u0442\u043E \u0438 \u0443 \u0431\u0440\u0430\u0442\u0430.
      <npc_speech lang=\"Sogdian\">\u0422\u044B - \u0442\u043E\u0442 \u043A\u0443\u043F\u0435\u0446
      \u0441 \u0442\u0440\u0430\u043A\u0442\u0430? \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u0436\u0438\u0432. \u041E\u043D \u0432\u0435\u043B\u0435\u043B \u043F\u0435\u0440\u0435\u0434\u0430\u0442\u044C:
      \u0434\u043E\u043B\u0433 \u0431\u0443\u0434\u0435\u0442 \u043E\u043F\u043B\u0430\u0447\u0435\u043D.</npc_speech>
      \u041F\u0430\u0440\u0435\u043D\u044C \u043A\u043B\u0430\u0434\u0451\u0442 \u043D\u0430
      \u043F\u0440\u0438\u043B\u0430\u0432\u043E\u043A \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u043C\u0435\u0448\u043E\u0447\u0435\u043A \u0441 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u043C\u0438
      \u0434\u0438\u0440\u0445\u0430\u043C\u0430\u043C\u0438 \u0438 \u0441\u0432\u0438\u0442\u043E\u043A
      \u0441 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u043C
      \u043F\u0438\u0441\u044C\u043C\u043E\u043C \u043A \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u043C
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u043C \u0434\u043E\u043C\u0430\u043C
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430. \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0430\u044F
      \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u044F \u0441\u0435\u0442\u044C \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0447\u0435\u0440\u0435\u0437 \u043B\u0438\u0447\u043D\u044B\u0435 \u0441\u0432\u044F\u0437\u0438
      - \u044D\u0442\u043E \u043F\u0438\u0441\u044C\u043C\u043E \u0441\u0442\u043E\u0438\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043C\u043E\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664724
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664725
    m_Localized: "\u0414\u0438\u0440\u0445\u0430\u043C\u044B \u0438 \u043F\u0438\u0441\u044C\u043C\u043E
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044F\u0442 \u043A \u0432\u0430\u043C.
      \u0425\u043E\u0440\u043E\u0448\u0438\u0439 \u043F\u043E\u0441\u0442\u0443\u043F\u043E\u043A
      \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0434\u043E\u0431\u0440\u044B\u043C
      \u0441\u043B\u043E\u0432\u043E\u043C \u0432 \u043D\u0443\u0436\u043D\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435. \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0435
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0440\u044B\u043D\u043A\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0442
      \u0432\u0430\u0441 \u0447\u0443\u0442\u044C \u0442\u0435\u043F\u043B\u0435\u0435
      - \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443
      \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u0432\u0435\u0440\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664726
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u0441 \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664727
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0441\u0430\u043D\u0434\u0430\u043B\u043E\u0432\u043E\u0433\u043E
      \u0434\u044B\u043C\u0430 \u0442\u044F\u043D\u0435\u0442\u0441\u044F \u0438\u0437
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0433\u043E \u043F\u0440\u0438\u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0433\u043E
      \u0430\u043B\u0442\u0430\u0440\u044F. \u0411\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u043C\u043E\u043D\u0430\u0445 \u0432 \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u0432\u043E\u043C
      \u043E\u0434\u0435\u044F\u043D\u0438\u0438 \u0441\u0438\u0434\u0438\u0442 \u0443
      \u043A\u0430\u043C\u043D\u044F \u0438 \u043F\u0440\u0430\u0432\u0438\u0442
      \u043F\u0435\u0440\u043E\u043C \u043A\u0430\u0440\u0442\u0443 \u043D\u0430
      \u043A\u043E\u0436\u0435. \u041E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u0443: <npc_speech lang=\"Chinese\">\u042F \u0437\u0430\u043F\u0438\u0441\u0430\u043B
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B, \u043E \u043A\u043E\u0442\u043E\u0440\u043E\u043C
      \u0437\u0430\u0431\u044B\u043B\u0438 \u043A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444\u044B
      \u0427\u0430\u043D\u044A\u0430\u043D\u044F. \u0425\u043E\u0447\u0435\u0448\u044C
      - \u043F\u0435\u0440\u0435\u043F\u0438\u0448\u0443 \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B.
      \u041C\u0435\u0441\u0442\u043E \u0440\u0435\u0434\u043A\u043E\u0435 - \u0442\u0430\u043C
      \u043C\u043E\u0436\u043D\u043E \u0441\u0440\u0435\u0437\u0430\u0442\u044C \u0442\u0440\u0438
      \u0434\u043D\u044F \u043F\u0443\u0442\u0438.</npc_speech> \u042D\u0442\u043E
      \u0437\u043D\u0430\u043D\u0438\u0435 \u0441\u0442\u043E\u0438\u0442 \u043C\u043D\u043E\u0433\u043E\u0433\u043E.
      \u041D\u043E \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E \u0432\u044B\u0433\u043E\u0434\u043D\u044B\u0445
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430\u0445 \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F
      \u0431\u044B\u0441\u0442\u0440\u043E, \u0438 \u0443 \u043E\u043F\u044B\u0442\u043D\u043E\u0433\u043E
      \u043A\u0443\u043F\u0446\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u043D\u0430\u0439\u0434\u0443\u0442\u0441\u044F
      \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664728
    m_Localized: "\u0417\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664729
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u0434\u0438\u043A\u0442\u0443\u0435\u0442
      - \u0432\u044B \u0437\u0430\u043D\u043E\u0441\u0438\u0442\u0435 \u0434\u0430\u043D\u043D\u044B\u0435
      \u043D\u0430 \u0431\u0435\u0440\u0435\u0441\u0442\u0443. \u041C\u0430\u0440\u0448\u0440\u0443\u0442
      \u0445\u043E\u0440\u043E\u0448. \u041D\u043E \u0442\u0430\u043A\u0438\u0435
      \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u043F\u0440\u0438 \u0441\u0435\u0431\u0435 \u0442\u0440\u0443\u0434\u043D\u043E:
      \u043A\u0443\u043F\u0446\u044B \u0431\u043E\u043B\u0442\u043B\u0438\u0432\u044B,
      \u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B \u0441\u0442\u0430\u043D\u0435\u0442
      \u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u0430\u043C
      \u0440\u0430\u043D\u044C\u0448\u0435, \u0447\u0435\u043C \u0432\u044B \u0442\u0443\u0434\u0430
      \u0434\u043E\u0431\u0435\u0440\u0451\u0442\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664730
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u0431\u0435\u0437 \u0437\u0430\u043F\u0438\u0441\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664731
    m_Localized: "\u0412\u044B \u0432\u044B\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u0435\u0442\u0435
      \u043C\u043E\u043D\u0430\u0445\u0430, \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442\u0435
      \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442\u0435
      \u043F\u0443\u0442\u044C. \u0417\u043D\u0430\u043D\u0438\u0435 \u0443 \u0432\u0430\u0441
      \u0432 \u0433\u043E\u043B\u043E\u0432\u0435 - \u043D\u0435 \u043D\u0430 \u0431\u0443\u043C\u0430\u0433\u0435,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043C\u043E\u0433\u0443\u0442 \u043D\u0430\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664732
    m_Localized: "\u041A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442 \u0443 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664733
    m_Localized: "\u0423 \u0432\u0445\u043E\u0434\u0430 \u0432 \u043F\u0435\u0440\u0435\u0432\u0430\u043B
      \u0441\u0442\u043E\u0438\u0442 \u043E\u0431\u043E\u0437 \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0433\u043E
      \u043A\u0443\u043F\u0446\u0430 - \u0448\u0435\u0441\u0442\u044C \u0433\u0440\u0443\u0436\u0451\u043D\u044B\u0445
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432, \u043F\u0435\u0441\u0442\u0440\u044B\u0435
      \u0442\u044E\u043C\u0435\u043D\u0441\u043A\u0438\u0435 \u0442\u043A\u0430\u043D\u0438
      \u043F\u043E\u0432\u0435\u0440\u0445 \u0432\u044C\u044E\u043A\u043E\u0432.
      \u0425\u043E\u0437\u044F\u0438\u043D \u0443\u043B\u044B\u0431\u0430\u0435\u0442\u0441\u044F:
      <npc_speech lang=\"Sogdian\">\u0411\u0430\u0445\u0440\u0430\u043C \u0438\u0431\u043D
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D. \u041C\u043E\u043D\u0430\u0445
      \u043F\u0440\u043E\u0434\u0430\u043B \u043C\u043D\u0435 \u0442\u0435 \u0436\u0435
      \u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0430\u0442\u044B \u0442\u0440\u0438
      \u0434\u043D\u044F \u043D\u0430\u0437\u0430\u0434. \u0420\u044B\u043D\u043E\u043A
      \u0443\u0436\u0435 \u0437\u043D\u0430\u0435\u0442 \u043E \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435.</npc_speech>
      \u041F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E \u0443\u0442\u0435\u0440\u044F\u043D\u043E.
      \u041F\u0440\u0438\u0434\u0451\u0442\u0441\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0437\u0430 \u043C\u0435\u0441\u0442\u043E \u043D\u0430 \u0441\u0443\u0436\u0435\u043D\u0438\u0438
      \u0434\u043E\u0440\u043E\u0433\u0438 \u0438\u043B\u0438 \u0443\u0441\u0442\u0443\u043F\u0438\u0442\u044C
      \u043F\u0435\u0440\u0432\u0435\u043D\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664734
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u043E \u0441\u043E\u0432\u043C\u0435\u0441\u0442\u043D\u043E\u043C \u043F\u0440\u043E\u0445\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664735
    m_Localized: "\u0412\u044B \u0434\u0435\u043B\u0438\u0442\u0435 \u043E\u0447\u0435\u0440\u0435\u0434\u044C
      \u043F\u043E-\u0445\u043E\u0440\u043E\u0448\u0435\u043C\u0443: \u0411\u0430\u0445\u0440\u0430\u043C
      \u0438\u0434\u0451\u0442 \u043F\u0435\u0440\u0432\u044B\u043C, \u0432\u044B
      - \u0441\u043B\u0435\u0434\u043E\u043C. \u041F\u043E\u0442\u0435\u0440\u044F
      \u0432 \u0434\u0435\u043D\u044C\u0433\u0430\u0445 \u0438 \u0432\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0438,
      \u043D\u043E \u0441\u0441\u043E\u0440\u0430 \u0443 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430
      \u043E\u043F\u0430\u0441\u043D\u0435\u0435. \u0411\u0430\u0445\u0440\u0430\u043C
      \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u0447\u0438\u0432\u044B\u043C
      - \u0437\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u043E\u043C \u0432\u044B
      \u0443\u0437\u043D\u0430\u0451\u0442\u0435 \u0446\u0435\u043D\u044B \u0432
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u0433\u043E\u0440\u043E\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664736
    m_Localized: "\u041F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664737
    m_Localized: "\u0421\u0435\u0440\u044B\u0439 \u0432\u0435\u0447\u0435\u0440,
      \u043F\u044B\u043B\u044C \u043E\u0441\u0435\u0434\u0430\u0435\u0442 \u043D\u0430
      \u043A\u043E\u0448\u043C\u0430\u0445. \u0423 \u043E\u0431\u043E\u0447\u0438\u043D\u044B
      \u0441\u0442\u043E\u0438\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0441
      \u0442\u0451\u043C\u043D\u044B\u043C \u043B\u0438\u0446\u043E\u043C \u0438
      \u0431\u0435\u0433\u0430\u044E\u0449\u0438\u043C \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C
      - \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u0442\u044E\u043B\u0435\u043D\u0435\u0432\u044B\u0439
      \u0445\u0430\u043B\u0430\u0442, \u0440\u0432\u0430\u043D\u044B\u0435 \u0441\u0430\u043F\u043E\u0433\u0438,
      \u043D\u0430 \u043F\u043B\u0435\u0447\u0435 \u0443\u0437\u043A\u0438\u0439
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A \u0438\u0437 \u0445\u043E\u043B\u0441\u0442\u0438\u043D\u044B.
      \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0431\u0435\u0437
      \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F: <npc_speech
      lang=\"Persian\">\u0414\u043E\u0440\u043E\u0433\u0430 \u043E\u0434\u043D\u0430.
      \u0412\u043E\u0437\u044C\u043C\u0438 \u043C\u0435\u043D\u044F \u0434\u043E
      \u041C\u0435\u0440\u0432\u0430 - \u044F \u043D\u0435 \u0435\u043C \u043C\u043D\u043E\u0433\u043E.</npc_speech>
      \u0427\u0442\u043E \u0432 \u0441\u0432\u0451\u0440\u0442\u043A\u0435 - \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E.
      \u0421\u0442\u0435\u043F\u043D\u044B\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
      \u0438\u043D\u043E\u0433\u0434\u0430 \u0441\u0442\u0430\u0432\u044F\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0432 \u0445\u0432\u043E\u0441\u0442 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430,
      \u0447\u0442\u043E\u0431\u044B \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432.
      \u041D\u043E \u0438\u043D\u043E\u0433\u0434\u0430 \u0442\u0430\u043A\u043E\u0439
      \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A \u0437\u043D\u0430\u0435\u0442
      \u043E \u0437\u0430\u0441\u0430\u0434\u0430\u0445 \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u0442\u043E, \u0447\u0435\u0433\u043E \u043D\u0435 \u0437\u043D\u0430\u0435\u0442\u0435
      \u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664738
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664739
    m_Localized: "\u0427\u0435\u043B\u043E\u0432\u0435\u043A \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0445\u0432\u043E\u0441\u0442\u0435 \u043E\u0431\u043E\u0437\u0430.
      \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438 \u0441\u043B\u0435\u0434\u044F\u0442
      \u0437\u0430 \u043D\u0438\u043C, \u0432\u044B - \u0442\u043E\u0436\u0435. \u0427\u0435\u0440\u0435\u0437
      \u0447\u0435\u0442\u044B\u0440\u0435 \u0434\u043D\u044F \u0432\u0441\u0451
      \u043F\u0440\u043E\u044F\u0441\u043D\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664740
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u0438 \u0435\u0445\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664741
    m_Localized: "\u0412\u044B \u043A\u0430\u0447\u0430\u0435\u0442\u0435 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
      \u0438 \u0442\u0440\u043E\u0433\u0430\u0435\u0442\u0435\u0441\u044C. \u0427\u0435\u043B\u043E\u0432\u0435\u043A
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u0441\u043B\u0435\u0434 \u0431\u0435\u0437
      \u0437\u043B\u043E\u0431\u044B - \u0438\u043B\u0438 \u0434\u0435\u043B\u0430\u0435\u0442
      \u0432\u0438\u0434. \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0443 \u043B\u044E\u0434\u0435\u0439 \u0447\u0443\u0442\u044C \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435:
      \u043C\u0435\u043D\u044C\u0448\u0435 \u0447\u0443\u0436\u0438\u0445 \u0433\u043B\u0430\u0437
      \u0432 \u043E\u0431\u043E\u0437\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664742
    m_Localized: "\u041F\u043E\u043F\u0443\u0442\u0447\u0438\u043A \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664743
    m_Localized: "\u041D\u0430 \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439
      \u0434\u0435\u043D\u044C \u0443 \u0431\u0440\u043E\u0434\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0430\u0440\u044B\u043A \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A \u0434\u043E\u0441\u0442\u0430\u0451\u0442
      \u0438\u0437 \u0445\u043E\u043B\u0441\u0442\u0438\u043D\u044B \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u0439
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0439 \u043F\u0435\u0440\u0441\u0442\u0435\u043D\u044C
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043F\u043E-\u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438:
      <npc_speech lang=\"Sogdian\">\u042F \u0421\u0430\u043C\u0435\u0445, \u0431\u044B\u0432\u0448\u0438\u0439
      \u0441\u0447\u0451\u0442\u0447\u0438\u043A \u0443 \u0411\u0430\u0445\u0440\u0430\u043C\u0430
      \u0438\u0437 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430.
      \u0423\u0431\u0435\u0436\u0430\u043B \u0441 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438.
      \u0415\u0441\u043B\u0438 \u0434\u043E\u0432\u0435\u0437\u0451\u0448\u044C \u0434\u043E
      \u041C\u0435\u0440\u0432\u0430 - \u043F\u0435\u0440\u0435\u0434\u0430\u043C
      \u0438\u0445 \u043D\u0443\u0436\u043D\u044B\u043C \u043B\u044E\u0434\u044F\u043C.
      \u0422\u0435\u0431\u0435 \u044D\u0442\u043E \u043E\u0431\u0435\u0440\u043D\u0451\u0442\u0441\u044F
      \u0434\u043E\u0431\u0440\u044B\u043C \u0441\u043B\u043E\u0432\u043E\u043C \u0443
      \u0442\u0430\u043C\u043E\u0448\u043D\u0435\u0439 \u0433\u0438\u043B\u044C\u0434\u0438\u0438.</npc_speech>
      \u0427\u0435\u043B\u043E\u0432\u0435\u043A \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043D\u0435 \u0432\u043E\u0440\u043E\u043C - \u0431\u0435\u0433\u043B\u0435\u0446\u043E\u043C
      \u0441 \u0446\u0435\u043D\u043D\u044B\u043C\u0438 \u0431\u0443\u043C\u0430\u0433\u0430\u043C\u0438.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0432 \u041C\u0435\u0440\u0432\u0435
      \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664744
    m_Localized: "\u0414\u043E\u0432\u0435\u0437\u0442\u0438 \u0421\u0430\u043C\u0435\u0445\u0430
      \u0434\u043E \u041C\u0435\u0440\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664745
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u0434\u043E\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
      \u0434\u043E \u041C\u0435\u0440\u0432\u0430. \u041D\u0443\u0436\u043D\u044B\u0435
      \u043B\u044E\u0434\u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u0431\u0443\u043C\u0430\u0433\u0438.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0430\u044F \u0433\u0438\u043B\u044C\u0434\u0438\u044F
      \u0437\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u0435\u0442 \u0432\u0430\u0448\u0435
      \u0438\u043C\u044F \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0445\u0440\u0430\u043D\u0438\u0442
      \u0442\u0430\u0439\u043D\u044B \u0438 \u0434\u0435\u0440\u0436\u0438\u0442
      \u0441\u043B\u043E\u0432\u043E. \u0414\u043E\u0440\u043E\u0433\u0430 \u0441\u0442\u0430\u043B\u0430
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664746
    m_Localized: "\u0410\u043A\u043A\u0440\u0435\u0434\u0438\u0442\u0438\u0432 \u0430\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u043E\u0433\u043E
      \u0431\u0430\u043D\u043A\u0438\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664747
    m_Localized: "\u0410\u0440\u043E\u043C\u0430\u0442 \u043C\u0443\u0441\u043A\u0443\u0441\u0430
      \u0438 \u0447\u0435\u0440\u043D\u0438\u043B - \u0432 \u043A\u0440\u044B\u0442\u043E\u043C
      \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u043C \u0440\u044F\u0434\u0443 \u0411\u0430\u0433\u0434\u0430\u0434\u0430
      \u0437\u0430 \u043D\u0438\u0437\u043A\u0438\u043C \u0441\u0442\u043E\u043B\u043E\u043C
      \u0441\u0438\u0434\u0438\u0442 \u0410\u0445\u043C\u0430\u0434 \u0438\u0431\u043D
      \u041C\u0443\u0445\u0430\u043C\u043C\u0430\u0434 \u0430\u043B\u044C-\u0425\u043E\u0440\u0430\u0441\u0430\u043D\u0438,
      \u043C\u0435\u043D\u044F\u043B\u0430 \u0441 \u0445\u043E\u0440\u043E\u0448\u0435\u0439
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0435\u0439. \u0415\u0433\u043E
      \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u043F\u043E\u044F\u0441 \u0443\u043A\u0440\u0430\u0448\u0435\u043D
      \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u043C\u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u043A\u0430\u043C\u0438;
      \u043D\u0430 \u0441\u0442\u043E\u043B\u0435 - \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u044B\u0435
      \u0432\u0435\u0441\u044B \u0438 \u0441\u0442\u043E\u043F\u043A\u0430 \u0431\u0443\u043C\u0430\u0433\u0438
      \u0438\u0437 \u0441\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430.
      <npc_speech lang=\"Arabic\">\u0422\u0432\u043E\u0451 \u0438\u043C\u044F \u044F
      \u0441\u043B\u044B\u0448\u0430\u043B. \u0412\u043E\u0442 \u0441\u0430\u043A\u043A
      \u043D\u0430 \u0441\u0442\u043E \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      - \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u0438 \u0435\u0433\u043E \u043C\u043E\u0435\u043C\u0443
      \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u0443 \u0432 \u041C\u0435\u0440\u0432\u0435.
      \u0427\u0435\u0440\u0435\u0437 \u0447\u0435\u0442\u044B\u0440\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u043D\u0435\u0439 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043C\u0441\u044F
      \u0441\u043D\u043E\u0432\u0430. \u0414\u043E\u0431\u0430\u0432\u0438\u0448\u044C
      \u0434\u0435\u0441\u044F\u0442\u044C \u0441\u0432\u0435\u0440\u0445\u0443.</npc_speech>
      \u0410\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430
      \u0441\u0430\u043A\u043A \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u043A\u0443\u043F\u0446\u0430\u043C \u043D\u0435 \u0432\u043E\u0437\u0438\u0442\u044C
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E \u0447\u0435\u0440\u0435\u0437 \u043F\u0443\u0441\u0442\u044B\u043D\u044E.
      \u0420\u0438\u0441\u043A \u0432 \u0442\u043E\u043C, \u0447\u0442\u043E \u0434\u043E\u043B\u0433
      \u043D\u0443\u0436\u043D\u043E \u043E\u0442\u0434\u0430\u0442\u044C \u0442\u043E\u0447\u043D\u043E
      \u0432 \u0441\u0440\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664748
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0430\u043A\u043A\u0440\u0435\u0434\u0438\u0442\u0438\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664749
    m_Localized: "\u0411\u0443\u043C\u0430\u0433\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u043A \u0432\u0430\u043C. \u0421\u0442\u043E \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      - \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0437\u0430\u0434\u0430\u0442\u043E\u043A
      \u0434\u043B\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438 \u0432
      \u041C\u0435\u0440\u0432\u0435. \u041D\u043E \u0410\u0445\u043C\u0430\u0434
      \u0437\u0430\u043F\u0438\u0441\u0430\u043B \u0434\u0430\u0442\u0443, \u0438
      \u0435\u0433\u043E \u043B\u044E\u0434\u0438 \u0443\u043C\u0435\u044E\u0442
      \u0441\u0447\u0438\u0442\u0430\u0442\u044C \u0434\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664750
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043E\u0442
      \u0434\u043E\u043B\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664751
    m_Localized: "\u0412\u044B \u0432\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435\u0441\u044C.
      \u0410\u0445\u043C\u0430\u0434 \u043A\u0438\u0432\u0430\u0435\u0442 \u0431\u0435\u0437
      \u043E\u0431\u0438\u0434\u044B - \u0434\u0435\u043B\u043E\u0432\u043E\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u044C. \u0412\u044B
      \u0435\u0434\u0435\u0442\u0435 \u0431\u0435\u0437 \u0434\u043E\u043B\u0433\u0430,
      \u043D\u043E \u0438 \u0431\u0435\u0437 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u043A\u0430\u043F\u0438\u0442\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664752
    m_Localized: "\u0414\u043E\u043B\u0433 \u043F\u0435\u0440\u0435\u0434 \u0410\u0445\u043C\u0430\u0434\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664753
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u041C\u0435\u0440\u0432\u0430
      \u043A \u0432\u0430\u043C \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u043A\u043B\u0435\u0440\u043A \u0432
      \u0431\u0435\u043B\u043E\u043C \u0442\u044E\u0440\u0431\u0430\u043D\u0435 -
      \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A \u0410\u0445\u043C\u0430\u0434\u0430,
      \u043E\u043D \u043F\u0440\u0438\u0431\u044B\u043B \u0437\u0430\u0440\u0430\u043D\u0435\u0435.
      <npc_speech lang=\"Arabic\">\u041C\u043E\u0439 \u0433\u043E\u0441\u043F\u043E\u0434\u0438\u043D
      \u043F\u0440\u0438\u0431\u0443\u0434\u0435\u0442 \u0437\u0430\u0432\u0442\u0440\u0430.
      \u0421\u0442\u043E \u0434\u0435\u0441\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432,
      \u043A\u0430\u043A \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438\u0441\u044C.
      \u041E\u043D \u0446\u0435\u043D\u0438\u0442 \u0442\u0435\u0445, \u043A\u0442\u043E
      \u043F\u043B\u0430\u0442\u0438\u0442 \u0431\u0435\u0437 \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u044F.</npc_speech>
      \u0414\u0435\u0441\u044F\u0442\u044C \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432
      \u0437\u0430 \u0447\u0435\u0442\u044B\u0440\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u043D\u0435\u0439 - \u043D\u0435\u043C\u0430\u043B\u043E, \u043D\u043E
      \u0430\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u0438\u0435 \u043C\u0435\u043D\u044F\u043B\u044B
      \u043F\u043E\u043C\u043D\u044F\u0442 \u0434\u043E\u043B\u0436\u043D\u0438\u043A\u043E\u0432
      \u043D\u0430\u0434\u043E\u043B\u0433\u043E. \u0421\u0432\u043E\u0435\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u0430\u044F
      \u0432\u044B\u043F\u043B\u0430\u0442\u0430 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0434\u0432\u0435\u0440\u0438 \u043A \u0431\u043E\u043B\u0435\u0435 \u0432\u044B\u0433\u043E\u0434\u043D\u044B\u043C
      \u0441\u0434\u0435\u043B\u043A\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664754
    m_Localized: "\u0412\u044B\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0434\u043E\u043B\u0433
      \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664755
    m_Localized: "\u0421\u0442\u043E \u0434\u0435\u0441\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044F\u0442 \u043A \u043A\u043B\u0435\u0440\u043A\u0443.
      \u041E\u043D \u043E\u0442\u0434\u0430\u0451\u0442 \u043A\u0432\u0438\u0442\u0430\u043D\u0446\u0438\u044E
      \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E \u0410\u0445\u043C\u0430\u0434\u0430.
      \u0414\u043E\u0440\u043E\u0433\u043E - \u043D\u043E \u0441\u043B\u043E\u0432\u043E
      \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F. \u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0440\u044B\u043D\u043A\u0435 \u0438\u043C\u044F \u0410\u0445\u043C\u0430\u0434\u0430
      \u0438\u0431\u043D \u041C\u0443\u0445\u0430\u043C\u043C\u0430\u0434\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0432 \u0432\u0430\u0448\u0443 \u043F\u043E\u043B\u044C\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664756
    m_Localized: "\u0414\u0435\u0440\u0435\u0432\u043D\u044F \u0441 \u0431\u043E\u043B\u0435\u0437\u043D\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664757
    m_Localized: "\u0417\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u043C
      \u0434\u043E\u0440\u043E\u0433\u0438 - \u0437\u0430\u043F\u0443\u0441\u0442\u0435\u043D\u0438\u0435:
      \u0432\u043E\u0440\u043E\u0442\u0430 \u0434\u0435\u0440\u0435\u0432\u043D\u0438
      \u0437\u0430\u043F\u0435\u0440\u0442\u044B, \u043D\u0430\u0434 \u043E\u0433\u0440\u0430\u0434\u043E\u0439
      \u0442\u043E\u0440\u0447\u0438\u0442 \u043F\u0443\u0447\u043E\u043A \u0447\u0451\u0440\u043D\u043E\u0439
      \u0441\u043E\u043B\u043E\u043C\u044B - \u0437\u043D\u0430\u043A \u0431\u0435\u0434\u044B.
      \u041D\u0430 \u043A\u0430\u043C\u043D\u0435 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
      \u043B\u0435\u0436\u0438\u0442 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043B\u0435\u043F\u0451\u0448\u0435\u043A \u0438 \u0433\u043B\u0438\u043D\u044F\u043D\u044B\u0439
      \u043A\u0443\u0432\u0448\u0438\u043D. \u0421\u0442\u0430\u0440\u0438\u043A
      \u043C\u0430\u0448\u0435\u0442 \u0438\u0437-\u0437\u0430 \u0437\u0430\u0431\u043E\u0440\u0430:
      <npc_speech lang=\"Chinese\">\u041D\u0435 \u0432\u0445\u043E\u0434\u0438! \u041A\u0430\u0448\u0435\u043B\u044C
      \u0437\u0430\u0431\u0438\u0440\u0430\u0435\u0442 \u0442\u0440\u0435\u0442\u044C\u044E
      \u043D\u0435\u0434\u0435\u043B\u044E. \u0415\u0434\u0443 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438,
      \u043D\u043E \u0442\u0435\u0431\u0435 \u043D\u0435\u043B\u044C\u0437\u044F
      \u0437\u0434\u0435\u0441\u044C \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F.</npc_speech>
      \u041E\u0431\u043E\u0439\u0442\u0438 \u0434\u0435\u0440\u0435\u0432\u043D\u044E
      \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439 - \u043F\u043E\u0442\u0435\u0440\u044F
      \u0434\u043D\u044F. \u041D\u043E \u043F\u0440\u043E\u0439\u0442\u0438 \u043D\u0430\u0441\u043A\u0432\u043E\u0437\u044C
      \u043E\u043F\u0430\u0441\u043D\u043E: \u0431\u043E\u043B\u0435\u0437\u043D\u044C
      \u043C\u043E\u0436\u0435\u0442 \u0441\u0435\u0441\u0442\u044C \u0432 \u043E\u0431\u043E\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664758
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u0434\u0435\u0440\u0435\u0432\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664759
    m_Localized: "\u041E\u0431\u043E\u0437 \u0443\u0445\u043E\u0434\u0438\u0442 \u0432
      \u043E\u0431\u044A\u0435\u0437\u0434 \u043F\u043E \u043F\u043E\u043B\u0435\u0432\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435. \u041F\u043E\u0442\u0435\u0440\u044F \u0434\u043D\u044F,
      \u043B\u0438\u0448\u043D\u0438\u0439 \u043A\u0440\u044E\u043A \u043F\u043E
      \u0433\u0440\u044F\u0437\u0438. \u041D\u043E \u043B\u044E\u0434\u0438 \u0432
      \u043E\u0431\u043E\u0437\u0435 \u0434\u044B\u0448\u0430\u0442 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435
      - \u0445\u043E\u0442\u044F \u043E\u0434\u0438\u043D \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0443\u0436\u0435 \u0447\u0438\u0445\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664760
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E
      \u0431\u044B\u0441\u0442\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664761
    m_Localized: "\u0412\u044B \u0433\u043E\u043D\u0438\u0442\u0435 \u043E\u0431\u043E\u0437
      \u0447\u0435\u0440\u0435\u0437 \u0434\u0435\u0440\u0435\u0432\u043D\u044E \u0431\u0435\u0437
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438. \u0420\u0442\u044B
      \u043F\u0440\u0438\u043A\u0440\u044B\u0442\u044B \u0442\u0440\u044F\u043F\u043A\u0430\u043C\u0438,
      \u0432\u0437\u0433\u043B\u044F\u0434\u044B - \u0432 \u043F\u043E\u043B. \u0414\u0435\u0440\u0435\u0432\u043D\u044F
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0437\u0430 \u0447\u0430\u0441,
      \u043D\u043E \u0431\u043E\u043B\u044C\u043D\u043E\u0439 \u0432\u043E\u0437\u0434\u0443\u0445
      \u0443\u0436\u0435 \u0441\u0434\u0435\u043B\u0430\u043B \u0441\u0432\u043E\u0451
      \u0434\u0435\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664762
    m_Localized: "\u0411\u043E\u043B\u0435\u0437\u043D\u044C \u0432 \u043E\u0431\u043E\u0437\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664763
    m_Localized: "\u041D\u0430 \u0442\u0440\u0435\u0442\u044C\u0435 \u0443\u0442\u0440\u043E
      \u043F\u043E\u0441\u043B\u0435 \u0434\u0435\u0440\u0435\u0432\u043D\u0438 \u0442\u0440\u043E\u0435
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u043B\u0435\u0436\u0430\u0442
      \u043F\u043E\u0434 \u0442\u0435\u043B\u0435\u0433\u043E\u0439 \u0441 \u0436\u0430\u0440\u043E\u043C.
      \u041A\u0430\u0448\u0435\u043B\u044C \u0440\u0432\u0451\u0442 \u0443\u0442\u0440\u0435\u043D\u043D\u044E\u044E
      \u0442\u0438\u0448\u0438\u043D\u0443. \u042E\u0441\u0443\u0444, \u0441\u0442\u0430\u0440\u0448\u0438\u0439
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A, \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u043D\u0430 \u043D\u043E\u0433\u0430\u0445, \u043D\u043E \u0435\u0433\u043E
      \u043B\u0438\u0446\u043E \u0441\u0435\u0440\u043E\u0435: <npc_speech lang=\"Arabic\">\u0411\u043E\u043B\u0435\u0437\u043D\u044C
      \u0438\u0437 \u0442\u043E\u0439 \u0434\u0435\u0440\u0435\u0432\u043D\u0438.
      \u041D\u0430\u043C \u043D\u0430\u0434\u043E \u0432\u0441\u0442\u0430\u0442\u044C
      \u043D\u0430 \u0442\u0440\u0438 \u0434\u043D\u044F, \u0438\u043D\u0430\u0447\u0435
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u043B\u044F\u0436\u0435\u0442.</npc_speech>
      \u0411\u043E\u043B\u0435\u0437\u043D\u044C \u043F\u0440\u0438\u0448\u043B\u0430
      \u0438\u0437 \u0437\u0430\u0440\u0430\u0436\u0451\u043D\u043D\u043E\u0439 \u0434\u0435\u0440\u0435\u0432\u043D\u0438
      - \u0432\u043E\u0437\u0434\u0443\u0445 \u0438 \u043F\u044B\u043B\u044C \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0441\u0432\u043E\u0451 \u0434\u0435\u043B\u043E. \u0417\u0430\u043F\u0430\u0441\u044B
      \u0435\u0434\u044B \u0442\u0430\u044E\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435,
      \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u043E\u0432 \u043C\u0435\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664764
    m_Localized: "\u0412\u0441\u0442\u0430\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u0435\u043C
      \u043D\u0430 \u0442\u0440\u0438 \u0434\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664765
    m_Localized: "\u041E\u0431\u043E\u0437 \u0432\u0441\u0442\u0430\u0451\u0442 \u0443
      \u0440\u0443\u0447\u044C\u044F. \u0422\u0440\u0438 \u0434\u043D\u044F \u043B\u0435\u0447\u0435\u043D\u0438\u044F:
      \u0433\u043E\u0440\u044F\u0447\u0430\u044F \u0432\u043E\u0434\u0430, \u0441\u0443\u0445\u0438\u0435
      \u0442\u0440\u0430\u0432\u044B, \u043E\u0442\u0434\u044B\u0445. \u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E
      \u0432\u0441\u0442\u0430\u0451\u0442 \u043D\u0430 \u043D\u043E\u0433\u0438,
      \u043D\u043E \u0437\u0430\u043F\u0430\u0441\u044B \u0435\u0434\u044B \u0437\u0430\u043C\u0435\u0442\u043D\u043E
      \u043F\u0440\u043E\u0441\u0435\u043B\u0438, \u0438 \u0442\u0440\u043E\u0435
      \u0434\u043D\u0435\u0439 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E.
      \u0411\u043E\u043B\u0435\u0437\u043D\u044C \u0441\u0442\u043E\u0438\u043B\u0430
      \u0434\u043E\u0440\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664766
    m_Localized: "\u041F\u043E\u0434\u043A\u0443\u043F \u043D\u0430 \u0437\u0430\u0441\u0442\u0430\u0432\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664767
    m_Localized: "\u0417\u0430\u0441\u0442\u0430\u0432\u0430 \u0443 \u0440\u0435\u0447\u043D\u043E\u0439
      \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u044B - \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0439
      \u0448\u043B\u0430\u0433\u0431\u0430\u0443\u043C, \u0434\u0432\u043E\u0435
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u043E\u0432 \u0432 \u043F\u043E\u0442\u0451\u0440\u0442\u044B\u0445
      \u043A\u043E\u0436\u0430\u043D\u044B\u0445 \u043D\u0430\u0433\u0440\u0443\u0434\u043D\u0438\u043A\u0430\u0445.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439, \u0410\u0431\u0443 \u0411\u0430\u043A\u0440,
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0448\u0438
      \u0433\u0440\u0430\u043C\u043E\u0442\u044B \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0434\u043E\u043B\u0433\u043E \u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442
      \u0441 \u043D\u0430\u043C\u0435\u0440\u0435\u043D\u043D\u043E \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u043C
      \u0436\u0435\u0441\u0442\u043E\u043C: <npc_speech lang=\"Arabic\">\u0411\u0443\u043C\u0430\u0433\u0438
      \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435. \u041D\u043E \u0437\u0434\u0435\u0441\u044C
      \u0442\u0440\u0438 \u0434\u043D\u044F \u043D\u0435 \u0431\u044B\u043B\u043E
      \u043F\u043B\u0430\u0442\u044B \u0437\u0430 \u043E\u0431\u0441\u043B\u0443\u0436\u0438\u0432\u0430\u043D\u0438\u0435
      \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u044B.</npc_speech> \u041D\u0430\u043C\u0451\u043A
      \u043E\u0447\u0435\u0432\u0438\u0434\u0435\u043D. \u041F\u043E\u0434\u043A\u0443\u043F
      \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0443,
      \u043D\u043E \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u043E \xAB\u0449\u0435\u0434\u0440\u044B\u0445
      \u043A\u0443\u043F\u0446\u0430\u0445\xBB \u043D\u0430 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u0445
      \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u0431\u044B\u0441\u0442\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664768
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043D\u0435\u043E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664769
    m_Localized: "\u041C\u043E\u043D\u0435\u0442\u044B \u0441\u043A\u043E\u043B\u044C\u0437\u044F\u0442
      \u043F\u043E\u0434 \u0441\u0442\u043E\u043B\u0435\u0448\u043D\u0438\u0446\u0443.
      \u0428\u043B\u0430\u0433\u0431\u0430\u0443\u043C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F.
      \u0411\u044B\u0441\u0442\u0440\u043E \u0438 \u0447\u0438\u0441\u0442\u043E
      - \u0441\u0435\u0433\u043E\u0434\u043D\u044F. \u041D\u043E \u0410\u0431\u0443
      \u0411\u0430\u043A\u0440 \u0443\u0436\u0435 \u043F\u0438\u0448\u0435\u0442
      \u0447\u0442\u043E-\u0442\u043E \u0432 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u0431\u043B\u043E\u043A\u043D\u043E\u0442,
      \u0438 \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u0437\u0430\u0441\u0442\u0430\u0432\u0435
      \u0432\u0435\u0441\u0442\u044C \u0443\u0439\u0434\u0451\u0442 \u0440\u0430\u043D\u044C\u0448\u0435
      \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664770
    m_Localized: "\u041D\u0430\u0441\u0442\u043E\u044F\u0442\u044C \u043D\u0430 \u0437\u0430\u043A\u043E\u043D\u043D\u043E\u043C
      \u043F\u0440\u043E\u0445\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664771
    m_Localized: "\u0427\u0430\u0441 \u0441\u043F\u043E\u0440\u0438\u043C, \u0432\u0430\u0441
      \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442. \u041F\u043E\u0442\u043E\u043C
      \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u043C\u0430\u0448\u0435\u0442 \u0440\u0443\u043A\u043E\u0439
      - \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C. \u0414\u043E\u0440\u043E\u0433\u043E
      \u043E\u0431\u043E\u0448\u043B\u043E\u0441\u044C \u0432\u0440\u0435\u043C\u044F,
      \u043D\u043E \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0447\u0435\u0441\u0442\u043D\u043E\u0433\u043E
      \u043A\u0443\u043F\u0446\u0430 \u043D\u0435 \u0437\u0430\u043F\u044F\u0442\u043D\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664772
    m_Localized: "\u0421\u043B\u0443\u0445 \u043E \u0449\u0435\u0434\u0440\u043E\u043C
      \u043A\u0443\u043F\u0446\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664773
    m_Localized: "\u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0437\u0430\u0441\u0442\u0430\u0432\u0435 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0432\u0430\u0441 \u0443\u043B\u044B\u0431\u043A\u043E\u0439
      \u0435\u0449\u0451 \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A
      \u0432\u044B \u0434\u043E\u0441\u0442\u0430\u0451\u0442\u0435 \u0433\u0440\u0430\u043C\u043E\u0442\u044B.
      <npc_speech lang=\"Arabic\">\u0421\u043B\u044B\u0448\u0430\u043B\u0438 \u043E
      \u0442\u0435\u0431\u0435. \u0423 \u0410\u0431\u0443 \u0411\u0430\u043A\u0440\u0430
      \u0434\u043B\u0438\u043D\u043D\u044B\u0439 \u044F\u0437\u044B\u043A \u0438
      \u0431\u044B\u0441\u0442\u0440\u044B\u0435 \u043D\u043E\u0433\u0438 - \u0435\u0433\u043E
      \u0433\u043E\u043D\u0435\u0446 \u0434\u043E\u0431\u0440\u0430\u043B\u0441\u044F
      \u0441\u044E\u0434\u0430 \u0432\u0447\u0435\u0440\u0430.</npc_speech> \u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u0430\u0441 \u0437\u043D\u0430\u044E\u0442 \u043A\u0430\u043A \u043A\u0443\u043F\u0446\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043B\u0430\u0442\u0438\u0442
      \u0431\u0435\u0437 \u043F\u0443\u0441\u0442\u044B\u0445 \u0441\u043B\u043E\u0432.
      \u0422\u0440\u0435\u0431\u0443\u0435\u043C\u0430\u044F \u0441\u0443\u043C\u043C\u0430
      \u0432\u0434\u0432\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0439
      \u043F\u043E\u0448\u043B\u0438\u043D\u044B - \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438
      \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u044E\u0442 \u043D\u0430
      \u043F\u043E\u0432\u0442\u043E\u0440\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664774
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0443\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u043D\u044B\u0439
      \u0441\u0431\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664775
    m_Localized: "\u041B\u0438\u0448\u043D\u0438\u0435 \u043C\u043E\u043D\u0435\u0442\u044B
      \u0443\u0445\u043E\u0434\u044F\u0442. \u0421\u043B\u0443\u0445 \u043E \u0432\u0430\u0441
      \u0437\u0430\u043A\u0440\u0435\u043F\u0438\u043B\u0441\u044F - \u043D\u0430
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439 \u0437\u0430\u0441\u0442\u0430\u0432\u0435
      \u0436\u0434\u0438\u0442\u0435 \u0442\u043E\u0433\u043E \u0436\u0435. \u0429\u0435\u0434\u0440\u043E\u0441\u0442\u044C,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043D\u0430\u0447\u0430\u043B\u0430\u0441\u044C
      \u043A\u0430\u043A \u0440\u0430\u0437\u043E\u0432\u044B\u0439 \u0432\u044B\u0445\u043E\u0434,
      \u0441\u0442\u0430\u043B\u0430 \u0441\u0438\u0441\u0442\u0435\u043C\u043E\u0439.
      \u0414\u043E\u0440\u043E\u0433\u043E \u043E\u0431\u0445\u043E\u0434\u0438\u0442\u0441\u044F
      \u043C\u043E\u043B\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664776
    m_Localized: "\u0411\u0435\u0441\u0445\u043E\u0437\u043D\u0430\u044F \u043B\u043E\u0448\u0430\u0434\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664777
    m_Localized: "\u041D\u0430 \u043E\u0431\u043E\u0447\u0438\u043D\u0435 \u0441\u0442\u0435\u043F\u043D\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0438 \u043F\u0430\u0441\u0451\u0442\u0441\u044F
      \u043B\u043E\u0448\u0430\u0434\u044C \u0431\u0435\u0437 \u0441\u0435\u0434\u043E\u043A\u0430
      - \u043A\u0440\u0443\u043F\u043D\u044B\u0439 \u0441\u043E\u043B\u043E\u0432\u044B\u0439
      \u0436\u0435\u0440\u0435\u0431\u0435\u0446 \u0441 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u043C
      \u0442\u0430\u0432\u0440\u043E\u043C \u043D\u0430 \u043F\u0440\u0430\u0432\u043E\u043C
      \u0431\u043E\u043A\u0443 \u0438 \u043E\u0431\u043E\u0440\u0432\u0430\u043D\u043D\u043E\u0439
      \u0443\u0437\u0434\u043E\u0439. \u041D\u0438 \u0441\u0443\u043C\u043E\u043A,
      \u043D\u0438 \u0441\u043B\u0435\u0434\u043E\u0432 \u0445\u043E\u0437\u044F\u0438\u043D\u0430.
      \u0416\u0435\u0440\u0435\u0431\u0435\u0446 \u0441\u043F\u043E\u043A\u043E\u0435\u043D,
      \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u043F\u043E\u0434\u043E\u0439\u0442\u0438.
      \u0422\u0430\u0432\u0440\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u043B\u043E
      \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u043C\u0443 \u0440\u043E\u0434\u0443
      - \u0445\u043E\u0437\u044F\u0438\u043D \u0433\u0434\u0435-\u0442\u043E \u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664778
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043B\u043E\u0448\u0430\u0434\u044C
      \u0441 \u0441\u043E\u0431\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664779
    m_Localized: "\u0412\u044B \u0431\u0435\u0440\u0451\u0442\u0435 \u0436\u0435\u0440\u0435\u0431\u0446\u0430
      \u0432 \u043F\u043E\u0432\u043E\u0434. \u0417\u0430\u043F\u0430\u0441\u043D\u0430\u044F
      \u043B\u043E\u0448\u0430\u0434\u044C - \u0445\u043E\u0440\u043E\u0448\u043E,
      \u043D\u043E \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u0435 \u0442\u0430\u0432\u0440\u043E
      \u043E\u0431\u044F\u0437\u044B\u0432\u0430\u0435\u0442: \u0447\u0435\u0440\u0435\u0437
      \u0432\u043E\u0441\u0435\u043C\u044C \u0434\u043D\u0435\u0439 \u043C\u043E\u0436\u0435\u0442
      \u043E\u0431\u044A\u044F\u0432\u0438\u0442\u044C\u0441\u044F \u0445\u043E\u0437\u044F\u0438\u043D,
      \u0438 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0431\u0443\u0434\u0435\u0442
      \u043D\u0435\u043F\u0440\u043E\u0441\u0442\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664780
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043B\u043E\u0448\u0430\u0434\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664781
    m_Localized: "\u0412\u044B \u0435\u0434\u0435\u0442\u0435 \u0434\u0430\u043B\u044C\u0448\u0435.
      \u0416\u0435\u0440\u0435\u0431\u0435\u0446 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0432\u0441\u043B\u0435\u0434, \u043F\u043E\u0442\u043E\u043C \u043E\u043F\u0443\u0441\u043A\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u0443 \u0438 \u0441\u043D\u043E\u0432\u0430
      \u0449\u0438\u043F\u043B\u0435\u0442 \u0442\u0440\u0430\u0432\u0443. \u0413\u0440\u0443\u0437\u0430
      \u043C\u0435\u043D\u044C\u0448\u0435 - \u0434\u0443\u0448\u0430 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664782
    m_Localized: "\u0425\u043E\u0437\u044F\u0438\u043D \u043B\u043E\u0448\u0430\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664783
    m_Localized: "\u041D\u0430 \u0432\u043E\u0441\u044C\u043C\u043E\u0439 \u0434\u0435\u043D\u044C
      \u0443 \u0431\u0440\u043E\u0434\u0430 \u0432\u0430\u0441 \u0434\u043E\u0433\u043E\u043D\u044F\u0435\u0442
      \u0432\u0441\u0430\u0434\u043D\u0438\u043A - \u043C\u043E\u043B\u043E\u0434\u043E\u0439
      \u0442\u044E\u0440\u043A \u0432 \u0432\u043E\u0439\u043B\u043E\u0447\u043D\u043E\u043C
      \u0445\u0430\u043B\u0430\u0442\u0435, \u0441 \u043B\u0443\u043A\u043E\u043C
      \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439. \u041E\u043D \u0432\u0438\u0434\u0438\u0442
      \u0441\u043E\u043B\u043E\u0432\u0443\u044E \u043C\u0430\u0441\u0442\u044C \u0441\u0440\u0430\u0437\u0443.
      <npc_speech lang=\"Turkic\">\u041A\u044E\u043B\u044C - \u043C\u043E\u0439.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B \u0435\u0433\u043E \u0442\u0440\u0438
      \u043D\u0435\u0434\u0435\u043B\u0438 \u043D\u0430\u0437\u0430\u0434 \u0432
      \u0431\u0443\u0440\u0430\u043D\u0435. \u0422\u044B \u0432\u0435\u0440\u043D\u0451\u0448\u044C
      \u0438\u043B\u0438 \u043C\u043D\u0435 \u0437\u0432\u0430\u0442\u044C \u0441\u0442\u0430\u0440\u0448\u0438\u0445?</npc_speech>
      \u0417\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 \u0443 \u043D\u0435\u0433\u043E
      \u0434\u0432\u043E\u0435. \u0412\u0435\u0440\u043D\u0443\u0442\u044C \u0434\u043E\u0431\u0440\u043E\u0432\u043E\u043B\u044C\u043D\u043E
      - \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F. \u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      - \u0440\u0438\u0441\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664784
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C \u043B\u043E\u0448\u0430\u0434\u044C
      \u0431\u0435\u0437 \u0443\u0441\u043B\u043E\u0432\u0438\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664785
    m_Localized: "\u0412\u044B \u043E\u0442\u0434\u0430\u0451\u0442\u0435 \u041A\u044E\u043B\u044F.
      \u0422\u044E\u0440\u043A \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u0432\u0430\u0441 \u0438\u043D\u0430\u0447\u0435 - \u0431\u0435\u0437 \u043E\u0436\u0438\u0434\u0430\u0435\u043C\u043E\u0439
      \u043D\u0435\u043D\u0430\u0432\u0438\u0441\u0442\u0438. \u0414\u043E\u0441\u0442\u0430\u0451\u0442
      \u0438\u0437 \u0441\u0435\u0434\u0435\u043B\u044C\u043D\u043E\u0439 \u0441\u0443\u043C\u043A\u0438
      \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u043A\u043E\u0448\u0435\u043B\u0451\u043A:
      <npc_speech lang=\"Turkic\">\u0417\u0430 \u0447\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C
      - \u043C\u043E\u0438 \u043C\u043E\u043D\u0435\u0442\u044B.</npc_speech> \u0421\u0435\u0440\u0435\u0431\u0440\u043E
      \u043C\u0435\u043D\u044F\u0435\u0442 \u0445\u043E\u0437\u044F\u0438\u043D\u0430.
      \u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u043C
      \u043F\u043E\u0441\u0442\u0443 \u0432\u0430\u0448 \u043E\u0431\u043E\u0437
      \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442 \u0431\u044B\u0441\u0442\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664786
    m_Localized: "\u041F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
      \u043F\u043B\u0430\u0442\u0443 \u0437\u0430 \u0443\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664787
    m_Localized: "\u0412\u044B \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435
      \u0446\u0435\u043D\u0443. \u0422\u044E\u0440\u043A \u0442\u0435\u043C\u043D\u0435\u0435\u0442
      \u043B\u0438\u0446\u043E\u043C. \u041F\u043E\u0441\u043B\u0435 \u0434\u043E\u043B\u0433\u043E\u0433\u043E
      \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u044F \u043F\u043B\u0430\u0442\u0438\u0442
      - \u043D\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432 \u0441\u043F\u0438\u043D\u0443
      \u0434\u043E\u043B\u0433\u043E. \u0414\u0435\u043D\u044C\u0433\u0438 \u0432\u0437\u044F\u0442\u044B,
      \u043D\u043E \u043D\u0430 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0445
      \u043F\u043E\u0441\u0442\u0430\u0445 \u0432\u0430\u0441 \u0437\u0430\u043F\u043E\u043C\u043D\u044F\u0442
      \u0438\u043D\u0430\u0447\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664788
    m_Localized: "\u041B\u0435\u0447\u0435\u0431\u043D\u0430\u044F \u0442\u0440\u0430\u0432\u0430
      \u0434\u043B\u044F \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664789
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0434\u044B\u043C\u0430 \u0438
      \u043A\u0443\u043C\u044B\u0441\u0430 - \u0443 \u043A\u043E\u0447\u0435\u0432\u043E\u0439
      \u0441\u0442\u043E\u044F\u043D\u043A\u0438 \u0442\u0440\u043E\u0435 \u0442\u044E\u0440\u043A\u043E\u0432
      \u043F\u043E\u044F\u0442 \u0431\u043E\u043B\u044C\u043D\u043E\u0433\u043E \u0440\u0435\u0431\u0451\u043D\u043A\u0430
      \u0433\u043E\u0440\u044C\u043A\u0438\u043C \u0447\u0430\u0435\u043C \u0438\u0437
      \u0441\u0442\u0435\u043F\u043D\u044B\u0445 \u0442\u0440\u0430\u0432. \u041C\u0430\u0442\u044C
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0442\u0440\u0435\u0432\u043E\u0436\u043D\u043E.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u043C\u0443\u0436\u0447\u0438\u043D\u0430,
      \u0411\u0438\u043B\u044C\u0433\u044D, \u0438\u0434\u0451\u0442 \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443
      \u0431\u0435\u0437 \u043E\u0440\u0443\u0436\u0438\u044F: <npc_speech lang=\"Turkic\">\u0416\u0430\u0440
      \u0442\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C. \u0422\u0432\u043E\u0438
      \u043B\u044E\u0434\u0438 - \u0438\u0437 \u0433\u043E\u0440\u043E\u0434\u043E\u0432,
      \u0443 \u0432\u0430\u0441 \u0434\u0440\u0443\u0433\u0438\u0435 \u0442\u0440\u0430\u0432\u044B.
      \u041F\u043E\u043C\u043E\u0433\u0438.</npc_speech> \u0423 \u0432\u0430\u0441
      \u0435\u0441\u0442\u044C \u043B\u0435\u0447\u0435\u0431\u043D\u044B\u0439 \u0437\u0430\u043F\u0430\u0441.
      \u041A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0438 \u043F\u043E\u043C\u043D\u044F\u0442
      \u0434\u043E\u0431\u0440\u043E \u0438\u043D\u0430\u0447\u0435, \u0447\u0435\u043C
      \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0435 - \u043D\u0435 \u043C\u043E\u043D\u0435\u0442\u0430\u043C\u0438,
      \u0430 \u0441\u043B\u043E\u0432\u043E\u043C, \u043F\u0435\u0440\u0435\u0434\u0430\u044E\u0449\u0438\u043C\u0441\u044F
      \u043F\u043E \u0441\u0442\u0435\u043F\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664790
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u043B\u0435\u0447\u0435\u0431\u043D\u044B\u0435
      \u0442\u0440\u0430\u0432\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664791
    m_Localized: "\u041F\u0443\u0447\u043E\u043A \u0442\u0438\u043C\u044C\u044F\u043D\u0430
      \u0438 \u0433\u043E\u0440\u0435\u0447\u0430\u0432\u043A\u0438 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u043A \u043C\u0430\u0442\u0435\u0440\u0438. \u0420\u0435\u0431\u0451\u043D\u043E\u043A
      \u0437\u0430\u0441\u044B\u043F\u0430\u0435\u0442 \u043A \u0432\u0435\u0447\u0435\u0440\u0443.
      \u0411\u0438\u043B\u044C\u0433\u044D \u043C\u043E\u043B\u0447\u0430 \u043A\u0438\u0432\u0430\u0435\u0442
      - \u043D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C \u043F\u0443\u0442\u0438
      \u0442\u0430\u043A\u043E\u0439 \u043A\u0438\u0432\u043E\u043A \u0441\u0442\u043E\u0438\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0440\u0443\u043A\u043E\u043F\u043E\u0436\u0430\u0442\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664792
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u0432\u0435\u0436\u043B\u0438\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664793
    m_Localized: "\u0412\u044B \u0440\u0430\u0437\u0432\u043E\u0434\u0438\u0442\u0435
      \u0440\u0443\u043A\u0430\u043C\u0438 - \u0437\u0430\u043F\u0430\u0441\u044B
      \u043D\u0443\u0436\u043D\u044B \u0432\u0430\u043C \u0441\u0430\u043C\u0438\u043C.
      \u0411\u0438\u043B\u044C\u0433\u044D \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0431\u0435\u0437 \u0441\u043B\u043E\u0432\u0430. \u041E\u0431\u043E\u0437
      \u0435\u0434\u0435\u0442 \u0434\u0430\u043B\u044C\u0448\u0435 \u0432 \u0442\u0438\u0448\u0438\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664794
    m_Localized: "\u0421\u043B\u0430\u0432\u0430 \u043E \u043B\u0435\u043A\u0430\u0440\u0435-\u043A\u0443\u043F\u0446\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664795
    m_Localized: "\u041D\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u043C
      \u0434\u0432\u043E\u0440\u0435 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0442\u044E\u0440\u043A \u0432
      \u043F\u043E\u0442\u0451\u0440\u0442\u043E\u043C \u0445\u0430\u043B\u0430\u0442\u0435
      \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F \u0435\u0449\u0451 \u0432
      \u0434\u0432\u0435\u0440\u044F\u0445: <npc_speech lang=\"Turkic\">\u0411\u0438\u043B\u044C\u0433\u044D
      - \u043C\u043E\u0439 \u0434\u044F\u0434\u044F. \u0415\u0433\u043E \u0441\u044B\u043D
      \u0436\u0438\u0432. \u0421\u0442\u0435\u043F\u044C \u0437\u043D\u0430\u0435\u0442
      \u0442\u0432\u043E\u0451 \u0438\u043C\u044F.</npc_speech> \u041E\u043D \u043A\u043B\u0430\u0434\u0451\u0442
      \u043D\u0430 \u0441\u0442\u043E\u043B \u0433\u043E\u0440\u0441\u0442\u044C
      \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u0445 \u043C\u043E\u043D\u0435\u0442
      \u0438 \u043A\u0443\u0441\u043E\u043A \u0432\u044B\u0434\u0435\u043B\u0430\u043D\u043D\u043E\u0439
      \u043A\u043E\u0436\u0438 \u0441 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u043C
      \u043E\u0445\u0440\u0430\u043D\u043D\u044B\u043C \u0437\u043D\u0430\u043A\u043E\u043C.
      \u0417\u043D\u0430\u043A \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442,
      \u0447\u0442\u043E \u043A\u043E\u0447\u0435\u0432\u044B\u0435 \u0440\u043E\u0434\u044B
      \u0432 \u044D\u0442\u043E\u0439 \u0447\u0430\u0441\u0442\u0438 \u0441\u0442\u0435\u043F\u0438
      \u043D\u0435 \u0442\u0440\u043E\u043D\u0443\u0442 \u0432\u0430\u0448 \u043E\u0431\u043E\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664796
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0437\u043D\u0430\u043A
      \u0438 \u043C\u043E\u043D\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664797
    m_Localized: "\u041C\u043E\u043D\u0435\u0442\u044B \u0438 \u0437\u043D\u0430\u043A
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u044F\u0442 \u043A \u0432\u0430\u043C.
      \u041A\u0443\u0441\u043E\u043A \u043A\u043E\u0436\u0438 \u0431\u0443\u0434\u0435\u0442
      \u0432\u0438\u0441\u0435\u0442\u044C \u043D\u0430 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0439
      \u0442\u0435\u043B\u0435\u0433\u0435. \u0421\u0442\u0440\u0430\u0436\u0430
      \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0445 \u043F\u043E\u0441\u0442\u043E\u0432
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043D\u0435\u0433\u043E
      \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C - \u043A\u0443\u043F\u0435\u0446,
      \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0432 \u0441\u0442\u0435\u043F\u0438
      \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0447\u0435\u0441\u0442\u0438,
      \u043F\u043B\u0430\u0442\u0438\u0442 \u043C\u0435\u043D\u044C\u0448\u0435 \u043D\u0435\u0444\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u044B\u0445
      \u0441\u0431\u043E\u0440\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664798
    m_Localized: "\u041D\u0430\u0439\u0434\u0435\u043D\u043D\u044B\u0439 \u0441\u0432\u0438\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664799
    m_Localized: "\u0423 \u043A\u0440\u0430\u044F \u0442\u0440\u0430\u043A\u0442\u0430
      - \u0437\u0430\u0442\u043E\u043F\u0442\u0430\u043D\u043D\u044B\u0439 \u0446\u0438\u043B\u0438\u043D\u0434\u0440\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u0444\u0443\u0442\u043B\u044F\u0440 \u0438\u0437 \u043B\u0430\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
      \u0431\u0430\u043C\u0431\u0443\u043A\u0430. \u0412\u043D\u0443\u0442\u0440\u0438
      \u0441\u0432\u0438\u0442\u043E\u043A \u043D\u0430 \u0442\u043E\u043D\u043A\u043E\u0439
      \u0448\u0451\u043B\u043A\u043E\u0432\u043E\u0439 \u0431\u0443\u043C\u0430\u0433\u0435
      \u0441 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u043C\u0438 \u0438\u0435\u0440\u043E\u0433\u043B\u0438\u0444\u0430\u043C\u0438.
      \u0421\u0443\u0434\u044F \u043F\u043E \u043F\u0435\u0447\u0430\u0442\u0438
      - \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u0434\u043E\u043C\u0430 \u0438\u0437 \u0427\u0430\u043D\u044A\u0430\u043D\u044F.
      \u0422\u0430\u043A\u0438\u0435 \u0441\u0432\u0438\u0442\u043A\u0438 \u0442\u0435\u0440\u044F\u044E\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0440\u0438 \u0441\u043F\u0435\u0448\u043A\u0435
      \u0438\u043B\u0438 \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u0438.
      \u0425\u0440\u0430\u043D\u0438\u0442\u044C \u043D\u0430\u0445\u043E\u0434\u043A\u0443
      - \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u0447\u0443\u0436\u043E\u0439
      \u0442\u043E\u0432\u0430\u0440; \u043E\u0442\u0434\u0430\u0442\u044C - \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u043D\u0430\u0433\u0440\u0430\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664800
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0441\u0432\u0438\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664801
    m_Localized: "\u0424\u0443\u0442\u043B\u044F\u0440 \u0443\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
      \u0432 \u0441\u0443\u043C\u043A\u0443. \u0427\u0435\u0440\u0435\u0437 \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u043D\u0435\u0439 \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u0441\u044F,
      \u0438\u0449\u0435\u0442 \u043B\u0438 \u0435\u0433\u043E \u043A\u0442\u043E-\u0442\u043E
      - \u0438 \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043D\u0430\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664802
    m_Localized: "\u0421\u0434\u0430\u0442\u044C \u043D\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u043C
      \u0434\u0432\u043E\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664803
    m_Localized: "\u0425\u043E\u0437\u044F\u0438\u043D \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430 \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u0442
      \u0441\u0432\u0438\u0442\u043E\u043A \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C.
      \u0412\u044B \u0443\u0435\u0437\u0436\u0430\u0435\u0442\u0435 \u0441 \u0447\u0438\u0441\u0442\u043E\u0439
      \u0441\u043E\u0432\u0435\u0441\u0442\u044C\u044E \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u043C\u0438
      \u043C\u043E\u043D\u0435\u0442\u0430\u043C\u0438 \u0437\u0430 \u0442\u0440\u0443\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664804
    m_Localized: "\u0425\u043E\u0437\u044F\u0438\u043D \u0441\u0432\u0438\u0442\u043A\u0430
      \u043D\u0430\u0448\u0451\u043B\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664805
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u043A \u0432\u0430\u043C
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043F\u043E\u0436\u0438\u043B\u043E\u0439
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u0432 \u0442\u0451\u043C\u043D\u043E\u043C
      \u0448\u0451\u043B\u043A\u0435 - \u0440\u0443\u043A\u0430\u0432\u0430 \u0432\u044B\u0448\u0438\u0442\u044B
      \u043E\u0431\u043B\u0430\u0447\u043D\u044B\u043C \u0443\u0437\u043E\u0440\u043E\u043C
      \u0422\u0430\u043D. \u041E\u043D \u0432\u0438\u0434\u0438\u0442 \u0432\u0430\u0448
      \u0431\u0430\u043C\u0431\u0443\u043A\u043E\u0432\u044B\u0439 \u0444\u0443\u0442\u043B\u044F\u0440.
      <npc_speech lang=\"Chinese\">\u042D\u0442\u043E \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
      \u043C\u043E\u0435\u0433\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u0434\u043E\u043C\u0430. \u041D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u0435
      \u0431\u044B\u043B\u043E \u0432 \u0425\u0430\u043C\u0438\u0439\u0441\u043A\u043E\u043C
      \u0443\u0449\u0435\u043B\u044C\u0435. \u0422\u044B \u0438\u0445 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B.</npc_speech>
      \u041E\u043D \u0433\u043E\u0442\u043E\u0432 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0445\u043E\u0440\u043E\u0448\u043E. \u0421\u0432\u0438\u0442\u043E\u043A
      \u0441\u0442\u043E\u0438\u043B \u0435\u043C\u0443 \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0441\u0442\u043E\u0438\u0442 \u0432\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664806
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C \u0437\u0430 \u0445\u043E\u0440\u043E\u0448\u0443\u044E
      \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664807
    m_Localized: "\u0421\u043E\u0440\u043E\u043A \u043C\u043E\u043D\u0435\u0442 \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C
      \u0438 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0430. \u041E\u043D \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u043E\u043C \u0441\u043B\u043E\u0432\u0430
      \u0438 \u043E\u0431\u0435\u0449\u0430\u0435\u0442 \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435
      \u043F\u0438\u0441\u044C\u043C\u043E \u043A \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u043C
      \u0434\u043E\u043C\u0430\u043C \u041B\u043E\u044F\u043D\u0430. \u0427\u0435\u0441\u0442\u043D\u0430\u044F
      \u043D\u0430\u0445\u043E\u0434\u043A\u0430 \u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
      \u043A \u0445\u043E\u0437\u044F\u0438\u043D\u0443 - \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0430
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043E\u0436\u0438\u0434\u0430\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664808
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0437\u0430 \u043C\u0430\u043A\u0441\u0438\u043C\u0443\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664809
    m_Localized: "\u0412\u044B \u0434\u0435\u0440\u0436\u0438\u0442\u0435 \u0446\u0435\u043D\u0443
      \u0432\u044B\u0448\u0435 \u043F\u0435\u0440\u0432\u043E\u0433\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F.
      \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u043F\u043B\u0430\u0442\u0438\u0442
      - \u043D\u043E \u043B\u0438\u0446\u043E \u0435\u0433\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u043E,
      \u0438 \u043F\u0438\u0441\u044C\u043C\u043E \u043A \u043B\u043E\u044F\u043D\u0441\u043A\u0438\u043C
      \u0434\u043E\u043C\u0430\u043C \u0432\u044B \u0443\u0436\u0435 \u043D\u0435
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u0435. \u0414\u0435\u043D\u044C\u0433\u0438
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      - \u0442\u043E\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664810
    m_Localized: "\u041F\u043E\u0434\u0430\u0440\u043E\u043A \u0442\u0438\u0431\u0435\u0442\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664811
    m_Localized: "\u041D\u0430 \u0433\u043E\u0440\u043D\u043E\u0439 \u0442\u0440\u043E\u043F\u0435
      \u0413\u0430\u043D\u044C\u0441\u0443 - \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439
      \u0432\u043E\u0438\u043D \u0432 \u043B\u043E\u0445\u043C\u0430\u0442\u043E\u043C
      \u044F\u043A\u043E\u0432\u043E\u043C \u043F\u043E\u043B\u0443\u0448\u0443\u0431\u043A\u0435.
      \u041E\u043D \u0434\u0435\u0440\u0436\u0438\u0442 \u0432 \u0440\u0443\u043A\u0430\u0445
      \u043F\u043B\u043E\u0441\u043A\u0438\u0439 \u043A\u0430\u043C\u0435\u043D\u044C
      \u0441 \u0432\u044B\u0440\u0435\u0437\u0430\u043D\u043D\u043E\u0439 \u043C\u0430\u043D\u0442\u0440\u043E\u0439
      \u0438 \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0432\u0430\u043C:
      <npc_speech lang=\"Tibetan\">\u041D\u0430\u043D\u0430\u043C \u0434\u0430\u0451\u0442
      \u0442\u0435\u0431\u0435 \u043A\u0430\u043C\u0435\u043D\u044C. \u041C\u043E\u0439
      \u0431\u0440\u0430\u0442 \u0422\u0440\u0438\u0434\u044D \u0441\u0442\u0435\u0440\u0435\u0436\u0451\u0442
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043F\u0435\u0440\u0435\u0432\u0430\u043B.
      \u0421\u043A\u0430\u0436\u0438 \u0435\u043C\u0443: \u0431\u0435\u043B\u044B\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C \u043E\u0442 \u041D\u0430\u043D\u0430\u043C\u0430.</npc_speech>
      \u0422\u0438\u0431\u0435\u0442\u0446\u044B \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u0438\u0440\u0443\u044E\u0442
      \u0413\u0430\u043D\u044C\u0441\u0443\u0441\u043A\u0438\u0439 \u043A\u043E\u0440\u0438\u0434\u043E\u0440
      \u0432 VIII \u0432\u0435\u043A\u0435 \u0436\u0451\u0441\u0442\u043A\u043E -
      \u0441\u043B\u043E\u0432\u043E \u043E\u0434\u043D\u043E\u0433\u043E \u0432\u043E\u0438\u043D\u0430
      \u0431\u0440\u0430\u0442\u0443 \u0437\u043D\u0430\u0447\u0438\u0442 \u043F\u0440\u043E\u043F\u0443\u0441\u043A
      \u0431\u0435\u0437 \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664812
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043A\u0430\u043C\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664813
    m_Localized: "\u041A\u0430\u043C\u0435\u043D\u044C \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u043A \u0432\u0430\u043C. \u0422\u044F\u0436\u0451\u043B\u044B\u0439, \u043E\u0442\u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439,
      \u0441 \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u0433\u043E\u0440\u043D\u043E\u0433\u043E
      \u0432\u0435\u0442\u0440\u0430. \u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u043C \u043F\u043E\u0441\u0442\u0443
      \u043D\u0443\u0436\u043D\u043E \u0431\u0443\u0434\u0435\u0442 \u043D\u0430\u0437\u0432\u0430\u0442\u044C
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0435 \u0441\u043B\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664814
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664815
    m_Localized: "\u0412\u044B \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0435
      \u0440\u0443\u043A\u0438 \u0432 \u0437\u043D\u0430\u043A \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F
      \u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442\u0435: \u0447\u0443\u0436\u0438\u0445
      \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432 \u043D\u0435
      \u0431\u0435\u0440\u0451\u0442\u0435. \u041D\u0430\u043D\u0430\u043C \u043A\u0438\u0432\u0430\u0435\u0442
      - \u0443\u0432\u0430\u0436\u0430\u0435\u0442 \u043E\u0442\u0432\u0435\u0442.
      \u041A\u0430\u043C\u0435\u043D\u044C \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F
      \u043F\u0440\u0438 \u043D\u0451\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664816
    m_Localized: "\u0411\u0440\u0430\u0442 \u041D\u0430\u043D\u0430\u043C\u0430 \u043D\u0430
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664817
    m_Localized: "\u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043F\u043E\u0441\u0442
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435 - \u043A\u0430\u043C\u0435\u043D\u043D\u0430\u044F
      \u0441\u0442\u0435\u043D\u0430, \u0442\u0440\u043E\u0435 \u0432\u043E\u0438\u043D\u043E\u0432
      \u0441 \u043A\u043E\u043F\u044C\u044F\u043C\u0438, \u0437\u0430\u043F\u0430\u0445
      \u0433\u043E\u0440\u044F\u0449\u0435\u0433\u043E \u043C\u043E\u0436\u0436\u0435\u0432\u0435\u043B\u044C\u043D\u0438\u043A\u0430
      \u043E\u0442 \u0431\u043E\u043D-\u0430\u043B\u0442\u0430\u0440\u044F \u0432
      \u0443\u0433\u043B\u0443. \u0422\u0440\u0438\u0434\u044D - \u043A\u0440\u0435\u043F\u043A\u0438\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043B\u0435\u0442 \u0441\u043E\u0440\u043E\u043A\u0430
      - \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0448
      \u043E\u0431\u043E\u0437 \u0431\u0435\u0437 \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F.
      \u0412\u044B \u0434\u043E\u0441\u0442\u0430\u0451\u0442\u0435 \u043F\u043B\u043E\u0441\u043A\u0438\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C \u0441 \u043C\u0430\u043D\u0442\u0440\u043E\u0439.
      \u0422\u0440\u0438\u0434\u044D \u0431\u0435\u0440\u0451\u0442 \u0435\u0433\u043E
      \u0438 \u0434\u0435\u0440\u0436\u0438\u0442 \u0434\u043E\u043B\u0433\u043E,
      \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u0434\u043D\u043E\u0441\u0438\u0442
      \u043A\u043E \u043B\u0431\u0443: <npc_speech lang=\"Tibetan\">\u0411\u0435\u043B\u044B\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C \u041D\u0430\u043D\u0430\u043C\u0430.
      \u041F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u0435.</npc_speech> \u0412\u043E\u0438\u043D\u044B
      \u0443\u0431\u0438\u0440\u0430\u044E\u0442 \u043A\u043E\u043F\u044C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664818
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0447\u0435\u0440\u0435\u0437
      \u043F\u043E\u0441\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664819
    m_Localized: "\u041E\u0431\u043E\u0437 \u0432\u0445\u043E\u0434\u0438\u0442 \u0432
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B \u0431\u0435\u0437 \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430.
      \u0422\u0440\u0438\u0434\u044D \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u0435\u0442
      \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C - \u0431\u0435\u0437 \u0441\u043B\u043E\u0432.
      \u0414\u0430\u0440 \u0431\u0440\u0430\u0442\u0430 \u043E\u0442\u043A\u0440\u044B\u043B
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0447\u0435\u0440\u0435\u0437 \u043E\u0434\u0438\u043D
      \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u0442\u0440\u0443\u0434\u043D\u044B\u0445
      \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0445 \u043A\u043E\u0440\u0434\u043E\u043D\u043E\u0432
      \u0432 \u0413\u0430\u043D\u044C\u0441\u0443. \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u0441\u043D\u0438\u0436\u0435\u043D\u0430, \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0440\u0430\u0441\u0442\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664820
    m_Localized: "\u041E\u0433\u043E\u043D\u044C \u0432 \u043D\u043E\u0447\u043D\u043E\u043C
      \u043B\u0430\u0433\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664821
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0433\u043E\u0440\u0435\u043B\u043E\u0433\u043E
      \u0432\u043E\u0439\u043B\u043E\u043A\u0430 \u0431\u0443\u0434\u0438\u0442 \u0432\u0441\u0435\u0445
      \u0440\u0430\u0437\u043E\u043C. \u041D\u0430 \u043A\u0440\u0430\u044E \u043B\u0430\u0433\u0435\u0440\u044F
      \u044F\u0437\u044B\u043A\u0438 \u043F\u043B\u0430\u043C\u0435\u043D\u0438 \u043F\u043E\u0436\u0438\u0440\u0430\u044E\u0442
      \u043C\u0435\u0448\u043E\u043A \u0441 \u0437\u0435\u0440\u043D\u043E\u043C
      \u0438 \u043A\u0440\u0430\u0439 \u043F\u0430\u0440\u0443\u0441\u0438\u043D\u043E\u0432\u043E\u0433\u043E
      \u043D\u0430\u0432\u0435\u0441\u0430. \u041E\u0433\u043E\u043D\u044C \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
      - \u0437\u0430\u043B\u0438\u0432\u0430\u044E\u0442 \u0432\u043E\u0434\u043E\u0439
      \u0437\u0430 \u043F\u043E\u043B\u0447\u0430\u0441\u0430, \u043D\u043E \u0447\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430 \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u0430.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B.
      \u0427\u0442\u043E \u0433\u043E\u0440\u0435\u043B\u043E - \u043F\u043E\u043D\u044F\u0442\u043D\u043E.
      \u041E\u0442\u043A\u0443\u0434\u0430 \u043D\u0430\u0447\u0430\u043B\u043E\u0441\u044C
      - \u043D\u0435\u0442. \u041A\u043E\u0441\u0442\u0440\u0438\u0449\u0435 \u0432
      \u0442\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u043D\u0435
      \u0440\u0430\u0437\u0432\u043E\u0434\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664822
    m_Localized: "\u0420\u0430\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u0438\u0447\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664823
    m_Localized: "\u0412\u044B \u043E\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442\u0435
      \u043B\u044E\u0434\u0435\u0439 \u0438 \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442\u0435
      \u043C\u0435\u0441\u0442\u043E. \u0427\u0435\u0440\u0435\u0437 \u0442\u0440\u0438
      \u0434\u043D\u044F \u043A\u0430\u0440\u0442\u0438\u043D\u0430 \u043F\u0440\u043E\u044F\u0441\u043D\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664824
    m_Localized: "\u041D\u0435 \u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0432\u0440\u0435\u043C\u044F
      - \u0435\u0445\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664825
    m_Localized: "\u041E\u0431\u043E\u0437 \u0442\u0440\u043E\u0433\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435. \u041F\u0440\u0438\u0447\u0438\u043D\u0430
      \u043E\u0433\u043D\u044F \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0439.
      \u041B\u044E\u0434\u0438 \u043D\u0435\u0440\u0432\u043D\u0438\u0447\u0430\u044E\u0442,
      \u043F\u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044E\u0442 \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664826
    m_Localized: "\u041F\u0440\u0438\u0447\u0438\u043D\u0430 \u043D\u0430\u0439\u0434\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664827
    m_Localized: "\u041D\u0430 \u0442\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C
      \u043E\u0434\u0438\u043D \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u0441 \u0432\u0438\u043D\u043E\u0432\u0430\u0442\u044B\u043C
      \u043B\u0438\u0446\u043E\u043C \u0438 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043E\u0431\u0433\u043E\u0440\u0435\u0432\u0448\u0438\u0439 \u043A\u043E\u043D\u0435\u0446
      \u0444\u0438\u0442\u0438\u043B\u044F \u043E\u0442 \u043C\u0430\u0441\u043B\u044F\u043D\u043E\u0439
      \u043B\u0430\u043C\u043F\u044B - \u0443\u0440\u043E\u043D\u0438\u043B \u043F\u0435\u0440\u0435\u0434
      \u0441\u043D\u043E\u043C, \u043D\u0435 \u0437\u0430\u043C\u0435\u0442\u0438\u043B.
      \u041D\u0438\u0447\u0435\u0433\u043E \u0443\u043C\u044B\u0441\u043B\u0430:
      \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u044C \u0438 \u043D\u0435\u0431\u0440\u0435\u0436\u043D\u043E\u0441\u0442\u044C.
      <npc_speech lang=\"Sogdian\">\u042F \u0437\u0430\u043F\u043B\u0430\u0447\u0443
      \u0438\u0437 \u0441\u0432\u043E\u0435\u0433\u043E \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u044F.
      \u041F\u0440\u043E\u0441\u0442\u0438.</npc_speech> \u0412\u0438\u043D\u043E\u0432\u043D\u044B\u0439
      \u043D\u0430\u0439\u0434\u0435\u043D. \u0427\u0442\u043E \u0441 \u043D\u0438\u043C
      \u0434\u0435\u043B\u0430\u0442\u044C - \u0440\u0435\u0448\u0430\u0442\u044C
      \u0432\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664828
    m_Localized: "\u041F\u0440\u043E\u0441\u0442\u0438\u0442\u044C \u0441 \u0432\u044B\u0447\u0435\u0442\u043E\u043C
      \u0438\u0437 \u043F\u043B\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664829
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0442\u0435\u0440\u044F\u0435\u0442
      \u0447\u0430\u0441\u0442\u044C \u043E\u043F\u043B\u0430\u0442\u044B, \u043D\u043E
      \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u0432 \u043E\u0431\u043E\u0437\u0435.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0432\u0438\u0434\u044F\u0442:
      \u0432\u0438\u043D\u043E\u0432\u043D\u044B\u0439 \u043D\u0430\u043A\u0430\u0437\u0430\u043D,
      \u0430 \u043D\u0435 \u0443\u0432\u043E\u043B\u0435\u043D \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435.
      \u041C\u043E\u0440\u0430\u043B\u044C\u043D\u044B\u0439 \u0434\u0443\u0445 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      - \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0441\u0442\u044C
      \u0431\u0435\u0437 \u0436\u0435\u0441\u0442\u043E\u043A\u043E\u0441\u0442\u0438
      \u0434\u0435\u0440\u0436\u0438\u0442 \u043B\u044E\u0434\u0435\u0439 \u0432\u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664830
    m_Localized: "\u041E\u0434\u043E\u043B\u0436\u0435\u043D\u043D\u044B\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664831
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u043D\u044B\u0439 \u043A\u0443\u043F\u0435\u0446
      \u0420\u0443\u0441\u0442\u0430\u043C \u0438\u0437 \u0413\u0435\u0440\u0430\u0442\u0430
      \u0441\u0442\u043E\u0438\u0442 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
      \u0441 \u0443\u043F\u0430\u0432\u0448\u0438\u043C \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u043C
      - \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u043B\u0435\u0433\u043B\u043E
      \u043D\u0430\u0431\u043E\u043A \u0438 \u043D\u0435 \u0432\u0441\u0442\u0430\u0451\u0442.
      \u041D\u0430 \u043D\u0451\u043C \u043F\u043E\u043B\u043D\u044B\u0439 \u0432\u044C\u044E\u043A
      \u0445\u043B\u043E\u043F\u043A\u0430. <npc_speech lang=\"Persian\">\u041C\u043D\u0435
      \u0434\u043E \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0430 \u0442\u0440\u0438
      \u0434\u043D\u044F. \u041E\u0434\u043E\u043B\u0436\u0438 \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0433\u043E
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430. \u0412\u0435\u0440\u043D\u0443
      \u0432 \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0435 \u0432\u043C\u0435\u0441\u0442\u0435
      \u0441 \u0442\u0432\u043E\u0438\u043C.></npc_speech> \u0423 \u0432\u0430\u0441
      \u0435\u0441\u0442\u044C \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0439.
      \u0420\u0443\u0441\u0442\u0430\u043C \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0447\u0435\u0441\u0442\u043D\u044B\u043C \u043A\u0443\u043F\u0446\u043E\u043C.
      \u041D\u043E \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u0431\u044B\u0432\u0430\u044E\u0442
      \u0440\u0430\u0437\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664832
    m_Localized: "\u041E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664833
    m_Localized: "\u0412\u0435\u0440\u0431\u043B\u044E\u0434 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u043A \u0420\u0443\u0441\u0442\u0430\u043C\u0443. \u0427\u0435\u0440\u0435\u0437
      \u0448\u0435\u0441\u0442\u044C \u0434\u043D\u0435\u0439 \u0432 \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0435
      \u0441\u0442\u0430\u043D\u0435\u0442 \u044F\u0441\u043D\u043E, \u043A\u0430\u043A
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u043B\u043E
      \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664834
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664835
    m_Localized: "\u0412\u044B \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442\u0435:
      \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u043D\u0443\u0436\u0435\u043D \u0432\u0430\u043C \u0441\u0430\u043C\u043E\u043C\u0443.
      \u0420\u0443\u0441\u0442\u0430\u043C \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442.
      \u041E\u0431\u043E\u0437\u044B \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F.
      \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u0443 \u043B\u044E\u0434\u0435\u0439
      \u0447\u0443\u0442\u044C \u043B\u0443\u0447\u0448\u0435 - \u043D\u0438\u043A\u0430\u043A\u0438\u0445
      \u043B\u0438\u0448\u043D\u0438\u0445 \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664836
    m_Localized: "\u0412\u0435\u0440\u0431\u043B\u044E\u0434 \u0437\u0430\u0445\u0440\u043E\u043C\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664837
    m_Localized: "\u0412 \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0435 \u0420\u0443\u0441\u0442\u0430\u043C
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0432\u0430\u0441 \u0441
      \u0432\u0438\u043D\u043E\u0432\u0430\u0442\u044B\u043C \u043B\u0438\u0446\u043E\u043C.
      \u0412\u0430\u0448 \u0432\u0435\u0440\u0431\u043B\u044E\u0434 \u0441\u0442\u043E\u0438\u0442
      \u0440\u044F\u0434\u043E\u043C - \u043F\u0440\u0430\u0432\u0430\u044F \u043F\u0435\u0440\u0435\u0434\u043D\u044F\u044F
      \u043D\u043E\u0433\u0430 \u043F\u0435\u0440\u0435\u0432\u044F\u0437\u0430\u043D\u0430,
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u0435\u0434\u0432\u0430 \u0441\u0442\u0443\u043F\u0430\u0435\u0442.
      <npc_speech lang=\"Persian\">\u041A\u0430\u043C\u0435\u043D\u044C \u0432 \u0433\u043E\u0440\u043B\u0435
      \u0443\u0449\u0435\u043B\u044C\u044F. \u042F \u043D\u0435 \u0443\u0441\u043B\u0435\u0434\u0438\u043B.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u0432\u0435\u0440\u043D\u0443 - \u0443
      \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C.</npc_speech> \u0412\u0435\u0440\u0431\u043B\u044E\u0434
      \u043D\u0443\u0436\u0434\u0430\u0435\u0442\u0441\u044F \u0432 \u043B\u0435\u0447\u0435\u043D\u0438\u0438
      \u0438 \u043D\u0435\u0434\u0435\u043B\u0435 \u043E\u0442\u0434\u044B\u0445\u0430.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u043E\u0442 \u0420\u0443\u0441\u0442\u0430\u043C\u0430
      \u043F\u043E\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0447\u0430\u0441\u0442\u044C,
      \u043D\u043E \u043D\u0435 \u0432\u0441\u0451 - \u0432\u0435\u0442\u0435\u0440\u0438\u043D\u0430\u0440
      \u0432 \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0435 \u0434\u043E\u0440\u043E\u0433,
      \u0438 \u0432\u0440\u0435\u043C\u044F \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0436\u0435
      \u0441\u0435\u0440\u0435\u0431\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993406664838
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438
      \u0438 \u043B\u0435\u0447\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859008
    m_Localized: "\u0420\u0443\u0441\u0442\u0430\u043C \u0432\u044B\u043F\u043B\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0447\u0430\u0441\u0442\u044C. \u0412\u0435\u0440\u0431\u043B\u044E\u0434
      \u043B\u0435\u0447\u0438\u0442\u0441\u044F \u043D\u0435\u0434\u0435\u043B\u044E.
      \u041E\u0431\u043E\u0437 \u0441\u0442\u043E\u0438\u0442. \u0414\u0435\u043D\u044C\u0433\u0438
      \u0443\u0442\u0435\u043A\u043B\u0438, \u0432\u0440\u0435\u043C\u044F - \u0442\u043E\u0436\u0435.
      \u041E\u0434\u043E\u043B\u0436\u0451\u043D\u043D\u043E\u0435 \u0434\u043E\u0431\u0440\u043E\u0435
      \u0434\u0435\u043B\u043E \u043E\u0431\u0435\u0440\u043D\u0443\u043B\u043E\u0441\u044C
      \u043F\u0440\u044F\u043C\u044B\u043C \u0443\u0431\u044B\u0442\u043A\u043E\u043C
      - \u0443\u0440\u043E\u043A \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438: \u0434\u043E\u0432\u0435\u0440\u0438\u0435 \u0441\u0442\u043E\u0438\u0442
      \u0432\u0437\u0432\u0435\u0448\u0438\u0432\u0430\u0442\u044C, \u043A\u0430\u043A
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859009
    m_Localized: "\u0421\u0434\u0435\u043B\u043A\u0430 \u0441 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859010
    m_Localized: "\u0412 \u043F\u043E\u043B\u0443\u0442\u0451\u043C\u043D\u043E\u043C
      \u0443\u0433\u043B\u0443 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430 - \u043D\u0435\u0432\u0437\u0440\u0430\u0447\u043D\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432 \u043F\u044B\u043B\u044C\u043D\u043E\u043C
      \u0431\u0443\u0440\u043D\u0443\u0441\u0435. \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0442\u0438\u0445\u043E, \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044F
      \u0433\u043B\u0430\u0437: <npc_speech lang=\"Arabic\">\u0412\u043F\u0435\u0440\u0435\u0434\u0438
      \u043D\u0430 \u0442\u0440\u0430\u043A\u0442\u0435 \u0435\u0441\u0442\u044C
      \u043C\u0435\u0441\u0442\u043E - \u0443\u0449\u0435\u043B\u044C\u0435 \u0425\u0430\u0441\u0430\u043D.
      \u0422\u0430\u043C \u0441\u0435\u0439\u0447\u0430\u0441 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435\u0442. \u041D\u043E \u0435\u0441\u043B\u0438 \u0442\u044B \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0448\u044C
      \u043C\u043D\u0435 \u0441\u0435\u0433\u043E\u0434\u043D\u044F, \u044F \u0441\u043A\u0430\u0436\u0443,
      \u0433\u0434\u0435 \u043F\u0440\u043E\u0435\u0445\u0430\u0442\u044C \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E.</npc_speech>
      \u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0437\u0430 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u043E
      \u0434\u043E\u0440\u043E\u0433\u0435. \u0427\u0435\u043B\u043E\u0432\u0435\u043A
      \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0441 \u043D\u0443\u0436\u043D\u044B\u043C\u0438 \u0441\u0432\u044F\u0437\u044F\u043C\u0438.
      \u0418\u043B\u0438 \u043A\u0430\u043A \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043F\u043E\u0441\u043B\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859011
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0437\u0430
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859012
    m_Localized: "\u041C\u043E\u043D\u0435\u0442\u044B \u0443\u0445\u043E\u0434\u044F\u0442.
      \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440 \u0448\u0435\u043F\u0447\u0435\u0442
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0438 \u0438\u0441\u0447\u0435\u0437\u0430\u0435\u0442.
      \u0427\u0435\u0440\u0435\u0437 \u0432\u043E\u0441\u0435\u043C\u044C \u0434\u043D\u0435\u0439
      \u0432\u044B\u044F\u0441\u043D\u0438\u0442\u0441\u044F, \u0441\u0442\u043E\u0438\u043B\u0430
      \u043B\u0438 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u0441\u0432\u043E\u0438\u0445
      \u0434\u0435\u043D\u0435\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859013
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u0438 \u0435\u0445\u0430\u0442\u044C
      \u0441\u0432\u043E\u0438\u043C \u043F\u0443\u0442\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859014
    m_Localized: "\u0412\u044B \u0432\u0441\u0442\u0430\u0451\u0442\u0435 \u0438
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u0435. \u0421\u0432\u043E\u0439
      \u043F\u0443\u0442\u044C \u043F\u043E\u043D\u044F\u0442\u0435\u043D. \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u0441\u043B\u0435\u0434 -
      \u0431\u0435\u0437 \u0437\u043B\u043E\u0431\u044B, \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
      \u043E\u0436\u0438\u0434\u0430\u043B \u043E\u0442\u043A\u0430\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859015
    m_Localized: "\u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u0431\u044B\u043B\u0430
      \u043B\u043E\u0432\u0443\u0448\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859016
    m_Localized: "\u0412 \u0443\u0449\u0435\u043B\u044C\u0435 \u0425\u0430\u0441\u0430\u043D
      - \u0437\u0430\u0441\u0430\u0434\u0430. \u0427\u0435\u043B\u043E\u0432\u0435\u043A
      \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u043D\u0430 \u0441\u043A\u043B\u043E\u043D\u0430\u0445,
      \u043B\u0443\u043A\u0438 \u043D\u0430\u0442\u044F\u043D\u0443\u0442\u044B.
      \u041E\u043D\u0438 \u0436\u0434\u0430\u043B\u0438 \u0432\u0430\u0441 \u0438\u043C\u0435\u043D\u043D\u043E
      \u0437\u0434\u0435\u0441\u044C, \u0438\u043C\u0435\u043D\u043D\u043E \u0441\u0435\u0439\u0447\u0430\u0441.
      \u041C\u0430\u0440\u0448\u0440\u0443\u0442 \u043E\u0442 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440\u0430
      \u043F\u0440\u0438\u0432\u0451\u043B \u043F\u0440\u044F\u043C\u043E \u043A
      \u043D\u0438\u043C. \u0414\u043E\u0440\u043E\u0433\u0438 \u043D\u0430\u0437\u0430\u0434
      \u043D\u0435\u0442 - \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u043F\u0435\u0440\u0451\u0434,
      \u0441\u043A\u0432\u043E\u0437\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859017
    m_Localized: "\u041F\u0440\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F \u0441
      \u043E\u0445\u0440\u0430\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859018
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u0430 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      \u041F\u0440\u043E\u0440\u044B\u0432 \u0441\u0442\u043E\u0438\u0442 \u043A\u0440\u043E\u0432\u0438
      \u0438 \u043C\u043E\u043D\u0435\u0442 - \u0447\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430
      \u0431\u0440\u043E\u0448\u0435\u043D\u0430, \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043B\u044E\u0434\u0435\u0439 \u0440\u0430\u043D\u0435\u043D\u044B. \u041E\u0431\u043E\u0437
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0438\u0437 \u0443\u0449\u0435\u043B\u044C\u044F
      \u043F\u043E\u043A\u0430\u043B\u0435\u0447\u0435\u043D\u043D\u044B\u043C. \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0442\u043E\u0440
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0441\u0432\u043E\u0438 \u0434\u0435\u043D\u044C\u0433\u0438
      \u0434\u0432\u0430\u0436\u0434\u044B: \u043E\u0442 \u0432\u0430\u0441 \u0438
      \u043E\u0442 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859019
    m_Localized: "\u041E\u0431\u0449\u0438\u0439 \u043B\u0430\u0433\u0435\u0440\u044C
      \u0441 \u043A\u0443\u043F\u0446\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859020
    m_Localized: "\u0412\u0435\u0447\u0435\u0440 \u0443 \u0433\u043E\u0440\u043D\u043E\u0439
      \u0440\u0435\u043A\u0438 - \u0434\u0440\u0443\u0433\u043E\u0439 \u043E\u0431\u043E\u0437
      \u0443\u0436\u0435 \u0437\u0430\u043D\u044F\u043B \u043B\u0443\u0447\u0448\u0435\u0435
      \u043C\u0435\u0441\u0442\u043E \u0443 \u0432\u043E\u0434\u044B. \u041A\u0443\u043F\u0435\u0446
      \u0424\u0430\u0440\u0440\u0443\u0445 \u0438\u0431\u043D \u0414\u0430\u0440\u0438\u0443\u0448
      \u0438\u0437 \u0411\u0443\u0445\u0430\u0440\u044B \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
      \u0440\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C \u043A\u043E\u0441\u0442\u0451\u0440:
      <npc_speech lang=\"Persian\">\u041C\u0435\u0441\u0442\u0430 \u0445\u0432\u0430\u0442\u0438\u0442.
      \u0423 \u043C\u0435\u043D\u044F \u043B\u0438\u0448\u043D\u0438\u0439 \u043A\u043E\u0442\u0451\u043B
      \u043F\u043B\u043E\u0432\u0430. \u0423 \u0442\u0435\u0431\u044F \u043E\u0445\u0440\u0430\u043D\u0430
      \u043B\u0443\u0447\u0448\u0435.</npc_speech> \u0424\u0430\u0440\u0440\u0443\u0445
      \u0431\u043E\u0439\u043A\u0438\u0439, \u0445\u043E\u0440\u043E\u0448\u043E
      \u0437\u043D\u0430\u0435\u0442 \u0434\u043E\u0440\u043E\u0433\u0443. \u041D\u0430
      \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C \u043F\u0443\u0442\u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0435
      \u0441\u043E\u044E\u0437\u044B \u0443 \u043B\u0430\u0433\u0435\u0440\u043D\u043E\u0433\u043E
      \u043E\u0433\u043D\u044F \u0447\u0430\u0441\u0442\u043E \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
      \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u043C\u0438 \u0434\u0435\u043B\u043E\u0432\u044B\u043C\u0438
      \u0441\u0432\u044F\u0437\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859021
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859022
    m_Localized: "\u041B\u0430\u0433\u0435\u0440\u044F \u0441\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F.
      \u041F\u043B\u043E\u0432 \u0438\u0437 \u043A\u043E\u0442\u043B\u0430 \u0424\u0430\u0440\u0440\u0443\u0445a
      - \u0437\u0438\u0440\u0430 \u0438 \u043C\u043E\u0440\u043A\u043E\u0432\u044C,
      \u0436\u0438\u0440\u043D\u044B\u0439. \u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u0434\u043E\u043B\u0433\u0438\u0439. \u0427\u0435\u0440\u0435\u0437 \u043E\u0434\u0438\u043D\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u043D\u0435\u0439 \u043F\u0443\u0442\u0438 \u0432\u044B \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u0435
      \u0424\u0430\u0440\u0440\u0443\u0445a \u0441\u043D\u043E\u0432\u0430 \u0432
      \u0434\u0440\u0443\u0433\u043E\u043C \u0433\u043E\u0440\u043E\u0434\u0435 -
      \u0438 \u043E\u043D \u0432\u0430\u0441 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859023
    m_Localized: "\u0414\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859024
    m_Localized: "\u0412\u044B \u0432\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435\u0441\u044C.
      \u0421\u0442\u0430\u0432\u0438\u0442\u0435 \u043B\u0430\u0433\u0435\u0440\u044C
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0435. \u0422\u0438\u0445\u0438\u0439
      \u0432\u0435\u0447\u0435\u0440, \u0431\u0435\u0437 \u0447\u0443\u0436\u0438\u0445
      \u0443\u0448\u0435\u0439. \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0443 \u043B\u044E\u0434\u0435\u0439 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859025
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u0430 \u0441 \u0424\u0430\u0440\u0440\u0443\u0445\u043E\u043C
      \u0432 \u0433\u043E\u0440\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859026
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u041C\u0435\u0440\u0432\u0430
      \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0435 \u043B\u0438\u0446\u043E -
      \u0424\u0430\u0440\u0440\u0443\u0445 \u0432 \u0447\u0438\u0441\u0442\u043E\u043C
      \u043A\u0430\u0444\u0442\u0430\u043D\u0435, \u0440\u044F\u0434\u043E\u043C
      \u0434\u0432\u043E\u0435 \u043D\u043E\u0441\u0438\u043B\u044C\u0449\u0438\u043A\u043E\u0432.
      \u041E\u043D \u0443\u0437\u043D\u0430\u0451\u0442 \u0432\u0430\u0441 \u0441
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438 \u0448\u0430\u0433\u043E\u0432
      \u0438 \u0438\u0434\u0451\u0442 \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443
      \u0441 \u0448\u0438\u0440\u043E\u043A\u043E\u0439 \u0443\u043B\u044B\u0431\u043A\u043E\u0439:
      <npc_speech lang=\"Persian\">\u041A\u0443\u043F\u0435\u0446 \u0443 \u0440\u0435\u043A\u0438!
      \u042F \u0437\u0434\u0435\u0441\u044C \u0442\u0440\u0438 \u0434\u043D\u044F
      - \u0440\u044B\u043D\u043E\u043A \u0445\u043E\u0440\u043E\u0448\u043E \u0438\u0434\u0451\u0442.
      \u0414\u0430\u0432\u0430\u0439 \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u043C
      \u043E \u0434\u0435\u043B\u0435. \u041C\u043D\u0435 \u043D\u0443\u0436\u043D\u043E
      \u0442\u043E, \u0447\u0442\u043E \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C,
      \u0442\u0435\u0431\u0435 - \u0447\u0442\u043E \u0443 \u043C\u0435\u043D\u044F.</npc_speech>
      \u041E\u0431\u0449\u0438\u0439 \u0432\u0435\u0447\u0435\u0440 \u0443 \u043A\u043E\u0441\u0442\u0440\u0430
      \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0441\u044F \u0432 \u0434\u0435\u043B\u043E\u0432\u043E\u0439
      \u043A\u043E\u043D\u0442\u0430\u043A\u0442 \u0432 \u043D\u0443\u0436\u043D\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859027
    m_Localized: "\u0417\u0430\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0441\u0434\u0435\u043B\u043A\u0443
      \u0441 \u0424\u0430\u0440\u0440\u0443\u0445\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859028
    m_Localized: "\u0424\u0430\u0440\u0440\u0443\u0445 \u0442\u043E\u0440\u0433\u0443\u0435\u0442
      \u0431\u044B\u0441\u0442\u0440\u043E \u0438 \u0447\u0435\u0441\u0442\u043D\u043E.
      \u0421\u0434\u0435\u043B\u043A\u0430 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043A \u043F\u043E\u043B\u0443\u0434\u043D\u044E. \u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u043F\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0441\u0432\u0435\u0440\u0445
      \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E - \u044D\u0442\u043E \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C
      \u043E\u0434\u043D\u043E\u0433\u043E \u0432\u0435\u0447\u0435\u0440\u0430 \u0443
      \u043A\u043E\u0441\u0442\u0440\u0430 \u043E\u0434\u0438\u043D\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u043D\u0435\u0439 \u043D\u0430\u0437\u0430\u0434. \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C \u0441\u0442\u0440\u043E\u0438\u0442\u0441\u044F \u043D\u0430
      \u0442\u0430\u043A\u0438\u0445 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u044B\u0445,
      \u043D\u043E \u043F\u0430\u043C\u044F\u0442\u043D\u044B\u0445 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859029
    m_Localized: "\u0423\u0437\u043D\u0430\u0442\u044C \u043E \u0434\u043E\u0440\u043E\u0433\u0435
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859030
    m_Localized: "\u0424\u0430\u0440\u0440\u0443\u0445 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043E \u0446\u0435\u043D\u0430\u0445, \u043F\u043E\u0441\u0442\u0430\u0445
      \u0438 \u0442\u0440\u0443\u0434\u043D\u044B\u0445 \u0443\u0447\u0430\u0441\u0442\u043A\u0430\u0445
      \u043F\u0443\u0442\u0438. \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
      \u0438\u0437 \u043F\u0435\u0440\u0432\u044B\u0445 \u0440\u0443\u043A \u0441\u0442\u043E\u0438\u0442
      \u0434\u043E\u0440\u043E\u0436\u0435 \u043B\u044E\u0431\u043E\u0433\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u0441\u043F\u0440\u0430\u0432\u043E\u0447\u043D\u0438\u043A\u0430. \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0435
      \u043D\u0430\u0432\u044B\u043A\u0438 \u0440\u0430\u0441\u0442\u0443\u0442 -
      \u0432\u044B \u0437\u043D\u0430\u0435\u0442\u0435, \u0447\u0442\u043E \u0436\u0434\u0451\u0442
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859031
    m_Localized: "\u0422\u043E\u0432\u0430\u0440 \u0432 \u0434\u043E\u043B\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859032
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      - \u0431\u0443\u0445\u0430\u0440\u0441\u043A\u0438\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0448\u0451\u043B\u043A\u043E\u043C \u0441 \u043F\u044F\u0442\u043D\u0430\u043C\u0438
      \u0441\u0438\u043D\u0435\u0439 \u043A\u0440\u0430\u0441\u043A\u0438 \u043D\u0430
      \u043F\u0430\u043B\u044C\u0446\u0430\u0445 \u043E\u0442 \u043F\u043E\u0434\u043A\u0440\u0430\u0441\u043A\u0438
      \u043E\u0431\u0440\u0430\u0437\u0446\u043E\u0432 - \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442
      \u0442\u0440\u0438 \u0442\u044E\u043A\u0430 \u0431\u043E\u043A\u0445\u0430\u0440\u0441\u043A\u043E\u0433\u043E
      \u0431\u0430\u0440\u0445\u0430\u0442\u0430 \u0431\u0435\u0437 \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E\u0439
      \u043E\u043F\u043B\u0430\u0442\u044B: <npc_speech lang=\"Sogdian\">\u0420\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u0435\u0448\u044C\u0441\u044F
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435. \u042F
      \u0437\u043D\u0430\u044E \u0442\u0432\u043E\u0451 \u0441\u043B\u043E\u0432\u043E
      - \u043E\u043D\u043E \u0442\u044F\u0436\u0435\u043B\u0435\u0435, \u0447\u0435\u043C
      \u043B\u044E\u0431\u0430\u044F \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0430.</npc_speech>
      \u041A\u0440\u0435\u0434\u0438\u0442 \u0431\u0435\u0437 \u0440\u0430\u0441\u043F\u0438\u0441\u043A\u0438
      - \u0432\u044B\u0441\u0448\u0430\u044F \u0444\u043E\u0440\u043C\u0430 \u0434\u043E\u0432\u0435\u0440\u0438\u044F
      \u0432 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0435.
      \u0415\u0441\u043B\u0438 \u043D\u0435 \u0440\u0430\u0441\u043F\u043B\u0430\u0442\u0438\u0442\u044C\u0441\u044F,
      \u0438\u043C\u044F \u0441\u0442\u0430\u043D\u0435\u0442 \u0445\u0443\u0436\u0435
      \u043B\u044E\u0431\u043E\u0433\u043E \u0434\u043E\u043B\u0433\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859033
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0432\u0435\u0441\u044C
      \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859034
    m_Localized: "\u0422\u0440\u0438 \u0442\u044E\u043A\u0430 \u0431\u0430\u0440\u0445\u0430\u0442\u0430
      - \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0442\u043E\u0432\u0430\u0440
      \u0434\u043B\u044F \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u0432\u043C\u0435\u0441\u0442\u043E \u0437\u0430\u043B\u043E\u0433\u0430.
      \u041D\u043E \u0435\u0441\u043B\u0438 \u043D\u0435 \u0440\u0430\u0441\u043F\u043B\u0430\u0442\u0438\u0442\u044C\u0441\u044F
      \u0432 \u0441\u0440\u043E\u043A - \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0435\u0442 \u0432\u0441\u0435\u043C
      \u043A\u0443\u043F\u0446\u0430\u043C \u043E\u0442 \u041C\u0435\u0440\u0432\u0430
      \u0434\u043E \u041A\u0430\u0448\u0433\u0430\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859035
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u0442\u044E\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859036
    m_Localized: "\u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u0442\u043E\u0432\u0430\u0440\u0430
      - \u0432\u0434\u0432\u043E\u0435 \u043C\u0435\u043D\u044C\u0448\u0438\u0439
      \u0440\u0438\u0441\u043A. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u043A\u0438\u0432\u043D\u0443\u043B: \u0440\u0430\u0437\u0443\u043C\u043D\u044B\u0439
      \u043A\u0443\u043F\u0435\u0446 \u043D\u0435 \u0431\u0435\u0440\u0451\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043C\u043E\u0436\u0435\u0442
      \u043F\u0440\u043E\u0434\u0430\u0442\u044C. \u0414\u043E\u0432\u0435\u0440\u0438\u0435
      \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u043E \u0432 \u043F\u043E\u043B\u043D\u043E\u0439
      \u043C\u0435\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859037
    m_Localized: "\u041E\u0442\u0441\u0440\u043E\u0447\u043A\u0430 \u043E\u0442 \u0441\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0441\u043A\u043E\u0433\u043E
      \u0431\u0430\u043D\u043A\u0438\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859038
    m_Localized: "\u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0441\u043A\u0438\u0439
      \u043C\u0435\u043D\u044F\u043B\u0430 \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0438\u0431\u043D \u0411\u0430\u0445\u0440\u0430\u043C \u0432\u0435\u0434\u0451\u0442
      \u0443\u0447\u0451\u0442 \u0441 \u043F\u0435\u0434\u0430\u043D\u0442\u0438\u0447\u043D\u043E\u0441\u0442\u044C\u044E
      \u0437\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0446\u0430 -
      \u043A\u0430\u0436\u0434\u0430\u044F \u043C\u043E\u043D\u0435\u0442\u0430 \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u0430
      \u0434\u0432\u0430\u0436\u0434\u044B. \u041D\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F
      \u043E\u043D \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043A\u043D\u0438\u0433\u0443
      \u0440\u0430\u043D\u044C\u0448\u0435 \u0432\u0440\u0435\u043C\u0435\u043D\u0438:
      <npc_speech lang=\"Sogdian\">\u0422\u044B \u0434\u043E\u043B\u0436\u0435\u043D
      \u043C\u043D\u0435 \u043E\u0442 \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E
      \u043C\u0435\u0441\u044F\u0446\u0430. \u042F \u0437\u043D\u0430\u044E \u0442\u0432\u043E\u0451
      \u0438\u043C\u044F. \u041F\u043B\u0430\u0442\u0438 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u043D\u0435\u0439 -
      \u0431\u0435\u0437 \u0448\u0442\u0440\u0430\u0444\u0430. \u0427\u0435\u0441\u0442\u043D\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0443\u0441\u043F\u0435\u0435\u0442.</npc_speech>
      \u041E\u0442\u0441\u0440\u043E\u0447\u043A\u0430 \u0434\u043E\u043B\u0433\u0430
      \u0431\u0435\u0437 \u0448\u0442\u0440\u0430\u0444\u0430 - \u043F\u0440\u0438\u0432\u0438\u043B\u0435\u0433\u0438\u044F,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0434\u0430\u0451\u0442 \u043E\u0434\u043D\u043E\u043C\u0443 \u043A\u0443\u043F\u0446\u0443
      \u0438\u0437 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859039
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043E\u0442\u0441\u0440\u043E\u0447\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859040
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u043D\u0435\u0439
      - \u0445\u043E\u0440\u043E\u0448\u0438\u0439 \u0441\u0440\u043E\u043A \u0434\u043B\u044F
      \u043C\u0430\u043D\u0451\u0432\u0440\u0430. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0451\u043D\u043D\u043E\u0441\u0442\u044C
      \u0438 \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u043A\u043D\u0438\u0433\u0443.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B\u0430\u0441\u044C
      \u0432 \u0440\u0435\u0430\u043B\u044C\u043D\u0443\u044E \u0444\u0438\u043D\u0430\u043D\u0441\u043E\u0432\u0443\u044E
      \u0433\u0438\u0431\u043A\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859041
    m_Localized: "\u0412\u044B\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0441\u0440\u0430\u0437\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859042
    m_Localized: "\u0412\u044B \u043F\u043B\u0430\u0442\u0438\u0442\u0435 \u0441\u0435\u0439\u0447\u0430\u0441.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0434\u043E\u0432\u043E\u043B\u0435\u043D,
      \u0447\u0442\u043E \u043D\u0435 \u0436\u0434\u0451\u0442, - \u0441\u0442\u0430\u0432\u0438\u0442
      \u0433\u0430\u043B\u043E\u0447\u043A\u0443 \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0441\u043B\u043E\u0432. \u0414\u043E\u043B\u0433 \u0437\u0430\u043A\u0440\u044B\u0442,
      \u0441\u043E\u0432\u0435\u0441\u0442\u044C \u0447\u0438\u0441\u0442\u0430,
      \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u043B\u0443\u0447\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859043
    m_Localized: "\u041F\u0438\u0440 \u0443 \u0442\u0430\u043D\u0441\u043A\u043E\u0433\u043E
      \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859044
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0436\u0430\u0440\u0435\u043D\u043E\u0439
      \u0443\u0442\u043A\u0438 \u0438 \u0438\u043C\u0431\u0438\u0440\u043D\u043E\u0433\u043E
      \u0432\u0438\u043D\u0430. \u0421\u043B\u0443\u0433\u0430 \u0441 \u043A\u0440\u0430\u0441\u043D\u043E\u0439
      \u043B\u0435\u043D\u0442\u043E\u0439 \u043D\u0430 \u0448\u0430\u043F\u043A\u0435
      \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F \u0443 \u0432\u043E\u0440\u043E\u0442
      \u0438 \u0437\u0430\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442 \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435
      \u0432\u0441\u043B\u0443\u0445: \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440
      \u041B\u0438 \u042E\u0430\u043D\u044C-\u0446\u0437\u0438\u043D \u0437\u043E\u0432\u0451\u0442
      \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u043A\u0443\u043F\u0446\u0430
      \u043A \u0441\u0432\u043E\u0435\u043C\u0443 \u0441\u0442\u043E\u043B\u0443.
      \u0412 \u0437\u0430\u043B\u0435 - \u0448\u0451\u043B\u043A\u043E\u0432\u044B\u0435
      \u0437\u0430\u043D\u0430\u0432\u0435\u0441\u0438, \u043C\u0443\u0437\u044B\u043A\u0430\u043D\u0442\u044B
      \u0441 \u0433\u0443\u0446\u0438\u043D\u044F\u043C\u0438. \u0413\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043F\u043E-\u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438,
      \u043D\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0441
      \u0441 \u043D\u0435\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u043C\u044B\u043C
      \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u043C: <npc_speech lang=\"Chinese\">\u042F
      \u0441\u043B\u044B\u0448\u0430\u043B \u043E \u0442\u0435\u0431\u0435 \u043E\u0442
      \u0442\u0440\u0451\u0445 \u043A\u0443\u043F\u0446\u043E\u0432. \u0421\u0430\u0434\u0438\u0441\u044C.
      \u0412\u0438\u043D\u043E \u0438\u0437 \u041B\u043E\u044F\u043D\u0430.</npc_speech>
      \u041F\u0438\u0440 \u0443 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F
      \u043A \u043D\u0443\u0436\u043D\u044B\u043C \u043B\u044E\u0434\u044F\u043C
      - \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u0430\u043C, \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u0430\u043C,
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u043C \u043F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859045
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859046
    m_Localized: "\u0412\u0435\u0447\u0435\u0440 \u0443 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430
      - \u0435\u0434\u0430, \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u044B,
      \u043D\u0443\u0436\u043D\u044B\u0435 \u0437\u043D\u0430\u043A\u043E\u043C\u0441\u0442\u0432\u0430.
      \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441\u044B\u0442\u044B\u043C,
      \u0441 \u043F\u043E\u0434\u043D\u044F\u0442\u044B\u043C \u0434\u0443\u0445\u043E\u043C
      \u0438 \u0438\u043C\u0435\u043D\u0430\u043C\u0438 \u0442\u0440\u0451\u0445
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043F\u043E\u043C\u043E\u0433\u0443\u0442 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u043E\u043C \u043F\u043E\u0441\u0442\u0443.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u043A\u0430\u043A \u043A\u0430\u043F\u0438\u0442\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859047
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u043B\u043E\u043D\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859048
    m_Localized: "\u0412\u044B \u0441\u0441\u044B\u043B\u0430\u0435\u0442\u0435\u0441\u044C
      \u043D\u0430 \u0441\u043F\u0435\u0448\u043A\u0443. \u0413\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440
      \u043A\u0438\u0432\u0430\u0435\u0442 - \u0434\u0435\u043B\u043E\u0432\u043E\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043F\u043E\u0439\u043C\u0451\u0442
      \u0434\u0435\u043B\u043E\u0432\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.
      \u0421\u043B\u0443\u0433\u0430 \u043F\u0440\u043E\u0432\u043E\u0436\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C
      \u0438 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u043C \u0441\u0432\u0451\u0440\u0442\u043A\u043E\u043C
      \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0438 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859049
    m_Localized: "\u0411\u0438\u043B\u044C\u0433\u044D \u043F\u0440\u043E\u0441\u0438\u0442\u0441\u044F
      \u0432 \u043E\u0445\u0440\u0430\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859050
    m_Localized: "\u0423 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430 \u0436\u0434\u0451\u0442 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0439
      \u0432\u043E\u0438\u043D \u043B\u0435\u0442 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u0438
      \u043F\u044F\u0442\u0438 - \u0448\u0438\u0440\u043E\u043A\u0438\u0435 \u043F\u043B\u0435\u0447\u0438,
      \u043B\u0443\u043A \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439, \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u0434\u043E\u0441\u043F\u0435\u0445 \u0441 \u043D\u0430\u0448\u0438\u0442\u044B\u043C\u0438
      \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0430\u043C\u0438. \u041E\u043D
      \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0441\u0435\u0431\u044F \u0411\u0438\u043B\u044C\u0433\u044D
      \u0422\u0435\u0433\u0438\u043D \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E: <npc_speech lang=\"Turkic\">\u0422\u0432\u043E\u0451
      \u0438\u043C\u044F \u0437\u043D\u0430\u044E\u0442 \u043D\u0430 \u0442\u0440\u0451\u0445
      \u043F\u043E\u0441\u0442\u0430\u0445. \u042F \u0434\u0435\u0441\u044F\u0442\u044C
      \u043B\u0435\u0442 \u043E\u0445\u0440\u0430\u043D\u044F\u043B \u043E\u0431\u043E\u0437\u044B.
      \u0412\u043E\u0437\u044C\u043C\u0438 \u043C\u0435\u043D\u044F. \u0415\u043C
      \u043C\u0430\u043B\u043E, \u0434\u0435\u0440\u0443\u0441\u044C \u0445\u043E\u0440\u043E\u0448\u043E.</npc_speech>
      \u041E\u043F\u044B\u0442\u043D\u044B\u0439 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0439
      \u0432\u043E\u0438\u043D \u043D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u043F\u0443\u0442\u0438 - \u043D\u0435 \u043F\u0440\u043E\u0441\u0442\u043E
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A: \u043E\u043D \u0437\u043D\u0430\u0435\u0442
      \u043C\u0435\u0441\u0442\u043D\u044B\u0445 \u0432\u043E\u0436\u0434\u0435\u0439,
      \u0441\u0442\u0435\u043F\u043D\u044B\u0435 \u0442\u0440\u043E\u043F\u044B \u0438
      \u043A\u043E\u0433\u0434\u0430 \u043B\u0443\u0447\u0448\u0435 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859051
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0411\u0438\u043B\u044C\u0433\u044D
      \u0432 \u043E\u0445\u0440\u0430\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859052
    m_Localized: "\u0411\u0438\u043B\u044C\u0433\u044D \u0432\u0445\u043E\u0434\u0438\u0442
      \u0432 \u0441\u043E\u0441\u0442\u0430\u0432 \u043E\u0431\u043E\u0437\u0430.
      \u0415\u0433\u043E \u043F\u0440\u0438\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435
      \u043C\u0435\u043D\u044F\u0435\u0442 \u0442\u043E, \u043A\u0430\u043A \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0435
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438 \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u043D\u0430 \u0432\u0430\u0448 \u043E\u0431\u043E\u0437 - \u0441 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u043C
      \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u043A\u0443\u043F\u0446\u0430 \u043F\u0440\u0438\u0432\u043B\u0435\u043A\u043B\u0430
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0443\u0441\u0438\u043B\u0438\u0442 \u0435\u0451 \u0435\u0449\u0451 \u0431\u043E\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859053
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859054
    m_Localized: "\u0412\u044B \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442\u0435:
      \u0441\u043E\u0441\u0442\u0430\u0432 \u043F\u043E\u043B\u043D\u044B\u0439.
      \u0411\u0438\u043B\u044C\u0433\u044D \u043A\u0438\u0432\u0430\u0435\u0442 \u0431\u0435\u0437
      \u043E\u0431\u0438\u0434\u044B - \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439
      \u0432\u043E\u0438\u043D \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442 \u0445\u043E\u0437\u044F\u0439\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
      \u043B\u043E\u0433\u0438\u043A\u0443. \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0443 \u043B\u044E\u0434\u0435\u0439 \u0445\u043E\u0440\u043E\u0448\u0435\u0435
      - \u0437\u043D\u0430\u044E\u0442, \u0447\u0442\u043E \u0432\u043E\u0436\u0430\u043A
      \u0434\u0435\u0440\u0436\u0438\u0442 \u043E\u0431\u043E\u0437 \u0432 \u043F\u043E\u0440\u044F\u0434\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859055
    m_Localized: "\u0421\u043A\u0438\u0434\u043A\u0430 \u043E\u0442 \u0433\u0438\u043B\u044C\u0434\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859056
    m_Localized: "\u0413\u043B\u0430\u0432\u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0439
      \u0433\u0438\u043B\u044C\u0434\u0438\u0438 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      - \u043F\u043E\u043B\u043D\u044B\u0439 \u0441\u043E\u0433\u0434\u0438\u0435\u0446
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0438\u0431\u043D \u0411\u0430\u0445\u0440\u0430\u043C
      - \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0441
      \u043F\u043E\u0432\u0435\u0440\u0445 \u043E\u0447\u043A\u043E\u0432 \u0438\u0437
      \u0433\u043E\u0440\u043D\u043E\u0433\u043E \u0445\u0440\u0443\u0441\u0442\u0430\u043B\u044F.
      <npc_speech lang=\"Sogdian\">\u0422\u044B \u0442\u043E\u0440\u0433\u0443\u0435\u0448\u044C
      \u0447\u0435\u0441\u0442\u043D\u043E. \u041D\u0430\u043C \u0442\u0430\u043A\u0438\u0435
      \u043D\u0443\u0436\u043D\u044B. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
      \u043F\u0430\u0440\u0442\u0438\u044F \u0442\u043E\u0432\u0430\u0440\u0430 -
      \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432
      \u0441\u043A\u0438\u0434\u043A\u0438 \u043F\u043E \u043D\u0430\u0448\u0435\u043C\u0443
      \u043F\u0440\u0435\u0439\u0441\u043A\u0443\u0440\u0430\u043D\u0442\u0443. \u0421\u0432\u043E\u0438\u043C
      \u043A\u0443\u043F\u0446\u0430\u043C \u043C\u044B \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u043C
      \u0441\u0432\u043E\u0438\u043C.</npc_speech> \u0413\u0438\u043B\u044C\u0434\u0438\u0438
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0445 \u043A\u0443\u043F\u0446\u043E\u0432
      \u0434\u0435\u0440\u0436\u0430\u043B\u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435
      \u043F\u0443\u0442\u0438 \u0421\u0440\u0435\u0434\u043D\u0435\u0439 \u0410\u0437\u0438\u0438
      \u0432 VIII \u0432\u0435\u043A\u0435 - \u0438\u0445 \u0441\u043A\u0438\u0434\u043A\u0430
      \u0441\u0442\u043E\u0438\u0442 \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859057
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u043A\u0438\u0434\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859058
    m_Localized: "\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0438 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0437\u0430\u043A\u0443\u043F\u043A\u0435 - \u043F\u0440\u044F\u043C\u043E\u0439
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438.
      \u0413\u0438\u043B\u044C\u0434\u0438\u044F \u0432\u043D\u043E\u0441\u0438\u0442
      \u0432\u0430\u0448\u0435 \u0438\u043C\u044F \u0432 \u0441\u043F\u0438\u0441\u043E\u043A
      \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u0445 \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u043E\u0432:
      \u044D\u0442\u043E \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u0434\u0432\u0435\u0440\u0438
      \u0432 \u0434\u0440\u0443\u0433\u0438\u0445 \u0433\u043E\u0440\u043E\u0434\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859059
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
      \u043E \u0440\u044B\u043D\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859060
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0441\u043C\u0435\u0451\u0442\u0441\u044F
      - \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0437 \u0437\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0443.
      \u041E\u043D \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u043B\u0438\u0441\u0442\u043E\u043A
      \u0441 \u0446\u0435\u043D\u0430\u043C\u0438 \u0442\u0440\u0451\u0445 \u0433\u043E\u0440\u043E\u0434\u043E\u0432
      \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u0434\u0432\u0430
      \u043C\u0435\u0441\u044F\u0446\u0430. \u0422\u0430\u043A\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
      \u0438\u0437 \u043F\u0435\u0440\u0432\u044B\u0445 \u0440\u0443\u043A \u0441\u0442\u043E\u0438\u0442
      \u0434\u043E\u0440\u043E\u0436\u0435 \u0441\u043A\u0438\u0434\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859061
    m_Localized: "\u0422\u0430\u0439\u043D\u0430\u044F \u0442\u0440\u043E\u043F\u0430
      \u041D\u0430\u043D\u0430\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859062
    m_Localized: "\u041C\u0435\u0441\u0442\u043D\u044B\u0439 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u041D\u0430\u043D\u0430\u043C - \u043D\u0435\u0432\u044B\u0441\u043E\u043A\u0438\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0441 \u043E\u0431\u0432\u0435\u0442\u0440\u0435\u043D\u043D\u044B\u043C
      \u043B\u0438\u0446\u043E\u043C \u0438 \u0442\u0438\u0445\u0438\u043C \u0433\u043E\u043B\u043E\u0441\u043E\u043C
      - \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0432\u0430\u0441
      \u0443 \u0432\u043E\u0440\u043E\u0442 \u0434\u0435\u0440\u0435\u0432\u043D\u0438.
      \u041E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044F
      \u0432\u0437\u0433\u043B\u044F\u0434\u0430: <npc_speech lang=\"Tibetan\">\u042F
      \u0441\u043B\u044B\u0448\u0430\u043B \u043E \u0442\u0435\u0431\u0435. \u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439
      \u043F\u043E\u0441\u0442 \u043D\u0430 \u0433\u043B\u0430\u0432\u043D\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0435 \u0441\u0442\u043E\u0438\u0442 \u0442\u0440\u0443\u0434\u043D\u043E.
      \u0415\u0441\u0442\u044C \u0442\u0440\u043E\u043F\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0441\u0435\u0432\u0435\u0440\u043D\u044B\u0439 \u043E\u0442\u0440\u043E\u0433
      - \u043E\u0434\u0438\u043D \u0434\u0435\u043D\u044C, \u0438 \u0442\u044B \u0443\u0436\u0435
      \u043F\u043E \u0442\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443. \u041F\u043E\u043A\u0430\u0436\u0443
      \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u0431\u0435.</npc_speech>
      \u0422\u0430\u0439\u043D\u0430\u044F \u0442\u0440\u043E\u043F\u0430 \u0432
      \u043E\u0431\u0445\u043E\u0434 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u0433\u043E
      \u043F\u043E\u0441\u0442\u0430 - \u0437\u043E\u043B\u043E\u0442\u043E \u0434\u043B\u044F
      \u043A\u0443\u043F\u0446\u0430 \u0441 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0435\u0439:
      \u043C\u0435\u0441\u0442\u043D\u044B\u0435 \u0434\u043E\u0432\u0435\u0440\u044F\u044E\u0442
      \u0442\u0430\u043A\u0438\u0435 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B
      \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u0435\u043C, \u043A\u0442\u043E
      \u043D\u0435 \u0440\u0430\u0437\u0431\u0430\u043B\u0442\u044B\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859063
    m_Localized: "\u041F\u043E\u0439\u0442\u0438 \u043F\u043E \u0442\u0430\u0439\u043D\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859064
    m_Localized: "\u041D\u0430\u043D\u0430\u043C \u0432\u0435\u0434\u0451\u0442 \u043E\u0431\u043E\u0437
      \u043F\u043E \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u043C\u0443
      \u0441\u043A\u043B\u043E\u043D\u0443. \u0414\u0435\u043D\u044C \u0442\u0440\u0443\u0434\u043D\u044B\u0439,
      \u043D\u043E \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439. \u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439
      \u043F\u043E\u0441\u0442 \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043F\u043E\u0437\u0430\u0434\u0438,
      \u0431\u0435\u0437 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438 \u0438
      \u0431\u0435\u0437 \u0432\u0437\u044F\u0442\u043A\u0438. \u041E\u0434\u0438\u043D
      \u0434\u0435\u043D\u044C \u0432\u044B\u0438\u0433\u0440\u0430\u043D - \u0438
      \u0442\u0440\u043E\u043F\u0430 \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C
      \u0442\u0430\u0439\u043D\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859065
    m_Localized: "\u041F\u043E\u0435\u0445\u0430\u0442\u044C \u0433\u043B\u0430\u0432\u043D\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859066
    m_Localized: "\u0412\u044B \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u0435
      \u041D\u0430\u043D\u0430\u043C\u0430 \u0438 \u0435\u0434\u0435\u0442\u0435
      \u043F\u043E \u0442\u0440\u0430\u043A\u0442\u0443. \u0427\u0435\u0441\u0442\u043D\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430 - \u0447\u0435\u0441\u0442\u043D\u044B\u0435
      \u043F\u043E\u0448\u043B\u0438\u043D\u044B. \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0443 \u043B\u044E\u0434\u0435\u0439 \u0440\u043E\u0432\u043D\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859067
    m_Localized: "\u0420\u0435\u0434\u043A\u0430\u044F \u043A\u0430\u0440\u0442\u0430
      \u043E\u0442 \u0443\u0447\u0451\u043D\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859068
    m_Localized: "\u041F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439 \u0433\u0435\u043E\u0433\u0440\u0430\u0444
      \u0414\u0430\u0440\u0438\u0443\u0448 \u0438\u0431\u043D \u0420\u0443\u0441\u0442\u0430\u043C
      \u0434\u0435\u043B\u0430\u0435\u0442 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435
      \u043F\u0440\u0430\u0432\u043A\u0438 \u043D\u0430 \u043A\u0430\u0440\u0442\u0435
      \u0438\u0437 \u0432\u044B\u0434\u0435\u043B\u0430\u043D\u043D\u043E\u0439 \u0442\u0435\u043B\u044F\u0447\u044C\u0435\u0439
      \u043A\u043E\u0436\u0438. \u041E\u043D \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0433\u043E\u043B\u043E\u0432\u0443 \u0438 \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u043A\u0430\u0440\u0442\u0443 \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0438\u0441\u043B\u043E\u0432\u0438\u0439:
      <npc_speech lang=\"Persian\">\u042F \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B
      \u0435\u0451 \u0434\u0432\u0430 \u0433\u043E\u0434\u0430. \u0422\u044B - \u043A\u0443\u043F\u0435\u0446,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0447\u0438\u0442\u0430\u0435\u0442
      \u0434\u043E\u0440\u043E\u0433\u0438, \u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0440\u044B\u043D\u043A\u0438. \u0412\u043E\u0437\u044C\u043C\u0438. \u041E\u043D\u0430
      \u043D\u0430\u0439\u0434\u0451\u0442 \u043B\u0443\u0447\u0448\u0435\u0435 \u043F\u0440\u0438\u043C\u0435\u043D\u0435\u043D\u0438\u0435
      \u0432 \u0434\u043E\u0440\u043E\u0433\u0435.</npc_speech> \u041D\u0430 \u043A\u0430\u0440\u0442\u0435
      - \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u044B \u0447\u0435\u0440\u0435\u0437
      \u0425\u043E\u0440\u0430\u0441\u0430\u043D \u0441 \u043E\u0442\u043C\u0435\u0442\u043A\u0430\u043C\u0438
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u0432 \u0432\u043E\u0434\u044B
      \u0438 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0445 \u0434\u0432\u043E\u0440\u043E\u0432.
      \u0422\u0430\u043A\u0438\u0435 \u043A\u0430\u0440\u0442\u044B \u043D\u0435
      \u043F\u0440\u043E\u0434\u0430\u044E\u0442\u0441\u044F \u043D\u0430 \u0440\u044B\u043D\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859069
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043A\u0430\u0440\u0442\u0443
      \u0441 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859070
    m_Localized: "\u041A\u0430\u0440\u0442\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442
      \u043A \u0432\u0430\u043C. \u041E\u0442\u043C\u0435\u0442\u043A\u0438 \u0414\u0430\u0440\u0438\u0443\u0448\u0430
      \u0442\u043E\u0447\u043D\u044B - \u0432\u043E\u0434\u043D\u044B\u0435 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0438
      \u0442\u0430\u043C, \u0433\u0434\u0435 \u043E\u043D \u043D\u0430\u043F\u0438\u0441\u0430\u043B,
      \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0435 \u0434\u0432\u043E\u0440\u044B
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B. \u0420\u0435\u0434\u043A\u043E\u0435
      \u0437\u043D\u0430\u043D\u0438\u0435, \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u043E\u0435
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859071
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u0438 \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859072
    m_Localized: "\u0412\u044B \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442\u0435:
      \u043A\u0430\u0440\u0442\u0430 \u0434\u043E\u0440\u043E\u0436\u0435 \u0443
      \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442
      \u0440\u0430\u0431\u043E\u0442\u0443. \u0414\u0430\u0440\u0438\u0443\u0448
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0441 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u0435\u043C
      - \u043F\u043E\u0442\u043E\u043C \u0441 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C.
      \u0412\u044B \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u0441 \u0434\u043E\u0431\u0440\u044B\u043C
      \u0447\u0443\u0432\u0441\u0442\u0432\u043E\u043C \u0438 \u0431\u0435\u0437
      \u043B\u0438\u0448\u043D\u0435\u0439 \u0431\u0443\u043C\u0430\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859073
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u0441\u0435\u043A\u0440\u0435\u0442
      \u043E \u0446\u0435\u043D\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859074
    m_Localized: "\u041D\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u043E\u043C \u0432\u0435\u0447\u0435\u0440\u0435
      \u0443 \u0433\u0438\u043B\u044C\u0434\u0438\u0438 \u043A\u0443\u043F\u0435\u0446
      \u0438\u0437 \u0425\u043E\u0442\u0430\u043D\u0430 \u0431\u0435\u0440\u0451\u0442
      \u0432\u0430\u0441 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0438
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E: <npc_speech
      lang=\"Khotanese\">\u0412 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0435
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0434\u0435\u0444\u0438\u0446\u0438\u0442
      \u0448\u0451\u043B\u043A\u0430 - \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0435
      \u0434\u043E\u0440\u043E\u0433\u0438 \u0437\u0430\u043A\u0440\u044B\u0442\u044B
      \u0442\u0440\u0435\u0442\u0438\u0439 \u043C\u0435\u0441\u044F\u0446. \u0426\u0435\u043D\u0430
      \u0432\u0434\u0432\u043E\u0435 \u043F\u0440\u043E\u0442\u0438\u0432 \u043E\u0431\u044B\u0447\u043D\u043E\u0439.
      \u042D\u0442\u043E \u044F \u0433\u043E\u0432\u043E\u0440\u044E \u0442\u043E\u043B\u044C\u043A\u043E
      \u0442\u0435\u0431\u0435 - \u043F\u043E\u0442\u043E\u043C\u0443 \u0447\u0442\u043E
      \u0442\u044B \u043D\u0435 \u0438\u0437 \u0442\u0435\u0445, \u043A\u0442\u043E
      \u0441\u0440\u0430\u0437\u0443 \u0432\u0441\u0435\u043C \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442.</npc_speech>
      \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u043E \u0434\u0435\u0444\u0438\u0446\u0438\u0442\u0435
      - \u043F\u0440\u044F\u043C\u043E\u0435 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0435
      \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u043E. \u0414\u043E\u0432\u0435\u0440\u0438\u0435
      \u043A\u0443\u043F\u0446\u043E\u0432 \u0441\u0442\u0440\u043E\u0438\u0442\u0441\u044F
      \u043D\u0430 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859075
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859076
    m_Localized: "\u0412\u044B \u043C\u0435\u043D\u044F\u0435\u0442\u0435 \u043F\u043B\u0430\u043D
      \u0437\u0430\u043A\u0443\u043F\u043E\u043A. \u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
      \u0438\u0437 \u043F\u0435\u0440\u0432\u044B\u0445 \u0440\u0443\u043A \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u043D\u0430\u0432\u044B\u043A:
      \u0432\u044B \u0443\u0447\u0438\u0442\u0435\u0441\u044C \u0447\u0438\u0442\u0430\u0442\u044C
      \u0440\u044B\u043D\u043E\u043A \u0447\u0435\u0440\u0435\u0437 \u043B\u044E\u0434\u0435\u0439,
      \u0430 \u043D\u0435 \u0447\u0435\u0440\u0435\u0437 \u043F\u0440\u0435\u0439\u0441\u043A\u0443\u0440\u0430\u043D\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859077
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859078
    m_Localized: "\u0412\u044B \u043A\u0438\u0432\u0430\u0435\u0442\u0435 \u0438
      \u043C\u043E\u043B\u0447\u0438\u0442\u0435. \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0435
      \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435 \u0432 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C
      \u043A\u0440\u0443\u0433\u0443 - \u0438 \u043A\u0443\u043F\u0435\u0446 \u0438\u0437
      \u0425\u043E\u0442\u0430\u043D\u0430 \u044D\u0442\u043E \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442.
      \u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043C\u043E\u043D\u0435\u0442\u0430
      \u0437\u0430 \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0435 \u043D\u0435
      \u043D\u0443\u0436\u043D\u0430 - \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0441\u0430\u043C\u0430 \u0441\u0435\u0431\u044F \u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859079
    m_Localized: "\u041F\u043B\u0435\u043D\u043D\u044B\u0439 \u043B\u0430\u0437\u0443\u0442\u0447\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859080
    m_Localized: "\u0413\u043E\u0440\u044F\u0447\u0438\u0439 \u043F\u043E\u043B\u0434\u0435\u043D\u044C
      \u043D\u0430 \u0443\u0437\u043A\u043E\u043C \u0443\u0449\u0435\u043B\u044C\u0435.
      \u0412\u0430\u0448\u0438 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0441\u0445\u0432\u0430\u0442\u0438\u043B\u0438 \u0442\u044E\u0440\u043A\u0430
      - \u043C\u043E\u043B\u043E\u0434\u043E\u0439, \u0440\u044F\u0431\u043E\u0435
      \u043B\u0438\u0446\u043E, \u043F\u043E\u044F\u0441 \u0431\u0435\u0437 \u043E\u0440\u0443\u0436\u0438\u044F.
      \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0438\u0441\u043F\u043E\u0434\u043B\u043E\u0431\u044C\u044F,
      \u043A\u0440\u043E\u0432\u044C \u0437\u0430\u043F\u0435\u043A\u043B\u0430\u0441\u044C
      \u043D\u0430 \u0433\u0443\u0431\u0435. <npc_speech lang=\"Old_Turkic\">\u042F
      \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u0434\u043E\u0440\u043E\u0433\u0443. \u041D\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A.</npc_speech>
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0436\u0434\u0451\u0442 \u0432\u0430\u0448\u0435\u0433\u043E
      \u0441\u043B\u043E\u0432\u0430. \u041F\u0435\u0440\u0435\u0434\u0430\u0442\u044C
      \u0441\u0442\u0440\u0430\u0436\u0435 - \u0437\u043D\u0430\u0447\u0438\u0442
      \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C \u043F\u043E\u043B\u0434\u043D\u044F
      \u0438 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0437\u0430
      \u0434\u043E\u0441\u0442\u0430\u0432\u043A\u0443. \u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      - \u0437\u043D\u0430\u0447\u0438\u0442 \u0440\u0438\u0441\u043A\u043D\u0443\u0442\u044C.
      \u041F\u043E\u0434\u043E\u0431\u043D\u0430\u044F \u0432\u0441\u0442\u0440\u0435\u0447\u0430
      \u043D\u0430 \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C \u043F\u0443\u0442\u0438
      \u0431\u044B\u0432\u0430\u0435\u0442 \u0438 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435\u043C,
      \u0438 \u043B\u043E\u0432\u0443\u0448\u043A\u043E\u0439: \u0441\u0442\u0435\u043F\u043D\u044B\u0435
      \u043A\u043B\u0430\u043D\u044B \u043F\u043E\u043C\u043D\u044F\u0442 \u0434\u043E\u0431\u0440\u043E
      \u0438 \u043E\u0431\u0438\u0434\u044B \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E
      \u0434\u043E\u043B\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859081
    m_Localized: "\u041F\u0435\u0440\u0435\u0434\u0430\u0442\u044C \u0441\u0442\u0440\u0430\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859082
    m_Localized: "\u0421\u0442\u0440\u0430\u0436\u0430 \u0432\u0437\u044F\u043B\u0430
      \u0442\u044E\u0440\u043A\u0430 \u0431\u0435\u0437 \u0441\u043B\u043E\u0432
      - \u0438 \u0432\u044B\u0441\u0442\u0430\u0432\u0438\u043B\u0430 \u0441\u0447\u0451\u0442
      \u0437\u0430 \u043A\u043E\u043D\u0432\u043E\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0441\u043F\u043B\u044E\u043D\u0443\u043B
      \u043D\u0430 \u0437\u0435\u043C\u043B\u044E: \u043B\u0438\u0448\u043D\u0438\u0435
      \u043C\u043E\u043D\u0435\u0442\u044B, \u043B\u0438\u0448\u043D\u0438\u0435
      \u0447\u0430\u0441\u044B. \u0417\u0430\u0442\u043E \u0447\u0438\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859083
    m_Localized: "\u041E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0441 \u043C\u0438\u0440\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859084
    m_Localized: "\u0422\u044E\u0440\u043A \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F,
      \u043F\u043E\u0442\u0451\u0440 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u044F,
      \u043A\u0438\u0432\u043D\u0443\u043B - \u0438 \u0440\u0430\u0441\u0442\u0432\u043E\u0440\u0438\u043B\u0441\u044F
      \u0432 \u043A\u0430\u043C\u043D\u044F\u0445. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u043F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u043B. \u0427\u0442\u043E
      \u0438\u0437 \u044D\u0442\u043E\u0433\u043E \u0432\u044B\u0439\u0434\u0435\u0442
      - \u0443\u0437\u043D\u0430\u0435\u0442\u0435 \u0447\u0435\u0440\u0435\u0437
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859085
    m_Localized: "\u0412\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u0435
      \u0442\u044E\u0440\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859086
    m_Localized: "\u041D\u0430 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u0439 \u0441\u0442\u043E\u044F\u043D\u043A\u0435
      \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u0442\u043E\u0442 \u0441\u0430\u043C\u044B\u0439
      \u0440\u044F\u0431\u043E\u0439 \u0442\u044E\u0440\u043A - \u0442\u0435\u043F\u0435\u0440\u044C
      \u0441 \u0434\u0432\u0443\u043C\u044F \u043F\u0443\u0441\u0442\u044B\u043C\u0438
      \u0432\u044C\u044E\u043A\u0430\u043C\u0438 \u0438 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u043C.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u0438\u0441\u0445\u043E\u0434\u043E\u0432:
      \u0441 \u043C\u0438\u0440\u043E\u043C \u0438\u043B\u0438 \u0441 \u0434\u0440\u0430\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859087
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859088
    m_Localized: "\u0422\u044E\u0440\u043A \u043F\u0440\u0438\u0432\u0451\u043B \u0441\u0432\u043E\u0435\u0433\u043E
      \u0434\u044F\u0434\u044E - \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430
      - \u0438 \u043F\u0440\u0438\u043D\u0451\u0441 \u0432\u044F\u043B\u0435\u043D\u043E\u0435
      \u043C\u044F\u0441\u043E \u0438 \u043A\u0443\u0440\u0442. <npc_speech lang=\"Old_Turkic\">\u0414\u043E\u043B\u0433
      \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F.</npc_speech>
      \u0421\u0442\u0435\u043F\u043D\u043E\u0439 \u0437\u0430\u043A\u043E\u043D \u0447\u0435\u0441\u0442\u0438
      \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B: clan-\u043F\u0430\u043C\u044F\u0442\u044C
      \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0432\u044B\u0433\u043E\u0434\u044B
      \u043E\u0434\u043D\u043E\u0433\u043E \u0434\u043D\u044F. \u0414\u043E\u0440\u043E\u0433\u0430
      \u0434\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0431\u0440\u043E\u0434\u0430
      \u043F\u0440\u043E\u0439\u0434\u0451\u0442 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859089
    m_Localized: "\u041F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u043A \u0431\u043E\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859090
    m_Localized: "\u0422\u044E\u0440\u043A \u043F\u0440\u0438\u0448\u0451\u043B \u043D\u0435
      \u043E\u0434\u0438\u043D - \u0437\u0430 \u043D\u0438\u043C \u0435\u0449\u0451
      \u0442\u0440\u043E\u0435 \u0441 \u043B\u0443\u043A\u0430\u043C\u0438. \u0412\u044B
      \u0443\u0441\u043F\u0435\u043B\u0438 \u0432\u044B\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043E\u0445\u0440\u0430\u043D\u0443. \u041D\u0430\u043B\u0451\u0442 \u043E\u0431\u043E\u0448\u0451\u043B\u0441\u044F
      \u043F\u043E\u0442\u0435\u0440\u0435\u0439 \u043C\u043E\u043D\u0435\u0442 \u0438
      \u043D\u0435\u0440\u0432\u0430\u043C\u0438 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432.
      \u0421\u0442\u0435\u043F\u043D\u0430\u044F \u0449\u0435\u0434\u0440\u043E\u0441\u0442\u044C
      \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u043B\u043E\u0432\u0443\u0448\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859091
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859092
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u043A\u0438\u0441\u043B\u043E\u0439
      \u0440\u0432\u043E\u0442\u044B \u0440\u0430\u043D\u044C\u0448\u0435 \u0441\u0430\u043C\u043E\u0433\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430: \u0441\u043E\u0433\u0434\u0438\u0435\u0446
      \u043B\u0435\u0436\u0438\u0442 \u0432 \u0442\u0435\u043D\u0438 \u0447\u0430\u0445\u043B\u043E\u0433\u043E
      \u0442\u043E\u043F\u043E\u043B\u044F, \u0443\u043A\u0440\u044B\u0442 \u0441\u0442\u0430\u0440\u044B\u043C
      \u0445\u0443\u0440\u0434\u0436\u0443\u043D\u043E\u043C. \u041B\u0438\u0446\u043E
      \u0441\u0435\u0440\u043E\u0435, \u0433\u0443\u0431\u044B \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u0432\u0448\u0438\u0435\u0441\u044F.
      <npc_speech lang=\"Sogdian\">\u0421\u0430\u043C\u0435\u0445... \u0438\u0437
      \u041F\u0435\u043D\u0434\u0436\u0438\u043A\u0435\u043D\u0442\u0430. \u0422\u0440\u0438
      \u0434\u043D\u044F \u0431\u0435\u0437 \u0432\u043E\u0434\u044B. \u041F\u0440\u043E\u0448\u0443
      - \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0439\u0442\u0435.</npc_speech>
      \u041A\u0442\u043E-\u0442\u043E \u0443\u0436\u0435 \u043F\u0440\u043E\u0448\u0451\u043B
      \u043C\u0438\u043C\u043E - \u0432\u0438\u0434\u043D\u043E \u043F\u043E \u0441\u043B\u0435\u0434\u0430\u043C
      \u0441\u0430\u043F\u043E\u0433 \u0432 \u043F\u044B\u043B\u0438. \u041F\u043E\u043C\u043E\u0447\u044C
      - \u0437\u043D\u0430\u0447\u0438\u0442 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C
      \u043F\u0440\u0438\u043F\u0430\u0441\u044B \u0438 \u0437\u0430\u043C\u0435\u0434\u043B\u0438\u0442\u044C\u0441\u044F.
      \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0435 \u043A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u0438\u0435
      \u0441\u0435\u043C\u044C\u0438 - \u043F\u0430\u0443\u0442\u0438\u043D\u0430
      \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u043F\u0443\u0442\u0438: \u043F\u0435\u043D\u0434\u0436\u0438\u043A\u0435\u043D\u0442\u0441\u043A\u0438\u0439
      \u043A\u043B\u0430\u043D \u043F\u043E\u043C\u043D\u0438\u0442 \u0442\u0435\u0445,
      \u043A\u0442\u043E \u043F\u043E\u043C\u043E\u0433 \u0438\u0445 \u043B\u044E\u0434\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859093
    m_Localized: "\u041F\u043E\u043C\u043E\u0447\u044C \u0421\u0430\u043C\u0435\u0445\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859094
    m_Localized: "\u0412\u044B \u043E\u0442\u0434\u0430\u043B\u0438 \u0432\u043E\u0434\u0443,
      \u0435\u0434\u0443 \u0438 \u0447\u0430\u0441 \u0441\u0442\u043E\u044F\u043D\u043A\u0438.
      \u0421\u0430\u043C\u0435\u0445 \u0432\u044B\u043F\u0438\u043B \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E,
      \u043D\u0435 \u0440\u0430\u0441\u043F\u043B\u0435\u0441\u043A\u0430\u0432 \u043D\u0438
      \u043A\u0430\u043F\u043B\u0438 - \u0443\u043C\u0435\u0435\u0442 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C.
      \u0412\u0441\u0442\u0430\u043D\u0435\u0442 \u043B\u0438 \u043D\u0430 \u043D\u043E\u0433\u0438
      - \u043F\u043E\u043A\u0430\u0436\u0443\u0442 \u0434\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859095
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859096
    m_Localized: "\u0412\u044B \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u044B. \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u0442\u0440\u0430\u043A\u0442 \u0434\u043B\u0438\u043D\u043D\u044B\u0439 -
      \u0438 \u043C\u043E\u043B\u0432\u0430 \u043F\u043E \u043D\u0435\u043C\u0443
      \u0445\u043E\u0434\u0438\u0442 \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859097
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u043E\u0442 \u0421\u0430\u043C\u0435\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859098
    m_Localized: "\u0413\u043E\u043D\u0435\u0446 \u043D\u0430\u0441\u0442\u0438\u0433\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0443 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043A\u043E\u043B\u043E\u0434\u0446\u0430 \u0441 \u043A\u043E\u0436\u0430\u043D\u044B\u043C
      \u043A\u0438\u0441\u0435\u0442\u043E\u043C \u0432 \u0440\u0443\u043A\u0435.
      \u0414\u0432\u0430 \u0438\u0441\u0445\u043E\u0434\u0430 - \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438
      \u043E\u0442 \u0432\u043E\u043B\u0438 \u0421\u0430\u043C\u0435\u0445\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859099
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0431\u0430\u043A\u0448\u0438\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859100
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u0432\u044B\u0436\u0438\u043B.
      \u0412 \u043A\u0438\u0441\u0435\u0442\u0435 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0438 \u043F\u043E\u043B\u043E\u0441\u043A\u0430
      \u043A\u043E\u0436\u0438 \u0441 \u0442\u0438\u0441\u043D\u0435\u043D\u0438\u0435\u043C
      \u043F\u0435\u043D\u0434\u0436\u0438\u043A\u0435\u043D\u0442\u0441\u043A\u043E\u0439
      \u0442\u0430\u043C\u0433\u0438: \u0437\u043D\u0430\u043A, \u0447\u0442\u043E
      \u0432 \u043B\u044E\u0431\u043E\u0439 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0439
      \u0444\u0430\u043A\u0442\u043E\u0440\u0438\u0439 \u0432\u0430\u0441 \u043F\u0440\u0438\u043C\u0443\u0442
      \u043A\u0430\u043A \u0441\u0432\u043E\u0435\u0433\u043E. \u0425\u043E\u0440\u043E\u0448\u0435\u0435
      \u0432\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0442\u0440\u0451\u0445 \u0447\u0430\u0441\u043E\u0432
      \u0438 \u0444\u043B\u0430\u043A\u043E\u043D\u0430 \u0432\u043E\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859101
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0432\u0435\u0441\u0442\u044C
      \u0441\u043E \u0441\u043A\u043E\u0440\u0431\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859102
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u0443\u043C\u0435\u0440 \u043D\u0430
      \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439 \u0434\u0435\u043D\u044C.
      \u0413\u043E\u043D\u0435\u0446 - \u0435\u0433\u043E \u043F\u043B\u0435\u043C\u044F\u043D\u043D\u0438\u043A
      - \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F \u0434\u043E \u0437\u0435\u043C\u043B\u0438
      \u0438 \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u043C\u0435\u0434\u043D\u044B\u0439 \u0438\u0434\u043E\u043B-\u043E\u0431\u0435\u0440\u0435\u0433:
      \u0432\u0441\u0451, \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C.
      \u041F\u0435\u043D\u0434\u0436\u0438\u043A\u0435\u043D\u0442\u0441\u043A\u0430\u044F
      \u0441\u0435\u043C\u044C\u044F \u043D\u0435 \u0437\u0430\u0431\u044B\u0432\u0430\u0435\u0442
      \u0434\u043E\u0431\u0440\u0430, \u0434\u0430\u0436\u0435 \u0435\u0441\u043B\u0438
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u0435\u0433\u043E \u043E\u043F\u043B\u0430\u0442\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859103
    m_Localized: "\u041A\u0430\u0440\u0442\u0430 \u043C\u043E\u043D\u0430\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859104
    m_Localized: "\u0411\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u043C\u043E\u043D\u0430\u0445
      \u0441\u0438\u0434\u0438\u0442 \u0443 \u043E\u0431\u043E\u0447\u0438\u043D\u044B
      \u043D\u0430\u0434 \u043A\u0443\u0441\u043A\u043E\u043C \u0431\u0435\u0440\u0451\u0441\u0442\u044B,
      \u0447\u0435\u0440\u0442\u0438\u0442 \u0443\u0433\u043B\u0451\u043C. \u0417\u0430\u043C\u0435\u0447\u0430\u0435\u0442
      \u0432\u0430\u0441, \u043F\u0440\u044F\u0447\u0435\u0442 \u0431\u0435\u0440\u0435\u0441\u0442\u0443
      - \u043F\u043E\u0442\u043E\u043C \u043F\u0435\u0440\u0435\u0434\u0443\u043C\u044B\u0432\u0430\u0435\u0442.
      <npc_speech lang=\"Sogdian\">\u0421\u0442\u0430\u0440\u0430\u044F \u043A\u0443\u0448\u0430\u043D\u0441\u043A\u0430\u044F
      \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0430. \u042F \u0432\u0438\u0434\u0435\u043B
      \u0435\u0451 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442
      \u043D\u0430\u0437\u0430\u0434 - \u043A \u0437\u0430\u043F\u0430\u0434\u0443
      \u043E\u0442 \u0431\u0440\u043E\u0434\u0430 \u0410\u043A-\u0414\u0430\u0440\u044C\u044F,
      \u0437\u0430 \u0442\u0440\u0435\u043C\u044F \u0447\u0451\u0440\u043D\u044B\u043C\u0438
      \u0441\u043A\u0430\u043B\u0430\u043C\u0438. \u0422\u0430\u043C \u0434\u043E\u043B\u0436\u043D\u044B
      \u0431\u044B\u0442\u044C \u043C\u043E\u043D\u0435\u0442\u044B. \u042F \u043C\u043E\u043D\u0430\u0445
      - \u043C\u043D\u0435 \u043D\u0435 \u043D\u0443\u0436\u043D\u043E. \u0412\u0430\u043C,
      \u043C\u043E\u0436\u0435\u0442, \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F.</npc_speech>
      \u041C\u043E\u043D\u0430\u0445 \u0440\u0438\u0441\u0443\u0435\u0442 \u0431\u0435\u0437
      \u043A\u043E\u043B\u0435\u0431\u0430\u043D\u0438\u0439 - \u0437\u043D\u0430\u0447\u0438\u0442,
      \u043B\u0438\u0431\u043E \u0431\u0435\u0441\u043A\u043E\u0440\u044B\u0441\u0442\u0435\u043D,
      \u043B\u0438\u0431\u043E \u0443\u0436\u0435 \u043F\u043E\u0436\u0430\u043B\u0435\u043B
      \u043E \u043D\u0430\u0445\u043E\u0434\u043A\u0435. \u041A\u0440\u044E\u043A
      \u043A \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0435 \u0437\u0430\u0439\u043C\u0451\u0442
      \u0434\u0435\u043D\u044C. \u041D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u043F\u0443\u0442\u0438 \u043A\u0443\u0448\u0430\u043D\u0441\u043A\u0438\u0435
      \u043A\u043B\u0430\u0434\u044B \u043D\u0430\u0445\u043E\u0434\u044F\u0442 \u0440\u0430\u0437
      \u0432 \u0436\u0438\u0437\u043D\u0438 - \u0438 \u0442\u0430\u043A \u0436\u0435
      \u0447\u0430\u0441\u0442\u043E \u0443\u043F\u0443\u0441\u043A\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859105
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u043C\u043E\u043D\u0430\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859106
    m_Localized: "\u041A\u0430\u0440\u0442\u0443 \u0432\u0437\u044F\u043B\u0438.
      \u041C\u043E\u0436\u0435\u0442, \u043F\u0440\u0438\u0433\u043E\u0434\u0438\u0442\u0441\u044F.
      \u041C\u043E\u043D\u0430\u0445 \u043A\u0438\u0432\u043D\u0443\u043B \u0438
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043A \u0441\u043E\u0437\u0435\u0440\u0446\u0430\u043D\u0438\u044E
      - \u0435\u043C\u0443 \u0432\u0430\u0436\u0435\u043D \u0431\u044B\u043B \u0441\u0430\u043C
      \u0436\u0435\u0441\u0442, \u0430 \u043D\u0435 \u0432\u0430\u0448\u0435 \u0440\u0435\u0448\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859107
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C\u0441\u044F
      \u043A \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859108
    m_Localized: "\u0412\u044B \u0441\u0432\u0435\u0440\u043D\u0443\u043B\u0438 \u043A
      \u0410\u043A-\u0414\u0430\u0440\u044C\u0435. \u0414\u0435\u043D\u044C \u0432
      \u043F\u0443\u0442\u0438 \u043F\u043E \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435 - \u0438 \u0443 \u0442\u0440\u0451\u0445 \u0447\u0451\u0440\u043D\u044B\u0445
      \u0441\u043A\u0430\u043B \u043D\u0430\u0448\u043B\u0438 \u0432\u0445\u043E\u0434
      \u0432 \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0443. \u041D\u043E \u0447\u044C\u0438-\u0442\u043E
      \u0441\u043B\u0435\u0434\u044B \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0442\u0430\u043C \u0440\u0430\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859109
    m_Localized: "\u0420\u0430\u0437\u0433\u0440\u0430\u0431\u043B\u0435\u043D\u043D\u0430\u044F
      \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859110
    m_Localized: "\u0412\u0445\u043E\u0434 \u0432 \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0443
      \u0432\u0437\u043B\u043E\u043C\u0430\u043D \u0434\u0430\u0432\u043D\u043E -
      \u0437\u0435\u043C\u043B\u044F \u0432\u043E\u043A\u0440\u0443\u0433 \u0441\u043B\u0435\u0436\u0430\u043B\u0430\u0441\u044C.
      \u0412\u043D\u0443\u0442\u0440\u0438 \u043F\u044B\u043B\u044C\u043D\u043E \u0438
      \u043F\u0443\u0441\u0442\u043E: \u043A\u0443\u0448\u0430\u043D\u0441\u043A\u0438\u0435
      \u043D\u0438\u0448\u0435\u0432\u044B\u0435 \u043F\u043E\u0433\u0440\u0435\u0431\u0435\u043D\u0438\u044F,
      \u0447\u0435\u0440\u0435\u043F\u043A\u0438, \u043D\u0438 \u0435\u0434\u0438\u043D\u043E\u0439
      \u043C\u043E\u043D\u0435\u0442\u044B. \u041A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442
      \u0443\u0441\u043F\u0435\u043B \u0440\u0430\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859111
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0433\u0440\u043E\u0431\u043D\u0438\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859112
    m_Localized: "\u0412\u044B \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442\u0435
      \u043A\u0430\u0436\u0434\u0443\u044E \u043D\u0438\u0448\u0443. \u041C\u043E\u043D\u0435\u0442\u044B
      \u0432\u0437\u044F\u0442\u044B, \u043D\u043E \u0432 \u0434\u0430\u043B\u044C\u043D\u0435\u043C
      \u0443\u0433\u043B\u0443 \u0432\u0430\u043B\u044F\u0435\u0442\u0441\u044F \u043A\u0443\u0441\u043E\u043A
      \u043A\u0443\u0448\u0430\u043D\u0441\u043A\u043E\u0439 \u0442\u0435\u0440\u0440\u0430\u043A\u043E\u0442\u044B
      - \u0433\u043E\u043B\u043E\u0432\u0430 \u0411\u0443\u0434\u0434\u044B \u0441
      \u043F\u043E\u0437\u043E\u043B\u043E\u0442\u043E\u0439. \u041D\u0435\u0432\u0435\u043B\u0438\u043A
      \u043A\u043B\u0430\u0434, \u0437\u0430\u0442\u043E \u0441\u0432\u043E\u0439.
      \u0414\u0435\u043D\u044C \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D,
      \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u043F\u043E\u0434\u043E\u0440\u0432\u0430\u043D\u043E
      - \u043D\u043E \u0443\u0434\u0430\u0447\u0430 \u043B\u044E\u0431\u0438\u0442
      \u043D\u0430\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859113
    m_Localized: "\u041F\u043E\u043F\u0443\u0442\u0447\u0438\u043A \u0431\u0435\u0437
      \u0438\u043C\u0435\u043D\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859114
    m_Localized: "\u041D\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u043C
      \u0434\u0432\u043E\u0440\u0435 \u0432 \u041C\u0435\u0440\u0432\u0435 \u043A
      \u0432\u0430\u043C \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      - \u0441\u043C\u0443\u0433\u043B\u044B\u0439, \u0432 \u043F\u044B\u043B\u044C\u043D\u043E\u043C
      \u043A\u0430\u0444\u0442\u0430\u043D\u0435, \u0441 \u0442\u044E\u043A\u043E\u043C
      \u043D\u0430 \u0441\u043F\u0438\u043D\u0435. <npc_speech lang=\"Sogdian\">\u041E\u0434\u0438\u043D,
      \u0438\u0434\u0443 \u0432 \u041D\u0438\u0448\u0430\u043F\u0443\u0440. \u041C\u043E\u0433\u0443
      \u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0435\u0434\u043E\u0439. \u041E\u0445\u0440\u0430\u043D\u044F\u0442\u044C,
      \u043F\u043E\u043C\u043E\u0433\u0430\u0442\u044C - \u0432\u0441\u0451 \u0447\u0442\u043E
      \u0441\u043A\u0430\u0436\u0435\u0442\u0435.</npc_speech> \u0412\u0437\u0433\u043B\u044F\u0434
      \u0431\u0435\u0433\u0430\u0435\u0442. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0448\u0451\u043F\u043E\u0442\u043E\u043C: \xAB\u041E\u0434\u0438\u043D\u043E\u0447\u043A\u0438
      \u0431\u0435\u0437 \u0438\u043C\u0435\u043D\u0438 \u043D\u0435 \u0431\u044B\u0432\u0430\u044E\u0442
      \u043F\u0440\u043E\u0441\u0442\u043E \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0430\u043C\u0438\xBB.
      \u0412\u0437\u044F\u0442\u044C \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A\u0430
      - \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0442\u044C \u043D\u0430
      \u043E\u0445\u0440\u0430\u043D\u0435 \u0438 \u0435\u0434\u0435. \u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C
      - \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432\u0440\u0435\u043C\u044F \u043D\u0430 \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u044F.
      \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439 \u043F\u0443\u0442\u044C \u043F\u043E\u043B\u043E\u043D
      \u0442\u0435\u043C\u0438, \u043A\u0442\u043E \u043F\u0440\u044F\u0447\u0435\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859115
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859116
    m_Localized: "\u0427\u0435\u043B\u043E\u0432\u0435\u043A \u043F\u043E\u0436\u0430\u043B
      \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438 \u0438\u0441\u0447\u0435\u0437
      \u0437\u0430 \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B. \u0421\u043F\u043E\u043A\u043E\u0439\u043D\u0430\u044F
      \u043D\u043E\u0447\u044C \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0436\u0435
      \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u043B\u0435\u043D\u043D\u043E\u0439
      \u0433\u043E\u0440\u0441\u0442\u0438 \u0441\u0443\u0448\u0451\u043D\u043E\u0433\u043E
      \u0438\u0437\u044E\u043C\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859117
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859118
    m_Localized: "\u041F\u043E\u043F\u0443\u0442\u0447\u0438\u043A \u0438\u0434\u0451\u0442
      \u043C\u043E\u043B\u0447\u0430, \u0434\u0435\u0440\u0436\u0438\u0442\u0441\u044F
      \u0432 \u0445\u0432\u043E\u0441\u0442\u0435 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430.
      \u0415\u0441\u0442 \u043C\u0430\u043B\u043E, \u0441\u043F\u0438\u0442 \u0443
      \u043A\u043E\u043B\u0435\u0441\u0430. \u0427\u0442\u043E \u0431\u0443\u0434\u0435\u0442
      \u043D\u043E\u0447\u044C\u044E - \u0443\u0437\u043D\u0430\u0435\u0442\u0435
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859119
    m_Localized: "\u041F\u043E\u043F\u0443\u0442\u0447\u0438\u043A \u043F\u043E\u043A\u0430\u0437\u0430\u043B
      \u0441\u0435\u0431\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859120
    m_Localized: "\u0422\u0440\u0435\u0442\u044C\u044F \u043D\u043E\u0447\u044C \u0432
      \u043F\u0443\u0442\u0438. \u041E\u0434\u0438\u043D \u0438\u0437 \u0434\u0432\u0443\u0445
      \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u044B\u0445 \u0438\u0441\u0445\u043E\u0434\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859121
    m_Localized: "\u0423\u0442\u0440\u043E \u043F\u043E\u0441\u043B\u0435 \u043A\u0440\u0430\u0436\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859122
    m_Localized: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435 \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u0442\u0440\u044F\u0441\u0451\u0442 \u0432\u0430\u0441 \u0437\u0430 \u043F\u043B\u0435\u0447\u043E:
      \u043A\u043E\u0448\u0435\u043B\u0451\u043A \u0441 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C\u044E
      \u0434\u0438\u0440\u0445\u0430\u043C\u0430\u043C\u0438 \u0441\u0440\u0435\u0437\u0430\u043D
      \u0441 \u043F\u043E\u044F\u0441\u0430, \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A
      \u0438\u0441\u0447\u0435\u0437. \u0421\u043B\u0435\u0434\u044B \u0432\u0435\u0434\u0443\u0442
      \u043A \u0441\u0443\u0445\u043E\u043C\u0443 \u0440\u0443\u0441\u043B\u0443.
      \u0425\u043E\u0440\u043E\u0448\u043E \u0445\u043E\u0442\u044C \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
      \u0433\u0440\u0443\u0437 \u0446\u0435\u043B - \u043E\u043D \u0438\u0441\u043A\u0430\u043B
      \u043B\u0451\u0433\u043A\u0438\u0435 \u0434\u0435\u043D\u044C\u0433\u0438,
      \u043D\u0435 \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u043B \u0441 \u0442\u044E\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859123
    m_Localized: "\u0417\u0430\u0441\u0430\u0434\u0430 - \u0438 \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A
      \u0441\u043F\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859124
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u043D\u0430 \u043B\u0430\u0433\u0435\u0440\u044C
      \u0432\u044B\u0448\u043B\u0438 \u0442\u0440\u043E\u0435 \u0441 \u0434\u0443\u0431\u0438\u043D\u0430\u043C\u0438.
      \u041F\u043E\u043F\u0443\u0442\u0447\u0438\u043A \u0437\u0430\u043A\u0440\u0438\u0447\u0430\u043B
      \u0440\u0430\u043D\u044C\u0448\u0435 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430
      - \u0443\u0441\u043F\u0435\u043B\u0438 \u043F\u043E\u0434\u043D\u044F\u0442\u044C
      \u043B\u044E\u0434\u0435\u0439. \u041D\u0430\u043F\u0430\u0434\u0430\u0432\u0448\u0438\u0435
      \u0431\u0435\u0436\u0430\u043B\u0438. \u0423\u0442\u0440\u043E\u043C \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A
      \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B: <npc_speech lang=\"Sogdian\">\u042F
      \u0441\u0430\u043C \u0431\u044B\u043B \u0438\u0437 \u0442\u0430\u043A\u0438\u0445.
      \u0422\u0435\u043F\u0435\u0440\u044C \u043D\u0435\u0442.</npc_speech> \u0415\u0433\u043E
      \u0434\u043E\u043B\u0433 \u043E\u043F\u043B\u0430\u0447\u0435\u043D - \u043C\u043E\u0436\u0435\u0442\u0435
      \u0440\u0430\u0441\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u0431\u0435\u0437
      \u043E\u0431\u0438\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859125
    m_Localized: "\u0410\u043A\u043A\u0440\u0435\u0434\u0438\u0442\u0438\u0432 \u042E\u0441\u0443\u0444\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859126
    m_Localized: "\u0410\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u0438\u0439
      \u0431\u0430\u043D\u043A\u0438\u0440\u0441\u043A\u0438\u0439 \u0434\u043E\u043C
      \u0432 \u0411\u0430\u0433\u0434\u0430\u0434\u0435 - \u043C\u0440\u0430\u043C\u043E\u0440\u043D\u044B\u0439
      \u043F\u043E\u043B, \u0437\u0430\u043F\u0430\u0445 \u043A\u0435\u0434\u0440\u043E\u0432\u044B\u0445
      \u0447\u0435\u0440\u043D\u0438\u043B. \u042E\u0441\u0443\u0444 \u0438\u0431\u043D
      \u0420\u0430\u0448\u0438\u0434, \u043F\u043B\u043E\u0442\u043D\u044B\u0439
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0441 \u0447\u0435\u0440\u043D\u0438\u043B\u044C\u043D\u044B\u043C
      \u043F\u044F\u0442\u043D\u043E\u043C \u043D\u0430 \u043F\u0430\u043B\u044C\u0446\u0430\u0445,
      \u043A\u043B\u0430\u0434\u0451\u0442 \u043F\u0435\u0440\u0435\u0434 \u0432\u0430\u043C\u0438
      \u0441\u0432\u0438\u0442\u043E\u043A. <npc_speech lang=\"Arabic\">\u0421\u0442\u043E
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u043F\u043E\u0434 \u0447\u0435\u0441\u0442\u043D\u043E\u0435
      \u0441\u043B\u043E\u0432\u043E \u043A\u0443\u043F\u0446\u0430. \u0412\u043E\u0437\u0432\u0440\u0430\u0442
      \u0432 \u043B\u044E\u0431\u043E\u043C \u0438\u0437 \u043D\u0430\u0448\u0438\u0445
      \u0434\u043E\u043C\u043E\u0432 - \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435,
      \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0435, \u041C\u0435\u0440\u0432\u0435.
      \u041A\u043E\u043C\u0438\u0441\u0441\u0438\u044F \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u043D\u0430\u044F.</npc_speech>
      \u0410\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u0430\u044F \u0441\u0438\u0441\u0442\u0435\u043C\u0430
      \u0445\u0430\u0432\u0430\u043B\u0430 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
      \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C \u0431\u0435\u0437 \u043F\u0435\u0440\u0435\u0432\u043E\u0437\u043A\u0438
      \u0441\u0435\u0440\u0435\u0431\u0440\u0430 - \u0443\u0434\u043E\u0431\u0441\u0442\u0432\u043E,
      \u0437\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043F\u043B\u0430\u0442\u044F\u0442
      \u0434\u043E\u0432\u0435\u0440\u0438\u0435\u043C. \u0414\u0435\u043D\u044C\u0433\u0438
      \u043D\u0443\u0436\u043D\u044B \u0441\u0435\u0439\u0447\u0430\u0441: \u0437\u0430\u043A\u0443\u043F\u0438\u0442\u044C
      \u0442\u043E\u0432\u0430\u0440 \u043F\u043E \u0445\u043E\u0440\u043E\u0448\u0435\u0439
      \u0446\u0435\u043D\u0435 \u0432 \u0411\u0430\u0433\u0434\u0430\u0434\u0435
      \u0438\u043B\u0438 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F \u0441
      \u0442\u0435\u043C, \u0447\u0442\u043E \u0435\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859127
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0430\u043A\u043A\u0440\u0435\u0434\u0438\u0442\u0438\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859128
    m_Localized: "\u042E\u0441\u0443\u0444 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u043F\u0435\u0447\u0430\u0442\u044C. \u0421\u0442\u043E \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0437\u0430\u043F\u0438\u0441\u0430\u043D\u044B \u043D\u0430 \u0432\u0430\u0448
      \u0441\u0447\u0451\u0442 - \u0438 \u0432\u0430\u0448 \u0434\u043E\u043B\u0433
      \u0442\u043E\u0436\u0435. \u0427\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043D\u0435\u0434\u0435\u043B\u044C \u042E\u0441\u0443\u0444 \u0441\u043D\u043E\u0432\u0430
      \u0432\u044B\u0439\u0434\u0435\u0442 \u043D\u0430 \u0432\u0430\u0448\u0443
      \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859129
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043E\u0442
      \u0434\u043E\u043B\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859130
    m_Localized: "\u0412\u044B \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B\u0438
      \u0438 \u043E\u0442\u043A\u043B\u0430\u043D\u044F\u043B\u0438\u0441\u044C.
      \u042E\u0441\u0443\u0444 \u0443\u0431\u0440\u0430\u043B \u0441\u0432\u0438\u0442\u043E\u043A
      \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B - \u043E\u043D \u0441\u043B\u044B\u0448\u0430\u043B
      \u043E\u0442\u043A\u0430\u0437\u044B \u0438 \u043F\u043E\u0432\u0430\u0436\u043D\u0435\u0435.
      \u0411\u0435\u0437 \u0434\u043E\u043B\u0433\u0430 - \u0431\u0435\u0437 \u0440\u0438\u0441\u043A\u0430,
      \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445 \u043C\u043E\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859131
    m_Localized: "\u042E\u0441\u0443\u0444 \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859132
    m_Localized: "\u041D\u0430 \u0441\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0441\u043A\u043E\u043C
      \u0431\u0430\u0437\u0430\u0440\u0435 \u0443 \u043B\u0430\u0432\u043A\u0438
      \u043C\u0435\u043D\u044F\u043B\u044B \u0441\u0442\u043E\u0438\u0442 \u0437\u043D\u0430\u043A\u043E\u043C\u0430\u044F
      \u0444\u0438\u0433\u0443\u0440\u0430. \u042E\u0441\u0443\u0444 \u0437\u0430\u043C\u0435\u0442\u0438\u043B
      \u0432\u0430\u0441 \u043F\u0435\u0440\u0432\u044B\u043C \u0438 \u0448\u0438\u0440\u043E\u043A\u043E
      \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F. <npc_speech lang=\"Arabic\">\u0414\u043E\u0440\u043E\u0433\u043E\u0439
      \u0434\u0440\u0443\u0433. \u0421\u0442\u043E \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      - \u0438 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0441\u0432\u0435\u0440\u0445\u0443.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u0431\u044B\u043B\u0430 \u0434\u043E\u043B\u0433\u043E\u0439,
      \u0446\u0435\u043D\u044B \u0432\u044B\u0440\u043E\u0441\u043B\u0438. \u0422\u0430\u043A
      \u043F\u0440\u0438\u043D\u044F\u0442\u043E.</npc_speech> \u0410\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u0430\u044F
      \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u044F \u0437\u0430 \u0445\u0430\u0432\u0430\u043B\u0443
      - \u0440\u0435\u0430\u043B\u044C\u043D\u0430\u044F \u043F\u0440\u0430\u043A\u0442\u0438\u043A\u0430
      IX \u0432\u0435\u043A\u0430: \u043E\u0442 \u043F\u044F\u0442\u0438 \u0434\u043E
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432.
      \u0421\u043F\u043E\u0440\u0438\u0442\u044C \u0437\u043D\u0430\u0447\u0438\u0442
      \u043F\u043E\u0440\u0442\u0438\u0442\u044C \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044E
      \u0432 \u0431\u0430\u043D\u043A\u0438\u0440\u0441\u043A\u043E\u043C \u043A\u0440\u0443\u0433\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859133
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u0434\u043E\u043B\u0433 \u0441
      \u043A\u043E\u043C\u0438\u0441\u0441\u0438\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859134
    m_Localized: "\u0412\u044B \u043E\u0442\u0441\u0447\u0438\u0442\u0430\u043B\u0438
      \u0441\u0442\u043E \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432. \u042E\u0441\u0443\u0444
      \u0440\u0430\u0441\u043F\u0438\u0441\u0430\u043B\u0441\u044F \u0432 \u0441\u0432\u0438\u0442\u043A\u0435
      \u0438 \u043F\u043E\u0436\u0430\u043B \u0432\u0430\u0448\u0443 \u0440\u0443\u043A\u0443
      \u043E\u0431\u0435\u0438\u043C\u0438 \u0441\u0432\u043E\u0438\u043C\u0438.
      \u0425\u0430\u0432\u0430\u043B\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u0430
      - \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0447\u0438\u0441\u0442\u0430.
      \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0440\u0430\u0437
      \u043E\u043D \u0434\u0430\u0441\u0442 \u043B\u0443\u0447\u0448\u0443\u044E
      \u0441\u0442\u0430\u0432\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859135
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043F\u043B\u0430\u0442\u0438\u0442\u044C
      \u0441\u0432\u0435\u0440\u0445\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859136
    m_Localized: "\u042E\u0441\u0443\u0444 \u043F\u043E\u0434\u0436\u0430\u043B \u0433\u0443\u0431\u044B.
      \u0421\u043B\u043E\u0432\u043E \u043E \u0432\u0430\u0448\u0435\u0439 \u043D\u0435\u0441\u0433\u043E\u0432\u043E\u0440\u0447\u0438\u0432\u043E\u0441\u0442\u0438
      \u0440\u0430\u0437\u043E\u0439\u0434\u0451\u0442\u0441\u044F \u043F\u043E \u0431\u0430\u043D\u043A\u0438\u0440\u0441\u043A\u0438\u043C
      \u0434\u043E\u043C\u0430\u043C \u043E\u0442 \u041C\u0435\u0440\u0432\u0430
      \u0434\u043E \u0410\u043D\u0442\u0438\u043E\u0445\u0438\u0438. \u0414\u043E\u043B\u0433
      \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u043E\u0442\u0434\u0430\u0442\u044C - \u0447\u0435\u0440\u0435\u0437 \u0441\u0443\u0434
      \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0433\u043E \u043A\u0430\u0434\u0438.
      \u0425\u0430\u0432\u0430\u043B\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442
      \u043D\u0430 \u0434\u043E\u0432\u0435\u0440\u0438\u0438, \u0438 \u0432\u044B
      \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E \u0435\u0433\u043E
      \u043F\u043E\u0434\u043E\u0440\u0432\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859137
    m_Localized: "\u0414\u044B\u043C\u044F\u0449\u0430\u044F\u0441\u044F \u0434\u0435\u0440\u0435\u0432\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859138
    m_Localized: "\u0423 \u0432\u044A\u0435\u0437\u0434\u0430 \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u044E
      - \u043F\u0443\u0447\u043E\u043A \u0433\u043E\u0440\u044F\u0449\u0435\u0439
      \u043F\u043E\u043B\u044B\u043D\u0438 \u043D\u0430 \u0448\u0435\u0441\u0442\u0435
      \u0438 \u043A\u0430\u043C\u0435\u043D\u044C \u0441 \u0447\u0451\u0440\u043D\u043E\u0439
      \u043E\u0442\u043C\u0435\u0442\u0438\u043D\u043E\u0439. \u0417\u043D\u0430\u043A
      \u043A\u0430\u0440\u0430\u043D\u0442\u0438\u043D\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0437\u043D\u0430\u044E\u0442 \u0432\u0441\u0435 \u043D\u0430 \u044D\u0442\u043E\u043C
      \u0442\u0440\u0430\u043A\u0442\u0435. \u041C\u0435\u0441\u0442\u043D\u044B\u0439
      \u0441\u0442\u0430\u0440\u0438\u043A \u043A\u0440\u0438\u0447\u0438\u0442 \u0441
      \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F: <npc_speech lang=\"Persian\">\u0422\u0440\u0435\u0442\u0438\u0439
      \u0434\u0435\u043D\u044C \u0433\u043E\u0440\u0438\u043C. \u041D\u0435 \u0445\u043E\u0434\u0438,
      \u043A\u0443\u043F\u0435\u0446 - \u043D\u0438 \u0437\u0430 \u043A\u0430\u043A\u043E\u0435
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E.</npc_speech> \u041E\u0431\u0445\u043E\u0434
      \u0437\u0430\u0439\u043C\u0451\u0442 \u043F\u043E\u043B\u0434\u043D\u044F \u0438
      \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0432\u043E\u0434\u044B
      \u0438\u0437 \u043B\u0438\u0447\u043D\u044B\u0445 \u0437\u0430\u043F\u0430\u0441\u043E\u0432.
      \u041F\u0440\u044F\u043C\u043E\u0439 \u043F\u0443\u0442\u044C \u0432\u0434\u0432\u043E\u0435
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435 - \u0434\u0435\u0440\u0435\u0432\u043D\u044F
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F, \u043C\u043E\u0436\u043D\u043E
      \u043D\u0435 \u0437\u0430\u0445\u043E\u0434\u0438\u0442\u044C \u0432\u043D\u0443\u0442\u0440\u044C,
      \u043F\u0440\u043E\u0441\u0442\u043E \u043F\u0440\u043E\u0439\u0442\u0438 \u043A\u0440\u0430\u0435\u043C.
      \u0411\u043E\u043B\u0435\u0437\u043D\u0438 \u043D\u0430 \u0442\u0440\u0430\u043A\u0442\u0435
      \u0445\u043E\u0434\u044F\u0442 \u0441\u043B\u0435\u0434\u043E\u043C \u0437\u0430
      \u0442\u0435\u043C\u0438, \u043A\u0442\u043E \u043F\u0440\u0435\u043D\u0435\u0431\u0440\u0435\u0433\u0430\u0435\u0442
      \u0437\u043D\u0430\u043A\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859139
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u0434\u0435\u0440\u0435\u0432\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859140
    m_Localized: "\u0412\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u043F\u043E\u043B\u0434\u043D\u044F
      \u0438 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0432\u043E\u0434\u044B,
      \u0437\u0430\u0442\u043E \u043F\u0440\u043E\u0448\u043B\u0438 \u0447\u0438\u0441\u0442\u043E.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u0440\u0438\u043E\u0431\u043E\u0434\u0440\u0438\u043B\u0438\u0441\u044C:
      \u0445\u043E\u0437\u044F\u0438\u043D \u0434\u0443\u043C\u0430\u0435\u0442 \u043E
      \u043B\u044E\u0434\u044F\u0445, \u0430 \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E
      \u043E \u0433\u0440\u0430\u0444\u0438\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993410859141
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043A\u0440\u0430\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053312
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0448\u043B\u0438 - \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0432\u044B\u0445\u043E\u0434\u0438\u043B \u0438\u0437 \u0434\u043E\u043C\u043E\u0432,
      \u0434\u044B\u043C \u0441\u0442\u043B\u0430\u043B\u0441\u044F \u043D\u0438\u0437\u043A\u043E.
      \u041A\u0430\u0437\u0430\u043B\u043E\u0441\u044C, \u043E\u0431\u043E\u0448\u043B\u043E\u0441\u044C.
      \u041D\u043E \u0432\u043E\u0437\u0434\u0443\u0445 \u0443 \u0442\u0430\u043A\u0438\u0445
      \u0434\u0435\u0440\u0435\u0432\u0435\u043D\u044C \u0442\u044F\u0436\u0451\u043B\u044B\u0439,
      \u0438 \u044D\u0442\u043E \u0441\u043A\u0430\u0436\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053313
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0441\u043B\u0451\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053314
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u0442\u0440\u0438 \u0434\u043D\u044F
      \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0430 \u0443
      \u0434\u0435\u0440\u0435\u0432\u043D\u0438 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u041D\u0443\u0440\u043C\u0430\u0442 \u043D\u0435 \u0432\u0441\u0442\u0430\u0451\u0442
      \u0441 \u0443\u0442\u0440\u0430 - \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0430,
      \u043F\u043E\u0442\u043D\u044B\u0439 \u043B\u043E\u0431. \u0411\u043E\u043B\u044C\u043D\u043E\u0439
      \u0432 \u0434\u043E\u0440\u043E\u0433\u0435 - \u0433\u0440\u0443\u0437 \u0434\u043B\u044F
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053315
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0438 \u0432\u044B\u0445\u043E\u0434\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053316
    m_Localized: "\u0412\u044B \u0432\u0441\u0442\u0430\u043B\u0438 \u043B\u0430\u0433\u0435\u0440\u0435\u043C
      \u043D\u0430 \u0434\u0432\u0430 \u0434\u043D\u044F, \u043E\u0442\u043F\u043E\u0438\u043B\u0438
      \u041D\u0443\u0440\u043C\u0430\u0442\u0430 \u0442\u0440\u0430\u0432\u044F\u043D\u044B\u043C
      \u043E\u0442\u0432\u0430\u0440\u043E\u043C \u0438 \u0431\u0443\u0437\u043E\u0439.
      \u041E\u043D \u0432\u0441\u0442\u0430\u043B \u043D\u0430 \u043D\u043E\u0433\u0438
      \u0431\u043B\u0435\u0434\u043D\u044B\u0439, \u043D\u043E \u0436\u0438\u0432\u043E\u0439.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0437\u0430\u043F\u043E\u043C\u043D\u044F\u0442 - \u0437\u0430 \u0431\u043E\u043B\u044C\u043D\u044B\u0445
      \u043D\u0435 \u0431\u0440\u043E\u0441\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053317
    m_Localized: "\u0417\u0430\u0441\u043D\u0443\u0432\u0448\u0438\u0439 \u0441\u0442\u0440\u0430\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053318
    m_Localized: "\u041D\u043E\u0447\u043D\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430
      \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0430. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u0441\u0438\u0434\u0438\u0442, \u043F\u0440\u0438\u0432\u0430\u043B\u0438\u0432\u0448\u0438\u0441\u044C
      \u043A \u0441\u0442\u0435\u043D\u0435, - \u0437\u0430\u043F\u0430\u0445 \u043A\u0438\u0441\u043B\u043E\u0433\u043E
      \u043D\u0430\u0431\u0438\u0437\u0430 \u0437\u0430 \u0448\u0430\u0433. \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
      \u043D\u0430 \u043F\u0440\u0438\u0431\u044B\u0442\u0438\u0435 \u0435\u0449\u0451
      \u043D\u0435 \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u044B: \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u0439
      \u043F\u0438\u0441\u0435\u0446 \u0437\u0430\u043A\u0440\u044B\u043B\u0441\u044F
      \u0434\u043E \u0443\u0442\u0440\u0430. \u041E\u0444\u0438\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439
      \u043F\u0443\u0442\u044C - \u0436\u0434\u0430\u0442\u044C \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430.
      \u0414\u0440\u0443\u0433\u043E\u0439 \u043F\u0443\u0442\u044C - \u043D\u0430\u043B\u0438\u0442\u044C
      \u0441\u0442\u0440\u0430\u0436\u0435 \u0435\u0449\u0451 \u0438 \u043F\u0440\u043E\u0439\u0442\u0438
      \u043F\u043E\u043A\u0430 \u0442\u0435\u043C\u043D\u043E. \u0413\u0443\u043B\u044F\u043D\u0438\u0435
      \u0441 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438 \u0432
      \u0410\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u043E\u043C \u0445\u0430\u043B\u0438\u0444\u0430\u0442\u0435
      - \u0434\u0435\u043B\u043E \u043E\u0431\u044B\u0447\u043D\u043E\u0435, \u043D\u043E
      \u0434\u043E\u043D\u043E\u0441 \u0441\u0442\u043E\u0438\u0442 \u0434\u0435\u0448\u0435\u0432\u043B\u0435
      \u043A\u0443\u0432\u0448\u0438\u043D\u0430 \u0432\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053319
    m_Localized: "\u0421\u043F\u043E\u0438\u0442\u044C \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053320
    m_Localized: "\u041A\u0443\u0432\u0448\u0438\u043D \u043E\u043F\u0443\u0441\u0442\u0435\u043B,
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0437\u0430\u043A\u0440\u044B\u043B
      \u0433\u043B\u0430\u0437\u0430. \u0412\u044B \u043F\u0440\u043E\u0448\u043B\u0438
      \u0431\u0435\u0437 \u0448\u0443\u043C\u0430. \u041B\u0435\u0433\u043A\u043E
      \u0441\u0435\u0439\u0447\u0430\u0441 - \u043D\u043E \u0434\u043E\u043D\u043E\u0441
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u043D\u0435 \u0441\u0440\u0430\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053321
    m_Localized: "\u0414\u043E\u0436\u0434\u0430\u0442\u044C\u0441\u044F \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053322
    m_Localized: "\u0423\u0442\u0440\u043E \u043F\u0440\u0438\u0448\u043B\u043E \u0441
      \u0440\u043E\u0441\u043E\u0439 \u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C
      \u043F\u0438\u0441\u0446\u043E\u043C. \u0414\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B
      \u043E\u0444\u043E\u0440\u043C\u043B\u0435\u043D\u044B \u0447\u0438\u0441\u0442\u043E.
      \u041B\u0438\u0448\u043D\u0438\u0435 \u0447\u0430\u0441\u044B - \u043D\u0435
      \u043B\u0438\u0448\u043D\u0438\u0435 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053323
    m_Localized: "\u041D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A \u0441\u0442\u0440\u0430\u0436\u0438
      \u0436\u0434\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053324
    m_Localized: "\u0423 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445 \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u0438\u0445
      \u0432\u043E\u0440\u043E\u0442 \u0432\u0430\u0441 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u043D\u0435 \u0440\u044F\u0434\u043E\u0432\u043E\u0439 \u0441\u0442\u0440\u0430\u0436,
      \u0430 \u0434\u0435\u0441\u044F\u0442\u043D\u0438\u043A \u0441 \u0431\u0443\u043C\u0430\u0433\u043E\u0439
      \u0432 \u0440\u0443\u043A\u0435. \u041F\u044C\u044F\u043D\u044B\u0439 \u043F\u0440\u0438\u0432\u0440\u0430\u0442\u043D\u0438\u043A
      \u0432\u0441\u0451-\u0442\u0430\u043A\u0438 \u0434\u043E\u043D\u0451\u0441
      - \u0438\u043B\u0438 \u043A\u0442\u043E-\u0442\u043E \u0438\u0437 \u043F\u0440\u043E\u0445\u043E\u0436\u0438\u0445
      \u0432\u0438\u0434\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053325
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0448\u0442\u0440\u0430\u0444"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053326
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0438 \u043F\u043E\u0434\u043F\u0438\u0441\u044C \u043D\u0430 \u0431\u0443\u043C\u0430\u0433\u0435.
      \u0414\u0435\u0441\u044F\u0442\u043D\u0438\u043A \u0443\u0431\u0440\u0430\u043B
      \u0435\u0451 \u0432 \u0441\u0443\u043C\u043A\u0443 \u0431\u0435\u0437 \u0441\u043B\u043E\u0432\u0430.
      \u0411\u044E\u0440\u043E\u043A\u0440\u0430\u0442\u0438\u044F \u0410\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u043E\u0433\u043E
      \u0445\u0430\u043B\u0438\u0444\u0430\u0442\u0430 \u043B\u044E\u0431\u0438\u0442
      \u043C\u043E\u043D\u0435\u0442\u044B \u0438 \u043D\u0435 \u043B\u044E\u0431\u0438\u0442
      \u0448\u0443\u043C - \u0432\u044B \u0434\u0430\u043B\u0438 \u0435\u0439 \u0438
      \u0442\u043E, \u0438 \u0434\u0440\u0443\u0433\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053327
    m_Localized: "\u041E\u0441\u043F\u043E\u0440\u0438\u0442\u044C \u043E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053328
    m_Localized: "\u0412\u044B \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043B\u0438
      \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u0435\u0439. \u0414\u0435\u0441\u044F\u0442\u043D\u0438\u043A
      \u043F\u043E\u0436\u0430\u043B \u043F\u043B\u0435\u0447\u0430\u043C\u0438:
      \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C \u043D\u0430\u0439\u0434\u0451\u0442\u0441\u044F.
      \u0417\u0430\u0434\u0435\u0440\u0436\u043A\u0430 \u0432\u044B\u0448\u043B\u0430
      \u0432 \u0434\u0435\u043D\u044C \u0438 \u0442\u0435 \u0436\u0435 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u043F\u043B\u044E\u0441 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0441\u043A\u043B\u043E\u0447\u043D\u0438\u043A\u0430. \u0418\u043D\u043E\u0433\u0434\u0430
      \u043F\u0440\u043E\u0449\u0435 \u043F\u043B\u0430\u0442\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053329
    m_Localized: "\u041F\u0451\u0441 \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053330
    m_Localized: "\u0423 \u0432\u044B\u0441\u043E\u0445\u0448\u0435\u0433\u043E \u043A\u043E\u043B\u043E\u0434\u0446\u0430
      \u0441\u0438\u0434\u0438\u0442 \u043F\u0451\u0441 - \u0440\u0451\u0431\u0440\u0430
      \u0432\u0438\u0434\u043D\u044B, \u0443\u0445\u043E \u043D\u0430\u0434\u043E\u0440\u0432\u0430\u043D\u043E,
      \u043D\u043E \u0432\u0437\u0433\u043B\u044F\u0434 \u0436\u0438\u0432\u043E\u0439.
      \u0413\u043E\u043D\u0438\u0442 \u043D\u0435 \u043F\u0440\u043E\u0441\u0438\u0442
      - \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D: \xAB\u041A\u043E\u0440\u043C\u0438\u0442\u044C
      \u0431\u0440\u043E\u0434\u044F\u0433 - \u043F\u043B\u043E\u0445\u0430\u044F
      \u043F\u0440\u0438\u043C\u0435\u0442\u0430\xBB. \u0429\u0435\u043F\u043E\u0442\u043A\u0430
      \u0441\u0443\u0448\u0451\u043D\u043E\u0433\u043E \u043C\u044F\u0441\u0430 \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0441\u0442\u043E\u0438\u0442. \u0421\u0442\u0435\u043F\u043D\u044B\u0435
      \u043F\u0441\u044B \u043F\u0440\u0438\u0432\u044F\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u043A\u0440\u0435\u043F\u043A\u043E \u0438 \u0434\u0430\u043B\u0435\u043A\u043E
      \u043D\u0435 \u0443\u0445\u043E\u0434\u044F\u0442 - \u0438\u043D\u043E\u0433\u0434\u0430
      \u044D\u0442\u043E \u043E\u0431\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043F\u043E\u043B\u044C\u0437\u043E\u0439, \u0438\u043D\u043E\u0433\u0434\u0430
      \u043B\u0438\u0448\u043D\u0438\u043C \u0440\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053331
    m_Localized: "\u041D\u0430\u043A\u043E\u0440\u043C\u0438\u0442\u044C \u043F\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053332
    m_Localized: "\u041F\u0451\u0441 \u0432\u0437\u044F\u043B \u043C\u044F\u0441\u043E
      \u043D\u0435 \u0441\u043F\u0435\u0448\u0430 \u0438 \u043B\u0451\u0433 \u0440\u044F\u0434\u043E\u043C
      \u0441 \u043F\u043E\u0432\u043E\u0437\u043A\u043E\u0439. \u041A \u0432\u0435\u0447\u0435\u0440\u0443
      \u043E\u043D \u0432\u0441\u0451 \u0435\u0449\u0451 \u0448\u0451\u043B \u0441\u043B\u0435\u0434\u043E\u043C.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0431\u043E\u043B\u044C\u0448\u0435
      \u043D\u0435 \u0432\u043E\u0437\u0440\u0430\u0436\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053333
    m_Localized: "\u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C \u043F\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053334
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0433\u043D\u0430\u043B\u0438 \u0435\u0433\u043E
      \u043A\u0430\u043C\u0435\u0448\u043A\u043E\u043C. \u041F\u0451\u0441 \u043E\u0442\u0431\u0435\u0436\u0430\u043B,
      \u043B\u0451\u0433 \u0432 \u043E\u0442\u0434\u0430\u043B\u0435\u043D\u0438\u0438
      - \u0438 \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438 \u043F\u043E\u043B\u0447\u0430\u0441\u0430.
      \u041F\u043E\u0442\u043E\u043C \u043F\u0440\u043E\u043F\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053335
    m_Localized: "\u041F\u0451\u0441 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053336
    m_Localized: "\u041D\u0430 \u0432\u043E\u0441\u044C\u043C\u043E\u0439 \u0434\u0435\u043D\u044C
      \u0442\u043E\u0442 \u0441\u0430\u043C\u044B\u0439 \u043F\u0451\u0441 - \u0432\u044B
      \u0443\u0437\u043D\u0430\u0451\u0442\u0435 \u043D\u0430\u0434\u043E\u0440\u0432\u0430\u043D\u043D\u043E\u0435
      \u0443\u0445\u043E - \u0432\u0434\u0440\u0443\u0433 \u0441\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0432\u043F\u0435\u0440\u0451\u0434, \u043B\u0430\u0435\u0442 \u043D\u0430
      \u043F\u0440\u043E\u043C\u043E\u0438\u043D\u0443 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438.
      \u0422\u0430\u043C \u043F\u0440\u0438\u0442\u0430\u0438\u043B\u0438\u0441\u044C
      \u0434\u0432\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053337
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u043F\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053338
    m_Localized: "\u0414\u0432\u043E\u0435 \u0431\u0435\u0436\u0430\u043B\u0438 \u043F\u0440\u0438
      \u0432\u0438\u0434\u0435 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u043E\u0439
      \u043E\u0445\u0440\u0430\u043D\u044B - \u0438 \u0441\u043E\u0431\u0430\u043A\u0438,
      \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0437\u043D\u0430\u043B\u0430 \u0438\u0445
      \u0440\u0430\u043D\u044C\u0448\u0435 \u0432\u0430\u0441. \u041F\u0451\u0441
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F, \u043B\u0451\u0433 \u0443
      \u043A\u043E\u043B\u0435\u0441\u0430. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D
      \u043D\u0430\u0448\u0451\u043B \u0434\u043B\u044F \u043D\u0435\u0433\u043E
      \u043A\u043E\u0441\u0442\u044C. \u0421\u0442\u0435\u043F\u043D\u043E\u0439
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A \u043E\u0431\u043E\u0448\u0451\u043B\u0441\u044F
      \u0432 \u0449\u0435\u043F\u043E\u0442\u043A\u0443 \u0432\u044F\u043B\u0435\u043D\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053339
    m_Localized: "\u041F\u043E\u0441\u0442 \u0446\u0437\u0435\u0434\u0443\u0448\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053340
    m_Localized: "\u0417\u0430\u0441\u0442\u0430\u0432\u043D\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430
      \u0443 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u044B - \u0438 \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u0432 \u0441\u0438\u043D\u0435\u043C \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u0447\u044C\u0435\u043C
      \u0433\u0430\u043E\u0448\u0438, \u0441 \u043F\u043B\u0430\u043D\u0448\u0435\u0442\u043A\u043E\u0439
      \u0438\u0437 \u0441\u043B\u043E\u043D\u043E\u0432\u043E\u0439 \u043A\u043E\u0441\u0442\u0438.
      \u0414\u043E\u0441\u043C\u043E\u0442\u0440 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0437\u0430\u0439\u043C\u0451\u0442 \u043F\u043E\u043B\u0434\u043D\u044F:
      \u043F\u0435\u0440\u0435\u043F\u0438\u0441\u044C \u0442\u043E\u0432\u0430\u0440\u043E\u0432,
      \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0433\u0443\u0430\u043D\u044C\u0434\u0438\u0435
      - \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u043D\u043E\u0433\u043E \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430.
      \u0412\u0430\u0448\u0435 \u0433\u0443\u0430\u043D\u044C\u0434\u0438\u0435 \u043F\u0440\u043E\u0441\u0440\u043E\u0447\u0435\u043D\u043E
      \u043D\u0430 \u0442\u0440\u0438 \u0434\u043D\u044F. \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u0435\u0449\u0451 \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u043B \u0440\u043E\u0442
      - \u043D\u043E \u043F\u0430\u043B\u044C\u0446\u044B \u0443\u0436\u0435 \u0434\u0435\u0440\u0436\u0430\u0442
      \u043A\u0438\u0441\u0442\u044C \u043D\u0430\u0433\u043E\u0442\u043E\u0432\u0435.
      <npc_speech lang=\"Chinese\">\u0424\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438...
      \u0442\u0440\u0435\u0431\u0443\u044E\u0442 \u0432\u0440\u0435\u043C\u0435\u043D\u0438.</npc_speech>
      \u0412\u0437\u044F\u0442\u043A\u0430 \u0432 \u0422\u0430\u043D\u0441\u043A\u043E\u0439
      \u0431\u044E\u0440\u043E\u043A\u0440\u0430\u0442\u0438\u0438 - \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u043E\u0431\u044B\u0447\u043D\u043E\u0435 \u0434\u0435\u043B\u043E, \u0447\u0442\u043E
      \u0434\u043B\u044F \u043D\u0435\u0451 \u0435\u0441\u0442\u044C \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u044B\u0439
      \u0442\u0435\u0440\u043C\u0438\u043D: \xAB\u043B\u0451\u0434\xBB (\u0431\u0438\u043D-\u0446\u0437\u0438\u043D).
      \u0412\u043E\u043F\u0440\u043E\u0441 \u0432 \u0442\u043E\u043C, \u043A\u0442\u043E
      \u043E\u0431 \u044D\u0442\u043E\u043C \u0443\u0437\u043D\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053341
    m_Localized: "\u0414\u0430\u0442\u044C \u0432\u0437\u044F\u0442\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053342
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u043C\u043E\u043D\u0435\u0442
      \u043A\u0430\u0439\u044E\u0430\u043D\u044C \u0442\u0443\u043D\u0431\u0430\u043E
      \u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0438 \u043F\u043E\u0434
      \u043F\u043B\u0430\u043D\u0448\u0435\u0442\u043A\u0443. \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B \u043F\u0435\u0447\u0430\u0442\u044C
      \u0431\u0435\u0437 \u0441\u043B\u043E\u0432. \u0412\u043E\u0440\u043E\u0442\u0430
      \u043E\u0442\u043A\u0440\u044B\u043B\u0438\u0441\u044C. \u0411\u044B\u0441\u0442\u0440\u043E
      \u0438 \u0447\u0438\u0441\u0442\u043E - \u043F\u043E\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053343
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0434\u043E\u0441\u043C\u043E\u0442\u0440
      \u0447\u0435\u0441\u0442\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053344
    m_Localized: "\u041F\u043E\u043B\u0434\u043D\u044F. \u041F\u0435\u0440\u0435\u043F\u0438\u0441\u044C
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0442\u044E\u043A\u0430, \u0432\u043E\u043F\u0440\u043E\u0441\u044B
      \u043E \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0435, \u0448\u0442\u0440\u0430\u0444
      \u0437\u0430 \u043F\u0440\u043E\u0441\u0440\u043E\u0447\u0435\u043D\u043D\u043E\u0435
      \u0433\u0443\u0430\u043D\u044C\u0434\u0438\u0435. \u0414\u043E\u0440\u043E\u0433\u043E
      \u0438 \u0434\u043E\u043B\u0433\u043E - \u0437\u0430\u0442\u043E \u0447\u0438\u0441\u0442\u043E
      \u0432 \u0431\u0443\u043C\u0430\u0433\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053345
    m_Localized: "\u0421\u043B\u0443\u0445 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053346
    m_Localized: "\u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u043F\u043E\u0441\u0442\u0443 \u0441\u0442\u0430\u0440\u0448\u0438\u0439 \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443
      \u0441 \u043E\u0441\u043E\u0431\u044B\u043C \u0432\u0438\u0434\u043E\u043C.
      \u0421\u043B\u0443\u0445 \u043E \u043B\u0451\u0433\u043A\u043E\u0439 \u0432\u0437\u044F\u0442\u043A\u0435
      \u043F\u0440\u043E\u0448\u0451\u043B \u043F\u043E \u0442\u0440\u0430\u043A\u0442\u0443
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0432\u0430\u0448\u0435\u0433\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430. <npc_speech lang=\"Chinese\">\u0413\u043E\u0432\u043E\u0440\u044F\u0442,
      \u0442\u044B \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0449\u0435\u0434\u0440\u044B\u0439.
      \u041C\u043E\u044F \u043F\u0435\u0447\u0430\u0442\u044C \u0442\u043E\u0436\u0435
      \u0441\u0442\u043E\u0438\u0442 \u0434\u0435\u043D\u0435\u0433.</npc_speech>
      \u0410\u043F\u043F\u0435\u0442\u0438\u0442\u044B \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A\u043E\u0432
      \u043D\u0430 \u0412\u0435\u043B\u0438\u043A\u043E\u043C \u0448\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u043F\u0443\u0442\u0438 \u0440\u043E\u0441\u043B\u0438 \u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E
      \u043C\u043E\u043B\u0432\u0435 \u043E \u0432\u0430\u0448\u0435\u0439 \u0441\u0433\u043E\u0432\u043E\u0440\u0447\u0438\u0432\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053347
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0441\u043D\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053348
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043C\u043E\u043D\u0435\u0442
      \u0432\u043C\u0435\u0441\u0442\u043E \u0434\u0435\u0441\u044F\u0442\u0438.
      \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u0434\u043E\u0432\u043E\u043B\u0435\u043D.
      \u041D\u043E \u0432\u044B \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0442\u0435:
      \u043A\u0430\u0436\u0434\u0430\u044F \u0432\u0437\u044F\u0442\u043A\u0430 \u043D\u0430
      \u044D\u0442\u043E\u043C \u0442\u0440\u0430\u043A\u0442\u0435 - \u0440\u0435\u043A\u043B\u0430\u043C\u0430
      \u0434\u043B\u044F \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053349
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043F\u043B\u0430\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053350
    m_Localized: "\u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u043F\u043E\u0434\u0436\u0430\u043B
      \u0433\u0443\u0431\u044B \u0438 \u043F\u0440\u0438\u0434\u0443\u043C\u0430\u043B
      \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0443 \u0433\u0440\u0443\u0437\u0430
      \u043D\u0430 \u043F\u043E\u0434\u043B\u0438\u043D\u043D\u043E\u0441\u0442\u044C
      \u043A\u043B\u0435\u0439\u043C. \u0414\u0435\u043D\u044C \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438
      \u0438 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0441\u043A\u0430\u043D\u0434\u0430\u043B\u0438\u0441\u0442\u0430.
      \u0418\u043D\u043E\u0433\u0434\u0430 \u0442\u0432\u0451\u0440\u0434\u043E\u0441\u0442\u044C
      \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0436\u0435 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438
      \u043C\u043E\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053351
    m_Localized: "\u0420\u0435\u0431\u0451\u043D\u043E\u043A \u0432 \u044F\u043C\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053352
    m_Localized: "\u041D\u0430 \u043E\u0431\u043E\u0447\u0438\u043D\u0435 - \u0433\u043B\u0443\u0431\u043E\u043A\u0430\u044F
      \u043F\u0440\u043E\u043C\u043E\u0438\u043D\u0430, \u0441\u0442\u0430\u0440\u044B\u0439
      \u0430\u0440\u044B\u043A, \u0437\u0430\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0439
      \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443. \u0421\u043D\u0438\u0437\u0443
      - \u0434\u0435\u0442\u0441\u043A\u0438\u0439 \u043F\u043B\u0430\u0447. \u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0439
      \u043C\u0430\u043B\u044C\u0447\u0438\u043A \u043B\u0435\u0442 \u0448\u0435\u0441\u0442\u0438
      \u0437\u0430\u0441\u0442\u0440\u044F\u043B \u0432 \u0443\u0437\u043A\u043E\u043C
      \u0433\u043E\u0440\u043B\u043E\u0432\u0438\u043D\u0435: \u0443\u043F\u0430\u043B,
      \u0432\u044B\u043B\u0435\u0437\u0442\u0438 \u0441\u0430\u043C \u043D\u0435
      \u043C\u043E\u0436\u0435\u0442. \u0412\u043E\u043A\u0440\u0443\u0433 - \u043D\u0438\u043A\u043E\u0433\u043E,
      \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u043B\u0443\u0434\u0435\u043D\u043D\u0430\u044F
      \u0442\u0438\u0448\u0438\u043D\u0430 \u0438 \u0441\u0442\u0440\u0451\u043A\u043E\u0442
      \u043A\u0443\u0437\u043D\u0435\u0447\u0438\u043A\u043E\u0432. \u0412\u044B\u0442\u0430\u0449\u0438\u0442\u044C
      \u043D\u0435\u0441\u043B\u043E\u0436\u043D\u043E, \u043D\u043E \u043D\u0430\u0434\u043E
      \u0441\u043B\u0435\u0437\u0442\u044C \u0441\u0430\u043C\u043E\u043C\u0443 \u0438\u043B\u0438
      \u043F\u043E\u0441\u043B\u0430\u0442\u044C \u043A\u043E\u0433\u043E-\u0442\u043E.
      \u041F\u043E\u0442\u0435\u0440\u044F \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u0438
      \u0447\u0430\u0441\u0430. \u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0435\u0433\u043E - \u043A\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C
      \u043D\u0430\u0439\u0434\u0451\u0442. \u0418\u043B\u0438 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053353
    m_Localized: "\u0412\u044B\u0442\u0430\u0449\u0438\u0442\u044C \u0440\u0435\u0431\u0451\u043D\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053354
    m_Localized: "\u0412\u044B \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0438\u0441\u044C,
      \u043F\u043E\u0434\u0445\u0432\u0430\u0442\u0438\u043B\u0438 \u043C\u0430\u043B\u044C\u0447\u0438\u043A\u0430
      \u043F\u043E\u0434 \u043C\u044B\u0448\u043A\u0438 \u0438 \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438
      \u043D\u0430\u0432\u0435\u0440\u0445. \u041E\u043D \u0437\u0430\u043C\u043E\u043B\u0447\u0430\u043B,
      \u0443\u0441\u0442\u0430\u0432\u0438\u043B\u0441\u044F, \u043F\u043E\u0431\u0435\u0436\u0430\u043B
      \u043F\u0440\u043E\u0447\u044C \u0431\u0435\u0437 \u0441\u043B\u043E\u0432\u0430.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0443\u0441\u043C\u0435\u0445\u043D\u0443\u043B\u0441\u044F:
      \xAB\u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0435 \u0434\u0435\u0442\u0438
      \u043D\u0435 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F\u0442 -
      \u0437\u0430 \u043D\u0438\u0445 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F\u0442
      \u0440\u043E\u0434\u0438\u0442\u0435\u043B\u0438\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053355
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0438 \u0435\u0445\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053356
    m_Localized: "\u0412\u044B \u043F\u0440\u043E\u0435\u0445\u0430\u043B\u0438.
      \u041F\u043B\u0430\u0447 \u0437\u0430\u0442\u0438\u0445 \u0437\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u043C.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B
      \u043D\u0438\u0447\u0435\u0433\u043E - \u043D\u043E \u0432\u0435\u0447\u0435\u0440\u043E\u043C
      \u0435\u043B \u043C\u043E\u043B\u0447\u0430 \u0438 \u0433\u043B\u0430\u0437\u0430
      \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053357
    m_Localized: "\u0422\u044E\u0440\u043A\u0441\u043A\u0430\u044F \u0441\u0435\u043C\u044C\u044F
      \u043D\u0430\u0448\u043B\u0430 \u0432\u0430\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053358
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u0434\u0435\u0432\u044F\u0442\u044C
      \u0434\u043D\u0435\u0439 \u0443 \u0431\u0440\u043E\u0434\u0430 \u0432\u0430\u0441
      \u043D\u0430\u0433\u043E\u043D\u044F\u044E\u0442 \u0434\u0432\u043E\u0435 \u0432\u0435\u0440\u0445\u043E\u0432\u044B\u0445
      \u0442\u044E\u0440\u043A\u043E\u0432. \u041E\u0434\u0438\u043D - \u043C\u0443\u0436\u0447\u0438\u043D\u0430
      \u043B\u0435\u0442 \u0441\u043E\u0440\u043E\u043A\u0430, \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u043F\u0430\u043D\u0446\u0438\u0440\u044C, \u043B\u0443\u043A \u0437\u0430
      \u0441\u043F\u0438\u043D\u043E\u0439. \u041E\u043D \u0441\u043F\u0435\u0448\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u043A\u043B\u0430\u043D\u044F\u0435\u0442\u0441\u044F \u043D\u0438\u0437\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053359
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053360
    m_Localized: "<npc_speech lang=\"Old_Turkic\">\u042D\u0442\u043E \u043C\u043E\u0439
      \u0441\u044B\u043D. \u0422\u044B \u0435\u0433\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B
      - \u044F \u0434\u0430\u044E \u0442\u0435\u0431\u0435 \u0434\u043E\u0440\u043E\u0433\u0443.</npc_speech>
      \u041E\u043D \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u0432\u044C\u044E\u043A: \u0441\u0443\u0448\u0451\u043D\u043E\u0435 \u043C\u044F\u0441\u043E,
      \u043A\u0443\u0440\u0442, \u043C\u0435\u0448\u043E\u0447\u0435\u043A \u0441
      \u0437\u0435\u0440\u043D\u043E\u043C. \u0422\u044E\u0440\u043A\u0441\u043A\u043E\u0435
      \u0433\u043E\u0441\u0442\u0435\u043F\u0440\u0438\u0438\u043C\u0441\u0442\u0432\u043E
      - \u0434\u043E\u043B\u0433, \u0430 \u043D\u0435 \u0449\u0435\u0434\u0440\u043E\u0441\u0442\u044C.
      \u0411\u0440\u043E\u0434 \u043F\u0440\u043E\u0439\u0434\u0451\u0442\u0435 \u0441
      \u0435\u0433\u043E \u043B\u044E\u0434\u044C\u043C\u0438: \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0442\u0440\u043E\u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053361
    m_Localized: "\u0427\u0443\u0436\u043E\u0439 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053362
    m_Localized: "\u0423 \u0434\u043E\u0440\u043E\u0433\u0438 \u0441\u0442\u043E\u0438\u0442
      \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u0430\u044F \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      - \u043E\u0441\u044C \u0442\u0440\u0435\u0441\u043D\u0443\u043B\u0430. \u0421\u0442\u0430\u0440\u0448\u0438\u0439
      \u0438\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430, \u043F\u0435\u0440\u0441
      \u043F\u043E \u0438\u043C\u0435\u043D\u0438 \u0411\u0430\u0445\u0440\u0430\u043C,
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0441\u0430\u043C: <npc_speech
      lang=\"Persian\">\u041E\u0434\u043E\u043B\u0436\u0438 \u0436\u0435\u043B\u0435\u0437\u043E
      \u043D\u0430 \u0434\u0435\u043D\u044C. \u0412\u0435\u0440\u043D\u0443 \u0432
      \u041C\u0435\u0440\u0432\u0435 - \u0442\u0430\u043C \u0443 \u043C\u0435\u043D\u044F
      \u0441\u043A\u043B\u0430\u0434.</npc_speech> \u0412\u0430\u0448\u0438 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B
      \u043D\u0443\u0436\u043D\u044B \u0432\u0430\u043C \u0441\u0430\u043C\u0438\u043C
      - \u0434\u043E\u0440\u043E\u0433\u0430 \u043D\u0435\u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0443\u0435\u043C\u0430.
      \u041D\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u0441\u043E\u0441\u0435\u0434\u0443
      \u043F\u043E \u0442\u0440\u0430\u043A\u0442\u0443 - \u0434\u0443\u0440\u043D\u043E\u0439
      \u0437\u043D\u0430\u043A: \u0437\u0430\u0432\u0442\u0440\u0430 \u0432\u044B
      \u0441\u0430\u043C\u0438 \u0431\u0443\u0434\u0435\u0442\u0435 \u043F\u0440\u043E\u0441\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053363
    m_Localized: "\u041E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053364
    m_Localized: "\u0411\u0430\u0445\u0440\u0430\u043C \u0432\u0437\u044F\u043B \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B
      \u0438 \u043F\u0440\u0438\u043D\u044F\u043B\u0441\u044F \u0437\u0430 \u0440\u0430\u0431\u043E\u0442\u0443.
      \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u0435\u0433\u043E \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043A\u0430\u0442\u0438\u043B\u0430\u0441\u044C \u0441\u043D\u043E\u0432\u0430.
      \u041E\u043D \u043F\u043E\u043E\u0431\u0435\u0449\u0430\u043B \u041C\u0435\u0440\u0432.
      \u0418\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B \u0432\u0435\u0440\u043D\u0443\u0442\u0441\u044F
      - \u043C\u043E\u0436\u0435\u0442, \u043D\u0435 \u0432\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053365
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053366
    m_Localized: "\u0411\u0430\u0445\u0440\u0430\u043C \u043A\u0438\u0432\u043D\u0443\u043B
      \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B - \u0432\u0438\u0434\u043D\u043E,
      \u043D\u0435 \u0432 \u043F\u0435\u0440\u0432\u044B\u0439 \u0440\u0430\u0437.
      \u0415\u0433\u043E \u043B\u044E\u0434\u0438 \u0441\u043F\u0440\u0430\u0432\u0438\u043B\u0438\u0441\u044C
      \u0432\u0435\u0440\u0451\u0432\u043A\u043E\u0439. \u0412\u0430\u0448\u0438
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B \u0446\u0435\u043B\u044B
      - \u0438 \u0432\u0430\u0448\u0430 \u0441\u043E\u0432\u0435\u0441\u0442\u044C
      \u043D\u0435 \u043E\u0447\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053367
    m_Localized: "\u0411\u0430\u0445\u0440\u0430\u043C \u043D\u0430\u0433\u043D\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053368
    m_Localized: "\u0411\u0430\u0445\u0440\u0430\u043C \u043D\u0430\u0433\u043D\u0430\u043B
      \u0432\u0430\u0441 \u0434\u043E \u041C\u0435\u0440\u0432\u0430. \u041E\u043D
      \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B
      - \u0438 \u0432 \u0435\u0433\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u0435
      \u0447\u0442\u043E-\u0442\u043E \u0432\u0438\u043D\u043E\u0432\u0430\u0442\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053369
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0438 \u043F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053370
    m_Localized: "\u041E\u0434\u043D\u043E \u0437\u0443\u0431\u0438\u043B\u043E \u043D\u0430\u0434\u043B\u043E\u043C\u043B\u0435\u043D\u043E.
      \u0411\u0430\u0445\u0440\u0430\u043C \u044D\u0442\u043E\u0433\u043E \u043D\u0435
      \u043F\u0440\u0438\u0437\u043D\u0430\u0451\u0442 - \u043F\u0440\u043E\u0441\u0442\u043E
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
      \u0412\u044B \u0431\u0435\u0440\u0451\u0442\u0435 \u043C\u043E\u043B\u0447\u0430.
      \u0422\u0440\u0430\u043A\u0442 \u043D\u0435 \u043C\u0435\u0441\u0442\u043E
      \u0434\u043B\u044F \u043C\u0435\u043B\u043A\u0438\u0445 \u0441\u0447\u0451\u0442\u043E\u0432
      - \u0438 \u0411\u0430\u0445\u0440\u0430\u043C \u044D\u0442\u043E \u0437\u043D\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053371
    m_Localized: "\u041F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
      \u0432\u043E\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053372
    m_Localized: "\u0412\u044B \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0435
      \u043D\u0430 \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u043E\u0435 \u0437\u0443\u0431\u0438\u043B\u043E.
      \u0411\u0430\u0445\u0440\u0430\u043C \u043C\u043E\u0440\u0449\u0438\u0442\u0441\u044F,
      \u0434\u043E\u0441\u0442\u0430\u0451\u0442 \u0442\u0440\u0438 \u0434\u0438\u0440\u0445\u0430\u043C\u0430
      - \u043C\u0435\u043D\u044C\u0448\u0435, \u0447\u0435\u043C \u0441\u0442\u043E\u0438\u0442,
      \u043D\u043E \u0447\u0442\u043E-\u0442\u043E. \u041D\u0430\u0441\u0442\u043E\u044F\u0442\u044C
      \u0436\u0451\u0441\u0442\u0447\u0435 - \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C
      \u043F\u043E\u043B\u0434\u043D\u044F \u0443 \u0434\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053373
    m_Localized: "\u041F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0430\u043D\u0438\u0435
      \u043C\u043E\u043D\u0430\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053374
    m_Localized: "\u041C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0439
      \u043C\u043E\u043D\u0430\u0445 \u0432 \u0431\u0435\u043B\u043E\u043C, \u0440\u0430\u0441\u0448\u0438\u0442\u043E\u043C
      \u0447\u0451\u0440\u043D\u044B\u043C\u0438 \u043B\u043E\u0442\u043E\u0441\u0430\u043C\u0438
      \u043E\u0434\u0435\u044F\u043D\u0438\u0438 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0443 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438.
      \u041B\u0438\u0446\u043E \u0445\u0443\u0434\u043E\u0435, \u043F\u0430\u043B\u044C\u0446\u044B
      \u0432 \u0447\u0435\u0440\u043D\u0438\u043B\u0430\u0445. <npc_speech lang=\"Sogdian\">\u042F
      \u0432\u0438\u0434\u0435\u043B \u0441\u043E\u043D \u0442\u0440\u0438\u0436\u0434\u044B:
      \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0443 \u0442\u0440\u0435\u0442\u044C\u0435\u0433\u043E
      \u0431\u0440\u043E\u0434\u0430. \u041D\u0435 \u0433\u043E\u0432\u043E\u0440\u044E
      - \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0442\u0435.
      \u0413\u043E\u0432\u043E\u0440\u044E - \u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
      \u0432 \u043E\u0431\u0430.</npc_speech> \u041C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u0442\u0432\u043E
      \u043D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C \u043F\u0443\u0442\u0438
      - \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u0430\u044F \u0440\u0435\u043B\u0438\u0433\u0438\u043E\u0437\u043D\u0430\u044F
      \u0441\u0438\u043B\u0430: \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u0438
      \u0434\u0435\u0440\u0436\u0430\u043B\u0438 \u043A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u0441\u0435\u0442\u0438 \u0438 \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0438
      \u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0435 \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F.
      \u0418\u0445 \xAB\u0441\u043D\u044B\xBB \u0447\u0430\u0441\u0442\u043E \u0431\u044B\u043B\u0438
      \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F\u043C\u0438, \u043F\u0435\u0440\u0435\u0432\u0435\u0434\u0451\u043D\u043D\u044B\u043C\u0438
      \u0432 \u044F\u0437\u044B\u043A \u043E\u0442\u043A\u0440\u043E\u0432\u0435\u043D\u0438\u044F.
      \u0412\u0435\u0440\u0438\u0442\u044C \u0438\u043B\u0438 \u043D\u0435\u0442
      - \u0432\u0430\u0448 \u0432\u044B\u0431\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053375
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u0438 \u0438\u0434\u0442\u0438 \u043F\u0440\u044F\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053376
    m_Localized: "\u0412\u044B \u043A\u0438\u0432\u043D\u0443\u043B\u0438 \u0438
      \u0434\u0432\u0438\u043D\u0443\u043B\u0438\u0441\u044C \u043F\u0440\u044F\u043C\u044B\u043C
      \u043F\u0443\u0442\u0451\u043C. \u041F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      \u043F\u0440\u0438\u043D\u044F\u0442\u043E \u043A \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044E
      - \u043E\u0440\u0443\u0436\u0438\u0435 \u043D\u0430\u0433\u043E\u0442\u043E\u0432\u0435
      \u043D\u0430 \u0442\u0440\u0435\u0442\u044C\u0435\u043C \u0431\u0440\u043E\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053377
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u0442\u0440\u0435\u0442\u0438\u0439
      \u0431\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053378
    m_Localized: "\u041A\u0440\u044E\u043A - \u0434\u0435\u043D\u044C \u0438 \u043B\u0438\u0448\u043D\u044F\u044F
      \u0432\u043E\u0434\u0430. \u041A\u043E\u0433\u0434\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B\u0438
      \u0432 \u043E\u0431\u0445\u043E\u0434, \u0443\u0441\u043B\u044B\u0448\u0430\u043B\u0438
      \u0432\u0434\u0430\u043B\u0438 \u043A\u0440\u0438\u043A\u0438 \u0443 \u0440\u0435\u043A\u0438.
      \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u043B\u0438 \u0432\u044B\u0431\u043E\u0440
      - \u0443\u0437\u043D\u0430\u0435\u0442\u0435 \u043F\u043E\u0437\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053379
    m_Localized: "\u0422\u0440\u0435\u0442\u0438\u0439 \u0431\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053380
    m_Localized: "\u0422\u0440\u0435\u0442\u0438\u0439 \u0431\u0440\u043E\u0434 \u0447\u0435\u0440\u0435\u0437
      \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u0443\u044E \u0440\u0435\u0447\u043A\u0443.
      \u0418\u0432\u0430 \u0443 \u0431\u0435\u0440\u0435\u0433\u0430 \u043E\u0431\u043B\u043E\u043C\u0430\u043D\u0430
      - \u0437\u043D\u0430\u0447\u0438\u0442, \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u0434\u0430\u0432\u043D\u043E
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u043B\u0438\u0441\u044C.
      \u0422\u0438\u0448\u0438\u043D\u0430 \u043F\u043E\u0434\u043E\u0437\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053381
    m_Localized: "\u041F\u0435\u0440\u0435\u0441\u0435\u0447\u044C \u0431\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053382
    m_Localized: "\u0418\u0437-\u0437\u0430 \u043F\u0440\u0438\u0431\u0440\u0435\u0436\u043D\u044B\u0445
      \u043A\u0430\u043C\u043D\u0435\u0439 \u0432\u044B\u0441\u043A\u043E\u0447\u0438\u043B\u0438
      \u0442\u0440\u043E\u0435. \u041F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      \u043C\u043E\u043D\u0430\u0445\u0430 \u0441\u0431\u0435\u0440\u0435\u0433\u043B\u043E
      \u0441\u0435\u043A\u0443\u043D\u0434\u044B - \u043E\u0445\u0440\u0430\u043D\u0430
      \u0443\u0441\u043F\u0435\u043B\u0430 \u0432\u0441\u0442\u0430\u0442\u044C.
      \u0417\u0430\u0441\u0430\u0434\u0430 \u0441\u043E\u0440\u0432\u0430\u043B\u0430\u0441\u044C,
      \u043F\u043E\u0442\u0435\u0440\u0438 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B.
      \u041C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0435 \xAB\u0441\u043D\u044B\xBB
      \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439
      \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053383
    m_Localized: "\u041F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0435 \u043A\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053384
    m_Localized: "\u0412\u0435\u0447\u0435\u0440 \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0435
      \u041C\u0435\u0440\u0432\u0430. \u0422\u0440\u043E\u0435 \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0445
      \u043A\u0443\u043F\u0446\u043E\u0432 \u0441\u0438\u0434\u044F\u0442 \u0443
      \u043D\u0438\u0437\u043A\u043E\u0433\u043E \u0441\u0442\u043E\u043B\u0430,
      \u043A\u0438\u0434\u0430\u044E\u0442 \u043A\u043E\u0441\u0442\u0438. \u041E\u0434\u0438\u043D
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0433\u043E\u043B\u043E\u0432\u0443:
      <npc_speech lang=\"Persian\">\u0421\u0430\u0434\u0438\u0441\u044C, \u043A\u0443\u043F\u0435\u0446.
      \u0421\u0435\u0440\u0435\u0431\u0440\u043E \u043A \u0441\u0435\u0440\u0435\u0431\u0440\u0443
      - \u0438\u043B\u0438 \u0443\u0445\u043E\u0434\u0438 \u043A \u0441\u0432\u043E\u0438\u043C
      \u043C\u0435\u0448\u043A\u0430\u043C.</npc_speech> \u0418\u0445 \u043A\u043E\u0441\u0442\u0438
      \u0432\u044B\u0433\u043B\u044F\u0434\u044F\u0442 \u0447\u0435\u0441\u0442\u043D\u044B\u043C\u0438
      - \u0441\u043B\u043E\u043D\u043E\u0432\u0430\u044F \u043A\u043E\u0441\u0442\u044C,
      \u0445\u043E\u0440\u043E\u0448\u043E \u0441\u0431\u0430\u043B\u0430\u043D\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435.
      \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u0443 \u043B\u044E\u0434\u0435\u0439
      \u0434\u043E\u0431\u0440\u043E\u0435, \u0432\u0438\u043D\u043E \u0434\u0435\u0448\u0451\u0432\u043E\u0435.
      \u041F\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043C\u043E\u0436\u043D\u043E
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E - \u0449\u0435\u043A\u043E\u0442\u043A\u0430
      \u0440\u0438\u0441\u043A\u0430 \u043F\u043E\u0441\u043B\u0435 \u043F\u044B\u043B\u044C\u043D\u043E\u0433\u043E
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430. \u0418\u043B\u0438 \u043D\u0435
      \u0438\u0433\u0440\u0430\u0442\u044C \u0441\u043E\u0432\u0441\u0435\u043C:
      \u0434\u0435\u043D\u044C\u0433\u0438 \u043D\u0443\u0436\u043D\u044B \u043D\u0430
      \u0434\u0435\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053385
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u0438\u0433\u0440\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053386
    m_Localized: "\u0412\u044B \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0438\u0441\u044C
      \u0438 \u0437\u0430\u043A\u0430\u0437\u0430\u043B\u0438 \u0447\u0430\u0439.
      \u041F\u0435\u0440\u0441\u044B \u043F\u043E\u0436\u0430\u043B\u0438 \u043F\u043B\u0435\u0447\u0430\u043C\u0438
      \u0438 \u043D\u0430\u0448\u043B\u0438 \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u043E\u0433\u043E
      \u0438\u0433\u0440\u043E\u043A\u0430 \u0441\u0440\u0435\u0434\u0438 \u043C\u0435\u0441\u0442\u043D\u044B\u0445.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u0446\u0435\u043B\u044B, \u0433\u043E\u043B\u043E\u0432\u0430
      \u044F\u0441\u043D\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053387
    m_Localized: "\u0421\u044B\u0433\u0440\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053388
    m_Localized: "\u041A\u043E\u0441\u0442\u0438 \u043B\u0435\u0433\u043B\u0438 \u043D\u0430
      \u0441\u0442\u043E\u043B. \u0418\u0433\u0440\u0430 \u0437\u0430\u0442\u044F\u043D\u0443\u043B\u0430\u0441\u044C
      \u0437\u0430 \u043F\u043E\u043B\u043D\u043E\u0447\u044C - \u0438 \u0447\u0435\u0440\u0435\u0437
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439
      \u043F\u0440\u0438\u0434\u0451\u0442 \u0440\u0430\u0441\u043F\u043B\u0430\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053389
    m_Localized: "\u0418\u0442\u043E\u0433 \u0438\u0433\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053390
    m_Localized: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439
      \u0441\u043F\u0443\u0441\u0442\u044F \u0432\u044B \u043F\u043E\u0434\u0432\u043E\u0434\u0438\u0442\u0435
      \u0438\u0442\u043E\u0433 \u0442\u043E\u0439 \u043D\u043E\u0447\u0438 \u0432
      \u041C\u0435\u0440\u0432\u0435. \u0423\u0434\u0430\u0447\u0430 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0430\u0441\u044C
      \u043E\u0434\u043D\u043E\u0439 \u0438\u0437 \u0434\u0432\u0443\u0445 \u0441\u0442\u043E\u0440\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053391
    m_Localized: "\u041F\u0440\u043E\u0438\u0433\u0440\u044B\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053392
    m_Localized: "\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0443\u0448\u043B\u0438 \u0432 \u0442\u0443 \u043D\u043E\u0447\u044C - \u0438
      \u0441 \u043D\u0438\u043C\u0438 \u0440\u0430\u0434\u043E\u0441\u0442\u044C
      \u043E\u0442 \u0432\u044B\u0438\u0433\u0440\u044B\u0448\u0430 \u043F\u043E
      \u0434\u043E\u0440\u043E\u0433\u0435 \u0441\u044E\u0434\u0430. \u041F\u0435\u0440\u0441\u044B
      \u0438\u0433\u0440\u0430\u043B\u0438 \u0447\u0435\u0441\u0442\u043D\u043E.
      \u041A\u043E\u0441\u0442\u0438 \u0447\u0435\u0441\u0442\u043D\u044B\u0435 -
      \u043D\u043E \u0443\u0434\u0430\u0447\u0430 \u043D\u0435\u0447\u0435\u0441\u0442\u043D\u0430\u044F.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0434\u0435\u043B\u0438\u043A\u0430\u0442\u043D\u043E
      \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0435\u0442,
      \u043A\u0443\u0434\u0430 \u0434\u0435\u043B\u043E\u0441\u044C \u0441\u0435\u0440\u0435\u0431\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053393
    m_Localized: "\u0412\u044B\u0438\u0433\u0440\u044B\u0448"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053394
    m_Localized: "\u0412\u044B \u0432\u0441\u0442\u0430\u043B\u0438 \u0438\u0437-\u0437\u0430
      \u0441\u0442\u043E\u043B\u0430 \u0441 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C\u044E
      \u043B\u0438\u0448\u043D\u0438\u043C\u0438 \u0434\u0438\u0440\u0445\u0430\u043C\u0430\u043C\u0438.
      \u041F\u0435\u0440\u0441\u044B \u0440\u0430\u0441\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u043F\u043E-\u0434\u043E\u0431\u0440\u043E\u043C\u0443 - \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u044E\u0442
      \u0442\u0430\u043A \u0436\u0435 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E,
      \u043A\u0430\u043A \u0432\u044B\u0438\u0433\u0440\u044B\u0432\u0430\u044E\u0442.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0443\u0433\u043E\u0449\u0435\u043D\u0438\u0435 \u0437\u0430 \u0441\u0447\u0451\u0442
      \u0443\u0434\u0430\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053395
    m_Localized: "\u0417\u0430\u0433\u043E\u0432\u043E\u0440 \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053396
    m_Localized: "\u041F\u043E\u0437\u0434\u043D\u0438\u0439 \u0432\u0435\u0447\u0435\u0440,
      \u0442\u0430\u0432\u0435\u0440\u043D\u0430 \u0443 \u0431\u0430\u0437\u0430\u0440\u0430.
      \u0414\u0432\u043E\u0435 \u0432 \u0443\u0433\u043B\u0443 \u0433\u043E\u0432\u043E\u0440\u044F\u0442
      \u0442\u0438\u0445\u043E - \u043D\u043E \u043D\u0435 \u0442\u0438\u0445\u043E
      \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E. \u0412\u044B
      \u0441\u043B\u044B\u0448\u0438\u0442\u0435 \u0441\u043B\u043E\u0432\u043E \xAB\u0431\u0430\u0441\u043A\u0430\u043A\xBB
      \u0438 \u0441\u043B\u043E\u0432\u043E \xAB\u043D\u043E\u0436\xBB. \u0411\u0430\u0441\u043A\u0430\u043A
      - \u043C\u043E\u043D\u0433\u043E\u043B\u044C\u0441\u043A\u0438\u0439 \u0438\u043B\u0438
      \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0439 \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A,
      \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0442\u0440\u0430\u043A\u0442\u0430:
      \u0437\u0434\u0435\u0441\u044C \u044D\u0442\u043E \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u043A
      \u0441 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0439 \u0432\u043B\u0430\u0441\u0442\u044C\u044E.
      \u0414\u043E\u043B\u043E\u0436\u0438\u0442\u044C - \u0437\u043D\u0430\u0447\u0438\u0442
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u0432\u043B\u0430\u0441\u0442\u0438: \u0445\u043E\u0440\u043E\u0448\u0435\u0435
      \u0438\u043B\u0438 \u043F\u043B\u043E\u0445\u043E\u0435. \u041F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u0442\u044C
      - \u0437\u043D\u0430\u0447\u0438\u0442 \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
      \u0447\u0438\u0441\u0442\u044B\u043C, \u043D\u043E \u0447\u0443\u0436\u0430\u044F
      \u043A\u0440\u043E\u0432\u044C \u043D\u0430 \u0432\u0430\u0448\u0435\u0439
      \u0441\u043E\u0432\u0435\u0441\u0442\u0438, \u0435\u0441\u043B\u0438 \u0434\u043E\u0439\u0434\u0451\u0442
      \u0434\u043E \u0434\u0435\u043B\u0430. \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0439
      \u043F\u0443\u0442\u044C \u043F\u043E\u043B\u043E\u043D \u0442\u0435\u043C\u0438,
      \u043A\u0442\u043E \u0441\u043B\u044B\u0448\u0438\u0442 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043C\u043D\u043E\u0433\u043E - \u0438 \u0436\u0438\u0432\u0451\u0442 \u0434\u043E\u043B\u0433\u043E
      \u0438\u043C\u0435\u043D\u043D\u043E \u043F\u043E\u0442\u043E\u043C\u0443,
      \u0447\u0442\u043E \u043C\u043E\u043B\u0447\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053397
    m_Localized: "\u041F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u0442\u044C
      \u0431\u0430\u0441\u043A\u0430\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053398
    m_Localized: "\u0412\u044B \u043D\u0430\u0448\u043B\u0438 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0431\u0430\u0441\u043A\u0430\u043A\u0430 \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430.
      \u0421\u043B\u043E\u0432\u043E \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u0438
      \u0441\u0434\u0435\u0440\u0436\u0430\u043D\u043D\u043E, \u0431\u0435\u0437
      \u0438\u043C\u0451\u043D. \u0427\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u0442\u0441\u044F
      \u0441 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0449\u0438\u043A\u0430\u043C\u0438
      - \u043D\u0435 \u0432\u0430\u0448\u0435 \u0434\u0435\u043B\u043E. \u0427\u0435\u0440\u0435\u0437
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0434\u043D\u0435\u0439
      \u043F\u0440\u0438\u0434\u0451\u0442 \u043E\u0442\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053399
    m_Localized: "\u041F\u0440\u043E\u043C\u043E\u043B\u0447\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053400
    m_Localized: "\u0412\u044B \u0434\u043E\u043F\u0438\u043B\u0438 \u0447\u0430\u0439
      \u0438 \u043B\u0435\u0433\u043B\u0438 \u0441\u043F\u0430\u0442\u044C. \u0427\u0443\u0436\u0438\u0435
      \u0434\u0435\u043B\u0430 \u043D\u0430 \u0447\u0443\u0436\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0435.
      \u0423\u0442\u0440\u043E\u043C \u0431\u0430\u0437\u0430\u0440 \u0433\u0443\u0434\u0435\u043B
      \u043E\u0431\u044B\u0447\u043D\u043E - \u0437\u043D\u0430\u0447\u0438\u0442,
      \u043F\u043E\u043A\u0430 \u043E\u0431\u043E\u0448\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053401
    m_Localized: "\u041E\u0442\u0432\u0435\u0442 \u0431\u0430\u0441\u043A\u0430\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053402
    m_Localized: "\u0423 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E \u0434\u0432\u043E\u0440\u0430
      \u0441\u043B\u0443\u0433\u0430 \u0431\u0430\u0441\u043A\u0430\u043A\u0430 \u043D\u0430\u0433\u043E\u043D\u044F\u0435\u0442
      \u0432\u0430\u0441 \u0441 \u043A\u043E\u0436\u0430\u043D\u043E\u0439 \u0441\u0443\u043C\u043E\u0439.
      \u0418\u043B\u0438 \u0437\u0430\u0433\u043E\u0432\u043E\u0440\u0449\u0438\u043A\u0438
      - \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438
      \u043E\u0442 \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u0443\u0437\u043D\u0430\u043B
      \u043F\u0435\u0440\u0432\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053403
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043D\u0430\u0433\u0440\u0430\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053404
    m_Localized: "\u0421\u043B\u0443\u0433\u0430 \u0432\u0440\u0443\u0447\u0430\u0435\u0442
      \u0441\u0443\u043C: \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0438 \u0431\u0443\u043C\u0430\u0433\u0443 \u0441 \u043F\u0435\u0447\u0430\u0442\u044C\u044E
      - \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0439 \u043F\u0440\u043E\u0445\u043E\u0434
      \u0447\u0435\u0440\u0435\u0437 \u0442\u0440\u0438 \u0437\u0430\u0441\u0442\u0430\u0432\u044B.
      <npc_speech lang=\"Old_Turkic\">\u0411\u0438\u043B\u044C\u0433\u044D-\u0431\u0435\u0433
      \u043F\u043E\u043C\u043D\u0438\u0442 \u0441\u0432\u043E\u0438\u0445.</npc_speech>
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0434\u043E\u043D\u043E\u0441\u0447\u0438\u043A\u0430
      \u0438\u043B\u0438 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0433\u043E
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 - \u0437\u0430\u0432\u0438\u0441\u0438\u0442
      \u043E\u0442 \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053405
    m_Localized: "\u0417\u0430\u0433\u043E\u0432\u043E\u0440\u0449\u0438\u043A\u0438
      \u043E\u0442\u043E\u043C\u0441\u0442\u0438\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053406
    m_Localized: "\u041D\u043E\u0447\u044C\u044E \u043A\u0442\u043E-\u0442\u043E
      \u0431\u0440\u043E\u0441\u0438\u043B \u043A\u0430\u043C\u0435\u043D\u044C \u0432
      \u043A\u0440\u044B\u0442\u0443\u044E \u043F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0438 \u043F\u043E\u0440\u0435\u0437\u0430\u043B \u0443\u043F\u0440\u044F\u0436\u044C.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B
      - \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435,
      \u043D\u0435 \u0440\u0430\u0441\u043F\u0440\u0430\u0432\u0430. \u0417\u0430\u0433\u043E\u0432\u043E\u0440\u0449\u0438\u043A\u0438
      \u0432\u044B\u0447\u0438\u0441\u043B\u0438\u043B\u0438 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A.
      \u0415\u0445\u0430\u0442\u044C \u043B\u0443\u0447\u0448\u0435 \u0431\u044B\u0441\u0442\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053407
    m_Localized: "\u0420\u0430\u0431 \u0443 \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u0433\u043E
      \u0432\u043E\u0436\u0434\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053408
    m_Localized: "\u041B\u0430\u0433\u0435\u0440\u044C \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u0433\u043E
      \u0432\u043E\u0436\u0434\u044F \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D\u0430
      \u0443 \u0442\u0440\u0430\u043A\u0442\u0430 - \u044E\u0440\u0442\u044B, \u043A\u043E\u043D\u0438,
      \u0437\u0430\u043F\u0430\u0445 \u0433\u043E\u0440\u044F\u0449\u0435\u0433\u043E
      \u043A\u0438\u0437\u044F\u043A\u0430. \u0421\u0440\u0435\u0434\u0438 \u0441\u043B\u0443\u0433
      \u0432\u044B \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442\u0435 \u0441\u043E\u0433\u0434\u0438\u0439\u0446\u0430:
      \u043E\u0434\u0435\u0436\u0434\u0430 \u0440\u0432\u0430\u043D\u0430\u044F,
      \u043B\u0438\u0446\u043E \u043E\u043F\u0443\u0445\u0448\u0435\u0435, \u043D\u043E
      \u043E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043F\u0440\u044F\u043C\u043E.
      \u041B\u043E\u0432\u0438\u0442 \u0432\u0430\u0448 \u0432\u0437\u0433\u043B\u044F\u0434.
      <npc_speech lang=\"Sogdian\">\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u0438\u0437 \u041A\u0435\u0448\u0430. \u0422\u0440\u0438 \u0433\u043E\u0434\u0430.
      \u041F\u0440\u043E\u0448\u0443 - \u0432\u044B\u043A\u0443\u043F\u0438. \u041E\u0442\u0440\u0430\u0431\u043E\u0442\u0430\u044E
      \u0432\u0441\u0451, \u0447\u0442\u043E \u0441\u043A\u0430\u0436\u0435\u0448\u044C.</npc_speech>
      \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D \u043D\u0430\u0437\u043D\u0430\u0447\u0430\u0435\u0442
      \u0446\u0435\u043D\u0443: \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432. \u042D\u0442\u043E \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u044C
      \u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u043E\u0431\u043E\u0440\u043E\u0442\u0430. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0441\u043E \u0437\u043D\u0430\u043D\u0438\u0435\u043C \u043C\u0435\u0441\u0442\u043D\u044B\u0445
      \u0434\u043E\u0440\u043E\u0433 \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0433\u043E,
      \u0438 \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442, \u0441\u0443\u0434\u044F
      \u043F\u043E \u0432\u0437\u0433\u043B\u044F\u0434\u0443, \u0437\u043D\u0430\u0435\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053409
    m_Localized: "\u0412\u044B\u043A\u0443\u043F\u0438\u0442\u044C \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053410
    m_Localized: "\u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043F\u0435\u0440\u0435\u0448\u043B\u0438 \u043A \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D\u0443.
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0441\u0442\u0430\u0440\u044B\u0439 \u0445\u0430\u043B\u0430\u0442 \u0438\u0437
      \u0432\u0430\u0448\u0435\u0433\u043E \u0437\u0430\u043F\u0430\u0441\u0430 \u0438
      \u043C\u0435\u0441\u0442\u043E \u0443 \u043F\u043E\u0432\u043E\u0437\u043A\u0438.
      \u0413\u043B\u0430\u0437\u0430 \u043E\u043F\u0443\u0441\u0442\u0438\u043B -
      \u043D\u0435 \u043E\u0442 \u0441\u0442\u044B\u0434\u0430, \u043E\u0442 \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u0438.
      \u0427\u0442\u043E \u043E\u043D \u0441\u0442\u043E\u0438\u0442 - \u043F\u043E\u043A\u0430\u0436\u0443\u0442
      \u0434\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053411
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043E\u0442
      \u0432\u044B\u043A\u0443\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053412
    m_Localized: "\u0412\u044B \u043E\u0442\u0432\u0435\u043B\u0438 \u0432\u0437\u0433\u043B\u044F\u0434.
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043F\u043E\u043D\u044F\u043B
      - \u043F\u043B\u0435\u0447\u0438 \u043E\u043F\u0430\u043B\u0438. \u041A\u044E\u043B\u044C-\u0422\u0435\u0433\u0438\u043D
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043A \u0441\u0432\u043E\u0438\u043C
      \u0434\u0435\u043B\u0430\u043C. \u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0446\u0435\u043B\u044B,
      \u043D\u043E \u0434\u043E\u0440\u043E\u0433\u0430 \u043E\u0442 \u043B\u0430\u0433\u0435\u0440\u044F
      \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u0434\u043B\u0438\u043D\u043D\u0435\u0435
      \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053413
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043D\u0430 \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053414
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u0434\u0435\u0441\u044F\u0442\u044C
      \u0434\u043D\u0435\u0439 \u043F\u0443\u0442\u0438 \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043A \u0432\u0430\u043C
      \u043F\u0435\u0440\u0432\u044B\u043C - \u0441 \u043A\u0443\u0441\u043A\u043E\u043C
      \u043E\u0431\u0442\u044F\u043D\u0443\u0442\u043E\u0439 \u043A\u043E\u0436\u0435\u0439
      \u0449\u0435\u043F\u043A\u0438, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u043F\u0440\u043E\u0446\u0430\u0440\u0430\u043F\u0430\u043D\u0430 \u043A\u0430\u0440\u0442\u0430
      \u0442\u0440\u043E\u043F. \u041E\u0434\u0438\u043D \u0438\u0437 \u0434\u0432\u0443\u0445
      \u0438\u0441\u0445\u043E\u0434\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053415
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0441\u0442\u0430\u043B
      \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053416
    m_Localized: "<npc_speech lang=\"Sogdian\">\u042F \u0437\u043D\u0430\u044E \u0432\u0441\u0435
      \u0431\u0440\u043E\u0434\u044B \u0434\u043E \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430.
      \u0418 \u0442\u0440\u0438 \u0442\u0440\u043E\u043F\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043D\u0435\u0442 \u043D\u0430 \u0433\u0443\u0430\u043D\u044C\u0434\u0438\u0435.</npc_speech>
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0442\u0435\u043C, \u0447\u0435\u043C \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B:
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u043C \u0430\u0433\u0435\u043D\u0442\u043E\u043C,
      \u043F\u043E\u0442\u0435\u0440\u044F\u0432\u0448\u0438\u043C \u0445\u043E\u0437\u044F\u0438\u043D\u0430.
      \u041A\u0430\u0440\u0442\u0430 \u0442\u043E\u0447\u043D\u0430\u044F, \u043E\u0431\u0445\u043E\u0434\u044B
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0435. \u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u043E\u0442\u0431\u0438\u043B\u0438\u0441\u044C
      \u0437\u0430 \u043F\u0435\u0440\u0432\u0443\u044E \u0436\u0435 \u043D\u0435\u0434\u0435\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053417
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0438\u0441\u0447\u0435\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053418
    m_Localized: "\u041D\u0430 \u0434\u0435\u0441\u044F\u0442\u0443\u044E \u043D\u043E\u0447\u044C
      \u0435\u0433\u043E \u043C\u0435\u0441\u0442\u043E \u0443 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043F\u0443\u0441\u0442\u043E. \u041D\u0438 \u0437\u0430\u043F\u0438\u0441\u043A\u0438,
      \u043D\u0438 \u0441\u043B\u043E\u0432\u0430 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430\u043C.
      \u0418\u0441\u0447\u0435\u0437 - \u043A\u0430\u043A \u0438 \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u043E
      \u043E\u0436\u0438\u0434\u0430\u0442\u044C \u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
      \u043F\u0440\u0438\u0432\u044B\u043A\u0448\u0435\u0433\u043E \u0432\u044B\u0436\u0438\u0432\u0430\u0442\u044C
      \u0432 \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0443. \u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0441\u0442\u0430\u043B\u0438
      \u043F\u043B\u0430\u0442\u043E\u0439 \u0437\u0430 \u0445\u043E\u0440\u043E\u0448\u0438\u0439
      \u043D\u043E\u0447\u043D\u043E\u0439 \u043E\u0442\u0434\u044B\u0445 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0431\u044B\u0432\u0448\u0435\u0433\u043E \u0440\u0430\u0431\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053419
    m_Localized: "\u0421\u0430\u043A\u043A \u0431\u0435\u0437 \u0437\u0430\u043B\u043E\u0433\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053420
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      \u043F\u0430\u0445\u043D\u0435\u0442 \u0440\u043E\u0437\u043E\u0432\u044B\u043C
      \u043C\u0430\u0441\u043B\u043E\u043C \u0438 \u0433\u043E\u0440\u044F\u0447\u0438\u043C
      \u043E\u043B\u043E\u0432\u043E\u043C - \u043C\u0435\u043D\u044F\u043B\u044B
      \u0447\u0435\u043A\u0430\u043D\u044F\u0442 \u0434\u0438\u0440\u0445\u0430\u043C\u044B
      \u043F\u043E\u0434 \u043D\u0430\u0432\u0435\u0441\u0430\u043C\u0438. \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u0431\u0430\u043D\u043A\u0438\u0440 \u0411\u0430\u0445\u0440\u0430\u043C,
      \u0432 \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u043E\u043C \u0448\u0451\u043B\u043A\u0435
      \u0441 \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u044B\u043C \u043F\u043E\u044F\u0441\u043E\u043C,
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u043F\u0435\u0440\u0432\u044B\u043C
      \u0438 \u043A\u043B\u0430\u0434\u0451\u0442 \u043F\u0435\u0440\u0435\u0434
      \u0432\u0430\u043C\u0438 \u0441\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0439
      \u043B\u0438\u0441\u0442 \u0431\u0443\u043C\u0430\u0433\u0438. <npc_speech
      lang=\"Sogdian\">\u0412\u043E\u0441\u0435\u043C\u044C\u0434\u0435\u0441\u044F\u0442
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 - \u0441\u0430\u043A\u043A
      \u043D\u0430 \u041C\u0435\u0440\u0432. \u0411\u0435\u0437 \u0437\u0430\u043B\u043E\u0433\u0430.
      \u0418\u043C\u044F \u0447\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0436\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u0430.</npc_speech>
      \u0410\u043A\u043A\u0440\u0435\u0434\u0438\u0442\u0438\u0432 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0434\u0432\u0435\u0440\u0438 \u043B\u044E\u0431\u043E\u0433\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0433\u043E
      \u0434\u043E\u043C\u0430 \u043D\u0430 \u043F\u0443\u0442\u0438 \u0434\u043E
      \u041C\u0435\u0440\u0432\u0430. \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0435
      \u0441\u0430\u043A\u043A-\u0441\u0435\u0442\u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F
      \u043D\u0430 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438 - \u0411\u0430\u0445\u0440\u0430\u043C
      \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u043B \u0432\u0430\u0441 \u0447\u0435\u0440\u0435\u0437
      \u0442\u0440\u0451\u0445 \u043A\u0443\u043F\u0446\u043E\u0432, \u043F\u0440\u0435\u0436\u0434\u0435
      \u0447\u0435\u043C \u043F\u043E\u0434\u043E\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053421
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0441\u0430\u043A\u043A
      \u043D\u0430 80 \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053422
    m_Localized: "\u0411\u0430\u0445\u0440\u0430\u043C \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u043A\u0440\u0443\u0433\u043B\u0443\u044E \u0441\u0432\u0438\u043D\u0446\u043E\u0432\u0443\u044E
      \u043F\u0435\u0447\u0430\u0442\u044C. \u0421\u0430\u043A\u043A - \u043D\u0435
      \u043C\u043E\u043D\u0435\u0442\u044B, \u043E\u043D \u043B\u0435\u0433\u0447\u0435
      \u0438 \u043D\u0430\u0434\u0451\u0436\u043D\u0435\u0435: \u043F\u0440\u0435\u0434\u044A\u044F\u0432\u0438\u0448\u044C
      \u0432 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C \u0434\u043E\u043C\u0435
      \u041C\u0435\u0440\u0432\u0430, \u043F\u043E\u043B\u0443\u0447\u0438\u0448\u044C
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E. \u0422\u0435, \u043A\u0442\u043E
      \u0437\u043D\u0430\u044E\u0442 \u0411\u0430\u0445\u0440\u0430\u043C\u0430,
      \u0434\u043E\u0432\u0435\u0440\u044F\u044E\u0442 \u0438 \u0432\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053423
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043B\u0438\u0448\u044C \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u0441\u0443\u043C\u043C\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053424
    m_Localized: "\u0421\u043E\u0440\u043E\u043A \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      - \u043C\u0435\u043D\u044C\u0448\u0438\u0439 \u0434\u043E\u043B\u0433, \u043C\u0435\u043D\u044C\u0448\u0438\u0439
      \u0440\u0438\u0441\u043A. \u0411\u0430\u0445\u0440\u0430\u043C \u043A\u0438\u0432\u043D\u0443\u043B
      \u0431\u0435\u0437 \u0443\u0434\u0438\u0432\u043B\u0435\u043D\u0438\u044F:
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u0439 \u043A\u0443\u043F\u0435\u0446
      \u0436\u0438\u0432\u0451\u0442 \u0434\u043E\u043B\u044C\u0448\u0435. \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043D\u0430\u0432\u044B\u043A \u0440\u0430\u0441\u0442\u0451\u0442, \u043A\u043E\u0433\u0434\u0430
      \u043F\u043E\u043D\u0438\u043C\u0430\u0435\u0448\u044C \u043A\u043E\u0433\u0434\u0430
      \u043D\u0435 \u0436\u0430\u0434\u043D\u0438\u0447\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053425
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u043E \u043E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053426
    m_Localized: "\u0411\u0430\u0445\u0440\u0430\u043C \u0443\u0431\u0440\u0430\u043B
      \u0431\u0443\u043C\u0430\u0433\u0443 \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B.
      \u041E\u0442\u043A\u0430\u0437 \u043E\u0442 \u0434\u043E\u043B\u0433\u0430
      - \u0442\u043E\u0436\u0435 \u0437\u043D\u0430\u043A \u0440\u0430\u0437\u0443\u043C\u043D\u043E\u0441\u0442\u0438.
      \u0421\u043B\u0443\u0445 \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0432\u044B
      \u043D\u0435 \u0431\u0435\u0440\u0451\u0442\u0435 \u0441\u0432\u0435\u0440\u0445
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0433\u043E, \u0440\u0430\u0437\u043E\u0448\u0451\u043B\u0441\u044F
      \u043F\u043E \u0440\u044B\u043D\u043A\u0443 \u0440\u0430\u043D\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u043B\u0441\u044F
      \u0431\u0430\u0437\u0430\u0440\u043D\u044B\u0439 \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053427
    m_Localized: "\u041F\u0438\u0440 \u0443 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0430
      \u0427\u044D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053428
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0443\u043A\u0441\u0443\u0441\u043D\u043E\u0439
      \u0441\u0432\u0438\u043D\u0438\u043D\u044B \u0438 \u0438\u043C\u0431\u0438\u0440\u044F
      \u0442\u044F\u043D\u0435\u0442\u0441\u044F \u0438\u0437 \u0440\u0430\u0441\u043F\u0430\u0445\u043D\u0443\u0442\u044B\u0445
      \u0432\u043E\u0440\u043E\u0442 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u0441\u043A\u043E\u0439
      \u0443\u043F\u0440\u0430\u0432\u044B \u0432 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0435.
      \u0427\u0438\u043D\u043E\u0432\u043D\u0438\u043A \u0432 \u0441\u0438\u043D\u0435\u0439
      \u0447\u0438\u043D\u043E\u0432\u043D\u0438\u0447\u044C\u0435\u0439 \u0440\u043E\u0431\u0435
      \u0441 \u0431\u0435\u043B\u044B\u043C \u0446\u0430\u043F\u043B\u044F\u043D\u044B\u043C
      \u043D\u0430\u0448\u0438\u0432\u043D\u044B\u043C \u0437\u043D\u0430\u043A\u043E\u043C
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442 \u0443 \u0432\u043E\u0440\u043E\u0442:
      <npc_speech lang=\"Chinese\">\u0426\u0437\u0435\u0434\u0443\u0448\u0438 \u0427\u044D\u043D\u044C
      \u0412\u044D\u0439 \u0441\u043B\u044B\u0448\u0430\u043B \u043E \u0432\u0430\u0448\u0435\u043C
      \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C \u043F\u0443\u0442\u0438.
      \u041E\u043D \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0430\u0435\u0442 \u043D\u0430
      \u043F\u0438\u0440 - \u0432 \u0447\u0435\u0441\u0442\u044C \u043A\u0443\u043F\u0446\u0430,
      \u0447\u044C\u0451 \u0438\u043C\u044F \u043D\u0435 \u0442\u0440\u0435\u043F\u0435\u0449\u0435\u0442
      \u043F\u0435\u0440\u0435\u0434 \u0441\u0442\u0440\u0430\u0436\u0435\u0439.</npc_speech>
      \u041F\u0438\u0440 \u0432 \u0441\u0442\u0438\u043B\u0435 \u0442\u0430\u043D\u0441\u043A\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430: \u0432\u043E\u0441\u0435\u043C\u044C \u0431\u043B\u044E\u0434,
      \u043A\u0430\u0439\u044E\u0430\u043D\u044C \u0442\u0443\u043D\u0431\u0430\u043E
      \u0432 \u043A\u0440\u0430\u0441\u043D\u044B\u0445 \u043D\u0438\u0442\u044F\u043D\u044B\u0445
      \u043C\u0435\u0448\u043E\u0447\u043A\u0430\u0445 \u0433\u043E\u0441\u0442\u044F\u043C.
      \u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u0445\u043E\u0447\u0435\u0442
      \u0443\u0437\u043D\u0430\u0442\u044C \u043E \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0445
      \u0434\u043E\u0440\u043E\u0433\u0430\u0445 - \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C
      \u0432\u043B\u0430\u0441\u0442\u044C \u0442\u0435\u043C, \u043A\u0442\u043E
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053429
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u0440\u0438\u0433\u043B\u0430\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053430
    m_Localized: "\u0422\u0440\u0438 \u0447\u0430\u0441\u0430 \u0437\u0430 \u043B\u0430\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u043C
      \u0441\u0442\u043E\u043B\u043E\u043C. \u0427\u044D\u043D\u044C \u0412\u044D\u0439
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B \u043E \u0434\u043E\u0440\u043E\u0433\u0430\u0445,
      \u0432\u044B - \u043E\u0431 \u0443\u0439\u0433\u0443\u0440\u0441\u043A\u0438\u0445
      \u0440\u044B\u043D\u043A\u0430\u0445. \u0414\u0443\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F: \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0443\u0437\u043D\u0430\u043B\u0438, \u0447\u0442\u043E \u0438\u0445 \u043D\u0430\u043D\u044F\u0442\u0435\u043B\u044C
      \u0435\u0441\u0442 \u0441 \u0433\u0443\u0431\u0435\u0440\u043D\u0430\u0442\u043E\u0440\u043E\u043C.
      \u041C\u043E\u043D\u0435\u0442\u044B \u0432 \u043C\u0435\u0448\u043E\u0447\u043A\u0435
      - \u043A\u0430\u0439\u044E\u0430\u043D\u044C \u0442\u0443\u043D\u0431\u0430\u043E,
      \u0447\u0438\u0441\u0442\u043E\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053431
    m_Localized: "\u041F\u0440\u0438\u0439\u0442\u0438 \u0438 \u043F\u0440\u0438\u043D\u0435\u0441\u0442\u0438
      \u043F\u043E\u0434\u0430\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053432
    m_Localized: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0431\u043E\u043B\u0442
      \u0437\u0430\u043F\u0430\u0434\u043D\u043E\u0433\u043E \u0448\u0451\u043B\u043A\u0430
      - \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E. \u0427\u044D\u043D\u044C
      \u0412\u044D\u0439 \u043F\u0440\u0438\u043D\u044F\u043B \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C,
      \u0436\u0435\u0441\u0442 \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u0435\u0442\u0441\u044F.
      \u0413\u0443\u0430\u043D\u044C\u0434\u0438\u0435 \u0432\u043E\u0440\u043E\u0442
      \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0430 \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0440\u0430\u0437 \u043E\u0442\u043A\u0440\u043E\u044E\u0442\u0441\u044F \u0431\u044B\u0441\u0442\u0440\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053433
    m_Localized: "\u0418\u0437\u0432\u0438\u043D\u0438\u0442\u044C\u0441\u044F \u0438
      \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053434
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u044B\u0439 \u043E\u0442\u043A\u0430\u0437.
      \u0427\u044D\u043D\u044C \u0412\u044D\u0439 \u043D\u0435 \u043E\u0431\u0438\u0434\u0435\u043B\u0441\u044F
      - \u043A\u0443\u043F\u0446\u044B \u0441\u043F\u0435\u0448\u0430\u0442. \u0412\u043E\u0440\u043E\u0442\u0430
      \u043F\u0440\u043E\u0448\u043B\u0438 \u0431\u0435\u0437 \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430:
      \u043F\u043E\u0441\u0442 \u0437\u043D\u0430\u0435\u0442, \u0447\u0442\u043E
      \u0446\u0437\u0435\u0434\u0443\u0448\u0438 \u0441\u0430\u043C \u0437\u0432\u0430\u043B
      \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053435
    m_Localized: "\u0411\u0438\u043B\u044C\u0433\u044D \u0438\u0449\u0435\u0442 \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053436
    m_Localized: "\u0423 \u043A\u043E\u043D\u043E\u0432\u044F\u0437\u0438 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u0433\u043E
      \u0434\u0432\u043E\u0440\u0430 \u043F\u0430\u0445\u043D\u0435\u0442 \u043A\u043E\u043D\u0441\u043A\u0438\u043C
      \u043F\u043E\u0442\u043E\u043C \u0438 \u0434\u0443\u0431\u043B\u0451\u043D\u043E\u0439
      \u043A\u043E\u0436\u0435\u0439. \u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0439
      \u0432\u043E\u0438\u043D \u0411\u0438\u043B\u044C\u0433\u044D - \u0448\u0440\u0430\u043C
      \u0447\u0435\u0440\u0435\u0437 \u0431\u0440\u043E\u0432\u044C, \u0441\u043E\u0441\u0442\u0430\u0432\u043D\u043E\u0439
      \u043B\u0443\u043A \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 - \u0441\u0442\u043E\u0438\u0442
      \u043F\u0440\u044F\u043C\u043E \u0438 \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0432\u0430\u0441 \u043F\u043E \u0438\u043C\u0435\u043D\u0438 \u0431\u0435\u0437
      \u043F\u0440\u0435\u0434\u0438\u0441\u043B\u043E\u0432\u0438\u0439: <npc_speech
      lang=\"Turkic\">\u042F \u0441\u043B\u044B\u0448\u0430\u043B - \u0442\u044B
      \u043F\u0440\u043E\u0448\u0451\u043B \u041F\u0430\u043C\u0438\u0440 \u0431\u0435\u0437
      \u043F\u043E\u0442\u0435\u0440\u044C. \u041C\u043D\u0435 \u043D\u0443\u0436\u0435\u043D
      \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C, \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443
      \u043D\u0435 \u0441\u0442\u044B\u0434\u043D\u043E \u0441\u043B\u0443\u0436\u0438\u0442\u044C.</npc_speech>
      \u041F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u043B\u0435\u0442
      \u0432 \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u0439 \u043A\u0430\u0432\u0430\u043B\u0435\u0440\u0438\u0438,
      \u0437\u043D\u0430\u0435\u0442 \u0433\u043E\u0440\u043D\u044B\u0435 \u0442\u0440\u043E\u043F\u044B
      \u043E\u0442 \u0424\u0435\u0440\u0433\u0430\u043D\u044B \u0434\u043E \u041A\u0430\u0448\u0433\u0430\u0440\u0430.
      \u041C\u0435\u0441\u0442\u043E \u0432 \u043E\u0445\u0440\u0430\u043D\u0435
      \u043E\u043D \u043F\u0440\u043E\u0441\u0438\u0442 \u0441\u043A\u0440\u043E\u043C\u043D\u043E\u0435
      - \u0441\u043B\u0430\u0432\u0430 \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044F
      \u0432\u0430\u0436\u043D\u0435\u0435 \u043F\u043B\u0430\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053437
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u0411\u0438\u043B\u044C\u0433\u044D"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053438
    m_Localized: "\u0420\u0443\u043A\u043E\u043F\u043E\u0436\u0430\u0442\u0438\u0435
      \u0437\u0430\u043C\u0435\u043D\u0438\u043B\u043E \u0434\u043E\u0433\u043E\u0432\u043E\u0440.
      \u0411\u0438\u043B\u044C\u0433\u044D \u0437\u0430\u043D\u044F\u043B \u043C\u0435\u0441\u0442\u043E
      \u0443 \u0433\u043E\u043B\u043E\u0432\u044B \u043A\u043E\u043B\u043E\u043D\u043D\u044B
      - \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0434\u043B\u044F
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0441\u043D\u0438\u0437\u0438\u043B\u0430\u0441\u044C:
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438 \u0432\u0438\u0434\u044F\u0442
      \u043E\u043F\u044B\u0442\u043D\u043E\u0433\u043E \u0432\u043E\u0438\u043D\u0430
      \u0438 \u0441\u0447\u0438\u0442\u0430\u044E\u0442 \u0440\u0438\u0441\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053439
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u0437\u0430 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u0446\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053440
    m_Localized: "\u0411\u0438\u043B\u044C\u0433\u044D \u043F\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0430\u043B\u0441\u044F
      \u043A\u0440\u0430\u0442\u043A\u043E \u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0441\u044F.
      \u041F\u043E\u043B\u0446\u0435\u043D\u044B - \u0447\u0435\u0441\u0442\u043D\u043E
      \u0434\u043B\u044F \u0438\u0441\u043F\u044B\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u0441\u0440\u043E\u043A\u0430. \u041E\u0445\u0440\u0430\u043D\u0430 \u0441\u0442\u0430\u043B\u0430
      \u043D\u0430\u0434\u0451\u0436\u043D\u0435\u0435, \u0445\u043E\u0442\u044F
      \u0432\u043E\u0438\u043D \u043F\u043E\u043C\u043D\u0438\u0442 \u0442\u043E\u0440\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053441
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053442
    m_Localized: "\u0411\u0438\u043B\u044C\u0433\u044D \u043A\u0438\u0432\u043D\u0443\u043B
      \u0431\u0435\u0437 \u043E\u0431\u0438\u0434\u044B. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0442\u0430\u043A\u043E\u0432\u0430, \u0447\u0442\u043E \u043E\u043D \u0437\u043D\u0430\u0435\u0442
      - \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0432\u044B\u0431\u0438\u0440\u0430\u0442\u044C.
      \u0421\u043B\u043E\u0432\u0430 \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F
      \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C \u043F\u043E \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u043C\u0443
      \u0434\u0432\u043E\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053443
    m_Localized: "\u0426\u0435\u043D\u044B \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053444
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 - \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u043A\u0443\u043F\u0435\u0446 \u0441 \u0437\u0430\u043F\u0430\u0445\u043E\u043C
      \u043C\u0443\u0441\u043A\u0443\u0441\u0430 \u0438 \u043B\u0430\u0434\u0430\u043D\u0430
      \u043E\u0442 \u043E\u0434\u0435\u0436\u0434\u044B - \u043B\u043E\u0432\u0438\u0442
      \u0432\u0430\u0441 \u0443 \u0432\u043E\u0440\u043E\u0442 \u043F\u0435\u0440\u0435\u0434
      \u0432\u044B\u0445\u043E\u0434\u043E\u043C. \u0413\u043E\u0432\u043E\u0440\u0438\u0442
      \u0442\u0438\u0445\u043E, \u043F\u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F
      \u043D\u0430 \u0434\u0440\u0443\u0433\u0438\u0445: <npc_speech lang=\"Sogdian\">\u0428\u0451\u043B\u043A
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435 \u0443\u043F\u0430\u0434\u0451\u0442
      \u0447\u0435\u0440\u0435\u0437 \u0434\u0435\u0441\u044F\u0442\u044C \u0434\u043D\u0435\u0439
      - \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u0439
      \u043E\u0431\u043E\u0437 \u0443\u0436\u0435 \u0438\u0434\u0451\u0442. \u041F\u0440\u043E\u0434\u0430\u0432\u0430\u0439
      \u0441\u0435\u0439\u0447\u0430\u0441.</npc_speech> \u0417\u0430\u043A\u0440\u044B\u0442\u0430\u044F
      \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F,
      \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u0434\u0430\u044E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
      \u0442\u0435\u043C, \u043A\u043E\u043C\u0443 \u0434\u043E\u0432\u0435\u0440\u044F\u044E\u0442.
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043D\u0435 \u043F\u0440\u043E\u0434\u0430\u0451\u0442
      \u0441\u043B\u0443\u0445\u0438 - \u043E\u043D \u0434\u0435\u043B\u0438\u0442\u0441\u044F
      \u0438\u043C\u0438 \u0441 \u043D\u0443\u0436\u043D\u044B\u043C\u0438 \u043B\u044E\u0434\u044C\u043C\u0438
      \u0432 \u043D\u0443\u0436\u043D\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053445
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u0441\u043E\u0432\u0435\u0442\u0443 \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053446
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u043B\u0438 \u0448\u0451\u043B\u043A
      \u0434\u043E \u043E\u0431\u0432\u0430\u043B\u0430. \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u043D\u0435 \u043E\u0448\u0438\u0431\u0441\u044F - \u043D\u0430 \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439
      \u0434\u0435\u043D\u044C \u0446\u0435\u043D\u0430 \u0440\u0443\u0445\u043D\u0443\u043B\u0430,
      \u043A\u0430\u043A \u043E\u043D \u0441\u043A\u0430\u0437\u0430\u043B. \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043D\u0430\u0432\u044B\u043A \u0440\u0430\u0441\u0442\u0451\u0442, \u043A\u043E\u0433\u0434\u0430
      \u0432\u0438\u0434\u0438\u0448\u044C \u0440\u044B\u043D\u043E\u043A \u043D\u0430
      \u0448\u0430\u0433 \u0432\u043F\u0435\u0440\u0451\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053447
    m_Localized: "\u0417\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C \u0441\u043E\u0432\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053448
    m_Localized: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043F\u0440\u0438\u0431\u044B\u043B\u044C
      \u043E\u0442 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E\u0439 \u043F\u0440\u043E\u0434\u0430\u0436\u0438.
      \u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0440\u0430\u0437\u0443\u043C\u043D\u0430
      - \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u043C\u0438\u0440 \u043F\u043E\u043B\u043E\u043D
      \u043B\u043E\u0436\u043D\u044B\u0445 \u0441\u043B\u0443\u0445\u043E\u0432.
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0437\u0430\u043C\u0435\u0442\u0438\u043B:
      \u0432\u044B \u0443\u043C\u0435\u0435\u0442\u0435 \u0441\u043B\u0443\u0448\u0430\u0442\u044C,
      \u043D\u043E \u043D\u0435 \u0441\u043B\u0435\u043F\u043E \u0434\u043E\u0432\u0435\u0440\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053449
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438 \u043F\u0440\u043E\u0441\u044F\u0442
      \u0437\u0430\u0449\u0438\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053450
    m_Localized: "\u0421\u0435\u043C\u0435\u0440\u043E \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u043E\u0432-\u0431\u0443\u0434\u0434\u0438\u0441\u0442\u043E\u0432
      \u0441 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u043C\u0438 \u0447\u0451\u0442\u043A\u0430\u043C\u0438
      \u0438 \u0438\u0437\u043D\u043E\u0448\u0435\u043D\u043D\u044B\u043C\u0438 \u0441\u0430\u043D\u0434\u0430\u043B\u0438\u044F\u043C\u0438
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044E\u0442
      \u043E\u0431\u043E\u0437 \u0443 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u043C\u043E\u043D\u0430\u0445 \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u043B\u0441\u044F
      \u0442\u0440\u0438\u0436\u0434\u044B \u043F\u0435\u0440\u0435\u0434 \u0441\u043B\u043E\u0432\u0430\u043C\u0438:
      <npc_speech lang=\"Chinese\">\u0414\u043E\u0440\u043E\u0433\u0430 \u0434\u043E
      \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0430 \u043E\u043F\u0430\u0441\u043D\u0430.
      \u041C\u044B \u0441\u043B\u044B\u0448\u0430\u043B\u0438 \u043E \u0432\u0430\u0448\u0435\u043C
      \u0438\u043C\u0435\u043D\u0438 \u043E\u0442 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0442\u0440\u0451\u0445 \u043F\u0440\u043E\u0448\u043B\u044B\u0445 \u043E\u0431\u043E\u0437\u043E\u0432.
      \u041F\u043E\u0437\u0432\u043E\u043B\u044C\u0442\u0435 \u0438\u0434\u0442\u0438
      \u0440\u044F\u0434\u043E\u043C.</npc_speech> \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438
      \u043D\u0435\u0441\u0443\u0442 \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u0443\u044E
      \u0441\u0442\u0430\u0442\u0443\u044D\u0442\u043A\u0443 \u0413\u0443\u0430\u043D\u044C\u0438\u043D\u044C
      - \u043F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0435 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044E
      \u043F\u0435\u0449\u0435\u0440 \u041C\u043E\u0433\u0430\u043E. \u041F\u0443\u0442\u044C
      \u0441 \u043D\u0438\u043C\u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435,
      \u043D\u043E \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u0430: \u043E\u043D\u0438
      \u0437\u043D\u0430\u044E\u0442 \u0442\u0430\u0439\u043D\u044B\u0435 \u0432\u043E\u0434\u043E\u043F\u043E\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053451
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043F\u043E\u0434 \u0437\u0430\u0449\u0438\u0442\u0443
      \u0431\u0435\u0441\u043F\u043B\u0430\u0442\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053452
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438 \u0448\u043B\u0438
      \u0442\u0438\u0445\u043E, \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0438
      \u0434\u0432\u0430 \u0441\u043A\u0440\u044B\u0442\u044B\u0445 \u0432\u043E\u0434\u043E\u043F\u043E\u044F.
      \u0423 \u0432\u043E\u0440\u043E\u0442 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0430
      \u043C\u043E\u043D\u0430\u0445 \u0434\u0430\u043B \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u0432\u0441\u043B\u0443\u0445 - \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0438
      \u0441\u043B\u044B\u0448\u0430\u043B\u0438. \u0418\u043C\u044F \u0441\u0442\u0430\u043B\u043E
      \u0447\u0438\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053453
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0437\u0430 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0443\u044E
      \u043F\u043B\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053454
    m_Localized: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u043E
      \u0438 \u0442\u0430\u0439\u043D\u044B\u0439 \u0432\u043E\u0434\u043E\u043F\u043E\u0439
      - \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u044B\u0439
      \u043E\u0431\u043C\u0435\u043D. \u041C\u043E\u043D\u0430\u0445 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B
      \u0431\u0435\u0437 \u0432\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0439:
      \u043E\u043D \u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u043E\u0445\u0440\u0430\u043D\u0430
      \u0441\u0442\u043E\u0438\u0442 \u0434\u0435\u043D\u0435\u0433."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053455
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u043A\u0430\u0436\u0434\u044B\u0439
      \u0434\u0435\u043D\u044C \u0432\u0430\u0436\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053456
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0438 \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u043B\u0438\u0441\u044C
      \u0438 \u043F\u043E\u0448\u043B\u0438 \u0441\u0430\u043C\u0438. \u0421\u043B\u0443\u0445
      \u0440\u0430\u0437\u043E\u0448\u0451\u043B\u0441\u044F \u0441\u0440\u0435\u0434\u0438
      \u0432\u0441\u0442\u0440\u0435\u0447\u043D\u044B\u0445 \u043E\u0431\u043E\u0437\u043E\u0432:
      \u043A\u0443\u043F\u0435\u0446 \u0441\u043F\u0435\u0448\u0438\u0442, \u043D\u043E
      \u0432\u0435\u0436\u043B\u0438\u0432. \u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u043F\u043E\u0442\u0435\u0440\u044F \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053457
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0431\u0435\u0437 \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053458
    m_Localized: "\u041F\u043E\u0441\u0442 \u043D\u0430 \u0432\u044B\u0435\u0437\u0434\u0435
      \u0438\u0437 \u041C\u0435\u0440\u0432\u0430. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u0432 \u0432\u043E\u0439\u043B\u043E\u0447\u043D\u043E\u0439 \u0448\u0430\u043F\u043A\u0435
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043E\u043F\u0438\u0441\u044C
      \u0433\u0440\u0443\u0437\u0430, \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0433\u043B\u0430\u0437\u0430: <npc_speech lang=\"Persian\">\u0412\u0430\u0448\u0435
      \u0438\u043C\u044F \u044F \u0441\u043B\u044B\u0448\u0430\u043B \u043E\u0442
      \u043A\u0443\u043F\u0446\u043E\u0432 \u0438\u0437 \u0411\u0443\u0445\u0430\u0440\u044B.
      \u041F\u0440\u043E\u0435\u0437\u0436\u0430\u0439\u0442\u0435 - \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044C
      \u043D\u0435\u0447\u0435\u0433\u043E.</npc_speech> \u0417\u0430 \u0441\u043F\u0438\u043D\u043E\u0439
      \u0434\u0432\u0443\u0445 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432
      \u0438\u0437 \u0411\u0430\u043B\u0445\u0430 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044E\u0442
      \u0438 \u0432\u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0442\u044E\u043A\u0438.
      \u0412\u0430\u0441 \u043F\u0440\u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442
      \u0432\u043F\u0435\u0440\u0451\u0434 \u0431\u0435\u0437 \u0441\u043B\u043E\u0432\u0430.
      \u0427\u0435\u0441\u0442\u043D\u0430\u044F \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      - \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F, \u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u043D\u0435 \u043A\u0443\u043F\u0438\u0448\u044C \u043D\u0438 \u043D\u0430
      \u043E\u0434\u043D\u043E\u043C \u0440\u044B\u043D\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053459
    m_Localized: "\u041F\u0440\u043E\u0435\u0445\u0430\u0442\u044C \u0438 \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053460
    m_Localized: "\u0412\u0435\u0436\u043B\u0438\u0432\u044B\u0439 \u043A\u0438\u0432\u043E\u043A
      \u0438 \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439 \u0432\u044B\u0435\u0437\u0434.
      \u0414\u0435\u043D\u044C \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D -
      \u0437\u0430 \u0442\u043E \u0436\u0435 \u0432\u0440\u0435\u043C\u044F \u0434\u0440\u0443\u0433\u0438\u0435
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B \u0432\u0441\u0451 \u0435\u0449\u0451
      \u0441\u0442\u043E\u044F\u0442 \u0443 \u0432\u043E\u0440\u043E\u0442. \u041F\u0440\u0438\u0432\u0430\u043B
      \u0440\u0430\u043D\u044C\u0448\u0435, \u043D\u0430 \u043B\u0443\u0447\u0448\u0435\u043C
      \u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053461
    m_Localized: "\u041F\u0440\u043E\u0435\u0445\u0430\u0442\u044C \u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043F\u043E\u0434\u0430\u0440\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053462
    m_Localized: "\u0413\u043E\u0440\u0441\u0442\u044C \u0444\u0438\u043D\u0438\u043A\u043E\u0432
      \u043D\u0430 \u043E\u043F\u043E\u0440\u043D\u044B\u0439 \u043A\u0430\u043C\u0435\u043D\u044C
      \u0432\u043E\u0440\u043E\u0442 - \u043D\u0435 \u0432\u0437\u044F\u0442\u043A\u0430,
      \u0436\u0435\u0441\u0442 \u043F\u0440\u0438\u0437\u043D\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438.
      \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442
      \u043B\u0438\u0446\u043E. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u043F\u0440\u043E\u0435\u0437\u0434 \u0442\u043E\u0436\u0435 \u0431\u0443\u0434\u0435\u0442
      \u0431\u044B\u0441\u0442\u0440\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053463
    m_Localized: "\u041A\u0443\u043C\u044B\u0441 \u043E\u0442 \u0432\u043E\u0436\u0434\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053464
    m_Localized: "\u0412\u0435\u0447\u0435\u0440\u043E\u043C \u0443 \u0441\u0442\u043E\u044F\u043D\u043A\u0438
      \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043A\u043E\u043D\u043D\u044B\u0439
      \u043F\u043E\u0441\u043B\u0430\u043D\u043D\u0438\u043A \u0441 \u043A\u043E\u0436\u0430\u043D\u044B\u043C
      \u0431\u0443\u0440\u0434\u044E\u043A\u043E\u043C: \u0437\u043D\u0430\u043A
      \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F \u043E\u0442 \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u0433\u043E
      \u0432\u043E\u0436\u0434\u044F \u0422\u0435\u0433\u0438\u043D\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0438\u0442 \u0435\u0433\u043E \u0441\u043B\u043E\u0432\u0430:
      <npc_speech lang=\"Turkic\">\u0412\u043E\u0436\u0434\u044C \u0441\u043B\u044B\u0448\u0430\u043B,
      \u0447\u0442\u043E \u043E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B
      \u0431\u0435\u0437 \u043E\u0431\u043C\u0430\u043D\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0437\u0435\u043C\u043B\u0438 \u0422\u0435\u0433\u0438\u043D\u0430 \u0432
      \u043F\u0440\u043E\u0448\u043B\u044B\u0439 \u0433\u043E\u0434. \u041A\u0443\u043C\u044B\u0441
      - \u043D\u0435 \u043F\u043B\u0430\u0442\u0430. \u042D\u0442\u043E \u043F\u0430\u043C\u044F\u0442\u044C.</npc_speech>
      \u041A\u0443\u043C\u044B\u0441 \u0438\u0437 \u043A\u043E\u0431\u044B\u043B\u044C\u0435\u0433\u043E
      \u043C\u043E\u043B\u043E\u043A\u0430, \u0447\u0443\u0442\u044C \u043A\u0438\u0441\u043B\u044B\u0439
      \u0438 \u043A\u0440\u0435\u043F\u043A\u0438\u0439 - \u043D\u0430\u043F\u0438\u0442\u043E\u043A
      \u0441\u0442\u0435\u043F\u043D\u044B\u0445 \u0441\u043E\u044E\u0437\u043E\u0432.
      \u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C \u0435\u0433\u043E \u0441
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430\u043C\u0438 \u0437\u043D\u0430\u0447\u0438\u0442
      \u0441\u043A\u0440\u0435\u043F\u0438\u0442\u044C \u0434\u043E\u0432\u0435\u0440\u0438\u0435
      \u0431\u0435\u0437 \u0441\u043B\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053465
    m_Localized: "\u0420\u0430\u0437\u0434\u0435\u043B\u0438\u0442\u044C \u0441 \u043A\u043E\u043C\u0430\u043D\u0434\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053466
    m_Localized: "\u0411\u0443\u0440\u0434\u044E\u043A \u043F\u043E\u0448\u0451\u043B
      \u043F\u043E \u043A\u0440\u0443\u0433\u0443 \u0443 \u043A\u043E\u0441\u0442\u0440\u0430.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u0438\u043B\u0438
      \u043C\u043E\u043B\u0447\u0430 \u0438 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E
      - \u0437\u043D\u0430\u043A, \u0447\u0442\u043E \u0446\u0435\u043D\u044F\u0442
      \u0436\u0435\u0441\u0442. \u0414\u0443\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F \u043A\u0440\u0435\u043F\u0447\u0435,
      \u0447\u0435\u043C \u043E\u0442 \u043B\u044E\u0431\u043E\u0439 \u0440\u0435\u0447\u0438
      \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053467
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0438 \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053468
    m_Localized: "\u041F\u043E\u0441\u043B\u0430\u043D\u043D\u0438\u043A\u0443 \u0432\u0435\u0440\u043D\u0443\u043B\u0438
      \u043F\u0443\u0441\u0442\u043E\u0439 \u0431\u0443\u0440\u0434\u044E\u043A \u0438
      \u043F\u043E\u0436\u0435\u043B\u0430\u043D\u0438\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
      \u0432\u043E\u0436\u0434\u044E. \u041C\u0430\u043B\u044B\u0439 \u0436\u0435\u0441\u0442
      \u0445\u043E\u0440\u043E\u0448\u0435\u0433\u043E \u0442\u043E\u043D\u0430 -
      \u0442\u044E\u0440\u043A\u0438 \u043F\u043E\u043C\u043D\u044F\u0442 \u043E\u0431\u0435
      \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u043E\u0431\u043C\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053469
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u043F\u0440\u0435\u0434\u043F\u043E\u0447\u0438\u0442\u0430\u044E
      \u043D\u0430\u043B\u0438\u0447\u043D\u044B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053470
    m_Localized: "\u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F
      - \u043D\u0435 \u043A\u0430\u0436\u0434\u044B\u0439 \u043A\u0443\u043F\u0435\u0446
      \u0443\u043C\u0435\u0435\u0442 \u0432\u043E\u0432\u0440\u0435\u043C\u044F \u0441\u043A\u0430\u0437\u0430\u0442\u044C
      \u043D\u0435\u0442. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0433\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430
      \u0442\u043E\u0436\u0435 \u0438\u043C\u0435\u0435\u0442 \u0446\u0435\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053471
    m_Localized: "\u041A\u0430\u0440\u0442\u0430 \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u043E\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053472
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u043A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444
      \u043B\u0435\u0436\u0438\u0442 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
      \u043D\u0430 \u0442\u044E\u043A\u0435 - \u0435\u0433\u043E \u043C\u0443\u043B
      \u0441\u0442\u043E\u0438\u0442 \u0440\u044F\u0434\u043E\u043C, \u0431\u0443\u0440\u0434\u044E\u043A
      \u043F\u0443\u0441\u0442\u043E\u0439. \u0416\u0430\u0440. \u0420\u0443\u043A\u0430
      \u043D\u0430\u0449\u0443\u043F\u044B\u0432\u0430\u0435\u0442 \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A, \u043A\u043E\u0433\u0434\u0430
      \u043E\u0431\u043E\u0437 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F:
      <npc_speech lang=\"Persian\">\u042F \u043D\u0435 \u0434\u043E\u0439\u0434\u0443
      \u0434\u043E \u041C\u0435\u0440\u0432\u0430. \u042D\u0442\u0430 \u043A\u0430\u0440\u0442\u0430
      - \u043E\u0431\u0445\u043E\u0434\u043D\u043E\u0439 \u043F\u0443\u0442\u044C
      \u0447\u0435\u0440\u0435\u0437 \u0411\u0430\u043B\u0445\u0441\u043A\u0443\u044E
      \u0432\u043F\u0430\u0434\u0438\u043D\u0443. \u042F \u0438\u0441\u043A\u0430\u043B
      \u043A\u0443\u043F\u0446\u0430, \u043A\u043E\u0442\u043E\u0440\u043E\u043C\u0443
      \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u0435\u0451. \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0442\u044B \u0447\u0435\u0441\u0442\u0435\u043D.</npc_speech>
      \u041D\u0430 \u043A\u043E\u0436\u0435 \u043F\u0440\u043E\u0446\u0430\u0440\u0430\u043F\u0430\u043D\u044B
      \u0442\u0440\u043E\u043F\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u043D\u0435\u0442 \u043D\u0430 \u0433\u0443\u0430\u043D\u044C\u0434\u0438\u0435.
      \u0415\u0441\u043B\u0438 \u043A\u0430\u0440\u0442\u0430 \u0432\u0435\u0440\u043D\u0430
      - \u0442\u0440\u0438 \u0434\u043D\u044F \u043F\u0443\u0442\u0438 \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u043B\u0435\u043D\u044B.
      \u0415\u0441\u043B\u0438 \u043D\u0435\u0442 - \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053473
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043A\u0430\u0440\u0442\u0443 \u0438
      \u043F\u043E\u043C\u043E\u0447\u044C \u043A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053474
    m_Localized: "\u041A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444\u0430 \u043F\u0435\u0440\u0435\u0434\u0430\u043B\u0438
      \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0439 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u0439
      \u0441 \u0432\u043E\u0434\u043E\u0439 \u0438 \u0435\u0434\u043E\u0439. \u041A\u0430\u0440\u0442\u0430
      \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C \u0442\u043E\u0447\u043D\u043E\u0439
      - \u0442\u0440\u0438 \u0434\u043D\u044F \u043F\u0443\u0442\u0438 \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u043B\u0435\u043D\u044B,
      \u0442\u0440\u043E\u043F\u0430 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F.
      \u041D\u0430\u0432\u044B\u043A \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438
      \u0432\u044B\u0440\u043E\u0441: \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043D\u0430 \u043A\u0430\u0440\u0442\u0443 \u0443\u043C\u0435\u0435\u0442
      \u043A\u0430\u0436\u0434\u044B\u0439, \u0447\u0438\u0442\u0430\u0442\u044C
      \u0435\u0451 - \u043D\u0435 \u043A\u0430\u0436\u0434\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053475
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043A\u0430\u0440\u0442\u0443 \u0431\u0435\u0437
      \u043F\u043E\u043C\u043E\u0449\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053476
    m_Localized: "\u041A\u0430\u0440\u0442\u0443 \u0432\u0437\u044F\u043B\u0438.
      \u041A\u0430\u0440\u0442\u043E\u0433\u0440\u0430\u0444 \u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u0432\u0441\u043B\u0435\u0434. \u0422\u0440\u043E\u043F\u0430 \u0432\u0435\u0440\u043D\u0430\u044F
      - \u0432\u0440\u0435\u043C\u044F \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u043B\u0435\u043D\u043E.
      \u041D\u043E \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0432\u0438\u0434\u0435\u043B\u0438,
      \u043A\u0430\u043A \u043E\u0431\u043E\u0437 \u0443\u0435\u0445\u0430\u043B
      \u043E\u0442 \u0431\u043E\u043B\u044C\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053477
    m_Localized: "\u0411\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u043C\u043E\u043D\u0430\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053478
    m_Localized: "\u041C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
      - \u043F\u044F\u0442\u044C \u043C\u043E\u043D\u0430\u0445\u043E\u0432 \u0432
      \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u0432\u044B\u0445 \u0440\u043E\u0431\u0430\u0445
      \u043C\u0435\u0442\u0443\u0442 \u0434\u0432\u043E\u0440 \u0431\u0430\u043C\u0431\u0443\u043A\u043E\u0432\u044B\u043C\u0438
      \u043C\u0451\u0442\u043B\u0430\u043C\u0438. \u0421\u0442\u0430\u0440\u0448\u0438\u0439
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043D\u0430\u0432\u0441\u0442\u0440\u0435\u0447\u0443
      \u0431\u0435\u0437 \u0441\u043B\u043E\u0432\u0430 \u0438 \u0434\u0435\u0440\u0436\u0438\u0442
      \u043F\u0435\u0440\u0435\u0434 \u0441\u043E\u0431\u043E\u0439 \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u0443\u044E
      \u0447\u0430\u0448\u0443 \u0441 \u0433\u043E\u0440\u044F\u0449\u0438\u043C\u0438
      \u0431\u043B\u0430\u0433\u043E\u0432\u043E\u043D\u0438\u044F\u043C\u0438: \u0437\u0430\u043F\u0430\u0445
      \u0441\u0430\u043D\u0434\u0430\u043B\u043E\u0432\u043E\u0433\u043E \u0434\u0435\u0440\u0435\u0432\u0430
      \u043F\u043B\u044B\u0432\u0451\u0442 \u043D\u0430\u0434 \u043F\u044B\u043B\u044C\u044E
      \u0434\u043E\u0440\u043E\u0433\u0438. <npc_speech lang=\"Chinese\">\u041A\u0443\u043F\u0435\u0446
      \u0441 \u0447\u0438\u0441\u0442\u044B\u043C \u0438\u043C\u0435\u043D\u0435\u043C
      - \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044C \u043D\u0430 \u044D\u0442\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0435. \u0411\u0443\u0434\u0434\u0430 \u0432\u0438\u0434\u0438\u0442
      \u0442\u0435\u0445, \u043A\u0442\u043E \u0438\u0434\u0451\u0442 \u0447\u0435\u0441\u0442\u043D\u043E.</npc_speech>
      \u0411\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 - \u0431\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u043E\u0431\u0440\u044F\u0434, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0434\u0430\u044E\u0442 \u043D\u0435 \u043A\u0430\u0436\u0434\u043E\u043C\u0443.
      \u041C\u043E\u043D\u0430\u0445\u0438 \u0441\u043B\u044B\u0448\u0430\u0442 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B
      \u0432\u0441\u0435\u0445 \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053479
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053480
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u0442\u0440\u0438\u0436\u0434\u044B
      \u043E\u0431\u043E\u0448\u0451\u043B \u043E\u0431\u043E\u0437, \u0447\u0438\u0442\u0430\u044F
      \u0442\u0438\u0445\u0438\u043C \u0433\u043E\u043B\u043E\u0441\u043E\u043C.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0441\u043D\u044F\u043B\u0438
      \u0448\u0430\u043F\u043A\u0438. \u0414\u0443\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F - \u043D\u0435 \u0441\u0443\u0435\u0432\u0435\u0440\u0438\u0435,
      \u0430 \u0437\u043D\u0430\u043A \u0442\u043E\u0433\u043E, \u0447\u0442\u043E
      \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C \u0436\u0438\u0432\u0451\u0442
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053481
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E \u0431\u0435\u0437
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993415053482
    m_Localized: "\u041F\u043E\u043A\u043B\u043E\u043D \u043D\u0430 \u0445\u043E\u0434\u0443
      - \u043C\u043E\u043D\u0430\u0445 \u043F\u0440\u0438\u043D\u044F\u043B. \u0412\u0440\u0435\u043C\u044F
      \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u043E, \u043E\u0431\u0440\u044F\u0434
      \u043F\u0440\u043E\u043F\u0443\u0449\u0435\u043D. \u0414\u0443\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0441\u043B\u0435\u0433\u043A\u0430 \u043F\u0440\u043E\u0441\u0435\u043B -
      \u043D\u0435 \u0432\u0441\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u043E\u043D\u044F\u043B\u0438 \u0441\u043F\u0435\u0448\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247616
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0430
      \u0437\u0430\u043A\u0440\u044B\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247617
    m_Localized: "\u0412\u043E\u0440\u043E\u0442\u0430 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D\u0430
      \u0437\u0430\u043F\u0435\u0440\u0442\u044B \u043F\u0440\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u043C
      \u0440\u044B\u043D\u043A\u0435 \u0432\u043D\u0443\u0442\u0440\u0438. \u0421\u0442\u0430\u0440\u0448\u0438\u0439
      \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0441\u043A\u0440\u0435\u0449\u0438\u0432\u0430\u0435\u0442
      \u043A\u043E\u043F\u044C\u044F \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0431\u0435\u0437 \u0441\u043F\u0435\u0448\u043A\u0438: <npc_speech lang=\"Chinese\">\u0422\u0432\u043E\u0451
      \u0438\u043C\u044F \u0435\u0441\u0442\u044C \u0432 \u0441\u043F\u0438\u0441\u043A\u0435
      \u043A\u0443\u043F\u0446\u043E\u0432, \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u0446\u0437\u0435\u0434\u0443\u0448\u0438 \u0432\u0435\u043B\u0435\u043B \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u0442\u044C
      \u0434\u0432\u0430\u0436\u0434\u044B. \u041E\u0441\u043E\u0431\u0430\u044F
      \u043F\u043E\u0448\u043B\u0438\u043D\u0430 - \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432. \u0418\u043B\u0438 \u0436\u0434\u0438
      \u0434\u043E \u0437\u0430\u0432\u0442\u0440\u0430.</npc_speech> \u0417\u0430
      \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438 \u0441\u043B\u044B\u0448\u0435\u043D
      \u0431\u0430\u0437\u0430\u0440\u043D\u044B\u0439 \u0433\u043E\u043C\u043E\u043D.
      \u0414\u0440\u0443\u0433\u0438\u0435 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B
      \u043F\u0440\u043E\u0445\u043E\u0434\u044F\u0442 \u0440\u044F\u0434\u043E\u043C
      \u0431\u0435\u0437 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438. \u041F\u043B\u043E\u0445\u0430\u044F
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F - \u044D\u0442\u043E
      \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0435
      \u0434\u0432\u0435\u0440\u0438, \u044D\u0442\u043E \u0432\u0440\u0435\u043C\u044F
      \u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247618
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247619
    m_Localized: "\u041C\u043E\u043D\u0435\u0442\u044B \u0438\u0441\u0447\u0435\u0437\u043B\u0438
      \u0432 \u043A\u043E\u0448\u0435\u043B\u0435 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430.
      \u0412\u043E\u0440\u043E\u0442\u0430 \u043E\u0442\u043A\u0440\u044B\u043B\u0438\u0441\u044C.
      \u0414\u043E\u0440\u043E\u0433\u043E, \u0437\u0430\u0442\u043E \u0431\u044B\u0441\u0442\u0440\u043E
      - \u0440\u044B\u043D\u043E\u043A \u0435\u0449\u0451 \u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442.
      \u0414\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0434\u043E\u0441\u043C\u043E\u0442\u0440 \u043D\u0435 \u0434\u043E\u0431\u0430\u0432\u0438\u043B
      \u0440\u0430\u0434\u043E\u0441\u0442\u0438, \u043D\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u043B
      \u0432\u043E\u0439\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247620
    m_Localized: "\u0416\u0434\u0430\u0442\u044C \u0434\u043E \u0437\u0430\u0432\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247621
    m_Localized: "\u041D\u043E\u0447\u044C \u0443 \u0441\u0442\u0435\u043D. \u0420\u044B\u043D\u043E\u043A
      \u0437\u0430\u043A\u0440\u044B\u043B\u0441\u044F \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430
      - \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u043B\u0443\u0447\u0448\u0438\u0435
      \u0447\u0430\u0441\u044B \u0442\u043E\u0440\u0433\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B: \u043E\u043D\u0438
      \u0441\u043B\u044B\u0448\u0430\u043B\u0438, \u043F\u043E\u0447\u0435\u043C\u0443
      \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247622
    m_Localized: "\u041F\u043E\u0434\u043A\u0443\u043F\u0438\u0442\u044C \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430
      \u043C\u0435\u043D\u044C\u0448\u0435\u0439 \u0441\u0443\u043C\u043C\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247623
    m_Localized: "\u041F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432.
      \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A \u0432\u0437\u044F\u043B,
      \u043D\u043E \u043F\u0440\u043E\u0432\u0451\u043B \u0447\u0435\u0440\u0435\u0437
      \u0431\u043E\u043A\u043E\u0432\u0443\u044E \u043A\u0430\u043B\u0438\u0442\u043A\u0443
      \u0441 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u043E\u0439. \u0414\u0435\u0448\u0435\u0432\u043B\u0435
      \u0438 \u0443\u043D\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u0435\u0435
      - \u043E\u0431\u0430 \u0441\u043B\u043E\u0432\u0430 \u0432\u0435\u0440\u043D\u044B
      \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247624
    m_Localized: "\u0414\u043E\u0441\u043C\u043E\u0442\u0440 \u0446\u0437\u0435\u0434\u0443\u0448\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247625
    m_Localized: "\u041F\u044F\u0442\u0435\u0440\u043E \u0441\u043E\u043B\u0434\u0430\u0442
      \u0441 \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u043C\u0438 \u043A\u0440\u044E\u043A\u0430\u043C\u0438
      \u0432\u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0442\u044E\u043A\u0438
      \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435.
      \u041E\u0444\u0438\u0446\u0435\u0440 \u0441 \u0431\u0430\u043C\u0431\u0443\u043A\u043E\u0432\u043E\u0439
      \u0434\u043E\u0449\u0435\u0447\u043A\u043E\u0439 \u0437\u0430\u043F\u0438\u0441\u044B\u0432\u0430\u0435\u0442
      \u043A\u0430\u0436\u0434\u0443\u044E \u0432\u0435\u0449\u044C: <npc_speech
      lang=\"Chinese\">\u041F\u0440\u0438\u043A\u0430\u0437 \u0446\u0437\u0435\u0434\u0443\u0448\u0438.
      \u041A\u0443\u043F\u0446\u044B \u0441 \u043D\u0435\u044F\u0441\u043D\u043E\u0439
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0435\u0439 - \u043F\u043E\u043B\u043D\u044B\u0439
      \u0434\u043E\u0441\u043C\u043E\u0442\u0440. \u041E\u043F\u0438\u0441\u044C
      \u0437\u0430\u0439\u043C\u0451\u0442 \u0432\u0440\u0435\u043C\u044F.</npc_speech>
      \u0421\u043E\u043B\u0434\u0430\u0442\u044B \u043D\u0435 \u0433\u0440\u0443\u0431\u044F\u0442,
      \u043D\u043E \u043C\u0435\u0442\u043E\u0434\u0438\u0447\u043D\u044B. \u0428\u0451\u043B\u043A\u043E\u0432\u044B\u0435
      \u0442\u044E\u043A\u0438 \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0442,
      \u0449\u0443\u043F\u0430\u044E\u0442, \u0437\u0430\u043A\u0440\u044B\u0432\u0430\u044E\u0442.
      \u041C\u0435\u0434\u043D\u044B\u0435 \u043F\u0435\u0447\u0430\u0442\u0438 \u043D\u0430
      \u043A\u0443\u0432\u0448\u0438\u043D\u0430\u0445 \u0432\u0441\u043A\u0440\u044B\u0432\u0430\u044E\u0442.
      \u0422\u0440\u0438 \u0447\u0430\u0441\u0430 \u043D\u0430 \u0436\u0430\u0440\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247626
    m_Localized: "\u0421\u043E\u0442\u0440\u0443\u0434\u043D\u0438\u0447\u0430\u0442\u044C
      \u0438 \u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247627
    m_Localized: "\u0422\u0440\u0438 \u0447\u0430\u0441\u0430 \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430.
      \u041F\u043E\u0432\u0440\u0435\u0436\u0434\u0451\u043D \u043E\u0434\u0438\u043D
      \u043A\u0443\u0432\u0448\u0438\u043D. \u0428\u0442\u0440\u0430\u0444 \u0437\u0430
      \u043F\u0440\u043E\u0441\u0440\u043E\u0447\u0435\u043D\u043D\u044B\u0439 \u043F\u0443\u0442\u0435\u0432\u043E\u0439
      \u043B\u0438\u0441\u0442 \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0438 \u0441\u0432\u0435\u0440\u0445\u0443.
      \u0417\u0430\u0442\u043E \u043F\u0440\u043E\u0448\u043B\u0438 \u0431\u0435\u0437
      \u043E\u0431\u043E\u0441\u0442\u0440\u0435\u043D\u0438\u0439 - \u043E\u0444\u0438\u0446\u0435\u0440
      \u0432\u043F\u0438\u0441\u0430\u043B \u0432 \u0436\u0443\u0440\u043D\u0430\u043B
      \u0441\u043B\u043E\u0432\u043E \"\u043F\u043E\u0440\u044F\u0434\u043E\u0447\u043D\u044B\u0439\"."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247628
    m_Localized: "\u0414\u0430\u0442\u044C \u0432\u0437\u044F\u0442\u043A\u0443 \u043E\u0444\u0438\u0446\u0435\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247629
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043F\u044F\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0437\u0430 \u0441\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u0435
      \u0441\u043F\u0438\u0441\u043A\u0430 \u0434\u043E \u0442\u0440\u0451\u0445
      \u0442\u044E\u043A\u043E\u0432. \u041E\u0444\u0438\u0446\u0435\u0440 \u0432\u0437\u044F\u043B
      \u043D\u0435 \u0442\u043E\u0440\u0433\u0443\u044F\u0441\u044C. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u043F\u043B\u0430\u0442\u0438\u0442
      \u0447\u0442\u043E\u0431\u044B \u0441\u043A\u0440\u044B\u0442\u044C - \u0445\u0443\u0436\u0435,
      \u0447\u0435\u043C \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0447\u0435\u0441\u0442\u043D\u043E\u0433\u043E
      \u0431\u0435\u0434\u043D\u044F\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247630
    m_Localized: "\u0417\u0430\u0432\u044B\u0448\u0435\u043D\u043D\u044B\u0435 \u0446\u0435\u043D\u044B
      \u043D\u0430 \u0440\u044B\u043D\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247631
    m_Localized: "\u0411\u0430\u0437\u0430\u0440\u043D\u044B\u0439 \u0440\u044F\u0434
      \u0432 \u0411\u0430\u043B\u0445\u0435. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0441\u043F\u0435\u0446\u0438\u044F\u043C\u0438 - \u043F\u0430\u043B\u044C\u0446\u044B
      \u0436\u0451\u043B\u0442\u044B\u0435 \u043E\u0442 \u043A\u0443\u0440\u043A\u0443\u043C\u044B
      - \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0446\u0435\u043D\u0443
      \u0432\u0442\u0440\u043E\u0435 \u0432\u044B\u0448\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0439
      \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043F\u0440\u044F\u043C\u043E:
      <npc_speech lang=\"Persian\">\u042F \u0441\u043B\u044B\u0448\u0430\u043B \u043E
      \u0442\u0432\u043E\u0438\u0445 \u0434\u0435\u043B\u0430\u0445 \u0432 \u043F\u0440\u043E\u0448\u043B\u044B\u0439
      \u0440\u0430\u0437. \u0422\u0430\u043A\u043E\u043C\u0443 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044E
      - \u0442\u0430\u043A\u0430\u044F \u0446\u0435\u043D\u0430. \u041D\u0435 \u043D\u0440\u0430\u0432\u0438\u0442\u0441\u044F
      - \u0438\u0434\u0438 \u043A \u0434\u0440\u0443\u0433\u043E\u043C\u0443.</npc_speech>
      \u0414\u0440\u0443\u0433\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0440\u044F\u0434\u043E\u043C \u043E\u0442\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u043F\u043E\u0434\u043E\u0439\u0442\u0438.
      \u041F\u043B\u043E\u0445\u043E\u0435 \u0438\u043C\u044F \u043D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435
      - \u044D\u0442\u043E \u043D\u0430\u043B\u043E\u0433, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043F\u043B\u0430\u0442\u0438\u0448\u044C \u043A\u0430\u0436\u0434\u044B\u0439
      \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247632
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0437\u0430\u0432\u044B\u0448\u0435\u043D\u043D\u0443\u044E
      \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247633
    m_Localized: "\u041F\u0435\u0440\u0435\u043F\u043B\u0430\u0442\u0430 \u0437\u0430
      \u0441\u043F\u0435\u0446\u0438\u0438. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u043F\u0440\u043E\u0432\u0451\u043B \u0441\u0434\u0435\u043B\u043A\u0443 \u043C\u043E\u043B\u0447\u0430.
      \u0425\u043E\u0442\u044F \u0431\u044B \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438
      \u0442\u043E\u0432\u0430\u0440 \u0431\u0435\u0437 \u0441\u043A\u0430\u043D\u0434\u0430\u043B\u0430
      - \u043D\u0430\u0432\u044B\u043A \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438
      \u0440\u0430\u0441\u0442\u0451\u0442 \u043E\u0442 \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u044F,
      \u043A\u043E\u0433\u0434\u0430 \u043F\u0440\u043E\u0438\u0433\u0440\u044B\u0432\u0430\u0435\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247634
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u043A\u043E\u043D\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247635
    m_Localized: "\u0421\u0442\u043E\u0440\u0433\u043E\u0432\u0430\u043B\u0438\u0441\u044C
      \u0434\u043E \u0434\u0432\u043E\u0439\u043D\u043E\u0439 \u0446\u0435\u043D\u044B.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0441\u044F
      \u0441 \u044F\u0432\u043D\u044B\u043C \u043D\u0435\u0443\u0434\u043E\u0432\u043E\u043B\u044C\u0441\u0442\u0432\u0438\u0435\u043C.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0438 \u0434\u0435\u043D\u044C\u0433\u0438,
      \u0438 \u0434\u043E\u0431\u0440\u043E\u0435 \u0441\u043B\u043E\u0432\u043E
      - \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0430
      \u0435\u0449\u0451 \u043E\u0434\u043D\u0443 \u0437\u0430\u0440\u0443\u0431\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247636
    m_Localized: "\u0423\u0439\u0442\u0438 \u043A \u0434\u0440\u0443\u0433\u043E\u043C\u0443
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247637
    m_Localized: "\u0414\u0440\u0443\u0433\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0442\u043E\u0436\u0435 \u043D\u0430\u0437\u0432\u0430\u043B \u0446\u0435\u043D\u0443
      \u0432\u044B\u0448\u0435 \u043D\u043E\u0440\u043C\u044B - \u0441\u043B\u0443\u0445
      \u0440\u0430\u0441\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u0431\u044B\u0441\u0442\u0440\u043E.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0432\u0440\u0435\u043C\u044F,
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438 \u0442\u0435 \u0436\u0435
      \u0443\u0441\u043B\u043E\u0432\u0438\u044F. \u041E\u0434\u0438\u043D \u0434\u0435\u043D\u044C
      \u0434\u043B\u044F \u043F\u043E\u0438\u0441\u043A\u0430 \u0442\u043E\u0432\u0430\u0440\u0430
      \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247638
    m_Localized: "\u041F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0439 \u0434\u0432\u043E\u0440
      \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247639
    m_Localized: "\u041F\u043E\u0441\u0442\u043E\u044F\u043B\u044B\u0439 \u0434\u0432\u043E\u0440
      \u0432 \u041C\u0435\u0440\u0432\u0435 - \u0437\u0430\u043F\u0430\u0445 \u0436\u0430\u0440\u0435\u043D\u043E\u0433\u043E
      \u044F\u0433\u043D\u0451\u043D\u043A\u0430 \u0438 \u043A\u0443\u043D\u0436\u0443\u0442\u043D\u043E\u0433\u043E
      \u043C\u0430\u0441\u043B\u0430 \u0438\u0437 \u043A\u0443\u0445\u043D\u0438.
      \u0425\u043E\u0437\u044F\u0438\u043D \u0421\u0430\u043C\u0435\u0445 \u0441\u0442\u043E\u0438\u0442
      \u0432 \u0434\u0432\u0435\u0440\u044F\u0445 \u0438 \u043D\u0435 \u043E\u0442\u0445\u043E\u0434\u0438\u0442
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443: <npc_speech lang=\"Persian\">\u041C\u0435\u0441\u0442
      \u043D\u0435\u0442. \u0414\u043B\u044F \u0442\u0435\u0431\u044F \u043D\u0435\u0442.
      \u042F \u0437\u043D\u0430\u044E, \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C
      \u043D\u0430 \u043F\u0440\u043E\u0448\u043B\u043E\u043C \u043E\u0431\u043E\u0437\u0435
      - \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442.</npc_speech>
      \u0417\u0430 \u043D\u0438\u043C \u0432\u0438\u0434\u043D\u0435\u044E\u0442\u0441\u044F
      \u043F\u0443\u0441\u0442\u044B\u0435 \u043A\u043E\u043C\u043D\u0430\u0442\u044B.
      \u041E\u043D \u043D\u0435 \u043B\u0436\u0451\u0442 \u043E \u043C\u0435\u0441\u0442\u0430\u0445
      - \u043E\u043D \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0442, \u043A\u043E\u043C\u0443
      \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0442\u044C \u0434\u0432\u0435\u0440\u044C.
      \u041D\u043E\u0447\u0435\u0432\u0430\u0442\u044C \u043F\u0440\u0438\u0434\u0451\u0442\u0441\u044F
      \u0432 \u043F\u043E\u043B\u0435 \u0438\u043B\u0438 \u0438\u0441\u043A\u0430\u0442\u044C
      \u0434\u0440\u0443\u0433\u043E\u0435 \u043C\u0435\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247640
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u043D\u043E\u0447\u043B\u0435\u0433
      \u0432 \u043F\u043E\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247641
    m_Localized: "\u041D\u043E\u0447\u044C \u0443 \u0434\u043E\u0440\u043E\u0433\u0438.
      \u041A\u043E\u0441\u0442\u0451\u0440, \u043E\u0445\u0440\u0430\u043D\u0430
      \u0432 \u0434\u0432\u0435 \u0441\u043C\u0435\u043D\u044B. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u043E\u043D\u044F\u043B\u0438 \u043F\u043E\u0447\u0435\u043C\u0443 -
      \u0438 \u0441\u043F\u0430\u043B\u0438 \u043F\u043B\u043E\u0445\u043E. \u041F\u043E\u0442\u0435\u0440\u044F
      \u0434\u043D\u044F \u0432\u044B\u0445\u043E\u0434\u0430: \u0443\u0442\u0440\u043E\u043C
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0441\u043E\u0431\u0438\u0440\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247642
    m_Localized: "\u0414\u0430\u0442\u044C \u0432\u0437\u044F\u0442\u043A\u0443 \u0445\u043E\u0437\u044F\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247643
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043E\u0442\u043A\u0440\u044B\u043B\u0438 \u0434\u0432\u0435\u0440\u044C.
      \u0421\u0430\u043C\u0435\u0445 \u0432\u0437\u044F\u043B \u0431\u0435\u0437
      \u0443\u043B\u044B\u0431\u043A\u0438. \u041F\u0435\u0440\u0435\u043D\u043E\u0447\u0435\u0432\u0430\u043B\u0438,
      \u043D\u043E \u0432\u0435\u0441\u044C \u0434\u0432\u043E\u0440 \u0437\u043D\u0430\u043B,
      \u043A\u0430\u043A \u043F\u0440\u043E\u0448\u043B\u0430 \u0441\u0434\u0435\u043B\u043A\u0430.
      \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0432\u044B\u0440\u043E\u0441\u043B\u0430 - \u0441\u043B\u0443\u0445\u0438
      \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0442\u0430\u043A\u0438\u0445 \u0445\u043E\u0437\u044F\u0435\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247644
    m_Localized: "\u041B\u043E\u0436\u043D\u043E\u0435 \u043E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247645
    m_Localized: "\u0423 \u043A\u043E\u043B\u043E\u0434\u0446\u0430 \u043D\u0430
      \u043F\u0440\u0438\u0432\u0430\u043B\u0435 \u043A\u0443\u043F\u0435\u0446 \u0438\u0437
      \u0410\u043D\u0442\u0438\u043E\u0445\u0438\u0438 \u0445\u0432\u0430\u0442\u0430\u0435\u0442
      \u0432\u0430\u0441 \u0437\u0430 \u0440\u0443\u043A\u0430\u0432 \u043F\u0435\u0440\u0435\u0434
      \u0432\u0441\u0435\u043C\u0438: <npc_speech lang=\"Persian\">\u041C\u043E\u0439
      \u043A\u043E\u0448\u0435\u043B\u044C \u0441 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C\u044E
      \u0434\u0438\u0440\u0445\u0430\u043C\u0430\u043C\u0438 \u043F\u0440\u043E\u043F\u0430\u043B.
      \u0422\u044B \u0441\u0442\u043E\u044F\u043B \u0440\u044F\u0434\u043E\u043C
      - \u0432\u0441\u0435 \u0432\u0438\u0434\u0435\u043B\u0438.</npc_speech> \u0412\u043E\u043A\u0440\u0443\u0433
      \u0441\u043E\u0431\u0438\u0440\u0430\u044E\u0442\u0441\u044F \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438,
      \u043F\u0435\u0440\u0435\u043A\u0443\u043F\u0449\u0438\u043A\u0438, \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u043F\u043E\u0441\u0442\u0430 - \u0432\u0441\u0435 \u0441\u043C\u043E\u0442\u0440\u044F\u0442.
      \u041A\u043E\u0448\u0435\u043B\u044C \u043F\u0440\u043E\u043F\u0430\u043B \u043D\u0430
      \u0441\u0430\u043C\u043E\u043C \u0434\u0435\u043B\u0435. \u041E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u0435
      \u043B\u043E\u0436\u043D\u043E\u0435 - \u043D\u043E \u043A\u0442\u043E \u044D\u0442\u043E
      \u0437\u043D\u0430\u0435\u0442? \u041F\u0440\u0438 \u043D\u0438\u0437\u043A\u043E\u0439
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438 \u043B\u044E\u0431\u043E\u0435
      \u043E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u0435 \u0437\u0432\u0443\u0447\u0438\u0442
      \u043F\u0440\u0430\u0432\u0434\u043E\u043F\u043E\u0434\u043E\u0431\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247646
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C - \u043B\u0438\u0448\u044C
      \u0431\u044B \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247647
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0437\u0430\u0442\u043A\u043D\u0443\u043B\u0438 \u043E\u0431\u0432\u0438\u043D\u0435\u043D\u0438\u0435.
      \u0410\u043D\u0442\u0438\u043E\u0445\u0438\u0435\u0446 \u043A\u0438\u0432\u043D\u0443\u043B
      \u0438 \u0443\u0448\u0451\u043B - \u0443\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0451\u043D.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0432\u0438\u0434\u0435\u043B\u0438:
      \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C \u043F\u043B\u0430\u0442\u0438\u0442
      \u043F\u043E \u043F\u0435\u0440\u0432\u043E\u043C\u0443 \u0441\u043B\u043E\u0432\u0443.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044C
      \u043D\u0438\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247648
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u0438 \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247649
    m_Localized: "\u041E\u0431\u0432\u0438\u043D\u0438\u0442\u0435\u043B\u044C \u043A\u0440\u0438\u0447\u0430\u043B
      \u0432\u0441\u043B\u0435\u0434. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u0437\u0430\u043F\u0438\u0441\u0430\u043B \u0438\u043C\u044F. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0432\u0440\u0435\u043C\u044F \u0438 \u043D\u0435\u0440\u0432\u044B - \u043D\u043E
      \u043D\u0435 \u0434\u0435\u043D\u044C\u0433\u0438. \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u0432\u044B\u0440\u043E\u0441\u043B\u0430: \u0441\u0442\u0440\u0430\u0436\u0438
      \u043F\u043E\u0441\u0442\u0430 \u0442\u0435\u043F\u0435\u0440\u044C \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247650
    m_Localized: "\u041F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247651
    m_Localized: "\u041D\u0430\u0448\u043B\u0438 \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0433\u043E
      \u0432\u043E\u0440\u0430 - \u043C\u0430\u043B\u044C\u0447\u0438\u0448\u043A\u0430-\u043F\u043E\u043F\u0440\u043E\u0448\u0430\u0439\u043A\u0430.
      \u0410\u043D\u0442\u0438\u043E\u0445\u0438\u0435\u0446 \u0438\u0437\u0432\u0438\u043D\u0438\u043B\u0441\u044F
      \u0441\u0443\u0445\u043E. \u0421\u0442\u0440\u0430\u0436\u043D\u0438\u043A
      \u0432\u044B\u0447\u0435\u0440\u043A\u043D\u0443\u043B \u0438\u043C\u044F \u0438\u0437
      \u0441\u043F\u0438\u0441\u043A\u0430. \u0414\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043D\u0430\u0432\u044B\u043A \u0440\u0430\u0441\u0442\u0451\u0442 \u0442\u0430\u043C,
      \u0433\u0434\u0435 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u043F\u0430\u0434\u0430\u0435\u0442
      - \u0443\u0447\u0438\u0448\u044C\u0441\u044F \u0434\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C
      \u043F\u0440\u0430\u0432\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247652
    m_Localized: "\u0410\u0433\u0435\u043D\u0442 \u0433\u0438\u043B\u044C\u0434\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247653
    m_Localized: "\u041D\u0430 \u0431\u0430\u0437\u0430\u0440\u0435 \u0432 \u041A\u0430\u0448\u0433\u0430\u0440\u0435
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432 \u043E\u0431\u044B\u0447\u043D\u043E\u043C
      \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u043E\u043C \u0445\u0430\u043B\u0430\u0442\u0435
      \u0445\u043E\u0434\u0438\u0442 \u0437\u0430 \u0432\u0430\u043C\u0438 \u0442\u0440\u0438
      \u0447\u0430\u0441\u0430. \u041A\u043E\u0433\u0434\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0448\u044C
      - \u043E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0442\u0438\u0445\u043E: <npc_speech lang=\"Sogdian\">\u042D\u0442\u043E \u0430\u0433\u0435\u043D\u0442
      \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u0439 \u0433\u0438\u043B\u044C\u0434\u0438\u0438.
      \u041E\u043D\u0438 \u0441\u043B\u0435\u0434\u044F\u0442 \u0437\u0430 \u043A\u0443\u043F\u0446\u0430\u043C\u0438
      \u0441 \u043F\u043B\u043E\u0445\u043E\u0439 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0435\u0439
      - \u0447\u0442\u043E\u0431\u044B \u0437\u043D\u0430\u0442\u044C, \u043A\u0443\u0434\u0430
      \u0442\u0435 \u0432\u0435\u0437\u0443\u0442 \u0442\u043E\u0432\u0430\u0440
      \u0438 \u043A\u043E\u043C\u0443 \u043F\u0440\u043E\u0434\u0430\u044E\u0442.</npc_speech>
      \u0413\u0438\u043B\u044C\u0434\u0438\u044F \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0445
      \u043A\u0443\u043F\u0446\u043E\u0432 \u0434\u0435\u0440\u0436\u0438\u0442 \u0441\u0435\u0442\u044C
      \u043E\u0441\u0432\u0435\u0434\u043E\u043C\u0438\u0442\u0435\u043B\u0435\u0439
      \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C\u0443
      \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247654
    m_Localized: "\u0418\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      \u0438 \u0432\u0435\u0441\u0442\u0438 \u0434\u0435\u043B\u0430 \u043A\u0430\u043A
      \u043E\u0431\u044B\u0447\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247655
    m_Localized: "\u0410\u0433\u0435\u043D\u0442 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u043B
      \u0432\u0435\u0441\u044C \u0434\u0435\u043D\u044C. \u0421\u0434\u0435\u043B\u043A\u0438
      \u043F\u0440\u043E\u0448\u043B\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u043E
      - \u043D\u0435\u0447\u0435\u0433\u043E \u0441\u043A\u0440\u044B\u0432\u0430\u0442\u044C.
      \u0425\u043E\u0442\u044F \u0430\u0442\u043C\u043E\u0441\u0444\u0435\u0440\u0430
      \u0434\u0430\u0432\u0438\u043B\u0430, \u043F\u043E\u043F\u044B\u0442\u043A\u0438
      \u043F\u0440\u044F\u0442\u0430\u0442\u044C\u0441\u044F \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0431\u044B \u0445\u0443\u0436\u0435. \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0432\u044B\u0440\u043E\u0441\u043B\u0430
      - \u0433\u0438\u043B\u044C\u0434\u0438\u044F \u0447\u0438\u0442\u0430\u0435\u0442
      \u043F\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247656
    m_Localized: "\u041F\u043E\u0434\u043A\u0443\u043F\u0438\u0442\u044C \u0430\u0433\u0435\u043D\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247657
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432.
      \u0410\u0433\u0435\u043D\u0442 \u0432\u0437\u044F\u043B \u0438 \u0443\u0448\u0451\u043B.
      \u041D\u043E \u0433\u0438\u043B\u044C\u0434\u0438\u044F \u0437\u043D\u0430\u0435\u0442,
      \u0447\u0442\u043E \u0432\u044B \u043F\u043B\u0430\u0442\u0438\u0442\u0435
      \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u0442\u0435\u043B\u044F\u043C -
      \u044D\u0442\u043E \u0441\u0430\u043C\u043E \u043F\u043E \u0441\u0435\u0431\u0435
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0443\u043F\u0430\u043B\u0430 \u0435\u0449\u0451 \u043D\u0430 \u043E\u0434\u043D\u0443
      \u0441\u0442\u0443\u043F\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247658
    m_Localized: "\u0421\u043C\u0435\u043B\u044B\u0439 \u043D\u0430\u043B\u0451\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247659
    m_Localized: "\u0412\u043E\u0441\u0435\u043C\u044C \u043A\u043E\u043D\u043D\u044B\u0445
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u044E\u0442
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0443 \u0443\u0449\u0435\u043B\u044C\u044F.
      \u0418\u0445 \u043F\u0440\u0435\u0434\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C
      \u043A\u0440\u0438\u0447\u0438\u0442 \u0447\u0435\u0440\u0435\u0437 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u043E:
      <npc_speech lang=\"Turkic\">\u0421\u043B\u044B\u0448\u0430\u043B\u0438 - \u043E\u0445\u0440\u0430\u043D\u044B
      \u043C\u0430\u043B\u043E. \u0412\u0435\u0437\u0451\u0442 \u0442\u043E\u0442,
      \u043A\u0442\u043E \u043D\u0435 \u0436\u0430\u0434\u043D\u0438\u0447\u0430\u0435\u0442
      \u0441 \u0432\u044B\u043A\u0443\u043F\u043E\u043C.</npc_speech> \u041F\u0440\u0438
      \u0438\u043D\u043E\u0439 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438 \u0434\u0432\u0430\u0436\u0434\u044B
      \u043F\u043E\u0434\u0443\u043C\u0430\u043B\u0438 \u0431\u044B. \u0421\u0435\u0439\u0447\u0430\u0441
      \u043E\u043D\u0438 \u0437\u043D\u0430\u044E\u0442: \u0443 \u044D\u0442\u043E\u0433\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0441\u043B\u0430\u0431\u0430\u044F
      \u0437\u0430\u0449\u0438\u0442\u0430, \u0445\u043E\u0437\u044F\u0438\u043D
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0442 \u043D\u0430\u043D\u044F\u0442\u044C
      \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u044B\u0445 \u0432\u043E\u0438\u043D\u043E\u0432.
      \u0410\u0442\u0430\u043A\u0443\u044E\u0442 \u0441 \u0442\u0440\u0435\u043C\u044F
      \u043F\u0443\u0442\u044F\u043C\u0438 \u0432\u044B\u0445\u043E\u0434\u0430 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0442\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247660
    m_Localized: "\u0421\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247661
    m_Localized: "\u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u0431\u043E\u0439.
      \u0414\u0432\u043E\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0440\u0430\u043D\u0435\u043D\u044B, \u0442\u0435\u043B\u0435\u0433\u0430
      \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u0430, \u0437\u0430\u043F\u0430\u0441\u044B
      \u0435\u0434\u044B \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B. \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438, \u043D\u043E \u0432\u0437\u044F\u043B\u0438
      \u0441\u0432\u043E\u0451 - \u043F\u043B\u043E\u0445\u0430\u044F \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u043E\u0431\u0445\u043E\u0434\u0438\u0442\u0441\u044F \u043A\u0440\u043E\u0432\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247662
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0432\u044B\u043A\u0443\u043F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247663
    m_Localized: "\u0421\u043E\u0440\u043E\u043A \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432.
      \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438.
      \u0421\u043B\u0443\u0445 \u043E \u043B\u0451\u0433\u043A\u043E\u0439 \u0434\u043E\u0431\u044B\u0447\u0435
      \u0440\u0430\u0437\u043E\u0439\u0434\u0451\u0442\u0441\u044F - \u043D\u0430
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u043F\u0435\u0440\u0435\u0433\u043E\u043D\u0435
      \u043C\u043E\u0433\u0443\u0442 \u043D\u0430\u043F\u0430\u0441\u0442\u044C \u0441\u043D\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247664
    m_Localized: "\u041E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u0438 \u043E\u0431\u043E\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247665
    m_Localized: "\u041E\u0431\u0445\u043E\u0434 \u0437\u0430\u043D\u044F\u043B \u0434\u0432\u0430
      \u0434\u043D\u044F. \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u0441\u043D\u0438\u0437\u0438\u043B\u0430\u0441\u044C, \u043D\u043E \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u043E\u0431\u043E\u0437\u0430 \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0430
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247666
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u0434\u0432\u043E\u0439\u043D\u0443\u044E \u043F\u043B\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247667
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u042E\u0441\u0443\u0444
      - \u0437\u043D\u0430\u0435\u0442 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u044B
      \u041F\u0430\u043C\u0438\u0440\u0430 \u043B\u0443\u0447\u0448\u0435, \u0447\u0435\u043C
      \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435 \u043A\u0430\u0440\u043C\u0430\u043D\u044B
      - \u0441\u0442\u043E\u0438\u0442 \u0443 \u0432\u043E\u0440\u043E\u0442 \u0441
      \u043F\u043E\u0441\u043E\u0445\u043E\u043C \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u044E\u0449\u0435: <npc_speech lang=\"Persian\">\u042F
      \u0441\u043B\u044B\u0448\u0430\u043B \u043E \u0442\u0432\u043E\u0451\u043C
      \u043F\u0440\u043E\u0448\u043B\u043E\u043C \u043E\u0431\u043E\u0437\u0435.
      \u041E\u0431\u044B\u0447\u043D\u0430\u044F \u043F\u043B\u0430\u0442\u0430 -
      \u0434\u043B\u044F \u043E\u0431\u044B\u0447\u043D\u044B\u0445 \u043A\u0443\u043F\u0446\u043E\u0432.
      \u0421 \u0442\u0435\u0431\u044F \u0432\u0434\u0432\u043E\u0435, \u0438\u043B\u0438
      \u0438\u0434\u0438 \u0441\u0430\u043C.</npc_speech> \u0411\u0435\u0437 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430
      \u0447\u0435\u0440\u0435\u0437 \u041F\u0430\u043C\u0438\u0440 - \u0442\u0440\u0451\u0445\u0434\u043D\u0435\u0432\u043D\u044B\u0439
      \u0440\u0438\u0441\u043A \u0437\u0430\u0431\u043B\u0443\u0434\u0438\u0442\u044C\u0441\u044F.
      \u0421 \u043F\u043B\u043E\u0445\u0438\u043C \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u043E\u043C
      - \u0445\u0443\u0436\u0435. \u042E\u0441\u0443\u0444 \u0447\u0435\u0441\u0442\u0435\u043D
      \u0432 \u043E\u0434\u043D\u043E\u043C: \u043D\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0446\u0435\u043D\u0443 \u043F\u0440\u044F\u043C\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247668
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0434\u0432\u043E\u0439\u043D\u0443\u044E
      \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247669
    m_Localized: "\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0432\u043C\u0435\u0441\u0442\u043E \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u0438.
      \u042E\u0441\u0443\u0444 \u0432\u0437\u044F\u043B, \u043F\u0440\u0438\u0432\u0451\u043B
      \u0447\u0435\u0440\u0435\u0437 \u043F\u0435\u0440\u0435\u0432\u0430\u043B \u0442\u043E\u0447\u043D\u043E.
      \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0441\u043D\u0438\u0437\u0438\u043B\u0430\u0441\u044C
      - \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0441\u0432\u043E\u0451
      \u0434\u0435\u043B\u043E \u0437\u043D\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247670
    m_Localized: "\u0418\u0434\u0442\u0438 \u0431\u0435\u0437 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247671
    m_Localized: "\u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0434\u0432\u0430
      \u0434\u043D\u044F \u043D\u0430 \u043D\u0435\u0432\u0435\u0440\u043D\u043E\u043C
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435. \u0412\u044B\u0448\u043B\u0438
      \u0432\u0441\u0451 \u0436\u0435 - \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C,
      \u043D\u043E \u043F\u043E\u0437\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247672
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247673
    m_Localized: "\u0421\u043E\u0448\u043B\u0438\u0441\u044C \u043D\u0430 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u0438
      \u0434\u0438\u0440\u0445\u0430\u043C\u0430\u0445. \u042E\u0441\u0443\u0444
      \u043F\u0440\u043E\u0432\u0451\u043B \u0441 \u044F\u0432\u043D\u044B\u043C
      \u043D\u0435\u0436\u0435\u043B\u0430\u043D\u0438\u0435\u043C - \u043F\u043E
      \u0432\u0435\u0440\u043D\u043E\u0439 \u0442\u0440\u043E\u043F\u0435, \u043D\u043E
      \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445 \u0441\u043B\u043E\u0432.
      \u041D\u0430\u0432\u044B\u043A \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u0438
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0432\u044B\u0440\u043E\u0441 \u043E\u0442
      \u043D\u0430\u0431\u043B\u044E\u0434\u0435\u043D\u0438\u044F \u0437\u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247674
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0445\u043E\u0442\u044F\u0442
      \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247675
    m_Localized: "\u0423 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u0433\u043E \u043A\u043E\u0441\u0442\u0440\u0430
      \u0434\u0432\u043E\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      - \u0412\u0430\u0440\u0433\u0430 \u0438 \u043C\u043E\u043B\u043E\u0434\u043E\u0439
      \u0443\u0439\u0433\u0443\u0440 - \u0441\u0438\u0434\u044F\u0442 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E
      \u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0442 \u0442\u0438\u0445\u043E.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442 \u0438 \u043D\u0435 \u043F\u0440\u044F\u0447\u0435\u0442
      \u0441\u043B\u043E\u0432: <npc_speech lang=\"Sogdian\">\u041B\u044E\u0434\u0438
      \u0433\u043E\u0432\u043E\u0440\u044F\u0442 - \u0441 \u0442\u0430\u043A\u0438\u043C
      \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u0435\u043C \u0443\u0434\u0430\u0447\u0430
      \u043D\u0435 \u0445\u043E\u0434\u0438\u0442. \u0412\u0430\u0440\u0433\u0430
      \u0445\u043E\u0447\u0435\u0442 \u0443\u0439\u0442\u0438 \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435.
      \u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u0442\u043E\u0436\u0435 \u0434\u0443\u043C\u0430\u0435\u0442.
      \u0422\u044B \u0447\u0442\u043E-\u043D\u0438\u0431\u0443\u0434\u044C \u0441\u043A\u0430\u0436\u0435\u0448\u044C
      \u0438\u043C?</npc_speech> \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044F - \u044D\u0442\u043E
      \u0441\u0443\u0434\u044C\u0431\u0430 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0432 \u0433\u043B\u0430\u0437\u0430\u0445 \u0440\u0430\u0431\u043E\u0442\u043D\u0438\u043A\u043E\u0432.
      \u041A\u0442\u043E \u0445\u043E\u0447\u0435\u0442 \u0441\u043B\u0443\u0436\u0438\u0442\u044C
      \u0442\u043E\u043C\u0443, \u043E \u043A\u043E\u043C \u043F\u043B\u043E\u0445\u043E
      \u0433\u043E\u0432\u043E\u0440\u044F\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247676
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0438
      \u043F\u043E\u0432\u044B\u0441\u0438\u0442\u044C \u043E\u043F\u043B\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247677
    m_Localized: "\u041F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043F\u0440\u0438\u0431\u0430\u0432\u043A\u0438. \u0412\u0430\u0440\u0433\u0430
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F. \u041C\u043E\u043B\u043E\u0434\u043E\u0439
      \u0442\u043E\u0436\u0435. \u0414\u0443\u0445 \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F
      - \u043D\u0435 \u043E\u0442 \u0441\u043B\u043E\u0432, \u043E\u0442 \u0441\u0435\u0440\u0435\u0431\u0440\u0430.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0432\u044B\u0440\u043E\u0432\u043D\u044F\u043B\u0430\u0441\u044C: \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C
      \u0443\u043C\u0435\u0435\u0442 \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043B\u044E\u0434\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247678
    m_Localized: "\u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0434\u0435\u043B\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247679
    m_Localized: "\u0412\u0430\u0440\u0433\u0430 \u0443\u0448\u0451\u043B \u0432
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435. \u041C\u043E\u043B\u043E\u0434\u043E\u0439
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F, \u043D\u043E \u0440\u0430\u0431\u043E\u0442\u0430\u043B
      \u043C\u0440\u0430\u0447\u043D\u043E. \u0414\u0443\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0441\u044F \u043D\u0438\u0436\u0435
      - \u0438 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0432\u044B\u0440\u043E\u0441\u043B\u0430:
      \u043C\u0435\u043D\u044C\u0448\u0435 \u043B\u044E\u0434\u0435\u0439, \u0445\u0443\u0436\u0435
      \u043E\u0445\u0440\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247680
    m_Localized: "\u041F\u043E\u0434\u0441\u0442\u0430\u0432\u043D\u0430\u044F \u0441\u0434\u0435\u043B\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247681
    m_Localized: "\u041D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439 \u043A\u0443\u043F\u0435\u0446
      \u0432 \u0424\u0435\u0440\u0433\u0430\u043D\u0441\u043A\u043E\u0439 \u0434\u043E\u043B\u0438\u043D\u0435
      \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u043F\u0430\u0440\u0442\u0438\u044E
      \u043B\u0430\u0437\u0443\u0440\u0438\u0442\u0430 \u043F\u043E \u0441\u043C\u0435\u0448\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435 - \u0432\u0434\u0432\u043E\u0435 \u043D\u0438\u0436\u0435
      \u0440\u044B\u043D\u043A\u0430. \u0413\u043E\u0432\u043E\u0440\u0438\u0442
      \u0431\u044B\u0441\u0442\u0440\u043E, \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443: <npc_speech lang=\"Persian\">\u0421\u0440\u043E\u0447\u043D\u043E.
      \u041D\u0443\u0436\u043D\u044B \u0434\u0435\u043D\u044C\u0433\u0438. \u0417\u0430\u0431\u0435\u0440\u0438
      \u0441\u0435\u0439\u0447\u0430\u0441, \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0448\u044C
      \u043F\u043E\u0442\u043E\u043C.</npc_speech> \u041B\u0430\u0437\u0443\u0440\u0438\u0442
      \u0443 \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0440\u044F\u0434\u043E\u043C
      \u043D\u0435\u0442. \u0422\u043E\u0440\u0433\u043E\u0432\u043B\u044F \u0431\u0435\u0437
      \u043F\u0440\u043E\u0441\u043C\u043E\u0442\u0440\u0430 \u0442\u043E\u0432\u0430\u0440\u0430
      - \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u0430\u044F
      \u043B\u043E\u0432\u0443\u0448\u043A\u0430 \u0434\u043B\u044F \u0442\u0435\u0445,
      \u0443 \u043A\u043E\u0433\u043E \u043D\u0435\u0442 \u0441\u0432\u044F\u0437\u0435\u0439
      \u0434\u043B\u044F \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u0441\u043B\u0443\u0445\u043E\u0432.
      \u041F\u0440\u0438 \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E\u0439
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438 \u044D\u0442\u043E\u0442
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u043D\u0435 \u043F\u043E\u0434\u043E\u0448\u0451\u043B
      \u0431\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247682
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u043D\u0435 \u0433\u043B\u044F\u0434\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993419247683
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0438\u0441\u0447\u0435\u0437.
      \u0422\u043E\u0432\u0430\u0440 - \u043A\u0440\u0430\u0448\u0435\u043D\u044B\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C, \u043D\u0435 \u043B\u0430\u0437\u0443\u0440\u0438\u0442.
      \u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0443\u043F\u0430\u043B\u0430 \u0435\u0449\u0451 \u043D\u0438\u0436\u0435
      - \u0441\u0442\u0430\u043B\u0438 \u0436\u0435\u0440\u0442\u0432\u043E\u0439
      \u0442\u043E\u0433\u043E, \u043E\u0442 \u0447\u0435\u0433\u043E \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u044E\u0442
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435 \u0433\u0438\u043B\u044C\u0434\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441920
    m_Localized: "\u041F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
      \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441921
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0441\u0442\u0430\u043B \u0437\u0430\u0442\u044F\u0433\u0438\u0432\u0430\u0442\u044C,
      \u043F\u043E\u0442\u043E\u043C \u0438\u0441\u0447\u0435\u0437. \u0421\u0434\u0435\u043B\u043A\u0438
      \u043D\u0435 \u0431\u044B\u043B\u043E. \u0414\u0435\u043D\u044C\u0433\u0438
      \u0446\u0435\u043B\u044B, \u043D\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0432\u0440\u0435\u043C\u044F \u043D\u0430 \u043F\u0443\u0441\u0442\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441922
    m_Localized: "\u0421\u0442\u0440\u0430\u043D\u043D\u0430\u044F \u0441\u0434\u0435\u043B\u043A\u0430
      \u043C\u043E\u043D\u0430\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441923
    m_Localized: "\u0411\u0443\u0434\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u043C\u043E\u043D\u0430\u0445
      \u0443 \u0434\u043E\u0440\u043E\u0433\u0438 - \u043B\u044B\u0441\u044B\u0439,
      \u0432 \u0437\u0430\u043F\u043B\u0430\u0442\u0430\u043D\u043D\u043E\u0439 \u0448\u0430\u0444\u0440\u0430\u043D\u043E\u0432\u043E\u0439
      \u0440\u043E\u0431\u0435 - \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u043E\u0431\u043E\u0437 \u0431\u0435\u0437 \u0432\u044B\u0440\u0430\u0436\u0435\u043D\u0438\u044F,
      \u043F\u043E\u043A\u0430 \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u0431\u043B\u0438\u0436\u0435: <npc_speech lang=\"Chinese\">\u0422\u044B \u0435\u0434\u0435\u0448\u044C
      \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A. \u042F \u0442\u043E\u0436\u0435.
      \u0422\u0440\u0438 \u043D\u043E\u0447\u0438 \u043C\u043E\u043B\u0438\u0442\u0432\u044B
      \u0437\u0430 \u0433\u0440\u0443\u0437 \u0432\u0430\u0448\u0435\u0433\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430. \u0412\u0437\u0430\u043C\u0435\u043D
      - \u043D\u043E\u0447\u043B\u0435\u0433 \u0438 \u0435\u0434\u0430. \u041C\u043E\u043D\u0430\u0445
      \u043D\u0435 \u0431\u0435\u0440\u0451\u0442 \u0434\u0435\u043D\u044C\u0433\u0438.</npc_speech>
      \u041C\u043E\u043B\u0438\u0442\u0432\u0430 - \u043D\u0435\u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044C\u043D\u043E\u0435,
      \u043D\u043E\u0447\u043B\u0435\u0433 - \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0439
      \u0440\u0430\u0441\u0445\u043E\u0434. \u041D\u043E \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0441\u0443\u0435\u0432\u0435\u0440\u043D\u044B: \u043C\u043E\u043D\u0430\u0445
      \u0432 \u043E\u0431\u043E\u0437\u0435 \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442
      \u0434\u0443\u0445. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0441\u0440\u0435\u0434\u043D\u044F\u044F - \u043C\u043E\u043D\u0430\u0445
      \u043D\u0435 \u0443\u0432\u0435\u0440\u0435\u043D, \u0441\u0442\u043E\u0438\u0442
      \u043B\u0438 \u0434\u043E\u0432\u0435\u0440\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441924
    m_Localized: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0443\u0441\u043B\u043E\u0432\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441925
    m_Localized: "\u0422\u0440\u0438 \u043D\u043E\u0447\u0438 \u043C\u043E\u043D\u0430\u0445
      \u0447\u0438\u0442\u0430\u043B \u0441\u0443\u0442\u0440\u044B \u0443 \u043A\u043E\u0441\u0442\u0440\u0430.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0441\u043B\u0443\u0448\u0430\u043B\u0438
      - \u043A\u0442\u043E \u0441 \u0432\u0435\u0440\u043E\u0439, \u043A\u0442\u043E
      \u0438\u0437 \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0438.
      \u0414\u0443\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F,
      \u0430 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u0441\u043D\u0438\u0437\u0438\u043B\u0430\u0441\u044C:
      \u043D\u0430 \u043F\u043E\u0441\u0442\u0443 \u0446\u0437\u0435\u0434\u0443\u0448\u0438
      \u0441 \u043C\u043E\u043D\u0430\u0445\u043E\u043C \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u0434\u043E\u0431\u0440\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441926
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C \u0438 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C
      \u0434\u0435\u043D\u044C\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441927
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u043F\u043E\u043A\u0430\u0447\u0430\u043B
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u043D\u0430 \u0434\u0435\u043D\u044C\u0433\u0438
      \u0438 \u043F\u043E\u0448\u0451\u043B \u0441\u0432\u043E\u0435\u0439 \u0434\u043E\u0440\u043E\u0433\u043E\u0439.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u043F\u0440\u0438 \u0432\u0430\u0441. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u043E\u0436\u0430\u043B\u0438 \u043F\u043B\u0435\u0447\u0430\u043C\u0438
      - \u0436\u0435\u0441\u0442 \u043D\u0430\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044F,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0434\u0443\u043C\u0430\u0435\u0442
      \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u0435\u0441\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441928
    m_Localized: "\u041F\u0443\u0441\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441929
    m_Localized: "\u041C\u043E\u043D\u0430\u0445 \u0448\u0451\u043B \u0442\u0440\u0438
      \u0434\u043D\u044F, \u0447\u0438\u0442\u0430\u043B \u0442\u0438\u0445\u043E.
      \u0423 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u043F\u043E\u0441\u0442\u0430
      \u0441\u043E\u043B\u0434\u0430\u0442 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B
      \u043E\u0431\u043E\u0437 \u0431\u0435\u0437 \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432
      - \u043B\u0438\u0446\u043E \u043C\u043E\u043D\u0430\u0445\u0430 \u043E\u043D
      \u0437\u043D\u0430\u043B. \u0414\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043D\u0430\u0432\u044B\u043A: \u0438\u043D\u043E\u0433\u0434\u0430 \u043F\u043E\u043F\u0443\u0442\u0447\u0438\u043A
      \u0432\u0430\u0436\u043D\u0435\u0435 \u043F\u043E\u043F\u0443\u0442\u043D\u043E\u0433\u043E
      \u0432\u0435\u0442\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441930
    m_Localized: "\u0412\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0439 \u0441\u043E\u044E\u0437
      \u0441 \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441931
    m_Localized: "\u041A\u0443\u043F\u0435\u0446 \u0417\u0430\u0444\u0430\u0440 -
      \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442, \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E
      \u0432\u0438\u0434\u0435\u043B\u0438 \u0432 \u0442\u0440\u0451\u0445 \u0433\u043E\u0440\u043E\u0434\u0430\u0445
      \u043D\u0430 \u0442\u043E\u043C \u0436\u0435 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0435
      - \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u044B\u0432\u0430\u0435\u0442
      \u0443 \u0432\u044B\u0445\u043E\u0434\u0430 \u043D\u0430 \u043F\u0430\u043C\u0438\u0440\u0441\u043A\u0443\u044E
      \u0442\u0440\u043E\u043F\u0443. \u041B\u0438\u0446\u043E \u0435\u0433\u043E
      \u0443\u0441\u0442\u0430\u043B\u043E, \u0432\u044C\u044E\u043A\u0438 \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0435\u043D\u044B:
      <npc_speech lang=\"Persian\">\u041C\u043E\u0438 \u043B\u044E\u0434\u0438 \u0431\u043E\u044F\u0442\u0441\u044F
      \u0433\u043E\u0440\u043D\u044B\u0445 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432.
      \u0422\u0432\u043E\u0438, \u0433\u043E\u0432\u043E\u0440\u044F\u0442, \u043F\u0440\u043E\u0448\u043B\u0438
      \u0437\u0434\u0435\u0441\u044C \u0432 \u043F\u0440\u043E\u0448\u043B\u043E\u043C
      \u0433\u043E\u0434\u0443. \u041F\u043E\u0439\u0434\u0451\u043C \u0432\u043C\u0435\u0441\u0442\u0435
      \u0434\u043E \u0424\u0435\u0440\u0433\u0430\u043D\u044B - \u043F\u043E\u0442\u043E\u043C
      \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u0430\u043C.</npc_speech> \u041A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 - \u043D\u0435 \u0432\u0440\u0430\u0433.
      \u041E\u0431\u044A\u0435\u0434\u0438\u043D\u0451\u043D\u043D\u044B\u0439 \u043E\u0431\u043E\u0437
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435, \u043D\u043E
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435: \u0443 \u0417\u0430\u0444\u0430\u0440\u0430
      \u0440\u0430\u0437\u043D\u044B\u0439 \u0442\u0435\u043C\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441932
    m_Localized: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0441\u043E\u044E\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441933
    m_Localized: "\u0422\u0440\u0438 \u0434\u043D\u044F \u0447\u0435\u0440\u0435\u0437
      \u041F\u0430\u043C\u0438\u0440 \u0432\u043C\u0435\u0441\u0442\u0435. \u0417\u0430\u0444\u0430\u0440
      \u0437\u043D\u0430\u043B \u043E\u0434\u0438\u043D \u0431\u0440\u043E\u0434,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u043D\u0435 \u0431\u044B\u043B\u043E
      \u043D\u0430 \u0432\u0430\u0448\u0435\u0439 \u043A\u0430\u0440\u0442\u0435.
      \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B \u0431\u0435\u0437
      \u043F\u043E\u0442\u0435\u0440\u044C, \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u0441\u043D\u0438\u0437\u0438\u043B\u0430\u0441\u044C. \u041D\u0430\u0432\u044B\u043A
      \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438 \u0432\u044B\u0440\u043E\u0441
      - \u0417\u0430\u0444\u0430\u0440 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B
      \u043E \u0446\u0435\u043D\u0430\u0445 \u0432 \u0424\u0435\u0440\u0433\u0430\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441934
    m_Localized: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F
      \u0437\u0430 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0443\u044E \u043F\u043B\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441935
    m_Localized: "\u0417\u0430\u0444\u0430\u0440 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0437\u0430 \u0437\u0430\u0449\u0438\u0442\u0443. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430
      \u0432\u044B\u0433\u043E\u0434\u043D\u0435\u0435 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438
      \u0449\u0435\u0434\u0440\u043E\u0433\u043E - \u044D\u0442\u043E \u0434\u0435\u043B\u043E\u0432\u044B\u0435
      \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F, \u043D\u0435 \u0434\u0440\u0443\u0436\u0431\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441936
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441937
    m_Localized: "\u0417\u0430\u0444\u0430\u0440 \u043F\u043E\u0448\u0451\u043B \u0441\u0430\u043C
      - \u0438 \u043E\u0431\u043E\u0433\u043D\u0430\u043B \u0432\u0430\u0441 \u0432
      \u0424\u0435\u0440\u0433\u0430\u043D\u0435 \u043D\u0430 \u0434\u0432\u0430
      \u0434\u043D\u044F: \u043B\u0451\u0433\u043A\u0438\u0439 \u043E\u0431\u043E\u0437
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435. \u041E\u0442\u043A\u0430\u0437
      \u043E\u0442 \u0441\u043E\u044E\u0437\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B
      \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u044C
      \u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441938
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0447\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441939
    m_Localized: "\u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0432 \u0434\u043E\u0440\u043E\u0433\u043E\u043C \u043F\u043E\u044F\u0441\u0435,
      \u043D\u043E \u0441\u0442\u043E\u043F\u0442\u0430\u043D\u043D\u044B\u0445 \u0441\u0430\u043F\u043E\u0433\u0430\u0445,
      \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0431\u043E\u043B\u0442
      \u0448\u0451\u043B\u043A\u0430 \u0437\u0430 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u0435\u0433\u043E \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u0438 -
      \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043F\u0440\u044F\u043C\u043E
      \u0432 \u0433\u043B\u0430\u0437\u0430: <npc_speech lang=\"Sogdian\">\u042F
      \u0441\u043F\u0435\u0448\u0443. \u0411\u0435\u0440\u0438. \u0418\u043B\u0438
      \u0442\u044B \u0438\u0437 \u0442\u0435\u0445, \u043A\u0442\u043E \u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
      \u0447\u0443\u0436\u043E\u0439 \u0431\u0435\u0434\u043E\u0439?</npc_speech>
      \u042D\u0442\u043E \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F \u043D\u0443\u0436\u0434\u0430.
      \u0418\u043B\u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 - \u0442\u0430\u043A\u0438\u0435
      \u0443\u0441\u0442\u0440\u0430\u0438\u0432\u0430\u044E\u0442 \u043E\u043F\u044B\u0442\u043D\u044B\u0435
      \u043A\u0443\u043F\u0446\u044B, \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u043D\u044F\u0442\u044C,
      \u0441 \u043A\u0435\u043C \u0438\u043C\u0435\u044E\u0442 \u0434\u0435\u043B\u043E.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u043D\u0430 \u0441\u0440\u0435\u0434\u043D\u0435\u043C
      \u0443\u0440\u043E\u0432\u043D\u0435: \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E,
      \u0447\u0442\u043E \u043E\u043D \u043E \u0432\u0430\u0441 \u0441\u043B\u044B\u0448\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441940
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u043F\u043E \u0437\u0430\u043D\u0438\u0436\u0435\u043D\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441941
    m_Localized: "\u0421\u0434\u0435\u043B\u043A\u0430 \u0432\u044B\u0433\u043E\u0434\u043D\u0430\u044F.
      \u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u043A\u0438\u0432\u043D\u0443\u043B \u0431\u0435\u0437 \u044D\u043C\u043E\u0446\u0438\u0439
      \u0438 \u0443\u0448\u0451\u043B. \u041F\u043E\u0437\u0436\u0435 \u0443\u0437\u043D\u0430\u043B\u0438:
      \u043F\u043B\u0435\u043C\u044F\u043D\u043D\u0438\u043A \u043A\u0440\u0443\u043F\u043D\u043E\u0433\u043E
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0433\u043E \u043A\u0443\u043F\u0446\u0430
      - \u043F\u0440\u043E\u0432\u0435\u0440\u044F\u043B \u043D\u043E\u0432\u044B\u0445
      \u043F\u0430\u0440\u0442\u043D\u0451\u0440\u043E\u0432. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0443\u043F\u0430\u043B\u0430 \u0432 \u0435\u0433\u043E \u0433\u043B\u0430\u0437\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441942
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u0443\u044E
      \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441943
    m_Localized: "\u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F - \u043F\u0435\u0440\u0432\u044B\u0439
      \u0440\u0430\u0437 \u0437\u0430 \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440.
      \u0421\u0434\u0435\u043B\u043A\u0430 \u043F\u043E \u043F\u043E\u043B\u043D\u043E\u0439
      \u0446\u0435\u043D\u0435 \u043F\u0440\u043E\u0448\u043B\u0430 \u0431\u044B\u0441\u0442\u0440\u043E.
      \u041F\u043E\u0437\u0436\u0435 \u0432\u044B\u044F\u0441\u043D\u0438\u043B\u043E\u0441\u044C:
      \u043F\u043B\u0435\u043C\u044F\u043D\u043D\u0438\u043A \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0430.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0432 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u0439
      \u0441\u0435\u0442\u0438 \u0432\u044B\u0440\u043E\u0441\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441944
    m_Localized: "\u0423\u0439\u0442\u0438 \u0431\u0435\u0437 \u0441\u0434\u0435\u043B\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441945
    m_Localized: "\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B\u0438 \u0445\u043E\u0440\u043E\u0448\u0443\u044E
      \u0446\u0435\u043D\u0443 \u0438 \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C
      \u043D\u0435\u043F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u043C\u0438.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0432\u0440\u0435\u043C\u044F,
      \u043D\u0435 \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u043B\u0438 \u043D\u0438
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438, \u043D\u0438 \u0442\u043E\u0432\u0430\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441946
    m_Localized: "\u0417\u0430\u0439\u043C \u0443 \u0440\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441947
    m_Localized: "\u0420\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A \u0410\u0431\u0443
      \u0421\u0430\u043B\u0435\u0445 \u0441\u0438\u0434\u0438\u0442 \u0432 \u0442\u0435\u043D\u0438
      \u043D\u0430\u0432\u0435\u0441\u0430 \u0437\u0430 \u0441\u0442\u043E\u043B\u043E\u043C
      \u0441 \u0432\u0435\u0441\u0430\u043C\u0438 \u0438 \u0441\u0442\u043E\u043F\u043A\u043E\u0439
      \u043C\u0435\u0434\u043D\u044B\u0445 \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432.
      \u0421\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u043D\u0438\u043C\u0430\u0442\u0435\u043B\u044C\u043D\u043E,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C:
      <npc_speech lang=\"Persian\">\u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u043F\u043E\u0434 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u043C\u043E\u043D\u0435\u0442 \u0432\u043E\u0437\u0432\u0440\u0430\u0442\u0430
      \u0447\u0435\u0440\u0435\u0437 \u0448\u0435\u0441\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u0434\u043D\u0435\u0439. \u0423\u043C\u0435\u0440\u0435\u043D\u043D\u044B\u0439
      \u043F\u0440\u043E\u0446\u0435\u043D\u0442 - \u0434\u043B\u044F \u0442\u0435\u0445,
      \u0447\u044C\u0451 \u0441\u043B\u043E\u0432\u043E \u043D\u0435 \u0441\u043E\u0432\u0441\u0435\u043C
      \u043F\u0443\u0441\u0442\u043E\u0435.</npc_speech> \u041D\u0435 \u043B\u0443\u0447\u0448\u0438\u0435
      \u0443\u0441\u043B\u043E\u0432\u0438\u044F, \u043D\u043E \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u044B\u0435
      \u043F\u0440\u0438 \u0441\u0440\u0435\u0434\u043D\u0435\u0439 \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438.
      \u0420\u0438\u0441\u043A: \u0435\u0441\u043B\u0438 \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u0442\u044C
      - \u0438\u043C\u044F \u0441\u0442\u0430\u043D\u0435\u0442 \u0445\u0443\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441948
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0437\u0430\u0439\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441949
    m_Localized: "\u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043D\u0430 \u0440\u0443\u043A\u0438. \u0427\u0435\u0440\u0435\u0437 \u0448\u0435\u0441\u0442\u044C\u0434\u0435\u0441\u044F\u0442
      \u0434\u043D\u0435\u0439 \u043D\u0443\u0436\u043D\u043E \u0432\u0435\u0440\u043D\u0443\u0442\u044C
      \u0441\u0435\u043C\u044C\u0434\u0435\u0441\u044F\u0442. \u0414\u0435\u043D\u044C\u0433\u0438
      \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442 \u043D\u0430 \u043F\u0443\u0442\u0438
      - \u0435\u0441\u043B\u0438 \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u044F
      \u043F\u043E\u0439\u0434\u0451\u0442, \u0437\u0430\u0439\u043C \u043E\u043A\u0443\u043F\u0438\u0442\u0441\u044F.
      \u0415\u0441\u043B\u0438 \u043D\u0435\u0442 - \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0443\u043F\u0430\u0434\u0451\u0442 \u043A \u0443\u0440\u043E\u0432\u043D\u044E
      \u0434\u043E\u043B\u0436\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441950
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043C\u0435\u043D\u044C\u0448\u0443\u044E
      \u0441\u0443\u043C\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441951
    m_Localized: "\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432.
      \u041C\u0435\u043D\u044C\u0448\u0438\u0439 \u0434\u043E\u043B\u0433 - \u043C\u0435\u043D\u044C\u0448\u0438\u0439
      \u0440\u0438\u0441\u043A. \u0410\u0431\u0443 \u0421\u0430\u043B\u0435\u0445
      \u043A\u0438\u0432\u043D\u0443\u043B \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E:
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u0439 \u0437\u0430\u0451\u043C\u0449\u0438\u043A
      \u043D\u0430\u0434\u0451\u0436\u043D\u0435\u0435 \u0436\u0430\u0434\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441952
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441953
    m_Localized: "\u0410\u0431\u0443 \u0421\u0430\u043B\u0435\u0445 \u0443\u0431\u0440\u0430\u043B
      \u0434\u0435\u043D\u044C\u0433\u0438 \u0431\u0435\u0437 \u0441\u043B\u043E\u0432.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u0430\u044F:
      \u0442\u043E\u0442, \u043A\u0442\u043E \u043D\u0435 \u043B\u0435\u0437\u0435\u0442
      \u0432 \u0434\u043E\u043B\u0433\u0438, \u043D\u0435 \u0440\u0438\u0441\u043A\u0443\u0435\u0442
      \u0438\u043C\u0438 \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441954
    m_Localized: "\u0421\u043B\u0443\u0445\u0438 \u0433\u043E\u043D\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441955
    m_Localized: "\u0423\u0441\u0442\u0430\u043B\u044B\u0439 \u0433\u043E\u043D\u0435\u0446
      \u0441 \u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439 \u043F\u044B\u043B\u044C\u044E
      \u043D\u0430 \u043B\u0438\u0446\u0435 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u043A\u043E\u043D\u044F \u0440\u044F\u0434\u043E\u043C \u0441 \u043E\u0431\u043E\u0437\u043E\u043C
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0438\u0441\u043B\u043E\u0432\u0438\u0439:
      <npc_speech lang=\"Chinese\">\u0422\u044B \u0438\u0434\u0451\u0448\u044C \u043D\u0430
      \u0437\u0430\u043F\u0430\u0434? \u0412 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u0441\u0431\u043E\u0440 \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u043D\u0435\u0439. \u0413\u043E\u0432\u043E\u0440\u044F\u0442, \u0446\u0435\u043D\u044B
      \u043D\u0430 \u043B\u0430\u0437\u0443\u0440\u0438\u0442 \u0443\u043F\u0430\u0434\u0443\u0442
      - \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439 \u043E\u0431\u043E\u0437
      \u0441 \u0437\u0430\u043F\u0430\u0441\u0430\u043C\u0438 \u0443\u0436\u0435
      \u0432 \u043F\u0443\u0442\u0438.</npc_speech> \u0413\u043E\u043D\u0446\u044B
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445 \u0434\u043E\u043C\u043E\u0432
      \u043F\u0440\u043E\u0434\u0430\u044E\u0442 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E
      \u0432\u0441\u0435\u043C \u043F\u043E\u0434\u0440\u044F\u0434 \u0438\u043B\u0438
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0443\u0436\u043D\u044B\u043C -
      \u0432 \u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E\u0441\u0442\u0438 \u043E\u0442
      \u0442\u043E\u0433\u043E, \u043A\u0442\u043E \u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441956
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441957
    m_Localized: "\u0421\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043B\u0438
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0438 \u0434\u043E\u0448\u043B\u0438
      \u0434\u043E \u0441\u0431\u043E\u0440\u0430 \u0432\u043E\u0432\u0440\u0435\u043C\u044F.
      \u041D\u0430\u0432\u044B\u043A \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438
      \u0432\u044B\u0440\u043E\u0441 - \u0432\u043E\u0432\u0440\u0435\u043C\u044F
      \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
      \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0440\u043E\u0436\u0435 \u043B\u044E\u0431\u043E\u0433\u043E
      \u0442\u043E\u0432\u0430\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441958
    m_Localized: "\u041F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u0442\u044C
      \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441959
    m_Localized: "\u0418\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044E \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438,
      \u043D\u043E \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u043D\u0435 \u043C\u0435\u043D\u044F\u043B\u0438.
      \u0414\u0443\u0445 \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F
      - \u0445\u043E\u0440\u043E\u0448\u0438\u0435 \u043D\u043E\u0432\u043E\u0441\u0442\u0438
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043B\u0443\u0447\u0448\u0435 \u0442\u0438\u0448\u0438\u043D\u044B
      \u0432 \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441960
    m_Localized: "\u041C\u043E\u043B\u043E\u0434\u043E\u0439 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441961
    m_Localized: "\u0423 \u0432\u043E\u0440\u043E\u0442 \u041A\u0430\u0448\u0433\u0430\u0440\u0430
      \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0443\u0439\u0433\u0443\u0440 \u0441
      \u0445\u043E\u0440\u043E\u0448\u0438\u043C \u043F\u0440\u0438\u0446\u0435\u043B\u043E\u043C
      \u0440\u0435\u0447\u0438 \u0438 \u0434\u044B\u0440\u043E\u0439 \u0432 \u0441\u0430\u043F\u043E\u0433\u0435
      \u043F\u0440\u0435\u0434\u043B\u0430\u0433\u0430\u0435\u0442 \u0441\u0435\u0431\u044F
      \u0432 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u0438:
      <npc_speech lang=\"Sogdian\">\u0417\u043D\u0430\u044E \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u0439,
      \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439, \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u0439. \u0414\u0451\u0448\u0435\u0432\u043E
      \u0431\u0435\u0440\u0443. \u041D\u0430\u0434\u0451\u0436\u0435\u043D \u043B\u0438
      - \u0443\u0437\u043D\u0430\u0435\u0448\u044C \u0432 \u0434\u043E\u0440\u043E\u0433\u0435.</npc_speech>
      \u0414\u0451\u0448\u0435\u0432 - \u0437\u043D\u0430\u0447\u0438\u0442 \u0438\u043B\u0438
      \u043C\u043E\u043B\u043E\u0434, \u0438\u043B\u0438 \u043D\u0435\u043D\u0430\u0434\u0451\u0436\u0435\u043D,
      \u0438\u043B\u0438 \u043E\u0431\u0430 \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430
      \u0441\u0440\u0430\u0437\u0443. \u041F\u0440\u0438 \u0441\u0440\u0435\u0434\u043D\u0435\u0439
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438 \u0442\u0430\u043A\u0438\u0435
      \u043A\u0430\u043D\u0434\u0438\u0434\u0430\u0442\u044B \u0441\u0430\u043C\u0438
      \u0432\u044B\u0431\u0438\u0440\u0430\u044E\u0442, \u043A \u043A\u043E\u043C\u0443
      \u0438\u0434\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441962
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u0437\u0430 \u0441\u0442\u0430\u043D\u0434\u0430\u0440\u0442\u043D\u0443\u044E
      \u043F\u043B\u0430\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441963
    m_Localized: "\u0423\u0439\u0433\u0443\u0440 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043C\u043E\u043B\u043E\u0434\u044B\u043C, \u043D\u043E \u0441\u043C\u044B\u0448\u043B\u0451\u043D\u044B\u043C.
      \u041D\u0430 \u043F\u043E\u0441\u0442\u0443 \u0446\u0437\u0435\u0434\u0443\u0448\u0438
      \u043F\u0435\u0440\u0435\u0432\u0451\u043B \u0442\u043E\u0447\u043D\u043E -
      \u043D\u0438 \u0441\u043B\u043E\u0432\u0430 \u043B\u0438\u0448\u043D\u0435\u0433\u043E.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0443 \u0434\u043E\u0431\u0430\u0432\u0438\u043B\u0441\u044F
      \u0441\u043F\u0443\u0442\u043D\u0438\u043A-\u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441964
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441965
    m_Localized: "\u0411\u0435\u0437 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u0430
      \u043F\u0440\u043E\u0448\u043B\u0438 \u043F\u043E\u0441\u0442 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E
      - \u0434\u043E\u043B\u044C\u0448\u0435 \u0438 \u0441 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u043E\u0439
      \u0443 \u0432\u043E\u0440\u043E\u0442. \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u0447\u0443\u0442\u044C \u0432\u044B\u0440\u043E\u0441\u043B\u0430: \u043D\u0435\u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u044F\u0437\u044B\u043A\u0430 \u0440\u043E\u0436\u0434\u0430\u0435\u0442 \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0435
      \u0443 \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441966
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u0441\u043D\u0430\u0447\u0430\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441967
    m_Localized: "\u0422\u0440\u0438 \u0434\u043D\u044F \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F.
      \u041F\u0435\u0440\u0435\u0432\u043E\u0434 \u0432\u0435\u0440\u043D\u044B\u0439,
      \u0445\u043E\u0442\u044F \u043D\u0435\u043B\u043E\u0432\u043A\u0438\u0439.
      \u0420\u0435\u0448\u0438\u043B\u0438 \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      - \u0434\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043D\u0430\u0432\u044B\u043A \u0432\u044B\u0440\u043E\u0441 \u043E\u0442
      \u0440\u0430\u0431\u043E\u0442\u044B \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u0441\u0440\u0435\u0434\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441968
    m_Localized: "\u041B\u043E\u0448\u0430\u0434\u044C \u0437\u0430 \u0442\u043E\u0432\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441969
    m_Localized: "\u041A\u043E\u0447\u0435\u0432\u043E\u0439 \u0442\u044E\u0440\u043A
      \u043D\u0430 \u043F\u0435\u0433\u043E\u0439 \u043A\u043E\u0431\u044B\u043B\u0435
      \u043F\u043E\u0434\u044A\u0435\u0437\u0436\u0430\u0435\u0442 \u043A \u043E\u0431\u043E\u0437\u0443
      \u0443 \u0441\u0442\u0435\u043F\u043D\u043E\u0439 \u0441\u0442\u043E\u044F\u043D\u043A\u0438.
      \u041B\u043E\u0448\u0430\u0434\u044C \u043A\u0440\u0435\u043F\u043A\u0430\u044F
      - \u0448\u0438\u0440\u043E\u043A\u0430\u044F \u0433\u0440\u0443\u0434\u044C,
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435 \u043D\u043E\u0433\u0438,
      \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u043D\u0430\u044F
      \u043A \u0433\u043E\u0440\u043D\u044B\u043C \u0442\u0440\u043E\u043F\u0430\u043C:
      <npc_speech lang=\"Turkic\">\u0425\u043E\u0447\u0443 \u0448\u0451\u043B\u043A
      - \u0434\u0432\u0430 \u0431\u043E\u043B\u0442\u0430, \u0437\u0430 \u043A\u043E\u0431\u044B\u043B\u0443.
      \u0427\u0435\u0441\u0442\u043D\u044B\u0439 \u043A\u0443\u0440\u0441, \u043D\u0435
      \u0442\u043E\u0440\u0433\u0443\u044E\u0441\u044C.</npc_speech> \u041B\u043E\u0448\u0430\u0434\u044C
      \u0441\u0442\u043E\u0438\u0442 \u0442\u0440\u0451\u0445 \u0431\u043E\u043B\u0442\u043E\u0432
      \u043F\u043E \u0440\u044B\u043D\u043E\u0447\u043D\u044B\u043C \u0446\u0435\u043D\u0430\u043C,
      \u0434\u0432\u0430 - \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E
      \u0434\u043B\u044F \u0441\u0442\u0435\u043F\u043D\u043E\u0433\u043E \u043E\u0431\u043C\u0435\u043D\u0430.
      \u0422\u044E\u0440\u043A \u043D\u0435 \u043B\u0436\u0451\u0442 \u043E \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0435:
      \u043A\u043E\u0431\u044B\u043B\u0430 \u0437\u0434\u043E\u0440\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441970
    m_Localized: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043E\u0431\u043C\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441971
    m_Localized: "\u0414\u0432\u0430 \u0431\u043E\u043B\u0442\u0430 \u0448\u0451\u043B\u043A\u0430
      \u0437\u0430 \u043A\u0440\u0435\u043F\u043A\u0443\u044E \u043A\u043E\u0431\u044B\u043B\u0443.
      \u041B\u043E\u0448\u0430\u0434\u044C \u043F\u0440\u043E\u0448\u043B\u0430 \u0442\u0440\u0438
      \u0433\u043E\u0440\u043D\u044B\u0445 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430
      \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C \u0442\u0435\u043C\u043F\u0430.
      \u041D\u0430\u0432\u044B\u043A \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438
      \u0432\u044B\u0440\u043E\u0441: \u0431\u0430\u0440\u0442\u0435\u0440 \u0432
      \u0441\u0442\u0435\u043F\u0438 - \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u043E\u0435
      \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441972
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C \u0434\u043E\u0440\u043E\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441973
    m_Localized: "\u0422\u044E\u0440\u043A \u0434\u0430\u043B \u0442\u0440\u0438
      \u0431\u043E\u043B\u0442\u0430 \u0431\u0435\u0437 \u0441\u043F\u043E\u0440\u0430
      - \u0437\u043D\u0430\u0447\u0438\u0442, \u0437\u043D\u0430\u043B \u0446\u0435\u043D\u0443
      \u0438 \u0431\u044B\u043B \u0433\u043E\u0442\u043E\u0432. \u0425\u043E\u0440\u043E\u0448\u0430\u044F
      \u0441\u0434\u0435\u043B\u043A\u0430. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0447\u0435\u0441\u0442\u043D\u043E\u0433\u043E, \u043D\u043E \u043D\u0435\u0431\u0435\u0441\u043A\u043E\u0440\u044B\u0441\u0442\u043D\u043E\u0433\u043E
      \u043A\u0443\u043F\u0446\u0430 \u043F\u043E\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441974
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F \u043E\u0442
      \u0441\u0434\u0435\u043B\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441975
    m_Localized: "\u0422\u044E\u0440\u043A \u0443\u0435\u0445\u0430\u043B \u0441
      \u043A\u043E\u0431\u044B\u043B\u043E\u0439. \u0428\u0451\u043B\u043A \u043E\u0441\u0442\u0430\u043B\u0441\u044F.
      \u0421\u0434\u0435\u043B\u043A\u0443 \u043D\u0435 \u0437\u0430\u043A\u0440\u044B\u043B\u0438
      - \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0447\u0443\u0442\u044C
      \u043F\u0440\u043E\u0441\u0435\u043B\u0430: \u0442\u043E\u0442, \u043A\u0442\u043E
      \u043D\u0435 \u0443\u043C\u0435\u0435\u0442 \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C
      \u0432 \u0441\u0442\u0435\u043F\u0438, \u043D\u0435 \u0443\u043C\u0435\u0435\u0442
      \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C \u043D\u0438\u0433\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441976
    m_Localized: "\u0420\u0430\u0441\u0441\u0443\u0434\u0438\u0442\u044C \u0441\u043F\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441977
    m_Localized: "\u0414\u0432\u043E\u0435 \u043A\u0443\u043F\u0446\u043E\u0432 \u0441\u043F\u043E\u0440\u044F\u0442
      \u0443 \u0432\u0435\u0441\u043E\u0432 \u043F\u043E\u0441\u0440\u0435\u0434\u0438
      \u0434\u043E\u0440\u043E\u0433\u0438 - \u0433\u043E\u043B\u043E\u0441\u0430
      \u0433\u0440\u043E\u043C\u043A\u0438\u0435, \u0440\u0443\u043A\u0438 \u043D\u0430
      \u0442\u044E\u043A\u0435. \u041E\u0434\u0438\u043D - \u043F\u0435\u0440\u0441
      \u0438\u0437 \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0430, \u0434\u0440\u0443\u0433\u043E\u0439
      - \u0438\u043D\u0434\u0438\u0439\u0441\u043A\u0438\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0438\u0437 \u0421\u0438\u043D\u0434\u0430. \u041F\u0435\u0440\u0441 \u043A\u0440\u0438\u0447\u0438\u0442:
      <npc_speech lang=\"Persian\">\u0422\u0440\u0438 \u0440\u0430\u0442\u043B\u044F
      - \u043C\u044B \u0434\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u043B\u0438\u0441\u044C!
      \u041E\u043D \u0432\u0437\u0432\u0435\u0441\u0438\u043B \u0434\u0432\u0430
      \u0441 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043E\u0439!</npc_speech>
      \u041E\u043D\u0438 \u043E\u0431\u0430 \u0441\u043C\u043E\u0442\u0440\u044F\u0442
      \u043D\u0430 \u0432\u0430\u0441: \u0441\u043B\u044B\u0448\u0430\u043B\u0438,
      \u0447\u0442\u043E \u0432\u044B \u0437\u043D\u0430\u0435\u0442\u0435 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435
      \u043C\u0435\u0440\u044B. \u0417\u0430 \u0441\u043F\u043E\u0440\u043E\u043C
      \u043E \u0432\u0435\u0441\u0435 \u0442\u044E\u043A\u0430 - \u0434\u0435\u043D\u044C\u0433\u0438
      \u0438 \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u043E \u043E\u0431\u043E\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441978
    m_Localized: "\u0420\u0430\u0441\u0441\u0443\u0434\u0438\u0442\u044C \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441979
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\u0438 \u0432\u0435\u0441\u044B
      \u0438 \u043C\u0435\u0440\u044B - \u043F\u0435\u0440\u0441 \u0431\u044B\u043B
      \u043F\u0440\u0430\u0432. \u0418\u043D\u0434\u0438\u0435\u0446 \u043F\u0440\u0438\u0437\u043D\u0430\u043B
      \u0438 \u0434\u043E\u043F\u043B\u0430\u0442\u0438\u043B \u0440\u0430\u0437\u043D\u0438\u0446\u0443.
      \u041E\u0431\u0430 \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u043B\u0438\u0441\u044C
      \u0432\u0430\u043C. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0447\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u0430\u0440\u0431\u0438\u0442\u0440\u0430
      - \u0440\u0435\u0434\u043A\u0430\u044F \u0438 \u0434\u043E\u0440\u043E\u0433\u0430\u044F
      \u0432\u0435\u0449\u044C \u043D\u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445
      \u0434\u043E\u0440\u043E\u0433\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441980
    m_Localized: "\u041F\u043E\u0441\u043E\u0432\u0435\u0442\u043E\u0432\u0430\u0442\u044C
      \u043F\u043E\u0434\u0435\u043B\u0438\u0442\u044C \u0440\u0430\u0437\u043D\u0438\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441981
    m_Localized: "\u041E\u0431\u0430 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0438\u0441\u044C
      \u043D\u0435\u0445\u043E\u0442\u044F. \u041D\u0438\u043A\u0442\u043E \u043D\u0435
      \u0434\u043E\u0432\u043E\u043B\u0435\u043D \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      - \u0437\u0430\u0442\u043E \u043D\u0438\u043A\u0442\u043E \u0438 \u043D\u0435
      \u0432 \u0443\u0431\u044B\u0442\u043A\u0435. \u0422\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043D\u0430\u0432\u044B\u043A \u0432\u044B\u0440\u043E\u0441: \u043A\u043E\u043C\u043F\u0440\u043E\u043C\u0438\u0441\u0441
      \u0431\u044B\u0441\u0442\u0440\u0435\u0435 \u0438\u0441\u0442\u0438\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441982
    m_Localized: "\u0423\u0439\u0442\u0438 \u043D\u0435 \u0432\u043C\u0435\u0448\u0438\u0432\u0430\u044F\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441983
    m_Localized: "\u0421\u043F\u043E\u0440 \u0440\u0430\u0437\u0433\u043E\u0440\u0435\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435 \u0431\u0435\u0437 \u0432\u0430\u0441.
      \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u0434\u043E\u0448\u043B\u043E
      \u0434\u043E \u0441\u0442\u0440\u0430\u0436\u043D\u0438\u043A\u0430 \u043F\u043E\u0441\u0442\u0430.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0442\u043E\u0433\u043E,
      \u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u043C\u043E\u0433\u0430\u0435\u0442,
      \u043A\u043E\u0433\u0434\u0430 \u043C\u043E\u0436\u0435\u0442 - \u0442\u043E\u0436\u0435
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441984
    m_Localized: "\u041F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      \u043F\u0430\u0441\u0442\u0443\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441985
    m_Localized: "\u041F\u0430\u0441\u0442\u0443\u0445 \u0441 \u043E\u0442\u0430\u0440\u043E\u0439
      \u043E\u0432\u0435\u0446 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      \u043E\u0431\u043E\u0437 \u0436\u0435\u0441\u0442\u043E\u043C \u0440\u0443\u043A\u0438
      - \u0431\u0435\u0437 \u0441\u043B\u043E\u0432 \u0441\u043D\u0430\u0447\u0430\u043B\u0430,
      \u043F\u043E\u0442\u043E\u043C \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442: \u0436\u0435\u043B\u0442\u043E\u0432\u0430\u0442\u043E\u0435
      \u043D\u0435\u0431\u043E \u043D\u0430\u0434 \u0434\u044E\u043D\u0430\u043C\u0438,
      \u0442\u043E\u043D\u043A\u0430\u044F \u043F\u044B\u043B\u044C\u043D\u0430\u044F
      \u043F\u043E\u043B\u043E\u0441\u043A\u0430 \u0443 \u0437\u0435\u043C\u043B\u0438.
      <npc_speech lang=\"Persian\">\u0427\u0435\u0440\u0435\u0437 \u0434\u0432\u0430
      \u0447\u0430\u0441\u0430 - \u0431\u0443\u0440\u044F. \u042F \u043F\u0430\u0441
      \u0437\u0434\u0435\u0441\u044C \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C
      \u043B\u0435\u0442. \u0412\u0441\u0442\u0430\u043D\u044C \u0437\u0430 \u0442\u043E\u0439
      \u0433\u0440\u044F\u0434\u043E\u0439, \u0442\u0430\u043C \u0432\u0435\u0442\u0435\u0440
      \u043C\u0435\u043D\u044C\u0448\u0435.</npc_speech> \u041F\u0430\u0441\u0442\u0443\u0445\u0438
      \u0447\u0438\u0442\u0430\u044E\u0442 \u0441\u0442\u0435\u043F\u044C \u043B\u0443\u0447\u0448\u0435
      \u043B\u044E\u0431\u043E\u0439 \u043A\u0430\u0440\u0442\u044B. \u0411\u0443\u0440\u044F
      \u043C\u043E\u0436\u0435\u0442 \u0434\u043B\u0438\u0442\u044C\u0441\u044F \u0447\u0430\u0441
      \u0438\u043B\u0438 \u0442\u0440\u0438 \u0434\u043D\u044F - \u043D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0437\u043D\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441986
    m_Localized: "\u0412\u0441\u0442\u0430\u0442\u044C \u0437\u0430 \u0433\u0440\u044F\u0434\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441987
    m_Localized: "\u0411\u0443\u0440\u044F \u043F\u0440\u043E\u0448\u043B\u0430 \u0437\u0430
      \u0448\u0435\u0441\u0442\u044C \u0447\u0430\u0441\u043E\u0432. \u0417\u0430
      \u0433\u0440\u044F\u0434\u043E\u0439 \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043E\u0434\u0438\u043D \u0434\u0435\u043D\u044C, \u043D\u043E \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438
      \u0433\u0440\u0443\u0437 \u0438 \u043B\u044E\u0434\u0435\u0439. \u041F\u0430\u0441\u0442\u0443\u0445
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043F\u0440\u0430\u0432 -
      \u0432\u0435\u0442\u0435\u0440 \u0443 \u0433\u0440\u044F\u0434\u044B \u0431\u044B\u043B
      \u0432\u0434\u0432\u043E\u0435 \u0441\u043B\u0430\u0431\u0435\u0435, \u0447\u0435\u043C
      \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441988
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441989
    m_Localized: "\u0411\u0443\u0440\u044F \u043D\u0430\u043A\u0440\u044B\u043B\u0430
      \u043E\u0431\u043E\u0437 \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441.
      \u0414\u0432\u043E\u0435 \u0441\u0443\u0442\u043E\u043A \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E,
      \u0435\u0434\u0430 \u043E\u0442\u0441\u044B\u0440\u0435\u043B\u0430, \u043E\u0434\u0438\u043D
      \u0442\u044E\u043A \u0448\u0451\u043B\u043A\u0430 \u0438\u0441\u043F\u043E\u0440\u0447\u0435\u043D
      \u043F\u044B\u043B\u044C\u044E. \u041F\u0430\u0441\u0442\u0443\u0445 \u0432\u0438\u0434\u0435\u043B
      \u044D\u0442\u043E \u0441 \u0433\u0440\u044F\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441990
    m_Localized: "\u0417\u0430\u0431\u043B\u0443\u0434\u0438\u0432\u0448\u0438\u0439\u0441\u044F
      \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441991
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A \u0432 \u043F\u044B\u043B\u044C\u043D\u043E\u0439
      \u0431\u0435\u043B\u043E\u0439 \u0440\u0443\u0431\u0430\u0445\u0435 \u0441\u0438\u0434\u0438\u0442
      \u0443 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438 \u0438 \u0434\u0435\u0440\u0436\u0438\u0442
      \u0432 \u0440\u0443\u043A\u0430\u0445 \u043F\u0443\u0441\u0442\u0443\u044E
      \u0444\u043B\u044F\u0433\u0443 - \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0440\u0430\u0441\u0442\u0435\u0440\u044F\u043D\u043D\u043E. \u0423\u0432\u0438\u0434\u0435\u0432
      \u043E\u0431\u043E\u0437, \u0432\u0441\u0442\u0430\u0451\u0442: <npc_speech
      lang=\"Chinese\">\u042F \u0438\u0434\u0443 \u0432 \u0414\u0443\u043D\u044C\u0445\u0443\u0430\u043D,
      \u043A \u043F\u0435\u0449\u0435\u0440\u0430\u043C \u041C\u043E\u0433\u0430\u043E.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B \u0434\u043E\u0440\u043E\u0433\u0443
      \u0432\u0447\u0435\u0440\u0430. \u041D\u043E \u044F \u0437\u043D\u0430\u044E
      \u0442\u0430\u0439\u043D\u0443\u044E \u0442\u0440\u043E\u043F\u0443 \u0447\u0435\u0440\u0435\u0437
      \u0433\u043E\u0440\u043D\u0443\u044E \u0441\u043A\u043B\u0430\u0434\u043A\u0443
      - \u043E\u043D\u0430 \u043A\u043E\u0440\u043E\u0447\u0435 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
      \u043D\u0430 \u0434\u0435\u043D\u044C. \u041F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0435
      - \u043F\u043E\u043A\u0430\u0436\u0443.</npc_speech> \u0422\u0440\u043E\u043F\u0430
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F \u0438\u043B\u0438 \u043D\u0435\u0442
      - \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E. \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A
      \u043D\u0435 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043C\u043E\u0448\u0435\u043D\u043D\u0438\u043A\u043E\u043C,
      \u043D\u043E \u043C\u043E\u0436\u0435\u0442 \u043E\u0448\u0438\u0431\u0430\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441992
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043F\u0430\u043B\u043E\u043C\u043D\u0438\u043A\u0430
      \u0438 \u043F\u0440\u043E\u0439\u0442\u0438 \u0442\u0430\u0439\u043D\u043E\u0439
      \u0442\u0440\u043E\u043F\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441993
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0439 - \u0443\u0437\u043A\u043E\u0439,
      \u0441 \u043A\u0440\u0443\u0442\u044B\u043C\u0438 \u043A\u0430\u043C\u043D\u044F\u043C\u0438,
      \u043D\u043E \u0432\u0435\u0440\u043D\u043E\u0439. \u041E\u0434\u0438\u043D
      \u0434\u0435\u043D\u044C \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u043B\u0435\u043D.
      \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A \u0448\u0451\u043B \u043C\u043E\u043B\u0447\u0430
      \u0438 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C
      \u0443 \u0432\u043E\u0440\u043E\u0442 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044F.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0432\u044B\u0440\u043E\u0441\u043B\u0430
      \u043E\u0442 \u0434\u043E\u0431\u0440\u043E\u0433\u043E \u043F\u043E\u0441\u0442\u0443\u043F\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441994
    m_Localized: "\u0414\u0430\u0442\u044C \u0435\u0434\u044B \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C
      \u0434\u043E\u0440\u043E\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441995
    m_Localized: "\u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A \u0443\u0448\u0451\u043B
      \u043F\u043E \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0435
      \u0441 \u0435\u0434\u043E\u0439. \u041F\u043E\u043B\u0443\u0447\u0438\u043B\u0438
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0443\u044E \u0441\u0443\u043C\u043C\u0443
      \u0437\u0430 \u0434\u043E\u0431\u0440\u043E\u0442\u0443 - \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C,
      \u0443\u0437\u043D\u0430\u0432 \u043E \u043F\u043E\u0441\u0442\u0443\u043F\u043A\u0435,
      \u043F\u0435\u0440\u0435\u0434\u0430\u043B \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u0447\u0435\u0440\u0435\u0437 \u0433\u043E\u043D\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441996
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u0431\u0435\u0437
      \u043F\u043E\u043C\u043E\u0449\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441997
    m_Localized: "\u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B \u043C\u0438\u043C\u043E.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u043B\u0438\u0441\u044C
      - \u043C\u043E\u043B\u0447\u0430. \u041F\u0430\u043B\u043E\u043C\u043D\u0438\u043A
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u0432\u0441\u043B\u0435\u0434.
      \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u043D\u0430 \u0433\u043E\u0440\u043D\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0435 \u0432\u044B\u0440\u043E\u0441\u043B\u0430
      - \u0442\u0430\u043A\u0438\u0435 \u0432\u0437\u0433\u043B\u044F\u0434\u044B
      \u043F\u0440\u0438\u043D\u043E\u0441\u044F\u0442 \u043F\u043B\u043E\u0445\u0443\u044E
      \u043F\u043E\u0433\u043E\u0434\u0443, \u043A\u0430\u043A \u0433\u043E\u0432\u043E\u0440\u044F\u0442
      \u0432 \u0441\u0442\u0435\u043F\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441998
    m_Localized: "\u0417\u0430\u0441\u0430\u0434\u0430 \u0443 \u0433\u0440\u044F\u0434\u044B
      \u043A\u0430\u043C\u043D\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423441999
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u043F\u044B\u043B\u0438 \u0438
      \u043F\u0440\u043E\u0433\u043E\u0440\u043A\u043B\u043E\u0433\u043E \u043A\u0443\u043D\u0436\u0443\u0442\u043D\u043E\u0433\u043E
      \u043C\u0430\u0441\u043B\u0430 - \u0447\u0435\u0442\u044B\u0440\u0435 \u0441\u0438\u043B\u0443\u044D\u0442\u0430
      \u0432\u044B\u0445\u043E\u0434\u044F\u0442 \u0438\u0437-\u0437\u0430 \u0433\u0440\u044F\u0434\u044B
      \u0441\u0435\u0440\u044B\u0445 \u043A\u0430\u043C\u043D\u0435\u0439, \u0437\u0430\u0433\u043E\u0440\u0430\u0436\u0438\u0432\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0443. \u0412\u043F\u0435\u0440\u0435\u0434\u0438
      \u043A\u043E\u0440\u0435\u043D\u0430\u0441\u0442\u044B\u0439 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A
      \u0441 \u043A\u0440\u0438\u0432\u044B\u043C \u043D\u043E\u0436\u043E\u043C
      \u0432 \u043A\u0430\u0436\u0434\u043E\u0439 \u0440\u0443\u043A\u0435 \u043A\u0440\u0438\u0447\u0438\u0442
      \u043F\u043E-\u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438: \"\u0412\u0430\u0448\u0438
      \u0442\u044E\u043A\u0438 \u0438\u043B\u0438 \u0432\u0430\u0448\u0438 \u0436\u0438\u0437\u043D\u0438
      - \u0432\u044B\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0431\u044B\u0441\u0442\u0440\u043E\".
      \u041E\u043D\u0438 \u0445\u043E\u0440\u043E\u0448\u043E \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043B\u0438
      \u043C\u0435\u0441\u0442\u043E: \u0441\u043B\u0435\u0432\u0430 \u043E\u0431\u0440\u044B\u0432,
      \u0441\u043F\u0440\u0430\u0432\u0430 \u0441\u043A\u0430\u043B\u0430, \u043E\u0442\u0441\u0442\u0443\u043F\u0430\u0442\u044C
      \u043D\u0435\u043A\u0443\u0434\u0430. \u041D\u0430 \u043A\u043E\u043D\u0443
      \u0432\u0435\u0441\u044C \u0442\u043E\u0432\u0430\u0440 \u0438 \u0436\u0438\u0437\u043D\u0438
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432. \u0422\u0430\u043A\u0438\u0435
      \u0433\u0440\u044F\u0434\u044B \u043D\u0430 \u0440\u0430\u0432\u043D\u0438\u043D\u0430\u0445
      \u0425\u044D\u0441\u0438 \u0434\u0430\u0432\u043D\u043E \u0441\u0442\u0430\u043B\u0438
      \u0438\u0437\u043B\u044E\u0431\u043B\u0435\u043D\u043D\u044B\u043C\u0438 \u043C\u0435\u0441\u0442\u0430\u043C\u0438
      \u0434\u043B\u044F \u0437\u0430\u0441\u0430\u0434 - \u043C\u0435\u0441\u0442\u043D\u044B\u0435
      \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0438\u0445 \"\u0437\u0443\u0431\u0430\u043C\u0438
      \u0434\u0440\u0430\u043A\u043E\u043D\u0430\"."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442000
    m_Localized: "\u0414\u0430\u0442\u044C \u0431\u043E\u0439 - \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432
      \u0432\u0441\u0435\u0433\u043E \u0447\u0435\u0442\u0432\u0435\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442001
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438 \u043E\u0442\u0431\u0438\u043B\u0438
      \u0430\u0442\u0430\u043A\u0443. \u0414\u0432\u0443\u0445 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432
      \u0440\u0430\u043D\u0438\u043B\u0438, \u0434\u0432\u043E\u0435 \u0431\u0435\u0436\u0430\u043B\u0438.
      \u041F\u043E\u0442\u0435\u0440\u0438 - \u043E\u0434\u0438\u043D \u043F\u043E\u0440\u0435\u0437
      \u0443 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430, \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043C\u0435\u0448\u043A\u043E\u0432 \u043E\u043F\u0440\u043E\u043A\u0438\u043D\u0443\u0442\u043E.
      \u0423\u0433\u0440\u043E\u0437\u0430 \u043C\u0438\u043D\u043E\u0432\u0430\u043B\u0430,
      \u043D\u043E \u0448\u0443\u043C \u043C\u043E\u0433 \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u044C
      \u0434\u0440\u0443\u0433\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442002
    m_Localized: "\u041F\u0440\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F \u0441
      \u0440\u0430\u0437\u0433\u043E\u043D\u0430 \u043D\u0430 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442003
    m_Localized: "\u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u043F\u0440\u043E\u0448\u043B\u0438
      \u0441\u043A\u0432\u043E\u0437\u044C \u0437\u0430\u0441\u0430\u0434\u0443 \u0441\u043B\u043E\u043C\u044F
      \u0433\u043E\u043B\u043E\u0432\u0443. \u041E\u0434\u0438\u043D \u0442\u044E\u043A
      \u0441\u043E\u0440\u0432\u0430\u043B\u0441\u044F \u0438 \u043E\u0441\u0442\u0430\u043B\u0441\u044F
      \u043F\u043E\u0437\u0430\u0434\u0438 - \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438
      \u0437\u0430\u0431\u0440\u0430\u043B\u0438 \u0435\u0433\u043E. \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0443\u0434\u0430\u0440 \u0434\u0443\u0431\u0438\u043D\u043E\u0439
      \u043F\u043E \u043F\u043B\u0435\u0447\u0443, \u043D\u043E \u043E\u0431\u043E\u0437
      \u0432\u044B\u0448\u0435\u043B \u0438\u0437 \u043B\u043E\u0432\u0443\u0448\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442004
    m_Localized: "\u041E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F -
      \u0434\u0430\u0442\u044C \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443
      \u0434\u0438\u0440\u0445\u0430\u043C\u0443 \u0441 \u0442\u044E\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442005
    m_Localized: "\u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438 \u0432\u0437\u044F\u043B\u0438
      \u0434\u0435\u043D\u044C\u0433\u0438 \u0438 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438.
      \u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      - \u0446\u0435\u043D\u0430 \u043F\u0440\u043E\u0445\u043E\u0434\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0432\u043E\u0440\u0447\u0430\u043B\u0438, \u043D\u043E \u0446\u0435\u043B\u044B.
      \u0421\u043B\u0443\u0445 \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0441
      \u044D\u0442\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0431\u0435\u0440\u0443\u0442 \u0434\u0435\u043D\u044C\u0433\u0438, \u0443\u0439\u0434\u0451\u0442
      \u0432\u043F\u0435\u0440\u0451\u0434 \u0431\u044B\u0441\u0442\u0440\u0435\u0435
      \u0441\u0430\u043C\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442006
    m_Localized: "\u0427\u0435\u043B\u043E\u0432\u0435\u043A-\u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442007
    m_Localized: "\u0421\u0440\u0435\u0434\u0438 \u0434\u043D\u044F \u0443 \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u0448\u0435\u0433\u043E
      \u0440\u0443\u0441\u043B\u0430 \u0438\u0437-\u0437\u0430 \u0432\u0430\u043B\u0443\u043D\u0430
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F \u043E\u0434\u0438\u043D\u043E\u043A\u0430\u044F
      \u0444\u0438\u0433\u0443\u0440\u0430 \u0432 \u043B\u043E\u0445\u043C\u043E\u0442\u044C\u044F\u0445.
      \u0412 \u043F\u0440\u0430\u0432\u043E\u0439 \u0440\u0443\u043A\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A
      \u0434\u0435\u0440\u0436\u0438\u0442 \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0435
      \u043A\u043E\u043F\u044C\u0451 \u0441 \u043C\u0435\u0434\u043D\u044B\u043C
      \u043D\u0430\u043A\u043E\u043D\u0435\u0447\u043D\u0438\u043A\u043E\u043C, \u0432
      \u043B\u0435\u0432\u043E\u0439 - \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u043C\u0435\u0448\u043E\u0447\u0435\u043A,
      \u0438\u0437 \u043A\u043E\u0442\u043E\u0440\u043E\u0433\u043E \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u0442\u0438\u0445\u043E\u0435 \u0448\u0443\u0440\u0448\u0430\u043D\u0438\u0435.
      \u0423\u043B\u044B\u0431\u0430\u044F\u0441\u044C \u0431\u0435\u0437\u0437\u0443\u0431\u044B\u043C
      \u0440\u0442\u043E\u043C, \u043E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043F\u043E-\u043F\u0430\u0440\u0444\u044F\u043D\u0441\u043A\u0438: \"\u0412\u043D\u0443\u0442\u0440\u0438
      - \u0442\u0440\u0438 \u0436\u0438\u0432\u044B\u0445 \u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D\u0430.
      \u041F\u043E\u043B\u043E\u0436\u0438\u0442\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u043E
      \u043D\u0430 \u043A\u0430\u043C\u0435\u043D\u044C \u0438 \u0443\u0445\u043E\u0434\u0438\u0442\u0435\".
      \u0423\u0433\u0440\u043E\u0437\u0430 \u043D\u0435\u043B\u0435\u043F\u0430,
      \u043D\u043E \u043E\u0442\u0442\u043E\u0433\u043E \u043D\u0435 \u043C\u0435\u043D\u0435\u0435
      \u0440\u0435\u0430\u043B\u044C\u043D\u0430 - \u044F\u0434 \u0430\u043D\u0434\u0440\u043E\u043A\u0442\u043E\u043D\u0430
      \u0443\u0431\u0438\u0432\u0430\u0435\u0442 \u0437\u0430 \u0441\u0443\u0442\u043A\u0438.
      \u041D\u0430 \u0434\u043D\u0435 \u043F\u0443\u0441\u0442\u044B\u043D\u0438
      \u0422\u0430\u043A\u043B\u0430-\u041C\u0430\u043A\u0430\u043D \u043E\u0434\u0438\u043D\u043E\u0447\u043A\u0438
      \u0432\u044B\u0436\u0438\u0432\u0430\u044E\u0442 \u0445\u0438\u0442\u0440\u043E\u0441\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442008
    m_Localized: "\u0417\u0430\u0441\u043C\u0435\u044F\u0442\u044C\u0441\u044F \u0438
      \u043F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E - \u0431\u043B\u0435\u0444\u0443\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442009
    m_Localized: "\u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A \u0440\u0430\u0441\u0442\u0435\u0440\u044F\u043B\u0441\u044F
      \u043E\u0442 \u0441\u043C\u0435\u043B\u043E\u0441\u0442\u0438 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0438 \u043C\u0435\u0448\u043E\u0447\u0435\u043A \u043D\u0435 \u043E\u0442\u043A\u0440\u044B\u043B.
      \u041D\u043E \u043A\u043E\u043F\u044C\u0451\u043C \u0432\u0441\u0451 \u0436\u0435
      \u0437\u0430\u043C\u0430\u0445\u043D\u0443\u043B\u0441\u044F. \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u043F\u0435\u0440\u0435\u0445\u0432\u0430\u0442\u0438\u043B \u0440\u0443\u043A\u0443.
      \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B, \u043D\u0435
      \u043F\u043E\u0442\u0435\u0440\u044F\u0432 \u043D\u0438\u0447\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442010
    m_Localized: "\u041D\u0430\u043F\u0430\u0441\u0442\u044C \u043F\u0440\u0435\u0436\u0434\u0435,
      \u0447\u0435\u043C \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u043C\u0435\u0448\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442011
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0430\u0442\u0430\u043A\u043E\u0432\u0430\u043B
      \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0435\u043B\u044C\u043D\u043E, \u043D\u043E
      \u043C\u0435\u0448\u043E\u043A \u0432\u0441\u0451 \u0436\u0435 \u0443\u043F\u0430\u043B.
      \u0414\u0432\u043E\u0435 \u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D\u043E\u0432
      \u0440\u0430\u0437\u0431\u0435\u0436\u0430\u043B\u0438\u0441\u044C. \u041E\u0434\u0438\u043D
      \u0443\u0436\u0430\u043B\u0438\u043B \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430
      \u041A\u0430\u0440\u0438\u043C\u0430 \u0432 \u043B\u043E\u0434\u044B\u0436\u043A\u0443
      - \u043A\u043E\u0436\u0430 \u0432\u0441\u043F\u0443\u0445\u043B\u0430, \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0434\u0435\u043B\u0430\u0442\u044C \u043D\u0430\u0434\u0440\u0435\u0437 \u0438
      \u043F\u0440\u0438\u0436\u0438\u0433\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442012
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C - \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u043F\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0438
      \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442013
    m_Localized: "\u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A \u043F\u0440\u0438\u043D\u044F\u043B
      \u043C\u043E\u043D\u0435\u0442\u044B \u0438 \u0441\u0435\u043B \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u0437\u0430 \u043A\u0430\u043C\u0435\u043D\u044C. \u0423\u043D\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
      \u043D\u043E \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043D\u0430\u0437\u0432\u0430\u043B\u0438 \u0435\u0433\u043E \u0434\u0443\u0440\u0430\u0446\u043A\u043E\u0435
      \u043F\u0440\u043E\u0437\u0432\u0438\u0449\u0435 - \u0447\u0435\u043B\u043E\u0432\u0435\u043A-\u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D
      - \u0438 \u0441\u043C\u0435\u044F\u043B\u0438\u0441\u044C \u0435\u0449\u0451
      \u0434\u0432\u0430 \u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442014
    m_Localized: "\u0412\u043E\u043B\u043A\u0438 \u0432 \u043D\u043E\u0447\u043D\u043E\u043C
      \u043B\u0430\u0433\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442015
    m_Localized: "\u041E\u043A\u043E\u043B\u043E \u043F\u043E\u043B\u0443\u043D\u043E\u0447\u0438
      \u043B\u0430\u0433\u0435\u0440\u044C \u043F\u0440\u043E\u0441\u044B\u043F\u0430\u0435\u0442\u0441\u044F
      \u043E\u0442 \u0440\u0451\u0432\u0430 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432
      \u0438 \u0441\u043E\u0431\u0430\u0447\u044C\u0435\u0433\u043E \u043B\u0430\u044F.
      \u0412 \u043E\u0442\u0431\u043B\u0435\u0441\u043A\u0430\u0445 \u043A\u043E\u0441\u0442\u0440\u0430
      \u0434\u0432\u0438\u0436\u0443\u0442\u0441\u044F \u0441\u0435\u0440\u044B\u0435
      \u0442\u0435\u043D\u0438 - \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 \u0434\u0435\u0432\u044F\u0442\u0438
      \u0432\u043E\u043B\u043A\u043E\u0432 \u043E\u0431\u043E\u0448\u043B\u0438 \u043B\u0430\u0433\u0435\u0440\u044C
      \u0441 \u0442\u0440\u0451\u0445 \u0441\u0442\u043E\u0440\u043E\u043D. \u0412\u043E\u0436\u0430\u043A
      \u0441\u0442\u0430\u0438, \u043A\u0440\u0443\u043F\u043D\u044B\u0439 \u0441\u0430\u043C\u0435\u0446
      \u0441 \u0440\u0430\u0437\u043E\u0434\u0440\u0430\u043D\u043D\u044B\u043C \u0443\u0445\u043E\u043C,
      \u0441\u0442\u043E\u0438\u0442 \u0432 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u0438
      \u0448\u0430\u0433\u0430\u0445 \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u043D\u043D\u044B\u0445
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445. \u0417\u0430\u043F\u0430\u0441\u044B
      \u0435\u0434\u044B \u043F\u043E\u0434 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C
      \u043D\u0435\u0431\u043E\u043C. \u0415\u0441\u043B\u0438 \u043E\u0433\u043E\u043D\u044C
      \u043D\u0435 \u0441\u0434\u0435\u0440\u0436\u0438\u0442 - \u0441\u0442\u0430\u044F
      \u0434\u043E\u0431\u0435\u0440\u0451\u0442\u0441\u044F \u0434\u043E \u0432\u044C\u044E\u0447\u043D\u044B\u0445
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445. \u0412 \u0441\u0442\u0435\u043F\u044F\u0445
      \u0416\u0435\u0442\u044B\u0441\u0443 \u0432\u043E\u043B\u043A\u0438 \u0432
      \u0441\u0443\u0440\u043E\u0432\u044B\u0435 \u0437\u0438\u043C\u044B \u043D\u0435
      \u0431\u043E\u044F\u0442\u0441\u044F \u0434\u0430\u0436\u0435 \u0431\u043E\u043B\u044C\u0448\u0438\u0445
      \u043E\u0431\u043E\u0437\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442016
    m_Localized: "\u0420\u0430\u0437\u0434\u0443\u0442\u044C \u043A\u043E\u0441\u0442\u0440\u044B
      \u0438 \u043A\u0440\u0438\u0447\u0430\u0442\u044C \u0432\u0441\u0435\u043C
      \u0432\u043C\u0435\u0441\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442017
    m_Localized: "\u0428\u0443\u043C \u0438 \u043E\u0433\u043E\u043D\u044C \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0441\u0432\u043E\u0451 \u0434\u0435\u043B\u043E - \u043F\u043E\u0441\u043B\u0435
      \u0447\u0435\u0442\u0432\u0435\u0440\u0442\u0438 \u0447\u0430\u0441\u0430 \u0441\u0442\u043E\u044F\u0447\u0435\u0433\u043E
      \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F
      \u0432\u043E\u0436\u0430\u043A \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B
      \u0438 \u0443\u0448\u0451\u043B. \u0417\u0430\u043F\u0430\u0441\u044B \u0443\u0446\u0435\u043B\u0435\u043B\u0438.
      \u041B\u044E\u0434\u0438 \u043D\u0435 \u0441\u043F\u0430\u043B\u0438 \u0434\u043E
      \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442018
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u043A\u0443\u0441\u043E\u043A
      \u0435\u0434\u044B \u043F\u0440\u043E\u0447\u044C \u043E\u0442 \u043B\u0430\u0433\u0435\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442019
    m_Localized: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u043E\u043B\u043A\u043E\u0432
      \u0443\u0448\u043B\u0438 \u0437\u0430 \u0435\u0434\u043E\u0439. \u0421\u0442\u0430\u044F
      \u0440\u0430\u0437\u0434\u0440\u043E\u0431\u0438\u043B\u0430\u0441\u044C. \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
      \u0441\u043F\u0430\u043B\u0430, \u043D\u043E \u0432\u043E\u0441\u0435\u043C\u044C
      \u043C\u0435\u0448\u043A\u043E\u0432 \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0438
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u043E\u0442\u0434\u0430\u0442\u044C
      - \u0432\u043E\u043B\u043A\u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u0437\u0430 \u043E\u0441\u0442\u0430\u0442\u043A\u0430\u043C\u0438 \u0442\u0440\u0438\u0436\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442020
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0442\u0438\u0442\u044C \u0441\u0442\u0430\u044E
      \u0441 \u043A\u043E\u043F\u044C\u044F\u043C\u0438 - \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438
      \u0432\u043F\u0435\u0440\u0451\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442021
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0411\u0430\u0445\u0440\u0430\u043C
      \u0431\u044B\u043B \u0443\u043A\u0443\u0448\u0435\u043D \u0437\u0430 \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u044C\u0435,
      \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0441\u0442\u0430\u044F
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0430. \u0420\u0430\u043D\u0430
      \u0433\u043B\u0443\u0431\u043E\u043A\u0430\u044F. \u0412\u043E\u043B\u043A\u0438
      \u0443\u0448\u043B\u0438, \u043D\u043E \u043E\u0434\u0438\u043D \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u0432 \u0438\u0441\u043F\u0443\u0433\u0435 \u043F\u043E\u0440\u0432\u0430\u043B
      \u0432\u0435\u0440\u0451\u0432\u043A\u0443 \u0438 \u0443\u0431\u0435\u0436\u0430\u043B
      \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442022
    m_Localized: "\u0411\u0443\u043D\u0442 \u043D\u0430\u0451\u043C\u043D\u043E\u0433\u043E
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442023
    m_Localized: "\u0413\u043B\u0443\u0431\u043E\u043A\u043E\u0439 \u043D\u043E\u0447\u044C\u044E
      \u0440\u0435\u0437\u043A\u0438\u0439 \u043B\u044F\u0437\u0433 \u0441\u0442\u0430\u043B\u0438
      \u0431\u0443\u0434\u0438\u0442 \u043B\u0430\u0433\u0435\u0440\u044C. \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D,
      \u043D\u0430\u043D\u044F\u0442\u044B\u0439 \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u0437\u0430 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0432 \u043D\u0435\u0434\u0435\u043B\u044E, \u0441\u0442\u043E\u0438\u0442
      \u0443 \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0441 \u043E\u0431\u043D\u0430\u0436\u0451\u043D\u043D\u044B\u043C
      \u043C\u0435\u0447\u043E\u043C \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0440\u043E\u0432\u043D\u044B\u043C \u0433\u043E\u043B\u043E\u0441\u043E\u043C:
      \"\u042F \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u0435
      \u043E\u0442 \u043A\u0443\u043F\u0446\u0430 \u041C\u0430\u043D\u0430\u0445\u0430.
      \u041E\u043D \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442 \u0432\u0442\u0440\u043E\u0435,
      \u0435\u0441\u043B\u0438 \u044F \u043F\u0440\u0438\u0432\u0435\u0434\u0443
      \u043A \u043D\u0435\u043C\u0443 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432
      \u0441 \u043B\u0430\u0437\u0443\u0440\u0438\u0442\u043E\u043C. \u041D\u0435
      \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u044F\u0439\u0442\u0435\u0441\u044C\".
      \u0422\u0440\u043E\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0437\u0430 \u0435\u0433\u043E \u0441\u043F\u0438\u043D\u043E\u0439 \u043C\u043E\u043B\u0447\u0430\u0442
      - \u043D\u0435\u044F\u0441\u043D\u043E, \u043D\u0430 \u0447\u044C\u0435\u0439
      \u043E\u043D\u0438 \u0441\u0442\u043E\u0440\u043E\u043D\u0435. \u041B\u0430\u0437\u0443\u0440\u0438\u0442
      \u043D\u0430 \u0431\u043E\u0440\u0442\u0443 \u0441\u0442\u043E\u0438\u0442
      \u0434\u043E\u0440\u043E\u0436\u0435 \u0433\u043E\u0434\u043E\u0432\u043E\u0439
      \u0432\u044B\u0440\u0443\u0447\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442024
    m_Localized: "\u0412\u0441\u0442\u0430\u0442\u044C \u043B\u0438\u0447\u043D\u043E
      \u0438 \u043F\u0440\u0438\u0437\u0432\u0430\u0442\u044C \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442025
    m_Localized: "\u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B,
      \u043A\u043E\u0433\u0434\u0430 \u0443\u0432\u0438\u0434\u0435\u043B, \u0447\u0442\u043E
      \u0434\u0432\u043E\u0435 \u0434\u0440\u0443\u0433\u0438\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432
      \u0432\u0441\u0442\u0430\u043B\u0438 \u043D\u0430 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043E\u0431\u043E\u0437\u0430. \u041E\u043D \u0443\u0448\u0451\u043B \u0432
      \u0442\u0435\u043C\u043D\u043E\u0442\u0443 \u0431\u0435\u0437 \u043A\u0440\u043E\u0432\u0438,
      \u043D\u043E \u0431\u0435\u0437 \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u044F.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0437\u0430\u0443\u0432\u0430\u0436\u0430\u043B\u0438
      \u0440\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442026
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u0434\u0432\u043E\u0439\u043D\u0443\u044E
      \u043F\u043B\u0430\u0442\u0443 - \u043F\u0435\u0440\u0435\u043A\u0443\u043F\u0438\u0442\u044C
      \u043E\u0431\u0440\u0430\u0442\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442027
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0441\u0432\u0435\u0440\u0445 \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0430
      \u0432\u0435\u0440\u043D\u0443\u043B\u0438 \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D\u0430
      \u0432 \u0441\u0442\u0440\u043E\u0439. \u0414\u043E\u0440\u043E\u0433\u043E,
      \u043D\u043E \u0431\u0435\u0437 \u043A\u0440\u043E\u0432\u0438. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0432\u0435\u0440\u0438\u0442\u044C \u0435\u043C\u0443 \u043C\u0435\u043D\u044C\u0448\u0435
      - \u043E\u043D \u043F\u0440\u043E\u0434\u0430\u0451\u0442\u0441\u044F \u0442\u043E\u043C\u0443,
      \u043A\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u043B\u0430\u0442\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442028
    m_Localized: "\u0423\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u0438 \u043E\u0442\u0434\u0430\u0442\u044C
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432 \u0441 \u043B\u0430\u0437\u0443\u0440\u0438\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442029
    m_Localized: "\u0422\u0440\u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430
      \u0441 \u043B\u0430\u0437\u0443\u0440\u0438\u0442\u043E\u043C \u0443\u0448\u043B\u0438
      \u0432 \u043D\u043E\u0447\u044C. \u041F\u043E\u0442\u0435\u0440\u044F \u043E\u0433\u0440\u043E\u043C\u043D\u0430\u044F.
      \u0412\u0430\u0440\u0430\u0445\u0440\u0430\u043D \u0431\u044B\u043B \u0434\u043E\u0432\u043E\u043B\u0435\u043D.
      \u0423\u0442\u0440\u043E\u043C \u043A\u0443\u043F\u0435\u0446 \u041C\u0430\u043D\u0430\u0445
      \u043F\u0440\u0438\u0441\u043B\u0430\u043B \u043D\u0430\u0441\u043C\u0435\u0448\u043B\u0438\u0432\u043E\u0435
      \u043F\u0438\u0441\u044C\u043C\u043E \u0441 \u043F\u043E\u0437\u0434\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C
      - \u043E\u043D \u0432\u0441\u0451 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043B
      \u0437\u0430\u0440\u0430\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442030
    m_Localized: "\u0420\u0435\u0447\u043D\u044B\u0435 \u043F\u0438\u0440\u0430\u0442\u044B
      \u0443 \u0431\u0440\u043E\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442031
    m_Localized: "\u0411\u0440\u043E\u0434 \u0447\u0435\u0440\u0435\u0437 \u0421\u044B\u0440\u0434\u0430\u0440\u044C\u044E
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043F\u0435\u0440\u0435\u0433\u043E\u0440\u043E\u0436\u0435\u043D.
      \u0414\u0432\u0435 \u043F\u043B\u043E\u0441\u043A\u043E\u0434\u043E\u043D\u043D\u044B\u0435
      \u043B\u043E\u0434\u043A\u0438 \u0441\u0442\u043E\u044F\u0442 \u0431\u043E\u0440\u0442
      \u043A \u0431\u043E\u0440\u0442\u0443, \u043D\u0430\u0442\u044F\u043D\u0443\u0432
      \u043C\u0435\u0436\u0434\u0443 \u043D\u0438\u043C\u0438 \u0442\u043E\u043B\u0441\u0442\u0443\u044E
      \u0432\u0435\u0440\u0451\u0432\u043A\u0443 \u0438\u0437 \u043A\u0430\u043C\u044B\u0448\u0430.
      \u041D\u0430 \u043D\u0438\u0445 \u0441\u0435\u043C\u0435\u0440\u043E \u0441
      \u0434\u0443\u0431\u0438\u043D\u0430\u043C\u0438 \u0438 \u0431\u0430\u0433\u0440\u0430\u043C\u0438,
      \u043A\u0440\u0438\u0447\u0430\u0442 \u043F\u043E-\u0442\u044E\u0440\u043A\u0441\u043A\u0438:
      \"\u041F\u0440\u043E\u0445\u043E\u0434 \u0441\u0442\u043E\u0438\u0442 \u043F\u043E
      \u043E\u0434\u043D\u043E\u043C\u0443 \u043A\u0430\u0439\u044E\u0430\u043D\u044C-\u0442\u0443\u043D\u0431\u0430\u043E
      \u0441 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0438 \u043F\u043E
      \u0442\u0440\u0438 - \u0441 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430\".
      \u0412\u043E\u0434\u0430 \u043C\u0443\u0442\u043D\u0430\u044F \u0438 \u0431\u044B\u0441\u0442\u0440\u0430\u044F,
      \u043E\u0431\u0445\u043E\u0434\u0438\u0442\u044C \u0431\u0440\u043E\u0434 -
      \u043B\u0438\u0448\u043D\u0438\u0439 \u0434\u0435\u043D\u044C. \u0413\u0440\u0443\u0437
      \u0442\u044F\u0436\u0451\u043B\u044B\u0439, \u043F\u0435\u0440\u0435\u043F\u043B\u044B\u0442\u044C
      \u0432\u043F\u043B\u0430\u0432\u044C \u043D\u0435\u043B\u044C\u0437\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442032
    m_Localized: "\u041F\u0440\u043E\u0440\u0432\u0430\u0442\u044C \u0437\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u0438\u0435
      \u0441\u0438\u043B\u043E\u0439 - \u0440\u0443\u0431\u0438\u0442\u044C \u0432\u0435\u0440\u0451\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442033
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0438 \u0434\u043E\u0441\u0442\u0438\u0433\u043B\u0438
      \u043B\u043E\u0434\u043E\u043A \u043F\u043E\u0434 \u0433\u0440\u0430\u0434\u043E\u043C
      \u0434\u0443\u0431\u0438\u043D, \u0432\u0435\u0440\u0451\u0432\u043A\u0443
      \u043F\u0435\u0440\u0435\u0440\u0443\u0431\u0438\u043B\u0438. \u0414\u0432\u043E\u0435
      \u043F\u0438\u0440\u0430\u0442\u043E\u0432 \u0443\u043F\u0430\u043B\u0438 \u0432
      \u0432\u043E\u0434\u0443, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438. \u041E\u0434\u0438\u043D
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0441\u043B\u043E\u043C\u0430\u043B
      \u0440\u0443\u043A\u0443, \u043D\u043E \u043F\u0440\u043E\u0445\u043E\u0434
      \u043E\u0442\u043A\u0440\u044B\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442034
    m_Localized: "\u0423\u0439\u0442\u0438 \u0432 \u043E\u0431\u0445\u043E\u0434
      - \u043F\u043E\u0442\u0435\u0440\u044F \u0434\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442035
    m_Localized: "\u041E\u0431\u0445\u043E\u0434 \u0437\u0430\u043D\u044F\u043B \u0446\u0435\u043B\u044B\u0439
      \u0434\u0435\u043D\u044C \u043F\u043E \u0432\u044F\u0437\u043A\u043E\u043C\u0443
      \u0431\u0435\u0440\u0435\u0433\u0443. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u0443\u0441\u0442\u0430\u043B\u0438, \u043E\u0434\u0438\u043D \u0432\u044C\u044E\u043A
      \u043D\u0430\u043C\u043E\u043A \u043F\u0440\u0438 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0435
      \u0443 \u0432\u0441\u043F\u043E\u043C\u043E\u0433\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u0431\u0440\u043E\u0434\u0430. \u0417\u0430\u0442\u043E \u0431\u0435\u0437
      \u043F\u043E\u0442\u0435\u0440\u044C \u043B\u044E\u0434\u0435\u0439 \u0438
      \u0431\u0435\u0437 \u043A\u043E\u043D\u0444\u043B\u0438\u043A\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442036
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u0443\u044E
      \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442037
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043F\u044F\u0442\u044C
      \u043C\u043E\u043D\u0435\u0442 \u043F\u0435\u0440\u0435\u0448\u043B\u0438 \u043A
      \u043F\u0438\u0440\u0430\u0442\u0430\u043C. \u0412\u0435\u0440\u0451\u0432\u043A\u0443
      \u0443\u0431\u0440\u0430\u043B\u0438, \u043E\u0431\u043E\u0437 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F.
      \u041F\u0438\u0440\u0430\u0442\u044B \u043A\u043B\u0430\u043D\u044F\u043B\u0438\u0441\u044C
      \u0441 \u0434\u0435\u043B\u0430\u043D\u043E\u0439 \u0432\u0435\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u044C\u044E.
      \u0421\u0432\u043E\u0451 \u043E\u043D\u0438 \u0431\u0435\u0440\u0443\u0442
      \u0438\u0441\u043F\u0440\u0430\u0432\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442038
    m_Localized: "\u0422\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0439 \u043E\u0442\u0440\u044F\u0434
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442039
    m_Localized: "\u041D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435 \u0447\u0435\u0442\u044B\u0440\u0451\u0445
      \u0442\u044B\u0441\u044F\u0447 \u0448\u0430\u0433\u043E\u0432 \u043D\u0430\u0434
      \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u0440\u0435\u043A\u0438 \u0442\u0440\u043E\u043F\u0443
      \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0445 \u0432\u043E\u0438\u043D\u043E\u0432
      \u0432 \u043B\u0430\u043C\u0435\u043B\u043B\u044F\u0440\u043D\u044B\u0445 \u0434\u043E\u0441\u043F\u0435\u0445\u0430\u0445
      \u0438\u0437 \u044F\u043B\u043E\u0432\u043E\u0439 \u043A\u043E\u0436\u0438.
      \u0418\u0445 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440 \u041D\u0430\u043D\u0430\u043C
      \u0441\u0442\u043E\u0438\u0442, \u043E\u043F\u0438\u0440\u0430\u044F\u0441\u044C
      \u043D\u0430 \u0434\u043B\u0438\u043D\u043D\u043E\u0435 \u043A\u043E\u043F\u044C\u0451,
      \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439 \u0440\u0430\u0437\u0432\u0435\u0432\u0430\u0435\u0442\u0441\u044F
      \u0436\u0451\u043B\u0442\u044B\u0439 \u0444\u043B\u0430\u0433 \u0441 \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u043C
      \u0431\u043E\u043D. \u0412\u043E\u0437\u0434\u0443\u0445 \u0440\u0430\u0437\u0440\u0435\u0436\u0435\u043D\u043D\u044B\u0439,
      \u0433\u043E\u043B\u043E\u0441 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0430
      \u0433\u043B\u0443\u0445\u043E\u0439: \"\u042D\u0442\u0430 \u0442\u0440\u043E\u043F\u0430
      \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0438\u0442 \u0422\u0438\u0431\u0435\u0442\u0441\u043A\u043E\u043C\u0443
      \u0446\u0430\u0440\u0441\u0442\u0432\u0443. \u0414\u0430\u043D\u044C - \u0442\u0440\u0435\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430 \u0438\u043B\u0438 \u0441\u0435\u043C\u044C
      \u044F\u043A\u043E\u0432\". \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u0448\u0435\u043F\u0447\u0435\u0442: \u043E\u043D \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E. \u041D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435
      \u0425\u043E\u0440\u043E\u0433 \u0442\u0438\u0431\u0435\u0442\u0441\u043A\u0438\u0435
      \u043F\u043E\u0441\u0442\u044B \u043F\u043E\u044F\u0432\u0438\u043B\u0438\u0441\u044C
      \u0442\u0440\u0438 \u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442040
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u0430
      - \u0441\u043D\u0438\u0437\u0438\u0442\u044C \u0434\u0430\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442041
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u043F\u0440\u043E\u0432\u0451\u043B
      \u0447\u0430\u0441 \u0432 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0430\u0445.
      \u041D\u0430\u043D\u0430\u043C \u043F\u0440\u0438\u043D\u044F\u043B \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0432\u043C\u0435\u0441\u0442\u043E
      \u044F\u043A\u043E\u0432 - \u0434\u0435\u043D\u044C\u0433\u0438 \u0434\u043B\u044F
      \u043D\u0435\u0433\u043E \u0443\u0434\u043E\u0431\u043D\u0435\u0435 \u043D\u0430
      \u0432\u044B\u0441\u043E\u0442\u0435. \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B.
      \u0423\u0434\u0430\u0447\u0430: \u0445\u043E\u0440\u043E\u0448\u0438\u0439
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0441\u0442\u043E\u0438\u0442
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043B\u044E\u0431\u043E\u0439 \u043E\u0445\u0440\u0430\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442042
    m_Localized: "\u0410\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C - \u0443
      \u043D\u0430\u0441 \u0431\u043E\u043B\u044C\u0448\u0435 \u043B\u044E\u0434\u0435\u0439
      \u043D\u0430 \u0443\u0437\u043A\u043E\u0439 \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442043
    m_Localized: "\u0411\u043E\u0439 \u043D\u0430 \u0443\u0437\u043A\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435 \u0442\u044F\u0436\u0451\u043B\u044B\u0439.
      \u0414\u0432\u043E\u0435 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432
      \u0440\u0430\u043D\u0435\u043D\u044B. \u0422\u0438\u0431\u0435\u0442\u0446\u044B
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438, \u0443\u043D\u0435\u0441\u044F
      \u0441\u0432\u043E\u0438\u0445. \u041D\u043E \u0432\u043F\u0435\u0440\u0435\u0434\u0438
      \u0435\u0449\u0451 \u0434\u0432\u0430 \u0434\u043D\u044F \u0432 \u0433\u043E\u0440\u0430\u0445
      - \u043F\u043E\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u044E\u0442,
      \u0447\u0442\u043E \u043E\u0442\u0440\u044F\u0434 \u041D\u0430\u043D\u0430\u043C\u0430
      \u043C\u043E\u0436\u0435\u0442 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0441 \u043F\u043E\u0434\u043C\u043E\u0433\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442044
    m_Localized: "\u041E\u0442\u0434\u0430\u0442\u044C \u0442\u0440\u0438 \u044F\u043A\u0430
      - \u0434\u0435\u0448\u0435\u0432\u043B\u0435 \u043A\u0440\u043E\u0432\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442045
    m_Localized: "\u041D\u0430\u043D\u0430\u043C \u043F\u0440\u0438\u043D\u044F\u043B
      \u044F\u043A\u043E\u0432 \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C.
      \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B \u0447\u0435\u0440\u0435\u0437
      \u043F\u043E\u0441\u0442 \u0431\u0435\u0437 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438.
      \u0422\u0440\u0438 \u044F\u043A\u0430 - \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u0430\u044F
      \u043F\u043E\u0442\u0435\u0440\u044F \u0442\u044F\u0433\u043B\u043E\u0432\u043E\u0439
      \u0441\u0438\u043B\u044B, \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0439\u0441\u044F
      \u043F\u0443\u0442\u044C \u043F\u043E \u0433\u043E\u0440\u0430\u043C \u0441\u0442\u0430\u043D\u0435\u0442
      \u0442\u044F\u0436\u0435\u043B\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442046
    m_Localized: "\u0417\u0430\u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u0430\u044F
      \u043B\u043E\u0432\u0443\u0448\u043A\u0430 \u0441 \u0448\u0438\u043F\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442047
    m_Localized: "\u0423 \u043E\u0430\u0437\u0438\u0441\u0430 \u042F\u043B\u043A\u0430\u043D\u0433
      \u043D\u0430 \u043F\u0440\u0438\u0431\u0440\u0435\u0436\u043D\u043E\u043C \u043F\u0435\u0441\u043A\u0435
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0421\u0430\u043C\u0435\u0445
      \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442 \u043B\u0451\u0433\u043A\u0443\u044E
      \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u044E - \u0437\u0435\u043C\u043B\u044F
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438 \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0440\u043E\u0432\u043D\u0430\u044F \u0438 \u0447\u0443\u0442\u044C \u0442\u0435\u043C\u043D\u0435\u0435.
      \u041F\u043E\u0434 \u0442\u0440\u043E\u0441\u0442\u043D\u0438\u043A\u043E\u0432\u044B\u043C
      \u043C\u0430\u0442\u043E\u043C, \u043F\u0440\u0438\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u043C
      \u043F\u0435\u0441\u043A\u043E\u043C, - \u0440\u044F\u0434\u044B \u0437\u0430\u043E\u0441\u0442\u0440\u0451\u043D\u043D\u044B\u0445
      \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u0445 \u043A\u043E\u043B\u044C\u0435\u0432,
      \u0441\u043C\u0430\u0437\u0430\u043D\u043D\u044B\u0445 \u0447\u0451\u0440\u043D\u043E\u0439
      \u0441\u043C\u043E\u043B\u043E\u0439 \u0441 \u043F\u0440\u0438\u043C\u0435\u0441\u044C\u044E
      \u0442\u043E\u043B\u0447\u0451\u043D\u044B\u0445 \u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D\u043E\u0432.
      \u041B\u043E\u0432\u0443\u0448\u043A\u0430 \u0441\u0432\u0435\u0436\u0430\u044F,
      \u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u043D\u043E\u0447\u044C\u044E.
      \u041A\u0442\u043E-\u0442\u043E \u0436\u0434\u0451\u0442 \u043E\u0431\u043E\u0437\u0430
      \u0438\u043B\u0438 \u0443\u0436\u0435 \u0443\u0448\u0451\u043B? \u0428\u0438\u043F\u044B
      \u043B\u0435\u0433\u043A\u043E \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u044E\u0442
      \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u044C\u0438 \u043F\u043E\u0434\u0443\u0448\u043A\u0438
      \u043B\u0430\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993423442048
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u043B\u043E\u0432\u0443\u0448\u043A\u0443
      \u0438 \u0438\u0441\u043A\u0430\u0442\u044C \u0437\u0430\u0441\u0430\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636224
    m_Localized: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u0439 \u043E\u0431\u0445\u043E\u0434
      \u0432\u043F\u0440\u0430\u0432\u043E \u0441\u043F\u0430\u0441 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445.
      \u041F\u043E\u0438\u0441\u043A \u0437\u0430\u0441\u0430\u0434\u044B \u0434\u0430\u043B
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 - \u0441\u043B\u0435\u0434\u044B
      \u0442\u0440\u0451\u0445 \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0443\u0445\u043E\u0434\u0438\u043B\u0438
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0431\u0430\u0440\u0445\u0430\u043D\u043E\u0432.
      \u041B\u043E\u0432\u0443\u0448\u043A\u0443 \u0440\u0430\u0441\u043A\u0440\u044B\u043B\u0438
      \u0432\u043E\u0432\u0440\u0435\u043C\u044F. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0421\u0430\u043C\u0435\u0445 \u0437\u0430\u0441\u043B\u0443\u0436\u0438\u043B
      \u0434\u0432\u043E\u0439\u043D\u0443\u044E \u0434\u043E\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636225
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0441\u043A\u0432\u043E\u0437\u044C
      - \u043B\u043E\u0432\u0443\u0448\u043A\u0430 \u043D\u0435 \u0434\u043B\u044F
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636226
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u0432\u0441\u0442\u0430\u043B \u043D\u0430 \u043C\u0430\u0442 \u0438 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0441\u044F.
      \u0414\u0432\u0430 \u0448\u0438\u043F\u0430 \u043F\u0440\u043E\u0431\u0438\u043B\u0438
      \u043B\u0430\u043F\u0443. \u041B\u0435\u0447\u0435\u043D\u0438\u0435 \u0437\u0430\u043D\u044F\u043B\u043E
      \u043F\u043E\u043B\u0434\u043D\u044F, \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435
      \u0445\u0440\u043E\u043C\u0430\u0435\u0442. \u042F\u0434 \u043B\u0451\u0433\u043A\u0438\u0439,
      \u043D\u0435 \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u044B\u0439,
      \u043D\u043E \u0442\u0435\u043C\u043F \u043F\u043E\u0442\u0435\u0440\u044F\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636227
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C
      - \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0432\u0435\u0441\u044C
      \u043E\u0430\u0437\u0438\u0441 \u0434\u043E \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636228
    m_Localized: "\u0427\u0430\u0441\u043E\u0432\u043E\u0439 \u043E\u0441\u043C\u043E\u0442\u0440
      \u0432\u044B\u044F\u0432\u0438\u043B \u0435\u0449\u0451 \u0434\u0432\u0435
      \u0437\u0430\u043C\u0430\u0441\u043A\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
      \u043B\u043E\u0432\u0443\u0448\u043A\u0438 \u0443 \u0432\u043E\u0434\u043E\u043F\u043E\u044F.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0434\u0435\u043D\u044C,
      \u0437\u0430\u0442\u043E \u043F\u0440\u043E\u0448\u043B\u0438 \u043E\u0430\u0437\u0438\u0441
      \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C. \u041B\u044E\u0434\u0438
      \u0443\u0441\u0442\u0430\u043B\u0438 \u043E\u0442 \u043D\u0430\u043F\u0440\u044F\u0436\u0435\u043D\u0438\u044F,
      \u043D\u043E \u0433\u0440\u0443\u0437 \u0446\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636229
    m_Localized: "\u041D\u0430\u0451\u043C\u043D\u044B\u0435 \u043C\u0435\u0447\u043D\u0438\u043A\u0438
      \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636230
    m_Localized: "\u041D\u0430 \u043F\u043E\u043B\u0443\u0434\u043D\u0435 \u0434\u043E\u0440\u043E\u0433\u0438
      \u043A \u041C\u0435\u0440\u0432\u0443 \u0442\u0440\u043E\u0435 \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0445
      \u043C\u0443\u0436\u0447\u0438\u043D \u043F\u0440\u0435\u0433\u0440\u0430\u0436\u0434\u0430\u044E\u0442
      \u043F\u0443\u0442\u044C. \u041E\u0434\u0435\u0442\u044B \u0447\u0438\u0441\u0442\u043E,
      \u043B\u043E\u0448\u0430\u0434\u0438 \u0445\u043E\u043B\u0451\u043D\u044B\u0435
      - \u043D\u0435 \u043E\u0431\u044B\u0447\u043D\u044B\u0435 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438.
      \u0421\u0442\u0430\u0440\u0448\u0438\u0439 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0431\u0435\u0437 \u0443\u0433\u0440\u043E\u0437, \u043F\u043E-\u0430\u0440\u0430\u0431\u0441\u043A\u0438:
      \"\u041A\u0443\u043F\u0435\u0446 \u042E\u0441\u0443\u0444 \u0430\u043B\u044C-\u0425\u0430\u043C\u0434\u0430\u043D\u0438
      \u043F\u0440\u043E\u0441\u0438\u0442 \u0432\u0430\u0441 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
      \u0432 \u041D\u0438\u0448\u0430\u043F\u0443\u0440. \u041E\u043D \u0443\u0436\u0435
      \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0448\u0451\u043B\u043A \u0432
      \u041C\u0435\u0440\u0432 \u0438 \u0432\u0430\u0448 \u0442\u043E\u0432\u0430\u0440
      \u0442\u0430\u043C \u043D\u0438\u043A\u043E\u043C\u0443 \u043D\u0435 \u043D\u0443\u0436\u0435\u043D\".
      \u042D\u0442\u043E \u043D\u0435\u043F\u0440\u0430\u0432\u0434\u0430 \u0438\u043B\u0438
      \u043F\u0440\u0430\u0432\u0434\u0430 - \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E.
      \u041D\u043E \u0442\u0440\u0438 \u043C\u0435\u0447\u0430 \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435
      - \u0444\u0430\u043A\u0442. \u0421\u043E\u043F\u0435\u0440\u043D\u0438\u0447\u0435\u0441\u0442\u0432\u043E
      \u043D\u0430 \u0425\u043E\u0440\u0430\u0441\u0430\u043D\u0441\u043A\u043E\u043C
      \u0442\u0440\u0430\u043A\u0442\u0435 \u0438\u0434\u0451\u0442 \u043D\u0435
      \u0442\u043E\u043B\u044C\u043A\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u043C\u0438
      \u043C\u0435\u0442\u043E\u0434\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636231
    m_Localized: "\u041F\u0440\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F \u0441
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430\u043C\u0438 - \u043D\u0435
      \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636232
    m_Localized: "\u0421\u0445\u0432\u0430\u0442\u043A\u0430 \u0432\u044B\u0448\u043B\u0430
      \u043A\u043E\u0440\u043E\u0442\u043A\u043E\u0439 - \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u0438
      \u043D\u0435 \u043E\u0436\u0438\u0434\u0430\u043B\u0438 \u0440\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438.
      \u041E\u0434\u0438\u043D \u0431\u0440\u043E\u0441\u0438\u043B \u043E\u0440\u0443\u0436\u0438\u0435
      \u0441\u0440\u0430\u0437\u0443, \u0434\u0432\u043E\u0435 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438.
      \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0440\u0430\u043D\u0435\u043D
      \u0432 \u043F\u043B\u0435\u0447\u043E. \u0414\u043E\u0440\u043E\u0433\u0430
      \u043E\u0442\u043A\u0440\u044B\u0442\u0430, \u043D\u043E \u042E\u0441\u0443\u0444
      \u0443\u0437\u043D\u0430\u0435\u0442 \u043E\u0431 \u044D\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636233
    m_Localized: "\u0412\u044B\u043A\u0443\u043F\u0438\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0443
      - \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0438\u043C \u043B\u0438\u0447\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636234
    m_Localized: "\u0422\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043F\u0440\u044F\u043C\u043E \u0432 \u0438\u0445 \u043A\u0430\u0440\u043C\u0430\u043D\u044B
      - \u0438 \u043D\u0430\u0451\u043C\u043D\u0438\u043A\u0438 \u0440\u0430\u0441\u0441\u0442\u0443\u043F\u0438\u043B\u0438\u0441\u044C.
      \u042E\u0441\u0443\u0444 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u043F\u043E\u043B\u0443\u0447\u0438\u0442, \u0430 \u0435\u0433\u043E \u043B\u044E\u0434\u0438
      \u043F\u0440\u0435\u0434\u0430\u0434\u0443\u0442 \u0435\u0433\u043E \u043B\u0435\u0433\u043A\u043E.
      \u0414\u043E\u0440\u043E\u0433\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430,
      \u0434\u0435\u043D\u044C\u0433\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636235
    m_Localized: "\u041F\u0440\u0438\u0433\u0440\u043E\u0437\u0438\u0442\u044C \u0436\u0430\u043B\u043E\u0431\u043E\u0439
      \u0432 \u043C\u0435\u0441\u0442\u043D\u0443\u044E \u0443\u043F\u0440\u0430\u0432\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636236
    m_Localized: "\u0423\u043F\u043E\u043C\u0438\u043D\u0430\u043D\u0438\u0435 \u0430\u0431\u0431\u0430\u0441\u0438\u0434\u0441\u043A\u043E\u0433\u043E
      \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u0430 \u0432 \u041C\u0435\u0440\u0432\u0435
      \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u043E. \u041D\u0430\u0451\u043C\u043D\u0438\u043A\u0438
      \u043D\u0435\u0440\u0432\u043D\u043E \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u043B\u0438\u0441\u044C
      \u0438 \u0443\u0448\u043B\u0438 \u043F\u0440\u043E\u0447\u044C. \u042E\u0441\u0443\u0444
      \u044F\u0432\u043D\u043E \u043D\u0435 \u043F\u043B\u0430\u0442\u0438\u043B
      \u0438\u043C \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C
      \u0437\u0430\u043A\u043E\u043D\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636237
    m_Localized: "\u0421\u0431\u0435\u0436\u0430\u0432\u0448\u0438\u0439 \u0442\u0430\u043D\u0441\u043A\u0438\u0439
      \u0441\u043E\u043B\u0434\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636238
    m_Localized: "\u041D\u0430 \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0435 \u0434\u043E\u0440\u043E\u0433
      \u0443 \u0442\u043E\u043F\u043E\u043B\u0435\u0439 \u0441\u0442\u043E\u0438\u0442
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A \u0432 \u0440\u0432\u0430\u043D\u043E\u043C
      \u0442\u0430\u043D\u0441\u043A\u043E\u043C \u043C\u0443\u043D\u0434\u0438\u0440\u0435
      - \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0447\u0430\u0442\u044B\u0439
      \u0434\u043E\u0441\u043F\u0435\u0445 \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u0441\u043D\u044F\u0442, \u0432\u043E\u0440\u043E\u0442 \u0440\u0430\u0437\u043E\u0440\u0432\u0430\u043D.
      \u0411\u044B\u0432\u0448\u0438\u0439 \u0441\u043E\u043B\u0434\u0430\u0442 \u0434\u0435\u0440\u0436\u0438\u0442
      \u043A\u043E\u043F\u044C\u0451 \u043E\u0431\u0435\u0438\u043C\u0438 \u0440\u0443\u043A\u0430\u043C\u0438.
      \u041B\u0438\u0446\u043E \u0438\u0437\u043D\u0443\u0440\u0451\u043D\u043D\u043E\u0435,
      \u043D\u043E \u0432\u0437\u0433\u043B\u044F\u0434 \u0442\u0432\u0451\u0440\u0434\u044B\u0439.
      \u041F\u043E-\u043A\u0438\u0442\u0430\u0439\u0441\u043A\u0438: \"\u0414\u0430\u0439\u0442\u0435
      \u0435\u0434\u044B \u0438 \u0441\u0435\u0440\u0435\u0431\u0440\u0430. \u041C\u043D\u0435
      \u043D\u0435 \u043D\u0443\u0436\u043D\u044B \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0432\u0430\u043C \u0442\u043E\u0436\u0435\". \u0414\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u0441\u0442\u0432\u043E
      \u0438\u0437 \u0442\u0430\u043D\u0441\u043A\u043E\u0439 \u0430\u0440\u043C\u0438\u0438
      \u043A\u0430\u0440\u0430\u0435\u0442\u0441\u044F \u0441\u043C\u0435\u0440\u0442\u044C\u044E.
      \u0421\u043E\u043B\u0434\u0430\u0442 \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C
      \u043E\u043F\u0430\u0441\u0435\u043D \u0438\u043C\u0435\u043D\u043D\u043E \u043F\u043E\u0442\u043E\u043C\u0443,
      \u0447\u0442\u043E \u0442\u0435\u0440\u044F\u0442\u044C \u0435\u043C\u0443
      \u043D\u0435\u0447\u0435\u0433\u043E. \u0415\u0433\u043E \u0438\u043C\u044F
      - \u0427\u044D\u043D\u044C \u042E\u0439, \u0440\u044F\u0434\u043E\u0432\u043E\u0439
      \u0410\u043D\u044C\u0441\u0438\u0439\u0441\u043A\u043E\u0433\u043E \u0433\u0430\u0440\u043D\u0438\u0437\u043E\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636239
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0435
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u044B \u0438 \u043F\u0440\u043E\u0435\u0445\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636240
    m_Localized: "\u0427\u044D\u043D\u044C \u042E\u0439 \u043F\u0440\u043E\u0447\u0451\u043B
      \u043F\u0435\u0447\u0430\u0442\u044C \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u0430
      \u0438 \u043E\u043F\u0443\u0441\u0442\u0438\u043B \u043A\u043E\u043F\u044C\u0451.
      \"\u041B\u044E\u0434\u0438 \u0441 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438
      - \u043D\u0435 \u043C\u043E\u0438 \u0432\u0440\u0430\u0433\u0438\", \u0441\u043A\u0430\u0437\u0430\u043B
      \u043E\u043D. \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0435\u0445\u0430\u043B
      \u0431\u0435\u0437 \u043F\u043B\u0430\u0442\u044B. \u0414\u0435\u0437\u0435\u0440\u0442\u0438\u0440
      \u0443\u0448\u0451\u043B \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043E\u0442 \u0434\u043E\u0440\u043E\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636241
    m_Localized: "\u0414\u0430\u0442\u044C \u0435\u0434\u044B \u0438 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 - \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636242
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442 \u0432\u0437\u044F\u043B \u0435\u0434\u0443
      \u043C\u043E\u043B\u0447\u0430 \u0438 \u043A\u0438\u0432\u043D\u0443\u043B.
      \u0421\u0435\u0440\u0435\u0431\u0440\u043E \u043E\u043D \u0441\u043F\u0440\u044F\u0442\u0430\u043B
      \u0437\u0430 \u043F\u0430\u0437\u0443\u0445\u0443. \u0423\u0448\u0451\u043B
      \u043D\u0430 \u0441\u0435\u0432\u0435\u0440 - \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435
      \u043E\u0442 \u0442\u0430\u043D\u0441\u043A\u0438\u0445 \u0433\u0430\u0440\u043D\u0438\u0437\u043E\u043D\u043E\u0432.
      \u0414\u043E\u0431\u0440\u044B\u0439 \u0436\u0435\u0441\u0442, \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u043F\u043E\u0442\u0435\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636243
    m_Localized: "\u0410\u0442\u0430\u043A\u043E\u0432\u0430\u0442\u044C - \u043E\u043D
      \u043E\u0434\u0438\u043D, \u043D\u0430\u0441 \u043C\u043D\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636244
    m_Localized: "\u0421\u043E\u043B\u0434\u0430\u0442 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043E\u043F\u044B\u0442\u043D\u044B\u043C \u0431\u043E\u0439\u0446\u043E\u043C.
      \u0420\u0430\u043D\u0438\u043B \u0434\u0432\u043E\u0438\u0445 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u043E\u0432
      \u043F\u0440\u0435\u0436\u0434\u0435, \u0447\u0435\u043C \u0435\u0433\u043E
      \u043E\u0431\u0435\u0437\u043E\u0440\u0443\u0436\u0438\u043B\u0438. \u0415\u0433\u043E
      \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0441\u0432\u044F\u0437\u0430\u0442\u044C
      \u0438 \u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0443 \u0434\u043E\u0440\u043E\u0433\u0438.
      \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B, \u043D\u043E
      \u0441 \u043F\u043E\u0442\u0435\u0440\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636245
    m_Localized: "\u0428\u0430\u043A\u0430\u043B\u044B \u0432 \u043D\u043E\u0447\u043D\u043E\u043C
      \u043B\u0430\u0433\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636246
    m_Localized: "\u041F\u0435\u0440\u0435\u0434 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u043E\u043C
      \u0438\u0437 \u0442\u0435\u043C\u043D\u043E\u0442\u044B \u043D\u0435\u0441\u0443\u0442\u0441\u044F
      \u043F\u0440\u043E\u043D\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0442\u044F\u0432\u043A\u0430\u044E\u0449\u0438\u0435 \u043A\u0440\u0438\u043A\u0438
      - \u0430\u0437\u0438\u0430\u0442\u0441\u043A\u0438\u0435 \u0448\u0430\u043A\u0430\u043B\u044B,
      \u0442\u0440\u0438 \u0438\u043B\u0438 \u0447\u0435\u0442\u044B\u0440\u0435
      \u043E\u0441\u043E\u0431\u0438, \u0440\u0430\u0437\u043E\u0440\u0438\u043B\u0438
      \u043C\u0435\u0448\u043A\u0438 \u0441 \u0437\u0435\u0440\u043D\u043E\u043C
      \u0443 \u043A\u0440\u0430\u044F \u043B\u0430\u0433\u0435\u0440\u044F. \u041E\u043D\u0438
      \u043D\u0435 \u0431\u043E\u044F\u0442\u0441\u044F \u0441\u043F\u044F\u0449\u0438\u0445
      \u043B\u044E\u0434\u0435\u0439 \u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442
      \u0431\u044B\u0441\u0442\u0440\u043E: \u043E\u0441\u0442\u0440\u044B\u0435
      \u0437\u0443\u0431\u044B \u0432\u0441\u043F\u0430\u0440\u044B\u0432\u0430\u044E\u0442
      \u043C\u0435\u0448\u043A\u043E\u0432\u0438\u043D\u0443 \u0437\u0430 \u0441\u0435\u043A\u0443\u043D\u0434\u044B.
      \u041E\u0434\u0438\u043D \u0448\u0430\u043A\u0430\u043B \u0443\u0436\u0435
      \u0442\u0430\u0449\u0438\u0442 \u043A\u0443\u0441\u043E\u043A \u0432\u044F\u043B\u0435\u043D\u043E\u0433\u043E
      \u043C\u044F\u0441\u0430. \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u0411\u0438\u043B\u044C\u0433\u044D \u043F\u0440\u043E\u0441\u043D\u0443\u043B\u0441\u044F
      \u043F\u0435\u0440\u0432\u044B\u043C. \u0417\u0430\u043F\u0430\u0445 \u0437\u0435\u0440\u043D\u0430
      \u043D\u0430 \u0437\u0435\u043C\u043B\u0435 \u043F\u0440\u0438\u0432\u043B\u0435\u0447\u0451\u0442
      \u0435\u0449\u0451 \u0431\u043E\u043B\u044C\u0448\u0435 \u043F\u0430\u0434\u0430\u043B\u044C\u0449\u0438\u043A\u043E\u0432
      \u043A \u0443\u0442\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636247
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u0432 \u043D\u0438\u0445
      \u0433\u043E\u0440\u044F\u0449\u0435\u0439 \u0433\u043E\u043B\u043E\u0432\u043D\u0451\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636248
    m_Localized: "\u041E\u0433\u043E\u043D\u044C \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E - \u0448\u0430\u043A\u0430\u043B\u044B
      \u0431\u0440\u043E\u0441\u0438\u043B\u0438\u0441\u044C \u0432\u0440\u0430\u0441\u0441\u044B\u043F\u043D\u0443\u044E.
      \u041F\u044F\u0442\u044C \u043C\u0435\u0448\u043A\u043E\u0432 \u043F\u043E\u0432\u0440\u0435\u0436\u0434\u0435\u043D\u043E,
      \u0437\u0435\u0440\u043D\u043E \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
      \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u043E\u0441\u044C, \u043D\u043E
      \u0431\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u0443\u0434\u0430\u043B\u043E\u0441\u044C
      \u0441\u043E\u0431\u0440\u0430\u0442\u044C \u043E\u0431\u0440\u0430\u0442\u043D\u043E.
      \u041F\u043E\u0442\u0435\u0440\u044F \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636249
    m_Localized: "\u041E\u0442\u043F\u0443\u0433\u043D\u0443\u0442\u044C \u043A\u0440\u0438\u043A\u043E\u043C
      \u0438 \u0445\u043B\u043E\u043F\u043A\u0430\u043C\u0438 - \u043D\u0435 \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C
      \u043E\u0433\u043D\u0451\u043C \u0443 \u0442\u044E\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636250
    m_Localized: "\u0428\u0430\u043A\u0430\u043B\u044B \u0443\u0445\u043E\u0434\u0438\u043B\u0438
      \u043D\u0435\u043E\u0445\u043E\u0442\u043D\u043E, \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u043B\u0438\u0441\u044C
      \u0434\u0432\u0430\u0436\u0434\u044B. \u041A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443
      \u0432\u043E\u0441\u0435\u043C\u044C \u043C\u0435\u0448\u043A\u043E\u0432 \u0437\u0435\u0440\u043D\u0430
      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0435\u043D\u043E. \u0413\u0440\u0443\u0437
      \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B \u0437\u0430\u043C\u0435\u0442\u043D\u043E.
      \u0411\u0438\u043B\u044C\u0433\u044D \u043F\u0440\u043E\u043C\u0430\u044F\u043B\u0441\u044F
      \u0434\u043E \u0443\u0442\u0440\u0430 \u0431\u0435\u0437 \u0441\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636251
    m_Localized: "\u0412\u044B\u0441\u043B\u0430\u0442\u044C \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430
      \u0441 \u0434\u0443\u0431\u0438\u043D\u043E\u0439 - \u043F\u0440\u043E\u0433\u043D\u0430\u0442\u044C
      \u0432\u0440\u0443\u0447\u043D\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636252
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0443\u043A\u0443\u0441 \u0437\u0430 \u0433\u043E\u043B\u0435\u043D\u044C,
      \u043F\u043E\u043A\u0430 \u043F\u0440\u043E\u0433\u043E\u043D\u044F\u043B \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E
      \u0448\u0430\u043A\u0430\u043B\u0430. \u041D\u0435\u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439,
      \u043D\u043E \u0431\u043E\u043B\u0435\u0437\u043D\u0435\u043D\u043D\u044B\u0439.
      \u0428\u0430\u043A\u0430\u043B\u044B \u0443\u0448\u043B\u0438. \u041C\u0435\u0448\u043A\u0438
      \u0441 \u0437\u0435\u0440\u043D\u043E\u043C \u0441\u043F\u0430\u0441\u0435\u043D\u044B
      \u043F\u043E\u0447\u0442\u0438 \u0432\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636253
    m_Localized: "\u0421\u043D\u0435\u0436\u043D\u044B\u0439 \u0431\u0430\u0440\u0441
      \u0443\u0442\u0430\u0449\u0438\u043B \u044F\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636254
    m_Localized: "\u0420\u0430\u043D\u043D\u0438\u043C \u0443\u0442\u0440\u043E\u043C
      \u043D\u0430 \u0433\u043E\u0440\u043D\u043E\u0439 \u0442\u0440\u043E\u043F\u0435
      \u0443 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430 \u0410\u043A-\u0411\u0430\u0439\u0442\u0430\u043B
      \u043E\u0431\u043E\u0437 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u0432\u0430\u0435\u0442,
      \u0447\u0442\u043E \u043E\u0434\u0438\u043D \u0432\u044C\u044E\u0447\u043D\u044B\u0439
      \u044F\u043A \u0438\u0441\u0447\u0435\u0437. \u0421\u043B\u0435\u0434\u044B
      \u043D\u0430 \u0441\u043D\u0435\u0433\u0443 \u0447\u0438\u0442\u0430\u044E\u0442\u0441\u044F
      \u044F\u0441\u043D\u043E: \u0431\u043E\u043B\u044C\u0448\u0438\u0435 \u043C\u044F\u0433\u043A\u0438\u0435
      \u043B\u0430\u043F\u044B \u0434\u043B\u0438\u043D\u043E\u0439 \u0432 \u043B\u0430\u0434\u043E\u043D\u044C
      \u0432\u0437\u0440\u043E\u0441\u043B\u043E\u0433\u043E \u043C\u0443\u0436\u0447\u0438\u043D\u044B
      - \u0441\u043D\u0435\u0436\u043D\u044B\u0439 \u0431\u0430\u0440\u0441 \u043D\u0430\u043F\u0430\u043B
      \u043D\u043E\u0447\u044C\u044E \u0438 \u0443\u0442\u0430\u0449\u0438\u043B
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 \u0437\u0430 \u0443\u0441\u0442\u0443\u043F.
      \u0422\u0440\u043E\u043F\u0430 \u043D\u0430 \u0443\u0441\u0442\u0443\u043F
      \u0432\u0435\u0434\u0451\u0442 \u0432\u043D\u0438\u0437. \u0422\u0430\u043C
      \u043B\u0435\u0436\u0438\u0442 \u0440\u0430\u0441\u0442\u0435\u0440\u0437\u0430\u043D\u043D\u044B\u0439
      \u044F\u043A \u0438 \u0440\u044F\u0434\u043E\u043C, \u043B\u0451\u0436\u0430,
      \u0431\u0430\u0440\u0441 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u043B\u044E\u0434\u0435\u0439 \u0436\u0451\u043B\u0442\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438.
      \u041E\u043D \u043D\u0435 \u0443\u0431\u0435\u0436\u0430\u043B - \u0434\u043E\u0431\u044B\u0447\u0430
      \u0435\u0433\u043E. \u041F\u043E\u0442\u0435\u0440\u044F\u043D \u044F\u043A
      \u0441 \u0447\u0430\u0441\u0442\u044C\u044E \u0433\u0440\u0443\u0437\u0430
      \u043D\u0430 \u0441\u043F\u0438\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636255
    m_Localized: "\u0423\u0439\u0442\u0438 - \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435
      \u043D\u0435 \u0442\u0440\u043E\u043D\u0443\u0442\u044C, \u0431\u0430\u0440\u0441
      \u0441\u0432\u044F\u0449\u0435\u043D\u0435\u043D \u0432 \u0433\u043E\u0440\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636256
    m_Localized: "\u041E\u0431\u043E\u0437 \u0442\u0440\u043E\u043D\u0443\u043B\u0441\u044F
      \u0431\u0435\u0437 \u044F\u043A\u0430. \u0413\u0440\u0443\u0437 \u043F\u0435\u0440\u0435\u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u043B\u0438
      \u043C\u0435\u0436\u0434\u0443 \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u043C\u0438\u0441\u044F
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u043C\u0438. \u041C\u0435\u0441\u0442\u043D\u044B\u0439
      \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0422\u0440\u0438\u0434\u044D
      \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u043F\u043E\u0441\u0442\u0443\u043F\u0438\u043B\u0438
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E - \u0443\u0431\u0438\u0442\u044C
      \u0431\u0430\u0440\u0441\u0430 \u0432 \u0433\u043E\u0440\u0430\u0445 \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442
      \u043D\u0430\u0432\u043B\u0435\u0447\u044C \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u044C\u044F
      \u043D\u0430 \u0432\u0435\u0441\u044C \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636257
    m_Localized: "\u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C \u0431\u0430\u0440\u0441\u0430
      \u0438 \u0441\u043F\u0430\u0441\u0442\u0438 \u0445\u043E\u0442\u044C \u0447\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636258
    m_Localized: "\u0411\u0430\u0440\u0441 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B
      \u043F\u043E\u0441\u043B\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445
      \u043A\u0430\u043C\u043D\u0435\u0439 \u0438 \u043A\u0440\u0438\u043A\u0430,
      \u043D\u043E \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0432\u0437\u043C\u0430\u0445\u043D\u0443\u043B \u043B\u0430\u043F\u043E\u0439.
      \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0435\u0434\u0432\u0430 \u0443\u0441\u043F\u0435\u043B
      \u043E\u0442\u0448\u0430\u0442\u043D\u0443\u0442\u044C\u0441\u044F. \u0427\u0430\u0441\u0442\u044C
      \u0433\u0440\u0443\u0437\u0430 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u0441\u043D\u044F\u0442\u044C
      \u0441 \u044F\u043A\u0430. \u0411\u0430\u0440\u0441 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636259
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0431\u0430\u0440\u0441\u0443
      \u0442\u0443\u0448\u0443 \u0438 \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0438
      - \u043E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636260
    m_Localized: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0435\u0448\u043A\u043E\u0432
      \u0435\u0434\u044B \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0440\u044F\u0434\u043E\u043C.
      \u0411\u0430\u0440\u0441 \u043D\u0435 \u043F\u0440\u0435\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B
      \u043E\u0431\u043E\u0437 \u0434\u0430\u043B\u044C\u0448\u0435. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0422\u0440\u0438\u0434\u044D \u0434\u043E\u0432\u043E\u043B\u0435\u043D:
      \u0442\u0435\u043F\u0435\u0440\u044C \u0434\u0443\u0445 \u044D\u0442\u043E\u0433\u043E
      \u043F\u0440\u043E\u0445\u043E\u0434\u0430 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0441\u0432\u043E\u044E \u0434\u043E\u043B\u044E \u0438 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636261
    m_Localized: "\u0413\u043E\u0440\u0446\u044B \u043D\u0430 \u0443\u0437\u043A\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636262
    m_Localized: "\u0428\u0435\u0441\u0442\u0435\u0440\u043E \u043A\u0440\u0435\u043F\u043A\u0438\u0445
      \u0433\u043E\u0440\u0446\u0435\u0432 \u0432 \u0433\u0440\u0443\u0431\u044B\u0445
      \u0448\u0435\u0440\u0441\u0442\u044F\u043D\u044B\u0445 \u043D\u0430\u043A\u0438\u0434\u043A\u0430\u0445
      \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0442\u0440\u043E\u043F\u0443
      \u0443 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0430 \u0441\u043A\u0430\u043B\u044B.
      \u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0434\u0443\u0431\u0438\u043D\u0430
      \u0438\u043B\u0438 \u0443\u0432\u0435\u0441\u0438\u0441\u0442\u044B\u0439 \u043A\u0430\u043C\u0435\u043D\u044C
      \u0432 \u0440\u0443\u043A\u0435. \u0421\u0442\u0430\u0440\u0448\u0438\u0439
      - \u0432\u044B\u0441\u043E\u043A\u0438\u0439, \u0441 \u043A\u043E\u0441\u043E\u0439
      \u0447\u0451\u0440\u043D\u043E\u0439 \u0431\u043E\u0440\u043E\u0434\u043E\u0439
      - \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043F\u0430\u043B\u044C\u0446\u0435\u043C
      \u043D\u0430 \u0442\u044E\u043A\u0438. \u0422\u0440\u043E\u043F\u0430 \u0448\u0438\u0440\u0438\u043D\u043E\u0439
      \u0432 \u0434\u0432\u0430 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430,
      \u0441\u043B\u0435\u0432\u0430 \u043E\u0442\u0432\u0435\u0441\u043D\u0430\u044F
      \u0441\u0442\u0435\u043D\u0430, \u0441\u043F\u0440\u0430\u0432\u0430 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C.
      \u041E\u0442\u0440\u044F\u0434 \u043D\u0435 \u043F\u043E\u0445\u043E\u0436
      \u043D\u0430 \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0445
      \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432 - \u0441\u043A\u043E\u0440\u0435\u0435
      \u0433\u043E\u0440\u043D\u044B\u0435 \u043F\u0430\u0441\u0442\u0443\u0445\u0438,
      \u043A\u043E\u0442\u043E\u0440\u044B\u043C \u043F\u043B\u043E\u0445\u043E \u0437\u0438\u043C\u043E\u0439.
      \u0414\u0443\u0431\u0438\u043D\u044B \u043F\u0440\u043E\u0442\u0438\u0432 \u043C\u0435\u0447\u0430
      \u043D\u0430 \u0443\u0437\u043A\u043E\u0439 \u0442\u0440\u043E\u043F\u0435
      - \u043E\u043F\u0430\u0441\u043D\u043E\u0435 \u0441\u043E\u0447\u0435\u0442\u0430\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636263
    m_Localized: "\u0423\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0437\u0430\u0432\u0430\u043B
      \u0441\u0437\u0430\u0434\u0438 - \u043E\u0442\u0440\u0435\u0437\u0430\u0442\u044C
      \u043E\u0442\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u0435 \u0438 \u0434\u0430\u0432\u0438\u0442\u044C
      \u0441\u043F\u0435\u0440\u0435\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636264
    m_Localized: "\u0422\u0430\u043A\u0442\u0438\u043A\u0430 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430:
      \u0433\u043E\u0440\u0446\u044B, \u0437\u0430\u0436\u0430\u0442\u044B\u0435
      \u0441 \u043E\u0431\u043E\u0438\u0445 \u043A\u043E\u043D\u0446\u043E\u0432,
      \u0431\u0440\u043E\u0441\u0438\u043B\u0438 \u043A\u0430\u043C\u043D\u0438 \u0438
      \u043F\u043E\u0434\u043D\u044F\u043B\u0438 \u0440\u0443\u043A\u0438. \u041E\u0431\u043E\u0437
      \u043F\u0440\u043E\u0448\u0451\u043B \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0447\u0430\u0441 \u043D\u0430
      \u043C\u0430\u043D\u0451\u0432\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636265
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u043E\u0431\u0445\u043E\u0434 \u043F\u043E
      \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u043C\u0443 \u0443\u0449\u0435\u043B\u044C\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636266
    m_Localized: "\u041E\u0431\u0445\u043E\u0434 \u0437\u0430\u043D\u044F\u043B \u043F\u043E\u043B\u0442\u043E\u0440\u0430
      \u0434\u043D\u044F \u043F\u043E \u043A\u0440\u0443\u0442\u043E\u043C\u0443
      \u0443\u0449\u0435\u043B\u044C\u044E. \u041E\u0434\u0438\u043D \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0441\u044F
      \u043D\u0430 \u043C\u043E\u043A\u0440\u043E\u043C \u043A\u0430\u043C\u043D\u0435
      \u0438 \u0443\u0448\u0438\u0431 \u043A\u043E\u043B\u0435\u043D\u043E. \u0413\u043E\u0440\u0446\u0435\u0432
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438.
      \u041F\u043E\u0442\u0435\u0440\u044F \u0432\u0440\u0435\u043C\u0435\u043D\u0438
      \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636267
    m_Localized: "\u0414\u0430\u0442\u044C \u043F\u043E \u043E\u0434\u043D\u043E\u0439
      \u043C\u043E\u043D\u0435\u0442\u0435 \u043A\u0430\u0436\u0434\u043E\u043C\u0443
      \u0438 \u043F\u0440\u043E\u0439\u0442\u0438 \u0441 \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636268
    m_Localized: "\u0428\u0435\u0441\u0442\u044C \u043C\u043E\u043D\u0435\u0442 -
      \u043D\u0438\u0447\u0442\u043E \u0440\u044F\u0434\u043E\u043C \u0441\u043E
      \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C\u044E \u0433\u0440\u0443\u0437\u0430.
      \u0413\u043E\u0440\u0446\u044B \u0440\u0430\u0441\u0441\u0442\u0443\u043F\u0438\u043B\u0438\u0441\u044C.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445 \u043A\u0438\u0432\u043D\u0443\u043B
      \u0441 \u0434\u043E\u0441\u0442\u043E\u0438\u043D\u0441\u0442\u0432\u043E\u043C.
      \u041D\u0430 \u043E\u0431\u0440\u0430\u0442\u043D\u043E\u043C \u043F\u0443\u0442\u0438
      \u0443 \u044D\u0442\u043E\u0433\u043E \u043F\u0440\u043E\u0445\u043E\u0434\u0430
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636269
    m_Localized: "\u041E\u0441\u043A\u043E\u0440\u0431\u043B\u0435\u043D\u0438\u0435
      \u0443 \u043A\u043E\u043B\u043E\u0434\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636270
    m_Localized: "\u0423 \u043E\u0431\u0449\u0435\u0433\u043E \u043A\u043E\u043B\u043E\u0434\u0446\u0430
      \u043C\u0435\u0436\u0434\u0443 \u0411\u0430\u043B\u0445\u043E\u043C \u0438
      \u0422\u0435\u0440\u043C\u0435\u0437\u043E\u043C \u0432\u0441\u0442\u0440\u0435\u0447\u0430
      \u0441 \u0434\u0440\u0443\u0433\u0438\u043C \u043E\u0431\u043E\u0437\u043E\u043C.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442,
      \u0433\u043E\u0440\u044F\u0447\u0438\u0439 \u0441\u043E\u0433\u0434\u0438\u0435\u0446
      \u0438\u0437 \u0432\u0430\u0448\u0435\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430,
      \u0438 \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u043D\u0430\u0451\u043C\u043D\u0438\u043A
      \u041A\u044E\u043B\u044C \u0438\u0437 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0433\u043E
      \u043E\u0431\u043E\u0437\u0430 \u043F\u043E\u0441\u0441\u043E\u0440\u0438\u043B\u0438\u0441\u044C
      \u0438\u0437-\u0437\u0430 \u043E\u0447\u0435\u0440\u0451\u0434\u043D\u043E\u0441\u0442\u0438
      \u0432\u043E\u0434\u043E\u043F\u043E\u044F. \u041A\u044E\u043B\u044C \u043D\u0430\u0437\u0432\u0430\u043B
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0430 \xAB\u0432\u043E\u043D\u044E\u0447\u0438\u043C
      \u0437\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u0438\u043C
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u043C\xBB. \u041F\u043E \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u043C\u0443
      \u043E\u0431\u044B\u0447\u0430\u044E - \u044D\u0442\u043E \u0442\u0440\u0435\u0431\u0443\u0435\u0442
      \u043E\u0442\u0432\u0435\u0442\u0430. \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0441:
      \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u0435 \u043B\u0438? \u0412\u043E\u043A\u0440\u0443\u0433
      \u0443\u0436\u0435 \u0441\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C \u043E\u0431\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0440\u0435\u0448\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u044F\u043C\u043E
      \u0437\u0434\u0435\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636271
    m_Localized: "\u0420\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044C \u043F\u043E\u0435\u0434\u0438\u043D\u043E\u043A
      - \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0434\u043E\u043B\u0436\u0435\u043D
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0447\u0435\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636272
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0432\u044B\u0438\u0433\u0440\u0430\u043B
      - \u043E\u043F\u044B\u0442\u043D\u044B\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0432 \u043C\u043E\u043B\u043E\u0434\u043E\u0441\u0442\u0438 \u0441\u043B\u0443\u0436\u0438\u043B
      \u0432 \u0434\u043E\u0437\u043E\u0440\u0435. \u041A\u044E\u043B\u044C \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0441\u0438\u043D\u044F\u043A \u043F\u043E\u0434 \u0433\u043B\u0430\u0437\u043E\u043C
      \u0438 \u0438\u0437\u0432\u0438\u043D\u0438\u043B\u0441\u044F. \u041E\u0431\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0440\u0430\u0437\u043E\u0448\u043B\u0438\u0441\u044C.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0445\u043E\u0434\u044F\u0442
      \u0441 \u0433\u043E\u0440\u0434\u044B\u043C \u0432\u0438\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636273
    m_Localized: "\u041E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F \u043E\u0442
      \u0441\u043A\u0430\u043D\u0434\u0430\u043B\u0430 - \u0434\u0430\u0442\u044C
      \u0441\u0435\u0440\u0435\u0431\u0440\u043E \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0443
      \u0442\u043E\u0433\u043E \u043E\u0431\u043E\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636274
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0433\u043B\u0430\u0432\u0435 \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0433\u043E
      \u043E\u0431\u043E\u0437\u0430 \u0440\u0435\u0448\u0438\u043B\u0438 \u0434\u0435\u043B\u043E
      \u0431\u0435\u0437 \u0431\u043E\u044F. \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u0435\u043D - \u043C\u043E\u043B\u0447\u0438\u0442
      \u0432\u0441\u044E \u0434\u043E\u0440\u043E\u0433\u0443. \u041A\u044E\u043B\u044C
      \u0441\u043C\u0435\u0451\u0442\u0441\u044F \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438 \u0443 \u044D\u0442\u043E\u0433\u043E
      \u043A\u043E\u043B\u043E\u0434\u0446\u0430 \u044D\u0442\u043E \u043D\u0435
      \u043F\u0440\u0438\u0431\u0430\u0432\u0438\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636275
    m_Localized: "\u0417\u0430\u043F\u0440\u0435\u0442\u0438\u0442\u044C \u043F\u043E\u0435\u0434\u0438\u043D\u043E\u043A
      - \u043D\u0435 \u0432\u0440\u0435\u043C\u044F \u0434\u043B\u044F \u043B\u0438\u0447\u043D\u044B\u0445
      \u0441\u0447\u0451\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636276
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043F\u043E\u0434\u0447\u0438\u043D\u0438\u043B\u0441\u044F,
      \u043D\u043E \u043E\u0431\u0438\u0434\u0435\u043B\u0441\u044F. \u041E\u0431\u0430
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0443\u0448\u043B\u0438 \u0432
      \u043C\u043E\u043B\u0447\u0430\u043D\u0438\u0438. \u0412 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445
      \u043A\u0440\u0443\u0433\u0430\u0445 \u0411\u0430\u043B\u0445\u0430 \u043F\u043E\u0439\u0434\u0451\u0442
      \u0441\u043B\u0443\u0445, \u0447\u0442\u043E \u0432\u0430\u0448\u0438 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u0440\u043E\u0433\u043B\u043E\u0442\u0438\u043B\u0438 \u043E\u0441\u043A\u043E\u0440\u0431\u043B\u0435\u043D\u0438\u0435.
      \u0410\u0432\u0442\u043E\u0440\u0438\u0442\u0435\u0442 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636277
    m_Localized: "\u0421\u043E\u0431\u043B\u0430\u0437\u043D \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636278
    m_Localized: "\u041D\u0430 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u0439 \u0441\u0442\u043E\u044F\u043D\u043A\u0435
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0412\u0430\u0440\u0437\u0435
      \u043E\u0442\u0432\u043E\u0434\u0438\u0442 \u0432\u0430\u0441 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E,
      \u043D\u0435 \u0433\u043B\u044F\u0434\u044F \u0432 \u0433\u043B\u0430\u0437\u0430.
      \u041A\u0443\u043F\u0435\u0446 \u041C\u0430\u043D\u0430\u0445 \u0438\u0437
      \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u0433\u043E \u043E\u0431\u043E\u0437\u0430
      \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u0435\u043C\u0443 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0438 \u0442\u0451\u043F\u043B\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E \u043F\u0440\u0438 \u0441\u0432\u043E\u0451\u043C
      \u043E\u0431\u043E\u0437\u0435 - \u0435\u0441\u043B\u0438 \u0412\u0430\u0440\u0437\u0435
      \u0440\u0430\u0441\u0441\u043A\u0430\u0436\u0435\u0442 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u0438 \u0441\u043E\u0441\u0442\u0430\u0432 \u0433\u0440\u0443\u0437\u0430.
      \u041E\u043D \u043F\u0440\u0438\u0448\u0451\u043B \u0441\u0430\u043C, \u043D\u0435
      \u0443\u0442\u0430\u0438\u043B. \u0415\u0433\u043E \u0442\u0440\u044F\u0441\u0451\u0442:
      \u0434\u0435\u043D\u044C\u0433\u0438 \u043D\u0443\u0436\u043D\u044B, \u0443
      \u043D\u0435\u0433\u043E \u0434\u043E\u043B\u0433 \u043F\u0435\u0440\u0435\u0434
      \u043B\u0435\u043A\u0430\u0440\u0435\u043C \u0432 \u041C\u0435\u0440\u0432\u0435.
      \u041D\u043E \u043E\u043D \u0437\u0434\u0435\u0441\u044C \u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0432\u0430\u043C. \u042D\u0442\u043E \u043B\u0438\u0431\u043E \u0447\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C,
      \u043B\u0438\u0431\u043E \u0445\u0438\u0442\u0440\u043E\u0441\u0442\u044C -
      \u043D\u0435 \u0441\u0440\u0430\u0437\u0443 \u043F\u043E\u0439\u043C\u0451\u0448\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636279
    m_Localized: "\u041F\u043E\u0445\u0432\u0430\u043B\u0438\u0442\u044C \u0438 \u043F\u043E\u043A\u0440\u044B\u0442\u044C
      \u0435\u0433\u043E \u0434\u043E\u043B\u0433 - \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636280
    m_Localized: "\u0412\u0430\u0440\u0437\u0435 \u0437\u0430\u043F\u043B\u0430\u043A\u0430\u043B
      - \u0442\u0438\u0445\u043E, \u0443\u0442\u0435\u0440\u0435\u0432 \u043B\u0438\u0446\u043E
      \u0440\u0443\u043A\u0430\u0432\u043E\u043C. \u0421 \u044D\u0442\u043E\u0433\u043E
      \u0434\u043D\u044F \u043E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u043B
      \u0432\u0434\u0432\u043E\u0435 \u0443\u0441\u0435\u0440\u0434\u043D\u0435\u0435.
      \u041C\u0430\u043D\u0430\u0445 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u0443\u0437\u043D\u0430\u043B. \u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u043B\u0443\u0447\u0448\u0438\u043C \u0432\u043B\u043E\u0436\u0435\u043D\u0438\u0435\u043C
      \u0432 \u044D\u0442\u043E\u043C \u043E\u0431\u043E\u0437\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636281
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438
      \u0438\u0437 \u043A\u0430\u0437\u043D\u044B \u0438 \u043F\u043E\u0442\u0440\u0435\u0431\u043E\u0432\u0430\u0442\u044C
      \u0432\u0435\u0440\u043D\u043E\u0441\u0442\u0438 \u043A\u043B\u044F\u0442\u0432\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636282
    m_Localized: "\u0412\u0430\u0440\u0437\u0435 \u043F\u043E\u043A\u043B\u044F\u043B\u0441\u044F
      \u043D\u0430 \u0441\u0432\u043E\u0451\u043C \u043A\u0438\u043D\u0436\u0430\u043B\u0435
      - \u043F\u043E \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C\u0443
      \u043E\u0431\u044B\u0447\u0430\u044E \u043A\u043B\u044F\u0442\u0432\u0430 \u043D\u0430
      \u043E\u0440\u0443\u0436\u0438\u0438 \u043D\u0435\u0440\u0443\u0448\u0438\u043C\u0430.
      \u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043E\u0442\u0434\u0430\u043D\u044B. \u041E\u043D \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u0435\u0435. \u041C\u0430\u043D\u0430\u0445
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u043B
      \u043A \u043D\u0435\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636283
    m_Localized: "\u0423\u0432\u043E\u043B\u0438\u0442\u044C \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      - \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u0440\u0438\u0441\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636284
    m_Localized: "\u0412\u0430\u0440\u0437\u0435 \u0443\u0448\u0451\u043B \u043C\u043E\u043B\u0447\u0430,
      \u0437\u0430\u0431\u0440\u0430\u0432 \u0441\u0432\u043E\u0438 \u0432\u0435\u0449\u0438.
      \u041C\u043E\u0436\u0435\u0442, \u043E\u043D \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0431\u044B\u043B \u0447\u0435\u0441\u0442\u0435\u043D. \u0411\u0435\u0437
      \u043D\u0435\u0433\u043E \u043E\u0445\u0440\u0430\u043D\u0430 \u043E\u0441\u043B\u0430\u0431\u043B\u0430.
      \u041E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435
      \u0432\u044B\u0440\u043E\u0441\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636285
    m_Localized: "\u0421\u043A\u0440\u044B\u0442\u0430\u044F \u0440\u0430\u043D\u0430
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636286
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u041F\u0435\u043C\u0431\u0430
      \u0437\u0430\u043C\u0435\u0447\u0430\u0435\u0442, \u0447\u0442\u043E \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u041A\u044E\u043B\u044C \u0445\u0440\u043E\u043C\u0430\u0435\u0442 - \u043D\u0435\u043B\u043E\u0432\u043A\u043E,
      \u0431\u0443\u0434\u0442\u043E \u0441\u0442\u0430\u0440\u0430\u0435\u0442\u0441\u044F
      \u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0442\u044C.
      \u041D\u0430 \u0441\u0442\u043E\u044F\u043D\u043A\u0435 \u041F\u0435\u043C\u0431\u0430
      \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u0435\u0433\u043E
      \u0431\u0435\u0437 \u0441\u043F\u0440\u043E\u0441\u0430 \u0438 \u0432\u0438\u0434\u0438\u0442:
      \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439 \u043F\u043E\u0440\u0435\u0437
      \u043D\u0430 \u0431\u0435\u0434\u0440\u0435, \u043F\u0435\u0440\u0435\u0442\u044F\u043D\u0443\u0442\u044B\u0439
      \u0433\u0440\u044F\u0437\u043D\u043E\u0439 \u0442\u0440\u044F\u043F\u043A\u043E\u0439,
      \u0443\u0436\u0435 \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0433\u043D\u043E\u0438\u0442\u044C\u0441\u044F.
      \u041A\u044E\u043B\u044C \u0437\u043B\u0438\u0442\u0441\u044F: \"\u041D\u0438\u0447\u0435\u0433\u043E
      \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E, \u0437\u0430\u0436\u0438\u0432\u0451\u0442
      \u0441\u0430\u043C\u043E\". \u0422\u0440\u0438 \u0434\u043D\u044F \u043E\u043D
      \u0441\u043A\u0440\u044B\u0432\u0430\u043B - \u043D\u0435 \u0445\u043E\u0442\u0435\u043B
      \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C \u043C\u0435\u0441\u0442\u043E.
      \u0415\u0441\u043B\u0438 \u043D\u0435 \u043B\u0435\u0447\u0438\u0442\u044C,
      \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u0434\u043D\u044F \u043E\u043D
      \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0442 \u0438\u0434\u0442\u0438.
      \u0427\u0435\u0440\u0435\u0437 \u043F\u044F\u0442\u044C - \u0437\u0430\u0440\u0430\u0436\u0435\u043D\u0438\u0435
      \u043A\u0440\u043E\u0432\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636287
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043E\u0431\u043E\u0437
      - \u0434\u0430\u0442\u044C \u041F\u0435\u043C\u0431\u0435 \u0434\u0435\u043D\u044C
      \u043D\u0430 \u043B\u0435\u0447\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636288
    m_Localized: "\u0414\u0435\u043D\u044C \u043F\u043E\u0442\u0435\u0440\u044F\u043D,
      \u043D\u043E \u041F\u0435\u043C\u0431\u0430 \u043F\u0440\u043E\u043C\u044B\u043B
      \u0440\u0430\u043D\u0443 \u044F\u0447\u043C\u0435\u043D\u043D\u044B\u043C \u0443\u043A\u0441\u0443\u0441\u043E\u043C
      \u0438 \u043F\u0435\u0440\u0435\u0442\u044F\u043D\u0443\u043B \u0447\u0438\u0441\u0442\u044B\u043C
      \u043B\u044C\u043D\u043E\u043C. \u041A\u044E\u043B\u044C \u0447\u0435\u0440\u0435\u0437
      \u0442\u0440\u0438 \u0434\u043D\u044F \u0448\u0451\u043B \u043D\u043E\u0440\u043C\u0430\u043B\u044C\u043D\u043E.
      \u041E\u0431\u043E\u0437 \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043B
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636289
    m_Localized: "\u041D\u0435\u0441\u0442\u0438 \u0440\u0430\u043D\u0435\u043D\u043E\u0433\u043E
      \u043D\u0430 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0435 \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636290
    m_Localized: "\u041A\u044E\u043B\u044C \u0435\u0445\u0430\u043B \u043D\u0430
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0435, \u0437\u043B\u044F\u0441\u044C.
      \u0427\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u0434\u043D\u044F \u0440\u0430\u043D\u0430
      \u0432\u043E\u0441\u043F\u0430\u043B\u0438\u043B\u0430\u0441\u044C \u0441\u0438\u043B\u044C\u043D\u0435\u0435.
      \u041F\u0435\u043C\u0431\u0430 \u043B\u0435\u0447\u0438\u043B \u043D\u0430
      \u0445\u043E\u0434\u0443, \u043A\u0430\u043A \u043C\u043E\u0433. \u0412 \u0438\u0442\u043E\u0433\u0435
      \u041A\u044E\u043B\u044C \u0432\u044B\u0436\u0438\u043B, \u043D\u043E \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B
      \u0434\u0432\u0435 \u043D\u043E\u0447\u043D\u044B\u0435 \u0441\u043C\u0435\u043D\u044B
      \u043E\u0445\u0440\u0430\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636291
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0437\u0430
      \u043B\u0435\u0447\u0435\u043D\u0438\u0435 \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C
      \u0441\u0435\u043B\u0435\u043D\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636292
    m_Localized: "\u0421\u0435\u043B\u044C\u0441\u043A\u0438\u0439 \u043B\u0435\u043A\u0430\u0440\u044C
      \u0432\u0437\u044F\u043B \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0438 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B
      \u043E\u0442\u0432\u0430\u0440 \u043F\u043E\u043B\u044B\u043D\u0438. \u041D\u0435\u043F\u043B\u043E\u0445\u043E
      - \u041A\u044E\u043B\u044C \u043F\u043E\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F
      \u0437\u0430 \u0434\u0432\u0430 \u0434\u043D\u044F. \u041E\u0431\u043E\u0437
      \u0441\u0434\u0435\u043B\u0430\u043B \u043A\u0440\u044E\u043A \u0432 \u043F\u043E\u043B\u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636293
    m_Localized: "\u0411\u0440\u0430\u0442 \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636294
    m_Localized: "\u041D\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u043C
      \u0434\u0432\u043E\u0440\u0435 \u0432 \u041A\u0430\u0448\u0433\u0430\u0440\u0435
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0411\u0443\u0433\u0430 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430 \u0432 \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u043E\u0439
      \u043E\u0434\u0435\u0436\u0434\u0435 \u0441 \u0432\u043E\u0435\u043D\u043D\u043E\u0439
      \u0432\u044B\u043F\u0440\u0430\u0432\u043A\u043E\u0439. \u0411\u0443\u0433\u0430
      \u0441\u0430\u043C \u043D\u0435 \u0441\u0432\u043E\u0439 - \u043E\u0431\u043D\u0438\u043C\u0430\u0435\u0442
      \u0435\u0433\u043E, \u043F\u043E\u0442\u043E\u043C \u043E\u0442\u0432\u043E\u0434\u0438\u0442
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0442:
      \u044D\u0442\u043E \u0435\u0433\u043E \u043C\u043B\u0430\u0434\u0448\u0438\u0439
      \u0431\u0440\u0430\u0442 \u0422\u0435\u0433\u0438\u043D, \u0441\u0431\u0435\u0436\u0430\u0432\u0448\u0438\u0439
      \u0438\u0437 \u0443\u0439\u0433\u0443\u0440\u0441\u043A\u043E\u0433\u043E \u0433\u0430\u0440\u043D\u0438\u0437\u043E\u043D\u0430
      \u0442\u0440\u0438 \u043D\u0435\u0434\u0435\u043B\u0438 \u043D\u0430\u0437\u0430\u0434.
      \u0422\u0435\u0433\u0438\u043D \u043F\u0440\u043E\u0441\u0438\u0442 \u0443\u043A\u0440\u044B\u0442\u0438\u044F
      \u0432 \u043E\u0431\u043E\u0437\u0435 - \u043E\u043D \u0431\u043E\u0438\u0442\u0441\u044F,
      \u0447\u0442\u043E \u0443\u0439\u0433\u0443\u0440\u0441\u043A\u0438\u0435 \u043E\u0444\u0438\u0446\u0435\u0440\u044B
      \u0438\u0449\u0443\u0442 \u0435\u0433\u043E \u043F\u043E \u0432\u0441\u0435\u043C\u0443
      \u041A\u0430\u0448\u0433\u0430\u0440\u0443. \u0411\u0443\u0433\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0441 \u043C\u043E\u043B\u044F\u0449\u0438\u043C
      \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C. \u0414\u0435\u0437\u0435\u0440\u0442\u0438\u0440\u043E\u0432
      \u043D\u0435 \u0443\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0431\u0435\u0437
      \u043F\u043E\u0441\u043B\u0435\u0434\u0441\u0442\u0432\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636295
    m_Localized: "\u0421\u043F\u0440\u044F\u0442\u0430\u0442\u044C \u0422\u0435\u0433\u0438\u043D\u0430
      \u043F\u043E\u0434 \u0442\u044E\u043A\u0430\u043C\u0438 - \u0440\u0438\u0441\u043A\u043D\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636296
    m_Localized: "\u0422\u0435\u0433\u0438\u043D \u0442\u0440\u043E\u0435 \u0441\u0443\u0442\u043E\u043A
      \u0435\u0445\u0430\u043B \u043F\u043E\u0434 \u0442\u044E\u043A\u0430\u043C\u0438,
      \u043F\u043E\u0447\u0442\u0438 \u0431\u0435\u0437 \u0435\u0434\u044B. \u041D\u0430
      \u0432\u044B\u0435\u0437\u0434\u0435 \u0438\u0437 \u041A\u0430\u0448\u0433\u0430\u0440\u0430
      \u043F\u0430\u0442\u0440\u0443\u043B\u044C \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B
      \u043E\u0431\u043E\u0437 - \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435
      \u043D\u0430\u0448\u043B\u0438. \u0411\u0443\u0433\u0430 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0434\u043E\u043B\u0436\u0435\u043D \u0432\u0430\u043C \u0431\u043E\u043B\u044C\u0448\u0435,
      \u0447\u0435\u043C \u043B\u044E\u0431\u043E\u0435 \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u0435
      \u0432\u044B\u0440\u0430\u0436\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636297
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0422\u0435\u0433\u0438\u043D\u0443
      \u0437\u0430 \u0434\u043E\u0440\u043E\u0433\u0443 - \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u0434\u0440\u0443\u0433\u0438\u043C \u043F\u0443\u0442\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636298
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0438 \u0443\u043A\u0430\u0437\u0430\u043D\u0438\u0435 \u043D\u0430 \u0442\u0440\u043E\u043F\u0443
      \u0447\u0435\u0440\u0435\u0437 \u0433\u043E\u0440\u044B \u043F\u043E\u043C\u043E\u0433\u043B\u0438
      \u0422\u0435\u0433\u0438\u043D\u0443 \u0443\u0439\u0442\u0438 \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E.
      \u0411\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E \u0434\u043B\u044F \u043E\u0431\u043E\u0437\u0430.
      \u0411\u0443\u0433\u0430 \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B
      \u0441\u0434\u0435\u0440\u0436\u0430\u043D\u043D\u043E, \u043D\u043E \u0438\u0441\u043A\u0440\u0435\u043D\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636299
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u0447\u0443\u0436\u0438\u0435
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B \u043D\u0435 \u043D\u0430\u0448\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636300
    m_Localized: "\u0411\u0443\u0433\u0430 \u043A\u0438\u0432\u043D\u0443\u043B \u0438
      \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B.
      \u0422\u0435\u0433\u0438\u043D \u0443\u0448\u0451\u043B \u0432 \u0433\u043E\u0440\u043E\u0434.
      \u0427\u0442\u043E \u0441 \u043D\u0438\u043C \u0441\u0442\u0430\u043B\u043E
      - \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E. \u0411\u0443\u0433\u0430
      \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0443,
      \u043D\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443.
      \u0427\u0442\u043E-\u0442\u043E \u043C\u0435\u0436\u0434\u0443 \u0432\u0430\u043C\u0438
      \u0441\u043B\u043E\u043C\u0430\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636301
    m_Localized: "\u0420\u0435\u0434\u043A\u0430\u044F \u0442\u0440\u0430\u0432\u0430
      \u043B\u0435\u043A\u0430\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636302
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u041F\u0435\u043C\u0431\u0430
      \u0432\u0434\u0440\u0443\u0433 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u0441\u043A\u043B\u043E\u043D\u0435, \u043D\u0435 \u0441\u043B\u0443\u0448\u0430\u044F
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432. \u041E\u043D
      \u043F\u0440\u0438\u0441\u0435\u043B \u0443 \u0441\u0435\u0440\u043E\u0433\u043E
      \u043A\u0430\u043C\u043D\u044F \u0438 \u0440\u0432\u0451\u0442 \u0447\u0442\u043E-\u0442\u043E
      \u0440\u0443\u043A\u0430\u043C\u0438, \u0443\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044F
      \u0432 \u043B\u044C\u043D\u044F\u043D\u043E\u0439 \u043C\u0435\u0448\u043E\u0447\u0435\u043A.
      \u041F\u043E\u0442\u043E\u043C \u0431\u0435\u0436\u0438\u0442 \u043A \u0432\u0430\u043C,
      \u0433\u043B\u0430\u0437\u0430 \u0431\u043B\u0435\u0441\u0442\u044F\u0442:
      \"\u042D\u0442\u043E \u0432\u043E\u043B\u0447\u044C\u044F \u044F\u0433\u043E\u0434\u0430
      \u0433\u043E\u0440\u043D\u0430\u044F - \u043E\u043D\u0430 \u0440\u0430\u0441\u0442\u0451\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u0437\u0434\u0435\u0441\u044C, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 \u043B\u0435\u0442\u0430. \u0414\u0430\u0439\u0442\u0435
      \u043C\u043D\u0435 \u0447\u0430\u0441. \u041D\u0435\u0442, \u0434\u0432\u0430.
      \u042F \u0441\u043E\u0431\u0435\u0440\u0443 \u0441\u0442\u043E\u043B\u044C\u043A\u043E,
      \u0447\u0442\u043E\u0431\u044B \u0445\u0432\u0430\u0442\u0438\u043B\u043E \u043D\u0430
      \u0433\u043E\u0434. \u042D\u0442\u043E \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E
      \u043E\u0442 \u0433\u043E\u0440\u043D\u043E\u0439 \u043B\u0438\u0445\u043E\u0440\u0430\u0434\u043A\u0438
      - \u043B\u044E\u0431\u043E\u0439 \u0430\u043F\u0442\u0435\u043A\u0430\u0440\u044C
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435 \u0432\u043E\u0437\u044C\u043C\u0451\u0442
      \u0435\u0451 \u043F\u043E \u0432\u0435\u0441\u0443 \u0441\u0435\u0440\u0435\u0431\u0440\u0430\".
      \u041E\u0431\u043E\u0437 \u0441\u0442\u043E\u0438\u0442. \u0412\u0440\u0435\u043C\u044F
      \u0438\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636303
    m_Localized: "\u0414\u0430\u0442\u044C \u0434\u0432\u0430 \u0447\u0430\u0441\u0430
      - \u043B\u0435\u043A\u0430\u0440\u0441\u0442\u0432\u043E \u0434\u043E\u0440\u043E\u0433\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636304
    m_Localized: "\u041F\u0435\u043C\u0431\u0430 \u0441\u043E\u0431\u0440\u0430\u043B
      \u043F\u043E\u043B\u043D\u044B\u0439 \u043C\u0435\u0448\u043E\u0447\u0435\u043A.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0434\u0435\u043D\u044C,
      \u043D\u043E \u041F\u0435\u043C\u0431\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442
      \u0441\u0447\u0430\u0441\u0442\u043B\u0438\u0432\u044B\u043C. \u0412 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u0441\u0431\u043E\u0440 \u043F\u0440\u0438\u043D\u0451\u0441 \u043D\u0435\u043F\u043B\u043E\u0445\u0443\u044E
      \u0441\u0443\u043C\u043C\u0443. \u041B\u0435\u043A\u0430\u0440\u044C \u0441\u0442\u0430\u043B
      \u043B\u0435\u0447\u0438\u0442\u044C \u043E\u0445\u043E\u0442\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636305
    m_Localized: "\u0414\u0430\u0442\u044C \u043F\u043E\u043B\u0447\u0430\u0441\u0430
      - \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0430\u043C\u043E\u0435 \u0446\u0435\u043D\u043D\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636306
    m_Localized: "\u041F\u0435\u043C\u0431\u0430 \u0443\u0441\u043F\u0435\u043B \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u043C\u0435\u0448\u043E\u0447\u043A\u0430.
      \u041D\u0435\u043C\u043D\u043E\u0433\u043E \u0437\u043B\u0438\u0442\u0441\u044F,
      \u0447\u0442\u043E \u043C\u0430\u043B\u043E, \u043D\u043E \u043D\u0435 \u0441\u043F\u043E\u0440\u0438\u0442.
      \u041E\u0431\u043E\u0437 \u0441\u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u043F\u043E\u0447\u0442\u0438 \u0431\u0435\u0437 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438.
      \u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F \u043F\u043E\u043B\u044C\u0437\u0430
      \u0434\u043B\u044F \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F \u0432
      \u0434\u043E\u0440\u043E\u0433\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636307
    m_Localized: "\u0417\u0430\u043F\u0440\u0435\u0442\u0438\u0442\u044C - \u043D\u0435\u043A\u043E\u0433\u0434\u0430
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636308
    m_Localized: "\u041F\u0435\u043C\u0431\u0430 \u043F\u043E\u0434\u0447\u0438\u043D\u0438\u043B\u0441\u044F
      \u043C\u043E\u043B\u0447\u0430, \u043D\u043E \u0432\u0435\u0441\u044C \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u0434\u0435\u043D\u044C \u043B\u0435\u0447\u0438\u043B \u0432\u044F\u043B\u043E
      \u0438 \u043E\u0433\u0440\u044B\u0437\u0430\u043B\u0441\u044F \u043D\u0430
      \u0432\u043E\u043F\u0440\u043E\u0441\u044B. \u0422\u0440\u0430\u0432\u0430
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u043D\u0430 \u0441\u043A\u043B\u043E\u043D\u0435.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0441\u0442\u0430\u043B\u0438
      \u0440\u0435\u0436\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F
      \u043A \u043B\u0435\u043A\u0430\u0440\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636309
    m_Localized: "\u041C\u043E\u0440 \u0432 \u0434\u0435\u0440\u0435\u0432\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636310
    m_Localized: "\u0423 \u0432\u043E\u0440\u043E\u0442 \u0433\u043B\u0438\u043D\u043E\u0431\u0438\u0442\u043D\u043E\u0439
      \u0434\u0435\u0440\u0435\u0432\u043D\u0438 \u043D\u0430 \u043A\u0440\u0430\u044E
      \u043F\u0443\u0441\u0442\u044B\u043D\u0438 \u041F\u0435\u043C\u0431\u0430 \u0441\u043B\u044B\u0448\u0438\u0442
      \u043A\u0430\u0448\u0435\u043B\u044C \u0438 \u0441\u0442\u043E\u043D \u0432\u043D\u0443\u0442\u0440\u0438.
      \u041E\u043D \u0437\u0430\u0445\u043E\u0434\u0438\u0442 \u0441\u0430\u043C
      - \u0438 \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0447\u0435\u0440\u0435\u0437
      \u043C\u0438\u043D\u0443\u0442\u0443 \u0441 \u0431\u043B\u0435\u0434\u043D\u044B\u043C
      \u043B\u0438\u0446\u043E\u043C: \u043F\u044F\u0442\u0435\u0440\u043E \u0434\u0435\u0442\u0435\u0439
      \u0431\u043E\u043B\u044C\u043D\u044B \u043F\u043E\u043D\u043E\u0441\u043E\u043C
      \u0441 \u043A\u0440\u043E\u0432\u044C\u044E, \u0434\u0432\u043E\u0435 \u0443\u0436\u0435
      \u043D\u0435 \u0432\u0441\u0442\u0430\u044E\u0442. \u041F\u0435\u043C\u0431\u0430
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E: \"\u042D\u0442\u043E
      \u043D\u0435 \u0437\u0430\u0440\u0430\u0437\u043D\u043E\u0435 - \u043D\u0435\u0447\u0438\u0441\u0442\u0430\u044F
      \u0432\u043E\u0434\u0430. \u042F \u043C\u043E\u0433\u0443 \u043F\u043E\u043C\u043E\u0447\u044C,
      \u0443 \u043C\u0435\u043D\u044F \u0435\u0441\u0442\u044C \u0441\u043D\u0430\u0434\u043E\u0431\u044C\u044F.
      \u041D\u043E \u043D\u0443\u0436\u043D\u043E \u0442\u0440\u0438 \u0434\u043D\u044F\".
      \u0422\u0440\u0438 \u0434\u043D\u044F \u043D\u0430 \u043C\u0435\u0441\u0442\u0435
      \u043E\u0437\u043D\u0430\u0447\u0430\u044E\u0442 \u043F\u043E\u0442\u0435\u0440\u044E
      \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u043F\u043E\u0433\u043E\u0434\u044B
      \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430. \u0418
      \u0442\u0440\u0430\u0442\u0430 \u0437\u0430\u043F\u0430\u0441\u043E\u0432 \u043B\u0435\u043A\u0430\u0440\u044F
      \u043D\u0430 \u0447\u0443\u0436\u0438\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636311
    m_Localized: "\u041F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C - \u043E\u0441\u0442\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0442\u0440\u0438 \u0434\u043D\u044F, \u043F\u043E\u043C\u043E\u0447\u044C
      \u0434\u0435\u0440\u0435\u0432\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636312
    m_Localized: "\u0414\u0435\u0442\u0438 \u0432\u044B\u0436\u0438\u043B\u0438.
      \u041D\u0430 \u0442\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C
      \u0434\u0435\u0440\u0435\u0432\u0435\u043D\u0441\u043A\u0438\u0439 \u0441\u0442\u0430\u0440\u0435\u0439\u0448\u0438\u043D\u0430
      \u043F\u0440\u0438\u043D\u0451\u0441 \u043B\u0435\u043F\u0451\u0448\u043A\u0438
      \u0438 \u043C\u0451\u0434. \u041F\u043E \u043E\u043A\u0440\u0443\u0433\u0435
      \u043F\u043E\u0448\u043B\u0430 \u043C\u043E\u043B\u0432\u0430 \u043E \u0434\u043E\u0431\u0440\u043E\u043C
      \u043E\u0431\u043E\u0437\u0435. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0432\u044B\u0440\u043E\u0441\u043B\u0430. \u041F\u0435\u043C\u0431\u0430
      \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0431\u0435\u0437 \u0441\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636313
    m_Localized: "\u0414\u0430\u0442\u044C \u041F\u0435\u043C\u0431\u0435 \u0447\u0430\u0441
      - \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u0435\u0440\u0432\u0443\u044E
      \u043F\u043E\u043C\u043E\u0449\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636314
    m_Localized: "\u041F\u0435\u043C\u0431\u0430 \u0441\u0434\u0435\u043B\u0430\u043B
      \u0447\u0442\u043E \u0441\u043C\u043E\u0433 \u0437\u0430 \u0447\u0430\u0441:
      \u0434\u0430\u043B \u043F\u043E\u0440\u043E\u0448\u043E\u043A \u043E\u0442
      \u043F\u043E\u043D\u043E\u0441\u0430, \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043B
      \u043F\u0440\u043E \u0432\u043E\u0434\u0443. \u041E\u043D \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u0435\u043D
      - \u0433\u043E\u0432\u043E\u0440\u0438\u0442, \u044D\u0442\u043E\u0433\u043E
      \u043C\u0430\u043B\u043E. \u0414\u0435\u0442\u044F\u043C \u0441\u0442\u0430\u043B\u043E
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u043B\u0443\u0447\u0448\u0435.
      \u041E\u0431\u043E\u0437 \u0443\u0448\u0451\u043B \u0432 \u0441\u043E\u043C\u043D\u0435\u043D\u0438\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636315
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043C\u0435\u0441\u0442\u043D\u043E\u0439
      \u0437\u043D\u0430\u0445\u0430\u0440\u043A\u0435 - \u0438 \u0435\u0445\u0430\u0442\u044C
      \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636316
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043C\u0435\u0441\u0442\u043D\u043E\u0439 \u0437\u043D\u0430\u0445\u0430\u0440\u043A\u0435.
      \u041F\u0435\u043C\u0431\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u0441\u043B\u0435\u0434
      \u0434\u0435\u0440\u0435\u0432\u043D\u0435 \u043C\u043E\u043B\u0447\u0430.
      \u041E\u043D \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u043D\u043E \u0432 \u043B\u0430\u0433\u0435\u0440\u0435 \u0432 \u0442\u043E\u0442
      \u0432\u0435\u0447\u0435\u0440 \u043B\u0435\u0447\u0438\u043B \u0432\u0441\u0435
      \u043C\u0435\u043B\u043A\u0438\u0435 \u0441\u0441\u0430\u0434\u0438\u043D\u044B
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u0441 \u043E\u0441\u043E\u0431\u043E\u0439
      \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E,
      \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u0438\u0441\u043A\u0443\u043F\u0430\u044F
      \u0447\u0442\u043E-\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636317
    m_Localized: "\u041B\u0435\u043A\u0430\u0440\u044C \u0438 \u0434\u043E\u043B\u0436\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636318
    m_Localized: "\u041D\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u043C
      \u0434\u0432\u043E\u0440\u0435 \u0432 \u0411\u0443\u0445\u0430\u0440\u0435
      \u041F\u0435\u043C\u0431\u0430 \u0431\u043B\u0435\u0434\u043D\u0435\u0435\u0442,
      \u0443\u0432\u0438\u0434\u0435\u0432 \u043F\u043E\u0436\u0438\u043B\u043E\u0433\u043E
      \u043A\u0443\u043F\u0446\u0430. \u041E\u043D \u0442\u044F\u043D\u0435\u0442
      \u0432\u0430\u0441 \u0437\u0430 \u0440\u0443\u043A\u0430\u0432: \"\u042D\u0442\u043E
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0438\u0437 \u0421\u043E\u0433\u0434\u0438\u0430\u043D\u044B.
      \u0421\u0435\u043C\u044C \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434
      \u044F \u0432\u044B\u0442\u0430\u0449\u0438\u043B \u0435\u0433\u043E \u0438\u0437
      \u0433\u043E\u0440\u044F\u0447\u043A\u0438 \u0432 \u0411\u0430\u043B\u0445\u0435
      - \u0442\u0440\u0438 \u043D\u0435\u0434\u0435\u043B\u0438 \u0443 \u043F\u043E\u0441\u0442\u0435\u043B\u0438,
      \u043D\u043E\u0447\u0430\u043C\u0438. \u041E\u043D \u043E\u0431\u0435\u0449\u0430\u043B
      \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043C\u043D\u0435 \u0437\u043E\u043B\u043E\u0442\u043E\u043C\".
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0436\u0438\u0432 \u0438
      \u044F\u0432\u043D\u043E \u0431\u043E\u0433\u0430\u0442 - \u043D\u0430 \u043F\u0430\u043B\u044C\u0446\u0430\u0445
      \u043A\u043E\u043B\u044C\u0446\u0430, \u0440\u044F\u0434\u043E\u043C \u0434\u0432\u0430
      \u0441\u043B\u0443\u0433\u0438. \u041F\u0435\u043C\u0431\u0430 \u043D\u0435
      \u043F\u0440\u043E\u0441\u0438\u0442 \u0432\u0430\u0441 \u0432\u043C\u0435\u0448\u0430\u0442\u044C\u0441\u044F.
      \u041D\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u044B\u0436\u0438\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636319
    m_Localized: "\u041F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C \u0441
      \u043A\u0443\u043F\u0446\u043E\u043C - \u043D\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u044C
      \u043E \u0434\u043E\u043B\u0433\u0435 \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636320
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043F\u043E\u043C\u043E\u0440\u0449\u0438\u043B\u0441\u044F,
      \u043D\u043E \u0434\u0435\u043D\u044C\u0433\u0438 \u043E\u0442\u0434\u0430\u043B
      - \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432,
      \u044F\u0432\u043D\u043E \u043C\u0435\u043D\u044C\u0448\u0435 \u043E\u0431\u0435\u0449\u0430\u043D\u043D\u043E\u0433\u043E.
      \u041F\u0435\u043C\u0431\u0430 \u0432\u0437\u044F\u043B \u043C\u043E\u043B\u0447\u0430.
      \u0421\u0435\u043C\u044C \u043B\u0435\u0442, \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u043E\u043D \u0443\u0436\u0435 \u043F\u043E\u0447\u0442\u0438 \u043D\u0435
      \u0432\u0435\u0440\u0438\u043B. \u041D\u043E \u043F\u043E\u043C\u043D\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636321
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0443
      \u043C\u0435\u0441\u0442\u043E \u0432 \u043D\u0430\u0448\u0435\u043C \u043E\u0431\u043E\u0437\u0435
      - \u0437\u0430 \u0436\u0438\u0437\u043D\u044C \u043F\u043B\u0430\u0442\u044F\u0442
      \u043D\u0430\u0442\u0443\u0440\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636322
    m_Localized: "\u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u043E\u0436\u0438\u0432\u0438\u043B\u0441\u044F
      - \u0435\u043C\u0443 \u043A\u0430\u043A \u0440\u0430\u0437 \u043D\u0443\u0436\u043D\u0430
      \u0431\u044B\u043B\u0430 \u043E\u0445\u0440\u0430\u043D\u0430 \u0434\u043E
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430. \u041E\u043D
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B \u0437\u0430 \u043C\u0435\u0441\u0442\u043E
      \u0449\u0435\u0434\u0440\u043E, \u0430 \u0441 \u041F\u0435\u043C\u0431\u043E\u0439
      \u043F\u043E\u043C\u0438\u0440\u0438\u043B\u0441\u044F \u0437\u0430 \u0447\u0430\u0448\u0435\u0439
      \u043A\u0443\u043C\u044B\u0441\u0430. \u0414\u043E\u043B\u0433 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636323
    m_Localized: "\u041D\u0435 \u0432\u043C\u0435\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      - \u043B\u0438\u0447\u043D\u043E\u0435 \u0434\u0435\u043B\u043E \u041F\u0435\u043C\u0431\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636324
    m_Localized: "\u041F\u0435\u043C\u0431\u0430 \u043F\u043E\u0434\u043E\u0448\u0451\u043B
      \u043A \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0443 \u0441\u0430\u043C.
      \u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0432\u044B\u0448\u0435\u043B
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C \u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u043C.
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0443\u0448\u0451\u043B,
      \u043D\u0435 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u0432. \u041F\u0435\u043C\u0431\u0430
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0443
      \u0441 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u043C \u043B\u0438\u0446\u043E\u043C.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636325
    m_Localized: "\u0422\u0430\u0439\u043D\u0430\u044F \u0441\u0434\u0435\u043B\u043A\u0430
      \u043A\u043E\u043C\u043F\u0430\u043D\u044C\u043E\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636326
    m_Localized: "\u041D\u0430 \u0432\u0435\u0447\u0435\u0440\u043D\u0435\u0439 \u0441\u0442\u043E\u044F\u043D\u043A\u0435
      \u0443 \u0425\u0430\u043C\u0430\u0434\u0430\u043D\u0430 \u043A\u0443\u043F\u0435\u0446-\u043A\u043E\u043C\u043F\u0430\u043D\u044C\u043E\u043D
      \u0421\u0430\u043C\u0435\u0445 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
      \u043A \u0432\u0430\u043C \u0441 \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u043C
      \u0432\u0438\u0434\u043E\u043C. \u041E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
      \u043F\u043E\u043A\u0430 \u0432\u044B \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u043B\u0438\u0441\u044C
      \u0443 \u043A\u0443\u0437\u043D\u0435\u0446\u0430, \u043E\u043D \u043F\u0440\u043E\u0434\u0430\u043B
      \u043F\u044F\u0442\u044C \u043C\u0435\u0448\u043A\u043E\u0432 \u043F\u0435\u0440\u0446\u0430
      \u0438\u0437 \u043E\u0431\u0449\u0435\u0433\u043E \u0437\u0430\u043F\u0430\u0441\u0430
      \u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u043E\u043C\u0443 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0443
      - \u043F\u043E \u0446\u0435\u043D\u0435 \u0432\u0434\u0432\u043E\u0435 \u0432\u044B\u0448\u0435
      \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439. \u0414\u0435\u043D\u044C\u0433\u0438
      \u0443\u0436\u0435 \u0443 \u043D\u0435\u0433\u043E \u0432 \u043A\u043E\u0448\u0435\u043B\u044C\u043A\u0435.
      \u041E\u043D \u043D\u0435 \u0441\u043F\u0440\u043E\u0441\u0438\u043B \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043D\u0438\u044F.
      \"\u0421\u043B\u0443\u0447\u0430\u0439 \u0431\u044B\u043B \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0445\u043E\u0440\u043E\u0448\", - \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u043E\u043D, \u0443\u043B\u044B\u0431\u0430\u044F\u0441\u044C. \u0421\u0434\u0435\u043B\u043A\u0430
      \u0432\u044B\u0433\u043E\u0434\u043D\u0430\u044F, \u043D\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u0430
      \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636327
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438
      \u0438 \u043F\u043E\u0445\u0432\u0430\u043B\u0438\u0442\u044C \u0437\u0430
      \u043D\u044E\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636328
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043F\u044F\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0441\u0432\u0435\u0440\u0445
      \u043D\u043E\u0440\u043C\u044B - \u0445\u043E\u0440\u043E\u0448\u043E. \u0421\u0430\u043C\u0435\u0445
      \u0440\u0430\u0441\u0446\u0432\u0451\u043B \u0438 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0439
      \u0441\u0434\u0435\u043B\u043A\u043E\u0439 \u0432\u0434\u0432\u043E\u0435 \u0430\u043A\u0442\u0438\u0432\u043D\u0435\u0435.
      \u041F\u0440\u0430\u0432\u0438\u043B\u0430 \u043D\u0430\u0440\u0443\u0448\u0435\u043D\u044B,
      \u043D\u043E \u043F\u0440\u0438\u0431\u044B\u043B\u044C \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0441\u0430\u043C\u0430 \u0437\u0430 \u0441\u0435\u0431\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636329
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0434\u0435\u043D\u044C\u0433\u0438,
      \u043D\u043E \u043E\u0431\u044A\u044F\u0441\u043D\u0438\u0442\u044C \u043F\u0440\u0430\u0432\u0438\u043B\u0430
      \u043D\u0430 \u0431\u0443\u0434\u0443\u0449\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636330
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0438 \u043A\u0438\u0432\u043D\u0443\u043B.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u0432 \u043E\u0431\u0449\u0443\u044E
      \u043A\u0430\u0441\u0441\u0443. \u0411\u043E\u043B\u044C\u0448\u0435 \u0441\u0430\u043C\u043E\u0434\u0435\u044F\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u043D\u0435 \u0431\u044B\u043B\u043E. \u041A\u043E\u043C\u043F\u0440\u043E\u043C\u0438\u0441\u0441
      - \u0438 \u0434\u0435\u043D\u044C\u0433\u0438, \u0438 \u0434\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636331
    m_Localized: "\u041E\u0442\u0440\u0443\u0433\u0430\u0442\u044C \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u043E
      - \u043D\u0435\u043B\u044C\u0437\u044F \u043D\u0430\u0440\u0443\u0448\u0430\u0442\u044C
      \u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u043E\u0431\u043E\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636332
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u043F\u043E\u0431\u043B\u0435\u0434\u043D\u0435\u043B
      \u043E\u0442 \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u043E\u0433\u043E \u0440\u0430\u0437\u043D\u043E\u0441\u0430.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u0432\u0435\u0440\u043D\u0443\u043B.
      \u0414\u043D\u044F \u0442\u0440\u0438 \u043C\u043E\u043B\u0447\u0430\u043B.
      \u0414\u0438\u0441\u0446\u0438\u043F\u043B\u0438\u043D\u0430 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u0430,
      \u043D\u043E \u043D\u0438 \u043E\u0434\u043D\u043E\u0439 \u0438\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u043D\u043E\u0439
      \u0441\u0434\u0435\u043B\u043A\u0438 \u043E\u0442 \u043D\u0435\u0433\u043E
      \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0431\u044B\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636333
    m_Localized: "\u0414\u043E\u043B\u0433 \u043A\u0443\u043F\u0446\u0430-\u043A\u043E\u043C\u043F\u0430\u043D\u044C\u043E\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636334
    m_Localized: "\u0412 \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0435 \u0443
      \u0432\u043E\u0440\u043E\u0442 \u0440\u044B\u043D\u043A\u0430 \u043F\u0435\u0440\u0435\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0434\u043E\u0440\u043E\u0433\u0443 \u043A\u0440\u0435\u043F\u043A\u0438\u0439
      \u043C\u0443\u0436\u0447\u0438\u043D\u0430 \u0441 \u0434\u0432\u0443\u043C\u044F
      \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u0430\u043C\u0438. \u041E\u043D
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043F\u043E-\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438,
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0421\u0430\u043C\u0435\u0445\u0430:
      \"\u0413\u043E\u0434 \u043F\u0440\u043E\u0448\u0451\u043B. \u0421\u043E\u0440\u043E\u043A
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u043F\u043B\u044E\u0441 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u044B
      - \u043F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u043F\u044F\u0442\u044C.
      \u042F \u043F\u043E\u0434\u043E\u0436\u0434\u0430\u043B \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E\".
      \u0421\u0430\u043C\u0435\u0445 \u043A\u0440\u0430\u0441\u043D\u0435\u0435\u0442
      \u0438 \u0448\u0435\u043F\u0447\u0435\u0442 \u0432\u0430\u043C: \"\u042F \u0432\u0437\u044F\u043B
      \u0432 \u0434\u043E\u043B\u0433 \u0434\u043E \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430,
      \u0442\u043E\u0433\u0434\u0430 \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C...
      \u042F \u043E\u0442\u0434\u0430\u043C, \u0442\u043E\u043B\u044C\u043A\u043E
      \u0434\u0430\u0439\u0442\u0435 \u043F\u0430\u0440\u0443 \u0434\u043D\u0435\u0439\".
      \u0420\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A \u043D\u0435 \u043D\u0430\u043C\u0435\u0440\u0435\u043D
      \u0436\u0434\u0430\u0442\u044C. \u0415\u0433\u043E \u043F\u043E\u043C\u043E\u0449\u043D\u0438\u043A\u0438
      \u044F\u0432\u043D\u043E \u0433\u043E\u0442\u043E\u0432\u044B \u0441\u043E\u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C
      \u0421\u0430\u043C\u0435\u0445\u0430 \u043A\u0443\u0434\u0430 \u0441\u043B\u0435\u0434\u0443\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636335
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0434\u043E\u043B\u0433
      \u0438\u0437 \u043A\u0430\u0437\u043D\u044B - \u043F\u043E\u0442\u043E\u043C
      \u0432\u044B\u0447\u0435\u0441\u0442\u044C \u0438\u0437 \u0434\u043E\u043B\u0438
      \u0421\u0430\u043C\u0435\u0445\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636336
    m_Localized: "\u041F\u044F\u0442\u044C\u0434\u0435\u0441\u044F\u0442 \u043F\u044F\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0440\u0435\u0448\u0438\u043B\u0438
      \u0432\u043E\u043F\u0440\u043E\u0441. \u0420\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A
      \u0443\u0448\u0451\u043B, \u0421\u0430\u043C\u0435\u0445 \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B.
      \u041E\u043D \u043E\u0431\u0435\u0449\u0430\u043B \u0432\u043E\u0437\u043C\u0435\u0441\u0442\u0438\u0442\u044C
      - \u0438 \u0441\u0434\u0435\u0440\u0436\u0430\u043B \u0441\u043B\u043E\u0432\u043E
      \u0437\u0430 \u0442\u0440\u0438 \u043D\u0435\u0434\u0435\u043B\u0438, \u0440\u0430\u0431\u043E\u0442\u0430\u044F
      \u0431\u0435\u0437 \u043E\u0442\u0434\u044B\u0445\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636337
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u043F\u0443\u0441\u0442\u044C
      \u0441\u0430\u043C \u0440\u0435\u0448\u0430\u0435\u0442 \u0441\u0432\u043E\u0438
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636338
    m_Localized: "\u0421\u0430\u043C\u0435\u0445\u0430 \u0443\u0432\u0435\u043B\u0438
      \u043D\u0430 \u0447\u0430\u0441. \u0412\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u043F\u043E\u0442\u0440\u0451\u043F\u0430\u043D\u043D\u044B\u0439 - \u0432\u0438\u0434\u043D\u043E,
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440 \u0432\u044B\u0448\u0435\u043B
      \u0436\u0451\u0441\u0442\u043A\u0438\u043C. \u0414\u0435\u043D\u0435\u0433
      \u0433\u0434\u0435-\u0442\u043E \u043D\u0430\u0448\u0451\u043B, \u043D\u0435
      \u0441\u043F\u0440\u043E\u0441\u0438\u0432. \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439 \u0437\u043B\u0438\u043B\u0441\u044F \u043D\u0430
      \u0432\u0435\u0441\u044C \u043C\u0438\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636339
    m_Localized: "\u0414\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F
      \u0441 \u0440\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A\u043E\u043C -
      \u043E\u0442\u0441\u0440\u043E\u0447\u043A\u0430 \u0432 \u043E\u0431\u043C\u0435\u043D
      \u043D\u0430 \u043D\u0430\u0448\u0443 \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636340
    m_Localized: "\u0421\u043B\u043E\u0432\u043E \u0447\u0435\u0441\u0442\u043D\u043E\u0433\u043E
      \u043A\u0443\u043F\u0446\u0430 \u0441 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438
      \u0443\u0431\u0435\u0434\u0438\u043B\u043E \u0440\u043E\u0441\u0442\u043E\u0432\u0449\u0438\u043A\u0430.
      \u0414\u0432\u0443\u0445\u043D\u0435\u0434\u0435\u043B\u044C\u043D\u0430\u044F
      \u043E\u0442\u0441\u0440\u043E\u0447\u043A\u0430. \u0421\u0430\u043C\u0435\u0445
      \u0443\u0441\u043F\u0435\u043B \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
      \u0434\u043E\u043B\u0433 \u043D\u0430 \u0440\u044B\u043D\u043A\u0435 \u041D\u0438\u0448\u0430\u043F\u0443\u0440\u0430.
      \u041E\u0431\u043E\u0448\u043B\u043E\u0441\u044C \u0434\u0438\u043F\u043B\u043E\u043C\u0430\u0442\u0438\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636341
    m_Localized: "\u0421\u0435\u043A\u0440\u0435\u0442\u043D\u044B\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u043A\u0443\u043F\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636342
    m_Localized: "\u041D\u0430 \u043D\u043E\u0447\u043D\u043E\u0439 \u0441\u0442\u043E\u044F\u043D\u043A\u0435
      \u043A\u0443\u043F\u0435\u0446-\u043A\u043E\u043C\u043F\u0430\u043D\u044C\u043E\u043D
      \u0421\u0430\u043C\u0435\u0445 \u0441\u0438\u0434\u0438\u0442 \u0443 \u043E\u0433\u043D\u044F
      \u0438 \u0447\u0435\u0440\u0442\u0438\u0442 \u0447\u0442\u043E-\u0442\u043E
      \u043D\u0430 \u043F\u0435\u0441\u043A\u0435. \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0441 \u0445\u0438\u0442\u0440\u043E: \"\u042F \u0437\u043D\u0430\u044E
      \u0442\u0440\u043E\u043F\u0443 \u0447\u0435\u0440\u0435\u0437 \u044E\u0436\u043D\u044B\u0439
      \u043E\u0442\u0440\u043E\u0433. \u041E\u043D\u0430 \u043D\u0430 \u0442\u0440\u0438
      \u0434\u043D\u044F \u043A\u043E\u0440\u043E\u0447\u0435 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0433\u043E
      \u043F\u0443\u0442\u0438 \u0438 \u043E\u0431\u0445\u043E\u0434\u0438\u0442
      \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u044B\u0439 \u043F\u043E\u0441\u0442
      \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u0430. \u041C\u043E\u044F
      \u0441\u0435\u043C\u044C\u044F \u0445\u043E\u0434\u0438\u043B\u0430 \u0435\u044E
      \u0441\u043E\u0440\u043E\u043A \u043B\u0435\u0442. \u041F\u0440\u043E\u0434\u0430\u043C
      \u0437\u043D\u0430\u043D\u0438\u0435 \u0437\u0430 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0438 \u0434\u0435\u0441\u044F\u0442\u044C
      \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432 \u043E\u0442 \u0432\u044B\u0433\u043E\u0434\u044B
      \u0441 \u044D\u0442\u043E\u0433\u043E \u043F\u0440\u043E\u0445\u043E\u0434\u0430\".
      \u0422\u0440\u0438 \u0434\u043D\u044F - \u0431\u043E\u043B\u044C\u0448\u0430\u044F
      \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u044F. \u041D\u043E \u0443\u0441\u043B\u043E\u0432\u0438\u044F
      \u0443 \u043D\u0435\u0433\u043E \u043A\u043E\u043D\u043A\u0440\u0435\u0442\u043D\u044B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636343
    m_Localized: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0435\u0433\u043E \u0443\u0441\u043B\u043E\u0432\u0438\u044F
      - \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0441\u0442\u043E\u0438\u0442
      \u0442\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636344
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0439. \u0422\u0440\u0438
      \u0434\u043D\u044F \u0432\u044B\u0438\u0433\u0440\u0430\u043D\u043E, \u0442\u0430\u043C\u043E\u0436\u043D\u044F
      \u043E\u0431\u043E\u0439\u0434\u0435\u043D\u0430. \u0421\u0430\u043C\u0435\u0445
      \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0441\u0432\u043E\u0451 \u0438
      \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B\u043C.
      \u0412\u044B\u0433\u043E\u0434\u043D\u0430\u044F \u0441\u0434\u0435\u043B\u043A\u0430,
      \u0445\u043E\u0442\u044F \u0438 \u0434\u043E\u0440\u043E\u0433\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636345
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      - \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0431\u0435\u0437 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636346
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u043F\u043E\u0442\u043E\u0440\u0433\u043E\u0432\u0430\u043B\u0441\u044F
      \u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0441\u044F \u043D\u0430
      \u0441\u0435\u043C\u043D\u0430\u0434\u0446\u0430\u0442\u044C. \u0422\u0440\u043E\u043F\u0430
      \u0442\u0430 \u0436\u0435, \u0432\u044B\u0433\u043E\u0434\u0430 \u0442\u0430
      \u0436\u0435, \u043D\u043E \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F
      \u043D\u0435\u043C\u043D\u043E\u0433\u043E \u0445\u043E\u043B\u043E\u0434\u043D\u0435\u0435
      - \u043E\u043D \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442, \u0447\u0442\u043E
      \u0435\u0433\u043E \u0443\u043C\u0435\u0440\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636347
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u043D\u0435\u0442
      \u0434\u043E\u0432\u0435\u0440\u0438\u044F \u0442\u0430\u0439\u043D\u044B\u043C
      \u0442\u0440\u043E\u043F\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636348
    m_Localized: "\u0421\u0430\u043C\u0435\u0445 \u043F\u043E\u0436\u0430\u043B \u043F\u043B\u0435\u0447\u0430\u043C\u0438.
      \u041F\u043E\u0448\u043B\u0438 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u043C
      \u043F\u0443\u0442\u0451\u043C. \u0422\u0440\u0438 \u0434\u043D\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E,
      \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u044B\u0439 \u0441\u0431\u043E\u0440
      \u0443\u043F\u043B\u0430\u0447\u0435\u043D. \u0421\u0430\u043C\u0435\u0445
      \u043D\u0435 \u0437\u043B\u0438\u0442\u0441\u044F - \u043F\u0440\u043E\u0441\u0442\u043E
      \u043F\u0440\u0438\u0434\u0435\u0440\u0436\u0430\u043B \u0437\u043D\u0430\u043D\u0438\u0435
      \u043F\u0440\u0438 \u0441\u0435\u0431\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636349
    m_Localized: "\u041D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439 \u0434\u0438\u0430\u043B\u0435\u043A\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636350
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u0425\u043E\u0442\u0430\u043D\u0430
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u041C\u0430\u043D\u0430\u0445
      \u0441\u0442\u043E\u043B\u043A\u043D\u0443\u043B\u0441\u044F \u0441 \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u043E\u0439:
      \u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u043D\u0430 \u0441\u0430\u043A\u0441\u043A\u043E\u043C
      \u0434\u0438\u0430\u043B\u0435\u043A\u0442\u0435, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u041C\u0430\u043D\u0430\u0445 \u0437\u043D\u0430\u0435\u0442 \u043F\u043B\u043E\u0445\u043E
      - \u043F\u0443\u0442\u0430\u0435\u0442 \u043F\u0430\u0434\u0435\u0436\u0438,
      \u0434\u0435\u043B\u0430\u0435\u0442 \u043F\u0430\u0443\u0437\u044B, \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0441 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u0435\u043D\u0438\u0435\u043C.
      \u0412\u043E\u043A\u0440\u0443\u0433 \u0443\u0436\u0435 \u0441\u0442\u043E\u044F\u0442
      \u043B\u044E\u0434\u0438 \u0438 \u043D\u0430\u0431\u043B\u044E\u0434\u0430\u044E\u0442.
      \u041C\u0430\u043D\u0430\u0445 \u043A\u0440\u0430\u0441\u043D\u0435\u0435\u0442.
      \u0421\u0434\u0435\u043B\u043A\u0430 \u0441 \u0445\u043E\u0440\u043E\u0448\u0438\u043C
      \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0435\u043C \u043F\u043E\u0434
      \u0443\u0433\u0440\u043E\u0437\u043E\u0439. \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u043B\u0438\u0446\u043E \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u043E,
      \u0447\u0442\u043E \u0432 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C
      \u043C\u0438\u0440\u0435 \u0425\u043E\u0442\u0430\u043D\u0430 - \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u044B\u0439
      \u0443\u0434\u0430\u0440 \u043F\u043E \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636351
    m_Localized: "\u0412\u043C\u0435\u0448\u0430\u0442\u044C\u0441\u044F \u0438 \u0436\u0435\u0441\u0442\u0430\u043C\u0438
      \u0434\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C\u0441\u044F -
      \u043F\u043E\u043C\u043E\u0447\u044C \u041C\u0430\u043D\u0430\u0445\u0443 \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C
      \u043B\u0438\u0446\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636352
    m_Localized: "\u0412\u044B \u0432\u043C\u0435\u0448\u0430\u043B\u0438\u0441\u044C,
      \u0434\u043E\u0431\u0430\u0432\u0438\u0432 \u0437\u043D\u0430\u043A\u0438 \u0438
      \u0440\u0438\u0441\u0443\u043D\u043A\u0438. \u0421\u0434\u0435\u043B\u043A\u0430
      \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u0430\u0441\u044C, \u0445\u043E\u0442\u044C
      \u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E. \u041C\u0430\u043D\u0430\u0445
      \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B\u0430
      - \u043C\u0435\u0441\u0442\u043D\u044B\u0435 \u0432\u043E\u0441\u043F\u0440\u0438\u043D\u044F\u043B\u0438
      \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044E \u0441 \u044E\u043C\u043E\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636353
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u043C\u0435\u0441\u0442\u043D\u043E\u043C\u0443
      \u0442\u043E\u043B\u043C\u0430\u0447\u0443 \u0437\u0430 \u043F\u043E\u043C\u043E\u0449\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636354
    m_Localized: "\u0414\u0435\u0441\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u043C\u0435\u0441\u0442\u043D\u043E\u043C\u0443 \u043F\u0430\u0440\u043D\u044E
      \u0440\u0435\u0448\u0438\u043B\u0438 \u0432\u043E\u043F\u0440\u043E\u0441 \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E.
      \u0421\u0434\u0435\u043B\u043A\u0430 \u043F\u0440\u043E\u0448\u043B\u0430 \u0433\u043B\u0430\u0434\u043A\u043E.
      \u041C\u0430\u043D\u0430\u0445 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442
      \u0441\u0435\u0431\u044F \u043D\u0435\u043B\u043E\u0432\u043A\u043E, \u043D\u043E
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0435\u043D. \u0422\u043E\u043B\u043C\u0430\u0447
      \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0445\u043E\u0440\u043E\u0448\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636355
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u0441\u0434\u0435\u043B\u043A\u0443
      - \u0443\u0439\u0442\u0438 \u0431\u0435\u0437 \u043F\u043E\u043A\u0443\u043F\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636356
    m_Localized: "\u0423\u0448\u043B\u0438 \u0431\u0435\u0437 \u0441\u0434\u0435\u043B\u043A\u0438.
      \u041C\u0430\u043D\u0430\u0445 \u043F\u043B\u0451\u043B\u0441\u044F \u0441\u043B\u0435\u0434\u043E\u043C,
      \u043C\u043E\u043B\u0447\u0430\u043B. \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u0432\u0434\u0432\u043E\u0435
      \u0443\u0441\u0435\u0440\u0434\u043D\u0435\u0435, \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E
      \u043E\u0442\u043A\u0443\u043F\u0430\u043B\u0441\u044F. \u0423\u043F\u0443\u0449\u0435\u043D\u043D\u0430\u044F
      \u0432\u044B\u0433\u043E\u0434\u0430 \u043E\u0449\u0443\u0449\u0430\u043B\u0430\u0441\u044C
      \u0432 \u043A\u0430\u0437\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636357
    m_Localized: "\u041F\u043E\u0434\u0441\u043B\u0443\u0448\u0430\u043D\u043D\u044B\u0439
      \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636358
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u041C\u0430\u043D\u0430\u0445
      \u043F\u0440\u0438\u0445\u043E\u0434\u0438\u0442 \u043A \u0432\u0430\u043C
      \u043D\u043E\u0447\u044C\u044E \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0431\u044B\u0441\u0442\u0440\u043E: \u043E\u043D \u0441\u0442\u043E\u044F\u043B
      \u0443 \u0441\u0442\u0435\u043D\u044B \u043D\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u043C
      \u0434\u0432\u043E\u0440\u0435 \u0432 \u041C\u0435\u0440\u0432\u0435 \u0438
      \u043F\u043E\u043D\u044F\u043B \u0440\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u0434\u0432\u0443\u0445 \u043F\u0435\u0440\u0441\u043E\u0432 \u043D\u0430
      \u0444\u0430\u0440\u0441\u0438. \u041A\u0443\u043F\u0435\u0446 \u042E\u0441\u0443\u0444
      \u0438\u0437 \u0420\u0435\u044F \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0435\u0442
      \u043F\u043E\u0434\u043A\u0443\u043F\u0438\u0442\u044C \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0438\u043A\u0430
      \u043D\u0430 \u0432\u044B\u0445\u043E\u0434\u0435 \u0438\u0437 \u0433\u043E\u0440\u043E\u0434\u0430,
      \u0447\u0442\u043E\u0431\u044B \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u0442\u044C
      \u043D\u0430\u0448 \u043E\u0431\u043E\u0437 \u043D\u0430 \u043D\u0435\u0434\u0435\u043B\u044E.
      \u041C\u0430\u043D\u0430\u0445 \u044D\u0442\u043E \u0441\u043B\u044B\u0448\u0430\u043B
      \u0442\u043E\u0447\u043D\u043E. \u0412\u043E\u043F\u0440\u043E\u0441 \u0432
      \u0442\u043E\u043C, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C:
      \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0434\u0438\u0442\u044C \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u0430,
      \u043E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F \u043E\u0442 \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0438\u043A\u0430
      \u043F\u0435\u0440\u0432\u044B\u043C\u0438 - \u0438\u043B\u0438 \u043C\u043E\u043B\u0447\u0430\u0442\u044C
      \u0438 \u0441\u043C\u0435\u043D\u0438\u0442\u044C \u043C\u0430\u0440\u0448\u0440\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636359
    m_Localized: "\u0414\u043E\u043D\u0435\u0441\u0442\u0438 \u043D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A\u0443
      - \u043F\u0443\u0441\u0442\u044C \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u0442\u0441\u044F
      \u0441 \u042E\u0441\u0443\u0444\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636360
    m_Localized: "\u041D\u0430\u043C\u0435\u0441\u0442\u043D\u0438\u043A \u043E\u0442\u0440\u0435\u0430\u0433\u0438\u0440\u043E\u0432\u0430\u043B.
      \u042E\u0441\u0443\u0444 \u0437\u0430\u0434\u0435\u0440\u0436\u0430\u043D \u0434\u043B\u044F
      \u043F\u0440\u043E\u0432\u0435\u0440\u043A\u0438 \u043D\u0430 \u0434\u0432\u043E\u0435
      \u0441\u0443\u0442\u043E\u043A. \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B
      \u0431\u0435\u0441\u043F\u0440\u0435\u043F\u044F\u0442\u0441\u0442\u0432\u0435\u043D\u043D\u043E.
      \u041C\u0430\u043D\u0430\u0445 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B
      \u043D\u0435\u0440\u0432\u043D\u044B\u043C, \u043D\u043E \u0432\u0441\u0451
      \u043E\u0431\u043E\u0448\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636361
    m_Localized: "\u041E\u043F\u0435\u0440\u0435\u0434\u0438\u0442\u044C \u042E\u0441\u0443\u0444\u0430
      - \u0441\u0430\u043C\u0438\u043C \u043F\u043E\u0434\u043A\u0443\u043F\u0438\u0442\u044C
      \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636362
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0438\u043A\u0443. \u041E\u043D
      \u043F\u0440\u0438\u043D\u044F\u043B \u043C\u043E\u043B\u0447\u0430 \u0438
      \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u043B \u0431\u0435\u0437 \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u0430.
      \u042E\u0441\u0443\u0444 \u043F\u0440\u0438\u0448\u0451\u043B \u0441\u043E
      \u0441\u0432\u043E\u0438\u043C \u0441\u0435\u0440\u0435\u0431\u0440\u043E\u043C
      \u043F\u043E\u0437\u0436\u0435 - \u0438 \u043D\u0435 \u043D\u0430\u0448\u0451\u043B
      \u043D\u0443\u0436\u043D\u043E\u0433\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430.
      \u041E\u0431\u043E\u0437 \u0443\u0436\u0435 \u0443\u0435\u0445\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636363
    m_Localized: "\u0421\u043C\u0435\u043D\u0438\u0442\u044C \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      - \u0443\u0439\u0442\u0438 \u0447\u0435\u0440\u0435\u0437 \u0437\u0430\u043F\u0430\u0434\u043D\u044B\u0435
      \u0432\u043E\u0440\u043E\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636364
    m_Localized: "\u0417\u0430\u043F\u0430\u0434\u043D\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430
      - \u043A\u0440\u044E\u043A \u0432 \u043F\u043E\u043B\u0434\u043D\u044F, \u043D\u043E
      \u0442\u0430\u043C \u0434\u0440\u0443\u0433\u043E\u0439 \u0442\u0430\u043C\u043E\u0436\u0435\u043D\u043D\u0438\u043A.
      \u041F\u0440\u043E\u0448\u043B\u0438 \u0431\u0435\u0437 \u0437\u0430\u0434\u0435\u0440\u0436\u043A\u0438.
      \u042E\u0441\u0443\u0444 \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0441
      \u043E\u0431\u0435\u0441\u0446\u0435\u043D\u0435\u043D\u043D\u044B\u043C \u0432\u0437\u044F\u0442\u043A\u043E\u043C.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u043F\u043E\u043B-\u0434\u043D\u044F,
      \u0432\u044B\u0438\u0433\u0440\u0430\u043B\u0438 \u043D\u0435\u0434\u0435\u043B\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636365
    m_Localized: "\u0420\u043E\u0434\u043D\u043E\u0439 \u0433\u043E\u0440\u043E\u0434
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636366
    m_Localized: "\u041E\u0431\u043E\u0437 \u0432\u044A\u0435\u0437\u0436\u0430\u0435\u0442
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434 \u0447\u0435\u0440\u0435\u0437
      \u0432\u043E\u0441\u0442\u043E\u0447\u043D\u044B\u0435 \u0432\u043E\u0440\u043E\u0442\u0430.
      \u041F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u041C\u0430\u043D\u0430\u0445
      \u043C\u043E\u043B\u0447\u0438\u0442 \u0432\u0441\u044E \u0434\u043E\u0440\u043E\u0433\u0443,
      \u043D\u043E \u0443 \u0432\u043E\u0440\u043E\u0442 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E
      \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0443\u043B\u0438\u0446\u0443
      \u0434\u043E\u043B\u0433\u043E - \u0434\u043E \u0432\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u0438
      \u0432 \u0433\u043B\u0430\u0437\u0430\u0445. \u041F\u043E\u0442\u043E\u043C
      \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F:
      \"\u042F \u0432\u044B\u0440\u043E\u0441 \u0432 \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0435
      \u0433\u043E\u0440\u0448\u0435\u0447\u043D\u0438\u043A\u043E\u0432, \u0432\u043E\u0442
      \u0437\u0430 \u044D\u0442\u043E\u0439 \u0441\u0442\u0435\u043D\u043E\u0439.
      \u042F \u043D\u0435 \u0431\u044B\u043B \u0437\u0434\u0435\u0441\u044C \u0434\u0435\u0432\u044F\u0442\u044C
      \u043B\u0435\u0442. \u0414\u0430\u0439\u0442\u0435 \u043C\u043D\u0435 \u0434\u0432\u0430
      \u0434\u043D\u044F. \u042F \u043D\u0435 \u043F\u0440\u043E\u0448\u0443 \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u044F
      \u0437\u0430 \u044D\u0442\u0438 \u0434\u043D\u0438 - \u043F\u0440\u043E\u0441\u0442\u043E
      \u0434\u0432\u0430 \u0434\u043D\u044F\". \u0415\u0433\u043E \u043C\u0430\u0442\u044C
      \u0436\u0438\u0432\u0430. \u041E\u043D \u0445\u043E\u0447\u0435\u0442 \u0443\u0432\u0438\u0434\u0435\u0442\u044C
      \u0435\u0451."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636367
    m_Localized: "\u0414\u0430\u0442\u044C \u0434\u0432\u0430 \u0434\u043D\u044F
      - \u043F\u0443\u0441\u0442\u044C \u043F\u043E\u0431\u0443\u0434\u0435\u0442
      \u0441 \u0441\u0435\u043C\u044C\u0451\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636368
    m_Localized: "\u041C\u0430\u043D\u0430\u0445 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u0434\u043D\u044F \u0441
      \u043F\u043E\u043A\u0440\u0430\u0441\u043D\u0435\u0432\u0448\u0438\u043C\u0438
      \u0433\u043B\u0430\u0437\u0430\u043C\u0438 \u0438 \u043B\u0435\u043F\u0451\u0448\u043A\u0430\u043C\u0438
      \u043E\u0442 \u043C\u0430\u0442\u0435\u0440\u0438. \u0420\u0430\u0431\u043E\u0442\u0430\u043B
      \u043F\u043E\u0442\u043E\u043C \u0442\u0430\u043A, \u0431\u0443\u0434\u0442\u043E
      \u0434\u043E\u043B\u0433 \u043E\u0442\u0434\u0430\u0432\u0430\u043B. \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434
      \u0441\u0442\u0430\u043B \u0434\u043B\u044F \u043D\u0435\u0433\u043E \u0441\u043D\u043E\u0432\u0430
      \u0441\u0432\u043E\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636369
    m_Localized: "\u0414\u0430\u0442\u044C \u043E\u0434\u0438\u043D \u0434\u0435\u043D\u044C
      - \u0437\u0430\u0432\u0442\u0440\u0430 \u0432\u044B\u0435\u0437\u0436\u0430\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636370
    m_Localized: "\u041C\u0430\u043D\u0430\u0445 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0441 \u043F\u0435\u0440\u0432\u044B\u043C\u0438 \u043F\u0435\u0442\u0443\u0445\u0430\u043C\u0438,
      \u043D\u0435 \u0432\u044B\u0441\u043F\u0430\u0432\u0448\u0438\u0439\u0441\u044F.
      \u041C\u0430\u0442\u044C \u043E\u043D \u0443\u0432\u0438\u0434\u0435\u043B.
      \u042D\u0442\u043E\u0433\u043E \u0435\u043C\u0443 \u0445\u0432\u0430\u0442\u0438\u043B\u043E.
      \u041E\u0434\u0438\u043D \u0434\u0435\u043D\u044C \u043F\u043E\u0442\u0435\u0440\u044F\u043D,
      \u043F\u0435\u0440\u0435\u0432\u043E\u0434\u0447\u0438\u043A \u0434\u043E\u0432\u043E\u043B\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636371
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0435
      \u0434\u0435\u043B\u0430 \u043D\u0435 \u0436\u0434\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636372
    m_Localized: "\u041C\u0430\u043D\u0430\u0445 \u043A\u0438\u0432\u043D\u0443\u043B
      \u0438 \u043F\u043E\u0448\u0451\u043B \u0434\u0430\u043B\u044C\u0448\u0435.
      \u0412\u0441\u0451 \u0432\u0440\u0435\u043C\u044F \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043A\u0432\u0430\u0440\u0442\u0430\u043B\u0430 \u0433\u043E\u0440\u0448\u0435\u0447\u043D\u0438\u043A\u043E\u0432.
      \u0420\u0430\u0431\u043E\u0442\u0430\u043B \u0438\u0441\u043F\u0440\u0430\u0432\u043D\u043E.
      \u041D\u043E \u0447\u0442\u043E-\u0442\u043E \u0432 \u043D\u0451\u043C \u0437\u0430\u043A\u0440\u044B\u043B\u043E\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636373
    m_Localized: "\u041F\u0440\u043E\u0438\u0433\u0440\u044B\u0448 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636374
    m_Localized: "\u041D\u0430 \u043F\u043E\u0441\u0442\u043E\u044F\u043B\u043E\u043C
      \u0434\u0432\u043E\u0440\u0435 \u0432 \u041E\u0448\u0435 \u043A \u0432\u0430\u043C
      \u043F\u043E\u0434\u0445\u043E\u0434\u044F\u0442 \u0434\u0432\u043E\u0435 \u043C\u0435\u0441\u0442\u043D\u044B\u0445
      \u0441 \u0432\u0438\u0434\u043E\u043C \u0445\u043E\u0437\u044F\u0435\u0432
      - \u0448\u0438\u0440\u043E\u043A\u0438\u0435 \u043F\u043B\u0435\u0447\u0438,
      \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0435 \u0441\u0430\u0431\u043B\u0438
      \u0443 \u043F\u043E\u044F\u0441\u0430. \u041E\u043D\u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0442
      \u043F\u043E-\u0442\u044E\u0440\u043A\u0441\u043A\u0438, \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0411\u0443\u0433\u0430 \u0441\u043B\u0443\u0448\u0430\u0435\u0442 \u0441
      \u043E\u043F\u0443\u0449\u0435\u043D\u043D\u043E\u0439 \u0433\u043E\u043B\u043E\u0432\u043E\u0439.
      \u041E\u043D\u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u044E\u0442:
      \u0411\u0443\u0433\u0430 \u043F\u0440\u043E\u0438\u0433\u0440\u0430\u043B \u0438\u043C
      \u043F\u0440\u043E\u0448\u043B\u043E\u0439 \u043D\u043E\u0447\u044C\u044E \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0432 \u043A\u043E\u0441\u0442\u0438
      \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B \u0432 \u0437\u0430\u043B\u043E\u0433
      \"\u0441\u043B\u043E\u0432\u043E \u043A\u0443\u043F\u0446\u0430 \u043F\u0440\u0438
      \u043A\u043E\u0442\u043E\u0440\u043E\u043C \u0441\u043B\u0443\u0436\u0438\u0442\".
      \u041F\u043E \u0442\u044E\u0440\u043A\u0441\u043A\u043E\u043C\u0443 \u043E\u0431\u044B\u0447\u0430\u044E
      \u044D\u0442\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442, \u0447\u0442\u043E
      \u0432\u044B \u043F\u043E\u0440\u0443\u0447\u0438\u0442\u0435\u043B\u044C.
      \u0411\u0443\u0433\u0430 \u043D\u0435 \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0432\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636375
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0434\u043E\u043B\u0433
      - \u0438 \u0436\u0451\u0441\u0442\u043A\u043E \u043F\u043E\u0433\u043E\u0432\u043E\u0440\u0438\u0442\u044C
      \u0441 \u0411\u0443\u0433\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636376
    m_Localized: "\u0414\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0443\u043F\u043B\u0430\u0447\u0435\u043D\u044B. \u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440
      \u0441 \u0411\u0443\u0433\u043E\u0439 \u0432\u044B\u0448\u0435\u043B \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C
      \u0438 \u044F\u0441\u043D\u044B\u043C. \u041E\u043D \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B,
      \u043A\u0438\u0432\u043D\u0443\u043B, \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B
      \u043F\u0440\u043E\u0449\u0435\u043D\u0438\u044F. \u0411\u043E\u043B\u044C\u0448\u0435
      \u043A\u0443\u0431\u0438\u043A\u0438 \u043D\u0435 \u0432\u0438\u0434\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636377
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u044D\u0442\u043E
      \u043B\u0438\u0447\u043D\u044B\u0439 \u0434\u043E\u043B\u0433 \u0411\u0443\u0433\u0438,
      \u043F\u0443\u0441\u0442\u044C \u0441\u0430\u043C \u043F\u043B\u0430\u0442\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636378
    m_Localized: "\u0414\u0432\u043E\u0435 \u0441\u0442\u0430\u043B\u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u0443\u0433\u0440\u043E\u0436\u0430\u044E\u0449\u0435. \u0411\u0443\u0433\u0430
      \u043D\u0430\u0448\u0451\u043B \u0434\u0435\u043D\u044C\u0433\u0438 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E
      \u043A\u0430\u043A - \u043D\u0430\u0432\u0435\u0440\u043D\u043E\u0435, \u0437\u0430\u043D\u044F\u043B
      \u0443 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432. \u041E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044F
      \u0432 \u043E\u0431\u043E\u0437\u0435 \u0441\u0442\u0430\u043B\u0438 \u043D\u0430\u043F\u0440\u044F\u0436\u0451\u043D\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636379
    m_Localized: "\u0414\u0430\u0442\u044C \u0411\u0443\u0433\u0435 \u0432 \u0434\u043E\u043B\u0433
      \u0438\u0437 \u043A\u0430\u0437\u043D\u044B - \u043F\u0443\u0441\u0442\u044C
      \u0441\u0430\u043C \u043E\u0442\u0434\u0430\u0441\u0442 \u043F\u043E\u0442\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636380
    m_Localized: "\u0411\u0443\u0433\u0430 \u0432\u0437\u044F\u043B \u0432 \u0434\u043E\u043B\u0433
      \u0438 \u0440\u0430\u0441\u043F\u043B\u0430\u0442\u0438\u043B\u0441\u044F.
      \u0414\u0435\u043D\u044C\u0433\u0438 \u0432\u0435\u0440\u043D\u0443\u043B \u0437\u0430
      \u0442\u0440\u0438 \u043D\u0435\u0434\u0435\u043B\u0438 \u043F\u043E \u0447\u0430\u0441\u0442\u044F\u043C.
      \u0427\u0435\u0441\u0442\u043D\u044B\u0439 \u0447\u0435\u043B\u043E\u0432\u0435\u043A,
      \u043D\u043E \u043D\u0435\u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u044B\u0439
      \u0441 \u043A\u043E\u0441\u0442\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636381
    m_Localized: "\u041E\u043F\u0430\u0441\u043D\u044B\u0439 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u0439
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636382
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u0411\u0443\u0433\u0430
      \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u043D\u0430 \u0433\u043E\u0440\u043D\u044B\u0439
      \u0441\u043A\u043B\u043E\u043D: \"\u0415\u0441\u043B\u0438 \u043F\u043E\u0439\u0434\u0451\u043C
      \u0447\u0435\u0440\u0435\u0437 \u043F\u0435\u0440\u0435\u0432\u0430\u043B \u0410\u043A-\u0421\u0443\u0443,
      \u043C\u044B \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043C \u0434\u0435\u043D\u044C.
      \u0422\u0440\u043E\u043F\u0430 \u043A\u0440\u0443\u0442\u0430\u044F - \u043E\u0434\u0438\u043D
      \u043E\u0441\u044B\u043F\u043D\u043E\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A
      \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E \u0441\u0442\u043E \u0448\u0430\u0433\u043E\u0432.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u043F\u0440\u043E\u0439\u0434\u0443\u0442,
      \u0435\u0441\u043B\u0438 \u0432\u0435\u0441\u0442\u0438 \u043F\u043E\u0434
      \u0443\u0437\u0434\u0446\u044B. \u042F \u0445\u043E\u0434\u0438\u043B \u0437\u0434\u0435\u0441\u044C
      \u0434\u0432\u0430\u0436\u0434\u044B\". \u041E\u043D \u043D\u0435 \u0433\u043E\u0432\u043E\u0440\u0438\u0442,
      \u0447\u0442\u043E \u043F\u0440\u043E\u0448\u043B\u044B\u0439 \u0440\u0430\u0437
      \u0431\u044B\u043B \u0431\u0435\u0437 \u0433\u0440\u0443\u0437\u0430 \u0438
      \u0432 \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u043F\u043E\u0433\u043E\u0434\u0443.
      \u041D\u0435\u0431\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0441
      \u0443\u0442\u0440\u0430 \u0437\u0430\u0442\u044F\u043D\u0443\u043B\u043E.
      \u0414\u0435\u043D\u044C - \u044D\u0442\u043E \u043C\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636383
    m_Localized: "\u0421\u043E\u0433\u043B\u0430\u0441\u0438\u0442\u044C\u0441\u044F
      - \u0440\u0438\u0441\u043A\u043D\u0443\u0442\u044C \u0440\u0430\u0434\u0438
      \u0434\u043D\u044F \u043F\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636384
    m_Localized: "\u041E\u0441\u044B\u043F\u043D\u043E\u0439 \u0443\u0447\u0430\u0441\u0442\u043E\u043A
      \u0434\u0430\u043B\u0441\u044F \u0442\u044F\u0436\u0435\u043B\u043E. \u041E\u0434\u0438\u043D
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434 \u043F\u043E\u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B\u0441\u044F,
      \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0442\u044E\u043A \u0432 \u0443\u0449\u0435\u043B\u044C\u0435.
      \u041D\u043E \u0432\u0441\u0435 \u043F\u0440\u043E\u0448\u043B\u0438. \u0414\u0435\u043D\u044C
      \u0432\u044B\u0438\u0433\u0440\u0430\u043B\u0438. \u0411\u0443\u0433\u0430
      \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636385
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C - \u0438\u0434\u0451\u043C
      \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u043C \u043F\u0443\u0442\u0451\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636386
    m_Localized: "\u041E\u0441\u043D\u043E\u0432\u043D\u043E\u0439 \u043F\u0443\u0442\u044C
      \u0437\u0430\u043D\u044F\u043B \u0434\u0435\u043D\u044C \u0431\u043E\u043B\u044C\u0448\u0435,
      \u043A\u0430\u043A \u0438 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u043B
      \u0411\u0443\u0433\u0430. \u041D\u0438\u043A\u0430\u043A\u0438\u0445 \u043F\u043E\u0442\u0435\u0440\u044C,
      \u043D\u0438\u043A\u0430\u043A\u043E\u0433\u043E \u0440\u0438\u0441\u043A\u0430.
      \u0411\u0443\u0433\u0430 \u043D\u0435 \u0441\u043F\u043E\u0440\u0438\u043B
      - \u0432 \u043A\u043E\u043D\u0446\u0435 \u043A\u043E\u043D\u0446\u043E\u0432,
      \u044D\u0442\u043E \u0435\u0433\u043E \u0440\u0430\u0431\u043E\u0442\u0430:
      \u0437\u043D\u0430\u0442\u044C, \u0430 \u043D\u0435 \u0440\u0435\u0448\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636387
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0434\u043E \u0443\u0442\u0440\u0430 - \u043E\u0446\u0435\u043D\u0438\u0442\u044C
      \u043F\u043E\u0433\u043E\u0434\u0443 \u0437\u0430\u043D\u043E\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636388
    m_Localized: "\u0423\u0442\u0440\u043E\u043C \u043D\u0435\u0431\u043E \u043F\u0440\u043E\u044F\u0441\u043D\u0438\u043B\u043E\u0441\u044C.
      \u041F\u0440\u043E\u0448\u043B\u0438 \u0447\u0435\u0440\u0435\u0437 \u0410\u043A-\u0421\u0443\u0443
      \u0431\u0435\u0437 \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u043F\u043E\u043B\u0434\u043D\u044F
      \u043D\u0430 \u043D\u043E\u0447\u0451\u0432\u043A\u0443. \u0420\u0430\u0437\u0443\u043C\u043D\u0430\u044F
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E\u0441\u0442\u044C -
      \u043E\u0441\u044B\u043F\u044C \u043F\u043E\u0441\u043B\u0435 \u0434\u043E\u0436\u0434\u044F
      \u0431\u044B\u043B\u0430 \u0431\u044B \u043A\u0430\u0442\u0430\u0441\u0442\u0440\u043E\u0444\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636389
    m_Localized: "\u041E\u0448\u0438\u0431\u043A\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636390
    m_Localized: "\u041D\u0430 \u0442\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C
      \u0432 \u0433\u043E\u0440\u0430\u0445 \u0411\u0443\u0433\u0430 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u0434\u043E\u043B\u0433\u043E \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u043D\u0430 \u0441\u043A\u043B\u043E\u043D\u044B. \u041F\u043E\u0442\u043E\u043C
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0441 \u0442\u0440\u0443\u0434\u043E\u043C:
      \"\u042F \u0432\u044B\u0431\u0440\u0430\u043B \u043D\u0435 \u0442\u043E\u0442
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B. \u0422\u043E\u0442, \u0447\u0442\u043E
      \u0432\u043F\u0435\u0440\u0435\u0434\u0438 - \u043D\u0435 \u0410\u043A-\u0411\u0430\u0439\u0442\u0430\u043B,
      \u0430 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0439, \u043E\u043D \u0432\u0435\u0434\u0451\u0442
      \u043A \u043C\u0451\u0440\u0442\u0432\u043E\u043C\u0443 \u0443\u0449\u0435\u043B\u044C\u044E.
      \u041D\u0443\u0436\u043D\u043E \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0434\u0432\u0430 \u0434\u043D\u044F \u043D\u0430\u0437\u0430\u0434
      \u043A \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0435\". \u0414\u0432\u0430
      \u0434\u043D\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E. \u041E\u0448\u0438\u0431\u043A\u0430
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F, \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u044F\u0432\u043D\u043E \u043D\u0435 \u0441\u043F\u0430\u043B \u0432\u0441\u044E
      \u043D\u043E\u0447\u044C. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043C\u043E\u043B\u0447\u0430\u0442, \u043D\u043E \u0441\u043C\u043E\u0442\u0440\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636391
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043E\u0448\u0438\u0431\u043A\u0443
      \u0438 \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u0442\u044C \u0431\u0435\u0437
      \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636392
    m_Localized: "\u041F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0438 \u043C\u043E\u043B\u0447\u0430.
      \u0411\u0443\u0433\u0430 \u0448\u0451\u043B \u0432\u043F\u0435\u0440\u0435\u0434\u0438,
      \u043D\u0435 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u044F \u0433\u043E\u043B\u043E\u0432\u044B.
      \u0414\u0432\u0430 \u0434\u043D\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0432\u043E\u0440\u0447\u0430\u043B\u0438
      \u043C\u0435\u0436\u0434\u0443 \u0441\u043E\u0431\u043E\u0439. \u041A \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u043C\u0443
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0443 \u0432\u044B\u0448\u043B\u0438
      \u043D\u0430 \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439 \u0434\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636393
    m_Localized: "\u041E\u0448\u0442\u0440\u0430\u0444\u043E\u0432\u0430\u0442\u044C
      \u0411\u0443\u0433\u0443 - \u0432\u044B\u0447\u0435\u0441\u0442\u044C \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u044B\u0435
      \u0434\u043D\u0438 \u0438\u0437 \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636394
    m_Localized: "\u0412\u044B\u0447\u0435\u0442 \u0438\u0437 \u0436\u0430\u043B\u043E\u0432\u0430\u043D\u044C\u044F
      \u0411\u0443\u0433\u0430 \u043F\u0440\u0438\u043D\u044F\u043B \u0431\u0435\u0437
      \u0432\u043E\u0437\u0440\u0430\u0436\u0435\u043D\u0438\u0439. \u0417\u0430\u0442\u043E
      \u0448\u0451\u043B \u043C\u043E\u043B\u0447\u0430 \u0438 \u0437\u043B\u0438\u043B\u0441\u044F.
      \u041D\u0430 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E\u0439 \u0442\u0440\u043E\u043F\u0435
      \u043E\u043D \u0440\u0430\u0431\u043E\u0442\u0430\u043B \u043F\u0440\u043E\u0444\u0435\u0441\u0441\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E,
      \u043D\u043E \u0434\u043E\u0432\u0435\u0440\u0438\u0435 \u0434\u0430\u043B\u043E
      \u0442\u0440\u0435\u0449\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636395
    m_Localized: "\u041E\u0431\u044A\u044F\u0432\u0438\u0442\u044C \u043E\u0431 \u043E\u0448\u0438\u0431\u043A\u0435
      \u043F\u0443\u0431\u043B\u0438\u0447\u043D\u043E \u043F\u0435\u0440\u0435\u0434
      \u0432\u0441\u0435\u043C \u043E\u0431\u043E\u0437\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636396
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B\u0438
      \u043E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0435 \u0411\u0443\u0433\u0438
      \u0438 \u0434\u0432\u0438\u043D\u0443\u043B\u0438\u0441\u044C \u043D\u0430\u0437\u0430\u0434.
      \u041D\u043E \u0442\u0440\u043E\u0435 \u0441\u0442\u0430\u043B\u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
      \u043D\u0430 \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430 \u0441
      \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C \u043D\u0435\u0434\u043E\u0432\u0435\u0440\u0438\u0435\u043C.
      \u0411\u0443\u0433\u0430 \u0432\u0451\u043B \u0434\u0430\u043B\u044C\u0448\u0435
      \u0442\u043E\u0447\u043D\u043E, \u043D\u043E \u0441\u043B\u043E\u043C\u0430\u043B\u0441\u044F
      \u0432\u043D\u0443\u0442\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636397
    m_Localized: "\u0411\u0430\u0440\u0441\u0438\u0446\u0430 \u0441 \u0434\u0435\u0442\u0451\u043D\u044B\u0448\u0430\u043C\u0438
      \u043D\u0430 \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636398
    m_Localized: "\u0423\u0442\u0440\u0435\u043D\u043D\u0438\u0439 \u0445\u043E\u043B\u043E\u0434
      \u0432 \u0443\u0449\u0435\u043B\u044C\u0435 \u0421\u0430\u0440\u0435\u0437
      - \u0438 \u0432\u0434\u0440\u0443\u0433 \u0432 \u043F\u044F\u0442\u0438\u0434\u0435\u0441\u044F\u0442\u0438
      \u0448\u0430\u0433\u0430\u0445 \u043D\u0430 \u0442\u0440\u043E\u043F\u0435
      \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043A\u0440\u0443\u043F\u043D\u0430\u044F
      \u0441\u0430\u043C\u043A\u0430 \u0441\u043D\u0435\u0436\u043D\u043E\u0433\u043E
      \u0431\u0430\u0440\u0441\u0430. \u041F\u043E\u0437\u0430\u0434\u0438 \u043D\u0435\u0451
      \u0434\u0432\u043E\u0435 \u043A\u043E\u0442\u044F\u0442 - \u0438\u043C \u043D\u0435
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0442\u0440\u0451\u0445 \u043C\u0435\u0441\u044F\u0446\u0435\u0432,
      \u0445\u0432\u043E\u0441\u0442\u044B \u0442\u043E\u043B\u0441\u0442\u044B\u0435,
      \u043B\u0430\u043F\u044B \u043D\u0435\u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E
      \u0431\u043E\u043B\u044C\u0448\u0438\u0435. \u041C\u0430\u0442\u044C \u043D\u0435
      \u0443\u0431\u0435\u0433\u0430\u0435\u0442: \u043E\u043D\u0430 \u0432\u0441\u0442\u0430\u043B\u0430
      \u0431\u043E\u043A\u043E\u043C, \u0445\u0432\u043E\u0441\u0442 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0430\u043B\u044C\u043D\u043E,
      \u0443\u0448\u0438 \u043F\u0440\u0438\u0436\u0430\u0442\u044B - \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435.
      \u041A\u043E\u0442\u044F\u0442\u0430 \u043F\u0440\u044F\u0447\u0443\u0442\u0441\u044F
      \u0437\u0430 \u043D\u0435\u0439. \u0422\u0440\u043E\u043F\u0430 \u0448\u0438\u0440\u0438\u043D\u043E\u0439
      \u0432 \u043E\u0434\u043D\u043E\u0433\u043E \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430.
      \u0421\u0430\u043C\u043A\u0430 \u0441\u043D\u0435\u0436\u043D\u043E\u0433\u043E
      \u0431\u0430\u0440\u0441\u0430 \u0441 \u043C\u043E\u043B\u043E\u0434\u043D\u044F\u043A\u043E\u043C
      \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442 \u0438\u0445 \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u043E
      - \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0435\u0451 \u043D\u0435\u043B\u044C\u0437\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636399
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043E\u0431\u043E\u0437
      \u0438 \u0436\u0434\u0430\u0442\u044C, \u043F\u043E\u043A\u0430 \u043E\u043D\u0430
      \u0443\u0439\u0434\u0451\u0442 \u0441\u0430\u043C\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636400
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u0431\u0430\u0440\u0441\u0438\u0446\u0430
      \u0443\u0432\u0435\u043B\u0430 \u043A\u043E\u0442\u044F\u0442 \u0432 \u0441\u043A\u0430\u043B\u044B.
      \u0422\u0440\u043E\u043F\u0430 \u043E\u0442\u043A\u0440\u044B\u043B\u0430\u0441\u044C.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0447\u0430\u0441, \u043D\u043E
      \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0434\u043E\u043B\u0433\u043E
      \u043C\u043E\u043B\u0447\u0430\u043B\u0438 - \u0442\u0430\u043A\u043E\u0435
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044E\u0442 \u0440\u0430\u0437 \u0432
      \u0436\u0438\u0437\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636401
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u043A\u0430\u043C\u043D\u0438
      \u0438 \u043A\u0440\u0438\u0447\u0430\u0442\u044C - \u043F\u0440\u043E\u0433\u043D\u0430\u0442\u044C
      \u0448\u0443\u043C\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636402
    m_Localized: "\u0411\u0430\u0440\u0441\u0438\u0446\u0430 \u043F\u0440\u044B\u0433\u043D\u0443\u043B\u0430
      \u043D\u0430 \u0431\u0440\u043E\u0441\u0438\u0432\u0448\u0435\u0433\u043E \u043A\u0430\u043C\u0435\u043D\u044C
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A\u0430. \u0426\u0430\u0440\u0430\u043F\u0438\u043D\u0430
      \u043D\u0430 \u043F\u0440\u0435\u0434\u043F\u043B\u0435\u0447\u044C\u0435,
      \u043E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0443\u043F\u0430\u043B \u043D\u0430\u0437\u0430\u0434.
      \u041E\u043D\u0430 \u043D\u0435 \u043F\u0440\u0435\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u0430.
      \u041A\u043E\u0442\u044F\u0442\u0430 \u0443\u0431\u0435\u0436\u0430\u043B\u0438
      \u0432 \u0440\u0430\u0441\u0449\u0435\u043B\u0438\u043D\u0443. \u0422\u0440\u043E\u043F\u0430
      \u043E\u0441\u0432\u043E\u0431\u043E\u0434\u0438\u043B\u0430\u0441\u044C, \u043D\u043E
      \u043A\u0440\u043E\u0432\u044C \u043F\u0440\u043E\u043B\u0438\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636403
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u043F\u043E \u0432\u0435\u0440\u0445\u043D\u0435\u043C\u0443
      \u043A\u0430\u0440\u043D\u0438\u0437\u0443 - \u043E\u0431\u0445\u043E\u0434
      \u043D\u0430\u0434 \u0442\u0440\u043E\u043F\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636404
    m_Localized: "\u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u043F\u0440\u043E\u0448\u043B\u0438
      \u043F\u043E \u043A\u0430\u0440\u043D\u0438\u0437\u0443 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E,
      \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443. \u0411\u0430\u0440\u0441\u0438\u0446\u0430
      \u0441\u043B\u0435\u0434\u0438\u043B\u0430 \u0441\u043D\u0438\u0437\u0443,
      \u043D\u043E \u043D\u0435 \u0442\u0440\u043E\u043D\u0443\u043B\u0430\u0441\u044C.
      \u041F\u043E\u043B\u0447\u0430\u0441\u0430 \u043C\u0430\u043D\u0435\u0432\u0440\u0430.
      \u041A\u043E\u0442\u044F\u0442\u0430 \u0432\u0441\u0451 \u044D\u0442\u043E
      \u0432\u0440\u0435\u043C\u044F \u0438\u0433\u0440\u0430\u043B\u0438 \u0441
      \u0445\u0432\u043E\u0441\u0442\u043E\u043C \u043C\u0430\u0442\u0435\u0440\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636405
    m_Localized: "\u0412\u043E\u043B\u043A\u0438 \u0438 \u0441\u0442\u0430\u0434\u043E
      \u044F\u043A\u043E\u0432 \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636406
    m_Localized: "\u041D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435,
      \u0432 \u0441\u0438\u0437\u043E\u043C \u0442\u0443\u043C\u0430\u043D\u0435,
      \u043E\u0431\u043E\u0437 \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043D\u0430
      \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0435 \u043F\u0430\u0441\u0442\u0431\u0438\u0449\u0435
      \u0438 \u0432\u0438\u0434\u0438\u0442: \u0432 \u0442\u0440\u0451\u0445\u0441\u0442\u0430\u0445
      \u0448\u0430\u0433\u0430\u0445 \u0441\u0435\u043C\u044C \u0432\u043E\u043B\u043A\u043E\u0432
      \u0434\u0435\u043B\u043E\u0432\u0438\u0442\u043E \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0442
      \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u0441\u0442\u0430\u0434\u043E
      \u044F\u043A\u043E\u0432 - \u044F\u0432\u043D\u043E \u043D\u0435 \u0432\u0430\u0448\u0438\u0445.
      \u0412\u043E\u043B\u043A\u0438 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442
      \u0432 \u043F\u0430\u0440\u0435, \u043E\u0442\u0440\u0435\u0437\u0430\u044F
      \u043C\u043E\u043B\u043E\u0434\u043E\u0433\u043E \u044F\u043A\u0430 \u043E\u0442
      \u0441\u0442\u0430\u0434\u0430. \u042F\u043A\u0438 \u0440\u0435\u0432\u0443\u0442.
      \u0425\u043E\u0437\u044F\u0438\u043D\u0430 \u0441\u0442\u0430\u0434\u0430 \u043D\u0435
      \u0432\u0438\u0434\u043D\u043E. \u0412\u044B \u043C\u043E\u0436\u0435\u0442\u0435
      \u0443\u0439\u0442\u0438, \u043D\u0435 \u0432\u043C\u0435\u0448\u0438\u0432\u0430\u044F\u0441\u044C
      - \u044D\u0442\u043E \u043F\u0440\u0438\u0440\u043E\u0434\u0430. \u0418\u043B\u0438
      \u043F\u043E\u043C\u043E\u0447\u044C. \u0418\u043B\u0438 \u0432\u043E\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0441\u0443\u043C\u0430\u0442\u043E\u0445\u043E\u0439 \u0434\u043B\u044F \u043E\u0445\u043E\u0442\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636407
    m_Localized: "\u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C \u0432\u043E\u043B\u043A\u043E\u0432
      - \u043F\u043E\u043C\u043E\u0447\u044C \u0441\u0442\u0430\u0434\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636408
    m_Localized: "\u041A\u0440\u0438\u043A, \u043E\u0433\u043E\u043D\u044C, \u0444\u0430\u043A\u0435\u043B\u0430
      - \u0432\u043E\u043B\u043A\u0438 \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438.
      \u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
      \u043F\u0430\u0441\u0442\u0443\u0445-\u0442\u0438\u0431\u0435\u0442\u0435\u0446,
      \u043F\u043E\u043A\u043B\u043E\u043D\u0438\u043B\u0441\u044F \u043D\u0438\u0437\u043A\u043E
      \u0438 \u043F\u0440\u0438\u0432\u0451\u043B \u043E\u0432\u0446\u0443 \u0432
      \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C.
      \u041D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u0430\u044F \u043F\u0440\u0438\u0431\u044B\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636409
    m_Localized: "\u041E\u0445\u043E\u0442\u0438\u0442\u044C\u0441\u044F \u043D\u0430
      \u0432\u043E\u043B\u043A\u043E\u0432 - \u0441\u0432\u0435\u0436\u0435\u0435
      \u043C\u044F\u0441\u043E \u043D\u0443\u0436\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636410
    m_Localized: "\u041E\u0445\u043E\u0442\u043D\u0438\u043A\u0438 \u0443\u0431\u0438\u043B\u0438
      \u0434\u0432\u0443\u0445 \u0432\u043E\u043B\u043A\u043E\u0432. \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0443\u0448\u043B\u0438. \u042F\u043A\u0438 \u0443\u0446\u0435\u043B\u0435\u043B\u0438.
      \u0421\u0432\u0435\u0436\u0435\u0435 \u043C\u044F\u0441\u043E \u0443 \u043B\u0430\u0433\u0435\u0440\u044F.
      \u041F\u0430\u0441\u0442\u0443\u0445 \u043F\u0440\u0438\u0448\u0451\u043B \u043F\u043E\u0437\u0436\u0435
      - \u0431\u0435\u0437 \u0440\u0430\u0434\u043E\u0441\u0442\u0438, \u0432\u043E\u043B\u0447\u044C\u0438
      \u0448\u043A\u0443\u0440\u044B \u0443 \u043D\u0435\u0433\u043E \u0431\u044B\u043B\u0438
      \u0431\u044B \u0441\u0432\u043E\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636411
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E -
      \u043D\u0435 \u043D\u0430\u0448 \u0441\u043A\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636412
    m_Localized: "\u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B,
      \u043D\u0435 \u0432\u043C\u0435\u0448\u0430\u0432\u0448\u0438\u0441\u044C.
      \u0412\u043E\u0439 \u0438 \u0440\u0451\u0432 \u0443\u0442\u0438\u0445\u043B\u0438
      \u0437\u0430 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u043E\u043C. \u041C\u043E\u043B\u043E\u0434\u043E\u0439
      \u044F\u043A, \u0441\u043A\u043E\u0440\u0435\u0435 \u0432\u0441\u0435\u0433\u043E,
      \u043F\u043E\u0433\u0438\u0431. \u041D\u0438\u043A\u0430\u043A\u0438\u0445
      \u043F\u043E\u0442\u0435\u0440\u044C \u0443 \u043E\u0431\u043E\u0437\u0430,
      \u043D\u0438\u043A\u0430\u043A\u043E\u0439 \u043F\u043E\u043B\u044C\u0437\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636413
    m_Localized: "\u0422\u0430\u0431\u0443\u043D \u0434\u0436\u0435\u0439\u0440\u0430\u043D\u043E\u0432
      \u043D\u0430 \u043F\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636414
    m_Localized: "\u0417\u0435\u043C\u043B\u044F \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442
      \u0434\u0440\u043E\u0436\u0430\u0442\u044C \u043F\u043E\u0434 \u043D\u043E\u0433\u0430\u043C\u0438
      \u0437\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0438\u043D\u0443\u0442
      \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442
      \u0442\u0435\u043C\u043D\u0435\u0435\u0442. \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0442\u044B\u0441\u044F\u0447 \u0434\u0436\u0435\u0439\u0440\u0430\u043D\u043E\u0432
      \u0438\u0434\u0443\u0442 \u0448\u0438\u0440\u043E\u043A\u0438\u043C \u0444\u0440\u043E\u043D\u0442\u043E\u043C
      \u0447\u0435\u0440\u0435\u0437 \u0440\u0430\u0432\u043D\u0438\u043D\u0443 -
      \u0438\u0445 \u0440\u044B\u0436\u0435-\u0441\u0435\u0440\u044B\u0435 \u0441\u043F\u0438\u043D\u044B
      \u0441\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0432 \u0432\u043E\u043B\u043D\u0443.
      \u041F\u044B\u043B\u044C \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442\u0441\u044F
      \u0441\u0442\u0435\u043D\u043E\u0439 \u0432\u044B\u0441\u043E\u0442\u043E\u0439
      \u0432 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0448\u0430\u0433\u043E\u0432.
      \u0412\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u044C - \u043D\u043E\u043B\u044C.
      \u0414\u0436\u0435\u0439\u0440\u0430\u043D\u044B \u043D\u0435 \u0437\u0430\u043C\u0435\u0447\u0430\u044E\u0442
      \u043B\u044E\u0434\u0435\u0439 \u0438 \u043E\u0431\u0445\u043E\u0434\u044F\u0442
      \u0438\u0445 \u0441\u0442\u0430\u0434\u043D\u044B\u043C \u0440\u0435\u0444\u043B\u0435\u043A\u0441\u043E\u043C.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u0431\u0435\u0441\u043F\u043E\u043A\u043E\u044F\u0442\u0441\u044F.
      \u0415\u0441\u043B\u0438 \u0432\u043E\u0439\u0442\u0438 \u0432 \u043F\u043E\u0442\u043E\u043A
      - \u0437\u0430\u0442\u043E\u043F\u0447\u0443\u0442, \u0435\u0441\u043B\u0438
      \u043F\u0435\u0440\u0435\u0436\u0438\u0434\u0430\u0442\u044C - \u0443\u0439\u0434\u0451\u0442
      \u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636415
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043E\u0431\u043E\u0437
      \u0438 \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C - \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636416
    m_Localized: "\u0427\u0430\u0441 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F
      \u0432 \u043F\u044B\u043B\u0438. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0437\u0430\u043A\u0440\u044B\u043B\u0438 \u043B\u0438\u0446\u0430 \u0442\u043A\u0430\u043D\u044C\u044E.
      \u0421\u0442\u0430\u0434\u043E \u043F\u0440\u043E\u0448\u043B\u043E \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E.
      \u041E\u0431\u043E\u0437 \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F \u0434\u0430\u043B\u044C\u0448\u0435
      \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C. \u0417\u0440\u0435\u043B\u0438\u0449\u0435
      \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u0441\u044F \u043D\u0430\u0434\u043E\u043B\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636417
    m_Localized: "\u041E\u0445\u043E\u0442\u0438\u0442\u044C\u0441\u044F \u043D\u0430
      \u043A\u0440\u0430\u044E \u0441\u0442\u0430\u0434\u0430 - \u043F\u043E\u0434\u0441\u0442\u0440\u0435\u043B\u0438\u0442\u044C
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636418
    m_Localized: "\u041E\u0445\u043E\u0442\u043D\u0438\u043A\u0438 \u0434\u043E\u0431\u044B\u043B\u0438
      \u0442\u0440\u0451\u0445 \u0434\u0436\u0435\u0439\u0440\u0430\u043D\u043E\u0432
      \u043D\u0430 \u043A\u0440\u0430\u044E. \u0421\u0432\u0435\u0436\u0430\u044F
      \u0434\u0438\u0447\u044C - \u0445\u0432\u0430\u0442\u0438\u0442 \u043D\u0430
      \u0434\u0432\u0430 \u0434\u043D\u044F. \u041E\u0431\u043E\u0437 \u0441\u0442\u043E\u044F\u043B
      \u0447\u0443\u0442\u044C \u0434\u043E\u043B\u044C\u0448\u0435, \u043D\u043E
      \u0441 \u043C\u044F\u0441\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636419
    m_Localized: "\u041F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C
      \u043F\u0440\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F \u0447\u0435\u0440\u0435\u0437
      \u043F\u043E\u0442\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636420
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u0432\u043E\u0448\u0451\u043B \u0432 \u0441\u0442\u0430\u0434\u043E \u0438
      \u0442\u0443\u0442 \u0436\u0435 \u0448\u0430\u0440\u0430\u0445\u043D\u0443\u043B\u0441\u044F
      - \u0442\u0430\u0431\u0443\u043D \u0443\u0434\u0430\u0440\u0438\u043B \u0435\u0433\u043E
      \u0441 \u0431\u043E\u043A\u043E\u0432. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0443\u043F\u0430\u043B. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C. \u041F\u043E\u043F\u044B\u0442\u043A\u0430
      \u043D\u0435\u0443\u0434\u0430\u0447\u043D\u0430, \u043D\u043E \u043D\u0438\u043A\u0442\u043E
      \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u043E \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636421
    m_Localized: "\u0421\u043A\u043E\u0440\u043F\u0438\u043E\u043D \u0432 \u0441\u0430\u043F\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636422
    m_Localized: "\u0420\u0430\u043D\u043D\u0438\u043C \u0443\u0442\u0440\u043E\u043C
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u041A\u0430\u0440\u0438\u043C
      \u0432\u0441\u0442\u0440\u044F\u0445\u043D\u0443\u043B \u0441\u0430\u043F\u043E\u0433
      \u043F\u0435\u0440\u0435\u0434 \u0442\u0435\u043C, \u043A\u0430\u043A \u043D\u0430\u0434\u0435\u0442\u044C,
      - \u0438 \u0437\u0430\u0441\u0442\u044B\u043B. \u0412\u043D\u0443\u0442\u0440\u0438
      \u0448\u0443\u0440\u0448\u0438\u0442. \u041E\u043D \u0434\u0435\u0440\u0436\u0438\u0442
      \u0441\u0430\u043F\u043E\u0433 \u0432\u0432\u0435\u0440\u0445 \u043F\u043E\u0434\u043E\u0448\u0432\u043E\u0439
      \u0438 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u043E\u043F\u0440\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E.
      \u0418\u0437 \u0433\u043E\u0440\u043B\u044B\u0448\u043A\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u0435\u0442
      \u0436\u0435\u043B\u0442\u043E\u0432\u0430\u0442\u043E-\u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u0439
      \u0441\u043A\u043E\u0440\u043F\u0438\u043E\u043D \u0430\u043D\u0434\u0440\u043E\u043A\u0442\u043E\u043D\u0443\u0441
      - \u0445\u0432\u043E\u0441\u0442 \u043F\u043E\u0434\u043D\u044F\u0442. \u042D\u0442\u043E
      \u043E\u0434\u0438\u043D \u0438\u0437 \u0441\u0430\u043C\u044B\u0445 \u044F\u0434\u043E\u0432\u0438\u0442\u044B\u0445
      \u0432\u0438\u0434\u043E\u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u044C.
      \u0423\u0441\u043F\u0435\u043B \u0432\u044B\u0442\u0440\u044F\u0445\u043D\u0443\u0442\u044C
      \u0438\u043B\u0438 \u043D\u0435\u0442 - \u0434\u0435\u043B\u043E \u0441\u043B\u0443\u0447\u0430\u044F.
      \u041E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0443\u0436\u0435 \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u044E\u0442
      \u0441\u0432\u043E\u044E \u043E\u0431\u0443\u0432\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636423
    m_Localized: "\u0412\u044B\u0442\u0440\u044F\u0445\u043D\u0443\u0442\u044C \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E
      - \u041A\u0430\u0440\u0438\u043C \u043C\u043E\u043B\u043E\u0434\u0435\u0446,
      \u0447\u0442\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636424
    m_Localized: "\u0421\u043A\u043E\u0440\u043F\u0438\u043E\u043D \u0443\u043F\u0430\u043B
      \u043D\u0430 \u043F\u0435\u0441\u043E\u043A \u0438 \u043C\u0435\u0442\u043D\u0443\u043B\u0441\u044F
      \u043F\u043E\u0434 \u043A\u0430\u043C\u0435\u043D\u044C. \u041A\u0430\u0440\u0438\u043C
      \u0446\u0435\u043B. \u041E\u043D \u0432\u0432\u0451\u043B \u0432 \u043E\u0442\u0440\u044F\u0434\u0435
      \u043F\u0440\u0430\u0432\u0438\u043B\u043E: \u043A\u0430\u0436\u0434\u043E\u0435
      \u0443\u0442\u0440\u043E - \u0442\u0440\u044F\u0441\u0442\u0438 \u043E\u0431\u0443\u0432\u044C.
      \u0422\u0435\u043F\u0435\u0440\u044C \u044D\u0442\u043E \u0437\u0430\u043A\u043E\u043D
      \u043E\u0431\u043E\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993427636425
    m_Localized: "\u0414\u0430\u0442\u044C \u041A\u0430\u0440\u0438\u043C\u0443 \u043D\u0430\u0441\u0442\u0443\u043F\u0438\u0442\u044C
      - \u043C\u043E\u0436\u0435\u0442, \u043D\u0435 \u0443\u0436\u0430\u043B\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830528
    m_Localized: "\u041A\u0430\u0440\u0438\u043C \u0443\u0436\u0430\u043B\u0438\u043B\u043E
      \u0432 \u0441\u0442\u0443\u043F\u043D\u044E. \u041B\u0435\u043A\u0430\u0440\u044C
      \u041F\u0435\u043C\u0431\u0430 \u043F\u0440\u043E\u0432\u0451\u043B \u0447\u0430\u0441
      \u043D\u0430\u0434 \u043D\u0438\u043C - \u043D\u0430\u0434\u0440\u0435\u0437,
      \u0442\u0440\u0430\u0432\u0430, \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0439
      \u043A\u043E\u043C\u043F\u0440\u0435\u0441\u0441. \u041D\u043E\u0433\u0430
      \u0440\u0430\u0437\u0434\u0443\u043B\u0430\u0441\u044C. \u041A\u0430\u0440\u0438\u043C
      \u0448\u0451\u043B, \u043D\u043E \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435
      \u0442\u0440\u0438 \u0434\u043D\u044F. \u0420\u0438\u0441\u043A \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0440\u0435\u0430\u043B\u044C\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830529
    m_Localized: "\u0411\u0435\u0440\u043A\u0443\u0442 \u0430\u0442\u0430\u043A\u0443\u0435\u0442
      \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830530
    m_Localized: "\u0422\u0435\u043D\u044C \u043D\u0430\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u043E\u0431\u043E\u0437 \u0440\u0435\u0437\u043A\u043E - \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439
      \u043E\u0440\u0451\u043B-\u0431\u0435\u0440\u043A\u0443\u0442, \u0440\u0430\u0437\u043C\u0430\u0445
      \u043A\u0440\u044B\u043B\u044C\u0435\u0432 \u0432 \u0434\u0432\u0430 \u043B\u043E\u043A\u0442\u044F,
      \u043F\u0430\u0434\u0430\u0435\u0442 \u0441 \u0432\u044B\u0441\u043E\u0442\u044B
      \u043D\u0430 \u0432\u044C\u044E\u043A\u0438 \u043F\u0435\u0440\u0435\u0434\u043D\u0435\u0433\u043E
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430. \u041A\u043E\u0433\u0442\u0438
      \u0446\u0435\u043F\u043B\u044F\u044E\u0442 \u0445\u043E\u043B\u0449\u043E\u0432\u044B\u0439
      \u043C\u0435\u0448\u043E\u043A \u0441 \u043A\u0430\u0440\u0434\u0430\u043C\u043E\u043D\u043E\u043C,
      \u043F\u0442\u0438\u0446\u0430 \u0431\u044C\u0451\u0442 \u043A\u0440\u044B\u043B\u044C\u044F\u043C\u0438
      \u0438 \u043F\u044B\u0442\u0430\u0435\u0442\u0441\u044F \u043F\u043E\u0434\u043D\u044F\u0442\u044C
      \u043C\u0435\u0448\u043E\u043A. \u0421\u0438\u043B\u0430 \u0443\u0434\u0430\u0440\u0430
      \u0441\u0431\u0438\u0432\u0430\u0435\u0442 \u043A\u0440\u044B\u0448\u043A\u0443
      \u0431\u043E\u0447\u043A\u0438 \u0440\u044F\u0434\u043E\u043C. \u0412\u0435\u0440\u0431\u043B\u044E\u0434
      \u0440\u0435\u0432\u0451\u0442 \u0438 \u0448\u0430\u0440\u0430\u0445\u0430\u0435\u0442\u0441\u044F.
      \u0411\u0435\u0440\u043A\u0443\u0442 \u043D\u0435 \u0432\u0438\u0434\u0438\u0442
      \u043B\u044E\u0434\u0435\u0439 - \u043E\u043D \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442
      \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0434\u0432\u0438\u0436\u0443\u0449\u0438\u0439\u0441\u044F
      \u0433\u0440\u0443\u0437. \u041C\u0435\u0448\u043E\u043A \u0441 \u043A\u0430\u0440\u0434\u0430\u043C\u043E\u043D\u043E\u043C
      \u0442\u044F\u0436\u0451\u043B \u0434\u043B\u044F \u043F\u0442\u0438\u0446\u044B,
      \u043D\u043E \u043E\u043D\u0430 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0435\u0442
      \u0431\u0438\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830531
    m_Localized: "\u041A\u0440\u0438\u0447\u0430\u0442\u044C \u0438 \u0440\u0430\u0437\u043C\u0430\u0445\u0438\u0432\u0430\u0442\u044C
      \u0440\u0443\u043A\u0430\u043C\u0438 - \u043F\u0440\u043E\u0433\u043D\u0430\u0442\u044C
      \u043F\u0442\u0438\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830532
    m_Localized: "\u0411\u0435\u0440\u043A\u0443\u0442 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B
      \u043C\u0435\u0448\u043E\u043A \u0438 \u0432\u0437\u043C\u044B\u043B. \u041A\u0430\u0440\u0434\u0430\u043C\u043E\u043D
      \u0446\u0435\u043B, \u043C\u0435\u0448\u043E\u043A \u043F\u043E\u0440\u0432\u0430\u043D
      \u043F\u043E \u043A\u0440\u0430\u044E. \u041F\u0442\u0438\u0446\u0430 \u043F\u043E\u043A\u0440\u0443\u0436\u0438\u043B\u0430
      \u0438 \u0443\u0448\u043B\u0430 \u0437\u0430 \u0433\u043E\u0440\u043D\u044B\u0439
      \u0433\u0440\u0435\u0431\u0435\u043D\u044C. \u0412\u0435\u0440\u0431\u043B\u044E\u0434
      \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u043B\u0441\u044F \u0447\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830533
    m_Localized: "\u041F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C \u0443\u043D\u0435\u0441\u0442\u0438
      \u043C\u0435\u0448\u043E\u043A - \u0434\u043E\u0440\u043E\u0433\u043E, \u0437\u0430\u0442\u043E
      \u0431\u0435\u0437 \u0441\u0443\u0435\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830534
    m_Localized: "\u0411\u0435\u0440\u043A\u0443\u0442 \u0443\u043D\u0451\u0441 \u043C\u0435\u0448\u043E\u043A
      \u0441 \u043A\u0430\u0440\u0434\u0430\u043C\u043E\u043D\u043E\u043C. \u041F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u0443\u0431\u044B\u0442\u043A\u0430.
      \u0417\u0430\u0442\u043E \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u043B\u0438\u0441\u044C
      \u0431\u044B\u0441\u0442\u0440\u043E \u0438 \u043E\u0431\u043E\u0437 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B
      \u043F\u0443\u0442\u044C \u0431\u0435\u0437 \u0442\u0440\u0430\u0432\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830535
    m_Localized: "\u041C\u0435\u0442\u043D\u0443\u0442\u044C \u0432 \u043F\u0442\u0438\u0446\u0443
      \u043A\u0430\u043C\u0435\u043D\u044C - \u043E\u0442\u043F\u0443\u0433\u043D\u0443\u0442\u044C
      \u0440\u0435\u0437\u043A\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830536
    m_Localized: "\u041A\u0430\u043C\u0435\u043D\u044C \u0437\u0430\u0434\u0435\u043B
      \u043A\u0440\u044B\u043B\u043E - \u043F\u0442\u0438\u0446\u0430 \u0431\u0440\u043E\u0441\u0438\u043B\u0430
      \u043C\u0435\u0448\u043E\u043A \u0438 \u0441 \u043A\u0440\u0438\u043A\u043E\u043C
      \u0443\u043B\u0435\u0442\u0435\u043B\u0430. \u041A\u0430\u0440\u0434\u0430\u043C\u043E\u043D
      \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u043B\u0441\u044F, \u043D\u043E
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043B\u0438.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0434\u043E\u043B\u0433\u043E
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u0432\u0441\u043B\u0435\u0434
      \u0431\u0435\u0440\u043A\u0443\u0442\u0443 - \u043A\u0440\u0430\u0441\u0438\u0432\u0430\u044F
      \u043F\u0442\u0438\u0446\u0430, \u043A\u0430\u043A \u043D\u0438 \u043A\u0440\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830537
    m_Localized: "\u0414\u0438\u043A\u0438\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u0438 \u0441\u0430\u043C\u043A\u0430 \u0438\u0437 \u043E\u0431\u043E\u0437\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830538
    m_Localized: "\u0418\u0437 \u0431\u0430\u0440\u0445\u0430\u043D\u043E\u0432 \u0432\u044B\u0445\u043E\u0434\u0438\u0442
      \u0434\u0438\u043A\u0438\u0439 \u0431\u0430\u043A\u0442\u0440\u0438\u0439\u0441\u043A\u0438\u0439
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434 - \u0448\u0435\u0440\u0441\u0442\u044C
      \u0441\u043F\u0443\u0442\u0430\u043D\u043D\u0430\u044F, \u0433\u043E\u0440\u0431\u044B
      \u043F\u043E\u0434\u0436\u0430\u0440\u044B\u0435, \u043D\u043E\u0437\u0434\u0440\u0438
      \u0434\u0440\u043E\u0436\u0430\u0442. \u041E\u043D \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u043F\u0440\u044F\u043C\u043E \u043A \u0441\u0430\u043C\u043A\u0435 \u0438\u0437
      \u043E\u0431\u043E\u0437\u0430, \u043A\u043E\u0442\u043E\u0440\u0430\u044F
      \u0432 \u043F\u0435\u0440\u0438\u043E\u0434\u0435 \u0442\u0435\u0447\u043A\u0438.
      \u0421\u0430\u043C\u0435\u0446 \u0434\u0438\u043A\u0438\u0439, \u043D\u0435\u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0443\u0435\u043C\u044B\u0439
      \u0438 \u043A\u0440\u0443\u043F\u043D\u0435\u0435 \u0434\u043E\u043C\u0430\u0448\u043D\u0435\u0433\u043E.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0421\u0430\u043C\u0435\u0445
      \u043A\u0440\u0438\u0447\u0438\u0442 \u0438 \u043C\u0430\u0448\u0435\u0442
      \u0440\u0443\u043A\u0430\u043C\u0438, \u043D\u043E \u0434\u0438\u043A\u0430\u0440\u044C
      \u043D\u0435 \u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0435\u0442. \u0415\u0441\u043B\u0438
      \u0434\u0430\u0442\u044C \u0435\u043C\u0443 \u043F\u043E\u0434\u043E\u0439\u0442\u0438
      - \u043F\u043E\u0442\u0435\u0440\u044F\u0435\u043C \u0432\u0440\u0435\u043C\u044F
      \u0438 \u0447\u0430\u0441\u0442\u044C \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u043C\u043E\u0441\u0442\u0438
      \u0441\u0442\u0430\u0434\u0430. \u041D\u043E \u0438 \u043F\u0440\u043E\u0433\u043D\u0430\u0442\u044C
      \u0435\u0433\u043E \u043D\u0435\u043F\u0440\u043E\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830539
    m_Localized: "\u0423\u0432\u0435\u0441\u0442\u0438 \u0441\u0430\u043C\u043A\u0443
      - \u043F\u0440\u0438\u0432\u044F\u0437\u0430\u0442\u044C \u043F\u043E\u0434\u0430\u043B\u044C\u0448\u0435
      \u043E\u0442 \u0434\u0438\u043A\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830540
    m_Localized: "\u0421\u0430\u043C\u043A\u0443 \u0443\u0432\u0435\u043B\u0438 \u0437\u0430
      \u0442\u044E\u043A\u0438. \u0414\u0438\u043A\u0438\u0439 \u043F\u043E\u043A\u0440\u0443\u0436\u0438\u043B,
      \u043F\u043E\u043D\u044E\u0445\u0430\u043B \u0432\u043E\u0437\u0434\u0443\u0445
      \u0438 \u0443\u0448\u0451\u043B \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u0432 \u0431\u0430\u0440\u0445\u0430\u043D\u044B \u0447\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441. \u041F\u043E\u0442\u0435\u0440\u044F\u043D \u0447\u0430\u0441
      \u0441\u0442\u043E\u044F\u043D\u043A\u0438, \u043D\u043E \u043F\u043E\u0442\u043E\u043C\u0441\u0442\u0432\u043E
      \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830541
    m_Localized: "\u041D\u0435 \u0432\u043C\u0435\u0448\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      - \u043F\u0440\u0438\u0440\u043E\u0434\u0430 \u0441\u0434\u0435\u043B\u0430\u0435\u0442
      \u0441\u0432\u043E\u0451"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830542
    m_Localized: "\u0414\u0438\u043A\u0438\u0439 \u0432\u0435\u0440\u0431\u043B\u044E\u0434
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0440\u044F\u0434\u043E\u043C \u0441
      \u0441\u0430\u043C\u043A\u043E\u0439 \u0442\u0440\u0438 \u0447\u0430\u0441\u0430.
      \u041F\u043E\u0442\u043E\u043C \u0443\u0448\u0451\u043B. \u0421\u0430\u043C\u043A\u0430
      \u0431\u0443\u0434\u0435\u0442 \u0436\u0435\u0440\u0435\u0431\u043E\u0439.
      \u0427\u0435\u0440\u0435\u0437 \u043F\u043E\u043B\u0442\u043E\u0440\u0430 \u0433\u043E\u0434\u0430
      \u0445\u043E\u0437\u044F\u0438\u043D \u043F\u043E\u0442\u043E\u043C\u0441\u0442\u0432\u0430
      \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043D. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043F\u0435\u0440\u0435\u0448\u0451\u043F\u0442\u044B\u0432\u0430\u044E\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830543
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C \u0441\u0430\u043C\u043A\u0443
      \u0434\u0438\u043A\u043E\u043C\u0443 \u043F\u0430\u0441\u0442\u0443\u0445\u0443-\u0431\u0435\u0434\u0443\u0438\u043D\u0443
      - \u0443\u0431\u044B\u0442\u043E\u043A \u043C\u0435\u043D\u044C\u0448\u0435
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830544
    m_Localized: "\u0412\u0441\u0442\u0440\u0435\u0447\u0435\u043D\u043D\u044B\u0439
      \u0431\u0435\u0434\u0443\u0438\u043D \u0432\u0437\u044F\u043B \u0441\u0430\u043C\u043A\u0443
      \u0437\u0430 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432.
      \u0414\u0438\u043A\u0438\u0439 \u0443\u0448\u0451\u043B \u0432\u0441\u043B\u0435\u0434.
      \u041F\u043E\u0442\u0435\u0440\u044F \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0433\u043E
      - \u043C\u0438\u043D\u0443\u0441 \u0442\u044F\u0433\u043E\u0432\u0430\u044F
      \u0441\u0438\u043B\u0430. \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u043F\u0435\u0440\u0435\u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0438\u0442\u044C
      \u0433\u0440\u0443\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830545
    m_Localized: "\u041F\u0430\u043D\u0438\u043A\u0430 \u043A\u0443\u043B\u0430\u043D\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830546
    m_Localized: "\u0421\u0442\u0430\u0434\u043E \u043A\u0443\u043B\u0430\u043D\u043E\u0432
      - \u0434\u0438\u043A\u0438\u0445 \u043E\u0441\u043B\u043E\u0432, \u043F\u043B\u043E\u0442\u043D\u044B\u0445
      \u0438 \u0431\u044B\u0441\u0442\u0440\u044B\u0445 - \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E
      \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0438 \u043D\u0435\u0441\u0451\u0442\u0441\u044F \u043F\u0440\u044F\u043C\u043E
      \u0447\u0435\u0440\u0435\u0437 \u043B\u0430\u0433\u0435\u0440\u044C. \u0427\u0442\u043E
      \u0438\u0445 \u0441\u043F\u0443\u0433\u043D\u0443\u043B\u043E - \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E,
      \u043C\u043E\u0436\u0435\u0442 \u0432\u043E\u043B\u043A \u0441 \u044E\u0433\u0430.
      \u0421\u043E\u0442\u043D\u044F \u043E\u0441\u043E\u0431\u0435\u0439 \u043C\u0447\u0438\u0442\u0441\u044F
      \u0432 \u043F\u0430\u043D\u0438\u043A\u0435, \u043D\u0435 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0438. \u041A\u043E\u043F\u044B\u0442\u0430
      \u0433\u0440\u0435\u043C\u044F\u0442 \u043A\u0430\u043A \u0431\u0430\u0440\u0430\u0431\u0430\u043D\u044B.
      \u041B\u0430\u0433\u0435\u0440\u044C \u0440\u0430\u0437\u0431\u0438\u0442 \u043F\u0440\u044F\u043C\u043E
      \u043D\u0430 \u043F\u0443\u0442\u0438 \u0441\u0442\u0430\u0434\u0430. \u041D\u0430
      \u0440\u0430\u0441\u0441\u0451\u0434\u043B\u0430\u043D\u043D\u044B\u0445 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432
      \u0441\u0442\u0430\u0434\u043E \u043D\u0430\u043B\u0435\u0442\u0438\u0442 \u0447\u0435\u0440\u0435\u0437
      \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0441\u0435\u043A\u0443\u043D\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830547
    m_Localized: "\u0417\u0430\u0433\u043E\u0440\u043E\u0434\u0438\u0442\u044C \u043F\u0443\u0442\u044C
      \u043E\u0433\u043D\u0451\u043C \u0438 \u043A\u0440\u0438\u043A\u043E\u043C
      - \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u0441\u0442\u0430\u0434\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830548
    m_Localized: "\u041E\u0433\u043E\u043D\u044C \u0440\u0430\u0437\u043E\u0433\u043D\u0430\u043B\u0438
      \u043C\u0433\u043D\u043E\u0432\u0435\u043D\u043D\u043E. \u0421\u0442\u0430\u0434\u043E
      \u0440\u0430\u0437\u0434\u0430\u043B\u043E\u0441\u044C \u043D\u0430\u0434\u0432\u043E\u0435
      \u0438 \u043E\u0431\u043E\u0448\u043B\u043E \u043B\u0430\u0433\u0435\u0440\u044C
      \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439. \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0442\u044E\u043A\u043E\u0432 \u0441\u0434\u0432\u0438\u043D\u0443\u043B\u043E\u0441\u044C.
      \u0412\u0441\u0435 \u0446\u0435\u043B\u044B. \u0411\u044B\u0441\u0442\u0440\u0430\u044F
      \u0440\u0435\u0430\u043A\u0446\u0438\u044F \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0441\u043F\u0430\u0441\u043B\u0430 \u043B\u0430\u0433\u0435\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830549
    m_Localized: "\u0420\u0430\u0441\u0441\u0440\u0435\u0434\u043E\u0442\u043E\u0447\u0438\u0442\u044C
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432 - \u0441\u043F\u0430\u0441\u0442\u0438
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u043F\u0440\u0435\u0436\u0434\u0435
      \u0432\u0441\u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830550
    m_Localized: "\u0412\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432 \u0440\u0430\u0441\u0442\u0430\u0449\u0438\u043B\u0438
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0437\u0430 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C
      \u0441\u0435\u043A\u0443\u043D\u0434. \u0421\u0442\u0430\u0434\u043E \u043F\u0440\u043E\u0448\u043B\u043E
      \u0447\u0435\u0440\u0435\u0437 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0443
      \u043B\u0430\u0433\u0435\u0440\u044F. \u041F\u044F\u0442\u044C \u0442\u044E\u043A\u043E\u0432
      \u0440\u0430\u0441\u0442\u043E\u043F\u0442\u0430\u043D\u043E, \u043E\u0434\u0438\u043D
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0441\u0431\u0438\u0442 \u0441
      \u043D\u043E\u0433. \u0416\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u0446\u0435\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830551
    m_Localized: "\u041E\u0442\u043A\u0443\u043F\u0438\u0442\u044C\u0441\u044F \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0435\u0439
      - \u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0435\u0434\u0443 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043E\u0442 \u043B\u0430\u0433\u0435\u0440\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830552
    m_Localized: "\u041A\u0443\u043B\u0430\u043D\u044B \u043D\u0435 \u0435\u0434\u044F\u0442
      \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u043E\u0433\u043E \u0437\u0435\u0440\u043D\u0430
      \u043D\u0430 \u0431\u0435\u0433\u0443 - \u044D\u0442\u043E \u0434\u0438\u043A\u0438\u0435
      \u043E\u0441\u043B\u044B, \u043D\u0435 \u0434\u043E\u043C\u0430\u0448\u043D\u0438\u0435.
      \u041F\u043E\u043F\u044B\u0442\u043A\u0430 \u043D\u0435 \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u0430.
      \u041F\u0440\u0438\u0448\u043B\u043E\u0441\u044C \u0431\u0435\u0436\u0430\u0442\u044C
      \u0441\u0430\u043C\u0438\u043C. \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043C\u0435\u0448\u043A\u043E\u0432 \u043F\u043E\u0433\u0443\u0431\u043B\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830553
    m_Localized: "\u0420\u0430\u043D\u0435\u043D\u044B\u0439 \u043A\u0430\u0431\u0430\u043D
      \u0432 \u0442\u0440\u043E\u0441\u0442\u043D\u0438\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830554
    m_Localized: "\u0420\u0435\u043A\u0430 \u0417\u0435\u0440\u0430\u0432\u0448\u0430\u043D
      - \u0443\u0437\u043A\u0430\u044F, \u0441 \u0433\u0443\u0441\u0442\u044B\u043C
      \u0442\u0440\u043E\u0441\u0442\u043D\u0438\u043A\u043E\u043C \u043F\u043E \u0431\u0435\u0440\u0435\u0433\u0430\u043C.
      \u041E\u0431\u043E\u0437 \u0438\u0434\u0451\u0442 \u0432\u0434\u043E\u043B\u044C
      \u0431\u0435\u0440\u0435\u0433\u0430, \u043A\u043E\u0433\u0434\u0430 \u0432
      \u0442\u0440\u043E\u0441\u0442\u043D\u0438\u043A\u0435 \u0440\u0430\u0437\u0434\u0430\u0451\u0442\u0441\u044F
      \u0445\u0440\u0438\u043F \u0438 \u0438\u0437 \u0437\u0430\u0440\u043E\u0441\u043B\u0435\u0439
      \u0432\u044B\u043B\u0430\u043C\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043A\u0440\u0443\u043F\u043D\u044B\u0439
      \u043A\u0430\u0431\u0430\u043D-\u0441\u0435\u043A\u0430\u0447 \u0441 \u0433\u043B\u0443\u0431\u043E\u043A\u043E\u0439
      \u0440\u0430\u043D\u043E\u0439 \u043D\u0430 \u0431\u043E\u043A\u0443 - \u043F\u043E\u0445\u043E\u0436\u0435,
      \u0441\u0442\u0440\u0435\u043B\u0430 \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u0430.
      \u041E\u043D \u0440\u0430\u043D\u0435\u043D \u0438 \u043E\u0441\u043B\u0435\u043F\u043B\u0451\u043D
      \u0431\u043E\u043B\u044C\u044E. \u0420\u0430\u043D\u0435\u043D\u044B\u0439
      \u043A\u0430\u0431\u0430\u043D \u043D\u0430\u043F\u0430\u0434\u0430\u0435\u0442
      \u043D\u0435 \u0438\u0437 \u0433\u043E\u043B\u043E\u0434\u0430, \u0430 \u043E\u0442
      \u0441\u0442\u0440\u0430\u0445\u0430 - \u044D\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442
      \u0435\u0433\u043E \u0432\u0434\u0432\u043E\u0435 \u043E\u043F\u0430\u0441\u043D\u0435\u0435.
      \u041A\u043B\u044B\u043A\u0438 \u0434\u043B\u0438\u043D\u043E\u0439 \u0432
      \u0442\u0440\u0438 \u043F\u0430\u043B\u044C\u0446\u0430. \u041F\u0435\u0440\u0432\u044B\u0439
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434 \u0432 \u0440\u044F\u0434\u0443
      \u043F\u0440\u044F\u043C\u043E \u043F\u0435\u0440\u0435\u0434 \u043D\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830555
    m_Localized: "\u0414\u0430\u0442\u044C \u043A\u0430\u0431\u0430\u043D\u0443 \u0431\u043E\u0439
      - \u043E\u043D \u043E\u0434\u0438\u043D \u0438 \u0440\u0430\u043D\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830556
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u0443\u0434\u0430\u0440\u0438\u043B
      \u043A\u043E\u043F\u044C\u0451\u043C. \u041A\u0430\u0431\u0430\u043D \u0441\u043D\u0451\u0441
      \u0435\u0433\u043E \u0441 \u043D\u043E\u0433 \u0434\u043E \u044D\u0442\u043E\u0433\u043E.
      \u0422\u0440\u0438 \u0441\u0435\u043A\u0443\u043D\u0434\u044B \u0445\u0430\u043E\u0441\u0430,
      \u043A\u0440\u043E\u0432\u044C, \u043A\u0440\u0438\u043A - \u0438 \u043A\u0430\u0431\u0430\u043D
      \u0438\u0437\u0434\u043E\u0445. \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u043E\u0442\u0434\u0435\u043B\u0430\u043B\u0441\u044F \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u043C
      \u0440\u0435\u0431\u0440\u043E\u043C. \u041D\u0430 \u0432\u0435\u0447\u0435\u0440
      - \u0436\u0430\u0440\u0435\u043D\u0430\u044F \u0441\u0432\u0438\u043D\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830557
    m_Localized: "\u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C \u043A\u0430\u0431\u0430\u043D\u0430
      \u0432 \u0440\u0435\u043A\u0443 - \u0437\u0430\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u043F\u043B\u044B\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830558
    m_Localized: "\u041E\u0433\u043E\u043D\u044C \u0438 \u043A\u0440\u0438\u043A\u0438
      \u043F\u043E\u0433\u043D\u0430\u043B\u0438 \u043A\u0430\u0431\u0430\u043D\u0430
      \u043A \u0432\u043E\u0434\u0435. \u041E\u043D \u0441 \u0442\u0440\u0435\u0441\u043A\u043E\u043C
      \u043D\u044B\u0440\u043D\u0443\u043B \u0432 \u0440\u0435\u043A\u0443 \u0438
      \u043F\u043E\u043F\u043B\u044B\u043B \u0432\u043D\u0438\u0437 \u043F\u043E
      \u0442\u0435\u0447\u0435\u043D\u0438\u044E. \u041D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B. \u0414\u0438\u0447\u044C
      \u0443\u0448\u043B\u0430 - \u043C\u044F\u0441\u0430 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830559
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C \u043E\u0431\u043E\u0437
      - \u0434\u0430\u0442\u044C \u043A\u0430\u0431\u0430\u043D\u0443 \u0443\u0439\u0442\u0438
      \u0441\u0430\u043C\u043E\u043C\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830560
    m_Localized: "\u041A\u0430\u0431\u0430\u043D \u043F\u043E\u0441\u0442\u043E\u044F\u043B,
      \u0445\u0440\u0438\u043F\u044F, \u0438 \u0443\u0448\u0451\u043B \u043E\u0431\u0440\u0430\u0442\u043D\u043E
      \u0432 \u0442\u0440\u043E\u0441\u0442\u043D\u0438\u043A \u0447\u0435\u0440\u0435\u0437
      \u043F\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442. \u041F\u043E\u0442\u0435\u0440\u044F\u043D
      \u0447\u0430\u0441 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u043B\u0438\u0441\u044C \u0442\u043E\u043B\u044C\u043A\u043E
      \u043F\u043E\u0441\u043B\u0435 \u0442\u043E\u0433\u043E, \u043A\u0430\u043A
      \u0437\u0430\u043F\u0430\u0445 \u043A\u0440\u043E\u0432\u0438 \u0443\u043D\u0435\u0441\u043B\u043E
      \u0432\u0435\u0442\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830561
    m_Localized: "\u0413\u044E\u0440\u0437\u044B \u043F\u043E\u0434 \u0442\u044E\u043A\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830562
    m_Localized: "\u041D\u0430 \u043D\u043E\u0447\u043D\u043E\u0439 \u0441\u0442\u043E\u044F\u043D\u043A\u0435
      \u0443 \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A\u0430 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0421\u0430\u043C\u0435\u0445 \u043F\u043E\u0434\u043D\u044F\u043B \u0442\u044E\u043A,
      \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
      \u0432\u0435\u0440\u0451\u0432\u043A\u0443, \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
      \u043A\u0430\u043A \u0432\u043A\u043E\u043F\u0430\u043D\u043D\u044B\u0439.
      \u041F\u043E\u0434 \u0442\u044E\u043A\u043E\u043C - \u043A\u043B\u0443\u0431\u043E\u043A
      \u0438\u0437 \u0442\u0440\u0451\u0445 \u0433\u044E\u0440\u0437. \u0421\u0430\u043C\u043A\u0438
      \u043B\u0435\u0432\u0430\u043D\u0442\u0438\u0439\u0441\u043A\u043E\u0439 \u0433\u044E\u0440\u0437\u044B
      \u0433\u0440\u0435\u044E\u0442\u0441\u044F \u043F\u043E\u0434 \u043D\u0430\u0433\u0440\u0435\u0442\u044B\u043C
      \u0432\u043E\u0439\u043B\u043E\u043A\u043E\u043C. \u0418\u0445 \u0443\u043A\u0443\u0441
      \u0431\u0435\u0437 \u043B\u0435\u0447\u0435\u043D\u0438\u044F \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u0435\u043D.
      \u041E\u043D\u0438 \u043F\u043E\u043A\u0430 \u043D\u0435 \u043F\u043E\u0442\u0440\u0435\u0432\u043E\u0436\u0435\u043D\u044B.
      \u041D\u043E \u0442\u044E\u043A\u0438 \u043D\u0443\u0436\u043D\u043E \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044C
      \u043D\u0430 \u043D\u043E\u0447\u044C, \u0430 \u0442\u0430\u043C \u043C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C \u0435\u0449\u0451 \u0431\u043E\u043B\u044C\u0448\u0435
      \u0437\u043C\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830563
    m_Localized: "\u041E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E \u043E\u0442\u043E\u0434\u0432\u0438\u043D\u0443\u0442\u044C
      \u0442\u044E\u043A\u0438 \u0438 \u0434\u0430\u0442\u044C \u0437\u043C\u0435\u044F\u043C
      \u0443\u0439\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830564
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043E\u0442\u043E\u0434\u0432\u0438\u0433\u0430\u043B\u0438
      \u0442\u044E\u043A\u0438 \u043F\u0430\u043B\u043A\u0430\u043C\u0438. \u0413\u044E\u0440\u0437\u044B
      \u0443\u043F\u043E\u043B\u0437\u043B\u0438 \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0443
      - \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u043D\u0435 \u043D\u0430\u043F\u0430\u0434\u0430\u044F.
      \u041E\u0441\u043C\u043E\u0442\u0440 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0445
      \u0442\u044E\u043A\u043E\u0432 \u0437\u0430\u043D\u044F\u043B \u0447\u0430\u0441.
      \u0411\u043E\u043B\u044C\u0448\u0435 \u0437\u043C\u0435\u0439 \u043D\u0435
      \u043D\u0430\u0448\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830565
    m_Localized: "\u0423\u0431\u0438\u0442\u044C \u0432\u0441\u0435\u0445 \u0442\u0440\u0451\u0445
      \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E - \u043D\u0435
      \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830566
    m_Localized: "\u0414\u0432\u0443\u0445 \u0443\u0431\u0438\u043B\u0438 \u043B\u043E\u043F\u0430\u0442\u043E\u0439.
      \u0422\u0440\u0435\u0442\u044C\u044F \u0443\u0436\u0430\u043B\u0438\u043B\u0430
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430 \u0432 \u0440\u0443\u043A\u0443
      \u043F\u0440\u0435\u0436\u0434\u0435, \u0447\u0435\u043C \u0435\u0451 \u0434\u043E\u0431\u0438\u043B\u0438.
      \u041B\u0435\u043A\u0430\u0440\u044C \u041F\u0435\u043C\u0431\u0430 \u0440\u0430\u0431\u043E\u0442\u0430\u043B
      \u0432\u0441\u044E \u043D\u043E\u0447\u044C \u0441 \u043D\u0430\u0434\u0440\u0435\u0437\u043E\u043C
      \u0438 \u043F\u0440\u0438\u043F\u0430\u0440\u043A\u0430\u043C\u0438 \u0438\u0437
      \u0442\u0440\u0430\u0432. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0432\u044B\u0436\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830567
    m_Localized: "\u041F\u0435\u0440\u0435\u043D\u0435\u0441\u0442\u0438 \u043B\u0430\u0433\u0435\u0440\u044C
      - \u043D\u043E\u0447\u0435\u0432\u0430\u0442\u044C \u0432 \u0434\u0440\u0443\u0433\u043E\u043C
      \u043C\u0435\u0441\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830568
    m_Localized: "\u041F\u0435\u0440\u0435\u043D\u043E\u0441 \u043B\u0430\u0433\u0435\u0440\u044F
      \u0437\u0430\u043D\u044F\u043B \u0447\u0430\u0441 \u0432 \u0442\u0435\u043C\u043D\u043E\u0442\u0435.
      \u041B\u044E\u0434\u0438 \u0443\u0441\u0442\u0430\u043B\u0438. \u0417\u0430\u0442\u043E
      \u0443\u0442\u0440\u043E\u043C \u043E\u0441\u043C\u043E\u0442\u0440 \u043F\u0440\u0435\u0436\u043D\u0435\u0439
      \u0441\u0442\u043E\u044F\u043D\u043A\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B
      \u0435\u0449\u0451 \u0448\u0435\u0441\u0442\u0435\u0440\u044B\u0445 \u0433\u044E\u0440\u0437
      \u043F\u043E\u0434 \u0434\u0440\u0443\u0433\u0438\u043C\u0438 \u0442\u044E\u043A\u0430\u043C\u0438.
      \u0420\u0435\u0448\u0435\u043D\u0438\u0435 \u0431\u044B\u043B\u043E \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830569
    m_Localized: "\u0421\u0435\u0440\u044B\u0439 \u0432\u0430\u0440\u0430\u043D \u0432
      \u043B\u0430\u0433\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830570
    m_Localized: "\u041F\u043E\u043B\u0434\u0435\u043D\u044C, \u0436\u0430\u0440\u0430.
      \u041E\u0433\u0440\u043E\u043C\u043D\u044B\u0439 \u0441\u0435\u0440\u044B\u0439
      \u0432\u0430\u0440\u0430\u043D \u0434\u043B\u0438\u043D\u043E\u0439 \u0432
      \u0434\u0432\u0430 \u043B\u043E\u043A\u0442\u044F \u0434\u0435\u043B\u043E\u0432\u0438\u0442\u043E
      \u0441\u0438\u0434\u0438\u0442 \u0443 \u043C\u0435\u0448\u043A\u0430 \u0441
      \u0441\u0443\u0448\u0451\u043D\u044B\u043C\u0438 \u0444\u0438\u043D\u0438\u043A\u0430\u043C\u0438,
      \u0440\u0430\u0437\u043E\u0434\u0440\u0430\u0432 \u043C\u0435\u0448\u043A\u043E\u0432\u0438\u043D\u0443
      \u043A\u043E\u0433\u0442\u044F\u043C\u0438. \u0425\u0432\u043E\u0441\u0442
      \u0442\u043E\u043B\u0449\u0438\u043D\u043E\u0439 \u0432 \u0437\u0430\u043F\u044F\u0441\u0442\u044C\u0435
      \u0445\u043B\u0435\u0449\u0435\u0442 \u043F\u043E \u0437\u0435\u043C\u043B\u0435.
      \u041E\u043D \u043D\u0435 \u0443\u0431\u0435\u0433\u0430\u0435\u0442 - \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0436\u0451\u043B\u0442\u044B\u043C\u0438 \u0433\u043B\u0430\u0437\u0430\u043C\u0438
      \u0441 \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u043C
      \u0437\u0440\u0430\u0447\u043A\u043E\u043C. \u0412\u0430\u0440\u0430\u043D
      \u043E\u043F\u0430\u0441\u0435\u043D \u043D\u0435 \u044F\u0434\u043E\u043C,
      \u0430 \u043A\u043E\u0433\u0442\u044F\u043C\u0438 \u0438 \u0431\u0430\u043A\u0442\u0435\u0440\u0438\u044F\u043C\u0438
      \u0432 \u0441\u043B\u044E\u043D\u0435. \u041C\u0435\u0448\u043E\u043A \u043D\u0430\u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u043E\u043F\u0443\u0441\u0442\u043E\u0448\u0451\u043D. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0441\u0442\u043E\u044F\u0442 \u043D\u0430 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830571
    m_Localized: "\u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C \u0448\u0435\u0441\u0442\u043E\u043C
      - \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E, \u0431\u0435\u0437
      \u0443\u0434\u0430\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830572
    m_Localized: "\u0412\u0430\u0440\u0430\u043D \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B,
      \u043D\u0435\u0434\u043E\u0432\u043E\u043B\u044C\u043D\u043E \u0448\u0438\u043F\u044F.
      \u041E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F \u0444\u0438\u043D\u0438\u043A\u0438
      \u0441\u043F\u0430\u0441\u0435\u043D\u044B. \u041C\u0435\u0448\u043E\u043A
      \u0437\u0430\u0448\u0438\u043B\u0438. \u0412\u0430\u0440\u0430\u043D \u0441\u043A\u0440\u044B\u043B\u0441\u044F
      \u0437\u0430 \u043A\u0430\u043C\u043D\u044F\u043C\u0438 - \u0432\u0438\u0434\u043D\u043E,
      \u0437\u0434\u0435\u0441\u044C \u0435\u0433\u043E \u043E\u0431\u044B\u0447\u043D\u0430\u044F
      \u043E\u0445\u043E\u0442\u043D\u0438\u0447\u044C\u044F \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830573
    m_Localized: "\u041F\u043E\u0437\u0432\u043E\u043B\u0438\u0442\u044C \u0434\u043E\u0435\u0441\u0442\u044C
      - \u0440\u0430\u0434\u0438 \u043C\u0438\u0440\u0430 \u0432 \u043B\u0430\u0433\u0435\u0440\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830574
    m_Localized: "\u0412\u0430\u0440\u0430\u043D \u0434\u043E\u0435\u043B \u0444\u0438\u043D\u0438\u043A\u0438
      \u0438 \u0443\u0448\u0451\u043B. \u041E\u0434\u0438\u043D \u043C\u0435\u0448\u043E\u043A
      \u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u043D.
      \u0417\u0430\u0442\u043E \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B
      \u0438 \u043D\u0435 \u043F\u043E\u0442\u0440\u0435\u0432\u043E\u0436\u0438\u043B
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435. \u041F\u0443\u0441\u0442\u044B\u043D\u043D\u044B\u0435
      \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u044B \u0433\u043E\u0432\u043E\u0440\u044F\u0442
      - \u0432\u0430\u0440\u0430\u043D\u0430 \u043B\u0443\u0447\u0448\u0435 \u043D\u0435
      \u0437\u043B\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830575
    m_Localized: "\u0423\u0431\u0438\u0442\u044C \u0434\u043B\u044F \u043D\u0430\u0443\u043A\u0438
      - \u0438\u0437\u0443\u0447\u0438\u0442\u044C \u0432\u0438\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830576
    m_Localized: "\u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u043F\u0440\u043E\u043C\u0430\u0445\u043D\u0443\u043B\u0441\u044F
      \u043A\u043E\u043F\u044C\u0451\u043C. \u0412\u0430\u0440\u0430\u043D \u0443\u0434\u0430\u0440\u0438\u043B
      \u0445\u0432\u043E\u0441\u0442\u043E\u043C \u0438 \u0440\u0430\u0437\u0431\u0438\u043B
      \u0433\u043B\u0438\u043D\u044F\u043D\u044B\u0439 \u043A\u0443\u0432\u0448\u0438\u043D.
      \u0412\u0442\u043E\u0440\u043E\u0439 \u0443\u0434\u0430\u0440 \u0434\u043E\u0441\u0442\u0430\u043B
      \u0435\u0433\u043E. \u0428\u043A\u0443\u0440\u0430 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043D\u0430\u044F,
      \u043D\u043E \u044D\u0442\u043E \u043D\u0435 \u0441\u0442\u043E\u0438\u043B\u043E
      \u0440\u0430\u0437\u0431\u0438\u0442\u043E\u0433\u043E \u043A\u0443\u0432\u0448\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830577
    m_Localized: "\u0424\u0435\u043D\u0435\u043A \u0441 \u043F\u043E\u0434\u0440\u0430\u043D\u043A\u043E\u043C
      - \u043F\u043B\u043E\u0445\u043E\u0439 \u0437\u043D\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830578
    m_Localized: "\u041D\u0430 \u0437\u0430\u043A\u0430\u0442\u0435 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439
      \u0444\u0435\u043D\u0435\u043A \u0441 \u043D\u0435\u043F\u0440\u043E\u043F\u043E\u0440\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E
      \u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438 \u0443\u0448\u0430\u043C\u0438
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043F\u0440\u044F\u043C\u043E \u043A
      \u0434\u043E\u0440\u043E\u0433\u0435 \u0438 \u0441\u0430\u0434\u0438\u0442\u0441\u044F
      \u0432 \u043F\u044F\u0442\u0438 \u0448\u0430\u0433\u0430\u0445 - \u0432 \u0437\u0443\u0431\u0430\u0445
      \u0442\u0440\u0435\u043F\u044B\u0445\u0430\u0435\u0442\u0441\u044F \u044F\u0449\u0435\u0440\u0438\u0446\u0430.
      \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u043E\u0431\u043E\u0437
      \u0431\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0430. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A-\u043F\u0435\u0440\u0441
      \u0410\u0445\u043C\u0430\u0434 \u0431\u043B\u0435\u0434\u043D\u0435\u0435\u0442
      \u0438 \u0433\u043E\u0432\u043E\u0440\u0438\u0442: \u0432 \u0425\u043E\u0440\u0430\u0441\u0430\u043D\u0435
      \u0444\u0435\u043D\u0435\u043A \u0443 \u0434\u043E\u0440\u043E\u0433\u0438
      \u0441 \u0434\u043E\u0431\u044B\u0447\u0435\u0439 \u0432 \u0437\u0443\u0431\u0430\u0445
      - \u043A \u0441\u043C\u0435\u0440\u0442\u0438 \u043E\u0434\u043D\u043E\u0433\u043E
      \u0438\u0437 \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u0432. \u0414\u0440\u0443\u0433\u0438\u0435
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u043F\u0435\u0440\u0435\u0448\u0451\u043F\u0442\u044B\u0432\u0430\u044E\u0442\u0441\u044F.
      \u0421\u0442\u0440\u0430\u0445 \u0438\u0440\u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439,
      \u043D\u043E \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435 \u0438\u0440\u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0435
      - \u044D\u0442\u043E \u0442\u043E\u0436\u0435 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830579
    m_Localized: "\u041F\u043E\u0441\u043C\u0435\u044F\u0442\u044C\u0441\u044F \u043D\u0430\u0434
      \u0441\u0443\u0435\u0432\u0435\u0440\u0438\u044F\u043C\u0438 \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830580
    m_Localized: "\u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B
      \u043F\u0443\u0442\u044C. \u0424\u0435\u043D\u0435\u043A \u0443\u0431\u0435\u0436\u0430\u043B
      \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u044E. \u041D\u0438\u0447\u0435\u0433\u043E
      \u0441\u0442\u0440\u0430\u0448\u043D\u043E\u0433\u043E \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0434\u0435\u043D\u044C.
      \u0421\u0443\u0435\u0432\u0435\u0440\u0438\u0435 \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C
      \u0441\u0443\u0435\u0432\u0435\u0440\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830581
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      - \u043F\u0440\u043E\u0447\u0435\u0441\u0442\u044C \u043C\u043E\u043B\u0438\u0442\u0432\u0443
      \u0438 \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C \u043D\u043E\u0447\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830582
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u043B\u0438 \u043D\u043E\u0447\u044C
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435. \u0410\u0445\u043C\u0430\u0434
      \u043F\u043E\u043C\u043E\u043B\u0438\u043B\u0441\u044F. \u0423\u0442\u0440\u043E\u043C
      \u0442\u0440\u043E\u043D\u0443\u043B\u0438\u0441\u044C \u0431\u0435\u0437 \u0442\u0440\u0435\u0432\u043E\u0433\u0438.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u043F\u043E\u043B\u0434\u043D\u044F.
      \u041B\u044E\u0434\u0438 \u0448\u043B\u0438 \u0431\u043E\u0434\u0440\u0435\u0435
      - \u0441\u0442\u0440\u0430\u0445 \u0432\u044B\u0448\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830583
    m_Localized: "\u0421\u0443\u0440\u043A\u0438 \u0431\u0435\u0433\u0443\u0442 -
      \u043A \u0431\u0443\u0440\u0435 \u0438\u043B\u0438 \u0445\u0438\u0449\u043D\u0438\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830584
    m_Localized: "\u0426\u0435\u043B\u0430\u044F \u043A\u043E\u043B\u043E\u043D\u0438\u044F
      \u043C\u043E\u043D\u0433\u043E\u043B\u044C\u0441\u043A\u0438\u0445 \u0441\u0443\u0440\u043A\u043E\u0432
      \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u0432\u044B\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u0435\u0442
      \u0438\u0437 \u043D\u043E\u0440 \u0438 \u043D\u0435\u0441\u0451\u0442\u0441\u044F
      \u043F\u0440\u043E\u0447\u044C \u043E\u0442 \u0441\u0432\u043E\u0435\u0439
      \u0433\u043E\u0440\u043A\u0438 - \u0432\u0441\u044F, \u0440\u0430\u0437\u043E\u043C,
      \u0431\u0435\u0437 \u0435\u0434\u0438\u043D\u043E\u0433\u043E \u0437\u0432\u0443\u043A\u0430.
      \u042D\u0442\u043E \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u043E: \u0441\u0443\u0440\u043A\u0438
      \u043B\u0438\u0431\u043E \u043A\u0440\u0438\u0447\u0430\u0442 \u0442\u0440\u0435\u0432\u043E\u0433\u0443,
      \u043B\u0438\u0431\u043E \u043F\u0440\u044F\u0447\u0443\u0442\u0441\u044F \u0432
      \u043D\u043E\u0440\u044B. \u0422\u0438\u0445\u043E\u0435 \u043C\u0430\u0441\u0441\u043E\u0432\u043E\u0435
      \u0431\u0435\u0433\u0441\u0442\u0432\u043E \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442
      \u0447\u0442\u043E-\u0442\u043E \u043A\u0440\u0443\u043F\u043D\u043E\u0435
      \u0438 \u0431\u043B\u0438\u0437\u043A\u043E\u0435. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0411\u0443\u0433\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442: \"\u041B\u0438\u0431\u043E
      \u0441\u043D\u0435\u0436\u043D\u044B\u0439 \u0431\u0430\u0440\u0441 \u0432
      \u0442\u0440\u0451\u0445\u0441\u0442\u0430\u0445 \u0448\u0430\u0433\u0430\u0445,
      \u043B\u0438\u0431\u043E \u0431\u0443\u0440\u044F \u0447\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441\". \u041D\u0435\u0431\u043E \u0447\u0438\u0441\u0442\u043E\u0435,
      \u043D\u043E \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442 \u0447\u0443\u0442\u044C
      \u043C\u0443\u0442\u043D\u043E\u0432\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830585
    m_Localized: "\u041D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0438\u0441\u043A\u0430\u0442\u044C
      \u0443\u043A\u0440\u044B\u0442\u0438\u0435 - \u0437\u0430 \u0433\u043E\u0440\u043D\u044B\u043C
      \u0432\u044B\u0441\u0442\u0443\u043F\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830586
    m_Localized: "\u0421\u043F\u0440\u044F\u0442\u0430\u043B\u0438\u0441\u044C \u0437\u0430
      \u0441\u043A\u0430\u043B\u043E\u0439. \u0427\u0435\u0440\u0435\u0437 \u0441\u043E\u0440\u043E\u043A
      \u043C\u0438\u043D\u0443\u0442 \u043D\u0430\u043B\u0435\u0442\u0435\u043B \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u044B\u0439
      \u0443\u0440\u0430\u0433\u0430\u043D \u0441 \u0433\u0440\u0430\u0434\u043E\u043C.
      \u0411\u0435\u0437 \u0443\u043A\u0440\u044B\u0442\u0438\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0431\u044B \u0442\u044E\u043A\u0438 \u0438 \u043B\u044E\u0434\u0435\u0439.
      \u0421\u0443\u0440\u043A\u0438 \u0437\u043D\u0430\u043B\u0438 \u043B\u0443\u0447\u0448\u0435
      \u043B\u044E\u0434\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830587
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0438 \u043E\u0433\u043B\u044F\u0434\u0435\u0442\u044C\u0441\u044F - \u043D\u0430
      \u043F\u043E\u0438\u0441\u043A \u0431\u0430\u0440\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830588
    m_Localized: "\u041F\u043E\u0438\u0441\u043A \u043D\u0438\u0447\u0435\u0433\u043E
      \u043D\u0435 \u0434\u0430\u043B. \u0427\u0435\u0440\u0435\u0437 \u043F\u043E\u043B\u0447\u0430\u0441\u0430
      \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F \u0432\u0435\u0442\u0435\u0440.
      \u0411\u0443\u0440\u044F \u0437\u0430\u0441\u0442\u0430\u043B\u0430 \u0432
      \u043F\u0443\u0442\u0438. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043E\u0434\u0438\u043D \u0434\u0435\u043D\u044C \u0438\u0437-\u0437\u0430
      \u043D\u0435\u043F\u043E\u0433\u043E\u0434\u044B. \u0411\u0430\u0440\u0441\u0430
      \u043D\u0435 \u043D\u0430\u0448\u043B\u0438 - \u0431\u044B\u043B \u043B\u0438
      \u043E\u043D \u0442\u0430\u043C, \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830589
    m_Localized: "\u041D\u0435 \u043E\u0431\u0440\u0430\u0449\u0430\u0442\u044C \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u044F
      - \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830590
    m_Localized: "\u0423\u0440\u0430\u0433\u0430\u043D \u043D\u0430\u043A\u0440\u044B\u043B
      \u043E\u0431\u043E\u0437 \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u043C
      \u043F\u043B\u0430\u0442\u043E. \u0422\u0440\u0438 \u0442\u044E\u043A\u0430
      \u0443\u043D\u0435\u0441\u043B\u043E \u0432\u0435\u0442\u0440\u043E\u043C.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u043B\u043E\u0436\u0438\u043B\u0438\u0441\u044C
      \u043E\u0442 \u0441\u0442\u0440\u0430\u0445\u0430. \u041B\u044E\u0434\u0438
      \u0441\u0432\u044F\u0437\u0430\u043B\u0438\u0441\u044C \u0432\u0435\u0440\u0451\u0432\u043A\u043E\u0439,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C\u0441\u044F.
      \u0421\u0443\u0440\u043A\u0438 \u0437\u043D\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830591
    m_Localized: "\u0421\u0442\u0430\u044F \u043A\u0443\u0440\u043E\u043F\u0430\u0442\u043E\u043A
      \u0432 \u0433\u043E\u0440\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830592
    m_Localized: "\u041D\u0430 \u0433\u043E\u0440\u043D\u043E\u043C \u043B\u0443\u0433\u0443
      \u043F\u0435\u0440\u0435\u0434 \u043E\u0431\u043E\u0437\u043E\u043C \u0432\u0437\u043B\u0435\u0442\u0430\u0435\u0442
      \u043E\u0433\u0440\u043E\u043C\u043D\u0430\u044F \u0441\u0442\u0430\u044F \u043A\u0435\u043A\u043B\u0438\u043A\u043E\u0432
      - \u0433\u043E\u0440\u043D\u044B\u0445 \u043A\u0443\u0440\u043E\u043F\u0430\u0442\u043E\u043A.
      \u0421\u043E\u0442\u043D\u0438 \u043F\u0442\u0438\u0446, \u0440\u044B\u0436\u0435\u0432\u0430\u0442\u044B\u0445
      \u0441 \u0431\u0435\u043B\u043E\u0439 \u0449\u0435\u043A\u043E\u0439 \u0438
      \u0447\u0451\u0440\u043D\u044B\u043C \u043E\u0436\u0435\u0440\u0435\u043B\u044C\u0435\u043C,
      \u0432\u0437\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0438\u0437 \u0442\u0440\u0430\u0432\u044B
      \u0438 \u043D\u0435\u0441\u0443\u0442\u0441\u044F \u043F\u0440\u043E\u0447\u044C
      \u0441 \u0440\u0435\u0437\u043A\u0438\u043C \u043A\u0440\u0438\u043A\u043E\u043C
      \"\u043A\u0435-\u043A\u0435-\u043A\u0435\". \u041E\u043D\u0438 \u043E\u043F\u0443\u0441\u043A\u0430\u044E\u0442\u0441\u044F
      \u0432 \u0441\u0442\u0430 \u0448\u0430\u0433\u0430\u0445. \u0421\u043D\u043E\u0432\u0430.
      \u0418 \u0441\u043D\u043E\u0432\u0430. \u041F\u0442\u0438\u0446 \u0442\u0430\u043A
      \u043C\u043D\u043E\u0433\u043E, \u0447\u0442\u043E \u0438\u0445 \u043C\u043E\u0436\u043D\u043E
      \u0431\u0440\u0430\u0442\u044C \u0440\u0443\u043A\u0430\u043C\u0438. \u041B\u0443\u0447\u043D\u0438\u043A\u0438
      \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F.
      \u0421\u0432\u0435\u0436\u0435\u0435 \u043C\u044F\u0441\u043E \u043F\u043E\u043F\u043E\u043B\u043D\u0438\u043B\u043E
      \u0431\u044B \u0437\u0430\u043F\u0430\u0441\u044B \u043D\u0430 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830593
    m_Localized: "\u041E\u0445\u043E\u0442\u0438\u0442\u044C\u0441\u044F - \u0434\u043E\u0431\u044B\u0442\u044C
      \u043C\u044F\u0441\u043E \u043D\u0430 \u0442\u0440\u0438 \u0434\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830594
    m_Localized: "\u0417\u0430 \u0447\u0430\u0441 \u043E\u0445\u043E\u0442\u044B
      \u0434\u043E\u0431\u044B\u043B\u0438 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C
      \u043F\u0442\u0438\u0446. \u0421\u0432\u0435\u0436\u0435\u0435 \u043C\u044F\u0441\u043E
      \u043D\u0430 \u0442\u0440\u0438 \u0434\u043D\u044F. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0437\u0430\u0436\u0430\u0440\u0438\u043B\u0438 \u043A\u0435\u043A\u043B\u0438\u043A\u043E\u0432
      \u043D\u0430 \u0443\u0433\u043B\u044F\u0445 \u0441 \u0434\u0438\u043A\u043E\u0439
      \u043C\u044F\u0442\u043E\u0439. \u041B\u0443\u0447\u0448\u0438\u0439 \u0443\u0436\u0438\u043D
      \u0437\u0430 \u0434\u0432\u0435 \u043D\u0435\u0434\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830595
    m_Localized: "\u041F\u043E\u0439\u043C\u0430\u0442\u044C \u0442\u0440\u0451\u0445
      \u043F\u0442\u0438\u0446 \u0436\u0438\u0432\u044C\u0451\u043C - \u043F\u0440\u043E\u0434\u0430\u0442\u044C
      \u0432 \u0433\u043E\u0440\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830596
    m_Localized: "\u0422\u0440\u0451\u0445 \u043A\u0435\u043A\u043B\u0438\u043A\u043E\u0432
      \u043F\u043E\u0439\u043C\u0430\u043B\u0438 \u0432 \u043D\u0430\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0435
      \u0448\u0430\u043F\u043A\u0438. \u0412 \u041A\u0430\u0448\u0433\u0430\u0440\u0435
      \u0434\u0435\u043A\u043E\u0440\u0430\u0442\u0438\u0432\u043D\u044B\u0435 \u0433\u043E\u0440\u043D\u044B\u0435
      \u043A\u0443\u0440\u043E\u043F\u0430\u0442\u043A\u0438 \u0446\u0435\u043D\u044F\u0442\u0441\u044F.
      \u041F\u0440\u043E\u0434\u0430\u043B\u0438 \u0437\u0430 \u0432\u043E\u0441\u0435\u043C\u044C
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u043D\u0430 \u0440\u044B\u043D\u043A\u0435
      \u043F\u0442\u0438\u0446\u0435\u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0435\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830597
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u043F\u0442\u0438\u0446
      - \u043F\u0443\u0441\u0442\u044C \u043B\u0435\u0442\u044F\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830598
    m_Localized: "\u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B \u043C\u0438\u043C\u043E.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
      \u0432\u0441\u043B\u0435\u0434 \u0441\u0442\u0430\u0435 \u0441 \u043D\u0435\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u043C\u044B\u043C
      \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u0435\u043C. \u041C\u044F\u0441\u0430
      \u043D\u0435 \u0434\u043E\u0431\u044B\u043B\u0438, \u0437\u0430\u0442\u043E
      \u043F\u0442\u0438\u0446\u044B \u0440\u0430\u0437\u043B\u0435\u0442\u0435\u043B\u0438\u0441\u044C
      \u043A\u0440\u0430\u0441\u0438\u0432\u044B\u043C \u043E\u0431\u043B\u0430\u043A\u043E\u043C
      \u043D\u0430\u0434 \u0433\u043E\u0440\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830599
    m_Localized: "\u0420\u0435\u0434\u043A\u0438\u0439 \u0441\u0430\u0439\u0433\u0430\u043A
      \u0441 \u0440\u043E\u0433\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830600
    m_Localized: "\u041D\u0430 \u043A\u0440\u0430\u044E \u0441\u0442\u0435\u043F\u0438
      \u0441\u0442\u043E\u0438\u0442 \u043E\u0434\u0438\u043D\u043E\u043A\u0438\u0439
      \u0441\u0430\u043C\u0435\u0446 \u0441\u0430\u0439\u0433\u0430\u043A\u0430 \u0441
      \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u044B\u043C\u0438 \u043B\u0438\u0440\u043E\u0432\u0438\u0434\u043D\u044B\u043C\u0438
      \u0440\u043E\u0433\u0430\u043C\u0438 \u0438 \u0432\u0437\u0434\u0443\u0442\u044B\u043C
      \u0445\u043E\u0431\u043E\u0442\u043E\u043E\u0431\u0440\u0430\u0437\u043D\u044B\u043C
      \u043D\u043E\u0441\u043E\u043C. \u041E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u043E\u0431\u043E\u0437\u0430
      \u0431\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0430. \u0412 \u0441\u0442\u0430
      \u0448\u0430\u0433\u0430\u0445 \u043F\u043E\u0437\u0430\u0434\u0438 - \u0442\u0440\u043E\u0435
      \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432 \u043D\u0430 \u043B\u043E\u0448\u0430\u0434\u044F\u0445
      \u0441 \u043B\u0443\u043A\u0430\u043C\u0438, \u043E\u043D\u0438 \u0441\u043B\u0435\u0434\u044F\u0442
      \u0437\u0430 \u043E\u0431\u043E\u0437\u043E\u043C, \u043E\u043F\u0430\u0441\u0430\u044F\u0441\u044C
      \u0441\u043F\u0443\u0433\u043D\u0443\u0442\u044C \u0434\u043E\u0431\u044B\u0447\u0443.
      \u041E\u0434\u0438\u043D \u0438\u0437 \u043D\u0438\u0445 \u043A\u0440\u0438\u0447\u0438\u0442:
      \"\u041D\u0435 \u0434\u0432\u0438\u0433\u0430\u0439\u0442\u0435\u0441\u044C
      - \u043E\u043D \u043D\u0430\u0448\". \u0421\u0430\u0439\u0433\u0430\u043A \u0441
      \u0442\u0430\u043A\u0438\u043C\u0438 \u0440\u043E\u0433\u0430\u043C\u0438 \u043D\u0430
      \u0440\u044B\u043D\u043A\u0435 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430
      \u0441\u0442\u043E\u0438\u0442 \u0432\u0442\u0440\u043E\u0435 \u0434\u043E\u0440\u043E\u0436\u0435
      \u043E\u0431\u044B\u0447\u043D\u043E\u0439 \u0434\u0438\u0447\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830601
    m_Localized: "\u0423\u0441\u0442\u0443\u043F\u0438\u0442\u044C - \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u044C
      \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u043E\u0432, \u043F\u0443\u0441\u0442\u044C
      \u0431\u0435\u0440\u0443\u0442 \u0441\u0432\u043E\u0451"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830602
    m_Localized: "\u041E\u0431\u043E\u0437 \u0432\u0441\u0442\u0430\u043B. \u041E\u0445\u043E\u0442\u043D\u0438\u043A\u0438
      \u0432\u044B\u043F\u0443\u0441\u0442\u0438\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u044B.
      \u0421\u0430\u0439\u0433\u0430\u043A \u0443\u043F\u0430\u043B. \u041E\u0445\u043E\u0442\u043D\u0438\u043A\u0438
      \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B\u0438
      - \u043E\u0434\u0438\u043D \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u043B
      \u043E\u0431\u043E\u0437 \u0434\u043E \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438
      \u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u043B \u0445\u043E\u0440\u043E\u0448\u0438\u0439
      \u0432\u043E\u0434\u043E\u043F\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830603
    m_Localized: "\u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C \u0441\u0430\u0439\u0433\u0430\u043A\u0430
      - \u043F\u043E\u0440\u0447\u0430 \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u0430\u043C,
      \u0437\u0430\u0442\u043E \u0431\u0435\u0437 \u0441\u0442\u0440\u0435\u043B
      \u0440\u044F\u0434\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830604
    m_Localized: "\u0421\u0430\u0439\u0433\u0430\u043A \u0443\u0431\u0435\u0436\u0430\u043B.
      \u041E\u0445\u043E\u0442\u043D\u0438\u043A\u0438 \u0437\u0430\u043A\u0440\u0438\u0447\u0430\u043B\u0438
      \u0432 \u044F\u0440\u043E\u0441\u0442\u0438. \u041E\u0434\u0438\u043D \u0432\u044B\u0441\u0442\u0440\u0435\u043B\u0438\u043B
      \u0441\u0442\u0440\u0435\u043B\u043E\u0439 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043E\u0431\u043E\u0437\u0430 - \u043D\u0435 \u043F\u043E\u043F\u0430\u043B,
      \u043D\u043E \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      \u044F\u0441\u043D\u043E\u0435. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0432 \u043E\u043A\u0440\u0443\u0433\u0435 \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830605
    m_Localized: "\u041F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u0442\u044C \u043E\u0445\u043E\u0442\u043D\u0438\u043A\u0430\u043C
      \u043A\u0443\u043F\u0438\u0442\u044C \u0434\u043E\u0431\u044B\u0447\u0443 \u0443
      \u043D\u0438\u0445 \u043F\u043E\u0441\u043B\u0435 \u043E\u0445\u043E\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830606
    m_Localized: "\u041E\u0445\u043E\u0442\u043D\u0438\u043A\u0438 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0438\u0441\u044C
      \u043F\u0440\u043E\u0434\u0430\u0442\u044C \u0440\u043E\u0433\u0430 \u0438
      \u0447\u0430\u0441\u0442\u044C \u043C\u044F\u0441\u0430. \u041F\u043E\u0434\u043E\u0436\u0434\u0430\u043B\u0438
      \u043F\u043E\u043B\u0447\u0430\u0441\u0430. \u0420\u043E\u0433\u0430 \u0441\u0430\u0439\u0433\u0430\u043A\u0430
      \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435 \u043F\u0440\u0438\u043D\u0435\u0441\u043B\u0438
      \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u0446\u0435\u043D\u0443 \u0443
      \u0430\u043F\u0442\u0435\u043A\u0430\u0440\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830607
    m_Localized: "\u0421\u0442\u0430\u0440\u044B\u0439 \u0432\u043E\u043B\u043A \u0443
      \u0434\u043E\u0440\u043E\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830608
    m_Localized: "\u0412\u043E\u0442 \u0443\u0436\u0435 \u0442\u0440\u0438 \u0434\u043D\u044F
      \u043E\u0434\u0438\u043D \u0432\u043E\u043B\u043A \u0438\u0434\u0451\u0442
      \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u043E \u043E\u0431\u043E\u0437\u0443
      - \u0432 \u0441\u0442\u0430-\u0434\u0432\u0443\u0445\u0441\u0442\u0430\u0445
      \u0448\u0430\u0433\u0430\u0445, \u0442\u043E \u0441\u043F\u0440\u0430\u0432\u0430,
      \u0442\u043E \u0441\u043B\u0435\u0432\u0430. \u041E\u043D \u0441\u0442\u0430\u0440\u044B\u0439:
      \u0448\u0435\u0440\u0441\u0442\u044C \u0441\u0435\u0440\u0430\u044F \u0441
      \u043F\u0440\u043E\u0441\u0435\u0434\u044C\u044E, \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0435, \u043D\u043E \u0442\u043E\u0447\u043D\u044B\u0435.
      \u041D\u0435 \u043D\u0430\u043F\u0430\u0434\u0430\u0435\u0442. \u041D\u0435
      \u0443\u0431\u0435\u0433\u0430\u0435\u0442. \u041F\u0440\u043E\u0441\u0442\u043E
      \u0438\u0434\u0451\u0442. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A-\u0442\u044E\u0440\u043E\u043A
      \u041A\u044E\u043B\u044C \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E:
      \"\u041F\u043E \u0441\u0442\u0435\u043F\u043D\u044B\u043C \u043F\u043E\u0432\u0435\u0440\u044C\u044F\u043C,
      \u043E\u0434\u0438\u043D\u043E\u043A\u0438\u0439 \u0432\u043E\u043B\u043A,
      \u0438\u0434\u0443\u0449\u0438\u0439 \u0441 \u043F\u0443\u0442\u043D\u0438\u043A\u043E\u043C
      \u0442\u0440\u0438 \u0434\u043D\u044F, - \u044D\u0442\u043E \u043C\u0451\u0440\u0442\u0432\u044B\u0439
      \u043F\u0440\u0435\u0434\u043E\u043A, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u0432\u0435\u0434\u0451\u0442 \u043A \u0447\u0435\u043C\u0443-\u0442\u043E.
      \u0418\u043B\u0438 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u0435\u0442\".
      \u041E\u0431\u044A\u044F\u0441\u043D\u0435\u043D\u0438\u0439 \u043F\u0440\u0438\u0440\u043E\u0434\u043D\u044B\u0445
      \u043D\u0435\u0442: \u0441\u0442\u0430\u0438 \u0437\u0434\u0435\u0441\u044C
      \u043D\u0435\u0442, \u0434\u043E\u0431\u044B\u0447\u0438 \u0443 \u0432\u043E\u043B\u043A\u0430
      \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830609
    m_Localized: "\u0418\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      - \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u0442\u0430\u0440\u044B\u0439
      \u0432\u043E\u043B\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830610
    m_Localized: "\u041D\u0430 \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u044B\u0439
      \u0434\u0435\u043D\u044C \u0432\u043E\u043B\u043A \u0438\u0441\u0447\u0435\u0437.
      \u041D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0440\u0430\u0437\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u043D\u044B
      \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0438\u0435\u043C \u0437\u043D\u0430\u043C\u0435\u043D\u0438\u044F
      - \u0438\u043B\u0438 \u043E\u0431\u043B\u0435\u0433\u0447\u0435\u043D\u044B.
      \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B
      \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830611
    m_Localized: "\u041E\u0441\u0442\u0430\u0432\u043B\u044F\u0442\u044C \u0435\u043C\u0443
      \u043C\u044F\u0441\u043E \u043A\u0430\u0436\u0434\u044B\u0439 \u0432\u0435\u0447\u0435\u0440
      - \u0437\u0430\u0434\u043E\u0431\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830612
    m_Localized: "\u0412\u043E\u043B\u043A \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u043B
      \u043C\u044F\u0441\u043E. \u041D\u0430 \u043F\u044F\u0442\u044B\u0439 \u0434\u0435\u043D\u044C
      \u043E\u043D \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B \u043D\u0430
      \u0441\u0435\u0432\u0435\u0440 \u0438 \u0443\u0448\u0451\u043B \u0432 \u0441\u0442\u0435\u043F\u044C.
      \u041A\u044E\u043B\u044C \u0441\u043A\u0430\u0437\u0430\u043B: \"\u0414\u0430\u043B
      \u0432\u0441\u0451, \u0447\u0442\u043E \u043C\u043E\u0433. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0434\u043E\u0432\u043E\u043B\u0435\u043D\". \u041F\u0440\u043E\u0432\u0438\u0437\u0438\u044F
      \u0443\u0431\u044B\u043B\u0430, \u043D\u043E \u043B\u044E\u0434\u0438 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u044E\u0442
      \u0441\u0435\u0431\u044F \u043B\u0443\u0447\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830613
    m_Localized: "\u0421\u0447\u0438\u0442\u0430\u0442\u044C \u0435\u0433\u043E \u0434\u043E\u0431\u0440\u044B\u043C
      \u0437\u043D\u0430\u043A\u043E\u043C \u0438 \u0438\u0434\u0442\u0438 \u0431\u044B\u0441\u0442\u0440\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830614
    m_Localized: "\u041E\u0431\u043E\u0437 \u0443\u0441\u043A\u043E\u0440\u0438\u043B\u0441\u044F.
      \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435 \u0443 \u043B\u044E\u0434\u0435\u0439
      \u043F\u043E\u0434\u043D\u044F\u043B\u043E\u0441\u044C - \u0432\u0435\u0440\u0438\u043B\u0438
      \u0432 \u0437\u043D\u0430\u043A. \u041D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439
      \u0434\u0435\u043D\u044C \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E \u0445\u043E\u0434\u0430
      \u043D\u0430\u0448\u043B\u0438 \u0445\u043E\u0440\u043E\u0448\u0443\u044E \u0441\u0442\u043E\u044F\u043D\u043A\u0443
      \u0441 \u0432\u043E\u0434\u043E\u0439. \u0412\u043E\u043B\u043A \u0438\u0441\u0447\u0435\u0437
      \u0432 \u0442\u0443 \u0436\u0435 \u043D\u043E\u0447\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830615
    m_Localized: "\u0412\u0435\u0440\u0431\u043B\u044E\u0434\u0438\u0446\u0430 \u0440\u043E\u0436\u0430\u0435\u0442
      \u0432 \u043F\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830616
    m_Localized: "\u0412\u0435\u0440\u0431\u043B\u044E\u0434\u0438\u0446\u0430 \u0438\u0437
      \u043E\u0431\u043E\u0437\u0430 \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E
      \u043B\u043E\u0436\u0438\u0442\u0441\u044F \u0438 \u043D\u0435 \u0432\u0441\u0442\u0430\u0451\u0442.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0421\u0430\u043C\u0435\u0445
      \u043F\u043E\u0434\u0431\u0435\u0433\u0430\u0435\u0442 - \u0441\u0445\u0432\u0430\u0442\u043A\u0438.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u043E\u0436\u0438\u0434\u0430\u043B:
      \u043E\u043D\u0430 \u0440\u043E\u0436\u0430\u043B\u0430 \u0441\u043A\u0440\u044B\u0442\u043D\u043E.
      \u0414\u0430\u0442\u0430 \u0440\u043E\u0434\u043E\u0432 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D\u0430
      \u043D\u0435\u0432\u0435\u0440\u043D\u043E. \u0412\u0435\u0440\u0431\u043B\u044E\u0436\u043E\u043D\u043E\u043A
      \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043F\u0435\u0440\u0435\u0434\u043D\u0438\u043C\u0438
      \u043D\u043E\u0433\u0430\u043C\u0438. \u0420\u043E\u0434\u044B \u0443 \u0431\u0430\u043A\u0442\u0440\u0438\u0439\u0441\u043A\u043E\u0439
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0438\u0446\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0442
      \u043E\u0442 \u043F\u043E\u043B\u0443\u0447\u0430\u0441\u0430 \u0434\u043E
      \u0442\u0440\u0451\u0445 \u0447\u0430\u0441\u043E\u0432. \u0415\u0441\u043B\u0438
      \u043D\u0435 \u043F\u043E\u043C\u043E\u0447\u044C - \u0440\u0438\u0441\u043A
      \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C \u0438 \u043C\u0430\u0442\u044C,
      \u0438 \u0434\u0435\u0442\u0451\u043D\u044B\u0448\u0430. \u041E\u0431\u043E\u0437
      \u0441\u0442\u043E\u0438\u0442. \u0416\u0434\u0430\u0442\u044C \u0438\u043B\u0438
      \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C?"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830617
    m_Localized: "\u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F
      \u0438 \u043F\u043E\u043C\u043E\u0447\u044C - \u043B\u0435\u043A\u0430\u0440\u044C
      \u0438 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0432\u043C\u0435\u0441\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830618
    m_Localized: "\u0420\u043E\u0434\u044B \u0437\u0430\u043D\u044F\u043B\u0438 \u0447\u0430\u0441
      \u0441\u043E\u0440\u043E\u043A. \u0412\u0435\u0440\u0431\u043B\u044E\u0436\u043E\u043D\u043E\u043A
      \u0440\u044B\u0436\u0438\u0439, \u043C\u043E\u0445\u043D\u0430\u0442\u044B\u0439
      - \u0432\u0441\u0442\u0430\u043B \u043D\u0430 \u043D\u043E\u0433\u0438 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043C\u0438\u043D\u0443\u0442.
      \u041C\u0430\u0442\u044C \u0438 \u0434\u0435\u0442\u0451\u043D\u044B\u0448
      \u0437\u0434\u043E\u0440\u043E\u0432\u044B. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438 \u043C\u043E\u043B\u0447\u0430,
      \u043A\u0430\u043A \u043E\u043D \u0434\u0435\u043B\u0430\u0435\u0442 \u043F\u0435\u0440\u0432\u044B\u0435
      \u0448\u0430\u0433\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830619
    m_Localized: "\u0423\u0441\u043A\u043E\u0440\u0438\u0442\u044C \u0440\u043E\u0434\u044B
      - \u043D\u0435 \u0436\u0434\u0430\u0442\u044C \u043B\u0438\u0448\u043D\u0435\u0433\u043E
      \u0447\u0430\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830620
    m_Localized: "\u041D\u0435\u0443\u0434\u0430\u0447\u043D\u043E\u0435 \u0432\u043C\u0435\u0448\u0430\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0436\u043E\u043D\u043E\u043A \u0440\u043E\u0434\u0438\u043B\u0441\u044F
      \u0441\u043B\u0430\u0431\u044B\u043C. \u041C\u0430\u0442\u044C \u0436\u0438\u0432\u0430,
      \u0434\u0435\u0442\u0451\u043D\u044B\u0448 \u0432\u044B\u0436\u0438\u043B,
      \u043D\u043E \u043F\u0435\u0440\u0432\u044B\u0435 \u0434\u043D\u0438 \u043E\u043D
      \u0448\u0451\u043B \u043D\u0430 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0435,
      \u0430 \u043D\u0435 \u0441\u0432\u043E\u0438\u043C\u0438 \u043D\u043E\u0433\u0430\u043C\u0438.
      \u041F\u043E\u0442\u0435\u0440\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830621
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C \u043D\u043E\u0432\u043E\u0440\u043E\u0436\u0434\u0451\u043D\u043D\u043E\u0433\u043E
      \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u043E\u043D\u043A\u0430 \u043F\u0435\u0440\u0432\u043E\u043C\u0443
      \u0432\u0441\u0442\u0440\u0435\u0447\u043D\u043E\u043C\u0443 \u043A\u0443\u043F\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830622
    m_Localized: "\u041F\u0440\u043E\u0435\u0437\u0436\u0438\u0439 \u043A\u0443\u043F\u0435\u0446
      \u0438\u0437 \u0411\u0430\u043B\u0445\u0430 \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0437\u0430 \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u043E\u043D\u043A\u0430.
      \u0425\u043E\u0440\u043E\u0448\u0430\u044F \u0446\u0435\u043D\u0430. \u041C\u0430\u0442\u044C
      \u043F\u043E\u0448\u043B\u0430 \u0434\u0430\u043B\u044C\u0448\u0435. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438
      \u043A\u043E\u0441\u0438\u043B\u0438\u0441\u044C - \u043F\u0440\u043E\u0434\u0430\u043B\u0438
      \u0442\u043E\u043B\u044C\u043A\u043E \u0447\u0442\u043E \u0440\u043E\u0436\u0434\u0451\u043D\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830623
    m_Localized: "\u041F\u043E\u0447\u0442\u043E\u0432\u044B\u0439 \u0441\u043E\u043A\u043E\u043B
      \u0441 \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830624
    m_Localized: "\u0421\u043E\u043A\u043E\u043B \u043A\u0440\u0443\u0436\u0438\u0442
      \u043D\u0438\u0437\u043A\u043E \u043D\u0430\u0434 \u043E\u0431\u043E\u0437\u043E\u043C
      \u0438 \u043F\u0430\u0434\u0430\u0435\u0442 \u043A\u0430\u043C\u043D\u0435\u043C
      - \u043D\u0435 \u043D\u0430 \u0434\u043E\u0431\u044B\u0447\u0443, \u0430 \u043F\u0440\u044F\u043C\u043E
      \u043D\u0430 \u0442\u044E\u043A \u043F\u0435\u0440\u0432\u043E\u0433\u043E
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430. \u041E\u043D \u0441\u0438\u0434\u0438\u0442
      \u0442\u0430\u043C \u0441 \u0432\u0438\u0434\u043E\u043C \u0445\u043E\u0437\u044F\u0438\u043D\u0430.
      \u041D\u0430 \u043B\u0430\u043F\u0435 - \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u0442\u0443\u0431\u0443\u0441. \u041F\u0442\u0438\u0446\u0430 \u044F\u0432\u043D\u043E
      \u043F\u043E\u0447\u0442\u043E\u0432\u0430\u044F: \u043A\u043E\u043B\u044C\u0446\u0430
      \u043D\u0430 \u043E\u0431\u0435\u0438\u0445 \u043B\u0430\u043F\u0430\u0445,
      \u0445\u043E\u0440\u043E\u0448\u043E \u0432\u044B\u043D\u043E\u0448\u0435\u043D\u0430.
      \u041D\u043E \u0443\u043F\u0430\u043B\u0430 - \u0447\u0442\u043E-\u0442\u043E
      \u0441\u0431\u0438\u043B\u043E\u0441\u044C \u0432 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u043A\u0435.
      \u041F\u0438\u0441\u044C\u043C\u043E \u0432\u043D\u0443\u0442\u0440\u0438 \u0441\u0432\u0451\u0440\u043D\u0443\u0442\u043E
      \u0432 \u0442\u0440\u0443\u0431\u043A\u0443, \u043D\u0430\u043F\u0438\u0441\u0430\u043D\u043E
      \u043F\u043E-\u0430\u0440\u0430\u0431\u0441\u043A\u0438. \u041A\u043E\u043C\u0443
      \u043E\u043D\u043E? \u0427\u044C\u0451 \u044D\u0442\u043E? \u0420\u0430\u0437\u0432\u0435\u0440\u043D\u0443\u0442\u044C
      - \u0437\u043D\u0430\u0447\u0438\u0442 \u043F\u0440\u043E\u0447\u0435\u0441\u0442\u044C
      \u0447\u0443\u0436\u043E\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830625
    m_Localized: "\u041F\u0440\u043E\u0447\u0435\u0441\u0442\u044C \u043F\u0438\u0441\u044C\u043C\u043E
      - \u0432\u0434\u0440\u0443\u0433 \u0432\u0430\u0436\u043D\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830626
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u043E\u0442 \u043A\u0443\u043F\u0446\u0430
      \u042E\u0441\u0443\u0444\u0430 \u043A \u0435\u0433\u043E \u0430\u0433\u0435\u043D\u0442\u0443
      \u0432 \u041C\u0435\u0440\u0432\u0435 - \u0446\u0435\u043D\u044B \u043D\u0430
      \u0448\u0451\u043B\u043A \u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442
      \u043A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u0430. \u041F\u043E\u043B\u0435\u0437\u043D\u0430\u044F
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F. \u0421\u043E\u043A\u043E\u043B\u0430
      \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B\u0438 \u0441 \u043D\u043E\u0432\u044B\u043C
      \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0435\u043C - \u043F\u0443\u0441\u0442\u044C
      \u043B\u0435\u0442\u0438\u0442 \u043A\u0443\u0434\u0430 \u0434\u043E\u043B\u0436\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830627
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0441\u043E\u043A\u043E\u043B\u0430
      \u0434\u0430\u043B\u044C\u0448\u0435 \u0431\u0435\u0437 \u0447\u0442\u0435\u043D\u0438\u044F
      - \u0432\u0435\u0440\u043D\u0443\u0442\u044C \u043F\u0442\u0438\u0446\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830628
    m_Localized: "\u041F\u0442\u0438\u0446\u0443 \u043D\u0430\u043A\u043E\u0440\u043C\u0438\u043B\u0438
      \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u043B\u0438. \u041E\u043D\u0430
      \u0443\u043B\u0435\u0442\u0435\u043B\u0430 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E
      - \u043D\u0430\u0448\u043B\u0430 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440.
      \u0427\u0443\u0436\u043E\u0435 \u043F\u0438\u0441\u044C\u043C\u043E \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043D\u043E
      \u043D\u0435 \u0431\u044B\u043B\u043E. \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F
      \u0447\u0435\u0441\u0442\u043D\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0447\u0443\u0442\u044C \u043E\u043A\u0440\u0435\u043F\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830629
    m_Localized: "\u0421\u043E\u0445\u0440\u0430\u043D\u0438\u0442\u044C \u0441\u043E\u043A\u043E\u043B\u0430
      - \u043F\u0440\u043E\u0434\u0430\u0442\u044C \u0432 \u0433\u043E\u0440\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830630
    m_Localized: "\u041E\u0431\u0443\u0447\u0435\u043D\u043D\u044B\u0439 \u043F\u043E\u0447\u0442\u043E\u0432\u044B\u0439
      \u0441\u043E\u043A\u043E\u043B \u043D\u0430 \u0440\u044B\u043D\u043A\u0435
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0430 \u0441\u0442\u043E\u0438\u0442
      \u043F\u044F\u0442\u044C \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432 \u043C\u0438\u043D\u0438\u043C\u0443\u043C.
      \u041F\u0440\u043E\u0434\u0430\u043B\u0438. \u041F\u0438\u0441\u044C\u043C\u043E
      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u043B\u0438. \u041F\u043E\u043B\u0443\u0447\u0430\u0442\u0435\u043B\u044C
      \u043F\u0438\u0441\u044C\u043C\u0430 \u0442\u0430\u043A \u0438 \u043D\u0435
      \u0443\u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u0431\u044B\u043B\u043E
      \u0432 \u0442\u043E\u043C \u043F\u043E\u0441\u043B\u0430\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830631
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0435 \u043A\u043E\u0437\u043B\u044B
      \u043D\u0430 \u0442\u0440\u043E\u043F\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830632
    m_Localized: "\u0421\u0442\u0430\u0434\u043E \u0441\u0438\u0431\u0438\u0440\u0441\u043A\u0438\u0445
      \u043A\u043E\u0437\u0435\u0440\u043E\u0433\u043E\u0432 - \u0434\u0435\u0432\u044F\u0442\u044C
      \u0441\u0430\u043C\u0446\u043E\u0432 \u0441 \u0438\u0437\u043E\u0433\u043D\u0443\u0442\u044B\u043C\u0438
      \u043D\u0430\u0437\u0430\u0434 \u0440\u043E\u0433\u0430\u043C\u0438 \u0434\u043B\u0438\u043D\u043E\u0439
      \u0432 \u043B\u043E\u043A\u043E\u0442\u044C - \u0441\u0442\u043E\u0438\u0442
      \u043F\u0440\u044F\u043C\u043E \u043D\u0430 \u0433\u043E\u0440\u043D\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435. \u041E\u043D\u0438 \u043D\u0435 \u0431\u043E\u044F\u0442\u0441\u044F
      \u043B\u044E\u0434\u0435\u0439: \u043F\u0440\u0438\u0432\u044B\u043A\u043B\u0438
      \u043A \u0440\u0435\u0434\u043A\u0438\u043C \u043F\u0443\u0442\u043D\u0438\u043A\u0430\u043C.
      \u0421\u0430\u043C\u044B\u0439 \u043A\u0440\u0443\u043F\u043D\u044B\u0439,
      \u0441 \u0440\u043E\u0433\u0430\u043C\u0438 \u0432\u043F\u043E\u043B\u043E\u0431\u043E\u0440\u043E\u0442\u0430,
      \u0441\u0442\u043E\u0438\u0442 \u0432 \u0446\u0435\u043D\u0442\u0440\u0435
      \u0442\u0440\u043E\u043F\u044B \u0438 \u0436\u0443\u0451\u0442 \u0441\u0443\u0445\u0443\u044E
      \u0442\u0440\u0430\u0432\u0443 \u0441 \u043D\u0435\u0432\u043E\u0437\u043C\u0443\u0442\u0438\u043C\u044B\u043C
      \u0432\u0438\u0434\u043E\u043C. \u0422\u0440\u043E\u043F\u0430 \u043E\u0434\u043D\u0430.
      \u041A\u043E\u0437\u0435\u0440\u043E\u0433 \u0432\u0435\u0441\u0438\u0442 \u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0436\u0435, \u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u0438\u0439
      \u0432\u044C\u044E\u043A. \u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C
      \u0435\u0433\u043E \u043A\u0440\u0438\u0447\u0430\u0442 \u043F\u043E-\u0440\u0430\u0437\u043D\u043E\u043C\u0443:
      \u043E\u0434\u043D\u0438 \u0433\u043E\u0432\u043E\u0440\u044F\u0442 - \u043D\u0435\u043B\u044C\u0437\u044F,
      \u044D\u0442\u043E \u0433\u043E\u0440\u043D\u044B\u0439 \u0434\u0443\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830633
    m_Localized: "\u041F\u043E\u0434\u043E\u0436\u0434\u0430\u0442\u044C - \u0443\u0439\u0434\u0443\u0442
      \u0441\u0430\u043C\u0438, \u043D\u0435 \u0442\u043E\u0440\u043E\u043F\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830634
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u0441\u0442\u0430\u0434\u043E
      \u043D\u0435\u0442\u043E\u0440\u043E\u043F\u043B\u0438\u0432\u043E \u0443\u0448\u043B\u043E
      \u0432\u0432\u0435\u0440\u0445 \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443.
      \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B
      \u043F\u0443\u0442\u044C. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0447\u0430\u0441. \u041E\u0434\u0438\u043D \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0443\u043C\u0443\u0434\u0440\u0438\u043B\u0441\u044F \u043F\u043E\u0442\u0440\u043E\u0433\u0430\u0442\u044C
      \u0440\u043E\u0433 \u0432\u043E\u0436\u0430\u043A\u0430 - \u043A\u043E\u0437\u0435\u0440\u043E\u0433
      \u0434\u0430\u0436\u0435 \u0443\u0445\u043E\u043C \u043D\u0435 \u043F\u043E\u0432\u0451\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830635
    m_Localized: "\u041E\u0445\u043E\u0442\u0438\u0442\u044C\u0441\u044F - \u0441\u0432\u0435\u0436\u0435\u0435
      \u043C\u044F\u0441\u043E \u0438 \u0440\u043E\u0433\u0430 \u043D\u0430 \u043F\u0440\u043E\u0434\u0430\u0436\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830636
    m_Localized: "\u0414\u0432\u0443\u0445 \u043A\u043E\u0437\u0435\u0440\u043E\u0433\u043E\u0432
      \u0432\u0437\u044F\u043B\u0438 \u0441\u0442\u0440\u0435\u043B\u0430\u043C\u0438.
      \u0421\u0442\u0430\u0434\u043E \u0443\u0448\u043B\u043E. \u0420\u043E\u0433\u0430
      \u0443 \u0430\u043F\u0442\u0435\u043A\u0430\u0440\u044F \u0432 \u041A\u0430\u0448\u0433\u0430\u0440\u0435
      \u0441\u0442\u043E\u044F\u0442 \u0445\u043E\u0440\u043E\u0448\u043E. \u041C\u044F\u0441\u043E
      \u043D\u0430 \u0442\u0440\u0438 \u0434\u043D\u044F. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u0411\u0443\u0433\u0430 \u043F\u043E\u043C\u043E\u0440\u0449\u0438\u043B\u0441\u044F:
      \u0432 \u0433\u043E\u0440\u0430\u0445 \u043E\u0445\u043E\u0442\u0430 \u043D\u0430
      \u043A\u043E\u0437\u0435\u0440\u043E\u0433\u043E\u0432 - \u043F\u043B\u043E\u0445\u043E\u0439
      \u0437\u043D\u0430\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830637
    m_Localized: "\u041A\u0440\u0438\u0447\u0430\u0442\u044C \u0438 \u0431\u0440\u043E\u0441\u0430\u0442\u044C
      \u043A\u0430\u043C\u043D\u0438 - \u043F\u0440\u043E\u0433\u043D\u0430\u0442\u044C
      \u0431\u044B\u0441\u0442\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830638
    m_Localized: "\u041A\u043E\u0437\u0435\u0440\u043E\u0433\u0438 \u043D\u0435\u0445\u043E\u0442\u044F
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438 - \u043D\u0430 \u0441\u043A\u0430\u043B\u0443
      \u0432 \u043F\u044F\u0442\u0438 \u0448\u0430\u0433\u0430\u0445 \u043E\u0442
      \u0442\u0440\u043E\u043F\u044B. \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B,
      \u0430 \u043E\u043D\u0438 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438
      \u0441\u0432\u0435\u0440\u0445\u0443 \u0440\u0430\u0432\u043D\u043E\u0434\u0443\u0448\u043D\u044B\u043C\u0438
      \u0433\u043B\u0430\u0437\u0430\u043C\u0438. \u041A\u0430\u043C\u043D\u0438
      \u043E\u0442\u0432\u043B\u0435\u043A\u043B\u0438, \u043D\u0435 \u043F\u0440\u043E\u0433\u043D\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830639
    m_Localized: "\u0411\u0443\u0440\u044F \u0441\u0431\u0438\u043B\u0430 \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830640
    m_Localized: "\u0412\u0435\u0442\u0435\u0440 \u0443\u0442\u0438\u0445 \u0447\u0435\u0440\u0435\u0437
      \u0434\u0432\u0430 \u0447\u0430\u0441\u0430, \u043E\u0441\u0442\u0430\u0432\u0438\u0432
      \u0432\u043C\u0435\u0441\u0442\u043E \u0437\u043D\u0430\u043A\u043E\u043C\u043E\u0433\u043E
      \u0440\u0435\u043B\u044C\u0435\u0444\u0430 \u0440\u043E\u0432\u043D\u043E\u0435
      \u0431\u0435\u043B\u043E\u0435 \u043C\u043E\u0440\u0435 \u043F\u0435\u0441\u043A\u0430
      - \u0434\u044E\u043D\u044B \u043F\u0435\u0440\u0435\u043A\u0430\u0442\u0438\u043B\u0438\u0441\u044C,
      \u0441\u0442\u043E\u043B\u0431\u044B \u0437\u0430\u043D\u0435\u0441\u043B\u043E,
      \u0441\u043B\u0435\u0434\u044B \u0438\u0441\u0447\u0435\u0437\u043B\u0438.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0421\u0430\u043C\u0435\u0445
      \u043F\u0440\u0438\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442 \u043B\u0430\u0434\u043E\u043D\u044C
      \u043A\u043E\u0437\u044B\u0440\u044C\u043A\u043E\u043C, \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044F\u0441\u044C:
      \u0442\u0440\u0438 \u0432\u043F\u0430\u0434\u0438\u043D\u044B \u043D\u0430
      \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435, \u0438 \u043D\u0438
      \u043E\u0434\u043D\u0430 \u043D\u0435 \u043F\u043E\u0445\u043E\u0436\u0430
      \u043D\u0430 \u0442\u0443, \u0447\u0442\u043E \u0431\u044B\u043B\u0430 \u0432\u0447\u0435\u0440\u0430.
      \u0426\u0435\u043D\u0430 \u043E\u0448\u0438\u0431\u043A\u0438 - \u043F\u043E\u043B\u0442\u043E\u0440\u0430
      \u0434\u043D\u044F \u043F\u0443\u0442\u0438 \u0438 \u0437\u0430\u043F\u0430\u0441\u044B
      \u0432\u043E\u0434\u044B \u043D\u0430 \u0434\u0432\u0435 \u0442\u0440\u0435\u0442\u0438.
      \u0421\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0435 \u043A\u0443\u043F\u0446\u044B
      \u0433\u043E\u0432\u043E\u0440\u044F\u0442: \u0432 \u0422\u0430\u043A\u043B\u0430-\u041C\u0430\u043A\u0430\u043D
      \u0431\u0443\u0440\u044F \u043C\u0435\u043D\u044F\u0435\u0442 \u0434\u043E\u0440\u043E\u0433\u0438
      \u0442\u0430\u043A \u0436\u0435 \u043B\u0435\u0433\u043A\u043E, \u043A\u0430\u043A
      \u043F\u0438\u0441\u0435\u0446 \u043F\u0440\u0430\u0432\u0438\u0442 \u0447\u0435\u0440\u043D\u043E\u0432\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830641
    m_Localized: "\u0418\u0434\u0442\u0438 \u043F\u043E \u0441\u043B\u0435\u0434\u0430\u043C
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u043A \u0432\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830642
    m_Localized: "\u041A\u043E\u043F\u044B\u0442\u0430 \u044F\u043A\u043E\u0432 \u0438
      \u043A\u043E\u0448\u0430\u0447\u044C\u0438 \u0441\u043B\u0435\u0434\u044B \u043F\u0435\u0442\u043B\u044F\u043B\u0438,
      \u043D\u043E \u0432\u044B\u0432\u0435\u043B\u0438 \u043A \u0432\u044B\u0441\u043E\u0445\u0448\u0435\u043C\u0443
      \u0440\u0443\u0441\u043B\u0443 - \u0442\u0430\u043C \u0432 \u0442\u0435\u043D\u0438
      \u043E\u0431\u0440\u044B\u0432\u0430 \u043D\u0430\u0448\u043B\u0430\u0441\u044C
      \u0437\u043D\u0430\u043A\u043E\u043C\u0430\u044F \u0433\u0440\u0443\u0434\u0430
      \u043A\u0430\u043C\u043D\u0435\u0439. \u041E\u0440\u0438\u0435\u043D\u0442\u0438\u0440
      \u0446\u0435\u043B. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0432\u0440\u0435\u043C\u044F
      \u0438 \u043D\u0435\u0440\u0432\u044B, \u043D\u043E \u043D\u0435 \u0434\u043E\u0440\u043E\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830643
    m_Localized: "\u0416\u0434\u0430\u0442\u044C \u043D\u043E\u0447\u0438 - \u0438\u0434\u0442\u0438
      \u043F\u043E \u0437\u0432\u0451\u0437\u0434\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830644
    m_Localized: "\u041F\u043B\u0435\u044F\u0434\u044B \u0432\u0437\u043E\u0448\u043B\u0438
      \u0437\u0430 \u0447\u0430\u0441 \u0434\u043E \u043F\u043E\u043B\u0443\u043D\u043E\u0447\u0438,
      \u0447\u0438\u0441\u0442\u044B\u0435 \u0438 \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0435.
      \u0421\u0430\u043C\u0435\u0445 \u0432\u0451\u043B \u043E\u0431\u043E\u0437
      \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E - \u0437\u0430 \u0442\u0440\u0438
      \u043D\u043E\u0447\u043D\u044B\u0435 \u0441\u0442\u043E\u044F\u043D\u043A\u0438
      \u0441\u043E\u0433\u0434\u0438\u0439\u0446\u044B \u0438\u043C\u0435\u043D\u043D\u043E
      \u0442\u0430\u043A \u0438 \u0432\u044B\u0445\u043E\u0434\u0438\u043B\u0438
      \u0438\u0437 \u0432\u0435\u043B\u0438\u043A\u043E\u0439 \u043F\u0443\u0441\u0442\u044B\u043D\u0438.
      \u041A \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0443 \u0434\u043E\u0440\u043E\u0436\u043D\u044B\u0439
      \u043A\u0430\u043C\u0435\u043D\u044C \u0441 \u043D\u0430\u0441\u0435\u0447\u043A\u0430\u043C\u0438
      \u0431\u043B\u0435\u0441\u043D\u0443\u043B \u0432 \u0441\u0432\u0435\u0442\u0435
      \u0444\u0430\u043A\u0435\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830645
    m_Localized: "\u0420\u0430\u0437\u043E\u0441\u043B\u0430\u0442\u044C \u0442\u0440\u0451\u0445
      \u043B\u044E\u0434\u0435\u0439 \u0432 \u0440\u0430\u0437\u043D\u044B\u0435
      \u0441\u0442\u043E\u0440\u043E\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830646
    m_Localized: "\u0414\u0432\u043E\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C
      \u043F\u0443\u0441\u0442\u044B\u043C\u0438. \u0422\u0440\u0435\u0442\u0438\u0439
      - \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0411\u0443\u0433\u0430
      - \u043D\u0430\u0448\u0451\u043B \u0441\u0442\u0430\u0440\u044B\u0439 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439
      \u0437\u0430\u0433\u043E\u043D \u0434\u043B\u044F \u0441\u043A\u043E\u0442\u0430
      \u0432 \u0434\u0432\u0443\u0445 \u043B\u0438 \u043A \u044E\u0433\u0443. \u0417\u0430\u0433\u043E\u043D
      \u0441\u0442\u043E\u0438\u0442 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438,
      \u043D\u043E \u043F\u043E\u043A\u0430 \u0435\u0433\u043E \u0438\u0441\u043A\u0430\u043B\u0438,
      \u0436\u0430\u0440\u0430 \u0432\u0437\u044F\u043B\u0430 \u0441\u0432\u043E\u0451:
      \u0434\u0432\u0430 \u0432\u044C\u044E\u0447\u043D\u044B\u0445 \u043C\u0435\u0448\u043A\u0430
      \u0441 \u043F\u0440\u043E\u0432\u0438\u0430\u043D\u0442\u043E\u043C \u043F\u043E\u0440\u0432\u0430\u043B\u0438\u0441\u044C
      \u043E\u0442 \u0436\u0451\u0441\u0442\u043A\u043E\u0439 \u043F\u043E\u0441\u0430\u0434\u043A\u0438
      \u043D\u0430 \u043A\u0430\u043C\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830647
    m_Localized: "\u0417\u0432\u0451\u0437\u0434\u043D\u0430\u044F \u043A\u0430\u0440\u0442\u0430
      \u043A\u0443\u043F\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830648
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u043A\u043E\u0440\u0438\u0430\u043D\u0434\u0440\u0430
      \u0438 \u0441\u0442\u0430\u0440\u043E\u0439 \u043A\u043E\u0436\u0438 - \u043A\u0443\u043F\u0435\u0446
      \u0424\u0430\u0440\u0440\u0443\u0445 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043D\u0430 \u043A\u043E\u043B\u0435\u043D\u0435 \u043A\u0443\u0441\u043E\u043A
      \u0432\u044B\u0434\u0435\u043B\u0430\u043D\u043D\u043E\u0439 \u043E\u0432\u0447\u0438\u043D\u044B
      \u0441 \u043D\u0430\u043D\u0435\u0441\u0451\u043D\u043D\u044B\u043C\u0438 \u0442\u0443\u0448\u044C\u044E
      \u0437\u0432\u0451\u0437\u0434\u043D\u044B\u043C\u0438 \u0440\u0438\u0441\u0443\u043D\u043A\u0430\u043C\u0438
      \u0438 \u043F\u0443\u043D\u043A\u0442\u0438\u0440\u043E\u043C \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430
      \u043E\u0442 \u041C\u0435\u0440\u0432\u0430 \u0434\u043E \u041A\u0430\u0448\u0433\u0430\u0440\u0430.
      \u0415\u0433\u043E \u0441\u043C\u0443\u0433\u043B\u044B\u0435 \u043F\u0430\u043B\u044C\u0446\u044B
      \u043F\u043E\u0441\u0442\u0443\u043A\u0438\u0432\u0430\u044E\u0442 \u043F\u043E
      \u0442\u043E\u0447\u043A\u0430\u043C: <npc_speech lang=\"Persian\">\u0427\u0435\u0442\u044B\u0440\u0435
      \u0441\u0442\u043E\u044F\u043D\u043A\u0438 \u0434\u043E \u0425\u043E\u0442\u0430\u043D\u0430
      - \u043D\u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u043E\u043F\u0430\u0441\u043D\u043E\u0433\u043E
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430.</npc_speech> \u041A\u0430\u0440\u0442\u0430
      \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u0441\u0432\u0435\u0436\u0435\u0439,
      \u043D\u043E \u0446\u0435\u043D\u0430 - \u0441\u043E\u0440\u043E\u043A \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432
      \u0441\u0435\u0439\u0447\u0430\u0441 \u0438\u043B\u0438 \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C
      \u0448\u0430\u043D\u0441. \u041F\u0435\u0440\u0441 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442:
      \u044D\u0442\u043E \u043A\u043E\u043F\u0438\u044F \u0441 \u043A\u0430\u0440\u0442\u044B
      \u0446\u0437\u0435\u0434\u0443\u0448\u0438, \u0441\u043D\u044F\u0442\u0430\u044F
      \u0434\u0432\u0430 \u0433\u043E\u0434\u0430 \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830649
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u043A\u0430\u0440\u0442\u0443
      \u0437\u0430 \u0437\u0430\u043F\u0440\u043E\u0448\u0435\u043D\u043D\u0443\u044E
      \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830650
    m_Localized: "\u0424\u0430\u0440\u0440\u0443\u0445 \u0441\u0432\u0435\u0440\u043D\u0443\u043B
      \u043A\u0430\u0440\u0442\u0443 \u0438 \u043F\u0435\u0440\u0435\u0434\u0430\u043B
      \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
      \u0442\u0440\u0438 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430 \u043F\u0440\u043E\u0448\u043B\u0438
      \u0431\u0435\u0437 \u0435\u0434\u0438\u043D\u043E\u0433\u043E \u0441\u043F\u043E\u0440\u0430
      \u043E \u0434\u043E\u0440\u043E\u0433\u0435: \u0437\u0432\u0451\u0437\u0434\u043D\u044B\u0435
      \u0437\u0430\u0441\u0435\u0447\u043A\u0438 \u0438 \u043F\u043E\u0434\u043F\u0438\u0441\u0430\u043D\u043D\u044B\u0435
      \u043A\u043E\u043B\u043E\u0434\u0446\u044B \u0441\u043E\u0432\u043F\u0430\u043B\u0438
      \u0441 \u0440\u0435\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E.
      \u0414\u0438\u0440\u0445\u0430\u043C\u044B \u043F\u043E\u0442\u0440\u0430\u0447\u0435\u043D\u044B
      \u043D\u0435 \u0432\u043F\u0443\u0441\u0442\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830651
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u0441\u043F\u0440\u0430\u0432\u0435\u0434\u043B\u0438\u0432\u043E\u0439
      \u0446\u0435\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830652
    m_Localized: "\u041F\u043E\u0441\u043B\u0435 \u0434\u043E\u043B\u0433\u043E\u0433\u043E
      \u0442\u043E\u0440\u0433\u0430 \u0424\u0430\u0440\u0440\u0443\u0445 \u0443\u0441\u0442\u0443\u043F\u0438\u043B,
      \u043D\u043E \u0441 \u0435\u0434\u0432\u0430 \u0441\u043A\u0440\u044B\u0442\u043E\u0439
      \u043E\u0431\u0438\u0434\u043E\u0439 \u043A\u0438\u0432\u043D\u0443\u043B:
      <npc_speech lang=\"Persian\">\u0412\u043E\u0437\u044C\u043C\u0438 \u0437\u0430
      \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043F\u044F\u0442\u044C.</npc_speech>
      \u041A\u0430\u0440\u0442\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u0442\u043E\u0447\u043D\u043E\u0439. \u041F\u0435\u0440\u0441\u044B \u043F\u043E\u043C\u043D\u044F\u0442
      \u0442\u0430\u043A\u043E\u0435 - \u0441\u043A\u0443\u043F\u043E\u0439 \u043F\u043B\u0430\u0442\u0438\u0442
      \u0434\u0432\u0430\u0436\u0434\u044B \u0432 \u0441\u043C\u044B\u0441\u043B\u0435
      \u0440\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993431830653
    m_Localized: "\u041E\u0442\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F -
      \u043E\u0431\u043E\u0439\u0434\u0451\u043C\u0441\u044F \u0441\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024832
    m_Localized: "\u0424\u0430\u0440\u0440\u0443\u0445 \u043F\u043E\u0436\u0430\u043B
      \u043F\u043B\u0435\u0447\u0430\u043C\u0438 \u0438 \u0443\u0431\u0440\u0430\u043B
      \u043A\u0430\u0440\u0442\u0443. \u041D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0435 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B\u0438
      \u043F\u043E\u043B\u0434\u043D\u044F \u043D\u0430 \u043F\u043E\u0438\u0441\u043A
      \u0437\u0430\u0432\u0430\u043B\u0435\u043D\u043D\u043E\u0433\u043E \u043F\u0435\u0441\u043A\u043E\u043C
      \u043A\u043E\u043B\u043E\u0434\u0446\u0430. \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
      \u043A\u0430\u0440\u0442\u0430 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430
      \u0431\u044B \u0435\u0433\u043E \u0441\u0440\u0430\u0437\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024833
    m_Localized: "\u0420\u0430\u0437\u0432\u0438\u043B\u043A\u0430 \u0431\u0435\u0437
      \u0437\u043D\u0430\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024834
    m_Localized: "\u0414\u0432\u0430 \u043F\u044B\u043B\u044C\u043D\u044B\u0445 \u043F\u044F\u0442\u043D\u0430
      \u0440\u0430\u0441\u0445\u043E\u0434\u044F\u0442\u0441\u044F \u043E\u0442 \u0446\u0435\u043D\u0442\u0440\u0430
      - \u043D\u0438 \u0441\u0442\u043E\u043B\u0431\u0430, \u043D\u0438 \u0433\u0440\u0443\u0434\u044B
      \u043A\u0430\u043C\u043D\u0435\u0439, \u043D\u0438 \u0442\u0440\u044F\u043F\u043A\u0438
      \u043D\u0430 \u043A\u0443\u0441\u0442\u0435. \u041B\u0435\u0432\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0448\u0438\u0440\u0435 \u0438 \u0432\u0434\u0430\u0432\u043B\u0435\u043D\u0430
      \u0433\u043B\u0443\u0431\u0436\u0435: \u0442\u0443\u0442 \u0445\u043E\u0434\u0438\u043B\u0438
      \u0442\u044F\u0436\u0451\u043B\u044B\u0435 \u0432\u043E\u0437\u044B. \u041F\u0440\u0430\u0432\u0430\u044F
      - \u0441\u0432\u0435\u0436\u0438\u0439 \u043D\u0430\u0432\u043E\u0437 \u044F\u043A\u043E\u0432,
      \u043D\u0435 \u0441\u0442\u0430\u0440\u0448\u0435 \u0432\u0447\u0435\u0440\u0430\u0448\u043D\u0435\u0433\u043E
      \u0432\u0435\u0447\u0435\u0440\u0430. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0447\u0435\u0448\u0435\u0442
      \u0437\u0430\u0442\u044B\u043B\u043E\u043A: \u043E\u043D \u0437\u043D\u0430\u0435\u0442
      \u044D\u0442\u0438 \u043C\u0435\u0441\u0442\u0430 \u043F\u043E \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043C
      \u043E\u0442\u0446\u0430, \u043D\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439
      \u0440\u0430\u0437 \u0441\u0430\u043C \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B
      \u0437\u0434\u0435\u0441\u044C \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434. \u0412\u0440\u0435\u043C\u044F
      \u043D\u0435 \u0436\u0434\u0451\u0442 - \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435
      \u0447\u0435\u0440\u043D\u0435\u0435\u0442 \u043F\u043E\u043B\u043E\u0441\u0430
      \u043E\u0431\u043B\u0430\u043A\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024835
    m_Localized: "\u041B\u0435\u0432\u0430\u044F - \u0442\u044F\u0436\u0451\u043B\u044B\u0435
      \u0432\u043E\u0437\u044B \u0437\u043D\u0430\u043B\u0438 \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024836
    m_Localized: "\u0427\u0435\u0440\u0435\u0437 \u0447\u0430\u0441 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0432\u044B\u0448\u043B\u0430 \u043A \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u044E
      \u0441 \u043E\u0431\u0432\u0430\u043B\u0438\u0432\u0448\u0435\u0439\u0441\u044F
      \u043A\u0440\u043E\u0432\u043B\u0435\u0439 - \u0437\u0430\u0431\u0440\u043E\u0448\u0435\u043D,
      \u043D\u043E \u0441\u0442\u0435\u043D\u044B \u0446\u0435\u043B\u044B. \u0421\u0442\u0430\u0440\u044B\u0435
      \u043A\u043E\u043B\u0435\u0438 \u0432\u0435\u043B\u0438 \u0438\u043C\u0435\u043D\u043D\u043E
      \u0441\u044E\u0434\u0430, \u0430 \u0434\u0430\u043B\u044C\u0448\u0435 \u0443\u0436\u0435
      \u0437\u043D\u0430\u043A\u043E\u043C\u044B\u0439 \u0442\u0440\u0430\u043A\u0442.
      \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440,
      \u0445\u043E\u0442\u044F \u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024837
    m_Localized: "\u041F\u0440\u0430\u0432\u0430\u044F - \u0441\u0432\u0435\u0436\u0438\u0439
      \u0441\u043B\u0435\u0434 \u043D\u0430\u0434\u0451\u0436\u043D\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024838
    m_Localized: "\u0421\u0432\u0435\u0436\u0438\u0435 \u0441\u043B\u0435\u0434\u044B
      \u043F\u0440\u0438\u0432\u0435\u043B\u0438 \u043A \u043F\u0430\u0441\u0442\u0431\u0438\u0449\u0443,
      \u0430 \u043E\u0442 \u043D\u0435\u0433\u043E - \u043A \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u044C\u043D\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435 \u0441 \u044F\u0441\u043D\u044B\u043C\u0438
      \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u0430\u043C\u0438. \u041F\u0430\u0441\u0442\u0443\u0445-\u0442\u044E\u0440\u043A
      \u0436\u0435\u0441\u0442\u043E\u043C \u043F\u043E\u043A\u0430\u0437\u0430\u043B
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435. \u0418\u0434\u0442\u0438
      \u0431\u044B\u043B\u043E \u043B\u0435\u0433\u0447\u0435, \u0447\u0435\u043C
      \u043E\u0436\u0438\u0434\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024839
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u0430
      \u043F\u0435\u0448\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024840
    m_Localized: "\u0413\u043E\u043D\u0435\u0446 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441: \u043F\u0440\u0430\u0432\u0430\u044F
      \u0434\u043E\u0440\u043E\u0433\u0430 \u0443\u0445\u043E\u0434\u0438\u0442 \u0432
      \u0431\u0430\u043B\u043A\u0443 \u0438 \u0442\u0435\u0440\u044F\u0435\u0442\u0441\u044F.
      \u041B\u0435\u0432\u0430\u044F \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u043A
      \u0440\u0443\u0441\u043B\u0443. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0432\u0440\u0435\u043C\u044F, \u043D\u043E \u0432\u044B\u0431\u043E\u0440
      \u0442\u043E\u0447\u043D\u044B\u0439 - \u043D\u0438\u043A\u0430\u043A\u0438\u0445
      \u0441\u044E\u0440\u043F\u0440\u0438\u0437\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024841
    m_Localized: "\u041C\u0438\u0440\u0430\u0436 \u0432\u043F\u0435\u0440\u0435\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024842
    m_Localized: "\u041F\u0430\u043B\u044C\u043C\u044B \u0434\u0440\u043E\u0436\u0430\u0442
      \u043D\u0430\u0434 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u043E\u043C
      - \u0437\u0435\u043B\u0451\u043D\u044B\u0435, \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0437\u0435\u043B\u0451\u043D\u044B\u0435 \u0434\u043B\u044F \u044D\u0442\u043E\u0433\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0433\u043E\u0434\u0430. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043F\u043E\u0434\u043D\u044F\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u044B
      \u0438 \u043F\u043E\u0442\u044F\u043D\u0443\u043B\u0438\u0441\u044C \u0432\u043F\u0435\u0440\u0451\u0434,
      \u043D\u043E\u0437\u0434\u0440\u0438 \u0440\u0430\u0437\u0434\u0443\u043B\u0438\u0441\u044C.
      \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u041F\u0435\u043C\u0431\u0430
      \u0438\u0437 \u0422\u0438\u0431\u0435\u0442\u0430 \u0433\u043E\u0432\u043E\u0440\u0438\u0442
      \u0441\u0443\u0445\u043E: <npc_speech lang=\"Tibetan\">\u041D\u0435 \u0445\u043E\u0434\u0438
      - \u0437\u0435\u043C\u043B\u044F \u0433\u043E\u0440\u044F\u0447\u0430\u044F,
      \u0432\u043E\u0434\u044B \u043D\u0435\u0442.</npc_speech> \u041D\u043E \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u0442\u044F\u043D\u0443\u0442 \u043F\u043E\u0441\u0442\u0440\u043E\u043C\u043A\u0438,
      \u0438 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0443\u0436\u0435 \u0441\u043F\u043E\u0440\u044F\u0442 - \u043C\u0438\u0440\u0430\u0436
      \u0438\u043B\u0438 \u043D\u0435\u0442. \u0412\u043E\u0434\u044B \u0432 \u0431\u0443\u0440\u0434\u044E\u043A\u0430\u0445
      \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u043D\u0430 \u043F\u043E\u043B\u0442\u043E\u0440\u0430
      \u0434\u043D\u044F, \u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0439 \u043E\u0430\u0437\u0438\u0441
      - \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024843
    m_Localized: "\u0418\u0434\u0442\u0438 \u043A \u043E\u0430\u0437\u0438\u0441\u0443
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024844
    m_Localized: "\u0427\u0430\u0441 \u043F\u0443\u0442\u0438 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      - \u0438 \u043F\u0430\u043B\u044C\u043C\u044B \u0440\u0430\u0441\u0442\u0430\u044F\u043B\u0438
      \u0432 \u0433\u043E\u0440\u044F\u0447\u0435\u043C \u0432\u043E\u0437\u0434\u0443\u0445\u0435.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438\u0441\u044C,
      \u043C\u043E\u0442\u0430\u044F \u0433\u043E\u043B\u043E\u0432\u0430\u043C\u0438.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0432\u043E\u0434\u0443 \u043D\u0430
      \u043E\u0431\u0445\u043E\u0434\u043D\u043E\u0439 \u043A\u0440\u044E\u043A \u0438
      \u0442\u0440\u0438 \u0447\u0430\u0441\u0430 \u043F\u043E\u0434 \u043F\u043E\u043B\u0443\u0434\u0435\u043D\u043D\u044B\u043C
      \u0441\u043E\u043B\u043D\u0446\u0435\u043C. \u041F\u0435\u043C\u0431\u0430
      \u043C\u043E\u043B\u0447\u0430\u043B \u0432\u0435\u0441\u044C \u043F\u0443\u0442\u044C
      \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024845
    m_Localized: "\u0414\u043E\u0432\u0435\u0440\u044F\u0442\u044C \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0443
      - \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043A\u0443\u0440\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024846
    m_Localized: "\u041F\u0435\u043C\u0431\u0430 \u043F\u043E\u0432\u0451\u043B \u043E\u0431\u043E\u0437
      \u0441\u0442\u043E\u0440\u043E\u043D\u043E\u0439, \u043D\u0435 \u0433\u043B\u044F\u0434\u044F
      \u043D\u0430 \u043C\u0435\u0440\u0446\u0430\u043D\u0438\u0435. \u0415\u0449\u0451
      \u0447\u0435\u0440\u0435\u0437 \u0448\u0435\u0441\u0442\u044C \u0447\u0430\u0441\u043E\u0432
      \u0432 \u043B\u043E\u0436\u0431\u0438\u043D\u0435 \u043F\u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0430\u044F \u0432\u043E\u0434\u0430
      - \u0447\u0443\u0442\u044C \u043C\u0443\u0442\u043D\u0430\u044F, \u043D\u043E
      \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F. \u0422\u0438\u0431\u0435\u0442\u0435\u0446
      \u0443\u043C\u0435\u0435\u0442 \u0447\u0438\u0442\u0430\u0442\u044C \u043F\u0443\u0441\u0442\u044B\u043D\u044E
      \u043A\u0430\u043A \u043A\u043D\u0438\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024847
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u0430
      - \u0440\u0435\u0448\u0438\u0442\u044C \u043D\u0430\u0432\u0435\u0440\u043D\u044F\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024848
    m_Localized: "\u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0411\u0443\u0433\u0430
      \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F \u0447\u0435\u0440\u0435\u0437
      \u043F\u043E\u043B\u0442\u043E\u0440\u0430 \u0447\u0430\u0441\u0430: \u0441\u0443\u0445\u043E\u0439
      \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A, \u043D\u0438 \u043A\u0430\u043F\u043B\u0438.
      \u041E\u0431\u043E\u0437 \u043F\u043E\u0442\u0435\u0440\u044F\u043B \u0447\u0430\u0441,
      \u0437\u0430\u0442\u043E \u043D\u0435 \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B
      \u0432\u043E\u0434\u0443 \u043D\u0430 \u0432\u0441\u0435\u0445. \u041F\u0435\u043C\u0431\u0430
      \u043E\u0434\u043E\u0431\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043A\u0438\u0432\u043D\u0443\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024849
    m_Localized: "\u0420\u0435\u043A\u0430 \u0438\u0441\u0447\u0435\u0437\u043B\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024850
    m_Localized: "\u041D\u0430 \u043A\u0430\u0440\u0442\u0435 - \u0441\u0438\u043D\u044F\u044F
      \u043B\u0438\u043D\u0438\u044F \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u044B.
      \u041D\u0430 \u043C\u0435\u0441\u0442\u0435 - \u0440\u0430\u0441\u0442\u0440\u0435\u0441\u043A\u0430\u0432\u0448\u0435\u0435\u0441\u044F
      \u0433\u043B\u0438\u043D\u044F\u043D\u043E\u0435 \u0434\u043D\u043E, \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043B\u0443\u0436 \u0438 \u0437\u0430\u043F\u0430\u0445 \u0437\u0430\u0442\u0445\u043B\u043E\u0439
      \u0433\u0440\u044F\u0437\u0438. \u041D\u0438\u0447\u0435\u0433\u043E. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0410\u0445\u043C\u0430\u0434 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442
      \u043F\u043E\u0436\u0435\u043B\u0442\u0435\u0432\u0448\u0438\u0439 \u043B\u0438\u0441\u0442
      \u0441 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u043C \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u043E\u043C
      \u0438 \u0449\u0443\u0440\u0438\u0442\u0441\u044F: \u043A\u0430\u0440\u0442\u0430
      \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u0430 \u043F\u0440\u0438
      \u0434\u0435\u0434\u0435 \u043D\u044B\u043D\u0435\u0448\u043D\u0435\u0433\u043E
      \u0445\u0430\u043B\u0438\u0444\u0430. \u0413\u0434\u0435 \u0431\u0440\u0430\u0442\u044C
      \u0432\u043E\u0434\u0443 - \u043D\u0435\u044F\u0441\u043D\u043E; \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F
      \u0441\u0442\u043E\u044F\u043D\u043A\u0430 \u0441 \u043A\u043E\u043B\u043E\u0434\u0446\u0435\u043C
      - \u043F\u043E\u043B\u0442\u043E\u0440\u0430 \u0434\u043D\u044F \u043F\u0443\u0442\u0438.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u0441\u0442\u043E\u044F\u0442
      \u043D\u0430 \u0441\u0443\u0445\u043E\u043C \u0434\u043D\u0435 \u0438 \u0436\u0443\u044E\u0442
      \u043F\u0443\u0441\u0442\u043E\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024851
    m_Localized: "\u0418\u0441\u043A\u0430\u0442\u044C \u0431\u0440\u043E\u0434 \u0432\u0432\u0435\u0440\u0445
      \u043F\u043E \u0440\u0443\u0441\u043B\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024852
    m_Localized: "\u0412 \u0434\u0432\u0443\u0445 \u043B\u0438 \u0432\u044B\u0448\u0435
      \u043D\u0430\u0448\u043B\u0438 \u043F\u0440\u043E\u0441\u0430\u0447\u0438\u0432\u0430\u043D\u0438\u0435
      - \u043D\u0435 \u0440\u0435\u043A\u0430, \u043D\u043E \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E,
      \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u044C
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u0431\u0443\u0440\u0434\u044E\u043A\u043E\u0432.
      \u0411\u0435\u0440\u0435\u0433 \u043A\u0440\u0443\u0442\u043E\u0439, \u043E\u0434\u043D\u0430
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u0435\u0434\u0432\u0430 \u043D\u0435
      \u0437\u0430\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044C. \u0410\u0445\u043C\u0430\u0434
      \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B \u0438 \u0432\u044B\u0442\u0435\u0440
      \u043B\u043E\u0431."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024853
    m_Localized: "\u0412\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F \u043D\u0430
      \u0441\u0442\u0430\u0440\u044B\u0439 \u043C\u0430\u0440\u0448\u0440\u0443\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024854
    m_Localized: "\u041A\u0440\u0443\u0433\u043E\u0432\u043E\u0439 \u043E\u0431\u0445\u043E\u0434
      \u0441\u044A\u0435\u043B \u0434\u0432\u0430 \u0434\u043D\u044F \u0438 \u0437\u0430\u043F\u0430\u0441\u044B.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u0448\u043B\u0438 \u043F\u043E\u043D\u0443\u0440\u044B\u0435.
      \u0417\u0430\u0442\u043E \u0434\u043E\u0440\u043E\u0433\u0430 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430\u044F,
      \u0438 \u043A\u043E\u043B\u043E\u0434\u0435\u0446 \u0443 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u044F
      \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043F\u043E\u043B\u043D\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024855
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u043C\u0435\u0441\u0442\u043D\u043E\u0433\u043E
      \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u0430 \u043A\u0430\u043A \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024856
    m_Localized: "\u042E\u043D\u043E\u0448\u0430-\u0442\u044E\u0440\u043A \u0437\u0430
      \u043F\u0440\u0438\u0433\u043E\u0440\u0448\u043D\u044E \u043C\u043E\u043D\u0435\u0442
      \u043F\u0440\u043E\u0432\u0451\u043B \u043A \u0441\u043A\u0440\u044B\u0442\u043E\u043C\u0443
      \u043A\u043B\u044E\u0447\u0443 \u0437\u0430 \u0433\u0440\u0430\u043D\u0438\u0442\u043D\u044B\u043C
      \u0432\u044B\u0441\u0442\u0443\u043F\u043E\u043C. \u0414\u0432\u0430 \u0447\u0430\u0441\u0430
      \u043A\u0440\u044E\u043A\u0430, \u0437\u0430\u0442\u043E \u0432\u0441\u0435
      \u0431\u0443\u0440\u0434\u044E\u043A\u0438 \u043F\u043E\u043B\u043D\u044B.
      \u041E\u043D \u0443\u043B\u044B\u0431\u043D\u0443\u043B\u0441\u044F \u0438
      \u0438\u0441\u0447\u0435\u0437 \u0442\u0430\u043A \u0436\u0435 \u0431\u044B\u0441\u0442\u0440\u043E,
      \u043A\u0430\u043A \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024857
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u0430\u043B \u0432 \u0442\u0443\u043C\u0430\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024858
    m_Localized: "\u041E\u0431\u043B\u0430\u043A\u043E \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u043E\u0441\u044C
      \u0432 \u0441\u0435\u0434\u043B\u043E\u0432\u0438\u043D\u0443 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430
      - \u0431\u0435\u043B\u043E\u0435, \u043F\u043B\u043E\u0442\u043D\u043E\u0435,
      \u0441 \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u043C\u043E\u043A\u0440\u043E\u0433\u043E
      \u043A\u0430\u043C\u043D\u044F \u0438 \u043B\u0435\u0434\u043D\u0438\u043A\u0430.
      \u0412 \u043F\u044F\u0442\u0438 \u0448\u0430\u0433\u0430\u0445 \u0432\u0435\u0434\u0443\u0449\u0435\u0433\u043E
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430 \u0443\u0436\u0435 \u043D\u0435
      \u0432\u0438\u0434\u043D\u043E. \u0422\u0440\u043E\u043F\u0430 \u0437\u0434\u0435\u0441\u044C
      \u0448\u0438\u0440\u0438\u043D\u043E\u0439 \u0432 \u0434\u0432\u0435 \u043B\u0430\u0434\u043E\u043D\u0438:
      \u0441\u043B\u0435\u0432\u0430 - \u0441\u043A\u0430\u043B\u0430, \u0441\u043F\u0440\u0430\u0432\u0430
      - \u043E\u0431\u0440\u044B\u0432 \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0439
      \u0433\u043B\u0443\u0431\u0438\u043D\u044B. \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A
      \u041D\u0430\u043D\u0430\u043C \u0438\u0437 \u041B\u0445\u0430\u0441\u044B
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0442\u0438\u0445\u043E: <npc_speech
      lang=\"Tibetan\">\u0422\u0438\u0431\u0435\u0442 \u0437\u043D\u0430\u0435\u0442
      \u0442\u0430\u043A\u043E\u0439 \u0442\u0443\u043C\u0430\u043D - \u043A \u043F\u043E\u043B\u0443\u0434\u043D\u044E
      \u0443\u0445\u043E\u0434\u0438\u0442, \u043D\u043E \u0436\u0434\u0430\u0442\u044C
      \u043D\u0430\u0434\u043E.</npc_speech> \u041E\u0431\u043E\u0437 \u0441\u0442\u043E\u0438\u0442.
      \u041A\u0430\u0436\u0434\u044B\u0439 \u0447\u0430\u0441 \u0441\u0442\u043E\u044F\u043D\u043A\u0438
      - \u044D\u0442\u043E \u0435\u0434\u0430 \u0438 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024859
    m_Localized: "\u0418\u0434\u0442\u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      - \u0448\u0430\u0433 \u0437\u0430 \u0448\u0430\u0433\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024860
    m_Localized: "\u0427\u0435\u0442\u044B\u0440\u0435 \u0447\u0430\u0441\u0430 \u043F\u043E
      \u043A\u0430\u043C\u043D\u044F\u043C - \u043F\u043E\u0447\u0442\u0438 \u043E\u0449\u0443\u043F\u044C\u044E.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u0448\u043B\u0438 \u0433\u043E\u043B\u043E\u0432\u0430
      \u043A \u0445\u0432\u043E\u0441\u0442\u0443, \u043B\u044E\u0434\u0438 \u0434\u0435\u0440\u0436\u0430\u043B\u0438\u0441\u044C
      \u0437\u0430 \u0432\u0435\u0440\u0451\u0432\u043A\u0438. \u0412\u044B\u0448\u043B\u0438
      \u0438\u0437 \u0442\u0443\u043C\u0430\u043D\u0430 \u043A \u043F\u043E\u043B\u0443\u0434\u043D\u044E
      \u0446\u0435\u043B\u044B\u043C\u0438. \u041D\u0430\u043D\u0430\u043C \u043D\u0435
      \u0441\u043A\u0430\u0437\u0430\u043B \u043D\u0438 \u0441\u043B\u043E\u0432\u0430
      - \u0442\u043E\u043B\u044C\u043A\u043E \u043A\u0438\u0432\u043D\u0443\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024861
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C
      \u0438 \u0436\u0434\u0430\u0442\u044C \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024862
    m_Localized: "\u041F\u0435\u0440\u0435\u043D\u043E\u0447\u0435\u0432\u0430\u043B\u0438
      \u0432 \u0445\u043E\u043B\u043E\u0434\u043D\u043E\u0439 \u0441\u0435\u0434\u043B\u043E\u0432\u0438\u043D\u0435.
      \u041A \u0443\u0442\u0440\u0443 \u0442\u0443\u043C\u0430\u043D \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043F\u043E\u0440\u0435\u0434\u0435\u043B, \u0434\u043E\u0440\u043E\u0433\u0430
      \u043E\u0442\u043A\u0440\u044B\u043B\u0430\u0441\u044C. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0434\u0435\u043D\u044C, \u043D\u043E \u0441\u043F\u0443\u0441\u043A \u043F\u0440\u043E\u0448\u0451\u043B
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E \u0438 \u0431\u0435\u0437
      \u043F\u043E\u0442\u0435\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024863
    m_Localized: "\u0418\u0434\u0442\u0438 \u0431\u044B\u0441\u0442\u0440\u043E -
      \u043F\u043E\u043A\u0430 \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435
      \u0437\u0430\u043A\u0440\u044B\u043B\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024864
    m_Localized: "\u0422\u0443\u043C\u0430\u043D \u0441\u0442\u0430\u043B \u0433\u0443\u0449\u0435
      \u0447\u0435\u0440\u0435\u0437 \u0447\u0430\u0441. \u0412\u0435\u0434\u0443\u0449\u0438\u0439
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434 \u0448\u0430\u0433\u043D\u0443\u043B
      \u0441 \u0442\u0440\u043E\u043F\u044B - \u0435\u0434\u0432\u0430 \u0443\u0434\u0435\u0440\u0436\u0430\u043B\u0438.
      \u041E\u0431\u043E\u0437 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0441\u044F
      \u0432 \u0441\u0430\u043C\u043E\u043C \u0443\u0437\u043A\u043E\u043C \u043C\u0435\u0441\u0442\u0435
      \u0438 \u0441\u0442\u043E\u044F\u043B \u0442\u0430\u043C \u0434\u043E \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0430,
      \u0434\u0440\u043E\u0436\u0430 \u043E\u0442 \u0445\u043E\u043B\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024865
    m_Localized: "\u0421\u0440\u0435\u0437\u043A\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024866
    m_Localized: "\u041F\u0430\u0441\u0442\u0443\u0445-\u0442\u044E\u0440\u043A \u041A\u044E\u043B\u044C
      \u0436\u0435\u0441\u0442\u0438\u043A\u0443\u043B\u0438\u0440\u0443\u0435\u0442,
      \u0440\u0438\u0441\u0443\u0435\u0442 \u043F\u0430\u043B\u044C\u0446\u0435\u043C
      \u043F\u043E \u0437\u0435\u043C\u043B\u0435: \u0440\u043E\u0432\u043D\u044B\u0439
      \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A, \u0434\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u043B\u0438, \u0442\u0432\u0451\u0440\u0434\u0430\u044F \u043A\u043E\u0440\u043A\u0430.
      <npc_speech lang=\"Turkic\">\u0422\u0440\u0438 \u0434\u043D\u044F \u0441\u0440\u0435\u0437\u0430\u0442\u044C
      - \u0432\u0435\u0440\u043D\u043E \u0433\u043E\u0432\u043E\u0440\u044E.</npc_speech>
      \u0411\u0435\u043B\u0430\u044F \u0440\u0430\u0432\u043D\u0438\u043D\u0430 \u0441\u0432\u0435\u0440\u043A\u0430\u0435\u0442
      \u0432 \u043C\u0430\u0440\u0435\u0432\u0435. \u041F\u043E \u043A\u0440\u0430\u044F\u043C
      \u043E\u043D\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043D\u0430\u0434\u0451\u0436\u043D\u043E,
      \u043D\u043E \u0432 \u0446\u0435\u043D\u0442\u0440\u0435 - \u0436\u0435\u043B\u0442\u043E\u0432\u0430\u0442\u044B\u0435
      \u043F\u044F\u0442\u043D\u0430, \u0433\u0434\u0435 \u043A\u043E\u0440\u043A\u0430
      \u0442\u043E\u043D\u044C\u0448\u0435. \u041A\u044E\u043B\u044C \u0443\u0445\u043C\u044B\u043B\u044F\u0435\u0442\u0441\u044F:
      \u0435\u0433\u043E \u043E\u0432\u0446\u044B \u0445\u043E\u0434\u0438\u043B\u0438.
      \u041E\u0432\u0446\u044B - \u043D\u0435 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0441 \u0442\u043E\u0432\u0430\u0440\u043E\u043C. \u0421\u0442\u0430\u0432\u043A\u0438
      \u0432\u044B\u0441\u043E\u043A\u0438: \u043F\u043E\u043B\u0434\u043D\u044F
      \u0432\u044B\u0438\u0433\u0440\u044B\u0448\u0430 \u0438\u043B\u0438 \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u043E\u0435
      \u043A\u043E\u043B\u0435\u0441\u043E \u043F\u043E\u0441\u0440\u0435\u0434\u0438
      \u043F\u043B\u043E\u0441\u043A\u043E\u0441\u0442\u0438 \u0431\u0435\u0437 \u0442\u0435\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024867
    m_Localized: "\u0420\u0438\u0441\u043A\u043D\u0443\u0442\u044C - \u043F\u043E\u0439\u0442\u0438
      \u0447\u0435\u0440\u0435\u0437 \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024868
    m_Localized: "\u041F\u0435\u0440\u0432\u044B\u0435 \u0448\u0435\u0441\u0442\u044C
      \u043B\u0438 - \u043A\u043E\u0440\u043A\u0430 \u0434\u0435\u0440\u0436\u0430\u043B\u0430.
      \u041D\u0430 \u0441\u0435\u0434\u044C\u043C\u043E\u043C \u043F\u0435\u0440\u0435\u0434\u043D\u044F\u044F
      \u043F\u043E\u0432\u043E\u0437\u043A\u0430 \u0445\u0440\u0443\u0441\u0442\u043D\u0443\u043B\u0430
      \u0438\u043D\u0430\u0447\u0435. \u0423\u0441\u043A\u043E\u0440\u0438\u043B\u0438
      \u0448\u0430\u0433, \u043F\u0440\u043E\u0448\u043B\u0438 \u043E\u0441\u0442\u0430\u0432\u0448\u0438\u0435\u0441\u044F
      \u043F\u044F\u0442\u044C \u043B\u0438 \u043F\u043E\u0447\u0442\u0438 \u0431\u0435\u0433\u043E\u043C.
      \u0412\u044B\u0448\u043B\u0438 \u0441 \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u0432\u0448\u0438\u043C\u0438\u0441\u044F
      \u043E\u0431\u043E\u0434\u044C\u044F\u043C\u0438, \u0437\u0430\u0442\u043E
      \u043D\u0430 \u0434\u0435\u043D\u044C \u0440\u0430\u043D\u044C\u0448\u0435
      \u0441\u0440\u043E\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024869
    m_Localized: "\u041E\u0441\u0442\u0430\u0442\u044C\u0441\u044F \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0439
      \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024870
    m_Localized: "\u041A\u044E\u043B\u044C \u043F\u043E\u043A\u0430\u0447\u0430\u043B
      \u0433\u043E\u043B\u043E\u0432\u043E\u0439 \u0438 \u0443\u0448\u0451\u043B
      \u043A \u0441\u0442\u0430\u0434\u0443. \u041E\u0431\u043E\u0437 \u043F\u043E\u0448\u0451\u043B
      \u0441\u0442\u0430\u0440\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u043E\u0439
      - \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435, \u043D\u0430\u0434\u0451\u0436\u043D\u0435\u0435.
      \u0422\u0440\u0438 \u043B\u0438\u0448\u043D\u0438\u0445 \u0434\u043D\u044F
      \u043F\u0443\u0442\u0438, \u0437\u0430\u0442\u043E \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0446\u0435\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024871
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u041A\u044E\u043B\u044F \u0432\u0435\u0441\u0442\u0438
      \u0447\u0435\u0440\u0435\u0437 \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024872
    m_Localized: "\u0417\u0430 \u0434\u0432\u0430\u0434\u0446\u0430\u0442\u044C \u043A\u0430\u0439\u044E\u0430\u043D\u044C
      \u0442\u0443\u043D\u0431\u0430\u043E \u041A\u044E\u043B\u044C \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0441\u044F
      \u0432\u0435\u0441\u0442\u0438. \u041E\u043D \u0437\u043D\u0430\u043B \u043A\u0430\u0436\u0434\u0443\u044E
      \u0436\u0451\u043B\u0442\u0443\u044E \u043F\u043E\u043B\u043E\u0441\u0443 \u043D\u0430\u0438\u0437\u0443\u0441\u0442\u044C,
      \u043E\u0431\u0445\u043E\u0434\u0438\u043B \u0438\u0445 \u0443\u0432\u0435\u0440\u0435\u043D\u043D\u043E.
      \u041F\u0435\u0440\u0435\u0448\u043B\u0438 \u0441\u043E\u043B\u043E\u043D\u0447\u0430\u043A
      \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C \u0438 \u0441 \u0437\u0430\u043F\u0430\u0441\u043E\u043C
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024873
    m_Localized: "\u041D\u0430\u043C\u043E\u043A \u043F\u0443\u0442\u043E\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024874
    m_Localized: "\u041F\u0440\u0438 \u0431\u0440\u043E\u0434\u0435 \u0447\u0435\u0440\u0435\u0437
      \u0433\u043E\u0440\u043D\u044B\u0439 \u0440\u0443\u0447\u0435\u0439 \u0432\u044C\u044E\u0447\u043D\u044B\u0439
      \u0442\u044E\u043A \u0441 \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u043C\u0438
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u043C\u0438
      \u0441\u043A\u043E\u043B\u044C\u0437\u043D\u0443\u043B \u0432 \u0432\u043E\u0434\u0443.
      \u041A\u0438\u0442\u0430\u0439\u0441\u043A\u0438\u0439 \u043A\u043E\u043C\u043F\u0430\u0441-\u043F\u0443\u0442\u043E\u0443
      - \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u0430\u044F \u043B\u043E\u0436\u043A\u0430
      \u043D\u0430 \u043F\u043E\u043B\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439
      \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u043E\u0439 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0435
      - \u043F\u043E\u0442\u0435\u043C\u043D\u0435\u043B \u043E\u0442 \u0432\u043B\u0430\u0433\u0438
      \u0438 \u0442\u0435\u043F\u0435\u0440\u044C \u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0432\u044F\u043B\u043E, \u043D\u0435 \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u044F
      \u043D\u0430 \u044E\u0433. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u042E\u0441\u0443\u0444 \u0434\u0435\u0440\u0436\u0438\u0442 \u0435\u0433\u043E
      \u043D\u0430\u0434 \u0443\u0433\u043B\u044F\u043C\u0438: <npc_speech lang=\"Arabic\">\u0412\u044B\u0441\u043E\u0445\u043D\u0435\u0442
      - \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u0435\u0442?</npc_speech>
      \u041D\u0435\u0431\u043E \u0437\u0430\u0442\u044F\u043D\u0443\u0442\u043E -
      \u043D\u0438 \u041F\u043E\u043B\u044F\u0440\u043D\u043E\u0439 \u0437\u0432\u0435\u0437\u0434\u044B,
      \u043D\u0438 \u041F\u043B\u0435\u044F\u0434. \u0414\u043E \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u0433\u043E
      \u0433\u043E\u0440\u043E\u0434\u0430 \u0441 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u0449\u0438\u043A\u043E\u043C
      - \u0434\u0432\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430. \u0422\u043E\u0447\u043D\u043E\u0435
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0432\u0430\u0436\u043D\u043E:
      \u0437\u0434\u0435\u0441\u044C \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0438
      \u043A\u0430\u0436\u0434\u044B\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024875
    m_Localized: "\u041E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u043F\u043E \u0441\u043E\u043B\u043D\u0446\u0443 \u0438 \u0432\u0435\u0442\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024876
    m_Localized: "\u041F\u043E\u0441\u043B\u0435\u043F\u043E\u043B\u0443\u0434\u0435\u043D\u043D\u0430\u044F
      \u0442\u0435\u043D\u044C \u043E\u0442 \u0448\u0435\u0441\u0442\u0430 \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u0430
      \u0437\u0430\u043F\u0430\u0434. \u042E\u0441\u0443\u0444 \u0440\u0438\u0441\u043E\u0432\u0430\u043B
      \u043C\u0435\u0442\u043A\u0438 \u043D\u0430 \u0437\u0435\u043C\u043B\u0435
      \u043A\u0430\u0436\u0434\u044B\u0435 \u043F\u043E\u043B\u0447\u0430\u0441\u0430.
      \u0414\u0432\u0430\u0436\u0434\u044B \u043E\u0448\u0438\u0431\u043B\u0438\u0441\u044C,
      \u043E\u0431\u0430 \u0440\u0430\u0437\u0430 \u043F\u043E\u043D\u044F\u043B\u0438
      \u043F\u043E \u0437\u0430\u043F\u0430\u0445\u0443 \u0433\u043E\u0440\u043D\u043E\u0439
      \u0432\u043E\u0434\u044B. \u041A \u0432\u0435\u0447\u0435\u0440\u0443 \u0432\u044B\u0448\u043B\u0438
      \u043D\u0430 \u0437\u043D\u0430\u043A\u043E\u043C\u0443\u044E \u0442\u0440\u043E\u043F\u0443
      - \u0441 \u043E\u043F\u043E\u0437\u0434\u0430\u043D\u0438\u0435\u043C, \u043D\u043E
      \u0432\u0435\u0440\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024877
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u043C\u0435\u0441\u0442\u043D\u043E\u0433\u043E
      \u0437\u043D\u0430\u0442\u043E\u043A\u0430 \u043F\u0443\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024878
    m_Localized: "\u041F\u043E\u0436\u0438\u043B\u043E\u0439 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u043F\u0430\u0441\u0442\u0443\u0445 \u0437\u0430 \u0433\u043E\u0440\u0441\u0442\u044C
      \u043C\u043E\u043D\u0435\u0442 \u0443\u043A\u0430\u0437\u0430\u043B \u043F\u0443\u0442\u044C
      \u043F\u043E \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u0430\u043C:
      \u0442\u0440\u0438 \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u044B\u0445 \u0442\u043E\u043F\u043E\u043B\u044F,
      \u043F\u043E\u0442\u043E\u043C \u0447\u0451\u0440\u043D\u0430\u044F \u0441\u043A\u0430\u043B\u0430,
      \u043F\u043E\u0442\u043E\u043C \u0432\u043D\u0438\u0437. \u041A\u0430\u0436\u0434\u044B\u0439
      \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440 \u0441\u0442\u043E\u044F\u043B
      \u043D\u0430 \u043C\u0435\u0441\u0442\u0435. \u041F\u0443\u0442\u043E\u0443
      \u0434\u043E\u0441\u043E\u0445 \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443
      \u0443\u0442\u0440\u0443 \u0438 \u0441\u043D\u043E\u0432\u0430 \u0437\u0430\u0440\u0430\u0431\u043E\u0442\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024879
    m_Localized: "\u041F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C \u043F\u043E\u043B\u0434\u043D\u044F
      \u043D\u0430 \u043F\u0440\u043E\u0441\u0443\u0448\u043A\u0443 \u043A\u043E\u043C\u043F\u0430\u0441\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024880
    m_Localized: "\u042E\u0441\u0443\u0444 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043B
      \u043F\u0443\u0442\u043E\u0443, \u043F\u0440\u043E\u0442\u0451\u0440 \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u0443\u044E
      \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0443 \u0441\u0443\u0445\u043E\u0439
      \u043A\u043E\u0448\u043C\u043E\u0439 \u0438 \u0432\u044B\u043B\u043E\u0436\u0438\u043B
      \u043D\u0430 \u043F\u043B\u043E\u0441\u043A\u0438\u0439 \u043A\u0430\u043C\u0435\u043D\u044C
      \u043F\u043E\u0434 \u0441\u043E\u043B\u043D\u0446\u0435\u043C. \u041A \u043F\u043E\u043B\u0443\u0434\u043D\u044E
      \u0441\u0442\u0440\u0435\u043B\u043A\u0430 \u0441\u043D\u043E\u0432\u0430 \u0441\u043B\u0430\u0431\u043E,
      \u043D\u043E \u0432\u0435\u0440\u043D\u043E \u043F\u043E\u0442\u044F\u043D\u0443\u043B\u0430\u0441\u044C
      \u043A \u044E\u0433\u0443. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043F\u043E\u043B\u0434\u043D\u044F, \u0441\u043E\u0445\u0440\u0430\u043D\u0438\u043B\u0438
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024881
    m_Localized: "\u0414\u0440\u0435\u0432\u043D\u0438\u0439 \u043F\u0443\u0442\u0435\u0432\u043E\u0439
      \u0441\u0442\u043E\u043B\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024882
    m_Localized: "\u0421\u0442\u043E\u043B\u0431 \u0432\u044B\u0441\u043E\u0442\u043E\u0439
      \u043F\u043E \u0433\u0440\u0443\u0434\u044C, \u043E\u0431\u0442\u0451\u0441\u0430\u043D\u043D\u044B\u0439
      \u0438\u0437 \u0441\u0435\u0440\u043E\u0433\u043E \u0431\u0430\u0437\u0430\u043B\u044C\u0442\u0430.
      \u041D\u0430\u0434\u043F\u0438\u0441\u044C \u0432 \u0442\u0440\u0438 \u0441\u0442\u0440\u043E\u043A\u0438
      - \u0448\u0440\u0438\u0444\u0442 \u043F\u043E\u0445\u043E\u0436 \u043D\u0430
      \u0441\u0440\u0435\u0434\u043D\u0435\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439,
      \u043D\u043E \u0447\u0430\u0441\u0442\u044C \u0437\u043D\u0430\u043A\u043E\u0432
      \u043D\u0435\u0437\u043D\u0430\u043A\u043E\u043C\u0430. \u041E\u0434\u043D\u0430
      \u0446\u0438\u0444\u0440\u0430 \u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F
      \u044F\u0441\u043D\u043E. \u0412\u043D\u0438\u0437\u0443 \u043F\u0440\u043E\u0446\u0430\u0440\u0430\u043F\u0430\u043D
      \u0440\u0438\u0441\u0443\u043D\u043E\u043A: \u0433\u043E\u0440\u0430, \u0438\u0437\u043E\u0433\u043D\u0443\u0442\u0430\u044F
      \u043B\u0438\u043D\u0438\u044F \u0440\u0435\u043A\u0438, \u043A\u0440\u0435\u0441\u0442\u0438\u043A.
      \u0417\u043D\u0430\u043A \u0434\u043E\u0440\u043E\u0433\u0438? \u041F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435?
      \u0421\u0442\u043E\u043B\u0431 \u0441\u0442\u043E\u0438\u0442 \u0442\u0430\u043C,
      \u0433\u0434\u0435 \u0442\u0440\u043E\u043F\u0430 \u0440\u0430\u0437\u0434\u0432\u0430\u0438\u0432\u0430\u0435\u0442\u0441\u044F.
      \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0420\u0443\u0441\u0442\u0430\u043C
      \u0445\u043C\u0443\u0440\u0438\u0442\u0441\u044F: <npc_speech lang=\"Persian\">\u0412
      \u0421\u043E\u0433\u0434\u0438\u0430\u043D\u0435 \u0442\u0430\u043A\u0438\u0435
      \u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u0421\u0430\u0441\u0430\u043D\u0438\u0434\u044B
      - \u0442\u0440\u0438\u0441\u0442\u0430 \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434.</npc_speech>
      \u0423 \u043A\u0430\u043C\u043D\u044F - \u0441\u043B\u043E\u0439 \u043C\u043E\u043D\u0435\u0442,
      \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0445 \u0440\u0438\u0442\u0443\u0430\u043B\u044C\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024883
    m_Localized: "\u041F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0432\u0440\u0435\u043C\u044F
      \u043D\u0430 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024884
    m_Localized: "\u0420\u0443\u0441\u0442\u0430\u043C \u0438 \u0441\u0442\u0430\u0440\u0448\u0438\u0439
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0447\u0430\u0441 \u0441\u043F\u043E\u0440\u0438\u043B\u0438
      \u043D\u0430\u0434 \u043A\u0430\u043C\u043D\u0435\u043C, \u0441\u0432\u0435\u0440\u044F\u044F\u0441\u044C
      \u0441\u043E \u0441\u0432\u0438\u0442\u043A\u043E\u043C \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445
      \u0437\u043D\u0430\u043A\u043E\u0432. \u041F\u0440\u043E\u0447\u043B\u0438:
      \u0432\u043E\u0434\u0430 - \u0432\u043E\u0441\u0435\u043C\u044C \u0444\u0430\u0440\u0441\u0430\u0445\u043E\u0432
      \u0432\u043F\u0440\u0430\u0432\u043E. \u041A\u0440\u044E\u043A \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439.
      \u0412\u043E\u0434\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u0438\u043C\u0435\u043D\u043D\u043E \u0442\u0430\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024885
    m_Localized: "\u0417\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u0442\u044C \u043D\u0430\u0434\u043F\u0438\u0441\u044C
      \u0438 \u0438\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024886
    m_Localized: "\u041F\u0438\u0441\u0430\u0440\u044C \u0441\u043A\u043E\u043F\u0438\u0440\u043E\u0432\u0430\u043B
      \u0437\u043D\u0430\u043A\u0438 \u043D\u0430 \u0431\u0435\u0440\u0435\u0441\u0442\u0443.
      \u0412 \u0425\u043E\u0442\u0430\u043D\u0435 \u0433\u0440\u0430\u043C\u043E\u0442\u043D\u044B\u0439
      \u043C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0439 \u043C\u043E\u043D\u0430\u0445
      \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u043B \u043D\u0430\u0434\u043F\u0438\u0441\u044C
      \u0437\u0430 \u0447\u0430\u0448\u043A\u0443 \u0447\u0430\u044F: \u0441\u0442\u043E\u043B\u0431
      \u043E\u0442\u043C\u0435\u0447\u0430\u043B \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0443\u044E
      \u0434\u043E\u0440\u043E\u0433\u0443 \u0432 \u043E\u0431\u0445\u043E\u0434
      \u0431\u043E\u043B\u043E\u0442\u0430. \u041E\u043D\u0438 \u0432\u044B\u0431\u0440\u0430\u043B\u0438
      \u0432\u0435\u0440\u043D\u043E \u0438 \u043D\u0435 \u0437\u043D\u0430\u043B\u0438
      \u043E\u0431 \u044D\u0442\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024887
    m_Localized: "\u041D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F
      - \u0438\u0434\u0442\u0438 \u0438\u043D\u0441\u0442\u0438\u043D\u043A\u0442\u0438\u0432\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024888
    m_Localized: "\u0423\u0448\u043B\u0438 \u0431\u044B\u0441\u0442\u0440\u043E.
      \u0412\u044B\u0431\u0440\u0430\u043B\u0438 \u043B\u0435\u0432\u0443\u044E \u0440\u0430\u0437\u0432\u0438\u043B\u043A\u0443
      \u043D\u0430\u0443\u0433\u0430\u0434. \u0427\u0435\u0440\u0435\u0437 \u043B\u0438
      \u0442\u0440\u043E\u043F\u0430 \u0441\u0442\u0430\u043B\u0430 \u043A\u0430\u043C\u0435\u043D\u0438\u0441\u0442\u0435\u0435
      \u0438 \u043A\u0440\u0443\u0447\u0435. \u041F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0430\u044F
      \u043B\u0438 \u044D\u0442\u043E \u0434\u043E\u0440\u043E\u0433\u0430 - \u0442\u0430\u043A
      \u0438 \u043D\u0435 \u0443\u0437\u043D\u0430\u043B\u0438; \u0432\u044B\u0448\u043B\u0438
      \u043A\u0443\u0434\u0430 \u043D\u0443\u0436\u043D\u043E, \u043D\u043E \u043F\u043E\u0442\u0440\u0430\u0442\u0438\u043B\u0438
      \u0431\u043E\u043B\u044C\u0448\u0435 \u0441\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024889
    m_Localized: "\u0422\u0430\u0439\u043D\u0438\u043A \u0443 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024890
    m_Localized: "\u041F\u043E\u043B\u0443\u0437\u0430\u0441\u044B\u043F\u0430\u043D\u043D\u044B\u0439
      \u0443\u0433\u043E\u043B \u0441\u0442\u0430\u0440\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0441\u0430\u0440\u0430\u044F:
      \u043A\u0438\u0440\u043F\u0438\u0447 \u043E\u0441\u044B\u043F\u0430\u043B\u0441\u044F,
      \u0438 \u043F\u043E\u0434 \u043D\u0438\u043C - \u0433\u043E\u0440\u043B\u043E\u0432\u0438\u043D\u0430
      \u0433\u043B\u0438\u043D\u044F\u043D\u043E\u0433\u043E \u043A\u0443\u0432\u0448\u0438\u043D\u0430,
      \u0437\u0430\u043F\u0435\u0447\u0430\u0442\u0430\u043D\u043D\u043E\u0433\u043E
      \u043A\u0440\u0430\u0441\u043D\u043E\u0439 \u0441\u043C\u043E\u043B\u043E\u0439.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0411\u0443\u0433\u0430 \u043A\u043E\u0432\u044B\u0440\u044F\u0435\u0442
      \u0441\u043C\u043E\u043B\u0443 \u043D\u043E\u0436\u043E\u043C: \u0432\u043D\u0443\u0442\u0440\u0438
      \u043C\u043E\u043D\u0435\u0442\u044B, \u043C\u043E\u0442\u043E\u043A \u0441\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u043E\u0439
      \u043F\u0440\u043E\u0432\u043E\u043B\u043E\u043A\u0438 \u0438 \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u0441\u0432\u0451\u0440\u0442\u043E\u043A. \u041C\u043E\u043D\u0435\u0442\u044B
      \u0434\u0438\u0440\u0445\u0430\u043C\u043E\u0432\u044B\u0435, \u0441 \u043F\u043E\u0440\u0442\u0440\u0435\u0442\u043E\u043C
      \u0410\u0431\u0431\u0430\u0441\u0438\u0434\u0430, \u043D\u043E \u043A\u0443\u0432\u0448\u0438\u043D
      \u0437\u0430\u0440\u044B\u0442 \u0434\u0430\u0432\u043D\u043E - \u0441\u0432\u0435\u0440\u0445\u0443
      \u043D\u0430\u0440\u043E\u0441 \u0431\u0443\u0440\u044C\u044F\u043D. \u041A\u0442\u043E-\u0442\u043E
      \u0436\u0434\u0430\u043B \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F,
      \u043D\u043E \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F.
      \u041C\u0435\u0441\u0442\u043E \u0431\u0435\u0437\u043B\u044E\u0434\u043D\u043E\u0435
      - \u043D\u0438\u043A\u043E\u0433\u043E, \u043A\u0442\u043E \u043C\u043E\u0433
      \u0431\u044B \u0441\u043F\u0440\u043E\u0441\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024891
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0432\u0441\u0451 \u0438\u0437
      \u0442\u0430\u0439\u043D\u0438\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024892
    m_Localized: "\u0421\u0435\u0440\u0435\u0431\u0440\u044F\u043D\u0430\u044F \u043F\u0440\u043E\u0432\u043E\u043B\u043E\u043A\u0430
      \u0438 \u043C\u043E\u043D\u0435\u0442\u044B \u043F\u0435\u0440\u0435\u0448\u043B\u0438
      \u0432 \u0441\u0443\u043C\u043A\u0443. \u041D\u0438\u043A\u0442\u043E \u043D\u0435
      \u0432\u0438\u0434\u0435\u043B. \u041D\u043E \u0443 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E
      \u0433\u043E\u0440\u043E\u0434\u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0441 \u0442\u0430\u0442\u0443\u0438\u0440\u043E\u0432\u043A\u043E\u0439 \u0440\u043E\u0434\u0430
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442 \u0441\u043C\u043E\u0442\u0440\u0435\u043B
      \u043D\u0430 \u0441\u0435\u0440\u0435\u0431\u0440\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u043F\u0440\u0438\u0441\u0442\u0430\u043B\u044C\u043D\u043E. \u0427\u0443\u0436\u043E\u0435
      \u0434\u043E\u0431\u0440\u043E \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u0441\u043B\u0435\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024893
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0447\u0430\u0441\u0442\u044C -
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0437\u043D\u0430\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024894
    m_Localized: "\u0412\u0437\u044F\u043B\u0438 \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443
      \u043C\u043E\u043D\u0435\u0442, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u0432\u0435\u0440\u043D\u0443\u043B\u0438 \u0432 \u043A\u0443\u0432\u0448\u0438\u043D
      \u0438 \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438 \u043D\u0430
      \u0432\u0438\u0434\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E. \u0412
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u0433\u043E\u0440\u043E\u0434\u0435
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438 \u043A\u0443\u043F\u0446\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u0438\u043B
      \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C: \u043E\u043D \u0434\u0430\u0432\u043D\u043E
      \u0438\u0441\u043A\u0430\u043B \u044D\u0442\u043E\u0442 \u0442\u0430\u0439\u043D\u0438\u043A.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u0447\u0435\u0441\u0442\u043D\u043E\u0433\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430 \u0441\u0442\u043E\u0438\u0442
      \u0434\u043E\u0440\u043E\u0436\u0435 \u0441\u0435\u0440\u0435\u0431\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024895
    m_Localized: "\u041D\u0435 \u0442\u0440\u043E\u0433\u0430\u0442\u044C - \u0447\u0443\u0436\u043E\u0435
      \u0434\u043E\u0431\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024896
    m_Localized: "\u041F\u0440\u043E\u0448\u043B\u0438 \u043C\u0438\u043C\u043E.
      \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u0433\u043E\u0440\u043E\u0434\u0435
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0438 \u043E \u0442\u0430\u0439\u043D\u0438\u043A\u0435
      \u0443 \u0440\u0430\u0437\u0432\u0430\u043B\u0438\u043D. \u041C\u0435\u0441\u0442\u043D\u044B\u0439
      \u043A\u0443\u043F\u0435\u0446 \u0432\u044B\u0441\u043B\u0443\u0448\u0430\u043B
      \u0441 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C\u044E
      \u0438 \u0432\u0435\u0447\u0435\u0440\u043E\u043C \u043F\u0440\u0438\u043D\u0451\u0441
      \u043A\u043E\u0440\u0437\u0438\u043D\u0443 \u0444\u0438\u043D\u0438\u043A\u043E\u0432
      - \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0436\u0435\u0441\u0442
      \u043F\u0440\u0438\u0437\u043D\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
      \u043E\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
      \u043F\u043E\u043D\u044F\u043B \u0447\u0442\u043E \u0435\u043C\u0443 \u0432\u0435\u0440\u043D\u0443\u043B\u0438
      \u043D\u0430\u0434\u0435\u0436\u0434\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024897
    m_Localized: "\u0417\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u0438\u0435
      \u0440\u0443\u0438\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024898
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0433\u043E\u0440\u0435\u043B\u043E\u0439
      \u0441\u043C\u043E\u043B\u044B, \u0437\u0430\u0441\u0442\u0430\u0440\u0435\u043B\u044B\u0439
      - \u043E\u0433\u043E\u043D\u044C \u0437\u0434\u0435\u0441\u044C \u0436\u0433\u043B\u0438
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0440\u0430\u0437,
      \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u043F\u0440\u0438
      \u0421\u0430\u0441\u0430\u043D\u0438\u0434\u0430\u0445. \u0422\u0440\u0438
      \u0441\u0442\u0435\u043D\u044B \u0441\u0442\u043E\u044F\u0442, \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u0430\u044F
      \u043E\u0431\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044C \u0432\u043D\u0443\u0442\u0440\u044C.
      \u0412 \u043D\u0438\u0448\u0435 \u043D\u0430\u0434 \u0430\u043B\u0442\u0430\u0440\u0451\u043C
      - \u0431\u0440\u043E\u043D\u0437\u043E\u0432\u0430\u044F \u0447\u0430\u0448\u0430,
      \u0437\u0435\u043B\u0435\u043D\u043E\u0432\u0430\u0442\u0430\u044F \u043E\u0442
      \u043F\u0430\u0442\u0438\u043D\u044B, \u0438 \u043A\u0443\u0441\u043E\u0447\u043A\u0438
      \u0437\u0430\u0441\u043E\u0445\u0448\u0435\u0433\u043E \u0441\u0430\u043D\u0434\u0430\u043B\u0430
      \u0432 \u043F\u0435\u043F\u043B\u0435. \u041D\u0430 \u043F\u043B\u0438\u0442\u0435
      \u043F\u043E\u043B\u0430 - \u0440\u0435\u043B\u044C\u0435\u0444 \u0410\u0445\u0443\u0440\u0430-\u041C\u0430\u0437\u0434\u044B
      \u0441 \u043A\u0440\u044B\u043B\u044C\u044F\u043C\u0438, \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
      \u0441\u0431\u0438\u0442\u044B\u0439. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0420\u0443\u0441\u0442\u0430\u043C \u0441\u043D\u0438\u043C\u0430\u0435\u0442
      \u0448\u0430\u043F\u043A\u0443: \u044D\u0442\u043E \u0431\u044B\u043B \u0430\u0442\u0435\u0448\u043A\u0430\u0434\u0435
      - \u0445\u0440\u0430\u043C \u0441\u0432\u044F\u0449\u0435\u043D\u043D\u043E\u0433\u043E
      \u043E\u0433\u043D\u044F. \u0411\u0440\u0430\u0442\u044C \u0447\u0442\u043E-\u0442\u043E
      \u043E\u0442\u0441\u044E\u0434\u0430 - \u0434\u043B\u044F \u0437\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0446\u0435\u0432
      \u043E\u0441\u043A\u043E\u0440\u0431\u043B\u0435\u043D\u0438\u0435, \u0437\u0430
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u043F\u043E\u043C\u043D\u044F\u0442
      \u043F\u043E\u043A\u043E\u043B\u0435\u043D\u0438\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993436024899
    m_Localized: "\u0422\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043E\u0431\u044B\u0441\u043A\u0430\u0442\u044C
      \u0445\u0440\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219136
    m_Localized: "\u0417\u0430 \u043E\u0431\u0432\u0430\u043B\u0438\u0432\u0448\u0435\u0439\u0441\u044F
      \u043F\u043B\u0438\u0442\u043E\u0439 \u043D\u0430\u0448\u043B\u0438 \u043C\u0435\u0434\u043D\u0443\u044E
      \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0443 \u0441 \u0440\u0438\u0442\u0443\u0430\u043B\u044C\u043D\u044B\u043C\u0438
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430\u043C\u0438 \u0438 \u0441\u0442\u0430\u0440\u043E\u0439
      \u043C\u043E\u043D\u0435\u0442\u043E\u0439 \u0421\u0430\u0441\u0430\u043D\u0438\u0434\u043E\u0432.
      \u0426\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u0435\u0441\u0442\u044C.
      \u041D\u043E \u0432 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435 \u043D\u0430 \u043E\u0431\u043E\u0437
      \u043A\u043E\u0441\u0438\u043B\u0438\u0441\u044C \u0442\u0440\u043E\u0435 \u043A\u0443\u043F\u0446\u043E\u0432
      \u0441 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u044B\u043C\u0438
      \u0431\u0435\u043B\u044B\u043C\u0438 \u043E\u0434\u0435\u0436\u0434\u0430\u043C\u0438.
      \u0421\u043B\u0443\u0445\u0438 \u0445\u043E\u0434\u044F\u0442 \u0431\u044B\u0441\u0442\u0440\u043E
      \u043F\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C\u0443 \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219137
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u043E\u0434\u0438\u043D \u043F\u0440\u0435\u0434\u043C\u0435\u0442
      - \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219138
    m_Localized: "\u0411\u0440\u043E\u043D\u0437\u043E\u0432\u0443\u044E \u0447\u0430\u0448\u0443
      \u0432\u0437\u044F\u043B\u0438 \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C
      \u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438 \u043F\u043E\u0447\u0442\u0435\u043D\u0438\u044F.
      \u0412 \u0433\u043E\u0440\u043E\u0434\u0435 \u0435\u0451 \u043F\u0440\u043E\u0434\u0430\u043B\u0438
      \u043C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u043E\u043C\u0443 \u043C\u043E\u043D\u0430\u0445\u0443,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0437\u043D\u0430\u043B \u0435\u0451
      \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
      \u0438 \u043E\u0442\u043D\u0451\u0441\u0441\u044F \u0441 \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435\u043C.
      \u0417\u0430\u043F\u0430\u0445 \u0441\u0430\u043D\u0434\u0430\u043B\u0430 \u0435\u0449\u0451
      \u0434\u043E\u043B\u0433\u043E \u0434\u0435\u0440\u0436\u0430\u043B\u0441\u044F
      \u043D\u0430 \u0440\u0443\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219139
    m_Localized: "\u0423\u0439\u0442\u0438 \u0441 \u043F\u043E\u0447\u0442\u0435\u043D\u0438\u0435\u043C
      - \u043D\u0435 \u0442\u0440\u043E\u0433\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219140
    m_Localized: "\u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B \u043C\u0438\u043C\u043E.
      \u0420\u0443\u0441\u0442\u0430\u043C \u043F\u043E\u0441\u0442\u0430\u0432\u0438\u043B
      \u0443 \u0432\u0445\u043E\u0434\u0430 \u043A\u0430\u043C\u0435\u0448\u0435\u043A
      - \u0437\u043D\u0430\u043A \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u044F
      \u043F\u043E \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u043E\u043C\u0443
      \u043E\u0431\u044B\u0447\u0430\u044E. \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435 \u0437\u043E\u0440\u043E\u0430\u0441\u0442\u0440\u0438\u0439\u0441\u043A\u0438\u0439
      \u043A\u0443\u043F\u0435\u0446 \u0411\u0430\u0445\u0440\u0430\u043C \u0441\u043A\u0430\u0437\u0430\u043B:
      \u0437\u043D\u0430\u044E \u044D\u0442\u043E\u0442 \u0445\u0440\u0430\u043C.
      \u0418 \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u043D\u0435\u043F\u043B\u043E\u0445\u0443\u044E
      \u0446\u0435\u043D\u0443 \u043D\u0430 \u0441\u043F\u0435\u0446\u0438\u0438
      - \u043B\u044E\u0434\u0438 \u0437\u0430\u043C\u0435\u0447\u0430\u044E\u0442,
      \u043A\u0442\u043E \u0431\u0435\u0440\u0435\u0436\u0451\u0442 \u0441\u0442\u0430\u0440\u0438\u043D\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219141
    m_Localized: "\u041D\u0430\u0434\u043F\u0438\u0441\u044C \u043D\u0430 \u043A\u0430\u043C\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219142
    m_Localized: "\u041F\u043B\u043E\u0441\u043A\u0438\u0439 \u043A\u0430\u043C\u0435\u043D\u044C
      \u0443 \u0442\u0440\u043E\u043F\u044B - \u043D\u0435 \u0441\u0442\u043E\u043B\u0431,
      \u043F\u0440\u043E\u0441\u0442\u043E \u0432\u0430\u043B\u0443\u043D, \u043D\u043E
      \u043A\u0442\u043E-\u0442\u043E \u0441\u0442\u0430\u0440\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0432\u044B\u0431\u0438\u043B \u043D\u0430 \u043D\u0451\u043C \u0434\u0432\u0435
      \u0441\u0442\u0440\u043E\u043A\u0438 \u043F\u0438\u0441\u044C\u043C\u0435\u043D\u0430\u043C\u0438.
      \u0428\u0440\u0438\u0444\u0442 \u0441\u0440\u0435\u0434\u043D\u0435\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438\u0439,
      \u043F\u0435\u0445\u043B\u0435\u0432\u0438\u0439\u0441\u043A\u0438\u0439, \u044F\u0432\u043D\u043E
      \u0441\u0442\u0430\u0440\u044B\u0439: \u0431\u0443\u043A\u0432\u044B \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0435,
      \u0443\u0436\u0435 \u0437\u0430\u0440\u043E\u0441\u0448\u0438\u0435 \u043C\u0445\u043E\u043C
      \u043F\u043E \u043A\u0440\u0430\u044F\u043C. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u0420\u0443\u0441\u0442\u0430\u043C \u0447\u0438\u0442\u0430\u0435\u0442 \u043F\u043E-\u043F\u0435\u0440\u0441\u0438\u0434\u0441\u043A\u0438,
      \u043D\u043E \u044D\u0442\u043E\u0442 \u0434\u0438\u0430\u043B\u0435\u043A\u0442
      - \u043D\u0435 \u0435\u0433\u043E; \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u0442
      \u0447\u0435\u0440\u0435\u0437 \u0441\u043B\u043E\u0432\u043E. \u0421\u043B\u043E\u0432\u043E
      \xAB\u0432\u043E\u0434\u0430\xBB \u043E\u043D \u0443\u0437\u043D\u0430\u0451\u0442
      \u0442\u043E\u0447\u043D\u043E. \u0421\u043B\u043E\u0432\u043E \xAB\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C\xBB
      - \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E. \u0418\u043B\u0438 \xAB\u0432\u043E\u0441\u0442\u043E\u043A\xBB?
      \u0421\u0442\u0440\u0435\u043B\u043A\u0430 \u0432\u044B\u0440\u0435\u0437\u0430\u043D\u0430
      \u0447\u0443\u0442\u044C \u043D\u0438\u0436\u0435, \u043D\u043E \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443 \u0433\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219143
    m_Localized: "\u041F\u043E\u0442\u0440\u0430\u0442\u0438\u0442\u044C \u0432\u0440\u0435\u043C\u044F
      \u043D\u0430 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219144
    m_Localized: "\u0420\u0443\u0441\u0442\u0430\u043C \u0438 \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442
      \u043F\u0440\u043E\u0432\u0435\u043B\u0438 \u0447\u0430\u0441 \u043D\u0430\u0434
      \u043D\u0430\u0434\u043F\u0438\u0441\u044C\u044E, \u0441\u0432\u0435\u0440\u044F\u044F\u0441\u044C
      \u0441 \u043A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u0438\u043C \u0441\u043F\u0440\u0430\u0432\u043E\u0447\u043D\u0438\u043A\u043E\u043C
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0445 \u0437\u043D\u0430\u043A\u043E\u0432.
      \u0418\u0442\u043E\u0433: \u0432\u043E\u0434\u0430 \u0432 \u0434\u0432\u0443\u0445
      \u0444\u0430\u0440\u0441\u0430\u0445\u0430\u0445 \u043D\u0430 \u0432\u043E\u0441\u0442\u043E\u043A,
      \u0443 \u0442\u0440\u0451\u0445 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0445
      \u0441\u043E\u0441\u0435\u043D. \u0421\u044A\u0435\u043B\u0438 \u0432\u0440\u0435\u043C\u044F,
      \u043D\u043E \u043A\u043E\u043B\u043E\u0434\u0435\u0446 \u043D\u0430\u0448\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219145
    m_Localized: "\u0421\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0442\u043E\u043B\u043A\u043E\u0432\u0430\u0442\u0435\u043B\u044F
      \u0432 \u0433\u043E\u0440\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219146
    m_Localized: "\u0412 \u0433\u043E\u0440\u043E\u0434\u0435 \u043C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0439
      \u043C\u043E\u043D\u0430\u0445 \u0437\u0430 \u043F\u0440\u0438\u0433\u043E\u0440\u0448\u043D\u044E
      \u043C\u043E\u043D\u0435\u0442 \u043F\u0440\u043E\u0447\u0451\u043B \u043D\u0430\u0434\u043F\u0438\u0441\u044C
      \u0437\u0430 \u043C\u0438\u043D\u0443\u0442\u0443: \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      \u043E \u043D\u0435\u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043C\u043E\u043C
      \u0443\u0447\u0430\u0441\u0442\u043A\u0435 \u0433\u043E\u0440\u043D\u043E\u0433\u043E
      \u0441\u043A\u043B\u043E\u043D\u0430. \u041E\u0431\u043E\u0437 \u0441\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043B
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442. \u0422\u043E\u043B\u043A\u043E\u0432\u0430\u0442\u0435\u043B\u044C
      \u0434\u043E\u0431\u0430\u0432\u0438\u043B: \u044D\u0442\u0443 \u043D\u0430\u0434\u043F\u0438\u0441\u044C
      \u0441\u0434\u0435\u043B\u0430\u043B\u0438 \u043A\u0443\u043F\u0446\u044B \u0440\u043E\u0434\u0430
      \u0411\u0430\u0445\u0440\u0430\u043C\u043E\u0432 \u043B\u0435\u0442 \u0434\u0432\u0435\u0441\u0442\u0438
      \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219147
    m_Localized: "\u0418\u0434\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435 -
      \u043D\u0435\u043A\u043E\u0433\u0434\u0430 \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219148
    m_Localized: "\u041F\u0440\u043E\u0448\u043B\u0438 \u043C\u0438\u043C\u043E.
      \u0427\u0435\u0440\u0435\u0437 \u043B\u0438 \u0434\u043E\u0440\u043E\u0433\u0430
      \u0441\u0442\u0430\u043B\u0430 \u043A\u0440\u0443\u0442\u043E \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F
      - \u0447\u0442\u043E-\u0442\u043E \u0437\u0434\u0435\u0441\u044C \u043D\u0435
      \u0442\u0430\u043A. \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u043D\u0430\u0434\u043F\u0438\u0441\u044C
      \u0438\u043C\u0435\u043D\u043D\u043E \u043E\u0431 \u044D\u0442\u043E\u043C
      \u0438 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0430\u043B\u0430.
      \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0434\u0440\u0430\u043B\u0441\u044F
      \u0447\u0435\u0440\u0435\u0437 \u043A\u0430\u043C\u0435\u043D\u043D\u044B\u0439
      \u0441\u043A\u043B\u043E\u043D \u0441 \u0442\u0440\u0443\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219149
    m_Localized: "\u041F\u043E\u0433\u0438\u0431\u0448\u0438\u0439 \u043E\u0431\u043E\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219150
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u043D\u0435 \u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0441\u044F
      - \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u0430\u0432\u043D\u043E.
      \u0422\u0440\u0438 \u043E\u0441\u0442\u043E\u0432\u0430 \u043F\u043E\u0432\u043E\u0437\u043E\u043A,
      \u043F\u043E\u0431\u0435\u043B\u0435\u0432\u0448\u0438\u0435 \u043F\u043E\u0434
      \u0441\u043E\u043B\u043D\u0446\u0435\u043C \u043A\u043E\u0441\u0442\u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432,
      \u0440\u0430\u0441\u0441\u044B\u043F\u0430\u0432\u0448\u0438\u0435\u0441\u044F
      \u0442\u044E\u043A\u0438. \u041A\u043E\u0435-\u0433\u0434\u0435 - \u043C\u043E\u043D\u0435\u0442\u044B,
      \u0432\u0442\u043E\u043F\u0442\u0430\u043D\u043D\u044B\u0435 \u0432 \u043F\u044B\u043B\u044C,
      \u043E\u0431\u043B\u043E\u043C\u043E\u043A \u043A\u0440\u0438\u0432\u043E\u0433\u043E
      \u043C\u0435\u0447\u0430. \u041E\u0434\u0438\u043D \u0438\u0437 \u0432\u044C\u044E\u0447\u043D\u044B\u0445
      \u044F\u0449\u0438\u043A\u043E\u0432 \u043F\u043E\u0434 \u043E\u043F\u0440\u043E\u043A\u0438\u043D\u0443\u0442\u043E\u0439
      \u043F\u043E\u0432\u043E\u0437\u043A\u043E\u0439 \u043F\u043E\u0447\u0442\u0438
      \u0446\u0435\u043B. \u0421\u043B\u0435\u0434\u043E\u0432 \u043D\u0430\u043F\u0430\u0434\u0435\u043D\u0438\u044F
      \u043D\u0435\u0442 - \u0438\u043B\u0438 \u0438\u0445 \u0443\u0436\u0435 \u043D\u0435
      \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C. \u0416\u0430\u0440\u0430?
      \u0416\u0430\u0436\u0434\u0430? \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438?
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0411\u0443\u0433\u0430 \u0441\u043D\u0438\u043C\u0430\u0435\u0442
      \u0448\u0430\u043F\u043A\u0443: \u043A\u0442\u043E \u0431\u044B \u044D\u0442\u043E
      \u043D\u0438 \u0431\u044B\u043B, \u043E\u043D\u0438 \u0448\u043B\u0438 \u0442\u0435\u043C
      \u0436\u0435 \u043F\u0443\u0442\u0451\u043C. \u0413\u0440\u0443\u0437 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
      \u043C\u043E\u0436\u043D\u043E \u0432\u0437\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219151
    m_Localized: "\u0412\u0437\u044F\u0442\u044C \u0432\u0435\u0441\u044C \u0443\u0446\u0435\u043B\u0435\u0432\u0448\u0438\u0439
      \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219152
    m_Localized: "\u0412 \u044F\u0449\u0438\u043A\u0435 \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u043A\u0443\u0441\u043A\u0438 \u0448\u0451\u043B\u043A\u0430-\u0441\u044B\u0440\u0446\u0430
      \u0438 \u0444\u0430\u0440\u0444\u043E\u0440\u043E\u0432\u044B\u0435 \u0447\u0430\u0448\u043A\u0438,
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0445
      \u0443\u0446\u0435\u043B\u0435\u043B\u0430. \u0412 \u0433\u043E\u0440\u043E\u0434\u0435
      \u043F\u0440\u043E\u0434\u0430\u043B\u0438 \u0431\u0435\u0437 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0432\u043E\u043F\u0440\u043E\u0441\u043E\u0432. \u041D\u043E \u0420\u0443\u0441\u0442\u0430\u043C
      \u0434\u043E\u043B\u0433\u043E \u043C\u043E\u043B\u0447\u0430\u043B \u043F\u043E\u0441\u043B\u0435
      - \u043E\u043D \u0443\u0437\u043D\u0430\u043B \u043C\u0435\u0442\u043A\u0438
      \u0440\u043E\u0434\u0430 \u0421\u0430\u043C\u0435\u0445\u043E\u0432 \u043D\u0430
      \u0442\u044E\u043A\u0430\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219153
    m_Localized: "\u041F\u043E\u0445\u043E\u0440\u043E\u043D\u0438\u0442\u044C \u043E\u0441\u0442\u0430\u043D\u043A\u0438
      \u043F\u043E \u043E\u0431\u044B\u0447\u0430\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219154
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u043B\u0438 \u0434\u0432\u0430 \u0447\u0430\u0441\u0430
      \u0437\u0430 \u0440\u0430\u0431\u043E\u0442\u043E\u0439 - \u0441\u043E\u0431\u0440\u0430\u043B\u0438
      \u043A\u043E\u0441\u0442\u0438, \u043D\u0430\u0441\u044B\u043F\u0430\u043B\u0438
      \u0445\u043E\u043B\u043C, \u0420\u0443\u0441\u0442\u0430\u043C \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u043B
      \u043C\u043E\u043B\u0438\u0442\u0432\u0443. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0432\u0440\u0435\u043C\u044F \u0438 \u0435\u0434\u0443. \u041D\u043E \u0432
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u0433\u043E\u0440\u043E\u0434\u0435
      \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438 \u043A\u0443\u043F\u0446\u0430
      \u041D\u0430\u043D\u0430\u0438\u0434\u0430\u0442\u0430: \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
      \u043E\u043D \u0438\u0441\u043A\u0430\u043B \u0441\u043B\u0435\u0434\u044B
      \u044D\u0442\u043E\u0433\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u043C\u043D\u043E\u0433\u043E \u043B\u0435\u0442. \u0417\u0430\u043F\u043B\u0430\u0442\u0438\u043B
      \u0437\u0430 \u0434\u043E\u0431\u0440\u0443\u044E \u0432\u0435\u0441\u0442\u044C
      \u0449\u0435\u0434\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219155
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C - \u043F\u043E\u043D\u044F\u0442\u044C
      \u0447\u0442\u043E \u0441\u043B\u0443\u0447\u0438\u043B\u043E\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219156
    m_Localized: "\u0411\u0443\u0433\u0430 \u043D\u0430\u0448\u0451\u043B \u0441\u0442\u0440\u0435\u043B\u0443
      \u0441 \u0442\u044E\u0440\u043A\u0441\u043A\u0438\u043C \u043E\u043F\u0435\u0440\u0435\u043D\u0438\u0435\u043C,
      \u0432\u0431\u0438\u0442\u0443\u044E \u0432 \u0431\u043E\u0440\u0442 \u043F\u043E\u0432\u043E\u0437\u043A\u0438.
      \u0417\u043D\u0430\u0447\u0438\u0442, \u043D\u0430\u043B\u0451\u0442 - \u0438
      \u0434\u0430\u0432\u043D\u0438\u0439. \u042D\u0442\u0438 \u043F\u043B\u0435\u043C\u0435\u043D\u0430
      \u0443\u0436\u0435 \u043E\u0442\u043A\u043E\u0447\u0435\u0432\u0430\u043B\u0438.
      \u041E\u0431\u043E\u0437 \u043F\u043E\u043B\u0443\u0447\u0438\u043B \u0432\u0430\u0436\u043D\u043E\u0435
      \u0437\u043D\u0430\u043D\u0438\u0435: \u0437\u0434\u0435\u0441\u044C \u043E\u043F\u0430\u0441\u043D\u043E
      \u043D\u0435 \u0438\u0437-\u0437\u0430 \u043F\u0440\u0438\u0440\u043E\u0434\u044B,
      \u0430 \u0438\u0437-\u0437\u0430 \u043C\u0430\u0440\u0448\u0440\u0443\u0442\u0430.
      \u0421\u043A\u043E\u0440\u0440\u0435\u043A\u0442\u0438\u0440\u043E\u0432\u0430\u043B\u0438
      \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0439 \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219157
    m_Localized: "\u0421\u043A\u0440\u044B\u0442\u044B\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219158
    m_Localized: "\u0417\u0430\u043F\u0430\u0445 \u0432\u043B\u0430\u0436\u043D\u043E\u0433\u043E
      \u043C\u0445\u0430 \u0437\u0430 \u0433\u043E\u0440\u044F\u0447\u0438\u043C
      \u0432\u043E\u0437\u0434\u0443\u0445\u043E\u043C \u043F\u0443\u0441\u0442\u044B\u043D\u0438
      - \u043D\u0435\u043E\u0431\u044A\u044F\u0441\u043D\u0438\u043C\u044B\u0439,
      \u0442\u043E\u0447\u043D\u044B\u0439. \u0421\u0442\u0430\u0440\u0430\u044F
      \u0440\u0443\u043A\u043E\u043F\u0438\u0441\u044C \u0443 \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430
      \u0424\u0430\u0440\u0440\u0443\u0445\u0430 \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043B\u0430
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A \u0437\u0430 \u0433\u0440\u0430\u043D\u0438\u0442\u043D\u044B\u043C
      \u0432\u044B\u0441\u0442\u0443\u043F\u043E\u043C \u043A \u0441\u0435\u0432\u0435\u0440\u0443
      \u043E\u0442 \u0441\u0443\u0445\u043E\u0433\u043E \u0440\u0443\u0441\u043B\u0430.
      \u0412\u043E\u0442 \u0438 \u0433\u0440\u0430\u043D\u0438\u0442, \u0432\u043E\u0442
      \u0438 \u0440\u0443\u0441\u043B\u043E. \u0417\u0430 \u0432\u044B\u0441\u0442\u0443\u043F\u043E\u043C
      - \u0443\u0437\u043A\u0430\u044F \u0449\u0435\u043B\u044C, \u0430 \u0438\u0437
      \u043D\u0435\u0451 \u0432\u044B\u0442\u0435\u043A\u0430\u0435\u0442 \u0442\u043E\u043D\u043A\u0430\u044F
      \u0441\u0442\u0440\u0443\u0439\u043A\u0430: \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F,
      \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u0430\u044F, \u0431\u0435\u0437
      \u0437\u0430\u043F\u0430\u0445\u0430 \u0441\u043E\u043B\u0438. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043F\u043E\u0447\u0443\u044F\u043B\u0438 \u0440\u0430\u043D\u044C\u0448\u0435
      \u043B\u044E\u0434\u0435\u0439. \u041C\u0435\u0441\u0442\u043E \u0441\u043A\u0440\u044B\u0442\u043E
      \u0442\u0430\u043A \u0445\u043E\u0440\u043E\u0448\u043E, \u0447\u0442\u043E
      \u0447\u0443\u0436\u043E\u0439 \u043D\u0435 \u043D\u0430\u0439\u0434\u0451\u0442
      \u0431\u0435\u0437 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219159
    m_Localized: "\u041F\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u044C \u0432\u0441\u0435
      \u0437\u0430\u043F\u0430\u0441\u044B \u0432\u043E\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219160
    m_Localized: "\u0427\u0430\u0441\u043E\u0432\u0430\u044F \u0441\u0442\u043E\u044F\u043D\u043A\u0430
      - \u0438 \u0432\u0441\u0435 \u0431\u0443\u0440\u0434\u044E\u043A\u0438 \u0442\u0443\u0433\u0438\u0435,
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u043D\u0430\u043F\u043E\u0435\u043D\u044B.
      \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u0434\u0432\u0430 \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430
      \u043F\u0440\u043E\u0448\u043B\u0438 \u0431\u0435\u0437 \u043C\u044B\u0441\u043B\u0438
      \u043E \u0432\u043E\u0434\u0435. \u0422\u0430\u043A\u043E\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
      \u0441\u0442\u043E\u0438\u0442 \u043B\u044E\u0431\u043E\u0433\u043E \u043A\u0440\u044E\u043A\u0430
      \u043A \u043D\u0435\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219161
    m_Localized: "\u041F\u043E\u043C\u0435\u0442\u0438\u0442\u044C \u043D\u0430 \u043A\u0430\u0440\u0442\u0435
      - \u0441\u043E\u043E\u0431\u0449\u0438\u0442\u044C \u0434\u0440\u0443\u0433\u0438\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219162
    m_Localized: "\u0424\u0430\u0440\u0440\u0443\u0445 \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0437\u0430\u0440\u0438\u0441\u043E\u0432\u0430\u043B \u043E\u0440\u0438\u0435\u043D\u0442\u0438\u0440\u044B.
      \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u0433\u043E\u0440\u043E\u0434\u0435
      \u043F\u0435\u0440\u0435\u0434\u0430\u043B \u043A\u043E\u043F\u0438\u044E \u043A\u0443\u043F\u0435\u0447\u0435\u0441\u043A\u043E\u043C\u0443
      \u0441\u043E\u0432\u0435\u0442\u0443. \u042D\u0442\u043E \u0437\u043D\u0430\u043D\u0438\u0435
      \u0446\u0435\u043D\u0438\u0442\u0441\u044F \u043D\u0430 \u0442\u043E\u0440\u0433\u043E\u0432\u043E\u043C
      \u043F\u0443\u0442\u0438 - \u0438 \u043B\u044E\u0434\u0438 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B\u0438,
      \u043A\u0442\u043E \u0438\u043C \u0435\u0433\u043E \u0434\u0430\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219163
    m_Localized: "\u041E\u0442\u0434\u043E\u0445\u043D\u0443\u0442\u044C \u0437\u0434\u0435\u0441\u044C
      \u0446\u0435\u043B\u044B\u0439 \u0434\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219164
    m_Localized: "\u0414\u0435\u043D\u044C \u0443 \u0432\u043E\u0434\u044B. \u041B\u044E\u0434\u0438
      \u0432\u044B\u0441\u043F\u0430\u043B\u0438\u0441\u044C, \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043D\u0430\u0433\u0443\u043B\u044F\u043B\u0438 \u0436\u0438\u0440 \u043D\u0430
      \u0441\u043A\u0443\u0434\u043D\u044B\u0445 \u043A\u043E\u043B\u044E\u0447\u043A\u0430\u0445
      \u0443 \u0449\u0435\u043B\u0438. \u041F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u043B\u0438 \u0438 \u043F\u043E\u0434\u0442\u044F\u043D\u0443\u043B\u0438.
      \u0412\u044B\u0448\u043B\u0438 \u043D\u0430\u0437\u0430\u0432\u0442\u0440\u0430
      \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0432\u0448\u0438\u043C\u0438 -
      \u0445\u043E\u043B\u043E\u0434\u043D\u0430\u044F \u0432\u043E\u0434\u0430 \u0438
      \u0442\u0435\u043D\u044C \u0441\u043A\u0430\u043B\u044B \u0441\u0434\u0435\u043B\u0430\u043B\u0438
      \u0441\u0432\u043E\u0451 \u0434\u0435\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219165
    m_Localized: "\u041A\u043B\u043E\u0447\u043E\u043A \u0448\u0451\u043B\u043A\u0430
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219166
    m_Localized: "\u041D\u0430 \u043F\u044B\u043B\u044C\u043D\u043E\u0439 \u0442\u0440\u043E\u043F\u0435,
      \u043F\u0440\u0438\u0434\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0439 \u043A\u0430\u043C\u043D\u0435\u043C
      - \u043F\u0440\u044F\u043C\u043E\u0443\u0433\u043E\u043B\u044C\u043D\u044B\u0439
      \u043A\u0443\u0441\u043E\u043A \u0448\u0451\u043B\u043A\u0430 \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C
      \u0441 \u043B\u0430\u0434\u043E\u043D\u044C, \u0441 \u0447\u0430\u0441\u0442\u044C\u044E
      \u0443\u0437\u043E\u0440\u0430: \u0437\u043E\u043B\u043E\u0442\u044B\u0435
      \u043D\u0438\u0442\u0438 \u043F\u043E \u043A\u0440\u0430\u0441\u043D\u043E\u043C\u0443
      \u0444\u043E\u043D\u0443, \u043F\u0442\u0438\u0446\u0430 \u0441 \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0451\u0440\u0442\u044B\u043C\u0438
      \u043A\u0440\u044B\u043B\u044C\u044F\u043C\u0438, \u044F\u0432\u043D\u043E
      \u0445\u0430\u043D\u044C\u0441\u043A\u0430\u044F \u0440\u0430\u0431\u043E\u0442\u0430.
      \u0422\u043A\u0430\u043D\u044C \u043F\u043B\u043E\u0442\u043D\u0430\u044F,
      \u043D\u0438\u0442\u0438 \u043D\u0435 \u043E\u0441\u044B\u043F\u0430\u043B\u0438\u0441\u044C,
      \u043D\u0435\u0441\u043C\u043E\u0442\u0440\u044F \u043D\u0430 \u043B\u0435\u0436\u0430\u043D\u0438\u0435
      \u043F\u043E\u0434 \u0441\u043E\u043B\u043D\u0446\u0435\u043C - \u043D\u0435
      \u0434\u0435\u0448\u0451\u0432\u044B\u0439 \u0440\u044B\u043D\u043E\u043A.
      \u0411\u0443\u0433\u0430 \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442
      \u0435\u0433\u043E \u0434\u0432\u0443\u043C\u044F \u043F\u0430\u043B\u044C\u0446\u0430\u043C\u0438
      \u0438 \u043D\u044E\u0445\u0430\u0435\u0442: \u043B\u0451\u0433\u043A\u0438\u0439
      \u0437\u0430\u043F\u0430\u0445 \u0441\u0430\u043D\u0434\u0430\u043B\u043E\u0432\u043E\u0433\u043E
      \u043C\u0430\u0441\u043B\u0430 \u0435\u0449\u0451 \u0435\u0441\u0442\u044C.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043D \u043D\u0435\u0434\u0430\u0432\u043D\u043E.
      \u041A\u0442\u043E \u043D\u0451\u0441 \u0435\u0433\u043E - \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E,
      \u0441\u043B\u0435\u0434\u043E\u0432 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219167
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219168
    m_Localized: "\u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u0442\u043A\u0430\u043D\u044F\u043C\u0438
      \u0432 \u0425\u043E\u0442\u0430\u043D\u0435 \u043E\u0446\u0435\u043D\u0438\u043B
      \u0443\u0437\u043E\u0440: \u0445\u0430\u043D\u044C\u0441\u043A\u043E\u0435
      \u0438\u043C\u043F\u0435\u0440\u0441\u043A\u043E\u0435 \u0430\u0442\u0435\u043B\u044C\u0435,
      \u043D\u0435 \u043F\u043E\u0437\u0434\u043D\u0435\u0435 \u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F
      \u0421\u044E\u0430\u043D\u044C\u0446\u0437\u0443\u043D\u0430. \u0417\u0430\u043F\u043B\u0430\u0442\u0438\u043B
      \u0447\u0435\u0441\u0442\u043D\u043E. \u041A\u0443\u0441\u043E\u043A \u0448\u0451\u043B\u043A\u0430
      \u0441\u0442\u043E\u0438\u043B \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C
      \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219169
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u0430\u0442\u044C \u043A\u0443\u043F\u0446\u0430\u043C
      - \u043D\u0430\u0439\u0442\u0438 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219170
    m_Localized: "\u041D\u0430 \u0440\u044B\u043D\u043A\u0435 \u043A\u0443\u0441\u043E\u043A
      \u043E\u043F\u043E\u0437\u043D\u0430\u043B \u0445\u0430\u043D\u044C\u0441\u043A\u0438\u0439
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446 \u041B\u0438: \u044D\u0442\u043E
      \u0438\u0437 \u0435\u0433\u043E \u0442\u044E\u043A\u0430, \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u043E\u0433\u043E
      \u0442\u0440\u0438 \u0434\u043D\u044F \u043D\u0430\u0437\u0430\u0434. \u0412\u0435\u0440\u043D\u0443\u043B
      \u0441 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C\u044E
      \u0438 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043D\u0430\u0433\u0440\u0430\u0434\u043E\u0439.
      \u0420\u0435\u043F\u0443\u0442\u0430\u0446\u0438\u044F \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u0432\u044B\u0440\u043E\u0441\u043B\u0430 - \u0442\u0430\u043A \u0433\u043E\u0432\u043E\u0440\u044F\u0442
      \u043D\u0430 \u0440\u044B\u043D\u043A\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219171
    m_Localized: "\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
      \u043A\u0430\u043A \u043E\u0431\u0440\u0430\u0437\u0435\u0446 \u0434\u043B\u044F
      \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219172
    m_Localized: "\u041D\u0430 \u043F\u0435\u0440\u0435\u0433\u043E\u0432\u043E\u0440\u0430\u0445
      \u0441 \u0434\u0430\u043C\u0430\u0441\u0441\u043A\u0438\u043C \u043A\u0443\u043F\u0446\u043E\u043C
      \u043A\u0443\u0441\u043E\u043A \u0448\u0451\u043B\u043A\u0430 \u043B\u0451\u0433
      \u043D\u0430 \u0441\u0442\u043E\u043B \u043A\u0430\u043A \u043D\u0430\u0433\u043B\u044F\u0434\u043D\u044B\u0439
      \u043F\u0440\u0438\u043C\u0435\u0440 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430
      \u0442\u043E\u0432\u0430\u0440\u0430. \u0421\u0434\u0435\u043B\u043A\u0430
      \u0441\u043E\u0441\u0442\u043E\u044F\u043B\u0430\u0441\u044C \u043F\u043E \u043B\u0443\u0447\u0448\u0435\u0439
      \u0446\u0435\u043D\u0435: \u0432\u0438\u0437\u0443\u0430\u043B\u044C\u043D\u044B\u0439
      \u043E\u0431\u0440\u0430\u0437\u0435\u0446 \u0443\u0431\u0435\u0434\u0438\u043B
      \u043B\u0443\u0447\u0448\u0435 \u0441\u043B\u043E\u0432. \u0424\u0440\u0430\u0433\u043C\u0435\u043D\u0442
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u0443 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044F
      \u043A\u0430\u043A \u0431\u043E\u043D\u0443\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219173
    m_Localized: "\u0421\u0432\u0435\u0436\u0438\u0439 \u043A\u043E\u0441\u0442\u0451\u0440
      \u0431\u0435\u0437 \u0445\u043E\u0437\u044F\u0435\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219174
    m_Localized: "\u0414\u044B\u043C \u0435\u0449\u0451 \u0441\u0442\u043E\u0438\u0442
      \u0441\u0442\u043E\u043B\u0431\u043E\u043C. \u0423\u0433\u043B\u0438 \u043A\u0440\u0430\u0441\u043D\u044B\u0435
      \u043F\u043E\u0434 \u0441\u0435\u0440\u044B\u043C \u043F\u0435\u043F\u043B\u043E\u043C.
      \u041D\u0430 \u0437\u0435\u043C\u043B\u0435 - \u0441\u043B\u0435\u0434\u044B
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445 \u043B\u044E\u0434\u0435\u0439
      \u0438 \u043E\u0434\u043D\u043E\u0433\u043E \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u0430,
      \u0443\u0448\u0435\u0434\u0448\u0438\u0445 \u0432 \u0440\u0430\u0437\u043D\u044B\u0435
      \u0441\u0442\u043E\u0440\u043E\u043D\u044B. \u0411\u0440\u043E\u0448\u0435\u043D\u043D\u0430\u044F
      \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u0430\u044F \u043C\u0438\u0441\u043A\u0430
      \u0441 \u043E\u0441\u0442\u0430\u0442\u043A\u0430\u043C\u0438 \u043F\u0448\u0451\u043D\u043D\u043E\u0439
      \u043A\u0430\u0448\u0438 \u0435\u0449\u0451 \u0442\u0451\u043F\u043B\u0430\u044F.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0435\u043B - \u043A\u043E\u0433\u043E-\u0442\u043E
      \u0438\u043B\u0438 \u0447\u0442\u043E-\u0442\u043E \u0441\u043F\u0443\u0433\u043D\u0443\u043B\u043E.
      \u0411\u0443\u0433\u0430 \u0449\u0443\u0440\u0438\u0442\u0441\u044F \u0438
      \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E: \u0442\u0438\u0445\u043E,
      \u043D\u043E \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0442\u0438\u0445\u043E
      - \u0434\u0430\u0436\u0435 \u043F\u0442\u0438\u0446 \u043D\u0435 \u0441\u043B\u044B\u0448\u043D\u043E.
      \u041A\u0442\u043E \u0443\u0448\u0451\u043B, \u043A\u0443\u0434\u0430 \u0438
      \u043F\u043E\u0447\u0435\u043C\u0443 - \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219175
    m_Localized: "\u0421\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C \u0437\u0430
      \u0443\u0448\u0435\u0434\u0448\u0438\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219176
    m_Localized: "\u0421\u043B\u0435\u0434\u044B \u043F\u0440\u0438\u0432\u0435\u043B\u0438
      \u043A \u0441\u043A\u0430\u043B\u044C\u043D\u043E\u043C\u0443 \u043A\u0430\u0440\u043D\u0438\u0437\u0443:
      \u0442\u0430\u043C \u0441\u0438\u0434\u0435\u043B \u0438\u0441\u043F\u0443\u0433\u0430\u043D\u043D\u044B\u0439
      \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u0441\u043E\u0433\u0434\u0438\u0439\u0441\u043A\u0438\u0439
      \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446, \u0431\u0435\u0436\u0430\u0432\u0448\u0438\u0439
      \u043E\u0442 \u0440\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u043E\u0432.
      \u0420\u0430\u0437\u0431\u043E\u0439\u043D\u0438\u043A\u0438 \u0443\u0448\u043B\u0438
      \u0447\u0430\u0441 \u043D\u0430\u0437\u0430\u0434. \u0422\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u043E\u0442\u0434\u0430\u043B \u0432 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C
      \u0442\u043E \u043D\u0435\u043C\u043D\u043E\u0433\u043E\u0435, \u0447\u0442\u043E
      \u0443\u043D\u0451\u0441 - \u043A\u043E\u0448\u0435\u043B\u044C \u0441 \u043C\u043E\u043D\u0435\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219177
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C
      \u0438 \u0436\u0434\u0430\u0442\u044C \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219178
    m_Localized: "\u041F\u0440\u043E\u0436\u0434\u0430\u043B\u0438 \u0434\u043E \u0432\u0435\u0447\u0435\u0440\u0430.
      \u041D\u0438\u043A\u0442\u043E \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F.
      \u041F\u0435\u043F\u0435\u043B \u043E\u0441\u0442\u044B\u043B. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043F\u043E\u043B\u0434\u043D\u044F \u0438 \u0447\u0430\u0441\u0442\u044C
      \u0435\u0434\u044B. \u041A\u0435\u043C \u0431\u044B \u043E\u043D\u0438 \u043D\u0438
      \u0431\u044B\u043B\u0438, \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0442\u044C\u0441\u044F
      \u043E\u043D\u0438 \u043D\u0435 \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0438\u0441\u044C
      - \u0438\u043B\u0438 \u043D\u0435 \u043C\u043E\u0433\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219179
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u0442\u044C
      \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219180
    m_Localized: "\u0411\u0443\u0433\u0430 \u043D\u0430\u0448\u0451\u043B \u0441\u0440\u0435\u0434\u0438
      \u0443\u0433\u043B\u0435\u0439 \u043E\u0431\u043B\u043E\u043C\u043E\u043A \u0433\u0443\u0430\u043D\u044C\u0434\u0438\u0435
      - \u043F\u043E\u0434\u043E\u0440\u043E\u0436\u043D\u043E\u0439 \u0433\u0440\u0430\u043C\u043E\u0442\u044B
      \u0441 \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u043E\u0439 \u043F\u0435\u0447\u0430\u0442\u044C\u044E.
      \u0427\u044C\u044F - \u043D\u0435 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C.
      \u041D\u0438\u0447\u0435\u0433\u043E \u043E\u043F\u0430\u0441\u043D\u043E\u0433\u043E
      \u0432 \u043E\u043A\u0440\u0443\u0433\u0435 \u043D\u0435 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438.
      \u041F\u043E\u0448\u043B\u0438 \u0434\u0430\u043B\u044C\u0448\u0435 \u0441
      \u0447\u0443\u0442\u044C \u0431\u043E\u043B\u0435\u0435 \u043D\u0430\u0441\u0442\u043E\u0440\u043E\u0436\u0435\u043D\u043D\u044B\u043C
      \u0432\u0437\u0433\u043B\u044F\u0434\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219181
    m_Localized: "\u042F\u043D\u0442\u0430\u0440\u044C \u0441 \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219182
    m_Localized: "\u041D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435 - \u043A\u0443\u0441\u043E\u043A
      \u044F\u043D\u0442\u0430\u0440\u044F \u0440\u0430\u0437\u043C\u0435\u0440\u043E\u043C
      \u0441 \u043A\u0443\u043B\u0430\u043A, \u0436\u0451\u043B\u0442\u043E-\u0440\u044B\u0436\u0435\u0433\u043E
      \u0446\u0432\u0435\u0442\u0430, \u043F\u043E\u043B\u0443\u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0439.
      \u0412\u043D\u0443\u0442\u0440\u0438 \u0447\u0451\u0442\u043A\u043E \u0432\u0438\u0434\u0435\u043D
      \u0441\u0438\u043B\u0443\u044D\u0442 \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u043E\u0433\u043E
      - \u043A\u0440\u0443\u043F\u043D\u044B\u0439, \u0441 \u0434\u043B\u0438\u043D\u043D\u044B\u043C\u0438
      \u0443\u0441\u0430\u043C\u0438, \u044F\u0432\u043D\u043E \u0440\u0435\u0434\u043A\u0438\u0439
      \u0432\u0438\u0434. \u0422\u044F\u0436\u0451\u043B\u044B\u0439 \u0434\u043B\u044F
      \u0441\u0432\u043E\u0435\u0433\u043E \u0440\u0430\u0437\u043C\u0435\u0440\u0430,
      \u0442\u0451\u043F\u043B\u044B\u0439 \u043D\u0430 \u043E\u0449\u0443\u043F\u044C
      - \u044F\u043D\u0442\u0430\u0440\u044C \u0432\u0441\u0435\u0433\u0434\u0430
      \u0442\u0451\u043F\u043B\u044B\u0439. \u041E\u0442\u043A\u0443\u0434\u0430
      \u043E\u043D \u0437\u0434\u0435\u0441\u044C - \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E:
      \u0431\u0430\u043B\u0442\u0438\u0439\u0441\u043A\u043E\u0435 \u0441\u044B\u0440\u044C\u0451
      \u0438\u043D\u043E\u0433\u0434\u0430 \u0434\u043E\u0445\u043E\u0434\u0438\u0442
      \u0434\u043E \u044D\u0442\u0438\u0445 \u043C\u0435\u0441\u0442 \u043F\u043E
      \u0441\u0435\u0432\u0435\u0440\u043D\u043E\u043C\u0443 \u043F\u0443\u0442\u0438,
      \u043D\u043E \u0442\u0430\u043A\u043E\u0439 \u043A\u0440\u0443\u043F\u043D\u044B\u0439
      \u043A\u0443\u0441\u043E\u043A \u0441 \u0442\u0430\u043A\u0438\u043C \u0432\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043C
      \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u0435\u0442\u0441\u044F \u0440\u0430\u0437
      \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043B\u0435\u0442.
      \u041F\u0440\u0438\u0440\u043E\u0434\u043D\u044B\u0439 \u0437\u043D\u0430\u043A
      \u0438\u043B\u0438 \u0441\u043B\u0443\u0447\u0430\u0439\u043D\u0430\u044F \u043F\u043E\u0442\u0435\u0440\u044F
      - \u043D\u0435 \u044F\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219183
    m_Localized: "\u041F\u0440\u043E\u0434\u0430\u0442\u044C \u0441\u0440\u0430\u0437\u0443
      \u0432 \u0433\u043E\u0440\u043E\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219184
    m_Localized: "\u042E\u0432\u0435\u043B\u0438\u0440 \u0432 \u041A\u0430\u0448\u0433\u0430\u0440\u0435
      \u0432\u0437\u044F\u043B \u043D\u0435 \u0442\u043E\u0440\u0433\u0443\u044F\u0441\u044C
      - \u044F\u043D\u0442\u0430\u0440\u044C \u0441 \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u044B\u043C
      \u0440\u0435\u0434\u043A\u043E\u0441\u0442\u044C \u0434\u0430\u0436\u0435 \u0437\u0434\u0435\u0441\u044C.
      \u0417\u0430\u043F\u043B\u0430\u0442\u0438\u043B \u0445\u043E\u0440\u043E\u0448\u043E.
      \u0411\u044B\u0441\u0442\u0440\u044B\u0435 \u0434\u0435\u043D\u044C\u0433\u0438
      \u0437\u0430 \u0443\u0434\u0430\u0447\u043D\u0443\u044E \u043D\u0430\u0445\u043E\u0434\u043A\u0443
      \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219185
    m_Localized: "\u041E\u0446\u0435\u043D\u0438\u0442\u044C \u0443 \u044E\u0432\u0435\u043B\u0438\u0440\u0430
      \u0437\u0430 \u0434\u043E\u043B\u044E \u043E\u0442 \u043F\u0440\u043E\u0434\u0430\u0436\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219186
    m_Localized: "\u042E\u0432\u0435\u043B\u0438\u0440 \u0411\u0430\u0445\u0440\u0430\u043C
      \u043E\u0446\u0435\u043D\u0438\u043B \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E:
      \u044D\u0442\u043E \u0431\u0430\u043B\u0442\u0438\u0439\u0441\u043A\u0438\u0439
      \u044F\u043D\u0442\u0430\u0440\u044C \u0441 \u043E\u043B\u0435\u043D\u044C\u0438\u043C
      \u0436\u0443\u043A\u043E\u043C, \u0441\u0442\u043E\u0438\u0442 \u0432\u0442\u0440\u043E\u0435
      \u0434\u043E\u0440\u043E\u0436\u0435, \u0447\u0435\u043C \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C.
      \u0412\u0437\u044F\u043B \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C
      \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u043E\u0432 \u0437\u0430 \u044D\u043A\u0441\u043F\u0435\u0440\u0442\u0438\u0437\u0443
      \u0438 \u043F\u043E\u043C\u043E\u0433 \u0441 \u0432\u044B\u0433\u043E\u0434\u043D\u044B\u043C
      \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u0435\u043C. \u0418\u0442\u043E\u0433\u043E\u0432\u0430\u044F
      \u0441\u0443\u043C\u043C\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0430\u0441\u044C
      \u0432\u044B\u0448\u0435 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219187
    m_Localized: "\u0412\u0435\u0437\u0442\u0438 \u0434\u0430\u043B\u044C\u0448\u0435
      - \u043D\u0430\u0439\u0442\u0438 \u043E\u0441\u043E\u0431\u043E\u0433\u043E
      \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219188
    m_Localized: "\u0412 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u043D\u0430\u0442\u0443\u0440\u0430\u043B\u0438\u0441\u0442 \u043F\u0440\u0438
      \u0434\u0432\u043E\u0440\u0435 \u043F\u0440\u0430\u0432\u0438\u0442\u0435\u043B\u044F
      \u0437\u0430\u043F\u043B\u0430\u0442\u0438\u043B \u0437\u0430 \u044F\u043D\u0442\u0430\u0440\u044C
      \u0441 \u0440\u0435\u0434\u043A\u0438\u043C \u043D\u0430\u0441\u0435\u043A\u043E\u043C\u044B\u043C
      \u0432\u0434\u0432\u043E\u0435 \u0431\u043E\u043B\u044C\u0448\u0435 \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439
      \u0446\u0435\u043D\u044B - \u0434\u043B\u044F \u0435\u0433\u043E \u043A\u043E\u043B\u043B\u0435\u043A\u0446\u0438\u0438.
      \u0422\u0435\u0440\u043F\u0435\u043D\u0438\u0435 \u0438 \u0437\u043D\u0430\u043D\u0438\u0435
      \u0440\u044B\u043D\u043A\u0430 \u043E\u043A\u0443\u043F\u0438\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219189
    m_Localized: "\u0421\u0432\u0438\u0442\u043E\u043A \u0432 \u043A\u043E\u0436\u0430\u043D\u043E\u043C
      \u0447\u0435\u0445\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219190
    m_Localized: "\u041D\u0430 \u043E\u0431\u043E\u0447\u0438\u043D\u0435 \u0442\u0440\u043E\u043F\u044B
      - \u0434\u043E\u0440\u043E\u0433\u043E\u0439 \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u0446\u0438\u043B\u0438\u043D\u0434\u0440, \u0437\u0430\u043A\u0440\u044B\u0442\u044B\u0439
      \u043C\u0435\u0434\u043D\u043E\u0439 \u043F\u0440\u043E\u0431\u043A\u043E\u0439
      \u0441 \u0442\u0438\u0441\u043D\u0451\u043D\u043E\u0439 \u0432\u044F\u0437\u044C\u044E.
      \u041A\u043E\u0436\u0430 \u043C\u044F\u0433\u043A\u0430\u044F, \u043D\u0443\u0442\u0440\u044F\u043D\u0430\u044F,
      \u0441 \u0437\u0430\u043F\u0430\u0445\u043E\u043C \u043C\u0443\u0441\u043A\u0443\u0441\u0430
      - \u044F\u0432\u043D\u043E \u043D\u0435 \u0434\u0435\u0448\u0451\u0432\u044B\u0439
      \u0442\u043E\u0432\u0430\u0440. \u0412\u043D\u0443\u0442\u0440\u0438 \u0441\u0432\u0451\u0440\u043D\u0443\u0442\u044B\u0439
      \u0441\u0432\u0438\u0442\u043E\u043A \u0441 \u0430\u0440\u0430\u0431\u0441\u043A\u043E\u0439
      \u0432\u044F\u0437\u044C\u044E - \u0447\u0451\u0440\u043D\u044B\u0435 \u0447\u0435\u0440\u043D\u0438\u043B\u0430
      \u043D\u0430 \u0442\u043E\u043D\u043A\u043E\u043C \u043F\u0435\u0440\u0433\u0430\u043C\u0435\u043D\u0442\u0435,
      \u043F\u0435\u0447\u0430\u0442\u044C \u0441 \u0438\u043C\u0435\u043D\u0435\u043C.
      \u041F\u0438\u0441\u044C\u043C\u043E \u0430\u0434\u0440\u0435\u0441\u043E\u0432\u0430\u043D\u043E,
      \u0441\u0443\u0434\u044F \u043F\u043E \u043D\u0430\u0434\u043F\u0438\u0441\u0438
      \u0441\u043D\u0430\u0440\u0443\u0436\u0438, \u043A\u0443\u043F\u0446\u0443
      \u0432 \u0411\u0430\u0433\u0434\u0430\u0434\u0435. \u0410\u0445\u043C\u0430\u0434
      \u0447\u0438\u0442\u0430\u0435\u0442 \u043F\u043E-\u0430\u0440\u0430\u0431\u0441\u043A\u0438
      \u0438 \u0445\u043C\u0443\u0440\u0438\u0442\u0441\u044F: \u0442\u0435\u043A\u0441\u0442
      \u0434\u0435\u043B\u043E\u0432\u043E\u0439, \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0442\u0441\u044F
      \u0446\u0438\u0444\u0440\u044B \u0438 \u043C\u0430\u0440\u0448\u0440\u0443\u0442.
      \u0427\u044C\u0451 \u043F\u0438\u0441\u044C\u043C\u043E, \u043A\u043E\u0433\u0434\u0430
      \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043E - \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219191
    m_Localized: "\u0414\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0430\u0434\u0440\u0435\u0441\u0430\u0442\u0443
      \u0432 \u0411\u0430\u0433\u0434\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219192
    m_Localized: "\u041F\u0438\u0441\u044C\u043C\u043E \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      \u0441 \u043E\u043A\u0430\u0437\u0438\u0435\u0439 \u0447\u0435\u0440\u0435\u0437
      \u0442\u0440\u0438 \u043C\u0435\u0441\u044F\u0446\u0430. \u041A\u0443\u043F\u0435\u0446
      \u042E\u0441\u0443\u0444 \u0438\u0437 \u0411\u0430\u0433\u0434\u0430\u0434\u0430
      \u043F\u0440\u0438\u0441\u043B\u0430\u043B \u043E\u0442\u0432\u0435\u0442\u043D\u043E\u0435
      \u043F\u0438\u0441\u044C\u043C\u043E \u0441 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C\u044E
      \u0438 \u0432\u043E\u0437\u043D\u0430\u0433\u0440\u0430\u0436\u0434\u0435\u043D\u0438\u0435\u043C
      \u0447\u0435\u0440\u0435\u0437 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043F\u043E\u0441\u0442 \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435.
      \u0427\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u044C \u043D\u0430 \u0428\u0451\u043B\u043A\u043E\u0432\u043E\u043C
      \u043F\u0443\u0442\u0438 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0441 \u043F\u0440\u043E\u0446\u0435\u043D\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219193
    m_Localized: "\u0412\u0441\u043A\u0440\u044B\u0442\u044C \u0438 \u043F\u0440\u043E\u0447\u0438\u0442\u0430\u0442\u044C
      \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219194
    m_Localized: "\u0410\u0445\u043C\u0430\u0434 \u043F\u0440\u043E\u0447\u0451\u043B:
      \u043F\u0438\u0441\u044C\u043C\u043E \u043E\u043F\u0438\u0441\u044B\u0432\u0430\u043B\u043E
      \u0442\u0430\u0439\u043D\u044B\u0439 \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439
      \u043C\u0430\u0440\u0448\u0440\u0443\u0442 \u0441 \u0446\u0435\u043D\u0430\u043C\u0438
      \u043D\u0430 \u0441\u043F\u0435\u0446\u0438\u0438. \u041F\u043E\u043B\u0435\u0437\u043D\u0430\u044F
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F, \u043D\u043E
      \u0441\u043B\u043E\u043C\u0430\u043D\u043D\u0430\u044F \u043F\u0435\u0447\u0430\u0442\u044C
      - \u0441\u043B\u0435\u0434. \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435 \u043E\u0434\u0438\u043D \u043A\u0443\u043F\u0435\u0446
      \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043D\u0430 \u043E\u0431\u043E\u0437
      \u0441 \u044F\u0432\u043D\u044B\u043C \u043F\u043E\u0434\u043E\u0437\u0440\u0435\u043D\u0438\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219195
    m_Localized: "\u0421\u0434\u0430\u0442\u044C \u0433\u043E\u0440\u043E\u0434\u0441\u043A\u043E\u043C\u0443
      \u043A\u0430\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219196
    m_Localized: "\u041A\u0430\u0434\u0438 \u043F\u0440\u0438\u043D\u044F\u043B \u043F\u0438\u0441\u044C\u043C\u043E
      \u0441 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u043D\u043E\u0441\u0442\u044C\u044E
      \u0438 \u0432\u043D\u0451\u0441 \u043E\u0431\u043E\u0437 \u0432 \u043A\u043D\u0438\u0433\u0443
      \u0434\u043E\u0431\u0440\u043E\u0441\u043E\u0432\u0435\u0441\u0442\u043D\u044B\u0445
      \u043A\u0443\u043F\u0446\u043E\u0432. \u0422\u0430\u043A\u0430\u044F \u0437\u0430\u043F\u0438\u0441\u044C
      \u0443\u0441\u043A\u043E\u0440\u044F\u0435\u0442 \u043F\u0440\u043E\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
      \u0437\u0430\u0441\u0442\u0430\u0432. \u041D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439
      \u043F\u043E\u0441\u0442\u0443\u043F\u043E\u043A, \u0434\u043E\u043B\u0433\u0430\u044F
      \u043F\u043E\u043B\u044C\u0437\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219197
    m_Localized: "\u0421\u0442\u0435\u043D\u0430 \u043F\u0435\u0441\u043A\u0430 -
      \u0445\u0430\u0431\u0443\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219198
    m_Localized: "\u0413\u043E\u0440\u0438\u0437\u043E\u043D\u0442 \u043D\u0430 \u044E\u0433\u0435
      \u0441\u0442\u0430\u043B \u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u044B\u043C,
      \u043F\u043E\u0442\u043E\u043C \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u044B\u043C
      - \u0441\u0442\u0435\u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u043E\u0439
      \u0432 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043E\u0442\u0435\u043D
      \u043B\u043E\u043A\u0442\u0435\u0439 \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F
      \u0441\u043E \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C\u044E \u0441\u043A\u0430\u0447\u0443\u0449\u0435\u0439
      \u043B\u043E\u0448\u0430\u0434\u0438. \u0412\u043E\u0437\u0434\u0443\u0445
      \u0441\u0440\u0430\u0437\u0443 \u0441\u0442\u0430\u043B \u0433\u043E\u0440\u044C\u043A\u0438\u043C
      \u0438 \u0441\u0443\u0445\u0438\u043C, \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u0437\u0430\u0436\u0430\u043B\u0438 \u043D\u043E\u0437\u0434\u0440\u0438 \u0438
      \u043F\u043E\u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u0445\u0432\u043E\u0441\u0442\u0430\u043C\u0438
      \u043A \u0432\u0435\u0442\u0440\u0443. \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0411\u0443\u0433\u0430 \u043A\u0440\u0438\u0447\u0438\u0442 - \u0435\u0433\u043E
      \u0443\u0436\u0435 \u043F\u043E\u0447\u0442\u0438 \u043D\u0435 \u0441\u043B\u044B\u0448\u043D\u043E:
      \u0447\u0435\u0440\u0435\u0437 \u043F\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442
      \u0437\u0434\u0435\u0441\u044C \u0431\u0443\u0434\u0435\u0442 \u0442\u0435\u043C\u043D\u043E
      \u043A\u0430\u043A \u043D\u043E\u0447\u044C\u044E, \u0438 \u0432\u0435\u0442\u0435\u0440
      \u0441\u043E\u0431\u044C\u0451\u0442 \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u0441 \u043D\u043E\u0433. \u0423 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      - \u043C\u0438\u043D\u0443\u0442\u044B, \u0447\u0442\u043E\u0431\u044B \u0440\u0435\u0448\u0438\u0442\u044C
      \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219199
    m_Localized: "\u0423\u043A\u0440\u044B\u0442\u044C\u0441\u044F \u0437\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u043C\u0438
      \u0438 \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219200
    m_Localized: "\u0414\u0432\u0435\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u043F\u0440\u0438\u0436\u0430\u043B\u0438\u0441\u044C \u043A \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u043C,
      \u043B\u0438\u0446\u0430 \u0432 \u043A\u043E\u0448\u043C\u0430\u0445. \u0422\u0440\u0438
      \u0447\u0430\u0441\u0430 \u0433\u0440\u043E\u0445\u043E\u0442\u0430, \u043F\u0435\u0441\u043A\u0430
      \u0438 \u0442\u044C\u043C\u044B. \u041F\u043E\u0442\u043E\u043C \u0442\u0438\u0448\u0438\u043D\u0430.
      \u0412\u0441\u0451 \u043F\u043E\u043A\u0440\u044B\u0442\u043E \u0441\u043B\u043E\u0435\u043C
      \u043F\u044B\u043B\u0438 \u0432 \u043F\u0430\u043B\u0435\u0446 \u0442\u043E\u043B\u0449\u0438\u043D\u043E\u0439,
      \u043E\u0434\u043D\u043E \u043A\u043E\u043B\u0435\u0441\u043E \u0441\u043B\u043E\u043C\u0430\u043D\u043E
      \u043E\u0442 \u0443\u0434\u0430\u0440\u0430 \u0432\u044C\u044E\u043A\u0430,
      \u043D\u043E \u043E\u0431\u043E\u0437 \u0446\u0435\u043B \u0438 \u0432\u0441\u0435
      \u0436\u0438\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219201
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u043E \u0443\u0439\u0442\u0438 \u0432
      \u043D\u0438\u0437\u0438\u043D\u0443 - \u043E\u0431\u044A\u0435\u0445\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219202
    m_Localized: "\u041E\u0431\u043E\u0437 \u0443\u0441\u043F\u0435\u043B \u0434\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F
      \u0434\u043E \u0432\u0430\u0434\u0438 - \u0441\u0443\u0445\u043E\u0433\u043E
      \u0440\u0443\u0441\u043B\u0430 \u0441 \u0432\u044B\u0441\u043E\u043A\u0438\u043C\u0438
      \u0431\u0435\u0440\u0435\u0433\u0430\u043C\u0438. \u0411\u0443\u0440\u044F
      \u043F\u0440\u043E\u0448\u043B\u0430 \u043F\u043E\u0432\u0435\u0440\u0445\u0443,
      \u043E\u0441\u044B\u043F\u0430\u0432 \u043F\u0435\u0441\u043A\u043E\u043C,
      \u043D\u043E \u043D\u0435 \u043D\u0430\u043A\u0440\u044B\u0432. \u0423\u043C\u043D\u044B\u0439
      \u043C\u0430\u043D\u0451\u0432\u0440 \u043E\u0442\u0446\u0430 \u0411\u0443\u0433\u0438
      - \u043E\u043D \u0443\u0447\u0438\u043B: \u0445\u0430\u0431\u0443\u0431 \u0438\u0434\u0451\u0442
      \u043F\u043E \u0440\u0430\u0432\u043D\u0438\u043D\u0435, \u0431\u0435\u0440\u0435\u0433\u0430
      \u0435\u0433\u043E \u0440\u0430\u0441\u0441\u0435\u043A\u0430\u044E\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219203
    m_Localized: "\u041D\u0430\u043A\u0440\u044B\u0442\u044C \u043B\u044E\u0434\u0435\u0439
      \u0438 \u0433\u0440\u0443\u0437 \u043A\u043E\u0448\u043C\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219204
    m_Localized: "\u0420\u0430\u0437\u043B\u043E\u0436\u0438\u043B\u0438 \u0432\u043E\u0439\u043B\u043E\u043A
      \u043F\u043E\u0432\u0435\u0440\u0445 \u0432\u0441\u0435\u0433\u043E - \u043B\u044E\u0434\u0435\u0439,
      \u0442\u043E\u0432\u0430\u0440\u0430, \u0432\u0435\u0440\u0431\u043B\u044E\u0436\u044C\u0438\u0445
      \u0433\u043E\u043B\u043E\u0432. \u0411\u0443\u0440\u044F \u0442\u0440\u044F\u0441\u043B\u0430
      \u0438 \u0445\u043B\u0435\u0441\u0442\u0430\u043B\u0430, \u043D\u043E \u043D\u0438
      \u043E\u0434\u0438\u043D \u0442\u044E\u043A \u043D\u0435 \u043F\u043E\u0442\u0435\u0440\u044F\u043D.
      \u0421\u0430\u043C\u0438 \u0432\u044B\u0431\u0440\u0430\u043B\u0438\u0441\u044C
      \u0438\u0437-\u043F\u043E\u0434 \u043F\u0435\u0441\u043A\u0430 \u0447\u0435\u0440\u0435\u0437
      \u0442\u0440\u0438 \u0447\u0430\u0441\u0430, \u043E\u0442\u043F\u043B\u0451\u0432\u044B\u0432\u0430\u044F\u0441\u044C
      \u0438 \u043A\u0430\u0448\u043B\u044F\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219205
    m_Localized: "\u041F\u043E\u0442\u043E\u043A \u0432 \u0441\u0443\u0445\u043E\u043C
      \u0440\u0443\u0441\u043B\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219206
    m_Localized: "\u0413\u0440\u043E\u043C \u0432 \u0433\u043E\u0440\u0430\u0445
      \u0431\u044B\u043B \u0447\u0430\u0441 \u043D\u0430\u0437\u0430\u0434. \u0422\u0435\u043F\u0435\u0440\u044C
      \u0438\u0437 \u0432\u0430\u0434\u0438 \u0434\u043E\u043D\u043E\u0441\u0438\u0442\u0441\u044F
      \u043D\u0430\u0440\u0430\u0441\u0442\u0430\u044E\u0449\u0438\u0439 \u0433\u0443\u043B
      - \u043D\u0435 \u0432\u0435\u0442\u0435\u0440, \u0433\u043B\u0443\u0431\u0436\u0435.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A \u0410\u0445\u043C\u0430\u0434
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432\u0432\u0435\u0440\u0445 \u043F\u043E
      \u0443\u0449\u0435\u043B\u044C\u044E: \u0442\u0430\u043C \u0442\u0435\u043C\u043D\u043E-\u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u0430\u044F
      \u0441\u0442\u0435\u043D\u0430 \u0432\u043E\u0434\u044B \u0438 \u0433\u043B\u0438\u043D\u044B
      \u0434\u0432\u0438\u0436\u0435\u0442\u0441\u044F \u0432\u043D\u0438\u0437,
      \u043B\u043E\u043C\u0430\u044F \u0437\u0430\u0440\u043E\u0441\u043B\u0438 \u0442\u0430\u043C\u0430\u0440\u0438\u0441\u043A\u0430.
      \u041E\u0431\u043E\u0437 \u0441\u0442\u043E\u0438\u0442 \u0432 \u0440\u0443\u0441\u043B\u0435.
      \u041F\u044F\u0442\u044C \u043C\u0438\u043D\u0443\u0442 - \u043C\u0435\u043D\u044C\u0448\u0435.
      \u0411\u0435\u0440\u0435\u0433\u0430 \u043A\u0440\u0443\u0442\u044B\u0435,
      \u043D\u043E \u0435\u0441\u0442\u044C \u0432\u044B\u0445\u043E\u0434 \u043A
      \u0441\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u043F\u043E\u043B\u043A\u0435
      \u0441\u043B\u0435\u0432\u0430 \u0438 \u043E\u0442\u043B\u043E\u0433\u0438\u0439
      \u043F\u043E\u0434\u044A\u0451\u043C \u0441\u043F\u0440\u0430\u0432\u0430.
      \u0413\u0440\u0443\u0437 \u043D\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0430\u0445
      \u043D\u0435 \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u0451\u043D - \u0442\u043E\u043B\u044C\u043A\u043E
      \u0447\u0442\u043E \u0441\u0442\u043E\u044F\u043B\u0438 \u043D\u0430 \u043D\u043E\u0447\u0451\u0432\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219207
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      - \u0431\u0435\u0436\u0430\u0442\u044C \u043D\u0430 \u0432\u043E\u0437\u0432\u044B\u0448\u0435\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219208
    m_Localized: "\u0412\u0441\u0435 \u0432\u044B\u0431\u0440\u0430\u043B\u0438\u0441\u044C
      \u043D\u0430 \u0441\u043A\u0430\u043B\u044C\u043D\u0443\u044E \u043F\u043E\u043B\u043A\u0443
      \u0437\u0430 \u0447\u0435\u0442\u044B\u0440\u0435 \u043C\u0438\u043D\u0443\u0442\u044B.
      \u041F\u043E\u0442\u043E\u043A \u043F\u0440\u043E\u0448\u0451\u043B \u0432\u043D\u0438\u0437\u0443
      \u0441 \u0433\u0440\u043E\u0445\u043E\u0442\u043E\u043C - \u0443\u043D\u0451\u0441
      \u043E\u0434\u043D\u0443 \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u0443\u044E
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443 \u0438 \u0447\u0430\u0441\u0442\u044C
      \u0442\u044E\u043A\u043E\u0432. \u041B\u044E\u0434\u0438 \u0436\u0438\u0432\u044B.
      \u0413\u0440\u0443\u0437 \u043F\u043E\u0442\u0435\u0440\u044F\u043D \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E,
      \u043D\u043E \u0436\u0438\u0437\u043D\u044C \u0434\u043E\u0440\u043E\u0436\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219209
    m_Localized: "\u0421\u043F\u0430\u0441\u0430\u0442\u044C \u0433\u0440\u0443\u0437
      - \u0437\u0430\u043A\u0440\u0435\u043F\u0438\u0442\u044C \u0442\u044E\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219210
    m_Localized: "\u0414\u0432\u043E\u0435 \u0437\u0430\u043A\u0440\u0435\u043F\u0438\u043B\u0438
      \u0442\u044E\u043A\u0438, \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u0432\u044B\u0432\u043E\u0434\u0438\u043B\u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432.
      \u0412\u043E\u0434\u0430 \u043F\u0440\u0438\u0448\u043B\u0430 \u0440\u0430\u043D\u044C\u0448\u0435,
      \u0447\u0435\u043C \u0443\u0441\u043F\u0435\u043B\u0438. \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u041A\u044E\u043B\u044C-\u0431\u0430\u0442\u0443\u0440 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0443\u0434\u0430\u0440 \u0431\u0440\u0435\u0432\u043D\u043E\u043C \u043F\u043E
      \u043F\u043B\u0435\u0447\u0443. \u0427\u0430\u0441\u0442\u044C \u0433\u0440\u0443\u0437\u0430
      \u0441\u043F\u0430\u0441\u043B\u0438, \u043D\u043E \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0430
      \u043B\u0435\u0447\u0438\u043B\u0438 \u0442\u0440\u0438 \u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219211
    m_Localized: "\u0412\u044B\u0442\u044F\u0433\u0438\u0432\u0430\u0442\u044C \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u043C\u0438 \u043D\u0430 \u0431\u0435\u0440\u0435\u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219212
    m_Localized: "\u0412\u043E\u0441\u0435\u043C\u044C \u0447\u0435\u043B\u043E\u0432\u0435\u043A
      \u0442\u044F\u043D\u0443\u043B\u0438 \u043A\u0430\u043D\u0430\u0442\u044B,
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u0441\u043A\u0440\u0438\u043F\u0435\u043B\u0438
      \u0438 \u043F\u043E\u043B\u0437\u043B\u0438 \u0432\u0432\u0435\u0440\u0445.
      \u041F\u043E\u0434\u043D\u044F\u043B\u0438 \u0442\u0440\u0438 \u0438\u0437
      \u0447\u0435\u0442\u044B\u0440\u0451\u0445 \u0434\u043E \u0442\u043E\u0433\u043E
      \u043A\u0430\u043A \u0432\u043E\u0434\u0430 \u0434\u043E\u0441\u0442\u0438\u0433\u043B\u0430
      \u043A\u043E\u043B\u0451\u0441. \u0427\u0435\u0442\u0432\u0451\u0440\u0442\u0430\u044F
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C \u0432\u043D\u0438\u0437\u0443
      \u0438 \u043E\u043F\u0440\u043E\u043A\u0438\u043D\u0443\u043B\u0430\u0441\u044C.
      \u0411\u043E\u043B\u044C\u0448\u0438\u043D\u0441\u0442\u0432\u043E \u0433\u0440\u0443\u0437\u0430
      \u0432 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219213
    m_Localized: "\u041B\u0430\u0432\u0438\u043D\u0430 \u0437\u0430\u043A\u0440\u044B\u043B\u0430
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219214
    m_Localized: "\u0413\u0440\u043E\u0445\u043E\u0442 \u0441 \u0441\u0435\u0432\u0435\u0440\u0430
      - \u0438 \u0441\u043A\u043B\u043E\u043D \u043F\u0440\u0438\u0448\u0451\u043B
      \u0432 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u0435. \u0421\u043D\u0435\u0436\u043D\u044B\u0439
      \u0432\u0430\u043B \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u0438
      \u043B\u043E\u043A\u0442\u0435\u0439 \u0432\u044B\u0441\u043E\u0442\u043E\u0439
      \u0437\u0430\u0432\u0430\u043B\u0438\u043B \u0442\u0440\u043E\u043F\u0443 \u0432
      \u0441\u0442\u0430 \u0448\u0430\u0433\u0430\u0445 \u0432\u043F\u0435\u0440\u0435\u0434\u0438,
      \u0438 \u0435\u0449\u0451 \u043E\u0441\u044B\u043F\u0430\u043B\u043E\u0441\u044C,
      \u043F\u043E\u043A\u0430 \u043E\u0431\u043E\u0437 \u0441\u0442\u043E\u044F\u043B.
      \u041F\u0435\u0440\u0435\u0432\u0430\u043B \u0437\u0430\u043A\u0440\u044B\u0442
      - \u043D\u0430\u0441\u043A\u043E\u043B\u044C\u043A\u043E, \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E.
      \u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u041D\u0430\u043D\u0430\u043C
      \u0449\u0443\u043F\u0430\u0435\u0442 \u0441\u043D\u0435\u0433: \u043F\u043B\u043E\u0442\u043D\u044B\u0439,
      \u0441\u043B\u0435\u0436\u0430\u0432\u0448\u0438\u0439\u0441\u044F. \u0422\u0440\u0438
      \u0432\u0430\u0440\u0438\u0430\u043D\u0442\u0430: \u0436\u0434\u0430\u0442\u044C
      \u043F\u043E\u043A\u0430 \u0441\u043E\u0439\u0434\u0451\u0442 \u0441\u0430\u043C,
      \u0438\u0441\u043A\u0430\u0442\u044C \u043E\u0431\u0445\u043E\u0434 \u043F\u043E
      \u0441\u043E\u0441\u0435\u0434\u043D\u0435\u043C\u0443 \u0433\u0440\u0435\u0431\u043D\u044E
      - \u044D\u0442\u043E \u0434\u0432\u0430 \u043B\u0438\u0448\u043D\u0438\u0445
      \u0434\u043D\u044F, \u0438\u043B\u0438 \u043F\u0440\u043E\u043A\u0430\u043F\u044B\u0432\u0430\u0442\u044C
      \u043F\u0443\u0442\u044C \u0432\u0440\u0443\u0447\u043D\u0443\u044E. \u0417\u0430\u043F\u0430\u0441\u044B
      \u0435\u0434\u044B \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D\u044B
      \u043D\u0430 \u043F\u044F\u0442\u044C \u0434\u043D\u0435\u0439 \u0432\u043F\u0435\u0440\u0451\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219215
    m_Localized: "\u0418\u0434\u0442\u0438 \u0432 \u043E\u0431\u0445\u043E\u0434
      \u0447\u0435\u0440\u0435\u0437 \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0439
      \u0433\u0440\u0435\u0431\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219216
    m_Localized: "\u041E\u0431\u0445\u043E\u0434 \u0437\u0430\u043D\u044F\u043B \u0434\u0432\u0430
      \u0434\u043D\u044F. \u0422\u0440\u043E\u043F\u0430 \u043F\u043E \u0433\u0440\u0435\u0431\u043D\u044E
      \u0443\u0437\u043A\u0430\u044F, \u0432\u0435\u0442\u0440\u0435\u043D\u0430\u044F,
      \u043E\u0434\u0438\u043D \u044F\u043A \u0435\u0434\u0432\u0430 \u043D\u0435
      \u0441\u043E\u0440\u0432\u0430\u043B\u0441\u044F. \u041D\u043E \u043F\u0440\u043E\u0448\u043B\u0438.
      \u0417\u0430\u043F\u0430\u0441\u044B \u0441\u044A\u0435\u043B\u0438 \u0441\u0432\u0435\u0440\u0445
      \u043D\u043E\u0440\u043C\u044B, \u043D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0443\u043F\u0430\u043B\u043E - \u0438 \u0432\u0441\u0451 \u0436\u0435 \u043F\u0435\u0440\u0435\u0432\u0430\u043B
      \u043E\u0441\u0442\u0430\u043B\u0441\u044F \u043F\u043E\u0437\u0430\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219217
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C
      \u0438 \u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219218
    m_Localized: "\u0416\u0434\u0430\u043B\u0438 \u0442\u0440\u0438 \u0434\u043D\u044F.
      \u0421\u043D\u0435\u0433 \u043E\u0441\u0435\u043B, \u0438 \u043F\u043E \u043A\u0440\u0430\u044E
      \u0437\u0430\u0432\u0430\u043B\u0430 \u043F\u0440\u043E\u0448\u043B\u0438 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u043C\u043D\u043E\u0433\u043E
      \u0435\u0434\u044B \u0438 \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u043D\u043E
      \u0431\u0435\u0437 \u0440\u0438\u0441\u043A\u0430. \u041D\u0430\u043D\u0430\u043C
      \u0441\u043A\u0430\u0437\u0430\u043B: \u0432 \u0422\u0438\u0431\u0435\u0442\u0435
      \u0442\u0430\u043A \u0432\u0441\u0435\u0433\u0434\u0430 - \u0433\u043E\u0440\u0430
      \u0432\u043E\u0437\u044C\u043C\u0451\u0442 \u0441\u0432\u043E\u0451, \u0430
      \u043F\u043E\u0442\u043E\u043C \u0443\u0431\u0435\u0440\u0451\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219219
    m_Localized: "\u041F\u0440\u043E\u043A\u0430\u043F\u044B\u0432\u0430\u0442\u044C
      \u043F\u0443\u0442\u044C \u0432\u0440\u0443\u0447\u043D\u0443\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219220
    m_Localized: "\u0428\u0435\u0441\u0442\u044C \u0447\u0430\u0441\u043E\u0432 \u043A\u043E\u043F\u0430\u043B\u0438
      \u043B\u043E\u043F\u0430\u0442\u0430\u043C\u0438 \u0438 \u0440\u0443\u043A\u0430\u043C\u0438.
      \u041F\u0440\u043E\u0431\u0438\u043B\u0438 \u0442\u043E\u043D\u043D\u0435\u043B\u044C
      \u0448\u0438\u0440\u0438\u043D\u043E\u0439 \u0432 \u043E\u0434\u043D\u0443
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443. \u041E\u0431\u043E\u0437 \u043F\u0440\u043E\u0448\u0451\u043B
      - \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E, \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043D\u0435\u0440\u0432\u043D\u0438\u0447\u0430\u043B\u0438 \u0432 \u0441\u043D\u0435\u0436\u043D\u043E\u043C
      \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u0435. \u041E\u0434\u0438\u043D
      \u0442\u044E\u043A \u043F\u0440\u0438\u043C\u0451\u0440\u0437 \u043A \u0441\u0442\u0435\u043D\u043A\u0435
      \u0438 \u0435\u0433\u043E \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0431\u0440\u043E\u0441\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219221
    m_Localized: "\u0422\u0443\u0447\u0430 \u0441\u0430\u0440\u0430\u043D\u0447\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219222
    m_Localized: "\u0428\u043E\u0440\u043E\u0445 \u043D\u0430\u0447\u0430\u043B\u0441\u044F
      \u0441 \u0437\u0430\u043F\u0430\u0434\u0430 - \u043A\u0430\u043A \u0434\u0430\u043B\u0451\u043A\u0438\u0439
      \u0434\u043E\u0436\u0434\u044C, \u0442\u043E\u043B\u044C\u043A\u043E \u0441\u0443\u0445\u043E\u0439.
      \u041E\u0431\u043B\u0430\u043A\u043E \u0437\u0435\u043B\u0451\u043D\u043E-\u043A\u043E\u0440\u0438\u0447\u043D\u0435\u0432\u043E\u0435
      \u043F\u043E\u0434\u043D\u044F\u043B\u043E\u0441\u044C \u043D\u0430\u0434 \u0445\u043E\u043B\u043C\u043E\u043C
      \u0438 \u0434\u0432\u0438\u043D\u0443\u043B\u043E\u0441\u044C \u043D\u0430
      \u043E\u0431\u043E\u0437. \u0427\u0435\u0440\u0435\u0437 \u043C\u0438\u043D\u0443\u0442\u0443
      \u0432\u043E\u0437\u0434\u0443\u0445 \u043D\u0430\u043F\u043E\u043B\u043D\u0438\u043B\u0441\u044F
      \u0445\u0440\u0443\u0441\u0442\u043E\u043C \u0438 \u0437\u0430\u043F\u0430\u0445\u043E\u043C
      \u0441\u0443\u0445\u043E\u0439 \u0442\u0440\u0430\u0432\u044B: \u0441\u0430\u0440\u0430\u043D\u0447\u0430
      \u0441\u0430\u0434\u0438\u043B\u0430\u0441\u044C \u043D\u0430 \u043C\u0435\u0448\u043A\u0438
      \u0441 \u0437\u0435\u0440\u043D\u043E\u043C, \u043D\u0430 \u043A\u043E\u0448\u043C\u044B,
      \u043D\u0430 \u043E\u0434\u0435\u0436\u0434\u0443 \u043B\u044E\u0434\u0435\u0439.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u043C\u043E\u0442\u0430\u043B\u0438
      \u0433\u043E\u043B\u043E\u0432\u0430\u043C\u0438. \u0417\u0435\u0440\u043D\u043E\u0432\u044B\u0435
      \u043C\u0435\u0448\u043A\u0438 \u043F\u043E\u0434 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C
      \u043D\u0435\u0431\u043E\u043C \u0437\u0430 \u0447\u0430\u0441 \u0442\u0435\u0440\u044F\u044E\u0442
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0443 \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0433\u043E
      - \u0441\u0430\u0440\u0430\u043D\u0447\u0430 \u0435\u0441\u0442 \u0432\u0441\u0451
      \u0438 \u0431\u044B\u0441\u0442\u0440\u043E. \u041F\u0430\u0441\u0442\u0431\u0438\u0449\u043D\u043E\u0433\u043E
      \u043A\u043E\u0440\u043C\u0430 \u0434\u043B\u044F \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445
      \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435 \u043B\u0438 \u0443\u0436\u0435
      \u043D\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219223
    m_Localized: "\u0416\u0435\u0447\u044C \u0441\u044B\u0440\u044B\u0435 \u0432\u0435\u0442\u043A\u0438
      - \u0434\u044B\u043C\u043E\u043C \u043E\u0442\u043E\u0433\u043D\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219224
    m_Localized: "\u0414\u044B\u043C \u043E\u0442 \u0441\u044B\u0440\u043E\u0433\u043E
      \u0442\u0430\u043C\u0430\u0440\u0438\u0441\u043A\u0430 \u0431\u044B\u043B \u0435\u0434\u043A\u0438\u0439
      \u0438 \u0433\u0443\u0441\u0442\u043E\u0439. \u0420\u043E\u0439 \u0441\u043C\u0435\u0441\u0442\u0438\u043B\u0441\u044F,
      \u043D\u043E \u043D\u0435 \u0443\u0448\u0451\u043B - \u0447\u0430\u0441\u0442\u044C
      \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C, \u043E\u0431\u044A\u0435\u043B\u0430
      \u0432\u0438\u0434\u0438\u043C\u044B\u0435 \u0437\u0430\u043F\u0430\u0441\u044B.
      \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438 \u0447\u0430\u0441 \u0438
      \u0447\u0430\u0441\u0442\u044C \u0444\u0443\u0440\u0430\u0436\u0430, \u0437\u0430\u0442\u043E
      \u0441\u043F\u0430\u0441\u043B\u0438 \u0431\u043E\u043B\u044C\u0448\u0443\u044E
      \u0447\u0430\u0441\u0442\u044C \u0437\u0435\u0440\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219225
    m_Localized: "\u0421\u0440\u043E\u0447\u043D\u043E \u0443\u043A\u0440\u044B\u0442\u044C
      \u0432\u0435\u0441\u044C \u0444\u0443\u0440\u0430\u0436"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219226
    m_Localized: "\u0412\u0441\u0435 \u0432\u043E\u0441\u0435\u043C\u044C \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0431\u0440\u043E\u0441\u0438\u043B\u0438\u0441\u044C \u0443\u043A\u0440\u044B\u0432\u0430\u0442\u044C
      \u043C\u0435\u0448\u043A\u0438 \u0432\u043E\u0439\u043B\u043E\u043A\u043E\u043C.
      \u0411\u043E\u043B\u044C\u0448\u0443\u044E \u0447\u0430\u0441\u0442\u044C \u0443\u0441\u043F\u0435\u043B\u0438.
      \u041C\u0435\u043D\u044C\u0448\u0443\u044E - \u043D\u0435\u0442: \u0441\u0430\u0440\u0430\u043D\u0447\u0430
      \u0435\u043B\u0430 \u0442\u043E, \u0447\u0442\u043E \u0442\u043E\u0440\u0447\u0430\u043B\u043E
      \u043D\u0430\u0440\u0443\u0436\u0443. \u0416\u0438\u0432\u043E\u0442\u043D\u044B\u0445
      \u043A\u043E\u0440\u043C\u0438\u0442\u044C \u043D\u0435\u0447\u0435\u043C \u0441\u0435\u0433\u043E\u0434\u043D\u044F,
      \u0437\u0430\u0432\u0442\u0440\u0430 \u043D\u0430\u0434\u043E \u043D\u0430\u0439\u0442\u0438
      \u043F\u0430\u0441\u0442\u0431\u0438\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219227
    m_Localized: "\u041F\u0440\u0438\u043D\u044F\u0442\u044C \u043F\u043E\u0442\u0435\u0440\u0438
      \u0438 \u0438\u0434\u0442\u0438 \u0432\u043F\u0435\u0440\u0451\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219228
    m_Localized: "\u041D\u0435 \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u043B\u0438\u0441\u044C.
      \u0421\u0430\u0440\u0430\u043D\u0447\u0430 \u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043B\u0430
      \u0437\u0430 \u043E\u0431\u043E\u0437\u043E\u043C \u0447\u0430\u0441, \u043F\u043E\u0442\u043E\u043C
      \u0440\u0430\u0441\u0441\u0435\u044F\u043B\u0430\u0441\u044C. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043C\u043D\u043E\u0433\u043E \u0444\u0443\u0440\u0430\u0436\u0430 - \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435
      \u0443\u0441\u0442\u0430\u043B\u0438 \u0440\u0430\u043D\u044C\u0448\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E,
      \u0438 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435 \u0434\u0432\u0430
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0442\u044F\u0436\u0435\u043B\u0435\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219229
    m_Localized: "\u041B\u0435\u0434\u044F\u043D\u043E\u0439 \u0433\u0440\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219230
    m_Localized: "\u041D\u0435\u0431\u043E \u043F\u043E\u0442\u0435\u043C\u043D\u0435\u043B\u043E
      \u0432 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u044C \u043C\u0438\u043D\u0443\u0442.
      \u041F\u0435\u0440\u0432\u044B\u0435 \u0433\u0440\u0430\u0434\u0438\u043D\u044B
      - \u0441 \u043D\u043E\u0433\u043E\u0442\u044C \u043C\u0438\u0437\u0438\u043D\u0446\u0430,
      \u043F\u043E\u0442\u043E\u043C \u0432\u0441\u0451 \u043A\u0440\u0443\u043F\u043D\u0435\u0435.
      \u0416\u0438\u0432\u043E\u0442\u043D\u044B\u0435 \u0448\u0430\u0440\u0430\u0445\u043D\u0443\u043B\u0438\u0441\u044C
      \u0438 \u0441\u0431\u0438\u043B\u0438\u0441\u044C \u0432 \u043A\u0443\u0447\u0443.
      \u0423\u0434\u0430\u0440\u044B \u043F\u043E \u0434\u0435\u0440\u0435\u0432\u044F\u043D\u043D\u044B\u043C
      \u0431\u043E\u0440\u0442\u0430\u043C \u043F\u043E\u0432\u043E\u0437\u043E\u043A
      - \u043A\u0430\u043A \u043A\u0430\u043C\u043D\u0438 \u0438\u0437 \u043F\u0440\u0430\u0449\u0438.
      \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B \u0441\u043A\u0443\u043B\u044F\u0442
      \u043D\u0438\u0437\u043A\u043E \u0438 \u043D\u0435\u043F\u0440\u0438\u044F\u0442\u043D\u043E.
      \u041B\u044E\u0434\u0438 \u043F\u0440\u0438\u043A\u0440\u044B\u0432\u0430\u044E\u0442
      \u0433\u043E\u043B\u043E\u0432\u044B \u0447\u0435\u043C \u043F\u043E\u043F\u0430\u043B\u043E.
      \u0413\u0440\u0430\u0434\u0438\u043D\u044B \u0432\u0435\u043B\u0438\u0447\u0438\u043D\u043E\u0439
      \u0441 \u0433\u043E\u043B\u0443\u0431\u0438\u043D\u043E\u0435 \u044F\u0439\u0446\u043E
      \u043E\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442 \u0441\u0438\u043D\u044F\u043A\u0438
      \u0434\u0430\u0436\u0435 \u0441\u043A\u0432\u043E\u0437\u044C \u0445\u0430\u043B\u0430\u0442.
      \u0413\u0440\u0443\u0437 \u043F\u043E\u0434 \u043E\u0442\u043A\u0440\u044B\u0442\u044B\u043C
      \u043D\u0435\u0431\u043E\u043C - \u0444\u0430\u0440\u0444\u043E\u0440, \u0441\u0442\u0435\u043A\u043B\u044F\u043D\u043D\u044B\u0435
      \u0444\u043B\u0430\u043A\u043E\u043D\u044B - \u0432 \u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219231
    m_Localized: "\u0423\u043A\u0440\u044B\u0442\u044C \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445
      \u043F\u043E\u0434 \u0441\u043A\u0430\u043B\u044C\u043D\u044B\u043C \u043A\u043E\u0437\u044B\u0440\u044C\u043A\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219232
    m_Localized: "\u0421\u043A\u0430\u043B\u0430 \u0432 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u0438
      \u0448\u0430\u0433\u0430\u0445. \u0417\u0430\u0432\u0435\u043B\u0438 \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432
      \u043F\u043E\u0434 \u043A\u043E\u0437\u044B\u0440\u0451\u043A - \u0435\u0434\u0432\u0430
      \u043F\u043E\u043C\u0435\u0441\u0442\u0438\u043B\u0438\u0441\u044C. \u041F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043E\u0441\u0442\u0430\u043B\u0438\u0441\u044C \u0441\u043D\u0430\u0440\u0443\u0436\u0438,
      \u0431\u043E\u0440\u0442\u0430 \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u043B\u0438\u0441\u044C
      \u043E\u0442 \u0443\u0434\u0430\u0440\u043E\u0432. \u041D\u043E \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0435
      \u0446\u0435\u043B\u044B, \u0430 \u0431\u0435\u0437 \u043D\u0438\u0445 \u043D\u0435\u0442
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219233
    m_Localized: "\u041D\u0430\u043A\u0440\u044B\u0442\u044C \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043A\u043E\u0448\u043C\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219234
    m_Localized: "\u0412\u043E\u0439\u043B\u043E\u043A \u043F\u0440\u0438\u043D\u044F\u043B
      \u0443\u0434\u0430\u0440: \u0445\u0440\u0443\u043F\u043A\u0438\u0439 \u0433\u0440\u0443\u0437
      \u0443\u0446\u0435\u043B\u0435\u043B. \u041D\u043E \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0432\u0441\u0451 \u0440\u0430\u0432\u043D\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u043B\u0438
      \u0441\u0432\u043E\u044E \u0434\u043E\u043B\u044E, \u0430 \u043B\u044E\u0434\u0438
      \u043F\u043E\u0431\u0438\u0442\u044B. \u0417\u0430\u0442\u043E \u0444\u0430\u0440\u0444\u043E\u0440\u043E\u0432\u044B\u0435
      \u0447\u0430\u0448\u043A\u0438 \u0432 \u0442\u044E\u043A\u0430\u0445 \u0434\u043E\u0448\u043B\u0438
      \u0434\u043E \u0433\u043E\u0440\u043E\u0434\u0430 \u0446\u0435\u043B\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219235
    m_Localized: "\u041E\u0442\u043E\u0433\u043D\u0430\u0442\u044C \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445
      \u0432 \u0445\u0432\u043E\u0441\u0442 \u043A\u043E\u043B\u043E\u043D\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219236
    m_Localized: "\u0416\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u0437\u0430\u0432\u0435\u0440\u043D\u0443\u043B\u0438
      \u043D\u0430\u0437\u0430\u0434, \u043D\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0435
      \u043C\u0435\u0441\u0442\u043E \u0442\u0430\u043C \u0431\u044B\u043B\u043E
      \u043D\u0435 \u043B\u0443\u0447\u0448\u0435. \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A
      \u041A\u044E\u043B\u044C-\u0431\u0430\u0442\u0443\u0440 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
      \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439 \u043F\u043E\u0440\u0435\u0437
      \u043E\u0442 \u043E\u0441\u0442\u0440\u043E\u0439 \u0433\u0440\u0430\u0434\u0438\u043D\u044B
      \u043F\u043E \u0441\u043A\u0443\u043B\u0435. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043F\u0435\u0440\u0435\u043F\u0443\u0433\u0430\u043B\u0438\u0441\u044C \u0438
      \u0440\u0430\u0437\u0431\u0435\u0436\u0430\u043B\u0438\u0441\u044C - \u0441\u043E\u0431\u0438\u0440\u0430\u043B\u0438
      \u043F\u043E\u043B\u0447\u0430\u0441\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219237
    m_Localized: "\u0422\u0440\u044F\u0441\u0438\u043D\u0430 \u0443 \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u0448\u0435\u0433\u043E
      \u043E\u0437\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219238
    m_Localized: "\u0414\u043D\u043E \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u0448\u0435\u0433\u043E
      \u043E\u0437\u0435\u0440\u0430 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B\u043E
      \u0442\u0432\u0451\u0440\u0434\u044B\u043C: \u0441\u0435\u0440\u0430\u044F
      \u043A\u043E\u0440\u043A\u0430, \u043F\u043E\u0442\u0440\u0435\u0441\u043A\u0430\u0432\u0448\u0430\u044F\u0441\u044F
      \u0437\u0438\u0433\u0437\u0430\u0433\u0430\u043C\u0438. \u041F\u0435\u0440\u0432\u044B\u0439
      \u044F\u043A \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0441\u044F \u043F\u043E
      \u043A\u043E\u043B\u0435\u043D\u043E - \u0432\u043D\u0435\u0437\u0430\u043F\u043D\u043E,
      \u0431\u0435\u0437 \u043F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F.
      \u041D\u0430\u0447\u0430\u043B \u0434\u0451\u0440\u0433\u0430\u0442\u044C\u0441\u044F
      \u0438 \u043F\u043E\u0433\u0440\u0443\u0437\u0438\u043B\u0441\u044F \u0433\u043B\u0443\u0431\u0436\u0435.
      \u0417\u0430 \u043D\u0438\u043C - \u043F\u043E\u0432\u043E\u0437\u043A\u0430,
      \u043A\u043E\u043B\u0451\u0441\u0430 \u043A\u043E\u0442\u043E\u0440\u043E\u0439
      \u0448\u043B\u0438 \u0441\u043B\u0435\u0434\u043E\u043C. \u041F\u043E\u0434
      \u043A\u043E\u0440\u043A\u043E\u0439 - \u0432\u043B\u0430\u0436\u043D\u044B\u0439
      \u0438\u043B, \u043C\u044F\u0433\u043A\u0438\u0439 \u043A\u0430\u043A \u043C\u0430\u0441\u043B\u043E.
      \u0421\u043E\u043B\u043D\u0446\u0435 \u0443\u0436\u0435 \u0432\u044B\u0441\u043E\u043A\u043E,
      \u0436\u0430\u0440\u0430 \u0434\u0430\u0432\u0438\u0442. \u0422\u0440\u0438
      \u044F\u043A\u0430 \u0443\u0432\u044F\u0437\u043B\u0438. \u041E\u0431\u043E\u0437
      \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u043A\u0440\u0430\u044E \u0443\u0447\u0430\u0441\u0442\u043A\u0430,
      \u043D\u0435 \u0437\u043D\u0430\u044F \u0433\u0434\u0435 \u0442\u0432\u0451\u0440\u0434\u043E,
      \u0430 \u0433\u0434\u0435 \u0441\u043D\u043E\u0432\u0430 \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219239
    m_Localized: "\u0420\u0443\u0431\u0438\u0442\u044C \u0436\u0435\u0440\u0434\u0438
      - \u043D\u0430\u0441\u0442\u0438\u043B\u0430\u0442\u044C \u043F\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219240
    m_Localized: "\u0420\u0430\u0437\u043E\u0431\u0440\u0430\u043B\u0438 \u0431\u043E\u0440\u0442
      \u043E\u0434\u043D\u043E\u0439 \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043D\u0430
      \u0434\u043E\u0441\u043A\u0438, \u043D\u0430\u0431\u0440\u043E\u0441\u0430\u043B\u0438
      \u0432\u043F\u0435\u0440\u0451\u0434. \u041F\u043E \u043D\u0430\u0441\u0442\u0438\u043B\u0443
      \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438 \u044F\u043A\u043E\u0432 \u0438
      \u043F\u0440\u043E\u0432\u0435\u043B\u0438 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0431\u043E\u0440\u0442 \u0438 \u043F\u043E\u043B\u0434\u043D\u044F, \u0437\u0430\u0442\u043E
      \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438 \u0432\u0441\u0435\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219241
    m_Localized: "\u0412\u044B\u043F\u0440\u044F\u0447\u044C \u044F\u043A\u043E\u0432
      - \u0442\u0430\u0449\u0438\u0442\u044C \u043F\u0443\u0441\u0442\u044B\u0435
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219242
    m_Localized: "\u0416\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u0432\u044B\u0432\u0435\u043B\u0438
      \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443, \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E.
      \u041F\u0443\u0441\u0442\u044B\u0435 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0442\u044F\u043D\u0443\u043B\u0438 \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u043C\u0438
      \u0441 \u0442\u0432\u0451\u0440\u0434\u043E\u0433\u043E \u0431\u0435\u0440\u0435\u0433\u0430.
      \u0414\u043E\u043B\u0433\u043E \u0438 \u0442\u044F\u0436\u0435\u043B\u043E,
      \u043D\u043E \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u043E. \u041E\u0434\u0438\u043D
      \u0432\u0430\u043B \u0438\u043B\u0430 \u0432\u0441\u0451 \u0436\u0435 \u043F\u043E\u0433\u043B\u043E\u0442\u0438\u043B
      \u043A\u043E\u043B\u0435\u0441\u043E - \u043F\u0440\u0438\u0448\u043B\u043E\u0441\u044C
      \u0431\u0440\u043E\u0441\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219243
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u043E\u0434\u043D\u0443
      \u043F\u043E\u0432\u043E\u0437\u043A\u0443 - \u0441\u043F\u0430\u0441\u0442\u0438
      \u044F\u043A\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219244
    m_Localized: "\u041F\u043E\u0432\u043E\u0437\u043A\u0443 \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438
      - \u0442\u043E\u0432\u0430\u0440 \u0447\u0430\u0441\u0442\u0438\u0447\u043D\u043E
      \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0437\u0438\u043B\u0438 \u043D\u0430
      \u0434\u0440\u0443\u0433\u0438\u0445, \u0447\u0430\u0441\u0442\u044C \u043F\u043E\u0442\u043E\u043D\u0443\u043B\u0430.
      \u042F\u043A\u043E\u0432 \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438 \u043D\u0430
      \u0442\u0432\u0451\u0440\u0434\u043E\u0435 \u043C\u0435\u0441\u0442\u043E.
      \u0411\u0435\u0437 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430
      \u043D\u0435\u0442; \u0433\u0440\u0443\u0437 \u043C\u043E\u0436\u043D\u043E
      \u0434\u043E\u043A\u0443\u043F\u0438\u0442\u044C \u0432 \u0433\u043E\u0440\u043E\u0434\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219245
    m_Localized: "\u041B\u0451\u0434 \u0442\u0440\u0435\u0441\u043D\u0443\u043B \u043F\u043E\u0434
      \u043F\u043E\u0432\u043E\u0437\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219246
    m_Localized: "\u0417\u0438\u043C\u043D\u044F\u044F \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430:
      \u043B\u0451\u0434 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u043C
      - \u0441\u0438\u043D\u0435\u0432\u0430\u0442\u043E-\u0441\u0435\u0440\u044B\u0439,
      \u0431\u0435\u0437 \u043F\u0443\u0441\u0442\u043E\u0442. \u041F\u0435\u0440\u0432\u044B\u0435
      \u0442\u0440\u0438 \u043F\u043E\u0432\u043E\u0437\u043A\u0438 \u043F\u0440\u043E\u0448\u043B\u0438
      \u0431\u0435\u0437 \u043F\u0440\u043E\u0431\u043B\u0435\u043C. \u0427\u0435\u0442\u0432\u0451\u0440\u0442\u0430\u044F,
      \u0442\u044F\u0436\u0435\u043B\u043E\u0433\u0440\u0443\u0436\u0451\u043D\u0430\u044F,
      \u043D\u0430 \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435 \u0440\u0435\u043A\u0438
      \u0438\u0437\u0434\u0430\u043B\u0430 \u0437\u0432\u0443\u043A \u0440\u0430\u0441\u043A\u0430\u043B\u044B\u0432\u0430\u044E\u0449\u0435\u0433\u043E\u0441\u044F
      \u0434\u0435\u0440\u0435\u0432\u0430 - \u0438 \u043E\u0441\u0435\u043B\u0430
      \u043D\u0430 \u043F\u043E\u043B\u043A\u043E\u043B\u0435\u0441\u0430 \u0432
      \u0432\u043E\u0434\u0443. \u041B\u0451\u0434 \u0434\u0435\u0440\u0436\u0438\u0442,
      \u043D\u043E \u0442\u0440\u0435\u0449\u0438\u043D\u0430 \u0440\u0430\u0441\u0445\u043E\u0434\u0438\u0442\u0441\u044F.
      \u0412\u043E\u0434\u0430 \u0432 \u0440\u0435\u043A\u0435 \u043F\u043E \u0433\u0440\u0443\u0434\u044C
      \u0447\u0435\u043B\u043E\u0432\u0435\u043A\u0443, \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430
      - \u0431\u043B\u0438\u0437\u043A\u043E \u043A \u043D\u0443\u043B\u044E. \u041F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u044B\u0439
      \u0431\u0435\u0440\u0435\u0433 \u0432 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u0438
      \u0448\u0430\u0433\u0430\u0445. \u041E\u0431\u043E\u0437 \u043D\u0430 \u044D\u0442\u043E\u043C
      \u0431\u0435\u0440\u0435\u0433\u0443 \u0437\u0430\u043C\u0435\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219247
    m_Localized: "\u041E\u0442\u0441\u0442\u0443\u043F\u0438\u0442\u044C - \u0438\u0441\u043A\u0430\u0442\u044C
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0431\u0440\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219248
    m_Localized: "\u0427\u0435\u0442\u0432\u0451\u0440\u0442\u0443\u044E \u043F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0430\u043A\u043A\u0443\u0440\u0430\u0442\u043D\u043E \u0441\u0434\u0430\u043B\u0438
      \u043D\u0430\u0437\u0430\u0434 - \u0442\u0440\u0435\u0449\u0438\u043D\u0430
      \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u043B\u0430\u0441\u044C, \u043D\u043E
      \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E. \u041D\u0430\u0448\u043B\u0438
      \u0431\u0440\u043E\u0434 \u0432 \u0434\u0432\u0443\u0445 \u043B\u0438 \u0432\u044B\u0448\u0435
      - \u043D\u0435\u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0439, \u043D\u043E
      \u043B\u0435\u0434\u044F\u043D\u043E\u0439 \u0432\u043E\u0434\u044B \u043F\u043E
      \u0433\u043E\u043B\u0435\u043D\u044C. \u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u0438\u0441\u044C
      \u0437\u0430 \u0442\u0440\u0438 \u0447\u0430\u0441\u0430 \u0441 \u043F\u043E\u0442\u0435\u0440\u0435\u0439
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438 \u0438 \u043D\u0435\u0440\u0432\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219249
    m_Localized: "\u0420\u0430\u0437\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043F\u043E\u0432\u043E\u0437\u043A\u0443
      \u0438 \u043F\u0440\u043E\u0432\u0435\u0437\u0442\u0438 \u043D\u0430\u043B\u0435\u0433\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219250
    m_Localized: "\u0422\u044E\u043A\u0438 \u043F\u0435\u0440\u0435\u043D\u0435\u0441\u043B\u0438
      \u043F\u043E \u043B\u044C\u0434\u0443 \u0432\u0440\u0443\u0447\u043D\u0443\u044E.
      \u041F\u0443\u0441\u0442\u0430\u044F \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043F\u0440\u043E\u0448\u043B\u0430 \u0431\u0435\u0437 \u043F\u0440\u043E\u0431\u043B\u0435\u043C.
      \u0413\u0440\u0443\u0437 \u0442\u043E\u0436\u0435 \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u0438
      - \u0445\u043E\u043B\u043E\u0434\u043D\u043E, \u0441\u043A\u043E\u043B\u044C\u0437\u043A\u043E,
      \u043E\u0434\u0438\u043D \u0442\u044E\u043A \u0443\u043F\u0430\u043B \u0432
      \u0432\u043E\u0434\u0443. \u0412\u0441\u0451 \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u043E\u0435
      \u0446\u0435\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219251
    m_Localized: "\u0422\u044F\u043D\u0443\u0442\u044C \u0432\u0435\u0440\u0451\u0432\u043A\u0430\u043C\u0438
      \u0441 \u043E\u0431\u043E\u0438\u0445 \u0431\u0435\u0440\u0435\u0433\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219252
    m_Localized: "\u0427\u0435\u0442\u044B\u0440\u0435 \u0432\u0435\u0440\u0451\u0432\u043A\u0438
      \u0441 \u043E\u0431\u043E\u0438\u0445 \u0431\u0435\u0440\u0435\u0433\u043E\u0432.
      \u041F\u043E\u0432\u043E\u0437\u043A\u0443 \u0442\u044F\u043D\u0443\u043B\u0438
      \u0440\u043E\u0432\u043D\u043E, \u043D\u0435 \u0434\u0430\u0432\u0430\u044F
      \u043A\u0430\u0447\u0430\u0442\u044C\u0441\u044F. \u041B\u0451\u0434 \u0445\u0440\u0443\u0441\u0442\u0435\u043B,
      \u043D\u043E \u0434\u0435\u0440\u0436\u0430\u043B. \u0417\u0430 \u0434\u0435\u0441\u044F\u0442\u044C
      \u043C\u0438\u043D\u0443\u0442 \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438
      \u043D\u0430 \u0442\u043E\u0442 \u0431\u0435\u0440\u0435\u0433. \u0422\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438
      \u0441\u043B\u043E\u0436\u043D\u043E - \u043D\u043E \u0441\u0440\u0430\u0431\u043E\u0442\u0430\u043B\u043E
      \u0447\u0438\u0441\u0442\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219253
    m_Localized: "\u041E\u0430\u0437\u0438\u0441 \u043F\u0435\u0440\u0435\u0441\u043E\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219254
    m_Localized: "\u041F\u0430\u043B\u044C\u043C\u044B \u0441\u0442\u043E\u044F\u0442,
      \u043D\u043E \u043B\u0438\u0441\u0442\u044C\u044F \u0441\u0435\u0440\u044B\u0435
      \u043E\u0442 \u043F\u044B\u043B\u0438 - \u0431\u0435\u0437 \u0432\u043B\u0430\u0433\u0438
      \u0441 \u0432\u0435\u0441\u043D\u044B. \u041A\u043E\u043B\u043E\u0434\u0435\u0446,
      \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u043B\u0438,
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043F\u0443\u0441\u0442\u044B\u043C
      \u0433\u043B\u0430\u0437\u043E\u043C \u0432\u043E\u0441\u044C\u043C\u0438 \u043B\u043E\u043A\u0442\u0435\u0439
      \u0433\u043B\u0443\u0431\u0438\u043D\u043E\u0439 \u0438 \u0441\u0443\u0445\u0438\u043C
      \u0434\u043D\u043E\u043C. \u0411\u0443\u0433\u0430 \u043A\u0438\u0434\u0430\u0435\u0442
      \u043A\u0430\u043C\u0435\u043D\u044C - \u0437\u0432\u0443\u043A \u0433\u043B\u0443\u0445\u043E\u0439,
      \u043D\u0438\u043A\u0430\u043A\u043E\u0439 \u0432\u043E\u0434\u044B. \u0412
      \u043E\u0431\u043E\u0437\u0435 \u0432\u043E\u0434\u044B \u043D\u0430 \u0434\u0432\u0430
      \u0434\u043D\u044F \u043F\u0440\u0438 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0438.
      \u0414\u043E \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0433\u043E \u0433\u0430\u0440\u0430\u043D\u0442\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0433\u043E
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430 - \u0447\u0435\u0442\u044B\u0440\u0435
      \u0434\u043D\u044F \u043F\u0443\u0442\u0438. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u0443\u0436\u0435 \u043F\u044C\u044E\u0442 \u0434\u0430\u0432\u043D\u043E,
      \u043B\u044E\u0434\u0438 \u044D\u043A\u043E\u043D\u043E\u043C\u044F\u0442.
      \u0421\u043E\u043B\u043D\u0446\u0435 \u0432 \u0437\u0435\u043D\u0438\u0442\u0435,
      \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u043F\u044F\u0442\u044C \u043F\u043E
      \u043E\u0449\u0443\u0449\u0435\u043D\u0438\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219255
    m_Localized: "\u0420\u0430\u0446\u0438\u043E\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C
      - \u0438\u0434\u0442\u0438 \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439
      \u0441\u0442\u043E\u044F\u043D\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219256
    m_Localized: "\u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u043D\u043E\u0440\u043C\u044B
      \u0432\u043E\u0434\u044B. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043D\u0435\u0441\u0443\u0442 \u0431\u0435\u0437 \u0436\u0430\u043B\u043E\u0431
      - \u043E\u043D\u0438 \u043C\u043E\u0433\u0443\u0442. \u041B\u044E\u0434\u0438
      \u0441\u0442\u0440\u0430\u0434\u0430\u044E\u0442 \u043C\u043E\u043B\u0447\u0430.
      \u041D\u0430 \u0442\u0440\u0435\u0442\u0438\u0439 \u0434\u0435\u043D\u044C
      \u0443 \u043B\u0435\u043A\u0430\u0440\u044F \u041F\u0435\u043C\u0431\u044B
      \u043F\u0435\u0440\u0435\u0441\u043E\u0445\u043B\u043E \u0433\u043E\u0440\u043B\u043E
      \u0442\u0430\u043A, \u0447\u0442\u043E \u043E\u043D \u0435\u0434\u0432\u0430
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B. \u041A \u0447\u0435\u0442\u0432\u0451\u0440\u0442\u043E\u043C\u0443
      \u0434\u043D\u044E \u043D\u0430\u0448\u043B\u0438 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A.
      \u0414\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219257
    m_Localized: "\u041A\u0443\u043F\u0438\u0442\u044C \u0432\u043E\u0434\u0443 \u0443
      \u043A\u043E\u0447\u0435\u0432\u043D\u0438\u043A\u043E\u0432 \u0437\u0430 \u043B\u044E\u0431\u0443\u044E
      \u0446\u0435\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219258
    m_Localized: "\u0422\u044E\u0440\u043A\u0441\u043A\u0438\u0439 \u043F\u0430\u0441\u0442\u0443\u0445
      \u0411\u0438\u043B\u044C\u0433\u044D \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F
      \u043D\u0430 \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442\u0435 \u043D\u0430
      \u0442\u0440\u0435\u0442\u0438\u0439 \u0447\u0430\u0441 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u044F.
      \u0417\u0430\u043F\u0440\u043E\u0441\u0438\u043B \u0432 \u0447\u0435\u0442\u044B\u0440\u0435
      \u0440\u0430\u0437\u0430 \u0434\u043E\u0440\u043E\u0436\u0435 \u0440\u044B\u043D\u043E\u0447\u043D\u043E\u0439
      \u0446\u0435\u043D\u044B. \u0417\u0430\u043F\u043B\u0430\u0442\u0438\u043B\u0438
      \u0431\u0435\u0437 \u0442\u043E\u0440\u0433\u0430. \u0412\u043E\u0434\u0430
      \u0435\u0441\u0442\u044C - \u044D\u0442\u043E \u0432\u0430\u0436\u043D\u0435\u0435
      \u043C\u043E\u043D\u0435\u0442 \u0432 \u043F\u0443\u0441\u0442\u044B\u043D\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219259
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u043B\u044E\u0434\u0435\u0439
      \u043D\u0430\u043B\u0435\u0433\u043A\u0435 \u0432\u043F\u0435\u0440\u0451\u0434
      \u0437\u0430 \u0432\u043E\u0434\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219260
    m_Localized: "\u0422\u0440\u043E\u0435 \u0443\u0448\u043B\u0438 \u043D\u0430\u043B\u0435\u0433\u043A\u0435
      \u0438 \u0432\u0435\u0440\u043D\u0443\u043B\u0438\u0441\u044C \u0447\u0435\u0440\u0435\u0437
      \u0434\u0435\u043D\u044C \u0441 \u0431\u0443\u0440\u0434\u044E\u043A\u0430\u043C\u0438.
      \u041E\u0431\u043E\u0437 \u0436\u0434\u0430\u043B \u043F\u043E\u0434 \u043F\u0430\u043B\u044C\u043C\u0430\u043C\u0438,
      \u044D\u043A\u043E\u043D\u043E\u043C\u044F \u0432\u043E\u0434\u0443. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0434\u0435\u043D\u044C, \u043D\u043E \u0432\u0441\u0435 \u0434\u043E\u0448\u043B\u0438
      \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C. \u0421\u043E\u0433\u043B\u0430\u0441\u043E\u0432\u0430\u043D\u043D\u043E\u0435
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u0432 \u043A\u0440\u0438\u0437\u0438\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219261
    m_Localized: "\u0421\u043C\u0435\u0440\u0447 \u0440\u0430\u0437\u043C\u0435\u0442\u0430\u043B
      \u043B\u0430\u0433\u0435\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219262
    m_Localized: "\u041F\u0435\u0441\u0447\u0430\u043D\u044B\u0439 \u0441\u0442\u043E\u043B\u0431
      \u043F\u043E\u044F\u0432\u0438\u043B\u0441\u044F \u0438\u0437 \u043D\u0438\u043E\u0442\u043A\u0443\u0434\u0430
      - \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0439,
      \u0432\u043E\u044E\u0449\u0438\u0439, \u0441 \u043A\u0443\u043B\u0430\u043A
      \u0448\u0438\u0440\u0438\u043D\u043E\u0439 \u0443 \u0437\u0435\u043C\u043B\u0438
      \u0438 \u0442\u0440\u0438 \u0434\u0435\u0440\u0435\u0432\u0430 \u0432\u044B\u0441\u043E\u0442\u043E\u0439.
      \u0417\u0430 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u0441\u0435\u043A\u0443\u043D\u0434
      \u043E\u043D \u043F\u0440\u043E\u0448\u0451\u043B \u0447\u0435\u0440\u0435\u0437
      \u043B\u0430\u0433\u0435\u0440\u044C \u0438 \u0443\u043D\u0451\u0441 \u0441
      \u0441\u043E\u0431\u043E\u0439 \u043B\u0451\u0433\u043A\u0438\u0435 \u0442\u044E\u043A\u0438,
      \u043A\u043E\u0448\u043C\u044B, \u043E\u0434\u0438\u043D \u0448\u0430\u0442\u0440\u043E\u0432\u044B\u0439
      \u043F\u043E\u043B\u043E\u0433 \u0438 \u0441\u0443\u043C\u043A\u0443 \u0441
      \u043D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u043C\u0438
      \u0441\u0432\u0438\u0442\u043A\u0430\u043C\u0438. \u0412\u0435\u0440\u0431\u043B\u044E\u0434\u044B
      \u043B\u0435\u0436\u0430\u043B\u0438 \u043D\u0430 \u0437\u0435\u043C\u043B\u0435
      - \u043E\u043D\u0438 \u0447\u0443\u044E\u0442 \u0442\u0430\u043A\u0438\u0435
      \u0432\u0435\u0449\u0438 \u0437\u0430\u0440\u0430\u043D\u0435\u0435 \u0438
      \u043B\u043E\u0436\u0430\u0442\u0441\u044F \u0441\u0430\u043C\u0438. \u041B\u044E\u0434\u0438
      \u043F\u0430\u0434\u0430\u043B\u0438. \u041F\u043E\u0442\u043E\u043C \u0442\u0438\u0448\u0438\u043D\u0430,
      \u043F\u044B\u043B\u044C \u043E\u0441\u0435\u0434\u0430\u0435\u0442, \u043B\u0430\u0433\u0435\u0440\u044C
      \u0432\u044B\u0433\u043B\u044F\u0434\u0438\u0442 \u043A\u0430\u043A \u043F\u043E\u0441\u043B\u0435
      \u043D\u0430\u043B\u0451\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219263
    m_Localized: "\u041B\u0435\u0447\u044C \u0438 \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C
      - \u043D\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219264
    m_Localized: "\u0412\u0441\u0435 \u0443\u043F\u0430\u043B\u0438 \u0432\u043E\u0432\u0440\u0435\u043C\u044F.
      \u0421\u043C\u0435\u0440\u0447 \u043F\u0440\u043E\u0448\u0451\u043B \u043F\u043E\u0432\u0435\u0440\u0445\u0443
      \u0438 \u0443\u0448\u0451\u043B. \u041A\u043E\u0448\u043C\u044B \u0441\u043D\u0435\u0441\u043B\u043E
      - \u043D\u0430\u0448\u043B\u0438 \u0432 \u0441\u0442\u0430 \u0448\u0430\u0433\u0430\u0445.
      \u041D\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0435
      \u0441\u0432\u0438\u0442\u043A\u0438 \u0443\u043B\u0435\u0442\u0435\u043B\u0438
      \u0431\u0435\u0437\u0432\u043E\u0437\u0432\u0440\u0430\u0442\u043D\u043E. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u0431\u0443\u043C\u0430\u0433\u0443 \u0438 \u0447\u0430\u0441\u0442\u044C
      \u0431\u044B\u0442\u0430, \u043B\u044E\u0434\u0438 \u0446\u0435\u043B\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219265
    m_Localized: "\u041B\u043E\u0432\u0438\u0442\u044C \u0440\u0430\u0437\u043B\u0435\u0442\u0430\u044E\u0449\u0438\u0439\u0441\u044F
      \u0433\u0440\u0443\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219266
    m_Localized: "\u0414\u0432\u043E\u0435 \u043F\u043E\u0431\u0435\u0436\u0430\u043B\u0438
      \u0437\u0430 \u0442\u044E\u043A\u0430\u043C\u0438 \u0438 \u043F\u043E\u0439\u043C\u0430\u043B\u0438
      \u0447\u0430\u0441\u0442\u044C. \u0422\u0440\u0435\u0442\u0438\u0439 \u043F\u043E\u043F\u0430\u043B
      \u0432 \u043A\u0440\u0430\u0439 \u0441\u043C\u0435\u0440\u0447\u0430 \u0438
      \u0443\u043F\u0430\u043B, \u043E\u0431\u043E\u0434\u0440\u0430\u0432 \u0440\u0443\u043A\u0438
      \u043E \u043A\u0430\u043C\u043D\u0438. \u0412\u0435\u0440\u043D\u0443\u043B\u0438
      \u0447\u0435\u0442\u044B\u0440\u0435 \u0442\u044E\u043A\u0430 \u0438\u0437
      \u0432\u043E\u0441\u044C\u043C\u0438 \u0443\u043D\u0435\u0441\u0451\u043D\u043D\u044B\u0445
      - \u043E\u0441\u0442\u0430\u043B\u044C\u043D\u044B\u0435 \u0438\u0441\u0447\u0435\u0437\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219267
    m_Localized: "\u041F\u0440\u0438\u0432\u044F\u0437\u0430\u0442\u044C \u0432\u0441\u0451
      \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C \u0438
      \u0441\u0442\u043E\u044F\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219268
    m_Localized: "\u0412\u043C\u0435\u0441\u0442\u043E \u043F\u043E\u0433\u043E\u043D\u0438
      \u0437\u0430 \u0443\u043B\u0435\u0442\u0435\u0432\u0448\u0438\u043C \u0437\u0430\u043D\u044F\u043B\u0438\u0441\u044C
      \u0442\u0435\u043C, \u0447\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C:
      \u0432\u0435\u0440\u0451\u0432\u043A\u0438, \u0443\u0437\u043B\u044B, \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u043F\u0440\u0438\u0436\u0430\u043B\u0438 \u043A \u0437\u0435\u043C\u043B\u0435.
      \u0421\u043C\u0435\u0440\u0447 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F
      - \u0441\u043B\u0430\u0431\u0435\u0435, \u043D\u043E \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F.
      \u0412\u0442\u043E\u0440\u043E\u0439 \u0440\u0430\u0437 \u043F\u0440\u043E\u0448\u0451\u043B
      \u043F\u043E\u0447\u0442\u0438 \u0431\u0435\u0437 \u0443\u0449\u0435\u0440\u0431\u0430.
      \u0423\u043C\u043D\u044B\u0439 \u0432\u044B\u0431\u043E\u0440 \u0432 \u0445\u0430\u043E\u0441\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219269
    m_Localized: "\u0411\u0443\u0440\u044F \u0441\u0440\u0435\u0434\u0438 \u043B\u0435\u0442\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219270
    m_Localized: "\u041C\u0435\u0441\u044F\u0446 \u0436\u0430\u0442\u0432\u044B,
      \u0440\u0430\u0437\u0433\u0430\u0440 \u043B\u0435\u0442\u0430 - \u0438 \u0441\u043D\u0435\u0433.
      \u041D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435 \u0441\u0435\u043C\u0438
      \u0442\u044B\u0441\u044F\u0447 \u043B\u043E\u043A\u0442\u0435\u0439 \u0432\u044B\u0441\u043E\u0442\u044B
      \u0437\u0438\u043C\u0430 \u043D\u0435 \u0437\u043D\u0430\u0435\u0442 \u043A\u0430\u043B\u0435\u043D\u0434\u0430\u0440\u0435\u0439.
      \u0412\u0435\u0442\u0435\u0440 \u043F\u0440\u0438\u0448\u0451\u043B \u0441
      \u0441\u0435\u0432\u0435\u0440\u0430 \u0440\u0435\u0437\u043A\u0438\u0439 \u0438
      \u043C\u043E\u043A\u0440\u044B\u0439, \u0438 \u0447\u0435\u0440\u0435\u0437
      \u0447\u0430\u0441 \u0431\u0435\u043B\u043E\u0435 \u043C\u0435\u0441\u0438\u0432\u043E
      \u0443\u0436\u0435 \u0437\u0430\u043B\u0435\u043F\u043B\u044F\u043B\u043E \u0433\u043B\u0430\u0437\u0430.
      \u0422\u0440\u043E\u043F\u0430 \u0441\u0442\u0430\u043B\u0430 \u0441\u043A\u043E\u043B\u044C\u0437\u043A\u043E\u0439.
      \u0422\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430 \u0443\u043F\u0430\u043B\u0430
      \u0442\u0430\u043A \u0431\u044B\u0441\u0442\u0440\u043E, \u0447\u0442\u043E
      \u043F\u0440\u043E\u043C\u0451\u0440\u0437\u0448\u0438\u0439 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A
      \u0411\u0443\u0433\u0430 \u0441\u043A\u0430\u0437\u0430\u043B \u0442\u043E\u043B\u044C\u043A\u043E:
      <npc_speech lang=\"Turkic\">\u041F\u043B\u043E\u0445\u043E.</npc_speech> \u0412\u0438\u0434\u0438\u043C\u043E\u0441\u0442\u044C
      - \u0434\u0435\u0441\u044F\u0442\u044C \u0448\u0430\u0433\u043E\u0432. \u0412\u043F\u0435\u0440\u0435\u0434\u0438
      - \u043B\u0438\u0431\u043E \u0441\u043A\u0430\u043B\u0430 \u0441 \u0443\u043A\u0440\u044B\u0442\u0438\u0435\u043C,
      \u043B\u0438\u0431\u043E \u043F\u0435\u0449\u0435\u0440\u0430, \u043A\u043E\u0442\u043E\u0440\u0443\u044E
      \u0443\u043F\u043E\u043C\u0438\u043D\u0430\u043B \u043F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219271
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u0442\u044C \u043B\u0430\u0433\u0435\u0440\u044C
      \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219272
    m_Localized: "\u0420\u0430\u0437\u0431\u0438\u043B\u0438 \u0448\u0430\u0442\u0440\u044B
      \u0437\u0430 \u0442\u0440\u0438\u0434\u0446\u0430\u0442\u044C \u043C\u0438\u043D\u0443\u0442
      \u043D\u0430 \u043E\u0442\u043D\u043E\u0441\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0440\u043E\u0432\u043D\u043E\u043C \u0443\u0447\u0430\u0441\u0442\u043A\u0435.
      \u0411\u0443\u0440\u044F \u0433\u0440\u0435\u043C\u0435\u043B\u0430 \u0434\u0432\u043E\u0435
      \u0441\u0443\u0442\u043E\u043A. \u0415\u0434\u0443 \u0432\u0430\u0440\u0438\u043B\u0438
      \u043D\u0430 \u0443\u0433\u043B\u044F\u0445 \u0432\u043D\u0443\u0442\u0440\u0438.
      \u0412\u044B\u0448\u043B\u0438 \u043D\u0430 \u0442\u0440\u0435\u0442\u0438\u0439
      \u0434\u0435\u043D\u044C - \u0432\u0441\u0451 \u0431\u044B\u043B\u043E \u0437\u0430\u043D\u0435\u0441\u0435\u043D\u043E
      \u0441\u043D\u0435\u0433\u043E\u043C \u043F\u043E \u043A\u043E\u043B\u0435\u043D\u043E,
      \u043D\u043E \u0436\u0438\u0432\u044B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219273
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0442\u044C \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F
      - \u043F\u0440\u043E\u0439\u0442\u0438 \u043F\u0435\u0440\u0435\u0432\u0430\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219274
    m_Localized: "\u0428\u043B\u0438 \u0435\u0449\u0451 \u0434\u0432\u0430 \u0447\u0430\u0441\u0430
      \u0432 \u0441\u043D\u0435\u0436\u043D\u043E\u0439 \u043C\u0433\u043B\u0435.
      \u0422\u0440\u043E\u043F\u0430 \u043F\u043E\u0447\u0442\u0438 \u0438\u0441\u0447\u0435\u0437\u043B\u0430.
      \u041E\u0445\u0440\u0430\u043D\u043D\u0438\u043A \u041D\u0430\u043D\u0430\u043C
      \u0443\u043F\u0430\u043B \u043D\u0430 \u043A\u0440\u0430\u044E \u0441\u043A\u043B\u043E\u043D\u0430
      - \u0432\u044B\u0442\u0430\u0449\u0438\u043B\u0438. \u041F\u043E\u0442\u0435\u0440\u044F\u043B\u0438
      \u043E\u0434\u043D\u0443 \u043F\u043E\u0432\u043E\u0437\u043A\u0443 \u0432
      \u0441\u043D\u0435\u0433\u0443. \u041A \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0443
      \u0432\u044B\u0448\u043B\u0438 - \u0445\u043E\u043B\u043E\u0434\u043D\u044B\u0435
      \u0438 \u0438\u0437\u043D\u0443\u0440\u0451\u043D\u043D\u044B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219275
    m_Localized: "\u041D\u0430\u0439\u0442\u0438 \u043F\u0435\u0449\u0435\u0440\u0443
      - \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C \u0442\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219276
    m_Localized: "\u041F\u0435\u0449\u0435\u0440\u0430 \u043D\u0430\u0448\u043B\u0430\u0441\u044C
      \u0432 \u043F\u044F\u0442\u043D\u0430\u0434\u0446\u0430\u0442\u0438 \u043C\u0438\u043D\u0443\u0442\u0430\u0445
      \u0445\u043E\u0434\u0430 \u043E\u0442 \u0442\u0440\u043E\u043F\u044B - \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F,
      \u043D\u043E \u0437\u0430\u043A\u0440\u044B\u0442\u0430\u044F. \u0417\u0430\u0432\u0435\u043B\u0438
      \u0432\u0435\u0440\u0431\u043B\u044E\u0434\u043E\u0432, \u0440\u0430\u0437\u043E\u0436\u0433\u043B\u0438
      \u043A\u043E\u0441\u0442\u0451\u0440 \u0438\u0437 \u0437\u0430\u043F\u0430\u0441\u043D\u043E\u0433\u043E
      \u0434\u0435\u0440\u0435\u0432\u0430. \u0421\u0438\u0434\u0435\u043B\u0438
      \u0441\u0443\u0442\u043A\u0438. \u0412\u044B\u0448\u043B\u0438 \u043E\u0442\u0434\u043E\u0445\u043D\u0443\u0432\u0448\u0438\u043C\u0438
      \u0438 \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C \u0432 \u043B\u044E\u0434\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219277
    m_Localized: "\u041E\u0431\u043E\u0437 \u0438\u0441\u0447\u0435\u0437 \u0437\u0430
      \u043D\u043E\u0447\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219278
    m_Localized: "\u0412\u0447\u0435\u0440\u0430 \u0432\u0435\u0447\u0435\u0440\u043E\u043C
      \u043F\u043E\u043F\u0443\u0442\u043D\u044B\u0439 \u043E\u0431\u043E\u0437 \u0440\u0430\u0437\u0431\u0438\u043B
      \u043B\u0430\u0433\u0435\u0440\u044C \u0432 \u0441\u0442\u0430 \u0448\u0430\u0433\u0430\u0445
      - \u0441\u043B\u044B\u0448\u043D\u044B \u0431\u044B\u043B\u0438 \u0433\u043E\u043B\u043E\u0441\u0430,
      \u0437\u0430\u043F\u0430\u0445 \u0434\u044B\u043C\u0430 \u043E\u0442 \u0438\u0445
      \u043A\u043E\u0441\u0442\u0440\u0430. \u0423\u0442\u0440\u043E\u043C - \u0442\u0438\u0448\u0438\u043D\u0430.
      \u0422\u043E\u043B\u044C\u043A\u043E \u0432\u043C\u044F\u0442\u0438\u043D\u044B
      \u043E\u0442 \u0448\u0430\u0442\u0440\u043E\u0432\u044B\u0445 \u043A\u043E\u043B\u044C\u0435\u0432
      \u0432 \u0437\u0435\u043C\u043B\u0435, \u0441\u0431\u0438\u0442\u044B\u0435
      \u0443\u0433\u043B\u0438 \u0438 \u0441\u043B\u0435\u0434\u044B \u043A\u043E\u043F\u044B\u0442.
      \u0421\u043B\u0435\u0434\u044B \u0443\u0445\u043E\u0434\u044F\u0442 \u043D\u0430
      \u0432\u043E\u0441\u0442\u043E\u043A, \u043A \u0441\u043A\u0430\u043B\u0430\u043C,
      \u0438 \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0435\u0441\u0442\u0438
      \u0448\u0430\u0433\u043E\u0432 \u043E\u0431\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      - \u043A\u0430\u043A \u0431\u0443\u0434\u0442\u043E \u043E\u0431\u043E\u0437
      \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F \u0432 \u0432\u043E\u0437\u0434\u0443\u0445.
      \u0417\u0435\u043C\u043B\u044F \u0442\u0432\u0451\u0440\u0434\u0430\u044F,
      \u0441\u043B\u0435\u0434\u043E\u0432 \u0434\u0430\u043B\u044C\u0448\u0435 \u043D\u0435\u0442.
      \u0411\u0443\u0433\u0430 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430
      \u0433\u043E\u0440\u0438\u0437\u043E\u043D\u0442 \u043C\u043E\u043B\u0447\u0430
      \u0443\u0436\u0435 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u043C\u0438\u043D\u0443\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219279
    m_Localized: "\u0421\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C \u043F\u043E
      \u0441\u043B\u0435\u0434\u0430\u043C \u0434\u043E \u043E\u0431\u0440\u044B\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219280
    m_Localized: "\u0412 \u043A\u043E\u043D\u0446\u0435 \u0441\u043B\u0435\u0434\u043E\u0432
      - \u043A\u043E\u0436\u0430\u043D\u044B\u0439 \u043C\u0435\u0448\u043E\u043A
      \u0441 \u043C\u043E\u043D\u0435\u0442\u0430\u043C\u0438, \u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0439
      \u0432 \u0441\u043F\u0435\u0448\u043A\u0435. \u0411\u043E\u043B\u044C\u0448\u0435
      \u043D\u0438\u0447\u0435\u0433\u043E. \u0427\u0442\u043E \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E
      - \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443 \u043D\u0435\u043F\u043E\u043D\u044F\u0442\u043D\u043E.
      \u041C\u043E\u043D\u0435\u0442\u044B \u0432\u0437\u044F\u043B\u0438. \u0414\u043E\u0440\u043E\u0433\u0430
      \u0434\u0430\u043B\u044C\u0448\u0435 \u043F\u0443\u0441\u0442\u0430\u044F \u0438
      \u043C\u043E\u043B\u0447\u0430\u043B\u0438\u0432\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219281
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u043E \u0443\u0439\u0442\u0438 -
      \u043D\u0435 \u0437\u0430\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219282
    m_Localized: "\u0412\u044B\u0448\u043B\u0438 \u0431\u0435\u0437 \u0437\u0430\u0432\u0442\u0440\u0430\u043A\u0430.
      \u0411\u0443\u0433\u0430 \u043D\u0435 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u043B\u0441\u044F.
      \u0427\u0442\u043E \u0431\u044B \u044D\u0442\u043E \u043D\u0438 \u0431\u044B\u043B\u043E
      - \u043B\u0443\u0447\u0448\u0435 \u043D\u0435 \u0437\u043D\u0430\u0442\u044C.
      \u041C\u0435\u0441\u0442\u043E \u043E\u0441\u0442\u0430\u043B\u043E\u0441\u044C
      \u043F\u043E\u0437\u0430\u0434\u0438. \u041D\u0430\u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435
      \u0432 \u043E\u0431\u043E\u0437\u0435 - \u043F\u043E\u0434\u0430\u0432\u043B\u0435\u043D\u043D\u043E\u0435
      \u0434\u043E \u0432\u0435\u0447\u0435\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219283
    m_Localized: "\u0416\u0434\u0430\u0442\u044C \u0434\u043E \u0443\u0442\u0440\u0430
      - \u043C\u043E\u0436\u0435\u0442 \u0432\u0435\u0440\u043D\u0443\u0442\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219284
    m_Localized: "\u0416\u0434\u0430\u043B\u0438. \u041D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u0432\u0435\u0440\u043D\u0443\u043B\u0441\u044F. \u041D\u043E\u0447\u044C\u044E
      \u043A\u0442\u043E-\u0442\u043E \u0438\u0437 \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432
      \u0432\u0438\u0434\u0435\u043B \u043E\u0433\u043E\u043D\u0451\u043A \u0432
      \u0441\u0442\u043E\u0440\u043E\u043D\u0435 \u0441\u043A\u0430\u043B - \u043C\u0435\u0440\u0446\u0430\u043B
      \u0442\u0440\u0438 \u0440\u0430\u0437\u0430 \u0438 \u043F\u043E\u0433\u0430\u0441.
      \u0423\u0442\u0440\u043E\u043C \u0434\u0432\u0438\u043D\u0443\u043B\u0438\u0441\u044C
      \u0434\u0430\u043B\u044C\u0448\u0435. \u0420\u0430\u0437\u0433\u043E\u0432\u043E\u0440\u044B
      \u043E\u0431 \u044D\u0442\u043E\u043C \u043C\u0435\u0441\u0442\u0435 \u0448\u043B\u0438
      \u0435\u0449\u0451 \u0434\u043E\u043B\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219285
    m_Localized: "\u041E\u0433\u043D\u0438 \u043D\u0430\u0434 \u0441\u0442\u0430\u0440\u044B\u043C
      \u043A\u043E\u043B\u043E\u0434\u0446\u0435\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219286
    m_Localized: "\u041A\u043E\u043B\u043E\u0434\u0435\u0446 \u0431\u0435\u0437 \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u044F
      - \u0441\u0442\u0430\u0440\u044B\u0439, \u043E\u0431\u043B\u0438\u0446\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0436\u0451\u043B\u0442\u044B\u043C \u043A\u0438\u0440\u043F\u0438\u0447\u043E\u043C
      \u0441 \u0442\u0440\u0435\u0449\u0438\u043D\u0430\u043C\u0438. \u041D\u043E\u0447\u044C\u044E
      \u043D\u0430\u0434 \u043D\u0438\u043C \u0433\u043E\u0440\u044F\u0442 \u043E\u0433\u043D\u0438:
      \u0442\u0440\u0438 \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u044B\u0435
      \u0442\u043E\u0447\u043A\u0438 \u0431\u043B\u0435\u0434\u043D\u043E-\u0441\u0438\u043D\u0435\u0433\u043E
      \u0446\u0432\u0435\u0442\u0430, \u043D\u0435 \u043C\u0435\u0440\u0446\u0430\u044E\u0442,
      \u043D\u0435 \u0434\u0432\u0438\u0436\u0443\u0442\u0441\u044F. \u041D\u0435
      \u0441\u0432\u0435\u0447\u0438 - \u0441\u043B\u0438\u0448\u043A\u043E\u043C
      \u0440\u043E\u0432\u043D\u044B\u0435. \u041D\u0435 \u0444\u0430\u043A\u0435\u043B
      - \u043D\u0435\u0442 \u0437\u0430\u043F\u0430\u0445\u0430 \u0434\u044B\u043C\u0430.
      \u041F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u0441\u044F
      \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0435. \u0411\u0443\u0433\u0430
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442: \u0442\u044E\u0440\u043A\u0438
      \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442 \u0442\u0430\u043A\u043E\u0435
      \u044F\u0440-\u043E\u0442\u044B - \u043E\u0433\u043E\u043D\u044C \u0431\u043E\u043B\u043E\u0442\u0430.
      \u041C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0439 \u043C\u043E\u043D\u0430\u0445
      \u0432 \u043E\u0431\u043E\u0437\u0435 \u0420\u0443\u0441\u0442\u0430\u043C\u0430
      \u0433\u043E\u0432\u043E\u0440\u0438\u0442 \u0438\u043D\u0430\u0447\u0435:
      \u044D\u0442\u043E \u043C\u043E\u0433\u0443\u0442 \u0431\u044B\u0442\u044C
      \u0434\u0443\u0445\u0438 \u0443\u043C\u0435\u0440\u0448\u0438\u0445 \u043A\u0443\u043F\u0446\u043E\u0432,
      \u043D\u0435 \u043D\u0430\u0448\u0435\u0434\u0448\u0438\u0445 \u0434\u043E\u0440\u043E\u0433\u0438
      \u0434\u043E\u043C\u043E\u0439. \u041A\u043E\u043B\u043E\u0434\u0435\u0446
      \u043F\u043E \u0432\u0438\u0434\u0443 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219287
    m_Localized: "\u0421\u043F\u0443\u0441\u0442\u0438\u0442\u044C\u0441\u044F \u0432
      \u043A\u043E\u043B\u043E\u0434\u0435\u0446 \u0438 \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219288
    m_Localized: "\u0412 \u043A\u043E\u043B\u043E\u0434\u0446\u0435 \u043D\u0430
      \u0443\u0441\u0442\u0443\u043F\u0435 - \u043C\u0435\u0434\u043D\u0430\u044F
      \u0448\u043A\u0430\u0442\u0443\u043B\u043A\u0430, \u0432\u043E\u0434\u043E\u0439
      \u043D\u0435 \u0437\u0430\u043B\u0438\u0442\u0430\u044F. \u0412\u043D\u0443\u0442\u0440\u0438
      \u043C\u043E\u043D\u0435\u0442\u044B \u0438 \u0437\u0430\u043F\u0438\u0441\u043A\u0430
      \u043D\u0430 \u043F\u0435\u0445\u043B\u0435\u0432\u0438\u0439\u0441\u043A\u043E\u043C.
      \u041E\u0433\u043D\u0438 \u043A \u0442\u043E\u043C\u0443 \u043C\u043E\u043C\u0435\u043D\u0442\u0443
      \u043F\u043E\u0433\u0430\u0441\u043B\u0438 \u0441\u0430\u043C\u0438. \u0427\u0442\u043E
      \u044D\u0442\u043E \u0431\u044B\u043B\u043E - \u0420\u0443\u0441\u0442\u0430\u043C
      \u0442\u0430\u043A \u0438 \u043D\u0435 \u0440\u0435\u0448\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219289
    m_Localized: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u043A\u0430\u043C\u0435\u043D\u044C
      - \u0441\u043B\u0443\u0448\u0430\u0442\u044C \u0447\u0442\u043E \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219290
    m_Localized: "\u041A\u0430\u043C\u0435\u043D\u044C \u0443\u043F\u0430\u043B,
      \u0432\u0441\u043F\u043B\u0435\u0441\u043A \u0432\u043E\u0434\u044B. \u041E\u0433\u043D\u0438
      \u043D\u0435 \u0441\u0440\u0435\u0430\u0433\u0438\u0440\u043E\u0432\u0430\u043B\u0438.
      \u041F\u043E\u0441\u0442\u043E\u044F\u043B\u0438 \u0435\u0449\u0451 \u0447\u0430\u0441
      - \u043E\u0433\u043D\u0438 \u043F\u043E\u0433\u0430\u0441\u043B\u0438 \u0441\u0430\u043C\u0438
      \u043D\u0430 \u0440\u0430\u0441\u0441\u0432\u0435\u0442\u0435. \u0412\u043E\u0434\u0443
      \u0438\u0437 \u043A\u043E\u043B\u043E\u0434\u0446\u0430 \u043D\u0430\u0431\u0440\u0430\u043B\u0438
      \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E, \u043D\u0435 \u0433\u043B\u044F\u0434\u044F
      \u0432\u043D\u0438\u0437. \u0411\u0443\u0433\u0430 \u0447\u0438\u0442\u0430\u043B
      \u043C\u043E\u043B\u0438\u0442\u0432\u0443 \u043F\u043E-\u0442\u044E\u0440\u043A\u0441\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219291
    m_Localized: "\u0423\u0439\u0442\u0438 \u043D\u0435 \u043E\u0433\u043B\u044F\u0434\u044B\u0432\u0430\u044F\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219292
    m_Localized: "\u0423\u0448\u043B\u0438 \u0432 \u043D\u043E\u0447\u044C, \u043D\u0430\u0448\u043B\u0438
      \u0434\u0440\u0443\u0433\u043E\u0439 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A
      \u0432\u043E\u0434\u044B \u0447\u0435\u0440\u0435\u0437 \u043B\u0438. \u041E\u0433\u043D\u0438
      \u043D\u0430\u0434 \u043A\u043E\u043B\u043E\u0434\u0446\u0435\u043C \u0432\u0438\u0434\u0435\u043B\u0438
      \u0435\u0449\u0451 \u0434\u043E\u043B\u0433\u043E \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439.
      \u0412 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C \u0433\u043E\u0440\u043E\u0434\u0435
      \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0438 - \u0442\u043E\u0440\u0433\u043E\u0432\u0435\u0446
      \u043A\u0438\u0432\u043D\u0443\u043B: \u0434\u0430, \u0437\u043D\u0430\u044E
      \u044D\u0442\u043E\u0442 \u043A\u043E\u043B\u043E\u0434\u0435\u0446, \u0432\u0441\u0435
      \u043E\u0431\u0445\u043E\u0434\u044F\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219293
    m_Localized: "\u0413\u043E\u0432\u043E\u0440\u044F\u0449\u0438\u0439 \u0432\u043E\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219294
    m_Localized: "\u041D\u0430 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0435
      \u0443 \u0442\u043E\u043F\u043E\u043B\u0435\u0439 \u043F\u0442\u0438\u0446\u0430
      \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0430\u0441\u044C \u043D\u0430 \u0431\u043E\u0440\u0442
      \u043F\u043E\u0432\u043E\u0437\u043A\u0438 - \u043A\u0440\u0443\u043F\u043D\u044B\u0439
      \u0432\u043E\u0440\u043E\u043D \u0441 \u0431\u043B\u0435\u0441\u0442\u044F\u0449\u0438\u043C
      \u0447\u0451\u0440\u043D\u044B\u043C \u043E\u043F\u0435\u0440\u0435\u043D\u0438\u0435\u043C,
      \u0431\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0430. \u0427\u0435\u0440\u0435\u0437
      \u043C\u0438\u043D\u0443\u0442\u0443 \u043E\u043D \u043F\u0440\u043E\u0438\u0437\u043D\u0451\u0441
      \u0438\u043C\u044F \u0433\u043B\u0430\u0432\u043D\u043E\u0433\u043E \u0442\u043E\u0440\u0433\u043E\u0432\u0446\u0430
      \u043E\u0431\u043E\u0437\u0430 - \u043D\u0435 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E,
      \u0430 \u0442\u043E\u0447\u043D\u043E, \u0441 \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u044B\u043C
      \u0443\u0434\u0430\u0440\u0435\u043D\u0438\u0435\u043C. \u041F\u043E\u0442\u043E\u043C
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u043B\u043E\u0432
      \u043D\u0430 \u0444\u0430\u0440\u0441\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0441\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u0432\u043E
      \u0444\u0440\u0430\u0437\u0443: \u0446\u0435\u043D\u0430 \u0443\u043F\u0430\u0434\u0451\u0442.
      \u0411\u0443\u0433\u0430 \u043E\u0442\u0448\u0430\u0442\u043D\u0443\u043B\u0441\u044F.
      \u041C\u0430\u043D\u0438\u0445\u0435\u0439\u0441\u043A\u0438\u0439 \u043C\u043E\u043D\u0430\u0445
      \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0441 \u0438\u043D\u0442\u0435\u0440\u0435\u0441\u043E\u043C:
      \u0432 \u0438\u043D\u0434\u0438\u0439\u0441\u043A\u0438\u0445 \u0442\u0435\u043A\u0441\u0442\u0430\u0445
      \u0432\u043E\u0440\u043E\u043D\u044B \u0441\u043B\u0443\u0436\u0430\u0442 \u0432\u0435\u0441\u0442\u043D\u0438\u043A\u0430\u043C\u0438.
      \u0420\u0443\u0441\u0442\u0430\u043C \u043C\u043E\u043B\u0447\u0438\u0442.
      \u041F\u0442\u0438\u0446\u0430 \u0436\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219295
    m_Localized: "\u041F\u043E\u0439\u043C\u0430\u0442\u044C \u0432\u043E\u0440\u043E\u043D\u0430
      - \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F \u0447\u0435\u0439
      \u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219296
    m_Localized: "\u041F\u043E\u0439\u043C\u0430\u043B\u0438 \u0441 \u0442\u0440\u0443\u0434\u043E\u043C
      - \u043F\u0442\u0438\u0446\u0430 \u0431\u044B\u043B\u0430 \u043E\u0431\u0443\u0447\u0435\u043D\u0430
      \u0438 \u0432 \u043F\u0430\u043D\u0438\u043A\u0435 \u0443\u043A\u0443\u0441\u0438\u043B\u0430
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u0430. \u041D\u0430 \u043A\u043E\u043B\u044C\u0446\u0435
      \u043B\u0430\u043F\u044B \u0432\u044B\u0433\u0440\u0430\u0432\u0438\u0440\u043E\u0432\u0430\u043D\u043E
      \u0438\u043C\u044F: \u041B\u0438 \u0413\u0443\u0430\u043D, \u043A\u0443\u043F\u0435\u0446
      \u0438\u0437 \u0427\u0430\u043D\u044A\u0430\u043D\u0438. \u0412 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C
      \u0433\u043E\u0440\u043E\u0434\u0435 \u043D\u0430\u0448\u043B\u0438 \u0435\u0433\u043E
      \u0442\u043E\u0440\u0433\u043E\u0432\u044B\u0439 \u0434\u043E\u043C. \u0426\u0435\u043D\u0430
      \u043D\u0430 \u0448\u0451\u043B\u043A \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0443\u043F\u0430\u043B\u0430 - \u0442\u0440\u0438 \u0434\u043D\u044F \u043D\u0430\u0437\u0430\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219297
    m_Localized: "\u0421\u043B\u0443\u0448\u0430\u0442\u044C \u0447\u0442\u043E \u0435\u0449\u0451
      \u0441\u043A\u0430\u0436\u0435\u0442 \u043F\u0442\u0438\u0446\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219298
    m_Localized: "\u041F\u0440\u043E\u0441\u0438\u0434\u0435\u043B\u0438 \u0441 \u0432\u043E\u0440\u043E\u043D\u043E\u043C
      \u043F\u043E\u043B\u0447\u0430\u0441\u0430. \u041E\u043D \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u043B
      \u0444\u0440\u0430\u0437\u0443 \u0434\u0432\u0430\u0436\u0434\u044B \u0438
      \u0434\u043E\u0431\u0430\u0432\u0438\u043B \u043E\u0434\u043D\u043E \u0441\u043B\u043E\u0432\u043E:
      \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434. \u041F\u043E\u0442\u043E\u043C
      \u0443\u043B\u0435\u0442\u0435\u043B \u043D\u0430 \u0437\u0430\u043F\u0430\u0434.
      \u0421\u043E\u0432\u0435\u0442 \u043E\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u0443\u043C\u0435\u0441\u0442\u043D\u044B\u043C: \u0432 \u0421\u0430\u043C\u0430\u0440\u043A\u0430\u043D\u0434\u0435
      \u0446\u0435\u043D\u0430 \u043D\u0430 \u0441\u043F\u0435\u0446\u0438\u0438
      \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0431\u044B\u043B\u0430 \u0432\u044B\u0448\u0435 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219299
    m_Localized: "\u041F\u0440\u043E\u0433\u043D\u0430\u0442\u044C \u043F\u0442\u0438\u0446\u0443
      - \u043F\u0440\u0438\u043C\u0435\u0442\u0430 \u043F\u043B\u043E\u0445\u0430\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 35058993440219300
    m_Localized: "\u041A\u0438\u043D\u0443\u043B\u0438 \u043A\u0430\u043C\u0435\u043D\u044C,
      \u0432\u043E\u0440\u043E\u043D \u0443\u043B\u0435\u0442\u0435\u043B. \u0411\u0443\u0433\u0430
      \u043E\u0431\u043B\u0435\u0433\u0447\u0451\u043D\u043D\u043E \u0432\u044B\u0434\u043E\u0445\u043D\u0443\u043B:
      \u0433\u043E\u0432\u043E\u0440\u044F\u0449\u0430\u044F \u043F\u0442\u0438\u0446\u0430
      - \u043A \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u044C\u044E, \u0432\u0441\u0435
      \u0437\u043D\u0430\u044E\u0442. \u041F\u043E\u043B\u043E\u0432\u0438\u043D\u0430
      \u043F\u043E\u0433\u043E\u043D\u0449\u0438\u043A\u043E\u0432 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0430\u0441\u044C,
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u0430 \u043D\u0435\u0442. \u0421\u043F\u043E\u0440\u0438\u043B\u0438
      \u0434\u043E \u0432\u0435\u0447\u0435\u0440\u0430 \u0432\u043C\u0435\u0441\u0442\u043E
      \u0442\u043E\u0433\u043E \u0447\u0442\u043E\u0431\u044B \u0442\u043E\u0440\u0433\u043E\u0432\u0430\u0442\u044C\u0441\u044F
      \u043D\u0430 \u0440\u044B\u043D\u043A\u0435."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
