  - m_Id: 651148095643738
    m_Localized: "\u0417\u0440\u0435\u043B\u0438\u0449\u0435 \u0434\u0438\u043A\u043E\u0433\u043E
      \u0442\u0430\u0431\u0443\u043D\u0430 \u0432 \u0437\u0430\u043A\u0430\u0442\u043D\u044B\u0445
      \u043B\u0443\u0447\u0430\u0445 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u0441\u044F
      \u043D\u0430\u0434\u043E\u043B\u0433\u043E. \u041A\u0430\u0440\u0430\u0432\u0430\u043D\u0449\u0438\u043A\u0438
      \u0437\u0430\u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0438\u0441\u044C, \u0437\u0430\u0431\u044B\u0432
      \u043E\u0431 \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643739
    m_Localized: "\u0412\u0435\u0440\u0451\u0432\u043E\u0447\u043D\u0430\u044F \u043F\u0435\u0442\u043B\u044F
      \u043B\u0435\u0433\u043B\u0430 \u043D\u0430 \u0448\u0435\u044E \u043C\u043E\u043B\u043E\u0434\u043E\u0439
      \u043A\u043E\u0431\u044B\u043B\u044B. \u041E\u043D\u0430 \u0440\u0432\u0430\u043B\u0430\u0441\u044C,
      \u043D\u043E \u0443\u0441\u0442\u0430\u043B\u0430 \u043A \u0437\u0430\u043A\u0430\u0442\u0443.
      \u041D\u043E\u0432\u043E\u0435 \u0442\u044F\u0433\u043B\u043E\u0432\u043E\u0435
      \u0436\u0438\u0432\u043E\u0442\u043D\u043E\u0435 - \u0446\u0435\u043D\u043D\u0435\u0439\u0448\u0430\u044F
      \u0434\u043E\u0431\u044B\u0447\u0430 \u0441\u0442\u0435\u043F\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643740
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043F\u043E\u0434\u043E\u0448\u0451\u043B \u043A \u0432\u043E\u0436\u0430\u043A\u0443,
      \u043F\u0440\u043E\u0442\u044F\u0433\u0438\u0432\u0430\u044F \u0433\u043E\u0440\u0441\u0442\u044C
      \u0437\u0435\u0440\u043D\u0430. \u0416\u0435\u0440\u0435\u0431\u0435\u0446
      \u043E\u0431\u043D\u044E\u0445\u0430\u043B \u0440\u0443\u043A\u0443 \u0438
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B, \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0432
      \u043F\u043E\u0434\u043E\u0439\u0442\u0438 \u043A \u043C\u043E\u043B\u043E\u0434\u043E\u0439
      \u043A\u043E\u0431\u044B\u043B\u0435. \"\u042F \u0437\u043D\u0430\u044E \u0441\u0442\u0435\u043F\u043D\u044B\u0445
      \u043A\u043E\u043D\u0435\u0439,\" - \u0441\u043A\u0430\u0437\u0430\u043B \u043E\u043D,
      \u0432\u0435\u0434\u044F \u0435\u0451 \u0437\u0430 \u0433\u0440\u0438\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643741
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0437\u0430\u043B\u0451\u0433
      \u0432 \u043D\u0438\u0437\u0438\u043D\u0435 \u0438 \u043F\u0435\u0440\u0435\u0436\u0434\u0430\u043B
      \u0433\u0440\u043E\u0437\u0443. \u041C\u043E\u043B\u043D\u0438\u0438 \u0431\u0438\u043B\u0438
      \u0440\u044F\u0434\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643742
    m_Localized: "\u0411\u0435\u0448\u0435\u043D\u0430\u044F \u0441\u043A\u0430\u0447\u043A\u0430
      \u043F\u043E \u0441\u0442\u0435\u043F\u0438 \u2014 \u043A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0443\u0448\u0451\u043B \u043E\u0442 \u0433\u0440\u043E\u0437\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643743
    m_Localized: "\u0411\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B\u0439 \u043F\u0443\u0442\u044C
      \u0434\u043B\u0438\u043D\u043D\u0435\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643744
    m_Localized: "\u041A\u043E\u0440\u043E\u0442\u043A\u0438\u0439 \u043F\u0443\u0442\u044C
      \u0441\u044D\u043A\u043E\u043D\u043E\u043C\u0438\u043B \u0432\u0440\u0435\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643745
    m_Localized: "\u0420\u0430\u0441\u0448\u0438\u0444\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
      \u0437\u043D\u0430\u043A\u0438 \u0443\u043A\u0430\u0437\u0430\u043B\u0438 \u043D\u0430
      \u043B\u0443\u0447\u0448\u0438\u0439 \u043F\u0443\u0442\u044C. \u041A\u0430\u0440\u0430\u0432\u0430\u043D
      \u0438\u0437\u0431\u0435\u0436\u0430\u043B \u043E\u043F\u0430\u0441\u043D\u043E\u0433\u043E
      \u0443\u0447\u0430\u0441\u0442\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643746
    m_Localized: "\u0417\u0430 \u0447\u0430\u0435\u043C \u0443 \u043A\u043E\u0441\u0442\u0440\u0430
      \u0443\u0437\u043D\u0430\u043B\u0438 \u043E \u0446\u0435\u043D\u0430\u0445
      \u0432 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0445 \u0433\u043E\u0440\u043E\u0434\u0430\u0445.
      \u0426\u0435\u043D\u043D\u0430\u044F \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
      \u0434\u043B\u044F \u0442\u043E\u0440\u0433\u043E\u0432\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643747
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0435\u0445\u0430\u043B
      \u043C\u0438\u043C\u043E \u043B\u0430\u0433\u0435\u0440\u044F \u0431\u0435\u0437
      \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438. \u041A\u043E\u043D\u043A\u0443\u0440\u0435\u043D\u0442\u044B
      \u2014 \u043D\u0435 \u0434\u0440\u0443\u0437\u044C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643748
    m_Localized: "\u0423\u0434\u0430\u0447\u043D\u044B\u0439 \u043E\u0431\u043C\u0435\u043D
      \u0442\u043E\u0432\u0430\u0440\u0430\u043C\u0438 \u0441 \u043F\u043E\u043F\u0443\u0442\u043D\u044B\u043C
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u043C. \u041E\u0431\u0435
      \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643749
    m_Localized: "\u0422\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043E\u0431\u044B\u0441\u043A
      \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B \u0441\u043F\u0440\u044F\u0442\u0430\u043D\u043D\u044B\u0435
      \u0446\u0435\u043D\u043D\u043E\u0441\u0442\u0438 \u043F\u043E\u0434 \u043E\u0431\u043B\u043E\u043C\u043A\u0430\u043C\u0438.
      \u041F\u043E\u0432\u0435\u0437\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643750
    m_Localized: "\u041E\u0447\u0435\u0432\u0438\u0434\u043D\u044B\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
      \u0441\u043E\u0431\u0440\u0430\u043D\u044B \u0431\u044B\u0441\u0442\u0440\u043E.
      \u041D\u0435 \u0442\u0430\u043A \u043C\u043D\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643751
    m_Localized: "\u0411\u043E\u0439 \u043D\u0430 \u043F\u0440\u0438\u0431\u0440\u0435\u0436\u043D\u044B\u0445
      \u043A\u0430\u043C\u043D\u044F\u0445. \u041F\u0438\u0440\u0430\u0442\u044B
      \u043E\u0442\u0441\u0442\u0443\u043F\u0438\u043B\u0438 \u043A \u0441\u0432\u043E\u0438\u043C
      \u043B\u043E\u0434\u043A\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643752
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0431\u0440\u043E\u0441\u0438\u043B\u0441\u044F
      \u0432\u0433\u043B\u0443\u0431\u044C \u0441\u0443\u0448\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643753
    m_Localized: "\u0412\u044B\u043A\u0443\u043F \u0437\u0430\u043F\u043B\u0430\u0447\u0435\u043D.
      \u041F\u0438\u0440\u0430\u0442\u044B \u043F\u043E\u0433\u0440\u0443\u0437\u0438\u043B\u0438
      \u0434\u043E\u0431\u044B\u0447\u0443 \u0432 \u0448\u043B\u044E\u043F\u043A\u0443
      \u0438 \u043E\u0442\u0447\u0430\u043B\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643754
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0443\u043A\u0440\u044B\u043B\u0441\u044F
      \u0432 \u043F\u0440\u0438\u0431\u0440\u0435\u0436\u043D\u044B\u0445 \u0441\u043A\u0430\u043B\u0430\u0445.
      \u0412\u043E\u043B\u043D\u044B \u0431\u0443\u0448\u0435\u0432\u0430\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643755
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0431\u0438\u043B\u0441\u044F
      \u0441\u043A\u0432\u043E\u0437\u044C \u0448\u0442\u043E\u0440\u043C. \u0421\u043E\u043B\u0451\u043D\u0430\u044F
      \u0432\u043E\u0434\u0430 \u0438\u0441\u043F\u043E\u0440\u0442\u0438\u043B\u0430
      \u0447\u0430\u0441\u0442\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643756
    m_Localized: "\u0412\u043E\u0434\u0430 \u0441\u043F\u0430\u043B\u0430 \u0447\u0435\u0440\u0435\u0437
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0447\u0430\u0441\u043E\u0432.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u043E\u0442\u0435\u0440\u044F\u043B
      \u0432\u0440\u0435\u043C\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643757
    m_Localized: "\u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430 \u0432\u0431\u0440\u043E\u0434
      \u043F\u0440\u043E\u0448\u043B\u0430 \u0442\u044F\u0436\u0435\u043B\u043E \u2014
      \u0447\u0430\u0441\u0442\u044C \u0442\u043E\u0432\u0430\u0440\u043E\u0432 \u043F\u043E\u0434\u043C\u043E\u0447\u0435\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643758
    m_Localized: "\u0418\u043C\u043F\u0440\u043E\u0432\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u043D\u0430\u0441\u0442\u0438\u043B \u0438\u0437 \u0431\u0440\u0451\u0432\u0435\u043D
      \u0432\u044B\u0434\u0435\u0440\u0436\u0430\u043B. \u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430
      \u043F\u0440\u043E\u0448\u043B\u0430 \u0431\u0435\u0437 \u043F\u043E\u0442\u0435\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643759
    m_Localized: "\u0421\u0440\u0435\u0434\u0438 \u043E\u0431\u043B\u043E\u043C\u043A\u043E\u0432
      \u043D\u0430\u0439\u0434\u0435\u043D\u044B \u0431\u043E\u0447\u043A\u0438 \u0441
      \u0432\u0438\u043D\u043E\u043C \u0438 \u044F\u0449\u0438\u043A\u0438 \u0441
      \u0442\u043A\u0430\u043D\u044F\u043C\u0438. \u041C\u043E\u0440\u0435 \u0449\u0435\u0434\u0440\u043E
      \u0441\u0435\u0433\u043E\u0434\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643760
    m_Localized: "\u0421 \u0431\u0435\u0440\u0435\u0433\u0430 \u0441\u043E\u0431\u0440\u0430\u043D\u044B
      \u0432\u044B\u0431\u0440\u043E\u0448\u0435\u043D\u043D\u044B\u0435 \u0432\u043E\u043B\u043D\u0430\u043C\u0438
      \u0442\u043E\u0432\u0430\u0440\u044B. \u041D\u0435\u043C\u043D\u043E\u0433\u043E
      \u043F\u043E\u0434\u043C\u043E\u0447\u0435\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643761
    m_Localized: "\u041D\u044B\u0440\u044F\u043B\u044C\u0449\u0438\u043A\u0438 \u0434\u043E\u0441\u0442\u0430\u043B\u0438
      \u0441\u043E \u0434\u043D\u0430 \u0442\u044F\u0436\u0451\u043B\u044B\u0435
      \u044F\u0449\u0438\u043A\u0438. \u0412\u043D\u0443\u0442\u0440\u0438 \u2014
      \u0440\u0435\u0434\u043A\u0438\u0435 \u0442\u043E\u0432\u0430\u0440\u044B \u0432
      \u0445\u043E\u0440\u043E\u0448\u0435\u043C \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643762
    m_Localized: "\u0420\u044B\u0431\u0430\u043A\u0438 \u043F\u043E\u0434\u0435\u043B\u0438\u043B\u0438\u0441\u044C
      \u043D\u043E\u0432\u043E\u0441\u0442\u044F\u043C\u0438 \u043E \u0434\u043E\u0440\u043E\u0433\u0435
      \u0438 \u043F\u043E\u0433\u043E\u0434\u0435. \u041F\u043E\u043B\u0435\u0437\u043D\u044B\u0435
      \u0441\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0434\u043B\u044F \u043F\u0443\u0442\u043D\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643763
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0435\u0445\u0430\u043B
      \u043C\u0438\u043C\u043E \u0441 \u043A\u043E\u0440\u043E\u0442\u043A\u0438\u043C
      \u043F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435\u043C. \u041F\u0443\u0442\u044C
      \u043D\u0435 \u0436\u0434\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643764
    m_Localized: "\u0421\u0432\u0435\u0436\u0430\u044F \u0440\u044B\u0431\u0430 \u043A\u0443\u043F\u043B\u0435\u043D\u0430
      \u043F\u043E \u0445\u043E\u0440\u043E\u0448\u0435\u0439 \u0446\u0435\u043D\u0435.
      \u041F\u0440\u043E\u0432\u0438\u0430\u043D\u0442 \u043F\u043E\u043F\u043E\u043B\u043D\u0435\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643765
    m_Localized: "\u041A\u043E\u043D\u0442\u0440\u0430\u0431\u0430\u043D\u0434\u043D\u044B\u0439
      \u0442\u043E\u0432\u0430\u0440 \u043A\u0443\u043F\u043B\u0435\u043D \u043F\u043E
      \u0431\u0440\u043E\u0441\u043E\u0432\u043E\u0439 \u0446\u0435\u043D\u0435.
      \u041F\u0440\u043E\u0438\u0441\u0445\u043E\u0436\u0434\u0435\u043D\u0438\u0435
      \u043B\u0443\u0447\u0448\u0435 \u043D\u0435 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148095643766
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0431\u043B\u0430\u0433\u043E\u0440\u0430\u0437\u0443\u043C\u043D\u043E
      \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F \u043E\u0442 \u0441\u043E\u043C\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0439
      \u0441\u0434\u0435\u043B\u043A\u0438 \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0438\u043B
      \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837952
    m_Localized: "\u041A\u0440\u0443\u043F\u043D\u0430\u044F \u043F\u0430\u0440\u0442\u0438\u044F
      \u044D\u043A\u0437\u043E\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u0442\u043E\u0432\u0430\u0440\u043E\u0432
      \u043A\u0443\u043F\u043B\u0435\u043D\u0430 \u0437\u0430 \u043F\u043E\u043B\u0446\u0435\u043D\u044B.
      \u0420\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837953
    m_Localized: "\u0421\u043D\u0435\u0436\u043D\u0430\u044F \u0431\u0443\u0440\u044F
      \u0431\u0443\u0448\u0435\u0432\u0430\u043B\u0430 \u0432\u0441\u044E \u043D\u043E\u0447\u044C.
      \u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u044B\u0441\u0442\u043E\u044F\u043B
      \u0432 \u0443\u043A\u0440\u044B\u0442\u0438\u0438, \u0445\u043E\u0442\u044C
      \u0438 \u0437\u0430\u043C\u0451\u0440\u0437 \u0434\u043E \u043A\u043E\u0441\u0442\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837954
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0448\u0451\u043B \u0441\u043A\u0432\u043E\u0437\u044C
      \u043C\u0435\u0442\u0435\u043B\u044C \u043D\u0430\u043E\u0449\u0443\u043F\u044C.
      \u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0432\u044C\u044E\u043A\u043E\u0432
      \u0441\u043E\u0440\u0432\u0430\u043B\u043E \u0432\u0435\u0442\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837955
    m_Localized: "\u041C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0439 \u043F\u043E\u0434\u044A\u0451\u043C
      \u0441 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0430\u043C\u0438 \u043F\u043E\u043C\u043E\u0433
      \u043F\u0440\u0438\u0432\u044B\u043A\u043D\u0443\u0442\u044C \u043A \u0432\u044B\u0441\u043E\u0442\u0435.
      \u0412\u0441\u0435 \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C \u0434\u043E
      \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837956
    m_Localized: "\u0411\u044B\u0441\u0442\u0440\u044B\u0439 \u043F\u0440\u043E\u0445\u043E\u0434
      \u0447\u0435\u0440\u0435\u0437 \u043F\u0435\u0440\u0435\u0432\u0430\u043B -
      \u043B\u044E\u0434\u0438 \u0437\u0430\u0434\u044B\u0445\u0430\u044E\u0442\u0441\u044F,
      \u043D\u043E \u0441\u043F\u0443\u0441\u043A \u0443\u0436\u0435 \u0431\u043B\u0438\u0437\u043A\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837957
    m_Localized: "\u041E\u0431\u0445\u043E\u0434\u043D\u043E\u0439 \u043F\u0443\u0442\u044C
      \u043D\u0438\u0436\u0435 \u043F\u043E \u0441\u043A\u043B\u043E\u043D\u0443
      \u0434\u043B\u0438\u043D\u043D\u0435\u0435, \u043D\u043E \u043B\u0435\u0433\u0447\u0435
      \u0434\u043B\u044F \u043B\u044E\u0434\u0435\u0439 \u0438 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837958
    m_Localized: "\u041B\u0451\u0434 \u0441\u043A\u043E\u043B\u043E\u043B\u0438 \u0438
      \u043A\u043E\u043B\u0451\u0441\u0430 \u0441\u043C\u0430\u0437\u0430\u043B\u0438
      \u0436\u0438\u0440\u043E\u043C. \u041E\u0441\u043D\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0440\u0430\u0431\u043E\u0442\u0430 - \u043F\u043E\u0432\u043E\u0437\u043A\u0430
      \u043A\u0430\u043A \u043D\u043E\u0432\u0430\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837959
    m_Localized: "\u041A\u0438\u043F\u044F\u0442\u043A\u043E\u043C \u043E\u0442\u043B\u0438\u043B\u0438
      \u043A\u043E\u043B\u0451\u0441\u0430 \u043E\u0442\u043E \u043B\u044C\u0434\u0430.
      \u0411\u044B\u0441\u0442\u0440\u043E, \u043D\u043E \u043A\u0440\u0435\u043F\u043B\u0435\u043D\u0438\u044F
      \u043F\u043E\u0441\u0442\u0440\u0430\u0434\u0430\u043B\u0438 \u043E\u0442 \u043F\u0435\u0440\u0435\u043F\u0430\u0434\u0430
      \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837960
    m_Localized: "\u041F\u043E\u0432\u043E\u0437\u043A\u0443 \u0431\u0440\u043E\u0441\u0438\u043B\u0438
      \u043D\u0430 \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435. \u0413\u0440\u0443\u0437
      \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D \u043C\u0435\u0436\u0434\u0443
      \u0432\u044C\u044E\u0447\u043D\u044B\u043C\u0438 \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837961
    m_Localized: "\u041F\u0430\u0441\u0442\u0443\u0445\u0438 \u043E\u0431\u043C\u0435\u043D\u044F\u043B\u0438
      \u0441\u0443\u0448\u0451\u043D\u043E\u0435 \u043C\u044F\u0441\u043E \u0438
      \u043C\u0430\u0441\u043B\u043E \u044F\u043A\u0430 \u043D\u0430 \u0442\u043A\u0430\u043D\u0438.
      \u041E\u0431\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0434\u043E\u0432\u043E\u043B\u044C\u043D\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837962
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u0432\u0435\u0436\u043B\u0438\u0432\u043E
      \u043F\u0440\u043E\u0448\u0451\u043B \u043C\u0438\u043C\u043E \u0441\u0442\u043E\u044F\u043D\u043A\u0438
      \u043F\u0430\u0441\u0442\u0443\u0445\u043E\u0432. \u041F\u0443\u0442\u044C
      \u0437\u043E\u0432\u0451\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837963
    m_Localized: "\u0427\u0430\u0439 \u0441 \u043C\u043E\u043B\u043E\u043A\u043E\u043C
      \u044F\u043A\u0430 \u0441\u043E\u0433\u0440\u0435\u043B \u043A\u0430\u0440\u0430\u0432\u0430\u043D.
      \u041F\u0430\u0441\u0442\u0443\u0445\u0438 \u0440\u0430\u0441\u0441\u043A\u0430\u0437\u0430\u043B\u0438
      \u043E \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u043C \u043F\u0435\u0440\u0435\u0432\u0430\u043B\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837964
    m_Localized: "\u0423\u043A\u0440\u044B\u0442\u0438\u0435 \u0437\u0430 \u0432\u044B\u0441\u0442\u0443\u043F\u043E\u043C
      \u0441\u043A\u0430\u043B\u044B \u0441\u043F\u0430\u0441\u043B\u043E \u043A\u0430\u0440\u0430\u0432\u0430\u043D.
      \u0421\u043D\u0435\u0433 \u0437\u0430\u0432\u0430\u043B\u0438\u043B \u0434\u043E\u0440\u043E\u0433\u0443,
      \u043D\u043E \u0432\u0441\u0435 \u0436\u0438\u0432\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837965
    m_Localized: "\u0411\u0435\u0433\u0441\u0442\u0432\u043E \u0432\u043F\u0435\u0440\u0451\u0434
      \u043F\u043E \u0442\u0440\u043E\u043F\u0435 - \u043B\u0430\u0432\u0438\u043D\u0430
      \u043F\u0440\u043E\u0448\u043B\u0430 \u0432 \u043C\u0435\u0442\u0440\u0430\u0445
      \u0437\u0430 \u0441\u043F\u0438\u043D\u043E\u0439. \u0427\u0443\u0434\u043E\u043C
      \u0443\u0446\u0435\u043B\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837966
    m_Localized: "\u0422\u0451\u043F\u043B\u044B\u0439 \u043A\u0440\u043E\u0432 \u0438
      \u0433\u043E\u0440\u044F\u0447\u0430\u044F \u0435\u0434\u0430 \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u043B\u0438
      \u0441\u0438\u043B\u044B \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430.
      \u041C\u043E\u043D\u0430\u0445\u0438 - \u0449\u0435\u0434\u0440\u044B\u0435
      \u0445\u043E\u0437\u044F\u0435\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837967
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0441\u044F
      \u043E\u0442 \u043F\u0440\u0438\u044E\u0442\u0430 \u0438 \u0434\u0432\u0438\u043D\u0443\u043B\u0441\u044F
      \u0434\u0430\u043B\u044C\u0448\u0435 \u043F\u043E \u0437\u0430\u0441\u043D\u0435\u0436\u0435\u043D\u043D\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837968
    m_Localized: "\u041F\u043E\u0434\u043D\u043E\u0448\u0435\u043D\u0438\u0435 \u043F\u0440\u0438\u043D\u044F\u0442\u043E
      \u0441 \u043F\u043E\u043A\u043B\u043E\u043D\u043E\u043C. \u0412 \u043E\u0442\u0432\u0435\u0442
      \u043C\u043E\u043D\u0430\u0445\u0438 \u0438\u0441\u0446\u0435\u043B\u0438\u043B\u0438
      \u0431\u043E\u043B\u044C\u043D\u044B\u0445 \u0438 \u0431\u043B\u0430\u0433\u043E\u0441\u043B\u043E\u0432\u0438\u043B\u0438
      \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837969
    m_Localized: "\u041F\u0430\u0432\u043E\u0434\u043E\u043A \u0441\u0445\u043B\u044B\u043D\u0443\u043B
      \u043A \u0443\u0442\u0440\u0443. \u0414\u043E\u0440\u043E\u0433\u0430 \u0432
      \u0433\u0440\u044F\u0437\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837970
    m_Localized: "\u0412\u0431\u0440\u043E\u0434 \u0447\u0435\u0440\u0435\u0437 \u043C\u0443\u0442\u043D\u044B\u0439
      \u043F\u043E\u0442\u043E\u043A \u2014 \u0432\u043E\u0434\u0430 \u0434\u043E\u0445\u043E\u0434\u0438\u043B\u0430
      \u0434\u043E \u043F\u043E\u044F\u0441\u0430. \u0427\u0430\u0441\u0442\u044C
      \u0442\u043E\u0432\u0430\u0440\u0430 \u043F\u043E\u0434\u043C\u043E\u0447\u0435\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837971
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u0430\u044F \u043B\u043E\u0434\u043A\u0430
      \u043F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0438\u043B\u0430 \u0433\u0440\u0443\u0437
      \u043F\u043E \u0447\u0430\u0441\u0442\u044F\u043C. \u041C\u0435\u0434\u043B\u0435\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837972
    m_Localized: "\u041F\u0430\u0440\u043E\u043C\u0449\u0438\u043A \u0434\u043E\u0432\u043E\u043B\u0435\u043D
      \u043E\u043F\u043B\u0430\u0442\u043E\u0439. \u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430
      \u043F\u0440\u043E\u0448\u043B\u0430 \u0433\u043B\u0430\u0434\u043A\u043E \u2014
      \u0433\u0440\u0443\u0437 \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u043C
      \u0431\u0435\u0440\u0435\u0433\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837973
    m_Localized: "\u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430 \u0432\u0431\u0440\u043E\u0434
      \u0431\u0435\u0437 \u043F\u0430\u0440\u043E\u043C\u0430 \u2014 \u0440\u0438\u0441\u043A\u043E\u0432\u0430\u043D\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837974
    m_Localized: "\u041F\u0440\u043E\u0432\u043E\u0434\u043D\u0438\u043A \u043F\u043E\u043A\u0430\u0437\u0430\u043B
      \u043C\u0435\u043B\u043A\u0438\u0439 \u0431\u0440\u043E\u0434 \u0432\u044B\u0448\u0435
      \u043F\u043E \u0442\u0435\u0447\u0435\u043D\u0438\u044E. \u041F\u0435\u0440\u0435\u043F\u0440\u0430\u0432\u0430
      \u043F\u0440\u043E\u0448\u043B\u0430 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837975
    m_Localized: "\u0421\u0432\u0435\u0436\u0430\u044F \u0440\u044B\u0431\u0430 \u043A\u0443\u043F\u043B\u0435\u043D\u0430
      \u043F\u0440\u044F\u043C\u043E \u0441 \u043B\u043E\u0434\u043A\u0438. \u0412\u043A\u0443\u0441\u043D\u044B\u0439
      \u0443\u0436\u0438\u043D \u0434\u043B\u044F \u0432\u0441\u0435\u0433\u043E
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 651148099837976
    m_Localized: "\u041A\u0430\u0440\u0430\u0432\u0430\u043D \u043F\u0440\u043E\u0435\u0445\u0430\u043B
