    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060814
    m_Localized: "\u041F\u043E\u0434\u0430\u0440\u0438\u0442\u044C \u0447\u0430\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060815
    m_Localized: "\u0413\u043E\u0440\u043D\u0430\u044F \u043F\u0435\u0449\u0435\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060816
    m_Localized: "\u0423 \u0434\u043E\u0440\u043E\u0433\u0438 \u0437\u0438\u044F\u0435\u0442
      \u0442\u0451\u043C\u043D\u044B\u0439 \u0432\u0445\u043E\u0434 \u0432 \u043F\u0435\u0449\u0435\u0440\u0443
      \u0441 \u0434\u0440\u0435\u0432\u043D\u0438\u043C\u0438 \u043E\u0442\u043C\u0435\u0442\u0438\u043D\u0430\u043C\u0438.
      \u0412 \u043C\u0435\u0440\u0446\u0430\u043D\u0438\u0438 \u0444\u0430\u043A\u0435\u043B\u0430
      \u0432\u043D\u0443\u0442\u0440\u0438 \u0447\u0442\u043E-\u0442\u043E \u043F\u043E\u0431\u043B\u0451\u0441\u043A\u0438\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060817
    m_Localized: "\u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0442\u044C
      \u0433\u043B\u0443\u0431\u0436\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060818
    m_Localized: "\u041E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C \u0432\u0445\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060819
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060820
    m_Localized: "\u0422\u0440\u043E\u043F\u0430 \u043D\u0430\u0434 \u043E\u0431\u0440\u044B\u0432\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060821
    m_Localized: "\u0423\u0437\u043A\u0430\u044F \u0442\u0440\u043E\u043F\u0430 \u0432\u044C\u0451\u0442\u0441\u044F
      \u043D\u0430\u0434 \u043F\u0440\u043E\u043F\u0430\u0441\u0442\u044C\u044E.
      \u041A\u0430\u043C\u043D\u0438 \u043E\u0441\u044B\u043F\u0430\u044E\u0442\u0441\u044F
      \u0438\u0437-\u043F\u043E\u0434 \u043D\u043E\u0433, \u0432\u0435\u0442\u0435\u0440
      \u0440\u0432\u0451\u0442 \u043E\u0434\u0435\u0436\u0434\u0443, \u0430 \u0432\u043D\u0438\u0437\u0443
      \u2014 \u0431\u0435\u0437\u0434\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060822
    m_Localized: "\u0418\u0434\u0442\u0438 \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060823
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u0431\u044B\u0441\u0442\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060824
    m_Localized: "\u0425\u043E\u043B\u043E\u0434\u043D\u0430\u044F \u043D\u043E\u0447\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060825
    m_Localized: "\u041C\u043E\u0440\u043E\u0437 \u0441\u043A\u043E\u0432\u0430\u043B
      \u0433\u043E\u0440\u043D\u044B\u0439 \u043B\u0430\u0433\u0435\u0440\u044C.
      \u041A\u043E\u0441\u0442\u0451\u0440 \u0433\u0430\u0441\u043D\u0435\u0442,
      \u0434\u044B\u0445\u0430\u043D\u0438\u0435 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u0432 \u043F\u0430\u0440, \u0430 \u043B\u044E\u0434\u0438 \u0436\u043C\u0443\u0442\u0441\u044F
      \u0434\u0440\u0443\u0433 \u043A \u0434\u0440\u0443\u0433\u0443 \u0432 \u043F\u043E\u0438\u0441\u043A\u0430\u0445
      \u0442\u0435\u043F\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060826
    m_Localized: "\u0421\u0436\u0435\u0447\u044C \u043F\u0440\u0438\u043F\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060827
    m_Localized: "\u0422\u0435\u0440\u043F\u0435\u0442\u044C \u0445\u043E\u043B\u043E\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060828
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060829
    m_Localized: "\u0414\u0440\u0435\u0432\u043D\u0438\u0439 \u043C\u043E\u043D\u0430\u0441\u0442\u044B\u0440\u044C
      \u043D\u0430 \u0441\u043A\u0430\u043B\u0435 \u0432\u0438\u0434\u0435\u043D
      \u0438\u0437\u0434\u0430\u043B\u0435\u043A\u0430. \u041C\u043E\u043D\u0430\u0445\u0438
      \u0432 \u043E\u0440\u0430\u043D\u0436\u0435\u0432\u044B\u0445 \u043E\u0434\u0435\u0436\u0434\u0430\u0445
      \u0441\u0442\u043E\u044F\u0442 \u0443 \u0432\u043E\u0440\u043E\u0442, \u043C\u043E\u043B\u0438\u0442\u0432\u0435\u043D\u043D\u044B\u0435
      \u0444\u043B\u0430\u0433\u0438 \u0440\u0430\u0437\u0432\u0435\u0432\u0430\u044E\u0442\u0441\u044F
      \u043D\u0430 \u0432\u0435\u0442\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060830
    m_Localized: "\u0421\u0434\u0435\u043B\u0430\u0442\u044C \u043F\u043E\u0436\u0435\u0440\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060831
    m_Localized: "\u041F\u0440\u043E\u0439\u0442\u0438 \u043C\u0438\u043C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060832
    m_Localized: "\u041F\u043E\u0434\u0430\u0440\u0438\u0442\u044C \u0431\u043B\u0430\u0433\u043E\u0432\u043E\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060833
    m_Localized: "\u0413\u043E\u0440\u043D\u044B\u0439 \u043E\u0440\u0451\u043B"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060834
    m_Localized: "\u041E\u0433\u0440\u043E\u043C\u043D\u044B\u0439 \u0431\u0435\u0440\u043A\u0443\u0442
      \u043A\u0440\u0443\u0436\u0438\u0442 \u043D\u0430\u0434 \u043A\u0430\u0440\u0430\u0432\u0430\u043D\u043E\u043C,
      \u0442\u043E \u0441\u043D\u0438\u0436\u0430\u044F\u0441\u044C, \u0442\u043E
      \u0432\u0437\u043C\u044B\u0432\u0430\u044F \u0432\u0432\u044B\u0441\u044C.
      \u0425\u0438\u0449\u043D\u0438\u043A \u044F\u0432\u043D\u043E \u0432\u044B\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442
      \u0434\u043E\u0431\u044B\u0447\u0443 \u0441\u0440\u0435\u0434\u0438 \u0432\u044C\u044E\u0447\u043D\u044B\u0445
      \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060835
    m_Localized: "\u041E\u0442\u043F\u0443\u0433\u043D\u0443\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060836
    m_Localized: "\u041F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060837
    m_Localized: "\u041B\u0435\u0441\u043D\u0430\u044F \u0437\u0430\u0441\u0430\u0434\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060838
    m_Localized: "\u0418\u0437-\u0437\u0430 \u043F\u043E\u0432\u0430\u043B\u0435\u043D\u043D\u043E\u0433\u043E
      \u0434\u0435\u0440\u0435\u0432\u0430 \u043D\u0430 \u043B\u0435\u0441\u043D\u043E\u0439
      \u0442\u0440\u043E\u043F\u0435 \u0432\u044B\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u044E\u0442
      \u0432\u043E\u043E\u0440\u0443\u0436\u0451\u043D\u043D\u044B\u0435 \u0444\u0438\u0433\u0443\u0440\u044B.
      \u0411\u0430\u043D\u0434\u0438\u0442\u044B \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0442
      \u043A\u0430\u0440\u0430\u0432\u0430\u043D \u2014 \u0438\u0445 \u043A\u043B\u0438\u043D\u043A\u0438
      \u0431\u043B\u0435\u0441\u0442\u044F\u0442 \u0432 \u043F\u0440\u043E\u0441\u0432\u0435\u0442\u0430\u0445
      \u043C\u0435\u0436\u0434\u0443 \u0434\u0435\u0440\u0435\u0432\u044C\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060839
    m_Localized: "\u0421\u0440\u0430\u0436\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060840
    m_Localized: "\u0411\u0435\u0436\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060841
    m_Localized: "\u0417\u0430\u043F\u043B\u0430\u0442\u0438\u0442\u044C \u0432\u044B\u043A\u0443\u043F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060842
    m_Localized: "\u041B\u0435\u0441\u043D\u043E\u0439 \u043F\u043E\u0436\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060843
    m_Localized: "\u0415\u0434\u043A\u0438\u0439 \u0434\u044B\u043C \u0441\u0442\u0435\u043B\u0435\u0442\u0441\u044F
      \u043C\u0435\u0436\u0434\u0443 \u0441\u0442\u0432\u043E\u043B\u0430\u043C\u0438
      \u0438 \u0442\u0440\u0435\u0441\u043A \u043F\u043B\u0430\u043C\u0435\u043D\u0438
      \u043D\u0430\u0440\u0430\u0441\u0442\u0430\u0435\u0442. \u0421\u0442\u0435\u043D\u0430
      \u043E\u0433\u043D\u044F \u043F\u043E\u043B\u0437\u0451\u0442 \u0441\u043A\u0432\u043E\u0437\u044C
      \u0447\u0430\u0449\u0443 \u2014 \u043D\u0443\u0436\u043D\u043E \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
      \u0431\u044B\u0441\u0442\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060844
    m_Localized: "\u0423\u043A\u0440\u044B\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060845
    m_Localized: "\u041F\u0440\u043E\u0440\u0432\u0430\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060846
    m_Localized: "\u041E\u0431\u043E\u0439\u0442\u0438 \u043E\u0433\u043E\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060847
    m_Localized: "\u0414\u0438\u043A\u0438\u0439 \u043A\u0430\u0431\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060848
    m_Localized: "\u0422\u0440\u0435\u0441\u043A \u0432\u0435\u0442\u043E\u043A \u2014
      \u0438 \u0438\u0437 \u043F\u043E\u0434\u043B\u0435\u0441\u043A\u0430 \u0432\u044B\u043B\u0435\u0442\u0430\u0435\u0442
      \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u0439 \u043A\u0430\u0431\u0430\u043D
      \u0441 \u0434\u043B\u0438\u043D\u043D\u044B\u043C\u0438 \u043A\u043B\u044B\u043A\u0430\u043C\u0438.
      \u0417\u0432\u0435\u0440\u044C \u0440\u043E\u0435\u0442 \u043A\u043E\u043F\u044B\u0442\u043E\u043C
      \u0437\u0435\u043C\u043B\u044E \u0438 \u043D\u0430\u0446\u0435\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060849
    m_Localized: "\u041E\u0445\u043E\u0442\u0438\u0442\u044C\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060850
    m_Localized: "\u041F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060851
    m_Localized: "\u041D\u0435\u043F\u0440\u043E\u043B\u0430\u0437\u043D\u0430\u044F
      \u0433\u0440\u044F\u0437\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060852
    m_Localized: "\u0414\u043E\u0436\u0434\u044C \u043F\u0440\u0435\u0432\u0440\u0430\u0442\u0438\u043B
      \u043B\u0435\u0441\u043D\u0443\u044E \u0434\u043E\u0440\u043E\u0433\u0443 \u0432
      \u0442\u043E\u043F\u044C. \u041A\u043E\u043B\u0451\u0441\u0430 \u043F\u043E\u0432\u043E\u0437\u043A\u0438
      \u0443\u0432\u044F\u0437\u043B\u0438 \u043F\u043E \u043E\u0441\u044C \u2014
      \u0442\u0435\u043B\u0435\u0433\u0430 \u043D\u0435 \u0441\u0434\u0432\u0438\u043D\u0435\u0442\u0441\u044F
      \u0431\u0435\u0437 \u0441\u0435\u0440\u044C\u0451\u0437\u043D\u044B\u0445 \u0443\u0441\u0438\u043B\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060853
    m_Localized: "\u041D\u0430\u043D\u044F\u0442\u044C \u043F\u043E\u043C\u043E\u0449\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060854
    m_Localized: "\u0427\u0438\u043D\u0438\u0442\u044C \u043D\u0430 \u043C\u0435\u0441\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060855
    m_Localized: "\u0420\u0430\u0437\u0433\u0440\u0443\u0437\u0438\u0442\u044C \u043F\u043E\u0432\u043E\u0437\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060856
    m_Localized: "\u041F\u0440\u043E\u043B\u0438\u0432\u043D\u043E\u0439 \u0434\u043E\u0436\u0434\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060857
    m_Localized: "\u041D\u0435\u0431\u043E \u0440\u0430\u0437\u0432\u0435\u0440\u0437\u043B\u043E\u0441\u044C
      \u043D\u0430\u0434 \u043B\u0435\u0441\u043E\u043C \u0441\u043F\u043B\u043E\u0448\u043D\u043E\u0439
      \u0441\u0442\u0435\u043D\u043E\u0439 \u0432\u043E\u0434\u044B. \u0422\u0440\u043E\u043F\u0430
      \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F \u0432
      \u0440\u0443\u0447\u0435\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 651148083060858
    m_Localized: "\u041F\u0435\u0440\u0435\u0436\u0434\u0430\u0442\u044C"
