  - m_Id: 485482540
    m_Localized: Empire of Trade
    m_Metadata:
      m_Items: []
  - m_Id: 485482541
    m_Localized: "Career in the trade guild \u2014 from simple deliveries to the
      empire's grand contract. Unlocks access to Constantinople"
    m_Metadata:
      m_Items: []
  - m_Id: 485482542
    m_Localized: Path of the Mystic
    m_Metadata:
      m_Items: []
  - m_Id: 485482543
    m_Localized: Spiritual journey through the Silk Road's sacred sites. Unlocks
      the mountain pass
    m_Metadata:
      m_Items: []
  - m_Id: 485482544
    m_Localized: Path of the Caravaneer
    m_Metadata:
      m_Items: []
  - m_Id: 485482545
    m_Localized: "Old Dariush's trials \u2014 become a legend of the roads"
    m_Metadata:
      m_Items: []
